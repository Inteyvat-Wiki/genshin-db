				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Kalian salah tangkap orang ... Guruku bernama Kanei, dan namaku Zhaka ... Harusnya kalian tangkap dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "Aku sama sekali tidak bisa buat boneka sebaik guruku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Kamu ditangkap ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Eh? Jadi kalian bukan sekongkol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Ya bukan lah! Apa kamu enggak lihat kami sudah ngusir mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Oh, ternyata. Baguslah! Berarti aku akhirnya bebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Tentu saja, kamu boleh pulang. Tapi ... apa yang terjadi di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Mereka entah dari mana datang ke sini menjual boneka liburan palsu. Tapi boneka buatan mereka sangat jelek, jadi mereka menculik guruku Kanei untuk membantu mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Tapi entah kenapa, mereka malah menangkapku ... Aduh, aku baru belajar teknik cat dari guru selama tiga hari ... Aku tidak punya kemampuan seperti yang mereka harapkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Tapi gimana pun, terima kasih banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, ayo pulang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
	]
