				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "Halo! Apakah kamu mau bermain Theater Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Theater Mechanicus? Apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Oh, tidak pernah dengar? Biarkan aku untuk memperkenalkannya padamu. Theater Mechanicus adalah jenis permainan di atas meja yang kuciptakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Apakah kamu melihat potongan-potongan yang diletakkan di atas meja ini? Semua ini adalah item penting dalam permainan Theater Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Sepertinya cukup rumit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Ini mungkin terlihat rumit, tapi kamu akan memahaminya setelah bermain beberapa kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Jadi, bagaimana? Apakah kamu ingin mencobanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Uh, harganya berapa kalau mau main?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Tidak, tidak, lagi pula sekarang sedang Festival Lantern Rite. Selain itu, aku juga ingin tahu pendapat orang-orang tentang permainan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Jadi, kamu hanya perlu membayar dengan satu Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Kamu hanya perlu memberiku Lentera Xiao kalau kamu ingin mencoba bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Ayo, cobalah! Aku akan membiarkanmu bermain ronde pertama secara gratis dan kamu bisa menyimpan Lentera Xiao-mu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Pasti cukup mahal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
