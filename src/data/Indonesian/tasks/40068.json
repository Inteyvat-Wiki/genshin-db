					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400681201,
					"content": "Semuanya, aku menemukan catatan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681202,
					"content": "Oh, jadi begitu ya, pulau ini menarik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681203,
					"content": "Coba lihat gaya dan tanda tangan ini. Ini milik Albedo, salah satu teman kita dari Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681204,
					"content": "Albedo adalah alkemis yang handal, dia juga pernah datang ke pulau ini sebelumnya. Catatan ini dia tinggalkan untuk petualang di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681205,
					"content": "Oh? Ternyata dia ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681206,
					"content": "Maksud dia, seluruh pulau ini sudah dibuat jadi alat musik? Luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681207
					],
