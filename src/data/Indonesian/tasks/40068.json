				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680501,
					"content": "Pintunya terkunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680502,
					"content": "Mona, cepat berubah jadi air dan masuk ke dalam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "Simpan saja omong-kosongmu untuk dirimu sendiri, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680506,
					"content": "Xinyan, kok kamu kunci pintunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680507,
					"content": "Haha, entahlah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680508,
					"content": "Kalau dipikir-pikir, biasanya aku simpan kunci di bawah pot bunga dekat pintu. Jadi, mungkin kuncinya ada di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680509,
					"content": "Apa ada pot bunga di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680510,
					"content": "Tidak ada, tapi ada ... itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "Mungkin saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680504,
					"content": "Kazuha, ayo lompat sekuat tenaga dan lewat pintu itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "Akan kupertimbangkan lagi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
