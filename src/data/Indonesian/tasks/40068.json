			},
			"dialogs": [
				{
					"id": 400681001,
					"content": "Wah, kita sudah di luar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "Di sini memang terang, tapi aku juga suka gua itu sih, di sana hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "\"Mata Air Gletser\" ada di pegunungan sekitar sini, ayo kita cari sama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Tunggu, kenapa di sini bisa ada cahaya? Apa mungkin ini ... jalur air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "Menurut penjelasan bunga tadi, jalur air ini berhubungan dengan tanaman, dan tanamannya akan mengarahkan kita ke mata airnya. Kita ikuti saja jalur airnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006812,
