			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Hei bangun, pemalas! Ini sudah siang! Matahari udah di tepat di depan matamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, tapi kan aku tutup mata tidurnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Ya sudah, pantas saja kamu tidak bisa lihat kalau matahari sudah ada di atasmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, bagaimana tidurmu semalam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Biasa saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Senang mendengarnya. Aku tadi bangun duluan, jadi aku jalan-jalan dan memetik sedikit buah untuk sarapan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "Kita semua sudah nungguin kamu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "Kalian menikmati sarapannya dan mulai mengobrol ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Eh? Fischl sudah pergi pagi-pagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Hm, dia tampaknya tidak mau tinggal di sini bersama kita, lalu dia bilang Adventurer's Guild memanggilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "Hah? Dia jelas bilang kalau tujuannya mau memulihkan kejayaan Immernachtreich! Terus apa-apaan? Dia kerja untuk Adventurer's Guild? Lucu banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Sudahlah ... Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Dia sepertinya khawatir tentang sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "Kita sudah minta Mona untuk menghiburnya, tapi Fischl bilang Mona tidak tahu apa pun tentang menjadi seorang petualang jadi dia menolak Mona untuk ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "Terus gimana dong soal Immernachtreich? Paimon pikir dia suka sama cerita yang dibuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Mungkin dia memang sedang ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "Aku ingin membantunya sebagai teman ... tapi mungkin dia benar. Kita akan menjelajahi pulau yang lain hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Oh? Begitukah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Semua sudah setuju kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "Tapi kan tidak ada aku waktu ambil keputusan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "Tadi Paimon sudah mewakilimu! Paimon bilang pilihannya pilihanmu juga, dan sebaliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "Hehe, kamu itu kan seorang petualang, kamu pasti akan pergi, ya kan? Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Hadeh, baiklah ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl menyarankan kita bergerak bersama, masih ada hal yang harus diselidiknya. Tapi begitu dia selesai, dia akan bergabung dengan kita, jadi tidak usah khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Jangan meremehkannya, dia juga petualang yang berpengalaman, aku rasa kita harus percaya padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "Aku belum lama mengenal Fischl, tapi aku rasa dia sedang berkecamuk dengan dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Sepertinya kamu benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "Kalau kamu sedang bermasalah dengan orang lain, kamu bisa menang atau kalah. Tapi kalau lawanmu itu diri sendiri, sulit untuk menentukan pemenangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "Beberapa tahun yang lalu, aku juga sama sepertinya, jadi aku bisa mengerti kondisinya. Dia khawatir dengan sesuatu dan sedang butuh waktu sendiri sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "Aku sih setuju saja. Cuma sayang, aku pikir kita akan bertualang bersama hari ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Xinyan bersemangat banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#Oh ya, ngomong-ngomong, pagi ini ada sebuah ilusi di pulau di utara, kita bisa pergi ke sana setelah {NICKNAME} selesai sarapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "Lumayan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
