				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "Wah! Bunganya besar banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "Panas sekali di sini ... Apa gara-gara bunga itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Tidak kusangka ada tamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680904,
					"content": "Ehhh! Bunganya bisa ngomong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "Tupai yang kemarin juga bisa, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Paimon tahu! Tapi, ini enggak sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Halo, kami sudah menyentuh tanaman seperti drum di dekat pantai lalu dipindahkan ke area ini. Apakah kamu pemilik tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "Ini adalah aula musik, aku cuma penjaga gerbang. Apa kalian juga datang untuk mencari musik, kawan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680910,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Kalau begitu, coba jelaskan, bagaimana pemahamanmu terhadap musik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680912,
					"content": "Hidup pemberontakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "Luar biasa! Aku senang mendengarnya. Kita mungkin bisa jadi teman seperjuangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680914,
					"content": "Xinyan berteman dengan bunga raksasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "Yah, orangnya yang mudah bergaul kan memang bisa berteman di mana pun juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "Kalau kalian sudah sampai sejauh ini, kalian pasti mau masuk lagi ke dalam, kan? Tapi, aku minta maaf. Kalian perlu suara nyanyianku untuk masuk. Tapi sayangnya tenggorokanku lagi tidak enak sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680917,
					"content": "Kamu tidak apa-apa, kan? Mau minum obat batuk atau sejenisnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "Tidak, aku cuma sudah lama tidak minum Mata Air Gletser. Kalau bisa minum air dari sana, suaraku pasti bisa merdu kembali dan bisa membuka jalan untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680919,
					"content": "\"Mata Air Gletser\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Benar. Setelah minum airnya satu teguk saja, orang yang lelah, burung yang mengantuk, dan bocah sekalipun, akan bisa menyanyikan lagu dengan suara yang paling indah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680921,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "Baik, akan aku bantu carikan. Di mana mata airnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "Terima kasih, kamu yang terbaik! Air dari sana membantu tumbuhan tumbuh kuat supaya bisa mengalahkan kesulitan dan menaklukkan gunung yang ada di hadapannya ... Jadi, aku rasa mata air ini ada di salah satu pegunungan yang dilindungi oleh tumbuh-tumbuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680924,
					"content": "Di atas gunung? Paimon pikir air laut sembarangan saja sudah bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "Air laut dan mata air kan sumbernya beda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Oh, tapi kamu perlu kekuatanku kalau mau mencari mata air itu. Kawanku, berikan tanganmu agar kamu bisa melihat dengan mataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680927,
					"content": "Terima kasih! Kamu menjabat tanganku — jadi artinya kita sudah resmi berteman ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "Kapal kemarin juga bisa, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
