				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "Pulau ini kelihatannya normal banget sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "Aku mencium bau gosong di udara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Eh ... Air ramalanku sudah sedikit lebih jernih, tapi tetap masih belum jelas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "Hei! Lihat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "Ini drum ... atau tumbuhan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "Alat musik dari tanaman? Sepertinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, menurutmu ini pulaumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Jadi maksudmu alat musik ini ditaruh di sini khusus untukku? Oke, aku bisa coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Tunggu. Kemarin saat aku menyentuh bebatuan di bonsai itu, kita langsung berpindah ke tempat lain yang khusus. Xinyan, apa kamu perlu waktu untuk bersiap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "Tidak masalah, aku selalu siap untuk musik kapan pun di mana pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
