			"dialogs": [
				{
					"id": 400680401,
					"content": "*uhuk* *uhuk* Paimon jadi makan debu satu mulut penuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680402,
					"content": "Paimon, kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680403,
					"content": "Ternyata benar, kita dikirim ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680404,
					"content": "Kenapa tempat ini rasanya sangat gersang ... Xinyan, apa kamu yakin ini alam fantasimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680405,
					"content": "Sepertinya iya, tapi ... kenapa gersang seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680406,
					"content": "Lihat, di sana terang sekali, sepertinya kita diundang untuk pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680407,
					"content": "Baik, ayo kita ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680408,
					"content": "Tunggu, tunggu! Ini jelas banget kan! Jadi bisa saja perangkap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680409,
					"content": "Mungkin saja, tapi kita tidak punya jalan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680410,
					"content": "Iya sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "Jika benar ini alam fantasi Xinyan, seharusnya tidak akan ada jebakan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680412,
					"content": "Terima kasih! Kamu paham benar soal karakterku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680413,
					"content": "Oke, masuk akal. Kita ke sana, tapi tetap harus hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
