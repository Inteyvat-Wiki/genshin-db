			"dialogs": [
				{
					"id": 230090201,
					"content": "Aku masih harus belanja bahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "Bagaimana Tanah Beton-nya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Luar biasa! Ternyata kegunaannya sangat beragam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Bisa jadi tembikar, bisa juga untuk menambal retak dan kebocoran di rumah-rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Hanya dengan mengatur sedikit rasio campuran tanah, langsung dipakai untuk membangun rumah pun tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "Tapi ... karena yang pesan tanah jenis ini banyak, jadi bahanku hampir habis lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "Yang jelas aku sudah kehabisan Slime Condensate. Pengembara, bisa tolong carikan tiga lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "Tolong ya Pengembara. Tiga lagi saja Slime Condensate-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "Bahan yang lainnya gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Bahan lain sudah dibeli, relasiku banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Tapi aku tidak sangka Slime Condensate itu habisnya cepat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
