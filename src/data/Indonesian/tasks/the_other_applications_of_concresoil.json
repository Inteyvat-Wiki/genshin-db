			"dialogs": [
				{
					"id": 230091101,
					"content": "Pengembara! Kebetulan sekali kamu datang. Aku butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "Penelitian tanahnya gimana? Ada kemajuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Eh, tidak juga sih. Tapi aku dapat masukan bagus dari pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Katanya dia hobi tanam bunga, dan dia sering kesal ketika harus cari tanah yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "Tanahnya harus bagus, bisa menyerap udara, dan ada humusnya. Penyerapan air juga harus memadai, tapi tidak boleh sampai tergenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Karena dia melihat Tanah Betonku ini ada banyak perkembangan, dia memintaku membuat versi Tanah Beton untuk bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Aku rasa hal ini cukup pantas diteliti, jadi sekarang aku sedang cari bahan lain untuk mengembangkan Tanah Beton-ku lebih jauh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Aku butuh bantuanmu kali ini, tolong bawakan sedikit tanah yang subur ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Lokasi tanahnya sudah kuberi tanda di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Kenapa jauh ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
