					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "*huff* Intinya, aku harus perbaiki semua yang retak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Karena aku membantu banyak orang memperbaiki barang, ada banyak sekali sisa Tanah Beton yang kuminta mereka simpan dalam pot-pot. Dan ah, ada banyak sekali potnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "Pengembara, tolong ambilkan Tanah Beton yang dibuang di rumah ini. Aku akan ke rumah satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
