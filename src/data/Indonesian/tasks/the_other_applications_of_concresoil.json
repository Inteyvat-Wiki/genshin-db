						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "Ada yang salah dengan Tanah Beton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Mungkin karena rasio campurannya, atau mungkin karena uji coba yang kurang banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Banyak pelanggan yang pakai Tanah Beton ini untuk bangun dapur, lalu beberapa hari kemudian terjadi keretakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Apa mungkin karena dipakai untuk kegiatan yang melibatkan suhu tinggi, jadi tanahnya gagal?",
