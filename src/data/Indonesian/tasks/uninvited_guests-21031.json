			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Duh, aku harus kepikiran caranya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Ah, ternyata kamu. *huff* Sebenarnya aku malas membahasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Belakangan ini usaha penginapan sudah semakin lancar dan banyak pengunjung yang datang untuk menginap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Ada yang menyendiri agar lebih tenang, ada juga yang membawa keluarganya jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Usaha yang jadi semakin ramai tentu saja adalah hal bagus, tapi masalahnya ada banyak monster yang berkeliaran di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Kalau anak-anak sedang bermain di luar, atau orang tua sedang jalan-jalan santai, lalu mereka bertemu dengan monster ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Agar masalah seperti itu tidak terjadi, aku harus keluar dan mengusir monster-monster itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Tapi aku hanya seorang diri, sedangkan monsternya ada banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "Pengembara, maukah kamu membantuku? Bayarannya pasti sebanding kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Aku hanya bisa mengandalkanmu. Setelah kuperhatikan, ada beberapa kemah monster yang berisi monster-monster berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Selain itu ada gerombolan monster yang diam-diam membuat kemah di dekat penginapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "Bagaimana kalau begini? Monster yang lebih berbahaya itu serahkan saja padaku. Kamu hanya perlu mengusir monster yang ada di sekitar penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "Kalau semuanya sudah beres, kita ketemu lagi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "*huff* Monster-monster ini benar-benar merepotkan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Tapi kamu sendiri cukup ahli, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Aku? Yah ... terima kasih atas pujiannya, tapi sebenarnya biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "Bagaimanapun juga, kalau sendiri tidak akan bisa melawan mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
