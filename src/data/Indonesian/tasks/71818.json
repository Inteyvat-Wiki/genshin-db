					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "Apa kamu sudah menggantung Lentera Xiao-nya? Baguslah. Tahun yang akan datang ini pun pasti akan menjadi tahun yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "Ya, pasti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Kakek Jiangcheng, sudah waktunya kami pergi. Masih ada hal yang harus kami selesaikan. Aku akan mengunjungimu lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180405,
					"content": "Baiklah... Anak muda sepertimu selalu saja ada hal yang harus dikerjakan... tidak bisa beristirahat sejenak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ah, baiklah. Sayangku... jangan lupa untuk menjaga rumah kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
