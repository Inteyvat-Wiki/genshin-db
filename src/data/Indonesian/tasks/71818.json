					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Sayang, ayo kemarilah dan berbincang dengan Xiaobai... Karya ayahnya benar-benar luar biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "Mereka menjual tofu di Pelabuhan Liyue, dan benar-benar enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Ah, Xiaobai, kamu sedang apa di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "Kami membawa Lentera Xiao untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Lentera Xiao... ah... Lentera Xiao... ah, setiap tahun aku sungguh merepotkanmu, Xiaobai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Sayang, apa kamu ingat? Dulu aku sering membuat Lentera Xiao yang besar sekali. Tetangga kita menyukainya sampai mereka memintaku membuatkannya untuk mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Lentera Xiao ini indah sekali, benar-benar menerangi setiap lentera di Lantern Rite... tunggu, aku akan menggantungnya untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Kubantu menggantungnya untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Baiklah, hati-hati ya, jangan sampai kamu jatuh dan terluka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
