			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Sayang, kamu sudah kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "Maaf, kamu salah orang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Tidak mungkin, aku masih belum pikun... Bagaimana mungkin aku tidak mengenali istriku sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "Aku baru saja memberi tahumu bahwa, dengan festival besar yang sebentar lagi akan tiba, mungkin kita harus membeli pakaian baru untuk putri kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Oh kamu kembali membawa tamu... Ah, dia pasti penjahit pakaian kan. Wah, kamu selalu tahu apa yang ada di pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Kakek Jiangcheng, ini aku, Xiaobai. Aku memberimu tofu kemarin ini. Kamu tidak mungkin melupakanku secepat itu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180207,
					"content": "Ah... Xiaobai... tentu saja aku ingat! Ayahmu memberitahuku bahwa dia bangga sekali padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Eh... kapan ya dia bilang begitu?... Sayang, mungkin kamu ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "...aku ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Ha! Benar kan kataku, tidak ada yang salah dengan ingatanku... lalu, lalu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Kakek Jiangcheng, bagaimana jika kamu beristirahat dulu? Tidak perlu memaksakan diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180213,
					"content": "Pengembara, bagaimana jika kamu membantu kakek Jiangcheng untuk membersihkan rumahnya? Sementara itu aku akan menemaninya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180214,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180210,
					"content": "Tentu saja aku ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
