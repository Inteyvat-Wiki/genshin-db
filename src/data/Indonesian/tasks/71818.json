				"objectNames": [
					"Nona Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "Bagaimana, Pengembara? Terima kasih atas bantuanmu terakhir kali. Sudah lama Desa Qingce tidak semeriah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180102,
					"content": "Tak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "Pada tahun-tahun sebelumnya, hanya Zhi dan aku yang ada di sini, jadi kami hanya bisa membuatkan anak-anak beberapa Lentera Xiao, lalu berbincang dengan beberapa orang tua mengenai bisnis lokal, lalu memasak beberapa makanan enak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180104,
					"content": "Tapi dengan bantuanmu, kami bisa merasakan suasana Lantern Rite yang cukup meriah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180105,
					"content": "Tapi kurasa kita harus kembali normal sekarang... Aku harus menemui orang tua di desa. Aku bermaksud untuk pergi menemui Jiangcheng hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180106,
					"content": "Jika kamu tidak keberatan, bisakah kamu pergi denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180107,
					"content": "Baiklah, ayo kita pergi bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Baiklah, ayo kita pergi ke tempatnya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Bai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
