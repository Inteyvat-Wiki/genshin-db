			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "Aku benar-benar berterima kasih atas bantuanmu. Jika aku pergi sendiri, pastinya akan membutuhkan waktu berjam-jam sampai semuanya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180502,
					"content": "Aku tidak ingin meninggalkan kakek Jiangcheng sendirian sebelum festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180503,
					"content": "Bagaimana denganmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Aku... akan kembali ke tempat penggilingan. Ada masih banyak pekerjaan yang harus dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180505,
					"content": "Aku mewarisi tempat penggilingan itu sejak ayahku meninggal. Aku bahkan meninggalkan pekerjaanku di Pelabuhan Liyue untuk melanjutkan tradisi keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180506,
					"content": "Bagaimana mengatakannya ya... tapi mengerjakan sesuatu yang biasa dikerjakan ayahku, dengan lingkungan yang sama, benar-benar membuatku bernostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180507,
					"content": "Terutama pada saat Festival Lantern Rite seperti ini, aku selalu memikirkan mengenai banyak hal yang ayahku katakan padaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180508,
					"content": "Oh, aku hampir lupa. Karena terlalu memikirkan Kakek Jiangcheng, aku jadi lupa membuat Lentera Xiao untuk diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180509,
					"content": "Masalahnya aku tidak punya bahan-bahannya lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180510,
					"content": "Aku khawatir tidak bisa menyelesaikannya tepat waktu jika aku mencari bahan-bahannya sekarang... Pengembara, apa kamu bersedia mengumpulkan beberapa bahan untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718180511,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Bai"
				}
			]
		},
