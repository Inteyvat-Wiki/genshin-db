			"dialogs": [
				{
					"id": 752475001,
					"content": "Yang penting, apa kamu senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Wah, bos! Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Kuanggap itu sebagai iya. Selamat ulang tahun, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Tapi ngomong-ngomong, kenapa kamu tidak kasih tahu aku dulu? Ayolah, bos. Katanya kita sahabat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha, jujur saja aku hanya penasaran apa kamu masih ingat tanggal untuk hari peringatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "Ifa, kamu sudah berubah. Bagaimana aku bisa percaya lagi padamu setelah ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Lagi pula aku ingat tanggalnya kok. Aku sudah siapkan madu segar untuk Cacucu. Kalau aku sampai lupa tanggal ini, bisa-bisa kepalaku dipatuk setahun penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Tidak mungkin dong, bos! Kamu paling keren pokoknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
