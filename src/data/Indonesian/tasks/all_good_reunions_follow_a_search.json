					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "Kepalanya sangat bulat dan lembut, kamu merasa ingin terus mengelusnya tanpa henti.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hehe, kayaknya sekarang hoki Paimon udah cukup sampai akhir tahun nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "Pasti bisa, Paimon. Karena kamu punya partner yang sangat spesial di hidupmu, sama seperti Cacucu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "Ke-Kenapa lihat aku begitu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Jadi ini rencanamu sejak awal, kan? Saatnya mengaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Heh? Maksudnya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Tunggu, jadi keberuntungan Cacucu itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Sudah, sudah. Tidak apa-apa, kan? Tentu saja dia beruntung karena punya sahabat sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Sudah jangan menghindar lagi. Kamu yang mengatur semuanya dari awal, kan? Acara memancingnya, petak umpetnya, semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Itu berarti kamu sudah kenal petualang dari Mondstadt itu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "Tidak juga. Aku hanya bertemu dengannya satu hari lebih cepat darimu, lalu aku minta petunjuk saja darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "Dan aku mengaku memang aku yang mengatur semuanya. Mulai dari gambar-gambarnya agar Cacucu bisa bermain dengan Asha dan Capybara-nya. Lalu Gift Egg itu juga ideku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Wow, bos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha, tapi si Capybara King itu malah salah kaprah. Tapi namanya juga hewan liar, pasti sulit mengerti maksud kata-kataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Kurasa dia kira kita mau mengambil barang-barang yang sudah kusiapkan untuk Cacucu, makanya dia marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Oh, jadi namanya memang benar Capybara King ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Tentu saja bukan, aku hanya pakai julukan darimu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Wah, bos! Aku jadi terharu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "Yah pokoknya begitu deh! Kebetulan ini sudah dekat hari peringatan aku bertemu dengan Cacucu, jadi aku mau membuat sesuatu yang spesial buat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Kami tidak tahu ulang tahun Cacucu, jadi kami selalu pakai hari peringatan ini sebagai alasan untuk merayakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Cacucu mungkin terlihat seperti Saurian yang dewasa, tapi sebenarnya dia seperti anak kecil yang suka main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Aku tahu kamu hanya ingin main sampai puas. Jadi, tidak perlu sungkan lagi, main saja, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Bos-bosku ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Oh, kamu mau bilang sesuatu, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Duh, bos, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Tidak perlu bilang kami juga tahu kok. Kami juga sayang padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Iya, jangan malu-malu begitu, bos. Selagi kita di resor ini, kamu bisa bebas seperti Qucusaurus liar. Pokoknya tinggal main saja sepuas hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Selamat hari jadi, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Bos-bosku semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Semuanya berkat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "Biar yang bagus disisakan terakhir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
