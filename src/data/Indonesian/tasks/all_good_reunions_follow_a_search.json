			"dialogs": [
				{
					"id": 752470301,
					"content": "*huff* Akhirnya berhasil! Capek juga ya ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "\"Cacasha\""
				},
				{
					"id": 752470303,
					"content": "#Ah, kamu pasti Cacasha! Kamu sama Cacucu itu cocok banget! Sama kayak Paimon dan {NICKNAME} ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Hebat, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "Benar, kan? Kalau mereka sudah bergabung, mereka jadi tak terkalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, kurasa kamu sudah resmi dapat sertifikat \"ilmu menyamar\". Mulai sekarang kamu sudah boleh sebut diri sendiri Penyamar Ulung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "Wow! Kamu memang paling keren, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "Heh? Aku apa dong? Kan aku yang paling sering menemanimu main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470309,
