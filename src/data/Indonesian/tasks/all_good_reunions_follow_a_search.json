			"dialogs": [
				{
					"id": 752475101,
					"content": "Halo lagi, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Tadinya aku mau bilang kalau Ifa salah tanggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Tapi aku tahan diri saja. Kurasa ini juga bagian dari menjadi dewasa ya, tahu hal apa saja yang harus ditahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
