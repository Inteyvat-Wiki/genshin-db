					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Ini sih sudah hampir namanya! Duh ... enggak, salah. Ini baru awalnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
