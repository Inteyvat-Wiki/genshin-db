					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Fuwaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Jangan! Lautnya terlalu berbahaya! Lagian kamu enggak mungkin bisa menyusulnya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
