				},
				{
					"id": 750150406,
					"content": "#Tunggu, ini masih belum selesai! Kita harus tunggu {NICKNAME} selesai masak dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Kalau ikannya sudah dipanggang, semua orang bisa duduk dan makan.",
