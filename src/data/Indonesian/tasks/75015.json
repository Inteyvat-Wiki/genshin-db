				},
				{
					"id": 750150503,
					"content": "Sayangnya, permukaan airnya tidak bergerak dan tanpa ada riak sedikit pun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
