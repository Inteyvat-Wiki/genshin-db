					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Nguk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Ayo! Kamu pasti bisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Hei, jangan berisik dong ... jadi keganggu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Eh?! Umpannya dimakan tuh! Ayo tarik! Paimon mau lihat dapat ikan apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Hah ...? Ini kok kayaknya bukan ikan, malahan dapat botol! Terikat diikat di papan kayu di tempat mancing segala ... Ugh, yah tapi kan {NICKNAME} juga kadang suka mancing barang-barang aneh ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Kamu kayaknya bisa mancing apa saja kecuali ikan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "#Hei, {NICKNAME} juga selalu dapat banyak barang aneh! Ya sudah, Paimon sudah keburu mancing, yuk kita lihat dalamnya kayak gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Jangan-jangan barang-barang ini ditinggalin sama mereka berdua tadi? Orang-orang yang terobsesi sama area mancing sini ngeri juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Kayaknya mereka pakai botol ini buat kirim pesan ke yang lain ... Yuk kita lempar lagi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Paimon punya firasat yang berikutnya pasti ikan besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "Joran pancing tiba-tiba melengkung ke bawah dan mulai bergetar hebat.\\nSepertinya sesuatu yang besar dan berat di bawah sana memakan umpannya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Akhirnya! Pasti ikan gede ... Ayo sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Oke, ikan besar! Ayo ayo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "Ngu-Nguuuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Melihat Paimon yang kesulitan,\\nkamu dan {REALNAME[ID(2)|SHOWHOST(true)]} langsung memegangnya ....\\nTapi joran pancing terus ditarik oleh kekuatan yang luar biasa ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Akhirnya, terdengar suara 'plop', dan ikan itu pun kabur ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*hiks* Pasti ikan gede tuh, kalau enggak mana mungkin bisa kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
