					"content": "Kamu peka juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "Hei, kamu membuatku malu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110708,
					"content": "Tapi satu-satunya benda lain di sini adalah mesin dengan baju Inazuma tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110709,
					"content": "Mungkinkah ini peringatan untuk mesin tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110710,
					"content": "Mungkin dulu mesin itu pernah melakukan sebuah ritual untuk peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110712,
					"content": "Semua yang ada di sini menunjukkan bahwa dulu ada manusia tinggal di sini. Namun, tetap tidak cukup bagi kita untuk menyimpulkan peradaban macam apa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110713,
					"content": "Dan sampai sekarang, kita masih belum melihat adanya manusia atau kuburan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110714,
					"content": "Master Jean, boleh tidak aku pergi ke sana dan melihat-lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110715,
					"content": "Boleh, tapi hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110716,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110717,
					"content": "Berapa banyak rahasia yang tersimpan di pulau ini?",
