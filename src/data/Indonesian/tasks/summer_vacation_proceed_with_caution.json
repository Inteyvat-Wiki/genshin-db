			"dialogs": [
				{
					"id": 400110201,
					"content": "Apa arti dari pelampung-pelampung tersebut...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "Tentang kepulauan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Kepulauan ini terisolasi dari dunia luar, mirip seperti Domain rahasia yang tercipta secara alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "Kita semua dipandu ke sini oleh sepucuk surat serta dengan bantuan Venti dan Dvalin... Semuanya seperti terlalu kebetulan. Aku sedikit khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "Tapi aku berada di sini untuk melindungi kalian semua, jadi jangan khawatir. Apa yang akan terjadi, terjadilah. Aku akan menghadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "Tentang baju musim panasmu...",
