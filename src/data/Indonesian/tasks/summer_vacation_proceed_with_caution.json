					"nextDialogs": [
						400110722
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110722,
					"content": "Sebuah surat yang membimbing kita untuk mengaktifkan mekanisme di kepulauan terpencil... aneh.",
