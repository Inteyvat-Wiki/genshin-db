					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "Klee masih terlalu muda untuk merasakan adanya bahaya. Pengembara, kita semua harus tetap waspada dalam situasi begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110719,
					"content": "Sejujurnya, aku pikir surat itu awalnya lelucon saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110720,
					"content": "Kita juga berpikir begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
