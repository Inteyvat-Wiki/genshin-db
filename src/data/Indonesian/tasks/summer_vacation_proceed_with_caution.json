						400110703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110703,
					"content": "Lihat batu-batu yang ditumpuk ini lalu ada bunga kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110704,
