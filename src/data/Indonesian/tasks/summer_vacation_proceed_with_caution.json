				{
					"id": 400110624,
					"content": "Benar, benar, Dodo-King mungkin ketiduran. Dia kan sudah menunggu lama untuk kedatanganmu lalu *hoam* — waktunya istirahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Ayo kita pergi temani Klee bermain di tempat lain dan kembali saat Dodo-King sudah bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110626,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110627,
					"content": "Tentu saja! Percayalah pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110628,
					"content": "Hm... Tidak, aku tahu sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110629,
					"content": "Ini bukan Dodo-King. Dodo-King yang sebenarnya ada di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110630,
					"content": "Eh? Be-benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110631,
					"content": "Aku tidak akan menyerah. Dodo-King, tunggulah! Kami akan menemukanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110632,
					"content": "Dia pergi deh... Wow, energinya benar-benar banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110633,
					"content": "Klee, tunggu kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
