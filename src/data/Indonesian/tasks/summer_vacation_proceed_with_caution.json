			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ahh... Cuacanya bagus sekali, rasanya Paimon seperti sedang bermimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "Selamat pagi! Woah, ada apa dengan pakaian kalian!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Hehe! Bagaimana, bagus tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "Kami semua mengganti pakaian menjadi pakaian musim panas loh! Walaupun bukan datang ke sini untuk bermain, tapi kita tidak boleh melewatkan hari musim panas di tepi laut yang indah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "Ti-tidak terlihat aneh, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "Pakaian ringan dengan suasana musim panas ini pasti tidak cocok untukku... Ah, hehe... maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "Tidak kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "Benarkah...? Terima kasih, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "Kaget juga melihat Master Jean akan menyiapkan pakaian musim panas secara khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Tidak, kakakku tidak akan mungkin menyiapkan semua ini sendiri. Lisa dan akulah yang memilih pakaian untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "Langsung menceploskan \"kakak\" dan tidak menyadarinya sama sekali... Barbara sudah mulai mabuk musim panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "Ada cerita yang cukup panjang untuk pakaian musim panas ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "Aku kira kantong yang diberikan Lisa berisi semacam alat darurat. Tak kusangka isinya adalah satu set pakaian musim panas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "Semua aksesori ini juga... Pasti buatan tangan Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Semua orang di Knights of Favonius selalu berusaha membuatku berlibur. Kurasa aku sudah terlalu memaksakan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "Semuanya, ayo ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "Itu suara Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "Aku melihat benda aneh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "Hah? Ada apa? Apa maksudmu \"ada benda aneh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "Lihat lautnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "Lihat kan? Ada benda aneh yang mengapung di atas air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "Alat panjang dan tipis itu... Sepertinya pelampung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "Tapi kita tidak melihat apa pun saat sampai di sini kemarin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "Pasti Dodo-King yang meletakkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Alat aneh yang tiba-tiba muncul dalam semalam. Sepertinya ada yang tidak beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Dia tidak pernah datang mencari Klee. Apa ini berarti dia tidak mengakuiku? Atau mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "Mungkin pelampung-pelampung ini adalah petunjuk dan dia menungguku untuk menemukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "Jadi itukah alasan kenapa pelampung-pelampung tersebut tiba-tiba muncul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "Ayo kita lihat lebih dekat dan cari tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Setuju. Kita tidak akan menemukan solusinya kalau hanya menebak dari tepi pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "Apa tidak apa-apa kalau kita ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "Mungkin, tapi kita tetap harus menyelidiki pelampung-pelampung tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "Sulit untuk mengatakan hal apa yang menunggu kita di laut. Tapi untuk berjaga-jaga, persiapkanlah diri untuk bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "Setelah siap, berkumpullah di sini dan kita akan pergi bersama ke sana dengan kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "Memang Master Jean yang bisa diandalkan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "Ti-tidak kok. Ini kan tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "Kalau begitu, aku percayakan tugas persiapan kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "Bahkan saat memakai pakaian musim panas pun juga bisa diandalkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "Kamu terlihat luar biasa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
