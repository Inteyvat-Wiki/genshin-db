					"nextDialogs": [
						400110724
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110724,
					"content": "Kak Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "Klee"
				},
