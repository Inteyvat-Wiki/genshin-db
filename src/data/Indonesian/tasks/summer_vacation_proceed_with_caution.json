					"nextDialogs": [
						400110723
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110723,
					"content": "Aku jadi penasaran apakah ini jebakan yang sengaja disiapkan. Kita harus tetap waspada.",
