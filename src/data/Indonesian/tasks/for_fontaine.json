			"dialogs": [
				{
					"id": 742490101,
					"content": "Aku merasa tidak enak kalau harus berikan semua pekerjaan ini padamu lagi, Nona Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Tidak masalah. Cuma ini yang bisa kulakukan, mengingat dukunganmu belakangan ini selama Festival Film Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490103,
					"content": "Oh, tidak kok! Yang hebat itu para aktornya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Apakah kamu tidak berencana untuk kembali tampil, Nona Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490105,
					"content": "Yah ... bukan berarti tidak bisa sih ... Tapi sekarang, aku lebih suka bekerja di balik layar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Jujur saja, waktu aku masih tinggal di Fontaine, aku saja tahu siapa kamu. Artis superstar nomor satu, Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490107,
					"content": "Ugh, tolong ya! Apa pun yang terjadi, jangan bilang kamu \"tumbuh dewasa sambil menonton penampilanku\" ... Aku jadi canggung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Oh, tidak usah khawatir. Aku cuma mau bilang, waktu aku tinggalkan Fontaine, bisa melihatmu seperti dulu itu kehormatan bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490109,
					"content": "Tapi setelah bertemu lagi setelah sekian lama, kurasa aku lebih suka melihat dirimu yang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490110,
					"content": "Huh ...? Diriku yang sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Iya. Dulu ekspresimu di panggung selalu tegang, tapi sekarang kamu lebih rileks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490112,
					"content": "Haha ... Terima kasih. Aku memang lebih menikmati hidup akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "Bagaimana denganmu, Nona Guillotin? Apa kamu puas dengan hidupmu sekarang? Dibandingkan dengan saat kamu pergi dari Fontaine, maksudku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Semuanya lancar kok, meskipun aku rasa itu karena aku mengubah pola pikirku. Jujur, aku selalu suka dan menganggap Fontaine sebagai rumahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490115,
					"content": "Bukan berarti lebih baik dari bangsa lain ya, tapi tempat ini menyimpan banyak kenangan. Kehidupan di sini setenang air diam, tapi juga penuh dengan perubahan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490116,
					"content": "Akhir-akhir ini, aku belajar untuk melihat sisi positif kehidupan. Kurasa orang-orang di tempat lain juga memandang tanah air mereka dengan cara yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490117,
					"content": "Wah, indah sekali, Nona Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Ini mungkin sedikit melanggar etiket pesta teh, tapi aku mau bersulang ... untuk Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha ... Demi kampung halaman kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
