			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! Aku tidak akan pernah bosan minum teh santai di sore hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490204,
					"content": "Ya ampun ... Waktu menyenangkan selalu berlalu dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
