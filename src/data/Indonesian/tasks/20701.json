			"dialogs": [
				{
					"id": 207010101,
					"content": "Kenapa aku sudah lapar lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Oh, kamu! Bagus sekali. Apakah kamu masih ingat denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Xiangling, perlombaan memasak? Ini aku, Siegfria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Hehe, apakah kamu sudah ingat sekarang? Kamu datang tepat waktu. Bisakah aku... meminta tolong sesuatu padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Minta tolong apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Apakah kamu masih ingat Jade Parcel yang kamu buat sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "Itu sangat lezat, aku bahkan masih ingat rasanya sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "Jadi, aku ingin mencoba memasak sendiri, tapi... rasanya selalu ada yang kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Aku pikir kalau aku bisa mencobanya beberapa kali lagi, aku bisa membuat masakan dengan rasa yang sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Jadi, bisakah kamu membuatkan Jade Parcel untukku mencobanya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
