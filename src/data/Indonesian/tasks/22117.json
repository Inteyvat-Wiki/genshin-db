			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "Kamu ini! Kenapa kamu tidak berpakaian lebih tebal? Aku akan merasa bersalah kalau kamu masuk angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170302,
					"content": "Nenek, apakah ini barang yang nenek jatuhkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Coba aku lihat... Ya, ya benar, ini barang yang kucari. Ternyata terjatuh di atas gunung... Daya ingatku ini benar-benar sudah tidak bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170304,
					"content": "Jangan dilihat lagi, anak-anak. Benda di dalam kotak ini tidak penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170305,
					"content": "Ini, ambillah ini. Terima kasih telah membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170306,
					"content": "Aku harus cepat-cepat memasukkan kotak ini ke dalam poci. Kalau tidak, aku bisa lupa lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
