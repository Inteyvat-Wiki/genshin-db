			"dialogs": [
				{
					"id": 221170401,
					"content": "Kamu ini! Kenapa kamu tidak berpakaian lebih tebal? Aku akan merasa bersalah kalau kamu masuk angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170402,
					"content": "Amber-amber itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Amber-amber itu dibuat oleh temanku. Dia bilang amber-amber itu digunakan untuk menghadang monster dan pencuri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170404,
					"content": "Bertahun-tahun sudah berlalu... Sampai sekarang, amber-amber di atas masih mengurung makhluk-makhluk aneh di dalamnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170405,
					"content": "Ugh, benar-benar cairan yang mengerikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170406,
					"content": "Pocimu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Oh, terima kasih banyak! Akhirnya pociku bersih lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170408,
					"content": "Kali ini aku datang mengambil barang, tujuan utamanya adalah untuk membersihkan poci ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170409,
					"content": "Setelah dibersihkan dan berkilau kembali, poci ini bisa dipakai lagi untuk menyuguhkan teh kepada para tamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		}
	]
