			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Duh, jangan bilang kalau aku meninggalkannya di atas gunung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170102,
					"content": "Ne-nenek, kok bisa ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Duh, duh, duh... Dua anak ini kenapa bisa ke sini? Benar-benar kebetulan. Loh, kenapa kamu berpakaian begitu tipis? Di luar begitu dingin, hati-hati masuk angin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170104,
					"content": "Aku baru saja menemui teman lama di \"Mt. Hulao\". Kami mengobrol lama mengenang masa muda kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170105,
					"content": "Waktu dalam perjalanan pulang, aku tiba-tiba teringat kalau ada barangku yang hilang. Sepertinya aku menjatuhkannya di atas gunung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170106,
					"content": "Tapi aku sudah tua dan tidak mampu berjalan begitu jauh lagi. Apalagi di atas gunung ada banyak batu amber yang mengganggu jalan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170107,
					"content": "Anak-anak, apa kalian bisa membantuku naik ke Mt. Hulao dan mengambilkan barangku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170108,
					"content": "Siapa teman nenek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "Dia tinggal di atas Mt. Hulao, kalian seharusnya sudah pernah bertemu dengannya. Amber yang dia pasang itu sangat merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170110,
					"content": "Aku juga salah karena aku suka lupa. Aku lupa memasukkan kotak itu ke dalam poci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170111,
					"content": "Barang apa yang nenek lupakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Harusnya... sebuah kotak. Ingatanku tidak begitu baik. *huff* Kalau saja aku memasukkan kotak itu ke dalam poci, tidak akan ada masalah sebesar ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170113,
					"content": "Tapi kalau benar kotak itu jatuh di Mt. Hulao, maka ada kemungkinan besar kotak itu terperangkap di antara batu-batuan Amber. Kalian tidak akan kesulitan mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170114,
					"content": "Anak-anak, tolong bantulah nenek yang sudah tua ini. Naiklah ke Mt. Hulau dan carikan aku kotak itu di antara bebatuan amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170115,
					"content": "Oh ya, kalian harus berhati-hati. Bertahun-tahun sudah berlalu dan entah apa yang sudah terperangkap di dalam bongkahan amber itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
