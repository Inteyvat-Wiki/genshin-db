			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#Xilonen? {NICKNAME} dan Paimon, kalian berdua ke sini juga? Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060202,
					"content": "Ororon? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060203,
					"content": "Kamu sudah sehat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "Terima kasih perhatiannya. Nenek maksa aku istirahat dan minum obat pahit selama berhari-hari. Sekarang sudah jauh lebih mendingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060205,
					"content": "Hai Ororon! Mau bantu Xilonen nangkepin Aphid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060206,
					"content": "Aphid? Oh ... jadi kalian toh yang menculik si Manis Seratus Persen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060207,
					"content": "Pantas saja si Manis Ekstrem dan si Anehnya Kok Manis juga hilang ... semuanya ulah kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060208,
					"content": "Uh ... itu nama Aphid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060209,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060210,
					"content": "Biar gampang dibedain. Aku tidak menghakimi sih, mereka tetap keren meski tidak bisa produksi madu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060211,
					"content": "Jadi ... Aphid ini ... peliharaan kamu semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060212,
					"content": "Ah, kalau dibilang \"pelihara\" sih kayaknya kurang tepat ya. Aku tidak banyak campur tangan yang mengganggu perilaku alaminya, cuma kebetulan saja tinggal di wilayah yang sama. Anggap saja semacam simbiosis gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060213,
					"content": "Uh, maaf, aku tidak tahu sama sekali. Tapi mereka semua kena kontaminasi Abyss, dan mulai ada pengaruhnya ke suku sini. Jadi kami bereskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060214,
					"content": "Iya, betul! Dan kami enggak apa-apain juga kok, sungguh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060215,
					"content": "Oh ya? Baguslah. Tenang, bukan masalah besar kok ini. Justru aku sendiri datang untuk urus itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060216,
					"content": "Tapi biar jelas dulu ya, Aphid ini bukannya kena kontaminasi. Mereka sendiri yang sengaja makan kekuatan Abyss, pintar kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060217,
					"content": "HAH? Sengaja?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060218,
					"content": "Iya. Sedikit-sedikit, kadang-kadang. Dan sedikit itu cukup untuk bikin mereka jadi segede gitu, tapi tidak cukup untuk bikin mereka kehilangan nyawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060219,
					"content": "Setelah sekian lama berlalu, mereka akan terbang jauh, lalu bikin Mutiara Madu Phlogiston yang mengandung kontaminasi Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060220,
					"content": "Cangkang luar mutiara berfungsi sebagai penghalang kontaminasi. Dengan cara ini, mereka perlahan-lahan membersihkan kekuatan Abyss di tempat tinggalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060221,
					"content": "Prosesnya harus terus diulang sampai bersih semua, tapi mereka ini makhluk yang sangat sabar. Anggap saja semut yang lagi pindahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060222,
					"content": "Oh, jadi mereka cuma ... melindungi tempat tinggalnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060223,
					"content": "Ini pertama kalinya aku dengar cerita begini. Jadi bahkan makhluk kecil pun tahu kalau tanah airnya diserbu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060224,
					"content": "Iya, Manis Seratus Persen dan yang lain berjuang juga loh! Mereka semua Aphid jagoan, kuat dan perkasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060225,
					"content": "Yah, pantesan tempat ini disebut \"Bangsa Peperangan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "Tapi Ororon, kenapa kamu bisa tahu tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060227,
					"content": "Oh, soalnya aku kasih mereka makan biji Numberry. Biji itu enggak bisa dicerna, jadi tak lama juga pasti bakal dikeluarkan sebagai kotoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060228,
					"content": "Setelah bijinya menyentuh tanah, tumbuhnya cepat banget. Tidak lama juga semaknya lebat dan berbuah. Setelah itu, aku tinggal ikuti saja jalur semaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060229,
					"content": "Lalu aku mengumpulkan Mutiara Madu yang mereka buat, musnahkan, lalu pakai Numberry lagi buat bawa mereka pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060230,
					"content": "Tapi kali ini sepertinya proses itu sudah dilakukan ya, dan kalian tidak menyiksa mereka juga. Makasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060231,
					"content": "Pantesan bisa ada Numberry di situ! Paimon sudah mikir sampai jauh banget, benar-benar bingung kenapa bisa ada kondisi kayak gitu, ada konspirasi macam apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060232,
					"content": "Ah? Aku bikin masalah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060233,
					"content": "TIDAK kok, tidak sama sekali! Santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060234,
					"content": "Ororon, kami akan kembalikan semua Aphid pembersih Abyss ini ke tempatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060235,
					"content": "Bagus banget kalau bisa gitu. Mereka ini makhluk hidup yang pegang peranan penting, harus diperlakukan dengan baik juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060236,
					"content": "Nah, berarti masalahnya sudah selesai ya. Sampai ketemu lagi, silakan kalau mau main ke tempatku. Aku akan bawa kalian tengok teman-teman baik yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060237,
					"content": "Mau dong. Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "Fiuh, enggak nyangka akhirnya ternyata kayak gini. Si Ororon tuh memang jago banget ya bikin kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060239
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060239,
					"content": "#Makasih {NICKNAME}, makasih Paimon. Enggak ada kalian, enggak ramai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060240
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060240,
					"content": "Ini buat kalian, Mutiara Madu Phlogiston murni yang tidak terkontaminasi. Tenang, ini murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060241
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060241,
					"content": "Anggap saja kenang-kenangan. Untuk mengingat jasa para pejuang mini yang juga ikut berperang membela Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		}
	]
}