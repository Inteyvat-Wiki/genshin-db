			},
			"dialogs": [
				{
					"id": 755060101,
					"content": "Hei, kalian datang juga. Ini tempat terakhir Abyssal Aphid terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060102,
					"content": "Jadi, begitu yang ini berhasil ditangkap, urusan kita kelar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060103,
					"content": "Iya. Kalaupun ada beberapa yang kabur juga tidak masalah. Nanti biar aku cari waktu buat tangkap mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060104,
					"content": "Ada kabar dari suku kalau keadaan para pasien sudah berangsur membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060105,
					"content": "Oh bagus dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060106,
					"content": "Tapi ada satu hal yang sangat disayangkan. Konspirasinya Paimon ternyata tidak terjadi tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060107,
					"content": "Sepertinya buah-buah itu tumbuh dengan sendirinya di tempat berkumpulnya Aphid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060108,
					"content": "Em ... Paimon enggak pernah nyangka bakalan ada Fatui ... atau Treasure Hoarder ... atau siapa gitu dalang di balik semua ini ... Tapi sebagai pemandu hebat kan Paimon harus tetap waspada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060109,
					"content": "Aku yakin Paimon cukup waspada kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "Hehe, ya iya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060111,
					"content": "Oke deh, yuk cepat kita bereskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060112,
					"content": "Oke! Tim Pemburu Serangga, gas! Waktunya pertarungan terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
