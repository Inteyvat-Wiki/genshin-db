			"dialogs": [
				{
					"id": 742480101,
					"content": "Nona Columbina, Nona Sandrone! Terima kasih sudah meluangkan waktu untuk bergabung dengan Sandiwara Meja kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "Tidak masalah. Kami belum pernah memainkan ini sebelumnya, jadi kami mengandalkanmu untuk menunjukkan caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480103,
					"content": "Jangan khawatir, tidak perlu tegang. Yang paling penting, semua orang bisa menikmatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "Bagus! Aku sudah tidak sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480105,
					"content": "Kalau begitu, biar kujelaskan alur ceritanya secara singkat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "\"Ini adalah era saat vampir dan manusia hidup berdampingan. Kisah kita terjadi di sebuah kota yang dihuni oleh kedua ras ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 742480107,
					"content": "\"Meskipun tidak bermusuhan secara terbuka, hubungan antara manusia dan vampir tidak bisa dibilang harmonis. Kini, pembunuhan yang terjadi di tengah malam telah menghancurkan keseimbangan yang rapuh ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 742480108,
					"content": "Vampir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480109,
					"content": "Mereka adalah ras yang bertahan hidup dengan menghisap darah manusia. Ini adalah tema yang cukup umum dalam novel fantasi. Nona Columbina, apa kamu pernah membaca cerita seperti ini sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Hmm, sepertinya pernah. Lalu, apa peran kita dalam cerita ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480111,
					"content": "Pertama, setiap orang harus memutuskan karakter yang ingin diperankan. Kamu bebas memilih identitas dan profesi apa pun, selama sesuai dengan latar ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Karakter yang ingin aku perankan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480113,
					"content": "Kalau bingung memilih, kamu bisa bekerja sama dengan orang lain dan biarkan mereka yang menentukan karaktermu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Oh? Maksudmu ... minta orang lain membuat latar belakang karakter kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480115,
					"content": "Oh! Seru sekali! Kita pakai cara itu saja! Lembar karakterku aku serahkan padamu, Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Kalau begitu kamu yang tentukan karakterku, Sandrone, aku akan pikirkan peran yang sempurna untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480117,
					"content": "Hah ... Boleh juga. Aku juga bingung mau pilih profesi apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480118,
					"content": "Semuanya sudah selesai? Hehe, aku sudah tidak sabar mau lihat punyaku ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "\"Aku adalah pedagang keliling yang berdagang di kota tempat vampir dan manusia hidup berdampingan ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Pedagang Keliling"
				},
				{
					"id": 742480120,
					"content": "... Tunggu dulu. Game Master, lembar karakter ini mencurigakan sekali, mirip dengan yang dulu punyaku ... Bahkan status karakternya sama! Kamu cuma salin ulang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "Apa pun yang aku kasih, kamu pasti tetap ketemu cara aneh untuk kacaukan ceritanya. Lagi pula, karakter yang cerdik dan heboh seperti ini sudah sangat cocok sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "... Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Coba kulihat, aku jadi siapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480124,
					"content": "\"Aku vampir jahat yang mengerikan. Di siang hari, aku suka tidur di rumah, aku hanya keluar untuk berjalan-jalan di taman di malam hari saat bulan sedang bersinar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "\"The Damselette\"",
					"speakerSubtitle": "Vampir Jahat"
				},
				{
					"id": 742480125,
					"content": "\"Aku suka bernyanyi, dan aku memanfaatkan suaraku untuk memancing mangsaku. Tidak ada yang pernah menatap mataku dan hidup untuk melihat matahari terbit.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "\"The Damselette\"",
					"speakerSubtitle": "Vampir Jahat"
				},
				{
					"id": 742480126,
					"content": "Hmm ... Apa begitu pandanganmu terhadap diriku, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480127,
					"content": "Hehe, cocok denganmu, kan? Lagian, itu karakter yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480128,
					"content": "Baiklah, tapi aku tetap ingin jadi vampir yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480129,
					"content": "Terserah kamu saja. Nah, sekarang giliranku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480130,
					"content": "\"Aku adalah wanita anggun dan bangsawan yang suka mengutak-atik berbagai penemuan di kamarku. Aku tidur malam sekali, dan jadwalku sangat tidak teratur ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Pemburu Vampir"
				},
				{
					"id": 742480131,
					"content": "Hei! Perkenalan macam apa itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480132,
					"content": "Hmph ... \"Tapi aku juga seorang pemburu vampir. Saat ada orang di kota yang berada dalam bahaya, aku menggunakan penemuanku untuk menyelamatkan mereka ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Pemburu Vampir"
				},
				{
					"id": 742480133,
					"content": "... Hah? Ini sama sekali tidak mirip denganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480134,
					"content": "Kamu tidak setuju? Menurutku sih mirip sekali denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480135,
					"content": "Tapi berdasarkan pengenalan ini, berarti karakter Nona Columbina dan Nona Sandrone harus jadi musuh bebuyutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Pedagang Keliling"
				},
				{
					"id": 742480136,
					"content": "Hmm, sepertinya cerita ini akan berkembang dengan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 742480137,
					"content": "Oh! Aku sudah tidak sabar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Pedagang Keliling"
				},
				{
					"id": 742480138,
					"content": "Hah ... Aku rasa cerita ini akan menimbulkan banyak masalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Pemburu Vampir"
				},
				{
					"id": 742480139,
					"content": "Kamu khawatir bagaimana akhir semua ini kan, Sandrone? Apa karena aku vampir jahat yang menghisap darah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "\"The Damselette\"",
					"speakerSubtitle": "Vampir Jahat"
				},
				{
					"id": 742480140,
					"content": "Hah! Satu-satunya yang aku khawatirkan cuma kehilangan kesempatanku untuk menghajar karaktermu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Pemburu Vampir"
				}
			]
		},
