			"dialogs": [
				{
					"id": 742480201,
					"content": "Permainan Sandiwara Meja ini memang menyenangkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480204,
					"content": "Ya. Kurasa vampir jahat ini juga harus pulang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 742480203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
