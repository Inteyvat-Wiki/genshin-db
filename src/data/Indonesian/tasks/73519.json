			"dialogs": [
				{
					"id": 735190101,
					"content": "Dasar aneh ... padahal dia yang punya ide untuk ke kafe dan menulis laporan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Kamu kok sendirian di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "Huh, sudahlah lupakan. Dia malah menulis laporannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Seharusnya kami bertemu di kafe kemarin. Tapi dia lama sekali baru muncul. Lalu, dia pun tidak membawa pulpen atau kertas untuk menulis laporannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Aku mengkritiknya karena membuang-buang waktu yang seharusnya bisa kami gunakan untuk menulis laporan. Lalu, dia malah marah! Terakhir dia bilang kalau laporannya akan dia tulis sendiri, terus dia mengusirku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "Benar-benar tidak masuk akal, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Tapi sudahlah, lagi pula aku sudah terbiasa dengan temperamennya. Paling-paling beberapa hari kemudian juga sudah normal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Coba saja kalau mengendalikan emosinya itu semudah mengotak-atik mesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Semangat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Hah? Kok kamu juga jadi agak aneh ... lupakanlah. Masih ada beberapa Wenut di sekitar sini yang terkena pengaruh. Tapi kalau dibiarkan saja pun, nanti mereka perlahan-lahan akan mereda sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Tapi kalau kamu sempat, tolong amankan para pejalan yang melintas dari kemungkinan bahaya ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Ngomong-ngomong, sekarang lingkungan elemen dan perangkat pengisi dayanya sudah kembali normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Sekarang adalah kesempatan terbaik untuk merasakan kekuatan penuh Meriam Wenutslayer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Semoga keberuntungan besertamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Mana Shriya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}