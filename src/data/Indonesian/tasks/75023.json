			"dialogs": [
				{
					"id": 750230201,
					"content": "#{NICKNAME}, lihat, lihat! Ada kamera dan peralatan panggung juga di sini! Jangan-jangan ini tempat syuting ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230202,
					"content": "#Tapi ... rumah-rumahnya kecil banget! {NICKNAME} jadi kayak raksasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230203,
					"content": "Nguk, nguuuk ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "Kurcaci ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "Cocok dong buat Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "Fuwaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "Hehe, kita sudah beneran jadi orang \"besar\" ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230208,
					"content": "Ih, kalau Paimon tinggal di sini, gerak dikit saja rumahnya pasti langsung runtuh. Mau menggeliat sedikit saja juga enggak bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230239,
					"content": "Seorang Natlan bergabung ke dalam percakapan dengan sangat alami ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "Oh! Kalian tertarik dengan film? Kalau begitu tolong bantu aku, Akatanga, untuk sebarkan tren baru ini ke seluruh Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230210,
					"content": "Nguk, nguuk, NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} kok senang banget? Setuju sama dia ya? Suka film juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230212,
					"content": "Nguuuuuuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "Si kecil ini punya selera yang bagus! Sejujurnya semua yang di sini disiapkan untuk membuat seekor Tepetlisaurus jadi bintang masa depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230214,
					"content": "Sayangnya Tepetlisaurus-nya dibawa pergi sama temanku. Kami bertengkar hebat karena punya pendapat kreatif yang berbeda. Setelah itu dia lari sama aktor utamanya *huff* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230215,
					"content": "Harusnya tidak boleh kerja bareng teman sih. Proyeknya gagal, temannya malah jadi ikut kabur! Jadi rugi dua kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230216,
					"content": "Tapi tidak apa-apa. Ada Tepetlisaurus kecil lain sekarang. Lihat tuh, dia semangat sekali, aku yakin pasti bisa sukses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230217,
					"content": "Bagaimana? Apa kalian bersedia bantu selesaikan mahakaryaku? Aku bakal kasih imbalan besar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230218,
					"content": "#Kalau si {REALNAME[ID(2)|SHOWHOST(true)]} suka ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "Kedengarannya mirip modus penipuan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "Kalaupun tidak langsung nge-hits, kalian tetap akan dapat imbalan untuk bantuan kalian selama syuting, jadi tidak ada ruginya buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230221,
					"content": "Kalau bantu sih boleh-boleh saja, tapi kami masih belum tahu kamu mau buat film yang gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230222,
					"content": "Konsepnya begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230223,
					"content": "Bzzt, jeng! Jeng! Jeng! Bzzt! Cahaya putih yang menyilaukan itu menghilang, pengunjung yang bulat dan berduri itu tiba di kampung suku. Css ... css ... css ... Dia berhenti sejenak di atas rumput, dan langsung mencium bau gosong! \"Ah! Utusan Xibalba!\" Orang-orang dari suku tersebut menunjukkan ekspresi ketakutan. Bzzt, bzzt, bzzt! \"Dia sudah datang! Makhluk mengerikan yang bahkan tidak punya gigi! Dia mau menelan seluruh suku!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#Pada saat penjahat itu mau melompat ke barisan pertahanan depan suku! Tang! Tang! Bintang penyelamat dengan syal merah di ekornya tiba-tiba muncul. \"Kok bisa ada di sini?\" Cakarnya yang lebih kokoh dari batu obsidian yang bisa menghancurkan batu sekeras apa pun semudah membalikkan telapak tangan, \"Tapi musuhnya lebih licik dan lebih tidak tahu malu, kemungkinan {REALNAME[ID(2)|SHOWHOST(true)]} bisa menang adalah ....\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "\"Aaah!\" Daripada disebut sedang berteriak, itu lebih mirip suara jeritan yang melengking. Penjahat tanpa gigi itu pun mulai bergetar. Cahaya api menembus langit, lalu terdengar suara yang kuat, dan ombak yang bahkan lebih panas daripada Phlogiston cair! Penjahat tanpa gigi itu pun kabur. \"Panas! Panas\" Sisa gelombangnya menyapu suku yang berhasil selamat dari bencana.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "Bintang penyelamat dengan syal merah di ekornya telah pergi diam-diam sejak entah kapan, sama seperti tidak ada yang mengetahui kapan dia datang ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "Jadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230228,
					"content": "Nguk, nguuk, NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "Wah! Ini nih yang mau kulihat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "Ini ... cukup unik sih. Agak susah dipahami ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "Sudah kuduga! Pasti akan ada orang yang tertarik dengan hal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230232,
					"content": "Eh ... Pernah ada orang asing yang bilang padaku, kalau mencolok di antara kerumunan, artinya sudah betul tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230233,
					"content": "#Emm, Paimon enggak gitu paham, tapi selama {REALNAME[ID(2)|SHOWHOST(true)]} suka ya sudah deh. Jadi ... kami harus ngapain nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230234,
					"content": "Sederhana saja. Pertama, atur letak peralatan pertunjukan. <color=#00E1FFFF>Taruh Gentong Kayu dan Umpan Elemen di tempat yang tepat</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230235,
					"content": "Gentong Kayu itu senjata rahasiamu, jadi selama tidak menghalangi karakter utama dan latar, sebaiknya <color=#00E1FFFF>ditaruh di tengah</color>. Kalau Umpan Elemen, bagusnya ditaruh <color=#00E1FFFF>di jalan masuk karakter antagonis</color> ... di pinggir sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230236,
					"content": "#Nanti sewaktu semua aktor ada di sini, nah waktunya bergerak. {REALNAME[ID(2)|SHOWHOST(true)]}, penyelamat kami dengan syal merahnya akhirnya masuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230237,
					"content": "Saat cerita dimulai, kalian berdua harus <color=#00E1FFFF>memandu musuh ke dekat Gentong Kayu</color>, setelah itu, kalian cepat-cepat pergi. Setelah sampai di tempat aman, langsung <color=#00E1FFFF>hancurkan Gentong Kayunya</color>, selesai deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230238,
					"content": "Aku tidak sabar buat liat filmnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
