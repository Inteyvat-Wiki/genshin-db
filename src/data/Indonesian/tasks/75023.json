			"dialogs": [
				{
					"id": 750230701,
					"content": "Fuwaaa, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "Sudah, sudah. Jangan terlalu terburu-buru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230703,
					"content": "Kalau mau jujur ya, tadi aku juga sempat deg-degan loh. Supaya terlihat lebih nyata, jumlah peledaknya aku buat lebih banyak ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230704,
					"content": "Hampir meledak semua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "Fuwawawawawawawanguk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "Pokoknya! Kali ini sudah belajar dari pengalaman, lain kali tidak lagi deh. Terima kasih ya untuk bantuannya. Yuk kita lihat gimana hasilnya yang tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230709,
					"content": "Yang tidak terduga sih, tidak ada bintang penyelamat dengan syal merah di ekor dalam adegan tadi, juga tidak ada musuh yang jahat, juga tidak ada suara ledakan yang mendebarkan. Yang ada hanya ekspresi Akatanga yang terus berubah ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "Aku ... yang jadi pemeran utamanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230711,
					"content": "Terima kasih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "Mana mungkin ... Apa mungkin Kameranya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230714,
					"content": "Yah, memang benar sih ini pertama kalinya aku pakai Kamera. Tapi harusnya ... tidak salah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230715,
					"content": "Loh kok ngomongnya gampang begitu sih! Kerja keras kami tadi kamu anggap apa, hah?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230716,
					"content": "Nguk ... nguuuk ... fuwaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#Jelas-jelas {REALNAME[ID(2)|SHOWHOST(true)]} sudah penasaran banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230718,
					"content": "Maaf! Maaf! Semua salahku. Begini deh. Yang tadi anggap saja latihan. Kali ini yang serius. Aku serius dua puluh ribu kali, biar filmnya jadi film terbagus dalam sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230719,
					"content": "Fuwaaa ... NGUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "Kayaknya kamu lagi semangat ya. Kalau begitu, Paimon anggap kamu bersedia yah. Tapi kali ini jangan sampai salah-salah lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230721,
					"content": "Kalian mengikuti alurnya sekali lagi dan mendapatkan hasil yang diinginkan ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "Mantap! Sempurna! Ini sudah melebihi ekspektasiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230723,
					"content": "Benar-benar ... sudah biasa bagiku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "Selain dari imbalan yang dijanjikan di awal, aku akan berikan foto ini sebagai kenang-kenangan. Hei, ini mahakarya yang aku bangga-banggakan ya. Tentu saja, terima kasih untuk bantuan kalian lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230726,
					"content": "#Wah! {REALNAME[ID(2)|SHOWHOST(true)]} kayaknya keren banget! Mantap nih memang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230727,
					"content": "Fuwaaa, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#Hehe, kayaknya {REALNAME[ID(2)|SHOWHOST(true)]} juga puas banget deh. Kalau begitu, semuanya beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230724,
					"content": "Jadi, mana bonus yang dijanjikan tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "Kamu ... pernah pakai Kamera tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "Bahkan aku ngerasa sedikit bahaya tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "Iya tuh! Kalau sampai ada yang terluka, atau kebakaran, gimana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
