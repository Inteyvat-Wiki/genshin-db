			"dialogs": [
				{
					"id": 750231201,
					"content": "Hei! Kok tiba-tiba kamu jadi karakter antagonis, sebelumnya kan tidak ada bahasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231202,
					"content": "Sstt!! Jangan ribut! Sudah mau mulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231203,
					"content": "\"Tidak bisa dimaafkan ... Istirahatlah dengan teman, sahabat-sahabatku ... Oh ... kesedihan dan air mata ini ... setelah melihat penduduk {RUBY#[D]saudara-sadauraku}sukuku yang gugur ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231204,
					"content": "\"Tapi sekarang bukan waktunya untuk menangis. Hari ini, aku sedang menghadapi utusan {RUBY#[D]Xolotl} yang gugur, dan hari ini pula, aku akan membalaskan dendamku ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231205,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231206,
					"content": "Monster buas tanpa gigi, wajahnya terlihat tenang seperti Lavender Melon, buah legendaris yang berasal dari bangsa nan jauh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231207
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231207,
					"content": "Muka macam apa itu? Muka yang bahkan bisa menelan Tatacos dengan tingkat kepedasan gunung berapi tapi tetap tidak mengerut sedikit pun ... Benar-benar mengerikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231208
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231208,
					"content": "\"Kali ini ... Kali ini ... aku akan membuatmu menyesal seumur hidup!\" Setelah itu, raksasa dengan syal merah di ekornya pun menggunakan Bola Api Daging Berlemak yang sudah dia latih selama jutaan kali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231209
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231209,
					"content": "Baiklah! sekarang waktunya! Cepat pancing Electro Slime ke Gentong Kayu, lalu hancurkan Gentongnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231210,
					"content": "Hancurkan gentongnya di saat seperti ini? Memangnya gentongnya itu Bola Api Daging Berlemak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231211,
					"content": "Agak aneh sih, tapi ...ya sudahlah. Kita coba saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
