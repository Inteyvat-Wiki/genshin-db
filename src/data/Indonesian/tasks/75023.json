			"dialogs": [
				{
					"id": 750230301,
					"content": "Gimana? Apa perlu aku ulangi langkah-langkahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230302,
					"content": "Coba sekali lagi deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "Pertama-tama, keluarkan alat peraganya. Taruh Gentong kayu <color=#00E1FFFF>di tengah, tapi jangan sampai menghalangi posisi karakter utama dan latar</color>. Taruh Umpan Elemen <color=#00E1FFFF>di jalan masuk karakter antagonis</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230304,
					"content": "Ketika sudah waktunya, <color=#00E1FFFF>pandu karakter antagonis sampai ke sekitar Gentong Kayu</color>, lalu mundur ke lokasi yang aman untuk <color=#00E1FFFF>menghancurkan Gentong-nya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230305,
					"content": "Tidak perlu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "Kalau begitu, tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
