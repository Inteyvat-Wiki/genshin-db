					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Kali ini pasti menang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020102,
					"content": "Menang dalam hal apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Apa kamu tahu kalau di Inazuma sering diadakan lomba menulis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020104,
					"content": "Nama lombanya... \"Novel ini Luar Biasa!\". Lomba ini diadakan oleh Yae Publishing House, organisasi penerbitan terbesar di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020105,
					"content": "Aku sudah mempersiapkan diri cukup lama demi memenangkan lomba ini. Banyak novel yang populer di Inazuma sudah kubaca untuk meresap inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020106,
					"content": "Ditambah lagi koleksi bukuku yang sudah lama kupelajari... Aku memadukan budaya Liyue dan Inazuma dalam tulisanku, dan aku yakin aku pasti akan menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020107,
					"content": "Aku sudah bertemu dengan Feiyun Commerce Guild. Mereka bilang akan membantuku mengumpulkan naskah novelku, tapi sampai sekarang utusan mereka belum datang juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020108,
					"content": "Kalau kamu ada waktu, apa kamu bisa membantuku mengantar naskah novelku ke <color=#00E1FFFF>Feiyun Commerce Guild</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Tolong ya, kali ini aku pasti bisa memenangkan lomba itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020111,
					"content": "Ceritanya tentang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Maaf, aku tidak bisa membeberkannya karena ini adalah isi cerita untuk lomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 223020113,
					"content": "Kalau aku menang, semuanya akan membaik kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
