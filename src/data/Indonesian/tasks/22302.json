			"dialogs": [
				{
					"id": 223020301,
					"content": "Tuan muda pergi ke mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Tentang novel Chang the Ninth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Hah? Dia... dia masih menulis novel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Oh iya, aku ingat. Dia pernah bilang ingin mengikuti lomba menulis novel di Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Kali ini, apa yang dia tulis? Dulu dia menulis tentang Qixing dan mendesak kami untuk membantu menerbitkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Belum diterbitkan saja sudah hampir menyebabkan para Millelith datang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "Tapi setidaknya kali ini novel yang dia tulis mau dikumpulkan ke Inazuma. Para Millelith tidak akan bisa cari gara-gara dengan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Serahkan naskahnya kepadaku, aku akan meminta pelaut yang menuju ke Inazuma untuk membawanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Tapi aku rasa Chang tidak punya kesempatan untuk memenangkan lomba ini. Aku mendengar kabar ada sebuah novel berjudul \"Legenda Pedang\" yang sedang populer di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Penulisnya berasal dari Liyue, tapi aku tidak tahu siapa identitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Oh ya, terima kasih sudah membantu membawakan naskahnya kemari. Awalnya Chang the Ninth meminta kami mengambilnya, dan sudah memberi kami upah, karena itu, terimalah upah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
