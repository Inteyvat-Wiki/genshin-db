			"dialogs": [
				{
					"id": 223020201,
					"content": "Sepertinya di depan adalah <color=#00E1FFFF>Feiyun Commerce Guild</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Cukup serahkan naskah novelnya ke <color=#00E1FFFF>orang yang di depan pintu itu</color>, lalu selesai deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Tapi... Paimon benar-benar penasaran, novelnya tentang apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "Bagaimana? Mau mengintip sedikit isinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
