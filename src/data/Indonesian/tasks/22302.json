					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "Ya, mengintip sedikit saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020503,
					"content": "Hmm... anak muda ini bukannya Chang the Ninth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Usianya sudah dewasa, tapi pola pikirnya ternyata masih kekanak-kanakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Ayo kita serahkan naskahnya ke <color=#00E1FFFF>Feiyun Commerce Guild</color>.",
