				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Tak lama kemudian, di bengkel Xilonen ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Aku sudah balik. Ini, kenalkan ibunya Tepal, Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Halo! Kami—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Tidak usah basa-basi. Aku tidak mau bahas soal anak itu lebih lama dari seperlunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Dia sudah bukan anakku lagi! Sudah dicoret dari kartu keluarga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Dia cuma peduli sama mimpi kosong terbang di langit ... kami coba kasih pengertian ke dia, tapi percuma! Dia terobsesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hmph, waktu dia pergi, masih sempat-sempatnya omong kosong soal bikin bengkel di langit supaya jauh dari omongan pahit kami para \"penghuni daratan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Ini catatannya. Pertanyaan apa pun yang kalian punya, silakan cari jawabannya di sana. Aku tidak mau bahas lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Dia bukan anakku ... panggil \"ibu\" saja tidak pernah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Wah, hubungannya separah itu ... Paimon enggak nyangka loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Suaminya, ayah Tepal ... meninggal baru-baru ini, tapi Tepal datang ke pemakamannya saja tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Kalau menurutku ya, mungkin pada saat itulah Puma akhirnya sudah tidak mau peduli lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Aku temani dia dulu deh. Kalau ada perlu yang lain, bilang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Oke, jadi petunjuk kita sekarang cuma catatan ini. Gimana? Ada info apa di dalam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hmm ... desain-desain awal Sayap Phlogiston ... lalu teori-teori tentang mendirikan bengkel udara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Kota Bara Ochkanatlan ... sepertinya dari situ deh inspirasi teknologinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Jadi dia serius bikin bengkel di langit? Gila, proyek gede gitu gimana caranya cuma dipegang satu orang ... memangnya bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Eh, lihat sketsa balonnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "OH! IYA! Di arena ujian ... yang terbangnya tinggi banget itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Balon itu sudah di sana lumayan lama, dan orang-orang penasaran gimana caranya dia bisa naik setinggi itu. Tapi ... gimana kalau ternyata pertanyaan itu salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Gimana kalau ternyata balon itu awalnya justru terbang lebih tinggi sampai di atas awan dan tidak kelihatan dari bawah, dan baru-baru ini turun karena ada kesalahan sistem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "Dengan kata lain, balon itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "Bagian dari bengkel Tepal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Kemungkinan. Kalau markas Tepal selama ini tersembunyi di atas awan, wajar kalau Isidore tidak bisa menemukannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon sudah curiga duluan loh ya ... tapi, eh, gimana caranya kita naik ke sana? Chasca, memangnya kamu bisa terbang setinggi itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "Kalau sendiri sih mungkin ... tapi kalau bonceng orang, tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Dan aku rasa Sayap Phlogiston juga tidak bisa terbang setinggi itu ... ya, tidak bisa tanpa \"relik\" yang disebut Tepal di catatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Iya, dan pasti benda itu ada di tangannya sekarang ... kita harus cari alternatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Paimon bisa terbang setinggi itu enggak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Oh, jelas ENGGAK dong. Itu sih sudah ketinggian banget buat Paimon! Lagian ngapain nanya gitu? Mau nyuruh Paimon naik terus ajak berantem si Tepal sendirian?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Jangan dipikirkan terlalu pelik. Sekarang kita belum ada solusi, tapi bukan berarti orang lain juga tidak bisa. Yang jago terbang di suku Bunga Bersayap kan bukan cuma aku seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Oh, betul juga! Kita tanya Tetua Allpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Dan Mutota. Dia itu jagoan pasukan terbang pada zamannya. Kita tanya pendapat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Kita kayaknya pernah lihat. Ya kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
