			"dialogs": [
				{
					"id": 150221101,
					"content": "Kalian bergegas ke arena ujian untuk menjelaskan situasinya ke Inkanak ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Astaga ... idenya gila sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Memang, tapi kita harus gerak cepat. Gimana cara tercepat buat menyumbat pancoran gas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Kalau secara teknis sih aku sarankan ukur dulu, survei dulu, rencanakan dulu langkah-langkahnya sampai matang ... tapi sepertinya kalian tidak terima saran seperti itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "Berarti kita harus pakai cara kasar. Lihat Phlogiston padat di sebelah sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "Pemeriksaan kemarin menunjukkan adanya suatu struktur yang stabil di dalamnya, sehingga membuatnya cukup tahan banting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Ada titik lemah, tapi kalau tidak dihajar semua sekali jadi, strukturnya akan tetap kokoh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Lalu ... apa yang terjadi kalau kita hajar semuanya sekali jadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Dia akan ambruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "Oke, aku paham ke mana arahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "Ya, betul! Asal kalian bisa hajar semua titik lemahnya dari sudut tertentu, nanti Phlogiston padatnya bakal jatuh pas di atas pancoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Memang cara kasar ya ... tapi aku suka ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
