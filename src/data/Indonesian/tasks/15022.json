			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Kata Allpa, si Tepal itu orang Putra-Putri Gema. Tapi gimana ngelacaknya? Tanya terus sampai dapat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Kita mulai dari yang kenal dulu, biar lebih cepat. Kalau di sini, jam segini, maka paling gampang itu kita tanya ke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Xilonen, ayo bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*hoam* Oh, kalian ... sebentar, aku turun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*hoam* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Kalian berdua sama-sama suka manjat pohon ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Aku manjat untuk terbang lebih jauh dan melihat lebih jauh. Bukan buat bobo siang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Yah, enggak semua orang kayak kamu yang masih punya tenaga setelah terbang seharian ... jadi kenapa ganggu waktu bobo siangku? Ada urusan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Maaf ya Xilonen, soalnya urusan ini enggak bisa nunggu. Kamu tahu nama \"Tepal\"? Katanya dia seorang pengrajin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal? Ah, kayaknya kenal ... itu nama anaknya Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Apa dia ada di sini sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Kalau mau ketemu dia, kalian telat beberapa tahun ... kenapa cari dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "Ceritanya panjang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Kamu mencoba menjelaskan kronologis peristiwanya dengan singkat dan padat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "Sayap Phlogiston? Wah, keren. Anak itu bisa juga rupanya ... yah, berarti hari ini aku tidak bisa lanjut bobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "Bisa juga? Maksudnya dia dari dulu memang cobain bikin itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Iya, dia langsung fokus mencoba bikin mesin terbang semenjak pulang dari suku Bunga Bersayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Jadi, tepat setelah dia gagal dapat sayap ... mesin terbang ini apa mirip dengan meriam yang dari kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Maksudnya meriam yang lebih susah dijinakin daripada Qucusaurus paling galak? Bukan, dia maunya alat yang bisa bikin semua orang bisa terbang bebas meski enggak punya bakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Dulu sih tidak ada perkembangan ya. Bengkelnya meledak beberapa kali, pernah sampai orangnya nyaris wafat. Setelah itu aku jarang kontak sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Waktu muda dulu orang tuanya suka bepergian. Mereka baru pulang ke sini setelah anaknya lahir. Tapi tinggalnya di daerah yang jauh ke mana-mana, dan jarang juga interaksi sama warga yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "Artinya, kebanyakan orang sini enggak terlalu kenal mereka ... yah, coba langsung saja bicara sama keluarganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Aku panggilin deh si Puma. Kalian tunggu di depan bengkel ya, tidak bakal lama kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
			"completionStepIds": [
				1502202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
