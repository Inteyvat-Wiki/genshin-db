				},
				{
					"id": 150221302,
					"content": "Setidaknya kita masih utuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Ah-hah ... sesuai dugaan. Dari luar tampak kayak balon biasa, tapi kalau dari dekat begini kelihatan jelas sudah dimodifikasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "Dan benar, dia hanya turun ke bawah awan karena ada mesinnya bermasalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Terus kamu tahu juga di mana letak masalahnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221306
					]
				},
				{
					"id": 150221306,
					"content": "Bisa dicari tahu di buku catatan Tepal. Untungnya aku ada sedikit pengalaman oprek-oprek mesin karena sering mengutak-atik senjata sendiri ketika ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221307,
					"content": "Mm-hmm ... harusnya sudah bisa. Sekarang tinggal ditendang, pakai tenaga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221308,
					"content": "Eh, sebentar ... meriam mungkin bisa digituin, tapi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221309
					],
					"speakerTitle": "Paimon"
				},
