			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, akhirnya pulang juga! Suasana di suku semakin tegang nih. Penyelidikannya gimana, ada perkembangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Bahkan ada yang mikir kita menahan para pedagang karena mau mendukung pasukan terbang dan menolak Sayap Phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Kalau suasananya malah semakin tegang setelah kita menahan para pedagang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Kami dapat petunjuk bagus, tapi ada satu rintangan besar yang menghalangi jalan kita menuju bukti yang tak bisa disangkal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca menjelaskan tentang Tepal dan teori kalian mengenai bengkel kerja yang mengudara ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Relik dari Kota Bara? Ugh ... jadi Och-Kan masih bisa menebar keributan bahkan setelah sekian tahun lamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Bengkel udara ... balon udara di atas arena ... kalian mau ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Ada ide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Sayap Phlogiston dan Qucusaurus tidak bisa terbang setinggi itu. Yakin Tepal sembunyi di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hmm ... tapi mungkin ... ada jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Oh ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Masih ingat pancoran di arena? Waktu semuanya mampet, Phlogiston gas di arena tidak bisa mengalir keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Tapi sekarang semuanya sudah bebas mengalir. Kalau kita macetkan sekali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Maksudnya ... semua kecuali yang di puncak arena? Supaya tekanan gasnya mengalir semua ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Betul. Kalau Phlogiston gasnya mengalir cuma dari satu pancoran, akan terbentuk arus angin tekanan tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "Tinggal numpang itu ke atas dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Betul. Risikonya lumayan, tapi kalau Chasca yang terbang, harusnya sih bisa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "Risikonya bukan lumayan lagi ... tapi aku setuju kalau itu mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Kalau mau coba, bicara dengan Inkanak di arena. Dia bisa jelaskan cara menyumbat pancorannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca ... kalau ada orang yang bisa cari bukti di langit atas, aku rasa cuma kamu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Apa ini indikasi bahwa ada pihak lain yang mengipasi warga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
