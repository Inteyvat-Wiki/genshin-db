				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Rasanya lumayan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Aku selalu keasyikan bermain dan tanpa sadar terbang terlalu tinggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#Hei {NICKNAME}! Aku sudah mencarimu ke mana-mana! Bagaimana penggunaan wind glider yang kuhadiahkan kepadamu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Sepertinya kamu sangat menyukainya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Tapi ngomong-ngomong, kamu pasti belum mempunyai Surat Izin Meluncur, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Surat Izin Meluncur? Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Bukankah dari namanya saja sudah jelas? Kamu harus memiliki Surat Izin Meluncur agar bisa meluncur di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Urgh, {NICKNAME} sudah lama meluncur dan belum pernah mendengar aturan seperti ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Ya... Kalian meluncur ke sana kemari dan semua orang menyadarinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Jadi kamu ke sini untuk memberi kami Surat Izin Meluncur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Mana mungkin?! Knights of Favonius mengatur hal ini dengan sangat ketat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "Kamu harus melewati tes agar Knights of Favonius bisa mengeluarkan Surat Izin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Aku hari ini datang sebagai penguji yang mengawasi {NICKNAME} melakukan tes lisensi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Akulah yang menghadiahkan kamu wind glider itu, jadi aku harus bertanggung jawab atas tindakanmu — pasti itu yang akan dikatakan oleh Grand Master Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "... Apa kamu bisa memberi kami sedikit kemudahan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "Tidak apa-apa. Aku bisa melakukannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Tes? Kedengarannya sangat merepotkan. Tapi kalau Amber yang mengawasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Ti-dak-bi-sa. Jangan memandangku seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME} pasti bisa lulus tes dengan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Ini hanya tes kecil saja, aku yakin kamu bisa. Semua orang di Mondstadt telah menyaksikan kemampuan terbangmu saat mengalahkan Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Tapi peraturan tetaplah peraturan, dan kita harus menaatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Buku Panduan Meluncur ini untukmu. Kamu tidak perlu menghafalnya, kamu hanya perlu menguasai seluk beluk di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Misalnya seperti: satu wind glider hanya boleh ditumpangi satu orang saja, tidak boleh membawa barang yang terlalu berat saat terbang, dan tidak boleh menggunakan Anemo Slime untuk lepas landas, dan lain sebagainya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Singkatnya, kamu baca baik-baik bukunya. Saat Lisa mengajarku ilmu sihir, aku harus membaca banyak buku-buku yang tebal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Kelihatannya tebal sekali... Apa boleh buat, kita sebaiknya mulai membacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Bagus. Temui aku di Windrise setelah selesai membacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "Panduan Meluncur Knights of Favonius. Kedengarannya bukan bacaan yang menarik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Kita lebih baik mulai membacanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Aku merasa seperti membaca sebuah buku dongeng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Orang-orang di Mondstadt benar-benar memahami romansa dalam belajar meluncur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Ceritanya sangat menarik... Apa buku petunjuk Knights of Favonius memang ditulis dengan gaya seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Huh. Ngomong-ngomong, ayo kita temui Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}