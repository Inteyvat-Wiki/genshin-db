					"nextDialogs": [
						721411603
					]
				},
				{
					"id": 721411603,
					"content": "(Kamu mendengar suara debur ombak yang menghantam batu karang. Debur ombak membuat orang ingin memandangi laut dan langit. Tetapi saat kamu mencoba mendengarkannya, seakan-akan tidak ada apa pun yang terjadi.)",
					"roleType": "TALK_ROLE_NPC",
