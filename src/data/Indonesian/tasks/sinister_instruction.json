			"dialogs": [
				{
					"id": 721411701,
					"content": "Padamkan amarah dia, redakan amarahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "Kamu melakukannya dengan baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "Ingat, beberapa orang akan memakai topeng untuk menipumu, tetapi dia akan membantumu, dia akan selalu membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Wanita itu seperti monster rubah legendaris, dia amat marah karena aku membiarkannya pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "Dia marah lagi... Ini semua salahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Kumohon maafkan aku... Akan kucarikan \"lagi\" kurban untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Kumohon maafkan aku...",
