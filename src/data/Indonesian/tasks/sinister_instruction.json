					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Apa... Tetapi kenapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "Aku memimpin setiap pengorbanan, dan selalu menerima berkah darimu!",
