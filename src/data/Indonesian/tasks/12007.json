			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "Jadi ada makhluk gaib hebat yang tinggal di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "Brr... Kalau ada yang tinggal di sini, kok di sini dingin sekali sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Hmm... Aku juga punya pertanyaan yang sama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Aneh sekali, aku yakin ini lokasi yang ditulis ibuku, tapi... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "Mungkin kita salah lokasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Hmm... Aku jadi ragu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Tapi, karena kita sudah di sini, sepertinya kita harus pergi dan menjelajah lebih dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Iya, masuk akal. Siapa tahu, mungkin ada kejutan yang menanti di depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Jadi, ehm... apa yang ditulis di buku catatan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Biar kupikir dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "\"Seekor bangau membawa <color=#00E1FFFF>satu</color> kuntum bunga di paruhnya untuk menghiasi rambutku, sedangkan seekor kelinci putih merajut sehelai rok dari <color=#00E1FFFF>empat</color> garis cahaya bulan. Dengan pakaianku yang sepantasnya, aku <color=#00E1FFFF>menghadap ke arah timur</color> dan memanggil nama Tsubaki <color=#00E1FFFF>tujuh</color> kali. Dalam sekejap mata, aku sudah berdiri di jalan menuju rumahnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Seperti dongeng saja... Jadi ibumu akan melakukan ritual kecil itu terus Tsubaki akan datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Memang terdengar seperti Adeptus sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "Menurutku itu sejenis kode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Ayo kita mendekat lagi sedikit sebelum mengambil kesimpulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "Ide bagus tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "Mungkin Tsubaki benar-benar utusan rubah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
