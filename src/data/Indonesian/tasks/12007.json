						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "Di sini harusnya sudah bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Baiklah, ayo kita lihat isi buku catatan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Ooh, Paimon tebak pasti tentang harta karun misterius! Ah, seru sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Psst, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Kenapa? Kenapa kamu tiba-tiba berbisik? Paimon jadi grogi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Sini ikut aku. Kita ke sana dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Ohhhh, kamu tidak mau mengganggu Ayaka membaca buku catatan itu ya. Memang sih, isinya kelihatan penting sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Tapi, em, berdasarkan ekspresinya... sepertinya bukan peta harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Hmmm, kira-kira apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "*hufff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "Pengembara, Paimon, maaf membuat kalian menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Tidak apa, baru sebentar saja kok! Kamu bacanya cepat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Apa kamu sudah selesai membacanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Ya, sudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Kurasa aku harus menceritakan kebenaran tentang buku catatan ini pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Meskipun isinya berbeda jauh dari dugaanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Berbeda bagaimana? Maksudmu, bukan seorang utusan rubah yang menulisnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "Bukan, bukan seorang utusan rubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "Ternyata identitas asli Tsubaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "...adalah ibuku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "Terkejut? A-Aku juga... Tapi itu yang tertulis di bagian awal buku catatan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "\"Tsubaki dan aku adalah orang yang sama, tapi juga sangat berbeda. Saat aku menjadi Tsubaki, aku sudah bukan lagi Kamisato Kayo dan menjadi wanita paling biasa di dunia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "\"Halaman-halaman selanjutnya di buku ini hanya menceritakan kehidupan sehari-hari orang biasa. Tidak kurang, tidak lebih.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Sebagian besar isi buku ini adalah keluh kesah ibuku, pribadi maupun sepele. Semua hal yang kita tahu tentang Tsubaki... ternyata adalah tentang ibuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Jadi... berarti desain kimono itu, dan hidangan luar negeri itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "Adalah hal-hal yang ingin dicoba oleh ibuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Aku yakin semua ini terdengar aneh bagimu, tapi bagiku, sikap ibuku sangat bisa kumengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "Atau dengan kata lain, aku... sebenarnya juga punya sisi lain dari diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Aku kehilangan kata-kata saat aku membaca buku catatan ini... Rasanya seperti... ada seseorang yang masuk ke dalam pikiranku, melihat semuanya, dan menulisnya ke sebuah buku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "Sejak ibuku menikahi ayahku, dia menjadi ibu dari keluarga Kamisato, dan hal itu membawa berbagai macam tugas. Di saat bersamaan, wibawa Yashiro Commission juga membawa tanggung jawab yang besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Terlebih lagi, setiap tindakannya mewakili Klan Kamisato. Dia selalu jadi pusat perhatian. Dalam kondisi seperti itu, dia tidak punya waktu untuk melakukan apa yang benar-benar dia inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Setelah ayahku meninggal, Ayato dan aku harus bertanggung jawab untuk berbagai hal di dalam klan. Waktu itu benar-benar masa yang sulit bagi kami... Kurasa orang di luar klan kami tidak akan mengerti rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Setiap kali aku menghadapi kesulitan, aku akan bertanya pada diriku sendiri: Apakah ibuku juga pernah melewati ini? Apa yang akan dia lakukan di situasi seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Mungkin karena aku sudah lama tidak melihat ibuku, tapi... entah kenapa, yang ada di ingatanku adalah sisi ibuku yang patut dikagumi dan dihormati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Tapi... ternyata gambaranku tentangnya salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Saat aku membaca buku catatan ini, aku sadar... Dia sama sepertiku. Di luar posisi dan jabatannya, dia hanyalah orang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Dia menyukai kimono yang cantik, ingin mencicipi makanan dari berbagai tempat, dia ingin melihat pemandangan yang belum pernah dilihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Mungkin semua ini terdengar kekanak-kanakan bagimu, tapi... aku juga merasakan hal yang sama. Aku ingin hidup sebagai wanita biasa, bukan seorang Kamisato Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "Ibu menulis kalau dia selalu ingin pergi ke festival lokal Inazuma. Dia menulis kalau kadang-kadang, di malam yang cerah, dia bisa melihat cahaya festival di kejauhan dari rumah kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "Aku juga pernah melihat cahaya itu! Kelihatannya ramai sekali dengan banyak orang —— dan cahayanya sampai membuat langit bersinar... Tentu saja, hal itu kadang membuatku cemas juga dari sisi pandang ketertiban umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Tapi kalau orang sepertiku tiba-tiba datang ke festival tanpa pemberitahuan —— itu akan dianggap etiket yang buruk. Apalagi di generasi orang tuaku, saat Yashiro Commission tidak punya hubungan dekat dengan para rakyat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Kalaupun tidak ada yang mencegah kami, kalau ada anggota Yashiro Commission yang membaur di keramaian... orang-orang pasti melihat dengan pandangan aneh. Mereka pasti mengira ada suatu masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "Ibu mengatakan kalau dia tidak ingin membuat orang-orang khawatir —— dia ingin semua orang menikmati festival dengan bebas... Dia tidak ingin mengganggu mereka, dan dia tidak punya banyak waktu luang juga, jadi dia tidak pernah pergi ke sana. Tidak sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Yahh... Jadi desain kimono itu —— pasti itu kimono yang mau dia pakai kalau dia akan pergi ke festival ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "Ya. Terkadang ada makanan internasional dijual di festival. Dia juga ingin mencicipinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Kuharap ini bukanlah sesuatu yang tidak sopan untuk dibicarakan, tapi... aku tidak pernah tahu bahwa ibuku memiliki sisi kekanak-kanakan juga, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Sama sekali tidak kok! Paimon rasa ibumu adalah yang terbaik dari kedua sisi — di dalam berhati lembut dan di luar punya rasa tanggung jawab yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Tanpa kusadari, aku berakhir dengan memenuhi beberapa harapan ibuku. Namun, pergi ke festival adalah sebuah hal yang tidak dapat kulakukan untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Mungkin ini adalah sebuah hal yang tidak akan pernah bisa kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Kamu sudah melakukan banyak pencapaian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "...Terima kasih. Kurasa aku memahami sesuatu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Ibu dan aku sangat mirip dalam beberapa hal. Hal-hal yang dia hadapi adalah hal-hal yang juga akan aku hadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "Dia memilih untuk mengurung harapannya yang tidak terpenuhi ke dalam identitas Tsubaki. Sedangkan aku... aku sudah memutuskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Oh! Jadi kamu sudah putuskan untuk ubah egomu juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "Tidak, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Aku tidak berencana untuk melakukan hal seperti itu. Aku hanya berpikir... aku akan menetapkan tujuan baru untuk diriku sendiri: Hidup tanpa penyesalan setiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "Jadi, ehm... Pengembara, aku... Ehem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Fiuh, tarik napas dalam-dalam, Ayaka, tarik napas dalam-dalam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "Apakah kamu tertarik untuk melihat festival Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Paimon mau banget pergi sejak lihat poster itu! Ayaka juga mau ikutan pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Jadi, kamu benar-benar belum pernah ke festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Hei, mohon jangan menertawakanku! Se-sebelumnya aku hanya memiliki kekhawatiran yang sama dengan ibuku... tapi sekarang, kurasa aku tidak perlu terlalu mengkhawatirkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Aku akan jujur pada diriku sendiri, memenuhi harapan ibu dan harapanku sendiri. Aku tahu bahwa kamulah dari semua orang yang dapat memahami keputusanku ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "Jadi... ayo kita lakukan hal ini, kamu dan aku! Ayo kita ke festival bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Paimon ikut! Ada Festival pastinya ada banyak camilan, ya kan? Terus ada permainan seru juga kan? Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "...Luar biasa! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Jika kita pergi sekarang, seharusnya masih keburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Oh, intinya itu kan? Bukannya hari ini adalah hari terakhir? Tunggu apa lagi — ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "Hal itu bukan salahmu, memang seperti itulah apa adanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}