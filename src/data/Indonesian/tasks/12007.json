			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Apa sudah terbuka? Apa \"Inazumadeptus\" kita meninggalkan harta karunnya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070202,
					"content": "Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070203,
					"content": "Eh... Sepertinya buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070204,
					"content": "Sepertinya ini buku catatan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070205,
					"content": "Mungkin ini buku catatan milik Tsubaki...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070206,
					"content": "Ayo kita keluar dulu. Suasana di sini sedikit berbeda dari bayanganku. Entah kenapa... membuatku enggan membuka buku catatan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070207,
					"content": "Paimon mengerti maksudmu — membaca di tempat gelap tidak bagus buat mata. Ayo kita ke luar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
