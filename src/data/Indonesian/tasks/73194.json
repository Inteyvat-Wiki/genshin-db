			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Papan Pengumuman ini dipasang oleh Mahamata untuk mempublikasikan informasi penting Kota Sumeru. Jika ada pertanyaan dapat menyampaikannya di papan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Apa kamu pernah dengar? Pelindung Hutan menemukan istana megah yang muncul entah dari mana di sebelah utara hutan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940202,
					"content": "\"Tapi sepertinya tiap orang yang pernah pergi ke sana kena tipu sampai habis uangnya. Ketika ditemukan Pelindung Hutan, yang tersisa dari mereka hanyalah celana dalamnya saja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940203,
					"content": "\"Mereka cuma menangis dan diam seribu bahasa sewaktu ditanya tentang kejadian apa yang menimpa mereka. Sungguh menakutkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940204,
					"content": "\"Lebih baik jangan keluyuran di dalam hutan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Pengumuman di seluruh Sumeru akan ditampilkan melalui Akasha sekarang. Harap untuk selalu mengenakan Akasha Terminal supaya tidak ada pemberitahuan penting yang terlewatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940302,
					"content": "Papan Pengumuman ini akan disimpan sementara untuk memudahkan pedagang asing, orang lanjut usia, dan anak-anak. Pengumuman ini bisa dihapus kapan saja di masa yang akan datang. Harap untuk tidak bergantung secara berlebihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Pembagian \"Anahitian Blessing\" tahun ini sudah dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940402,
					"content": "Pada prinsipnya, pembagian dilaksanakan berdasarkan kebijakan dan syarat-syarat yang berlaku tahun sebelumnya. Detail informasinya sudah dirilis melalui Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940403,
					"content": "Jika ada perubahan, harap hubungi Mahamata terdekat dengan mengajukan permohonan perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Kasus Eleazar sedang meningkat di kota. Jika Anda menunjukkan gejala seperti mati rasa pada kulit, anggota tubuh yang lemah, atau muncul sisik abu-abu dan hitam pada tubuh, harap untuk segera mendapatkan perawatan di Bimarstan secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940502,
					"content": "Jika waktu pengobatan yang terbaik sudah terlewatkan dan penyakitnya semakin parah, akan menyebabkan konsekuensi yang parah seperti ketidakmampuan. Harap pengumuman ini diperhatikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
