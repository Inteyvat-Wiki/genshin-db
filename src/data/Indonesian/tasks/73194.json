			"dialogs": [
				{
					"id": 731941001,
					"content": "Pemberitahuan Bounty: Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941002,
					"content": "Orang ini menyamar sebagai Mahamata untuk melakukan pemerasan dan perampokan di sekitar Pelabuhan Bazaar. Citadel of Regzar saat ini sedang melakukan investigasi terhadapnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941003,
					"content": "Ada kabar yang melaporkan persembunyiannya di dalam hutan. Harap lapor jika menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
