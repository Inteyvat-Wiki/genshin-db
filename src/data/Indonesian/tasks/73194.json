				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Bimarstan adalah fasilitas medis di bawah Amurta yang menyediakan perawatan medis gratis untuk semua penghuni Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940702,
					"content": "Dokter di Bimarstan telah memegang lisensi Amurta, diagnosa dan rencana perawatan dikaji berulang oleh Akasha. Kami menyediakan layanan medis paling profesional dan aman untuk semua penghuni Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940703,
					"content": "Mohon untuk tidak memercayai dokter yang tidak dikenal atau tidak berizin agar terhindar dari kerugian finansial dan kesehatan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
