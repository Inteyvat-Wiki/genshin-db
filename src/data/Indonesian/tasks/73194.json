			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Mohon untuk tidak membawa terlalu banyak Mora di tempat keramaian agar terhindar dari tindak pencurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940802,
					"content": "Jika ada harta benda yang dicuri, harap untuk tidak meminta bantuan dari Eremite sekitar yang sedang berpatroli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940803,
					"content": "Karena ada kemungkinan merekalah yang mengambil harta benda Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
