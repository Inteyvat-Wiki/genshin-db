			"dialogs": [
				{
					"id": 731940901,
					"content": "Pemberitahuan Bounty: Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940902,
					"content": "Orang ini mengklaim dirinya sebagai bandit terkenal yang melakukan perjalanan lintas negara. Namun kenyataannya dia adalah penipu yang tidak ada dalam peringkat Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940903,
					"content": "Akhir-akhir ini banyak kasus penipuan yang ada hubungannya dengan orang ini. Harap tingkatkan kewaspadaan agar terhindar dari tindak penipuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
