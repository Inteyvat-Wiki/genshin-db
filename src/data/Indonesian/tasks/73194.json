			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "\"Berhati-hatilah jika akan pergi ke hutan hujan. Dulu saya diutus oleh mentor ke sana untuk mengumpulkan rempah-rempah, tapi saya hampir saja kehilangan nyawa karena bertemu dengan Rishboland Tiger.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941202,
					"content": "\"Untungnya saya diselamatkan oleh Penjaga Hutan di sekitaran. Meskipun dia menyebut dirinya Penjaga Hutan Pemula, dia kelihatannya sudah sangat berpengalaman. Dan yang terpenting, dia memberikan saya makanan enak untuk menenangkan saya yang masih syok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941203,
					"content": "\"Dengar-dengar dia adalah murid dari Senior Tighnari. Seperti kata pepatah — 'Murid' tidak jatuh jauh dari 'gurunya'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
