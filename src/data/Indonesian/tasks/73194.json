				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Pengingat khusus: \"Eremite\" adalah satu-satunya pakaian prajurit resmi di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940602,
					"content": "Jangan terlalu mudah percaya pada orang asing untuk menghindari penipuan",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731940603,
					"content": "Jika Anda membutuhkan pengawal, petugas keamanan, atau permintaan lainnya, mohon hubungi Parchamdar Rukh Shah dari \"Corps of Thirty\" atau kirimkan misi lewat perantara Akademiya, Effendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
