			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Karena Mahamata akan berhenti menggunakan ini untuk mempublikasikan pengumuman, kami akan menjadikannya sebagai papan pesan Lambad's Tavern. Silakan tinggalkan pesan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941102,
					"content": "\"Bos, apakah pesanan sepuluh krat minuman beralkohol saya dulu sudah sampai? Saya kemarin datang di waktu yang dijanjikan, tapi barangnya belum ada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941103,
					"content": "Bagaimana bisa begitu! Dulu ada pemuda pirang yang mengaku sebagai teman sekamarmu sudah membawa pergi semuanya. Saya masih ingat kalian datang berdua waktu itu, apa kamu tidak salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731941104,
					"content": "\" ... Baiklah. Saya mengerti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
