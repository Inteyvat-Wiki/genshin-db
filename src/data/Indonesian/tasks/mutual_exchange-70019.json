					"nextDialogs": [
						700190104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190104,
					"content": "Katanya dia tidak mau melihat matahari. Dia ingin tidur dan tidak mau bangun lagi selamanya. Aku penasaran dengan apa yang menyebabkan dia sampai menderita begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190106,
					"content": "Hmm, bagaimana kalau kita coba berikan sesuatu yang dia inginkan, agar dia merasa lebih baik?",
