					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030312,
					"content": "Bencana yang lumayan dahsyat sepertinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030313
					]
				},
				{
					"id": 790030313,
					"content": "Pasti lah, kapalnya saja terbelah dua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030316,
					"content": "Hmm, pertanyaan sebenarnya adalah... apa muatan yang mereka bawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030317,
					"content": "Bagaimana kalau kita cari lagi di sekitar sini? Jangan-jangan ada harta karun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030318,
					"content": "Apa pun muatannya, pasti sudah rusak kalau terendam air selama itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "Hei! Jangan menjatuhkan semangat Paimon mencari harta karun dong! Kalau ketemu, Paimon yakin harta karunnya pasti masih berkilau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030322,
					"content": "Yah pokoknya kita jalan dulu. Masih banyak tempat yang harus kita periksa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030320,
					"content": "Atau malah monster yang ketemu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030321
					]
				},
				{
					"id": 790030321,
					"content": "Tidak bakal, kita kan ada di laut! Di laut cuma ada air dan ikan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030314,
					"content": "Mungkin mereka berhasil bertahan hidup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030315
					]
				},
				{
					"id": 790030315,
					"content": "Paimon harap sih begitu... Situasinya seperti parah sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Paimon"
				}
			]
