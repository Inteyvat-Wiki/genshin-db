				"points": []
			},
			"dialogs": [
				{
					"id": 790030401,
					"content": "Hei, harusnya ini deh separuh bagian kapal satunya. Coba Paimon lihat... Oh, ada ukiran lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030402,
					"content": "\"...Meskipun bagian depannya hancur, tapi kapal ini tidak tenggelam walau hanya tersisa dengan bagian belakangnya saja. Memang hebat kapalku, hahaha. Sayangnya hampir semua muatan kapal sudah tenggelam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030403,
					"content": "\"...Tampaknya, kita hanyut terbawa arus tenggara? Ah sudahlah, itu tidak penting. Masalahnya adalah bagaimana caranya meninggalkan tempat ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030405,
					"content": "Tulisan yang diukir di kedua bagian kapal ini sepertinya berhubungan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030406
					]
				},
				{
					"id": 790030406,
					"content": "Kalau digabung, jadinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030407,
					"content": "\"Aku tidak tahu ini di mana, tapi rasanya sudah jauh dari Inazuma. Hah! Aku ingin sekali melihat wajah terkejut para anak buah Shogunate itu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030408,
					"content": "\"Namun, sepertinya di sekitar sini tidak ada daratan. Aku khawatir kapal ini tidak bisa bertahan lebih lama, kecuali kita menemukan sebuah tempat untuk berlabuh... kita harus mencari jalan keluar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030409,
					"content": "\"...Meskipun bagian depannya hancur, tapi kapal ini tidak tenggelam walau hanya tersisa dengan bagian belakangnya saja. Memang hebat kapalku, hahaha. Sayangnya hampir semua muatan kapal sudah tenggelam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030410,
					"content": "\"...Tampaknya, kita hanyut terbawa arus tenggara? Ah sudahlah, itu tidak penting. Masalahnya adalah bagaimana caranya meninggalkan tempat ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030411,
					"content": "Paimon sudah paham nih. Orang-orang ini membawa muatan, lalu kapal mereka kena bencana di laut dan akhirnya hanyut sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030412,
						790030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030412,
					"content": "Bencana yang lumayan dahsyat sepertinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030413
					]
				},
				{
					"id": 790030413,
					"content": "Pasti lah, kapalnya saja terbelah dua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030416,
					"content": "Hmm, pertanyaan sebenarnya adalah... apa muatan yang mereka bawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030417
					],
					"speakerTitle": "Paimon"
				},
