			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Oh, sepertinya ini... sebuah kapal. Yah, lebih mirip separuh kapal sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030102,
					"content": "Tapi kenapa separuh kapal ini bisa ada di sini? Eh, lihat! Ada ukirannya. Coba kita lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030103,
					"content": "\"...Meskipun bagian depannya hancur, tapi kapal ini tidak tenggelam walau hanya tersisa dengan bagian belakangnya saja. Memang hebat kapalku, hahaha. Sayangnya hampir semua muatan kapal sudah tenggelam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030104,
					"content": "\"...Tampaknya, kita hanyut terbawa arus tenggara? Ah sudahlah, itu tidak penting. Masalahnya adalah bagaimana caranya meninggalkan tempat ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030105,
					"content": "Paimon rasa mereka ini orang-orang yang kapalnya karam di laut. Di sini tertulis \"bagian depannya hancur\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030106,
					"content": "Oh, ini pasti yang dimaksud \"bagian belakang kapal\"! Wuih, kenapa bisa sampai terbelah dua gini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030107,
					"content": "Hmm, di sini juga tertulis kalau mereka sampai ke sini karena terbawa \"arus tenggara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030108,
					"content": "Kalau kita telusuri arah mereka datang dan cari bagian depan kapalnya, mungkin kita akan nemu sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030109,
					"content": "Kita bawa juga papan kayu yang ada ukirannya itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Oh, Paimon paham. Pasti kamu merasa ukiran di papan kayu itu sejenis petunjuk ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030111,
					"content": "Paimon setuju! Kapal ini kayunya sudah lapuk, harusnya papannya bisa langsung kita cabut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030112,
					"content": "Oke, cabut papan itu dan ayo cari separuh bagian kapal yang satunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
