							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "Sebagai salah satu pengamat dunia yang tidak berubah, aku perlu jarak pandang yang baik. Sama seperti seorang pemahat yang tidak bisa hidup tanpa pahat, atau penulis yang tidak bisa hidup tanpa pena dan tinta ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Pencapaianku di kedua bidang itu adalah hal yang berbeda, tapi aku sangat serius dalam pekerjaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}, kamu pasti sudah menyadarinya, akhir-akhir ini \"takdir\" di Teyvat sering terguncang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Terkadang aku berpikir, seandainya aku masih memiliki wujud, kekuatan, dan kemampuan yang kumiliki di masa puncakku, aku pasti bisa melakukan lebih dari yang aku lakukan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Tapi aku akan langsung meragukan diriku lagi, karena jika aku melakukannya, batasan yang kuterima dari langit juga akan bertambah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Begitu aku terpikir tentang topik yang tidak boleh diceritakan, rasanya jadi tidak sepadan. Jadi, bagaimana aku bisa bercerita dengan bebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "Jadi, aku tidak menyesali apa yang sudah aku korbankan, juga tidak menyesali setiap pilihan yang sudah aku jalankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Aku ingin menjadi manusia dan hidup seperti orang biasa ... tapi kehidupan seperti itu adalah suatu kemewahan. Aku tidak akan melupakan identitasku sebagai malaikat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Meski hanya seorang malaikat yang bisu, aku tetap akan memenuhi tugasku. Melindungi peradaban, melindungi makhluk-makhluk di bumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Aduh, sepertinya topik kita beralih ke pembicaraan yang terlalu serius ini! Mungkin ada hubungannya dengan sekitar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "Sebenarnya aku cukup puas dengan peranku sebagai malaikat, bahkan bisa dibilang bangga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "Benar, Nicole memang hebat kok! Kamu enggak sering bertindak, tapi sekali gerak selalu membuat orang merasa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Sudah seharusnya kamu bangga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Oh ya? Hehe, aku senang kalian ingat kalau aku ini orang yang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Sekarang sudah larut. Pergilah, bawa berkahku dan lanjutkan petualanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Jangan takut tersesat, dan ingat ada malaikat yang akan diam-diam mengawasi perjalananmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
