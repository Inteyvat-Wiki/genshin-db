			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "Pengembara, kamu sudah kembali! Bagaimana? Apakah kamu berhasil mendapatkan foto-fotonya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Foto dan sampelnya, semua ada di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "Wow! Kamu lincah bagaikan kancil! Seorang petualang berpengalaman memang beda, ya? Kamu hebat banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "Terima kasih banyak, Pengembara! Ah, aku punya ide, akan kutraktir kamu sebagai ucapan terima kasihku. Makanannya pasti enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Bagaimana? Kelihatannya enak, kan? Semoga kamu suka ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Aku sendiri akan kembali dan lanjut menulis catatanku. Hmmm, sedangkan tanaman ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Akan kutanya Jack apakah dia tahu cara mengawetkan sampel tanaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Kalau bunga Cecilia, kurasa lebih bagus ditaruh di dalam vas daripada jadi sebuah sampel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
