			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "Betul ini Lonceng Penyuci. Cukup terawat juga, kondisinya masih bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Kita taruh parfum yang sudah disiapkan sebelumnya di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Kamu kenal Madame Ping?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Tentu. Kalau tidak kenal, dari mana aku tahu dia punya Lonceng Penyuci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Mencurigakan ya! Tapi kalau kamu enggak mau cerita, kami juga enggak maksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Oh iya, nenek itu juga titip pesan buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "\"Jika ada waktu, mampirlah minum teh. Nenek tua ini tidak punya apa-apa, tapi sepoci teh selalu ada untuk disajikan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Haha, nada bicara demikian tidak cocok denganmu. Namun memang poci tehnya sangat bagus. Tidak ada yang lebih baik lagi jika ingin minum teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Kalau waktunya sudah tiba, aku akan bawa teh bagus lalu pergi mengunjunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Nah, habis ini apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Hmm ... Selanjutnya, kita perlu membeli <color=#00E1FFFF>layangan</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Paimon suka main layangan! Zhongli mau main? Kami ... boleh istirahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, bukan, bukan. Layangan memang mainan kanak-kanak, tapi ketika digunakan untuk berbagai ritual Liyue, ada makna simbolis yang terkandung di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Aku akan menjelaskannya nanti. Sekarang kita harus membeli dulu layangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Oh, oke ... makin penasaran nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Kamu juga Adeptus ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				}
			]
