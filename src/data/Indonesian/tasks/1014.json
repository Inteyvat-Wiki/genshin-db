			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Tidak ada yang tetap. Semuanya terus berubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140102,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Hm? Oh anak muda, mau melihat bunga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140104,
					"content": "Sayang sekali. Bunga Glaze Lily ini sudah hampir layu semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140107,
					"content": "Bunga-bunga ini ... Kenapa bisa layu semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Ketika muda dulu, orang -orang sering bilang bahwa Glaze Lily bisa membaca hati manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140109,
					"content": "Kalau mendengar suara tawa dan nyanyian, mereka akan mekar dengan indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140110,
					"content": "Tapi jika yang terdengar adalah berita miring dan fitnah, mereka pun akan layu sebelum berkembang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140111,
					"content": "Artinya, bunga ini bisa tahu apa yang sedang terjadi di Liyue ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Ya. Kabar kematian Rex Lapis bukanlah perkara kecil. Beritanya ada di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140113,
					"content": "Ada yang bilang kalau itu semua adalah pekerjaan para Fatui. Ada juga yang bilang kalau Qixing-lah dalang di balik semuanya. Bahkan ada juga yang bilang kalau ini pertanda bahwa \"dia yang ada di bawah laut\" akan segera bangkit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140114,
					"content": "Pelabuhan ini ibarat setumpuk kayu bakar kering. Satu percikan saja akan melalap habis semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140115,
					"content": "Baiklah, cukup sampai sini dulu bicaranya. Nenek ini sudah terlalu tua dan terlalu banyak mengeluh. Anak muda, ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140116,
					"content": "Kami mau pinjam Lonceng Penyuci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ah, barang antik itu ya ... Benda itu memang nenek tua ini yang simpan, tapi sayangnya sudah lupa simpannya di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140118,
					"content": "Benda itu biasa dibawa oleh seorang kawan lamaku, waktu kami muda dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140119,
					"content": "Lonceng itu dia berikan padaku, karena aku serinng memandanginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140120,
					"content": "Namun dia juga bilang jika suatu hari nanti ada yang datang meminjamnya, aku harus rela berpisah dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140127,
					"content": "Sudah sekian tahun berlalu, dan aku sudah tidak ingat berapa kali lonceng ini dipinjam orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140128,
					"content": "Namun memang, sudah lama sekali tidak ada yang pinjam. Aku juga sudah tidak tahu berapa lama tepatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140129,
					"content": "Ah, aku sudah tua dan ringkih. Perlu waktu lama untuk cari satu barang saja. Mungkin kalian tidak ingin menunggu lama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140130,
					"content": "Kami bisa cari sendiri kok, Nek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Iya Nek. Boleh kan kami ikut ke rumah nenek dan bantu cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "Terus ... kami juga bisa bantu nenek beres-beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Baiklah, anak-anak. Tidak usah cemas, tempat penyimpanan lonceng itu tidak jauh kok letaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140136,
					"content": "Eh? Nenek tinggal di daerah sini? Wah, ini kan Yujing Terrace. Mahal loh di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Haha, nenek ini mana mampu beli rumah di kota ini. Liat poci teh ini? Rumahku ada di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140138,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "Mungkin maksud nenek, kunci rumah ada di dalam poci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Hehehe, anak-anak, maksudnya lonceng itu ada di dalam poci dan kalian boleh ambil ... kalau ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140140,
					"content": "Apa jangan-jangan isi rumah nenek cuma lonceng itu doang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Woy, sopan sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "Dan kalau misalnya benar juga, berarti bel itu mahal banget. Iya kan, Nek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Paimon, masuk. Periksain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Ngaco! Paimon enggak muat lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "Terus ngapain Paimon pakai masuk segala? Buka saja tutupnya terus lihay, beres kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "Aku ini lulusan jurusan pencarian barang hilang dari lembaga Knights of Favonius loh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "Kok bangga sama begituan sih, aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Kami mau pinjam sesuatu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "Sesuatu? Ah ... Lonceng Penyuci ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140123,
					"content": "Selain barang antik itu, kurasa aku tidak punya apa-apa lagi yang mungkin diperlukan anak-anak muda seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140124,
					"content": "Dan lonceng itu dulunya memang bukan milikku. Pemilik aslinya adalah seorang teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140125,
					"content": "Nenek tua ini cukup centil dan suka bersolek sewaktu muda dulu. Aku suka lonceng itu dan terus memintanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140126,
					"content": "Dia tidak bisa menolakku, dan akhirnya memberikan loncengnya. Tapi dia juga bilang jika suatu hari nanti ada yang datang meminjamnya, aku harus rela berpisah dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140105,
					"content": "Anda baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Tidak apa-apa, aku hanya merasa begitu banyak Glaze Lily yang sudah layu, sangat disayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
