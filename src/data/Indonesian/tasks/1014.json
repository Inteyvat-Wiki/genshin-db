			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "Anak-anak, bukankah kalian ingin segera menemukan loncengnya? Ayo, bergegaslah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140202,
					"content": "Berhati-hatilah. Sudah lama sekali aku tidak membereskan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140203,
					"content": "Kalian pakai baju bagus begitu, akan repot membersihkannya kalau sampai kotor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Anak muda memang gesit ya. Cepat sekali keluarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140302,
					"content": "Nenek ... Adeptus ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Adeptus ... Nama yang nenek tua ini sudah lama tidak dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140304,
					"content": "Adeptus atau bukan, tentunya kamu sudah mengerti bukan, anakku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140312,
					"content": "Aduh ... Paimon ngerti enggak ngerti nih jadinya. Nenek beneran mau kasih pinjam kami loncengnya begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Memangnya nenek enggak merasa aneh gitu? Ada kejadian yang menyangkut Rex Lapis, terus kami tiba-tiba saja nongol mau pinjam lonceng ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Anakku, Pelabuhan Liyue punya sejarah yang sangat panjang. Selama itu, tentu sudah banyak sekali Adeptus yang mangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140315,
					"content": "Dan ketika itu terjadi kami selalu mengutamakan Rite of Parting sebelum mengurus hal lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140316,
					"content": "Meneriakkan \"tangkap pembunuhnya!\" dengan lantang, namun menunda Rite of Parting, bagiku, itu sudah terbalik urutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140317,
					"content": "Dan kini kalian datang untuk meminjam lonceng. Mungkin ini artinya teman lamaku akhirnya memutuskan untuk mengambil tindakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140318,
					"content": "Jadi, kenapa aku harus tidak rela meminjamkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140319,
					"content": "Lalu kalau misalkan teman lama nenek tidak mengembalikan loncengnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Oh? Kalau itu terjadi, hahaha ... Akan ada nenek tua yang mengetuk pintu rumahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140321,
					"content": "Sudah lama pula kami tidak berjumpa. Senang juga kalau bisa bersua sambil minum teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140326,
					"content": "Yah, kalian pasti masih sibuk. Loncengnya sudah berhasil kalian dapatkan, jadi silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140327,
					"content": "Oh, titip pesan untuk orang yang mengirim kalian kemari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140328,
					"content": "Bilang padanya jika ada waktu, mampirlah minum teh. Nenek tua ini tidak punya apa-apa, tapi sepoci teh selalu ada untuk disajikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140329,
					"content": "Oke! Pasti kami sampaikan! Makasih ya Nek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Loncengnya boleh buat aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Hei! Namanya minjam itu harus dipulangin tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Buat kamu? Hahaha, kamu jujur sekali. Kalau kamu ingin, simpan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140325,
					"content": "Tapi lonceng ini suatu hari akan kangen rumah. Dan siapa tahu, mungkin lonceng itu akan pulang dengan sendirinya ke tangan nenek tua ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140305,
					"content": "Nenek ... Anggota Liyue Qixing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Liyue Qixing ... Anak-anak itu sudah lama melarangku dan teman-temanku ikut campur urusan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140307,
					"content": "Tapi kerja mereka akhir-akhir ini sungguh baik. Orang tua seperti kami jadi bisa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140308,
					"content": "Nenek ... Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "Fatui? Hahaha, apa yang ada di benakmu itu, anakku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140310,
					"content": "Nenek ini sudah terlalu tua untuk bercengkrama dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140311,
					"content": "Tapi jika mereka bertindak kelewat batas, maka nenek ini akan melakukan apa yang seharusnya dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
