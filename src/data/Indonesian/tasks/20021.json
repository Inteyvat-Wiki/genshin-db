			"dialogs": [
				{
					"id": 200210101,
					"content": "Oh, ayolah. Kenapa mau memakai wind glider saja perlu Surat Izin Meluncur sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210102,
					"content": "Anthony, apa kamu pernah mendaftar untuk Surat Izin Meluncur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210103,
					"content": "Aku tidak memakai wind glider, jadi aku belum pernah ikut ujiannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200210104,
					"content": "Kamu mau ikut ujiannya, Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "Yap. Semua petualang pasti akan menggunakan wind glider, jadi aku sedang berusaha berlatih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210106,
					"content": "Tapi aku tidak pernah tahu tentang Surat Izin Meluncur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210107,
					"content": "Sebenarnya aku sudah mendaftar untuk ikut ujian sih, tapi rasanya aku masih belum terlalu siap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210108,
					"content": "Pengembara, kata Amber kamu sudah punya Surat Izin Meluncur ya? Apakah kamu bisa mengajariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210109,
					"content": "Apa Amber yang jadi pengawasmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "Bukan sih, tapi aku bertemu dengannya waktu mendaftar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210111,
					"content": "Dia bercerita tentangmu waktu sedang menjelaskan cara pendaftarannya padaku. Dia bilang kamu lulus dengan sangat baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210112,
					"content": "Karena itu, aku terpikir untuk konsultasi denganmu tentang pertanyaan-pertanyaan di ujian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210115,
					"content": "Oke, jadi aku punya tiga pertanyaan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210116,
					"content": "Yang pertama ... satu wind glider bisa membawa berapa orang saat meluncur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210113,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "Oke deh! Terima kasih banyak ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				}
			]
		},
