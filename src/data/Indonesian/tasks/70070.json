				"points": []
			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "Oh? Kamu sudah selesai merapikannya? Lebih cepat dari perkiraanku loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Nah, kamu mau apa sebagai balasannya, Manis? Kamu sudah bantu aku bereskan semuanya sampai sore ini jadi kosong. Bagaimana kalau kita habiskan waktu bersama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "Aku mau dibayar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Oh, cuma itu? Tenang saja. Aku tidak akan lupa kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, kamu juga sadar rupanya. Judulnya aneh-aneh, dan isinya lebih aneh lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Apalagi, ini adalah perpustakaan terbesar di Teyvat utara, tapi aku tidak kenal satu pun judul dari daftar itu. Rasanya ini sesuatu yang tidak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "Kecuali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "Sebenarnya, kami baru saja bertemu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "Bertemu masalah ya? Kurasa aku tidak perlu ikut campur, kalau kalian tidak keberatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "Lagi pula, buku seperti apa pun selalu punya tempat di perpustakaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Lebih baik mereka masuk ke sini daripada jatuh ke tangan orang yang ... mencurigakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "Baiklah, ini bayaranmu. Terima kasih sekali lagi untuk bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "Aku mau tanya soal buku-buku ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
