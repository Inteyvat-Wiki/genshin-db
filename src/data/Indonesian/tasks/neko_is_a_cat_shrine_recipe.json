				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, kamu datang. Tepat waktu sekali. Diriku butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110802,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Berkat bantuanmu, kondisi kuil jadi meningkat, dan kita bisa berharap para pengunjung pasti akan segera datang ke kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110804,
					"content": "Diriku telah memberi perintah pada anak-anak untuk menjaga martabat dan tidak merendahkan diri mereka di hadapan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110805,
					"content": "Sayangnya, mereka sudah terbiasa berlarian ke sana kemari dan tidak mau mendengarkan perintahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110806,
					"content": "Namun demikian, diriku punya rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110807,
					"content": "Rencana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Saat diriku masih sangat kecil dulu, diriku juga senang bermain ke sana kemari. Agar diriku bisa akrab dan berbaur dengan kucing-kucing lain. Hibiki akan membuat makanan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110809,
					"content": "Ma—Makanan enak, katamu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Apa pun makanan yang dihidangkan, para kucing pasti akan datang dari pohon dan atap. Tidak peduli seberapa panasnya, atau bagaimana lidah kami terbakar saat memakannya, kami tidak akan bisa menahan godaan dari makanan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Setiap kali Hibiki selalu membuat seukuran pot besar, lalu manusia dan kucing akan memakannya bersama-sama. Bahkan orang yang mengunjungi kuil juga akan mendapat bagian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Ah, tapi Domeki... Ck, si serakah itu. Dia selalu makan banyak sekali. Sungguh tidak elegan, sungguh berbeda dengan diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "Jadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Bagus sekali, daya tangkapmu sungguh hebat. Iya, diriku ingin minta tolong padamu untuk membuatkan diriku makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Aku tidak meragukan kebijaksanaanmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Tapi kamu tahu kan bagaimana makanan ini harus dibuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Meong, meong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Bu—Bukankah menyerahkan hal-hal ini padamu merupakan inti dari latihan ini? Apa diriku harus melakukan semuanya sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "...Ah, tapi makanan itu memang enak sekali! Walaupun sudah lama sekali tidak memakannya, diriku masih ingat rasanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#Baiklah, {NICKNAME}, sepertinya ini jadi pekerjaan kita lagi ya? Bagaimanapun juga, ini demi kuil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Apa saja yang terkandung di dalam makanan itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Tentu saja diriku masih ingat. Fish meat, animal meat, rumput yang tumbuh di air, dan nasi putih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Ooh, jadi Fish, Raw Meat, Seagrass, dan Rice, eh... Jadi bagaimana itu dibuatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Diriku tidak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "...Sepertinya kita harus tanya ke koki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Oke, tapi ... Di mana kita bisa menemukan koki yang bisa membuat makanan kucing? Hmm ... Ayo kita tanya Taisuke dan Etsuko! Mungkin mereka tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Ayo kita tanya kedua petualang itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Oh iya, benar juga! Taisuke dan Etsuko kan petualang juga! Mungkin mereka bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Paimon, kamu gampang sekali ditebak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Ayolah, Paimon sekarang sudah jadi teman kucing-kucing ini! Neko, apa kamu masih ingat bahan-bahan yang digunakan dalam makanan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Kamu ingin aku membuatkanmu makanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
