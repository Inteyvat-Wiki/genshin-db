			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "Halo, selamat datang di Kiminami Restaurant. Mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110203,
					"content": "Tentang makanan untuk Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "\"Neko\" ...? Apa itu nama kucing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110205,
					"content": "Kamu kenal dengan Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110206,
					"content": "Tidak. Aku hanya berpikir nama itu bagus untuk seekor kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110207,
					"content": "Instingmu tajam juga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "Ah sudahlah. Jadi begini ceritanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110209,
					"content": "Jadi... ada Kuil Asase di Pulau Seirai, dan kuil itu merupakan rumah dari seekor kucing yang bisa bicara!? Terus kucing itu memintamu untuk membuatkannya makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110210,
					"content": "Apa... Apakah itu benar? Aku belum pernah dengar cerita semacam itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110211,
					"content": "Iya, benar kok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "Pulau Seirai! Benar, kan? Aku pasti akan pergi ke sana jika ada kesempatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110214,
					"content": "Itu... Makanan Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "Ah, iya... aku hampir lupa. Coba kupikirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110216,
					"content": "Hmm, makanan yang akan disukai seekor kucing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110217,
					"content": "Apakah ini hal sulit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110219,
					"content": "Sulit sekali ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "Ini adalah tantangan bagi keluarga Kiminami! Apa pun yang terjadi, aku pasti akan menyelesaikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110221,
					"content": "Baiklah. Aku percaya bahwa Fish, Raw Meat, Seagrass, dan Rice akan menjadi sebuah makanan yang bahkan seekor kucing pun akan menyukainya. Serahkan saja padaku, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110222,
					"content": "Paimon juga mau makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110223,
					"content": "Aku juga mau makan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "Baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110226,
					"content": "Biar kupikirkan bagaimana membuat resep dari ini semua. Sementara ini, tolong bantu aku menyiapkan 3 Seagrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110227,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "Tolong ya. Tiga saja sudah cukup. Kalau sudah ketemu, berikan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110229,
					"content": "Apa kamu sudah menemukan caranya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "Aku sudah memikirkan beberapa cara, tapi masih belum kuputuskan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110231,
					"content": "Pokoknya bantu aku dulu saja untuk mencari 3 Seagrass tadi. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110224,
					"content": "Kalau begitu kami serahkan padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "Kamu bisa pergi melihatnya sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
