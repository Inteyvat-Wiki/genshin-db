				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Nona Etsuko, selanjutnya kita pergi ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Fyuh... Ayo kita istirahat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Hmm? Oh ternyata kamu. Apa ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Tentang seorang koki yang bisa diandalkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Kamu mencari seorang koki? Di Pulau Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Oke, jadi begini. Neko ingin kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Heh. Jadi Nona Neko ingin kamu menyiapkan beberapa makanan, begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah, sial! Andai saja aku bisa masak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "Dengan kata lain, kamu membutuhkan seorang koki yang bisa membantumu memikirkan \"bagaimana membuat makanan yang akan disukai kucing dari bahan-bahan ini\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Biar kupikirkan dulu... Seorang koki ya... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "Kalau begitu, kenapa kamu tidak coba pergi ke Kota Inazuma dan mencari Kiminami Anna di Kiminami Restaurant saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "Dia orang yang baik, dan dia juga jago masak. Harusnya dia bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Terima kasih, kami akan segera mencarinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Tidak perlu berterima kasih pada kami. Pergilah, Taisuke dan aku masih harus merencanakan penjelajahan berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Hehe, yah, aku harap kuil ini benar-benar bisa bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Jika tidak, kerja kerasmu dan Neko akan sia-sia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
