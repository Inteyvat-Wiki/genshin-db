					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Apa kamu sudah membawakan makanan itu kepada anak-anak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "Mereka semua menyukainya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Begitukah? Bagus, bagus sekali. Meong, meong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Sudah lama sekali sejak diriku makan makanan seenak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Meong, meong, meong ... Walaupun sekarang diriku tidak lagi perlu makan atau minum, tapi rasa dari hidangan dengan nasi memang sulit ditolak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "Si kecil ini namanya Meshi, karena itu adalah nama terbaik yang bisa dipikirkan yang ada di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "Jadi, apa nama makanan yang akan dibuat Hibiki itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Nama? Memang makanan perlu nama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Ini disebut \"Invigorating Kitty Meal\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Nama yang rumit. Tapi, diriku tidak membencinya sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "Dan kamu benar. Makanan itu hal yang baik, dan semua hal baik harus punya nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Meong, meong, diriku akan tanya Hibiki saat dia kembali. Kamu juga bisa membuatkan makanan untuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "Lalu dia juga akan membuatkan makanan untukmu. Jadi kamu bisa makan dua jenis makanan enak yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Dan tentunya, itu jadi salah satu alasan kenapa diriku harus memulihkan kuil ini. Saat Hibiki kembali, kita akan makan bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Terima kasih. Ini lezat sekali. Miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
