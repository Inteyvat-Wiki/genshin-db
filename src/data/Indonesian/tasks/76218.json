			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marionette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh? Sudah datang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180102,
					"content": "Halo, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Terima kasih atas undangannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Hah? Bukannya di suratmu kamu bilang bakal ada pesta teh? Kok enggak ada apa-apa di sini? Jangan bilang ini pertemuan doang, enggak ada camilannya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Hah, mana mungkin sih, Paimon? Kamu kira aku bakal lupa siapin makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180107,
					"content": "Wuah! Ba-Barusan meja itu muncul dari mana?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Hehe, keren kan? Ini adalah meja teh portabel yang baru saja kukembangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180109,
					"content": "Mudah dibawa dan disimpan, bahkan dilengkapi dengan perangkat untuk membuatnya melayang, sama seperti milik Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180110,
					"content": "Lebih hebatnya lagi— Ah, ehm, sudahlah, aku enggak mau pamer dan jadi kedengaran kayak promosi jualan. Kalian bisa lihat sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180111,
					"content": "Ini, aku sudah menyiapkan teh dan camilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180112,
					"content": "Aku tidak sungkan-sungkan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mmm ...! Enak banget! Kamu emang jago masak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180115,
					"content": "Tapi kenapa kamu tiba-tiba membuat sesuatu seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Tentu saja karena aku ingin bisa menikmati pesta teh yang menyenangkan bersama teman-temanku, di mana pun mereka berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180117,
					"content": "Aku sudah pernah bilang ini sebelumnya. Mempertahankan apa yang sudah kamu miliki bukanlah satu-satunya cara untuk menjaga hal yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180118,
					"content": "Akhir-akhir ini, aku ingin lebih sering jalan-jalan dan mengunjungi teman-temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180119,
					"content": "Tapi mengundang diri sendiri ke rumah orang lain dan berharap mereka menyiapkan teh dan camilan, lalu membiarkan mereka membereskan meja setelahnya ... itu bukan etiket yang pantas untuk seorang wanita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180120,
					"content": "Hehe, Paimon rasa teman-temanmu enggak bakal keberatan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Aku yang keberatan. Lagi pula, penemuan sederhana kayak begini enggak susah sama sekali buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180122,
					"content": "Aku lihat kalian sangat menyukainya. Tenang, aku bisa buatkan juga untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180123,
					"content": "Hah?! Asli nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Tenang saja. Sudah kubilang kan, benda seperti ini bisa kubuat dalam sekejap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180125,
					"content": "Kalau begitu, terima kasih banyak ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Tidak perlu sungkan. Kalian sudah banyak bantu aku selama Festival Fontinalia. Anggap saja ini sebagai ucapan terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180104,
					"content": "Semoga kamu tidak menunggu terlalu lama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}