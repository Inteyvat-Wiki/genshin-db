						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cimest",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Anda dan katak origami itu sudah diakui sebagai Pelindung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Benar-benar sulit dipercaya! Belum pernah aku dengar yang seperti ini, juga belum pernah aku membaca catatan tentang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "Dan Anda masih harus mengubah ujiannya ... Tidak boleh! Tidak boleh! Tuan Putri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Anda tidak boleh mengubah warisan yang kuno begitu saja! TUAN PUTRI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Ya sudah! Kecilkanlah suara kalian. Sakit telingaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "Sudah sampai seperti ini. Aku kan Tuan Putri, juga Pelindung yang diakui benda suci. Kalian tidak bisa menghentikan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "Tapi ... Tuan Putri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "Tenang saja deh. Aku akan memimpin upacara ujian, dan akan melatih lebih banyak tupai terbang untuk melindungi kerajaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Setelah itu, aku baru akan pergi dari kerajaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Tuan Putri, kami ... Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Tenang sajalah, para paman sekalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700312,
					"content": "Aku ... pada akhirnya harus menyambut badai di luar sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700313,
					"content": "Sesuai perintah Anda, Tuan Putri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborn"
				}
			]
		}
	]
}