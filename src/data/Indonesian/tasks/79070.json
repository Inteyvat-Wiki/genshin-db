			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborn",
					"Souffache",
					"Cimest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Salam. Aku menyambutmu mewakili Kerajaan Lonceng Angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "Gimana rencanamu selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Uhm ... Pertama-tama, aku akan umumkan ke seluruh kerajaaan kalau benda suci sudah menilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "Kalau soal Pelindung, ya ... kita punya Tuan Faurobert yang datang dari jauh itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Eh? Kok begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Kalau mau jelaskan semua yang sudah kita lalui, sepertinya terlalu rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "Lagian, mereka juga pasti tidak bisa langsung paham kenapa aku bisa jadi putri dan Pelindung sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "Kalau waktunya sudah cocok, aku akan mencatat semua detailnya dan memberitahukannya kepada semua orang secara tertulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "Sebelum itu, aku masih akan memimpin semua urusan yang ada di kerajaan sebagai putri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "Setelah \"arena ujian\" resmi diubah menjadi \"arena pelatihan\", aku akan berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Berangkat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Yang Mulia, masih ingatkah ... karena siapa benda suci itu menyala ketika di gua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Eh? Karena siapa ... menyala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Betul. Saat itu kita semua ada di dekat benda sucinya. Tentu saja Tuan Putri layak diakui, tapi aku ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Kamu juara yang diakui oleh juara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Benar. Dan juara itu sengaja datang buat cari kamu loh. Apa iya dia enggak pantas diakui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "Mungkin karena Tuan Putri terlalu bersinar, sehingga semua orang jadi salah kaprah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Kalau begitu, Tuan Juara. Apa kamu bersedia menerima ujian sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "Biarlah aku, Putri Cimest kerajaan selaku pemegang benda suci, yang menjadi saksi atas perbuatan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "TENTU! BERSEDIA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Jangan keras-keras woi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Langsung jadi semangat dia kalau ngebahas Tuan Putri. Hehe, duh duh Faurobert ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Kalian jangan salah paham ya! Ini semua, demi ... demi Kolam Nyanyian Hujan! Aku sudah melewati banyak latihan, semua itu cuma untuk selamatkan ... anu ... Tuan Putri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "Misi sepenting ini tentu harus serius ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Kamu bersedia berjalan bersama Tuan Putri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "Ya ... bersedia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Hehe. Baguslah kalau begitu. Jadi, Faurobert, Tuan Juara, sudah siap menerima ujian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "Siap, Tuan Putri! Siap setiap saat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Wow! benda sucinya nyala loh! Gi-Gila, SILAUUU BOS!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Yang dengar bisa budek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Apa yang mau kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
