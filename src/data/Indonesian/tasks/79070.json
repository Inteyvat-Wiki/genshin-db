							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Faurobert",
					"Horellou",
					"Estampe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe! Kamu ke mana saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Eh? Aku cuma iseng jalan-jalan, lalu cobain ujiannya. Menarik juga, tapi cuma bisa lulus pakai cara lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Aku sudah dengar cerita kalian dari Tuan Horellou. Lumayan juga ya, Tuan Pelindung. Kamu benar-benar hebat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "Ka-Kamu ... Kalau di sampingku, jangan salahkan aku kalau kamu kudorong ya! Hati-hati kudorong sepuluh kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Makanya aku ikut ujian. Faurobert, teman baik, aku percaya kamu pasti bisa. Lihat, benar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Hahaha. Wahai kedua tuan yang baik, hari ini adalah hari baik untuk Kolam Nyanyian Hujan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Kami akhirnya memiliki juara sejati. Meski Tuan Faurobert masih belum punya kesempatan untuk menolong Tuan Putri, tapi aku percaya dia pasti akan bisa menunjukkan kemampuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "Hah! Aku tidak melakukan apa pun. Tuan Horellou, aku cuma melihat dari samping saja. Semua ini benar-benar karena bantuan dari Tuan Putri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "Bukannya lebih baik? Atau Anda malah ingin Tuan Putri terperangkap dalam bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Aku ... Anu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Sudahlah, Tuan Faurobert. Anda sudah mengemban misi yang diberikan oleh Cibrelus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "Sembarangan! Aku bahkan tidak tahu dia itu benar Cibrelus atau bukan! Aku cuma pernah dengar soal dia, belum pernah dengar dia berbicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Lagian, kamu sudah menerima ujian dari putri itu. Benar-benar juara yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Kalau begitu, jangan bahas masalah ini dulu deh. Tolong deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Pokoknya, masa depan dari Kolam Nyanyian Hujan diserahkan ke tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Akhirnya kita sekarang bisa melompat tanpa tekanan apa pun. Aku akan kembali dan berikan masukan kepada komite, untuk menambahkan lebih banyak isi yang menarik dalam kontes lompat jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "Ide bagus nih! Aku mau memimpinnya. Kita balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Hei! Jangan tinggalkan aku di sini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
