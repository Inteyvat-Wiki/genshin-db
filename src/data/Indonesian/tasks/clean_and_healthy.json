					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "Terima kasih banyak, Pengembara. Imbalan ini mohon diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "Omong-omong, akhir-akhir ini Tuan Gurgen sering memaksakan diri untuk bekerja. Apa aku perlu cari waktu untuk menasihatinya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "Belakangan ini banyak urusan yang melelahkan. Lain kali aku mungkin butuh bantuanmu membereskannya.",
					"roleType": "TALK_ROLE_NPC",
