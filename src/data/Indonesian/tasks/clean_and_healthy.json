			"dialogs": [
				{
					"id": 230060301,
					"content": "Pengembara, ada yang kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Tentang Zakariya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Zakariya adalah seorang dokter yang sangat hebat dan pengikut Archon Dendro yang sangat setia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Dia sering mengobati orang sakit tanpa kenal lelah, bahkan untuk makan saja dia sering melewatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Dokter Zakariya berkata, membuat semakin banyak orang bisa menerima berkat Archon Dendro itu adalah misinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Apakah pengobatan kalian sangat bergantung pada berkat Archon Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Lebih tepatnya, \"penyembuhan penyakit\" itu adalah anugerah Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "Archon Dendro melindungi kami, sehingga kami bisa menemukan cara menyembuhkan penyakit dan membudidayakan ramuan penyembuhnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Terima kasih Archon Dendro yang sudah menjauhkan kami dari penyakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
