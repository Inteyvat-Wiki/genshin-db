			"trigger": {
				"objectNames": [
					"Golshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "Huh, jam-jam segini mana mungkin ada orang yang bisa membantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "Ah! Halo Pengembara, kamu butuh pengobatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Cuma lewat saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Haha ... kelihatan jelas ya? Tapi, aku memang sedang banyak pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Tidak tahu kenapa, akhir-akhir ini banyak orang yang berobat di \"Bimarstan\", hampir semua karyawan kami ikut menjaga pasien sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Tapi Dr. Zakariya masih menyuruhku untuk membersihkan sekitar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Dia bilang supaya semua orang bisa mendapatkan berkat dari Archon Dendro, kita harus menjaga kebersihan jiwa dan raga pasien di dalam maupun luar rumah sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "Uhh, tapi tidak ada orang yang bisa membantu sekarang, aku tidak mungkin minta tolong pada pasien yang penyakitnya ringan untuk membantu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Kalau begitu, serahkan padaku saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Kamu mau bantu? Kalau begitu terima kasih banyak! Aku akan memberikan imbalan, walaupun, walaupun tidak banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "Uhh, semoga Archon Dendro melindungi semua orang dari penyakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Memangnya tidak ada orang yang bisa dipekerjakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Di sini hampir semuanya pasien, dan tidak banyak orang yang bersedia membantu. Di sisi lain uang kami juga terbatas, tidak bisa mengupah banyak pekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Biasanya kami piket bergantian, tapi sekarang sangat sibuk, sudah tidak ada orang yang kosong waktunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "Pengembara, kalau ... kalau kamu bersedia, bolehkah bantu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "Kami akan memberikan imbalan! Walaupun, walaupun tidak banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Penyakit pasien-pasien di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "Penyakit pasien di sini sebenarnya adalah penyakit ringan seperti sakit kepala dan lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Dr. Zakariya juga sudah memberi tahu berulang kali bahwa penyakit ini tidak berbahaya, tapi tidak ada orang yang percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Aku rasa mungkin mereka bukan takut pada penyakitnya, tapi takut tertular penyakitnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "Urusan bersih-bersih kuserahkan padamu ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Kamu kelihatannya sedang banyak pikiran ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
