				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Apa kamu perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "Oh, ternyata Pengembara. Baik sekali kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Saat ini adalah musim pematangan anggur yang sangat penting. Tapi sekelompok boar muncul entah dari mana dan mereka mengincar kebun anggur ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "Aku tidak sanggup mengusir mereka sendirian dan putraku juga tidak bersamaku sekarang. Jadi aku hanya bisa pasrah melihat mereka menghancurkan lahanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "Kalau kamu bisa membantuku mengusir boar-boar itu, aku akan memberimu imbalan yang memuaskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
