			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Halo, apa kamu membawa pesan dari putraku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "Siapa kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Aku? Teman-teman di winery memanggilku Old Tunner. Aku adalah petani Dawn Winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Keluargaku telah mengolah tanah ini selama beberapa generasi. Anggur enak yang pernah kamu cicipi, aku yakin kebanyakan difermentasi menggunakan anggur dari lahan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Setiap pemilik winery selalu memperlakukan keluarga kami dengan sangat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Tetapi aku tidak ingin anak cucuku melanjutkan usaha ini kemudian menghabiskan seumur hidup di lahan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Putramu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Guy! Nama dia Guy, putra tercintaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Apa? Kamu belum pernah mendengar tentang dia? Hahaha, bukan masalah. Cepat atau lambat kamu akan tahu. Orang-orang di seluruh Mondstadt mengenal dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Putraku Guy akan menjadi Knight terkuat di dalam Knights of Favonius. Begitulah katanya padaku dan aku percaya dia pasti bisa mewujudkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Huff, sejak dia masih kecil, aku sudah menghabiskan seluruh penghasilanku untuknya agar dia bisa mempunyai masa depan yang lebih baik daripada bertani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Tapi bocah itu benar-benar punya tekad keras. Dia sudah menjadi Knight pemula saat baru menginjak 16 tahun. Sejak itu keluarga kami pun menggantungkan harapan besar padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Selamat tinggal",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Sampai jumpa! Kalau kamu bertemu dengan putraku Guy, tolong katakan padanya untuk pulang ke rumah sesekali waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
