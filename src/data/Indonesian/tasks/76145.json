				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "Mantap! Ludes semua lagi. Strategi \"cuan kecil omset gede\" hari gini masih bisa ya ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450602,
					"content": "Aku seharusnya sekarang langsung cabut ke Snezhnaya, tapi ... cuan dari bisnis kali ini cuma cukup buat perjalanannya, ada lebih dikit doang. Aku pergi dari sana dengan tangan hampa, masa sih pulang harus dengan tangan hampa juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450603,
					"content": "Tapi intinya, terima kasih dukungannya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Ah, takdir memang suka bercanda ... bisa-bisanya ketemu sama kamu lagi! Mau lihat-lihat dulu, mungkin? Kali ini barangnya bagus-bagus semua loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "Mana sih, lihat, jadi kepo juga aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Semuanya barang eks-perlengkapan Fatui. Eksklusif, cuma ada di sini saja doang! Silakan dipilih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "Katanya mau pulang ke Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Yah, sebenarnya rumahku tuh di Novokitezhgrad. Keluargaku semuanya kuli tambang. Lebih keras daripada Domovoy, dan waktu aku bilang mau coba bisnis, mereka semua anti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Jadi pas berangkat, aku bersumpah tidak akan pulang sebelum jadi hartawan ... Eh, kenyataannya malah duit buat pulang kampung saja pas-pasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Aku sudah tidak mikir mau cuan besar atau jadi kaya raya sih, tapi setidaknya jangan nol banget lah ... minimal pulang tuh ada hasilnya, gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "Kenapa kamu ada di wilayah Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "Ah, aku ini warga Snezhnaya yang taat aturan! Diam di tempat yang banyak Fatui-nya justru bikin aku lebih nyaman dan aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "Semua barang di sini tuh eks-perlengkapan Fatui, mereka juga yang secara khusus minta tolong aku buangin. Makanya, barang-barang ini eksklusif, cuma ada di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "Makasih, tapi enggak usah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Ah ... sayang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "Makasih banyak, sungguh ... Akhirnya aku bisa pulang dengan kepala \"sedikit\" tegak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450902,
					"content": "Kali ini beneran terakhir ya. Kamu sudah belanja banyak banget dari aku, hubungan kita sudah lebih dari sekadar pembeli dan penjual nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450903,
					"content": "Kalau suatu hari nanti kamu main ke Snezhnaya, cari aku di Novokitezhgrad! Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		}
	]
}