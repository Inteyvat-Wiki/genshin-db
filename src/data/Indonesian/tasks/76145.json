			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "Bisnis sekarang sepinya luar biasa. Kayaknya mending nabung dan sewa lapak di Kota Nasha kali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "Ada barang bagus apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Cuma mainan dari Natlan lah. Silakan kalau penasaran ingin lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Ah, ada tamu! Halo, aku Kuzmich, pedagang keliling dari Snezhnaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Yah, resminya sih gitu, tapi sebenarnya usahaku cuma sampingan buat modal, kelilingnya yang utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Tapi waktu tempo hari singgah di Natlan, orang-orang di sana asli kelewat semangat, aku kebawa suasana dan ... yah, intinya kalau ini tidak laku semua, beli tiket pulang saja kayaknya tidak bakal bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "Mau pulang ke Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Iya, setelah ini semua laku, aku mau beli tiket kereta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Di sana dingin sepanjang tahun, di mana-mana penuh es dan salju. Sehari-hari kita umumnya cuma diam di kota biar tidak mati kedinginan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Tapi setelah pergi selama ini, aku jadi kangen hari-hari bisa tidur dan rebahan seharian di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "Tapi kayaknya lagi sepi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Iya, sepi. Tapi kalau mau buka lapak di kota, aku harus ajukan kredit ke Northland Bank. Katanya yang di Kota Nasha tuh banyak oknum tukang main skema, kurang bagus reputasinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "Ah, masa bodohlah. Setidaknya di sini banyak pejalan kaki lewat. Asal masih ada orang, nanti juga barang-barang ini bakal laku semua, ya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Aduh, aku buru-buru nih, maaf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Loh, kok sudah mau pergi lagi? Boleh dilihat dulu sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "Oh, astaga, laku semua, ludes tanpa sisa! Ternyata aku bakat juga ya jualan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450302,
					"content": "Habis ini aku akan minta Lightkeeper di sana antar aku melewati Rawa Bayang Kelam. Setelah itu, tinggal lurus saja ke arah utara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450303,
					"content": "Mungkin di jalan balik nanti ada peluang bisnis lagi ... yah, kita berpisah dulu ya, kawan. Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "Kebetulan yang luar biasa, kita betulan ketemu lagi! Mau belanja? Barang-barangku masih belum ada yang keluar nih ... tolong dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Mana sini lihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "Semuanya barang khas daerah. Tenang, kalau buat kamu, harganya sudah pasti terbaik lah pokoknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "Kenapa malah belanja lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Yah, gitu deh, namanya juga bisnis. Mumpung masih panas mesti digarap, ya kan? Aku dapat peluang bagus di Piramida. Ada yang mau jual cepat, dan harganya bagus banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "Yah, akhirnya aku malah jadi hitung-hitungan dan lupa keadaannya lagi di jalan mau pulang ... singkat cerita, semuanya aku borong, dan sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Coba, pikir kenapa dia segitunya mau jual cepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Ahh, sudah, jangan nyinyir gitu ... aku tahu kok. Coba kamu lihat dulu deh barangnya, siapa tahu ada yang bisa kepakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Maaf, ada perlu dulu nih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "Eh ... eh, jangan pergi dulu, tolong! Masa sih tidak ada yang kamu butuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
