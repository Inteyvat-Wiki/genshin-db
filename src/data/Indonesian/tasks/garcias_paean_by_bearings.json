				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Ukuran bantalan ini terlalu besar, tidak bisa dipadukan dengan bantalan lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "Sebelumnya terlalu kecil, sekarang terlalu besar! Lama-lama Iron Chunk milikku bisa habis kamu pakai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "Sebenarnya, uang kami juga sudah hampir habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Kalian lagi ribut apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Orang ini minta aku buatkan tabung besi dan roda gigi yang banyak, dan keduanya harus punya spesifikasi yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "Gara-gara mau buat semua ini untuknya, Iron Chunk-ku sudah hampir habis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Tapi dia masih bilang belum cukup dan perlu lebih banyak roda gigi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "Tolong dengarkan penjelasan pekerjaanku sekali lagi. Setelah itu, kamu pasti bisa mengerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "Apa sih yang diributkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Biarkan Tuan Garcia jelaskan saja pada Tuan Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "Pengembara, aku ... eh, Tuan Garcia mau minta bantuanmu untuk mengumpulkan Iron Chunk, apa kamu bersedia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Aku lagi senggang sih, tapi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Untuk pembuatan mesin ... kami menemukan beberapa hambatan yang sudah diprediksi sebelumnya, Tuan Garcia sekarang sedang pikirkan cara membereskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Kalau kamu tertarik, tanyakan saja ke Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Aku pikir ... tidak ada yang bisa menjelaskan cara kerja mesin itu selain dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Tapi sebelum itu, tolong bawa kembali beberapa Iron Chunk dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Bagaimana kabar modifikasi mesinnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
