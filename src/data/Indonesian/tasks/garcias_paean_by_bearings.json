				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Kamu mau ngapain sih pakai roda gigi dan tabung besi sebanyak itu? Mau buat rumah besi atau apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Benar, Tuan! Aku mau bangun satu rumah ... yang penuh dengan roda gigi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Aku kasih nama sebagian area yang punya roda gigi \"gudang\", sedangkan bantalan dan sebagian roda gigi lainnya akan menjadi \"basis angka\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Roda gigi di \"gudang\" dipakai untuk menyimpan angka, dan roda gigi di \"basis angka\" dipakai untuk menghitungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Kamu pasti langsung mengerti kalau aku gambar, ada kertas? Tidak ada? Tidak apa-apa, aku gambar di baju, biar bisa lebih jelas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Bisa ambilkan arang itu? Terima kasih, coba lihat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
