			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> kayaknya mendengar sesuatu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "Aneh ... Sepertinya tadi aku mendengar sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Ah, ada tamu! Ayo, ayo! Putar rodanya, terus berhentikan. Nanti ada makanan enak!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Eh? Kenapa kamu tidak putar rodanya? Ayo cepat putar. Makanan enak menanti!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Yang barusan itu ... suara anjing kecil, ya? Putar rodanya untuk dapat makanan enak ... Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Halo, tamu! Kamu bisa ngomong sama aku ya? Ayo putar rodanya, biar aku bisa makan enak!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Kamu lapar? Aku ada biskuit. Nih, ambil satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hmm? Kamu tidak putar rodanya, tapi mau kasih makanan ...? Hmm, oke deh, aku terima.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Terima kasih, tamu. Namaku Pavlov. Terima kasih biskuitnya, enaaak sekali! Tapi kamu belum putar rodanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Sama-sama ... Tapi kalau boleh tanya, apa maksudnya \"putar roda\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Kalau rodanya diputar lalu berhenti, nanti ada makanan enak keluar. Biasanya selalu begitu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Kamu benar-benar tidak mau putar rodanya, tamu yang baik? Biasanya semua senang kalo rodanya diputar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Aku tidak usah ... Sepertinya kamu senang ya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Iya, iya! Banyak yang main sama aku, ada roda juga, dan ada makanan enak.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Baguslah. Titip salam untuk majikanmu, ya. Aku pamit dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Ohh ... Sampai jumpa, tamu! Datang lagi ya!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
