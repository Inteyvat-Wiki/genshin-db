			"dialogs": [
				{
					"id": 220460101,
					"content": "Kuilnya jadi berantakan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Miaw, ternyata kamu. Selamat datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460104,
					"content": "Setelah beberapa lama ditinggalkan, sekeliling kuil ini sudah berdebu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460105,
					"content": "Kalau begini, kita tidak bisa menyambut manusia yang datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460106,
					"content": "Apakah kamu bisa membantu diriku membersihkan kuilnya lagi, seperti waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460107,
					"content": "Bukannya kamu punya Taisuke dan Etsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Diriku... tidak akan memulai pembicaraan dengan dua manusia hijau itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460109,
					"content": "Manusia yang tinggi itu selalu melihat diriku dengan tatapan yang aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460110,
					"content": "Dan manusia hijau satu lagi terlihat sangat... lemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460111,
					"content": "Miaw miaw, pokoknya mereka berdua tidak bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460115,
					"content": "Bagaimanapun juga, diriku hanya bisa meminta tolong pada dirimu. Tolong gunakan tongkat panjang dan air untuk bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460116,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Pokoknya kuserahkan padamu ya. Diriku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460119,
					"content": "Diriku akan menunggumu di sini, miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460117,
					"content": "Aku sudah tahu, kira-kira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Kamu bisa minta tolong Tuan Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "Manusia batu ini selalu sibuk mengetuk sana sini. Entah apa yang sedang dia ketuk-ketuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460114,
					"content": "Jelas-jelas batunya sudah selesai diketuk. Tidak tahu dia sedang mengetuk apa lagi sekarang... Merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				}
			]
		},
