					"nextDialogs": [
						220460303
					]
				},
				{
					"id": 220460303,
					"content": "Miaw miaw, bagus sekali. Kamu benar-benar bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460304,
					"content": "Kuil ini semakin lama semakin bagus. Ah, Hibiki pasti senang sekali saat dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460305,
					"content": "Diriku harus terus merawat kuil ini dengan baik... Miaw miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
