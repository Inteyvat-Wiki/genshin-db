			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#Terima kasih banyak, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Awalnya aku pergi untuk melihat situasi di kebun anggur, namun malah terjadi hal seperti tadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "Ah, tolong jangan beri tahu putraku. Dia salah seorang Knight di Knights of Favonius. Dia pasti sibuk sekali sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Tidak perlu mengganggunya hanya karena orang tua ceroboh sepertiku menemui sedikit masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Tapi akhir-akhir ini, para Slime sering bermunculan di dekat kebun anggur. Setiap hari aku khawatir mereka akan menghancurkan kebun anggurku, sampai-sampai aku tidak bisa tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Jika kalian ada waktu, tolong bantu orang tua ini untuk memeriksa sekeliling dan mengusir para Slime itu, tolong jangan biarkan mereka menghancurkan kebun anggurku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Terima kasih, akhirnya aku bisa istirahat sejenak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "Ah, sebenarnya aku ingin melakukannya sendiri... Sayangnya orang tua sepertiku sudah tidak bebas bergerak lagi, anak muda, tolonglah orang tua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
