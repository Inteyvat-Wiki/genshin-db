			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "Ini adalah Papan Pengumuman Feiyun Slope. Berita atau kabar area sekitar, ataupun iklan toko-toko dan restoran akan diumumkan di sini. Bagi yang tidak punya tujuan jelas, diharapkan untuk tidak menempel iklan sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 718040202,
					"content": "Tentang pemindahan personel Bagian Urusan Sipil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "\"Pengumuman pemindahan personel Bagian Urusan Sipil adalah sebagai berikut...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 718040204,
					"content": "Tunggu sebentar, perpindahan personel Bagian Urusan Sipil seharusnya tidak ada hubungannya dengan izin usaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Tentang masalah pencemaran air di Feiyun Slope...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "\"Tentang pencemaran air di Feiyun Slope baru-baru ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 718040207,
					"content": "Tuan Ivanovich sedang terburu-buru sehingga tidak ada waktu untuk mengurusi masalah pencemaran air seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Mengenai permohonan izin usaha baru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "\"Jika kamu perlu mengajukan izin usaha baru, kamu harus melalui prosedur berikut...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 718040210,
					"content": "Ini pasti izin usaha baru yang ingin diajukan oleh Tuan Ivanovich. Ayo cepat kita catat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
