				{
					"id": 718040401,
					"content": "Mengapa prosedur untuk dokumen ini tidak lengkap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040402,
					"content": "Tentang izin usaha baru milik Ivanovich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich... oh, dia pernah ke sini beberapa kali sebelumnya, aku ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040404,
					"content": "Apakah dia menjalani prosedur untuk izin usaha baru? Haha... dia pasti lelah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040405,
					"content": "Kamu di sini untuk membantunya ya? apakah kamu membawa <color=#00E1FFFF>Persetujuan Melaut</color>? Aku mengatakan kepadanya terakhir kali bahwa prosedurnya tidak lengkap dan dia harus pergi ke tempat lain untuk melengkapinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				}
			]
		},
