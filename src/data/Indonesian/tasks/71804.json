			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Jadi apa kamu sudah menemukan pengumuman tentang izin usaha yang baru itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "Iya, sudah kucatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Bagus sekali, biar kulihat dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Persetujuan Melaut, Sertifikat Bisnis dan Keamanan serta... Izin Usaha Lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "Bagus, bagus, untungnya aku baru saja menandatangani dokumen-dokumen ini beberapa hari yang lalu, walaupun rasanya melelahkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "Pengembara, maaf merepotkanmu lagi tapi bisakah kamu membantuku menyerahkan dokumen-dokumen ini secara terpisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Uhuk... mungkin harus diserahkan kepada beberapa orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "Pertama-tama, berikan <color=#00E1FFFF>Persetujuan Melaut</color> ke Nervous An, lalu berikan <color=#00E1FFFF>Sertifikat Bisnis dan Keamanan</color> ke prajurit Millelith, Jiayi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Lalu <color=#00E1FFFF>surat izin usaha yang lama</color>, tolong berikan kepada Clerk Zhao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "Pengembara, tolong bantulah aku lagi untuk berlari dan menyerahkan itu semua, aku pasti akan membayarmu dengan cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Baiklah, baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Aku berharap setelah menyelesaikan prosedur ini, aku tidak perlu lari lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Kuharap nanti tidak usah berlari lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Kamu seharusnya tidak usah melalui berbagai hal formalitas semacam ini, tapi aku... melakukan bisnis di sini, jadi tidak bisa dihindari lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "Sayangnya, meski cara ini benar-benar menjamin keamanan dan kesejahteraan, tapi akan lebih baik jika bisa disederhanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
