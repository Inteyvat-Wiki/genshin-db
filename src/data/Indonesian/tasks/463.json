					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Kalian akan memaafkanku, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "Aku benar-benar beruntung mempunyai teman yang pengertian dan pemaaf seperti kalian.",
