					"content": "Benar saja, sebenarnya tidak ada harta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "Kamu membohongi kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "Kalau mereka tidak menyebarkan <color=#00E1FFFF>informasi buatan</color>, kita tidak akan bisa menjebak Treasure Hoarder.",
