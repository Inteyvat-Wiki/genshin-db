					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630313,
					"content": "Ukh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630314,
					"content": "Aneh sekali! Padahal kita sudah menjaga rahasia ini sebaik mungkin, kenapa mereka bisa tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630315,
					"content": "Kamu bilang... sebaik... mungkin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Huh! Bagaimanapun kita tidak akan menyerahkan hartanya begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630317,
					"content": "Kuperingatkan untuk tidak meremehkan kami kalau tidak mau menyesal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630318,
					"content": "Orang-orangku sedang berada di luar dan mereka sedang menunggu perintah dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630319,
					"content": "Sayangnya, mereka tidak akan... sebaik aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630320,
					"content": "(Kaeya dan Knights of Favonius muncul)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630321,
					"content": "Maaf, aku jadi mengganggu tawa kemenanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630322,
					"content": "Tapi orang-orangmu di luar itu tidak mungkin lagi membantumu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630323,
					"content": "Kalau kamu bertanya kenapa, kunjungi saja mereka di... Penjara Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630324,
					"content": "Atau mungkin... kamu ingin bergabung dengan mereka seterusnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630325,
					"content": "Knights of Favonius...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630326,
					"content": "Wah, Kaeya datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630327,
					"content": "Kaeya, dia mau merebut harta karunmu! Cepat tangkap dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630328,
					"content": "Cih! Sudah sejauh ini, hanya kurang sedikit saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630329,
					"content": "Oh, maksudmu harta itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630330,
					"content": "Maaf, sebenarnya, di sini sama sekali tidak ada harta apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630331,
					"content": "Kalian datang sejauh ini... hanya untuk tertangkap. Menyerahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630332,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630333,
					"content": "Tidak ada... harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630334,
					"content": "Kaeya barusan bilang... di sini tidak ada harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630335,
					"content": "Hah. Ternyata aku jatuh ke dalam perangkap... Tidak kusangka Knights bisa menipu orang dengan cara seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630336,
					"content": "Seorang pencuri tidak berhak sama sekali untuk mengkritik cara kerja Knights of Fav – Hei tunggu, apa yang kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630337,
					"content": "Aku tidak akan tertangkap oleh kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630338,
					"content": "A... apa ini? Aku tidak sengaja!",
					"roleType": "TALK_ROLE_NPC",
