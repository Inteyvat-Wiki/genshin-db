				},
				{
					"id": 4630014,
					"content": "Tapi benar-benar deh, peta harta karun ini benar-benar tidak jelas... seperti digambar oleh bajak laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630002,
					"content": "Kalau begitu sekarang...",
