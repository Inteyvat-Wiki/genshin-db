					"nextDialogs": [
						4630520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630520,
					"content": "Kalian sudah membantuku, bagaimanapun aku harus berterima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630521,
					"content": "Ini adalah \"Triumphant Harbinger of Dawn That Points Towards Victory.\" Sesuai namanya, pedang ini melambangkan cahaya dan kemenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Kalau kalian tidak keberatan, aku ingin kalian menerima Harbinger of Dawn ini sebagai imbalan.",
