					"nextDialogs": [
						4630516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630516,
					"content": "Kalau tidak, mana mungkin kamu tidak memberitahuku dan tidak mengajakku untuk ikut mencarinya?",
