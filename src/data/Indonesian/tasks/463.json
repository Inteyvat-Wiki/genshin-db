			"dialogs": [
				{
					"id": 4630001,
					"content": "Kali ini, semua misteri benar-benar terpecahkan. Tidak mudah juga, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
