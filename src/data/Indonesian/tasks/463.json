				},
				{
					"id": 4630003,
					"content": "Sebaiknya kita melapor ke Kaeya dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Hmm? Menurut Paimon... sama... sekali... tidak... perlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "Kamu bisa membaca pikiranku! Paimon senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630007,
					"content": "Ayo kita pergi! Jangan sampai keduluan orang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630008,
					"content": "Seperti... seperti Treasure Hoarder yang Kaeya sebut-sebut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "Aku, hanya ingin pinjam pedang itu sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630010,
					"content": "Bu, bukan, makudku hanya ingin melihatnya saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630011,
					"content": "Bukannya aku ingin memakainya dan jadi super kuat... aku hanya ingin... main-main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630012,
					"content": "Oke, Paimon akan membicarakan lagi hal ini nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630013,
					"content": "Perburuan harta Arcadian, dimulai!",
