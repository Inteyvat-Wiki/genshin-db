					"nextDialogs": [
						4630517
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630517,
					"content": "Ah, um... tapi... Hmph!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630518,
					"content": "#{NICKNAME}, ayo pergi! Buang-buang waktu saja bicara dengan orang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "Paimon"
				},
				{
