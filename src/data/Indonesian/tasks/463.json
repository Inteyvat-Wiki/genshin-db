					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "Harbinger of Dawn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Benar. Sangat cocok untuk gadis penuh disiplin dan baik hati sepertimu, bagaimana menurutmu, Paimon?",
