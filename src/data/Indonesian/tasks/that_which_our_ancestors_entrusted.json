			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "Angin selatan bertiup di Pulau Watatsumi. Artinya, akan ada sahabat yang datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "Setiap kali kamu ngomong gitu, kami yang sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Jangan begitu ah. Kerja sama kita tempo hari kan berbuah manis? Paling manis, malah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Yah, aku memang mau minta tolong kalian lagi sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "Cerita turun temurun di keluargaku bilang masih ada satu ujian lagi selain Watatsumi Goryou Matsuri, yang tidak berhubungan dengan hidup atau matinya pulau, melainkan berkaitan dengan kebenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Ujian ... lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Nah, berhubung sekarang pulau ini sudah aman, aku mau bilang ini sama kalian. Anggap saja kewajiban klan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Kalian bisa ke Serpent's Heart. Petunjuk ujian kedua ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "Fiuh, lega deh rasanya! Tanggung jawab super berat ini sudah bisa kuserahkan ke putriku yang di masa depan nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "Begitu ya caramu menghormati misi dari leluhur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "Paimon masih saja bingung sama Tsuyuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
