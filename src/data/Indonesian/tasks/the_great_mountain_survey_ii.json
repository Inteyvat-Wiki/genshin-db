			"dialogs": [
				{
					"id": 701080301,
					"content": "Apa kamu sudah meletakkan sinyal pandunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Baiklah, terima kasih banyak, dengan begini aku pasti bisa mengamati ketinggian gunung salju itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Oh ya, mengenai imbalanmu aku sudah meminta Cyrus menyiapkannya, kamu dapat mencarinya di kota untuk mengambil imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Lalu, tolong bawakan surat ini padanya, dia berjanji padaku untuk membantuku mengawasi tim ekspedisi kedua ke gunung, tapi sampai sekarang belum ada kabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Setelah sinyal pandu selesai diperbaiki, aku masih harus pergi ke gunung untuk memasangnya lagi. Masih banyak hal yang harus dilakukan untuk mengamati gunung ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
