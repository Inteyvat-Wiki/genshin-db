			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Halo, ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Surat ini untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Surat? Oh... Surat darinya, aku mengerti, pasti dia ingin bertanya tentang tim ekspedisi itu lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*huff* Tapi sayangnya aku juga tidak dapat berbuat apa-apa, jarang ada tim ekspedisi yang mau pergi ke gunung salju itu sekarang, tempat itu memang sangat berbahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Aku akan menulis surat untuknya dan menjelaskan tentang situasinya, terima kasih telah membawakan surat ini padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Ini imbalan yang dia siapkan untukmu, terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Satu lagi... aku tahu kamu kuat, tapi tetap saja, berhati-hati lah saat berada di gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "*huff* Dragonspine... Kalau saja aku ada waktu, pasti aku akan memimpin tim ekspedisi untuk pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
