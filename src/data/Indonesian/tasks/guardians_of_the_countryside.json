			"dialogs": [
				{
					"id": 718230701,
					"content": "Tunggu dulu... sepertinya sekarang bukan waktu yang tepat untuk mengambil Lotus Head.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718230702,
					"content": "Coba kita pikir... Zhi ingin agar kita mengambil Lotus Head ini antara tengah malam sampai jam enam pagi. Baiklah, ayo kita tunggu sampai waktu yang tepat.",
					"roleType": "TALK_ROLE_NPC",
