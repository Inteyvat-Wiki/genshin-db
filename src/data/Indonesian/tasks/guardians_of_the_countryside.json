			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "Kamu sudah kembali, apa kamu berhasil menemukan tumbuhan herbal yang kuminta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Ya, sudah terkumpul semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Terima kasih atas bantuanmu. Aku juga sudah meminta Nona Bai untuk membantuku memproses tumbuhan herbal ini. Kami akan segera pergi ke tempat penggilingan, jadi tolong bawa tumbuhan herbal ini langsung ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nona Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "Oh, biar aku saja yang mengurus tumbuhan herbal ini. Setelah selesai, kamu bisa membawanya kembali dan menggunakannya sebagai obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718231002,
					"content": "Terima kasih. Sekarang, andai saja aku bisa membuat obatnya menjadi sedikit lebih manis... Jika tidak, anak-anak pasti tidak mau meminumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Apa setiap tahun kamu selalu sibuk pada saat-saat seperti ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Ya... kurang lebih selalu begini. Bagaimana pun juga, tidak banyak anak muda di Desa Qingce, jadi kami hanya bisa membantu sebisa kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 718231005,
					"content": "Sibuk pada saat-saat seperti ini setiap tahunnya tidak menjadi masalah. Lagi pula, tahun ini sudah cukup lumayan karena terbantu olehmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "Pada tahun-tahun sebelumnya, butuh waktu beberapa hari bagiku untuk mengumpulkan tumbuhan herbal ini, belum lagi waktu yang dibutuhkan untuk membuat obatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Baiklah, terima kasih atas bantuan kalian. Aku akan pergi untuk memproses tumbuhan herbal ini dan menyiapkan Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "Tahun lalu aku hampir lupa untuk menerbangkan lentera... jadi aku harus pastikan kalau tahun ini aku tidak akan lupa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "Apa yang kamu harapkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Hmm... Agar semua orang di Desa Qingce selalu sehat? Ya, mungkin itu harapanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Tapi katanya harapan akan kehilangan efeknya jika diucapkan dengan lantang, jadi aku tidak akan menyebutkan apa-apa lagi padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Ini untukmu, terima kasih karena telah banyak membantuku hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
