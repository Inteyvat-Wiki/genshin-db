					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Hm, ternyata bahan obat herbalnya masih belum cukup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230202,
					"content": "Apa kamu ingin pergi untuk mengumpulkan tumbuhan herbal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Benar, aku baru saja akan pergi. Setiap tahun aku selalu menyiapkan lebih banyak obat daripada biasanya pada saat-saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230204,
					"content": "Maksudku bukan obat keras atau bagaimana, hanya obat yang biasa digunakan untuk mengobati demam atau gangguan pencernaan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230205,
					"content": "Kenapa tidak minta resep dari Bubu Pharmacy saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Bubu Pharmacy terlalu jauh, Butuh waktu lama untuk berjalan dari sini ke Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230207,
					"content": "Terlebih lagi, Desa Qingce sebagian besar populasinya hanya anak-anak dan orang tua saja. Tidak ada petualang yang sepertimu, mereka tidak akan bisa melakukan perjalanan sejauh itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230208,
					"content": "Jadi aku telah menyiapkan beberapa tumbuhan herbal untuk mengobati beberapa penyakit ringan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230209,
					"content": "Tapi bagaimana pun juga, jika seseorang mendapatkan penyakit yang serius, masih tetap membutuhkan resep yang benar-benar akurat, yang hanya bisa didapatkan dari Bubu Pharmacy. *huff* Kuharap itu tidak akan terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230210,
					"content": "Aku akan berbincang lagi denganmu nanti, aku masih harus mengumpulkan beberapa tumbuhan herbal lalu membawanya pulang untuk diproses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230211,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "Eh? Kamu akan melakukannya? Wah, bagus sekali! Aku sudah khawatir memikirkan berapa lama aku harus terus mencari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230213,
					"content": "Coba kulihat... Sepertinya aku masih membutuhkan 3 tipe tumbuhan herbal yang berbeda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230214,
					"content": "Salah satunya adalah Qingxin, yang tumbuh di puncak gunung dan tidak hanya kaya akan nutrisi tapi juga bagus untuk pencernaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230215,
					"content": "Lalu yang lainnya adalah Calla Lilly, yang bisa ditemukan di sisi sungai. Mereka dapat digunakan untuk mengatur kelembapan dari dalam tubuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230216,
					"content": "Kualitas dari Calla Lilly yang tumbuh di sepanjang sisi sungai adalah yang terbaik, dan di sanalah biasanya aku mengumpulkan Calla Lilly tersebut. Calla Lilly di tempat lain lebih pucat dibandingkan yang ada di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230217,
					"content": "Lalu yang terakhir adalah Lotus Head dari kolam yang ada di sekitar. Saat dibuat menjadi obat, mereka bisa digunakan untuk menenangkan saraf dan memperkuat hati. Waktu terbaik untuk mengumpulkannya adalah antara tengah malam sampai jam enam pagi agar bisa mendapatkan efek yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
