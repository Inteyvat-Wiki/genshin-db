				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "Waspadalah, Pengembara. Saat ini bukanlah saat yang tepat untuk berjalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Hah, ada apa? Apa yang terjadi baru-baru ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Markas mendapat laporan kesaksian dari banyak orang tentang munculnya Ruin Guard. Mereka tidak seharusnya berada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "Sersan telah mengutus seseorang untuk mencari tahu dari mana asal robot-robot ini. Diketahui mereka telah meninggalkan reruntuhan dan berkeliaran tanpa alasan yang jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Apakah ada yang membangunkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Tidak tahu. Sampai sekarang kami belum mendapat banyak informasi tentang mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Ditambah lagi, reruntuhan itu sangat gelap dan suram. Banyak suara aneh yang terdengar dari sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Sebelum mendapat persetujuan dari pusat, kami tidak diizinkan untuk melakukan penyelidikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "Kita memang harus berhati-hati dalam melakukan sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "Satu-satunya strategi yang tepat untuk sementara ini adalah meningkatkan patroli Millelith. Kita tidak boleh membiarkan warga yang tidak bersalah terancam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Ide bagus. Ruin Guard mungkin berbahaya untuk warga biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Apa ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Wah, aku sangat berterima kasih atas tawaranmu, tapi... ini terlalu berisiko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME} sangat tangguh, kamu tidak perlu mencemaskan keselamatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Tidak akan ada masalah, aku bisa sedikit bela diri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Begitu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Kalau begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "Aku melihat jejak kaki Ruin Guard di <color=#00E1FFFF>lereng bukit sebelumnya</color>, namun karena sibuk memperingatkan para pejalan kaki untuk berhati-hati, aku tidak punya waktu untuk menyelidikinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Jejak kaki? Menarik... Serahkan kasus ini pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "Selama Millelith tak gentar, keadilan akan tetap berdiri tegak! Atas nama Millelith, aku berterima kasih padamu, Pengembara! Aku akan menemui kalian setelah menyelesaikan patroli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Mungkin kedengarannya sedikit sombong, tapi sepuluh dirimu pun bisa kukalahkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Hahaha, anak muda yang optimis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "Cara kerja seperti ini sangat tidak efisien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Hah? Kamu bilang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "Hei, kenapa nada bicaramu sama seperti saat Tuan Diluc mengkritik Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "#{F#Nona}{M#Tuan}, lihat sini! Besar sekali! Mengesankan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "(kebingungan) ... Apa yang dia kenakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "Aku belum pernah melihatnya sedekat ini! Apa kalian pernah melihatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Ini adalah Ruin Guard yang kehilangan kekuatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Salah, kalian salah! Ruin Guard apaan? Namanya adalah \"Si Kecil Bermata Satu\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "Si Kecil Bermata Satu? Lucu sekali... Tu-tunggu! Orang-orang memanggilnya seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Iya! Kakakku yang mengatakannya kepadaku. Dia adalah penjual mainan terhebat sedunia! Dia menjual mainan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Dia bekerja di \"Institute for Toy Research\" di Liyue. Si Kecil Bermata Satu lahir di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "Kakak juga suka mainan? Apa makhluk yang terbang di sampingmu ini adalah mainan terbaru? Dia bahkan bisa berbicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon dan Ruin Guard bukanlah mainan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Iya! Benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Halo, apa kamu menemukan sesu— Oh, seorang anak kecil.... A—ada apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Kami baru saja bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Kamu tidak boleh berkeliaran di sekitar sini, Nak. Ada banyak robot-robot pembunuh yang berbahaya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "Robot pembunuh? Maksudmu... seperti robot ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Benar, termasuk robot ini. Sekarang itu tidak bergerak, tapi sekali dia bangun, akibatnya adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "Dia bukan robot pembunuh! Si Kecil Bermata Satu adalah pembela kebenaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Hah? Si Kecil Bermata Satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "Kakak, paman ini mengatai Si Kecil Bermata Satu dengan buruk. Dia pasti orang jahat, ayo kita tinggalkan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "A—aku hanya mencoba menolong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Dia tidak akan mendengarkanmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Huh, aku memang tidak bisa berurusan dengan anak kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "Kenapa kamu tidak lanjutkan saja pekerjaanmu? Kami akan menjaganya dengan baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Aku tidak ada pilihan lain lagi... Baiklah, aku akan melanjutkan patroliku. Tolong bawa anak itu ke tempat yang aman. Tempat ini terlalu berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Hahaha, Si Kecil Bermata Satu lagi-lagi menakuti orang jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "Siapa namamu, Nak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "Namaku Teucer! Aku datang dari Snezhnaya untuk mencari kakakku di Liyue. Tapi aku sendirian dan tidak tahu bagaimana mencarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "Kamu datang dari Snezhnaya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Oh ya, aku seharusnya memberimu ini... Ambillah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "Apa ini? Berat sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "Ini...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "Banyak sekali Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Kakak menyuruhku membawanya. Dia memintaku menyerahkan ini kepada orang baik, dan orang baik akan merawat Teucer dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Kakakmu mungkin benar. Tapi sulit dipercaya, kamu datang sendirian dengan hanya dibekali beberapa kantong Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "Keluargamu pasti sangat kaya! Paimon tidak pernah tahu, ternyata menjual mainan bisa menghasilkan banyak uang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "Aku terima kantong ini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "Wah, benarkah? Terima kasih, kakak yang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Kalau begitu, kita harus janji kelingking sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "\"Janji kelingking tidak boleh diingkari. Siapa pun yang mengingkarinya akan dilempar ke sungai es. Dinginnya es akan membunuh sang pengkhianat, dinginnya es akan membekukan lidah sang pembohong!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Wah, lagu anak-anak ini sudah cukup mengungkapkan budaya Snezhnaya yang perlu kita ketahui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "Kalau begitu kita terpaksa harus menjadi penjaganya untuk sementara. Tapi bagaimana caranya kita bisa menemukan kakakmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "Kita bisa mulai dari tempat yang berhubungan dengan Snezhnaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Tempat yang berhubungan dengan Snezhnaya... Oh ya, bagaimana dengan <color=#00E1FFFF>Northland Bank</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Baik! Akhirnya aku bisa bertemu dengan kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>Northland Bank</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Ide bagus kan? Ayo kita ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Aku terima kantong ini (kembalikan ini saat bertemu sang kakak...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Banyak sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Di mana keluargamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Serahkan dia padaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Iya, hebat kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Hei! Kenapa Paimon jadi barang aneh lagi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Waspadalah, dia sangat berbahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "Memang benar! Si kecil bermata satu sangat hebat, tak ada satu pun orang jahat yang bisa lepas dari genggamannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Sepertinya ini agak tidak pantas, Tuan. Bagaimana mungkin Anda—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Tenang saja! Sekali-sekali saja kok! Tidak akan ada masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100303,
					"content": "Loh? Apa yang dia lakukan di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Hore! Kakak! Aku akhirnya menemukanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Suara itu... Suara adikku, Teucer! Ya Tuhan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100306,
					"content": "Hahaha! Sungguh mengejutkan, Teucer! Kupikir aku harus menunggu sampai aku pulang sebelum bertemu denganmu lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100307,
					"content": "Bagaimana kabar yang lainnya — Tonia dan Anthon? Apa semuanya baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100308,
					"content": "Mereka sangat merindukanmu! Kakak Tonia selalu mendoakanmu sebelum makan malam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "...Tunggu, tapi — apa yang kamu lakukan di Liyue, Teucer? Kenapa aku tidak mendapat kabar sama sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100310,
					"content": "Sebenarnya... Aku melihat sebuah kapal yang sepertinya memuat mainan untuk dijual, aku kira kamu ada di atas kapal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "Setelah turun dari kapal, aku terus berjalan menelusuri jalan... Lalu aku pun menemukan Si Kecil Bermata Satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "Si Kecil Bermata Satu menolongku mengusir orang jahat, lalu aku pun mengikuti kakak yang baik hati ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Ternyata kamu menyelundup dalam kapal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "Dan ternyata... Teucer adalah adik dari Childe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Kalau begitu, kita bisa menerima uang Teucer tanpa beban!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, ini terlalu berbahaya... Kakak sangat senang bertemu denganmu, tapi tolong... Berjanjilah kepadaku, kamu tidak akan melakukannya lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100318,
					"content": "Baik, aku berjanji... Tolong jangan marah kepadaku, kak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "Kakak tidak marah. Kakak hanya mengkhawatirkan keselamatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100320,
					"content": "Kalau kamu tidak bertemu dua orang baik ini, keadaanmu tidak mungkin seperti sekarang, Teucer. Apa kamu sudah berterima kasih kepada mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100321,
					"content": "Ya! Aku selalu ingat tata krama dan harus berterima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Oh, ternyata kamu menyadari kehadiran kami. Kamu tadi terus mengabaikan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Hahaha, maafkan aku. Bagiku, keluarga adalah yang terpenting. Mohon kalian memakluminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100324,
					"content": "Aku tahu kita tidak berdiri di perahu yang sama... Tapi bila masalah itu dikesampingkan, bukankah kita masih bisa berhubungan dengan baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100325,
					"content": "Kamu hanya berbasa-basi saja kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Hehe, ayolah... Kamu juga tahu kalau aku hanyalah bidak catur mereka. Aku hanya melakukan bagian dari pekerjaanku. Aku tidak peduli siapa yang menang, siapa yang kalah. Aku serahkan semuanya itu kepada pemainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100328,
					"content": "Aku lebih tertarik pada hasil akhir pertarungan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100329,
					"content": "Hmm? Sepertinya kamu ingin mengecap pahitnya rasa kekalahan lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Hahaha! Kamu sepertinya lupa siapa aku. Aku Tartaglia, aku akan menjadi semakin kuat seiring dengan waktu. Jangan harap kamu bisa menang semudah kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100331,
					"content": "Aku juga bukan aku yang dulu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Hei, hei, kalian mau bertarung sekarang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Hahaha, mungkin tidak. Tidak di saat ada anak kecil yang menonton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100335,
					"content": "Kenapa kakak mau bertarung dengan kakak yang baik hati? Apa kalian bermusuhan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#Tentu tidak, mana mungkin! {NICKNAME}, terimalah ungkapan terima kasihku karena telah mengantar adikku yang tersayang. Keselamatan dia sangat penting bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100337,
					"content": "Aku akan terus mengawasi gerak-gerikmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "Ngomong-ngomong, Paimon punya satu pertanyaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer mengatakan bahwa kakaknya adalah penjual mainan... Apa maksudnya itu? Bukankah kamu salah satu dari Eleven Harb—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "*Ehem* Ya, mengenai itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100342,
					"content": "Ssstt... Aku mengatakannya seperti itu agar dia mengagumiku. Di mata setiap anak kecil, pekerjaan yang berhubungan dengan mainan adalah pekerjaan yang terbaik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100343,
					"content": "Aku tidak ingin keluargaku berkaitan dengan Fatui, atau bisa dibilang sebagai... sisi gelap Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100344,
					"content": "Walaupun adik-adik lain yang lebih tua sudah mengetahui bahwa aku melayani Tsaritsa, tapi Teucer masih terlalu muda. Dan di matanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100345,
					"content": "*Ehem* Aku tetap seorang penjual mainan terbaik di Snezhnaya, dan kini bekerja di Institute for Toy Research di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100346,
					"content": "Benar sekali! Kakakku sangat hebat! Dia adalah teman baik Si Kecil Bermata Satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Tolong bantu aku bersandiwara di depan Teucer, tolonglah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100348,
					"content": "Oh ya, Ekaterina, aku akan segera menangani masalah tunggakan pembayaran itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100349,
					"content": "Jadi dia mulai mengalihkan pembicaraan, eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Tapi Tuan Childe, bukankah tidak pantas meminta Anda menangani ... penagihan utang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "Taruhan adalah taruhan. Karena aku sudah kalah taruhan dari Agent... Ya, setidaknya aku bisa berolahraga sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100352,
					"content": "Kakak mau pergi menjual mainan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "Iya! Kakak ingin sekali bermain lebih lama denganmu, Teucer. Tapi, kakak masih harus bekerja! Aku yakin kakak yang baik hati ini akan menemani kamu bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100354,
					"content": "Huh, jadi kami masih harus menjaga anak kecil demi kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "Baiklah! Aku sangat menyukai kakak ini, dan dia sudah melakukan janji kelingking denganku! Dia berjanji akan menjagaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "Sepertinya Teucer sangat menyukaimu, dan kalian juga sudah berjanji kelingking untuk menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100357,
					"content": "(Mereka menyudutkanku...) Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Aku berutang budi padamu. Ambillah ini sebagai imbalan untuk menemani Teucer bermain. Aku ingin dia melewati waktu yang menyenangkan di Liyue. Bawalah dia ke mana pun dia mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100360,
					"content": "Jika ada keperluan, kamu bisa menemukanku <color=#00E1FFFF>di tepi sungai dekat Qingxu Pool</color>. Sampai jumpa lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100358,
					"content": "Baik, kami akan melakukannya. Demi Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Kamu sangat memedulikan perasaan keluarga. Aku mengerti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "Aku siap meladenimu kapan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Kamu masih berani beralasan seperti itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "Teucer adik Childe?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
