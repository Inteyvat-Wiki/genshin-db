			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Ide bagus. Tapi apa bisa berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Gimana lukisannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ah, halo! Terima kasih sudah bantu urusan foto sebelumnya. Pemandangannya luar biasa sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Aku sudah punya gagasan, dan sudah gambar sketsa kasar juga ... tapi masih ada yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Jangan salah paham dulu, aku bukan menggambar sampah yang tidak ada nilainya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Cuma kok sepertinya kurang di mananya gitu. Kurang faktor yang membedakan dari gambar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Semuanya terlampau ... gamblang? Kalau langsung dituangkan ke atas kanvas, keindahan yang ingin kulukis akan ternoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "Ck, masalah yang pasti ditemui semua seniman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Kenapa enggak ganti gambar saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Terima kasih, tapi ini bukan masalah yang selesai dengan hanya ganti topik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Pegunungan, sungai, burung, hewan, manusia ... semuanya tidak luput dari masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "Justru dalam perjalanan mencari solusilah, beberapa rekanku berhasil mengubah pemandangan di hadapan mata menjadi perwujudan kalbu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Seni yang mengedepankan isi hati, yang diwujudkan di atas kanvas ... gimana ya menjelaskannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Yah, karakter maupun pemandangan ... bahkan cahaya saja membawa keunikan yang tidak bisa ditangkap oleh tradisi estetika awam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Dilihat sekilas saja sudah cukup, orang-orang akan menyangka lukisan ini adalah karya sosok yang sama sekali awam tentang seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Tapi kalau jiwa ditenangkan dan diselaraskan dengan seni, maka karya itu pun akan mengaum mewakili sang seniman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Auman seluruh jiwa dan raga, pancaran lubuk hati yang paling dalam ... perasaan yang amat sangat intens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Suara yang tak bisa didengar telinga, melainkan dirasa menggunakan hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Aku ... belum ingin meninggalkan objek nyata. Dan aku punya jalan alternatifnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Konsentrasi pada warna, mencari gradasi dalam guratan kuat namun sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Sambil melemahkan pencahayaan dalam komposisi tradisional ... yang akan berpengaruh pada ekspresi yang kuinginkan. Karenanya aku harus mempersilakan hal-hal tersebut meninggalkan kanvas untuk sementara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Tapi warna yang kuat berarti menghabiskan banyak cat. Tetesan warna harus dituangkan langsung ke atas kanvas agar tujuannya tercapai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Sehingga akhirnya ... aku kehabisan cat. Lukisan ini tidak boleh dipindah, nanti kreasi di atasnya bisa rusak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "Pengembara, boleh minta tolong kunjungi Boucicaut? Aku sudah pesan cat bagus dari dia, harusnya sudah siap sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Atau mungkin ... bisa carikan Whopperflower Nectar? Aku bisa bikin cat sendiri pakai itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Memangnya bisa bikin cat pakai itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, tentu saja bisa. Bahkan ada rekan-rekan seniman yang pakai telur untuk bikin cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Katanya cat dari bahan seperti itu warnanya lembut namun berlapis, sempurna untuk melukiskan pemandangan megah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Orang baik, apa kamu tega menolak permohonan seniman yang hina dina ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Iya, iya, enggak usah gitu juga ngomongnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Beribu terima kasih! Aku akan tunggu di sini. Kalau sudah ada barangnya, langsung kemari ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Ampun ... ya deh, serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Kamu bikin cat sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Haha, tentunya. Itu ilmu yang wajib dikuasai seorang pelukis. Agar punya kendali penuh atas hasil karya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Enggak coba ganti gaya melukis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Ya, ada rekan yang berpendapat sama juga. Dan mereka mencoba menggunakan metode \"kiasan\" untuk menciptakan sesuatu yang sifatnya abstrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "Yang paling radikal ingin meninggalkan usaha menggambar objek nyata, hanya melempar warna untuk mengekspresikan diri ... sebutannya \"Neo-deskriptif\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Tapi aku sendiri tidak bisa paham karya mereka. Hanya mampu sedikit merasakan keindahan ritme dalam lemparan warna dan guratan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Makna sesungguhnya ... hanya bisa dipelajari ketika aku bertanya pada si seniman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
