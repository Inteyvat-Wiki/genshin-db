			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Halo, kamu ingin membeli barang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Tentang cat Depierris ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Oh, kamu datang untuk ambil catnya? Ini sudah kusiapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Rasanya cat yang dipakai orang ini cepat sekali habis, seperti beli buat dituang ke air saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Oke, ini semua cat yang dia beli, silakan antarkan ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
