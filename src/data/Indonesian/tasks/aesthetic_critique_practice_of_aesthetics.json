	"talks": [
		{
			"id": 2401001,
			"completionStepIds": [
				2401001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
