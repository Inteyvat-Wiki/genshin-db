			"dialogs": [
				{
					"id": 760540101,
					"content": "Columbina mana ya? Paimon enggak lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Sebelah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540103,
					"content": "Woah! Kamu lagi ngapain di atas sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Naiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540105,
					"content": "Aduh, kita terlibat apa lagi sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Ingat batu-batu yang pernah kita kumpulkan tempo hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540107,
					"content": "Tempo hari ... oh, maksudnya bijih yang menyala setelah menyedot kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Betul. Setelah itu, para Kuuhenki mengumpulkan lebih banyak, dan aku memilahnya menjadi dua jenis. Yang lebih gelap dan lebih terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540109,
					"content": "Gelap dan terang? Kenapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Untuk main Catur Bulan, tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540111,
					"content": "Uh ... Catur Bulan tuh apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Oh, kalian belum pernah main?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540113,
					"content": "Belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Begitu ya ... waktu aku melihat kotak-kotak yang digambar anak-anak Bani Bulan Embun di tanah, aku selalu ingin coba main. Tapi tidak ada teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540115,
					"content": "Aturannya gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hmm ... mungkin lebih mudah kalau langsung dikasih lihat saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540117,
					"content": "Wow! Keren banget, gimana caranya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hm? Pakai kuuvahki, tentu saja. Kamu tidak bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540119,
					"content": "Uh, coba itu ekspektasinya direndahin dikit ... kami nih bukan dewa-dewian woi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Baiklah. Ini papannya, melambangkan \"langit malam\". Dan setiap bidak yang dikendalikan pemain melambangkan \"bulan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540121,
					"content": "Kedua pemain bergantian menaruh bulan di langit, dan yang pertama berhasil menempatkan tiga bulan secara berjajar, menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540122,
					"content": "Oh, kayak main dam-daman ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Jadi dam-daman tuh disebutnya \"Catur Bulan\" ya di Nod-Krai. Kearifan lokal nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Tapi dalam versi ini, bulan berotasi. Artinya, tidak boleh ada lebih dari tiga bulan di langit dalam waktu bersamaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540125,
					"content": "Jadi kalau langit malam sudah penuh, bulan yang naik untuk pertama kali akan hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540126,
					"content": "Itu ... masuk akal banget loh. Dan bikin mainnya jadi jauh lebih susah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Jadi, mau coba? Ini juga pertama kalinya aku main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540128,
					"content": "(Dia kayaknya ngebet banget.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "Hehe, asyik ya kayaknya! Paimon jadi wasit deh, si bestie tuh gitu-gitu juga otaknya jalan, jadi hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
