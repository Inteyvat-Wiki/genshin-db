				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Kemarilah dan coba mainkan Theater Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "Apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "Oh...! Selamat datang! Ini adalah sebuah permainan baru yang kudapat dari Liyue namanya Theater Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "Intinya ini adalah permainan yang dimainkan di atas papan. Permainan ini dibuat oleh Ruijin di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Aku... bagaimana mengatakannya ya, menurut Ruijin, aku adalah perwakilan luar negeri untuk permainan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "Setelah aku mendapatkan... ehm... hak distribusinya, Ruijin langsung mengirimkan satu set Theater Mechanicus bersama proposal bisnisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Walaupun saat tiba, permainan ini sempat ditahan oleh Agensi Pengawasan Orang Asing, tapi akhirnya aku berhasil mendapatkannya kembali setelah sekian lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "Kenapa Agensi Pengawasan Orang Asing harus menahannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "Apa pun yang berasal dari luar negeri pasti ditahan dulu oleh mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Ah sudahlah, jangan bicarakan hal itu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "Apakah kamu melihat potongan-potongan yang diletakkan di atas meja ini? Semua ini adalah benda penting dalam permainan Theater Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "Rasanya seperti ada di Liyue ya? Hahaha, aku melakukan semuanya secara spesifik sesuai dengan instruksi dalam surat Ruijin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "Bahkan untuk mejanya aku sengaja meminta seseorang untuk membuat meja yang mirip... itu menghabiskan banyak uang loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "Dan pada Theater Mechanicus ini, aku juga menambahkan gameplay baru sesuai dengan saran Ruijin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Ehm... sepertinya kalau cuma mendengarkan saja kamu tidak akan paham, kamu coba dulu saja permainannya, nanti kamu pasti akan mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Coba mainkan Theater Mechanicus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "Tidak masalah, bersenang-senanglah, Theater Mechanicus versi baru ini tidak akan mengecewakanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "Masih ada urusan lain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Baiklah, cobalah lagi kalau kamu ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "Wah ternyata di sini juga ada Theater Mechanicus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Selamat datang... eh? Jadi kamu juga tahu Theater Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "Oh... Aku tahu, kamu pasti pernah main di Liyue ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "Ruijin bilang padaku bahwa promosi yang dia lakukan saat Lantern Rite... sepertinya cukup efektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "Aku... bagaimana mengatakannya ya, menurut Ruijin, aku adalah perwakilan untuk permainan Theater Mechanicus di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}