				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Syukurlah! Knights of Favonius sudah tiba. Para Hilichurl tidak mungkin berani mengejarku lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Benar-benar sial... Kereta kami diserang oleh para Hilichurl. Untungnya kami berhasil melarikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "Hilichurl menyerang? Aku kira Knights of Favonius sudah membereskan seluruh kemah Hilichurl di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "Kemah Hilichurl ini kecil dan tidak jauh dari desa. Saat memasok barang, aku akan menghindari area ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Tapi hari ini tiba-tiba ada seseorang yang terjatuh ke dalam kemah Hilichurl dari atas langit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Hmm... Rasanya seperti hal yang sering dilakukan seseorang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Para Hilichurl dengan gusar mengejar orang aneh itu sampai keluar dari kemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Aku juga melarikan diri, tetapi mereka menghancurkan gerobak buah-buahanku sampai berkeping-keping. Aku tidak tahu apa yang harus aku lakukan saat pedagang karavan datang besok—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "Orang aneh? Anehnya seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Dia memeluk sesuatu dan terbang dengan miring, sepertinya karena sesuatu yang dipeluknya itu sangat berat. Dan itu juga alasan kenapa dia terjatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Dasar, orang seperti itu tidak seharusnya diizinkan meluncur. Bahkan orang yang tidak jenius pun pasti paham kalau tidak seharusnya membawa barang berat saat meluncur! Aku akan melaporkan orang itu supaya izinnya dicabut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Barang yang berat... mungkinkah itu relik? Dia pasti Raptor yang sedang kita cari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Apa kamu melihat ke arah mana orang aneh itu berlari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Aku sempat melihat sekilas ketika sedang melarikan diri dari Hilichurl. Mereka sepertinya... lari ke arah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Akhirnya kita berhasil mendapat petunjuk. {NICKNAME}, kita harus cepat mengejar mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Oh ya, jangan cemas. Setelah aku kembali nanti, aku akan segera melapor kepada Knights of Favonius agar sisa-sisa Hilichurl segera dibereskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
