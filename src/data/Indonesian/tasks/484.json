					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Huh, lihat di mana kita sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Tidak ada jejak elemental lagi di depan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Kekuatan elemental di relik itu pasti sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Raptor tahu kalau jejak-jejak elemental itu akan memberi tahu posisi mereka, lalu mengirim bawahannya untuk memperlambat langkah kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Mungkin dia ingin menunggu sampai efek jejak itu menghilang dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "Rencana dia tidak akan berhasil! Kejar dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48432",
							"2"
						],
						"stepId": 48432,
						"stateName": "QUEST_STATE_UNFINISHED"
