			"dialogs": [
				{
					"id": 4840601,
					"content": "Ini... ada potongan kain dan jejak Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "Dari desain dan jahitannya sih, ini potongan dari Wind Glider ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Wow, apakah sekarang seorang Outrider pun harus menjadi pakar tekstil? Ternyata pekerjaan ini lebih sulit daripada yang Paimon bayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Kalau memang punya Raptor, ini berarti Wind Glidernya sudah rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "Jejak elemental terus menunjuk ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "Apa Raptor terus berlari ke depan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "Hanya ada satu cara untuk mengetahuinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841104,
					"content": "#{NICKNAME}, kita terus ikuti jejak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841105,
					"content": "Loh, sepertinya ada sesuatu di depan sana...",
