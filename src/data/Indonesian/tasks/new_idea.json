			"dialogs": [
				{
					"id": 766562001,
					"content": "#Halo, {NICKNAME} dan Paimon. Berkat bantuan kalian, kita berhasil memperbaiki robot yang kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562002,
					"content": "Oh, semuanya ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "Saat ini tidak ada masalah baru, tapi aku tiba-tiba punya ide baru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}, saat kalian mencari robot-robot lainnya, bisakah membantuku memperhatikan beberapa pergerakan khusus mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "Maksudnya pergerakan gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562006,
					"content": "Kurang lebih ... interaksi di antara robot? Mungkin akan lebih jelas setelah menemukan lebih banyak robot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562007,
					"content": "Oh ... Serahkan pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562008,
					"content": "Terima kasih atas kerja keras kalian! Aku akan menandai area berikutnya di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
