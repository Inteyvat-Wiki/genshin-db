				"points": []
			},
			"dialogs": [
				{
					"id": 210030111,
					"content": "*huff* Andai saja kami bisa memiliki lebih banyak orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "Aku ingin membasmi mereka, tetapi aku khawatir kalau aku meninggalkan tempat ini, ada monster lain yang memanfaatkan kesempatan untuk menyerang orang-orang yang lewat. Aku hanya bisa berdiam di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Apakah kamu bisa membantuku membasmi monster-monster itu? Bantuanmu akan membuatku bisa lebih fokus ke masalah lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
		{
			"id": 2100311,
			"completionStepIds": [],
