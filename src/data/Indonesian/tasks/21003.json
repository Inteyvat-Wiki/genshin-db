			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Bagaimana ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Siapa kamu? Siapa pun yang menyeberangi jembatan ini harus melewati inspeksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Tapi, hmmm... orang yang berpakaian aneh sepertimu pasti bukan orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Pemikiran seperti apa ini... Coba saja pikir, orang yang berniat jahat pasti akan memakai baju sesederhana mungkin. Mereka tidak akan berpakaian mencolok seperti kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Lagi apa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Aku adalah Prajurit \"Millelith\" yang bertanggung jawab menjaga area ini. Karena area ini adalah jalur utama menuju Dihua Marsh, para pedagang dan pejalan kaki pasti akan melewati jalan ini. Karena itu aku diutus untuk menjaga keamanan jalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Beberapa hari yang lalu, aku melihat sekelompok monster... Sekelompok monster itu mendirikan kemah di sana. Walaupun belum ada tanda-tanda pergerakan dari mereka, tapi aku tetap harus mengawasi mereka dengan ketat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Aku ingin membasmi mereka, tetapi aku khawatir kalau aku meninggalkan tempat ini, ada monster lain yang memanfaatkan kesempatan untuk menyerang orang-orang yang lewat. Aku hanya bisa berdiam di sini sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Aku sudah membasmi monster-monster itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Kamu sudah memabsmi mereka? Semuanya? Hebat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Terima kasih banyak! Maaf, seharusnya itu adalah tugasku, tapi aku malah merepotkanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "*huff* Entah apa yang sedang dipikirkan pihak atasan. Mereka belum juga mengutus bala bantuan ke sini. Bagaimana mungkin aku bisa menjaga area ini seorang diri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Aku harus mencari kesempatan untuk melaporkan hal ini kepada pihak atasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Terima kasih. Terimalah ini sebagai ucapan terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
