					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "Ah, tuan pengembara, tolong tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020202,
					"content": "Apa terjadi sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Mungkin ini sedikit mendadak, tapi apakah kamu tertarik dengan Kamera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020204,
					"content": "Sedikit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Oh, tapi Kamera milikku ini lain dari yang lain loh. Kamera ini menggunakan teknologi terbaru dari Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020207,
					"content": "Hasil potretan Kamera ini akan menghasilkan warna foto yang berbeda dari Kamera biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020208,
					"content": "Kok bisa begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Ah! Kalian tidak percaya? Kalau tidak percaya, kalian coba tanyakan ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020211,
					"content": "Awalnya aku juga tidak percaya. Tapi waktu itu aku mengutak-atik Kamera ini seharian dan tidak berhasil, tiba-tiba seorang petualang dari Adventurers' Guild datang membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020212,
					"content": "Yang membedakan Kamera ini dengan kamera biasa adalah sebuah bagian kecil di dalam Kamera ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020213,
					"content": "Bila bagian ini diisi dengan sejenis potion khusus, Kamera ini dapat mencetak gambar dengan efek spesial, jauh lebih bagus dari hasil kamera biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020214,
					"content": "Bagaimana? Kalau kalian tertarik, ambil saja Kamera ini untuk mencobanya. Meskipun jenis potion di dalamnya tidak terlalu banyak, tapi cukuplah untuk percobaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020215,
					"content": "Aku berencana untuk pergi ke Fontaine dan membeli beberapa jenis ramuan baru. Jadi, kalau kamu tertarik, boleh sekalian datang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020216,
					"content": "Kalau begitu, terima kasih ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Kalau begitu, kalian pegang saja dulu Kamera ini. Kalau kalian suka, jangan lupa untuk membeli dari tokoku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020217,
					"content": "Berapa harga potionnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Itu masalah kecil, harganya murah kok, jangan khawatir. Kalau kalian membeli banyak potion sekaligus, aku bisa memberikan diskon lebih untuk kalian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020209,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Tidak sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
