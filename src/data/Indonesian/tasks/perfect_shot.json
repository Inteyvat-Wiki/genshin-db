			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ah, kalian sudah datang, pas sekali ada yang ingin kubicarakan dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Tidak perlu, tidak perlu. Aku sudah menemukan sumber masalahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "Beberapa hari yang lalu, aku akhirnya menemukan si penjual Kamera itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "Aku bilang bahwa Kamera yang dia jual rusak, tapi dia tidak mau percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Untung saja kalian membantuku memotret banyak foto. Kalau tidak ada bukti foto-foto itu, orang itu pasti tidak akan mengaku salah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "Berkat bantuan foto-foto kalian, dia berjanji untuk membawa kembali Kamera itu dan memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "Lalu kemarin dia baru saja memberikanku sebuah potion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "Dia bilang struktur Kamera ini berbeda dengan yang lainnya. Kita harus menambahkan potion ini agar dia bisa memotret dengan normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "Kalau tidak ada potion ini, hasil potretannya akan sama seperti yang kalian potret sebelumnya. Hanya ada warna, tapi gambarnya tidak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Yang penting Kameranya tidak rusak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Ya, sepertinya begitu. Tapi sebenarnya aku lebih tertarik dengan potion ini daripada Kamera itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Coba kalian bayangkan, kebanyakan orang pasti hanya akan membeli satu buah Kamera kan? Lalu Kamera itu juga bisa dipakai lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "Tapi potion ini kan barang konsumsi, jadi setelah dipakai habis, orang harus membelinya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Tapi menurut penjual itu, jenis potion yang berbeda akan menghasilkan efek gambar yang berbeda juga. Dia juga sedang meneliti potion jenis lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Bisa jadi... potion ini lah yang akan menghasilkan keuntungan besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "*ehem* Maaf, aku jadi berbicara sendiri terus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Terima kasih atas bantuan kalian, coba berikan Kamera itu kepadaku. Aku akan menambahkan potion ini ke dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "Jadi... sudah benar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Hari ini mau memotret warna mencolok lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
