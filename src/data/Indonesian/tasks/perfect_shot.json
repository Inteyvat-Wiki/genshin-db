			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Baiklah, kalau begitu Kamera ini untuk kalian saja, simpan baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "Kamera ini... untukku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "Potion ini bisa dipakai cukup lama kok. Kalau potionnya habis, kalian tinggal membelinya lagi dariku, gampang kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020305,
					"content": "Lagi pula aku masih akan mencari orang itu lagi dan membeli lebih banyak jenis potion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020306,
					"content": "Kalau kalian tertarik, kalian boleh datang mencariku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020307,
					"content": "Wah, tidak kusangka. Awalnya membeli sebuah Kamera, malah mendapatkan sebuah peluang bisnis bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020303,
					"content": "Kalau potionnya habis bagaimana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}