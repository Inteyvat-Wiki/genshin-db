			"dialogs": [
				{
					"id": 220070101,
					"content": "Di mana ya jatuhnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Aduh, jadi... aku sedang memeriksa reruntuhan, namun tiba-tiba para monster datang menyerang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "Aku lari karena panik, dan sepertinya aku menjatuhkan relik yang baru saja kutemukan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Setelah para monster pergi, aku kembali, tapi aku tidak bisa menemukannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "Aku sudah mencari di sekitar sini tapi tetap tidak bisa menemukannya, aku tidak tahu apakah para monster itu mungkin mengambilnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "Bisakah kamu membantuku mencarinya? Jika kamu menemukannya, kamu bisa menyimpannya di dalam kotak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
