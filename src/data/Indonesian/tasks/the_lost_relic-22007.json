					"nextDialogs": [
						220070305
					]
				},
				{
					"id": 220070305,
					"content": "Baiklah, kita cari dengan lebih teliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070304,
					"content": "Ayo kembali.",
