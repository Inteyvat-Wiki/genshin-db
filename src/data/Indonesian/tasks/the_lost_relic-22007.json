					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Ah, ingatlah untuk melihat dengan cermat, aku menggunakan pakaian sebagai bantalan di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Aku seorang pelajar profesional, bagaimana mungkin melakukan kesalahan yang amatir begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Baiklah, terima kasih karena sudah membantuku menemukan relik tersebut, aku benar-benar tidak berdaya melawan para monster itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
