			"dialogs": [
				{
					"id": 750490401,
					"content": "Ha ... ternyata masih ada yang bisa menemukan jalan masuk ini. Sudah lama sekali semenjak terakhir orang datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Roh Jiwa Malam"
				},
				{
					"id": 750490402,
					"content": "Di tempat ini ... jiwa-jiwa malam bergentayangan. Tiada seorang pun yang bernapas di bawah hangatnya sinar mentari masih mengingat nama dan perbuatan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Roh Jiwa Malam"
				},
				{
					"id": 750490403,
					"content": "Jiwa-jiwa malam ... kitalah yang menghiasi mimpinya ketika tertidur. Tetapi ketika dia terbangun, kita hanyalah seutas benang yang tertenun di dalam benaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Roh Jiwa Malam"
				},
				{
					"id": 750490404,
					"content": "Bahwa jiwa yang masih memiliki tubuh dapat menginjakkan kakinya di tempat ini ... Haha, biarlah mereka yang haus pertempuran membebaskan hasratnya. Pejuang dari tanah asing, orang yang dikasihi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Roh Jiwa Malam"
				},
				{
					"id": 750490405,
					"content": "Tenangkanlah jiwa-jiwa yang haus itu dengan gempuran dan kejayaan. Imbalan yang setimpal pun akan diberikan .... Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roh Jiwa Malam"
				}
			]
		},
