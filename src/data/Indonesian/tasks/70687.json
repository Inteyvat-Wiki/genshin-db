			"dialogs": [
				{
					"id": 706870101,
					"content": "Tamu yang terhormat, silakan lewat sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870102,
					"content": "Teman Bu Penyihir yang sangat pandai meramal bawa hadiah buat kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870103,
					"content": "Wow, bola kacanya cantik sekali! Kayaknya mahal banget deh. Kalau dijual ke Nona Margaret, mungkin bisa dapat sepuluh ... eh, dua puluh juta Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870104,
					"content": "Ehem, Paimon cuma bercanda kok. Jadi, benda apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870105,
					"content": "Kata temannya Bu Penyihir, \"di mana ada penyihir, di situ ada bola kaca yang layak untuk penyihir\". Dengan bola kaca ini, mungkin para tamu bisa naik ke panggung baru yang luar biasa dan menakjubkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870106,
					"content": "Aku juga tidak terlalu paham apa maksudnya. Aku cuma \"Penerima Tamu\" biasa, jadi aku cuma bisa melihat diriku sendiri di dalam bola kaca. Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870107,
					"content": "Ah, iya, iya, ada kotak ini juga, hadiah lainnya dari Bu Penyihir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870108,
					"content": "\"Kalau aku bisa menampilkan pertunjukan yang tak terduga dan mengejutkan di panggung rahasia ini, aku akan menemukan harta karun yang bisa dimasukkan ke dalam kotak ini\" ... Dia bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870109,
					"content": "Ha-Harta karun?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870110,
					"content": "\"Penerima Tamu\" tidak boleh bicara terlalu banyak, atau akan merusak kesan misteri cerita. Kalau begitu, silakan kedua tamu kita melangkah maju ke panggung baru dengan berani seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wolfy"
				}
			]
		}
	]
}