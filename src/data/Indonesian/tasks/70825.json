			"dialogs": [
				{
					"id": 708250401,
					"content": "Fuh, andai saja kita punya lebih banyak orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250402,
					"content": "Apa yang sedang dilakukan oleh para knight?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Mempertahankan pertahanan kota, membantu upaya pembangunan kota, dan banyak pekerjaan-pekerjaan lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Sekarang semua Knight sedang sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "Dibandingkan dengan mereka, tugas menjaga gerbang utama sangat ringan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "Bagaimana kalau mencoba meminta bantuan ke Adventurers' Guild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Mereka dari awal sudah membantu. Awalnya mereka membantu mencari dan menyelamatkan korban di kota, dan akhir-akhir ini mereka membantu mengawasi aktivitas monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "Saat monster-monster mulai berkumpul di dekat kota, kita bisa menyusun rencana untuk mengalahkan mereka karena laporan dari para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Bahkan sekarang pun, mereka masih bekerja keras membantu kami membangun kembali kota. Sejujurnya, tanpa mereka, para Knight juga tidak akan kuat dengan bebannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "Aku harus mengambil waktu untuk berterima kasih ke Cyrus secara pribadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
