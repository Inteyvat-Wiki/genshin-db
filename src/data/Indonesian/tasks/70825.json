				{
					"id": 708250601,
					"content": "Bagaimana, apa sudah dibersihkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Bagus, terima kasih banyak atas bantuannya. Aku tidak tahu berapa lama benda-benda itu akan berdiri di sana tanpamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "Honorary Knight, mohon terima ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
