			"dialogs": [
				{
					"id": 722610401,
					"content": "Akhirnya kamu ketemu juga! Kamu baik-baik saja, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "Hiks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610403,
					"content": "Jangan takut, sudah tidak apa-apa kok. Tapi lain kali jangan lari sendiri lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Kamu seperti kakaknya saja, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon memang lebih tua dari Kichiboushi. Jadi Paimon memang kakaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Hmm ... kok kelihatannya tidak seperti itu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Hu-hmm. Makasih, {NICKNAME}. Makasih, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610413,
					"content": "Kichiboushi, hampir kena segel! Takut! Tapi Paimon panggil Kichiboushi, jadi tidak takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610414,
					"content": "Oh iya, Ioroi pernah bilang ada tanuki-tanuki kecil yang disegel juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Di dalam amber, seram. Gelap, tidak kelihatan. Tidak bisa bicara, tidak bisa gerak. Tidak bisa pung-pung! Seperti jadi batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610416,
					"content": "Ioroi jadi batu, tapi dia kuat. Bisa bicara, bisa lihat, tapi tidak bisa gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610417,
					"content": "Kamu mau bantu Ioroi ya, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Iya. Lalu bantu tanuki lain di batu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610419,
					"content": "Tapi kami sekarang sudah bersamamu, Kichiboushi. Kami tidak akan membiarkan kamu disegel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Hore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610423,
					"content": "Tapi kamu tidak boleh nakal ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Mm. Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610425,
					"content": "Anak pintar! Kita berhenti sampai di sini dulu ya? Kamu harus istirahat juga, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Kichiboushi tidak capek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610427,
					"content": "Duh, pusing deh. Kalau Kichiboushi nakal, Paimon enggak tahu kita mau latihan ke mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610429,
					"content": "Kichiboushi akhirnya dengan tidak rela mengakui kalau dia juga sudah lelah ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "*fuhh* Kichiboushi benar-benar seperti anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "Dan kamu jadi ahli dalam menangani mereka ya, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Oh ya? Mungkin itu karena Paimon sudah lama bertualang bersamamu! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "Jadi kamu menganggapku anak-anak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "Bukan, bukan! Bukannya kita sudah menemani banyak anak-anak bermain? Misalnya si Dusky Ming, Changchang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "Paimon memang sudah belajar banyak dari perjalanan bersama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "Dan kali ini, pelajarannya adalah ... Bake-danuki dan Adeptus tidak cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "Kita harus memikirkan tujuan kita selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "Hmm, benar juga, kita sudah menjaga banyak anak-anak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Iya, seperti si Dusky Ming dan Changchang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "Ya, kami akan melindungimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "Benar! Kalau ada kami, kamu tidak akan disegel, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "Kamu seperti ibunya, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
