			"dialogs": [
				{
					"id": 722610201,
					"content": "Fotonya bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Ha-he-ho, Kichiboushi ganteng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610203,
					"content": "Bocah ini pede amat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Oh ya. Paimon, Adeptus punya sihir apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610205,
					"content": "Adeptus sangat kuat! Misalnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Coba lihat amber di sekitar sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "Amber? Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610208,
					"content": "Oh, Paimon ingat. Mountain Shaper punya bunga yang bisa membuat amber, amber itu mengurung hal jahat yang menyerang tanahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Mon-Mon kuat sekali. Kurung si jahat, lindungi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610210,
					"content": "Dulu, Four Oni of Ogata yang jahat, masuk hutan, ganggu banyak bake-danuki. Ioroi berubah jadi pejabat, lalu kasih mereka makan makanan bake-danuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610211,
					"content": "Lalu, Ioroi dan si Raja Singa lempar mereka ke dalam kertas. Segel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610212,
					"content": "Oh, ada cerita begitu ya. Pantas Ioroi panik waktu melihat foto Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi bukan Adeptus, tidak lindungi Liyue. Tapi Ioroi lindungi hutan. Lindungi tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610214,
					"content": "Orang yang berbeda punya hal yang berbeda yang perlu dilindungi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610216,
					"content": "Kamu akan mengerti kalau sudah dewasa, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "Karena itulah, kamu harus berlatih keras dan jadi bake-danuki yang super kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Hmm! Jelas. Bake-danuki terkenal, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610219,
					"content": "Paimon jadi penasaran dengan wujud Ioroi sebelum dia disegel. Dia pasti lucu berbulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Huh, Paimon tiba-tiba jadi ingat Treasure Hoarder yang terkurung di dalam amber ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "Mereka bahkan mengira kita sebagai utusan Adeptus ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Rasanya sudah lama sekali, tapi sepertinya juga tidak lama-lama banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610224,
					"content": "Ehem. Setelah sampai di Liyue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#\"Rite of Descension cuma setahun sekali! Dan aku, {NICKNAME}, mau makan enak sampai puas! Paimon, ayo! Hahaha!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "\"Masih ada semua pemberian orang-orang juga! Paimon langsung meluncur ke sana nih!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610228,
					"content": "Jangan ngomong sembarangan ah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Baiklah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Kamu menjelaskan apa yang terjadi di Liyue dengan kata-kata sederhana.\\nKamu bercerita sampai saat kalian pergi mencari Adeptus di Minlin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#Setelah itu, {NICKNAME} dan Paimon pergi makan ke Liuli Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Mon-Mon dan Clow-Clow kuat sekali! Mereka bikin rumah yang bisa gerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610233,
					"content": "Clow, eh, Cloud Retainer benar-benar suka makanan enak! Kami harus membuat banyak makanan untuk menemui dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Rakus, mirip Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610235,
					"content": "Memang mirip Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "Jadi Paimon Adeptus? Paimon hebat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610239,
					"content": "Uh, bingung. Itu pujian sih, tapi Paimon kok rasanya enggak senang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "Tapi Paimon bukan Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Mau main sama Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610242,
					"content": "Adeptus biasanya tidak muncul sembarangan. Tapi kita bisa lihat-lihat di sini. Pemandangannya bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Kichiboushi, berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
