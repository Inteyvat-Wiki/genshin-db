			"dialogs": [
				{
					"id": 722610101,
					"content": "Halo, Mountain Shaper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "Halo, Mon-Mon—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610103,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Wah, kayaknya Adeptus-nya lagi di luar nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Jangan tidak sopan sama Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, Adeptus tuh apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610107,
					"content": "Hmm ... Mereka adalah orang-orang spesial atau ... binatang spesial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Seperti Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610109,
					"content": "Uh, bukan! Mereka punya kekuatan mistis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "Mereka bisa pung-pung? Kalau iya, berarti Kichiboushi juga Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610111,
					"content": "Uh, Adeptus lebih kuno, dan mereka punya ... apa ya, martabat lebih? Harga diri tinggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Oke, Kichiboushi bukan Adeptus. Ioroi Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610113,
					"content": "Ugh, susah sekali sih jelasinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Adeptus adalah makhluk kuno yang melindungi Liyue ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Kichiboushi ngerti. Ioroi pelindung Chinju Forest, jadi dia bukan Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610116,
					"content": "Paimon tahu bukan begitu logikanya, tapi baguslah kalau dia tidak salah paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Tapi jarang-jarang kita ada di depan kediaman Adeptus. Ayo kita ambil foto Kichiboushi di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Hmm! Kichiboushi pose. Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610119,
					"content": "Kichiboushi pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
