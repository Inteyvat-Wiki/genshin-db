			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sturdy Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Siapa di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010302,
					"content": "Aku adalah pedagang dari Mondstadt, ingin bertemu dengan Gentry Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Eh? Dia tidak mengatakan akan kedatangan dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010306,
					"content": "Tuan sedang menangani bisnis penting hari ini. Semua pertemuan dan janji sudah dibatalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010307,
					"content": "Bisnis penting... seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Akhir-akhir ini Tuan sedang menangani sebuah perjanjian bisnis yang sangat besar. Dia berangkat pagi-pagi sekali untuk bertemu dengan tamu VIP.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010309,
					"content": "Jadi di mana dia sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Maaf, Tuan mengatakan kami tidak boleh mengungkapkan hal ini kepada sembarang orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010311,
					"content": "Jadi maksudmu kami bukan tamu penting yang terhormat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "Ti-tidak, aku tidak bermaksud menyinggungmu, percayalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010313,
					"content": "Kalau begitu bawa aku menemui Gentry Maocai, atau kamu akan merasakan akibatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Ma-maafkan aku! Saat ini Tuan sedang melakukan negosiasi bisnis di Xinyue Kiosk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010316,
					"content": "Tolong kasihanilah aku, jangan sampai Tuanku tahu soal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010317,
					"content": "Tuanku juga masih banyak hal penting yang harus dilakukan daripada bicara dengan penjaga tak sopan sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Kamu sedang menunggu {NICKNAME} dan Gentry Maocai selesai berbicara soal bisnis agar dia melupakan pelanggaranmu kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "Te-terima kasih banyak! Semoga bisnismu selalu diberkati oleh Lord Geo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010320,
					"content": "#Tak disangka {NICKNAME}, kamu bisa bernegosiasi seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Aku hanya menggertak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Kalau begitu, mulai sekarang Paimon harus lebih jeli lagi melihat apakah kamu cuma menggertak atau tidak padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Sepertinya tamu VIP yang disebutkan penjaga itu adalah orang Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Sepertinya benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Kalau begitu, ayo cepat kita pergi ke Xinyue Kiosk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Lebih baik datang tepat waktu daripada datang lebih awal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Kamu juga tidak buruk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Hehe, kalau kamu memang mau berterima kasih, ayo traktir aku makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Tunggu saja sampai Tuanmu memberi pelajaran untukmu karena hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Aku {NICKNAME}, tamu VIP bosmu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Aneh, namamu tidak ada di buku tamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Sturdy Wu"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
