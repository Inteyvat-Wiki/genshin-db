			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gentry Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Aku mengerti, tenanglah, aku pasti akan menyelesaikan pesanannya sesuai janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010702,
					"content": "Tapi orang yang kuminta untuk menjalankannya terlihat tidak begitu optimis dengan pembelian tersebut. Apa ada seseorang yang bersikap tidak kooperatif?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120010703,
					"content": "A-ah... hanya sedikit masalah dengan bahan bakunya. Kami hanya belum dapat membeli Cor Lapis tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010704,
					"content": "Tapi jangan khawatir, jika Chang the Ninth tidak mau menjualnya, aku masih bisa membelinya dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010705,
					"content": "Baguslah kalau begitu, kuingatkan sekali lagi, orang Fatui hanya peduli pada hasil akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120010706,
					"content": "Kami Fatui bersedia membantumu menyelesaikan transaksi ini, tapi kalau tidak diselesaikan dengan tepat waktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120010707,
					"content": "Kebaikan hati kami tidak diberikan secara cuma-cuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120010708,
					"content": "Aku mengerti, terima kasih banyak atas perhantian Anda, Anda tahu aku tidak mungkin berani mengecewakan Anda, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010709,
					"content": "Baiklah, mari kita lihat hasilnya saat waktunya tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120010710,
					"content": "Hah... dasar Chang sialan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 610045701,
					"content": "Jadi ternyata Gentry Maocai memang bersekongkol dengan orang Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Siapa tahu si kutu buku sudah ada kemajuan juga, ayo kita kembali dan beri tahu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Huh, katanya ada hal lain yang harus dilakukan, sok misterius saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Sebenarnya kamu cuma mau ganti tempat buat baca buku saja kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Kami sudah menyelidiki apa yang sedang dilakukan oleh Gentry Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Ternyata begitu, kurang lebih sama seperti dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Apa kamu benar-benar sudah menduganya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Aku sudah tahu apa yang harus dilakukan. Aku punya sepucuk surat di sini, tolong kalian antarkan surat ini ke Feiyun Commerce Guild, dia tahu apa yang harus dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "Tuanku, karena suatu alasan yang tidak bisa kuucapkan, aku tidak bisa menemani Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "Isi suratnya kalian tidak perlu tahu, jika nanti waktunya sudah tiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Aduh! Tulisan macam apa ini! Mata Paimon sakit, dilihat juga tidak dapat dibaca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "Apa ini bahasa kuno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Wow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Karena itu kubilang kalian tidak usah melihatnya, jangan lihat... lagi pula tidak ada hubungannya juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "Ada orang di Feiyun Commerce Guild yang bisa memahami itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Tapi, kenapa Feiyun Commerce Guild harus ikut campur? Bukannya mereka organisasi dagang besar di Liyue, kenapa mereka mau membantu kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "Feiyun Commerce Guild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Sejak kita tiba di Liyue, Paimon mendengar orang-orang terus menyebutnya, mereka banyak mendominasi perdagangan di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Bagus sih kalau kita memang punya dukungan yang kuat, tapi apa kamu yakin dia mau bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Kamu tidak perlu khawatir. Sepengetahuanku, mereka masih memiliki jiwa kesatria, sama sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Setelah mereka membacanya dan memahami isi surat tersebut, mereka pasti akan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Kamu yakin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Gentry Maocai harus diberi pelajaran yang tidak akan pernah dia lupakan. Ini adalah sesuatu yang tidak bisa kita lakukan sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Oh lalu, jangan biarkan orang lain tahu bahwa aku terlibat dalam masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Kenapa? Kamu melakukan ini bukan cuma untuk Chang the Ninth ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"Jika kita melakukan suatu kebaikan, hendaknya tidak perlu diributkan.\" itulah hal yang sepatutnya dilakukan oleh seorang knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Setiap tetes kebaikan yang kuterima, harus dibalas dengan budi baik, dan aku tidak mengharapkan pujian ataupun hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Kedengerannya bagus, tapi jujurlah, kamu sebenarnya cuma mau mereka melakukannya supaya kamu bisa terus baca buku kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Terima kasih sebelumnya kepada kalian karena mengantarkan surat itu kepada Feiyun Commerce Guild. Salah seorang dari mereka seharusnya sekarang berada di dekat Liuli Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Hei! Jangan abaikan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "Mengapa harus mencari mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Mungkin ini bahasa rahasia yang memerlukan alat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}