			"dialogs": [
				{
					"id": 200070101,
					"content": "#Terima kasih, {NICKNAME}! Tidak bisa dipercaya, kupikir tamat sudah riwayatku tadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Gerobak ini dipenuhi oleh barang-barang hasil buruan. Draff memintaku mengantarnya ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Walaupun aku bukan... pemburu yang hebat, tapi kupikir aku pasti bisa menyelesaikan pekerjaan sesederhana ini. Begitu pikirku tadinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Tapi kemudian terjadi sedikit masalah, mereka tiba-tiba menyerang entah dari mana, sepertinya ini memang barang yang bagus sehingga mereka mengincarnya, untunglah kamu datang tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Emm... aku sebenarnya tidak enak hati mengatakannya, tapi gerobakku rusak... Kalau mau pergi dari sini, aku harus memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Hutan di sekitar sini pasti mempunyai bahan-bahan yang kubutuhkan untuk memperbaikinya, tapi aku takut meninggalkan gerobakku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Jika tidak merepotkan, bisakah kamu membantuku mencari <color=#00E1FFFF>Papan Kayu Kokoh</color> di hutan sekitar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
