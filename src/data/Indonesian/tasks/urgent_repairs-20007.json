			"dialogs": [
				{
					"id": 200070401,
					"content": "Terima kasih banyak, mereka gigih sekali ya, aku jadi penasaran sebenarnya barang apa sih ini sampai-sampai menarik perhatian mereka begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Aku kagum pada Draff yang bisa berburu barang langka seperti ini, ah... andai saja aku bisa menjadi pemburu hebat seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Ah sudahlah, pertama-tama kita harus membawa gerobak ini dulu ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Maaf, Pengembara, sebenarnya aku tadi hampir selesai memperbaikinya, tapi karena serangan tadi, jadi bermasalah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Jika aku tetap di sini akan lebih berbahaya. Aku harus segera memperbaikinya, aku ingat ada tali di dalam gerobak tapi pasti para Hilichurl tadi mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "Pengembara, bisakah membantuku mencari <color=#00E1FFFF>tali</color> di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
