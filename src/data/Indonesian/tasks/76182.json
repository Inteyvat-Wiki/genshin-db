			"dialogs": [
				{
					"id": 761820101,
					"content": "Ini tempat tinggalmu dulu? Cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820102,
					"content": "Dulu tamannya jauh lebih indah. Begini-begini aku jago mengurus taman loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820103,
					"content": "Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820104,
					"content": "Kamu ketawain apa lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820105,
					"content": "Aku hanya membayangkan kamu sedang berjongkok merawat bunga-bunga itu. Adegan yang imut sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820106,
					"content": "Aku boleh lihat ke dalamnya nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820107,
					"content": "Tentu saja. Aku sudah membersihkan semua debunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820108,
					"content": "Apa rencanamu dengan tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820109,
					"content": "Hmm ... Menurutku aku masih ingin seperti sekarang saja. Aku bisa kembali dan merapikannya kapan pun aku punya waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820110,
					"content": "Kalau kamu sibuk, aku bisa bantu merawatnya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820111,
					"content": "Rasanya sama seperti kamarmu yang dulu. Menenangkan ... aku suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820112,
					"content": "Hah ... Terserah kamu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
