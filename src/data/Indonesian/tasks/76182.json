			"dialogs": [
				{
					"id": 761820201,
					"content": "... Tempat ini benar-benar indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820202,
						761820203
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820204,
					"content": "Baiklah, ayo kita kembali lagi lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761820203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Marionette"
				}
			]
