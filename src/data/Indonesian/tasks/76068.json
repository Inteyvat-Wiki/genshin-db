			"dialogs": [
				{
					"id": 760680101,
					"content": "Ah, Aria. Sepertinya kamu juga sudah memilih wujud \"manusia\" untukmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Hehe, penampilanmu juga sesuai ekspektasiku, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Tapi aku tidak sangka kamu rela menciptakan wujud seperti ini untuk makhluk kecil yang menggemaskan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "Ini sudah seharusnya, Aria. Makhluk-makhluk rapuh itu percaya padaku dan memanggilku, jadi aku akan menjawab suara mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Kita terlahir untuk menjaga dunia. Kalau makhluk bernama \"manusia\" bersedia menetap di dunia kita, berarti mendengarkan permintaan mereka juga merupakan misi yang diberikan raja kepada kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Ya, bagaimanapun juga, raja pernah bilang kalau semua kehidupan di antara lautan bintang adalah sekutu kita dalam melawan kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Tapi bukan itu yang ingin kukatakan. Yah, aku tidak sangka \"Frost Moon\" bisa menunjukkan sisi emosional seperti ini. Lucu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "... Bahasamu sudah mulai terpengaruh manusia-manusia kecil itu, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Kata-kata mereka selalu ambigu seperti ini. Jangan pakai deh. Aku sama sekali tidak mengerti apa yang ingin kamu sampaikan dengan kata \"lucu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Ah, sudahlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Kak Aria, Kak Canon, setelah menciptakan wujud untuk diri sendiri, yang pertama harus dilakukan kan menyelinap keluar diam-diam dan bermain bersama orang di atas sana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Kalau tidak, sia-sia dong punya bentuk ini! Cepat, sebelum ada yang sadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Hehe, sepertinya adik tersayang kita sudah tidak sabar, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Waktu mereka pertama kali membangun peradaban di atas tanah, kamu bilang \"pendatang asing itu bukan orang baik, ciptaannya juga pasti begitu.\" Kamu bahkan tidak mau melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "Itu kan hal yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Aku juga merasa kalian berdua seharusnya tidak membiarkan orang luar itu masuk, tapi orang-orang di permukaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "Hah ... yang penting kalian bersenang-senang. Pergilah, jangan jauh-jauh dari Aria ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Hmm? Kak Canon tidak ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "Pelayan Descender itu bilang ingin bicara denganku. Tentang potensi gravitasi dan metrik ten{RUBY#[D]hukum waktu}sor dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Istaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Harusnya benar itu namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Kamu harus ingat nama orang lain ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "Tapi ... mungkin perasaanku saja sih, tapi aku rasa, sifatnya terhadap Descender itu kayaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Aku tidak akan menilai terlalu cepat, Aria. Tapi aku akan tetap waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Oke, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Hehe, tidak ada apa-apa. Oke, kami pergi dulu ya, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Tenang saja, aku dan Sonnet akan bawakan oleh-oleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "Ah, aku tidak perlu oleh-oleh. Yang penting kalian hati-hati saja supaya tidak ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}