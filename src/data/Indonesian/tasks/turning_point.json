			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "*hosh... hosh...* Paimon kelelahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "Kalau tadi tidak sengaja lihat Jade Chamber melayang saat kita keluar dari Golden House, kita pasti tidak tahu harus pergi ke arah mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Apa kita bisa menyusulnya? Apa Overlord of the Vortex masih ada di laut? Dia belum menghancurkan Liyue kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "Kalian... kenapa ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Eh?... ah! Para Adeptus! Apa yang kalian lakukan di Jade Chamber? Paimon kira kalian sedang bertengkar dengan Qixing... Apa bertengkarnya sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Dihadapkan dengan bencana sebesar ini, para Adeptus dan Qixing setuju untuk melakukan gencatan senjata sementara dan bersatu untuk melawan musuh yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10240208,
					"content": "Ternyata begitu. Jadi, sekarang kalian punya solusi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Wow... cuma dengan melihat Overlord of the Vortex dari jauh saja Paimon sudah merasa sulit bernapas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Beberapa prajurit baru Millelith saja sudah gemetaran sekarang. Penampakan dewa kuno ini sungguh terlalu hebat bagi para manusia biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "...karena itulah kita harus menghentikan monster itu sebelum dia mendekati Pelabuhan Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Jadi apakah Perang Archon dua ribu tahun lalu itu melawan musuh seperti ini... mengerikan ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Jadi, apa kekuatan Qixing, Millelith, dan Adeptus bersama-sama di sini sudah cukup buat menghentikan dewa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Kita sudah berdiskusi soal ini, dan jawabannya... belum tentu cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "Hah?! Ta-tapi kamu kan makhluk abadi yang menjaga Liyue, lalu ada para Qixing yang juga menjaga Liyue! Pasti ada caranya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Hanya ada satu cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10240218,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Para Qixing pernah melakukan penelitian mengenai Guizhong Ballista ketika itu masih menjadi perhatian mereka sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10240220,
					"content": "Dan sepertinya sudah menjadi sebuah takdir bahwa pencipta Guizhong Ballista itu sendiri sekarang ada di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10240221,
					"content": "Apa yang bisa dipelajari manusia biasa tentang mesin ciptaan Adeptus? Aku hanya perlu melakukan sedikit modifikasi pada Guizhong Ballista ini untuk mengubahnya menjadi senjata perang yang sangat kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10240222,
					"content": "Hehe... ini berkah Adeptus yang harus disyukuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Baiklah, kami akan menggunakan Guizhong Ballista yang sudah diperbarui untuk melawan dewa itu. Semua Adeptus di sini akan meminjamkan kekuatan mereka untuk melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Tanpa basa-basi lagi, pertempuran ini dimulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
