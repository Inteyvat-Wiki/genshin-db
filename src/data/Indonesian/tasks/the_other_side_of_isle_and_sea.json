			"dialogs": [
				{
					"id": 790040101,
					"content": "Eh? Lihat... Ada semacam lukisan di permukaan batu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 790040102,
					"content": "Kelihatannya seperti kapal... yang banyak penumpangnya... lalu kena bencana di tengah laut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 790040103,
					"content": "Paimon tidak paham deh... Atau mending, gimana kalau kita salin dulu saja mural ini?",
					"roleType": "TALK_ROLE_NPC",
