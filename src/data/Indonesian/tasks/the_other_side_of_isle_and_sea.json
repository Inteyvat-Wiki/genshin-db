					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "Halo, apa ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Umm, apakah kamu seorang peneliti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Haha, sebut saja begitu. Lebih tepatnya lagi, aku adalah seorang \"pelajar keliling\". Menurutku, ini masih termasuk ke dalam \"peneliti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "Jadi, apakah kalian menjumpai masalah yang membutuhkan bantuan seorang \"peneliti\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Begini ceritanya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Pulau di tengah laut... dan mural yang kamu temukan di sana, benar-benar menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "Jadi kalian mencari seorang peneliti yang bisa membantu kalian menafsirkan potongan-potongan mural itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "Maukah kamu membantu kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Tentu saja, aku tidak akan melewatkan kesempatan untuk mempelajari hal baru yang belum diketahui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Nah, tunggu apa lagi, bolehkah aku melihat mural-muralnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Ini beberapa mural yang berhasil kami salin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Oh, lumayan, lumayan. Maaf, tolong biarkan aku berpikir sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "Kami akan memberikan imbalan yang sesuai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "Hahaha, kalian sepertinya petualang yang sangat berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "Kisah baru yang belum diketahui seperti ini sudah cukup menjadi imbalan terbesar yang mungkin kudapatkan. Kamu tidak perlu membayarku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
