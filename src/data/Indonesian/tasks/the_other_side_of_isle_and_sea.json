			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900402",
							"3"
						],
						"stepId": 7900402,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900419",
							"2"
						],
						"stepId": 7900419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Oke, semua mural sudah kita salin. Mungkin kalau disambung, akan terlihat jelas keseluruhan peristiwanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Hmm, sebenarnya tidak susah menafsirkan mural-mural ini. Aku belum mengurutkan semuanya dengan tepat, tapi kurasa tidak masalah jika kita kaji mereka satu per satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040402,
					"content": "Kita lihat mural pertama yang menggambarkan orang-orang yang terdampar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040403,
					"content": "Setelah karam, mereka terdampar di pulau tempat kalian menemukan mural-mural ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040404,
					"content": "Lalu mereka pun tinggal di pulau tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040405,
					"content": "Mural ini, menunjukkan lima benda yang memiliki lima tanda berbeda di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040406,
					"content": "Seperti lima gelas berisi air, yang masing-masing tidak sama penuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040407,
					"content": "Karya seni seperti ini biasanya menandakan ada sesuatu yang mengalami perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040414,
					"content": "Sesuatu yang mengalami perubahan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Hanya saja, aku belum bisa menerka apa sebenarnya \"sesuatu\" itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040409,
					"content": "Bagaimanapun juga, jika tempatnya adalah sebuah pulau di tengah laut, maka \"sesuatu\" itu bisa jadi \"air laut\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040410,
					"content": "Sekarang lihat mural berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040411,
					"content": "Ada lagi kapal lain yang karam dan ada \"tamu\" baru yang tiba di pulau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040412,
					"content": "Lihat, orang-orang dari kapal pertama mencoba untuk menolong orang-orang dari kapal kedua. Lihat juga bangkai kapalnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040413,
					"content": "Mural pertama cuma menunjukkan sedikit tentang keadaan mereka, tapi mural yang ini menggambarkan kapal yang karam secara terperinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040416,
					"content": "Mungkin bangkai kapal ini memiliki makna khusus untuk orang-orang yang terdampar di pulau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040417,
					"content": "Kemudian lihat mural yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040418,
					"content": "Pada mural yang ini, jelas terlihat sebuah gunung yang ditandai secara khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040419,
					"content": "Kurasa ini tempat yang penting bagi orang-orang yang terdampar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040422,
					"content": "Terakhir, lihat mural yang ini. Mereka telah menemukan cara untuk meninggalkan pulau, lalu kemudian pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040423,
					"content": "Demikianlah kisah yang digambarkan pada mural-mural ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040424,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "Sama-sama. Aku memang berminat meneliti hal-hal semacam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040426,
					"content": "Akulah yang seharusnya berterima kasih pada kalian karena telah membawakan mural ini dan kisahnya. Tak pernah terbayangkan kalau aku akan mendapat kesempatan seperti ini di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040427,
					"content": "Sepertinya aku harus menyempatkan waktu untuk keluar jalan-jalan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040428,
					"content": "Kenapa mereka memilih mural sebagai media?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
					"content": "Terkadang, menggunakan gambar untuk menyimpan dan menyampaikan informasi lebih mudah daripada menggunakan bahasa dan tulisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040415,
					"content": "Jadi artinya... apa?",
