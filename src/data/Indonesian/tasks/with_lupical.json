			"dialogs": [
				{
					"id": 100080101,
					"content": "Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080102,
					"content": "*endus* Bau yang akrab. Ah, kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080103,
					"content": "Kalian, apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080104,
					"content": "Hehe, iya! Kami baik-baik saja! Oh, tapi Boreas apa kabar, Razor? Kami lihat, kalian lagi ngobrol tadi. Rahasia enggak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080105,
					"content": "Kami pergi berburu. Aku coba yakinkan ... raja serigala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080106,
					"content": "Berburu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080107,
					"content": "#(Oh, {NICKNAME}. Apa jangan-jangan itu \"tugas\" Razor?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080108,
					"content": "Para serigalanya udah kehabisan makanan ya? Jadi kamu harus pergi berburu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080109,
					"content": "Berikan aku jebakan hewan liar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "Tidak. Perburuan ini bukan untuk makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080112,
					"content": "Kami berburu ... musuh. Kawanan serigala gelap. Bau aneh muncul dari tanah yang mereka ambil. Semakin menguat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080113,
					"content": "Kami memburu musuh untuk memurnikan hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080114,
					"content": "Oh, jadi Boreas setuju? Paimon ingat terakhir kali dia ngomong macam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080115,
					"content": "Ehem, \"Razor, kamu tidak seharusnya ikut campur. Karena ini adalah persoalan di antara serigala.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080116,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080117,
					"content": "Ah, maaf, Razor. Paimon enggak bermaksud mengungkit hal itu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080118,
					"content": "Tidak apa-apa. Aku tahu, Lupical, bukan jahat. Lagi pula, Guru sudah mengajariku cara berbicara dengan raja serigala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080119,
					"content": "Lisa ngajarin kamu ngomong sama raja serigala ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080120,
					"content": "Oh! Jadi, dia kasih tahu kamu harus ngomong apa gitu? Berarti kamu berhasil membujuknya dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080121,
					"content": "Ya. Berbicara ... sulit. Tapi, berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080122,
					"content": "Hah, jadi kamu benar-benar berhasil meyakinkan si besar yang keras kepala itu! Hebat banget sih, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080123,
					"content": "Serigala kegelapan, musuh seluruh dunia. Guru bilang, ini bukan masalah serigala. Ini, masalah dunia ... dan raja serigala setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080124,
					"content": "Tapi, karena itu, serigala lain tidak akan bergabung. Perang ini hanya antara aku dan kawanan serigala hitam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080125,
					"content": "Kalau begitu, kami juga ikut! Rifthound sialan itu sudah lama bikin kami kesal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080126,
					"content": "Te-Terima kasih ... Ada bantuan, berburu jadi mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080127,
					"content": "Ngomong-ngomong, kita berburunya mau gimana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080128,
					"content": "Kita pasang perangkap. Kejar serigala hitam ke sini. Masuk ke perangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080129,
					"content": "Lalu raja serigala akan menahan mereka, dan perburuan ... selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080130,
					"content": "Beri tahu aku kalau sudah siap. Kita mulai perburuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080401,
					"content": "Berangkat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "Boar di hutan itu sudah cukup besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
