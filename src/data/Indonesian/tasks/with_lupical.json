			"dialogs": [
				{
					"id": 100080301,
					"content": "Hampir saja! Untung aja ada serigala yang bantuin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Mereka menghadang para Rifthound itu buat kita, bahkan mengusirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Tapi ini bukan ... masalah serigala ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Hehe, kamu ngelakuin ini buat membantu Lupical-mu kan? Yah, mereka juga ingin kamu tetap aman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Paimon yakin mereka pergi nemuin Raja Serigala terus ngomong, \"Dengar! Ini bukan hanya masalah Lupical kita. Ini masalah dunia!\" ... Terus, cepat-cepat buat ngebantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Hmm, \"Lupical\" itu ... \"Lupical\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Aku, manusia, tapi tidak perlu jadi serigala untuk jadi \"Lupical\". Aku ... hanya ingin membantu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Bagus sekali, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Mungkin Lupus Boreas setuju untuk membiarkan kawanan membantu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Karena dia tahu isi hatimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Kamu ... berpikir begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "Iya, pasti deh! Nah, ayo kita hajar para Rifthound itu yuk!",
