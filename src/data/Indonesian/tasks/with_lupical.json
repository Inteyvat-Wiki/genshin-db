			"dialogs": [
				{
					"id": 100080601,
					"content": "Berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080602,
					"content": "Terima kasih ... sudah membantu. Kupikir melindungi Lupical adalah tugasku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080603,
					"content": "Tapi, Lupical juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "Kami ada di sini karena kami peduli denganmu, sama seperti kamu peduli dengan kami! Itulah yang membuat kita Lupical, benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080605,
					"content": "Benar ... Kita selalu, Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Hehe, dan sekarang, tidak akan ada lagi penyusup di Wolvendom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "Tidak ... Kawanan serigala kegelapan, mengoyak langit. Mereka ... bisa datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "Tapi, aku dan Lupical akan memburu mereka ... bagaimanapun caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "... Jangan lupa kalau masih ada kami ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Ya, kalau kamu butuh bantuan, bilang saja! Kami akan selalu ada untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "Aku ... menghargainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "Awoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Lolongan dari Kejauhan"
				},
				{
					"id": 100080613,
					"content": "Mereka ... memanggilku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080614,
					"content": "Hehe, sepertinya mereka mau memastikan kamu baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080615,
					"content": "Kalau begitu ... aku harus pergi. Terima kasih ... atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080616,
					"content": "Tidak usah sungkan! Itulah gunanya Lupical!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080617
					]
				},
				{
					"id": 100080617,
					"content": "Setelah kini Wolvendom aman, Razor mengucapkan selamat tinggal dan pergi ke dalam hutan.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100080618
					]
				},
				{
					"id": 100080618,
