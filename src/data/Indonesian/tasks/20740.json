					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Terima kasih, seharusnya ini sudah cukup. Aku akan menanamnya di pot ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "... Dan juga bunga-bunga yang kamu pernah berikan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah, iya. Aku sangat berterima kasih padamu, ini ambillah sebagai hadiah terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Sekarang, aku harus segera meletakkan bunga-bunga ini ke dalam pot di sini. Dan Dandelion Seed ke pot yang di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
