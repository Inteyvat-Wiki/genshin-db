			"dialogs": [
				{
					"id": 40190401,
					"content": "Eh ... kalian balik lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot! Laverune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "Kalian ... ketangkap lalu dijebloskan ke sini lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Hah? Enggak kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "Duh! Kirain kalian berhasil kabur waktu rusuh tempo hari! Aku sudah jadikan kalian tokoh legendaris yang berhasil kabur dari penjara, tapi ternyata ... kalian tidak pernah pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Ahahaha ... Uh, maaf, kami ... ada keperluan ... yang mesti diurus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Sudah, sudah, ngapain mikirin detailnya. Kami senang bisa ketemu kalian lagi. Orang ini cemas bukan main loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "HEH, bukan aku doang ya! Kamu juga sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Iya, begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "Aku juga dipindah kerja ke dapur beberapa hari lalu. Dan si Cuistot tidak henti-hentinya ngomong sama wortel: \"Mereka berdua apa kabar ya? Berhasil keluar hidup-hidup tidak?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Setiap kali dengar yang gitu, aku akan komentar: \"Mereka pasti baik-baik saja, sekarang pasti lagi minum sambil menikmati pemandangan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "EH, khawatir sama teman sesama narapidana salah di mananya coba? Apalagi teman yang dua ini senang banget dengar gosip ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Mereka berdua ... kok jadi lebih ramah dan bersahabat dari dulu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Makanan gratisnya pasti jadi lebih enak nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "Yah, apa katamu lah. Aku akan awasi, awas kalau ada yang tidak dihabiskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Makanan kalian akan bikin kantin kebanjiran tahanan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
