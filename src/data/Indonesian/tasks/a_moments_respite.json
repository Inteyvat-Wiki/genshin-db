			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}, Paimon, kalian sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "Kalian baik-baik saja, kan? Ada luka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Tenang, aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Kami oke kok! Kalian sendiri gimana? Parah banget yang tadi itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Ada sebagian yang menderita luka luar, tapi hanya sejauh itu saja kerugiannya. Monsieur Neuvillette datang, dan berkat dia kita berhasil mengatasi bencana untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Tentunya terima kasih banyak juga untuk bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Neuvillette kok bisa tahu dia diperlukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Monsieur Neuvillette punya kepekaan sangat kuat terhadap elemen Hydro. Ketika ketinggian air naik, dia bisa merasakan gelombangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Aku ketemu Duo Bomberman waktu lagi pasang perban ke yang luka-luka. Mereka lagi bahas tentang kalian yang lari ke bawah tanpa sepatah kata pun ... Untunglah kalian berdua baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Kalau kalian tidak buru-buru, tinggallah beberapa hari lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Kalau kalian ingin makan sesuatu, bilang saja. Biar aku minta Tuan Koki Wolsey masak buat kalian. Oh ya, silakan kalau mau rebahan di klinik ya, bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Aku ingin gunakan waktu ini untuk lebih banyak mempelajari otot wajah kalian. Senyuman bahagia kalian mudah sekali menular, sangat membekas di ingatan, dan aku kangen berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
