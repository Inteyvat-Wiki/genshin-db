			"dialogs": [
				{
					"id": 40190301,
					"content": "Mataku rabun, atau memang ada dua tahanan yang balik lagi setelah dilepas ke dunia atas? Ada angin apa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "Kami ingin menengok keadaan kalian di benteng? Aman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Kami baik-baik saja. Neuvillette turun dan membereskan bagian yang paling parahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "Hmm, kalau begitu, kenapa tidak minta dia di sini terus saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Oh, ide bagus. Mari kita sama-sama bujuk Iudex yang agung untuk menukar pengadilan Fontaine yang hingar bingar dengan genangan air di antah berantah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Seratus persen gagal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Dia datang dengan terburu-buru, lalu pergi terburu-buru. Minum teh saja tidak sempat. Tapi dia tidak lupa bawa hadiah dari Nona Sigewinne sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Sibuk banget yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Nona Clorinde juga sudah pergi. Dan dia juga bawa hadiah dari Nona Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "Hadiah apa sih? Milkshake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Neuvillette dapat milkshake. Clorinde dapat lipstik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Ehh??? Kok jauh amat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Salah Neuvillette sendiri bikin Nona Sigewinne cemas karena kesibukannya. Tapi terlepas dari itu, suster kepala kita memang suka sekali pilih kosmetik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Oh, aku juga ada hadiah buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "Dari Sigewinne juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "Bukan, ini dari aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Kalian sudah menyelesaikan pekerjaan di benteng, dan bebas pulang ke atas kapan saja. Namun masa hukuman kalian belum habis, jadi selama itu silakan kalau ingin menggunakan sel kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Wah, serius! Berarti bebas diam di sini sampai lama sekali dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "Makannya masih gratis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Ya, kalian bebas makan di Kantin Bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "HORE!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Jangan lupa datang ke tempatku untuk mengurus administrasi kalau sudah waktunya bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
