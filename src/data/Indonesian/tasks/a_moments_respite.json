			},
			"dialogs": [
				{
					"id": 40190601,
					"content": "Kita balik lagi ke sel dong! Tapi sudah bukan sebagai napi, jadi rasanya agak beda juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "Kita berhasil naik dari tempat terbawah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Betul! Tapi pada dasarnya kita emang enggak salah apa-apa sih, jadi ya sebenarnya bisa kapan pun berpuas diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "Kita kembali bebas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "Mhm! Senang sekali ya jadi orang bebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Paimon, mau ngomong apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Ha? Kok bisa tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Karena biasanya kamu bakal langsung bobo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Eh, enggak gitu-gitu amat ya! Oke deh ... Paimon cuma mau bilang, kita berdua memang keren ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Kayak ... kita sudah ke banyak sekali tempat barengan, dan berteman sama banyak sekali orang. Kita enggak pernah berhenti bertualang, dan selalu ketemu teman baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "Banyak hal buruk yang terjadi di dunia, dan kita ini cuma dua orang. Tapi ke mana pun kita melangkah, selalu berhasil menyelesaikan masalah yang menghadang ... keren enggak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "Kita ini duo petualang paling hebat sepanjang masa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "Tumben Paimon ikut dihitung? Yang petualang kan kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Pemandu juga termasuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "Kalau gitu Paimon mau minta buku Panduan Petualang ke Nona Katheryne! Mulai hari ini, Paimon juga jadi petualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "Ahh, baru dipikirin juga Paimon sudah senang ... Sudah ah, waktunya bobo! Kamu juga sana, cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
