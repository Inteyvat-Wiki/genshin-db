			"dialogs": [
				{
					"id": 40190501,
					"content": "Jurieu! Nona Sigewinne bilang kamu belum makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "Eh, aku lagi sibuk tadi, jadi lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Alasan apaan itu ... EH! Kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "Jurieu, Lourvine, kami balik lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "Halo, halo. Keadaan di sini lumayan berantakan. Apa kabar kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "Kami baik, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "Kalian sendiri gimana? Masih pakai jalan rahasia di klinik buat ngerjain kapal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Ya. Ingat itu rahasia, jangan diumbar ke mana-mana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Agak menyebalkan memang kalau ada banyak orang di klinik, tapi aku lebih suka lewat sana dibanding lewat kantor Duke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Soalnya klinik lebih gampang kalau kamu mau malas-malasan kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Oh? Terus kenapa kamu juga sering sekali ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Kalian berdua benar ya, pacaran terus, kedoknya saja kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "ENAK SAJA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
