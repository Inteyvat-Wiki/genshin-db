			"dialogs": [
				{
					"id": 745140101,
					"content": "Di-Dingiiin ... kenapa aku malah ke tempat yang banyak anginnya begini sih .....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140102,
					"content": "#Hah? {NICKNAME}! Paimon! Halo kaliAAACHIUUU!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140103,
					"content": "Asagiri? Ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Kamu aman? Kok bisa sih jauh-jauh ke sini? Sendirian pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745140105,
					"content": "Ah, aman kok, aman! Sekarang jauh lebih baik. Batuk-batuknya juga sudah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140106,
					"content": "Haha ... haaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140107,
					"content": "Yakin sudah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "WAH! Jangan! Oke, oke, aku ngaku! Aku kabur ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140110,
					"content": "Ti-Tidak ada pilihan, kan? Gimana caranya melukis yang indah dan cantik kalau cuma diam di Inazuma terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140111,
					"content": "Kalau kamu keliling dunia dan foto-foto buat aku pun, ya referensi gambar masih tetap kalah sama melihat langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140112,
					"content": "Jadi aku minta seorang sensei untuk menghubungi kapal dagang. Aku pun diam-diam menumpang kapalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140113,
					"content": "Semua alat lukis dibawa ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Ya iyalah! Kanvas ini separuh jiwaku! Mana bisa ditinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140115,
					"content": "Dan lukisanku ternyata laku keras di Fontaine. Bahkan sudah ada penulis yang minta aku bikin ilustrasi buat sampul novelnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140116,
					"content": "Tapi ... ternyata penulis Fontaine tidak paham soal memberi ilustrasi di DALAM novelnya. Aneh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140117,
					"content": "#Oh iya, {NICKNAME}, mumpung ada di sini ... mau dooong bantu-bantu cariin referensi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140118,
					"content": "Sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "Asyik! Dengan bantuanmu, beres sudah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140123,
					"content": "Oke, lihat dulu ya. Aku kebetulan baru dimintain tolong sama beberapa orang penulis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140120,
					"content": "Baiklah, tapi jangan ke mana-mana ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "Siap! Lagian aku juga mati kutu kalau ketemu Clockwork Meka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140122,
					"content": "Kalau urusannya sama monster sih, kamu juaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140108,
					"content": "Kirim surat dulu deh, cek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}