						747030104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030104,
					"content": "Kamu jadi menyesal cuma ambil 30%?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Jadi aku serendah itu di matamu? Aku cuma kagum kalian benar-benar kelola akuarium ini dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030106,
					"content": "Paimon rasa ini sedikit banyak berkat Festival Film Fontinalia juga deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Pemasukan sebanyak ini ... Bahkan setelah membayar sewa Wingalet, untungnya masih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030108,
					"content": "Mau ganti karier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Tidak sama sekali. Aku tidak cocok berbisnis. Merakit mesin dan meneliti sihirlah yang jadi gairahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030110,
					"content": "Meski begitu ... aku rasa kamu benar. Melihat tempat ini berubah dari ruangan tanpa ikan menjadi seperti sekarang, rasanya seperti keajaiban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030111,
					"content": "Hehe, semua ini berkat bantuanmu yang mau pinjemin ini! Senang banget bisa lihat kerja keras kami bisa buat banyak orang bahagia. Setuju enggak, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmph. Sedikit deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030113,
					"content": "Sedikit saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Pasti karena dia cuma dapat 30% ....",
