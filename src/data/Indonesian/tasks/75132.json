			"dialogs": [
				{
					"id": 751320601,
					"content": "Pahlawan dari jauh ... aku sudah mengetahui segala jasa-jasamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320602,
					"content": "Kehebatanmu sungguh luar biasa, wahai pahlawan. Kekuatan yang terkorosi telah kembali ke alam Patih Malam! Aku bisa mendengar jiwa-jiwa malam bersorak-sorai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320603,
					"content": "Ambillah ini, wahai pahlawan. Segala jasa dan perbuatan mulia tidak akan tersia-siakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				}
			]
		}
	]
