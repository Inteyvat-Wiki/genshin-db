					}
				]
			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "Sebab musuh terkutuk itu selalu mengintai, dan berhati-hatilah dengan semua musuh yang membawa korosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320502,
					"content": "Pahlawan dari jauh ... apakah ada yang ingin engkau ketahui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320503,
					"content": "Tentang mural para pahlawan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "Mereka berada di arah timur, di dalam gua yang berisi pohon terang bergerak mengikuti narasi pemegang gulungan tenun. Ada ancaman kengerian yang muncul dari kisah zaman dahulu kala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320505,
					"content": "Mungkin bayangan itu ingin melarikan diri dari hikayatnya di masa silam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320506,
					"content": "Tentang yang ada di atas lautan penuh misteri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "Pulau yang berselimut kabut itu ada di sebelah barat. Pada suatu masa, tempat itu adalah wilayah kudus untuk mengadakan upacara. Dihuni oleh mereka yang mengikat sumpah dengan Iktomisaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320508,
					"content": "Namun kenajisan muncul dari dalamnya, dan tempat yang kudus berubah menjadi terkutuk, disegel, lalu terlupakan ... Namun musuh kita yang licik itu tidak mudah menyerah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320509,
					"content": "Tentang kabut tanpa warna itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "Kabut nista itu pertama kali tercipta ketika kota kuno Ochkanatlan runtuh. Seharusnya kabut ini sudah disegel ... namun waktu dan kenangan memusuhi kita .....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320511,
					"content": "Jika saja ... ada yang bisa memusnahkan kabut itu ... sekali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320512,
					"content": "Sementara ini tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ah ... ingatlah, ingatlah untuk selalu ... waspada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				}
			]
		},
