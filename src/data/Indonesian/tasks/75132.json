			"dialogs": [
				{
					"id": 751320101,
					"content": "Ah ... wahai pahlawan dari tanah asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320102,
					"content": "Dengarkan petuahku. Akulah gagak pemandu, yang merupakan ingatan milik Penguasa Malam yang merenungkan puisi-puisi ... dan sekaligus merupakan butiran debu benak yang hilang di bawah sinar rembulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320103,
					"content": "Dengarkan petuahku. Sebab sungai roh di bawah bumi telah pecah, diriku hanya bisa berbicara lewat gambaran ini, agar dirimu senantiasa waspada terhadap musuh yang gelap nan licik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320104,
					"content": "Cermin pecah itu dulu pernah memantulkan cahaya terang di tempat ini. Namun kini asap hitam melanda tiga wilayah. Camkan ini baik-baik:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320105,
					"content": "Yang pertama ada di timur, bayangan yang bersembunyi di antara mural para pahlawan legendaris yang terlupakan telah muncul kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320106,
					"content": "Yang kedua ada di barat, di atas laut penuh misteri. Di sana kegelapan menjelma meniru suara raja malam seperti burung beo yang nista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320107,
					"content": "Yang ketiga ada di bawah tebing. Kabut tanpa warna yang seharusnya sudah hilang itu, kini menyebar kembali meliputi Kota Bara yang hidup kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				},
				{
					"id": 751320108,
					"content": "Pahlawan dari bangsa asing, waspadalah ... sebab musuh terkutuk itu selalu mengintai, dan berhati-hatilah dengan semua musuh yang membawa korosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suara Tekad Grafiti Misterius"
				}
			]
		},
		{
