					"content": "Kemampuanmu masih sehebat biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Sudah kamu perhatikan baik-baik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "Tentu saja! Aku sudah memperhatikan semuanya, mulai dari genggaman sampai tarikan busurmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "Hmmm, bagaimana bilangnya ya? Semakin aku melihatmu, rasanya aku semakin bisa merasakan perbedaan kemampuan kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "Ya-Yah, lebih baik jangan dipikirkan dulu deh. Tolong terima ini ya sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Aku akan lanjut berlatih lagi nanti. Targetku selanjutnya... kena tujuh dari sepuluh sasaran, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
