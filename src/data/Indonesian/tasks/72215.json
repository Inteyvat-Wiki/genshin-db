			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Kamu sudah menggantung semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150302,
					"content": "Sudah semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Miaw miaw, bagus sekali. Sekarang kuilnya pasti akan jadi lebih ramai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150305,
					"content": "Hmm. Kenapa masih belum ada orang-orang yang datang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150306,
					"content": "Kurasa tidak akan datang secepat itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "Ah, manusia memang sulit dimengerti. Tentu saja kecuali dirimu, kamu mengerti tentang sangat banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150309,
					"content": "Meskipun masih belum ada orang datang ... Tapi setidaknya anak-anak bandel itu tidak akan tersesat lagi, miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150310,
					"content": "Kata manusia batu itu, batunya akan segera siap. Silakan datang dan melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150311,
					"content": "Hmmm. Ya, masih ada satu hal lagi. Hal yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150312,
					"content": "Diriku pergi bertanya tentang Hibiki dan Domeki pada dua manusia hijau itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150313,
					"content": "Mereka berdua bilang kalau mereka tidak kenal Hibiki atau apa pun tentangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150314,
					"content": "Tapi manusia hijau yang tinggi bilang kalau dia pernah membaca tentang \"Ako Domeki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150315,
					"content": "Dia bicara tentang... \"bandit\" dan \"harta\" atau sejenisnya... Apa pun itu, dia mengatakan kalau Domeki adalah orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150316,
					"content": "Pasti ada kesalahan. Hibiki sering bermain dengannya, jadi Domeki pasti orang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150317,
					"content": "Pasti manusia itu sedikit kurang cerdas. Memang kamu ini manusia yang paling bisa diandalkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150318,
					"content": "Ah, kapan ya Hibiki akan kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150307,
					"content": "Tidak semudah itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}