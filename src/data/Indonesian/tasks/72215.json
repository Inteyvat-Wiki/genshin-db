			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Miaw miaw, kapan batu itu jadi sangat mirip dengan diriku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "Bagaimana patungnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "Manusia batu itu bilang kalau dia sudah hampir selesai mengetuk batu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Hibiki pasti akan sangat senang waktu dia kembali nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Hmm, ya. Batu ini sangat bagus, tapi kita juga harus menghias sekeliling kuil ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Tolong bantu diriku menggantung bola besi yang bisa berbunyi ini di sekitar kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "Benda-benda ini disiapkan oleh Hibiki. Jika ingatan diriku tepat, Domeki memberikannya pada Hibiki karena dia suka bermain dengan diriku dan anak lainnya. Cukup sulit menemukan bola-bola ini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "Hmm, ini ... lonceng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "\"Lonceng\"? Diriku tidak tahu apa nama benda itu, tapi Hibiki sering menggunakan bola besi itu saat bermain dengan diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Dia akan meletakkan bola besi ini di lantai, lalu mendorongnya jauh-jauh. Bola besi ini akan berbunyi \"ring, ring\" saat bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "Diriku tidak paham kekuatan apa yang ada pada bola besi ini, tapi suaranya selalu membuat diriku dan kucing lainnya ingin mengejarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "Jadi diriku sudah mengerti sekarang. Alasan tidak banyak orang datang ke sini adalah karena kuil ini tidak punya bola besi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Maka diriku meminta bantuanmu untuk menggantung bola besi ini di tempat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "Dengan begitu, para manusia bisa mengikuti suara bola besi ini saat ingin datang ke kuil dan mereka tidak akan tersesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "Nanti Kotak Uang-nya akan penuh dengan Mora, dan kuilnya akan ramai kembali... Hibiki pasti akan senang saat dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "Jadi tolong bantu diriku menggantung bola-bola besi ini di sekeliling kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Terima kasih, miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
