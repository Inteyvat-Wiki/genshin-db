					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Hmmm? Apa katamu? Boleh diulang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080402,
					"content": "Err ... itu mantan rekanmu juga ya? Jadi waktu itu kami lagi di Pantai Pasir Bintang dan dia juga keok sama Perburuan Liar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080404,
					"content": "Kamu barusan ... ketawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080406,
					"content": "(Yakin banget tadi dia ketawa!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Kalian berdua enggak akur ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Bukan begitu. Aku hanya membayangkan ekspresi kesalnya waktu dia kalah, dan kurasa sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080409,
					"content": "Dia emang kelihatan lumayan kecewa sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Oh, sebentar lagi juga dia pulih. Itu memang keahlian dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080411,
					"content": "Oke, kita jadi agak melenceng. Sekarang kita udah tahu kalau yang mengincar Sumsum Bulan ini berbahaya banget, kamu yakin masih mau bawa ke mana-mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Kalau informasi dari Fatui bisa dipercaya, seandainya seluruh Nod-Krai maju melawan Rerir pun, tetap dia yang akan menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080413,
					"content": "Mungkin sekarang ... ada sesuatu yang mengekangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080414,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Sebelum memutuskan, ada hal yang ingin kuminta padamu, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080417,
					"content": "#Apa kamu bisa menunjukkan apa yang terjadi padaku dan {M#adikku}{F#kakakku} saat pesawat kami baru mendarat di Nod-Krai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080419,
					"content": "Cepat juga setujunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Seperti kataku tadi, bagiku ini hanyalah secercah cahaya bulan. Bukan sesuatu yang sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080421,
					"content": "Ulurkan tanganmu, dan bersiaplah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080422,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Ini sama seperti yang kulihat sebelumnya, tapi lebih jelas ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Setidaknya kami mendarat dengan selamat ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Sepertinya sudah berlalu cukup lama ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Kami masih ada di dalam pesawatnya. Ternyata kita lama sekali berada di dalam ... Kira-kira kapan {M#Lumine}{F#Kak Aether} keluar ya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Tunggu. Itu kan ... {M#Lumine}{F#Kak Aether}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Mana mungkin? Belum ada yang keluar dari pesawat sejak mendarat! Pintunya saja belum dibuka!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Aku ... di mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Kak Aether}{F#Lumine}! Cepat! Kita harus pergi dari sini!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "Ka-kamu enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Setelah pesawat luar angkasa kami ... mendarat ... waktu yang berlalu sudah lama sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Tidak ada yang keluar dari pesawat, tapi ... entah bagaimana {M#Lumine}{F#Kak Aether} menemukanku dari luar pesawat kami ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Eh?! Gimana itu ceritanya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Entahlah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Rahasia yang ada di dalam ingatan itu ibarat biskuit. Gigit satu kali, remah-remahnya akan tersebar ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080439,
					"content": "(Ini ... aneh sekali. Aku harus cari tahu jawabannya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Tapi benar apa kata Nefer, tidak ada yang bisa kuselidiki kalau Nod-Krai hancur dulu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Baiklah. Biar aku yang pegang Sumsum Bulan-nya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "E-Eh? Y-Ya sudah kalau kamu yakin, tapi ini kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Apa kamu butuh bantuanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080445,
					"content": "Bantuan untuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Aku bisa membantumu menyembunyikan Sumsum Bulan-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080447,
					"content": "Yang benar? Bagus tuh kalau bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "Sebenarnya Sumsum Bulan ini sudah sulit dideteksi, tapi aku bisa mengajarkanmu cara menyembunyikannya lebih dalam lagi dengan kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080449,
					"content": "Seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080450,
					"content": "Oh! Jadi kayak perisai ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Rasanya lembut sekali ... seperti cahaya bulan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Apa kamu bisa merasakannya? Sekarang coba untuk mempertahankannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080453,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Kamu cepat belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080455,
					"content": "Kelihatannya cukup kuat, mungkin bisa dipakai buat melindungi diri waktu lagi genting ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Terima kasih sudah mau mengajariku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Columbina, biasanya kamu di sini terus? Di sekitar sini emang bahaya sih, tapi kamu enggak pernah jalan-jalan keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080459,
					"content": "Tidak suka orang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080460,
					"content": "Apa kita sudah termasuk orang yang dikenal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Sedikit di atas orang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080462,
					"content": "Setelah semua urusan Perburuan Liar ini beres ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Iya, iya! Bani Bulan Embun sekarang sudah beda, mungkin kamu bakal suka sama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080466,
					"content": "Akan kupikir-pikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080467,
					"content": "Kayaknya dia agak capek ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Mungkin sudah lama dia tidak bicara sebanyak ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "Pokoknya, terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "Ini bukan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080471,
					"content": "Bunga-bunga di sini ... suka pengunjung sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080463,
					"content": "Ayo kita pergi jalan-jalan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}