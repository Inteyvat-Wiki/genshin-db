			"dialogs": [
				{
					"id": 60080101,
					"content": "Kira-kira apa saja yang sudah berubah sejak beberapa hari lalu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "Tidak berubah sebanyak itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Iya, malah kelihatannya makin reda. Lauma emang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "Halo, Lauma! Kami sudah balik nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "Bagaimana kondisi belakangan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Pekerjaan akhirnya jauh lebih rumit dari yang kubayangkan. Mengurus masalah yang sudah menumpuk bukan hal yang mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Kalau dilihat dari kemajuan saat ini, sepertinya masih butuh waktu beberapa minggu lagi. Untungnya, orang-orang yang tinggal di sini juga tidak bingung lagi dan menjadi lebih aktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "Seakan-akan mereka benar-benar menemukan keyakinan mereka sendiri di saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "Semua ini berkat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "Tidak, aku ... harusnya aku melakukan ini lebih awal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "Belakangan ini aku sedang memulihkan tubuhku. Seharusnya aku bisa membantumu menyelidiki masa lalu menggunakan Sumsum Bulan yang sedang kamu jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Terima kasih masih mengingat soal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "Ngomong-ngomong, apa ada info baru tentang bayangan aneh itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "Aku sudah tanya ke beberapa orang, tapi masih belum ada petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "Kalian sendiri bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "Enggak banyak kemajuan sih, tapi kira-kira sekarang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "Aku sudah dapat gambarannya. Berarti pekerjaan kalian tidak akan mudah, jaga diri baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#Kalau begitu, {NICKNAME}, silakan ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "Apa yang kamu lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(Ini ... Nod-Krai? Sepertinya aku pernah lihat pemandangan ini ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Apakah itu ... bintang jatuh?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(Itu ...! Bukan! Itu pesawat kami!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "A-Apa sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Sepertinya hal ini sudah terjadi lama sekali. Aku cuma bisa merasakan ingatan-ingatan yang kacau. Dengan kekuatanku, hanya ini saja yang bisa kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Setidaknya sekarang aku tahu kalau pesawat kami mendarat di Nod-Krai ... spesifiknya, di dekat Pantai Pasir Bintang.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Ini juga sesuai dengan apa yang {M#Lumine}{F#Kak Aether} bilang .... Tapi, aku masih mau tahu lebih banyak lagi ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "Eh? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "Warna bunganya sudah berubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Bunga ini mencerminkan kekuatan The Damselette. Apa ini berarti tubuhnya sudah ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Seingatku, dia pernah bilang ingin menggunakan \"Sumsum Bulan\" untuk memulihkan sebagian kekuatannya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Iya, Paimon ngerti! Ayo kita cari dia dan lihat apa ada yang bisa kita bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Kalau begitu, kuserahkan pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Oh ya, Ini obat yang kamu minta Curatorium of Secrets siapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "Ah, terima kasih sudah jauh-jauh mengantarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "Lalu ... aku rasa sang \"Kuu{RUBY#[S]Gadis Bulan}tar\" mungkin bisa melihat ingatan tentang pesawat luar angkasa milikmu dengan lebih terperinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "Oooh! Benar juga, dia kan Kuutar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Tapi lebih baik kita cek kondisinya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "Sampai ketemu nanti ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
