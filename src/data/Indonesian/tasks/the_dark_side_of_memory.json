			"dialogs": [
				{
					"id": 60080201,
					"content": "Kelihatannya dia enggak baik-baik saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "Ah, maaf mengganggu ya. Kamu baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080204,
					"content": "Apa kondisimu memburuk lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "Pusing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080206,
					"content": "Aku seperti ... kembali ke bulan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080207,
					"content": "Sampai separah itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Ah? Aku bisa merasakan ... kekuatan bulan dari dalam tubuhmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080209,
					"content": "Kamu berhasil mengambil kembali Sumsum Bulan-nya dari para Fatui. Bisa dipakai untuk membantumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Dan ... apa yang kalian inginkan kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080211,
					"content": "Kenapa masih bicara begitu sih? Kesehatanmu lebih penting sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080213,
					"content": "(Apa mungkin dia sudah terbiasa begini ... karena sudah lama hidup di lingkungan yang saling memanfaatkan ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Mungkin nanti kamu bisa bantu aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "Oh, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080216,
					"content": "Ulurkan tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080217,
					"content": "*huff* Aku sudah kembali, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080218,
					"content": "Kan memang dari tadi ada di sini ... ya sudah lah. Sudah enakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Jauh lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080220,
					"content": "Apa yang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "Bulan yang ada di dalam tubuhmu begitu tenang, seperti pantulan di permukaan air yang tenang .... Sungguh luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080223,
					"content": "Yang kuambil hanya secercah sinar bulan di dalam air itu, cukup untuk kembali ke permukaan dunia selama beberapa saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080224,
					"content": "Sepertinya aku merasakan beberapa perubahan lainnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "\"Perkenanan Dewi Bulan\". Semua yang aku sentuh akan mendapatkan tanda itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080226,
					"content": "Tidak berbahaya, akan hilang sendiri setelah beberapa waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080227,
					"content": "Sekarang kan kekuatanmu sudah pulih, apa mau kamu saja yang jaga Sumsum Bulan-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "Ini kan termasuk barang milik \"dewa\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Ini adalah sisa-sisa dari Dewi Bulan Abadi, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080230,
					"content": "Jadi apa hubungannya sam— ... EH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Kalian tidak tahu soal ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080232,
					"content": "Lauma cuma bilang kalau pecahan ini beda dari yang lainnya, dia bisa merasakan kekuatan dewa dari dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Benar apa katanya. Saat aku mengambil cahaya bulan dari Sumsum Bulan itu, aku juga mengambil ingatan di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080234,
					"content": "Ingatan ini yang memberitahuku Sumsum ini berasal dari Dewi Bulan Abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080235,
					"content": "Tapi Lauma juga memakai Sumsum Bulan itu buat melihat ke masa lalu. Kenapa dia enggak bisa lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma bilang kalau dia cuma bisa melihat adegan yang putus-putus dan samar ... Mungkin untuk ini cuma Dewi Bulan saja yang bisa ya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Dulu, di atas langit ada tiga bulan, dan ada tiga dewi yang menguasai masing-masing bulan tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080238,
					"content": "Tetapi setelah Perang Api Pengabuan, ketiga dewi ini sudah tiada, dan dua dari tiga bulan itu hancur dalam peperangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080239,
					"content": "Setelah Aria wafat, kekuatannya pun berkumpul menjadi Sumsum Bulan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080240,
					"content": "Sisa-sisa Bulan Pelangi tidak pernah ditemukan, dan meskipun Dewi Bulan Embun telah wafat, bulannya sendiri tidak hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080241,
					"content": "Seperti yang diramalkan, cepat atau lambat bulan ini akan melahirkan dewa yang baru, yang disebut sebagai \"Kuu{RUBY#[S]Gadis Bulan}tar\" oleh para Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080242,
					"content": "Aku bisa merasakan kalau kekuatanku berasal dari Bulan Embun, tapi kekuatan itu sendiri berada jauh dari luar langit palsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080243,
					"content": "Jangankan \"mengendalikannya\", untuk merasakannya saja sekarang aku harus berusaha sekuat tenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080244,
					"content": "Se-Sebentar, Paimon mau hitungan ... Sumsum-nya Bulan Abadi sudah aman sama kita, lalu yang punya Bulan Pelangi entah ada di mana ... Sumsum Bulan yang Bulan Embun? Ada di kamu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Tidak, Sumsum Bulan hanya bisa terbentuk setelah Dewi Bulan wafat. Anggaplah itu sejenis inti daya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080246,
					"content": "Itu sama saja seperti kamu bertanya apakah ada batu-batuan di bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080247,
					"content": "Oh, jadi maksudnya kamu itu mewakili kekuatan Bulan Embun, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "Betul. Kalau dewa yang memiliki Gnosis disebut Archon ... apa itu berarti siapa pun yang memiliki Sumsum Bulan dapat disebut Dewi Bulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080249,
					"content": "Kurasa bukan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "Kamu tidak ingin jadi Dewi Bulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080251,
					"content": "Bukan itu masalahnya! Kenapa kamu kayak pengin banget kasih julukan itu ke orang lain?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Lupakan dulu deh masalah \"jadi Dewi Bulan\" ini. Pertanyaannya, Sumsum Bulan ini balikin ke kamu jangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Aku tidak menginginkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080254,
					"content": "Boleh diulang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Dan dia juga tidak ingin datang padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080256,
					"content": "Maksudnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Waktu aku bersentuhan dengan kekuatannya, aku merasakan sejenis \"penolakan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080258,
					"content": "Aku kira ini karena aku sendiri juga Dewi Bulan. Dua bulan tidak bisa terbit bersamaan, apalagi saling memangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080259,
					"content": "Kalau begitu sekarang cuma aku yang bisa membawanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "Yakin enggak apa-apa? Lauma bilang sih kamu jago sembunyiin kekuatannya, tapi Damselette bisa langsung merasakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "Dan Perburuan Liar-nya juga lagi enggak normal. Kalau Sumsum Bulannya sampai ketahuan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Kamu seakan-akan menggambarkan fenomena ini seperti seorang manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080263,
					"content": "Yah, soalnya emang kayak ada orang yang merencanakan semuanya, ada tujuan pasti pula! Mereka terus-terusan mengincar Sumsum Bulan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Aku seperti pernah mendengar hal yang serupa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080265,
					"content": "Eh? Yang benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Saat aku masih bersama Fatui, aku pernah dengar rekan-rekanku membicarakan tentang seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080267,
					"content": "Dia datang dari Khaenri'ah dan mendapatkan kekuatan Abyss sewaktu Bencana Khaenri'ah terjadi ... dan dia terobsesi dengan bulan-bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah? Entah bayangan aneh itu ada hubungannya sama Khaenri'ah atau enggak, tapi kayaknya semuanya sudah cocok sih ... siapa namanya tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Aku hanya tahu panggilannya ... \"Rächer of Solnari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080270,
					"content": "Salah satu dari Lima Pendosa?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah, benar, dia juga punya sebutan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080272,
					"content": "Eh?! Tunggu ... Dain pernah bilang soal dia, kan? Itu berarti kita lagi melawan Rerir, salah satu dari Lima Pendosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Tunggu. Kalau begitu harusnya dia lebih kuat dari ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Aku juga pernah dengar kalau dia menghilang tidak lama setelah Bencana Khaenri'ah terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080275,
					"content": "Waktu aku bertanya ke rekan-rekanku tentang keberadaannya, mereka justru membalas, \"Kamu benar-benar tidak tahu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080276,
					"content": "Kenapa mereka bilang begitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Konon katanya pada akhirnya dia terjatuh ke dalam \"bayangan bulan\" dan tidak pernah bisa kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080278,
					"content": "Tunggu, sebentar dulu ... terlalu banyak informasi nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Aku juga merasa begitu. Mereka berpikir kalau seharusnya aku yang lebih tahu segala hal tentang bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080280,
					"content": "Tapi seperti kataku ... bagian \"pembuka\" dari kisahku ada jauh di luar langit palsu. Aku bahkan tidak ingat namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080281,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "Intinya, setelah Rächer of Solnari menghilang, fenomena Perburuan Liar ini semakin memburuk dan dianggap sama seperti bencana Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080283,
					"content": "Fenomena Perburuan Liar saat ini hanya sama namanya saja, tapi skala dan bahayanya jauh melebihi versi terdahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60080284,
					"content": "Duh, enggak sangka kita lagi melawan salah satu dari Lima Pendosa yang legendaris itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Mana sanggup! Berarti kita kebetulan hoki saja waktu di Pantai Pasir Bintang ... atau mungkin dianya yang enggak serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Tapi bahkan ... dia masih bisa kalahin Marionette ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "Atau lebih tepatnya, apa yang kulakukan tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
