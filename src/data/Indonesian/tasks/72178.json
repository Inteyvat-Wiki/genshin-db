					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780105,
					"content": "Aneh... Sepertinya ada orang yang pernah ke sini.",
					"roleType": "TALK_ROLE_NPC",
