						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Kuil ini terlihat bersih, dan terdapat aroma bunga sakura. Mungkin belum lama ini ada seseorang yang berdoa di sini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780205,
					"content": "(Tapi selain itu, tidak ada jejak baru.)",
