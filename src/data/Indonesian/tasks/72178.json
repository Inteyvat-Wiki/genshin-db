						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Lihat, Sakura Bloom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Iya, Chouji pernah bilang kalau ibunya pernah kasih ini ke kuil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Di sini ada segini banyak kelopak bunga... Seharusnya bukan disengaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
