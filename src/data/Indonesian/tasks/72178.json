					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Kuil ini sangat bagus, sepertinya dirawat dengan baik. Orang yang merawatnya pasti sangat telaten.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780104,
					"content": "(Tapi, tidak ada jejak sama sekali.)",
