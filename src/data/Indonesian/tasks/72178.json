						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Kuil ini biasa saja tapi begitu indah. Bangunan kuil yang terbuat dari kayu bersinar mengkilap, seakan menyambut tamu yang datang dengan hormat dan teduh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780405,
					"content": "(Di samping kuil terdapat Sacred Sakura yang bertebaran di tanah, tidak terlihat seperti fenomena alami, namun seperti ada seseorang yang sengaja menaburkan Sakura Bloom di sini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780406,
					"content": "Uhh... Di sini juga tidak ada jejak.",
					"roleType": "TALK_ROLE_NPC",
