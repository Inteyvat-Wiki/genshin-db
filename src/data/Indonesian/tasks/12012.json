			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Yoimiya, gawat sekali! Tadi ada orang Tenryou Commission datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "Eh? Kenapa? Mereka sudah tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Ayah baik-baik saja? Apa mereka melakukan sesuatu pada ayah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "Kubilang saat ada pertunjukan kembang api, ada banyak kembang api di dalam rumah. Kuperingati mereka untuk tidak masuk sembarangan karena risiko terjadi kecelakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "Tapi mereka tidak mau mendengarnya dan mengira Sakujirou bersembunyi di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Untungnya Sakujirou mengetahui kehadiran mereka lebih dulu, lalu melarikan diri dari jendela. Jadinya orang-orang Tenryou Commission tidak menemukan dia di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "Aduh, bagaimana ini... Sakujirou pasti masih bimbang tak bisa memutuskan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Ayah, apa Ayah melihat dia lari ke arah mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "Kurasa orang Tenryou Commission pasti bisa mengejar dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "Kamu ada dengar nama orang Tenryou Commission itu tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Oh ya, nama, nama! Dia menangkapnya dadakan sekali, mungkin saja orang itu adalah Keisuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "Kalau tidak, kesalahan seperti penyelundupan tidak mungkin perlu penangkapan besar-besaran seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Pendengaranku tidak baik, dan penglihatanku juga buruk. Kamu mau tahu ke mana mereka? Mereka sudah keluar dari kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "Kalau nama, aku tidak mendengarnya... *huff* Aku benar-benar tidak mendengarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "Sepertinya aku mendengar namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "Aku baru saja mengambil beberapa bijih besi dari tempat temanku. Waktu mengantarnya ke sini, kebetulan aku menabrak mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "Pemimpinnya sepertinya benar-benar Keisuke yang kalian sebut-sebutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "Ternyata begitu! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "Kalau Sakujirou belum mengambil keputusan, pertemuan mereka berdua tidak akan menyelesaikan masalah dan hanya akan membuat masalah semakin tidak bisa diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#Masalahnya tidak bisa memburuk seperti itu. {NICKNAME}, ikuti aku, kita harus mencari jejak mereka di sepanjang jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
