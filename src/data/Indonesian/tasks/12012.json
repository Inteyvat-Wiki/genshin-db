			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Wah! Kamu Yoimiya kan? Ayo, ayo, sini masuk dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "Apa mereka temanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "Iya, mereka pengembara yang datang dari jauh. Sekarang susah sekali kalau orang luar mau masuk ke Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "Benar, kondisi sekarang lumayan spesial. Tapi karena kalian sudah datang, kita sebagai orang lokal harus menjamu mereka dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Oh ya, sebelum aku lupa, aku juga bawa kembang api yang kalian pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, terima kasih sekali, aku harus merepotkan keluarga kalian terus, dulu ayahmu, sekarang giliranmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Aku tidak tahu apa aku bisa hidup sampai bertemu penerus \"Naganohara Fireworks\" berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Tentu saja bisa, tubuh kalian berdua masih kuat begini, jangan bicara yang tidak-tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "Ah, tubuh ini, sudah tidak seperti dulu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Dulu aku bisa bertani dan memikul air dengan mudah, sekarang baru bergerak sedikit saja pinggangku sudah sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Kemarin aku ingin mencabuti rumput liar, tapi begitu aku membungkuk, rasanya sudah tidak bisa berdiri lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Oh, begitu? Tenang saja, serahkan pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "Ah, jangan, jangan! Kalian jauh-jauh datang kemari, aku tidak mau merepotkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Biar kuambilkan camilan dan teh untuk menemani kita mengobrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Tidak apa, aku kan sudah sering membantu kalian melakukan pekerjaan rumah juga. Belakangan ini aku sibuk dengan kembang apiku, tapi nanti aku akan sering datang ke sini lagi kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Ini hal kecil kok untuk kami, sama sekali tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "Ah, kalian ini benar-benar anak baik, tidak seperti anakku. Padahal umurku sudah tidak muda lagi, tapi dia masih saja belum menikah dan jarang pulang ke rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Kalau begitu, aku sudah membuat beberapa asinan lobak, bisakah kalian membantuku mengantarkan beberapa ke Satoru di desa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Tentu saja, kami akan segera kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Ayo ikut aku. Kaki kakek nenek sudah tidak kuat lagi, jadi kita bantu mereka. Kita <color=#00E1FFFF>potong rumput liar</color> dulu, lalu pergi <color=#00E1FFFF>mengirimkan asinan lobak</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Hai, Satoru, apa belakangan ini sehat-sehat saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Masih sama saja, tidak ada perubahan. Kamu sendiri kelihatannya masih semangat sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Berkat kalian semua, usaha keluargaku jadi semakin membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Kembang api yang dijual ke Liyue waktu itu, kudengar sangat disukai orang-orang, sepertinya pesanan kita akan bertambah lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Berarti kamu dan Ryuunosuke akan semakin sibuk ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Kalau ada pekerjaan yang berat, ingat untuk meminta bantuanku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Tenang sajalah, urusan kembang api itu biar kuselesaikan sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Oh iya, ini ada asinan lobak dari Nyonya Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Oh, terima kasih banyak. Awalnya aku tidak begitu terbiasa makan asinan lobak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Tapi aku jadi menyukainya setelah mencicipi lobak buatannya, sekarang semua keluargaku menyukainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Apa semua anggota keluargamu sehat-sehat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Sehat kok, tapi yah terkadang ada saja yang ribut. Bukankah keluarga memang begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Menurutku, meskipun kadang ada perselisihan di keluarga, tetap lebih baik daripada tidak bertemu sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Meskipun hubungan paman dan bibi sangat baik, tapi kalau anaknya jarang pulang, pasti akan merasa kesepian juga kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Sepertinya tidak juga, mungkin mereka sudah terbiasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Tapi benar juga katamu. Kalau begitu aku akan lebih sering mengunjungi mereka, setidaknya mereka ada teman mengobrol agar tidak bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Bagus sekali, semua orang di desa Konda selalu berharap kamu bisa sering-sering datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Heheh, terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Anak-anak muda memang selalu gesit ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Anak muda punya banyak tenaga, tapi orang tua punya banyak pengetahuan dan pengalaman. Masing-masing punya kelebihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Bicara soal masa muda... Tidak terasa sudah 50 tahun berlalu sejak saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Ya, waktu berlalu begitu cepat. Tanpa disadari 50 tahun berlalu begitu saja dalam sekejap mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "Lima puluh tahun? Apa yang terjadi waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Haha, jika kamu mau tahu, 50 tahun yang lalu, di masa ketika wanita muda ini masih mencoba untuk mengejarku, dia—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Kenapa kamu bilang yang tidak-tidak dengan orang luar... Jelas-jelas kamu yang tergila-gila denganku waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Mari kita sudahi saja topik ini. Singkatnya, di Pertunjukan Kembang Api Naganohara tahun itu, aku melamar wanita tua ini dan kami pun melewati hidup bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Selamat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "Jujur, awalnya aku belum yakin, dan dengan ragu pergi mencari Naganohara untuk membuat kembang api.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Saat kembang api bertebar indah di langit, aku juga masih tidak tahu bagaimana mengatakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Akhirnya saat mendengar suara gemuruh kembang api, sinar kembang api yang menghiasi langit, lalu kulihat wajahnya dari samping... matanya yang memantulkan cahaya kembang api bersinar gemerlapan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "Aku juga tidak tahu apa yang terjadi, saat tersadar aku sudah mengatakannya dan dia juga sudah menyetujuinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "Lima puluh tahun itu bisa dibilang waktu yang panjang, tapi juga waktu yang pendek. Bukan hal yang bisa dibesar-besarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Tapi bisa melewati 50 tahun bersama, memang layak diperingati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "Aku tidak tahu kalau hari ini adalah hari yang spesial dalam lima puluh tahun ini. Kalau aku tahu, aku pasti sudah membuatkanmu kembang api yang istimewa dan mewah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Tidak usah, buatkan saja yang seperti dulu. Setiap kali menonton pertunjukan kembang api aku harus melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Asalkan bisa melihat kembang api, aku pasti akan teringat masa-masa itu. Meskipun sudah semakin tua, aku tidak pernah merasakan adanya penyesalan pada masa laluku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Hubungan mereka harmonis sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Masalah kami tidak usah diungkit dulu, kamu pasti sibuk mengurus Pertunjukan Kembang Api. Ada urusan apa kamu kemari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Oh, sebenarnya ada hal yang agak sulit untuk diceritakan. Biar kujelaskan dulu kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Sakujirou... sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Eh? Kalian kenal dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Dia adalah teman kecil anakku yang paling baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*huff* Dulu mereka selalu bermain bersama. Dari kecil sampai besar, semuanya bisa mereka obrolkan. Mereka berlari dan pergi ke sana kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Ujung-ujungnya, suatu hari mereka bertengkar sangat hebat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Kuingat waktu itu Sakujirou mau merantau untuk melihat dunia luar, dia merasa Inazuma terlalu tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Tapi anakku Keisuke, sama seperti kami, dia merasa tidak ada salahnya kita hidup tenang dan damai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Biasalah, anak-anak memang suka mempertengkarkan siapa yang benar dan yang salah. Dan akhirnya Sakujirou yang marah pun pergi sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Oh, ternyata begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Sejak itu, meski Keisuke tidak pernah mengatakannya kepadaku, tapi terlihat sekali kalau dia sangat terluka. Tapi dia tidak mau mencurahkan isi hatinya kepada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Lalu, entah karena marah atau alasan apa, dia lalu bergabung dengan Tenryou Commission dan jarang pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Untuk masalah lain, kami bisa membantu membicarakannya baik-baik dengan Keisuke. Dia seharusnya akan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Tapi kalau masalah Sakujirou, kurasa... kami tidak bisa ikut campur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Tak disangka bisa kebetulan begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Aku mengerti. Waktu aku tanya Sakujirou kenapa dia pulang, dia juga tidak mengatakannya dengan jelas. Dia hanya mengatakan \"pernah melakukan kesalahan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Aku akhirnya mengerti kenapa dia tidak berani mengambil keputusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Jelas-jelas mereka teman baik di masa kecil. Sekarang yang satunya orang Tenryou Commission, yang satunya lagi buronan Tenryou Commission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Mungkin ini takdir mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Tidak apa-apa, kalau begitu kami tidak akan mengganggu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Kami akan membantu Sakujirou memikirkan solusinya. Kalian tidak perlu memaksakan diri, biar Sakujirou dan Keisuke sendiri saja yang menyelesaikan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Iya, andai saja hubungan mereka bisa sebaik dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Pertengkaran yang sudah terjadi bertahun-tahun lalu, sudah seharusnya dilepaskan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Tak disangka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Bikin iri saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
