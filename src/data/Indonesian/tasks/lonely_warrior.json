							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "Aku akan menuruti kemauanmu, Knight of Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Kamu tidak seperti yang kubayangkan. Tidak segila ingatan yang di dalam Roh Serigala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Aku tidak pernah mengingkari jalan kebenaran. Tapi ketika melihatmu, kesan yang muncul bukanlah seorang pahlawan pembasmi naga. Hanya jiwa tersesat yang sudah berkelana terlalu lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Kalau begitu kita sama. Zaman keemasan kita sudah lama berlalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Rächer of Solnari sudah dikalahkan, dan Roland yang ada di hadapanmu saat ini hanya bayangan tak sempurna yang diciptakan oleh Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Kekuatanku setara dengan puncak kekuatan Roland. Tapi hati dan pikiranku terkunci selamanya di momen bersimbah darah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Maka dari itu, aku yang ada saat ini adalah produk cacat ... seorang knight tidak akan membiarkan dirinya stagnan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Setelah membuatmu bertobat dari ketidakadilan dan membawamu menyerah kepada Abyss, aku akan memperbaiki diri dan terus mengikuti jalan seorang knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Ha, tapi dunia luar sudah muak dengan gangguanmu. Obsesi sinting itu ternyata tidak hilang ya, sesuai dugaan. Tidak ada cara untuk membuatmu sadar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Kata-kata belaka tidak akan pernah bisa membuat knight sejati meragukan keyakinannya, tak peduli seberapa mulia kedengarannya. Kita tidak bisa meyakinkan satu sama lain, dan kamu sudah tahu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Jika tidak, mana mungkin kamu menggantungkan harapan ke satu buah pikiran Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Tapi pedang yang dulu menampung Roh Serigala kini tinggal serpihan, dan yang ada di tanganmu itu hanya bayangan yang wujudnya sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Kamu tidak bisa mengubah situasi, dan tidak akan ada seorang pun yang dapat menolongmu keluar dari sini. Dari kuburanmu yang sepi, wahai pejuang yang kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Yah, kalimat barusan ada benarnya ... kecuali soal pertolongan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Aku cuma perlu membuat satu orang berubah pikiran. Dan orang itu bukan kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Lupa kita ada di mana sekarang? Inilah inti dari Andrius, God of the North Wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Andrius! Apa kamu bisa mendengarku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Bangunlah! Kamu ini kan God of the North Wind yang agung! Mau sampai kapan kamu akan membiarkan dirimu menderita di bawah pengaruh Abyss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "Kalau ini trik pamungkasmu ... mengecewakan sekali, Knight of Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Mengungkapkan harapan tidak akan mendatangkan mukjizat. Dunia ini terlalu kejam kepada para penghuninya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "Kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "... Kembali ke ... Ley Line ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "Pilihanku ... ingatanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "Inikah jawaban yang kutemukan ... di akhir perjalanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Boreas}rius ... Suratmu, aku akan mengirimkannya kembali ke dalam hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Ha, Knight of Boreas? Lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "Hanya inilah yang dapat dilakukan seri{RUBY#[S]aku}gala untuk manu{RUBY#[S]kamu}sia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "Atas nama seluruh umat manusia, aku mengucapkan terima kasih kepada sang Raja Serigala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas ... kembali ke Ley Line? Tapi kenapa? Pedangmu sudah rusak, kamu tidak lagi punya wadah untuk menampung jiwanya ... kecuali ... kecuali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Mengharap ada mukjizat itu sia-sia. Aku tahu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "... Tapi pedang hanyalah salah satu jenis wadah. Masih ada cara lain untuk menyimpan roh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Dominator of Wolves pernah menganugerahkan kekuatan jiwanya kepada kawanannya, memperkuat hati mereka dan mempertajam cakar dan taring mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "... Meskipun itu bukan niatku, jiwa Lupus Boreas pasti pada akhirnya akan menghancurkan, melahap, dan mengasimilasi jantung manusia ... seolah-olah manusia dan serigala dipaksa menyatu menjadi satu makhluk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "... Jika jantung manusia harus menanggung jiwa dewa ... ini adalah jalan yang tidak bisa dilalui kembali. Tapi aku tidak akan mencegah seorang knight untuk memulai perjalanan yang dipilih dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 160110939,
					"content": "Hatimu, jiwamu ...? Ah, aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Kamu penasaran bagaimana caranya seekor domba menjinakkan hati serigala? Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Inilah jawabanku, biarkan serigalanya melahap jantungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "Roh Serigala di dalam pedang itu cuma untuk mengecoh ... pikiran dan ingatan yang asli ada di dalam hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Untuk melenyapkan kecurigaan, kamu membiarkan jiwa Lupus Boreas melahap jiwamu sendiri, lalu memberi diri untuk ditelan olehku ... tapi, kenapa kamu bisa bertarung sambil membawa beban seberat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Dibandingkan dengan tekad Lupus Boreas ... pengorbanan ini tidak ada apa-apanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Kehendak yang kuat dan strategi luar biasa ... tapi seorang knight tidak bertempur dengan cara seperti ini. Pilihanmu keliru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Jiwamu kini menyatu dengan Andrius. Ketika dia akhirnya kembali ke Ley Line, kamu pun akan ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "Barbatos atau pun si Pengembara tidak akan bisa menemukan jiwamu yang ada di dalam Ley Line. Apalagi menolongmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Kamu dan aku, kita sama-sama kalah. Sayang sekali, aku tidak lagi bisa menyelamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "Beristirahatlah dengan tenang bersama Boreas, wahai pejuang yang kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "Hahahah, kesepian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Maaf sudah mengecewakanmu, tapi ... meskipun kedengarannya seperti akhiran yang sempurna, di mana kita berdua kembali ke Ley Line bersama-sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Faktanya adalah—beda dengan Roland yang sebenarnya di masa lalu—aku masih punya anggur berkualitas dan teman baik yang menantikan kepulanganku dengan penuh kemenangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Jadi, aku belum berniat untuk menyerah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ting-tong! Ada surat datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
			"completionStepIds": [
				1601111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
