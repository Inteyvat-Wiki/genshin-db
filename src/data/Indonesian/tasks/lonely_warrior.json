				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Ugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "... Pedangnya masih utuh? Tapi aku tidak merasakan Roh Serigala-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(... Sepertinya aku sudah tidak berada di dunia nyata lagi. Ini pasti ruang yang dibangun dari kesadaran Boreas dan Roland yang saling terkait.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Tidak ada jalan mundur, dan yang ada di depan hanyalah mulut serigala ... hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Ha, tidak ada jalan selain maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
