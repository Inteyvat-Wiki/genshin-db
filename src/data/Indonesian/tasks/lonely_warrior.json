			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
