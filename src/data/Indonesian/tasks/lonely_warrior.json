					}
				]
			},
			"dialogs": [
				{
					"id": 160111101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "... Maju terus, dan jangan pernah melihat ke belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "\"Varka ... sekarang, aku tahu arti dari namaku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "\"... Setelah merepotkan semua orang demi kamu, sebaiknya kamu berterima kasih dengan benar kepada kami semua saat kamu kembali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "\"Kamu tahu, ada banyak hal yang ingin aku beri tahukan padamu ... tapi itu bisa ditunda sampai kamu kembali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "\"Aku tidak berencana untuk kembali bergabung dengan Knights of Favonius ... tapi aku percaya kamu akan menemukan cara untuk mengatasinya sendiri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "\"... Grand Master, kami semua menunggumu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Hmm? ... Oh. Heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Aku ... menjalankan tugasku sebagai Grand Master dengan cukup baik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "... Aku akan menganggap diammu itu sebagai tanda setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Semua yang kalian sumpahkan untuk lindungi dengan nyawa kalian ... semuanya masih di sini, aman dan utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "Knights of Favonius, Mondstadt ... dan sumpah yang dijanjikan oleh setiap knight. Aku akan melindungi mereka semua dengan nyawaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Jadi ... aku akan mengantarkan surat itu untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "... Aku tahu ini hanya bayangan dari Roland yang sebenarnya, tapi ... kalau kamu punya waktu, bisa tolong bacakan ini untuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam dan Arundolyn ... mereka tidak pernah melupakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Wah ... ekspedisi ini sungguh panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "Mulai sekarang, kurasa aku akan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "membiarkan angin yang menuntun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "Hai semuanya. Sudah lama sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Aku ... sangat senang bisa bertemu kalian semua lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Selamat datang kembali, Grand Master.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "Ya. Aku sudah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111123,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111124,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111125,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111126
					],
