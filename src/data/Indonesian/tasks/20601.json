				{
					"id": 206010701,
					"content": "Kamu sudah kembali, Jack juga. Tapi kenapa dia jalannya pincang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010702,
					"content": "Apa yang sudah terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010703,
					"content": "Dia terluka karena tidak berhati-hati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Seperti yang ada di pikiranku. *huff* Dia pasti tidak mendengarkan apa yang selalu aku katakan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "Aku mengerti dia ingin membuktikan dirinya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Sudahlah, aku sudah mengerti apa yang terjadi. Aku akan berbicara dengan Jack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010707,
					"content": "Ini untukkmu, anggap saja sebagai upahmu karena bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
