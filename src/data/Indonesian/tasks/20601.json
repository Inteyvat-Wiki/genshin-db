			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "*arghhh* Sakit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Terima kasih. Aku kira aku tidak akan kembali hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "Bagaimana keadaanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Ha, hanya sedikit... *argh* sakit! Hanya sedikit saja, aku baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Aku menemukan sekelompok Hilichurl berkumpul di perkemahan di depan, dan aku curiga bahwa mereka mungkin merencanakan sesuatu. Jadi aku pun mengikuti mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "... Tapi aku terlalu dekat, dan mereka menyadari keberadaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Tidak perlu khawatir dengan hal itu, atau aku— Tolong bantu untuk menghabisi para Hilichurl itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Jumlah mereka semakin bertambah. Kita tidak bisa membiarkan rencana mereka berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Dan aku... aku akan menjaga diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
