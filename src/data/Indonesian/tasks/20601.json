						206010804
					]
				},
				{
					"id": 206010804,
					"content": "Oh, kamu bertarung bersamanya? Ternyata dia terluka karena itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "*huff* Berani itu baik... tapi aku lebih suka kalau dia bisa lebih stabil. Bagaimanapun, seseorang hanya bisa menjadi petualang kalau dia tetap hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
					],
					"speakerTitle": "Cyrus"
				},
				{
