			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "Kamu sudah membereskan mereka, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "Kamu benar-benar kuat. Kalau saja aku bisa sekuat kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Aku juga ingin tinggal untuk membantai naga dan menyelamatkan dunia seperti dalam cerita legenda, tapi mengalahkan sekelompok Hilichurl saja aku tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Ugh... Itu, aku... Meskipun tidak enak, tapi ada hal sesuatu yang ingin kutanyakan padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Sebenarnya aku datang ke Thousand Winds Temple karena aku akan segera mengikuti tes peringkat petualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Aku pikir peringkatku akan naik dengan mudah kalau aku bisa menunjukkan kemampuanku kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Tapi aku tidak mengira bahwa tidak ada yang bisa kutunjukkan, bahkan aku hampir kehilangan nyawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "Bi-bisakah kamu tidak memberi tahu Cyrus tentang hal ini? Aku pasti akan gawat kalau hal ini sampai memengaruhi peringkatku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Baik, aku mengerti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Benar-benar terima kasih! Aku janji lain kali aku tidak akan ceroboh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Seperti itu tidak baik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Aku tahu itu bukan hal yang baik, dan Cyrus selalu mengatakan bahwa seorang petualang harus jujur dengan dirinya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Tapi... *huff* lupakan saja. Aku hanya bisa berharap dia tidak marah besar padaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
