					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "Oh, ternyata kamu, manis! Ada apa nih? Tumben ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Apa kamu ke sini mau ke perpustakaan? Atau mungkin, kamu mau mengunjungi seseorang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Mau ketemu kamu dong pastinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Hehe, perhatian banget sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Duh, tapi sayang sekali ... Kebetulan aku lagi ngerjain hal penting. Nanti kapan-kapan aku traktir kamu minum teh bareng ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Tunggu, kamu betulan sibuk ... kerja? Tumben banget nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Haha, iya kamu benar. Terakhir kali aku sesibuk ini waktu meneliti di Akademiya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Sejak itu aku tidak pernah berpikir keras begini lagi, duh capek juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Kamu nulis skripsi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Hehe, kalau kamu tertarik begitu, gimana kalau kamu ikutan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Gimana? Mau bantu aku mengenang masa-masa sekolah bersama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "WOI! Enggak sopan ya ngasih kerjaan ke orang lain gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Kalau gitu kamu menolak aku ya, {NICKNAME}? Padahal jarang-jarang loh bisa kerja bareng aku ... Terus kamu pastinya bakal dapat imbalan juga loh. Tapi kalau kamu tidak mau sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Oke, aku siap dengarkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Jadi seperti yang kamu tahu, Knights of Favonius sudah lama melakukan penelitian alkimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Tapi sebagian besar dari penelitian itu dilakukan di laboratorium. Jadi pengetahuan orang-orang soal alkimia masih minim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Jadi artinya sampai sekarang, sebagian besar dari penelitian dan penemuan kami efeknya masih minim di kehidupan orang-orang. Kami sudah menghabiskan banyak Mora buat penelitian ini, tapi hasilnya masih begini-begini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Akhirnya, Jean memutuskan untuk mempromosikan alkimia kepada orang-orang. Untuk sekarang ini, kami mulai dari memperkenalkan berbagai ramuan alkimia dulu ke orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Dan kebetulan aku punya pengalaman di bidang ini. Walaupun biasanya aku kerja di perpustakaan, tapi dulu aku juga pernah bantu-bantu di bagian pasokan ramuan untuk Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Terus kebetulan ilmu soal ramuan juga salah satu bidang penelitianku waktu dulu, jadi Jean berpikir aku orang yang tepat buat dikasih kerjaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Tapi, untuk membuat ramuan yang cukup praktis untuk kebutuhan sehari-hari orang-orang itu perlu banyak pengaturan dan harus pakai bahan-bahan yang biasa kita gunakan juga, jadi secara keseluruhan prosesnya juga harus disederhanakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Intinya, yang tadinya cuma proyek penelitian sederhana malah jadi ribet gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "Jadi, kamu mau minta kami bantu kamu sama penelitianmu ya? Tapi, kami enggak jago soal neliti alkimia gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Hehe, jangan khawatir. Aku sudah memikirkan kerjaan yang paling pas buat kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Alkimia sekarang kan sudah semakin maju, tapi masih tidak banyak diketahui banyak orang. Nah yang harus kita lakukan cuma mengumpulkan masukan dari orang-orang. Jadi kita tahu mereka puas apa tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Tapi kalau kita mau melakukan penelitian dan mengumpulkan masukan di saat bersamaan, kita harus pakai cara yang lebih efisien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Jadi aku berpikir buat buka toko ramuan! Dengan begitu, kita bisa terus bikin ramuan sekaligus tahu apa saja yang dibutuhkan orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Oh! Jadi kayak sekali dayung dua tiga pulau terlampaui gitu ya! Pintar juga kamu, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Yah iya dong! Nah siapa lagi yang cocok buat kerjaan ini selain kesatria paling berprestasi ... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Waktu aku di Akademiya, para murid sudah biasa saling bantu proyek penelitian masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Aku yakin si manisku ini tidak akan melewatkan kesempatan untuk merasakan gairah hidup yang penuh gelora masa muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Kamu ngomongnya seolah ini menarik gitu ya, tapi Paimon yakin kamu sebenarnya cuma mau malas-malasan doang kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Yah anggap saja bantuin Lisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Hehe, aku tahu kamu paling bisa diandalkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "Kalau sudah selesai semua pasti bakal dikasih imbalan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Persiapannya semua sudah oke, jadi langsung saja kita ke toko. Kita lanjut diskusi di sana saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "Oke aku terima tantangan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Hah, aku suka semangatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Hmm, coba dengar dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Kamu lagi ada proyek penelitian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Kami cuma lewat kok ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "Terus sekalian mampir buat ngobrol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
