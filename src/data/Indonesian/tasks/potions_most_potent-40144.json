				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "Ini tokonya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Wow! Kamu betulan sudah siapin semua ya! Kamu lakuin ini semua sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "Ini kerja keras semua orang. Banyak kesatria yang datang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean sendiri yang menyiapkan dana untuk tokonya. Albedo dan Sucrose menyiapkan bahan-bahan dan peralatan yang dibutuhkan untuk meracik ramuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "Terus Divisi Logistik yang bertanggung jawab sama suplainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Nah sekarang ditambah bantuanmu, akhirnya beban ini terangkat juga dari pundakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Beberapa hari ini para kesatria sudah terus-terusan promosi soal toko kami. Jadi, kalau persiapan akhirnya sudah siap, sudah bisa langsung buka toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Oke, jangan buat yang lain menunggu. Coba sekarang kamu bikin ramuannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
