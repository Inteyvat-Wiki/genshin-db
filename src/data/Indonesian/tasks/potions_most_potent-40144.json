			"dialogs": [
				{
					"id": 401440701,
					"content": "#Halo, Honorary Knight! Halo, Paimon! Namaku Freda. Aku kesatria dari Divisi Logistik. Sungguh sebuah kehormatan bagiku dapat bertemu langsung dengan {NICKNAME} yang sohor dan pelayannya yang setia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "Wow, ketenaran Paimon akhirnya tersebar ke pelosok dunia, hehe! Cuma Paimon mau koreksi sedikit ya, Paimon ini temannya, bukan pelayannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Ah, maaf. Aku jadi terbawa suasana setelah mendengar sepak terjang kalian. Kalian ini benar-benar seperti tokoh-tokoh di novel deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Kalian ini sudah jadi legenda loh. Benar-benar membuat iri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "Aku juga mau bertualang menjelajahi berbagai bangsa sama seperti para kesatria yang ada di buku cerita! Kedengarannya menarik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Siapa tahu suatu hari nanti kamu berkesempatan begitu juga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Iya! Harapanku juga gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Ya sudah jadi sekarang lebih baik kita selesaikan kerjaan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "Perintah dari Grand Master adalah untuk mendukung bisnis kalian sebisaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Kalau ada yang kalian butuhkan, langsung bilang padaku saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Tentang pembelian suplai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Beruntung banget! Baru-baru ini aku dapat batch baru buat suplai! Silakan lihat saja apa yang kamu butuhkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "Semoga bisnisnya lancar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "Sebenarnya tidak semenarik itu juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Iya juga ya. Para kesatria di cerita itu juga kan selalu berhadapan dengan mara bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
