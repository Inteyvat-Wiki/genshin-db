			"dialogs": [
				{
					"id": 401440601,
					"content": "Oke kayaknya kamu mulai paham ya soal budi daya ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Oh ya aku harus ingatkan, kesatria dari Divisi Logistik sudah tiba. Dia yang bakal tangani urusan suplaimu ke depannya ya. Coba kamu ngobrol sama dia langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "Sudah deh, sisanya bebas terserah kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "Tunggu, terus kamu ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "Iya! Bukannya kita harusnya ngerjain ini sama-sama? Kita bertiga, kan? Terus kamu ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "Aku? Ya tentunya memastikan kalau manis-manisku ini sudah punya pengetahuan mumpuni soal alkimia dan bisnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Oke, aku mengandalkanmu ya! Semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon sudah menduga ujungnya pasti gini ....",
