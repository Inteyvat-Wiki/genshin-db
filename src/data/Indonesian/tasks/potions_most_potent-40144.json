			"dialogs": [
				{
					"id": 401440401,
					"content": "Ooh, kayaknya lancar nih. Kamu sudah menjual batch pertama ramuanmu. Boleh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Terus soal ramuan selanjutnya yang harus diracik, hmm coba kita cek dulu berita yang ada di pasaran saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Artinya kamu harus tahu juga berita-berita terbaru dan tren yang ada sekarang. Ini kemampuan yang penting kalau mau menjalankan bisnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Eh, kok kedengarannya susah ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Hehe ... Jangan khawatir. Aku sudah kompilasi berbagai berita terbaru di pasaran untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Gimana? Sudah kepikiran belum ramuan apa berikutnya yang mau dijual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Ayo coba budidayakan beberapa tanaman obat. Proses bio-alkimia bisa menggabungkan beberapa tanaman obat dengan efek yang berbeda-beda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Efek ramuan yang dihasilkan juga bakal beda tergantung ramuan berbagai tanaman obat yang dipakai waktu meraciknya. Banyak kombinasi yang bisa dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Baiklah, manis. Coba mulai deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
