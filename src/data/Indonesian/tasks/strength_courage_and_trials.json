			"dialogs": [
				{
					"id": 706940101,
					"content": "Nona Bold-Bang, pinggangmu masih sakit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940102,
					"content": "Sekarang sudah enggak apa-apa ... kompres hangat memang paling manjur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940103,
					"content": "Hehe, pakai bubuk mesiu pelan untuk panaskan perban basah, waktunya harus tepat ya, kalau tidak perbannya bisa terbakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940104,
					"content": "Cuma Yoimiya yang bisa kepikiran cara menghangatkan perban kayak gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940105,
					"content": "Tunggu ... lihat tuh siapa yang datang! Pahlawan besar yang sesungguhnya dan Asisten Putihnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940106,
					"content": "Apa adegan dari komik gulungan tenun akan terjadi di depan mataku ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940107,
					"content": "Kalian lagi ngobatin luka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "Enggak apa-apa! Aku cuma jalan-jalan di luar, lalu cari beberapa musuh yang belum pernah aku lawan buat latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940110,
					"content": "Justru Nona Yoimiya yang sangat membantu saat pinggangku tidak sengaja keseleo dan menggelinding seperti bola salju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940111,
					"content": "Aduh ... kedengarannya sakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940112,
					"content": "Haha, seperti yang dikatakan dalam Kisah Pertarungan Soulblazer, \"Aku cuma seorang prajurit yang kebetulan lewat saja\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940113,
					"content": "Dan aku ini prajurit bayaran yang bebas! Knights of Favonius sudah kasih izin, jadi aku bisa melawan monster sesukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940114,
					"content": "Kedengarannya masih ada monster yang berkeliaran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "Kayaknya agak gawat nih .... Apa kita perlu manggil Knights of Favonius buat minta bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940117,
					"content": "Memang tidak bisa santai, tapi situasinya juga tidak terlalu mendesak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940118,
					"content": "Para ahli dari Knights of Favonius sudah bersihin monster di sekitar area Kontes Lari Antar Bangsa, yang tersisa cuma monster yang berkeliaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940119,
					"content": "Dan jujur saja, di antara para peserta kontes lari ini, ada juga petualang yang punya kemampuan bertarung yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940120,
					"content": "Mereka punya fisik yang kuat dan keberanian. Kalau kita minta mereka untuk berhati-hati terhadap monster seperti orang normal, mereka malah merasa diremehin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940121,
					"content": "Jadi, sesuai dengan kebiasaan Adventurers' Guild, kami membentuk tim di tempat dan menjadikan penanganan monster-monster ini sebagai ujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940122,
					"content": "Itulah sebuah \"Tantangan Keberanian\", selain membasmi monster, kita juga akan meniru gaya bertarung para pahlawan dan melampaui batas kemampuan kita sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "Bold Bang Bouldern"
				},
				{
					"id": 706940123,
					"content": "Nah, ini baru gaya khas Berlimpah Jaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940124,
					"content": "Kalau begitu aku mau ikut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#Asyik! Sudah lama tidak lihat {NICKNAME} beraksi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940127,
					"content": "Aku tidak sabar, sekarang kemampuanmu ... sudah seindah kembang api apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940125,
					"content": "Aku juga enggak mau ketinggalan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "Kita harus hati-hati, masih ada warga sipil di sekitar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "Baru selesai bertarung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}