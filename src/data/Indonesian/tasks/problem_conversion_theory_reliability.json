			"dialogs": [
				{
					"id": 230200501,
					"content": "Oh! Terima kasih, Pengembara. Ini imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Tapi, material ini ternyata sangat berat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Aku akan usahakan untuk mulai membangunnya lebih cepat. Kapal kecil ini harusnya tidak perlu waktu yang terlalu lama, seharusnya tidak lama lagi bisa dicoba di air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "Kamu harus menyiapkan alat keselamatan saat waktunya tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Aduh, tidak masalah, pasti tidak masalah, percaya padaku.",
					"roleType": "TALK_ROLE_NPC",
