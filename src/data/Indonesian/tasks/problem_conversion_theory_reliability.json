				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "Aku merasa material di bagian ini tidak boleh dihemat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Tenang, bagian ini pasti kuat, aku sudah menghitungnya berulang kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Uhh, sudah dibilang ada banyak masalah yang tidak bisa diperhitungkan seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Apa yang sedang kalian ributkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Oh kamu, kami sedang diskusi mengenai masalah desain kapal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Aku sudah memperhitungkan semuanya dengan baik dan menjamin kekuatan setiap bagian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Tapi Qishan bersikeras bilang kekuatan dari beberapa bagian itu belum tentu aman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "\"Kekuatan\" yang kamu bilang itu cuma sebatas teori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "Kekuatan yang harus ditahan kapal saat berada di air pasti jauh lebih besar daripada perhitungan angka ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Aku paham logikanya ... tapi, uangku terbatas ... dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Kalau mau pakai material yang lebih mahal, aku paling cuma bisa menyelesaikan bagian haluan kapal ... *uhuk*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "Intinya! Ikuti saja sesuai arahanku sekarang, materialnya juga sudah kubeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "Pengembara, kalau bersedia, apa boleh bantu aku pindahkan sebagian bahan dulu? Aku tidak bisa pindahkan semua ini sendirian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Kalau begitu kuserahkan padamu ya, aku masih harus hitung barang. Kalau sudah selesai, nanti baru kupindahkan sisanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan tahu caranya buat kapal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Tentu, dalam perhitungan beberapa bagian, dia bahkan lebih cepat dibandingku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Aku benar-benar tidak tahu kenapa dia mau jadi pelayan di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
