			"dialogs": [
				{
					"id": 401300801,
					"content": "Hei, Freminet! Thelxie! Kami datang nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300802,
					"content": "#Halo, Paimon. Halo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300804,
					"content": "Mahkotanya sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300805,
					"content": "Iya, kita tinggal tunggu Madam Zuria sekarang. Dia masih belum datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300806,
					"content": "Kalau gitu kita tunggu dia dulu sebentar! Atau mungkin kita bisa cari dia? Toh dari sini enggak jauh juga. Dia bilang dia tinggal di bukit sebelah sana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300807,
					"content": "#Ah! {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300808,
					"content": "Hehe, ngomong-ngomong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300809,
					"content": "Akhirnya kalian berdua ketemu juga ... Aku senang kalian berdua baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300810,
					"content": "Hah? Kenapa kamu ada di sini, Nona Delaroche? Terus memangnya kami kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300811,
					"content": "Kenapa katamu? Si siluman air Thelxie itu lah jelas! Setelah aku memberi komisi itu ke kalian, aku mulai khawatir terus aku jadi tanya-tanya soal anak yang hilang itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300812,
					"content": "Oh? Iya sekarang kita sudah tahu jelas! Anak yang kamu dengar itu Freminet. Ikan yang hilang itu juga salahnya. Tenang, kami bakal bantu kamu nyari ikannya kalau sudah selesai di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300813,
					"content": "Maaf ya, akhir-akhir ini aku memang menyelam di sini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300814,
					"content": "Hah? Freminet? Menyelam? Bukan, bukan ... bukan itu yang terjadi. Aku dengar cerita yang beda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300815,
					"content": "Yang kudengar nih ya sekitar sebulan lalu, ada anak yang mengikatkan banyak sekali kerang ke tubuhnya dan berjalan ke laut. Dan dia tidak pernah kembali lagi ... kalau bukan kerjaan siluman air, apa lagi coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300816,
					"content": "Hah? Kamu ... yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300817,
					"content": "Seratus persen yakin! Aku sudah konfirmasi dengan beberapa nelayan veteran juga. Anak itu berumur 8 tahun ... Namanya Lescot. Lescot Destree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300818,
					"content": "Tunggu ... Lescot Destree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300819,
					"content": "Iya, itu namanya! Mereka bilang keluarganya kasih dia nama itu setelah pindah dari tempat bernama Destree ke kota. Ibunya itu pedagang lukisan yang terkenal, dan ayahnya sudah lama meninggal karena kecelakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300820,
					"content": "*huff* Ibunya depresi berat karena kecelakaan itu lalu jatuh sakit. Katanya dia meninggalkan Court of Fontaine, tidak ada yang tahu ke mana perginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300821,
					"content": "Yang benar ...? Lescot Destree ... Zuria Destree ... pasti kebetulan ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300822,
					"content": "Ayo kita ke rumah keluarga Destree.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "Maaf, Nona! Kami harus cek sesuatu dulu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300824,
					"content": "Oh, baiklah ... silakan. Aku cuma datang buat memastikan kalau kalian baik-baik saja. Aku balik dulu deh ... Hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
