			"dialogs": [
				{
					"id": 401300601,
					"content": "Maaf ... aku harus pergi, aku sudah janji dengan teman-teman, dan ini sudah terlambat sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300602
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300602,
					"content": "Madam, Anda masih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300603
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300603,
					"content": "Jangan menghalangi! Ini hari paling penting untuk mengobati Thelxie! Kita pakai terapi bimbingan. Kan kamu juga yang bilang itu mungkin berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300604,
					"content": "Aku bukan ingin menghalangi Anda, Madam. Tapi ... boleh beri tahu aku siapa nama putra Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300605
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300605,
					"content": "Dokter Jalacan, masa bisa lupa sama nama pasien sendiri? Namanya Thelxie, pangeran Kerajaan Siluman Air! Kami harus rebut kembali mahkotanya hari ini, dan harus hadir di upacara pemahkotaannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300606
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300606,
					"content": "Begitu ya ... Madam tenang saja, semuanya masih berjalan lancar. Teman-teman Anda sudah berangkat untuk mencari ... Ah! Itu mereka sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300607
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300607,
					"content": "Madam Zuria! Mahkotanya sudah berhasil direbut kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300608,
					"content": "Ah. Paimon, kalian ... sungguh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300609
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300609,
					"content": "Ya, tapi upacaranya belum digelar. Karena kami pikir Madam harus hadir dan memimpinnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300610,
					"content": "Bagus, bagus sekali! Thelxie, Nak ... kamu dengar kan? Semua yang hilang akan kembali, dan kamu akan ... sebentar lagi, kamu tidak akan kesepian lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300611,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300612
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300612,
					"content": "Dan halaman terakhir bukunya ... masih harus digambar dan diwarnai. Olehmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300613
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300613,
					"content": "Ya, buku gambar. Tapi aku tidak tahu harus gambar apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300614
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300614,
					"content": "Tenang, Thelxie dan teman-temannya tahu kok! Siap-siap, Madam Zuria! Kami akan jelasin semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300615,
					"content": "Oke ... oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300616
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300616,
					"content": "Ehem ... Akhirnya, Thelxie dan kawan-kawan berhasil mengusir monster dan meraih kejayaan. Sukses besar. Mahkota yang agung pun kembali dengan aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300617,
					"content": "Para Siluman Air akhirnya bisa pulang, dan mereka mengasihi sang pangeran, memandikannya dengan tepuk tangan serta sorak sorai. Mereka memberikan cangkang kerang paling indah untuknya, serta membangun kembali jembatan pelangi yang indah. Pangeran pun tersentuh melihat semua yang sedang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300618
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300618,
					"content": "#Tergerak oleh suasana yang penuh kebahagiaan, Pangeran pun melangkah ke jembatan pelangi, memandang ke arah semua rekan yang telah menemaninya sepanjang perjalanan. {NICKNAME}, Dewi Paimon, Freminet, dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300619,
					"content": "Hmm? Ke mana orang terakhir? Sang pangeran melihat ke sekeliling, namun tidak menemukan sosok yang paling ingin dia lihat. Ketika itu, sosok yang dinantikan tiba-tiba muncul di seberang jembatan. Dia berjalan dengan tersenyum sambil membuka tudung kepalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300620,
					"content": "Pangeran tak kuasa menahan air mata. Dia mengenali sosok itu, sosok yang selama ini setia menemaninya ... sosok ibundanya tercinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300621
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300621,
					"content": "Madam Zuria menyeberangi jembatan dan memahkotai sang pangeran. Dia tersenyum seraya berkata, \"Pangeranku sayang, raja yang baru ... kamu tidak akan pernah, tidak akan pernah lagi merasa kesepian.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300622
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300622,
					"content": "Demikianlah kisah ini berakhir, Madam Zuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300623,
					"content": "Terima kasih ... terima kasih semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300624
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300624,
					"content": "Nak, maafkan mama ... yang lalai dan tidak cukup menemani di sisimu ... kamu sudah dengar kan ceritanya? Kamu tidak akan pernah lagi merasa sepi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300625
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300625,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300626
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300626,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300627
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300627,
					"content": "Mhm! Mama juga sayang kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300628
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300628,
					"content": "Ke-Kenapa ini? Madam Zuria ngomong sama ... Thelxie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300629,
					"content": "Thelxie ngomong apa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300630
					]
				},
				{
					"id": 401300630,
					"content": "Cepat, pakai helmku! Ada modul transkrip yang bisa menerima sinyal Thelxie. Kamu bisa paham omongan Thelxie kalau pakai helm itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300631
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300699,
					"content": "Freminet berjalan ke arahmu, membuka helm menyelamnya, lalu memakaikannya di kepalamu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401300631,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300632
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300632,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300633
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300633,
					"content": "Aku sayang mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300634
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300634,
					"content": "Jadi itu ya yang dibilang Thelxie ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300635
					]
				},
				{
					"id": 401300635,
					"content": "Mama ... Mama juga menyayangimu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300636
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300636,
					"content": "Tapi aku lebih sayang Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300637
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300637,
					"content": "Tunggu, apaan nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300638
					]
				},
				{
					"id": 401300638,
					"content": "Apa? Kamu lihat sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300639
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300639,
					"content": "Mama, aku agak ngantuk ... Sudah waktunya tidur, apa mama bisa nyanyiin lagu nina bobo untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300640
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300640,
					"content": "Boleh dong, sayang ... Mama akan terus menyanyikannya selama yang kamu mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300641
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300641,
					"content": "♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300642
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300642,
					"content": "Makasih, Mama! Aku suka banget sama lagu nina bobo Mama. Sekarang, aku bisa balik ke mimpiku, terus balik ke Kerajaan Siluman Air deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300643
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300643,
					"content": "Ah, sayang ... Jangan lupa, Mama akan selalu menyayangimu. Rasa sayang Mama ... lebih besar dari jarak tempat ini ke Kerajaan Siluman Air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300644
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300644,
					"content": "Aku pasti ingat, Mama ... Aku juga sayaaang Mama ... lebih besar dari jarak tempat ini ke Kerajaan Siluman Air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300645
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300645,
					"content": "Selamat bobo, Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lescot Destree"
				}
			]
		},
		{
			"id": 4013007,
