					}
				]
			},
			"dialogs": [
				{
					"id": 401300646,
					"content": "Tiga hari kemudian, di kemah Freminet ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300647
					]
				},
				{
					"id": 401300647,
					"content": "#{NICKNAME}, Paimon ... Kalian sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300648
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300648,
					"content": "Freminet! Kenapa tiba-tiba manggil? Kamu dapat kabar dari Madam Zuria? Paimon ogah dengar kalau beritanya buruk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300649,
					"content": "Jangan khawatir, ini kabar baik kok. Madam tadi mampir ke sini sama dokternya. Pipinya terlihat lebih merona, dan dia juga lebih bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300650
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300650,
					"content": "Dia bilang mau kembali ke kota untuk melanjutkan pameran seni, tapi kali ini dia bakal kerja sama dengan dokter untuk menampilkan buku gambar terkait penyakit kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300651
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300651,
					"content": "Pastinya Petualangan Fantastis Thelxie dan panduan terapinya juga bakal dimasukkan ke dalam pameran itu. Dia mau menggunakan pengalamannya itu untuk membantu orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300652
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300652,
					"content": "Oh bagus deh! Fyuh, jadi bukan kabar buruk ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300653,
					"content": "Mhm. Nih, ambil foto ini. Madam mau kalian simpan gambar ini. Kalau di masa depan kalian menemui masalah serupa, dia harap buku ini bisa berguna untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300654
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300654,
					"content": "Eh? Tapi ini kan cerita tentang anaknya? Yakin enggak apa-apa ini buku dikasih ke kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300655,
					"content": "Tenang, ini cuma kopian. Dia punya buku aslinya. Buku itu penting sekali baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300656
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300656,
					"content": "Oke deh, kalau gitu enggak masalah! Hehe, rasanya senang ya kalau tahu kita ada kontribusi di hal berguna. Paimon betulan enggak sangka petualangan fantasi bisa berguna ... Paimon agak khawatir sih sama hasilnya. Toh gimanapun juga kan cuma cerita fantasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300657
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300657,
					"content": "Paimon, mau tahu apa yang Madam bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300658
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300658,
					"content": "Dia bilang ... saat dia meletakkan mahkota di kepala Thelxie, dia melihat sesuatu yang sangat indah. Anaknya telah kembali, dan anak itu bilang dia menyayangi Madam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300659
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300659,
					"content": "Madam juga bilang itulah saat dia bisa mengucapkan selamat tinggal pada anaknya. Dia merasa pada saat itulah, dia merasa sembuh berkat sebuah kekuatan magis, dan dia dipenuhi keberanian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300660
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300660,
					"content": "Oh?! Serius?! Tapi mungkin itu juga cuma bagian dari fantasinya saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300661,
					"content": "Ya mungkin, tapi kalau fantasi hanya sekadar fantasi, dan dunia fantasi itu tidak nyata, maka mana mungkin dia bisa memberikan kita kekuatan yang masih bisa kita gunakan di dunia nyata ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300662
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300662,
					"content": "Jadi ... mungkin ini bukan cuma fantasi belaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300663
					]
				},
				{
					"id": 401300663,
					"content": "Ta-Tapi kalau bukan fantasi terus apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300664,
					"content": "Dunia dongeng yang memasuki dunia nyata. Pada saat itu, dongeng yang luar biasa itu menjadi kenyataan, dan terpengaruh oleh hal-hal nyata di dunia kita. Itulah yang terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300665
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300665,
					"content": "Kamu juga lihat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300666
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300666,
					"content": "Tapi masa begitu sih? Enggak mungkin ah! Kalau gitu sih namanya keajaiban dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300667
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300667,
					"content": "Iya ... kurasa itu yang disebut dengan keajaiban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300668
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300668,
					"content": "Aku harap semua orang yang kini merasa berada di tempat gelap bisa melihat sesuatu yang indah, dan mengalami keajaiban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
