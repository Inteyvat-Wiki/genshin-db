				]
			},
			"dialogs": [
				{
					"id": 401300501,
					"content": "Kita ke sini lagi ya ... tahap akhir perjalanan Thelxie, tapi orang yang paling pentingnya enggak bisa hadir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300502,
					"content": "-.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300503
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300503,
					"content": "Semuanya ... tolong jangan muram begitu. Ingat kan dia bilang apa dulu? Kalau kita sedih, pasien juga akan ikut sedih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300504
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300504,
					"content": "Ah, benar juga. Paimon harus senyum! Kalau mau kasih sesuatu ke Madam Zuria, kita bisa mulai dari senyuman! Senyum terus sampai petualangannya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300505,
					"content": "Terus dia pasti bisa pulih, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300506,
