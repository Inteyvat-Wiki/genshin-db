			"dialogs": [
				{
					"id": 766750501,
					"content": "Mau minta tolong urus tong-tong ini, atau cuma mau ngobrol sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750502,
						766750504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750502,
					"content": "Tolong atur ulang posisinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "Oke! Jangan menyerah dan coba lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750504,
					"content": "Ayo kita ngobrol bentar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "Waktu aku melatih Noelle, dia langsung menghancurkan tong sampai berkeping-keping karena gugup. Setelah itu, dia tidak berhenti bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750506,
					"content": "Lama-kelamaan ... dia jadi tukang bersih-bersih tiada duanya di Knights of Favonius. Ha, mungkin dia tidak sadar, tapi itu juga termasuk kemajuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
