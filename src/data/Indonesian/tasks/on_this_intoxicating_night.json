					}
				]
			},
			"dialogs": [
				{
					"id": 766750401,
					"content": "Hei, kamu enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "A-Aman ... Fiuh, untung kalian datangnya cepat, kalau tidak aku mungkin tidak akan sampai sebelum matahari terbenam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "Syukurlah! \"Perbekalan penting\" kita sampai dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Uh ... barang apa ya? Sepenting itu kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "Alkohol. Iris telingaku kalau salah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Hehe, tahu saja! Ini Dandelion Wine yang kami khusus pesan dari Dawn Winery. Intisari Mondstadt dalam satu botol kenikmatan duniawi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "Kamu tidak tahu betapa sulitnya logistik buat bawa ini dari sana sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Hah, kerja bagus, bos! Malam ini ikut minum loh ya. Semua orang sudah tidak sabar ingin bersulang sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "Jadi ... alasan kamu buru-buru cuma mau pastiin minumannya sampai tepat waktu? Paimon tadi sempat kira urusannya serius, dan kamu akhirnya serius ngurusin yang serius ... seriusan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "Apa? Kamu kira minuman ini bukan urusan serius yang perlu diseriusin? Astaga, salah besar. Rasanya jadi ingin minum. Sekarang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "Tu-Tunggu! Mohon jangan dulu! Jangan sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "Ya, dengarkan dia dong! Setidaknya selesaikan dulu yang seriusnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "Anggur ini racikan khusus, harus terus diaduk supaya tidak mengendap dan rasanya tetap terjaga! Tapi karena lama tidak diaduk, kurasa kualitas rasanya sudah turun ... setidaknya sepuluh persen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Sepuluh persen?! Gawat. Baik, dilarang menyentuh botol ini sampai isinya siap diminum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "Ooooke deh. Suka-sukamu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "Jadi gimana? Rasanya bisa dibalikin ke asli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "Kami sudah minta orang buatkan suatu mekanisme agar tong-tong ini terus berputar ... Tapi sepertinya rusak waktu jatuh tadi. Maka sekarang, terpaksa pakai cara lama. Otot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Hmm, jadi tinggal <color=#00E1FFFF>gebuk terus tongnya dan gelindingkan sampai ke tujuan</color> ...? Kedengarannya seperti latihan kekuatan klasik ala Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Wah, anggota Knights of Favonius disuruh latihan kayak gitu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Ya, melatih kontrol tenaga supaya presisi. Kalau tidak, tongnya tidak bakal lurus, pasti keluar jalur. Ini latihan dasar buat anggota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Aku jadi penasaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "Hah, tertarik dengan latihan dasar rupanya? Sepertinya Laurent dan yang lainnya juga tidak akan kembali dalam waktu dekat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "Baiklah, silakan. Santai saja kalau sampai mukulnya kejauhan. Nanti panggil aku saja, biar aku yang mengembalikannya ke tempat semula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "Sebagai Honorary Knight, aku mau coba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Hmm, baunya kayak kenal nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
