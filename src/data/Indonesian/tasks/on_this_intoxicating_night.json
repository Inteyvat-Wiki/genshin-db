			"dialogs": [
				{
					"id": 766750101,
					"content": "Nannina menjaga bagian utara, sementara untuk bagian timur Laurent ... Baiklah, itu saja untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750102,
					"content": "Hei Varka~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750103,
					"content": "Hah? Honorary Knight dan Paimon? Ada angin apa datang ke kemahku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750104,
						766750105
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750104,
					"content": "Jalan-jalan, kebetulan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				},
				{
					"id": 766750106,
					"content": "Tentu saja tidak! Semua perkemahan Knights of Favonius itu kemahnya kamu juga, anggap saja ini rumah sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750107
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750107,
					"content": "Lain kali kabari dulu kalau mau datang, biar aku bisa minta petugas siapkan makan minum yahud buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750108,
					"content": "Ini beneran perkemahan pasukan ekspedisi? Paimon kira bakal lebih ... ramai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750109,
					"content": "Pasukan yang bertugas di sini tidak banyak, dan dari yang tidak banyak itu, kebanyakan lagi pada patroli. Yah ... hahaha, di sini memang krik-krik-krik sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750110,
					"content": "Yang tersisa di sini tugasnya ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750111
					]
				},
				{
					"id": 766750111,
					"content": "Mengumpulkan info terkait Abyss, meskipun fokus kami saat ini adalah menangani Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750112,
					"content": "Untuk itu, kami lagi mengumpulkan intel dari seluruh Nod-Krai. Rerir memang sudah disegel, tapi keadaan masih belum sepenuhnya tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750113,
					"content": "Kami mengumpulkan semua info terkait Abyss. Untuk saat ini, situasi di Nod-Krai memang stabil, tapi kita harus tetap waspada. Tidak ada yang tahu kapan Abyss akan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750114,
					"content": "Intel adalah fondasi dari setiap operasi. Bukan hanya gerakan musuh saja, medan perang atau perubahan cuaca pun bisa jadi penentu menang atau kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750115,
					"content": "Ke depannya, kami berencana untuk bekerja sama dengan Jaringan Intelijen Utara, dan mengubah kamp sementara ini menjadi pos intel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750116,
					"content": "Po-Pos intel? Wah, kayak mata-mata yang di novel Fontaine gitu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750117,
					"content": "Haha, ngaco! Coba sebut satu buku yang kemahnya sesantai ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750118,
					"content": "Selama bertahun-tahun ekspedisi, kami menemukan kalau banyak bencana Abyss yang terjadi di Teyvat, bentuknya juga beraneka ragam. Mereka licik dan wujudnya selalu berubah-ubah pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750119,
					"content": "Aku ingin memanfaatkan Jaringan Intelijen Utara untuk berbagi informasi yang sudah kami dapat, sekaligus mengumpulkan informasi lebih banyak juga tentang Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750120,
					"content": "Ini bukan beban satu wilayah saja. Setiap hari angin selalu bertiup melewati Nod-Krai ... kurasa ini tempat yang cocok untuk membangun pos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750121
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750121,
					"content": "Wah ... jadi gini toh yang namanya \"jiwa kesatria\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750122,
					"content": "Haha! \"Jiwa kesatria\", istilah bagus, prinsip bagus ... tapi realitanya pos ini baru berdiri, bahkan peta topografi wilayah sekitar saja belum ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750123,
					"content": "#{NICKNAME}, kalau kamu menemukan bahan bangunan atau informasi di sekitar sini, boleh tolong bawa ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750124,
					"content": "Kamu ini Honorary Knight. Jadi santai saja sama orang sendiri, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750125,
					"content": "Serahkan saja padaku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750126
					]
				},
				{
					"id": 766750126,
					"content": "Ha, baru kelar satu, muncul satu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750127
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750127,
					"content": "Grand Master! Kabar buruk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750128
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750128,
					"content": "Oh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750129
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750129,
					"content": "Tamu penting yang kita tunggu hari ini ... dia terjebak di kaki gunung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750130
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750130,
					"content": "APA?! Jangan-jangan ... dia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750131,
					"content": "Benar! Hampir semua anggota yang bisa ditugaskan lagi patroli, entah mesti panggil siapa balik buat urus ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750132
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750132,
					"content": "Tidak usah! Kasih tahu saja di mana, biar aku sendiri yang ke sana! Honorary Knight, Paimon, sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750133
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750133,
					"content": "Varka lari secepat angin ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766750134
					]
				},
				{
					"id": 766750134,
					"content": "Wah ... Paimon enggak pernah lihat Varka sepanik itu! Paimon jadi penasaran siapa tamunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750135,
					"content": "Mungkin ... informan penting ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750136
					]
				},
				{
					"id": 766750136,
					"content": "Ya, mungkin saja! Ayo kita ikutin, siapa tahu dia perlu bantuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750105,
					"content": "Kami ganggu yah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				}
			]
		},
		{
			"id": 7667504,
