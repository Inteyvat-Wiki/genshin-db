						766750805
					]
				},
				{
					"id": 766750805,
					"content": "Ngomong-ngomong, kamu belum ketemu Lohen, kan? Anak itu sudah terbiasa melakukan semua dengan caranya sendiri. Latihan saja sering mangkir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750806,
					"content": "Kalau ditanya, dia bakal bilang latihannya langsung ke lapangan, cari sarang monster. Soal latihan menggelindingkan tong ... katanya sih target yang tidak bisa menyerang balik itu tidak menarik, cuma buang-buang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
