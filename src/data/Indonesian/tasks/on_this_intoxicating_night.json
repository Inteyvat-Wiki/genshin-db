					"content": "Ayo kita ngobrol bentar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750705
					]
				},
				{
					"id": 766750705,
					"content": "Jean dan Albedo pernah ajak aku berdiskusi serius, tentang perlu atau tidaknya pelatihan dasar seperti ini buat Spark Knight kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750706
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750706,
					"content": "Latihan dasar memang bisa membantu dalam pembentukan karakter, tapi karena Spark Knight masih kecil ... aku memutuskan untuk tanya pendapatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750707
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750707,
					"content": "Dia membawa bom-bomnya ke tempat latihan dengan gembira. Dan akhirnya semua satu suara: pembahasan tentang hal ini tidak akan dilanjutkan lagi sampai dia sudah agak lebih dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
