						"pointId": 15082
					},
					{
						"sceneId": 3,
						"position": [
							5856.95,
							274.837,
							9759.279
						],
						"pointId": 15083
					}
				]
			},
			"dialogs": [
				{
					"id": 766750901,
					"content": "Ah! Grand Master! Honorary Knight! Mereka sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "Mereka sudah balik! Mereka sudah balik! Semuanya, berbaris dan berikan sambutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Wah, Paimon enggak tahu kita sepopuler ini! Paimon sampai malu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "Angin sudah meniupkan aromanya dari kejauhan! Ini dia! Dandelion Wine yang asli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "Racikan spesial dari Dawn Winery ... Ah! Balik! Kenangan indahku ... langsung balik semua! Muncul seketika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Ugh ... jadi bukan kita ya, yang disambut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Ya, ini rasanya ... benar begini! Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "Akhirnya ... setelah bertahun-tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "Aku pikir aku sudah lupa gimana rasanya anggur Dawn Winery yang kualitasnya benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "Kalau rasanya masih sama ... berarti rumahku di Springvale juga kan ...? Masih sama, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "Makasih ... Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "Sudah, sudah. Tutup dulu! Tidak ada yang boleh minum, anggurnya tidak boleh keluar tong sampai semua anggota kembali! Ayo, kita bereskan dulu persiapannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "SIAP! Laksanakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "Nah, sudah lihat sendiri kan? Ini perkara serius, yang harus diurusi dengan serius. Seriusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Huaaa ... Sticky Honey Roast ... Sweet Madame ... Paimon enggak nyangka bisa makan masakan Mondstadt yang otentik di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Eh tunggu, di mana Varka? Ada yang lihat dia? Dia enggak mabuk sampai sempoyongan lalu kecebur got entah di mana gitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Orang kuat minum gitu, mabuknya mau dicekokin berapa gentong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Oke ... nanti Paimon nyusul kalau sudah kenyang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "Aku cari dia deh. Kamu lanjut mamam saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "Masih sama kok, aku sudah pernah ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
