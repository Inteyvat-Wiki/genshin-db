					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "Waktu pertama kali latihan seperti ini sama Razor, kami perlu waktu seharian. Tahu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "Dia menghabiskan seperempat hari untuk menggelindingkan tong, dan tiga perempat sisanya untuk memahami omonganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
