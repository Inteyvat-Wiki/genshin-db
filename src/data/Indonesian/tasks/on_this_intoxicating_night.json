				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varka"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5921.365,
							283.763,
							9726.784
						],
						"pointId": 14164
					},
					{
						"sceneId": 3,
						"position": [
							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "Wah, pahlawan yang menyelamatkan juru selamat pembawa minuman kami! Kenapa malah ke pojokan sepi begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751002,
					"content": "Ehem, baru mau nanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Hehe, soalnya ... yang di gelasku ini racikan super istimewa. Cuma bisa diminum sendiran saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751005,
					"content": "Tapi ... karena aku ketangkap basah, nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751006,
					"content": "Sudah kuduga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "Kena! Setetes alkohol pun tidak ada. Kalau memang mau minum, kamu cari Erminie saja. Stoknya bejibun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751009,
					"content": "Di kemah harus ada satu yang sadar agar bisa menjaga teman-teman yang mabuk di malam hari, itu perintah pertama dan paling penting, yang aku maklumatkan sejak ekspedisi ini pertama berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751010,
					"content": "Nasib, nasib ... bisa gimana lagi? Malam ini kebetulan giliranku untuk tetap sadar seratus persen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751011,
					"content": "Jadi yah ... pada malam ketika mereka bebas mabuk, aku tidak boleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751012,
					"content": "Kebetulan apa \"kebetulan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Entahlah? Mungkin memang takdir hobi mempermainkan kita yang fana ini? Kalau datangnya besok, wuih. Kayaknya sih muka ini tidak bakal jauh-jauh dari gentongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751015,
					"content": "Tapi kalau memang telat, mungkin kamu cuma akan lewat, nyapa, lalu pergi lagi. Tidak akan ikutan makan-makan. Tidak akan ngobrol seperti ini denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751016,
					"content": "Tidak ada yang tahu seperti apa hasil dari pilihan kita, sebelum waktunya tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751017,
					"content": "Seperti saat aku memutuskan untuk memimpin ekspedisi ini keluar dari Mondstadt ... tidak pernah terpikir kalau aku bisa sampai sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751018,
					"content": "Alasan kamu memulai ekspedisi ini ... apakah untuk menghadapi Perburuan Liar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "Iya ... tapi waktu kami berangkat, yang aku \"tahu\" hanya ini: ada badai Abyss yang menakutkan di utara dan mungkin bisa menghancurkan seluruh Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751020,
					"content": "Memobilisasi pasukan sebanyak itu perlu waktu, tapi masih ada pertanyaan lain. Di mana musuh akan menampakkan diri? Lebih parah dari itu: bentuknya seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751021,
					"content": "Waktu itu tidak ada satu pun dari kami yang tahu. Yang bisa dilakukan cuma mengumpulkan informasi sambil bergerak maju, selalu siaga dan siap menghadapi skenario seperti apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751022,
					"content": "Cuma tahu info serancu itu, tapi kamu tetap berangkat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Haha, kamu cepat sekali belajarnya. Tapi ya, masalahnya musuh kita kali ini tidak akan duduk manis menunggu persiapan selesai. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751025,
					"content": "Setiap jam yang terbuang karena kami ragu, Abyss gunakan untuk memangsa entah berapa banyak korban. Semakin cepat berangkat, semakin baik. Semakin banyak nyawa yang bisa diselamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751026,
					"content": "Maka dari itu, info seperti itu sudah cukup untuk kami berangkat \"ekspedisi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751027,
					"content": "Kamu memang paling layak jadi Knight of Boreas ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "Tolong jangan tiba-tiba formal begitu, \"Honorary Knight\"! Kamu juga sudah mengubah takdir banyak orang selama perjalananmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751030,
					"content": "Baik Mondstadt yang dulu, Dvalin ... atau Nod-Krai yang sekarang, pasukan ekspedisi ... bahkan takdirku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751031,
					"content": "#Kita bisa bernyanyi di sekeliling api unggun, minum bersama, dan merenungkan masa depan ... Semua itu tidak akan terjadi tanpa kedatanganmu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751032,
					"content": "Aku sehebat itu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "Hah, entah juga ya. Takdir memang sulit ditebak dan berubah-ubah. Tapi selama kamu masih hidup, pasti masih ada harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751034,
					"content": "Anggur yang tidak kita minum malam ini, bisa kita minum besok. Teman-teman akan menyimpan bagianku. Selama hayat masih dikandung badan, hari esok akan dipenuhi oleh anggur dan tawa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751035,
					"content": "#Jadi, ayo bersulang, {NICKNAME}! Demi hari esok! demi harapan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751028,
					"content": "Memang begitulah Knights of Favonius ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "Katanya fondasi setiap operasi itu intel? Kok malah ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "Pas banget datang Dandelion Wine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "Ini Apple Cider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "Kenapa malah minum sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
