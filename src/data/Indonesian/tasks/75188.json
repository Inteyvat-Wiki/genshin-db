			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Boleh ke ladang di depan ini dan bantu carikan <color=#00E1FFFF>tiga Saurian kecilku</color>? Tolong bawa mereka pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "Hei, kamu! Ya, kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "Kamu berjalan dan berlari dengan cepat, sepertinya kamu orang yang sangat lincah dan sering berolahraga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "Pejuang Berlimpah Jaya? Atau kamu dari suku lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "Cuma petualang lewat sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Oh, sayang sekali. Yah, ketemu orang yang dibutuhkan pas kita lagi butuh-butuhnya itu memang cuma bisa terjadi di dalam mimpi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "Jadi gini, aku punya ladang. Kelihatan lah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "Aku selalu mengurus tempat ini sendirian, tapi belakangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Beberapa hari lalu, aku main gulat sama pejuang di kampung suku dan hasilnya ... punggung sekarang encok. Yah, memang bodoh banget sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Sekarang aku jadi tidak bisa bantu ayah buka lahan, malah ladang sendiri juga jadi tidak keurus. Jalan saja sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "Terus waktu aku mikir mau cari tenaga bantuan buat berapa hari ke depan, eh, kamu lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "Tapi ya, sayangnya kamu memang cuma lewat. Kerja di ladang tuh perlu tenaga dan ketelitian, jadi kalau kamu datangnya cuma sesekali saja, ya tanamanku bisa layu semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Tapi aku tidak punya tenaga untuk pergi ke suku untuk mencari orang. Selain Tatankasaurus peliharaan di sini, tidak ada lagi yang bisa bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "Anak-anak nakal itu lagi banyak tingkah. Tiga-tiganya cuma malas-malasan di lapangan. Tidak mau pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "Mungkin kamu bisa tolong jemput mereka? Aku benar-benar tidak bisa jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "Aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Terima kasih banyak. Biasanya mereka baik sih, sering temani aku kerja di ladang. Entah apa yang mereka pikirin berapa hari terakhir ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "Kalau kamu panggil, aku yakin ... yah, cukup yakin kalau mereka bakal pulang sendiri sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Bukan orang Natlan, malah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
