			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "Tiga-tiganya sudah pulang. Makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "Terima kasih, orang lewat yang baik hati dan gagah berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "Punggungku masih sakit, tapi setidaknya para Saurian sudah pulang. Aku merasa lebih baik dengan adanya mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "Aku bukan orang kaya, tapi ngerti aturan kok. Ini silakan, tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}