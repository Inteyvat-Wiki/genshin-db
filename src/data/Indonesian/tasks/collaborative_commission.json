			"dialogs": [
				{
					"id": 761290101,
					"content": "Terima kasih lagi atas bantuan kalian untuk Guild, Bos Nefer, Nona Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Ini cuma kerja sama biasa kok, tidak perlu sungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "Memang benar begitu, tapi aku tetap harus berterima kasih pada Bos Nefer yang bersedia membantu Guild melakukan beberapa ... tugas investigasi yang rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "Adventurers' Guild juga sudah mengirim banyak orang untuk bantu pekerjaan kami, ini bisa dibilang kerja sama yang saling menguntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Semoga kelak kita bisa terus bekerja sama dengan baik seperti ini, Tuan Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Tenang saja, Bos Nefer, kami dari Adventurers' Guild ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Oh, aku harus lebih jelas lagi. Cabang Adventurers' Guild Nod-Krai kami adalah rekan yang sangat bisa dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Hehe, sudah jelas kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Oke, oke, terus aja ngobrol, Bos Nef, Bos Nef tersayang, jangan lihat aku, tolong jangan lihat aku ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, kamu kok diam aja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(Aduh, dia malah lihat aku! Jangan lihat papan misi, tolong jangan lihat papan misi—)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Eh? A-Aku, tidak ada yang mau aku omongin kok? Terima kasih ... sudah memberi misi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Hehe, terima kasih juga atas bantuan Nona Jahoda. Tanpa kamu, urusan di Guild pasti sudah menumpuk seperti gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Tidak perlu sungkan ... aku kan sudah dibayar, tentu harus kerja dengan baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(Ah, sepertinya dia sudah lupa semua yang aku ajarkan ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "Oh ya, karena semuanya sudah di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(Jangan dong! Suasananya lagi enak begini, bos, tolong biarkan aku pergi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Tolong Tuan Sarin, bisa tolong ambilkan misi-misi terbaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, kamu pilih satu misi yang menurutmu paling penting untuk dikerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Pikir baik-baik dan pilih pelan-pelan, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "I-iya ... Bos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Waduh ... gawat deh ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}