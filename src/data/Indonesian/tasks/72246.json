			"dialogs": [
				{
					"id": 722460301,
					"content": "Nona Sumida, apa kamu sudah punya rencana selanjutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Hmmm ... Kudengar kalau Mondstadt memiliki perpustakaan yang sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
