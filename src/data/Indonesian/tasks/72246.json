	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Gelang yang indah sekali! Vas bunganya juga! Barang-barang dari Liyue benar-benar cantik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "Uh, tunggu, tidak. Kata-kata sifat seperti ini terlalu sederhana untuk novelis sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Mungkin aku harus membeli salah satu pernak-pernik porselen indah ini, dan menggunakannya sebagai bahan referensi novelku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Mmm, iya! Aku akan menulis plotnya seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"Kunci untuk mengubah situasi adalah Vision yang tersembunyi di dalam vas bunga!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "Ya, pasti ceritanya menarik! Bagaimana menurutmu, Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Nona Sumida, aku sungguh tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "Aku rasa deskripsi vas bunga ini harus dikontrol dengan baik. Kalau menghabiskan terlalu banyak waktu untuk mendeskripsi vas itu, \"pemberian petunjuk\" akan terlalu jelas. Tapi bila deskripsinya terlalu sedikit, kelanjutan cerita di belakangnya akan membuatnya muncul terlalu tiba-tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "Hmmm, benar juga! Biar kutulis sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "Tunggu, tidak. Lebih baik kita ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "Oh ya, bukannya aku sudah bilang ratusan kali, kalau jangan panggil aku \"Nona\" lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "Tapi kalau dipikir-pikir, ada dua pengembara yang tampak biasa-biasa, lalu salah satunya dipanggil \"Nona\" atau \"Tuan\", itu juga plot yang sering muncul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "*fuhh* Rasanya menyenangkan sekali—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "Mungkin lebih tepatnya, \"memang beginilah seharusnya perpustakaan paling besar di utara\"? Dan ternyata aku bisa juga dapat kesempatan untuk menghabiskan keseluruhan serial Kemelankolisan Vera sekaligus. Bagus, bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Nona Sumida, lebih baik Anda kecilkan suara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Ah, iya. Maaf. Aku terlalu bersemangat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "Tidak, aku takut Anda terluka. Pustakawan itu punya aura yang menakutkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Eh? Benarkah? Aku malah merasa kalau dia adalah penyihir tipikal yang agak malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "Dipikir-pikir, karakter seperti ini biasanya adalah karakter yang kuat. Benar juga, aku lebih baik tidak membuatnya marah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "Oh ya, haruskah aku menulis cerita dengan berdasarkan karakter seperti itu? Sesuatu seperti \"Penyihir di Perpustakaan Besar\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "Bagaimana dengan perjalanan kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Ah, lama tidak jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Oh ho, ada {NICKNAME} yang legendaris ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Perjalanan kami? Hmm, aku dulu sering berjalan-jalan untuk mengumpulkan bahan referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "Aku pergi ke Musoujin Gorge untuk mempelajari bagaimana cara menulis tentang petir, terus ke Serpent's Head untuk mempelajari bagaimana mendeskripsikan seekor siluman ular, dan aku meminta Kama bergabung ke militer untuk memahami hidup Stormchaser ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Buset, hidup Kama sulit juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "Biasa saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Tapi petualangan kali ini benar-benar petualangan. Petualangan tanpa tujuan yang pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Aku baru menyadari kalau banyak sekali hal-hal yang bisa ditulis di dunia ini, seperti Perjalanan Kino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Aku dan Kama pergi ke lokasi dan toko lokal yang direkomendasi, lalu pergi berkemah di alam liar, dan bertukar cerita dengan pengembara asing di tengah api unggun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "Dan saat kami terbangun, barang-barang kami raib semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "Tunggu. Kalian baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Ya. Jujur saja, saat kami menyadari kalau pencurinya ada lebih dari 10 orang, aku kira barang-barangku tidak akan bisa didapatkan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Tapi entah bagaimana, Kama berhasil meyakini mereka untuk mengembalikan barang-barangnya. Mereka bahkan memberikan koin-koin berlambang gagak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Sayangnya ... aku merasa kalau itu akan menjadi plot cerita yang menarik, tapi Kama tidak mau menceritakan apa yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Aku hanya melakukan yang sudah seharusnya. Nona Sumida tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "Kamu benar-benar tidak tergantikan, Kama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Dengan adanya kamu di sisiku, meskipun perjalanan ini membawa kita ke ujung dunia, kita tidak akan kena masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "Omong-omong, kamu benar-benar berubah banyak sejak kejadian di Pulau Tsurumi. Kamu jadi memiliki hal-hal yang ingin dilakukan, pendapat dan keraguan yang ingin disampaikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Ya, kalau Nona Sumida merasa itu tidak baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "Tidak, tidak, kurasa itu sangat bagus! Pendapatmu sangat cocok dijadikan referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "Baiklah, aku tidak akan mengganggu kalian lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Benar sekali. Sampai jumpa, {NICKNAME}. Sampai bertemu lagi di waktu segalanya berakhir, sama seperti di \"Bunga untuk Putri Fischl\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#Sampai jumpa, {NICKNAME}. Jaga diri baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Mungkin kita bisa bertemu lagi di lain tempat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Hebat, Kama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
