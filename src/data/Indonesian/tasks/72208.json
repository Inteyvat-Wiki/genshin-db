					"content": "Ke mana perginya perahu itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "Ke tanah emas, tanah impian, alam tanpa kabut. Sampai jumpa lagi di alam mimpi, teman.",
					"roleType": "TALK_ROLE_NPC",
