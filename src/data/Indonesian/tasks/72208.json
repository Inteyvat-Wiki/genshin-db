			"trigger": {
				"objectNames": [
					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Kamu sangat pandai memancing! Tapi masih ada yang bisa ditingkatkan loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ahaha, maaf. Aku selalu lupa menyapa dulu. Aku sering lupa kalau aku bisa menakuti orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "Tapi kamu terlihat sangat menikmatinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "Ayolah~ Kadang-kadang menakuti anak-anak cukup menyenangkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "*uhuk* Omong-omong, mari kembali ke topik memancing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "Ada apa, hal yang serius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Aku tahu kalau ini tidak terlihat bagus ... Tapi waktu aku pertama kali memancing, aku tidak sengaja menjatuhkan jimat yang diberikan Makiri. Jimat itu berisi berkat dari leluhurnya dan Great Thunderbird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "Saat naik perahu nanti, a-aku tidak tahu bagaimana menjelaskannya kalau dia tahu aku kehilangan jimat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "Tukang perahu berwarna emas itu bilang kalau dia akan meminta beberapa orang membantu mencari, tapi sampai sekarang ... tidak ada satu pun yang datang! Jadi kupikir mumpung kamu di sini, kamu bisa membantuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "Awalnya kukira kamu bisa diandalkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Aku biasa memancing di sana, tapi ... ingatanku makin lama makin melemah, kurasa harus kamu yang membantuku mencarinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Karena itu adalah tempat yang penuh dengan ingatan masa lalu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "Eh? Apa maksudmu? Itu cara orang luar untuk mencari sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "*huff* Tidak peduli apa pun itu, kamu harusnya bisa mencari jimat itu kalau kamu menemukan lokasi yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "Dan bagaimana cara mencari jimat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Uhh ... Dengan memancingnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "Terima kasih, teman dari jauh! Great Thunderbird dan leluhur kami memberkatimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Kurasa \"bulu\" bisa membantu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Apa boleh buat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "Sisi barat Autake Plains berhadapan dengan pulau kecil dengan tiga air terjun di dalamnya ... Jimat itu harusnya ada di laut, jauh di sebelah barat pulau itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "Kamu suka memancing ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "Bisa memberi salam dulu sebelum muncul tiba-tiba begini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
