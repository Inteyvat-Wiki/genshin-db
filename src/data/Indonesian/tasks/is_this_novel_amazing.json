			"dialogs": [
				{
					"id": 220100701,
					"content": "Barang yang dijual di Tsukumomono Groceries, mirip dengan benda-benda yang tokoh utamaku kumpulkan dari petualangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Aoi selalu bilang, \"Sampah di mata seseorang, adalah harta untuk orang lain.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Ah, sepertinya kalau mau dapat harga jual yang bagus, kuncinya adalah harus tahu lebih dulu apa yang para pembeli inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Tapi kalau kutulis begitu, nanti terlalu buang waktu untuk menjelaskan psikologi. Kurang pas ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Atau aku buat tokoh utamanya bisa baca pikiran. Dengan begitu dia bisa tahu apa yang dibutuhkan pembeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Jangan sembarangan tambah latar belakang aneh-aneh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Ini pengembangan karakter. Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Inspirasi sudah ketemu. Tinggal ditulis deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "Ayo pulang, pengembara. Aku lapor ke Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Mana plot ceritanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Plot... Eh, kupikirkan nanti saja saat menulis. Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201008,
			"completionStepIds": [
				2201004
			],
