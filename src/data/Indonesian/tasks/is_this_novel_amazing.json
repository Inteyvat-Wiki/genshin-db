					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100915,
					"content": "Pengembara, menurutmu yang benar aku atau Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
