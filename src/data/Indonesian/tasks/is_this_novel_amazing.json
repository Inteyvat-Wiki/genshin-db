			"dialogs": [
				{
					"id": 220100916,
					"content": "Sebenarnya ide Junkichi tidak jelek juga sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "Hah? Kalau dia seperti itu terus, aku jamin akhirnya dia sendiri yang jadi pusing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "Hahaha, tuh kan, Pengembara saja mendukungku. Artinya ideku ini menarik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100919,
					"content": "Hal terpenting ketika menulis cerita adalah plot yang segar dan menarik. Dan sekarang, aku akan lanjut menulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "Kamu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "Jangan takut, aku tahu apa yang harus kutulis. Penilaian dari pembaca juga pasti bagus, lihat saja nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
