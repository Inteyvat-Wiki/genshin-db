			"dialogs": [
				{
					"id": 220100922,
					"content": "Sebenarnya, pendapat Shigeru lebih masuk akal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Masuk akal? Itu tidak penting dibanding plot yang segar. Kalau plotnya jelek, biarpun masuk akal tetap saja akan membosankan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "Kamu ya... Sekarang mungkin terasa segar, tapi nanti waktu sampai ke penghujung cerita, kamu bakalan gila karena latar belakangnya kebanyakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "A-Aku punya catatan kok, akhir ceritanya tidak akan jadi masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "Bahkan kamu sendiri pun harus mencatat agar ingat detailnya. Kamu mau suruh pembaca ikut nulis catatan saat baca novel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Eh... Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "Aku bukan melarang kamu menambah latar baru. Kalau mau ya boleh, tapi pilih dengan cermat dan kendalikan frekuensi penambahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Menulis novel ibarat latihan fisik. Kalau staminamu habis di awal, kamu tak bakal kuat sampai akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "Kuncinya adalah menulis secara perlahan tapi pasti. Percayalah padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100931,
					"content": "Ba-baiklah kalau begitu... haah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
