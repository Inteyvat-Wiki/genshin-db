			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, besok sudah terakhir ya! Tidak boleh tunda-tunda lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "Tidak ada gunanya mendesakku. Ceritanya tersangkut di tempat yang krusial, aku tidak tahu bagaimana menulisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "Apa yang kalian perdebatkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "Pe-pengembara? Kebetulan sekali, tolong beri masukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "Aku Shigeru, editor di Yae Publishing House. Orang ini adalah penulis yang kuurus, Junkichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "Novel barunya \"Onibudou\" sangat populer, tapi dia selalu gagal mengumpulkan tulisannya tepat waktu. Kadang bahkan sampai berminggu-minggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "Sekarang penyakit lamanya kambuh lagi tuh. Kalau sampai besok masih belum dikumpulkan, edisi bulan ini tidak akan bisa naik cetak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Tanggal rilisnya kan bisa ditunda. Lagi pula para pembaca pasti masih rela keluar uang untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Jangan bercanda. Kalau tidak terbit tepat waktu, nanti reputasi novel ini bisa turun drastis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "Tapi aku sedang tidak ada inspirasi. Daripada mengumpulkan tulisan sampah, kan mending aku fokus memikirkan cerita yang benar-benar menarik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "Tapi penulis lain sudah selesai semua, sisa kamu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Mungkin Junkichi memang perlu inspirasi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "Benar! Sahabatku ini memang paling mengerti, aku butuh inspirasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "Mungkin aku harus pergi berkelana cari inspirasi. Nanti pasti dapat ide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "Hei, tempo hari kamu juga pakai alasan yang sama untuk menunda satu hari, masih berani bilang begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "Kali ini serius, percayalah padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Keterlaluan deh... Ya sudah, aku beri kamu kesempatan terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "Habis ini tidak ada mundur-mundur lagi, paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "Iya, iya, paham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Duh... sepertinya kali ini sudah tidak bisa diundur lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Ayo kita cari bahan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Waktunya cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Inspirasi bukan hal yang bisa dicari segampang itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "Tapi mau bagaimana lagi, kalau tidak Shigeru bisa mengobrak-abrik rumahku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
