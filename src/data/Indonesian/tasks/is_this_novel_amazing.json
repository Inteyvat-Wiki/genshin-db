				"points": []
			},
			"dialogs": [
				{
					"id": 220100801,
					"content": "Doushin menjaga Hanamizaka dengan ketat. Orang-orang yang mencurigakan tidak bisa luput dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Dalam ceritaku, para kesatria musuh punya tugas yang sama dengan Doushin. Tapi agar ceritanya lebih menarik, kubuat mereka 10 kali lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "Angka dari mana itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Angka sangat jelas dan gamblang. Dengan demikian, kekuatan tokoh utama dapat langsung ditonjolkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Hmm, aku kasih dia kemampuan menyamar saja. Dia bisa mengubah wujud dan suara dengan bebas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Tambahan dadakan lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Ini adalah kemampuan tersembunyi tokoh utama. Saat bertemu dengan musuh yang membuat dia harus menyamar, tentu dia akan pakai kemampuan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Kamu barusan saja kepikiran kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "Ma-mana mungkin ... itu sudah rencanaku dari awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Baiklah, begitu saja. Ayo pulang dan lapor ke Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "Apa kamu sudah tahu bagaimana cara tokoh utama membereskan masalah ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
