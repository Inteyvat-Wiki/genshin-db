					"nextDialogs": [
						220101111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101111,
					"content": "Ini kan gayaku menulis dari dulu. Kurasa sudah oke, pembaca pasti suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101112,
					"content": "Tidak! Para pembaca malah jadi mabuk gara-gara gayamu itu! Kamu juga sudah tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101113,
					"content": "Ngomong terus juga percuma, kamu terlalu tradisional. Pengembara, menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101114,
					"content": "Pengembara, menurutmu yang benar aku atau Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101107,
					"content": "Itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
			]
		},
