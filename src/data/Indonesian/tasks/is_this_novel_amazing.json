			"dialogs": [
				{
					"id": 220100901,
					"content": "Aku dapat inspirasi di Amenoma Smithy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100902,
					"content": "Oh? Ternyata kamu benar-benar pergi cari bahan. Baguslah, coba ceritakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100903,
					"content": "Suatu malam, sang tokoh utama mendapat pencerahan dan jadi bisa teknik alkimia hebat — Sword Resurrection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100904,
					"content": "Pisau karatan pun bisa diubah jadi senjata yang luar biasa kuat dengan cara menyebutkan nama barunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100905,
					"content": "Lalu dia akan... eh, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100906,
					"content": "Kamu... mau pakai cara itu lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100907,
					"content": "Lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "Kamu! Lagi-lagi mau tambah latar baru untuk mendorong kemajuan plot kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100910,
					"content": "Setelah itu latar barunya akan terus kamu kasih detail yang semakin lama semakin ruwet, sampai selesai jadi sebuah bab baru, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100911,
					"content": "Sesuka-sukanya kamu pada satu karakter, jangan buat dia punya terlalu banyak kemampuan! Nanti para pembaca bingung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100912,
					"content": "Ini kan gayaku menulis dari dulu. Kurasa sudah oke, pembaca pasti suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100913,
					"content": "Tidak! Para pembaca malah jadi mabuk gara-gara gayamu itu! Kamu juga sudah tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100914,
					"content": "Ngomong terus juga percuma, kamu terlalu tradisional. Pengembara, menurutmu?",
