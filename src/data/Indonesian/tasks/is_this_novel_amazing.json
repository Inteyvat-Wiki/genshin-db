			"dialogs": [
				{
					"id": 220100601,
					"content": "Percikan api beterbangan dari palu yang memukul lempengan besi tanpa henti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "Amenoma Smithy memang tempat yang penuh gairah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Hanya dengan menggunakan alat sederhana, para pandai besi mampu mengubah logam mentah dan bijih besi menjadi senjata yang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "Kalau pakai alkimia, apa mungkin mereka bisa buat senjata yang tak bisa dihancurkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "Alkimia tidak sampai segitunya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Ya! Bagus. Tokoh utama akan punya senjata super kuat yang dibuat dari Alkimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Dan senjata ini juga harus punya... nama dan latar belakang yang keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "Nah, bagus begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "Ayo pulang, pengembara. Aku mau menceritakan ideku ke Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Bukan begitu cara kerja alkimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Lalu apa dong? Alkimia bukannya ilmu untuk membuat hal yang tidak mungkin menjadi mungkin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
