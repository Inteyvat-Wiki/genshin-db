			"dialogs": [
				{
					"id": 721130601,
					"content": "Eh? Apaan nih? Kayaknya catatan seseorang deh, coba Paimon lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "\"Shuumatsu... para Fatui... merencanakan...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "Apa sih ini? Berantakan dan kotor sekali. Tidak jelas sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Mungkin petunjuk harta karun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "Bisa jadi! Coba Paimon lihat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "\"...Saat menguraikan slip, kode rahasianya...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "Menguraikan slip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Coba Paimon lihat... \"...Yang baris pertama, saat tengah malam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Cuma sampai sini doang, Paimon enggak bisa tebak apa lanjutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Tapi kan ini dipakai jadi sandi rahasia. Artinya, ada rahasia yang menunggu untuk diungkap, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "Apa pun itu, kayaknya penting deh. Lain kali kalau kita ambil Slip Keberuntungan lagi, kita samain aja sandinya, gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "Kode rahasia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
