				},
				{
					"id": 721130402,
					"content": "Eh, \"Sial\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Paimon ingat kita harus bagaimana! Katanya kita bisa \"mengikat slip sial ini di 'Gantungan Slip Keberuntungan'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "\"Lalu berikan Paimon makanan enak, maka kesialanmu akan berubah menjadi keberuntungan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "Oh, begitu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Ya! Kamu berani mempertanyakan pengetahuan para leluhur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "Pengetahuan orang zaman dahulu itu benar-benar hebat! Singkatnya, ayo cari Gantungan Slip Keberuntungan dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
