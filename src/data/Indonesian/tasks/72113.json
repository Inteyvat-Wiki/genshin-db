			"dialogs": [
				{
					"id": 721130801,
					"content": "Eh? Nona Gendou ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130802,
					"content": "Aku jadi agak khawatir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Ya. Kalau dia tidak kembali, bagaimana cara Paimon lihat keberuntungan hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130804,
					"content": "Eh? Ada selembar kertas ramalan di sini. Coba Paimon lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130805,
					"content": "Lebih baik jangan deh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "Tidak apa! Siapa tahu ada petunjuk kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130807,
					"content": "Eh? Ini kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130808,
					"content": "Sepertinya kita harus pergi ke tempat ini untuk mendapat petunjuk selanjutnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130809,
					"content": "Ayo kita ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
