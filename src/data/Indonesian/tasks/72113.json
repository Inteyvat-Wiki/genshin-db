			"dialogs": [
				{
					"id": 721130201,
					"content": "Aku mau lihat, aku mau lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130202,
					"content": "Wah! Tulisannya \"sangat beruntung\" lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "Sepertinya hari ini hari keberuntungan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "Hari keberuntunganmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "Betul! Kebahagiaanmu juga kebahagiaan Paimon! Jadi kalau dibalik, kalau Paimon senang, kamu juga senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "Paimon senang kalau dikasih makanan enak. Jadi, supaya kamu senang, ayo traktir aku makan makanan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
