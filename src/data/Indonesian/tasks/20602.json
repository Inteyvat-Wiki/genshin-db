					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020502,
					"content": "Di luar masih ada monster-monster...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "Masih ada monster-monster di area itu? Sepertinya akibat badai masih belum benar-benar menghilang...",
