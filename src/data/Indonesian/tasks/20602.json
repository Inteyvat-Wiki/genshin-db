					"nextDialogs": [
						206020504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020504,
					"content": "Hahaha, masih ada kesempatan! Masih ada kesempatan untuk Adventurers' Guild menunjukkan kekuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020505,
					"content": "Ini adalah tugas kita untuk memusnahkan monster-monster itu, dan Knights of Favonius akan tetap fokus mempertahankan kota dan area sekitar kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020506,
					"content": "Aku mengerti. Terima kasih sudah membantu investigasi. Aku akan mempertimbangkan kembali langkah kami. Ini terimalah upahmu.",
