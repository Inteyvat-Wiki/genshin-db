			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Tuan penambang, kami sudah kembali dan siap buat lapor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Ah! Aku senang sekali melihat kalian lagi! Aku sudah mulai khawatir ... Awalnya, aku pikir aku sudah bayar cukup, lalu aku tahu kalian ini profesional. Tapi terus aku pikir ... Ya ampun, aku takut terjadi apa-apa pada kalian setelah memberi kalian misi menyelidiki tempat yang begitu aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Aku akan merasa bersalah seumur hidup kalau terjadi apa-apa pada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "Tidak apa-apa, ini bukan hal yang tak bisa kami atasi! Kami berhasil kembali, kan? Dan berita baiknya, kita sudah tahu apa yang sebenarnya terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Bagus, bagus! Jadi, bagaimana situasi di bawah sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Eh ... uh ... hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "Jadi di bawah sana itu seperti rumah untuk menghabiskan hari tua Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Hah? Menghabiskan hari tua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Yah, jadi, Hilichurl di bawah sudah tidak mau bertempur lagi. Jadi biarkan saja mereka, mereka tidak akan ganggu kalian kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Yah, kami pastinya juga tidak mungkin memprovokasi mereka, percayalah. Kami tidak mau memancing bahaya sembarangan ... Kami cuma peduli pada benda yang berkilau dan emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Wow, itu filosofi yang Paimon suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Sejujurnya, aku tidak begitu paham situasi yang kalian jelaskan, tapi karena kamu sudah menjamin semuanya baik-baik saja itu saja sudah cukup. Artinya kami bisa kembali bekerja secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Terima kasih kepada kalian berdua! Sudah merepotkan kalian untuk datang sejauh ini! Tolong terima hadiah ini sebagai kompensasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Kamu tidak usah khawatir lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Di bawah sini adalah kampung halaman para Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Maaf, kampung halaman ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
