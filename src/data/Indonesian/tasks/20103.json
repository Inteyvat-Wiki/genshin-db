			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Oh senang sekali melihatmu lagi! Kamu masih ingat aku kan? Jika kamu lupa... kamu pasti masih ingat persahabatan kita yang bermula dari Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Hei, jangan menatapku seperti itu... Belajar sebuah bahasa membutuhkan latihan yang berkepanjangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Tenanglah, upayamu tidak sia-sia, sejak terakhir kali kita bertemu, kini bahasa Hilichurlku sudah mengalami banyak peningkatan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Namun hanya karena bahasa lisanku meningkat, aku tidak boleh mengabaikan bahasa tulisanku. Setelah penelitian ini, aku akan menyusun serangkaian puisi dalam bahasa Hilichurl asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Tapi... ada beberapa kalimat dalam puisi yang tidak kumengerti, bisakah kamu membantuku untuk mengujinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "...maksudmu mengujinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Ya... seperti membacakannya kepada para Hilichurl lalu lihat reaksi mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Tapi, jangan khawatir! Aku sudah <color=#00E1FFFF>menandai</color> kalimat yang tidak begitu kumengerti. Jadi aku yakin artinya tidak akan terlalu berbeda dari itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Aku sudah memilih targetnya. Para Hilichurl di sebelah sana terlihat lebih ramah daripada biasanya. Kamu bisa membacakan puisi itu kepada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Terima kasih banyak! Kembalilah setelah kamu selesai membacakan puisi itu kepada para Hilichurl, aku ingin tahu hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "...Membacakan ini lagi kepada para Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Iya benar, kamu sudah berpengalaman mengenai hal ini. Tidak usah khawatir, aku sudah <color=#00E1FFFF>menandai</color> kalimat yang tidak begitu kumengerti. Jadi aku yakin artinya tidak akan terlalu berbeda dari itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Aku sudah memilih targetnya. Para Hilichurl di sebelah sana terlihat lebih ramah daripada biasanya. Kamu bisa membacakan puisi itu kepada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Terima kasih banyak! Kembalilah setelah kamu selesai membacakan puisi itu kepada para Hilichurl, aku ingin tahu hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "Ji-jika tidak berjalan sesuai rencana, aku yakin kamu pasti mempunyai cara untuk mengatasinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
