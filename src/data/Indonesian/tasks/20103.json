			"dialogs": [
				{
					"id": 201031201,
					"content": "Bagaimana? Apa kamu sudah membacakan puisiku kepada para Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031202,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "Jadi bagaimana? Dari raut wajahmu... sepertinya tidak begitu baik ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "Ada sedikit masalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Apa kamu benar-benar membaca yang tertulis di catatanku? Apa mungkin ada yang salah ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Maaf, sepertinya aku masih harus banyak belajar, aku akan belajar lebih giat. Terima kasih sudah membantuku, ini terimalah sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "...aku harus segera memperbaikinya. Aku tidak bisa mencemarkan nama baik keluarga \"Musk\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
