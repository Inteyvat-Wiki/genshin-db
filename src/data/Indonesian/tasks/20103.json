					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "Aku ingin tahu apakah para Hilichurl akan menyukai puisiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Mengapa kamu menulis puisi dalam bahasa Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Eh... sebenarnya, aku masih belum memahami sepenuhnya tentang bahasa Hilichurl. Ada aturan tata bahasa tertentu, struktur kalimat, kombinasi kosakata dan sebagainya, banyak yang masih belum kupahami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Meskipun aku sudah bekerja keras menulisnya tapi siapa tahu, bagi para Hilichurl ini masih terdengar aneh dan canggung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Terkadang, walau hanya satu kata saja menggunakan konotasi yang salah, itu bisa mengubah arti dari seluruh kalimat, jadi hanya ada satu cara untuk mengetahuinya, yaitu dengan berbicara langsung kepada Hilichurl yang asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Tapi, gagasan untuk mempelajari bahasa Hilichurl langsung dari para Hilichurl, tidak dapat diterima oleh kebanyakan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Tapi tidak denganku. Jika aku ingin serius fasih berbahasa Hilichurl dan mengerti budaya mereka, aku harus melakukan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Dan menurutku akan lebih baik jika berkomunikasi dengan para Hilichurl di Mondstadt dengan menggunakan puisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Catatan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "Oh catatan yang ada di akhirnya. Ya... jadi, semua kosakata pada puisi ini, aku sudah pernah melihatnya pada buku lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Dan pada setiap kata, aku mencoba sebaik mungkin untuk mengerti tata cara penggunaan aslinya saat menyatukan kalimat-kalimat tersebut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Tapi bahasa adalah sesuatu yang sangat rumit. Terkadang, sebuah kata yang sangat dasar sekalipun bisa berubah artinya saat digunakan pada konteks tertentu, dan itu bisa mengubah arti dari keseluruhan kalimatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Baiklah, jadi kalimat-kalimat ini adalah kalimat yang aku rasa pemahamannya sudah benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Lalu ada pula beberapa kalimat yang aku tidak tahu bagaimana menterjemahkannya saat menulisnya... aku tidak akan menunjukkannya padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Sepertinya, kamu kurang lebih sudah memahaminya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Ya tapi... \"kurang lebih\" itu masih jauh sekali dari tujuanku untuk bisa berteman dan berinteraksi dengan para Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Jika terjadi kesalahan, sepertinya para Hilichurl itu tidak akan memberiku kesempatan untuk menjelaskan. Mereka pasti akan langsung menyerangku, lalu tamat sudah riwayatku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Jadi begitu, tolong ya, te-tenanglah, cukup ikuti saja catatanku dan aku yakin tidak akan ada masalah, tenang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Ya, seharusnya begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
