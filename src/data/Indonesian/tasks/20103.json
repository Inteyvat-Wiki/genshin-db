				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031101,
					"content": "Bagaimana? Kamu sudah bacakan puisi itu kepada para Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031102,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "Bagaimana hasilnya? Dari raut wajahmu, sepertinya semua baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "Hasilnya cukup baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Jadi pemahamanku mengenai kosakata sudah benar, bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Kali ini, aku telah mengambil sebuah langkah besar dalam Studi Hilichurlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Suatu hari, aku pasti bisa berbicara dengan para Hilichurl, dan mendengar semua rahasia mereka langsung dari mulut mereka sendiri, dan jika saat itu sudah tiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "...akhirnya aku bisa berkata, aku tidak membuat malu nama keluarga Musk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Oh iya, ini untukmu, sebagai tanda terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
