				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "...Kalian ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Kamu adalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Aku adalah Kamei Munehisa, hanya orang lewat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Wah... pakaian paman ini seperti seorang samurai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "Sa-samurai? Jangan-jangan dia adalah samurai Shogunate... Kudengar sikap Shogunate terhadap orang asing agak... aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Jangan khawatir. Aku sudah meninggalkan Shogunate dan bukan seorang samurai lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Aku sering datang ke sini untuk mencari makanan. Namun hari ini saat datang ke sini, aku melihat ada monster yang sedang berkeliaran di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Dan sepertinya bahan baku di sekitar sini sudah dijarah habis oleh mereka. Mau tidak mau aku harus menghabisi mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Kamu sering datang ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Biasanya di sini tidak ada monster. Aku sering datang ke sini untuk memetik buah atau berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Ceritanya sampai di sini saja. Setelah aku mengalahkan para monster ini, seharusnya mereka tidak akan berani datang lagi dalam waktu dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Jika kalian juga mencari makanan, bisa pergi mencari di sekitar sini. Aku hanya mengambil bagianku sendiri, seharusnya masih tersisa banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Kalau begitu aku permisi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Pergi begitu saja. Aku merasa gaya paman ini mirip dengan gaya samurai yang kudengar sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Tapi, dia bilang dia sudah meninggalkan Shogunate, apa artinya? Dan meninggalkan samurai Shogunate, bukankah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Mirip dengan musuh yang aku temui sebelumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Benar, aku juga pernah dengar ada samurai yang berkelana karena melarikan diri dari Shogunate. Mereka merampok pejalan di mana-mana untuk bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Walaupun paman itu tidak terlihat seperti penjahat, tapi sebaiknya kita tetap waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Sudah, sudah. Bukankah kita ke sini untuk mencari makanan? Tapi melihat situasi di sekitar sini, sebaiknya kita jangan masuk terlalu dalam untuk menghindari bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "Pengembara ini sudah mengawal kita selama ini, pasti lelah. Ayo istirahat sebentar dan masak sedikit makanan. Kemudian kita kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "Kata paman itu, di sekitar sini masih ada sisa bahan makanan kan? Ayo kita cari di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Mirip dengan \"Kairagi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Kamu yang mengalahkan semua monster ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Benar, tapi semua hanya monster biasa, jadi mudah untuk dihadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Kenapa kamu mencari makanan di alam liar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "Aku punya alasanku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
