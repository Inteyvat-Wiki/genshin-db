			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Julie",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Awalnya aku ingin mencari sedikit bahan makanan segar... Tapi sudahlah, seharusnya ini juga bisa dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Maaf, awalnya aku ingin membuat makanan yang lebih enak. Sepertinya sekarang kita hanya bisa berimprovisasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Kamu sudah bekerja keras mengawal kami, tapi kamu tidak dapat melewatkan kata \"tidak apa-apa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Aku akan mencatat resep ini dulu, lain kali aku akan mentraktirmu makanan yang lebih enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, sup ini seharusnya sudah matang kan? Ingat, jangan biarkan Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "Uh, tidak, tidak. Sebaiknya biarkan sup ini mendidih dengan sendirinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Tidak apa-apa, aku hanya akan menambahkan sedikit bumbu sesuai dengan resep yang sudah aku perbaiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Aku tidak mengerti dengan resep yang kamu perbaiki itu, cepat hentikan! Xudong, Xudong cepat kemari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! Hei! Bumbu aneh apa lagi yang kamu masukkan ke dalamnya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Bumbu aneh? Itu bumbu spesial yang aku buat! Ini adalah hasil penelitian yang aku bahas dengan menggunakan makalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Tidak usah! Hari ini kita makan makanan biasa saja! Julie, pegang dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Huh, benar-benar tidak tahu barang bagus... Sudahlah, tunggu sampai aku sempurnakan lagi. Aku pasti bisa membuat bumbu serbaguna yang bisa membuat masakan apa saja menjadi enak jika dicampurkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Bumbu serbaguna... Apa benar bumbu seperti itu bisa dibuat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Karena tidak ada yang membuat, makanya aku mau membuatnya. Kemudian aku akan mengejutkan orang-orang pintar di Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Haha... Baiklah, akan kutunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "Oh iya Pengembara, terima kasih karena kamu sudah menemani kami di luar begitu lama. Kamu sudah bekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Aku sudah membungkuskan makanan untuk kamu bawa. Bertualang di luar perlu makan dan minum yang cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "Pertemuan berikutnya aku pasti akan mentraktirmu makan makanan yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "Lain kali aku akan mencarimu lagi untuk memakan makanan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Hahaha, baiklah. Kalau begitu aku catat dulu resepnya, lain kali akan aku buatkan yang lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}