					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Siapa yang bisa tahu? Mungkin malah di Celestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "Hahahaha! Bercanda woi, jangan serius gitu. Tapi kalau kamu ingin ketemu aku di sana, ya aku bisa ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "Jangan tanya kenapanya. Pokoknya aku tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "Oke deh. Sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "Seribu peluk buat kamu juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "Hehe, makasih!",
