			"dialogs": [
				{
					"id": 733280101,
					"content": "Itu JEEEEHT! WOOOI~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}?! Dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "Bipbip——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "Haha, apa kubilang! Kita ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "Ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Hehe, rahasia perempuan~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{M#Artinya, kamu enggak boleh kepo! Aku boleh dong punya rahasia.}{F#Bawa aku ke Izakaya, siapa tahu mulut ini bakal bocor, hehe ... Masa masih harus aku ajarin sih? Hihihi.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{M#Maaf ya, menurut aturan, aku enggak boleh cerita sama siapa-siapa.}{F#Bercanda kok! Penjaga harus taat aturan, dan tidak boleh bocor soal barang apa yang diantar. Maaf ya!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "Huh, senang amat sih rahasia-rahasiaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Jadi ... apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "Lumayan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "Iya, sama aku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "Okelah, aku enggak akan nahan kamu di sini. Lagian masih ada kerjaan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "Jeht jadi sibuk ya. Tempo hari belum gini loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Hihi, begitulah kalau dapat kerja yang \"benar\" dan \"mapan\". Padahal yang dikerjainnya ya gitu-gitu doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "Dan aku sudah kangen banget sama hari-hari penuh kebebasan yang dulu, haa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "Aku tidak tahu kamu sibuk apa belakangan ini, tapi aku ingin tahu ceritanya! Aku sendiri juga ada banyak cerita, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "Tapi santai saja. Cerita seru itu ibarat anggur, harus difermentasi dulu dengan benar. Para pengembara di padang pasir dulu bertahan hidup dari cerita loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "Mm, ya pokoknya jaga diri baik-baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "Jeht juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Iya, peluk dan doaku selalu beserta kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "Bip bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "Haha, Benben juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "Ya gitu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
