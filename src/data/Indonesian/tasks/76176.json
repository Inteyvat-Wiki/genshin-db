			"dialogs": [
				{
					"id": 761760301,
					"content": "Kak Aria, Kak Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Ini bukan pertama kalinya. Ini sudah ... jauh melampaui batas \"hukuman\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Baik kota naga yang dipercayakan sang Raja, atau rumah rapuh nan indah yang dibangun manusia kecil itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Berapa banyak lagi makhluk tak berdosa yang harus mati sebelum kalian berhenti berdiam diri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Andai saja Raja kita masih hidup ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "Raja kita sudah tidak ada, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Kalau penguasa yang jauh dari kesempurnaan itu menganggap takdir yang pucat dan mengerikan sebagai \"tatanan\", kalau ini adalah satu-satunya kemungkinan untuk menyelamatkan dunia yang ditakdirkan untuk hancur dari kehancuran total, maka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Seberapa besar pun pengorbanan yang diminta ... bahkan jika pengorbanan itu membuatku sedih, itu jauh lebih baik dari kesunyian dalam kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "Jika dunia memang ditakdirkan untuk hancur ... untuk apa kita melawan kegelapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "Sonnet ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "Ti-Tidak ada apa-apa kok, Aria! Lupakan saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Aku cuma merasa kita tidak boleh diam saja dan membiarkan tiran itu membantai makhluk yang percaya dengan kita ... naga maupun manusia kecil itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Kita ... harusnya kita menyelamatkan mereka, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "... Aku paham kemarahan Sonnet, Aria. Menurutku, tindakan penguasa itu terlalu kejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Meski kemungkinannya kecil ... aku ingin berusaha menyelamatkan nyawa yang bisa diselamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "Tapi ... yang tidak bisa diselamatkan bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Orang yang tidak tertolong, nyawa yang tidak terselamatkan ... Apa air mata darah dan tangisan mereka pantas lenyap tanpa jejak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "Tidak ... tidak seharusnya seperti ini. Aku harap semua orang bisa diselamatkan, tidak ada satu pun yang tenggelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Asalkan \"tatanan\" itu mati bersamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "... Sonnet. Tolong jangan lupa alasan awal kita diciptakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Misi kita hanya menjaga dunia ini, sampai Raja yang memberikan kehidupan kepada kita kembali dari jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Sejak awal, kita sudah tahu apa yang harus dikorbankan untuk menjaga tatanan ini ... karena kita tidak bisa biarkan dunia ini menuju kehancuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "... Tidak, ini bahkan tidak ada hubungannya dengan tatanan, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, bagi kita ... bagiku, kamu adalah adik tersayangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "Jadi ... jangan lakukan hal yang bisa buat Aria dan aku menderita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Jangan melawan tatanan langit langsung. Setidaknya ... tidak sekarang, waktu dunia masih sangat rapuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Kak Canon ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth pernah memberitahuku satu kata yang hanya dimiliki manusia ... adalah \"harapan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Selama masih ada kehidupan, pasti akan ada harapan ... selalu ada harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}