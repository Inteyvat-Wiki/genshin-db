			"dialogs": [
				{
					"id": 705450101,
					"content": "Meong, meong, meong, meong~~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Meong! Meong meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "\"Saudara Kelinci\""
				},
				{
					"id": 705450103,
					"content": "Hmm ... Masuk akal sih yang dibilang \"Saudara Kelinci\" dan Amber ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Hmm ... begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Iya juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Sebenarnya Paimon kurang ngerti juga sih. Tapi Paimon bisa ngerasa kalau Amber dan \"Saudara Kelinci\" akhirnya sudah bisa sepakat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME} dan Paimon! Kalian sudah datang. Aku baru saja mau cari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Aku sudah dengar dari Nona Valerina tentang kalian yang bantu mengurus Benteng Bulu-Bulu ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Luar biasa memang, {NICKNAME}. Begitu balik ke Mondstadt, kamu langsung membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "Aku sang Honorary Knight akan terus mengabdi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Oh ya, tadi kamu lagi ngobrol apa sama si \"Saudara Kelinci\"? Kok kayaknya seru amat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Meong, meong meong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "\"Saudara Kelinci\""
				},
				{
					"id": 705450115,
					"content": "Hem ... Aku lagi tanya si \"Saudara Kelinci\" gimana cuaca hari ini. Bakal hujan enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Eh? Memangnya kucing bisa yang kayak gituan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hehe, Lisa sih pernah bilang sama aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Lisa pernah baca satu buku, katanya kucing itu sensitif sekali sama kelembapan, dan tidak suka basah-basah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Jadi waktu mereka tiba-tiba merasa kelembapannya meningkat, mereka pasti jadi gelisah, bakal terus garuk muka dan jilat bulunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Jadi begitu kucing melakukan gerakan seperti itu, ini berarti bakal ada hujan badai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Wah, Paimon baru tahu loh. Hari ini jadi belajar hal yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, kalau begitu, lain kali waktu kita bertualang, harus sering perhatikan si kucing ya. Jadi enggak bakalan sampai ... kehujanan sampai basah kuyup dari awan gelap itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Baiklah, aku akan lebih jeli lain kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Awalnya aku ke sini mau tanya sesuatu ke Nona Valerina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Tapi waktu lagi ngobrol sama dia, kucingnya tiba-tiba menyerbuku! Dia langsung berbaring di sebelahku dan menguap dong! Imut banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Karena dia ramah sekali denganku ... Yah, aku juga harus ramah dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Aku jadi ingat kata-kata Lisa, makanya sekalian tanya si \"Saudara Kelinci\" soal cuacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Tapi dia cuma gosok-gosok wajahnya saja, kadang-kadang goyang-goyang ekor, terus berbaring di lantai dan gosok-gosokkan tangannya ke aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*huff* Jadi sebenarnya bakal hujan atau enggak sih beberapa hari ke depan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Memangnya sejak kapan aku tidak perhatikan kucing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Pertahanan kucing di Mondstadt itu juga salah satu tanggung jawabku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Tunggu dulu, kok jadi aku yang bingung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}