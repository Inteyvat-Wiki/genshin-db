			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Lihat, itu <color=#00E1FFFF>\"Shield of Magnificent Honor\"</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Pembohong! Itu hanya sepotong kayu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Hanya sepotong kayu dengan pegangan... siapa yang akan menggunakannya menjadi sebuah perisai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Lagi pula, ada bekas anggur di atasnya... Aku yakin ini diambil dari gentong anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Menurut intuisi penyairku, ini adalah Shield of Magnificent Honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Petarung membanggakan bekas luka mereka, dan perisai juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Bukankah perisai utuh adalah perisai yang telah menghindar dari medan pertempuran? Bukankah perisai yang hancur dan terpecah-pecah adalah perisai yang telah berperang tak terhitung jumlahnya dan hidup untuk menceritakan kisah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Meski tubuh prajurit lelah dan terluka, dia tetap berjuang sampai titik darah penghabisan. Kekuatan kemauan yang begitu hebat... bukankah itu arti kehormatan yang sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Aku setuju dengan Venti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Benar juga... mana ada perisai tanpa bekas pertarungan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Kalau begitu... apakah dia akan memberikan Shield of Magnificent Honor kalau diminta baik-baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "Halo, Tuan Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Wah, {NICKNAME}, kamu saja deh. Coba gunakan kata-kata yang sering kamu dengar dari mereka. Atau pakai bahasa tubuh juga boleh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Aku ingin membeli perisai itu dengan Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "Hmm... dia tampaknya <color=#00E1FFFF>tidak terlalu gembira</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Bunga yang kupetik ini, kuberikan untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Hmm, dia terlihat lumayan senang. Mungkin negosiasi ini akan <color=#00E1FFFF>berhasil</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti, nyanyilah. Perisainya, berikan kepadaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
