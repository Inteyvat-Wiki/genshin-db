			"dialogs": [
				{
					"id": 4541501,
					"content": "Ini adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}, bantu aku kumpulkan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541503,
					"content": "Bukankah ini, biji Wolfhook?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541504,
					"content": "Tumbuk biji Wolfhook itu dan taruh di atas lukanya. Darah akan berhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541505,
					"content": "Benar. Dalam biji Wolfhook ada cairan untuk menghentikan rasa sakit, dan juga bisa menghentikan darah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541506,
					"content": "...aku pernah baca di buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541507,
					"content": "Kenapa bisa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541508,
					"content": "Aku tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541509,
					"content": "Kail sebarkan bijih. Cairannya hentikan darah, tahan sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541510,
					"content": "Karena hewan tidak rasakan kail. Mereka membawanya jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541511,
					"content": "...guru warna ungu, dia yang mengajariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541512,
					"content": "Aku tinggal di sini untuk merawatnya, sekaligus menjawab pertanyaan perempuan merah yang satunya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541513,
					"content": "Ya, dan kalau kelompok itu datang lagi, aku yakin mereka tidak akan berani mengadu nasibnya untuk bertarung melawan Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541514,
					"content": "#Aku masih belum sepenuhnya percaya kepada teman serigalamu itu. Tapi kami masih membutuhkan pertolonganmu untuk mengumpulkan biji-biji itu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
