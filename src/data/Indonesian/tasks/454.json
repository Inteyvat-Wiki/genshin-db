					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "Darah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541102,
					"content": "Bukan manusia, darah serigala. Lupical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541103,
					"content": "Apa sih Lupical? Kapan kamu mau beri tahu artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541104,
					"content": "Lupical, adalah keluarga dari takdir. Serigala menerima manusia, dan manusia menerima serigala. Itulah Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541105,
					"content": "Kedengarannya seperti bahasa ciptaan sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541106,
					"content": "Tapi aneh sekali. Dari mana asalnya kata-kata itu? Pasti bukan dari serigala, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541107,
					"content": "Mereka yang memberikan nama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541108,
					"content": "... mereka, siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541109,
					"content": "Penguasa tanah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541110,
					"content": "Penguasa Mondstadt, Barbatos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541111,
					"content": "Cukup. Aku sudah menemukan petunjuknya. Ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541112,
					"content": "Eh, tunggu! Aku kan sedang memberimu kesempatan untuk membuktikan kamu tidak bersalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541113,
					"content": "Eh, Razor sudah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
