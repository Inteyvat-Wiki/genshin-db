			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "Kita kembali! Menurutmu ini sudah cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor baru memberitahuku tentang prinsip-prinsip dunia serigala. Luar biasa sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Kami sudah mencari ke mana-mana, tetapi belum juga melihat serigala yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540307,
					"content": "Memang biasanya serigala seperti itu. Serigala yang berhasil kita tangkap barusan sepertinya agak sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "A, apa maumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540309,
					"content": "Balas dendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "Dia! Manusia yang hidup bersama serigala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540312,
					"content": "Ternyata kamu. Sudah kuduga, serigala tidak cukup pintar untuk merencanakan hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540313,
					"content": "Ternyata kamu yang membantu mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540314,
					"content": "Hanya karena mereka memberikanmu bekas-bekas tulang, dan kamu menganggap mereka keluarga? Apakah kamu sudah lupa siapa dirimu yang sesungguhnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4540315,
					"content": "Cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Iya! Jangan berbicara dengan Razor seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "Apa?! Knights of Favonius membela penjahat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Bukan kami yang menyerang desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
