				"points": []
			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "Siapa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540102,
					"content": "Tunggu, Razor, ini kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540103,
					"content": "Kamu... Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540104,
					"content": "Apa! Jadi kalian benar-benar tidak saling kenal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540105,
					"content": "\"Knight perempuan, merah...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "Tidak kenal. Perempuan ini juga merah, tapi tidak semerah perempuan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540108,
					"content": "Ah, aku paham sekarang. Ini anak serigala yang kalian bicarakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540109,
					"content": "Ya. Namanya Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540110,
					"content": "Tolong bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540111,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540112,
					"content": "Tidak sempat menjelaskan. Kuminta Lupical pergi. Orang-orang datang. Orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540113,
					"content": "Orang-orang tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540114,
					"content": "Aku mengerti, tapi sebelumnya, aku ingin menanyakan beberapa hal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540115,
					"content": "Ada bau darah. Kita harus cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540116,
					"content": "Darah? Jangan-jangan orang-orang bodoh itu diserang serigala?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540106,
					"content": "Sungguh bukan Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
