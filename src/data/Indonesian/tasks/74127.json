					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "Sebentar lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "Setelah selesai, tolong bawakan kepadaku, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
