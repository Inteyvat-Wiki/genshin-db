				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Hm ... Ini \"Taman Peringatan Mary-Ann\"? Kok sama sekali tidak terlihat kayak taman ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Tuan Roialte pasti bakal kecewa. Dia kan sampai mau undang orang ke sini untuk berpidato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Kalau dilihat dari lingkungannya, pidato sih tidak mungkin ya .... Selain itu, bangunan khas juga tidak ada, jadi tidak bisa foto bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Bisa ambil beberapa mekanisme tuh buat dijadiin kenang-kenangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "Hahaha, Anda lucu deh. Tapi, tidak ada tempat untuk ditaruh di Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "Selain itu, meski sudah dibawa pulang, aku masih harus bawa semuanya untuk dinilai harganya, dicatat, diklasifikasikan, terus disegel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "WOI! Kita ini cuma bercanda deh! Enggak usah langsung pikirin sederetan kerjaannya dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Soal mencatat ... aku masih belum dapatkan dokumen itu. Tuan Roialte pasti bakal kecewa lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Apa Choiseul persulit kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Tidak mempersulit sih. Permintaanku memang agak melanggar peraturan. Jadi, wajar kalau dia tidak setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Jadi begini. Institut Penelitian Fontaine kan lagi rencanakan pembangunan ulang. Ada alokasi material dan staf yang perlu dibicarakan lewat Maison Gestion ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "Maison Gestion peduli sekali dengan masalah ini. Jadi, mereka minta Tuan Roialte bentuk satu tim penelitian untuk melakukan penelitian lapangan di dekat Institut Penelitian Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Akhirnya, Tuan Roialte tinggal di Maison Gestion untuk kumpulkan staf, sedangkan aku ke Institut Penelitian untuk koordinasi soal penerimaan tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Kebetulan Institut Penelitian akan kirim surat balasan untuk Maison Gestion. Aku pikir, toh sudah datang, sekalian saja aku kembali sambil bawa suratnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Tapi, Tuan Choiseul malah bilang kalau tindakanku ini melanggar peraturan, dia memaksa tidak mau kasih surat itu padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Melanggar peraturan? Peraturan yang mana lagi sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "Ambil satu dokumen saja juga ada peraturannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Wah, jangan-jangan kita mesti ke sana kemari lagi buat minta cap sama tanda tangan, belum lagi harus dengar omong kosongnya mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Intinya, sebagian besar surat resmi Maison Gestion harus menggunakan mode \"Pengiriman Surat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "Eh? Ja ... jadi gimana kalau departemen yang perlu dikirimin surat jaraknya cuma beda satu blok atau bahkan cuma di seberang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "Ya harus pakai pengiriman surat juga. Semua ini demi menjamin agar semua surat resmi di Maison Gestion bisa \"ditelusuri\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Hidup sudah susah, dibuat makin susah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Aku rasa semua orang sudah terbiasa dengan hal menyusahkan seperti ini deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Sudahlah, kita jangan bicarakan ini dulu. Yuk ke tempat selanjutnya. Aku mau baca catatan yang ditinggalkan Tuan Roialte untukku ... Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "Tempat ini namanya ... \"Aula Akademik\" Institut Penelitian Fontaine. Aneh sekali. Waktu aku ke sini, aku tidak lihat ada bangunan dengan papan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Aku tahu di mana tempatnya. Ikuti aku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Anda memang selalu bisa diandalkan! Tanpa Anda, entah bagaimana nasib pekerjaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Kalau begitu, ayo cepat berangkat. Mungkin masih ada mekanisme lepas kontrol lainnya di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "Apa yang kamu diskusikan sama Choiseul?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
		{
			"id": 7412703,
