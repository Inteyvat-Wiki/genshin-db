				]
			},
			"dialogs": [
				{
					"id": 741270301,
					"content": "Ini \"Aula Akademik\" Institut Penelitian Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Kuakui sih, bangunan ini mirip sekali sama aula. Tapi, akademiknya di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "Akademiknya itu ada di otak penelitinya, tidak kelihatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Ya, sudah. Untung hari ini aku bukan datang untuk belajar. Soalnya, bangunan ini kelihatannya masih cukup ... utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Yah, cuma sisa \"utuh\"nya saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Ehem! Yuk kita jalan-jalan di sekitar sini. Aku rasa pasti ada tempat yang cocok untuk foto bersama di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Aku harus cari sudut yang bagus dulu. Kalau tidak, nanti begitu Tuan Roialte tanya, aku panik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}, tolong bantu aku ambil foto-foto ya. Aku dengar Anda ahli sekali dalam memotret. Pasti hasilnya lebih bagus dari punyaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "Yang jelas tidak di dalam batu ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
		{
			"id": 7412704,
