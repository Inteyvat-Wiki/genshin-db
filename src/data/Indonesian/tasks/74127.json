			"dialogs": [
				{
					"id": 741270101,
					"content": "Seperti yang kutekankan sebelumnya, Gestionnaire terhormat, peraturannya memang seperti itu. Aku juga tidak berdaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "Tuan Roialte memang sudah kirimkan daftar semua dokumen yang diperlukan, aku juga sudah siapkan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Tapi, kamu tidak bisa datang begitu saja untuk \"mengambil dokumennya\". Ini tidak sesuai dengan regulasi pengiriman surat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Eh? Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Haloo, Iaune. Kayaknya lumayan nih kabarmu, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Anda juga. Semua ini berkat bantuan Tuan Roialte dan Tuan Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Eh? Iaune, kamu kenal {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Tentu saja. Sebelumnya {NICKNAME} sudah bantu aku selesaikan banyak masalah. Tanpa dia, aku pasti tidak bisa lanjut bekerja di Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Serius? {NICKNAME} memang pantas diberi Peneliti Honoris Tingkat Lanjutan oleh Institut Penelitian Fontaine ya, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "Aku sangat ahli dalam memberikan dukungan semangat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Bagaimanapun juga, kalau waktu itu tidak ada dukungan dari Anda, aku pasti ... tidak bisa bertahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "Tadi aku dengar Tuan Choiseul bilang kalau Anda ini \"Peneliti Honoris Tingkat Lanjutan\" di Institut Penelitian Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Benar, ada sertifikatnya kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "Terus ada fotonya loh! Di fotonya ada Paimon, tapi sayang Paimon enggak punya sertifikat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#Benar, sebagai pengakuan atas pencapaian {NICKNAME} yang sebelumnya, Institut menganugerahi gelar Peneliti Honoris Tingkat Lanjutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#Mengenai apa \"pencapaiannya\" ... biar {NICKNAME} saja yang beri tahu padamu. Sekarang kita bahas yang penting dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "Aku memang tidak bisa berikan dokumen itu kepadamu sekarang, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Tapi, sebelumnya kamu bilang kalau kamu mau minta satu peneliti untuk jadi pemandumu dan ambil foto di sekitar Institut Penelitian Fontaine .... Ini sih tidak masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Aku pikir {NICKNAME} cocok sekali untuk pekerjaan ini. Dia sudah tahu betul medan di area sekitar sini, dia pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#Bagaimana menurut Anda, {M#Tuan}{F#Nona} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Tidak masalah. Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Hati Anda baik sekali. Selama ada Anda, aku jadi tenang. Waktu aku datang, aku lihat ada mekanisme yang lepas kontrol, juga ada monster di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Tapi, foto-foto bukan yang paling penting sekarang ... Sebenarnya, Tuan Choiseul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Iaune, aku juga mau bantu kamu, tapi peraturan tetap peraturan. Aku juga tidak bisa berbuat apa-apa. Tolong jangan persulit aku deh, aku ini cuma tukang cap dokumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Ya sudah .... Aku akan balik dan diskusikan masalah ini lagi dengan Tuan Roialte ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Sampai jumpa, Tuan Choiseul. Semoga hari Anda menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Terima kasih. Semoga kamu menikmati waktumu di Institut Penelitian Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}, kalau begitu, tolong pandu jalannya. Kita pergi ke \"Taman Peringatan Mary-Ann\" dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "Aku senang bisa membantu Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Aku cuma perbaiki mesin stempel otomatis kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Nanti aku bawa kamu terbang lagi ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Aku senang sekali bisa bertemu denganmu di sini! Kebetulan sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
