					}
				]
			},
			"dialogs": [
				{
					"id": 741270501,
					"content": "Semoga Archon memberkatiku. Jangan sampai mekanisme itu datang dan buat kekacauan lagi ... Iaune, kenapa kamu ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "Tuan Roialte suruh ke sini untuk meneliti. Jadi, aku sekalian datang berkunjung sambil bawakan kopi untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Tapi, harus diakui, lingkungan kerjamu memang ... berat. Aku pikir setidaknya ada satu ruangan yang layak ditempati di \"kantor\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Iaune terkasih, terima kasih kopinya. Kalau soal lingkungan pekerjaanku ... ini sudah cukup kok. Coba lihat sekelilingmu, setidaknya aku punya ruangan dengan atap utuh, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "Kamu masih bertanggung jawab untuk periksa kualifikasi di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! Eh, salah, sekarang sudah jadi Peneliti Honoris Tingkat Lanjutan, kan. Senang bertemu dengan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Iaune, kok kayaknya cemas? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "Ah ... jadi begini ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Iaune menceritakan masalah yang terjadi sebelumnya dengan wajah yang cemas ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Eh? Surat ini ... apa ini dokumen rahasia yang penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "Bukan. Isi surat balasan kayak begini sih biasanya cuma: \"Aku mengerti\", \"Aku tidak apa-apa\", \"Aku tidak tahu\", dan sebagainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "Paling-paling disalin dan dikirimkan ke departemen lain untuk memberi tahu semua orang kalau masalah ini perlu diperhatikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Oh, pantas saja aku juga terima surat ini .... Nih, kamu lihat, yang ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "A-Apa?! Padahal Tuan Choiseul bilang kalau dia belum kirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "Oh, maksudnya dia belum mengirim \"surat ke luar departemen\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Dia ngomongnya sepotong-sepotong deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "Orang Institut Penelitian Fontaine ... memang jago mancing emosi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Dari raut mukamu, pasti ini dokumen yang kamu mau. Aku sudah baca berkali-kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Ini sama dengan dokumen yang kamu mau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#Aha, {NICKNAME}, pengamatanmu tajam sekali. Iaune, semua surat yang dikirim Choiseul pasti sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "Kenapa kamu tidak langsung bawa pulang saja dokumenku ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "Eh? Sebentar, kalau Iaune bawa dokumenmu, kamu jadi enggak punya apa-apa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Hahaha, coba kamu lihat tempatku ini. Tidak ada orang yang peduli kalau aku tidak sengaja kehilangan satu surat yang tidak penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Boleh juga idenya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Tuh, aku tidak bakal minum kopimu secara cuma-cuma, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "Tidak, Tuan. Aku tidak mungkin seperti itu. Ini melanggar peraturan. Aku akan balik dulu dan tunggu sampai aku dapat surat resminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "Ya ampun ... Iaune! Fleksibel sedikit dong, jangan jadi orang bodoh. Kenapa harus paksakan diri sendiri kayak begitu sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Tidak ada yang tahu kapan surat itu bakal sampai ke tanganmu. Kalau kamu dapat suratnya satu hari lebih cepat, bisa mulai kerja lebih cepat, dan menyelesaikan masalah repot itu secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "Tidak, Tuan. Terima kasih atas kebaikan hatimu. Tapi, aku tidak akan melanggar aturan. Ini tuntutan pekerjaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Tuan Desnos, Paimon, aku pamit dulu. Tuan Roialte masih menunggu laporanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune pergi dengan langkah yang berat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "Duh, Iaune, si bodoh ini. Dia selalu keras kepala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Semua orang sibuk mencari cara supaya bisa hidup lebih nyaman. Tapi kok dia harus membuat dirinya menderita begitu sih? Padahal masalahnya pun sepele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "Sifatnya memang gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Salut deh ... tapi takut juga sih. Pantas dia tidak punya banyak teman di Maison Gestion. Cuma Tuan Roialte dan Semaine yang gaul sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "Aku juga temannya kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "Paimon juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Hahaha, baguslah kalau gitu. Anda harus sering mengobrol dengannya. Aku merasa mental Iaune memburuk dari hari ke hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Soal surat, aku akan cari cara. Nanti aku cari Tuan Choiseul dan minta dia untuk serahkan masalah pengiriman surat kepadaku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Kalau dia setuju, aku akan kirim suratnya untuk Iaune secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "Aduh, kalau berteman sama orang bodoh memang butuh usaha ekstra ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "Iaune memang orang seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "Kalau gitu, masalahnya selesai dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
