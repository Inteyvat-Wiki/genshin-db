					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "Oh, kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "Bagaimana keadaan benihnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "Masih tidak ada yang bertunas juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "Permukaan bijinya sudah kuperiksa, tidak ada tanda-tanda akan bertunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "Kenapa bisa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "Aku pasti tidak salah mengenalinya. Aku menggalinya keluar dari ruang penyimpanan berdasarkan catatan si hantu tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "Berdasarkan catatannya, masa simpan benih-benih itu sangat lama. Asalkan kering, mereka tidak akan rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "Cara budidayanya seharusnya tidak ada masalah. Aku tidak pernah lupa menyiram dan memupuknya. Sebenarnya kenapa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Jangan khawatir, Kek. Coba kita tunggu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "#Buah dan bunga yang tiap kali Paimon dan {NICKNAME} petik di alam liar juga butuh beberapa hari biar bisa keluar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Bersabarlah, Kek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "Yah memang cuma bisa kutunggu saja. Kalian ada waktu hari ini? Bisa tolong aku siramkan air untuk mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "Tanah pembibitannya baru saja kugemburkan seharian, sekarang betul-betul tidak ada tenaga buat kembali dan mengambil air lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Coba terus disiram air.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
