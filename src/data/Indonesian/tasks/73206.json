			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "Aku terus menyirami dan memupuknya ... Tapi, apa itu akan benar-benar berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060302,
					"content": "Aku sudah tidak tahu lagi. *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060303,
					"content": "Setelah sekian lama tak berbuat apa-apa sampai hari ini, aku akhirnya memutuskan untuk melakukan sesuatu. Tapi akhirnya masih saja tidak berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060304,
					"content": "Maafkan aku, hantu tua. Aku sudah mengecewakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060305,
					"content": "Kakek Affan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060306,
					"content": "Anak-anak, kalian pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
