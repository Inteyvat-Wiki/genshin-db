			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Mawar oh mawar, kabulkanlah permintaanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Eh? Kalian kok masih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Kenapa kakek tinggal di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Hehe, pokoknya aku ini cuma seorang tua yang aneh. Jarang sih ada yang bertanya misalnya \"kenapa si tua mengerjakan ini itu\" kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Aku selalu ingin mengadu nasib di luar dan memanfaatkan kesempatan untuk melakukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Hampir saja aku ikut Eremite tidak lama sesudah menikah. Tapi kupikir-pikir lagi, aku tidak bisa meninggalkan istriku dan pergi berkelana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Lalu aku bertemu dengan pedagang kaki lima dan lagi-lagi ingin mengikutinya berbisnis. Tapi akhirnya usahaku tidak berhasil karena uangku tidak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Selanjutnya istriku meninggal dan tidak ada lagi yang perlu kukhawatirkan. Tapi aku sudah terlalu tua, tidak bisa berpergian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Aku banyak menunda sesuatu sampai sekarang. Dan kini aku sudah ketinggalan banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Kupikir-pikir lagi ternyata aku bukan bagian dari desa ini dan juga bukan bagian dari tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Akhirnya aku seorang diri pindah ke pinggiran desa dan hidup dengan nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Lalu puluhan tahun berlalu begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Akan kupanggil kalian kalau bunga-bunga ini sudah mekar. Mereka mungkin akan mekar besok atau lusa, kalian ada waktu melihatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Baiklah, aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Mawar oh mawar, kabulkanlah permintaanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Tentang Si Hantu Tua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Cuma pendatang dari luar saja yang akan bertanya tentang si hantu tua. Semua anak-anak di desa kami tahu nama itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Kalau ada anak yang bandel, orang tuanya akan menakut-nakutinya: nanti si hantu tua akan datang dan menangkapmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Tidak ada seorang pun dari anak muda ini yang kenal si hantu tua, tapi memakai nama itu untuk menakut-nakuti orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Sewaktu aku kecil, aku pernah bertemu dengan si hantu tua itu sendiri. Memang betul dia tidak suka anak kecil, tapi tampangnya tidak seseram itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Aku tidak tahu kenapa nama si hantu tua bisa sampai tersebar. Mungkin saja gara-gara sekelompok pengangguran yang suka membicarakan orang sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Kalian bukannya teman ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Waktu masih kecil aku sering bermain dan keluyuran di dekat taman bunga miliknya. Begitu dia tahu, dia langsung mengusirku dengan cangkul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Dia mungkin mengingatku sebagai anak nakal. Mana mungkin dia ingat diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Walaupun belum tentu dia mengenalku, tapi aku masih mengingatnya dan taman bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Tidak ada salahnya juga kan kalau kuanggap dia temanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Untuk mengingat taman bunganya, aku juga menanam bunga-bunga ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
