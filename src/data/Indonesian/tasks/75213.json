			"dialogs": [
				{
					"id": 752130201,
					"content": "Perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Eh? Memang boleh? Semua staf toko sudah dikirim, tapi sekarang masih ada pesanan pengiriman yang mendesak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Ada catatan pada pesanan agar dikirim ke <color=#00E1FFFF>tamu dengan celana biru di pantai</color>, yang penting sampai tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Terima kasih banyak. Selain biaya pengiriman pesanan ini, resep minuman kami juga akan diberikan sebagai imbalan untukmu. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
