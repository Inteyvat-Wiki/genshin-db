			"dialogs": [
				{
					"id": 752130601,
					"content": "Hai, ini minumanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "Oh! Oh! Ternyata kalian yang mengantarkan minuman ya, aku sudah heran kenapa tidak kunjung diantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "Semua ini gara-gara kamu. Kamu meninggalkan catatan \"Untuk pelanggan dengan celana biru di pantai\", tapi malah bersembunyi di dalam pasir! Kami sudah susah payah cari yang pakai celana biru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Kamu harus kasih kami bayaran dua kali lipat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah, maaf. Aku lupa sudah menulis catatan itu. Harusnya aku taruh celanaku di samping untuk mempermudah kalian menemukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Tapi ... kenapa kamu kubur diri di pasir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Soalnya seru! Kudengar, banyak orang yang melakukan hal ini waktu liburan, jadi aku juga mau coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Tapi, posisi tubuhmu kurang tepat. Kamu terlihat seperti wortel yang tertancap di tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Hmm? Loh, memangnya kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Orang lain bisa jatuh karena tersandung, kamu sendiri juga bisa cedera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Baiklah, aku bakal mempertimbangkannya, ini bayaran tambahannya, terima kasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
