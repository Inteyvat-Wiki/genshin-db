			"dialogs": [
				{
					"id": 747070101,
					"content": "Baik, bagus kalau begitu! Coba sekali lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Bagus. Daaaan ... cut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Ada Columbina sama Chiori juga! Kalian masih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Iya, kita baru saja selesai syuting adegan sekundernya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Oh! Maksudnya yang pakai ikan buat aktornya itu ya? Gimana hasilnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Kita berhasil ketemu aktor yang pas berkat kalian, jadi semuanya lancar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Kalian berdua berbakat sekali mengurus akuarium ini. Furina tadi juga bilang, gara-gara kalian dia jadi mau syuting dokumenter bawah air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Ah, kalian terlalu memuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Aku juga suka. Aku bisa rasakan ikan-ikan kecil ini bahagia sekali waktu berenang keliling. Kalian jaga mereka dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747070111,
					"content": "Aku hanya harap akuarium ini bisa tetap di sini. JAdi, aku bisa berkunjung kapan pun aku mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Kalau kamu benar-benar masih tidak rela, gimana kalau kita tambahkan beberapa adegan pemandangan lagi di filmnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Benar juga. Kita harus ambil lebih banyak lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Lebih banyak ... ikan lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747070115,
					"content": "Lebih banyak adegan lagi! Ayo, ayo. Cahaya, kamera ... mana supervisor naskahku? Ayo semuanya, siap di posisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon sih sudah siap! Tapi kalau ngasih arahan ke ikan ... ini pengalaman super baru sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Bagus deh kalau kalian suka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}