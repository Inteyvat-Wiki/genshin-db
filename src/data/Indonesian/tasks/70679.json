			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Halo, halo, Kita ketemu lagi! Kebetulan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Eh? Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Gygax! Aku Gygax! Itu loh, yang dari Jejak Sang Angin. Masih ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Oh, kamu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Aku sudah ingat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Bilangnya begitu, tapi air muka Anda mengisyaratkan sebaliknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Tapi bagaimanapun, coba lihat di sini deh. Kalau Jejak Sang Angin, Anda pasti ingat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Tempo hari kan Anda sudah coba main beberapa kali dan kasih banyak pendapat. Semuanya bagus-bagus, aku langsung terapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Aku sudah revisi peraturannya dan permainannya satu kali ... Errr ... lebih tepatnya, beberapa kali sih setelah waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Jadi makin ribet dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Oh, tenang saja kalau soal itu. Anda pasti bakal suka sama permainan yang baru. Aku jelaskan secara singkat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Pertama-tama, kali ini menambahkan \"Pengirim Sinyal\" ke dalam Jejak Sang Angin yang baru ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Pemberontak cuma perlu mengaktifkan 4 Pengirim Sinyal untuk mengalahkan Pemburu, terus menang deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Terus si Pemburu ... Yah, masih sama seperti sebelumnya sih, kalau berhasil tangkap semua Pemberontak, dia menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Nah tapi di Jejak Sang Angin kali ini, Pemberontak yang tertangkap Pemburu tidak akan langsung keluar. Tapi bakal ditempatkan dulu di \"area pengamatan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Setelah beberapa saat, atau dengan dibantu oleh Pemberontak lain, maka dia bisa kabur dari \"area pengamatan\" tersebut dan melanjutkan permainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Tapi kalau dia tertangkap lagi ya ... dia gugur sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Kok kayaknya rumit juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Tenang, tenang. Dengarnya saja yang repot. Main beberapa kali juga Anda akan langsung bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "Ya sudah, aku coba deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Bagus! Silakan, sebelah sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Aku masih sibuk sama yang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Tidak masalah, datanglah kalau senggang. Aku masih bakal di sini kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Peraturannya banyak juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Kamu tidak tambahkan permainan yang aneh-aneh, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Kamu ... dari Jejak Sang Angin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Gygax loh! Ya sudah, toh Anda tidak salah. Aku juga tidak marah kalau Jejak Sang Angin lebih terkenal dari aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}