				},
				{
					"id": 4530704,
					"content": "Kira-kira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "...um, sepertinya lebih dari 2 meter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "...Paimon, kamu, pernah lihat serigala?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Hei! Serigala hewan yang misterius, biasanya jarang sekali bisa lihat.",
