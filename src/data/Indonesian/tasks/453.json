			"dialogs": [
				{
					"id": 4530501,
					"content": "Bulu serigala, kudengar orang-orang Liyue menggunakannya untuk membuat kuas kaligrafi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "Warna bulu ini, sepertinya beda sekali dengan warna bulu serigala Mondstadt. Apa mereka serigala dari tempat lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "Bulu serigala berbeda-beda warnanya, tergantung dari bagian tubuhnya. Kamu tidak tahu, kan – ini bulu bagian mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Tapi, lihat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "Sehelai bulu lain, tapi, sepertinya ada sesuatu di ujungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Satu buah biji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "Ini biji Wolfhook. Lihat, ada kail kecil di bijihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Di Mondstadt, tanaman ini hanya bisa ditemui di Wolvendom dan Brightcrown Canyon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Jadi... pelakunya memang serigala dari Wolvendom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Benar, dari daerah sana, tapi mungkin juga ada kelompok serigala lain yang melintas daerah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "Meskipun masih samar-samar, tapi setidaknya petunjuk ini cukup membantu kita untuk bisa memulai investigasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Aku akan menemui penduduk desa dulu sebelum pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "Apakah ada yang istimewa dari bagian itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
