			"dialogs": [
				{
					"id": 4530601,
					"content": "Bagaimana investigasimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530602,
					"content": "Waaa, kamu sudah bisa berdiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Aku sudah pulih. Rasanya, seperti kembali dari neraka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530604,
					"content": "Jadi apa yang kalian temukan, Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530605,
					"content": "Dari bulu serigala yang ada di tempat kejadian, kita tahu kalau serigala-serigala itu datang dari Wolvendom. Tapi,kita belum punya informasi apa-apa lagi selain itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Tapi jangan khawatir, aku akan pergi ke Wolvendom, dan menginvestigasi lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Knights of Favonius tidak akan membiarkan bahaya ini berlangsung lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Baiklah, lebih baik terlambat daripada tidak sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530609,
					"content": "Wah, orang ini tidak sopan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Sementara waktu, kita akan mengurus masalah ini sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530611,
					"content": "Hei, tapi jangan gegabah dan membahayakan orang-orang kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Hah! Kami melakukan hal-hal agak berbeda di sekitar sini, kalian mungkin terbiasa patuh para peraturan. Pokoknya bagi kami, mereka harus membayar apa yang telah mereka lakukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530613,
					"content": "Ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins the Marvelous"
				},
				{
					"id": 4530614,
					"content": "Gawat... buruk sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Maksudku nasib yang akan menimpa mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Menurutku juga begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Terkadang anak-anak muda terlalu impulsif. Kalau tidak keberatan, tolong bantulah aku untuk mengawasi mereka agar mereka tidak terus membuat onar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Tenanglah, itu alasan kami datang ke sini. Meskipun orang itu agak menyebalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Serahkan saja pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "Waktunya kita pergi ke Wolvendom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
