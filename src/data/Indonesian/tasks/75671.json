			"dialogs": [
				{
					"id": 756710101,
					"content": "Cip cip! Coo coo! Cip cip cip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710102,
					"content": "Ini ... apaan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Sa-sandi rahasia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Iya dong! Ini teknik untuk berkomunikasi dengan Finch yang imut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710106,
					"content": "Oh, sepertinya aku lupa menyapa kalian, dan juga kata pembuka yang tidak boleh ketinggalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710107,
					"content": "Wahai pengembara baik hati yang lewat, aku Basima V, seorang pelajar Amurta, pedagang baru, dan ahli hewan yang menggemaskan, mengucapkan salam kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710108,
					"content": "Silakan. Tenangkan tubuh, kosongkan pikiran, lalu dengarkanlah: sebab ada urusan teramat penting yang hendak kuberitahukan kepadamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710109,
					"content": "\"Finch paling lucu\" ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Tepat sekali! Selamat, kamu sudah terinfeksi keimutan Finch sampai enggak sabar langsung jawab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710111,
					"content": "Aneh, enggak tahu kenapa, kalau lihat permainan di atas meja, kata-kata itu langsung muncul di kepala Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Kamu ingat enggak sih, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Kita pernah bertemu dengannya sebelumnya, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "Benar! Kita sudah bertemu lebih dari sekali, dan melihat kalian masih penuh semangat seperti ini membuat hatiku terasa hangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710117,
					"content": "Yah intinya, mau coba main tidak? Edisi ke-17 nih, Bola Finch Ding Dong generasi ketiga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710118,
					"content": "Sambil main santai, kamu bisa ketahui cerita tentang Ancient Scarlet-Plume Finch besar yang mengalahkan burung camar pencuri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710119,
					"content": "Oke, game yang santai dan nyaman, kami juga suka kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Ayo main!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Ya! Semoga kalian bisa temukan cara main yang paling cocok untuk diri sendiri dan menemukan kesenangan yang unik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710121,
					"content": "Cepat mulai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Mulai sekarang juga bisa panggil \"Finch paling lucu\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Benar! Tidak masalah kalau belum bisa ingat masa lalu, yang penting nikmati saja saat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710104,
					"content": "Ko-kode rahasia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
