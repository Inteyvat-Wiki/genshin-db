				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "Ad astra abyssosque! Selamat datang di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Belakangan ini kami telah menerima sebuah misi dari Fishing Association. Mereka mengatakan bahwa ada keanehan pada aktivitas perikanan di area perairan sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Tapi situasi spesifiknya tidak bisa dijelaskan. Apa kamu bisa membantu menyelesaikannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Kalau kamu yang mengerjakannya, tidak peduli apa pun masalahnya, pasti bisa kamu selesaikan dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Fishing Association? Yang memancing ikan itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Eh? Memancing? Aku tidak begitu mengerti... Memancing yang kamu katakan itu, maksudnya bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Duh! Fishing Association. Dari namanya saja sudah jelas kalau Asosiasi ini menangkap banyak ikan enak buat dimakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Jangan buang-buang waktu lagi deh. Yuk kita cepat pergi ke sana! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
