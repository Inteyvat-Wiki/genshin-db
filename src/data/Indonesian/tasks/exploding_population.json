					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Di sini tempatnya! Lihat ikan-ikan kecil di air? Indah sekali yah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Ini alat-alat yang kusiapkan untukmu. Ada joran pancing, umpan, dan resep membuat umpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Pertama, kaitkan umpan di kailnya, lalu bidik ke tempat ikan berkumpul... dan lempar kailnya! Lalu, tunggu sampai ada ikan yang memakan umpannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Katanya seorang pemula memiliki \"keberuntungan pemula\". Dulu saat masih pemula, aku juga pernah menangkap seekor Bass besar yang panjangnya lebih dari setengah meter! Ayo, kamu coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Semoga aku bisa memancing seekor Paimon lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Hei! Kamu tidak boleh punya Paimon lain selain Paimon yang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? Nama yang aneh, itu jenis ikan juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "Paimon adalah \"makanan laut\" ajaib yang pernah kupancing terakhir kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Hei! Dari makanan darurat, sekarang berubah jadi makanan laut ajaib nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "Ternyata begitu! Ternyata kamu sudah punya pengalaman memancing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Aku jadi semakin menanti-nantikan hasil tangkapanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
