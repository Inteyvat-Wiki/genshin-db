			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Bagaimana? Dari ekspresi wajahmu, hasil tangkapanmu pasti lumayan, kan? Coba aku lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh? Ikan spesies baru! Bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Kamu sudah hampir sehebat diriku dulu! Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Kamu juga bisa menangkap ikan dengan tangan?",
