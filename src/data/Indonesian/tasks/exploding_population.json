					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "*uhuk* Kelihatannya ikan biasa seperti ini kurang seru untukmu. Aku seharusnya berikan sedikit tantangan untukmu...",
