			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "Ikan-ikan belakangan ini aktif sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "Ada yang perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "Ah, akhirnya ada yang datang membantu! Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "Namaku Nantuck, pemancing berpengalaman dari Mondstadt Fishing Association. *uhuk uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Belakangan ini banyak spesies ikan baru yang muncul di perairan sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "Aku segera menghubungi sesama pemancing di area lain, dan ternyata tempat lain juga mengalami situasi yang serupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "Orang-orang bilang kalau ini pasti ledakan populasi ikan Teyvat yang paling besar di abad ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "Alasan sebenarnya belum diselidiki jelas, tapi kutebak pasti ada hubungannya dengan perubahan lingkungan ekologis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Oh... Jadi ikan-ikan ini terlalu banyak dan menimbulkan masalah buat kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "Jangan khawatir, Paimon akan mengurusnya! Asal mereka enak saja sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Haha, sebenarnya bukan masalah sih. Bagi Fishing Association, tentu saja semakin banyak ikan semakin baik. Hanya saja tenaga kerjanya juga harus cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "Jujur saja, dengan tenaga kerja yang kami miliki sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "Menangkap semua spesies ikan baru dalam waktu singkat untuk diteliti... Hal ini benar-benar membuatku merasa tertekan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "Tapi di sisi lain, bukankah hal ini adalah peluang bagus agar Fishing Association dapat berkembang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "Jadi aku akhirnya mengajukan permohonan misi di Adventurers' Guild. Bagaimana? Apa kamu tertarik bergabung dengan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "Memancing ikan sangat seru loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "Tidak masalah, aku ahli dalam memancing ikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "Bagus, sungguh anak muda yang penuh semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "Jadi... Ayo kita pergi ke Cider Lake dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "Ada lokasi pemancingan yang sudah kusiapkan untuk pemula. Aku akan mengajarimu dasarnya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "Apa aku boleh turun untuk menangkapnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Kalau langsung menyelam bukannya berbahaya ya? Petualang macam kalian benar-benar pemberani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Sayangnya, ikan-ikan itu tidak seberani kalian. Semua ikan itu pasti lari ketakutan kalau ada raksasa yang melompat ke dalam air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "Lebih baik kalian tidak melakukan hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
