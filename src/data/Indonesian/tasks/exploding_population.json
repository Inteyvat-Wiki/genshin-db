					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "Kamu mungkin tidak tahu, karena perbedaan lingkungan dan makanan, jenis ikan yang sama sekalipun akan memiliki perbedaan besar antar individunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Meski mereka terlihat sangat mirip, beberapa ikan akan terlihat sangat aktif dan energik. Mereka akan melompat sewaktu-waktu dan sangat mencolok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "Ikan-ikan inilah yang memiliki nilai jual serta nilai estetika yang lebih unggul.",
