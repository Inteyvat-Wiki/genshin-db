			"dialogs": [
				{
					"id": 733480901,
					"content": "*huff* Dana sedikit begini, gimana risetku bisa ada kemajuan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Eh, permisi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Peneliti Purbiruni? Oh, kamu lagi cari Sadife ya? Hmm, aneh ... ada juga ya ternyata orang yang cari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Dia belakangan ini lagi sibuk membereskan urusan di Akademiya, harusnya ada di sekitar sana deh ... Ada perlu apa kamu cari dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Mengenai surat rekomendasi Khedive ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khadive? Risetnya sudah berakhir kah? Enak yah kalau punya uang, bisa undang satu tim peneliti buat menemaninya pergi meneliti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Sementara aku, pengajuan subsidi untuk meneliti ladang saja tidak disetujui ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Kamu tahu Khadive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Iya dong, peneliti yang memusingkan pendanaan dan tidak menghasilkan uang seperti kami ini, sudah lama dengar tentang kekayaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Wah, kalau gitu ... Khadive ini ... Peneliti dari klan mereka, kaya banget dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Kalau gitu kita bisa dapat banyak imbalan dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Tentu tidak. Bocah bernama Khadive ini pengecualian, kamu jangan berkhayal apa pun tentang peneliti Purbiruni dan Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Terutama yang mengambil jurusan astrologi, mempelajari sejarah dan biologi ... Beberapa arah riset ini, keberuntungannya jelek bahkan pengajuan pendanaan tidak disetujui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
