					"Sadife"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "Pengembara, Anda sudah kembali! Kotakku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Bagus sekali! Terima kasih ... Huh, kalau dipikir lagi, Anda datang bawa surat rekomendasi, tapi aku malah minta tolong pada Anda, aku jadi sungkan ... Harap terimalah beberapa Mora ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Seperti yang selalu dikatakan oleh Purbiruni ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Eh? Anda juga tahu kalimat ini? Iya, kami para Purbiruni memang memegang teguh kata-kata ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Tetapi kalimat ini digunakan untuk menegur kami, kapan pun tidak boleh karena harta atau alasan lainnya tergoyahkan dari prinsip riset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Lagi pula, jika seorang peneliti menganggap mengejar keuntungan sebagai prinsip akademis utamanya, maka ... dia tidak layak menjadi seorang peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Tetapi Anda berhak mendapatkan imbalan yang layak karena bekerja keras untuk membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Sekali lagi terima kasih atas bantuan Anda. Jika suatu saat Anda perlu bantuanku, jangan sungkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "\"Uang tidak boleh menjadi imbalan atas kecerdasan\", ya kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Sudah kuambil balik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
