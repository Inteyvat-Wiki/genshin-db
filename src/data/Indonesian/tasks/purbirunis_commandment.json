			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Oh, kamu datang lagi? Ketemu tidak sama Purbiruni? Harusnya tidak sulit, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Ketemu sih sudah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hmmm? Kamu kok terlihat ragu, ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Menjelaskan kepada Khedive hal yang berkaitan dengan Sadife ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah dasar si Sadife ... Dia memang terkenal keras kepala, bahkan terkadang gurunya tidak bisa menghadapinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Bahkan juga menolak semua pendanaan, bersikeras dengan penelitiannya sendiri, dan bilang ingin menjaga kemurnian penelitiannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Apa ini yang dimaksud \"uang tidak boleh menjadi imbalan atas kecerdasan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Ini adalah prinsip riset para peneliti Purbiruni ... Haha, kami Pursina sih lebih fleksibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Hmmm ... maksudnya bukan begitu juga sih. Cuma, aku punya lebih banyak Mora saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Kok kamu bisa banyak uang gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "Kamu kenapa curiga gitu sama aku? Uangku juga dihasilkan dari kerja keras. Apa kamu tahu seberapa ribetnya melakukan perdagangan berjangka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Perdagangan berjangka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Melakukan perdagangan berjangka ... Harus memperhatikan volume perdagangan barang, harus memperhatikan tren pasar, juga menimbang arah investasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Aku awalnya cuma investasi sedikit uang buat coba-coba, karena aku tidak mau hal itu memengaruhi risetku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Tapi siapa sangka ... Huh! Siapa sangka semakin banyak aku menghasilkan uang, semakin banyak juga uang yang aku taruh di bursa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Profesiku adalah peneliti! Aku ingin melakukan riset, aku ingin melakukan hal akademis! Yang aku inginkan adalah hasil akademis, bukan Mora! Aku selalu mengatakan ini kepada diriku sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Tapi setiap aku ada di Sumeru, aku tanpa sadar berjalan ke bursa, melakukan perdagangan berjangka lagi dan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Uang di akunku semakin banyak, tapi riset akademisku tidak ada kemajuan sedikit pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Karena itu! Aku mengundang orang sebanyak ini memasuki Chasm untuk meneliti bersama. Asalkan berada di tempat tanpa bursa seperti ini, aku baru bisa dengan tenang melakukan riset akademis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Kalau riset tidak ada hasilnya, aku ... aku tidak akan keluar dari Chasm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Kamu dapat uang dari perdagangan berjangka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Kok kamu bisa sekaya ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Tapi terjadi sesuatu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
