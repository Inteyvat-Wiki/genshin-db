				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Tunggu! Tunggu! Stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "*huff* Cuma sekotak buku, tidak perlu sampai begitu deh. Kalau mau, nih semua aku kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "Segini doang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Aku bersumpah demi langit! Waktu kami gali cuma ada ini doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Selain buku, di dalam juga ada beberapa batu dan lumpur di dalam botol ... Yah, ada beberapa permata yang indah juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "Kalian ambil permatanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Woi! Sini balikin permatanya! Itu semua sampel geologis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Sampel ... Geologis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Sini balikin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Eh oke! Balikin! Cepat balikin semuanya! Masukkan semua barang ke dalam kotak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Barang ... Barangnya semuanya ditaruh di dalam kotak. Kami pamit duluan ya ... Hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "Barang yang Sadife cari seharusnya semua ada di dalam, ayo bawa balik kotaknya ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "Tapi enggak nyangka banget ya dia sendirian masuk ke padang pasir. Gali sampel sampai banyak gini, belum lagi dicatat juga, memang peneliti tulen ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "Aku hitung sampai TIGA.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Yakin ya tidak ada yang lainnya lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
			"id": 7334803,
			"completionStepIds": [
				7334805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
