			"dialogs": [
				{
					"id": 733480101,
					"content": "Tapi ... Kalau tidak ada sampel itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Mengenai Purbiruni ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Benar. Aku \"Herbad\" yang sekarang. Maaf, Anda ada perlu apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "Mengenai masalah akademis? Tapi dilihat dari tampilan Anda, tidak seperti peneliti Akademiya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Mengenai surat rekomendasi Khedive ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Khedive ya ... ini Khedive yang tulis sendiri? Sebentar, aku lihat dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Iya, sepertinya kemajuan risetnya di Chasm lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "... Survei jamur ... Lingkungan akuatik ... Fosil biologis purba ... Lingkungan geologi khusus ... Sampel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Bagus, bagus, bagus! Indera penciuman dan kemampuan penelitian akademisnya masih sebagus ini, benar-benar tidak mengecewakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Huh ... Meskipun aku tidak suka untuk mengakuinya di depan orang-orang, tetapi kemampuan akademis Pursina memang layak dipuji ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Lagi pula, di suratnya Khedive juga berkali-kali menekankan tentang bantuan Anda padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Berkat bantuan Anda, risetnya \"berjalan mulus dan mendapatkan hasil yang bagus\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Tidak perlu diulang-ulang terus deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Oh ya? Ehem, maaf deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Setelah dia kembali ke Akademiya nanti, sejarah akademis Pursina pasti akan mencatatkan sebuah prestasi cemerlang yang baru lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Oh ... Satu lagi, pertemanan ribuan tahun antar perguruan kami, pasti akan meningkat pesat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "Pokoknya, di saat yang sama, aku mewakili Purbiruni dan Pursina untuk berterima kasih kepada Anda sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Oh iya, dia di suratnya juga memintaku menyiapkan hadiah untukmu ... Oke tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Kamu tidak akan memberiku surat sebagai imbalan, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Tentu saja tidak! Anda bekerja keras membantu Khedive meneliti ke semua tempat. Jadi, sudah wajar membayar Anda dengan Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Tapi ... Tolong maafkan aku. Hari ini aku keluar rumah buru-buru, jadi tidak bawa banyak Mora. Kalau Anda tidak keberatan, silakan tunggu sebentar di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Walaupun mereka berdua peneliti yang hebat tapi penampilan dia beda banget ya sama Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Dia kayaknya ... enggak punya uang deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "Ma-Mana mungkin? Purbiruni adalah keluarga bangsawan peneliti, tidak mungkin ada kesulitan finansial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Yah memang sih, kami menginvestasikan sebagian besar finansial ke riset. Buat kehidupan sehari-hari ... jadi tidak begitu mewah sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Tapi ini tidak menghambat riset kami. Sebaliknya, justru karena kami tidak dibutakan oleh keinginan materi, makanya kami baru bisa melihat jalan kebijaksanaan dengan lebih jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Aku akan pulang menyiapkan imbalan untuk Anda. Tapi sebelumnya, aku ada satu permintaan yang lancang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "Aku baca di dalam surat yang Khedive tulis kalau Anda sangat gesit, dan punya pengalaman bertempur yang banyak. Anda adalah seorang petualang luar biasa, satu di antara sejuta ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Kalau! Kalau Anda bersedia, bisakah membantuku? Beberapa waktu lalu, demi survey lingkungan geologis suatu wilayah, aku sendirian masuk ke padang pasir untuk meneliti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Karena ... aku tidak punya uang, jadi aku tidak menyewa pengawal. Kupikir kalau cuma perjalanan singkat begitu harusnya aman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Tapi, aku malah kena sial. Di jalan pulang aku diserang Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Meskipun aku kembali ke kota dengan selamat dan juga tidak ada yang terluka, seluruh sampel geologis dan kotak catatan jadi hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Di mata pedagang dan Treasure Hoarder, kotak itu mungkin tidak berharga ... Tapi di mataku! Barang di dalam kotak itu super berharga, tidak bisa tergantikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "Selama beberapa lama aku tidak menemukan petualang yang bersedia membantuku ... Pengembara, bisakah Anda menolongku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Terima kasih banyak! Anda benar-benar penyelamatku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Aku akan menandai peta lokasi di mana kami diserang. Kotak itu pasti ada di sekitar sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Aku sudah dengar cukup banyak dari dia sendiri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Maaf, apakah Anda peneliti Purbiruni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
