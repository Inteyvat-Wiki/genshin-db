			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "\"Sersan Anton menemukan sebuah lonceng besar di sebelah tenggara, dan ada aksara 'kaum mereka' yang terukir di dinding ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Jurnal Fatui"
				},
				{
					"id": 710430102,
					"content": "\"Mirip dengan lonceng yang ditemukan kapten di reruntuhan sebelah barat laut. Apa mungkin ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Jurnal Fatui"
				},
				{
					"id": 710430103,
					"content": "\"Kirim Snezhevna dan Fadeyka, bunyikan kedua lonceng di kedua lokasi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Jurnal Fatui"
				},
				{
					"id": 710430104,
					"content": "\"Suara siulan menakutkan bergema di dinding, dan kabut hitam menghilang. Tidak bisa dijelaskan ... Suaranya seakan-akan mengumumkan bahwa ada yang datang ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Jurnal Fatui"
				},
				{
					"id": 710430105,
					"content": "\"Sepuluh orang tewas, dan dua garda depan menderita kerugian besar. Kapten sudah perintahkan untuk mundur ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Jurnal Fatui"
				},
				{
					"id": 710430106,
					"content": "(Ada peta sederhana yang terselip di jurnal. Lokasi dua lonceng besar ditandai di barat laut dan tenggara, lalu ada dua gambar tengkorak yang mencolok.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurnal Fatui"
				}
			]
		},
