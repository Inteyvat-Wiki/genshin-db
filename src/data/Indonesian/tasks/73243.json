			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"Sesudah membaca 'Starlog' gubahan Sage Tabari dengan teliti, akhirnya aku sadar kalau itu semuanya adalah mikrokosmos dari pergerakan di langit, entah itu peperangan antar dewa atau keruntuhan kekaisaran kuno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432002,
					"content": "\"Satu-satunya yang abadi adalah bintang-bintang di atas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432003,
					"content": "\"Uh, kesampingkan dulu unsur sentimentilnya. Apa Rtawahist akan meringkas semua kejadian kuno sekaligus?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432004,
					"content": "\"Semoga kalian bisa melihat permasalahan dari sisi sejarah, bukan hanya sekadar menatap bintang sambil berkontemplasi setiap hari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432005,
					"content": "\"Kamu tahu apa! Ini namanya hukum alam semesta, pantas saja kalian Vahumana semuanya kutu buku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
