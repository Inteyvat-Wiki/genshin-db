			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"Tentang investigasi 'Zandik' ... Dastur ... sebab kematian ... kemungkinan pembunuh ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431902,
					"content": "\"'Zandik' ... sesudah dihapus dari daftar ... tentang Eleazar ... tapi kekurangan bukti ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431903,
					"content": "\"Catatan tiba-tiba menghilang ... tahun tidak diketahui ... wabah Eleazar dimulai ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431904,
					"content": "\"Sebelum menghilang ... 'Legenda Varuna' ... terobsesi oleh ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431905,
					"content": "(Konten berikut ini sudah dirusak sepenuhnya sampai benar-benar tidak dapat dipahami.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
