					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Semua pemberitahuan Akademiya dan pengumuman eksekutif sudah dipindahkan ke Akasha. Papan pengumuman ini hanya diperuntukkan untuk komunikasi internal antara instruktur dan pelajar saja. Pihak luar tidak boleh meninggalkan pesan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"Demi menambah suasana belajar yang santai, pertukaran ilmu yang lebih bersahabat, dan dapat menuliskan tugas akhir dengan senyuman!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430202,
					"content": "\"Kita dukung Vikram sebagai Konservator Agung selanjutnya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430203,
					"content": "\"Silakan bergabung di 'Asosiasi Persahabatan Vikram'. Kita saksikan lahirnya Konservator Agung muda, menarik, dan menyenangkan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Jangan pernah melupakan tiga kebajikan dan enam dosa Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430302,
					"content": "\"Nasihat, akal budi, dan praktik ... Kebajikan yang harus dicita-citakan oleh tiap peneliti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430303,
					"content": "\"Tiga kebajikan yang sudah dijalankan Rifaet selama beberapa dekade.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430304,
					"content": "\"'Himpunan Pembaca Tiga Kebajikan' menyambutmu untuk berjalan dengan kebijaksanaan dan masa depan Konservator Agung.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"Untuk anggota 'Himpunan Pembaca Tiga Kebajikan', aku salut atas pencarian kebajikanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430402,
					"content": "\"Tapi aku dengar kalau lebih dari setengah tugas akhir Rifaet bukan hasil tulisan yang bersangkutan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430403,
					"content": "\"Itulah kenapa sampai sekarang dia masih saja tidak menonjol meski banyak pencapaiannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430404,
					"content": "\"Walaupun papan pengumuman tidak membutuhkan bukti yang cukup seperti pada tugas akhir, itu juga bukan untuk menyerang orang lain.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430405,
					"content": "\"Aku lihat pesan yang ada di sana, semuanya berisi kedengkian!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430406,
					"content": "\"Aku juga dengar kalau Vikram memenangkan hati banyak gadis karena kepandaian berbicaranya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430407,
					"content": "\"Gadis-gadis ini bahkan tidak tahu kalau dia sudah menikah. Jadi, apa kamu iri dengan kepopulerannya itu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430408,
					"content": "\"Dilarang melakukan serangan tidak berdasar kepada peneliti. Barang siapa yang membuat rumor lebih lanjut akan diserahkan ke Matra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"Papan pesan ini belum tergabung dalam sistem akses Akasha dan bisa diakses tanpa sistem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430502,
					"content": "\"Harap tingkatkan kesadaran akan keamanan ilmu pengetahuan. Dilarang keras menggunakan papan pesan ini untuk menyebarkan sumber pengetahuan di luar bidang pembelajaran.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"Sekadar mengingatkan, harap perhatikan protokol dan etiket Akademiya selama di luar kampus.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430602,
					"content": "\"Manajemen pengetahuan terpusat adalah landasan 'Tanah Kebijaksanaan'. Jangan kehilangan kesempatan belajar di Akademiya hanya karena kesalahan yang tidak disengaja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Belum lama ini terjadi beberapa kasus penyelundupan Kapsul Pengetahuan. Keterangan lebih lanjut akan dirilis bagi instruktur dan pelajar dari sekolah yang bersangkutan melalui Akasha sebelum Hari Jnagarbha berikutnya, diikuti dengan penyelidikan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430702,
					"content": "\"Mentor diharapkan meningkatkan komunikasi dengan para pelajar untuk meringankan beban mental yang disebabkan oleh penulisan tugas akhir dan untuk mencegah terjadinya tindak kriminal.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"Ada yang bilang cara Akademiya mempromosikan Akasha agak berlebihan. Tapi menurutku mereka itu terlalu kolot. Kinerja sebagian besar Mahamata rendah, dan bahkan lebih buruk dibandingkan yang lalu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430802,
					"content": "\"Coba pikir, kalau saja pembagian tugas bisa langsung pakai Akasha, begitu pula cara Bursa mengatur perdagangan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430803,
					"content": "\"Kita bisa merumahkan setengah dari Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430804,
					"content": "\"Masuk akal sekali. Jadi itulah kenapa kita belum bisa melakukannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"Kita semua tahu, kalau tugas peneliti adalah menggali ilmu pengetahuan lebih dalam lagi. Tapi, Akademiya terlalu sibuk mengurusi masalah administrasi sekarang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430902,
					"content": "\"Sekarang banyak pelajar yang terpaksa menghentikan penelitiannya dan diutus untuk menjadi Mahamata ke berbagai tempat sesudah menyelesaikan studinya. Bukankah itu bertolak belakang dengan tujuan awal Akademiya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430903,
					"content": "\"Bukankah kesimpulan tentang Akasha sudah ada sejak lama?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732430904,
					"content": "\"Di kala masyarakat awam masih terlena dengan takhayul, cuma kita yang paling mendekati kebenaran. Bagaimana bisa kita melepaskan diri dari tugas untuk menerangi dunia? Kalau kita tidak peduli lagi, tidak tahu Sumeru bakal sekacau apa nanti!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"Sebagai pelajar asing, aku bisa merasakan kebesaran Greater Lord Rukkhadevata yang lebih besar tiap harinya selama di Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431002,
					"content": "\"Sewaktu di Mondstadt, perlu membolak-balik puluhan buku hanya untuk memilah-milah teori yang berbeda demi masalah yang sederhana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431003,
					"content": "\"Tapi cukup pikirkan saja sesuatu, dan segala info tentangnya akan langsung ada di Akasha Terminal. Tidak ada lagi ciptaan yang sehebat itu di seluruh dunia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Setelah Pir Kavikavus, Akademiya tidak pernah menambah dana tahunan untuk Kshahrewar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431102,
					"content": "\"Mereka yang di atas cuma menganjurkan kontrol ketat terhadap mesin dan pengembangan teknologi untuk menjamin masyarakat yang stabil dan damai. Dalam kasus seperti itu, lebih baik kamu matikan Akasha saja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431103,
					"content": "\"Kalau bukan untuk pendanaan jangka panjang dari pengusaha cerdik seperti Lord Sangemah Bay, Kshahrewar dari awal sudah pergi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Aku percaya dengan keputusan Sage dan Mentor, tapi bukankah Akademiya terlalu bergantung dengan Akasha sekarang?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431202,
					"content": "\"Sudah jelas kalau kemampuan akademis pelajar keliling menurun begitu kita terbiasa memakai Akasha. Aku rasa kita perlu membatasi akses Akasha untuk pelajar baru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431203,
					"content": "\"Kenapa bilang begitu? Apa kamu tidak tahu dengan sekte gurun pasir yang tanpa arahan Akasha harus terpaksa menelan racun ular untuk mendapatkan kebijaksanaan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431204,
					"content": "\"Di balik Greater Lord Rukkhadevata, justru Akasha-lah yang menjamin kemurnian ilmu pengetahuan kita.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "\"Seminar Botani minggu ini akan dibawakan oleh Pelindung Hutan Tighnari dan dilangsungkan di Pardis Dhyai seperti biasa. Silakan mendaftar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431302,
					"content": "Siapa pun yang berminat pada botani boleh berpartisipasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431303,
					"content": "Mohon maaf, dikarenakan terlalu banyak pendaftar seminar, Akademiya memutuskan untuk membatasi partisipasi hanya kepada pelajar Amurta dan petugas penjaga hutan. Demikian kami umumkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Apakah ada yang sudah membaca novel terbaru Yae Publishing House? Penulisnya kali ini dari Sumeru bernama Pusina atau apalah ... Dia jelas adalah seorang Amurta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431402,
					"content": "\"Ah ... seandainya saja dulu aku bisa masuk ke Amurta, aku bisa berwisata tiap hari dan ada waktu menulis novel. Tapi aku malah masuk ke Haravatat, setiap hari kerjanya hanya meneliti dan menulis skripsi, tidak ada kesempatan untuk pergi ke luar pula.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431403,
					"content": "\"Apa? Sudah ada yang mendahuluiku mencetak novelnya di Yae Publishing House? Itu akan merusak kredibilitasku sebagai penulis novel ringan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Ternyata realita bisnis berbeda dengan apa yang digambarkan di buku. Seandainya saja dulu aku tinggal di Grand Bazaar dan berbisnis di sana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431502,
					"content": "\"Sekarang aku tidak bisa menulis laporan akhir lagi dan kehabisan uang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431503,
					"content": "\"Kalau masih saja seperti ini, lebih baik aku putus sekolah saja lalu bergabung dengan Eremite.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"Bukannya aku bias kepada siapa pun dari padang pasir, tapi menurutku Mahamatra Agung seharusnya adalah peneliti yang terkenal, terutama untuk masalah akademis yang tidak bisa diselesaikan dengan baku hantam.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431602,
					"content": "\"Heh, masih lebih mending dari waktu diurus Rtawahist, setidaknya tidak ada bias. Atau kalian benar-benar kira kalau tidak ada orang yang tahu cerita sebenarnya di balik laporan tahunan yang kalian terbitkan itu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431603,
					"content": "\"Dengar baik-baik! Kshahrewar, lebih baik kamu bawakan buktinya, atau akan kuminta Matra untuk putuskan semua ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"Menerima pelajar asing masih bisa disetujui, tapi membiarkan mereka mengakses Akasha itu sudah lain cerita ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431702,
					"content": "\"Kita kesampingkan dulu fakta kalau pemikiran orang asing mungkin bisa berdampak tidak baik pada Akasha. Tidak ada yang tahu kerugian apa yang bisa timbul pada perdagangan Sumeru karena bocornya pengetahuan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431703,
					"content": "\"Tumben peneliti bisa prihatin dengan masalah ekonomi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431704,
					"content": "\"Jadi itu alasan Haravatat seperti kalian dianggap sok. Kalau bukan karena mau belajar cara membuat cat yang lebih baik, aku tidak akan pernah ke sini!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"Sudah lama si cebol dari penghuni gurun itu tidak kelihatan. Sepertinya kita bisa santai sejenak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431802,
					"content": "\"Entah apa yang ada di benak petugas tata tertib itu sampai-sampai aku tidak lolos evaluasi semester lalu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431803,
					"content": "\"Seingatku, evaluasi cuma tergantung dari absensi saja, kan? Jangan salahkan orang lain karena kamu tidak belajar dengan baik. Walaupun akhir-akhir ini Matra kekurangan staf, tapi lebih baik kamu tetap hati-hati waktu berbicara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431804,
					"content": "\"Matra itu siapa? Itu hierarki untuk pamer kekuasaan saja. Tunggu, aku baru dapat pesan dari Akasha ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732431805,
					"content": "\"Aku rasa kita semua perlu waspada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
