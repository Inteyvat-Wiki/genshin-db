				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"Sebagai pelajar asing, aku bisa merasakan kebesaran Archon Dendro yang lebih besar tiap harinya selama di Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432102,
					"content": "\"Sewaktu di Mondstadt, perlu membolak-balik puluhan buku hanya untuk memilah-milah teori yang berbeda demi masalah yang sederhana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732432103,
					"content": "\"Tapi cukup pikirkan saja sesuatu, dan segala info tentangnya akan langsung ada di Akasha Terminal. Tidak ada lagi ciptaan yang sehebat itu di seluruh dunia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
