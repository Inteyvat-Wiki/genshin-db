			"dialogs": [
				{
					"id": 732432401,
					"content": "\"Papan Pesan Umum ini hanya digunakan untuk urusan internal Akademiya. Dilarang menyebarkan hoaks.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
