			"dialogs": [
				{
					"id": 751560101,
					"content": "Bebas! Akhirnya bebas juga dari kandang jahanam ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560102,
					"content": "Ugh, panas dan sempit sekali di dalam sana ... bau pula! Padahal terjebaknya cuma setengah hari, tapi umurku rasanya berkurangnya dua sampai tiga tahun .....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560103,
					"content": "Kamu lagi? Kali ini kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "Ah, penolongku yang baik! Aku tidak sangka bisa ketemu ... bisa ditolong olehmu lagi dalam perjalanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560105,
					"content": "Ah, bukannya aku sudah pernah memperkenalkan diri ya? Namaku Conulaf, calon imam Penguasa Angin Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560106,
					"content": "Latihanku masih lanjut, dan para tetua suku bilang banyak harta pusaka tersebar di seluruh Natlan. \"Sana, cari harta karun, Conulaf!\" Gitu katanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560107,
					"content": "Intinya, aku diusir dengan dalih disuruh latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560108,
					"content": "Yah, telingaku mendengar ada harta dekat sini ... bisa ditemukan dengan mengikuti jejak binatang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560109,
					"content": "Tapi entah maksudnya Sumpter Beast atau Alpaca ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560110,
					"content": "Intinya, penolongku yang baik, aku mengikuti Sumpter Beast sampai ke kemah orang-orang ini. Aku dikira maling, dan akhirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560111,
					"content": "Boro-boro dapat harta karun terkubur. Yang ada aku nyaris dikubur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560112,
					"content": "Petunjuknya kurang lengkap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "Iya, betul! Habis ini tidak boleh gegabah lagi. Hmm ... mungkin itu hikmahnya ya dari kejadian kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560114,
					"content": "Ck, aku harus mandi kembang ini ... baunya nempel banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560115,
					"content": "Makasih banyak, penolongku yang terbaik! Ini ada sesuatu, tolong jangan dilihat nilainya yang tidak seberapa, karena disisihkan dari anggaran perjalananku yang amat sangat terbatas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
