				"points": []
			},
			"dialogs": [
				{
					"id": 745260401,
					"content": "#Ah, {NICKNAME}, kamu sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Nilou, kamu lagi latihan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Tidak, tidak apa-apa. Aku lagi mikirin tarian baru, terinspirasi dari Padisarah yang baru saja mekar setelah hujan, dengan tetesan embun yang masih menggantung di kelopaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Tapi sekarang masih tahap awal, banyak gerakan yang masih kurang terpoles. Rasanya ... ada kurang sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Dari ceritamu saja sudah terdengar indah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Mau foto aku? Tapi, seperti yang sudah aku bilang tadi, aku masih belum terlalu menguasai gerakan tarian ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Sesi latihan sebelum tariannya jadi sempurna ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Hmmm, oke! Kalau begitu aku akan ekspresikan semua perasaanku ke dalam gerakan tarianku ... Tolong tangkap momen saat bunganya mekar sempurna ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Juga bisa jadi karya seni yang indah juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Kalau begitu, aku boleh ambil foto kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Aku tidak ganggu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
