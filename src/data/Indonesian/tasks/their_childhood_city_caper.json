				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Wah ... rasanya jadi mau main air, atau mandi di air mancur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Kalau kita gitu nanti pasti dimarahi. Kita lihat yang di luar saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050203,
					"content": "Tapi kenapa mereka buat air mancurnya sebesar ini kalau tidak ada yang boleh main di dalamnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Mau seindah apa pun, kalau cuma boleh dilihat, ini cuma kolam air biasa. Tidak menarik sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Ini bukan air mancur biasa loh. Eh, papa ada bilang sesuatu soal air mancur biasa ... Apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "\"Tujuan utama proyek mempercantik kota di Court of Fontaine adalah demi solusi pelaporan pajak yang lebih fleksibel.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050207,
					"content": "Hari ini Paman Delerue juga jelaskan ini ke aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050208,
					"content": "Hah, nada bicaramu juga mirip Papa ... pantas saja Papa suka sekali sama Kak Aurele. Setiap kali Papa pasti bawa banyak buku buat ngobrol sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Meskipun aku kurang ngerti, tapi Kakak pasti lagi bilang sesuatu yang enggak seru lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, yuk kita main ke tempat lain. Hari ini kamu enggak usah belajar kan? Jarang-jarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Yuk, kita lihat-lihat ke tempat lain deh. Coba kupikir-pikir ... harusnya The Steambird masih buka, kita ke sana yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
