				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Kakak, cepat ke sini! Kita belum lihat rumah besar yang di sana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Pelan-pelan jalannya, jangan sampai jatuh lagi. Lovi juga, papamu bilang kamu lagi kurang sehat, awas masuk angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "Wah, kakakmu cerewet juga, ya. Persis kayak mamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Ya kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Kalian ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "Kita ketemu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Halo kak! Kami tidak lagi main petak umpet kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Lebih tepatnya, kami baru selesai main tadi ... Terus ditegur sama Nona Nour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "Kak Nour kalau lagi kerja serius banget, terus suka negur orang. Padahal aku pernah kasih dia biskuit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Tapi aku juga sudah capek main, terus kepikiran mau ajak Aurele dan Verut keliling cari makanan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Kakak mau ikut kami ... eh ... apa ya namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "Iya! Jalan-jalan bareng kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Yuk kita lihat alun-alun yang di sana, aku mau lihat air mancurnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Kalau gitu tolong pandu jalannya, Nona kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Oke, kalau gitu ... kita ke alun-alun di sana dulu. Air mancurnya indah sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Kalau gitu tolong pandu jalannya, teman-teman sekalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Kalian lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
