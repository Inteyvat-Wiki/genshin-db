			"dialogs": [
				{
					"id": 240051101,
					"content": "Kakakmu memang selalu serius gitu ya? Kayaknya aku belum pernah lihat dia ketawa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Dulu sih enggak begitu, tapi dia jadi begini sejak baca buku bareng Papa-mu. Setiap hari dahinya berkerut, enggak tahu tuh lagi pikir apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Waduh, sama kayak Papa-ku ya. Kata Mama kelihatan kayak lagi berantem sama sesuatu gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "Jadi sebenarnya dia lagi berantem sama apa? Atau jangan-jangan ... bertengkar sama Mama-mu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "Bukan ah! Papa sama Mama enggak pernah bertengkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Orang dewasa memang aneh ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
