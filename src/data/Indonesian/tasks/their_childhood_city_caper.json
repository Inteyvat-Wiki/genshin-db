			"dialogs": [
				{
					"id": 240050401,
					"content": "Kak Louis! Mau kentang bumbu Bulle Fruit dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Oh, ternyata Lovi ya. Aduh maaf sekali nih, hari ini dermaganya ramai sekali jadi semua Bulle Fruit yang kusiapkan sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "Yah, a-aku kan sudah bilang dari kemarin-kemarin. Bahkan aku sudah bawa teman ke sini buat coba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "Ah, aku sampai lupa saking ramainya tadi ... Ini masih ada sisa beberapa kentang biasa. Ini buat kalian deh, gratis kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Ya sudah deh, terima kasih ya Kak Louis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Kamu hanya kekurangan Bulle Fruit saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Kalau ada Bulle Fruit, aku bisa langsung buatkan selai Bulle Fruit. Bahan-bahan lainnya masih ada sisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "Asyik! Kakak emang paling top!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Maaf ya, setiap kali bertemu kami Kakak jadi repot sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050412,
					"content": "Tidak perlu sungkan begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Baiklah, aku harus belajar banyak darimu. Paman Delerue sering bilang aku terlalu kaku. Kalau ke depannya aku mau jadi seorang kritikus, jalan karirku akan sangat sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050415,
					"content": "E-Ehem! Tidak usah bicara soal ini lagi. Aku akan jaga mereka berdua di sini. Soal Bulle Fruit-nya kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050413,
					"content": "Aku tidak mau membuat kalian kecewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Aku bisa carikan beberapa Bulle Fruit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
