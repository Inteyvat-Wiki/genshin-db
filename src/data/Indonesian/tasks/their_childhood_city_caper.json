			"dialogs": [
				{
					"id": 240050601,
					"content": "Harusnya sudah cukup, tunggu sebentar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis mulai membuat selai dari Bulle Fruit-nya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Oke! Ini dia kentang Bulle Fruit-nya, baru keluar dari oven! Biar Kak Louis yang traktir kalian, langsung dimakan ya. Tapi hati-hati panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Horeee! Langsung dimakan ya, Ini enak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Oh iya, Kak Aurele jangan bilang-bilang ke Papa ya, nanti aku dimarahi lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Haha, tenang saja, kurasa Paman Delerue juga tidak tertarik dengan kentang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050607,
					"content": "Kakak ... punyaku mana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Kalian makan gih, yang bagianku kalian bagi-bagi saja. Aku tidak begitu suka makan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050609,
					"content": "Hehehe, kalau begitu kumakan ya! Kakak juga ayo cepat makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Oh ya, nanti aku masih mau beli kopi buat Paman Delerue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050611,
					"content": "Eits, jangan! Mama sudah larang Papa minum kopi dari dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Setiap kali Papa minum kopi pasti langsung batuk-batuk di rumah. Suaranya juga langsung jadi serak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Papa bilang itu demi pekerjaan, tapi pekerjaan seperti apa sih yang bisa membuatnya sampai begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "Apa ini maksud kata-kata yang dibilang Paman Delerue padaku tentang \"harga\" yang harus dibayar untuk memberi kritik yang bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050615,
					"content": "Menjadi kritikus itu tidak mudah ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
