			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Ini The Steambird? Kok biasa saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050302,
					"content": "Kelihatan seperti rumah biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Wah! Benar-benar ada burung mekanik ya? Keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Keren, kan? Papa sering bawa aku ke sini buat beli koran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Dia suka banget sama The Steambird. Kadang seharian dihabiskan cuma buat baca koran. Dan kadang dia bikin klipingan artikel, ditempel di buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Papa bilang kalau itu adalah \"komentar\" yang dia tulis, kadang-kadang dia bisa bacakan komentar ini buatku dan Mama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Sebenarnya kami berdua tidak suka sih, kami hanya balas seadanya seperti, \"Oke\", \"Oh, begitu ya?\", atau \"Ternyata begitu toh\". Tapi Papa bahkan enggak sadar karena dia terlalu senang sewaktu bacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "\"Komentar\" seperti apa maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Sederhananya, memberi \"komentar\" kepada publik dari sudut pandang pribadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050311,
					"content": "Ayah Lovi, Paman Delerue, kerja jadi ilmuwan di Institut Penelitian Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050320,
					"content": "Dan dia juga \"komentator\" yang nulis \"komentar\" di The Steambird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050312,
					"content": "Iya, dan dia suka sekali bikin komentar panjang buat ... segala hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Terkadang waktu kita lagi berbicara, Papa bisa tiba-tiba terpikirkan sesuatu dan langsung pulang buat menulis naskahnya. Bahkan sampai tidak makan, hanya minum teh saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Eh, memangnya pekerjaan menulis komentar seperti ini bisa dapat Mora ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Kalau hanya mengutarakan pendapat saja tidak bisa disebut \"kritikus\" sih. Kalau mau menulis sebuah komentar yang diakui orang-orang, pertama-tama harus memenuhi beberapa syarat dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050316,
					"content": "Eh, itu ... Verut! Lalu Kakak juga, kalian lapar tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Beberapa hari lalu Kak Louis bilang padaku kalau dia bakal jual kentang rasa Bulle Fruit. Kita pergi coba yuk? Kutraktir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Eh ... oh! Oke! Kakak jangan bilang apa-apa lagi, ayo kita pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Kalian ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050303,
					"content": "Benar-benar tidak ada yang spesial sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
