				},
				{
					"id": 240051202,
					"content": "Kalau aku bisa kerja di The Steambird, jadi ada pendapatan stabil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051203,
					"content": "Tapi Paman Delerue juga bilang, seorang kritikus tidak boleh mengejar Mora. Kalau tidak, aku akan tersesat seperti orang-orang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
