					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "Ah! Anda sudah datang! Jangan bergerak. Sepertinya ini akan jadi kali terakhir saya meminta bantuan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820102,
					"content": "Coba bilang, perlu bantuan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "Tadhla. Dia mau bicara dengan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820106,
					"content": "Duh, apaan sih, formal banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820107,
					"content": "Reruntuhan di utara, tempat di mana kalian saling bertemu untuk pertama kalinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820108,
					"content": "Kamu bilang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "Reruntuhan di utara, tempat di mana kalian saling bertemu untuk pertama kalinya. Jangan lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820110,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Ya, tolong jaga dia baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820104,
					"content": "Aku masih ada urusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Dengarkan saya dulu ... Tadhla bilang dia ingin bicara dengan Anda ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				}
			]
		},
