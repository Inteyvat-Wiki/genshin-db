			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Sial! Masseira hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Dia tinggalkan catatan ini ... Dasar penipu tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "Pada saat Anda membaca catatan ini, saya seharusnya sudah berlindung di tempat persembunyian di dalam ngarai.\\nJika kepala Anda masih utuh, tidak perlu menangisi Tadhla.\\n\\nPerburuan ini masih belum berakhir. Ini hanya permulaan dari badai.\\nDemikianlah Masseira, pemburu dan tetua Tanit, memperingatkan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 732820604,
					"content": "Heh? Maksud dia apa nulis semua ini? Paimon enggak ngerti deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Sepertinya dia kabur dari suku karena ada sejenis tekanan, lalu dia meninggalkan surat ini kepada Anda. Huh, Tanit sepertinya tidak sedamai yang dibayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
