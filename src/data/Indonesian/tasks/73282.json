				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla menghindari tatapan mata dan menundukkan kepalanya sambil merasa cemas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "Kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Maaf, pemburuan ini telah berakhir. Aku Elang Pemburu ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Tapi ... saya tidak apa-apa. Tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "Ekstrem sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Ekstrem ya? Saya tidak tahu sih. Tapi dari kecil kehidupan saya sudah begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "Ah, tapi ... Cerita Anda dan Paimon ... Perjalanan kalian berdua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Kalau ada kesempatan, saya ingin dengar kalian cerita lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "Oh pasti! Kami punya banyak banget cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Ya, pasti kuceritakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Pfft ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "Ehem, maaf. Aku terlalu senang. Terimalah rasa terima kasih saya padamu ini ... eh, Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "Kapan kamu mau dengar, aku akan ceritakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Kamu tidak pernah berpikir mau hidup demi dirimu sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "Tidak, tidak pernah kepikiran. Tidak pernah berharap juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Padang pasir itu kejam, tidak ada waktu untuk memikirkan diri sendiri. Tanpa saya, suku tetap bisa hidup. Tapi tanpa suku, saya tidak mungkin bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "Tentang hubunganmu dengan Masseira ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Saya sudah pernah bilang kalau dia itu ayah saya, dan saya itu Elang Pemburu-nya. Saya mengikuti perintahnya, berburu demi dirinya dan mati pun untuknya ... Karena dia mewakili semangat Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822807,
					"content": "Kalau pada suatu hari saya sudah tidak bisa menjalankan perintahnya, hidup saya sebagai Elang Pemburu-nya akan berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				}
			]
		},
		{
