			"dialogs": [
				{
					"id": 732822901,
					"content": "#Oh, Anda sudah datang, {M#Tuan}{F#Nona} Pemilik Jinni yang terhormat ... Ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822902,
					"content": "Tentang Tadhla ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822903
					]
				},
				{
					"id": 732822903,
					"content": "Dia menyukai Anda, saya bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822904
					],
					"speakerTitle": "Masseira"
