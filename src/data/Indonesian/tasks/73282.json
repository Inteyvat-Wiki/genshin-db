			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Terima kasih sudah meluangkan waktu. Saya senang melihat Anda kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "Aku dengar kamu sedang cari aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Aku selalu jatuh cinta dengan padang pasir di waktu-waktu seperti ini. Indah. Ini pemandangan yang sangat kusuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "Tapi sayang sekali, saya tidak pernah punya kesempatan untuk melihat matahari terbenam di tempat ini dengan teman saya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "Benar sih ... Terus seluruh padang pasirnya bernuansa warna momen matahari terbenam ... Tenang banget rasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Tapi Tadhla, kamu minta kami ke sini cuma buat ini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "Bagi Tanit, Anda itu tamu, tapi bagi Elang Pemburu, Anda itu mangsa yang empuk ... Tapi saya tetap berharap, Anda yang akan bisa bertahan hidup lebih lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Jadi, maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Bagaimana kabarmu akhir-akhir ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
