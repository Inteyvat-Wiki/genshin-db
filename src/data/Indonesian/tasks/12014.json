			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Aku ingin tetap di sini sebentar, kembang api di dalam hatiku masih belum padam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Ah, tidak masalah kalau kamu ingin mengobrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Apa rencanamu selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka dan lainnya masih menungguku untuk mencari Great Mujina Youkai. Aku ini seperti kakak perempuan mereka jadi tidak boleh mengingkari janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Lalu aku juga masih mau mencari tahu perasaan orang-orang setelah kembang apinya dilepaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Untuk ke depannya, aku masih perlu bimbingan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Aku juga masih perlu bimbingan dari kamu dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Buat kembang api secara khusus mahal tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Kalau kalian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Gratis kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Kan aku yang mau menghadiahkannya, dan aku juga sudah merepotkan kalian sepanjang perjalanan. Hehehe. Mana enak kalau aku minta bayaran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Wah, jadi tidak enak hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "Jangan terlalu dipikirkan, tidak perlu sungkan kok. Kita barter saja bagaimana? Tunggu sampai kamu temukan saudaramu, kamu harus rekomendasikan Naganohara Fireworks kepadanya. Lumayan kan, bisa bantu-bantu aku tambah 1 pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "Aku juga ingin bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "Kalau Tenryou Commission mencari masalah dengan kalian...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Habisi lagi mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "—Hahaha, bercanda kok. Aku kan sudah bilang, keluargaku berhubungan dekat dengan Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Cukup akui saja kesalahan dan berikan senyum, bayar uang denda. Gampang kok, lolos dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "Tapi kalian sih harus hati-hati ya. Jangan sampai seceroboh aku kalau menemui masalah. Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}