			"dialogs": [
				{
					"id": 210229501,
					"content": "Aku menemukan 5 buah batu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "Bagus! Coba kulihat... Ugh, semua tulisan ini berantakan, coba aku susun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "... Hmmm, sepertinya ada banyak tulisan yang hilang dan membuatnya tidak bisa dibaca. Lagi pula, aku juga tidak tahu urutan yang benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "Ini adalah tebakan terbaikku. Jika aku menyusunnya seperti ini, maka akan terbaca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "\"... Pada zaman dahulu, ketika orang-orang berkumpul dan hidup dari bertani... Turunlah seorang dewa bernama Guizhong, dengan kebajikan bagaikan debu yang menyelimuti seluruh dunia ini hingga ribuan mil...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "\"... Sang dewa memberikan empat perintah kepada para manusia... Kemudian turunlah dewa lain bernama Liyue yang menguasai bebatuan, dia mengumpulkan dan melindungi para manusia dengan kekuatannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "\"... Inilah asal mula nama Guili Assembly yang diambil dari nama kedua dewa tersebut...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "Itu seperti sejarah tentang Guili Assembly, dan dewa yang melindungi para manusia dengan kekuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "Tapi di sana juga dituliskan kalau ada dewa lain yang datang, dan membawa beberapa penduduknya pindah ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "Dan sepertinya \"Guili\" dalam \"Guili Assembly\" ini diambil dari masing-masing satu suku kata dari nama kedua dewa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "Menakjubkan, dari semua tulisan yang pernah kubaca, tidak pernah ada dua dewa yang hidup berdampingan dengan damai, bahkan saling membantu satu sama lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "Hubungan mereka lebih dari dua dewa yang saling membantu, mereka adalah teman baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "Lalu, apa yang terjadi dengan mereka? Kenapa akhirnya mereka tiba-tiba menghilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "Selain itu, bagaimana \"Guili Assembly\" menjadi reruntuhan? Dengan adanya dua dewa yang melindungi, bencana alam biasa dan bencana akibat manusia seharusnya tidak bisa menghancurkan seluruh \"Guili Assembly\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "Pasti apa yang terjadi melebihi kekuatan yang dimiliki dua dewa untuk mengatasinya....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "Pengembara, bisakah kamu mencari lebih banyak petunjuk? Kalau aku tidak salah, di sini seharusnya masih ada lebih banyak prasasti dari batu seperti yang kamu temukan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "Mungkin, tulisan dalam prasasti-prasati itu bisa memberikan petunjuk tentang apa yang terjadi selanjutnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "Tapi benda-benda yang tercatat di prasasti ini sepertinya agak berbeda dengan apa yang tertulis di catatan kuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "*fuhh* Begitu banyak legenda dan cerita yang berbeda... Yang mana yang benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
