			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "Aku menemukan dua prasasti batu lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Coba kulihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "\"... Mereka bertarung di Guili Plains, mengakibatkan seluruh langit menjadi gelap dan ribuan batu besar hancur berkeping-keping...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Ini... sepertinya sedang membahas pertarungan yang terjadi di Guili Plains, dan pertarungan hebat itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Itu pasti pertarungan di mana Guili Assembly jatuh. Tapi, bagian yang lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "...sepertinya ini ditulis oleh orang yang tidak rela meninggalkan Guili Assembly, dan tetap memilih tinggal di sini. Lagi pula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "...masih ada harta karun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "... Kamu begitu tertarik dengan harta karun. Tapi kamu tidak salah, memang ada harta karun di Guili Plains jika tulisan ini diartikan langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Tapi, di atas tertulis... \"Empat perintah Guizhong akan membimbing generasi yang akan datang untuk menemukannya\", kemudian di bawahnya tertulis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "\"Mengajari dengan kebijaksanaan, mengadili dengan kebajikan, memperkuat diri, dan mempersatukan hati. Keempat prinsip inilah yang membentuk Guili Assembly.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Hmm... Aku tidak tahu harus memulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Mari kita kembali ke Wangshu Inn dulu. Kita butuh beristirahat sejenak sebelum mencoba memecahkan teka-teki di balik Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
}