			"dialogs": [
				{
					"id": 762020601,
					"content": "Tiba-tiba turun gitu bikin Paimon kaget saja. Eh, ini patung ... Mandragora raksasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "*klotok* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Periksa pintunya"
				},
				{
					"id": 762020603,
					"content": "Tunggu sebentar, maaf ya. Sepertinya ada kesalahan kecil. Seharusnya tidak begini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "*klotak* *klotek* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Periksa pintunya"
				},
				{
					"id": 762020605,
					"content": "Dia gerak! Kenapa dia kayak mau nyerang kita?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Fiuh, begini baru benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "Nicole, apa maksudnya \"begini baru benar\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Hmm? Serangan kecil begini tidak ada apa-apanya kan? Waktunya kamu unjuk gigi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
					],
					"speakerTitle": "Nicole"
				}
			]
