			"dialogs": [
				{
					"id": 762020201,
					"content": "Selamat datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Halo, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Wah, rumahnya mewah banget! Dekorasinya cantik banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Hehe, kamu memang punya selera yang bagus. Tidak sia-sia aku mendesain tempat ini dengan sangat teliti meski hanya di sela-sela waktu luangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Untuk detailnya, kita harus mulai dari hari di mana rumah rahasia ini dibangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Awalnya aku ingin memanfaatkan momentum yang bagus ini untuk membangun beberapa rumah penyihir lagi, tapi karena tidak ada yang membantu memberikan inspirasi baru, lama-kelamaan aku merasa bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "\"Apa tidak ada cara yang menarik, menyenangkan, dan memberikan rasa pencapaian?\" Jawabannya langsung terlintas di benakku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Tunggu, langsung ke jawabannya nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Kita harus selalu bergerak cepat, Paimon. Nih, jawabannya ada di depan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Di balik pintu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "Sebenarnya bukan hanya pintu ini, tapi tidak salah juga. Harus ada urutan, jadi ayo kita mulai dari sini. Sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "Tu-Tunggu dulu, kamu ngomong terlalu cepat, Paimon enggak bisa ngikutin ... Siap buat ngapain sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Oh, santai saja, kalian tidak perlu siap-siap gimana kok. Itu hanya formalitas saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Berdasarkan pengamatanku dan pemahamanku tentang kalian ... dibanding penjelasan dan instruksi yang rumit di awal, kalian lebih suka langsung seru-seruan sambil bertualang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Tidak salah juga sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, aku senang mendengarnya! Kalau begitu, aku tidak sungkan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}, kamu mengerti perasaan kami sebagai malaikat, kan? Rasa kepuasan saat membimbing orang untuk menemukan harta karun selalu membuat kami tidak bisa menahan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Karena tujuannya adalah berbuat baik dan membantu orang, sudah seharusnya aku mulai dari teman-temanku dulu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Jadi aku punya ide cemerlang untuk mengubah pondok ini menjadi rumah bermain yang bisa kalian gunakan untuk bersantai dan bermain, dan bahkan menyembunyikan harta karun di setiap ruangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Jujur saja, bahkan di antara para malaikat, aku ini termasuk yang jago dalam hal menyembunyikan barang lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Kalau aku benar-benar diminta untuk pergi ke luar dan dengan serius mengubur sebuah peti harta, lalu tidak memberi kalian panduan arah, sepertinya kalian akan menghabiskan beberapa bulan untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "Ehem ... maaf, lari dari topik lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Pokoknya, aku tidak akan sengaja mempersulit kalian, dan juga kalian enggak perlu berlari-larian ke sana kemari di tempat terpencil demi hobi kecilku ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Kamu hanya perlu menemukan tiga bulu yang melambangkan harta karun di dalam ruangan untuk menyelesaikan stage! Hehe, tolong buka peti harta karun ini di depanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Sekarang Paimon ngerti semuanya! Bersiaplah, harta karun! Paimon datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Harta karun, aku juga datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Tapi aku masih mau dengar penjelasan dari Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "Suatu kehormatan bisa berkunjung ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
