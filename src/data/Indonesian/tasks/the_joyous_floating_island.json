			"dialogs": [
				{
					"id": 762020301,
					"content": "Angin sepoi-sepoi bertiup di wajahnya.\\nSungguh aneh, rasanya seperti campuran Fruit Tandem Turnover, Midsommar Torte, Crispy Roast, dan Berry Herbal Candy.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Ugh! Tiba-tiba ada angin masuk ke tenggorokan Paimon. *uhuk* *uhuk* Eh? Di mana ini? Poci dan cangkirnya gede banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Atau jangan-jangan ... kita yang jadi lebih kecil?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "Kayaknya ini sihir Nicole deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Maaf ya, aku tidak berhasil mengundang aktor hewan yang cocok. Biasanya aku berurusan dengan aktor batu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Eh? Nicole, kamu juga kecil gini ya. Paimon kira kamu bakal jadi gede juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, si penyihir raksasa yang tetap menjulang tinggi meski sudah berjongkok? Tidak deh, makasih. Aku sudah sangat puas dengan wujudku yang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Intinya, selamat datang di pesta teh milik penyihir yang agung! Yuk, nikmati tehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
