			"dialogs": [
				{
					"id": 740813101,
					"content": "Halo! Mengenai Nona Sevigne ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Kamu menjelaskan situasinya dan memberikan tiga Pita Berlubang pada Chisseray ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Aku khawatir soal dia. Aku sedang pikir apa aku harus pergi melihat kondisinya. Rupanya terjadi hal begini ya. Terima kasih karena sudah sampaikan kabarnya ... dan juga untuk Pita Berlubang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "Tidak kusangka mesin percobaan Maillardet masih bisa beroperasi, Sevigne juga masih terus kerja di lingkungan berbahaya seperti itu. Aku harus cari staf untuk diskusikan masalah penarikan mesin percobaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "Kebetulan aku juga bisa tanya tentang penggantian biaya ... Sevigne memang pintar. Tapi, soal sesuai aturan atau tidak, itu sih keputusan staf. Jadi, untuk sementara biar aku yang tanggung biayanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "Apa pun yang terjadi, terima kasih atas bantuan kalian. Ini imbalannya, silakan diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
			]
