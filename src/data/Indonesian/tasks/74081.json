					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Hmm ... Apa kita sudah buat masalah besar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "Aneh sekali. Kayaknya tadi ada getaran sebentar deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811703,
					"content": "Aku juga merasakannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Umm, mungkin karena tadi kita menggerakkan perangkat di lantai atas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Pintu di sini awalnya terkunci, kan? Lalu, masih ada sejumlah clockwork meka yang menjaga pintu masuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811707,
					"content": "Aku suruh mereka istirahat, lalu kubuka pintunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "Y-ya mau gimana lagi. Mereka kan yang serang kita duluan. Jadi anggap saja ini sedang membela diri sendiri?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Mesin percobaan Senior Maillardet ... harusnya dalam keadaan mati. Soalnya sejak senior temukan lokasi bagus di Erinnyes, dia hampir tidak pernah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811711,
					"content": "Setelah dipikir-pikir, masuk akal sih. Kalau bisa menunjukkan hasil penelitian di tempat yang indah seperti taman bunga, siapa sih yang mau kembali ke laboratorium yang lembap dan reyot ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811712,
					"content": "Setelah Tuan Bossuet turun dari jabatannya, semua orang berpencar ke berbagai tempat di Institut Penelitian Fontaine, sama kayak benda di sini. Bahkan satu sofa pun tidak mereka tinggalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811713,
					"content": "Cuma ada mesin percobaan yang masih ada di sini menunggu orang-orang yang tidak akan kembali itu. Awalnya, mesin-mesin ini cuma menunggu di sini begitu saja, bagi mereka sih harusnya tidak masalah ya. Tapi sekarang malah jadi begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811714,
					"content": "Lihat deh, mesinnya sudah berantakan, roda giginya saja juga hampir copot. Kalau Senior Maillardet sampai tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811715,
					"content": "Aku yang melakukannya. Maafkan aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Anu ... mesin ini mahal enggak ya? Kalau sampai harus ganti rugi sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Jangan khawatir. Aku cuma mau bilang, kalau sampai Senior Maillardet tahu, dia pasti bakal ketawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811720,
					"content": "Soalnya dia sendiri pun sebelum sering mengganggu waktu mesin percobaan sedang beroperasi. Setelah dikalahkan, dia malah terduduk sambil tertawa terbahak-bahak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811721,
					"content": "Oh ya, sudah ngobrol selama ini, tapi aku masih belum perkenalkan diri. Aku peneliti Institut Penelitian Fontaine. Namaku Sevigne. Kalau kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811722,
					"content": "#Paimon ya Paimon, dia {NICKNAME}. Kami berdua ... umm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Cuma petualang yang lewat saja. Tidak lebih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Yup! Kami cuma kebetulan lewat saja kok. Yang pasti sih enggak kepikiran kalau di sini bakal ada harta karun atau yang lainnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Oh, maksudnya kalian lagi mempersiapkan perjalanan tur mencari harta karun di reruntuhan? Kalau gitu, kalian salah tempat deh. Walau di sini kelihatannya kayak reruntuhan ... eh, bukan, memang reruntuhan sih ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811727,
					"content": "Tapi, tempat ini tidak masuk daftar tempat rekomendasi Tur Reruntuhan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811728,
					"content": "Ya, sudah. Kalau gitu, kami pergi. Dadah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "Tunggu, tunggu. Kalian tahu Institut Penelitian Fontaine yang baru, kan? Kalau kalian mau pergi, tolong bantu aku cari Senior Chisseray di Institut Penelitian Fontaine yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811730,
					"content": "Tapi, kami bukan pergi ke Institut Penelitian Fontaine yang baru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Terus aku harus gimana? Masih ada kerjaan yang belum kuselesaikan. Mesin percobaan Senior Maillardet juga sudah dirusak. Harus cari orang untuk angkut secepatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811733,
					"content": "#Umm, {NICKNAME}, gimana kalau kita bantu dia saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "Luar biasa! Karena kalian mau bantu aku kumpulkan semuanya, sekalian sama tugas kumpulkan Pita Berlubangnya juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811735,
					"content": "Kalau tahu begitu, aku tidak sentuh perangkat di luar deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Jangan sampai begitu dong bahasanya, kan bukan permintaan yang terlalu sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811737,
					"content": "Dengan reputasi membantu mengumpulkan data penelitian, imbalan misi ini bisa aku laporkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811738,
					"content": "Eh? Enggak apa-apa tuh kayak gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Soalnya kan, kalian memang membantu penelitian. Tentu tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811740,
					"content": "Kalau memang tidak sesuai peraturan, pasti akan ditolak oleh staf. Kalau benar terjadi, aku bayar saja pakai uangku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811741,
					"content": "Kalian sering seperti ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Kalau aku sendiri sih tidak. Kalau orang lain, aku tidak tahu. Sebelumnya aku memang pernah dengar kabar angin, tapi .... Duh, ini tidak pantas dibicarakan dengan orang luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811743,
					"content": "Pita Berlubang yang mau dicari lagi itu ada tiga. Harusnya cuma ada tiga kok di rak buku, jadi harusnya tidak sulit. Tolong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811744,
					"content": "Sementara itu, aku harus cek mesin percobaannya sekali lagi. Soalnya mesinnya sudah lama tidak terawat .... Kalau sampai lepas kendali, pasti jadi kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811745,
					"content": "Ya, sudah. Kita cari kamu lagi deh kalau sudah selesai kumpulin Pita Berlubangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "Tidak masalah, serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Kami masih harus cari harta karun yang lain lagi",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "Di sini ada harta karun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Apa kamu ada kepikiran untuk meningkatkan kekuatan mesin percobaan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Memang itu yang dilakukan Senior Maillardet. Mungkin hasil akhirnya bisa sesuai dengan ekspektasimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811708,
					"content": "Iya, aneh sekali. Kenapa pintunya bisa terbuka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Cuma perasaanmu saja kali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
