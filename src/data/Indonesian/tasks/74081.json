				{
					"id": 740812403,
					"content": "Benar ini. Kalian memang berkompeten, kerjaan kalian mulus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812404,
					"content": "Kerjaan segampang ini sih kecil ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "Tetap hebat sekali! Aku tidak gombal, tapi ada yang sampai habiskan waktu seharian buat cari satu material saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812406,
					"content": "Sudah, jangan bahas itu lagi. Tolong serahkan Pita Berlubang ini ke Senior Chisseray.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812407,
					"content": "Beri tahu dia kalau aku masih belum bisa kembali sementara ini. Oh, terus, minta dia hubungi Senior Maillardet untuk ambil mesin percobaan di sini secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812408,
					"content": "#Oke. Kalau gitu, {NICKNAME}, apa kita balik lewat jalan yang tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "Ah, tidak perlu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812410,
					"content": "Kalian berdua harusnya bisa menyelam, kan? Sebenarnya ada jalan air di sini untuk keluar. Kemarin, jalannya ditutup supaya orang tidak jatuh ke sana. Aku akan bantu kalian bukakan jalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812411,
					"content": "#Wow bagus! {NICKNAME}, yuk kita balik lewat jalan air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "Pos untuk buka jalannya ada di dalam. Aku saja yang ke sana. Harusnya kalian bisa pergi sendiri, kan? Tidak bakal tersesat dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812413,
					"content": "#Kamu terlalu remehin kami ya! Paimon itu kan pemandu terbaik Teyvat. Asal ada Paimon, mana mungkin {NICKNAME} bisa kesasar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "Benar-benar bisa diandalkan ya. Kalau begitu, aku serahkan pengiriman surat dan Pita Berlubangnya pada kalian. Aku antar sampai di sini saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sevigne"
				}
			]
		},
