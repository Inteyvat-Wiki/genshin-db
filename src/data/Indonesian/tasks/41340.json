			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herbalis Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Maaf ya masih harus merepotkanmu saat hari besar seperti ini. Saat Lantern Rite setiap tahunnya, pasien di Bubu Pharmacy pasti akan bertambah banyak, aku benar-benar kewalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400102,
					"content": "Kenapa bisa begitu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Karena saat Lantern Rite, semua orang akan mengambil cuti dan menghabiskan waktu bersama keluarga. Mereka akan makan besar-besaran, minum-minum, makan daging bebek, ayam, ikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400104,
					"content": "Tidak heran kalau pencernaan mereka akan terganggu atau muncul penyakit-penyakit aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400105,
					"content": "Meskipun aku selalu menasihati orang \"jangan makan terlalu banyak\". Tetapi nasihat seperti ini pasti dilupakan saat hari besar seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400106,
					"content": "Beberapa orang menghubungiku barusan, menanyakan apakah aku bisa mengirimkan mereka obat untuk gangguan pencernaan dan masalah usus. Tetapi aku tidak bisa meninggalkan toko yang kujaga begitu saja di Bubu Pharmacy ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400107,
					"content": "Pengembara, kalau boleh merepotkanmu, bisakah kamu membantuku mengantarkan beberapa obat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herbalis Gui"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
