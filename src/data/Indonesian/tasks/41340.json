					"Herbalis Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Terima kasih atas kerja kerasnya, obatnya seharusnya sudah dikirim kan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400402,
					"content": "Kurasa mereka akan sakit lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Apa boleh buat, kalau tidak memperhatikan gaya hidup tentunya akan sulit untuk menyembuhkan masalah sakit maag. Aku cuma bisa bantu meresepkan obat yang tepat kalau kambuh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400405,
					"content": "Setidaknya sekarang aku bisa bernapas lega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400406,
					"content": "Tentang Lentera Xiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Menerbangkan lentera? Kami biasanya tidak melakukannya. Menerbangkan Lentera Xiao untuk membuat harapan... tapi toko seperti Bubu Pharmacy bisa buat harapan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400408,
					"content": "Toko lain berharap bisnisnya lancar, tapi toko apotek yang merawat pasien dan menyelamatkan orang tentunya tidak bisa membuat harapan seperti itu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400409,
					"content": "Herbalis Gui adalah orang yang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Tapi secara pribadi, aku juga ingin menerbangkan lentera, namanya juga merayakan festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400412,
					"content": "Tapi aku butuh beberapa hari untuk membuat Lentera Xiao, terus karena terlalu sibuk, sekarang baru bisa mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400413,
					"content": "Bahkan sekarang waktu luangku sedikit, aku cuma bisa mengerjakannya sedikit dan pada saat aku sudah selesai mungkin Festival Lantern Rite sudah keburu berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400414,
					"content": "Sini, biar kubantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "Ya-yakin nih? Terima kasih banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 413400410,
					"content": "Herbalis Gui orangnya jujur sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "Kurasa ini hanya bisa menyembuhkan untuk sementara...",
