			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Jangan-jangan aku memakan makanan yang kotor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "Ini obat dari Herbalis Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Oh! Terima kasih banyak ya. Ini obat yang kuminta ke Herbalis Gui kan? Pas sekali saat perutku terasa sangat tidak enak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "Sebenarnya aku hanya ingin berjalan-jalan di sekitar pasar dan membeli camilan, tanpa sadar aku sudah makan terlalu banyak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "Apa saja yang kamu makan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Ada nasi goreng, Yusheng, buah-buahan, udang yang sangat banyak. Oh, lalu aku minum arak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Tidak heran perutmu sakit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Makanya aku minum obat kan. Tapi coba kamu pikir-pikir, apa artinya hidup kalau kamu melarang dirimu untuk makan makanan yang kamu mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Yah pokoknya terima kasih ya telah mengantarkan obat ini. Aku akan beristirahat sejenak dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "Meskipun sedang merayakan tapi tidak boleh berlebihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
