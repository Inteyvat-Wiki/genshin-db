			"dialogs": [
				{
					"id": 760320201,
					"content": "Hei kamu, tahu tidak akibatnya kalau nekat masuk ke wilayah terlarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Fatui Oprichnik"
				},
				{
					"id": 760320202,
					"content": "... Aku juga baru tahu sekarang! Namanya juga pertama kali, belum ada pengalaman. Gimana kalau begini aja, kasih aku satu kesempatan lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Orang yang Mencurigakan"
				},
				{
					"id": 760320203,
					"content": "Beri aku kesempatan sekali lagi, lain kali aku janji tidak akan tertangkap olehmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Orang yang Mencurigakan"
				},
				{
					"id": 760320204,
					"content": "Konyol, <color=#00E1FFFF>tikus-tikus yang mengincar harta</color>, tidak akan kubiarkan satu pun lolos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Fatui Oprichnik"
				},
				{
					"id": 760320205,
					"content": "Hei! Sekarang juga, bisa saja gadis itu sudah membawa semua barangnya pergi. Kenapa kamu malah bertengkar denganku di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Orang yang Mencurigakan"
				},
				{
					"id": 760320206,
					"content": "Kamu tidak perlu khawatir tentang nasibnya. Menyerahlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Oprichnik"
				}
			]
		}
