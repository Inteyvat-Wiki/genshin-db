			"dialogs": [
				{
					"id": 740841201,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841202,
					"content": "Pahsiv! Kamu muncul dari mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841203,
					"content": "Tanpa jejak, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841204,
					"content": "Aduh, pokoknya kita harus cepat jauhin Vishap itu. Bahaya banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841205,
					"content": "Paimon yang baik, Pahsiv! Bahaya, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841206,
					"content": "Pahsiv mengulurkan tangannya dan mengelus kepala Vishap tersebut, dan Vishap yang marah itu kemudian menundukkan tubuhnya dengan lembut.\\nDia membuka mulutnya, memuntahkan tetesan air yang sebening kristal, lalu berbalik dan melompat ke dalam air.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Kunci, Kunci, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841208,
					"content": "Wah, jadi si Vishap inisiatif buat ngembaliin kuncinya? Paimon enggak nyangka sih dia patuh sama kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841209,
					"content": "Si biru, baik, kunci, dilindungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841210,
					"content": "Si biru itu maksudnya Vishap yang barusan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841212,
					"content": "Jangan-jangan dia bantu kamu lindungi kuncinya? Kamu sama Vishap itu berteman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841213,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841214,
					"content": "Si ungu, curi kunci ... si biru, pingsan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841215,
					"content": "Si ungu? Siapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841216,
					"content": "#Si ungu, jahat! Si biru, Paimon, {NICKNAME}, baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841217,
					"content": "Hmm ... okelah. Walaupun kedengarannya kamu kayak lagi muji-muji kita, tapi rasanya agak aneh gimana gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841218,
					"content": "Si ungu, jahat sekali, Erinnyes, sangat Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841219,
					"content": "Oke deh, kamu beneran Melusine terunik yang pernah Paimon lihat ... Oh iya, seingat Paimon kebanyakan Melusine tinggal di Court of Fontaine atau Desa Merusea ... Kok kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841220,
					"content": "Court of Fontaine? Desa Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841221,
					"content": "Kamu kelihatannya bingung. Memangnya belum pernah dengar nama-nama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841222,
					"content": "Court of Fontaine, Melusine ... Desa Merusea, Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841223,
					"content": "Ah ... Erinnyes, Pahsiv, kampung halaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841224,
					"content": "Erinnyes, Pahsiv, melindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841225,
					"content": "Tunggu, kamu bilang ini kampung halamanmu? Kamu lagi lindungi kampung halamanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841227,
					"content": "Tapi kampung halaman Melusine itu di Desa Merusea, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Iya, aneh banget deh. Memangnya ada Melusine yang lahir di tempat lain? Tapi kayaknya enggak ada Melusine lain di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841229,
					"content": "Pahsiv, kamu tinggal sendirian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841230,
					"content": "Sendirian? Melusine. Tamu itu! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841231,
					"content": "Ta-Tamu itu? Masih ada tamu lain? Tamu yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841232,
					"content": "#Tamu itu! Paimon, Paimon, {NICKNAME}, {NICKNAME}, tamu itu, tamu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841233,
					"content": "Jadi tamu itu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Pahsiv ... jangan-jangan maksudmu tamu itu ya tamu itu, sama kayak Paimon ya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841235,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841236,
					"content": "Aha! Benar kan ternyata. Apa kata Paimon ... Paimon juga pintar banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841237,
					"content": "Aneh banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "Keren banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Tamu itu, Pahsiv, pengetahuan, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841240,
					"content": "Hmm ... maksudmu tamu itu ngebantuin kamu belajar pengetahuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841241,
					"content": "Pahsiv! Sangat banyak. Bahasa, kebijaksanaan ... sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841242,
					"content": "Ugh, buat Paimon kok rasanya enggak gimana banyak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841243,
					"content": "Pahsiv, tamu itu, melindungi, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841244,
					"content": "Dia juga bantu kamu lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841245,
					"content": "Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841246,
					"content": "Atau kamu yang membantunya melindungi tempat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841248,
					"content": "Ternyata gitu ... Tamu itu sebenarnya siapa? Kenapa dia butuh bantuanmu buat lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841249,
					"content": "Lagian memang kejadian hal yang jelek juga, kan? Tulisan yang ada di tablet batu yang kita lihat hancur, terus banyak kotorannya juga ... Apa itu semua gara-gara si ungu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841250,
					"content": "Paimon penasaran, Pahsiv! Tapi waktu, sangat sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841251,
					"content": "Kunci, kunci, kunci, alun-alun, barat. buagh, bugh, buagh, bugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841252,
					"content": "Kami usahakan secepatnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv melompat dua kali dengan gembira, lalu buru-buru pergi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Kayaknya waktu sudah beneran mepet deh. Untung dua kunci lainnya sudah dapat. Kunci yang ketiga nih terakhir, bisa, bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
