			"dialogs": [
				{
					"id": 740840801,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv, kamu kok di sini? Cepat tinggalin Vishap itu, bahaya tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "Paimon yang baik, Pahsiv! Bahaya, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv mengulurkan tangannya dan mengelus kepala Vishap tersebut, dan Vishap yang marah itu kemudian menundukkan tubuhnya dengan lembut.\\nDia membuka mulutnya, memuntahkan tetesan air yang sebening kristal, lalu berbalik dan melompat ke dalam air.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "Itu kuncinya! Jadi ternyata kuncinya tersembunyi di dalam mulutnya Vishap ya! Terus si Vishap inisiatif buat ngembaliin kuncinya gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "Si biru, baik, kunci, dilindungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "Si biru itu maksudnya Vishap yang barusan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv, kamu berteman sama si Vishap tadi? Jadi dia bantu kamu lindungi kuncinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "Si ungu, curi kunci ... si biru, pingsan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "Si ungu? Siapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#Si ungu, jahat ... Si biru, Paimon, {NICKNAME}, baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "Hmm ... okelah. Walaupun kedengarannya kamu kayak lagi muji-muji kita, tapi rasanya agak aneh gimana gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "Si ungu, jahat sekali, Erinnyes, sangat Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "Maksudmu ... pengancam pulau ini tuh si ungu ya? Untung saja kuncinya ada di kita sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#Paimon, {NICKNAME}, Pahsiv! Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "Kunci, kunci, kunci, alun-alun, barat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "Oke deh. Pahsiv tenang ya, sekarang kita pergi ke alun-alun sebelah barat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
