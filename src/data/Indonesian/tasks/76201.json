			"dialogs": [
				{
					"id": 762010201,
					"content": "Hei, Metta. Kok jahat sih! aku cuma mau ikut senang-senang dalam petualanganmu. Kok kamu malah ngomong kayak begitu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Kalau kamu merengek terus, orang lain juga pasti tidak tahan denganmu, cepat atau lambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Kok merengek sih? A-Aku juga punya rencana sendiri kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Wah, rencana sendiri yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Huh ... Kamu tipu aku lagi. Aku tidak mau ngomong sama kamu lagi! Jangan sampai menyesal nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "Ah ... Kak Linnea ... Dengar dulu! Dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Vesa menceritakan semua yang terjadi dengan terbata-bata, sepertinya ini cuma konflik anak-anak biasa saja ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Dilihat gimana pun, bukan aku yang salah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Aku, aku juga enggak salah, kan? Kak Linnea ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Hmm ... Kadang-kadang hal seperti ini memang sering terjadi ... Tidak ada yang salah sih, cuma kadang-kadang hasilnya tidak seperti harapan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Oh ... Ini kayak cerita tentang dua kakak beradik di Bani Bulan Embun yang dilambangkan oleh Nocturnal Blossom ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Eh? Cerita tentang dua kakak beradik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Ya. Aku pernah dengar kalau ada sepasang kakak beradik dari Bani Bulan Embun. Kepribadian mereka berbeda sekali, sama kayak bunga Nocturnal Blossom, satu merah, satu biru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "Kakak beradik ini percaya apa yang mereka lakukan itu benar, tapi mereka malah berpisah karena keyakinan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Konon katanya, adiknya tidak pernah memaafkan kakaknya yang meninggalkan dirinya, meski kakaknya telah menyelamatkan banyak nyawa ... Tapi akhirnya, mereka berdua tidak pernah bertemu lagi sampai maut memisahkan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Oh ... Aku enggak pernah dengar ada cerita seperti itu di Bani Bulan Embun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Aku juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Hmm ... Aku dengar dari penyair yang mengembara sih ... Mungkin ada bagian yang dikarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Oh, jadi cerita karangan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Yah, meski ceritanya mungkin tidak benar sepenuhnya, tapi nilai ceritanya tetap berguna, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Mereka berdua tidak merasa salah, dan mereka percaya pilihan mereka benar. Tapi keyakinan mereka malah membuat mereka kehilangan ikatan persaudaraan selamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Kalau membuktikan diri sendiri benar berarti kehilangan teman ... Kamu pilih yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Ah ... Sebenarnya hal-hal tidak terduga kayak gini waktu bertualang juga enggak jelek-jelek amat sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "Yah. Kalau pikir-pikir lagi, waktu Kak Metta menemaniku bertualang itu emang berharga banget. Kalau aku plin-plan, mungkin kita jadi enggak bisa nikmati apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Aku ... akan rencanakan dengan lebih baik lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Hehe. Baguslah kalau kalian sudah baikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "Kalau kami ketemu batu aneh dalam perjalanan, kami akan kirim ke Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Oke deh. Terima kasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
