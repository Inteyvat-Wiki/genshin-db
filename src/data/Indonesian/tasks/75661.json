			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "Pantas saja aku merasa harus mampir dan lihat-lihat ... Halo, \"Tu{RUBY#[D]Harapan}maini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610102,
					"content": "Coba kutebak, kamu ke sini buat ikut ujian pejuang Bunga Bersayap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610103,
					"content": "Betul. Aku mau periksa tingkat kesulitannya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "Kalau begitu kamu tidak akan kecewa, karena ekspektasiku untuk para penunggang Qucusaurus sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610105,
					"content": "Aku tidak pandai mengajar, jadi waktu diundang untuk merancang ujian ini, aku cuma tambahkan semua tantangan sulit yang bisa kupikirkan ke ujiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610109,
					"content": "Di antara pejuang-pejuang suku kami, tingkat kegagalan di ujian pertama adalah ... sembilan puluh sembilan persen. Oleh karena itu, mau tidak mau aku harus ikuti saran Irade dan turunkan tingkat kesulitannya sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610110,
					"content": "Tapi aku ragu ujian awalnya juga akan menantang untukmu. Untuk kamu ... mungkin aku harus pilih tantangan yang tidak sanggup kuselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610111,
					"content": "Terima kasih, tapi aku tidak butuh perlakuan khusus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "Tidak, aku jujur. Aku memang tidak pandai mengajar, tapi soal menilai kekuatan seseorang, aku tidak pernah salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610114,
					"content": "Mengingat kemampuanmu ... cuma tantangan paling sulit yang cocok untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610115,
					"content": "Tapi aku harus lihat apa ujiannya cocok untuk pejuang biasa atau tidak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "Baiklah kalau memang ada urusan, nanti juga akan ada kesempatan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610118,
					"content": "Suatu hari nanti aku akan rancang tantangan khusus untukmu ... Pesta pertempuran yang melampaui kemampuan penunggang Qucusaurus terhebat sekalipun. Tunggu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610116,
					"content": "Ujiannya harus bisa diambil orang lain juga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "Haha, kamu terlalu memuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "Bisa jadi aku cuma datang buat ketemu kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "Oh? Begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610108,
					"content": "Jadi kamu mau pecahkan rekorku? Boleh, boleh. Ujiannya penuh dengan tantangan tersulit yang pernah kuhadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				}
			]
		}
	]
}