			"dialogs": [
				{
					"id": 207000304,
					"content": "Sudah selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Lambat seperti Knights of Favonius. Aku memberimu waktu 1 menit! Apakah kamu sudah lupa, atau kamu tidak mendengarkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "Hmm, tidak memperhatikan bahkan untuk info sesederhana itu... Ini 1000 Mora untukmu, lakukan apa yang kamu inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1000 Mora? Kenapa sedikit sekali!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "Berapa banyak ekspektasimu dengan tugas seperti itu? Ini adalah upah yang layak kamu terima, terimalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
