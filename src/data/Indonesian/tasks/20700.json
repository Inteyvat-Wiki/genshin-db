			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Sudah selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "Cepat sekali? Bahkan kurang dari 1 menit! Kamu cukup hebat. Luar biasa hebat, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Bagus, bagus. Ini 5000 Mora untukmu, tidak kurang tidak lebih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "\"Luar biasa hebat\", tapi kita hanya mendapatkan 5000 Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Jangan banyak mengeluh. Aku sudah menghitung upah ini dengan sangat hati-hati, dan itu setara dengan tugas yang kuberikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Lakukan hal besar kalau kamu ingin mendapatkan banyak uang. Kalau kita bertemu kembali, cobalah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
