	"talks": [
		{
			"id": 2070001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2070001",
							"2"
						],
						"stepId": 2070001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Benar-benar nasib yang buruk! Para Knights of Favonius ini benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Hmm, para Knights of Favonius ini benar-benar tidak efisien dalam melakukan segala hal. Katanya di depan ada monster, dan mereka tidak membiarkanku lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Tapi sampai sekarang, aku belum mendapatkan kabar yang pasti dari mereka. Benar-benar tidak bisa diandalkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Masih ada banyak hal yang harus kukerjakan. Apakah mereka tahu berapa banyak kerugian yang aku terima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "Tapi... melihat penampilanmu yang seperti petualang... Begini saja... bagaimana kalau kamu membantuku melakukan sesuatu, dan aku akan membayarmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Bagus. Aku suka dengan orang yang tidak basa-basi. Kamu akan dibayar setelah tugasmu selesai, aku jamin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Mungkin aku salah, tapi Hilichurl di sekitar kota Mondstadt sepertinya semakin bertambah. Entah apa yang dilakukan para Knights of Favonius dari pagi hingga malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "Karena kamu sudah setuju untuk membantuku melakukan sesuatu, maka tugasmu adalah membasmi para Hilichurl. Tapi kamu hanya seorang diri. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Sudahlah, lupakan saja. Kamu pilih sendiri tempat untuk kamu bereskan: puncak, lereng, atau kaki gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Semuanya adalah membasmi Hilichurl, jadi tidak ada bedanya. Cepat pilih, jangan menghabiskan waktuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Berapa banyak yang bisa kamu berikan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Hah, itu tergantung dari hasil yang kamu lakukan. Kalau kamu melakukannya dengan baik, aku tentu akan memberikan hadiah yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
