					"nextDialogs": [
						207004303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004303,
					"content": "Tetapi, sepertinya kamu terbiasa melakukan segalanya berdasarkan keinginanmu sendiri, atau kamu tidak memperhatikan kata-kataku mengenai urutannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004304,
					"content": "Apakah kamu tahu? Di Snezhnaya, kami mengatakan \"memberikan seperti yang dijanjikan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004305
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004305,
					"content": "Aku membayarmu untuk melakukan sesuatu untukku, dan setiap kata yang aku keluarkan ada artinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004306,
					"content": "Kamu memang sudah menyelesaikan tugasmu, tapi melihat hasilnya... Aku hanya bisa memberimu 1000 Mora, ambill dan pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004307,
					"content": "Apa!? 1000 Mora? Bisa digunakan untuk apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207004308,
					"content": "Hmm, terlalu sedikit katamu? Kamu bahkan tidak menyelesaikan tugas dengan benar. 1000 Mora ini sudah lebih dari cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
