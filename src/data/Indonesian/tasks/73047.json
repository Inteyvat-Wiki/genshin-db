					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Eh, Nara {NICKNAME}, Paimon, ketemu lagi. Hehehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "Araja kayak lagi senang banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Hehehe, Aranara tua ini senang melihat Vanarana kembali ramai dan banyak Aranara sudah kembali. Tidak kusangka kalau aku akhirnya berkesempatan untuk mengikuti Festival Utsava secara langsung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "Kamu belum pernah ikutan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Aku pernah ikut dalam suatu cerita. Tapi itu dulu sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Aku, Aramuhukunda, Arana, Araji ... kami para Aranara merayakan Festival Utsava bersama Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "Itu adalah masa-masa sulit kami. Tapi di festival itu kami bisa tertawa dan bernyanyi bersama. Aku suka sekali kisah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "Loh? Kamu pernah ikutan dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Oh iya, di dalam cerita memang iya. Tapi aku sudah lupa. Cerita itu aku dengar dari Arana dan yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Ngomongnya sudah mulai enggak jelas kayak kakek-kakek. Mulai pikun ya dia, usia emang enggak bisa bohong sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Begini juga bagus. Nara {NICKNAME}, Paimon, apa kalian bersedia menerima ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Bunga lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Iya. Semoga bunga ini terus menemani kalian sepanjang jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "Aku terima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Waktu Nara lebih berharga daripada Aranara. Aku tidak akan mengganggu kalian menikmatinya. Kalian pergi temui Arakavi nanti, dia juga sedang mempersiapkan untuk upacara Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "Aku juga sangat senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "Paimon juga seneng! Tapi, memangnya dulu Araja belum pernah ikutan Festival Utsava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}