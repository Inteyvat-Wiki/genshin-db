			"dialogs": [
				{
					"id": 200160101,
					"content": "Pesanan untuk dikirim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "Pengembara, kamu datang di saat yang tepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Maaf, aku tahu kamu lapar... tapi bisakah kamu membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Akhir-akhir ini jumlah pesanan meningkat. Aku biasanya membagi pesanan berdasarkan wilayah dan memberi label setiap masakan dengan nama pemesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Tapi label untuk <color=#00E1FFFF>Calla Lily Seafood Soup</color> ini hilang. Yang aku tahu adalah makanan ini untuk seseorang di Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Dapatkah kamu membantuku mengirim <color=#00E1FFFF>Calla Lily Seafood Soup</color> ini ke Springvale dan mencari tahu siapa yang memesannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Baiklah, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Tunggu kamu pulang, akan ada banyak makanan lezat menunggumu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Aku mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Aku hanya datang untuk makan, aku kelaparan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Setelah kamu pulang, aku akan mentraktirmu menu spesial dari Good Hunter! Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
