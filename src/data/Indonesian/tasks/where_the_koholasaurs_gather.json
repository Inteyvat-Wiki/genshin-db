			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, Paimon! Sebelah sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Kamu sudah sampai, Mualani. Oh, si pelajar itu juga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "Selamat pagi, kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "Pagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "Jadi kapan kita berangkat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Haha, kamu seperti anak kecil yang semangat sekali sebelum perjalanan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Aku cuma ingin langsung mulai saja ... Kamu sadar kan ini bukan piknik, jadi aku harap kita bisa sedikit lebih profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "Jangan khawatir, aku ini pemandu profesional. Ehem, perjalanan kita ke pulau misterius resmi dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "Hore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Pertama, apa kalian semua lihat patung yang ada di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Mm-hmm. Apa itu petunjuk penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "Tidak. Itu bukan petunjuk apa-apa. Tapi dia adalah kepala suku pertama Warga Mata Air yang berhasil kembali dari pulau misterius dan membangun tempat ini. Itu sebuah monumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Hal pertama yang harus kita lakukan sebelum pergi adalah menyentuh patung itu dan berdoa kepada leluhur. Agar perjalanan kita ke pulau misterius jadi lebih lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "Keyakinan seperti itu, apa ada teori pendukungnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "Teori pendukung? Tidak ada, tapi guru bilang hal ini harus dilakukan sebelum berangkat ke pulau misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "Bagus! Kamu tidak mencoba untuk berargumen denganku soal sesuatu yang tidak kamu ketahui. Kamu profesional banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Yah tapi karena ini tidak ada basis empirisnya, aku tidak bisa masukkan ke dalam tesisku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "Ayo semuanya, barengan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Wahai leluhur, sebagai keturunan Anda, aku akan mengikuti langkah Anda dan menyaksikan pencapaian Anda. Izinkan aku pergi di bawah tatapan Anda dan kembali di bawah pengawasan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "Wow rasanya betulan kita mau mulai perjalanan hebat gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Sekarang, bersiaplah. Kita bakal cari petunjuk pertama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
