			"dialogs": [
				{
					"id": 150080401,
					"content": "Ketemu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "Apa ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "Ini kunci supaya kita bisa melewati kawanan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "Kalau Koholasaurus punya indra penciuman yang tajam, maka walau kita mau menyelinap diam-diam tanpa terlihat juga, mereka bakal langsung sadar kalau jaraknya sudah agak dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "Tapi tanaman ini bisa bantu kita selesaikan masalah itu, karena wanginya mirip dengan Koholasaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "Kita bisa pakai ekstrak dari tanaman ini ke badan kita, jadi mereka terkecoh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "Jadi kita ... mau oles-oles tanaman ini di badan kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "Tenang, ini juga bagus kok buat kulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "Mualani mengumpulkan beberapa ekstrak tanaman dan melumuri bau semua orang dengan tanaman tersebut.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Oh, Paimon berasa lengket dan licin, tapi ... memang baunya jadi kayak Koholasaurus sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Sempurna! Oke, sekarang kita coba buat lewati mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
