			"dialogs": [
				{
					"id": 150080501,
					"content": "Harusnya sudah dekat nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080502,
					"content": "Lihat, ada banyak yang ngumpul dekat batu itu. Mereka ngapain sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080503,
					"content": "Hmm, mungkin kalau sudah bosan, mereka kumpul bareng buat ngobrol? Duh sayang aku tidak paham mereka ngomong apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080504,
					"content": "Hah? Padahal Paimon pikir pemandu Warga Mata Air bisa ngerti bahasa Koholasaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080505,
					"content": "Kayaknya kamu kena tipu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080506,
					"content": "Iya betul, mereka memang mau coba nipu ... Hah? Kamu lihat enggak tuh yang ada di batu? Kok kayak ... ada coretan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "Aku pernah dengar ada tipe lumut yang bisa bereaksi terhadap sinyal biologis yang dipancarkan oleh Koholasaurus. Tapi untuk memicu reaksi itu, perlu Koholasaurus dalam jumlah besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "Itu pasti petunjuknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Kita foto jangan nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Cahayanya nanti mengganggu mereka. Biar aku salin saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Mualani menyalin gambar berlumut itu dan diam-diam menuntun kalian kembali. Lalu kalian menceritakan semua hal yang terjadi pada Viramdra dan Karya yang sedang menunggu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Jadi kita berhasil lolos ujian pertama perjalanan ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Begitu ya ... Jadi kalau tadi kita usir Koholasaurus itu, kita tidak akan pernah bisa menemukan petunjuk ini ... Ternyata memang ada basis logika dari semua yang kamu katakan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "Kak Karya, apa dia memang selalu begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "Dia cuma terobsesi sama penelitiannya saja sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Setidaknya ini menunjukkan kalau penilaianku benar. Aku sudah membuktikan bahwa aku layak dipercaya. Jadi, lain kali kita tidak perlu adu mulut lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Iya, aku paham ... dan kurasa itu juga bisa bikin kita hemat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani benar-benar jago ya buat mimpin tim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "Dia kan pemandu profesional.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Selanjutnya, kita harus pakai petunjuk yang kita temukan untuk menyingkap tujuan kita selanjutnya. Oke, jadi lambang ini artinya apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "Hmm susah juga ... Paimon betulan enggak paham deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "Aha! Aku tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Walaupun garisnya agak kurang rapi, aku masih bisa melihat ini melambangkan perbatasan antara air dan daratan di Jadeskirt Knoll. Kita bisa pakai ini buat mengisi lubang di peta, dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Menemukan tujuan kita berikutnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
