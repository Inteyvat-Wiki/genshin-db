			"dialogs": [
				{
					"id": 150080201,
					"content": "Wow, ada banyak Koholasaurus di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Sesuai dugaan, petunjuk pertama berhubungan dengan Koholasaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Saat orang luar suku dapat salinan peta, kebanyakan bisa langsung tahu kalau petunjuk pertama berhubungan dengan Koholasaurus, tapi mereka biasanya malah cari di jalan yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "Saat kepala suku pertama membuat petanya, dia meninggalkan tanda khusus untuk bagian ini. Ini adalah kode yang digunakan suku kami untuk menandai kawanan Koholasaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Jadi, mustahil buat menemukan petunjuk kalau cuma ada 1 atau 2 Koholasaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Kamu pro banget ya, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Tapi berdasarkan informasi yang berhasil kutemukan, Koholasaurus tidak suka berkelompok kecuali bersaing buat memperebutkan pemandian air panas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Jadi biar kuberi tahu rahasia yang hanya diketahui oleh pemandu Warga Mata Air. Koholasaurus akan berkumpul secara berkala di lembah depan sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "Sama seperti suku kami biasa berkumpul bersama untuk merayakan festival. Namun, begitu musimnya berlalu, mereka bakal langsung bubar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "Kalau kamu bukan pemandu yang sudah biasa keliling Natlan, bakalan jarang banget kamu lihat hal begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Ternyata ada hal begitu ya?! Aku harus langsung catat dan masukkan penjelasannya sebagai bagian dari tesisku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "Berdasarkan yang kutafsirkan dari peta, petunjuknya tersembunyi di kedalaman lembah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Tapi kalau mau ke sana, berarti kita harus melewati sekelompok Koholasaurus dulu dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Hmm, kita harus pikirin cara buat diam-diam lewati mereka tanpa mengagetkan mereka. Mereka kan kumpul sama teman-temannya, jadi aku yakin mereka juga tidak mau diganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Maksudnya, kita harus lewati kawanan Koholasaurus? Kok rasanya agak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Ehem ... Karena kita sudah setuju mau kerja sama, semua orang harus lakukan bagiannya masing-masing. Tapi, Karya sebelumnya sudah pernah diserang oleh Koholasaurus, jadi ini bukan rencana ideal deh buat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Tapi bagiku sih tidak masalah sama sekali! Karya boleh tunggu di sini dan aku akan ambil semua tugas yang harusnya jadi bagian dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Hehe, tidak perlu khawatir. Tidak perlu semua orang juga yang pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#Kita sebetulnya juga perlu orang buat tetap di sini dan menjaga barang-barang, jadi kami serahkan tugas itu pada kalian berdua. {NICKNAME}, Paimon, ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Oh ya? Kalau begitu bagus deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Dan sekarang aku paham kalau kamu begitu peduli pada asistenmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
