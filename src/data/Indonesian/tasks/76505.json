			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME} dan Paimon? Kebetulan sekali! Aku dengar kalian sudah berangkat ke Nod-Krai, tapi enggak nyangka kita bisa ketemu lagi secepat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Iya! Kirain mata Paimon sudah rabun atau apa gitu. Varesa, ngapain kamu jauh-jauh ke sini? Lagi tamasya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hehe, kurang lebih begitu! Kali ini aku datang untuk membeli mesin pertanian untuk kebun buah keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Ayah bilang ada barang bagus yang bisa membuat buah-buahan tumbuh lebih baik di Nod-Krai, juga bisa menghemat tenaga, jadi aku punya lebih banyak waktu untuk tidur ... dan olahraga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Setelah sampai di sini, aku menemukan banyak makanan enak yang tidak ada di Natlan! Selain urusan resmi, aku menghabiskan hampir seluruh waktuku untuk makan dan minum selama beberapa hari terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "Tak terasa, sudah waktunya pulang. Aku jadi sedikit enggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Jadi, aku harus memanfaatkan kesempatan terakhir ini dengan baik. Aku akan jalan-jalan lagi, mencoba semua yang belum pernah kumakan, dan menonton semua yang belum pernah kulihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Kalau kalian? Biar kutebak ... pahlawan kita {NICKNAME} yang tak terkalahkan, lagi-lagi sibuk menegakkan keadilan di tanah baru ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Hehe, aku paham kok! Waktu sampai di bangsa baru, semua hal terasa baru dan menarik. Aku jadi ingin foto-foto semua hal menarik dengan kamera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Kalau begitu ... Aduh! Aku harusnya juga harus memotret semua makanan lezat yang pernah kumakan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Kalau begitu, saat aku kembali ke Natlan, aku mungkin bisa minta Paman Atolli untuk mencoba membuat semua makanan lezat ini berdasarkan fotonya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Mungkin Varesa bisa berkarir sebagai fotografer makanan. Siapa tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Hehe, benarkah? Fotografer makanan ... kedengarannya sangat bagus! Setiap hari bisa berinteraksi dengan makanan enak, juga bisa memotret mereka sedemikian rupa sampai membuat orang tak kuasa menahan air liur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Sebelum kamu foto-foto makanannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Foto? Aku? Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "Ra-Rambutku kusut tidak? Sudah tidak ada saus di mulutku kan? Aduh, kalau tahu bakal ketemu kalian, aku pasti pakai aksesori yang baru dibeli kemarin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Kamu sekarang sudah bagus kok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "Wah! Kalau begitu ... tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Aku ingin mengabadikan momen indahmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Boleh foto-foto kamunya dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
