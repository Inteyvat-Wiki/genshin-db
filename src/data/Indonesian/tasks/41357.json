			"dialogs": [
				{
					"id": 413570301,
					"content": "Bagaimana? Sudah menemukan hartanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570302,
					"content": "Kami sudah menemukan semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Semuanya? Wah kemampuan mencari hartamu hebat juga. Banyak orang yang bahkan tidak bisa memutar lentera ke posisi yang benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570304,
					"content": "Nah, karena kalian sudah menemukan semua harta karunnya, ini hadiah untuk kalian. Semoga kalian bersenang-senang di Festival Lantern Rite ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
