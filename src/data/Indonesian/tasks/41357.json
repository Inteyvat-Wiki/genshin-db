			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Ayo coba mainkan Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570102,
					"content": "...I-Illumi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Illumiscreen. Kamu tertarik? Cara bermainnya mudah sekali kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570104,
					"content": "Kamu lihat layar-layar di sana? Dan tiga lentera di depan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570105,
					"content": "Aku meminta orang untuk membuat lentera-lentera itu. Saat diputar, lentera tersebut akan merefleksikan gambar-gambar yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570106,
					"content": "Lalu sebuah gambar yang lengkap akan muncul saat kamu memutar ketiga lentera ini ke posisinya yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570107,
					"content": "Hmm, mungkin aku tidak menjelaskannya dengan jelas... Baiklah, bagaimana kalau — kamu pergi dan coba putar lentera-lentera itu dulu, dan jika kamu sudah paham cara kerjanya, aku akan menjelaskan cara mainnya secara terperinci padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Wah, kamu cepat sekali mengerti. Baiklah, karena kamu sudah mengerti dasarnya, sekarang saatnya kamu mencoba memainkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570202,
					"content": "Memangnya susah...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "Tidak kok. Bukannya kamu baru saja belajar cara memutar lentera-lentera tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570204,
					"content": "Saat kamu memainkannya, kamu hanya perlu memutar ketiga lentera ini dan menggabungkan polanya di layarmu sehingga menjadi sebuah gambar yang utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570212,
					"content": "Aku akan memberi tahumu pola gambar itu terlebih dahulu, tapi kamu harus memikirkan sendiri cara memutar ketiga lentera tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570205,
					"content": "Kalau sudah jadi gambar yang utuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Mungkin kalian tidak sadar bahwa pada layar tersebut ada peta Liyue yang dilukis di atas permukaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570207,
					"content": "Saat kalian menyusun gambarnya dengan tepat dan merefleksikan nya ke peta tersebut, kalian bisa melihat \"harta karun\" yang telah disediakan oleh Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570208,
					"content": "Guild memiliki banyak orang yang bekerja keras untuk mengatur semua situs harta karun itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570213,
					"content": "Tapi kotak harta karun itu... sama dengan kotak harta karun ini. Pasti akan mudah ditemukan kalau kamu sudah tahu pasti lokasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570209,
					"content": "Aku sudah menyiapkan polanya, pola hari ini adalah <color=#00E1FFFF>Glaze Lily</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570210,
					"content": "Oh iya, satu lagi. Gambar di Illumiscreen ini hanya muncul pada malam hari. Jadi mungkin lebih baik kalau kalian datang untuk bermain di malam hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570211,
					"content": "Apalagi lentera ini dibuat khusus atas permintaan Adventurers' Guild. Mereka benar-benar indah, jadi tolong dilihat dengan jelas ya kalau tidak sayang sekali kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
