	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300302",
							"2"
						],
						"stepId": 2300302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "Pengembara! Ah salah, orang kaya, orang beruntung! Kamu sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "Aku mendapatkan untung besar di bursa setelah memakan \"Masakan Emas\" buatanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "Apa pun investasi yang sudah kubeli, semuanya terbukti untung hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Ayo, ayo ke Lambad's Tavern, aku traktir hari ini, pesan apa saja yang kalian mau. Aku yang traktir! Ini bentuk terima kasihku kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "Terima kasih untuk bantuan kalian kemarin itu. Jadi jangan sungkan-sungkan, silakan pilih apa pun yang mau kalian makan hari ini! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "Kayaknya kamu \"cuan\" banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "Lumayan banyak kalau dibandingkan dengan orang biasa, tapi kalau dibandingkan dengan hartaku, Hatim, biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "Omong-omong, aku sudah berpengalaman puluhan tahun, jadi kalau kalian tertarik dengan investasi, aku lumayan bisa mengajari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "Lagi pula, waktu itu juga kan memang aku sudah janji akan ada hadiah tambahan. Jadi, silakan menggali ilmu dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Oh, jadi ini hadiah tambahannya ... Kayak enggak ada bedanya sama enggak dapat hadiah tambahan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "Lagi pula kami tidak main investasi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Oh, jangan salah paham dulu. Mora sih sudah pasti jadi sesuatu yang akan kuberikan untuk kalian. Tapi kalau mau dibandingkan lagi, saran dan petuah dari seorang Hatim, itu jauh lebih berharga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "Kalau gitu Paimon mau nanya ... apa benar bakal ada investasi Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "Bu-Bukannya Paimon mau cari \"cuan\" ya! Paimon cuma iseng nanya saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Cuma barang yang terdapat peredarannya saja yang bisa dijadikan investasi. Dengan kata lain, kalau stok Slime Condensate ada sebanyak tepung dan susu di pasar, maka Slime Condensate bisa saja dijadikan perdagangan investasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "Tapi waktu itu aku juga sudah pernah bilang kan ya ... kalau Slime Condensate sampai diperdagangkan sebagai perdagangan investasi, maka Slime yang ada di alam liar mungkin sudah habis ditangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "Dan mungkin akan bermunculan pihak-pihak yang sengaja membudidayakan Slime dan terus memroduksi Slime Condensate dalam jumlah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "Dan kalau sudah begitu, mungkin saja harga Slime Condensate juga akan mengalami peningkatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "Wah! Paimon cuma pengen beli sedikit Slime Condensate saja padahal, kok jadi ribet gini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#Mending Paimon minta {NICKNAME} untuk langsung kalahkan Slime saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "Pembawa keberuntungan, kalau kamu, ada pertanyaan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "Bagaimana kamu bisa mengetahui tentang \"Masakan Emas\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "Ha! Pembawa keberuntungan memang hebat, langsung menanyakan kunci menuju kekayaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "Ya sebenarnya tidak bisa dibilang aku \"menemukannya\" juga sih, tapi ... ini merupakan \"hasil pembelajaran\" yang aku dapatkan selama bermain di dunia investasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "Walaupun perdagangan investasi sulit ditebak, selama ada \"Masakan Emas\", aku bisa memegang kendali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "Huh, ternyata masih saja tidak masuk akal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Sudahlah jangan mengobrol terus! Ayo kita makan dulu! Makanlah yang banyak, aku masih mau minta bantuan kalian lagi ke depannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Ayo! Coba Shawarma Wrap ini, ini adalah makanan khas Sumeru, harus coba ya, hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "Kamu menikmati makanannya bersama dengan Hatim ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Bukankah ini cuma sebatas \"sugesti menenangkan diri sendiri\" saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Aku jelas-jelas sudah makan \"Masakan Emas\", bahkan makannya pun sudah di \"Tempat Kekayaan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "Tapi kenapa hasil akhirnya malah seperti ini ... tidak masuk akal! Di mana letaknya keadilan dalam pasar ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, kami sudah daritadi mencarimu. Kamu enggak kenapa-napa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "Oh kalian ... aku ... aku tidak apa-apa, sungguh ... lihat, tidak ada yang kurang dari diriku, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "Aku cuma sedikit rugi uang saja ... *uhuk* *uhuk* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "Ma-Maaf ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Tidak! Ini bukan salahmu, jangan dimasukkan ke dalam hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Dan ... ini juga bukan salahku. Pasar yang buruk inilah yang harus disalahkan atas semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "Tidak masuk akal! Mengkhianati peraturan! Turun langsung terjun dan sedalam-dalamnya, tapi naik ... tidak naik-naik juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Keterlaluan ... Ah, sungguh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Sudahlah, aku tidak percaya kalau ... aku, Hatim, orang super kaya dari Kalimi, masih belum bisa menaklukkan perdagangan investasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Kamu bukannya sudah rugi sampai habis ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "Tidak apa-apa, aku masih punya dana cadangan yang banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030714,
					"content": "Meski uang di tanganku sudah habis, aku masih punya dana dan aset di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030715,
					"content": "Tunggu saja, Bursa Kalimi! Aku, Hatim, belum selesai perhitungan denganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		}
	]
}