					"id": 741511201,
					"content": "Sementara cuma ini yang bisa kupikirkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511202
					]
				},
				{
					"id": 741511202,
					"content": "#{NICKNAME}, menurutmu, apa Benoit dalam bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511203,
					"content": "Ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511204
					]
				},
				{
					"id": 741511204,
					"content": "Paimon punya firasat jelek nih. Gimana kalau kita laporin? Yuk kita obrolin sama Maison Gardiennage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511205,
						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "Kita enggak punya bukti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Hmm, benar juga sih. Omonganmu masuk akal. Intinya kita harus bantu Benoit, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Molli juga udah minta kita kasih tahu Benoit kalau camilan yang dia kasih enak banget. Terus kita juga sudah janji sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Sudah janji berarti harus dilakukan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Paimon tahu kok kamu cerdik dan bakal tepatin janji. Kalau gitu, selanjutnya kita mesti gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Coba kita selidiki dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Ayo kita selidiki apa yang sebenarnya terjadi! Hmm ... Lebih tepatnya, apa yang mesti kita selidiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "Identitas pasangan suami istri ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#Betul, betul. Biar kita saja yang bongkar kebenaran ini! Detektif Paimon dan {NICKNAME} beraksi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "Tujuan pasangan suami istri ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "Sikap Benoit pada mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "Kita masih belum tahu masalahnya dengan jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
					"content": "Kita tidak tahu bagaimana perasaan Benoit tentang hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
