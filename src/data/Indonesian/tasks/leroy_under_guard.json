			"dialogs": [
				{
					"id": 741511101,
					"content": "Sikap pasangan suami istri ini ke orang lain aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Betul, betul. Jelas-jelas pas waktu ketemu, mereka masih ramah banget. Tapi, baru juga beberapa hari, mereka jadi galak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "Mereka cuma baik sama kita pas di depan ayahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Hmm ... coba Paimon ingat-ingat dulu. Iya, ya, pas ketemu pertama kali, baru aja Benoit masuk, si menantu itu langsung jadi galak dan nyuruh kita jangan datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511105,
					"content": "Mereka lagi pura-pura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511106
					]
				},
				{
					"id": 741511106,
					"content": "Ngapain mereka harus pura-pura baik di depan ayah mereka sendiri sih? Pasti ada alasannya, kan? Kenapa ya? Paimon gagal paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
