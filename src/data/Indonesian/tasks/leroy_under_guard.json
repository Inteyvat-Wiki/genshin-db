			"dialogs": [
				{
					"id": 741510901,
					"content": "Pasangan suami istri ini aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Paimon juga ngerasa aneh sih. Yang satu bawel, yang satu diam banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "Kemunculan mereka terlalu kebetulan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Maksudmu mereka muncul pas Benoit mau rekrut pekerja paruh waktu buat rawatin dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Paimon ingat Nona Euphrasie bilang setengah tahun lalu Benoit sempat mau rekrut pekerja paruh waktu buat rawat dia. Baru juga lewat setengah tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Pasangan suami istri ini pun jadi anak-anaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "Kamu benar. Semua ini terlihat disengaja. Kalau dipikir-pikir, pasangan suami-istri ini bermasalah banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
