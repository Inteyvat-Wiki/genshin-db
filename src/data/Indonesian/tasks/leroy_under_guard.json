			"dialogs": [
				{
					"id": 741511001,
					"content": "Ada yang aneh sama hubungan mereka dan Benoit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511002
					]
				},
				{
					"id": 741511002,
					"content": "Waktu ketemu beberapa hari lalu, hubungan mereka masih baik-baik aja. Tapi, waktu Paimon lihat mereka ngobrol hari ini, rasanya agak canggung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511003,
						741511005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511003,
					"content": "Benoit dipaksa oleh menantunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Soalnya dia baru ngomong sebentar, menantu itu langsung kasih isyarat suruh dia masuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511007,
					"content": "Abis dengerin analisismu, Paimon jadi mulai ngerti kenapa Paimon agak bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511005,
					"content": "Benoit dipaksa oleh putrinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Paimon mikirnya enggak sejauh kamu sih. Cuman waktu putrinya ngomong, Paimon jadi merinding deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				}
			]
