			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Ayah, bagaimana dengan tidurmu belakangan ini? Masih insomnia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Aku sudah jauh lebih baik. Belakangan ini aku sudah jarang mimpi buruk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(Percakapan Keluarga Leroy perlahan-lahan terdengar semakin samar)",
