			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Kak Paimon, Kak {NICKNAME}, aku sudah kasih makan Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Oke, kalau gitu yuk kita ketuk pintu cari Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Tapi, aku agak khawatir deh. Apa dia bakal keluar? Belakangan ini waktu aku datang cari Tuan Leroy, dia sama sekali tidak mau ngobrol denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "Aku sudah ketuk pintunya sebelum kalian datang, tapi dia baru keluar sebentar saja, menantunya yang jahat itu langsung tarik dia ke dalam lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Paman yang jahat itu kasih aku permen dan suruh aku pulang. Lalu, dia tutup pintunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Padahal jelas-jelas Benoit orangnya baik, tapi kenapa keluarganya dingin begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Menantunya bilang Tuan Leroy sakit, tapi aku lihat dia sangat sehat kok. Kenapa dia tidak boleh bicara denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Kak Paimon, aku rasa tugas mengarangku sudah tidak penting lagi. Aku lebih cemas dengan keadaan Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "Kalau dia sakit, pasti sangat menderita. Ibuku bilang orang sakit itu kasihan dan butuh lebih banyak perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "Kalian bisa tidak temani aku tanya menantunya tentang penyakit Tuan Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Karena kebanyakan makan kue atau tidur tidak pakai selimut? Aku bisa pulang dan tanya orang tuaku bagaimana cara menyembuhkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Yuk kita ketuk pintunya dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Aku cuma agak takut sama menantunya. Kalian bantu aku bicara dong, dia galak banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "Jangan takut, Molli. Kami bisa bantu kamu tanya kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Kita kan sudah janjian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
