			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "Hei, kalian datang juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Nama Paimon ya Paimon, dia {NICKNAME}. Mulai sekarang kamu panggil kami pakai nama saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Molli datang buat cari Benoit ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Iya, tapi aku enggak bisa ngobrol lagi dengan Tuan Leroy .... Duh, aku jadi enggak bisa kerjakan tugas mengarang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Mengarang? Oh, Paimon ingat! Molli kan bantu Tuan Leroy buat kerjain PR.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Bukan gitu! Aku aslinya memang sangat suka Tuan Benoit. Dia itu ... hmm ... mulus! Ya benar, mulus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Pfft, deskripsi macam apa itu? Harusnya kamu bilang dia gampang bergaul, atau semacamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Oke, Kak Paimon. Bisa bantu aku pikirkan cara? Aku jadi enggak bisa tulis karanganku nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "Guru privatku bilang karanganku tentang membantu Tuan Leroy kasih makan kucing itu \"mulus dan penuh perasaan\", makanya aku disuruh tulis karangan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "Kok \"mulus\" sih? Maksudmu tulus, ya? Oh, Paimon tahu. Pantesan kamu mau datang ke rumah Benoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Meski demi PR, aku juga benar-benar suka dengan Tuan Leroy! Dia suruh aku sampaikan salam ke orang tuaku, juga sudah kusampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Orang tuaku marah sekali begitu dengar nama Tuan Benoit, mereka tidak izinkan aku datang. Aku juga tidak tahu kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "Cari bahan buat mengarang itu gampang, Molli. Sama kayak waktu itu aja, kamu tulis aja waktu bantuin dia kasih makan kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Kalau seperti itu, aku cuma bisa tulis satu baris saja. Itu terlalu sedikit, mana cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "Kami temani kamu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Betul, betul, kayak waktu itu aja. Kamu kasih makan kucing, kami bersihin noda di pintu dan belakang rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "Setelah selesai, kita ketuk pintu cari Benoit. Nah, kamu jadi punya bahan buat nulis karangan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Benar juga, itu ide bagus! Kak Paimon pintar sekali. Kalau begitu, aku kasih makan kucing dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
