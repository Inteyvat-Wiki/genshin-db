					]
				},
				{
					"id": 741510502,
					"content": "Kalian lagi? Sebenarnya kalian ini ada masalah apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510503,
					"content": "Maaf, kami mau tanya, Benoit di rumah enggak? Katanya dia sakit ya, kami khawatir sama kondisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "Ayahku di rumah, tapi dia sedang tidak enak badan, tidak bisa keluar temui tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510505,
					"content": "Bisa kasih tahu aku apa penyakitnya? Aku bisa minta orang tuaku untuk berikan obat ke Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510506,
					"content": "Tidak usah. Kami bisa beli obatnya sendiri. Lagi pula, ayahku tidak kekurangan obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510507,
					"content": "Kami kan cuma khawatir saja. Kenapa jawabnya dingin gitu sih ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Si Athos ini sama sekali enggak izinin kita ketemu Benoit!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Sikap dinginnya agak keterlaluan deh ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "Kalian jangan ikut campur urusan orang lain. Masih ada urusan lain tidak? Kalau tidak, aku mau masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510512,
					"content": "Tunggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "Kamu mau ngomong apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510514,
					"content": "Benoit benaran sakit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Tentu saja sakit, sakitnya juga parah sekali. Aku dan Morticia sedang memikirkan cara menyembuhkannya. Kalian tidak perlu khawatir soal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510518,
					"content": "Athos, ada ribut-ribut apa di luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Tidak ada apa-apa, Morticia. Ada beberapa anak kecil yang bilang mau mengunjungi Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510520,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Ayah populer sekali di kalangan anak-anak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Kalau ada anak kecil yang mau ketemu Ayah, bagaimana kalau Ayah keluar menyapa mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "Aku keluar temui mereka ya ... Boleh tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Tentu saja boleh. Terserah Ayah saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "Pintu pun terbuka. Benoit perlahan-lahan berjalan keluar dari ruangannya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "Tamu-tamuku, kalian datang lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "Tuan Leroy, kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510528,
					"content": "Aku? *Uhuk-uhuk* Kondisi tubuhku tidak terlalu baik. Tapi, kalian tidak perlu khawatir, aku sedang berusaha istirahat supaya sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "Putriku dan menantuku sangat baik padaku. Semuanya baik-baik saja kok. Kalian pulang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "Ayah, tubuhmu baik-baik saja? Kalau capek, lebih baik masuk saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510531,
					"content": "Benoit menatap mata Athos dengan tatapan yang mendalam, lalu masuk ke dalam tanpa berkata-kata.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Oke, kalian sudah lihat, kan? Ayahku memang sedang tidak enak badan. Sekarang kalian sudah puas, kan? Kalau tidak ada urusan lain, aku mau masuk saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510533,
					"content": "Kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Athos mengabaikan kalian.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Kali ini kita bisa ngobrol beberapa kalimat dengan Tuan Leroy. Hmmm, semoga dia cepat sembuh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510536,
					"content": "Kak Paimon, sepertinya aku menyusahkan orang lain. Sebenarnya aku juga tidak mau seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510537,
					"content": "Kok Molli mikirnya gitu sih? Kamu enggak nyusahin orang lain kok. Yang rese itu Athos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Hmm ... apa sih? Dari awal sampai akhir dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Molli, kamu pulang dulu aja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Eh? {NICKNAME}, kamu kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Ya, aku harus pulang. Sebenarnya orang tuaku tidak suka kalau aku ke sini. Kalau mereka tahu hari ini aku ke sini, mereka pasti akan marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510543,
					"content": "Aku tidak tahu masih ada kesempatan ketemu lagi dengan Tuan Leroy atau tidak. Aku sebetulnya ingin kasih tahu dia kalau camilannya benar-benar enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510544,
					"content": "Kalau kalian bisa ketemu dia lagi waktu dia sudah sembuh, kalian boleh tidak sampaikan pesanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510545,
					"content": "Ya, tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "Paimon juga janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#Oke, terima kasih ya, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510549,
					"content": "Aku pulang dulu ya. Sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510550,
					"content": "#{NICKNAME}, kamu kepikiran sesuatu ya? Dari tadi Paimon lihat kayaknya ada yang mau kamu omongin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Kita ngobrol di sana saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Ya, sudah. Kalau gitu kita ngobrol di sana deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Jangan kencang-kencang kalau bahas masalah itu di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Ya, aku janji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Aku dan Paimon juga mau balik kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Kenapa kamu halangi kami ketemu Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "Kenapa aku harus izinkan orang yang tidak ada hubungan mengunjungi ayahku? Aku sudah bilang kondisi tubuhnya tidak baik dan tidak bisa temui tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510510,
					"content": "(Kenapa tiba-tiba dia jadi dingin ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
