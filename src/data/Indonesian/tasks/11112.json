					"Little Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Sip, seharusnya sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120302,
					"content": "Aku akan mulai menyiapkan Jueyun Chili Chicken-nya. Sementara itu, barangkali kalian masih harus mencari orang-orang lainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120303,
					"content": "Nanti saat semua orang sudah siap, aku akan mengantarkan makanan ini kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120304,
					"content": "Baiklah! Sampai jumpa nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120305,
					"content": "(Eh? Kok dia bisa tahu rencana kunjungan ke orang yang lainnya, ya...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
