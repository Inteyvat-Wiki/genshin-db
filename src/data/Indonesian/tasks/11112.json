			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Kalian lagi... Sudah kubilang kalau aku tidak tertarik dengan apa pun yang dikerjakan oleh Wangsheng Funeral Parlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng bercerita kepada kami tentang dirimu, kalian teman baik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Ya, itu benar. Ngomong-ngomong tentang Meng, aku ingat kalau dia baru saja bergabung dengan Wangsheng Funeral Parlor belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "Kami sebagai teman-teman baiknya tidak heran mengapa dia harus bergabung... Pasti karena insiden Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Tapi aku tahu kalau kita tidak bisa memaksanya melupakan begitu saja. Melepaskan masa lalu memang sebuah proses yang menyakitkan. Aku tahu persis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Jadi apakah kedatangan kalian menemuiku juga ada kaitannya dengan perihal Big G?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Kenapa kamu bisa tahu?! Padahal kami belum mengatakan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Haha, jangan khawatir, aku adalah seorang pebisnis, aku tidak akan membocorkan rahasiamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Semua orang yang mendengar nama \"Mumu\" berpikir bahwa aku adalah orang yang bodoh, dan hal itu terjadi terus-menerus bahkan sampai aku mulai membuka bisnisku. Tapi... aku kini berhasil membuktikan kalau mereka semua salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Ambillah ini, ini adalah kotak mainan mewah yang selalu kami impikan sejak masih kecil. Tapi dulu kami belum sanggup membelinya karena belum memiliki uang sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Syukurlah sekarang bisnisku cukup lancar. Karena itu aku bisa mewujudkan mimpiku untuk membeli banyak kotak mainan mewah ini. Bisa dibilang ini adalah mimpi yang menjadi kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Wow, kamu pasti kaya sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Hahaha... Bagiku itu adalah sebuah benda kenang-kenangan masa kecil. Tanpanya, kita tidak akan bisa menjadi seperti sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Oh iya, berarti setelah bertemu denganku, selanjutnya kalian akan mencari Little Wu dan Congzi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Betul! Kami sudah bertemu dengan Little Wu, sekarang kami tinggal mencari Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Oh begitu. Kalau kamu mencari Congzi, nanti kita ketemuan saja di koridor atas Feiyun Slope. Tepat di atas tangga yang arahnya menghadap ke pelabuhan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Masih ada hal yang harus kulakukan, aku akan segera menyusulmu setelah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
