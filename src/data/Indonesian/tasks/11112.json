			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Semuanya terjadi begitu cepat, Paimon sudah tidak tahu lagi apa yang sedang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Aku juga tidak menyangka tiba-tiba didatangi Big G.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Sebenarnya aku juga tidak terkejut sama sekali sih. Ingat kata-kataku kalau hanya ada sedikit roh jahat di dunia ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "Dia juga meninggalkan Wuwang Hill karena sebuah kebetulan. Sekarang dia tidak bisa kembali karena suatu alasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Paimon merasa penjelasan ini tidak begitu menjelaskan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Sebenarnya ... yang dia ucapkan semuanya benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120108,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Hehe, jangan pernah meragukan insting profesionalismeku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Aku hanya ingin berjumpa dengan teman-temanku. Makanya aku datang ke Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120111,
					"content": "Jujur aku bukan ingin berbuat usil kok! Aku tidak berencana menakut-nakuti siapa pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120112,
					"content": "Beberapa hari lalu, ada beberapa orang yang datang ke Wuwang Hill untuk menguji nyali. Lalu aku mendengar kalau mereka datang dari Pelabuhan Liyue, makanya aku mengikuti mereka sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120113,
					"content": "Aha, pasti orang yang kamu ikuti adalah Luocheng yang malang itu. Mungkin dia tidak bisa melihatmu, tapi dia masih bisa merasakan kehadiranmu. Sekarang kita jadi tahu apa sebenarnya yang membuatnya bermimpi buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "Eh? A-aku ketahuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120115,
					"content": "Sepertinya begitu. Kalau tidak, dia tidak akan ketakutan setengah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Kenapa kamu tidak langsung mencari Meng saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Iya, padahal Hu Tao dan Meng sudah berkeliling ke mana-mana mencarimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh, itu karena aku tidak tahu mereka ada di mana. Ini pertama kalinya aku datang ke Pelabuhan Liyue, jadi aku tersesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120119,
					"content": "Benar juga, seingatku Big G memang buruk sekali soal mengingat arah. Saat kita masih kecil, dia tidak pernah bisa turun gunung sendirian, kami harus selalu memandunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Jadi semua ini terjadi karena kamu tersesat?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Kenapa kamu tidak terbang saja seperti hantu atau arwah lainnya? Bukannya lebih mudah mencari dari atas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "A-aku... tidak berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120123,
					"content": "Aku takut karena terlalu tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120124,
					"content": "Betul, betul. Dia juga sangat takut pada ketinggian sampai-sampai tidak berani melihat ke bawah dari atas gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, kamu tidak berubah sedikit pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Aku tahu kalau aku tidak seharusnya menampakkan diri kepada orang-orang, dan karena di Pelabuhan Liyue justru ada banyak sekali orang, aku tidak punya pilihan lain selain bersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120129,
					"content": "Aku tidak akan bisa menemukan kalian kalau kalian tidak mengaktifkan Monolit Ley Line itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120130,
					"content": "Aku lega sekali, ternyata kamu tidak menjadi roh jahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Makanya jangan pernah meragukan insting profesionalismeku. Sekarang kita hanya perlu mengantar anak ini kembali ke Wuwang Hill, dan semuanya akan beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Tapi dia bilang dia mau mengunjungi teman-temannya. Selain aku, masih ada Little Wu, Mumu, dan Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Yah... kalau begitu kita tidak boleh mengecewakannya. Ayo kita minta bantuan mereka untuk menyiapkan upacara perpisahan dengan Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng dan aku akan mengantarkan Big G kembali ke Wuwang Hill. Sementara itu, tolong kamu temui ketiga teman mereka berdua dan mintalah satu barang dari mereka yang paling dapat melambangkan diri mereka masing-masing. Sesudah itu, kita ketemuan di Wuwang Hill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Mereka semua kan berteman, kenapa kita tidak ke sana saja bersama-sama? Atau mungkin kita bisa mengantarkan Big G menemui mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Em... Sepertinya bukan ide yang bagus. Aku tidak ingin membuat mereka ketakutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120137,
					"content": "Aku tidak ingin membuat orang-orang biasa jadi percaya dengan takhayul. Lebih baik kalau mereka tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Jadi berhati-hatilah dengan kalimat yang kamu ucapkan saat meminta barang pada mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Kalau begitu kamu kurang cocok dipanggil \"Big G\" dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Jadi Big G bukan roh jahat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Uhh... Hai! Hehehe... Apa kamu masih ingat kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Kalian... Maaf ya, aku masih belum membutuhkan jasa pemakaman saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120203,
					"content": "Meng sudah menceritakannya kepada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Betul, Meng dan aku tumbuh besar bersama. Kami masih tetap berkomunikasi sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120206,
					"content": "Aku tidak tahu kenapa dia memutuskan untuk bekerja di Wangsheng Funeral Parlor. Jujur saja, aku merasa sang Master cukup aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120207,
					"content": "Tapi Meng pasti punya alasannya tersendiri. Lagi pula, sampai sekarang hanya dia seorang diri saja yang masih belum bisa menerima kenyataan terhadap apa yang terjadi pada Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120208,
					"content": "Apakah dia bercerita tentang Big G kepadamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120209,
					"content": "Ya, sudah. Kalau kamu bisa memberikan sebuah benda untuk kenang-kenangan Big G, kamu mau memberikan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Ini hanya berandai-andai saja, misalkan saja. Kita tidak berencana memperingati Big G kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Kelihatannya sudah cukup jelas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120214,
					"content": "Aku akan memasak sesuatu untuknya. Dia dapat makan makanan yang pedas, sementara kami teman-temannya tidak bisa. Makanan kesukaannya adalah Jueyun Chili Chicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120215,
					"content": "Aku bisa membuatkannya untukmu kalau kamu membawakan beberapa Jueyun Chili untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120216,
					"content": "Aku yakin dia akan sangat menikmati cita rasa masa kecilnya. Dan aku pun masih menggunakan resep yang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120217,
					"content": "Sepakat! Tunggu sebentar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Beginilah Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Kata Meng kamu adalah teman masa kecilnya dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
