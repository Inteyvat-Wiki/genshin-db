				"points": []
			},
			"dialogs": [
				{
					"id": 745280401,
					"content": "Oh, rupanya kamu. Sepertinya perjalanan kita kembali bersinggungan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Skirk, sudah lama tidak bertemu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "Aku sedang mengamati \"bekas luka\" yang ditinggalkan oleh dunia ini. Ledakan itu telah mengubah tempat ini menjadi reruntuhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "Tapi sekarang, orang-orang telah membangun sesuatu yang baru di atas reruntuhan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "Segala sesuatu pasti ada akhirnya, tapi setelah kehancuran, ada kemungkinan lahir sesuatu yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "Kekuatanmu sudah berkembang sejak terakhir kali kita bertemu. Sepertinya kamu tidak berhenti berlatih. Baguslah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "Aku punya satu permintaan kecil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Foto? Di dunia ini, aku hanyalah seseorang yang sedang lewat saja, kenapa aku harus meninggalkan jejakku di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "Tapi bagiku, kamu bukan sekadar orang yang lewat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "... Kalau memang itu yang mau kamu lakukan, lakukan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "Aku akan ada di sini terus. Kita bisa mulai kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "Setiap pertemuan pantas untuk dikenang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "Aku mau mengambil fotomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "Kamu sedang apa di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
