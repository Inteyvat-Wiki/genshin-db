			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Tidak kusangka kalian masih ada di pulau ini, pas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Apa kabar kalian belakangan ini? Apa ada penemuan mengejutkan? Coba ceritakan padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Tidak ada apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Apa boleh buat! Tapi pulau ini tidak kekurangan rahasia, aku yakin kalian pasti bisa menemukan sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Tapi omong-omong, kenapa Tuan Roald ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Hmmm? Aku baru saja beres-beres kemahku dan bersiap pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "Kabut di pulau ini benar-benar mengerikan ... Setiap kali aku masuk, pasti langsung kehilangan arah. Lalu kembali ke titik awal tanpa sadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Aku juga sudah lupa sama sekali dengan jalan yang ditunjukkan Kama ... Sebenarnya aku ingin kembali menemui penduduk asli di sana, tapi aku tidak menemukan jalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Mau pakai kompas atau melihat bayangan di tanah, semuanya tidak bisa menunjukkan arah. Aku bahkan sudah mencoba menggunakan sepatuku, tapi sama saja tidak bisa masuk lebih jauh ke dalam kabutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Sepatu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Maksudnya melempar sepatu untuk menunjukkan arah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Eh—?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Ha! Petualang sehebat kamu memang tahu segalanya, {NICKNAME}! Paimon harus belajar banyak darinya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Paimon, harus lebih rajin lagi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Jelas-jelas kamu cuma beruntung saja! Buat apa Paimon belajar hal seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Yah pokoknya begitu deh, jadi perjalananku harus terhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "Ah... kalau saja kuikat talinya ke pohon terdekat, lalu coba maju sambil pegangan erat ke ujung yang lain, harusnya bisa dicoba beberapa kali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Jadi kenapa tidak coba lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Sepatu yang kusiapkan buat cari tahu arah sudah dilempar semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Jadi sepatu serep itu cuma sekali pakai saja ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Hehe, aslinya tidak kok. Cuma saja, aku kebanyakan lempar sepatu, lalu lupa pungut lagi, sampai lambat laun akhirnya ... hilang semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Oh! Betul juga, aku jadi ingat mau minta tolong apa sama kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Waduh, kaget tahu! Paimon kira kamu mau gigit orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Maaf, maaf, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Seperti yang kalian tahu, aku punya kekurangan yang lumayan bikin malu ... yaitu, selalu ceroboh apa pun yang aku kerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Daya ingatku yang buruk sudah sering membuat repot. Apalagi melihat kalau aku ini seorang petualang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "Salah satu tujuanku datang ke Pulau Tsurumi adalah untuk mengumpulkan sesuatu yang bernama \"Fluorescent Fungus\". Menurut Sango, jenis jamur ini dapat menguatkan daya ingat serta mengurangi stres. Lalu katanya bisa juga mempertajam penglihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "Waktu aku ke sini dengan Kama terakhir kali, aku terlalu sibuk \"bertemu dengan warga lokal\" sampai lupa cari jamur itu ... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Aku juga tidak sangka bakal dapat banyak sekali masalah begitu datang ke sini sendirian. Sayang sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Jadi, kalau kalian masih ada rencana untuk bertualang di sekitar sini, boleh bantu aku cari sedikit saja Fluorescent Fungus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Asal kamu tidak lupa sama aku saja nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha, jangan takut, tidak bakalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Sayang sekali ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "Ah, iya kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Kita masih sedang menjelajahinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Ternyata begitu ya, haha. Kalau begitu aku tidak mau mengganggu perjalanan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Iya, segini harusnya cukup. Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "Kalau kalian menemukan sesuatu di sekitar tempat upacara di pulau, kasih tahu aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Oh ya, Kamera yang kalian bawa terus ... berasal dari Fontaine kan? Benda itu cukup mahal loh. Kalau uangku cukup, aku juga mau membeli satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Sejarawan setempat bilang bahwa penduduk asli Pulau Tsurumi akan menggunakan cat untuk menggambarkan sejarah yang sudah terlupakan di dinding gua. Mural yang ada di sini sudah berusia ribuan tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Terakhir kali ke sini, aku pakai api dari upacara untuk melihat muralnya. Sejak itu aku tidak bisa melupakannya, sampai susah tidur selama berhari-hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Setahuku, belum ada yang pernah lihat mural itu secara keseluruhan. Tapi kalau kalian bisa buktikan bahwa mural itu ada, berarti kalian sudah buat terobosan yang besar bagi Adventurers' Guild untuk bidang sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Jadi kuharap kalian dapat mencari mural legendaris tersebut dan memotretnya sejelas mungkin. Aku akan membeli foto-foto kalian sebagai bahan jurnalku, dan memberi kalian upah yang sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Bagaimana menurut kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Jangan hilangkan jurnal lagi loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Aku ... Akan kuusahakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
		{
