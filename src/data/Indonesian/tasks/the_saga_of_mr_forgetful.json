				"points": []
			},
			"dialogs": [
				{
					"id": 721750401,
					"content": "Halo, ada hal menarik apa yang kalian dapatkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750402,
					"content": "Tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Tidak usah terburu-buru. Aku akan terus menunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750404,
					"content": "Oh ya, terima kasih untuk Fluorescent Fungus pemberianmu! Segar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "Ngomongnya sih gampang. Jamur yang kamu makan juga kami yang petik loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Hahaha, jangan begitu dong. Aku makan terus jamurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750409,
					"content": "Wah, dasar amnesia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750405,
					"content": "Masih sedang diusahakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "Istirahatlah kalau capek. Kita nyalakan Fluorescent Fungus yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				}
			]
		},
