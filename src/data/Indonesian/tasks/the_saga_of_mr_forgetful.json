			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Wah, kita ketemu lagi {NICKNAME}! Dan ada juga si ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Mau tanya dong, si kecil yang terbang ke sana kemari ini harganya berapa? Kelihatannya seru juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Apa kamu baik-baik saja...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Jelas tidak dong! Kenapa dia tiba-tiba hilang ingatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "Kalian bilang apa sih ... Ha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahahaha ... Uhuk ... Hahaha! Lihat ekspresi kalian itu! Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Aduh, aku tertawa sampai sesak napas ... Maaf, maaf ... Ini ... Hahahaha! Ini adalah lelucon amnesia favoritku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Tidak lucu sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Aku tidak mengerti di mana lucunya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "Iya, iya, tidak melucu lagi. Maaf, maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Dasar, aku kira petualang hebat seperti kamu, orangnya serius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Hahaha, jangan punya kesan buruk seperti itu. Adventurers' Guild penuh dengan kumpulan orang-orang aneh. Aku masih termasuk normal kalau dibandingkan dengan yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "Tidak normal-normal amat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Terima kasih untuk jamurnya ya. Sampai sekarang sih, efeknya masih belum terlihat jelas. Mungkin perlu dimakan dalam jangka waktu lama, atau jamur itu bukan obat herbal ... Yang pasti rasanya lumayan enak sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Semua ini tidak boleh dihabiskan semua, aku akan sisakan beberapa untuk teman di Sumeru agar bisa diteliti nilainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Kurasa sebentar lagi kamu akan lupa hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "Ehem! Mari kita kembali ke topik semula. Apa kalian sudah coba cari muralnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Ini foto-foto yang kamu inginkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Oh, budi baik ini pasti akan kubalas! Begitu kan, cara orang sini bilang terima kasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Uh, menarik. Sangat menarik. Hanya saja, kalian belum menemukan lebih banyak mural lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Ini sudah semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Makin menarik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Penduduk Tsurumi pernah memercayai burung magis berelemen Electro, dan membentuk peradaban sendiri melalui upacara ritual. Orang yang mengerti sejarah pasti tidak akan membantah hal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Tapi dari contoh mural yang kalian berikan, tidak ada jejak Thunderbird sama sekali. Yang mereka sembah justru sesuatu yang lain—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Matahari, bulan, bintang-bintang, dan lambang-lambang aneh. Mungkin sebelum Thunderbird turun, leluhur orang sini sudah punya peradaban yang tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Selain itu ... kabut dan cahaya bulan, bintang-bintang dan kegelapan ... Ugh, sulit dijelaskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Mending jangan pakai otak terus ... ingatanmu jelek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "Ah, maaf. Aku keasyikan berpikir hingga melupakan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Terima kasih untuk bantuan kalian. Jurnalku jadi punya bahan yang cukup untuk ditulis ... Kalau bisa dihargai oleh para sejarawan, aku pasti tidak akan lupa mencantumkan nama kalian berdua di atasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Baiklah, sudah saatnya aku pergi melapor ke Adventurers' Guild. Maaf sekali, karena sudah merepotkan kalian dalam waktu lama. Sampai jumpa lagi di lain kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Benar-benar orang sibuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Oh ya, masih ada satu hal lagi. Bukan hal besar sih, tapi kuharap kalian dapat membantuku perhatikan anak kecil yang kusebut tadi. Namanya ... siapa ya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "\"Ruu\", itu namanya. kali ini aku bawa makanan buat dia ... semoga masih segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Sejak datang ke sini tempo hari, aku sering kepikiran tentang anak itu. Aku tahu hidup tidak mudah di pulau yang berbahaya begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Oke, cukup sampai sini dulu bicaranya. Sampai ketemu di perjalanan berikutnya, {NICKNAME}! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Kami hanya menemukan gambar-gambar ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Ini adalah cara orang amnesia untuk beradaptasi di dunia ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Apa Fluorescent Fungus manjur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
