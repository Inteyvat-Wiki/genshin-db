						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Aku sedang berpikir, di mana bisa dapat benih bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "Dulu, karena kejadian di Mikage Furnace, semua warga yang tinggal di sini dievakuasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Lalu aku dengar kalau masalahnya sudah berhasil ditanggulangi, jadi aku kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
