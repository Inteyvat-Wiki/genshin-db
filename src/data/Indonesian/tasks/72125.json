			"dialogs": [
				{
					"id": 721250501,
					"content": "Apa benih bunga ini bisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Ini... Bisa! Sangat bisa! Dengan benih ini, aku bisa tanam banyak bunga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "A-ah, maaf, sebentar... Aku harus memberimu imbalan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Ini untukmu. terima kasih untuk benih bunganya. Nanti kalau kamu ke sini lagi, tempat ini pasti sudah jadi lautan bunga yang indah!",
					"roleType": "TALK_ROLE_NPC",
