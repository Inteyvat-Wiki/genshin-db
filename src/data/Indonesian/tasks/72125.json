			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Kalau saja bisa menanam lebih banyak bunga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "Ah, halo! Senang bertemu denganmu... Permisi, apa kamu juga baru kembali? Maaf, sepertinya aku belum pernah melihatmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "Baru kembali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Betul, karena kejadian di Mikage Furnace, semua warga Tatarasuna dievakuasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Belum lama ini, kudengar masalah di Mikage Furnace sudah ditanggulangi, dan Tatarasuna sudah aman. Jadi aku pergi untuk bertanya apa sudah bisa pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Setelah dapat izin, aku langsung berkemas lalu pulang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Tapi... orang yang mau kembali ke sini cuma sedikit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Tapi apa boleh buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Karena masalah yang terjadi pada Mikage Furnace sangat serius, semua orang jadi takut hal itu terulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Kamu tidak takut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Tentu saja aku juga takut... Tapi ini rumahku, selain itu aku kepikiran bungaku terus, hehe. Jadi kuputuskan untuk kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Tapi bunga yang dulu aku tanam di sini sudah layu semua, dan sekarang aku tidak bisa menemukan benih bunganya. Sayang sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Tempat ini sangat cocok untuk menanam bunga. Benih apa pun itu, akan jadi lautan bunga dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Dulu aku bahkan pernah mencangkok bunga dari luar negeri seperti Small Lamp Grass, Windwheel Aster dan Dandelion dari Mondstadt, serta Silk Flower dari Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Small Lamp Grass cantik sekali di malam hari. Dia harus ditanam di tempat yang sejuk, sering disirami, lalu harus rajin memangkas ujung daun yang mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Windwheel Aster katanya akan tumbuh subur di tempat yang banyak anginnya. Aku merasa angin di Inazuma tidak bisa dibandingkan dengan angin di Mondstadt... Jadi aku sering mengipasi bunganya, entah ada gunanya atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Dandelion tidak perlu terlalu diurus, dia bisa merawat dirinya sendiri. Tapi... justru karena itulah dia jadi banyak tumbuh di tempat-tempat aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Ah, begitu ya. Aku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "Beda lagi kalau Silk Flower dari Liyue, dia susah sekali diurus. Onikabuto suka diam di kelopak bunga Silk Flower, dan aku harus menyingkirkan mereka satu per satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Tapi aku gagal saat mencangkok Qingxin. Setiap kali jadinya kecil saja atau malah langsung layu. Ah, kalau saja di dunia ini ada tanah yang bisa ditanami segala jenis bunga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Mungkin ada. Aku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Oh iya, apa kamu tahu di Liyue ada bunga yang bernama Violetgrass? Bunga itu susah sekali dicari, aku sudah minta tolong pada banyak orang, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Ah! Maaf, maaf! Aku selalu begini kalau membahas tentang bunga. Maaf ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Ka-kamu suka sekali sama bunga ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Aku cuma penikmat saja, hehe... Tapi sekarang aku bahkan tidak punya benih untuk menanam bunga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Aku bukan warga sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Eh? Begitu ya? Kukira kamu sama denganku, bersedia untuk kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Karena kejadian di Mikage Furnace, semua warga Tatarasuna dievakuasi.",
					"roleType": "TALK_ROLE_NPC",
