			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru benar-benar tempat yang bagus! Aku pasti balik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Kamu akan selalu disambut di sini. Avin juga pasti senang kalau bisa ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "Iya, janji loh ya! Aku tunggu Kakak datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
