			"dialogs": [
				{
					"id": 130320201,
					"content": "*hosh* Kakak ... hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Hehe, sedikit lagi kamu nyusulin aku loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin seimbang sama Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "Aku pernah menang balap lari sama orang dewasa dulu. Kaki panjang bukan otomatis larinya cepat, harus latihan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Hahaha, berapa tahun lagi aku sudah enggak bisa menang lawan kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hmm ... sekarang ke mana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Ah, lihat! Ada yang melayang tuh di depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Bentuknya kayak ... bintang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Apa dia minta kita ikuti gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Hmm, mungkin. Ayo ikutin saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
