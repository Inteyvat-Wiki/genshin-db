						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Kak Yoimiya, sebelum pulang boleh kan aku ceritain mimpiku yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "Aku mau pergi ke Inazuma dan nonton kembang api di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Wuih, asyik nih! Hehe, enggak sangka lagi liburan malah dapat pelanggan baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Aku janji bakal bikinin kamu kembang api yang tidak terlupakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "Kalian berdua juga. Sesibuk apa pun petualangan, ingat mampir ke Inazuma ya kali-kali. Kalian akan selalu disambut, kapan pun waktunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Kalian harus ke sana buat lihat kembang api yang terinspirasi dari hujan meteor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Oke, siplah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Jaga diri baik-baik ya, Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "Pastinya, pastinya! Dasar kamu, serius melulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Oh iya, lihat nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Ukiran kayu Aranara ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "Betul. Ini yang kalian bantu pilihin, yang katanya mirip sama aku loh. Aku beli lagi ... buat kalian nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Kalau lagi sendu, lihatin saja. Siapa tahu bisa bikin kamu semangat. Setidaknya, ini bukti kalau aku akan selalu dukung kamu dari jauh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Ketemu langsung jauh lebih bagus sih, tentunya. hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Makasih ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Oke, aku pulang dulu ya. Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "Aku puas sekali sama perjalanan kali ini. Kagum, malah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "Ke mana pun kalian berdua pergi, aku yakin dan percaya kalau kehangatan persahabatan kita akan selalu menopang langkah kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "Maju, teruskan perjalanan kalian sampai ujungnya ... dan sampai ke ujung dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "Aku pasti jaga baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "Semoga setiap hari selalu menyenangkan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Setiap hari, dan seterusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "\"Kembang api memang hanya sekejap, tapi persahabatan itu selamanya\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "Wo-Woi, kenapa keras banget ngomongnya? Jadi malu ....",
					"roleType": "TALK_ROLE_NPC",
