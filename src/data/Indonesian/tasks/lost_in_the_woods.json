					"content": "*napas berat*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Si Bongsor?"
				},
				{
					"id": 750000111,
					"content": "#Kasihan ... dia pasti kesakitan banget. {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000112,
					"content": "Kami sudah membasmi musuh-musuhmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "*napas berat*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Si Bongsor?"
				},
				{
					"id": 750000115,
					"content": "Kenapa? Apa ... ingin menyampaikan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "Mau bilang ... apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "Ulurkan ... tanganmu ... Yang Terpilih ... oleh Naga ... Ulurkan tanganmu padaku ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Padukan ... kekuatan ... Lalu ... jadilah saksi untuk semuanya ... untuk ... bebaskan semuanya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}, kamu kenapa lagi? Ini bukan waktunya bengong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
