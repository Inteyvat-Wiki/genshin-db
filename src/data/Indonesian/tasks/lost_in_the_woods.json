					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Wah, dia suka tuh! Oke, semoga misteri tentang kamu bisa ketahuan setelah kita sudah sampai Natlan ya. Sama mungkin bisa dapat petunjuk soal kenapa {NICKNAME} bisa tiba-tiba masuk ke badan Saurian tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Oh, kamu enggak apa-apa kan, {NICKNAME}? Kamu tiba-tiba berubah jadi Saurian tadi ... ada kerasa enggak enak atau apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Lumayan, mabuk Saurian nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Itu maksudnya APA WOI?! Paimon serius nanya, malah dibercandain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Tapi ya, {NICKNAME}. Paimon belum pernah dengar siapa pun di Natlan yang bisa berubah jadi Saurian ... ini aneh, sangat aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Kita baru juga sampai, tapi kok kayaknya sudah banyak peristiwa yang terjadi ya. Ah, gimana caranya kita keluar dari sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hmm? Kamu tahu jalan keluarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Aku jadi Saurian loh. Mantap, keren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Ya sudah, jaga tuh perasaan \"mantap\"-nya! Berabe kalau suatu hari nanti kamu berubah jadi Saurian, lalu enggak bisa balik lagi ke wujud semula ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
		},
