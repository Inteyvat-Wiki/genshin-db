			"dialogs": [
				{
					"id": 750000101,
					"content": "Hei, hei, bongsor ... Kamu oke? Bisa berdiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000102,
					"content": "Aduh, gimana nih! Kayaknya dia sudah lemah banget. Ampun ya, si guguk setan terbang itu memang enggak ada baik-baiknya sama sekali ... KESEL! Kenapa sih yang terbang-terbang gitu selalu enggak beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000103,
					"content": "Kamu pernah ngaca enggak sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Paimon beda jauh ya dari mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000105,
					"content": "Sudah, lupain dulu! Kita cariin makan saja buat dia, terus ... temenin dia istirahat deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000106,
					"content": "Dia pasti bisa sehat! Pulih lagi! Paimon yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000107,
					"content": "Terlambat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "Aduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Paimon"
				},
				{
