					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Cara bisnis seperti ini tidak akan tahan lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Maaf, maaf. Aku tiba-tiba keasyikan melamun. Kamu mau membeli pakaian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Meskipun sutra dan satin kualitas tinggi Liyue masih tidak ada stok, tapi kimono dengan model baru masih tersedia banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Kamu biasanya mengimpor stok dari Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Iya, dulunya toko kami selalu mengimpor sutra kualitas tinggi Liyue, misalnya seperti sutra Feiyun Commerce Guild yang terbuat dari Silk Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Tapi kondisi Inazuma yang sekarang... Toko ini sudah tidak ada stok sutra seperti itu lagi selama beberapa waktu. Sekarang kami hanya bisa mengandalkan sisa stok dulu untuk terus beroperasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Stok sutra-sutra di toko ini, bisa dibilang semakin hari semakin berkurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Aku sendiri sebenarnya berniat mendesain corak baru, atau memakai pewarna baru untuk membuat kain dan baju model baru yang dapat menarik minat pembeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Tapi sampai sekarang aku belum menemukan pewarna yang bisa disebut \"inovatif\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "Pengembara, kamu sudah bertualang di segala penjuru dan pasti sudah mengalami banyak hal... Apa kamu pernah melihat pewarna yang benar-benar inovatif?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Iya, aku sudah melihat banyak sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "Be-benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Kalau boleh, bisakah kamu membantuku dan mengambilkan bahan-bahan untuk membuat pewarna baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Aku akan menyiapkan imbalan yang pantas untukmu. Tolong dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Hanya mau pewarna ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Dalam situasi ini, aku hanya bisa memikirkan solusi dalam hal pewarna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Kalau kamu tahu bahan-bahan apa saja yang bisa dijadikan pewarna inovasi baru, tolong bawakan ya, aku akan siapkan imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
