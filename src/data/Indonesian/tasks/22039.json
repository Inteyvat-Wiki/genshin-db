			"dialogs": [
				{
					"id": 220390201,
					"content": "Kalau begini terus, usaha ini tidak akan bertahan lama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390202
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390202,
					"content": "Apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390203
					]
				},
				{
					"id": 220390203,
					"content": "Maaf, maaf. Aku lagi melamun saja. Mau beli baju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390204
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390204,
					"content": "Sutra kualitas tinggi dari Liyue masih belum ada, tapi kami masih punya kimono-kimono model terbaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390205
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390205,
					"content": "Kamu tadinya impor bahan dari Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390206
					]
				},
				{
					"id": 220390206,
					"content": "Iya, dulu kami selalu bisa dapat barang kualitas tinggi dari Liyue, misalnya sutra Feiyun Commerce Guild yang terbuat dari Silk Flower ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390207
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390207,
					"content": "Tapi saat ini kami masih belum bisa menghubungi pemasok, jadi sementara kami pakai yang ada dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390208
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390208,
					"content": "Karena itulah, stok sutra kami kian hari kian menipis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390209
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390209,
					"content": "Aku sendiri sebenarnya berniat mendesain corak baru, atau pakai pewarna baru untuk membuat kain dan baju model baru yang dapat menarik minat pembeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390210
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390210,
					"content": "Tapi sampai sekarang aku masih belum dapat pewarna yang betul-betul \"baru\" sih ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390211
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390211,
					"content": "Pengembara, kamu sudah bertualang ke segala penjuru dan pasti banyak pengalaman. Apa kamu tahu warna seperti apa yang bisa dibilang \"baru\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390212,
						220390216
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390212,
					"content": "Yah, aku memang sudah lihat segala macam sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390213
					]
				},
				{
					"id": 220390213,
					"content": "Be-benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390214
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390214,
					"content": "Tolong, bantu aku memperluas wawasan. Boleh kasih aku beberapa bahan dasar yang bisa kujadikan pewarna jenis baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390215
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390215,
					"content": "Aku akan menyiapkan imbalan yang pantas untukmu. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390216,
					"content": "Cuma perlu pewarna saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390217
					]
				},
				{
					"id": 220390217,
					"content": "Dalam situasi seperti ini, aku cuma sanggup buat itu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390218
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390218,
					"content": "Kalau kamu tahu bahan-bahan apa saja yang bisa dijadikan pewarna jenis baru, tolong bawakan ya. Aku akan siapkan imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
