					"content": "Biar kucarikan sumber panas untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200202
					]
				},
				{
					"id": 205200202,
					"content": "Ba-bagus sekali, kalau begitu tolong ya, cepatlah sedikit... aku merasa seperti akan membeku sebentar lagi...",
					"roleType": "TALK_ROLE_NPC",
