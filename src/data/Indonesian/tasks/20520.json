			"dialogs": [
				{
					"id": 205200501,
					"content": "Apa kamu sudah menemukan \"Daging Dingin\" tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200502,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Menakjubkan! Jadi, ini yang mereka sebut dengan Daging Dingin? Jujur saja, sepertinya daging ini tidak jauh berbeda dengan daging yang biasa, hanya saja daging ini memang dingin ketika disentuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Ah sudahlah, yang penting komisinya selesai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "Terima kasih banyak pengembara, jika bukan karena dirimu aku pasti menderita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "Tolong terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
