				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200301,
					"content": "Aku akan memasak beberapa makanan hangat untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200302
					]
				},
				{
					"id": 205200302,
					"content": "I-itu boleh juga, kalau begitu tolong ya, cepatlah sedikit... aku merasa seperti akan membeku sebentar lagi...",
					"roleType": "TALK_ROLE_NPC",
