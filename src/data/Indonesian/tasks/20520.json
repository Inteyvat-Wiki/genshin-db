			},
			"dialogs": [
				{
					"id": 205200101,
					"content": "Pe-pengembara... bi-bisakah kamu... mem-membantuku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "Kamu kenapa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "To-tolong bantu aku dulu, carikan sesuatu untuk menghangatkan badan... a-aku... merasa sangat kedinginan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "A-atau... tolong berikan aku makanan yang hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "To-tolonglah, aku sudah tidak tahan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
