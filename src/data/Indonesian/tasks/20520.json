			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "Huff... sekarang sudah jauh lebih baik, terima kasih banyak, pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Kenapa kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*huff* Tentu saja karena komisi, memang apa lagi? Aku sudah lama berada di perkemahan karena mengerjakan sebuah komisi yang... tidak mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Tapi aku tidak mau berada di sana selamanya, jadi aku mencari hal lain untuk dikerjakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Koki di kemah kami - Harris, sedang mencari seseorang yang bisa menemukan Daging Dingin di gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Dia berkata bahwa aku cukup menemukan beberapa boar yang membeku saja, tidak perlu pergi terlalu jauh ke atas gunung, dan kelihatannya sama sekali tidak berisiko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Aku pikir hal ini sangat mudah, jadi aku mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Aku juga sudah bersiap-siap, melatih diri secara perlahan untuk menjadi terbiasa dengan lingkungan di Dragonspine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "...Itu semua agar aku bisa menyelesaikan komisi yang diberikan padaku oleh nona alkemis itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "Tapi tak kusangka, begitu aku masuk, aku langsung tersesat dan hampir saja mati membeku, untung saja aku bertemu denganmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Satu-satunya penyesalanku adalah... aku tidak bisa menyelesaikan komisiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "Pengembara... sepertinya kamu cukup familier dengan gunung ini, bisakah kamu membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Aku hanya butuh bantuanmu untuk mendapatkan satu Daging Dingin saja. Dengan satu Daging Dingin saja, komisiku sudah berhasil diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Bagus sekali, kalau begitu aku akan menandai petamu untuk menunjukkan lokasi anak boar yang membeku itu, seperti yang Harris bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Jadi, aku akan pergi ke perkemahan di kaki gunung dan menunggu kabar baik darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
