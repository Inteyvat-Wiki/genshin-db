					"nextDialogs": [
						750180102
					],
					"speakerTitle": "\"Kururuk\""
				},
				{
					"id": 750180102,
					"content": "Anak baik, jangan ribut! Gimana bisa sembuh kalau tidak minum obat ... aduh!",
					"roleType": "TALK_ROLE_NPC",
