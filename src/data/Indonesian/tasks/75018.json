					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181009,
					"content": "Aku juga cukup kaget lihat kalian begitu akur sama Tepetlisaurus kecil ini. Mesti belajar banyak nih dari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Sebut aku pawang segala pawang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Aku ingin sekali bisa bantu, atau minimal ngapain itu untuk balas budi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "Tapi lebih baik kalian selalu sehat sentosa. Jadi jangan pernah ke sini minta aku tangani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "Ah, tapi kalau mau ngobrol, kapan pun silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "Makasih! Semoga Kururuk cepat sehat lagi ... dan semoga jangan main gebuk orang sembarangan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "Soal itu ya ... tenang, nanti juga tahu cara penanganannya. Yah, siapa tahu juga emosinya membaik seiring lukanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#Eh, itu sih si {REALNAME[ID(2)|SHOWHOST(true)]} saja yang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
