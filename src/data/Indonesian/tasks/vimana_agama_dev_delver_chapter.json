			"dialogs": [
				{
					"id": 730270301,
					"content": "Benda yang bersinar di dalam seharusnya benda yang dibilang Jazari itu, Chaos Core Ruin Golem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Meski kayaknya ketutup sama pohon dan tanaman, tapi sepertinya ada yang terus mengalir dari dalam deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "*hiks* Benda kotor, Ararycan bisa merasakan kalau ini yang membuat hutan sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Ugh, ada banyak Abyss Mage di samping pohon, ini jelas bukan pertanda baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Paimon ingat Jazari pernah bilang kalau segel intinya rusak. Apa jangan-jangan ini ulah Abyss Mage ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Omong-omong, Ararycan harus pergi dan mencari tempat sembunyi. Ayo hentikan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
