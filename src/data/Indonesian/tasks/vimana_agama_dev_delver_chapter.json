			"dialogs": [
				{
					"id": 730270201,
					"content": "Eh, Ararycan, kenapa kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Ararycan menunggu kalian di sini setelah selesai menanam bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Dan tidak tahu kenapa ada benda yang jatuh tiba-tiba dari Gunung Besi Besar dan hampir mengenai Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "Wah, maaf Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Paimon kenapa minta maaf, Ararycan tidak apa-apa, Ararycan larinya cepat jadi tidak akan tertimpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Yang penting kamu enggak apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Sepertinya lengan robot yang patah ini sudah membuka jalan masuk ke reruntuhan. Akhirnya ada gunanya juga lengan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Kalau gitu ayo kita turun buat lihat-lihat, entah ada apa lagi yang lagi nungguin kita datang di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "Ararycan ikut dengan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
