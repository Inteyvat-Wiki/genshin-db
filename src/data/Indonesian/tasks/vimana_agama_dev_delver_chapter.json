				{
					"id": 730270401,
					"content": "Akhirnya masalahnya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Ini memang perjalanan yang panjang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Hal yang dibicarakan pada Jazari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Oh ya, kalau dia tahu masalah core, mungkin dia bisa bantu mengajukan pendanaan atau lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#Tapi, Paimon enggak mau gabung ke Akademiya. {NICKNAME}, kamu juga enggak mau, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Intinya, walaupun enggak tahu apa ada \"Jelmaan Marana\" yang berhubungan dengan Abyss Order, paling enggak kita sudah bisa obati \"penyakit\" hutan, ini bagus dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "*hiks* Ararycan berterima kasih pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "Sama-sama, Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "Jadi, rencana Ararycan habis ini apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan ingin ikut Festival Utsava, tapi Ararycan khawatir sekali tentang \"penyakit\" di hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "Mungkin saja benda jahat yang menyebabkan penyakit hutan akan kembali lagi, Ararycan harus melindungi hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "Jadi Ararycan akan kembali lagi ke sini setelah Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Wow. Aranara juga sudah bekerja keras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Kalau Ararycan butuh bantuan, langsung cari kami saja ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Ya, Ararycan tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Hehe, jaga diri baik-baik ya, kita pasti ketemu lagi suatu hari nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Hal yang dibicarakan pada Kakek Royinjan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Oh ya, Kakek Royinjan pasti bilang \"cerita yang menarik ya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "Siapa sangka kita bisa menyelamatkan hutan.",
					"roleType": "TALK_ROLE_NPC",
