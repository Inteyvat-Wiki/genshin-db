			"dialogs": [
				{
					"id": 750790301,
					"content": "Selamat datang. Hmm ... sepertinya ada salah satu dari kalian yang sudah bisa terbang. Jadi, anak muda ini ya yang mau belajar terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Aku sudah punya SIM.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "SIM? Apaan tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Di sini, kami mengajarkan supaya Saurian dan penunggangnya sama-sama berkembang. Rekanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Nguk, nguuuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "Aduh, maaf ya sobat kecil. Sekolah Penerbangan Pakpaka sepertinya bukan tempat yang pas buat kamu unjuk gigi. Tapi bukan salah siapa-siapa kok, jangan diambil hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} masih muda, dia punya banyak potensi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "MANA ADA! Potensi Tepetlisaurus bukan buat TERBANG! Beda sama Qucusaurus atau Iktomisaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "Nah, anak muda. Kalau kamu berminat ikut latihan terbang, silakan coba jalurnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Naik Qucusaurus itu intinya harus bisa menghindari rintangan dan belok dengan gesit. Kalau penasaran kamu sejago apa, boleh dicoba dulu jalurnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "Jujur aku mati-matian sih mempromosikan ini. Ya hadiahnya, balapannya, dan lain sebagainya lah. Kalau lulus, kamu bisa ambil hadiahnya di Lamizana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Bisa ngajarin apa saja nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
