			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "Menangnya gampang banget loh ... hadiahnya langsung dapat. Duh, coba misi Adventurers' Guild segampang ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790902,
					"content": "#Kak {NICKNAME} ... kalian berdua petualang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790903,
					"content": "Aku punya Buku Panduan Petualang, si Paimon enggak. Gimana tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#HEH! Paimon nih JIWANYA yang petualang! Gitu lah pokoknya, sama kayak kemampuan terbang Paimon sejago si {NICKNAME}, padahal enggak ada SIM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790905,
					"content": "Kenapa kamu nanya gitu? Siapa yang suruh? Ah ... Paimon tahu deh kayaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790906,
					"content": "#Kamu lihat si {REALNAME[ID(2)|SHOWHOST(true)]} nempel banget sama kami, terus mau tanya apa rahasianya! Betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790907,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "Waduh. Jauh banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790909,
					"content": "Lah? Tapi kata Lamizana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790910,
					"content": "Justru dia yang bermasalah. Dia memang jagonya ngebujukin orang. Si Oberon saja nurut, soalnya dikasih biskuit terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790911,
					"content": "Chiii ... chriiik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790912,
					"content": "Jangan sok-sok jadi korban ya! Qucusaurus hebat tuh harus bisa jaga makan! Apalagi kamu gampang gendut gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790913,
					"content": "Orang itu pasti punya niat jelek ... gayanya saja kayak kasmaran sama kakakku, Lliwa. Aneh, kakak juga gitu saja terus. Senyam-senyum sendiri kalau diajak ngobrol sama dia. Bukannya curiga, malah senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790914,
					"content": "Lah? Itu sih bukan niat jahat, tapi memang orangnya saja baik! Kamunya yang enggak suka sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790915,
					"content": "Bukan, aku yakin bukan cuma itu! Belakangan ini dia suka rahasia-rahasia, dan aku enggak tahu apa urusannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790916,
					"content": "Orang dewasa punya urusan dewasa juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "Iya, bukannya dia bilang mau ada balapan? Mungkin sibuk ngurusin itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790918,
					"content": "Dia bilang kan ada balapan apa tuh tadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "Tapi dia enggak capek gimana juga sih. Kerja kerasnya diberesin Paran, yang bolak-balik ke sana kemari sama Carrewoof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790920,
					"content": "Kemarin juga aku dengar sesuatu ya! Dia kayak bahas yang bahaya-bahaya gitu sama orang luar. Aku enggak berani deketin, jadi ya enggak kedengeran jelas juga. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790921,
					"content": "Aku dengar \"tepat waktu di hari-h balapan\", \"jangan terlalu jauh\", \"hidup\", \"setengahnya lagi kalau sudah beres\". Terus \"rinciannya kita bahas di kemah utara besok malam\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790922,
					"content": "Nah, kenapa yang belakangnya itu kok bisa dengar jelas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "Soalnya Oberon waktu itu gelisah gitu, dia terus-terusan mau lari ke Lamizana. Sampai aku enggak kuat lagi ngehalanginnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790924,
					"content": "Chiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790925,
					"content": "Itu bukan pujian! Aneh. Yah, si orang luarnya langsung pergi begitu lihat aku lagi ngejar Oberon. Lamizana juga gelagatnya kayak ketangkap basah gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790926,
					"content": "Makanya hari ini dia mancing ribut sama aku. Takut ketahuan niat busuknya! Jadi dia ingin bisa mengawasi aku terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790927,
					"content": "Masih kecil tapi mikirnya sudah teori konspirasi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790928,
					"content": "Oke lah. Kamu juga enggak percaya omongan anak kecil, ya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790929,
					"content": "#Tapi justru itu aku mau minta tolong Kak {NICKNAME} cek kemah di utara itu nanti malam ... yah, takut dia beneran mau bikin onar gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790930,
					"content": "#Dan kalau benar, kita harus cegah! Kalau Kak {NICKNAME} saksinya, yang lain pasti percaya ... termasuk Kak Lliwa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790931,
					"content": "#Kak {NICKNAME}, kalau misalnya kakak merasa ini cuma imajinasi bocah, ya sudah. Tapi tolong bantu aku sampaikan pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790932,
					"content": "Aku sudah tulis surat buat jelasin situasinya. Kalau sampai besok aku belum pulang, tolong kasihin ini ke Kak Lliwa. Oberon juga aku serahin ke tangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790933,
					"content": "Tunggu, woi! Kenapa ngomongnya jadi bikin bergidik gitu. Masa sih separah itu situasinya? Tapi, eh ... gimana kalau ternyata betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}, bantu cek saja yuk? Paimon bakal mimpi buruk terus tiap malam kalau beneran ada sesuatu dan kita enggak peduli kayak gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790935,
					"content": "Kakak mau bantu? HOREEE! Oke, kita berangkat malam ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790936,
					"content": "Sudah, biar kami saja yang berangkat. Kamu tunggu di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "Iya, enggak boleh ramai-ramai kalau tujuannya mau nyelidikin. Kamu tunggu kabar saja di sini. Paimon juga petualang, paham yang beginian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790938,
					"content": "Yah, benar juga sih. Okelah kalau begitu, aku di sini saja nemenin si Oberon. Terus masih harus bisa bujuk Kak Lliwa biar jauh-jauh dari si Lamizana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790939,
					"content": "Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taruka"
				}
			]
		},
