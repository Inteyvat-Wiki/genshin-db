					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "Jangan dipegang! Ini hadiah. Kalau mau, silakan selesaikan jalur latihannya Temach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507907",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamizana",
					"Taruka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Heh, kalau mau sukses, benerin tuh adat. Kamu sudah besar, belajar punya sikap yang sopan. Aku bukan bilang gini karena dekat sama kakakmu, tapi demi diri kamu sendiri juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791702,
					"content": "Chiii, chi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750791703,
					"content": "Tuh, dia juga setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791704,
					"content": "Kalau soal sikap, kayaknya bukan aku deh yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "HEH! Kurang ajar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507909"
						],
						"stepId": 7507909
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Maaf Nona Quilla. Carrewoof nakal ya? Padahal biasanya dia tidak semangat begitu kalau bertemu orang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Haha, tidak apa. Aku suka binatang kok. Malah senang diginiin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "Hawka kangen banget tuh. Waktu dengar aku mau ke sini, dia langsung tanya kabarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "Paman Hawka? Ngapain tanya kabar aku segala? Duh, maaf ... kami sempat cekcok, tapi yah ... gitu lah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
		{
			"id": 7507919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_STATE_NOT_EQUAL",
						"rawParams": [
							"7507909",
							"3"
						],
						"stepId": 7507909,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lliwa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791901,
					"content": "Wah, pusing deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "Kenapa?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Begini, aku punya adik laki-laki, beda usianya jauh sih. Dia sekarang lagi puber, jadi kerjaannya membangkang saja, dan ribut sama semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "Duh. Cerita sama kamu juga cuma nambah bebanmu saja. Tunggu sampai dia lebih dewasa lagi lah baru diurus lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "Maaf mengganggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "Tidak apa, sampai jumpa.",
