				"objectNames": [
					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875101,
					"content": "Masih ada berapa lagi tantangan terbang. Detailnya ada di papan, silakan kalau mau coba ... dan tentu saja ada hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875102,
					"content": "Tentang Sekolah Penerbangan Pakpaka ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "Yah, aku tidak tahu kenapa namanya gitu. Tapi ngomong-ngomong soal Pakpaka ... pernah dengar cerita Kuntur dan Rumi si penyihir jahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875106,
					"content": "Pejuang suku dikalahkan oleh penyihir jahat, lalu disihir jadi Pakpaka ... yang dari namanya sih jelas bukan hal bagus ya. Tapi mungkin terbangnya cepat? Entahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875103,
					"content": "Tentang Lamizana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "Haha, dia pejuang yang cukup hebat, tapi bukan guru yang baik. Saingan balap terbang? Mungkin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875108,
					"content": "Kenapa datang ke sini kalau bukan karena masalah terbang? Jadi kalau aku terlalu keras ... yah, dulu juga pernah kejadian sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875109,
					"content": "Itulah kenapa aku fokus menyemangati anak muda. Aku yakin hasilnya juga baik kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875104,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "Sampai jumpa, silakan main ke sini lagi kalau senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
