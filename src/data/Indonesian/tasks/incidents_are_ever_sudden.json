			"dialogs": [
				{
					"id": 750790701,
					"content": "Sebagai kakak senior yang lebih berpengalaman, biar aku ajari kiat-kiat menjadi populer di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Ah, terima kasih, tapi tidak perlu. Dan kamu juga bukan kakak seniorku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Bisa tolong jangan kasih biskuit terus ke Oberon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Chiii ... chriii ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Heh, bocah. Dengar ya, kalau bukan karena kakakmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Permisi, aku mau ambil hadiah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Ah, ada tamu rupanya. Jarang-jarang ada Tepetlisaurus kecil kelihatan di sekitar sini. Ah ... rekanmu ada berbagai jenis ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Jenis?! Maksudnya Paimon dan {REALNAME[ID(2)|SHOWHOST(true)]}??? Bedanya bukan cuma di JENIS ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Nguk? Nguuuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Eh? Bukan, bukan gitu kok kecil. Kita sama-sama rekannya {NICKNAME}, tapi kita ada bedanya. Beda, tapi bukan berarti siapa lebih bagus dari siapa gitu, jangan kesinggung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "Kenyataan paling menyakitkan itu yang tidak sengaja terucapkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#HEH, jangan sembarangan! Itu jelas bukan maksud Paimon, jadi kamu jangan nyebelin! {REALNAME[ID(2)|SHOWHOST(true)]} tuh teman baik kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, kita teman baik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Fuwa? NGUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hehe, Paimon tahu si {REALNAME[ID(2)|SHOWHOST(true)]} pasti ngerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Kalian sudah begitu saling memahami ya. Kalau dari baju, kalian bukan warga lokal, tapi persahabatan kalian dan Tepetlisaurus ini dalam sekali. Apa rahasianya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Yah, aku terus terang saja. Taruka dan rekan Qucusaurus-nya tidak seakur kalian. Kalau memang ada rahasianya, tolong ajarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Kembali ke pembahasan ... mana hadiahnya? Jangan bilang belum siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Loh, ya sudah siap lah! Sesiap kesiapan kamu mengganti topik pembicaraan! Kita bahas lagi nanti deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Sebentar lagi mau ada balapan. Kalau minat, tonton ya! Aku ikutan balapannya loh, dijamin keren! Tapi sekarang kebetulan lagi sibuk, jadi duluan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
