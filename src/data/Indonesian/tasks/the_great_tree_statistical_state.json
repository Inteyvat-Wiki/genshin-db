			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Kita perlu lebih banyak data lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Peralatanmu ini tidak didukung data, bagaimana bisa beroperasi dengan normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Jadi kamu tidak akan mulai bekerja sampai kamu dapat semua datanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Apa kamu perlu mengamati tiap ombak yang datang waktu menangkap ikan? Kamu kan cuma butuh mengamati di bawahmu itu ada ikan atau tidak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Gara-gara itu kamu tidak bakal berhasil menangkap ikan selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Kamu belum pernah belajar di Haravatat! Jangan bermain kata-kata lagi. Kita harus bekerja dengan lebih serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Kalau molor lagi, takutnya skripsi kita dan Yasmin bisa kehabisan waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Kalian lagi ribut apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "Eh, kamu pasti Pengembara yang pernah disebut oleh Yasmin. Kamu sudah banyak membantu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "Salam kenal! Pengembara, senang bertemu denganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Namaku Pharez, dan aku sedang menempuh studiku di Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Aku Ladep, pelajar Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "Pengembara, kami juga butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Apa kamu tahu kalau Yasmin baru-baru ini sedang menebarkan ramuan obat di sekitar akar Pohon Suci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Tapi ... Emm, ramuan obat yang disebarkan Yasmin baru-baru ini sepertinya bermasalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Berbagai macam monster selalu muncul di area sekitaran tempat dia menebar ramuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Sumpah, aku benar-benar tidak mengubah komposisi ramuan atau dosis ramuannya. Pasti itu ... Eh, ada sesuatu yang di luar dugaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "Terserah apa katamu ... Kalau begitu, Pengembara, ikutlah bersama kami ke tempat Yasmin menuangkan ramuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Mungkin saja di sana muncul banyak monster, kami tidak berani pergi sendiri ... Kami harus cari orang yang kuat untuk pergi bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Dan yang terpenting, kalau saja monster Fungus-nya tidak terlalu berbahaya sekalipun, tapi kalau guru tahu ramuan kami ini ada masalah seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Laporan pendahuluan skripsi kami ini pasti bakal ditolak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Terutama karena kami dari Spantamad. Kalau ada kesalahan pada data yang kami kumpulkan, dia pasti akan mengomeli kami sampai habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Dulu bagaimana kalian menyelesaikan masalah ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Kami biasanya merekrut seorang petualang atau minta tolong ke guru kami, lalu minta bantuan ke anggota Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Tapi kesabaran guru ada batasnya. Dengan kondisi seperti sekarang ini, kami tidak berani menemuinya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "Jadi kami cuma bisa minta bantuanmu, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
