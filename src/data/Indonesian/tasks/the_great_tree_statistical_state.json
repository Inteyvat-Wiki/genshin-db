			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*uhuk-uhuk* Di sini pasti tidak apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "*hueek* Kamu ... Ini semua kan buatanmu sendiri! Kenapa masih bisa muntah juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Emm ... *uhuk-uhuk* *uhuk uhuk* ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Aku sudah ... sudah ... menjelaskan berulang kali kepadamu, yang kumasukkan itu bahan pemicu muntah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Jadi itu tidak ada hubungannya dengan terbiasa atau tidak. Begitu orang menghirupnya, dia langsung akan muntah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Ah ngapain juga sih aku harus menjelaskannya lagi, toh kamu tetap tidak akan paham ... Ugh ... Huek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "Loh? Ladep, Pharez, dan Pengembara? Apa yang kalian lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "Guci ramuannya pecah ... Apa kalian diserang monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "Kalau dilihat dari penampakan luarnya ... sepertinya memang begitu. Apa kamu tidak lihat monster waktu datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "Tidak tuh, aku malah punya waktu buat ambil beberapa sampel tumbuhan di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "Ini aneh sekali ... benar-benar aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
