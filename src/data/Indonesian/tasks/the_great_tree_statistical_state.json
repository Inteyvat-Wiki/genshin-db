			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Untung saja botol ramuan dalam kotak ini tidak pecah, kalau tidak kita pasti bakal muntah-muntah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Masa sih kamu tidak terbiasa dengan baunya? Ini kan kamu sendiri yang buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Sudah berkali-kali kukatakan kepadamu, yang kumasukkan itu bahan pemicu muntah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Jadi itu tidak ada hubungannya dengan terbiasa atau tidak. Begitu orang menghirupnya, dia langsung akan muntah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Ah ngapain juga sih aku harus menjelaskannya lagi, toh kamu tetap tidak akan paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Tapi ke mana perginya Yasmin? Ramuannya juga belum ditebarkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Mungkin dia menemukan tanaman langka lagi dan sedang sibuk mengambil sampelnya. Apa kamu masih belum paham \"makhluk-makhluk\" dari Amurta macamnya seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "Ya sudah, kalau begitu kita lihat dulu ramuan ini. Terima kasih atas bantuanmu, Pengembara. Ini silakan diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Ugh, dasar Amurta ... benar-benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
