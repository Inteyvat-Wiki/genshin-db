				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "Tapi bagaimana cara membuat Lentera Xiao ya? Apakah kamu tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "Aku tidak tahu... mungkin kita bisa minta tolong seseorang membuatkannya untuk kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "Apakah kalian juga ingin menerbangkan Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "Ah, kamu seorang Pengembara ya? Hmm, menerbangkan Lentera Xiao ya... kedengarannya menarik, aku jadi sangat penasaran deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "Kami awalnya mau mencoba makanan khas Festival Lantern Rite, tapi kata Geri dia mau menerbangkan Lentera Xiao dulu baru pergi kuliner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "Ya... begitu saja deh! Harus berbaur dengan suasana festivalnya dulu baru menikmati makanan khasnya agar mendapatkan pengalaman yang lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "Terus dengar-dengar kita juga bisa menuliskan harapan kita di Lentera Xiao... tapi kami tidak tahu bagaimana membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "Pengembara, bisakah kamu buatkan sebuah Lentera Xiao untuk kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Kalau begitu tolong ya, kami tunggu di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
