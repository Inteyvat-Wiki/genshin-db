					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "Terima kasih ya, aku belum lama meninggalkan Mondstadt tapi aku sudah rindu rumah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Apa kabar keluargaku ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Kalau begitu ini kesempatan yang bagus... Apakah kamu memiliki sebuah permohonan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "Aku? Hmmm, biar kupikir-pikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "Begini harusnya sudah cukup. Pengembara, aku minta bantuanmu sekali lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "Dandelion Seed bagusnya ditebar dari tempat tinggi, tapi puncak-puncak di Liyue terlalu curam untuk bisa kami daki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "Bolehkah kamu membantu kami untuk menebarkan Dandelion Seed ini dari tempat tinggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430508,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
