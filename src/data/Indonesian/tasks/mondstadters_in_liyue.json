			"dialogs": [
				{
					"id": 413430701,
					"content": "Halo, Pengembara. Apakah kamu sudah menebarkan Dandelion Seed-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430702,
					"content": "Ya, sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Baguslah, semoga Dandelion Seed itu bisa diterbangkan angin hingga sampai ke Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430704,
					"content": "Meskipun kita sudah berusaha beradaptasi dengan kehidupan di Liyue... tetapi kakakku masih terbiasa dengan hidup di Mondstadt. Bagaimana kalau hari ini kita mencari makanan khas Mondstadt...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430709,
					"content": "Tidak bisa begitu dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430710,
					"content": "Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430705,
					"content": "——Beradaptasi dan mempertahankan kebiasaan kan dua hal yang berbeda. Ayo kita menerbangkan lentera saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430706,
					"content": "Kamu sudah menuliskan permohonanmu? Nanti setelah kita menerbangkan Lentera Xiao, ayo kita cari makanan khas Lanten Rite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430707,
					"content": "Tulis sih sudah... tapi kamu masih mau makan lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430708,
					"content": "Pastinya dong! Kalau sedang ada Festival Lantern Rite, kita harus mencoba makanan khasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		}
	]
