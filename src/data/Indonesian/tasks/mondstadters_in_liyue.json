			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Terima kasih banyak ya. Selanjutnya kita perlu memikirkan mau menulis harapan apa ya di Lentera Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Oh... jadi begitu. Coba kupikirkan mau menulis apa ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Cukup seperti ini saja deh. Ngomong-ngomong, kalau dipikir-pikir ini seperti membiarkan Lentera Xiao terbang membawa harapan kita ke langit ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "Saat kami di Mondstadt, kami juga akan memberi tahu Dandelion apa yang kami pikirkan, lalu menebarkan Dandelion Seed agar terbang tertiup angin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "Jadi kangen dengan Mondstadt deh, sudah lama sekali aku tidak melihat adanya Dandelion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "Pengembara, bisakah kamu bantu carikan beberapa Dandelion Seed untuk kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Bagus sekali, terima kasih atas bantuanmu. Tolong carikan Dandelion Seed dan kasih ke kami ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
