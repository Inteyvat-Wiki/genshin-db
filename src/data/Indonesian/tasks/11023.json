			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "Semua ini... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "Apa yang mereka lihat... Dan apa yang mereka lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "Lalu... Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Karena kamu tidak memercayaiku, kita terus maju saja ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "Apa yang ada di balik pintu ini akan menunjukkan semua yang terjadi saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102311,
