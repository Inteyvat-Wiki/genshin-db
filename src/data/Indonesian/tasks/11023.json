					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "Ini adalah tempat kejadian saat itu. Tubuh Havria musnah, tidak menyisakan apa-apa selain garam ini. Momen kematiannya pun membeku dan tersimpan sampai saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "Ceritanya berlanjut ketika beberapa dari rakyatnya menyadari bahwa, dewa yang baik hati namun lemah ini tidak bisa melindungi siapa pun semasa perang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "Perang Archon sangat kejam. Daripada membuatnya menderita karena kalah dalam perang, mereka berpikir untuk memberinya pelepasan yang cepat dan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Tapi bagaimana dengan patung ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "Tidak peduli seberapa lemahnya dewa, kekuatan yang terpancar keluar saat kematiannya tetap berada di luar kemampuan tubuh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Mereka yang tidak berhasil melarikan diri berubah menjadi patung-patung ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Rakyatnya yang selamat dari bencana berangkat ke Liyue. Mereka mencari perlindungan dengan Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Keturunan mereka takut terhadap sisa-sisa kekuatan Havria dan hidup dalam kecemasan. Mereka takut Havria telah memberikan kutukan abadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "Jadi mereka mempertaruhkan nyawa, datang ke sini untuk mematahkan pedang, setelah itu meletakkan sesajian untuk meredakan kemarahan Havria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Tapi sebenarnya mereka tidak perlu melakukannya, karena bagaimana mungkin seorang dewa yang tidak pernah melawan - bahkan sampai akhir - bisa membenci rakyatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "A—aku... Bahkan jika memang begitu, aku tidak bisa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "Ini pasti suatu kebohongan... Sejarah palsu... Semua ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Jangan coba-coba menggoyahkan imanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Astaga, kali ini Zhongli tetap tidak berbelas kasihan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "Ini adalah harga yang harus dia bayar... Dan ini tidak bisa dibilang hal yang buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "Dilihat dari responnya, takutnya dia harus bergumul untuk sementara waktu. Walaupun tidak bisa menerima kenyataan secepat itu, tapi setidaknya dia sudah mengetahui kenyataan yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Kamu tampaknya tahu banyak tentang Dewa Garam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "Memang benar. Di masa lalu, bagiku, kisah Havria merupakan suatu peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "Tidak ada gunanya memercayai Dewa yang sudah meninggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "Tidak peduli itu Havria, ataupun Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Orang-orang Liyue suatu hari juga akan mengerti akan hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Baiklah kalau begitu, apa kamu mau menemaniku jalan-jalan ke Guyun Stone Forest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Hah? Kamu mau melakukan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
