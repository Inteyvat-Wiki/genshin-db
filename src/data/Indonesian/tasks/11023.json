					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Menapaki tanah tua dan lagi-lagi menceritakan kisah lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "Terkadang kita tidak bisa menghindari rasa rindu terhadap teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Kamu tahu cara membuka segel, itu bukan dari berita burung saja, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "Pengamatanmu sungguh tajam. Ini bukan karena kebijaksanaan, ini hanya karena aku sudah hidup lebih lama.",
					"roleType": "TALK_ROLE_NPC",
