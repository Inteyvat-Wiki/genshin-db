			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Aku akan menyita bejanamu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Kamu tidak layak untuk melanjutkan ekspedisi ke dalam reruntuhan. Tinggalkan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Sialan... Tunggu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Katanya mau melakukan survei arkeologi... Akhirnya sandiwaranya berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "Setidaknya kita sudah waspada dari awal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Ya, untung Paimon bisa mencium penipu dari jarak satu mil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Kekeliruan Kliment memang bermula dari keserakahannya. Namun selain keserakahan, masih banyak godaan lain yang mungkin membuat kita melanggar kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "Ketika orang melihat benda yang diimpi-impikan mereka, berapa banyak yang benar-benar mampu mengendalikan keinginan mereka dan tetap menjalani kontrak...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "Aku pikir kita harus jujur satu sama lain sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Hah? Jujur saja tentang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Sebenarnya, tidak ada satu pun dari anggota ekspedisi ini yang datang untuk arkeologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Ke-kenapa kamu berbicara seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Nona, kamu bahkan tidak memiliki pengetahuan arkeologi yang paling dasar dan tidak dapat mengenali apa pun kecuali beberapa benda peninggalan sederhana. Namun kamu memang tahu banyak hal tentang Dewa Garam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "Kamu tidak tertarik dengan arkeologi atau peninggalan - yang benar-benar kamu minati adalah Dewa Garam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "Legenda tentang Dewa Garam yang kamu sebutkan tadi di Pearl Galley, sejauh yang aku tahu, adalah yang paling banyak beredar di Yinyuan Hall...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Baik, cu-cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "...Tuan memang orang yang memiliki banyak pengetahuan dan bakat. Sepertinya keputusanku mencari Tuan adalah keputusan yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Tuan benar. Aku bukan seorang arkeolog. Aku datang dari salah satu Eight Trades yang dipimpin Qixing - Yinyuan Hall dari industri garam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Nenek moyang kami dilindungi oleh Dewa Garam bertahun-tahun yang lalu, ketika Perang Archon melanda dan menyebabkan kekacauan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Kalau dipikir-pikir, aku belum pernah mendengar kamu menyebut \"Rex Lapis\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Benar juga, orang-orang Liyue jarang sekali menyebut nama \"Morax\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Selama perang, Morax membunuh dewa kami karena iri atas kekuatannya, akibatnya kami kehilangan tempat perlindungan di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Kami... kami membencinya! Tapi Liyue adalah Liyue milik Morax. Sejarahnya ditulis sesuai keinginannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "Jadi aku ingin mencari bukti kesalahan Morax! Dia memiliki darah di tangannya, dan kekejaman di hatinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Kita pernah menyetujui sebuah kontrak untuk menghadapi sebuah kebenaran, benar kan, Tuan Zhongli?! Tuan harus menilai hal ini dengan adil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Tentu saja, tapi harus kutambahkan, Liyue bukan lagi Liyue milik Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Ikutlah aku, semua jawabannya ada di depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Kalau dipikir-pikir, aku belum pernah mendengar kamu menyebut \"Lord Geo\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Aku harap kamu tidak menjadi serakah seperti dia, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Paimon suka Mora, tapi Paimon tidak akan melakukan hal buruk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Ini... sebuah pedang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Aha! Sebuah pedang yang patah! Ini buktinya! Ini bukti bahwa Dewa Garam telah melawan Morax yang jahat, tapi sayangnya dia kalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "Kekuatan pedang ini pasti jauh lebih besar daripada bejana garam dan penggaris garam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Jika kita dapat memperbaiki pedang ini, maka kita dapat menunjukkan kekuatan besar Dewa Garam kepada dunia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hmm... Pedang itu memang terlihat seperti sesuatu yang ditinggalkan setelah kalah dalam pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Dua buah pedang yang patah. Dari sudut pandang arkeologi, ini adalah dua relik yang terpisah. Menurut kontrak, kamu hanya dapat mengklaim satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "Ke-kenapa? Walaupun harus mengklaim harta secara bergiliran, tapi Kliment sudah tidak ada di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Memang benar, tetapi isi kontrak hanya memperbolehkan kamu mengklaim satu benda. Kamu tidak dapat mengambil dua benda sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "I-ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Anu... Zhongli, dia kelihatannya bukan orang jahat dan tidak merebut harta. Bagaimana kalau kamu membiarkannya kali ini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "Kontrak tidak bisa dilanggar. Bila dilanggar, maka kontrak itu rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Tidak! Bila aku hanya mengambil setengahnya, maka aku tidak bisa memperbaikinya dan kekuatan Dewa Garam tidak bisa kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Biar bagaimanapun, aku tetap harus setia padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Aku tidak peduli bila aku harus melanggar kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Kamu sudah membuat keputusan? Hmm... ada harga yang harus kamu bayar bila kamu melanggar kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "Artinya, kamu mau menerima \"murka sang Geo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Itu... tidak apa-apa. Dewa Garam menyerahkan hidupnya untuk melindungi bangsanya. Pengorbananku tidak seberapa dibandingkan dengan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Hukumlah aku sesuai kehendakmu. Asalkan aku tetap membawa bukti imanku ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "Jangan, kamu tidak boleh memukul perempuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "Mungkin hukuman itu akan lebih mudah untuknya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Sebagai hukuman, aku akan memberi tahu kamu suatu kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "Kenyataan? Suatu kenyataan dijadikan sebagai hukumanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Ya, kenyataan yang akan kusampaikan adalah harga yang harus kamu bayar karena melanggar kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "Sayang sekali, Dewa Garam, Havria, bukanlah dewa terkuat seperti yang kamu pikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Dia sebaliknya adalah dewa kecil dan lemah yang tidak pernah melawan. Dia adalah... pengecut yang tidak akan pernah bisa mendapatkan kursi The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "A-Apa...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Selama Perang Archon, para dewa menggunakan seluruh kekuatannya dan kecerdasannya untuk memperebutkan kuasa akan Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Tapi Havria malah memilih untuk kabur. Dia pikir dengan menyerah sebelum pertarungan dimulai, dia bisa menyelamatkan dirinya dan rakyatnya dari perang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Namun bagaimanapun, di masa peperangan yang panjang, serangan-serangan yang datang tidak akan ada habisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Setelah menyerah, Havria kehilangan semua tanahnya sampai hanya satu tempat berlindung kecil yang tersisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Tidak... Tidak mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "Di hari-hari terakhirnya, dia bahkan tidak memiliki satu bilah pedang untuk melindungi rakyatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "Sebilah pedang pun tidak ada? Kalau begitu, pedang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Ya, pedang ini bukanlah peninggalan Dewa Garam, melainkan senjata pembunuh yang menewaskan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Senjata pembunuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Tidak! Itu tidak benar, itu tidak benar! Kamu hanya mencoba menguji imanku kepada Dewa Garam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Seperti yang pernah kukatakan sebelumnya, aku hanya mengungkap kenyataan yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Tidak masuk akal! Ka—kamu adalah pengikut Morax, jangan coba-coba menipuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Hei! HEIII! Jangan lari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Dia pasti sangat terpukul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "Bagaimanapun juga, itu adalah hukuman. Aku tidak ingin mengatakan kenyataan kejam ini kepadanya, tetapi dia telah melanggar kontrak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Mari kita terus masuk ke dalam. Di sana... takutnya akan ada sesuatu yang membuatnya terpaksa harus menerima kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "Apa yang kamu katakan itu benar, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "Memang. Jika tidak, mengapa aku menggunakan kenyataan sebagai hukuman? Aku tidak ingin memberi tahu dia fakta kejam itu, tetapi dia telah melanggar kontrak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102310,
