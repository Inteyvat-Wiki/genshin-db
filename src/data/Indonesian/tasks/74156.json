			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Suruh mereka selesaikan sendiri, tidak perlu ikut campur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Autumn sayangku, kamu tega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "Apa ada gadis di Fleuve Cendre yang hidup sebahagia kamu? Permen yang kamu makan, gaun satin, buku cerita ... semuanya perlu uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Saat orang lain kedinginan dan kelaparan, kamu malah bisa memakaikan kalung dan baju ke anjing peliharaan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Aku kerja keras demi bisa hidup seperti ini. Lalu apa ini balasannya? Mana mungkin bisa mendapat hasil tanpa berusaha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "Aku, kejam? Ini sudah sangat murah hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Pikir baik-baik, Autumn. Apakah aku masih kurang melancarkan setiap aspek dalam kehidupanmu? Kalau pun pernah salah jalan, itu kan pilihanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Tuan Benoit terlalu pandai bersilat lidah dan memutarbalikkan fakta, memanfaatkan kebajikan untuk mengejar kepentingan pribadi. Pada akhirnya, semua hanya demi dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Kamu baik kepadaku cuma demi masa depanmu sendiri, cukup sudah kebohongan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Belas kasihan terbesar yang bisa aku berikan saat ini adalah menghabisimu dengan cepat. Tapi sebelum itu ... di mana anakku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Baik itu rumah yang dulu atau yang kamu tempat sekarang, sama sekali tidak ada jejak keberadaannya. Kamu kirim dia ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Kalau kuberi tahu, apa kamu mau melepaskanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "Tidak. Tapi kamu boleh mati tanpa sakit yang berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "Bilang mati, tidak bilang juga mati, untuk apa aku kasih tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "Autumn ... kamu dari dulu memang tidak bisa bohong ya. Sekarang kita tidak akan pernah tahu di mana putrimu berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Aku tahu dia ada di mana! Tapi kalian tidak akan pernah tahu. Aku tidak akan buka mulut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Kamu tidak akan pernah melihatnya. Tidak akan pernah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Aku mau bawa dia balik ke rumahnya. Ada yang keberatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Silakan. Kami tidak ikut campur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "Terserah kalian saja deh. Kami sudah enggak ikutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit yang terus bergumam \"Tidak akan pernah\", dibawa pergi oleh Autumn yang diam seribu bahasa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Aku awalnya tidak ingin ada orang lain yang tahu soal ini. Karena dirinya masih buron, dan begitu pula diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Kalau kalian lapor ke Maison Gardiennage, imbalannya lumayan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Tapi lebih baik jangan. Teman-teman kami bukan tipe yang mudah lupa. Silakan cari tahu sendiri kalau tidak percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "Buat apa lapor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, sudah kuduga kamu akan bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "Rainbow Rose ini untukmu. Kami suka bunga ini karena maknanya yang dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Makna yang dikedepankan saat ini adalah \"peringatan\". Mohon diingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Jadi ... gitu toh ceritanya. Rumit amat sih keluarga yang satu ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon kehabisan kata-kata loh. Untung kita belum lapor ke Maison Gardiennage ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Paimon kasihan sih sama si Autumn. Akhirnya dia gagal ketemu anaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "Paimon kira si Benoit itu orang baik loh .. Duh, memangnya Paimon segampang itu ya dibodohi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Sadar juga akhirnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "KETERLALUAN! Malah ngejekin Paimon ... HUH! Enggak ada maaf sebelum ditraktir makan sampai kenyang di Hotel Debord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Dibodohi itu akar katanya \"bodoh\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Aku tidak kurang uang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
