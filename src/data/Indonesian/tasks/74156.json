				]
			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "Halo Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "Habis sudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560803,
					"content": "Waktu Autumn bilang kamu mau kabur, aku agak kaget sih. Sudah dikurung sekian lama tapi masih belum tumbang, belum menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "Malah bisa-bisanya memanfaatkan kesempatan, bersekongkol dengan dua \"pembela keadilan\" untuk membantumu kabur. Semangat hidupmu membuatku tersentuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Dari sekian banyak pilihan, kenapa ujung-ujungnya memilih tempat yang sering kamu datangi bersama Autumn? Konyol sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560808,
					"content": "Tidak usah dijelaskan. Aku bisa paham bahwa ketika situasi genting, orang cenderung panik dan memilih jalan yang paling familier, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Untungnya Autumn ikut pergi tak lama setelah itu. Dia masih di jalan, tapi tidak apa. Aku tidak ingin bahas ini di depan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Apa sebenarnya yang ada di pikiranmu? Jujur aku tidak paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Dengan kedok pernikahan, kamu menjualnya kepada orang lain seperti menjual barang dagangan, bahkan sampai dua kali. Yang pertama, kamu menukarnya dengan rumah besar di Court of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "Yang kedua, kamu asal cari orang buat menyingkirkannya, agar rumah dan harta lainnya menjadi milikmu seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Kamu menutup mata saat dia ditindas. Dia memberikan anak dari pernikahan keduanya untuk diasuh olehmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "Tapi anak itu pun kamu singkirkan. Aku hanya bisa simpulkan bahwa kamu memang hanya mengincar uang tunjangan hidup anaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Hari ini kenapa kamu masih bisa dengan tenang memberi permen ke anak kecil, sambil mengundang mereka bertamu ke rumahmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "Apa kamu tidak sedikit pun merasa bersalah? Aku tidak paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "Jujur, aku pertama kali bertemu Autumn waktu dia masih menggelandang di jalanan. Dia sesosok ibu yang lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Dia begitu peduli pada Penny, anak temanku. Sehari tidak bertemu saja Penny akan langsung merengek minta \"Kak Autumn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "Oh, kalau kamu merasa masih ada peluang untuk membalikkan keadaan, asal tahu saja ya ... Autumn sudah punya banyak teman. Bukan cuma aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Lari ke mana juga tidak ada gunanya, ke ujung dunia pun akan kami bakal kejar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Kenapa orang seperti dia harus menderita dan tidak punya apa-apa, sedangkan orang brengsek seperti kamu ini begitu kaya raya? Ada yang tidak beres, betul kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Sudah, tidak perlu panjang-panjang. Dia tidak pantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Ah, kedengaran ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Ternyata Autumn itu kamu ya? Akhirnya Paimon paham nih duduk perkaranya. Keluarga Leroy nih rumit banget, duh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}, kita sudah ikutin si Benoit sampai sini, tapi kayaknya ceritanya beda sama yang dibayangkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "Ini apa kita masih mau ikutan urusan mereka? Paimon sih terserah kamu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
