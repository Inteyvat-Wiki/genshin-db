			"dialogs": [
				{
					"id": 741560401,
					"content": "#Paimon deg-degan banget, {NICKNAME}. Kalau dari isi kertas itu, kita cuma perlu tungguin dia di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Yang sabar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Oke, terserah kamu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "Setelah beberapa saat menunggu, terdengar bunyi *kreak* jendela dibuka, kemudian muncullah wajah yang tidak asing lagi. Benoit menjulurkan kepalanya, lalu dia memanjat keluar setelah melihat kalian ada di sana.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, ada apa sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Cepat, cepat, habis aku kalau sampai ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Aku ada pertanyaan buat dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
