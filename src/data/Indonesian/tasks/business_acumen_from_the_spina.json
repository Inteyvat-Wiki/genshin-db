						],
						"pointId": 340200196
					}
				]
			},
			"dialogs": [
				{
					"id": 401891401,
					"content": "Aku sudah menyempurnakan saus untuk Barbeque Ribs ini. Rasanya jadi lebih kuat, tapi tidak terasa berminyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891402,
					"content": "Ekstrak daun Mint dalam bumbunya memberikan sensasi segar yang membekas — cocok untuk memanjakan lidah setelah hari yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891403,
					"content": "Tapi menurutku, para pengrajin lebih membutuhkan ini dibandingkan para tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891404,
					"content": "Para pengrajin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891405,
					"content": "Seperti yang kamu lihat, taman ini belum benar-benar rampung. Seporsi Barbeque Ribs ini pasti bisa memulihkan energi para pengrajin yang bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891406,
					"content": "Sebagai atasan mereka, sudah jadi tanggung jawab kalian untuk menyediakan makanan, kan? Sekalian undang mereka untuk makan di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891407,
					"content": "Siapa tahu, bisa saja mereka jadi makin semangat bekerja dan lebih produktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891408,
					"content": "Oh? Seingatku dulu kamu pernah menyajikan Fish and Chips spesial untuk para porter di Fleuve Cendre juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891409,
					"content": "Selama beberapa hari setelahnya, kerja mereka jadi sangat efisien. Mereka bisa menyelesaikan pekerjaan delapan jam hanya lima jam. Dan karena mereka pulang lebih awal, mereka bisa kembali dengan kondisi yang segar besoknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891410,
					"content": "Kalau begitu jangan buang-buang waktu lagi. Ayo undang mereka ke sini mumpung makanannya masih panas. Aku siapkan hidangan pendamping dan pencuci mulut juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891411,
					"content": "Ide bagus! Reputasimu memang tidak pernah bohong, Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891412,
					"content": "Kayaknya hidangan tema ini bakal berguna banget deh! Kalau begitu kami harus sering-sering ngobrol sama kamu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891413,
					"content": "Kamu dan Navia mengundang para pengrajin dan menjamu mereka dengan hidangan Barbeque Ribs yang sangat menggugah selera ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4018915,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
