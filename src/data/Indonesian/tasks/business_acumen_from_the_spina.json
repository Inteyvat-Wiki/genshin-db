			"dialogs": [
				{
					"id": 401891301,
					"content": "Aha! Inilah esensi dari metode improvisasi klasik Escoffier — \"hidangan misterius yang terinspirasi dari bahan-bahan utamanya\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
