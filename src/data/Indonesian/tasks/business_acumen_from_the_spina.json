			},
			"dialogs": [
				{
					"id": 401891001,
					"content": "Yah, mungkin angkanya belum terlalu mengesankan, tapi mengingat kita baru mulai, kurasa ini awal yang cukup bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Dengan memanfaatkan momentum ini, kita harus mempertimbangkan untuk menerapkan lebih banyak strategi bisnis yang unik di periode berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Untuk menarik pengunjung, aku sudah mengundang salah satu koki selebriti dari Fontaine, yaitu sahabatku Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "Dia akan \"mengadakan pertunjukan\" di restoran taman hiburan sini. Nah, ayo kita temui dia sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "Jadi restoran ini juga bagian dari strategi bisnisnya? Dalam sekali ya perencanaannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018911,
