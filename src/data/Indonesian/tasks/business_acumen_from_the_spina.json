			"dialogs": [
				{
					"id": 401891101,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891102,
					"content": "Restoran ini sungguh luar biasa, dan lokasinya yang berada di tepi air akan memberikan pengalaman makan yang unik. Pemandangan indah yang terpantul di air menciptakan latar belakang yang memukau, mengangkat suasana hati para tamu dan membuat mereka dapat benar-benar menikmati hidangan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Bahan-bahan, aman ... Peralatan masak, aman ... Sepertinya kita sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891104,
					"content": "Hei, Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "Oh? Bos-bosku sudah tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#Ketua Spina di Rosula, ditambah {NICKNAME} dan Paimon yang terkenal ... sepertinya kalian terlalu hebat untuk membuka taman hiburan bertema film seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "Kalau bicara soal kualifikasi berlebih, justru mantan koki kepala dari Hotel Debord yang terlalu hebat. Ke mana pun kamu melangkah, selalu ada aroma masakan lezat yang mengikuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Ehem, mari kita kembali ke inti pembicaraannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#Kutebak kamu mau {NICKNAME} membantuku menentukan hidangan tema untuk setiap periodenya. Benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "\"Hidangan tema\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "Ini adalah strategi bisnis yang kusebutkan sebelumnya — menggunakan hidangan kelas atas Escoffier untuk menarik lebih banyak pengunjung ke taman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "Tapi ini bukan hanya soal menarik pengunjung. Karya kuliner istimewanya pasti akan memberikan efek mengejutkan lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Paimon, coba kamu pikir-pikir lagi. Kalau cuma perlu satu tiket masuk untuk taman bermain, tapi kamu bisa main sampai puas dan makan makanan legendaris, apa kamu tidak jadi semangat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "Ka-Kalau begitu sih, Paimon bakal datang tiap hari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "Ada jual tiket tahunan juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Tapi kalau kami umumkan menunya, nanti pelanggannya jadi kurang penasaran kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "Berdasarkan survei dari seorang konsultan branding makanan tertentu, sekarang banyak restoran yang menawarkan hidangan \"Kejutan Chef\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "Jadi, tolong berikan aku inspirasi makanan setiap beberapa siklus bisnis, lalu aku akan tentukan hidangan temanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Nah sekarang, coba ulurkan tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "Tanganku ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Mm, rasanya hangat dan penuh energi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Tanganmu kapalan karena sering menggunakan pedang, tapi masih terasa lembut. Kamu menggenggam gagang pedang seperti sedang memegang busur biola ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "Pedang ya .... Kalau begitu, tema kali ini adalah \"Kekuatan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "Oke! Mari kita pikirkan bagaimana bentuk \"kekuatan\" dalam sebuah hidangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "Aku baru tahu inspirasi bisa ditransfer secara fisik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "Aku bakal cari cara buat tinggal di sini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
