					"content": "Tunggu aku bereskan beberapa hal lain dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890302
					]
				},
				{
					"id": 401890302,
					"content": "Tidak masalah. Pokoknya kami tunggu kamu siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
