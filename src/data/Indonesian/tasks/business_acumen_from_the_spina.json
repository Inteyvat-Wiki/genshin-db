		},
		{
			"id": 4018904,
			"completionStepIds": [
				4018901
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4018901",
							"2"
						],
						"stepId": 4018901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "Selanjutnya, rekan baikku dan Paimon, kita akan masuk ke topik utama, yaitu \"Chevalmarin Film Fantasyland\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Seperti yang disebutkan tadi, taman ini didirikan oleh para penggemar yang mengundang Spina di Rosula untuk menangani perencanaan, pembangunan, dan operasionalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Tentu saja, para penggemar biasanya bukan ahli dalam segala hal. Mereka biasanya hanya fokus pada perancangan stan acara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Kami menangani operasional jangka panjang dan mengembangkan panduan strategi standar untuk berbagai aktivitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Jangka panjang, operasional ... ribet banget ya kayaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "Tapi kami menghabiskan sebagian besar waktu untuk bertualang! Lagi pula, kamu hampir tidak pernah mengelola kios sendiri sebelumnya. Menurutmu kita bakal bisa tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Tidak semua bos besar lulusan sekolah bisnis, tahu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "Nah, begitu dong! Kamu sudah melihat semuanya, kan? Aku bahkan berani bilang kalau kamu sudah membentuk beberapa usaha bisnis terbesar di Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Intinya! Sekarang kita tentukan dulu fondasi dasar dari taman hiburan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Ah, kayaknya Paimon ngerti deh. Gimana, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Haha, kayaknya cocok banget sama aku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Yap, kita pasti bisa deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Tadi kamu bilang soal \"panduan strategi standar\" ... berarti ada \"panduan strategi tidak standar\" juga kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Tentu saja! Film dan hiburan memiliki arti yang berbeda bagi setiap orang, jadi akan ada berbagai macam kegiatan menarik yang bisa dicoba oleh semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Bisa jadi, ada turis yang tidak tahu jalan, berputar-putar sebentar lalu berlari keluar dari area tamannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "Yang lain mungkin mengambil properti berbahaya secara tidak sengaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Biar tidak kebingungan, kita perlu membuat \"panduan strategi standar\" untuk setiap aktivitas. Anggap saja seperti panduan dasar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Oh, jadi kamu mau aku jadi kelinci percobaanmu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Kalau dipikir-pikir, Paimon jadi bisa bayangin semua \"kejutan\" yang ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Kalau ada bagian yang susah, kita harus pakai keahlian kita buat lewatin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "Tentu saja, aku tidak bakal membahayakan rekanku sendiri. Aku sudah memeriksa dengan teliti semua aktivitas yang ada sebelum kamu datang, dan aku bisa memastikan bahwa semuanya benar-benar aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "Aku juga mau kamu coba aktivitas-aktivitas ini sebelum orang lain. Kami mau dengar pendapat dan saranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "Hehe, memang Navia hebat ya, selalu pastiin acaranya seru, tapi tetap aman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "Pendapatmu penting sekali buatku, oke? Aku tidak sabar dengar opinimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "Baiklah, mari kita mulai dengan Perjalanan Penuh Warna dan buat panduan pertama kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Aku mengerti, kamu ingin aku jadi patokan standarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Wow, sambil jalan sambil belajar deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "Kita sendiri sudah banyak coba bisnis besar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
