			},
			"dialogs": [
				{
					"id": 401891601,
					"content": "Fiuh ... sepertinya sudah semua. Kelihatannya kamu sudah benar-benar menguasai cara mengelola taman hiburan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Eh? Yang benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Tak terasa ya, kita sudah belajar banyak banget hal baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Ini semua karena penjelasanmu yang bagus, Navia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Ah, tidak juga. Aku tidak merasa mengajarimu banyak hal kok. Instingmu lah yang lebih banyak bekerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "Waktu pertama dengar sebutan \"operasi jangka panjang\", pasti kedengarannya menakutkan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "Tapi jangan sampai itu membuatmu panik! Bagi saja semuanya menjadi langkah-langkah kecil dan hadapi satu per satu. Kalau pun kamu bukan orang jenius atau berbakat, pasti tetap bisa selesai pada akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Wah, melihat kemajuan diri sendiri, Paimon jadi makin semangat nih! Paimon mau catat kata-kata motivasi dari Navia ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "Mulai sekarang, kita akan menjalankan Chevalmarin Film Fantasyland bersama-sama. Kita bikin jadi sukses besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Tidak mungkin bisa melakukannya tanpa ajaranmu, Navia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
		}
	]
