			"dialogs": [
				{
					"id": 401890601,
					"content": "Kalian kelihatan jadi lebih bersemangat dari sebelumnya. Kayaknya percobaan pertama kalian tidak mengecewakan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890602,
					"content": "Format tantangannya mudah dimengerti sih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "Paimon enggak sering nonton film sih, tapi habis coba tadi ... kayaknya Paimon suka deh! Kita harus tonton film aslinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890605,
					"content": "Bagus, Paimon! Kamu jadi sudah mengerti pikiran para fans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890606,
					"content": "Membuat pengunjung penasaran dengan film-film yang menginspirasi atraksi ini memang tepat seperti yang diharapkan oleh teman-teman penggemar kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890607,
					"content": "Dan kalau anggaran mereka memungkinkan, beberapa dari mereka bahkan bersedia mengeluarkan dana tambahan dari kantong mereka sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890608,
					"content": "Pa ... pakai uang sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890609,
					"content": "Benar sekali! Meski Spina di Rosula menanggung biaya bahan-bahan dasar untuk stan dan biaya sewanya, tapi banyak penggemar yang mendanai materi promosi dan merchandise-nya dari kantong mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890610,
					"content": "Pengeluaran utama mereka bukan di biaya stan. Beberapa dari mereka bahkan sudah mulai mendesain produk turunan yang terinspirasi dari karakter-karakter di film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890611,
					"content": "Ambil contoh maskot resmi kita, Surintendante Chevalmarin. Dia meraih peringkat kedua di voting \"Karakter Terpopuler\" terakhir untuk kategori film komik. Dia bahkan dijuluki sebagai \"Karakter Gembul Paling Lucu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890612,
					"content": "Banyak orang ingin membuat bantal dengan desain yang menggambarkan dirinya, menggunakan kain berkualitas terbaik, dan mempekerjakan pengrajin paling terampil untuk produksi massal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890613,
					"content": "Bantal-bantal ini akan resmi dijual di konvensi berikutnya, bersama dengan banyak produk serupa lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890614,
					"content": "Setelah kamu bilang begitu, aku jadi tertarik juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "Menarik sekali, kan? Selain itu, sebagai wali dan agen resmi untuk hak cipta gambar Surintendante Chevalmarin, Furina akan dapat enam puluh persen dari pendapatan penjualannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890618,
					"content": "Lagi pula, para penggemar melakukan ini secara sukarela — bukan untuk cari untung, tapi untuk mempromosikan citra menggemaskan Surintendante Chevalmarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890619,
					"content": "Semakin banyak Mora yang masuk ke dompet Furina, semakin mewah juga makanan Surintendante Chevalmarin. Ini berarti semuanya jadi senang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890620,
					"content": "Hehe, Paimon juga ikut senang dengernya! Semua orang rela kerja keras demi hobi yang sama, bukan demi untung doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890621,
					"content": "Tapi tetap saja kita tidak bisa mengabaikan Mora. Mau itu untuk kreasi penggemar atau proyek komersial resmi, tetap perlu keseimbangan finansial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890622,
					"content": "Logika ini juga berlaku untuk Chevalmarin Film Fantasyland secara keseluruhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890623,
					"content": "Setelah kita menyelesaikan panduan strategi standar-nya, wahana-wahana kita sudah bisa resmi dibuka untuk umum. Tapi kita tidak bisa jadi pihak yang menjual tiket secara langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890624,
					"content": "Masih banyak hal yang perlu diurus di stan ini, dan tamannya juga harus terus dibangun. Jadi kita akan tempatkan karyawan untuk mengelola setiap wahana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890625,
					"content": "Ada bagian rekrutmen di papan pengumuman di taman. Kami udah terima banyak lamaran, dan setiap kandidat punya kelebihan masing-masing. Nah, tugas kita itu mencari kandidat terbaik untuk setiap wahana berdasarkan kemampuan mereka secara keseluruhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890626,
					"content": "Setelah ditugaskan, staf-nya yang akan menjaga wahana terus beroperasi, jadi pendapatannya mengalir terus deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890627,
					"content": "Eh, tiba-tiba kita berubah dari penguji coba jadi ... Kepala Tim HR? Kayaknya sama sekali belum pernah begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890628,
					"content": "Standarku tinggi loh kalau periksa CV orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "Tapi kan enggak bisa pakai diri sendiri buat jadi standarnya, enggak semua orang bisa sama kayak kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890631,
					"content": "Oke deh, saatnya kita periksa CV orang-orang! Semoga kita dapat calon yang mantap ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890629,
					"content": "Kayaknya aku cocok deh jadi bos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "Furina harusnya dapat royalti besar juga dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "Tenang, sebagai wali dan agen resmi untuk hak cipta Surintendante Chevalmarin, Furina sudah dapat enam puluh persen dari pendapatan penjualannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890603,
					"content": "Dan cocok sama tema filmnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
