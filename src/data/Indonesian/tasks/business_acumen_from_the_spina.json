			"dialogs": [
				{
					"id": 401890801,
					"content": "Oke, kayaknya karyawan ini sudah mulai bisa bekerja dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Semoga kerja mereka lancar semua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Hahaha, lumayan juga kalian, bahkan lebih kedengaran seperti bosnya daripada aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "Oke deh, dengan begini, Chevalmarin Film Fantasyland resmi dibuka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Mengelola taman hiburan adalah proyek jangka panjang, tidak bisa dilakukan dengan buru-buru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Kita sudah mau selesai dengan pengaturan kerja saat ini, jadi ayo istirahat sebentar dan tunggu laporan pendapatan untuk periode ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Akan kuperhatikan absensi mereka baik-baik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
		{
			"id": 4018909,
