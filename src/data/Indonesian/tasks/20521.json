			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Bagaimana bisa dia pergi bertualang tanpa persediaan bertualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "\"Persediaan bertualang\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Oh, maksudku seperti hidangan panas. Aku bicara mengenai Iris, seorang petualang. Seharusnya dia membawa beberapa hidangan panas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Iris ingin mengadakan ekspedisi ke pegunungan bersalju lagi bersama timnya. Tapi dia bilang akan pergi ke gunung itu duluan, lalu berkemah di sana, mengamati situasi secara terperinci dan kemudian membuat rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Kemahnya tidak jauh, dan tidak sulit untuk mengirim beberapa persediaan ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Tapi bagaimanapun juga, dia berkemah di pegunungan yang tertutup salju. Menurutku jika dia bisa makan hidangan panas, dia mungkin akan berasa lebih bertenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Tapi aku tidak berani memasuki gunung salju sendirian... Bisakah kamu membantuku memberikan \"Cream Stew\" ini kepada Iris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Aku baru saja membuat hidangan ini dan masih panas. Kamu harus segera memberikannya kepada Iris. Dalam cuaca seperti ini, makanan bisa cepat dingin, dan kalau sudah dingin, makanannya sudah tidak enak untuk dimakan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Tapi... jika terjadi sesuatu yang tidak terduga dan makanannya tidak bisa dimakan, tolong kembalilah padaku dan aku akan membuatkan satu lagi untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Di mana aku bisa menemukan dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Dia bilang perkemahannya terletak di jalanan utama gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Dia seorang petualang yang berpengalaman dan sangat berhati-hati. Dia tidak akan berkeliaran terlalu jauh dari perkemahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
		{
			"id": 2052102,
			"completionStepIds": [
				2052102
			],
