			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Ini \"Cream Stew\" untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Oh, jadi Harris memintamu untuk membawanya ke sini, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Sebaiknya aku tidak terlalu terbiasa dengan masakan lezat buatannya. Kalau tidak, mungkin aku akan ketagihan dan justru tidak bisa memakan makanan lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Hahaha, aku bercanda. Jangan khawatir, sebagai seorang petualang aku tentu akan selalu memperhatikan waktu makanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Apa kamu masih ingin terus melanjutkan pergi ke dalam gunung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Tentu saja kemah ini hanya sebagai tempat persinggahan. Aku akan menunggu kesempatan yang bagus, lalu melihat apakah aku bisa mendirikan kemah lebih jauh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Pada saat itu, pastinya tidak akan ada hidangan panas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Namun, aku juga tidak akan gegabah, aku hanya akan mengamati sebentar, lalu kembali ke perkemahan dan mempertimbangkannya secara terperinci sebelum membuat rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Terima kasih karena telah mengantarkan hidangan ini untukku, ini untukmu, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
