				"points": []
			},
			"dialogs": [
				{
					"id": 205210201,
					"content": "Ya? Apa yang kamu lakukan di sini? Apa kamu seorang petualang juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
