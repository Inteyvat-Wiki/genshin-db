			"dialogs": [
				{
					"id": 710051201,
					"content": "\"Keserakahan, kerinduan, perhatian, kecemburuan, kemarahan, keinginan jahat, kekaguman pada diri, persaingan, kekacauan...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Prasasti"
				},
				{
					"id": 710051202,
					"content": "\"Sembilan jenis perasaan ini tidak hanya dapat membantu dunia, tetapi juga dapat menghancurkan dunia. Oleh karena itu, sembilan pilar dibangun untuk menenangkan dunia, dunia yang sedang berperang di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Prasasti"
				},
				{
					"id": 710051203,
					"content": "\"Jika ada seseorang dari generasi masa depan menghancurkan sembilan pilar, peperangan dunia akan terulang kembali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Prasasti"
				},
				{
					"id": 710051204,
					"content": "\"Kamu yang membaca prasasti ini, dapat mengambil harta karun, dan melindungi Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prasasti"
				}
			]
		},
