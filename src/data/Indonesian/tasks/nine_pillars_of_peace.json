			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Ingin memintamu melihat barang antik ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Aku juga tidak terlalu mengerti tentang barang antik... Tapi, coba kulihat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Cincin ini... coba kulihat, gioknya cukup kasar. Oh, bahan giok ini lumayan, giok ini cukup bernilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Ada ukiran di cincin ini... \"Semua makhluk menderita dalam perang\"... Dari mana kamu mendapatkan cincin ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "Reruntuhan sebelah Cuijue Slope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Cuijue Slope, Cuijue Slope... Sayang sekali, sebelahnya adalah Jueyun Karst...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Kalau saja cincin ini berasal dari reruntuhan Jueyun Karst, maka harganya pasti tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Sayang sekali, cincin ini harganya jauh lebih rendah. Tapi kondisi cincin ini masih bagus, pasti ada orang yang mau membelinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Begini saja, aku beli dengan harga <color=#00E1FFFF>180000 Mora</color>, ditambah dengan barang lainnya. Apakah kamu setuju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
