			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "Suasana di reruntuhan ini selalu membuat Paimon merasa tidak nyaman. Tapi, seharusnya inilah akhir dari reruntuhan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "Perjalanan ini bisa dibilang cukup menguntungkan, hehe... bahkan kita berhasil mendapatkan cincin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Ayo kita cepat pergi mencari beberapa <color=#00E1FFFF>orang yang mengerti barang antik</color>, dan menanyakan berapa harga jual harta karun ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
