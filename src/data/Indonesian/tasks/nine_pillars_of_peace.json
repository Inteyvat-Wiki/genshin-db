			"dialogs": [
				{
					"id": 710050501,
					"content": "Aku masih berpikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Mungkin kamu pikir harga cincin yang aku tawarkan bukan yang tertinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Tapi dari segi bisnis, kalau kamu menjual cincin ini padaku, dijamin tidak akan mengecewakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Coba kamu pikirkan, cincin berharga ini mana mungkin terjual dalam sekejap mata. Bagaimana kalau kamu menjual cincin ini kepadaku, nanti kalau ke depannya ada transaksi, aku akan memberi tahumu dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Selain itu, aku juga masih akan memberimu barang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Kamu pikirkan baik-baik, kalau kamu bersedia menjual cincin itu padaku, datang saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
