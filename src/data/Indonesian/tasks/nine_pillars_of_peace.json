					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Ingin memintamu melihat barang antik ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Barang antik? Bagus, kamu datang ke orang yang tepat. Harga yang kuberikan untuk barang antik adalah harga paling masuk akal di Pelabuhan Liyue ini, coba kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Giok dan cincinnya sendiri terbuat dari bahan yang bagus. Umurnya sudah sangat lama... dan cincin ini terawat dengan baik, benar-benar langka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Tapi, aku belum pernah mendengar kata-kata \"Semua makhluk menderita dalam perang\" yang terukir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Ya sudahlah, dari mana kamu menemukan cincin ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "Reruntuhan sebelah Cuijue Slope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Reruntuhan sebelah Cuijue Slope... Kamu memiliki kemampuan yang cukup bagus, sampai berani pergi ke sana untuk mencari harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Bukankah di area reruntuhan itu ada sembilan pilar, yang di tengah-tengahnya terdapat monumen batu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "Jangan terlalu terkejut, aku sering mendengar orang yang datang ke sini untuk berbisnis membicarakan tentang reruntuhan itu. Konon katanya ada pertempuran yang sangat besar, pasti di dalam sana ada harta karun yang terkubur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Bahkan ada beberapa orang yang mengatakan, pilar-pilar dan reruntuhan di dalamnya, dibangun oleh nenek moyang Liyue untuk menghentikan peperangan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Namun, mungkin itu juga tidak lebih dari sebuah legenda saja. Kalau sembilan pilar batu dapat menghentikan peperangan, maka dunia akan damai sejak awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Entah legenda itu benar atau tidak, tapi karena cincin ini berasal dari reruntuhan itu, dia pasti ada hubungannya dengan legenda tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Tidak hanya memiliki nama, tapi juga memiliki sejarah, dan kualitasnya bagus, pasti bisa dijual dengan harga yang tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "... Tenang, aku tidak akan bertanya padamu bagaimana kamu membuka reruntuhan itu. Aku hanya berbisnis, sisanya tidak ada hubungannya denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Aku akan membeli cincin ini dengan harga <color=#00E1FFFF>200000 Mora</color>, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
