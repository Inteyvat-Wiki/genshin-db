					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Bagus! Ini uangnya, silakan pegang baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Oh, cincin ini adalah harta karun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Pasti masih ada harta karun lainnya di dalam reruntuhan itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
