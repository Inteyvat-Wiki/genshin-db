			"dialogs": [
				{
					"id": 710050101,
					"content": "\"Semua perang di dunia berasal dari hati manusia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050102
					],
					"speakerTitle": "Prasasti"
				},
				{
					"id": 710050102,
					"content": "\"Sembilan pilar dibangun untuk menciptakan kedamaian dunia, menghentikan pertempuran yang tak pernah berakhir ini, dan sebagai harapan agar tak ada lagi pertikaian...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prasasti"
				}
			]
		},
		{
			"id": 7100502,
			"completionStepIds": [
