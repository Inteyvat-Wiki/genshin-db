			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"... Aku sudah memperbaiki oud yang dirusak Paman Bakr, jadi jangan menangis lagi ya? Kalau kamu masih sedih, ngobrollah dengan Khayyam dan aku ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570902,
					"content": "\"... Aku sudah diterima oleh Akademiya, ucapkan selamat padaku!!! Haha. Aku tidak mau menjadi istri petarung, aku ingin menjadi Siman, seorang Great Sage!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570903,
					"content": "\"Hehe, Irfan si Pemusik dan Khayyam yang Orang Bijak! Jangan melupakan aku! Terutama kamu Khayyam! Jangan pernah melupakan aku!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570904,
					"content": "\"Sampai jumpa, buku catatan! Selamat tinggal, Irfan dan Siman, sahabat-sahabatku! Semoga hutan tidak lupa akan cerita kita, dan semoga kita selalu ingat satu sama lain.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570905,
					"content": "(Sisanya berantakan, isinya penuh dengan kenangan indah dan kenangan sedih seorang anak.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570906,
					"content": "\"Aranakin sudah pergi. Hilang begitu saja, tanpa pertanda, tanpa basa-basi. Waktunya mengucapkan selamat tinggal kepada oud. Aku akan jadi pengrajin, seperti yang ayah inginkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570907,
					"content": "(Masih ada lanjutannya, tapi sudah dicoret dan ketumpahan tinta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570908,
					"content": "\"Untuk orang yang membaca buku catatan ini, kalau beberapa tahun lagi, terjadi mukjizat pada diriku sehingga aku bisa bertemu dengan Aranakin dan yang lainnya, maka tolong berikan bunga ini untuknya ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Buku Catatan Usang"
				},
				{
					"id": 730570909,
					"content": "Hmm ... kayaknya ada yang jatuh dari dalam buku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Itu kayaknya ... bunga? Kok mirip yang kita punya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
