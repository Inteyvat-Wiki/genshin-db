			"dialogs": [
				{
					"id": 730570801,
					"content": "Kalau kamu ada menemukan hal yang menarik, kasih tahu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
