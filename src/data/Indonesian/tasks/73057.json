			"dialogs": [
				{
					"id": 730570601,
					"content": "Di atas masih ada daun yang ditinggalkan Nara. Tapi ... aku enggak ngerti, enggak paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570602,
					"content": "Itu ... Daun yang dipakai Nara buat menyimpan kenangan. Di atasnya ada tulisan, tapi Aranakin tidak paham artinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Kamu bilang ... \"buku catatan\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "\"Buku catatan\" ...? Mungkin itu barang yang dipakai Nara buat nulis kenangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Ehm, bisa jadi itu ... Aranakin keberatan enggak kalau kita ke atas, terus lihat-lihat isi tulisannya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Aku? Enggak dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "Di dalamnya ada kenangan apa? Apa yang kalian lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "Pemilik buku catatan sepertinya kenal sama kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Iyakah ... Aku sudah enggak ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "Dia bilang ... Dia sudah enggak bisa ngeliat kamu lagi. Mungkin karena dia sudah tumbuh dewasa sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Huh ... jadi dewasa pasti banyak hal yang dipikirin ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Oh iya, di catatan ini juga dia nulis kalau bunga ini buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "Oh-waw! Ini kan bunga yang penting sekali! Kok kamu ... bisa punya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "Sebenarnya kamu juga pernah ngasih kami bunga yang sama ... tapi kamu sudah lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Gitu ya ... Sama kalian sih aku bisa berteman lagi. Tapi kalau sama dia ... bahkan aku saja sudah sama sekali tidak ingat dia itu gimana wujudnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "Eh, eh, sudah enggak apa-apa kok ... kamu jangan sedih ya. Kami kan masih punya bunga yang ini, pasti bisa kasih kamu lebih banyak kenangan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Iya betul, Putih Melayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "Aku mau bawa pulang bunga ini, \"Mawtiyima\" seharusnya tahu cara membuatnya terbangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#Huh ... Nara {NICKNAME} dan Putih Melayang, aku mau pulang ke tempat Aranaga. Sudah gitu aku akan menanamnya, juga mendengarkan lagunya. Kalau kalian ada waktu, datang ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "Iya, pasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305708,
