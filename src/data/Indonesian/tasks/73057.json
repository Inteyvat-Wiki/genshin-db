			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Haha, tuh kan dia muncul! Apa kabar, benda kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570202,
					"content": "Aranakin bukan benda kecil! Yang kecil itu kamu, benda putih ngambang-ngambang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570203,
					"content": "Tapi omong-omong, \"pasir\" emas ... Nara, kok kalian bisa memainkan lagu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570204,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570205,
					"content": "Kan kamu yang mengajarkan kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "Benar, pas kita terakhir bertualang bareng itu kan kamu yang ngajarin kami lagunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570209,
					"content": "Begini .. bukan? Aranakin bodoh, tapi kalian kelihatannya enggak seperti \"pasir\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570210,
					"content": "Ya iya dong! \"Pasir\" kan \"Valuka\", dan itu kan Nara jahat. Kalau kami ini kan Nara baik! Dulu kamu ngomong gitu kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570211,
					"content": "Oh iya? Aku pernah bilang begitu sama kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570212,
					"content": "#Haha, benar! {NICKNAME}, kita ceritain saja dulu kisah kita ke dia sekali lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570213,
					"content": "Kalian menceritakan tentang petualangan kalian bersama kepada Aranakin, termasuk pengalaman saat akhirnya bisa membuat \"Withering\" tenang kembali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "Oh jadi gitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570215,
					"content": "Aranakin bodoh sekali ya, tapi ucapan kalian sih seharusnya sudah benar. Aranakin yang lupa, maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570216,
					"content": "Enggak perlu ngerasa bersalah gitu! Lupa itu kan hal yang wajar, hehe ... lagian, kita bisa berteman dari awal lagi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570217,
					"content": "Aranakin anak baik deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Huh ... karena kita teman baik, sini ikut aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570221,
					"content": "Eh? Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570222,
					"content": "Nara Emas dan Si Putih Melayang! Ayo ke tempatku, ikuti aku!Si Putih Terbang",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570218,
					"content": "Paimon anak baik deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Oh, ya sudah jelas, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570207,
					"content": "Aku memainkan lagu ini secara khusus supaya bisa ketemu kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Hehe, {NICKNAME} mainnya bagus enggak? Hebat kan kami masih ingat partitur yang kamu ajarin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
