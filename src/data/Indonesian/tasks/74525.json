			"dialogs": [
				{
					"id": 745250401,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "Raut wajahmu kelihatan serius sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "Oh, rupanya kamu. Tidak, misi investigasi hari ini sudah selesai, dan tidak ada hal yang mencurigakan di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "Aku cuma lagi mikir, kenapa rombongan Eremite yang lewat tadi kelihatan tidak bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "Mungkin karena kelelahan dalam perjalanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Menurutku, mungkin karena masalah keuangan. Karena kalau tidak ada uang, muka \"Eremite\" pun bakal jadi \"pahit\", kan? Mau kerja pun tidak bisa \"gesit\" deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "Kalau begitu, gimana kalau kita lakukan sesuatu yang enggak \"berbelit-belit\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Ah, boleh. Tapi kalau aku hanya berdiri saja, hasil fotonya pasti kurang mantap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "Tapi tenang saja, aku bisa pakai Electro biar hasil fotomu terlihat \"pro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "Ide bagus, aku akan ambil foto yang paling bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Oke. Aku serahkan padamu. Yang penting jangan sampai momennya lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Aku mau ambil fotomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Atau jangan-jangan misinya gagal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Kamu lagi berburu penjahat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
