			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110102,
					"content": "Akhirnya kamu kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110103,
					"content": "Haha! Kami sudah bekerja keras untuk membuat pedang ini kuat! Lihatlah ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110104,
					"content": "Coba lihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Hmm... Ternyata benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110106,
					"content": "Seperti dugaanku, pedang ini akan tumbuh kuat bila kamu menggunakannya dalam pertarungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110107,
					"content": "Tapi dia kan bukan manusia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110108,
					"content": "Itulah alasan mengapa pedang ini sangat unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110109,
					"content": "Oh ya, ada satu hal yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110110,
					"content": "Aku sudah memeriksa daerah sekitar gunung, dan aku menemukan jejak-jejak yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110111,
					"content": "Bukan pencuri, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110112,
					"content": "Bukannya kita pencuri yang sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "Benar juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110115,
					"content": "Kurasa jejak-jejak aneh itu harus diselidiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110116,
					"content": "Apakah itu pencuri atau sesuatu yang lain? Kita harus menyelidikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110113,
					"content": "Treasure Hoarder mungkin tidak akan berpikir seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
