			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Bagaimana rasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110302,
					"content": "Rasanya kekuatan pedang meningkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "Aku punya satu hipotesa mengenai ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110305,
					"content": "Setiap kali pedang menghisap kekuatan dari musuh, pedang ini juga akan beresonansi dengan puing-puing tubuh Durin yang terkubur jauh di dalam gunung salju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "Ya ampun, hebat sekali?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110307,
					"content": "Kalau tebakanku benar, ini berarti monster-monster di gunung salju mungkin dapat beresonansi dengan sisa kerangka Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110308,
					"content": "Tapi kenapa bisa begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "Takutnya ini ada hubungannya dengan sumber kekuatan monster-monster tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110310,
					"content": "Durin bukanlah monster biasa. Bahkan kini setelah mati, seluruh gunung salju ini masih terpengaruh kuat oleh sisa kerangkanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110311,
					"content": "Kekuatan naga yang misterius ini... mungkin merupakan suatu kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110312,
					"content": "Kita masih tidak punya informasi yang cukup. Kita harus mengumpulkan lebih banyak data agar bisa memahami lebih banyak lagi. Inilah kenapa aku mencarimu.",
