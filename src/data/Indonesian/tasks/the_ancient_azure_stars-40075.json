				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "Wow, kita kembali lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750802,
					"content": "Mona, apa petualang itu ... benar-benar sudah meninggal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750803,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750804,
					"content": "Aku cuma pernah melihatnya sekali saja. Dan itu pun sudah lebih dari tiga tahun yang lalu, jadi ... dia pasti sudah meninggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750805,
					"content": "Apa sama sekali enggak mungkin kalau dia bisa saja masih hidup? Misalnya andai saja ramalanmu salah, gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750806,
					"content": "Tapi itu tidak adil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "Kalau maunya hanya dengar yang baik saja dan tidak bisa terima kalau dengar yang buruk ... itu sih namanya bukan ramalan, tapi cuma menghibur diri sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750808,
					"content": "Kalau buat hiburan, tentu saja tidak masalah. Tapi tidak ada bohong-membohongi dalam bidang yang menjadi keahlianku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750809,
					"content": "Menyangkali hasil ramalanku, sama saja artinya dengan menghujat ilmu astrologi itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750810,
					"content": "Kejam tapi nyata, memang begitulah takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750811,
					"content": "Aku jarang-jarang mengatakan hal ini. Tapi karena kita sudah terlanjur membahasnya, kuharap kalian tidak menyamakan ilmu astrologi yang sesungguhnya dengan permainan tarik undian yang ada di jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750812,
					"content": "Kita tidak memakai astrologi untuk memuaskan semua pihak. Keberadaan astrolog adalah untuk mencari dan menyaksikan kebenaran yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750813,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750814,
					"content": "Ah ...! Makanya kubilang kan kalau astrologi itu profesi yang menyebalkan! Itu memang mengesankan, tapi juga mengesalkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750815,
					"content": "Kenapa kamu tiba-tiba protes sebanyak itu, oh Nona Megistus? Sepertinya kamu bukan jenis orang yang akan berteman dengan mereka yang tidak layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750816,
					"content": "Yang ingin Nona katakan adalah ... dia tetap senang berteman denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750817,
					"content": "Bukan! Bukan seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750818,
					"content": "Oz, apa yang terjadi denganmu? Lama-lama kamu semakin terbiasa keliru dalam menyampaikan kehendakku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750819,
					"content": "Aduh, kenapa ya? Mungkin aku takut kalau ucapan Mein Fräulein akan menyinggung temannya, jadi aku mencoba untuk melindunginya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750820,
					"content": "Aku tidak begitu mengerti sih, tapi yang pasti kamu cuma satu-satunya astrolog yang kukenal, dan kamu pun selalu membuatku merasa baik-baik saja. Kamu sama sekali tidak menyebalkan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750821,
					"content": "Kalau ada orang yang minta diramal, lalu seenaknya membuang hasil yang tidak mereka sukai, itu sih mereka yang harus introspeksi diri. Takdir bukan suatu hal yang murahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750822,
					"content": "Kalau takdir adalah sesuatu yang dapat disetir dengan berucap sepatah dua patah kata saja, maka tidak mungkin ada tragedi di dunia ini. Mona, jangan disimpan ke hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750823,
					"content": "Ikuti kata hati dan jangan lupakan apa yang benar. Cukup itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750824,
					"content": "Ehem ... Tidak perlu menghiburku seperti ini. Aku tegar kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750825,
					"content": "Terus kenapa telingamu merah begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Ugh, ugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750827,
					"content": "... Baiklah, i-itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750828,
					"content": "Terima kasih ... semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750829,
					"content": "Apa yang kamu katakan? Aku tidak bisa mendengarmu dengan jelas. Tolong tawarkan rasa hormat dan berkatmu kepada Prinzessin dengan lantang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750830,
					"content": "Sudahlah, Yang Mulia, daripada berbebat, kamu harus pergi ke lokasi baru di refleksi untuk mengumpulkan pecahan lainnya. Tanpa pecahan itu, kita tidak bisa memasuki alam fantasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750831,
					"content": "Mein Fräulein, hanya mata tajammu saja yang tajam mendeteksi setiap rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750832,
					"content": "Kalau begitu, baiklah, aku akan pindah ke pantai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750833,
					"content": "Ayo pergi, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750834,
					"content": "Oh, oke! Sabar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750835,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
}