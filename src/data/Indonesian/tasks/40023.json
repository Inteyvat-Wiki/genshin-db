			"dialogs": [
				{
					"id": 400230101,
					"content": "Pengembara, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230102,
					"content": "Aku sudah menjelaskan situasinya ke Tenryou Commission, dan menunjukkan pada mereka dokumen aslinya. Akhirnya, mereka percaya kalau Mystic Onmyou Chamber dan aku tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230103,
					"content": "Mantap! Sekarang kamu bisa mulai fokus sama tugas awalmu lagi dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230104,
					"content": "Benar. Aku juga sudah memulihkan Mystic Onmyou Chamber ke keadaan semula — domain yang didedikasikan untuk mengasah keterampilan bela diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230105,
					"content": "Kekuatan Charm Magic di domain ini akan terus berkurang seiring berjalannya waktu. Nantinya, aku akan tutup domain agar kekuatan tersebut dapat perlahan-lahan terkumpul kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230109,
					"content": "Sekarang mungkin saat yang tepat untuk mencobanya. Kamu sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230106,
					"content": "Aku sudah siap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
