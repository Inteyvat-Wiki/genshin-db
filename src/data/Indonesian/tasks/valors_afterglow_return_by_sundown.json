	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Halo! Silakan duduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Tentang petualangan kita sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Kamu mau tahu kenapa waktu itu aku begitu keras kepala dan membuat semua orang khawatir? Haha ... iya aku tahu aku salah, sudah jangan marahi aku lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Tapi apa mau dikata, \"marabahaya\" adalah suatu hal yang selalu menarik bagi para petualang seperti kita kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "Maksudku, kita lahir dengan tulang yang kuat dan tubuh yang lincah. Jadi ini terasa ... salah. Memiliki bermacam-macam alat yang hebat begini dan merasa nyaman karenanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Untuk risiko yang fatalnya, aku juga bukannya tidak memikirkannya tapi ... hmm, apa aku boleh tanya satu hal padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Stanley, petualang hebat dari Mondstadt, terkenal karena berlayar melintasi Mare Jivari tapi dia kehilangan sahabatnya dalam petualangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Karena petualangannya pada saat itulah sahabatnya meninggal ... Dan walaupun tidak banyak orang yang tahu namanya, namun prestasi dan kenangan akan dirinya sudah diturunkan melalui para petualang di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Aku sedang berpikir ... Haha, tolong jangan ketawain aku ya. Teman Stanley yang tidak pernah kembali itu ... Mungkinkah kalau dia sebenarnya belum mati dan bahkan bisa dikatakan dia benar-benar \"hidup\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "Menjaga hidupmu itulah yang paling penting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Bahkan jika karirnya menyebabkan dia mati muda, tapi karena dia selalu dikenang ... bukankah itu juga artinya dia terus hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "Kamu akan hidup dengan gaya yang berbeda, dalam kekaguman dan ingatan ... di mata orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Jangan terlalu memikirkan apa kata orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Sudah banyak orang yang bilang begitu padaku, \"jadilah dirimu sendiri\", \"kerjakan saja urusanmu sendiri\" ... Kelihatannya seperti memandu kita, tapi sebenarnya mereka ingin agar aku menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Sebenarnya aku sudah pernah bilang, aku bertualang bukan demi orang lain ... juga bukan demi diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Apa kamu pernah memikirkan hal ini sebelumnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Dunia ini dikendalikan oleh para dewa ... Tapi kita, sebagai orang biasa, bahkan tanpa \"Vision\" yang telah diberikan para dewa kepada kita. Namun kita masih memiliki kegigihan untuk tidak dilupakan begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Aku percaya bahwa pemikiran pantang menyerah ini tidak akan sia-sia. Karena itu, aku mempertaruhkan hidup untuk menjelajahi daerah berbahaya tersebut. Karena bagaimanapun juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "Maksudku, bergumul dengan hal-hal yang bahkan para dewa sendiri takut karena betapa lemahnya kita ... bukankah itu yang membuat kita menjadi \"manusia\"? Itulah yang aku yakini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Tapi makna dari petualangan itu kan bukan kamu sendiri yang memutuskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Ah ... iya aku paham. Aku tidak akan melupakan bantuan dari semua orang, tidak akan lupa pada bantuanmu ... karena petualangan ini bukan dijalani oleh diriku seorang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Haha, bukankah petualang memang begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Apa kamu sebegitunya mau jadi pahlawan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Heh, perjalananku masih jauh untuk bisa jadi sepertimu ... Daripada \"pahlawan\", aku lebih suka menyebut diriku sebagai seseorang yang \"tidak takut mati agar bisa benar-benar merasa hidup\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Ini juga kata-kata yang dikatakan oleh seorang senior di Sumeru padaku, terus dia juga dengar dari Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Kurasa itu cukup masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Yah, kalau kata Paimon sih kamu itu \"orang yang terus-terusan mengejar kesialan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Dapat diingat dalam kenangan semua orang, itu juga merupakan sebuah kesuksesan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Yah ... aku memang tidak pernah memikirkan sebuah kehidupan yang sukses. Tapi biarpun aku gagal, setidaknya aku tetap bisa memberikan dampak bagi orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Setidaknya akan ada orang yang bilang: \"Zhiqiong ya, dia itu petualang yang sudah menghadapi berbagai tantangan di Chasm itu loh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Setidaknya, aku tidak akan dilupakan seperti para senior lain yang mengorbankan dirinya di tempat terpencil atau ... yah, seperti aku sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Aku tidak pernah memikirkan hal seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Begitukah? Atau mungkin karena kamu orang luar, akhirnya selalu menjadi pusat perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "Kurasa ini sama seperti anak-anak yang memang terlahir kaya raya lalu merasa bahwa hidup miskin itu menarik, hanya karena merasa itu adalah sebuah petualangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Ah, maaf ... aku bukan bermaksud begitu, maksudku ... ah sudahlah. Lupakan saja kata-kataku barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Tentang Zhiqiong, tadi dia pergi untuk mengambil suar, tapi masih belum kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Awalnya aku pikir juga mungkin dia keluyuran dulu ke mana gitu, jadi aku beri dia waktu tiga jam lagi ... tapi sampai sekarang ini sudah lima-enam jam dan dia masih belum kembali juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Anak itu begitu menghormatimu, tolong bantu aku cari dia. Aku tidak mau lagi ada kecelakaan yang terjadi di hadapanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "Haiya! Anak itu! Kenapa dia menghilang lagi sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
