			"dialogs": [
				{
					"id": 240000201,
					"content": "Merepotkan sekali ... cuma buat Mora yang sedikit ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "Tentang \"Formulir Pendaftaran Informasi Anggota Bantuan Luar\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Kamu menceritakan hal yang dialami Livre dan permintaannya untuk meminjam formulir ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*huff* Si Livre apes banget ... aku kayaknya tidak punya formulir ekstra deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "Aku bawa staf dari toko untuk membantuku waktu aku memperbaiki lampu jalan di Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Sekarang, dia hampir tidak bantu sama sekali, jadi aku tidak tulis namanya di Formulir Pendaftaran Informasi Anggota Bantuan Luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "Tapi saat aku kumpulkan formulirnya, Clapiers bersikeras aku harus sertakan semua nama anggota ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "Dia juga bilang, kalau yang diisi memang tidak benar, nanti bakalan ada \"konsekuensi serius\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Serius deh, cuma hilang satu nama saja. Konsekuensi kayak apa sih memang yang bakal terjadi? Omong kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
