			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "Aku ulangi sekali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Tuan Livre. Saya sangat mengerti permintaan Anda dan bersedia membantu Anda semampu saya, tapi ... Silakan lihat sendiri aplikasi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000103,
					"content": "Penanggung jawabnya adalah Tuan Clapiers. Semua bahan yang pernah kamu berikan adalah miliknya. Selain penanggung jawabnya sendiri, kami tidak punya hak untuk mengutak-atiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000104,
					"content": "Sekarang dia sedang ada urusan, tidak ada di kantor. Material ini harus dicap dengan stempel resmi sebelum masuk ke sistem perhitungan biaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000105,
					"content": "Iya, iya! Aku sudah tiga kali ke sini. Mau urus atau tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Tolong tenangkan diri, Tuan Livre. Hanya ada dua orang di ruangan Tuan Clapiers, salah satunya Tuan Monthois ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000107,
					"content": "Dia sudah tua, sudah mau pensiun. Dan sebenarnya, sudah lama juga tidak kerja di kantor. Gaji saja tidak diambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000108,
					"content": "Kalau begitu aku sendiri yang akan ke kantor, paksa pak tua itu cap! Atau aku cap sendiri saja sekalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Maaf, tidak bisa seperti itu. Satu, melanggar aturan. Dua, kunci stempelnya ada di Tuan Clapiers, cuma dia saja yang punya akses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000110,
					"content": "Sedangkan aku ... masih ada urusan lain. Percayalah, Tuan Clapiers akan kembali untuk menyelesaikan urusan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000111,
					"content": "Baiklah. Semoga harimu menyenangkan, Nona Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Sama-sama Tuan Livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000113,
					"content": "Cornelia pun pergi dengan tergesa-gesa ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "Cih. Sepertinya hari ini aku harus pulang tanpa hasil lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Bukan apa-apa sih. Cuma buang waktuku saja, tepatnya setengah hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "Aku sudah muak dengan si Clapiers ini! Palais Mermonia pesan beberapa mesin roda gigi dari kami, tapi belum bayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "Pertama kali aku cari dia, katanya kantor sedang ada audit bulanan internal, hanya bisa keluar uang ke pihak luar bulan depannya. Pengajuanku tidak bisa diproses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "Kedua kalinya, dia bilang kehabisan tinta cap, gudang tintanya kebakaran, mau tidak mau harus beli dari tempat lain. Artinya, pengajuanku tetap belum bisa dicap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "Ketiga, dia bilang Formulir Pendaftaran Informasi Anggota Bantuan Luar-nya sudah diperbarui, jadi harus diisi ulang. Dan tentu saja, mereka kehabisan formulir. Datangnya baru \"besok\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Aku sengaja ke sini buat ambil, tapi orangnya malah tidak di kantor. Demi semua Archon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Hmm? Tuan Livre, ada yang bisa dibantu? Kenapa seperti sedang kesal begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Bu Rhemia! Syukurlah kita bertemu. Gini kejadiannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "Mulut Livre pun tak henti bercerita ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Ah, Tuan Clapiers ... agak susah dihubungi ya, memang. Tapi dia benar-benar sedang di Erinnyes, bukan di Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Tapi sebaiknya urus dulu formulirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Eh? Tapi Tuan Clapiers bilang tidak ada formulir lain lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "Aku ada jalan keluar. Kalau tidak salah, beberapa toko yang bekerja sama dengan Palais Mermonia juga punya masalah yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "Solusinya ya, datang ke Palais dari waktu ke waktu, supaya bisa ambil formulir dan dokumen yang mungkin dibutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "Tujuannya agar mengisi dan mengumpulkan formulir jadi lebih mudah, dan supaya tidak ketinggalan kalau ada perubahan ... \"siap sedia setiap saat\", kurang lebih begitulah istilahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "Apa karena itu formulirnya tidak ada sisa sama sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "Itulah kenapa toko-toko tadi pasti punya formulir lebih. Ayo kita sambangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "Aku yakin mereka mau bantu kalau sudah dengar perjuanganmu bolak-balik Palais tanpa membuahkan hasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "Ya. Kita ambil formulirnya, isi, lalu antar ke kantor Tuan Clapiers sebelum jam bubaran Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "Pengembara, mau ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "Pengembara, tolong! Kalau ini belum kelar, aku tidak bakal bisa tidur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Cek dua toko ini dan pinjam Formulir Pendaftaran Informasi Anggota Bantuan Luar edisi terbaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Coba lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Tolong kunjungi bengkel pandai besi Nona Estelle dan toko jam Tuan Caron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Belum lama berselang, nona pandai besi membantu Palais membetulkan lampu jalan. Toko jam bantu menyetel jam di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Keduanya sering dapat tugas dari Palais, mereka pasti punya Formulir Pendaftaran Informasi Anggota Bantuan Luar yang lebih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Kedua lokasi itu kuserahkan padamu ya, aku dan Livre akan berpencar ke toko-toko lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Tapi aku harus ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
