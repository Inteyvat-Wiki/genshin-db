			"dialogs": [
				{
					"id": 200080101,
					"content": "Terima kasih telah menyelamatkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Para Slime ini tiba-tiba muncul entah dari mana. Kupikir mereka tidak akan muncul di daerah sini, sebelum aku sempat berlari mereka sudah mengelilingiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Tolong jangan katakan ini pada ayahku. Ayahku sebenarnya ingin aku tetap diam di rumah. Katanya akhir-akhir ini para Slime di sekitar sini liar sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Jadi sejak banyak Slime bermunculan di daerah kota, aku berdiam diri terus di rumah. Tapi hari ini aku berhasil menyelinap keluar tanpa diketahui olehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Jika kamu tidak keberatan, bisakah kamu memeriksa keadaan di depan sana, jika kamu melihat para Slime itu, tolong singkirkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Terima kasih! Akhirnya aku bisa bermain dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "Ta-tapi... Aku tidak bisa memberi tahu ayahku... ayolah, aku hanya bisa mengandalkanmu, tolonglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
	]
