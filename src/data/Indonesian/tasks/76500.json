			},
			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}! Cepat sini! Ada hal keren yang mau Paimon tunjukkan ke kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000102,
					"content": "Tadaa! Lihat, ini adalah harta yang Paimon dapetin susah payah di pasar yang super rame ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000103,
					"content": "Kamera ini kelihatannya sudah kuno banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "Menurut si penjual misterius, ini tuh kamera bekas fotografer Fontaine yang pernah sohor banget sekian puluh tahun lalu. Namanya Tuan Pierre Leblanc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000107,
					"content": "Konon, semua foto yang dia ambil dengan kamera ini populer banget. Foto-fotonya bahkan sampai dibikin jadi berita utama \"The Steambird\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000108,
					"content": "#Kalau {NICKNAME} juga pakai kamera yang hebat seperti ini, mungkin kamu juga bisa jadi seniman terkenal! Lalu nanti bisa dijual dengan harga tinggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000109,
					"content": "Kamera ini ... tidak murah, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "Hehehe, aman kok! Paimon juga punya \"dana darurat\" tersembunyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000111,
					"content": "#Asal {NICKNAME} suka, Paimon sih enggak perlu mikirin Mora-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000116,
					"content": "Terima kasih, Paimon. Aku sangat suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "Baguslah kalau suka! Kita baru saja sampai di bangsa baru, pasti ada banyak hal menarik di sini, ayo kita kumpulin semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000119,
					"content": "Paimon juga sudah siapkan album foto baru buat kamu. Paimon baik banget kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000120,
					"content": "Baiklah, ayo kita jelajahi tempat-tempat yang menarik! Berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000117,
					"content": "Aku akan berusaha untuk ambil gambar yang bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "Paimon enggak ditipu sama pedagang licik, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "Tenang saja. Buat pastiin semuanya aman, Paimon sudah minta seorang teknisi yang sangat bisa diandalkan buat ngecek! Ini adalah model yang digunakan oleh Master Leblanc, enggak diragukan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000114,
					"content": "Selain itu, waktu teknisi itu buka, dia ketemu ukiran kecil dengan inisial Leblanc! Ini sih bukti kuat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000115,
					"content": "Hehe, kalau sebagai pemandumu, Paimon tentu paling bisa diandalkan. Paimon enggak bakal pernah gagal di saat-saat yang penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000104,
					"content": "Paimon mau buka toko barang antik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "Bukan dong! Ini hadiah kejutan yang Paimon udah siapin khusus buatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}