						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Jadi memang ada hubungannya dengan Abyss Order. Dan para Hilichurl yang menyembah ini agak mengingatkanku pada Grand Thief ....)",
					"roleType": "TALK_ROLE_PLAYER",
