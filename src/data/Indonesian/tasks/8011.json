			"dialogs": [
				{
					"id": 80110401,
					"content": "Siapa itu tadi? Dia itu ... dia itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Menakutkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "... Dia begitu sempurna, luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Dia memiliki aura yang menakjubkan, kekuatan yang berbahaya namun indah ... Benar-benar memesona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Tapi kamu tetap saja mampu mengalahkannya. Kekuatanmu lebih hebat dari yang aku bayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Seleramu unik juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Ayo kita lanjut jalan lagi. Aku jadi semakin penasaran ... dan lebih bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "Aku cuma lebih berpengalaman dalam pertempuran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Aku pernah melihat wajah yang serupa sebelumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
