					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Sungguh tempat yang menyeramkan ... Apa tempat ini selalu ada? Aku bersumpah aku tidak pernah menyadarinya sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Lihat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Hah? Sepertinya mereka sedang ... menyembah. Kadang berjalan, kadang bersujud ... Terus kelihatannya sangat khusyuk sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Aku tidak pernah melihat hal seperti ini sepanjang hidupku. Apa yang sebenarnya disembunyikan tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Hanya ada satu cara untuk mengetahuinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(Udara di sini, dan pemandangan menyeramkan ini ... aku mengenalinya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "Apa yang sedang dilakukan para Hilichurl itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
