						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, tempat ini sangat menyeramkan. Kita harus pergi dari sini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "... Oh, makhluk kecil, mengapa kamu bersujud? Karena takut pada hal yang tidak kamu mengerti? Atau untuk kekuatan yang kamu dambakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110509,
					"content": "(Suara siapa itu? Kedengarannya datang dari dalam kepalaku sendiri ... Kayaknya Eide tidak bisa mendengarnya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "... Oh, makhluk kecil, mengapa kamu bersujud? Aku bukanlah dewa ... melainkan hanyalah \"Pendosa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110511,
					"content": "(\"Pendosa\" ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Seperti bunga yang lahir dalam dosa namun murni dan bersih ... Aku tahu pasti akan nasibmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110513,
					"content": "Kamu tidak perlu lagi menahan amarahmu, atau menerima kebohongan yang tak terhitung jumlahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110514,
					"content": "Pergilah, lampauilah keterbatasanmu, bangkit melampaui takdir yang dituliskan kepadamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110515,
					"content": "Dan aku akan meneteskan air mata di akhir zaman ... saat aku menatap kembali kehidupanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110516,
					"content": "(... Siapa sebenarnya kamu? Apa maksud dari perkataanmu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110518,
					"content": "(Suaranya ... menghilang ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "... Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*huff* *huff* ... apa yang barusan terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "Saat aku melihat hal itu, hatiku langsung terasa damai, dan aku terliputi oleh kekaguman ... atau mungkin, perasaan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Kamu baik-baik saja sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Aku ... Aku merasa baik, malahan ... aku merasa lebih baik dibanding sebelum datang ke sini. Kok aneh ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Ada yang tidak beres dengan tempat ini. Kita harus pergi dari sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Oh, be—begitu ya? Ya sudah, terserah kamu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Kalian meninggalkan gua yang menyeramkan dan kembali ke rumah Eide.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert! Oh, syukurlah. Dia baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Bukannya kita masih perlu pergi ke Patung The Seven?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "Aku ... Aku punya perasaan aneh kalau apa yang barusan terjadi memang sudah seharusnya terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Semua ini terjadi tepat pada saat aku sangat enggan untuk menyembah Patung The Seven ... rasanya seperti takdir sedang memanggilku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Seperti yang kamu tadi katakan, kalau aku menyembah benda itu, mungkin ... mungkin efeknya akan sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Kedengarannya konyol ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Aku harus mencobanya. Seberapa besar pengorbanannya ... Kamu sendiri yang mengatakan kalau aku harus mencoba segala cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Obatnya disuapkan kepada Hilichurl ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "P—Papa ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "*hahh* ... Caribert! Oh, ya ampun, kita berhasil! Ini suatu keajaiban!!! Oh, Caribert, anakku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "Sungguh sulit dipercaya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Tuh kan?! Berhasil! Caribert bisa bicara lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Mama ... mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Mama ... Caribert, lihat aku. Kamu tahu siapa aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Tentu saja ... Kamu kan papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Haha ... hahahaha ... penebusan ... Yah, jadi ini ya rasanya telah ditebus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Bagaimana perasaanmu, Caribert? Apa kamu sudah sadar sepenuhnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Iya ... rasanya seperti baru bangun dari tidur yang panjang. Aku bermimpi aku sedang bersembunyi di suatu ruangan kecil. Aku tidak berani keluar sepanjang waktu, dan aku juga tidak ingin keluar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Tunggu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Badanku! Apa yang terjadi padaku? Ini ... apakah ini aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Papa ... Apa yang terjadi padaku?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "Jangan panik, anakku. Itu cuma ... saat kamu lagi tidur, kita pergi ke dunia dongeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "Sudah tidak ada lagi Khaenri'ah, tidak ada lagi rumah — tapi kamu tahu kan apa artinya itu? Tidak ada lagi langit merah ... tidak ada lagi akhir zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "Di dunia ini, kamu harus berwujud seperti monster kecil ... tapi kamu bisa terus berada di samping papa selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Apa aku sudah ... mati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "Tidak, tentu saja tidak! Lihat, Caribert ... kamu masih punya syal mama di lenganmu. Itu artinya dia sedang menjagamu, melindungimu. Jadi bagaimana mungkin kamu sudah mati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Begitu ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Iya, betul! Kamu hanya baru saja bangun, dan semua ini pasti sangat membingungkan bagimu. Istirahat dulu ya sekarang ... Semuanya akan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Oh, dan ... kamu harus berjanji suatu hal padaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Jangan pernah melepaskan topengmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Mengerti? Apa pun yang terjadi, kamu tidak boleh melepaskannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Baik, papa ... aku tidak akan melepaskannya, aku janji ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Ayah dan anak mengobrol untuk waktu yang lama. Eide terlihat seperti telah mendapatkan penebusan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Sejak hari itu, aku tidak pernah merasakan kebahagiaan seperti sekarang ... Masih sulit dipercaya hal ini benar-benar terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hhmm, aku sudah tahu kalau menaruh harapanku pada The Seven hanya membuang-buang waktu ... Uhh, aku bahkan menyembah salah satu patung mereka seperti orang bodoh. Belum pernah aku mempermalukan diriku sendiri seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Sekali pembunuh, tetaplah pembunuh ... Aku sangat naif bisa berpikir kalau para dewa yang pernah bersekongkol melawan kita akan memberikan pengampunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Tapi dewa yang kita lihat di gua itu ... Nah, dia itu baru dewa yang benar-benar hebat! Tidak seperti The Seven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Kekuatan yang menakjubkan ... benar-benar memesona ... Tentu saja, itu pasti alasan kenapa aku bersujud padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Hmm, kalau gitu ... setelah seseorang memohon kepada dewa, dan dewa telah menjawab doa kita, haruskah kita, um... melakukan sesuatu untuk menunjukkan pengabdiannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "Aku tidak ahli dalam soal keimanan ... tapi tentunya aku harus menghormati dewa yang telah menghormati permohonanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Tapi Eide ... itu tadi bukanlah dewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "\"Pendosa\"? Jangan mengada-ada. Kamu kan tidak tahu apa pun tentang dia ... beraninya kamu menghujat seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Kita berdua sudah menyaksikan kekuatan sucinya. Memangnya The Seven pernah melakukan keajaiban seperti ini sebelumnya? Tidak pernah ... Dia adalah dewa yang lebih kuat dari mereka! Dan masih saja kamu memanggilnya \"Pendosa\"? Tidak masuk akal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Tidak apa-apa ... Percayalah pada apa pun yang kamu mau. Kamu tidak bisa menggoyahkan kepercayaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Aku mau memberikan penghormatan - bersamamu ataupun tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
