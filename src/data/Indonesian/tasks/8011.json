						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "Apa itu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Terikat oleh rantai, melayang di udara, memancarkan aura menyeramkan ... Tidak salah lagi. Ini persis seperti Patung Ternoda!)",
					"roleType": "TALK_ROLE_PLAYER",
