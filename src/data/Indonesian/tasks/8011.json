			"dialogs": [
				{
					"id": 80110301,
					"content": "Berhenti, wahai manusia. Takdir tidak mengizinkanmu untuk masuk ke dalam tempat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Fortune Lector"
				},
				{
					"id": 80110302,
					"content": "(Abyss Herald? Bukan, dia kelihatannya tidak seperti seseorang dari Abyss Order ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Hmm, kamu masih bersikeras dan tidak mau pergi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Fortune Lector"
				},
				{
					"id": 80110304,
					"content": "... Baiklah, kalau begitu aku akan memberimu ujian takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fortune Lector"
				}
			]
		},
