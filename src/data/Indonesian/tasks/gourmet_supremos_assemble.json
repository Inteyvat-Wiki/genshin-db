			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "Begini... lalu begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "Apa sudah selesai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Sedikit lagi... biar kulapisi dulu, lalu kugoreng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "\"Sakura Tempura\" selesai! Ayo cepat cicipi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "E-enak sekali, hanya saja agak... agak panas... aduh duh duh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong, di buku tertulis untuk makanan seperti \"Tempura\" ini, harusnya disajikan bersama dengan saus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "Saus? Kali ini aku tidak menyiapkannya, lain kali akan lebih kuperhatikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "Pengembara, terimalah \"Sakura Tempura\" ini. terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "Aku juga sudah menuliskan resep \"Sakura Tempura\" ini untukmu, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "Kalau ada kesempatan, kamu bisa coba membuatnya sendiri, memasak itu sesungguhnya menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "Jangan sungkan-sungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "Kami akan tinggal di Inazuma sementara waktu, jadi kurasa kita akan pergi ke <color=#00E1FFFF>Kannazuka</color> nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "Kata Julie dia ingin pergi melihat pohon Sacred Sakura di Kuil Agung Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "Konon, semua \"Sakura Bloom\" di pulau ini berguguran dari pohon tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "Sebesar apa pohonnya, bisa menggugurkan daun sebanyak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "Pergilah ke sana kalau kamu tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "Sekali lagi terima kasih atas bantuanmu, Pengembara. Aku mau makan dulu, sudah lapar sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "Kalian mau ke mana setelah ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
