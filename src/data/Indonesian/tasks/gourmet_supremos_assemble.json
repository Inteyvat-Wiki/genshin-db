					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Baiklah. Pertama carilah benda bernama Thunder Sakura Bough di sekitar sini, lalu sentuh dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Setelahnya, akan ada semacam benda bernama \"Electrogranum\" yang melekat di tubuhmu, agar kamu bisa masuk melewati penghalangnya.",
					"roleType": "TALK_ROLE_NPC",
