			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, apa benar-benar tidak ada cara lain lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "Hanya cara itu yang tertulis di buku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Huh... Kalau saja cuma monster yang menghalanginya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Apa ini \"Sakura Bloom\" yang kalian mau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Oh! Tepat sekali, inilah \"Sakura Bloom\" yang kami cari, berkilauan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Baguslah! Akhirnya bisa masak makanan enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Tunggu, kamu berhasil masuk ke dalam? Apakah kamu menggunakan cara yang kami sebutkan tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Apa bisa beri tahu aku di mana kamu menemukan Thunder Sakura Bough itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "Setelah menyentuh Thunder Sakura Bough, kenapa Electrogranum itu bisa melekat di tubuhmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Maaf, aku catat dulu... Baiklah, setelah \"Electrogranum\" melekat di tubuhmu, apa yang kamu rasakan? Terus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "Parvaneh, tunggu sebentar, Pengembara ini baru saja menolong kita, tunda dulu penelitianmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "Pengembara, terima kasih banyak atas bantuanmu, kami pasti akan berikan imbalan yang sudah kami janjikan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Tapi sebelumnya, mohon tunggu sebentar. Akan kubuatkan masakan lezat dari \"Sakura Bloom\" yang kamu ambil tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "Dari dulu aku sudah mendengar makanan khas Inazuma yang bernama \"Sakura Tempura\", akhirnya hari ini punya kesempatan membuatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Biar kusiapkan dulu, tidak akan lama kok, kembali temui aku lagi nanti ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
