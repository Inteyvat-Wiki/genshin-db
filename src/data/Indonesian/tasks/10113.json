					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Stanley... beri tahu aku, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Kenapa dia terus menyebut namanya sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "Dia sedang menyembunyikan sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Apakah ada orang lain bernama Stanley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "*Hiks* Oh... Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "Aku yang seharusnya mati di Mare Jivari hari itu... Kenapa arwahmu tidak datang untuk menghentikanku menggunakan namamu? Kenapa, Stanley, kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "Kalau saja kamu tidak melindungi pemula seperti aku, kamu tidak akan perlu mati di ujung dunia tanpa angin itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "Kamu seorang petualang veteran yang ditakdirkan menjadi legenda suatu hari nanti... tapi sekarang itu tidak akan terjadi, dan itu semua karena aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Um... apa yang sedang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "...Menurutku, teman kita ini benar-benar pernah menginjak Mare Jivari. Dan tragedi yang dia ceritakan juga benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "Hanya saja, teman yang bersama dia hari itu, adalah petualang veteran bernama Stanley, bukan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "Stanley yang asli adalah Stanley yang meninggal untuk menyelamatkan \"Stanley\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "Jadi... satu-satunya alasan Stanley yang ini dipanggil Stanley adalah karena dia mengambil nama Stanley asli yang meninggal itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "Sepertinya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley... aku hidup dengan takut selama bertahun-tahun... takut semua orang akan melupakanmu... karena itu aku menceritakan kisah petualanganmu kapan pun dan di mana pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Aku ingin Mondstadt mengingatmu, Stanley yang mencapai jantung Mare Jivari... dia adalah petualang terhebat yang pernah ada, dia masih hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley tidak akan pernah mati, karena aku adalah Stanley! ...Karena... karena aku Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "Maaf, Stanley... aku pun sudah tua... sudah tua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "Haaah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Seberapa lama lagi kalian ingin menguping?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Gawat, ketahuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "Apakah ada orang lain bernama Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Mana mungkin, aku saja tidak pernah dengar tentang orang kedua bernama Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
