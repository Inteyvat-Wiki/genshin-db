			"dialogs": [
				{
					"id": 101130211,
					"content": "Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "Setelah bertahun-tahun lamanya, bukan rekannya lagi yang menahan dirinya.",
