			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "\"Bicara tentang Grand Bazaar, tentunya jangan sampai melewatkan Zubayr Theater.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961502,
					"content": "\"Jangan lewatkan pertunjukan tari Nona Nilou selama di Zubayr Theater!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961503,
					"content": "\"Belum lengkap rasanya kalau datang ke Sumeru tanpa melihat pertunjukan Tarian Sabzeruz oleh Nona Nilou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
