				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Kami melayani jual beli luar negeri dan memiliki kerja sama jangka panjang dengan armada kuat seperti \"Crux Fleet\" untuk mengantarkan barang-barang Anda dengan aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961202,
					"content": "Empat rute baru telah dibuka pada musim panas ini untuk pengiriman komoditas sutera, rempah-rempah, dan biji tambang. Kapal baru kami punya kapasitas besar. Kami menantikan kerja sama dari Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961203,
					"content": "Jika Anda ingin mengontrak keseluruhan rute, harap hubungi Farzaneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
