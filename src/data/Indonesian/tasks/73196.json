			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "Ingin membeli: \"Kazeni's Lost Golden Statues\", harga bisa nego. Hubungi pemilik toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960802,
					"content": "Jika ada informasi terkait, kunjungi Toko Menakeri dan hubungi Khalid. Ada imbalan atas jasa yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319609,
