			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Kami menjual berbagai jenis kebutuhan sehari-hari. Kualitas setiap barang diperiksa sendiri oleh pemilik, kualitas terjamin demi kepuasan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960702,
					"content": "\"Ayah, bisa pinjami aku sedikit Mora lagi? Aku dengar harga kurma akan melambung tinggi. Kali ini aku pasti bisa mendapatkan uang banyak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
