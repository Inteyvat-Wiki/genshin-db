					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Karpet buatan tangan, sebuah mahakarya seni Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960502,
					"content": "Tiap penduduk Sumeru harus memiliki satu karpet sepanjang hidupnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960503,
					"content": "Karpet ada harganya, tapi seni tidak ternilai harganya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
				7319606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
