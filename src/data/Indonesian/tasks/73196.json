			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "Atas dasar keluhan konsumen yang berkenaan dengan tuduhan pencurian kain, Toko Pewarna Pakaian Ani ditutup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961302,
					"content": "Toko Pewarna Pakaian Ain sudah dikosongkan. Barang milik pelapor sedang dalam usaha pencarian.",
					"roleType": "TALK_ROLE_NPC",
