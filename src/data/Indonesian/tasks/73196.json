			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Toko Pewarna Pakaian Ani! Teknik istimewa untuk menambah warna baru pada pakaian Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961102,
					"content": "\"Kain yang aku kirim bulan lalu untuk diwarnai apakah sudah bisa diambil?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961103,
					"content": "\"Maaf sekali! Kemarin istriku melahirkan, tidak ada waktu untuk mengerjakannya. Tolong datang lagi besok, aku jamin pesanannya pasti sudah bisa diambil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961104,
					"content": "\"Ini sudah tiga bulan, tolong kembalikan saja kainnya. Aku tidak mau mewarnainya lagi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961105,
					"content": "\"Mohon maaf! Kain Anda tadinya sudah selesai diwarnai, tapi dicuri orang waktu dikeringkan. Kalau Anda menginginkannya kembali, kejar saja pencurinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
