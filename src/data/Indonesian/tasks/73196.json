			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961701,
					"content": "\"Semuanya pasti pernah dengar nama Lord Sangemah Bay, jadi aku tidak perlu memperkenalkannya lagi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961702,
					"content": "\"Omong-omong, karpet baru sudah datang. Itu bukan permadani terbang! Tapi barangnya lebih bagus daripada milik Sulaykha! Cepat beli sekarang kalau memang mau! Cara belinya masih seperti yang dulu. Hehe!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961703,
					"content": "\"Dori, kamu keterlaluan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
