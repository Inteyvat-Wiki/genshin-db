			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "\"Aku pernah punya harta yang tidak ada habisnya. Tapi hidup berfoya-foya pun tidak bisa membuatku tenang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961002,
					"content": "\"Sesudah aku melakukan perjalanan ini, tidak sepeser Mora pun yang tersisa di sakuku. Tapi, aku malah merasakan kedamaian.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961003,
					"content": "\"Kalau kamu mau mendengar ceritaku, datanglah ke toko sayurku. Tentu saja aku senang sekali kalau kamu sekalian belanja sayur di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319611,
