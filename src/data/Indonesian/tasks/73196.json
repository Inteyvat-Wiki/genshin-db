			},
			"dialogs": [
				{
					"id": 731960101,
					"content": "Ini adalah Papan Pengumuman Bursa Kalimi yang diperuntukkan bagi pedagang domestik dan internasional untuk mempublikasikan informasi bisnis. Dilarang memposting informasi lainnya yang tidak berkaitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Bursa ini mengusahakan segala upaya untuk memastikan keakuratan dan keandalan semua informasi yang diberikan, tapi tidak menjamin keakuratan dan keutuhan dalam semua bentuk informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960202,
					"content": "Seluruh klien tidak diperbolehkan menuntut kerugian yang ditimbulkan oleh penggunaan seluruh atau sebagian informasi pasar seperti yang dipublikasikan pada Papan Pengumuman ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Apakah kamu pernah mendengar teknik melayang? Pernahkah kamu melihat seseorang yang sedang terbang? Mau tahu rahasia di balik Sumpter Beast terbang? Kalau begitu jangan ketinggalan penampilan perdana Fontaine Flyers di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960302,
					"content": "Selamat datang, petunjukannya sudah dimulai! Jangan ketinggalan pertunjukan seni yang unik ini! Cukup lima Mora saja untuk membeli tiketnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960303,
					"content": "Berdasarkan laporan dari masyarakat, pertunjukan ini belum mendapat persetujuan dari Akademiya dan tidak diperkenankan tampil. Iklan ini akan segera dihapus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Kantor bank kami akan segera buka di Sumeru! Calon pelanggan kami yang terhormat dimohon untuk menantikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960402,
					"content": "Jika memerlukan layanan bisnis silakan hubungi Viktor untuk pengalihan layanan ke cabang Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960403,
					"content": "Untuk informasi cara pengajuan pinjaman, silakan hubungi agen perkreditan Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319605",
							"2"
						],
						"stepId": 7319605,
