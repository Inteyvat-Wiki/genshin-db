			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "Kualitas unggul dengan harga terjangkau. Jut's Spices adalah pilihan terbaik untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960602,
					"content": "Beli sekarang dan dapatkan hadiah gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
