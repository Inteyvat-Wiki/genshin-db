			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "Kejarlah kebahagiaan dalam hidup! Beranjaklah dari kampung halaman dan jelajahilah dunia! Bergabunglah dengan \"Adventurers' Guilt\" sekarang, cuma butuh lima Mora saja untuk daftar jadi anggota dalam satu bulan pertama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961602,
					"content": "Pengetahuan sejati hanya bisa diperoleh dari praktik kehidupan nyata. Kehilangan nyawa dalam perjalanan yang sulit jauh lebih bermakna daripada hanya menghabiskan hidup dengan bermalas-malasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961603,
					"content": "\"Lihat baik-baik! Ini adalah Adventurers' Guilt, bukan Adventurers' Guild.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961604,
					"content": "\"Apa?! Aku sudah bayar iuran anggota untuk setahun! Apa uangku bisa dikembalikan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
