			"dialogs": [
				{
					"id": 731961401,
					"content": "Tentang kepemilikan Kafe Puspa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961402,
					"content": "Pemilik asli toko sudah dipastikan hilang selama ekspedisi gurun pasir tiga tahun lalu. Berdasarkan peraturan yang ada, pengelolaan kafe akan dialihkan kepada Vahumana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731961403,
					"content": "Keputusan: Karena pihak penuntut menarik kembali keluhannya, kasus ini ditutup untuk jangka waktu yang tidak terbatas.",
					"roleType": "TALK_ROLE_NPC",
