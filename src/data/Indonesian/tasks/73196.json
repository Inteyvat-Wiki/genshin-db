			},
			"dialogs": [
				{
					"id": 731960901,
					"content": "Sate gurun asli! Dipanggang menggunakan resep rahasia Raja Deshret dan bumbu lokal asli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 731960902,
					"content": "Menyediakan makanan dan minuman yang dinikmati semua orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319610",
							"2"
						],
						"stepId": 7319610,
