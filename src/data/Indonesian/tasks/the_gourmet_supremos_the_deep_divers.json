					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Aku akan mulai membuat makanan yang bernama \"Onigiri\" ini, katanya tidak terlalu sulit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Oh, aku butuh waktu untuk membuatnya, tunggulah sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
