					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Ini sangat... sederhana... Aku ingin mencicipinya, tapi sepertinya aku tidak sanggup menghabiskannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Aku ingin mencicipinya asalkan rasanya enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "Ini untukmu, Pengembara. Aku juga mencatat cara membuat \"Onigiri\" untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Meskipun membuat \"Onigiri\" terlihat mudah, namun butuh keahlian untuk membuat Onigiri yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "*uhuk* ... Baiklah, cukup basa-basinya, aku juga ingin makan setelah sibuk seharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Hei! Parvaneh, bukannya kamu bilang tidak sanggup menghabiskannya? Sisakan sedikit untukku!",
					"roleType": "TALK_ROLE_NPC",
