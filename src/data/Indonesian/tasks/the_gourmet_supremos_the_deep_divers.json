				},
				{
					"id": 721700706,
					"content": "Apa yang kalian lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "Eh? Aku tidak menyangka bisa bertemu denganmu di sini, kita pasti berjodoh, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Tadi kita baru saja pergi memetik beberapa Seagrass Segar untuk membuat sebuah hidangan bernama \"Onigiri\". Tapi jalan ke sana susah sekali dilewati, sepatuku sampai basah kuyup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "Lupakan dulu itu. Pengembara, bisakah kamu bantu kami mencari Seagrass?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Area di bawah sepertinya baru terendam banjir, dan meskipun airnya sudah tidak ada, kita tidak tahu kapan banjirnya akan datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Jadi kurasa, lebih baik kita mengumpulkan Seagrass lagi secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "Mohon bantuanmu ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Kalau kamu sudah mengumpulkan Seagrass-nya, tolong berikan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Kenapa tidak memetiknya di pesisir pantai saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Seagrass di sana tidak terlalu segar, tidak enak untuk dimasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "Kualitas Seagrass di sini harusnya jauh lebih bagus. Yah bagaimanapun juga, kita butuh bantuanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Kalau kamu sudah mengumpulkan Seagrass-nya, tolong berikan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
