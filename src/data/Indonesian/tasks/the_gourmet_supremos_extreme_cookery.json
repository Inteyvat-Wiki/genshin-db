					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "Kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Maaf sedikit tiba-tiba, tapi hari ini aku ingin minta bantuan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "Setelah diberi pekerjaan oleh Xudong, aku selalu pergi bersama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "Demi membalas budi pada Xudong karena telah menerimaku, aku ingin membuatkannya sesuatu sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "Tapi ketimbang bela diri, Xudong lebih suka kuliner, jadi aku ingin membuatkannya sebuah makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "Tadinya aku sudah menemukan lokasi 2 bahan yang kubutuhkan, dan bermaksud menunggu mereka matang baru kuambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "Tapi sekarang kedua lokasi itu dikuasai oleh monster, dan mereka sudah mengambil bahan-bahan itu lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "Yang paling penting dari hidangan yang akan kumasak adalah bahan yang segar. Tadinya aku berencana ambil satu dulu, baru ambil yang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "Tapi sekarang monster di kedua tempat itu sudah mengambil bahannya. Kalau mau masak hidangan itu, aku harus merebut kembali bahannya secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "Tapi aku... tidak bisa membelah diri. Aku bisa saja menghadapi monster di satu lokasi, tapi aku khawatir monster di lokasi yang satu lagi sudah menghabiskan bahannya terlebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "Jadi, aku ingin minta tolong padamu untuk membantuku melawan monster itu bersama dan merebut kembali bahan-bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Terima kasih banyak. Aku tidak tahu harus berkata apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Uhh... Tidak ada gunanya berbicara di sini. Mari ikut aku ke lokasinya, baru kita diskusikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "Bagikan sedikit untukku kalau sudah dimasak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "Tentu saja. Aku akan menyediakan satu porsi untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "Tidak perlu sungkan begitu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Aku ingin meminta bantuan darimu jadi sudah sewajarnya bertanya dengan sopan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
