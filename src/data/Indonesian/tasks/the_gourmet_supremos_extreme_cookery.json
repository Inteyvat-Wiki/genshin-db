			"dialogs": [
				{
					"id": 220300601,
					"content": "Terima kasih banyak! Bahan-bahan ini masih bisa digunakan, tapi tidak bisa ditunda-tunda lagi... Aku harus memasaknya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "Selesai! Fiuh... hidangan ini masih bisa disajikan berkatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Kamu benar-benar seorang perfeksionis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Tentu saja. Mau itu merangkai bunga, menyeduh teh, memasak hidangan, atau mengayunkan pedang, kalau tidak maksimal, maka tidak ada maknanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Mengejar \"kesempurnaan\" adalah tujuan hidupku. Tapi... Xudong sepertinya tidak sependapat denganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Xudong pernah bilang padaku, ada sebuah istilah Liyue, namanya \"Jalan Tengah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Artinya, baik itu dalam berperilaku maupun mengerjakan sesuatu, berusahalah untuk netral, tidak memihak, adil, dan harmonis, jangan mengejar hal-hal ekstrem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300608,
					"content": "Aku kurang mengerti maksud dari perkataan Xudong ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300609,
					"content": "Tapi kupikir... Xudong mungkin memiliki pemikiran seperti itu karena dia sudah melalui begitu banyak suka dan duka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300612,
					"content": "Bahannya juga sudah kudapatkan, hidangan juga sudah dimasak. Kalau begitu, aku tidak akan menghabiskan waktumu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300613,
					"content": "Terimalah ini. Sisanya akan kubawakan untuk Xudong, dia seharusnya mau mencicipinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300610,
					"content": "Monster-monster itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "Sudah kubereskan. Tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
