			"dialogs": [
				{
					"id": 220300201,
					"content": "Ini dia tempatnya. Monster di kedua lokasi sama-sama memasang perkemahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Aku sudah menyelidiki diam-diam. Musuh di perkemahan sebelah kiri lebih lemah, tapi jumlah mereka banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Musuh di perkemahan sebelah kanan jumlahnya lebih sedikit, tapi masing-masing lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Tolong bereskan salah satunya, dan akan kubereskan yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
