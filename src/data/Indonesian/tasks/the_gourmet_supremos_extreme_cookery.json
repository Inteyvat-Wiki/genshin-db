					"content": "Aku ke kanan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Baik, kalau begitu aku ke sebelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Apa kamu bisa menghadapi mereka sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Tidak perlu khawatir, cuma beberapa ekor monster saja. Kalau bukan karena takut bahan-bahannya dihabiskan, aku sendiri bisa membereskan kedua-duanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "Baiklah, kalau sudah beres dan mendapatkan bahannya, cari aku di perkemahan yang satunya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Ayo kita bergerak sekarang. Kalau sampai bahannya rusak, hidangannya tidak akan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
