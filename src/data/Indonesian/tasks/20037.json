					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "...Ah, aku benar-benar ingin segera pulang ke Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "Ah, Pengembara! Bisakah kamu membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Seperti yang kamu lihat, aku Knight dari Knights of Favonius dan sedang berpatroli di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Aku mengatakan pada pacarku bahwa aku akan mengirim surat padanya, untuk memberi kabar bahwa aku sehat dan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Tapi aku terlalu sibuk jadi lupa, hahaha... dapatkah kamu membantuku untuk mengirim <color=#00E1FFFF>surat</color> ini kepadanya? Namanya <color=#00E1FFFF>Glory</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Tunggu, Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Gadis buta yang mengumpulkan dandelion seed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Ah! Kamu pasti Godwin, Glory pernah menyebut namamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Eh, bagaimana kamu bisa kenal dengan Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Kami pernah membantunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Dia meminta bantuan pada kalian? Apa ada hal berbahaya yang harus dilakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Dia hanya meminta kami untuk mengumpulkan beberapa dandelion seed. Dia bilang kalau melepaskan mereka bersama dengan angin, maka mereka akan menyampaikan isi hatinya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Ah, dandelion seed... Kedengarannya memang seperti Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Bukannya kamu sudah lama pergi meninggalkan Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Rencana awalnya memang begitu. Tapi... ah sudahlah biar kukatakan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Apa kamu pernah mendengar saat Grand Master meninggalkan Mondstadt dan membawa empat dari setiap lima Knight bersamanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Benar, aku adalah salah satu yang ditugaskan untuk ekspedisi itu. Tapi sebelum pergi, aku kehilangan benda yang diberikan oleh Glory. Saat aku sudah menemukannya, mereka sudah pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Aku belum menemukan cara untuk bergabung kembali bersama mereka, jadi sekarang aku hanya bisa berkeliaran di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Aku juga malu untuk kembali ke Mondstadt. Apa yang akan Knight lain pikirkan tentangku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Lalu Glory, aku berjanji padanya akan mengirimkan surat dan hadiah dari seluruh penjuru dunia. Aku berjanji akan membawakan \"seluruh dunia\" kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Jika dia tahu aku bahkan belum keluar dari Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Jadi kamu tidak ingin kehilangan muka ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Tolong, bisakah kamu membantuku mengirimkan <color=#00E1FFFF>surat</color> ini kepada <color=#00E1FFFF>Glory</color>? Dia pasti sangat khawatir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Terima kasih banyak, Pengembara! Tolong rahasiakan semua yang kukatakan padamu tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Kamu bisa menggunakan dandelion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Banyak hal yang ingin kukatakan pada Glory, bagaimana bisa dandelion membawanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Terima kasih sudah bersedia untuk mengantar suratnya. Ingat, tolong rahasikan hal ini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
