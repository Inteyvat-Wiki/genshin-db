			"dialogs": [
				{
					"id": 200370501,
					"content": "Apa suratnya sudah diberikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370502,
					"content": "Glory menyampaikan salamnya untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "Fuhh... Sudah lama aku tidak menghubunginya, untung dia tidak marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370504,
					"content": "Kamu hanya berkeliaran di sekitar sini, bagaimana kamu tahu tentang Pelabuhan Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370505,
					"content": "Oh, aku mendengar cerita-cerita ini dari Grand Master, dia telah mengunjungi banyak tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370506,
					"content": "Baiklah, terima kasih karena telah membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370507,
					"content": "Terimalah Dandelion Seed ini, aku sendiri yang mengumpulkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370508,
					"content": "Lain kali jika Glory memintamu untuk membawakan dandelion seed lagi, aku harap kalian mau membantunya. Maaf merepotkan kalian.",
					"roleType": "TALK_ROLE_NPC",
