				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Biar kulihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "Hilang kan... Visionnya menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "Huh! Ada yang mencurinya? Siapa yang berani-beraninya melakukan itu di siang bolong begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "Kita tidak tahu kapan tepatnya Vision itu diambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "Hah! Tidak kusangka di sini ada orang yang berani melawan Kapten Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "Jangan khawatir, bahkan tipuan yang paling lihai pun tidak akan luput dari mata alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hmm... Pelakunya belum lama beraksi. Mereka pasti belum jauh dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "Vision itu adalah hadiah yang kutawarkan, dan aku yang bertanggung jawab untuk menjaganya. Aku akan mendapatkannya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "Baiklah, kalau kamu bersikeras. Kuserahkan urusan ini padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Aku akan tinggal di sini untuk menjelasan situasinya pada para penonton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#{NICKNAME}, mohon ikut denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Sepertinya tidak ada pilihan lain lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Hmm, tapi kita kan ada di pulau... Bisa lari ke mana dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Ikut aku. Aku bisa merasakan angin segera datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "Lawanku juga tidak muncul sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
