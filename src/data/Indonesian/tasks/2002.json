			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei the Flyer",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Kalian berhasil mengejarku... Kok bisa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020902,
					"content": "Aku bahkan sudah menyiapkan perahu untuk kabur dengan cepat, bisa-bisanya kalian mengejarku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020903,
					"content": "Tidak ada perahu yang bisa menyamai kecepatan angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Angin? Ngomong apa sih? Oh, benar juga... Visionmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020905,
					"content": "Sial, kalau saja aku punya Vision... atau kalau saja aku bisa mengaktifkan Vision ini, kalian tidak mungkin bisa mengejarku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020906,
					"content": "Tidak ada hubungannya sama sekali dengan Vision. Kamu mungkin pandai menghilang dari kerumunan, tapi sepertinya kamu tidak tahu cara menyembunyikan dirimu dari mata alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Terlebih lagi, rute kaburmu ini punya cela yang terlalu banyak untuk disebutkan satu per satu. Kemudian, aku bisa mendengar tawa sombongmu yang terbawa angin saat pengejaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "Dengan kata lain, 3 kriteria dasar untuk menjadi pencuri ulung: cepat, tak terlihat, dan gaya — tidak ada satu pun yang terpenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Kamu... Kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020910,
					"content": "Tapi yang paling mengecewakan adalah kondisi Vision di tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Vision tidak menanggapi keinginan manusia tanpa pandang bulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Iya, iya! Aku mengaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020913,
					"content": "Aku sudah mengincar Vision itu dari dulu. Aku langsung mendaftar ke turnamen ini setelah tahu bahwa pesertanya lemah semua. Aku berhasil lolos ke babak final dan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020914,
					"content": "Aha, jadi kamu ya lawan kami di babak final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "Awalnya aku berencana memenangkan turnamen ini murni dengan kemampuanku sendiri, tapi tiba-tiba kalian muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020916,
					"content": "Setelah menonton pertandingan semi-final kalian, aku tahu kalau aku pasti kalah. Tapi aku tidak mau menyerahkan Vision itu begitu saja setelah sejauh ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020917,
					"content": "Karena aku pasti kalah kalau bertanding melawanmu, aku memutuskan untuk menggunakan keahlianku saat perhatian semua orang sedang terpusat pada dirimu dan Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020918,
					"content": "Padahal aku yakin persiapan kaburku sudah matang... tapi kalian tetap bisa mengejarku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020919,
					"content": "Kamu sudah tidak bisa kabur lagi, menyerah saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Uh... Sialan... Andai saja, seharusnya semua berjalan lancar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020923,
					"content": "Aku tidak menjamin keselamatanmu kalau kamu masih melawan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Simpan saja ancaman kosongmu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020928,
					"content": "Baiklah... pegang janjimu! Lagi pula Vision ini tidak aktif saat kuambil, tidak ada gunanya juga buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020929,
					"content": "Tapi menurut hukum lautan, pencuri yang tertangkap harus dipatahkan tangannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Hah?! Kamu bercanda kan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020931,
					"content": "Ditambah lagi kamu mencuri hadiah utama turnamen, kamu tidak muncul di babak final, dan kamu mempermalukan nama baik Kapten dari Crux Fleet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Sepertinya kita harus mencap kata \"maling\" di jidatmu dengan besi panas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Woy, woy, tidak perlu sampai segitunya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Uh, tidak kusangka ternyata kamu kejam sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020935,
					"content": "Kalau kalian tidak bisa diajak bicara baik-baik, lebih baik kulawan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020921,
					"content": "Kembalikan Vision-nya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Setelah semua jerih payahku? Tidak akan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020925,
					"content": "Turuti saja kata-kata kami dan tidak akan ada yang terluka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "Be-benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei the Flyer"
				},
				{
					"id": 20020927,
					"content": "Kembalikan Vision-nya dan kami akan melepaskanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
