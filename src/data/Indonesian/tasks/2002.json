			"dialogs": [
				{
					"id": 20021201,
					"content": "Eh? Beidou sudah pergi? Apa dia balik ke kapalnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Tadi Kapten Beidou dipanggil oleh Nona Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Sepertinya Turnamen Crux Clash kali ini menjadi kacau sekali sampai menarik perhatian Nona Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "Kapten Beidou pergi ke Pelabuhan Liyue sambil bersungut-sungut dan mengatai \"Ningguang wanita menyebalkan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Haha, mereka berdua memang sering berselisih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Kapten Beidou juga kecewa karena tidak bisa menyaksikan pelantikan sang juara baru. Padahal dia sudah lama menanti-nantikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "Pelaku yang mencuri Vision itu adalah orang yang seharusnya melawan pahlawan ini di babak final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Pencuri itu tahu kalau dia tidak mungkin menang, maka dari itu dia menggunakan cara kotor dan mencuri hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Dengan demikian, Turnamen Crux Clash ini telah mencapai akhir yang jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "...Jadi itu yang sebenarnya terjadi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "Kalau begitu ceritanya, pencuri itu harus didiskualifikasi sesuai aturan... berarti pahlawan kita inilah juaranya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon yakin kita bakal menang sih, tapi bukan begini caranya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Tidak apalah, sesuai kata pepatah \"kehormatan itu diberikan, bukan dicari.\" Biar kusiapkan dulu medali kejuaraannya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "Jadi sekarang kita bisa ke Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Seharusnya begitu. Meski sekarang Kapten Beidou tidak ada di sini, dia pasti akan tahu tentang hal ini. Dia tidak akan ingkar janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Tapi perjalanan ke Inazuma amat berbahaya. Hujan dan badai akan selalu menemanimu sepanjang perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "Hujan dan angin yang tidak pernah berhenti itu juga merupakan wujud dari keinginan Raiden Shogun untuk menutup bangsanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Tunggu dulu, maksudmu dia bisa mengendalikan cuaca sesuai keinginannya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Jangan lupa kalau dia adalah salah satu dari The Seven. Kalau Morax dari Liyue bisa menciptakan Guyun Stone Forest dengan memanggil tombak-tombak batu, berarti tidak heran kalau Raiden Shogun bisa menciptakan badai abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "Tapi kalau kalian memang ingin pergi ke Inazuma, kita perlu waktu untuk mempersiapkan kapal Alcor yang akan membawamu. Kamu akan diberi tahu kalau sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Selagi menunggu, aku juga berencana untuk pergi berkeliling, menjelajahi daratan Liyue yang begitu luas. Dengan harapan bisa menemukan cara untuk mengaktifkan kembali Vision ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Paimon yakin pasti kamu bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Terima kasih. Semoga perjalanan kita lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Biar kuperingatkan lagi. Perjalananmu setelah melewati badai nanti, mungkin akan jadi yang perjalanan yang paling sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
