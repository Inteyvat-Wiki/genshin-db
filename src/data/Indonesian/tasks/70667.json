			"dialogs": [
				{
					"id": 706670201,
					"content": "Meong! (Kamu benar-benar hebat! Selamat, kamu sudah menyelesaikan Ujian Tantangan Ascension! Kamu sekarang adalah Pemain Ahli!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670202,
					"content": "(Kamu sekarang sudah bisa menantang lebih banyak pemain. Oh ya, meski mungkin kamu sudah pernah melakukannya, tapi aku ingatkan lagi kalau kamu diizinkan untuk mengundang pemain lain di Papan Undangan ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670203,
					"content": "Meong ... (Dengan begitu, siapa pun yang mau menerima tantanganmu bisa merobek undanganmu. Pertandingan duel tanpa tahu lebih dulu siapa lawanmu kadang-kadang menarik, kan? Bagaimana menurutmu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670204,
					"content": "(Soalnya, pertemuan untuk pertandingan duel juga termasuk kesempatan untuk main bareng.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680204,
					"content": "Meong! (Ah! Maaf, ngomongnya kejauhan. Yah, sebagai Pemain Ahli, kamu sekarang jadi punya hak untuk beli kartu-kartu cantik ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670205,
					"content": "#({NICKNAME}, jangan lupa kenapa kamu mulai bermain kartu ini pada awalnya, dan semoga kamu bisa merasakan kesenangan dan kebahagiaan di dalam dunia Genius Invokation TCG!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
