			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Hmm ... tempat ini lumayan cocok, kan? Aku biasanya ke sini untuk mencari udara segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "Pemandangannya bagus, udaranya pun segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Kalau kamu mau menanyakan sesuatu kepadaku, tanyakan saja di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Dulunya kamu juga rekan kerjanya Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Apakah Ryuuji yang memberitahumu? Ya, dulu Ryuuji dan aku memang pernah jadi rekan kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Aku tidak tahu apakah Ryuuji sudah pernah memberitahumu tentang apa yang terjadi di tahun itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Singkat cerita, karena betapa impulsifnya dia, Ryuuji jatuh ke dalam perangkap orang lain dan menjadi kambing hitam mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Sekalipun aku muncul untuk menjaminnya, hakim yang bertanggung jawab untuk kasus tersebut masih terus menyatakan dirinya bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Aku juga sudah meminta banyak orang untuk menyelidikinya, tapi hasilnya nihil atau mereka memperingatiku agar tidak melanjutkan penyelidikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Hehe, pada saat itu aku... bagaimana mengatakannya ya, karena dapat peringatan jadinya aku juga tidak menyelidikinya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "Kasus ini dan kasus penuduhan Ryuuji saat itu sama persis, sudah jadi rahasia umum, jadi tidak masalah kuceritakan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Berhubung semua sudah tahu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Justru karena setiap orang menyadari bahwa \"semua orang tahu\", makanya tidak ada yang berani menyelidikinya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Tapi untungnya ada seorang detektif yang \"tidak tahu apa-apa\" kebetulan melakukan apa yang dia lakukan dan menjadi tertarik dengan kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Berkat detektif itu, kebenaran tentang kasus itu bisa terungkap dan Ryuuji dibebaskan dari vonisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Kemudian Ryuuji meninggalkan Commission dan bekerja untuk detektif tersebut sejak saat itu. Ceritanya berakhir sampai di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Kenapa kamu memberi tahuku semua ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Siapa yang memintamu mengirimkan hadiah ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Alasan Ryuuji mengirimiku hadiah pasti karena \"perintah Ketua\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Dengan sifat Ryuuji, kalau Sango memerintahkannya untuk mengirim sebuah hadiah secara langsung, sekalipun aku tinggal di tengah lautan api, dia pasti akan tetap mengirimkan hadiah itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Kalau Ryuuji memintamu yang mengirimkan hadiahnya, tentunya juga pasti karena Sango yang menyuruhnya berbuat begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Jadi Sango mau aku tahu semua ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "Hahaha, reaksimu cepat juga. Dengan adanya kamu di sini, seolah Sango mau memberi tahuku kalau dia punya asisten baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Sepertinya dia masih memikirkan tentang apa yang terjadi waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Wajar saja, lagi pula... sampai saat ini dia belum menemukan orang yang merencanakan jebakan itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Oke, aku sudah memberitahumu semua yang kutahu. Jadi apakah kamu akan membantu Sango atau tidak, semua tergantung keputusanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Oh iya, waktu kamu kembali nanti, sampaikan terima kasihku pada Ryuuji untuk Sakura Mochi ini, aku memang paling suka ini dari dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Kenapa Ryuuji meninggalkan Commission?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Alasan dia meninggalkan Commission tentu saja karena pilihannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
			"completionStepIds": [
				2202006
			],
