			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amano",
					"Andou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "Eh? Pengembara? Ada apa datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Ini ada kiriman dari Ryuuji untuk kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Oh? Coba kulihat... Ini kan Sakura Mochi, Ryuuji memang anak yang pengertian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "Hei, Andou, kamu tidak perlu sewaspada itu. Meski pengembara ini orang asing, tapi dia kan sudah membantu kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Untung dia ingat apa yang kita suka. Setidaknya masa-masa kita bekerja sama tidak sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "Kalian pernah bekerja bersama Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "Eh? Dia tidak pernah bilang padamu ya? Sebelumnya kami memang pernah kerja bersama untuk beberapa waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Tapi entah kenapa dia tiba-tiba terlibat dalam sebuah kasus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Meski pada akhirnya Sango berhasil menangkap penjahat yang sebenarnya dan Ryuuji sudah tidak jadi tersangka. Tapi setelah itu Ryuuji meninggalkan Commission untuk bekerja pada Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Selain itu, aku juga tidak tahu apa-apa lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Baiklah, bicaranya cukup sampai sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "Benar juga. Tapi bersama Sango, pekerjaannya dia jadi jauh lebih enak daripada pekerjaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "Kalau bisa, aku pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "Kamu benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "Ehem! Sudah jangan banyak bicara lagi, terima kasih ya, Pengembara. Kami terima camilan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Ingat sampaikan salamku untuk Ryuuji dan Sango ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
