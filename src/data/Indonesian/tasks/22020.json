				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "Oh? Kamu adalah... pengembara berambut pirang itu. Amano pernah memberi tahuku tentangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Ada apa? Kamu butuh sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Ini ada kiriman dari Ryuuji untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Oh, ternyata Sakura Mochi, camilan ini tidak bisa dimakan sembarangan, harus cari tempat yang cocok untuk menikmatinya pelan-pelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, gantikan aku sebentar ya. Kalau ada yang mencariku, minta mereka menunggu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Tuan Owada, sekarang kan masih jam kerja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Hahaha, tidak apa-apa, aku hanya keluar untuk cari udara segar. Aku akan segera kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "Ugh... baiklah, tapi kamu harus cepat kembali, kalau para atasan tiba-tiba datang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Jangan khawatir, Commission baru saja menyelesaikan sebuah kasus. Mereka datang sekalipun, pastinya untuk memberi tahu kita sebuah kabar baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Kalau begitu kuserahkan padamu ya, Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "Pengembara, ayo pergi bersamaku, aku tahu tempat yang sangat cocok untuk menyantap camilan ini dengan santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
