			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "Terima kasih atas kerja kerasmu, Pengembara. Apakah kamu sudah mengirimkan semua hadiahnya ke mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Semua ini perintah dari Sango ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Ke-ketahuan ya? Maaf ya... memintamu untuk mengirimkan hadiah ini memang perintah dari Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Kata Ketua, kalau mau sepenuhnya memecahkan kasusku dulu dan menemukan dalang di balik semua ini, kamu adalah penolong yang sangat diperlukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Kasusnya masih belum benar-benar selesai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Tidak. Kata Ketua, waktu dia menemukan penjahatnya dulu, semuanya tampak terlalu... sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Setelah Ketua menyelidikinya, hampir semua petunjuk, motif, dan bukti mengalir dengan sendirinya ke tangan Ketua, semuanya mengarahkannya ke orang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Meski pada akhirnya Commission menetapkan orang itu sebagai pelakunya, Ketua selalu merasa kalau pelaku yang sebenarnya adalah orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Kurasa alasan dia mempekerjakanku di kantornya pasti agar dia punya kesempatan untuk menyelesaikan kasus itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Tapi memangnya ada yang bisa kubantu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Cara pikir Ketua... tidak pernah bisa kutebak. Tapi pernah sekali dia bilang padaku, mungkin karena dia selalu tinggal di Inazuma jadi pandangannya terhadap dunia menjadi sempit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Kalau ada orang berpandangan luas dan berjiwa bebas yang bersedia datang membantu, mungkin kami dapat membuat kemajuan yang signifikan untuk kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "Pengembara, mungkin Ketua merasa kalau kamulah orang yang bisa membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "Kalau begitu sama saja aku juga jadi \"detektif\" ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Tentu saja, selama kamu bersedia membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "Tapi bagaimanapun juga, kamu sudah banyak membantu Kantor Detektif kami, jadi terimalah imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Kata-kata ini juga ajaran dari Sango ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Tidak, semua kata-kata ini adalah buatanku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Sekali lagi, terima kasih ya atas bantuanmu. Kalau kamu bersedia, silakan sering-sering mampir ke Kantor Detektif kami, Ketua pasti... akan sangat senang melihatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Imbalan untuk kasus ini besar kan ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Kalau itu aku tidak tahu pasti, tapi... tentunya akan menjadi imbalan bisa membuatmu puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "Apakah ini kejahatan sempurna yang sering disebut-sebut Sango?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Ya. Kata Ketua, saat dia menemukan pelakunya waktu itu, semuanya... terlalu sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Setelah Ketua menyelidikinya, hampir semua petunjuk, motif, dan bukti mengalir dengan sendirinya ke tangan Ketua, semuanya mengarahkannya ke orang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Meski pada akhirnya Commission menetapkan orang itu sebagai pelakunya, Ketua selalu merasa kalau pelaku yang sebenarnya adalah orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Langsung katakan saja padaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
