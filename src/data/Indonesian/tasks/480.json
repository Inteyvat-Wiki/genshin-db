			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Aku sudah membacanya, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Aku tidak berani mengatakan kalau aku benar-benar sudah memahami aturannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Ah, kamu sudah datang! Apa kamu sudah membaca buku panduannya? Apa kamu sudah memahami aturan-aturannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Ugh, nada bicaramu ini... Ya, aku mengerti kesulitanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Buku panduan meluncur memang sangat membosankan. Aku juga tidak suka membacanya... Duh, jangan katakan hal ini pada Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Oh ya? Paimon malah merasa cerita dalam \"Panduan Meluncur\" ini cukup menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Ceritanya menarik? Oh, maksudmu contoh-contoh kasus dalam lampiran di belakang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Aku juga menyukai beberapa kasus yang ditulis di dalam. Yang menjadi favoritku adalah kasus lepas landas menggunakan Anemo Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Kalau memecahkan Anemo Slime lalu lepas landas, dengar-dengar tiupan anginnya akan membuat kita terbang sangat, sangat tinggi... Aku ingin sekali mencobanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Bukan cerita yang itu, yang Paimon maksud adalah cerita tentang burung kecil yang ingin belajar terbang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Ah... Apa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Coba aku lihat... Loh, ini kan buku dongeng favoritku waktu masih kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Aduh maaf! Aku meletakkan buku ini dan buku panduan bersama-sama. Aku pasti mengambil buku yang salah waktu mau keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Bagaimana mungkin ada orang yang bisa salah mengambil buku dongeng dan buku panduan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Argh... Sungguh memalukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "Mungkin karena... karena di dalam hati kecilku, buku dongeng inilah yang mengajariku cara meluncur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"Yang paling penting bukanlah angin kencang, melainkan keberanianlah yang membuatmu menjadi burung pertama yang bisa terbang di dunia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Kalimat itulah yang memberiku keberanian untuk meluncur, menjadi seorang Outrider, dan menjadi Juara Meluncur Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "... Baiklah, jangan bicarakan hal ini lagi. Kita harus segera memulai tesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Jangan cemas. Kamu hanya perlu meluncur seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "Aku sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Ikuti <color=#00E1FFFF>jalur yang sudah ditandai</color> sampai ke tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
