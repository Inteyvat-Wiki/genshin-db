			"dialogs": [
				{
					"id": 741490201,
					"content": "Kemeja Athos 1.000 Mora ... Kalung Morticia ... Ckck, anak muda zaman sekarang memang pandai menghabiskan uang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Halo, Tuan Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Halo, kami diperkenalkan sama Nona Euphrasie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Kalian pun menjelaskan tujuan kedatangan kalian pada Tuan Leroy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, ini kan sudah masalah setengah tahun yang lalu, tak kusangka Nona Euphrasie masih simpan catatan misiku selama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "Benar. Aku memang berniat merekrut pekerja paruh waktu. Tidak peduli sehebat apa seseorang waktu masih muda, pas tua nanti, dia pasti perlu dirawat orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Aku sudah kerja keras seumur hidupku supaya bisa dapat satu rumah seperti ini, tapi waktu tua, aku baru sadar kalau aku sebatang kara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "Aku memang dulu sempat sedih sebentar karena hal ini. Tapi, untungnya sekarang ada putri dan menantuku yang merawatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Kedua anak ini penurut dan saling mencintai. Selama ada mereka yang menemaniku, aku sudah puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "Jadi, Nak, sekarang aku sudah tidak perlu pekerja paruh waktu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "Sayang sekali. Jadi, sia-sia aku datang ke sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Kalian juga jangan terlalu kecewa begitu. Aku paling tidak suka lihat anak muda yang berkecil hati. Anak muda harusnya tersenyum, menikmati semua yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "Karena kalian sudah terlanjur datang ke sini, dan direkomendasikan Nona Euphrasie dari The Steambird, aku masih punya kerjaan lain buat kalian kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "Kebetulan anak-anakku sedang pergi dan tidak ada di rumah. Aku juga tidak bisa kerjakan sendiri. Tentu saja aku pasti akan membayar kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "Wah, Tuan Leroy orangnya baik banget, deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Hahaha, mulutmu manis sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "Pergilah. Bantu aku bersihkan noda di pintu dan di belakang rumah. Sekalian juga kasih Nana makan ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "Oh, Nana itu kucingku, yang ada di depan pintu. Aku wakili dia berterima kasih pada kalian dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "Kedengarannya gampang banget deh. Enggak masalah, serahin aja ke kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Nona Euphrasie ini benar-benar deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
