					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Tentang pekerjaan baru ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Oh? Sepertinya misi \"Kisah Manusia\" kurang menantang buat kamu, ya? Atau belakangan ini kamu lagi butuh uang dan kekurangan Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Kalau Mora sih selamanya enggak bakal cukup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Iya. Memang banyak orang yang berpikir begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Di sini tidak pernah kekurangan pekerjaan misi. The Steambird mungkin sudah jadi pusat informasi perekrutan terbesar kedua di seluruh Court of Fontaine setelah Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Meski secara teori, kami tidak perlu menjalankan fungsi sosial seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Intinya, karena kamu butuh Mora, aku akan rekomendasikan pekerjaan jangka panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Ini pesan yang ditinggalkan Tuan Leroy di bagian \"Kisah Manusia\" lebih dari setengah tahun lalu. Semua yang tinggal di jalan ini kenal dengan Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Meski reputasinya waktu dia masih muda tidak terlalu baik, beberapa tahun ini aku tidak dengar gosip apa pun tentang dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Dia sudah menduda hampir seumur hidup, putri satu-satunya juga tidak ada di sampingnya. Tidak ada orang yang merawatnya, makanya dia sangat butuh seorang pekerja paruh waktu untuk membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "Setahuku Tuan Leroy tidak kekurangan uang, jadi imbalan darinya harusnya lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Aku rasa kerjaan ini tidak berbahaya, imbalannya juga oke. Tidak ada salahnya kamu pertimbangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Cuman bantuin kerjaan rumah saja, kan? Paimon rasa kerjaan ini oke deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Tolong kasih aku alamatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Tentu, untuk pergi ke rumah Tuan Leroy, kamu belok dua tikungan, lalu belok ke ... Ah, sudahlah, aku kasih petanya ke kamu saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Jangan lupa beri tahu dia kalau aku yang merekomendasikan pekerjaan ini ke kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Dua-duanya betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "Benar-benar anak muda yang rajin. Bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
