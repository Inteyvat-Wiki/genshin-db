			"dialogs": [
				{
					"id": 741490501,
					"content": "Pekerjaan kalian sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490502,
					"content": "Sudah, Tuan Leroy. Anu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Kalian mau permen atau mau ambil uang jajan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490504,
					"content": "Pai-Paimon mau dua-duanya. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Anak yang serakah, hahaha. Tapi, tidak apa-apa. Namanya juga anak kecil, ya wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490507,
					"content": "Terutama gadis imut seperti Paimon ini, memang harus makan Makaron, pakai baju bagus, dan tinggal di rumah yang cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490508,
					"content": "#Paimon juga ngerasa gitu loh! {NICKNAME}, {NICKNAME}, Paimon boleh enggak beli ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Enggak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#Hiks, sebel deh. {NICKNAME} pelit banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "Paimon, kita ini petualang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Tapi apa hubungannya ini sama Makaron, baju bagus, dan rumah besar yang cantik sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Kenapa kalian malah bertengkar? Kekanak-kanakan sekali. Tapi, bertengkar seperti ini bagus juga, bukti kalau kalian masih anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490515,
					"content": "Sebenarnya umurku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Masa kanak-kanak cuma sebentar. Hargai baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490518,
					"content": "Sudah, sudah, aku kasih Mora dan camilan manis ya. Jangan bertengkar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490519,
					"content": "Hore, ada camilan! Makasih Tuan Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Panggil aku Benoit saja. Leroy itu nama keluargaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490521,
					"content": "Sekarang di seluruh Court of Fontaine, cuma aku yang pakai nama keluarga Leroy. Kalau kamu panggil nama keluargaku, aku malah jadi merasa kesepian. Panggil nama depanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490522,
					"content": "Tuan Le ... Er, Benoit. Memangnya putrinya enggak pakai nama keluarga Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia bukan putri kandungku, dia putri yang kuadopsi setengah tahun lalu. Tapi, bagiku dia sudah seperti putri kandungku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490524,
					"content": "Kalau kalian tidak keberatan, besok kalian bisa datang lagi kok. Morticia dan Athos juga pasti sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490525,
					"content": "Aku rasa Morticia juga tidak akan keberatan kalau ada dua anak kecil imut yang bantu aku, terus makan camilan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490526,
					"content": "Kadang-kadang anak-anak lain juga datang ke sini, nanti kalian bisa main sama-sama. Aku benar-benar suka anak kecil, rumahku jadi ramai kalau ada banyak anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490527,
					"content": "Nanti kalau kalian tidak melihatku waktu kalian datang, ketuk saja pintu rumahku, Athos pasti akan bukakan pintu untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490528,
					"content": "Benar ya? Besok kami datang lagi, loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "Iya, iya. Kebetulan aku juga sudah mau masuk ke dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490530,
					"content": "Sampai ketemu besok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "Sampai jumpa, anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490516,
					"content": "Ini bukti kalau hubungan kami dekat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Paimon, jangan lupa tujuan perjalanan kita ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
