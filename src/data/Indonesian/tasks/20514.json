						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Apakah kamu melihat seorang gadis kecil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Gadis kecil? Oh, maksudmu Anna? Aku melihatnya, dia barusan lari ke arah kincir angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Aku bingung, bukankah dia sedang sakit? Dari mana dia punya tenaga sebanyak itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Setelah dia menyapaku dia langsung lari ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Anak ini... apakah kamu tahu sejak kapan dia sembuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
