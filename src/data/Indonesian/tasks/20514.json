			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Bagaimana hal ini bisa terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Oh, kamu. Kamu datang tepat waktu. Kesehatan Anna semakin membaik sejak dia memakan obat dari resep dokter itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Sebelumnya saat dia tidak sehat, dia membutuhkan istirahat yang banyak, dan menghabiskan waktunya di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Sekarang dia sudah sembuh, dia mulai merengek padaku setiap hari untuk bermain di luar, dan aku tidak bisa menolaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Tapi sekarang aku tidak bisa menemukannya. Aku tidak tahu dia ke mana. Tolong bantu aku menemukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "A-aku, baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Aku akan menunggu di sini, cepatlah mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "Anak ini, baru sembuh sudah membuat khawatir. Apa yang akan kita lakukan kalau sampai terjadi sesuatu padanya...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "Aku sudah mencarinya untuk waktu yang lama. Tapi aku masih belum melihat Adventurers' Guild, dan aku sudah kelelahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Kamu coba pergi ke Adventurers' Guild. Siapa tahu Cyrus mengetahui sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "Semoga bisa menemukannya, kalau tidak aku yang akan pergi mencarinya sampai ketemu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Kamu sepertinya senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Senang? Jangan bercanda. Anak ini baru sembuh sudah membuat khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "Tunggu dia kembali, aku akan memberikan apa pun yang dia inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Dia akan kembali saat dia lapar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Apa kamu menyamakan adikku dengan seekor kucing? Dan dia baru saja sembuh. Bagaimana mungkin membiarkannya kelaparan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Ya sudahlah, tolong bantu aku menemukannya, dan aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
