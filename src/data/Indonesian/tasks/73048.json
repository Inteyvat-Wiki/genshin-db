			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aramuhukunda",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730480101,
					"content": "Rasanya rindu sekali. Ratusan tahun berlalu sejak pemandangan seperti ini ada di hadapanku. Terima kasih, berkat kalian aku bisa kembali ke Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480102
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480102,
					"content": "Wah! Kamu sudah setua itu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480103,
						730480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730480103,
					"content": "Ini pertama kalinya aku dengar ada Aranara bilang \"tahun\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				},
				{
					"id": 730480105,
					"content": "Begitukah? Mungkin karena aku menerima banyak ingatan dan pengetahuan. Di alam mimpi Vanarana, tidak ada siang, tidak ada malam. Semuanya damai dan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480106
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480106,
					"content": "Umur kami sangat panjang, sehingga kami tidak menghitung waktu. Bagi kami waktu adalah pertumbuhan pohon, mekarnya bunga, dan naiknya bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480107
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480107,
					"content": "Kalau ada Festival Utsava, berarti sebentar lagi ada Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480108
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480108,
					"content": "Ya ... jadi Bija itu sebenarnya apa ya? Sebelumnya Araja dan Arama juga enggak jelasin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730480109,
					"content": "#Kalian telah menjadi teman Aranara, maka pasti pernah mendengar tentang prinsip Ararakalari. Nara {NICKNAME}, Paimon, apa kalian sudah tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480110
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480110,
					"content": "Arana pernah bilang soal kekuatan ingatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480111
					]
				},
				{
					"id": 730480111,
					"content": "Arana ya. Sudah lama sekali, semoga dia baik-baik saja. Dia itu pemarah, tapi kalau dia bilang begitu, berarti dia sudah menganggap kalian teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480112
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480112,
					"content": "Bija adalah buah yang terbentuk dari ekstrak ingatan dan mimpi, esensi dari hal yang paling berharga bagi kami Aranara. Dia buah, namun juga benih pengharapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480113
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480113,
					"content": "Bija dapat membantu mimpi untuk bisa terwujud, asalkan mimpinya bertujuan untuk menolong yang lain. Baik kamu dan Aranara yang mengejar Bija, kalian ingin membantu orang, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480114,
						730480115
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480114,
					"content": "Demi Rana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480116,
					"content": "#Maka semuanya mungkin terjadi. Karena Nara {NICKNAME} adalah teman, terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480117,
						730480118
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480117,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480119,
					"content": "Bunga lagi ... Arana dan Aranakin juga pernah kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730480120,
					"content": "Begitu ya. Kebiasaan ini tidak lekang oleh waktu dan terus lestari. Alangkah indahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480121
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480121,
					"content": "Dahulu kala, Araja, Araji ... dan Arapacati juga memberikan bunga pada Nara Varuna. Dia teman kami yang paling berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480122
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480122,
					"content": "Bunga ini adalah lambang persahabatan Aranara. Orang yang menerima bunga, berarti menerima persahabatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480123
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480123,
					"content": "Aranara tidak pandai berkata-kata. Ketika manusia menerima bunga, maka kami menjadi bangga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480124
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480124,
					"content": "#Aku sudah dengar banyak tentang Nara {NICKNAME}. Kamu adalah sahabat, dan aku merasa tersanjung karena kamu mau menerima bunga. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480125,
						730480126
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480125,
					"content": "Sama-sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480127,
					"content": "#Kita akan bertemu lagi. Semoga kalian bisa datang ke rumahku nanti, Nara {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480128
					],
					"speakerTitle": "Aramuhukunda"
				},
				{
					"id": 730480128,
					"content": "Ah, dia menghilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730480129,
					"content": "Aranara yang aneh! Sudahlah, ayo kita tengok Aranara yang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730480126,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480118,
					"content": "Terima kasih ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480115,
					"content": "Arana ingin menolong seorang teman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480104,
					"content": "Caramu menghitung waktu beda dari Aranara yang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				}
			]
		}
	]
}