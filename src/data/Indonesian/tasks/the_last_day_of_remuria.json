				]
			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Wah ... ini mirip banget sama ikan yang bisa nyala waktu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Terus masih ada benda aneh yang menjerat di sekelilingnya ... Sebenarnya ini kenapa sih? Paimon enggak ngerti, makin lama makin pusing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Aku pernah dengar suara ini di mimpiku sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Ya, kamu bertemu dengannya di dalam mimpi Sebastos, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830406,
					"content": "Scylla, naga iblis yang pernah melayani Sebastos. Dia ditaklukkan dan ditahan di sini oleh Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830407,
					"content": "Ehh?! Si najis enggak sopan itu pernah ngalahin naga iblis? Paimon enggak percaya dia bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "\"Naga iblis\" itu cuma julukan, sebenarnya hanya sedikit lebih kuat dari Vishap saja. Karena tidak ada Naga Hydro baru yang dapat lahir ke dunia selama Ratu Segala Perairan masih tertidur panjang di dasar laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830404,
					"content": "Tapi aku sudah lupa namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Monsieur Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Ahhh! Arusnya nyaman sekali! Akhirnya bebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Nah, makhluk kecil. Kalian datang dari dunia permukaan? Aku tidak tahu untuk apa kalian turun ke dalam sini, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "Kami enggak \"kecil\" loh ya! Kamunya saja yang kegedean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha! Baiklah kalau begitu. Kalian membebaskan aku dari belenggu yang mengikatku selama ribuan tahun. Aku berutang budi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Bicaralah. Bila ada yang bisa dibantu, maka akan kulakukan untuk membalas budi kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hehe, Paimon sudah tahu kamu nih paham aturannya! Hehe, Paimon ya ... Paimon, dia {NICKNAME}. Terus yang satu ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Ehh, Paimon enggak tahu sih dia ini apaan, tapi kami panggil dia Monsieur Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Ah, Cassiodor rupanya. Lama tak jumpa. Aku memang tidak memperkirakan ini, tapi kamu datang terlambat ... seribu tahun lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Wah, si gede ini kenal sama Monsieur Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Tidak ada yang perlu dibicarakan dengan pengkhianat hina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830611,
					"content": "Jaga bicaramu, makhluk fana! Kami adalah keturunan naga. Kami tidak ingkar janji, tidak khianat, dan tidak dapat dibandingkan dengan bangsa kalian yang angkuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Diam! Ucapanmu barusan sama sekali tak ada artinya! Pengkhianat ... bukankah kekalahan perang dahulu itu disebabkan oleh dirimu yang berbalik melawan kami semua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830613,
					"content": "Kalau saja perang itu berhasil dimenangkan ... bangsa kita ... Sebastos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830614,
					"content": "Dan kamu telah pergi terlalu lama, Cassiodor! Kenyataannya tidak seperti yang kau bayangkan. Tentunya rencana rahasia tak lagi sebuah rahasia bila sampai ke telingamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "Rencana ... rahasia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830616,
					"content": "Remus-lah yang memintaku untuk memimpin pasukan Vishap menyerbu ibu kota. Ini bagian dari rencana terakhir dan rahasianya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "Dan semua ini adalah untuk menyelamatkan bangsa dan rakyatnya. Dia benar-benar luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "Kok kedengarannya tidak masuk akal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "Iya, aneh sih. Kenapa ada raja yang bisa minta tolong orang lain buat nyerbu bangsanya sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Bagaimana mungkin kita dapat memahami pemikiran Remus, makhluk kecil? Apa pun masalahnya, coba lihat ini, Cassiodor. Kamu pasti bisa menerawang maknanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Lebah emas pemandu ... Mereka hanya menuruti satu simfoni ... Kenapa Sebastos mengizinkan seekor naga yang buas memperoleh kuasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830624,
					"content": "Karena mereka sudah pernah membuat perjanjian ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Oh? Makhluk kecil, kamu tahu banyak rupanya! Dari mana kamu mengetahuinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Dari ingatan ... yang tersebar di dalam air.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Benar yang kamu katakan! Ya, kami memang bertukar janji, namun aku tidak bisa menepatinya. Aku gagal meneladani pengorbanannya yang mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Aku terlambat sampai ke Domus Aurea! Ombak pun menelan kota, dan kaumku juga tidak bisa kabur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "Hah? Kok bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830630,
					"content": "Heh ... Kalau bukan karena pengkhianat itu ... Pengkhianat yang sesungguhnya adalah Boethius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Jika bukan karena bajingan penipu itu, tikus licik yang lidahnya bercabang ... bagaimana mungkin pangeran bangsa naga ini, yang memimpin pasukan di zaman keemasan para naga purba, mana mungkin aku bisa kalah dengan begitu mudahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "Iblis itu awalnya mengaku menghentikan perlawanan atas perintah Remus. Lalu mengatakan kalau dia memerintahkan legiun untuk menyerah. Setelah kami sampai tempat itu, dia tiba-tiba menyerang balik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Kalau dipikir lagi sekarang, sepertinya dia dari awal sudah tahu rencana Remus, lalu dia pancing aku selangkah demi selangkah, ke dalam perangkapnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "Begitulah, darah dan dagingku membatu, hingga hari ini, menunggu untuk diselamatkan oleh kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius tahu jelas kalau tindakannya ini akan membawa petaka besar, tapi dia masih ... Apa mungkin demi bisa mendapatkan kendali atas Phobos? Makanya dia berbuat dosa seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830636,
					"content": "Sepertinya cerita yang kita tahu belum lengkap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Jadi orang yang teriak-teriak pengkhianat ... adalah pengkhianat yang sebenarnya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Tapi kenapa? Masa kita harus tanya langsung ke orangnya sih? Paimon enggak percaya dia bakal jawab jujur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Hmm, jadi si cacing iblis hina itu masih belum lenyap dari muka bumi ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Iya, dan dia juga mencuri jiwa-jiwa banyak orang Fontaine! Kami ke sini mau nolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "Katanya dia bakal tunggu di Domus Aurea ... Yah, nungguin si Monsieur Os sih, kami sih nimbrung doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Enggak ada satu pintu pun yang tersisa. Benar-benar enggak sopan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "Gerbang Initium Iani? Heh ... Meski sudah kasih trik ilusi, tapi pada akhirnya, ini cuma pintu batu yang dibesar-besarkan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "Aku sudah kehilangan wujud dagingku, namun mudah saja bila ingin mengirim makhluk-makhluk kecil itu untuk membereskan masalahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Perhatikan baik-baik, makhluk kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Hooo! Kamu hebat juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Kita hanya perlu membuka segelnya yang kelihatan jelas itu satu per satu. Kalau sudah siap, langsung saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Monsieur Os, sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Sudah sejauh ini, kita tidak punya pilihan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830647,
					"content": "#Oke deh. {NICKNAME} gimana? Siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Apa dia juga sudah jadi gila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
