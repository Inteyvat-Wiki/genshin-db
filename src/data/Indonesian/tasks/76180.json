			"dialogs": [
				{
					"id": 761800601,
					"content": "A ... apa? Enggak mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800602,
					"content": "Sepertinya kamu kalah, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800603,
					"content": "A... Aku yang sengaja kasih kamu menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800604,
					"content": "Benarkah? Lalu kenapa kamu terlihat heboh begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800605,
					"content": "Sial ... sekali lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800606,
					"content": "Hmph, gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800607,
					"content": "Kamu menang. Kamu memang sangat pandai, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800608,
					"content": "Lain kali kita main yang lebih menantang. Aku tahu banyak permainan matematika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800609,
					"content": "Kedengarannya seru! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800610,
					"content": "Heh? Ada yang lucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800611,
					"content": "Aku hampir enggak pernah melihatmu sesenang ini. Kamu jarang sekali mengajakku bermain. Biasanya kamu malah mengusirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800612,
					"content": "Hei ... jangan bicara seolah-olah aku ini menindasmu dong! Mulai sekarang, aku akan lebih sering mengajakmu ke pesta teh, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800613,
					"content": "Baiklah. Aku suka sekali waktu minum teh bersamamu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
