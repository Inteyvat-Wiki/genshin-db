			"dialogs": [
				{
					"id": 761800401,
					"content": "Dulu kita selalu kumpul-kumpul di kebunmu, Sandrone. Sekarang justru kamu yang kunjungi aku untuk minum teh. Rasanya aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800402,
					"content": "Tapi masih aku yang menyiapkan semuanya, rasanya enggak terlalu ada bedanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800403,
					"content": "Yap, dan makanan buatanmu masih seenak yang kuingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800404,
					"content": "#Hmm ... kudengar {NICKNAME} sering mengunjungimu. Biasanya kalian ngapain saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800405,
					"content": "Kadang kami ngobrol, kadang bermain bersama kuuhenki, atau lihat mereka menggambar. Oh, kami juga main Catur Bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800406,
					"content": "Catur Bulan? Yang harus susun tiga keping dalam sebaris? Siapa yang menang biasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800407,
					"content": "#Aku tidak pernah hitung, tapi harus kuakui, {NICKNAME} memang jago sekali bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761800408,
					"content": "Heh, akan kutunjukkan kemampuan sesungguhnya. Mau main? Kalau seri, anggap saja kamu yang menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800409,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
