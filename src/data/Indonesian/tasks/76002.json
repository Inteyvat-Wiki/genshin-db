			"dialogs": [
				{
					"id": 760020301,
					"content": "Huff ... Mereka masih berhasil juga. Dasar para berengsek tak tahu diri, berani-beraninya cari masalah sama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Terima kasih sudah membantu. Sesudah rekan-rekanku antar \"Mademoiselle Belleville\" ke Kota Nasha, aku bakal kasih imbalan ke kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Ya, baguslah kalau ingat imbalan ... Eh, sebentar, kalian penculik ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Haha, jangan salah paham, gadis kecil. Kami tidak berurusan dengan penculikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "\"Mademoiselle Belleville\" itu nama benda besi ini. Kami sudah angkut jauh-jauh dari Fleuve Cendre dengan susah payah. Kalau sampai direbut orang, kami bisa rugi besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Ohh, jadi ini mekanisme roda gigi dari Fontaine ya ... Wah, teknologi Fontaine emang hebat ya, sampai di sini pun masih bisa berfungsi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Bercanda lagi gadis kecil ini. Sistem energi benda besi ini sudah lama dibongkar, tidak mungkin bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "Peringatan. Mode pengaktifan <color=#FF5E41FF>ABNORMAL</color>. Modul energi <color=#FF5E41FF>ABx5F02&#5E38NORMAL</color>. Verifikasi gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "\"Mademoiselle Belleville\""
				},
				{
					"id": 760020309,
					"content": "Verifikasi gagal. <color=#FF5E41FF>Verifikasi gagal</color>. <color=#FF5E41FF>Verifikasi gagal</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan, hancurkan, hancurkan</color>—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "\"Mademoiselle Belleville\""
				},
				{
					"id": 760020310,
					"content": "#Woah! {NICKNAME}, awas!",
					"roleType": "TALK_ROLE_NPC",
