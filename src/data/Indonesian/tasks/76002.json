			"dialogs": [
				{
					"id": 760020501,
					"content": "Ha! Akhirnya beres juga. Orang asing yang penuh omong kosong. Sekarang sudah kubekukan dan tidak panas lagi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Ka-Kayak gini seharusnya sudah bisa mencegah pengiriman barang terlarang ke Kota Nasha kan? Oh ya, jangan lupa imbalan kami ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hmph, dibandingkan dengan itu, biarkan aku periksa dulu barangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Hah? Periksa ... barang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Terus? Kalau sampai ada masalah, bukan cuma kalian, aku dan rekan-rekanku juga tidak akan dapat satu Mora pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Cih ... goresan-goresan ini, bahkan ada noda karat juga! Fleuve Cendre benar-benar makin ceroboh belakangan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Ohh, ini mekanisme roda gigi dari Fontaine kan ... Wah, teknologi Fontaine memang hebat ya, masih bisa dipakai setelah dibawa ke antah berantah gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Berfungsi? Sistem energi benda besi ini sudah lama dibongkar, tidak mungkin bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "Peringatan. Mode pengaktifan <color=#FF5E41FF>ABNORMAL</color>. Modul energi <color=#FF5E41FF>ABx5F02&#5E38NORMAL</color>. Verifikasi gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020510
					],
					"speakerTitle": "\"Mademoiselle Belleville\""
				},
				{
					"id": 760020510,
					"content": "Verifikasi gagal. <color=#FF5E41FF>Verifikasi gagal</color>. <color=#FF5E41FF>Verifikasi gagal</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan</color>. <color=#FF5E41FF>Hancurkan, hancurkan, hancurkan</color>—",
