			"dialogs": [
				{
					"id": 760020101,
					"content": "Hei, sobat berambut pirang di sana! Kalian datang tepat waktu, si berengsek ini lagi cari masalah. Ayo bantu aku, nanti akan kuberi imbalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "Apa-apaan ini? Takut kalah lalu mau ajak orang? Ya sudah, aku juga bisa begitu. Dengarkan aku, Kak. Bantu aku beresin orang ini, nanti imbalan Mora-nya kubagi setengah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "Eh, eh? Kami cuma numpang lewat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
