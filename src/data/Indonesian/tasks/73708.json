			"dialogs": [
				{
					"id": 737080301,
					"content": "*huff* Akhirnya kita sampai juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080302,
					"content": "Perjalanannya memang jauh, tapi menurut Paimon di Tirai Daun ini ada banyak ciri khas yang unik. Untuk para sobat Fungus, ini pasti hal yang baru banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080303,
					"content": "Paimon ada beberapa lukisan pemandangan, teman-teman Fungus bisa bandingkan dengan pemandangan aslinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080304,
					"content": "Kalau mereka lihat dan cocokkan lukisan dan pemandangan, lalu mulai perhatikan detail-detail kecil yang biasanya mereka abaikan ... itu berarti ini tempat yang cocok untuk kita jelajahi lebih dalam lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080305,
					"content": "♪♫!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737080306,
					"content": "♫... ♩?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "Pyro Sukacita"
				},
				{
					"id": 737080307,
					"content": "Ternyata bisa begini juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "Hehe, Paimon kalau punya waktu luang, Paimon bakal baca buku-buku panduan dan lihat tempat-tempat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080310,
					"content": "Pemandu yang baik harus bisa begitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080311,
					"content": "Oke, ayo kita coba sama teman Fungus kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080308,
					"content": "Paimon memang ahlinya!",
