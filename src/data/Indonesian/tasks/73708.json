			"dialogs": [
				{
					"id": 737080201,
					"content": "Sepertinya pesan ini berhasil tersampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080202,
					"content": "Kita bertemu lagi, \"Komet Emas\" dan \"Bintang Kejora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080203,
					"content": "Kalian yang bersinar dan penuh semangat membuatku merasa waktu telah berhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080204,
					"content": "Lama tak berjumpa, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "Ternyata benar-benar kalian, Haniyyah dan Topi Gendang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080206,
					"content": "Pantes Paimon terasa familier banget pas baca pesannya ... berarti Paimon dan Topi Gendang masih sedekat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737080212,
					"content": "Aku sudah membayangkan banyak cara untuk merayakan reuni kita, seperti pesta makan besar, atau sambutan yang kreatif untuk memberi kalian kejutan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080213,
					"content": "Tapi semua itu terasa terlalu formal. Karena kalian juga sangat sibuk, kurasa ini semua justru akan merepotkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080214,
					"content": "Lagi pula, teman-teman Fungus kita juga lebih suka ketenangan, jadi mari kita rayakan reuni ini dengan santai dan sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080215,
					"content": "Betul! Esai-esai yang dibaca Haniyyah benar-benar berguna. Ketenangan pikiran itu memang bagus untuk hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080216,
					"content": "Seperti ini, mengobrol santai adalah hal yang paling menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "Pyro Sukacita"
				},
				{
					"id": 737080218,
					"content": "Nona Souka juga ada di sini! Ada juga Pyro Sukacita, dan ... siapa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080219,
					"content": "Ini teman Fungus aku, Penari Badai! Waktu itu, kamu dan Topi Gendang mengalahkan kami di babak 32 besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080220,
					"content": "Ehehe, kamu masih ingat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080221,
					"content": "Aku sudah mulai teringat lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "Intinya, seperti yang kalian lihat, kita tidak perlu janjian untuk bertemu kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080224,
					"content": "Haniyyah dan aku sudah beli area perdagangan ini dan mengubahnya menjadi Taman Fungus Kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080225,
					"content": "Tunggu, jadi maksudmu bukan disewa untuk permainan di atas meja yang baru, tapi untuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080226,
					"content": "Betul. Mulai sekarang, kami akan menetap di Pelabuhan Bayda, mempromosikan permainan di atas meja milik Fungus, dan teori berkomunikasi dengan hewan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080227,
					"content": "Silakan mampir dan main dengan teman-teman Fungus kapan pun kalian punya waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737080229,
					"content": "Hore! Teman Fungus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "I-i-ini salah satu kabar terbaik yang Paimon dengar hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080232,
					"content": "Setelah Turnamen Fungus pertama, Paimon udah mikirin banyak ide main sama Topi Gendang, akhirnya kesampaian juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080233,
					"content": "Ngomong-ngomong, biaya di sini lumayan, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "Jangan khawatir, Mora bukan masalah bagi kami sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080235,
					"content": "Selama ini, selain mengumpulkan dana dengan mengoperasikan permainan meja \"Fungus Mechanicus\" dan \"Festival Fungus Fantastis\" dengan bantuan Tuan Balfour ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080236,
					"content": "Kami juga merangkum pengalaman masa lalu kami, mengumpulkan informasi mengenai pelatihan hewan dan Fungus ke dalam teori sistematis, dan mencoba mencetak beberapa koleksi buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080237,
					"content": "Bahkan ada beberapa peneliti yang memberikan bantuan finansial kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080238,
					"content": "Aku bisa menggunakan pengetahuanku untuk membantu lebih banyak orang, menukar Mora, dan membuat hidup teman-teman Fungus menjadi lebih baik, agar semuanya memasuki siklus yang positif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080239,
					"content": "Ke-keren banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080240,
					"content": "Rasanya Haniyyah udah jadi \"Ahli Penjinak Hewan\" yang tenang ... dan bisa tangani semua masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080241,
					"content": "Semua ini berkat bimbingan Souka. Dia mendorong aku untuk mengikuti jejak murid-murid dan menantang diri untuk menguasai keterampilan yang harus dipelajari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080242,
					"content": "Hei! Jangan merendah seperti itu, aku juga bukan guru hebat, terima saja pujian untuk kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080243,
					"content": "Bilangnya mudah, tapi pas ada masa-masa sulit juga, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "Iya, memang menghadapi banyak tantangan, tapi biarkan masa lalu dan hal-hal buruk memudar seiring berjalannya waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080246,
					"content": "Penyesalan terbesarku adalah ... aku tidak bawa teman-teman Fungus main di luar selama setahun ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080247,
					"content": "Sejak aku mulai menyusun teori penjinak hewan, sebagian besar waktu kami dihabiskan di dalam gua dan rumah pohon, menjalani kehidupan menulis yang kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080248,
					"content": "Kehidupan berbisnis dan menulis itu benar-benar melelahkan. Aku jadi lebih paham dengan pemikiran Souka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080249,
					"content": "Tidak semuanya negatif kok! Kan kita tetap merasa puas setelah menyelesaikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080250,
					"content": "Ya, aku setuju. Setiap kali menyelesaikan naskah, memang layak dirayakan dengan hidangan mewah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080251,
					"content": "Sayangnya, teman-teman Fungus kita tidak bisa menikmati makanan kita. Mungkin di mata mereka, hidup menjadi semakin membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080252,
					"content": "Kalau begini terus, kondisi mereka akan semakin memburuk, dan itu tidak bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080253,
					"content": "Jadi, karena kondisimu udah stabil sekarang, dan kamu juga udah punya tempat tinggal tetap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080254,
					"content": "Gimana kalau kami berdua ajak teman-teman Fungus keluar main? Pulangnya kalau udah puas main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080255,
					"content": "Kalau gitu, kamu kan bisa lebih fokus kerja, dan teman-teman Fungus juga bisa bersenang-senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080256,
					"content": "Ide yang bagus, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "Aku setuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080259,
					"content": "Kalau soal tempat main, aku biasanya cari dari buku. Waktu pertama kali ke Fontaine, kami sempat tersesat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080260,
					"content": "Haniyyah lebih parah lagi. Dia bahkan tidak tahu tempat-tempat seru apa saja di Sumeru, terlalu asyik dengan kerjaannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080261,
					"content": "Terakhir kali kami di Fontaine memang lumayan lama, tapi jadwal yang kami susun kurang matang. Jadi, kami tidak sempat mengunjungi toko kue yang menjual makaron yang sudah lama membuatku penasaran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080262,
					"content": "Ehem ... \"Komet Emas\" dan \"Bintang Kejora\" kan tahu banyak tempat menarik, teman-teman Fungus kita pasti bisa menikmati waktu yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080263,
					"content": "Kalau begitu aku harus cari tempat yang tepat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "Tunggu, silakan bawa Kamera kecil ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080266,
					"content": "Haniyyah mengeluarkan sebuah Kamera biasa dan meletakkannya di atas kepala Topi Gendang. Ternyata \"Topi Gendang\" bisa menyeimbangkannya dengan mudah, seolah-olah sudah terbiasa terbang sambil membawa benda seperti ini ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "Meskipun terlihat biasa-biasa saja, tapi ini adalah suvenir yang spesial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080268,
					"content": "Topi Gendang pernah menyelamatkan anak dari seorang pedagang yang tersesat di selatan Apam Woods. Sebagai tanda terima kasih, pedagang itu memberikan Topi Gendang banyak hadiah, Kamera ini adalah salah satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080269,
					"content": "Topi Gendang suka banget dengan foto-foto yang diambil Kamera ini. Jadi, kalian bisa menggunakannya selama perjalanan kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080270,
					"content": "Aku menemui Nona Helene, seorang pakar peralatan yang bantu menyegel bagian luar Kamera sehingga bisa digunakan di lingkungan yang lembab ... bahkan di dalam air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080271,
					"content": "Berarti, Kamera ini salah satu simbol kehormatan Topi Gendang dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080272,
					"content": "Keren banget, Topi Gendang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737080275,
					"content": "#Kalau soal ambil foto, jangan khawatir! {NICKNAME} dan Paimon juga ahlinya! Tampilan luarnya enggak jadi masalah, yang penting bisa ambil foto-foto bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}, ayo kita siap-siap sebelum berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080277,
					"content": "Jangan lupa makanan spesial untuk teman-teman Fungus kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080278,
					"content": "Benar! Paimon mengingat bagian itu dengan sangat jelas. Tolong bawa Marvelous Jelly yang cukup ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080279,
					"content": "Versi yang baru ini terasa lebih enak dan tahan lama. Tidak peduli lingkungannya sepanas apa pun, mereka tidak akan cepat membusuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080280,
					"content": "Hati-hati juga, jangan kasih terlalu banyak sekaligus. Terlalu memanjakan mereka itu tidak baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080281,
					"content": "Hehe, oke! Jelly masuk ke ransel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080282,
					"content": "Sekarang tinggal tunggu kami balik dengan suvenir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080273,
					"content": "Kerja bagus, Topi Gendang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "Aku akan memilih tempat yang seru dan indah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "Aku juga mau ajak teman-teman Fungus bermain!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "Sepertinya kamu mengabaikan bagian-bagian yang menyulitkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "Sekarang kita sudah bisa sering-sering ketemu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "Suasana yang hangat dan ramah membuatku merasa rileks ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "Meskipun aku tidak begitu ingat, tapi halo semua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "Iya, itu Haniyyah dan Topi Gendang! Teman yang kita kenal dari Turnamen Piala Nilotpala untuk Pawang Penjinak waktu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080210,
					"content": "Paimon ingat kita ketemu mereka di sekitar Port Ormos dan di Court of Fontaine! Udah lama banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Topi Gendang"
				}
			]
