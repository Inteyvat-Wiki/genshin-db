			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Kalian ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320102,
					"content": "Ada petunjuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Iya, berkat Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320104,
					"content": "Kami berhasil memastikan beberapa lokasi berkat bantuan analisanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320105,
					"content": "Sekarang ini, sepertinya salah satu perkemahan dijaga oleh \"Si Guguk Bertopi\". Lokasi yang itu perlu perhatian khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320106,
					"content": "Itu seperti julukan yang diberikan Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "Eh! Paimon mana mungkin kasih julukan payah begitu! Kalau kata Paimon sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320108,
					"content": "Anjing ini namanya \"Si Guguk Pisau\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320109,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320110,
					"content": "Aku sudah menaruh alat serupa di sekitar lokasi. Semoga mereka mempunyai efek yang sama seperti sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320111,
					"content": "Hei! Jangan abaikan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320112,
					"content": "Kuserahkan sisanya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320113,
					"content": "Ada pertanyaan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320114,
					"content": "Apa info ini bisa dipercaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Pasti. Aku sendiri yang mengintai daerah tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320116,
					"content": "Apa kali ini kamu enggak ikut bareng kita, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320117,
					"content": "Aku mau ikut, tapi sayangnya ada tugas lain yang harus kulakukan untuk Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320118,
					"content": "Kurang lebih, dia punya beberapa sumber tentang \"Si Guguk Bertopi\" dan dia memintaku untuk menyelidikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320119,
					"content": "\"Si Guguk Pisau\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320120,
					"content": "\"Si Guguk Bertopi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320121,
					"content": "\"Si Guguk Pisau Bertopi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Kombinasinya jadi aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320123,
					"content": "Julukan macam apa itu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320125,
					"content": "Hmm. Mungkin kita panggil saja dia \"Bayangan Hitam\" seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320126,
					"content": "Apa pun itu, kuserahkan para hewan itu padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320124,
					"content": "Ayolah, jangan berdebat lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Terima kasih banyak. Hmm ... Ini masih belum semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "Segitu banyaknya yang hilang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "Sayangnya, iya. Dibandingkan dengan komisi yang kita terima, seharusnya kita sudah menemukan setengah dari para hewan yang hilang tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "Sayangnya, kita kehilangan petunjuk lagi. Untungnya, hewan-hewan yang masih hidup jauh lebih mudah untuk diselidiki daripada benda mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "Kami baru saja menerima permintaan dari keluarga terpandang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "Petunjuk kita jadi buntu, dan jika bukan karena deduksi dari Sango, kita pasti tidak bisa maju lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "Bisa ceritakan lebih detail?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Yap yap yap! Kedengarannya menarik — ayo, kita dengar kelanjutannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "Aku tidak tahu kalau kamu begitu tertarik dengan pekerjaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "Sebenarnya, kami sudah melihat ke beberapa tersangka. Masalahnya kita tidak bisa menemukan bukti di tempatnya, petunjuk lain juga tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "Lalu, kebetulan aku dengar kalau tersangka kita itu menjual beberapa Naku Weed sehari sebelumnya. Aku menemui si pembeli untuk menyelidiki produknya dan menemukan bahwa memang produknya masih segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "Setelah mendengarnya, Sango memintaku pergi ke kaki gunung Mt. Yougou untuk menyelidikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "Eh? Kenapa Mt. Yougou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "\"Tersangka kita ini tinggal di Pulau Narukami. Walaupun Naku Weed bisa ditemukan di seluruh Inazuma, kebanyakan orang membutuhkan perahu untuk pergi ke pulau lain, dan kita tidak menemukan adanya perahu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "\"Lalu, Tenryou Commission sangat sensitif dengan penggunaan perahu karena adanya Dekrit Sakoku. Jika tersangka kita ini berencana untuk melakukan tindakan kriminal, mereka tidak akan melakukan sesuatu yang akan menarik perhatian Commission.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "\"Dari situ saja kita sudah bisa mengeliminasi pulau-pulau lain.\" Begitulah yang dia katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "Tapi bukannya ada Naku Weed di sekitar Kuil Agung Narukami, ya? Kenapa cuma cek di kaki gunung Mt. Yougou saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "Sango juga sudah memikirkannya. \"Naku Weed memang tumbuh juga di sekitar Kuil Agung Narukami, tapi para miko ada di sana, dan banyak pengunjung sering datang ke sana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "\"Jika ada sesuatu yang aneh terjadi di sana, pasti mudah diketahui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "Ooh, jadi gitu ya! Paimon paham sekarang kenapa Sango disebut sebagai otak dari kelompok kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "Kita juga menemukan gundukan tanah di kaki bukit, yang menunjukkan bekas-bekas baru digali. Si tersangka mengubur barang curiannya di sana. Dia berencana menunggu sampai situasi kembali tenang sebelum mengambilnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "Tapi dia pikir akan menarik kecurigaan dengan meninggalkan muatan berat itu dan kembali dengan tangan kosong, jadi dia mengumpulkan Naku Weed di sepanjang jalan dan menjualnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "Hah, tapi justru karena Naku Weed itu yang membuatnya tertangkap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "Benar. Karenanya, aku percaya pasti ada banyak jejak di sekitarnya. Kami hanya belum berhasil mengungkapkannya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "Aku percaya bahwa kerja sama kita ini cukup ideal. Lagi pula, keahlianku yang sebenarnya adalah menjalankan tugas, bukan sembunyi-sembunyi atau bertempur. Kuserahkan bagian itu untukmu, malahan, ini memang lebih cocok untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "Bagaimana? Apa kamu tertarik bekerja di Bantan Sango?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "Sango mungkin terlihat ... lebih rumit dari kelihatannya, dan dia terkadang mengatakan hal-hal aneh seperti \"hati nurani menahan kebijaksanaan\", tapi dia sebenarnya baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "Tidak, terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "Ah, sayang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "Baiklah, setelah kupikirkan, ini memang yang terbaik. Jika Sango punya orang sepertimu, aku bakal kehilangan pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
