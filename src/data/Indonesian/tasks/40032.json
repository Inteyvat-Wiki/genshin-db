	"talks": [
		{
			"id": 4003201,
			"completionStepIds": [
				4003201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
