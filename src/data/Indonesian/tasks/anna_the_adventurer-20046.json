				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "Selesai! Terima kasih, Pengembara. Misi pengantaran ini berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460202,
					"content": "Tapi, apa misi yang dilakukan petualang seperti ini semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460203,
					"content": "Masih ada misi lain kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "Nada bicaramu kedengarannya lesu sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460207,
					"content": "Oh begitu ... Baik! Aku akan terus berusaha keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460208,
					"content": "Nanti saat tabunganku sudah terkumpul banyak, akan kuajak orang tua dan kakakku jalan-jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460209,
					"content": "Dulu sebenarnya kakak selalu ingin pergi bertualang, tapi ... dia akhirnya malah harus menjagaku karena saat itu aku jatuh sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460210,
					"content": "Sekarang aku sudah sembuh dan bahkan berhasil menjadi seorang petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460211,
					"content": "Hehe, sekaranglah saatnya aku membantu kakak mewujudkan impiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460205,
					"content": "Kamu pelan-pelan bakal mengerti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "Yah, ekspresimu jangan lelah begitu dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				}
			]
		},
