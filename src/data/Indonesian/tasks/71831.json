				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "Akhirnya tempat ini sudah jadi lumayan mirip kuil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "Betul, akhirnya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Eh? Oh, pas sekali waktunya. Pekerjaan renovasi sudah selesai, aku barusan selesai bayar semua tukang-tukangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "Ah, tidak kusangka bakal keluar Mora sebanyak ini. Semua tabunganku habis untuk pekerjaan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "Tapi akhirnya renovasi kuil ini selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "Kamu mau bakar dupa? Aku sudah minta orang membuatkan pembakar dupa yang baru loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Ini dupanya. Tempat membakarnya di sebelah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "Kamu sendiri sudah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Tentu saja. Aku yang pertama bakar dupa malah, tepat begitu pekerjaan renovasinya rampung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
