				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Sudah selesai? Bagaimana rasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "Menenangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Bagus. Kuharap akan selalu ada dupa yang dibakar di kuil ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Aku akan tinggal di sini untuk sementara. Tempat ini sangat tenang, sangat sesuai untuk menulis buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Aku harus merapikan bahan dan informasi yang sudah kukumpulkan, agar bisa lanjut menulis buku tentang sang Vigilant Yaksha itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Menengoklah kemari kalau kamu ada waktu senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Kalau mau bakar dupa, minta saja ke aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "*huff* Sebenarnya aku juga ingin memperbaiki area sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "Jalannya harus dipasang batu dan dipagari kiri-kanan. Lalu mungkin buat taman bunga juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
