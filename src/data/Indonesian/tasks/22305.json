					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "#Keputusan yang bijaksana, {F#Nona}{M#Tuan}... Baiklah, pilihlah batu yang kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "Pilihlah dengan cermat, karena 200 Mora bukan jumlah yang kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Kalau sudah selesai memilih batunya, aku akan membantu membelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
