						223050502
					]
				},
				{
					"id": 223050502,
					"content": "Baik! Tidak setiap pelanggan baru menghargai bahwa seseorang harus menabur dengan murah hati untuk menuai dengan murah hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Silakan, pilihlah batu yang kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "Lihatlah dengan cermat, semua batu-batu ini sudah kami pilah. Aku jamin, kamu tidak akan rugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Beri tahu aku batu mana yang kamu pilih, lalu aku akan membantumu membelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
