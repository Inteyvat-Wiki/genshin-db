			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "Halo! Mau mencoba keberuntunganmu dengan batu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Baik, aku mau mencobanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "Bagus sekali, kamu tidak akan menyesal! Aku sudah mencium hawa keberuntungan terpancar dari tubuhmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "#Di sini, {F#Nona}{M#Tuan}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "Batu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Tentu saja batu-batu terpilih di dalam tokoku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Belilah satu buah batu dulu, kemudian belah dan lihat apakah ada giok di dalamnya. Bila ada giok di dalamnya, aku akan membayarmu Mora. Tentu saja bila tidak ada giok, berarti tidak ada Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "Cara terbaik untuk mengerti cara mainnya adalah membeli batu dan membelahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "Batu-batu ini berasal dari mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Batu-batu di toko kami adalah batu-batu terbaik yang digali dari Chasm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "Jangan takut, \"Jade Mystery\" sudah menjalankan bisnis giok dari generasi ke generasi. Penilaian kami terhadap batu tidak perlu diragukan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "Tapi Jade Mystery sudah tidak seperti dulu lagi... Bagian Urusan Sipil telah menutup Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Karena sumber batunya ditutup, persediaan batu pun semakin menipis... Sekarang batu-batu ini bahkan lebih berharga daripada perhiasan giok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Jadi kupikir kenapa tidak langsung menjual batunya saja? Selain bisa menghemat ongkos pembuatan, orang-orang akan berdebar-debar dan senang saat membelah batunya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "Halo! Mau mencoba keberuntunganmu dengan batu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Baik, aku mau mencobanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
