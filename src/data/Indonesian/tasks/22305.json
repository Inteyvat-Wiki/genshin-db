						223050402
					]
				},
				{
					"id": 223050402,
					"content": "Jumlah yang tepat seperti yang sering kusarankan untuk para pelanggan baru. Ini jumlah yang pas untuk bermain-main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "Kemarilah. Pilihlah sebongkah batu di antara batu-batu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Pilihlah dengan cermat. Setelah itu aku akan membantumu untuk membelahnya.",
					"roleType": "TALK_ROLE_NPC",
