			"dialogs": [
				{
					"id": 223050201,
					"content": "Batu-batu di Jade Mystery sangat banyak. Saking banyaknya, kamu bisa kewalahan waktu mau memilih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "Jadi sebelumnya aku sudah mengambil dan memilah beberapa batu untuk kalian. Kalian mau mengambil batu yang harganya berapa?",
					"roleType": "TALK_ROLE_NPC",
