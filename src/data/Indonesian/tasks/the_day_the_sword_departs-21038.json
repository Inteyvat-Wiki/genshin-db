			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "Pengembara, kamu datang juga. Kukira kamu sudah tidak akan datang lagi hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Hari ini aku akan pergi dari Pelabuhan Liyue. Aku sudah merepotkanmu banyak sekali ... aku harus berterima kasih padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "E-Ehem ... Aku baru saja memikirkan harus bilang apa kalau bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "Tapi pas harus bicara sekarang, aku malah tidak ingat harus bilang apa ... Duh, malah jadi canggung begini, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "Tidak apa, aku yakin kita bakal bertemu lagi kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Benarkah? Haha, bagus deh! Nanti akan kubawa kamu jalan-jalan di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Oh ya, sebenarnya aku masih mau minta tolong lagi. Kamu punya Kamera, kan? Boleh tolong foto aku sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Ada seorang pelaut yang bilang padaku kalau kita harus simpan foto kampung halaman waktu mau pergi ke tempat asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Tapi aku tidak punya Kamera, jadi mungkin kamu mau berbaik hati dan membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Ayo, pose yang keren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "Po-Pose?! Yang penting pemandangan di belakangku saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Kapan-kapan aku akan main ke Fontaine dan mencarimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
