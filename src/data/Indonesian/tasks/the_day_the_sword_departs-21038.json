			"dialogs": [
				{
					"id": 210380201,
					"content": "Terima kasih ya, Pengembara. Fotonya bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*huff* Akhirnya aku harus berangkat juga. Kalau dengar orang-orang bilang \"orang hebat berani mengejar ambisi sampai ke mana pun\" atau \"lebih baik menjelajah ribuan mil daripada membaca ribuan buku\", aku selalu merasa bersemangat dan terinspirasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Tapi kalau aku sendiri yang sudah mau pergi, aku sama sekali tidak semangat deh. Rasanya mau tetap di sini terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "Pengembara, apa menurutmu aku bisa menemukan hal yang kucari di perjalananku ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Entahlah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Hahaha ... Benar juga, memangnya apa yang kucari? Apa aku sendiri tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "Oke, sudah waktunya. Aku akan pergi menemui pedagang itu. Pengembara, ini tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Akhirnya Que'er tidak datang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Semua itu tergantung dirimu sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Jadi maksudmu ... semua tergantung nasib.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
