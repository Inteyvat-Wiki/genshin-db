				"points": []
			},
			"dialogs": [
				{
					"id": 727310201,
					"content": "HAHAHAHAHAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310202,
					"content": "Keren sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310203,
					"content": "HAHAHAHAHAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "Bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Cara bertarungmu memang beda sekali sama aku, tapi aku bisa memahami kecintaanmu yang luar biasa terhadap Onikabuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310206,
					"content": "Suatu hari nanti, kamu pasti bisa jadi juara sejati di dunia per-adu-kumbang-an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310207,
					"content": "Kamu juga hebat kok! Berhasil menang 570 kali dari 1.141 pertandingan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "Dari semua maraton adu kumbang yang pernah kuikuti, kamu yang paling tahan lama! Asli, Tuan Besar ini terharu, dan kagum juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "Salah, aku menang 571 kali, jadi masih banyakan aku. Lagian kamu unggul karena ini kan tempatmu. Nah, sekarang ketahuan kan, sebenarnya aku yang lebih jago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310210,
					"content": "Ha? Kenapa keras kepala amat sih? Tuan Besar ini ingat jelas skor kita masing-masing. Tuh saksinya, si Mamoru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Aku betul kan, Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Bos ... Aku ... sudah tidak kuat. Tolong lah ... ngantuk ... mau bobo dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Astaga ... mereka main terus tanpa istirahat? Sakit jiwa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Mereka terus main, enggak ada istirahatnya? Gila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "Arenanya bentar lagi rubuh tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Baiklah! Tuan Besar ini terkenal karena sifat derma dan murah hatinya! Satu ronde buat kamu, tidak masalah. Tinggal menang saja lain kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "Dan kalau masih belum puas, setelah ini kita main di tempatmu saja. Intinya SKILL si tukang adu kumbang yang berpengaruh, kali ini lokasi tidak ada hubungannya sama sekali dengan prestasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Boleh saja. Ayo ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310220,
					"content": "Eh? Wah, sohibku tersayang, Lavender Melon Terbang! Akhirnya kalian datang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Sebentar, kenapa Paimon jadi Lavender Melon Terbang lagi? Ke mana larinya si Pembelah Langit dan Bumi? Apa Paimon cuma dikasih nama keren kalau lagi belain kamu doang???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "Eh, jangan dipikirin sekarang lah. Nih, voucher makan ramen gratis selama dua bulan. Ambil, buat kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Voucher ramen apa ...? Oh IYA! RAMEN!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Nah, gitu donggg kali-kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "Waktunya pesta~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Oh, belum belum belum ... Ini baru pemanasan. Lomba Adu Kumbang Arataki yang Paling Seru dan Paling Gila masih berlanjut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Mana ada acara bisa meriah kalau tidak ada penontonnya! Tidak boleh beres cuma begini doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "Kabar baiknya, Grandmaster Hanakado sudah tidak sombong lagi. Dia mengakui kalau Tuan Besar ini petarung adu kumbang kelas wahid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Tapi kami belum selesai ya. Sebentar lagi Tuan Besar ini akan bertandang ke wilayah kandangnya! Dan kekalahan dia pun akan tuntas setuntas-tuntasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Setelah itu, dia akan jadi anak buah Tuan Besar ini. Artinya, dia akan bantu kita bikin Lomba Adu Kumbang Arataki yang Paling Seru dan Paling Gila ini jadi acara yang paling heboh, paling meriah, dan paling keren sepanjang masa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "Terima kasih ya kalian. Sekarang tunggu di sini ya, Tuan Besar ini akan kembali bawa kabar gembira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Si Bapak Gembala kayaknya senang banget ya. Terserah dia lah, pokoknya kita dapat makan ramen gratis dua bulan, hihihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "Semua menang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Bos! BOS! Ada surat dari Kak Shinobu. Baca dulu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Eh? Bos ke mana? Dia barusan masih adu kumbang di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "Urusan penting kah? Si Bapak Gembala barusan banget pergi sama Grandmaster Hanakado. Masih mau lanjut adu kumbang, katanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Yah, tidak penting gimana juga sih. Cuma di luar dugaan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "Baca saja sendiri deh biar lebih jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Hah? Jadi Grandmaster Hanakado itu ... Anggota Geng Arataki? Tapi cara ... ngomongnya? Bikin si Bapak Gembala ngerasa kalau dia lagi menghadapi musuh bebuyutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Sesuai dugaan Shinobu ya. Bapak Gembala ngabisin waktunya main adu kumbang. Enggak makan, enggak rehat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Tapi dia berhasil maksa kita ngadain dan ikutan Lomba Adu Kumbang Arataki yang Paling Seru dan Paling Gila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "Itu sih bukan istirahat namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Kata Paimon sih Shinobu lebih berhak menikmati ramen gratis dibanding kita! Gimana kalau nanti kita ajak dia ikutan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Hmmm, tunggu dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Si Bapak Gembala tadi enggak ada bilang voucher ini berlaku di kedai ramen yang mana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "Apa maksudnya ... kita harus cari sendiri kedai ramennya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Dan yang pentingnya lagi, semua senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "Adu Kumbang Paling Gila: Selesai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Onikabuto-nya juga sudah pingsan kayaknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
			"id": 7273107,
