				7273101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273101",
							"2"
						],
						"stepId": 7273101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273104",
							"2"
						],
						"stepId": 7273104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grandmaster Hanakado",
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "Aku paham. Jadi begitu ya ... Ayo kita bertarung sekali lagi. Kali ini, aku akan baca semua taktik dan mekanikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310702,
					"content": "Kalah menang tidak penting. Pertandingan dan kesenangan, itu saja. Setuju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310703,
					"content": "Jarang sekali dapat lawan yang kuat seperti ini. Rasanya rugi kalau pertarungan di antara kita selesai cuma sampai sini, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310704,
					"content": "Oh JELAS! SINI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "Tapi apa tadi, mau baca semua taktik dan mekanik punya Tuan Besar ini? Ngimpi kau, bocah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "Akui saja kalau Tuan Besar ini yang lebih hebat. Aku ladeni kamu adu kumbang, berapa ronde juga tidak takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Bapak Gembala dan Grandmaster Hanakado kayaknya belum capek tuh. Sudahlah, biarin saja mereka! Terus saja adu kumbang sampai kumbangnya sudah enggak bisa diadu-adu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}