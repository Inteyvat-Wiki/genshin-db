			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "Ugh ... harusnya aku bawa lebih banyak Lakkaberry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Waktu terakhir Lauma di sini ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Halo {NICKNAME}, mau ambil Sajian Purnama ya? Aduh maaf ... itu masih harus tunggu lumayan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Sajian Purnama apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Ah? Bukannya Anda sudah pernah ... Oh, benar juga. Tempo hari Nona Lauma yang mengurusnya, dan mungkin beliau lupa menyebutkan namanya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Singkatnya, Sajian Purnama adalah makanan gratis yang dibagikan oleh Bani Bulan Embun untuk mereka yang membutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Menolong kaum yang kesusahan memang sudah tradisi kami di Bani Bulan Embun, yah, tadinya memang hanya di area sekitaran Pulau Hiisi saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Tapi di bawah kepemimpinan Nona Lauma, juga berkat bantuan semua orang, kami kini sudah berhasil menjangkau daerah-daerah lain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Nona Lauma bilang bahwa kami melakukan ini agar berkat Dewi Bulan dapat menyentuh semua orang, seperti ada tertulis ... ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "\"Buah pertama harus diletakkan di Altar Cahaya Bulan. Bukan untuk para dewa, melainkan untuk mereka yang ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "\"Mereka yang ...\" Duh, mereka yang apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "EHEM, pokoknya, toko ini adalah salah satu corong distribusi utama Sajian Purnama. Hehe, dan aku mengelola nyaris semua urusan di tempat ini seorang diri. Lumayan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "Kami mengalami banyak sekali masalah waktu mencoba membagikan Sajian Purnama di Kota Nasha, tapi aku percaya apa kata Nona Lauma! Yang penting lebih banyak orang yang terbantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Tapi ... kemarin saat menyiapkan bahan masak, aku lupa menutup rapat kotak penyimpanannya. Waktu bangun pagi tadi, aku lihat banyak buah yang sudah dipatuk burung dan tidak bisa dipakai lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "Lakkaberry-nya sisa sedikit sekali, tidak cukup buat bikin Sajian Purnama ... duh, harus gimana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Sepertinya bagi-bagi makanan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
