			"dialogs": [
				{
					"id": 766670401,
					"content": "Sudah cukup! Terima kasih banyak! Mohon tunggu sebentar, aku buatkan Sajian Purnama yang paling lezat untuk Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki bergegas ke dapur belakang dan mulai memasak Sajian Purnama dengan penuh semangat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "Sudah siap, silakan dicicipi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Terima kasih sekali lagi atas bantuannya. Silakan datang ke sini lagi kalau lapar. Aku akan siapkan hidangan khusus untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
