					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "A-Anda mau bantu? Terima kasih! Terima kasih banyak! <color=#00E1FFFF>5 buah Lakkaberry</color>, segitu saja sudah cukup! Sekali lagi, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Setelah buahnya datang, aku akan buatkan Sajian Purnama yang paling enak untuk Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
