			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, kami menemukan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Oke, oke, tenang dulu. Kalian menemukan apa? Apa ada hubungannya dengan keberadaan Zhiqiong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Ini surat yang dia tinggalkan, dia bilang mau pergi lebih dalam ke Chasm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "Terima kasih, coba biar kulihat dulu dia nulis apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu membaca surat Zhiqiong dengan saksama.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Anak ini ... Aku selama ini tidak pernah memikirkan hal yang seperti ini, dan juga tidak pernah mengkritik pilihannya, tapi mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Mungkin saja aku tidak pernah ada waktu untuk memperhatikan setiap penemuannya, dan mungkin saja karena aku juga tidak mencoba untuk memahami dan menghormatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Sudah jelas kalau tidak ada peta darinya, sudah pasti misi ini akan sulit untuk diselesaikan ... namun aku malah terus menerus mengkhawatirkan kesehatannya dan malah mengabaikan hasil dari kerja kerasnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Lagi pula dia kan memang berbeda dari kami yang sudah jadi penambang sejak awal, kenapa aku tidak pernah memikirkan hal itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Dia hanya tidak ingin dilupakan oleh orang-orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Yah bukannya kita semua yang tidak dipandang oleh para dewa memang begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Kita semua sama saja kan ... Tapi apakah ada orang lain yang terobsesi seperti dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Namun saat aku memikirkan untuk menyerah pada semua ambisiku ... saat aku sadar aku sudah terbiasa hidup dengan hari yang biasa-biasa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Aku rasa aku tidak berhak untuk menilai Zhiqiong begitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
