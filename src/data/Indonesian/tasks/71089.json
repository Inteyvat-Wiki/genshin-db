				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Wow, suratnya panjang juga ya. Kayaknya Zhiqiong yang meninggalkan itu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "Oke, ini betulan punya dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Ugh, dia ke mana sih?! Ayo kita kasih tahu dulu apa yang terjadi ke Jinwu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
