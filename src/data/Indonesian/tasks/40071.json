					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "\"Tidak ada satu pun dari masyarakat sekarang yang tahu, tapi para peneliti tahu bahwa Yang Mulia Tuan Putri Fischl von Luftschloss Narfidort turun ke dunia kira-kira 600 tahun sebelum periode orang-orang kudus, itu terjadi pada masa kekacauan dunia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Narator"
				},
				{
					"id": 400710302,
					"content": "Apa? Seorang narator?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Kita benar-benar ada di dalam buku, bahkan ada narator yang menceritakan kisahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Wah, jalannya buntu. Kita enggak bisa lewat nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Ada sebuah perangkat di sana, sepertinya perangkat itu mau agar kita mendekatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "Ini perasaan Paimon saja, atau ... semua yang ada di sini kok kayak yang disengaja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Namanya juga Kerajaan Suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Iya sih, mencolok banget ... seolah memang berharap ditemukan sama orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "Haha! Itu baru namanya Fischl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
