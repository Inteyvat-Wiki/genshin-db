			"dialogs": [
				{
					"id": 400711201,
					"content": "Tidak ada kata-kata yang bisa mengungkapkan betapa bersyukurnya diriku. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
