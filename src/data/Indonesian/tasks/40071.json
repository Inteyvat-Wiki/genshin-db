				},
				{
					"id": 400711202,
					"content": "Ingat, ini adalah kata sandi untuk membuka gerbang: \"Semoga pendudukku dibebaskan dari belenggu aturan lama.\"",
					"roleType": "TALK_ROLE_NPC",
