				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Wah, sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Tunggu, sudah beres ...? Ceritanya kan belum selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "Menyebalkan deh, rasanya seperti seperti waktu membeli tutorial astrologi palsu, atau lupa bawa dompet waktu makan malam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "Arghhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Argh ...! Sangat tidak enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "Kalian berdua tampak kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Sejujurnya, aku juga tidak suka baca buku tidak sampai habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, siapa juga yang suka. Semuanya, ayo kita masuk kembali ke alam fantasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Ide bagus! Ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "Kita masih di sini ... Tidak berfungsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "Aneh, tadi bisa masuk, tapi sekarang kok tidak bisa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Kenapa?! Kita jadi tidak bisa menyelesaikan buku ini! Jahat deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Hmmm ... Apa karena kita sudah sampai di \"akhir buku\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "Sebelum meninggalkan alam fantasi, buku yang kita lihat sudah sampai halaman terakhir. Kurasa, \"Kidung Kerajaan Suci\" ada lebih dari satu jilid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "Ini mirip salah satu teknik pemasaran novel ringan ... \"Penasaran sama lanjutannya? Silakan beli jilid berikutnya!\" Eeeew!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Huh! Aku harus melihat akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Ah, ya, ya, akhir ceritanya ya. Semua orang mau tahu akhir ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Eh? Siapa di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, dia melihatku. Cepat berdiri tegak, berdiri yang tegak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "Siapa kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Aku Arnold, lengkapnya Arnold yang Suka Ditanya Tentang Jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "Namamu spesifik amat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Jadi, Arnold, ada yang mau kutanyakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "Namaku \"Arnold yang Suka Ditanya Tentang Jalan\", bukan Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "Oke. Jadi, Arnold yang Suka Ditanya Tentang Jalan, aku mau tanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Siap, nona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Apa ada jilid lanjutan dari \"Kidung Kerajaan Suci\"? Ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Oh, Anda bertanya pada orang yang tepat. \"Kidung Kerajaan Suci\" adalah buku suci Immernachtreich, dengan total tiga jilid. Dua jilid lainnya disembunyikan di dua dataran tinggi di kota kerajaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Kamu harus pergi ke puncak menara kalau mau mencari jilid keduanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Menara? Menara yang di sana itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Benar, itu tempat penyimpanan buku sucinya. Kalau dilihat lebih dekat ke gua di sana, kamu akan bisa menemukan rahasia yang dapat membawa kalian ke sana dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Baik. Terima kasih, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "Namaku \"Arnold yang Suka Ditanya Tentang Jalan\", bukan Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Nona yang cantik, apakah ada hal lain yang mau ditanyakan? Apa aku punya pacar atau tidak, pendapatan bulanan, atau yang lainnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "Tidak ada, sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Abaikan saja Night Raven itu. Ada jalan rahasia di dalam gua di depan yang langsung menuju ke puncak menara, ayo kita ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Oh, Nona! Anda benar-benar tidak tertarik? Padahal aku bersedia memberi tahu rahasia Immernachtreich karena Anda begitu cantik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}