			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "Kamu sudah bangun belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710202,
					"content": "Uh ... Sudah pagi lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "Jadi? Apa ada sesuatu yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "Kamu pasti enggak percaya, tapi enggak ada yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710205,
					"content": "Kamu sudah bangun? Kita langsung ke kesimpulan saja kalau begitu, kami sudah mencari ke sekeliling, tapi tidak ada yang mencurigakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710206,
					"content": "Kalau berdasarkan dari dua alam fantasi sebelumnya, seharusnya ada benda di sekitar yang berperan sebagai pintu masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710207,
					"content": "Aneh sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Atau mungkin belum waktunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710209,
					"content": "Maksudmu, harus menunggu lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710210,
					"content": "Ya. Lagi pula, Fischl tidak di sini. Aku rasa, dia seharusnya lebih penasaran di mana pintu masuknya dibanding kita semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710211,
					"content": "Kita tunggu saja. Berikan alam fantasi ini ... bukan, berikan Fischl sedikit waktu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710212,
					"content": "Semuanya setuju dengan pendapat Mona untuk beristirahat sebentar. Setelah itu, mereka menjelajahi sekitar dalam 2 grup berbeda.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "Setelah berkeliling beberapa kali dan tidak ada apa-apa, akhirnya ada yang muncul juga di pantai.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "Ada sesuatu di pantai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710215,
					"content": "Sebuah buku? Di sebelahnya juga ada ... eh ... patung burung gagak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710216,
					"content": "Patung ini kok kayak Oz ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710217,
					"content": "Mengapa kedua benda ini muncul bersamaan? Apakah dia yang membawa buku ini ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710218,
					"content": "Apa ini? Sebuah diari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710219,
					"content": "Coba aku lihat ... \"Kidung Kerajaan Suci\"? Aku belum pernah melihat buku dengan nama itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710220,
					"content": "Kalau dilihat dari sampulnya, kok kayaknya ... ini ditulis sama Fischl sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710221,
					"content": "Memang terdengar seperti sifatnya. \"Kidung Kerajaan Suci\", nama yang bagus, aku suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710222,
					"content": "Judul buku ini, memiliki suatu perasaan suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710223,
					"content": "Jadi kita harus gimana? Apa harus kita sentuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710224,
					"content": "Dia masih belum kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710225,
					"content": "Mari kita lanjutkan ke ilusi. Kalau Fischl melihat buku itu, kemungkinan besar dia akan datang mencari kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710226,
					"content": "Paimon setuju! Ini kayak kita ngintip buku harian orang lain, jadi Paimon yakin dia bakal masuk terus menghentikan kita gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
