				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "Eh? Kenapa kita berpindah tempat lagi, tapi kok tidak kembali ke pantai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711402,
					"content": "Sepertinya kita ada di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711403,
					"content": "Salam, Kaiserin der Verurteilung yang terhormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711404,
					"content": "Amy sayang, ibu bikin steak dan Fisherman's Toast, ayo makan selagi panas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Ibu Fischl"
				},
				{
					"id": 400711405,
					"content": "*uhuk*! Ibunda Ratu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711406,
					"content": "Oh, aku lupa! *uhuk*! Prinzessin der Verurteilung, apa kamu tahu sekarang waktunya makan siang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Ibu Fischl"
				},
				{
					"id": 400711407,
					"content": "Tentu saja, Ibunda Ratu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711408,
					"content": "Oh —! Pemandangan di luar sangat bagus, Prinzessin der Verurteilung dan Kaiserin der Verurteilung, apa kalian mau piknik bersama \"Kaiser der Verurteilung\"? Kita akan menikmati pemandangan alam dan masakan yang lezat yang dianugerahkan kepada kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Ayah Fischl"
				},
				{
					"id": 400711409,
					"content": "Ya, dengan senang hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711410,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711411,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711412,
					"content": "Hm ... apakah ada yang mau bicara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711413,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Aku tanya langsung saja. Jadi, \"Amy\" ... itu nama asli Fischl, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711415,
					"content": "Seharusnya iya. Kedua suara tadi sepertinya suara papa dan mamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711416,
					"content": "Kok semuanya jadi lihat aku?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711417,
					"content": "Mungkin sedikit lancang, tapi ... apakah nama belakangmu benar Megistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711418,
					"content": "Huh, kamu meremehkan aku? Nama lengkapku adalah: Mona Megistus, sang ahli Astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711419,
					"content": "Oh, maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711420,
					"content": "Memangnya tidak terlalu panjang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711421,
					"content": "Oh, ini kondisi spesial. Cuma orang jenius yang bisa dapat gelar seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711422,
					"content": "Enggak masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711423,
					"content": "Apa pendapat kalian tentang apa yang baru saja kita saksikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711424,
					"content": "Aku telah memastikan satu hal, \"menutup buku\" juga sebuah cara untuk mengubah alam fantasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711425,
					"content": "Yah, aku rasa orang tua Fischl bersedia mengikuti maunya, itu hebat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711426,
					"content": "Tapi tidak akan seperti itu terus. Ini harusnya ingatan dari masa kecilnya, tidak akan lagi seperti itu saat kamu bertumbuh besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711427,
					"content": "Mona tahu banyak tentang Fischl ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711428,
					"content": "Aku temannya, jadi wajar tahu hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711429,
					"content": "Oh ya ... Di mana Fischl sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711430,
					"content": "Suara tadi bilang kalau dia keluar, bagaimana kalau kita juga keluar dan melihat-lihat, pasti akan ada petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
