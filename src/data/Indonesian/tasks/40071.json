			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Sepertinya di depan jalannya buntu, cuma ada satu buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Yang barusan kita dengarkan, seharusnya cerita dari dalam buku itu bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Karena itu, Kerajaan Suci di judul buku itu mengacu pada Immernachtreich. Buku ini adalah puji-pujian para penduduk kerajaan untuk Nona Fischl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "Juga semacam autobiografi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Sudah sampai ke halaman terakhir buku, tetapi sepertinya cerita mereka belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "Terus habis ini apa nih? Paimon mau dengar akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Kalau begitu ayo terus lanjut mencari. Kita simpan saja bukunya dulu kalau sudah selesai dibaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
