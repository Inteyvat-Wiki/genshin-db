			"dialogs": [
				{
					"id": 220370201,
					"content": "Sebenarnya apa yang menyebabkan jamur-jamur itu muncul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "Aku di sini untuk membersihkan jamur-jamurnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "Apa kamu dari toko Vahid datang ke sini untuk membantuku membersihkan jamur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Hmmm, kalau begitu kuserahkan padamu. Jamur di ladang itu ada terlalu banyak, aku yang sudah tua ini tidak bisa membersihkannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "Kenapa jamur-jamurnya bisa tumbuh secepat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "Maaf jadi merepotkan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Oh, maksudnya jamurnya? Hmm, aku tidak kekurangan jamur sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
