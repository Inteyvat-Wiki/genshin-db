			"dialogs": [
				{
					"id": 220370301,
					"content": "Apa kamu sudah mencabut semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Jamur-jamur yang sudah dicabut ada di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "Cuma ada segini? Seingatku ada lebih dari ini, apa kamu belum mencabut semuanya sampai bersih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "Tapi bagaimanapun aku tetap berterima kasih padamu, anak muda. Barang-barang ini untukmu, anggap saja sebagai imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Tapi, pupuk ini sangat luar biasa, bisa membuat jamur tumbuh sangat cepat. Kalau saja tanaman juga bisa tumbuh secepat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Tunggu ada waktu, aku pasti akan membeli lagi untuk mencobanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
