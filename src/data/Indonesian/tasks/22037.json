				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "Gawat... Kenapa bisa begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "Pengembara, aku sedang mencarimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Kamu masih ingat pelanggan bernama Konda Densuke ini? Beberapa hari lalu dia ke toko, dan bertanya tentang pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Apa dia tidak puas dengan pupuknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "Entah puas atau tidak, tapi kurasa Konda Densuke sepertinya \"bingung\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Bingung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Jadi begini, setelah sebelumnya kamu menjelaskan, Konda Densuke mengaplikasikan pupuk kami seperti yang kamu bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "Meskipun tanamannya tumbuh, tapi... muncul banyak jamur di ladang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "Jujur aku juga agak bingung setelah mendengar perkataan Konda Densuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "Tapi bagaimanapun, hal ini pasti berhubungan dengan pengaplikasian pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "Pengembara, apa bisa minta tolong kamu pergi ke Desa Konda lagi untuk bantu Konda Densuke membersihkan jamur-jamur di ladangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Kalau begitu tolong ya. Aku mau memeriksa informasi di toko untuk melihat apa yang menyebabkan hal itu terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "Ah, alangkah baiknya kalau Alrani ada di sini, dia pasti bisa segera menemukan alasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "Kalau begitu biarkan Alrani yang meneliti masalah ini saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "Kalau Alrani ada di sini, dia pasti bisa segera menemukan alasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "Tapi dia masih belum balik, tidak tahu sebenarnya dia ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "Jadi cuma bisa minta tolong padamu, Pengembara. Aku mau memeriksa informasi di toko untuk melihat apa yang menyebabkan hal itu terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
