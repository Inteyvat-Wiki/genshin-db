			"dialogs": [
				{
					"id": 730552701,
					"content": "Di mana Omid dan Mirsad? Jangan-jangan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Mereka baik-baik saja, tapi ... mereka punya rencana masing-masing dan tidak akan mengikuti kita berbisnis Sumpter Beast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Hah? Kalau begitu kita harus bagaimana dong? Pekerjaan sebanyak ini mana mungkin ditangani hanya oleh kita saja. Kita harus mempekerjakan lebih banyak orang! Tapi siapa yang mau datang ke Desa Aaru ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Sudahlah, kita bahas lagi nanti saja. Cyrus berhasil kembali dengan selamat, itu bagus kan? Dia tidak boleh seenaknya ke tempat bahaya begitu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Ngomong apa sih? Kami ini kan pedagang Sumpter Beast! Kalau Sumpter Beast mogok kerja, terus kami harus makan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Memangnya kita bisa kenyang makan angin? Coba, buka mulutmu di sini! Pasti kenyang penuh pasir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Kita juga tidak bisa membiarkan Cyrus mengambil risiko. Kamu kelihatannya cukup kuat, bagaimana kalau kamu bawa barang-barang kami?",
					"roleType": "TALK_ROLE_NPC",
