			"dialogs": [
				{
					"id": 730552501,
					"content": "Ternyata kalian. Apa ada yang ingin kalian katakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Tentang Jebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "Aku sebenarnya masih meragukan dia sampai akhir. Aku ini memang bajingan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Sekarang, yang kurasakan padanya hanyalah rasa terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Dulu, aku tidak bisa berkomitmen seperti ini. Entah itu dalam hal akademis ataupun hidup ... tapi cukup sampai sini saja! Aku akan menapakkan langkah di jalan yang aku percaya, tak peduli betapa sulitnya itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Itu adalah caraku untuk menghormati Jebrael ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Tentang Raja Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Aku mulai meragukan kredibilitas artikel-artikel yang sudah kubaca dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Doa itu ... rasanya sedikit aneh. Dan kata-kata ... yang diucapkan Samail ... aku harus mempelajarinya lebih lanjut saat aku kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Tentunya misi utamaku adalah tesis, tidak ada perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Tentang Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*huff* Aku berharap aku bisa melakukan sesuatu untuknya, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Aku tidak bisa melakukan apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Dia juga diam seribu bahasa. Kalau saja dia bisa mengucapkan satu impiannya, aku ingin membantunya kalau itu masih dalam batas kemampuanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
