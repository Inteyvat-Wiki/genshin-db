			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "Tunggu, ada banyak jejak di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Pasti ini jejak para penambang itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Ayo kita berjalan ke ujung Lingju Pass. Kalau tidak ada jejak di sana, itu berarti para penambang masih berada di tempat ini. Sedangkan kalau kita menemukan jejak baru, kita bisa mengikutinya ke mana mereka pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Hei! Jejak kaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Sepertinya mereka berjalan melewati Lingju Pass dan terus maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Kalau kita ikuti jejak kaki mereka, harusnya kita bisa tahu mereka pergi ke mana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Halo, apa kamu melihat beberapa penambang di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "...Sepertinya sudah empat atau lima hari lalu. Ada beberapa laki-laki yang lewat sini membawa keranjang dan alat gali. Mungkin mereka adalah orang yang kamu maksud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "Benar! Itu mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "Empat atau lima hari lalu? Sepertinya mereka bergerak lebih pelan dari perkiraan kita. Mungkin mereka kesulitan melewati medan di Lingju Pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "Mereka aneh sekali! Empat pria kekar dengan ekspresi yang kosong... Mereka terlihat seperti sedang kerasukan! Dan di depan mereka ada anak kecil yang terhuyung-huyung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Anak kecil ini... apa kamu lihat dia seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Sekilas saja... rambut biru, tubuhnya pendek. Sepertinya... seorang anak perempuan! Wajah anak itu terlihat serius sekali, tidak ada senyumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "Dan mereka berjalan mengikuti jalan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Betul, mereka terus berjalan lurus dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "Ayo kita kejar mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Monster-monsternya ganas sekali — mereka pasti sadar aku lewat sini! Tanpa kusadari mereka sudah mengepungku... Terima kasih ya telah menolongku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Namaku Wanyu, aku berasal dari Shenglu Hall di Liyue. Aku memimpin penelitian tentang peninggalan budaya dan peradaban manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Eh? Jadi kamu bukan seorang... penambang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "Penambang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Benar. Kita sedang mencari sekelompok orang kekar yang membawa alat tambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "Hmm... sepertinya aku pernah melihat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Benarkah!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Iya. Dua hari lalu aku berangkat dari Nantianmen menuju Lingju Pass. Saat baru setengah jalan aku bertemu beberapa orang — beberapa orang pria dan anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Bisa kamu jelaskan dengan lebih spesifik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Aku sedang terburu-buru, jadi aku tidak melihat jelas. Sepertinya aku tidak yakin mengenai rupa mereka seperti apa... maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Sepertinya itu cukup, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Aku harap informasi itu berguna untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Sebaiknya aku segera pergi, ada sebuah konferensi yang harus kuhadiri. Sekali lagi, terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Berdasarkan kata pelajar tersebut, para penambang menuju ke Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Apa kita yakin mereka adalah orang-orang yang sedang kita cari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Seorang anak dengan sekelompok orang dewasa. Menurut Paimon sih sudah betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Tapi bisa saja itu kelompok orang yang berbeda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Uh... tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Hei, mungkin batu di sana bisa memberi tahu kita sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Aha! Paimon hampir saja lupa kalau kita punya senjata rahasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Sepertinya cukup meyakinkan, akan kucoba sebisaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Sepertinya memang kelompok tersebut. Mereka mengikuti jalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Tuan Kun Jun, kemampuanmu membaca ingatan bebatuan adalah sesuatu yang tidak akan bisa kulupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Aku rasa ini memang bisa dibilang sebuah kemampuan, meski jarang berguna. Tapi pujian dari Tuan Zhongli adalah pujian yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "Untung kita membawa \"kompas Kun Jun\" kita! Kalau tidak kita pasti sudah nyasar dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Hahaha, begitu ya? Kalau begitu setidaknya perjalanan ini tidak sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "Rasanya... kita jadi seperti menyelesaikan kasus kriminal ya. Seru sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Bagaimanapun juga, kita harus tetap waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Empat orang dewasa seperti kerasukan... berjalan siang dan malam... melewati gunung dan lembah... dipimpin oleh seorang anak kecil... Ini bukan kejadian biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Oh! Kamu benar sekali, Tuan Zhongli. Kita memang harus tetap waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Bukan hanya itu. Pelajar itu juga diserang oleh Geovishap Hatchling, tetapi tingkat agresi yang mereka tunjukkan... tidak biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Kita sudah banyak menemukan petunjuk sepanjang perjalanan. Sejauh ini mereka mengarahkan kita ke arah yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Hmmm, para penambang itu menuju Nantianmen dua hari lalu. Dari sini mereka harus melewati jalan pegunungan yang berbahaya. Jika tujuan mereka memang Nantianmen, kita harusnya bisa mengejar mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Bagus! Jangan menyia-nyiakan waktu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Aku meninggalkan tanda di sekitar jalanan barusan. Jika Paman Dai melewatinya, tanda tersebut pasti akan membimbingnya pada kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Pintar juga! Benar-benar gaya Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Penambang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "Ada keranjang yang tergeletak di sini... ini pasti milik salah satu penambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220803,
					"content": "Hei! Halo? Bisa dengar suara kami tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220804,
					"content": "Dilihat dari penampilannya, sepertinya dia pingsan karena kelelahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220805,
					"content": "Haruskah kita membangunkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220806,
					"content": "Aku masih... Aku masih bisa menggali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Penambang"
				},
				{
					"id": 111220807,
					"content": "Eh? Sepertinya dia membisikkan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220808,
					"content": "Sepertinya dia bergumul dengan sesuatu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "Seolah dia berpikir masih ada yang harus dikerjakan. Sepertinya ada sesuatu yang tidak beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220811,
					"content": "Ada kemah di sekitar sini. Kita harus membawanya ke sana dan memantau kondisinya sebelum memutuskan langkah kita berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220809,
					"content": "Sepertinya dia mencoba untuk berdiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "Bagaimana kondisinya? Di-dia tidak akan mati kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Dia terlalu memaksakan dirinya sendiri. Untungnya, kondisinya tidak begitu berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Bagaimana dia bisa sampai kelelahan begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Paimon dengar dia bicara tentang menggali sesuatu. Apa dia terus menggali sampai kelelahan begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "Mungkin saja begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Aneh sekali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Hm? Sepertinya ada sesuatu di sakunya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Apa ini... pecahan bijih batu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Aku baru saja menyaksikan kenangan yang ada di dalam pecahan bijih ini. Orang ini membawa pecahan tersebut dari tempat menambang. Dia salah satu dari empat orang yang sedang kita cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Yang harus kita ketahui adalah kenapa dia ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Jadi dia diculik, lalu... dibuang di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Tapi kalau memang dia tidak diperlukan, kenapa harus repot-repot membawanya sampai sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "Kecuali ada sesuatu yang terjadi... sesuatu yang membuatnya tertinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "Paimon sudah capek! Ini terlalu misterius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "Oh! Tunggu dulu! Melihat pecahan ini membuatku jadi teringat — aku punya sesuatu untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Apa? Ooh! Apakah ini hadiah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Sesuatu... untuk kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Seperti yang sudah kukatakan, sebelum bertemu Paman Dai aku merasa seperti kebingungan. Setelah aku menemanimu dalam kasus ini, aku merasa ingatanku jadi semakin jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Aku senang sekali saat Paman Dai mengutusmu untuk membantu. Jika aku sendirian aku pasti tidak akan bisa melacak petunjuk-petunjuk ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Ini adalah beberapa kristal yang kubeli dari toko. Ini bukan kristal tua biasa — tingkat kemurniannya benar-benar langka! Setiap orang dapat satu. Anggap saja kenang-kenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Indah sekali... Oh — warnanya berubah saat diputar! Jadi seperti kristal yang berbeda kalau dilihat dari sudut yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Terlihat mahal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Iya, tentu saja, silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Dan yang ini untuk Tuan Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Eh? A-apa ada yang salah? Kamu tidak menyukainya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Bukan... justru sebaliknya, aku tidak menyangka akan menerima hadiah pada saat-saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Tapi, terima kasih, aku akan menjaganya dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Aku senang kamu menyukainya. Senang sekali rasanya bisa memberi hadiah yang dihargai oleh orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Aku melihat lebih banyak batu di sebelah sana. Kamu harus banyak istirahat, aku akan berjalan-jalan sebentar — mungkin ada ingatan lainnya yang bisa kuungkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Kamu benar-benar menyukai batu ya, Kun Jun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Bijih adalah kristal bumi, dan merupakan endapan waktu. Aku merasa damai jika berada di antara mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Istirahatlah, dan panggil aku jika kamu siap berangkat. Aku tidak akan jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Dia akan baik-baik saja kan walau sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Tidak perlu khawatir, aku sudah memantau areanya. Tidak ada bahaya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Ah, tetapi ada sesuatu yang ingin kudiskusikan denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Eh? Kenapa tiba-tiba jadi serius begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "Pengembara... Apa kamu tahu soal Dragonfall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Maksudmu bijih yang sedang dicari oleh Kun Jun? Apa yang spesial mengenai bijih batu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "Dragonfall adalah bijih sangat langka yang digunakan untuk menempa. Mayoritas kristal biasa terbentuk di lingkungan bersuhu tinggi. Di sisi lain, Dragonfall terbentuk dari reaksi elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Reaksi elemental bisa menghasilkan objek material?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Betul. Namun, hanya sedikit yang bisa selamat setelah waktu yang lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "Dragonfall pertama kali muncul di tengah-tengah pertempuran hebat, ribuan tahun yang lalu. Bentrokan energi elemental yang kuat melahirkan kristal elemental. Ketika pertempuran berhenti, sisa-sisa geologis ini secara ajaib terawetkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Kereeennn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Namun mereka tetaplah sebuah kristal, sangat sedikit dan langka, relatif tidak dikenali. Beberapa ratus tahun yang lalu, mereka ditambang sampai tak tersisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Lalu kenapa rakyat Liyue sekarang ingin mencari bijih yang sudah lama menghilang dari muka bumi tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "Iya! Kalau dia tahu keberadaannya, pastinya dia tahu dong kalau semuanya sudah ditambang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Aneh... Paimon tidak mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Ada banyak di perdagangan tambang yang tertarik dengan Dragonfall. Tapi untuk seseorang seperti Tuan Kun Jun... yang motif pencariannya tidak jelas walau untuk dirinya sendiri... bisa dibilang tidak pernah dijumpai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Mungkin dia ada maksud tersembunyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "Motif tersembunyi... Eh!? Apa dia penjahatnya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Saat ini kita masih belum bisa membuat sebuah kesimpulan. Lebih baik kita lihat dulu... dan tunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "Jangan lupa, tujuan utama kita adalah menyelamatkan para penambang. Untuk hal lainnya... cepat atau lambat kita pasti akan tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Kita semakin dekat dengan tujuan kita. Menurutku kita harus terus mengikuti jalan ini. Karena kita sudah menemukan satu orang, yang lainnya pasti tidak jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Saat kamu sudah selesai beristirahat, tolong panggil Tuan Kun Jun kemari. Kita masih harus melanjutkan penyelidikan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Kita harus memastikan bahwa penambang ini bisa menetap di kemah ini dulu. Jika masalahnya sudah selesai, kita bisa kembali untuk merawatnya. Sebaiknya kita tinggalkan sebuah catatan untuk Paman Dai. Jika dia menemukan kemahnya dia pasti tahu harus melakukan apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Apa aku benar-benar boleh memilikinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Bukankah dia dibawa ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
