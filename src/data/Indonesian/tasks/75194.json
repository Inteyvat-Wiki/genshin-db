					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "Tunggu, tunggu, ini barang dagangan, jangan disentuh kalau tidak mau beli! Eh ... kamu, yang berambut pirang, tunggu dulu, jangan buru-buru pergi, coba aku lihat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Hmm ... Ternyata benar. Rambutmu terang bagaikan matahari, matamu menatap sedalam Kerajaan Malam ... Aku rasa, tidak, aku yakin kamu akan menjadi orang yang hebat di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "Sini, sini, sini. Aku punya perhiasan giok yang ajaib. Batu-batu itu mengandung berbagai melodi yang berbeda, dan kebetulan melodi itu cocok untuk pahlawan sehebat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "Tapi, ini harta yang tak ternilai. Biasanya aku jual dengan harga lebih dari 10 juta Mora. Tapi aku bisa kasih kamu diskon deh, soalnya kamu kayaknya berjodoh sama batu ini. Diskon 90%. Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Wah! Jadi bayar 10% saja?!? Tunggu dulu ... Berarti harganya 1 juta Mora dong? Kayaknya ... Agak mahal ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Yah, mau bagaimana lagi. Ini sudah murah kak. Kami kan cuma rakyat jelata yang coba berdagang, kasihanilah kami kak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "Dapat duit kok caranya begitu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Kedengaran sama kamu ya. Ahaha, mulutku memang enggak ada obatnya deh, suka ngomong sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "Huh ... karena sudah ketahuan, aku jujur deh. Aku menemukan giok ini tanpa sengaja. Sebenarnya harganya tidak setinggi itu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Tapi, apa yang bisa aku perbuat. Kamu juga sudah dengar, kami kekurangan dana, bahkan kami tidak bisa bayar orang untuk kumpulin data dari pelampung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "Kalau begitu tidak perlu dikumpulin saja! Ngapain sampai pakai nipu-nipu segala?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Tidak bisa ... Untuk organisasi lain, kekurangan dana ya tinggal stop beroperasi saja, tapi organisasi kami masih punya misi untuk mengamati gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Kami pakai pelampung untuk mengumpulkan data suhu air dan data lainnya untuk mendeteksi aktivitas gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Saat ini, aktivitas gunung berapi makin meningkat, jadi pengumpulan pelampung juga harus dipercepat, kalau tidak, pasti bakal ada masalah besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Sayang aku terluka, dan tidak bisa hancurkan pelampungnya, apalagi kumpulin data di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#Gimana menurutmu, {NICKNAME}? Mau bantu dia? Soalnya gunung berapi ini kan ngaruh ke keselamatan semua orang. Kayaknya enggak mungkin dibiarin gitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "Be-benarkah? Kalau kalian bersedia bantu aku, aku akan berikan giok ini secara gratis! Anggap saja sebagai bayaran kalian, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Kamu tadi bilang satu juta Mora, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Tenang saja, walaupun jumlahnya tidak banyak, tapi selain giok ini, pasti ada hadiah tambahan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Hehe! Sudah cukup kok! Kali ini kami bantu karena khawatir sama keselamatan semua orang! Jadi tenang saja, kami yang urus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Sekarang saja, gas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Bentar, siap-siap dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Oke, kapan pun kamu mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Jadi cuma dapat ... giok ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Jadi, kerjaan apa yang harganya satu juta Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
