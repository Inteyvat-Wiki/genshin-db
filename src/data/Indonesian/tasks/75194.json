					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Huff, untung saja. Kalau dilihat dari hasilnya, situasi gunung berapi tidak seburuk yang dibayangkan. Berarti semua orang bisa tidur nyenyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "Terima kasih banyak. Kalau kalian tidak bantu, mungkin tidak akan selancar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Tolong terima imbalan ini sebagai permintaan maaf dan tanda terima kasih dariku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hahaha. Yah, kalau kamu sudah ngomong begitu, kami enggak sungkan-sungkan lagi ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Rencanamu selanjutnya apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Aku masih punya beberapa barang tumpukan. Kalau aku diolah sedikit, bisa jadi dana deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Haha, tentu saja, kali ini tidak mendesak, jadi aku akan berbisnis dengan jujur, kalian tenang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
