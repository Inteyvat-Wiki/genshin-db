					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Sepuluh ... Dua puluh ... Oooh! Dapat uang banyak! Keuangan akhir-akhir ini harusnya sudah lumayan sehat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Tidak mau cari uang lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "Haha, tidak deh. Sudah cukup untuk sekarang. Kalau tidak ada kalian yang bantu aku, aku pasti sudah kena ampas karena batu giok itu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Lagian, setiap hari cuma duit duit duit saja, bosan juga. Cari cuan itu cuma hobiku, kehidupanku yang sesungguhnya itu mengamati gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Uang sih bisa didapat lagi. Tapi kalau karena kelalaian kita, orang-orang ini yang harus jadi korbannya ... Kerugiannya terlalu besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Memangnya Balai Majelis tidak kasih dana ke kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Kami tidak ajukan sih. Soalnya, dengan berbagai masalah, pemimpin Balai Majelis pasti sudah pusing. Mana mungkin aku menambah beban mereka untuk saat-saat kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Tapi, aku dan teman-temanku itu berbeda. Biasanya, kami juga berkelana ke sana kemari sambil cari uang untuk biaya perjalanan. Jadi kami sudah terbiasa dengan kehidupan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Mengamati gunung berapi selama perjalanan bukan hal yang sulit kok, sama seperti kalian sering membantu orang yang kesulitan, mudah saja kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Sampai jumpa, hehe. Kalau jodoh, kita bakal bertemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
