			"dialogs": [
				{
					"id": 741870701,
					"content": "Ya sudah. Benar katamu. Semua yang kami lakukan memang harus dipertimbangkan lagi. Tapi aku juga tidak tahu kenapa bisa begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870702,
					"content": "Aku tidak tahu kenapa, tapi sejak perang ini pecah, ada perasaan yang aneh dalam hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870703,
					"content": "Kami sih mau mengejar kebebasan dan kebahagiaan, tapi Phobos malah bimbing kami ke sini selangkah demi selangkah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870704,
					"content": "Apa ada yang salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870705,
					"content": "Kalau kalian bertemu dengan Sebastos setelah kembali, tolong beritahukan kepadanya keadaan dan keraguan hati kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870706,
					"content": "Mohon bantuannya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870707,
					"content": "Jangan khawatir, bakal kami bantu sampaikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
