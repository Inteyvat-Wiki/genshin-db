			"dialogs": [
				{
					"id": 741870201,
					"content": "Heh, dasar bodoh! Kenapa harta karunnya masih banyak begini di sini? Mau tunggu sampai kapan selesainya? Sampai tua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870202,
					"content": "Bukan begitu, bos! Harta karun yang ini beratnya minta ampun. Kami sudah pindahkan seharian, tapi masih banyak sisanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Ia yang Dipanggil \"Si Bodoh\""
				},
				{
					"id": 741870203,
					"content": "Kepala besarmu itu buat apa, hah! Namanya juga harta karun, wajar kalau berat dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870204,
					"content": "Lagian semua harta karun ini kita \"sita\" dari orang barbar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870205,
					"content": "Heh. Sayang banget lah kalau kita tinggalkan harta seperti ini di tangan serangga-serangga yang hidup seperti babi dan anjing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870206,
					"content": "Tapi, kalau kita mau angkut semua harta ini balik ke Remuria, rasanya perlu minta atasan kirim beberapa kapal lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Ia yang Dipanggil \"Si Bodoh\""
				},
				{
					"id": 741870207,
					"content": "Kamu ini, bodoh ya? Kapal angkutan imperium tidak boleh dipergunakan untuk hal seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870208,
					"content": "Kalau begitu hancurkan saja sisanya! Lebih bagus daripada jatuh ke tangan orang-orang barbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Ia yang Dipanggil \"Si Bodoh\""
				},
				{
					"id": 741870209,
					"content": "Hmm, kok Paimon berasa pernah dengar percakapan ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Waktu kita pertama sampai di Petrichor ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Betul juga. Bukannya petualang yang kita usir sebelumnya juga bilang hal yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "Terus kayaknya yang kali ini bahkan lebih keterlaluan dari sebelumnya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Apa mungkin mereka berubah jadi golem setelah kapal mereka tenggelam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Hih serem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Kalian dari Legio IX ya? Kenapa ada di sini? Kalian sudah diperintahkan untuk mundur ke Benteng Charybdis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Eh, Este! Jangan bikin kacau ya, bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870218,
					"content": "Ngurus orang-orang barbar ini lebih mudah lah daripada sama ikan mati, jadi tidak masalah lah kalau kami main-main lebih lama di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870219,
					"content": "Barang-barang ini ... Hmm, aku tidak tahu apa perintah Harmost kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Tapi bukankah Sebastos agung telah memerintahkan kita untuk menundukkan suku-suku barbar dan membebaskan mereka dari jeratan takdir? Sepertinya dia tidak memerintahkan ... melakukan perbuatan kriminal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Hah? Pemimpin kami, Dominus Boethius memerintahkan agar orang-orang biadab ini dihukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870222,
					"content": "Lagi pula kami juga tidak dijatuhi hukuman apa pun, berarti \"Phobos\" dan Sebastos agung sudah setuju dengan tindakan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870223,
					"content": "Apa maksudnya ungkit-ungkit soal tindakan kriminal, hah? Mau cari masalah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870224,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Este-nya ada dua? Kok makin ngaco saja sih ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Sepertinya sekarang waktu yang tepat untuk menjawab pertanyaan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "Este yang kalian temui di kota sepertinya keturunan Remuria. Nenek moyangnya ikut aku bergabung dengan bangsa baru Fontaine, lalu menjadi orang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "Jadi, \"simfoni\" yang hanya merenggut jiwa orang-orang Fontaine tidak akan memengaruhinya. Sebaliknya, melodi yang merekam ingatan leluhurnya melekat pada patung itu karena tidak ada tempat lain untuk dituju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "Jadi Este yang ini tuh nenek moyangnya Este yang di kota? \"Este si Cerdik\" yang asli? Terus yang lainnya siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Cuma jiwa biasa yang terjebak, tenggelam dalam ingatannya. Mari kita coba lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Kalian berjalan bersama Monsieur Os ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Halo, Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Oh, halo. Mohon maaf, kalian siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Rasanya kalian bukan orang Remuria. Anggota suku barbar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "Aku cuma pengembara yang kebetulan lewat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Um, ini medan perang, bukan tempat yang aman. Siapa pun kalian, tolong pergilah dan tinggalkan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Ini aku, Este. Lama tak jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "Demi langit segala langit, Dominus Cassiodor! Aku hampir tidak mengenali wujud Anda, Dominus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "Kedua orang ini ... abdi Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "Anggap saja iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Dominus, mengapa anda kemari? Bukankah Sebastos agung mengirim Anda ke ... Terkutuklah! Aku tidak ingat! Apakah ini mimpi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Kelihatannya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Haha, Anda pandai bergurau, Dominus! Aku asumsikan Sebastos agung telah memberi Anda misi rahasia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Betul. Ngomong-ngomong, kenapa prajurit-prajurit Legio IX melindungi rantai itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "Rantai ... Maksud Anda harta karunnya? Itu hasil jarahan perang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Sebastos agung memandang perang sebagai sesuatu yang perlu demi menunaikan amanat agung, biarpun demikian memilukannya ... beliau melarang perilaku brutalisme tak pandang bulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Tapi Anda juga tahu hal seperti ini sudah lumrah sekarang ... tanpa disadari, kita semua menapaki jalan menuju kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Dominus Cassiodor, sebenarnya apa yang terjadi? Phobos seharusnya membawa kebahagiaan, tapi aku merasa kesakitan ... yang entah apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Aku juga sedang mencari jawaban dari pertanyaan ini. Tapi sepertinya kita harus mengatasi masalah yang ada terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Ya. Tapi bagaimanapun, mereka adalah anggota legiun kita! Mari selesaikan dengan cara damai, jika Anda berkenan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "Aku ini majikannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Eh, eh, {NICKNAME}, jaga sikap ya. Jangan bikin situasinya makin ruwet ah! Dia cuma bercanda kok, Este. Silakan, lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Oh, kamu belum tahu yang namanya barbar kalau belum kenal aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "Kita kan pernah ketemu juga sama \"Treasure Hoarder\" ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
		{
			"id": 7418706,
