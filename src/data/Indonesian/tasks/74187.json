			"dialogs": [
				{
					"id": 741870901,
					"content": "Ah, sepertinya masalah yang tadi sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Berarti sekarang tinggal melanjutkan, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Iya. Aku serahkan urusan di sini padamu, Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "Dan ingat untuk ikuti hati nuranimu sendiri daripada andalkan Phobos atau Harmost mana pun untuk menilai mana yang benar dan salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "Sebastos menciptakan Phobos untuk membebaskan kita dari jeratan takdir, tapi kefanatikan menjerumuskan kita dalam perbudakan yang lebih mengerikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "Di masa depan, kamu mungkin akan menghadapi pilihan yang serupa lagi. Tapi kuharap kamu bisa membuat keputusan yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Dominus Cassiodor, kenapa Anda tiba-tiba membicarakan hal seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Aku akan selalu mengingat kata-kata Anda. Aku, Este, akan berpegang teguh pada keadilanku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Baguslah. Kalau begitu sampai jumpa, Este. Aku yakin kita akan bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
