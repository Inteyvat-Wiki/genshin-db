			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ehem, prajurit dari Legio IX.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "Hah? Siapa kalian? Pembantunya Este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870603,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Kami bukan pembantu! Kuatlah dia yang berjalan bersama Dominus Cassiodor, melayaninya serta membukakan jalan baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "(Sepertinya kalian berdua punya bakat akting ya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Hmm ... Dominus Cassiodor? Kudengar Sebastos agung mengutusnya ke Aremorica. Beliau sudah kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870611,
					"content": "Sebenarnya yang di sebelah kami ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "Duh. Intinya kami datang buat periksa situasi legiun garis depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Sesuai dugaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870615,
					"content": "Maksudnya, kami masih belum pergi ke Benteng Charybdis bareng pasukan utama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870616,
					"content": "Tapi melakukan \"pembersihan\" terakhir sebagai pasukan barisan belakang masuk akal juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870617,
					"content": "Apa ini juga perintah Phobos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Ini ya ... Phobos harusnya memandu kami dalam segala hal. Tapi sejak datang ke sini, sering kali kami tidak dapat mendengar alunan melodinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870619,
					"content": "Karena itulah kami mundur, sesuai perintah Dominus Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870620,
					"content": "Oh, si enggak sopan itu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Hei! Kamu pikir kamu siapa? Berani-beraninya menghina Dominus Boethius secara terang-terangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870622,
					"content": "Harmost yang terhormat bertindak sesuai kehendak Sebastos agung dalam segala peristiwa. Ucapannya senada dengan melodi Phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870626,
					"content": "Ya mungkin Phobos juga bisa salah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Apa kamu betul warga Remuria? Tak tahukah kamu bahwa Phobos diciptakan oleh Sebastos yang mahakuasa dengan bantuan peramal yang tak mungkin salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870628,
					"content": "Tapi kan kalian juga belum terima melodinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Yah, memang benar sih. Tapi selain Phobos, kami bisa percaya apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870630,
					"content": "Kalau memang kami ada di jalan yang salah, apa mungkin dia akan tinggal diam saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870623,
					"content": "Sebastos tidak mengizinkan orang-orang tidak bersalah dilukai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Tak bersalah ...? Ya, perintahnya memang agar kita membantu manusia-manusia lemah ini sebelum perang pecah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870625,
					"content": "Tapi sekarang gerakan kami juga sudah disetujui oleh Phobos. Apa perintah Phobos bisa berbeda dengan kehendak Sebastos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Pemimpin Grup"
				},
				{
					"id": 741870605,
					"content": "Kami adalah utusan khusus Sebastos agung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Sejak kapan ada jabatan kayak gitu? Yah enggak salah juga sih. Kami orangnya Dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "Kami mengabdi kepada Dominus Cassiodor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "Betul! Kami ini abdinya Dominus Cassiodor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
