			"dialogs": [
				{
					"id": 765100101,
					"content": "... Sekarang sudah bisa dibuktikan kalau ini bukan senjata militer rahasia, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Hm, benar juga. Sekarang tinggal dibuat lebih sulit dikit biar bisa dimainkan orang dewasa juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Wah! Suasananya serem lagi nih, tegang banget kayak bakal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Sepertinya mau berantem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Ya ... selagi {NICKNAME} ada di sini, bagaimana kalau kita minta dia buat jadi wasit? Biar adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "Ah, kenapa kamu begitu terobsesi sih? Jangan-jangan karena waktu itu kamu kalah telak dariku ya? Kalau memang itu alasannya, ayo kita duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, lihat saja nanti, siapa yang akan menyerah duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Huh, tidak ada gunanya kalau cuma bisa omong besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler kelihatannya lebih kuat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Waaah! Mereka bukannya cuma latihan doang ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Kamu masih bisa menyerah sekarang, aku beri waktu tiga detik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Tiga, dua, satu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Wuaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Terdengar bunyi \"klik\" logam yang nyaring, lalu semuanya kembali sunyi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "Baiklah, Paimon, kamu sudah bisa buka mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "Sepertinya, yang paling \"tegang\" di sini itu cuma kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "A-Apa? Wislawa, kamu baik-baik aja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler hanya menakut-nakuti Wislawa saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Tentu saja. Aku tidak mau masuk penjara di tempat asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Aku terpaksa pura-pura berani dan menggertak, supaya dia tahu kalau aku bukan pedagang lemah yang bisa dimanipulasi seenaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "Jadi kalau ketemu lagi, dia tidak akan berani cari masalah denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Tapi, gimana {NICKNAME} bisa tahu sih? Kamu enggak kelihatan gugup sama sekali loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "Ekspresi Edler terlalu santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "Kamu memang peka sekali. Intimidasi adalah cara tercepat untuk membuat orang menyerah. Tapi sayang, mengambil jalan pintas tidak semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Apalagi ada {NICKNAME} di sini ... Pokoknya, sekarang aku masih berdiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "Tapi saat kita ketemu lagi nanti, semoga ada kesempatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Jangan begitu, orang kecil sepertiku tidak punya banyak kesempatan untuk bertemu dengan orang terhormat seperti kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Kalau lain kali kita ketemu saat kamu sedang tugas dan kamu mau melakukan sesuatu padaku, aku terpaksa harus membela diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Tapi kalau kita ketemu saat kamu sedang cuti, kita bisa main simulasi perang. Anggap saja kamu sedang membantu usahaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "Edler bilang sendiri, ini soal \"siapa yang akan menyerah duluan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "Tidak ada peluru di dalam senapannya kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa kelihatannya lebih tinggi dan besar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}