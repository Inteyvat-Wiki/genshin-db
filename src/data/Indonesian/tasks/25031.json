			"dialogs": [
				{
					"id": 250310101,
					"content": "Gawat ... Benar-benar gawat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "Ada yang salah dengan pelatihan Alem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}! Untunglah kamu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "Tidak ada waktu untuk menjelaskan. Tolong bantu aku menyelamatkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "Dia temanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "I-Iya bisa dibilang begitu. Kami berdua pernah galau bareng, nangis bareng soal skripsi di perpustakaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "Aaaah, sekarang bukan waktunya jelasin hal itu! Dia sama sekali tidak mau mendengarkanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Katanya dia akan melakukan apa pun demi skripsinya, terus langsung pergi bawa pengawalnya, ngoceh soal alam liar segala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "Tapi dia masih belum kembali juga! Terus suku kami tidak punya orang untuk pergi menyelamatkan dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}, tolong selamatkan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Serahkan padaku, biar aku yang urus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#Tolong bantu aku, {NICKNAME}! Aku mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Duh kalian orang-orang Akademiya benar-benar deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Dia ... *huff* Aku cuma bisa bilang kalau dia memang punya keberuntungan yang luar biasa. Waktu kami datang ke Natlan, dia bahkan bilang mau melakukan upaya terakhir demi skripsinya itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "Dia kenalanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
