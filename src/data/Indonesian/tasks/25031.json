			"dialogs": [
				{
					"id": 250310401,
					"content": "Terima kasih banyak atas bantuanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Kalau aku bisa urus sendiri, pasti sudah kuurus dari kapan hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Tidak! Kalau begitu sia-sia saja kita datang ke Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Tunggu, kamu ... Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Hah? Ka-Kamu {NICKNAME}, kan?! Betulan kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Nona di sebelahmu ini, dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam. Treasure Hoarder. Kita pernah bertemu sebelumnya. Kamu pasti belum lupa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "Fyuh ... Kamu memang penyelamatku! Entah sudah berapa kali kamu selamatkan aku ya? Satu kali, dua kali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Jangan hitung waktu kamu bareng aku. Itu kan karena kamu sendiri yang maksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Iya aku tidak hitung kok. Dan apa maksudmu aku yang maksa? Aku kan sudah bayar kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Iya, tapi cuma cukup buat makanan sama minuman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Jangan bilang kamu ke sini demi skripsimu lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Hehe, yah ... karena sudah banyak sekali usaha yang kucurahkan pada skripsiku, aku pastinya tidak bisa membiarkannya begitu saja kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Aku bahkan sudah minta pendanaan khusus dari Akademiya kali ini, bahan penelitianku bahkan langsung disetujui tanpa adanya hambatan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Lagian, kan ada Narzam di sini sebagai pengawalku. Dia jago ngusir semua penjahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Mungkin karena kita juga tidak bawa barang berharga yang layak mereka rampok juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Tapi pada akhirnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "Dia ini ya, dari Putra-Putri Gema sampai ke sini nih, terus saja memegang erat tasnya itu, sudah kayak megang anak sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Kalau kata aku sih dia kelihatan kayak orang bodoh yang lagi pegang harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Terus orang bawa harta karun, jalan di alam liar cuma ditemani satu pengawal ... Siapa coba yang tidak tergiur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Kamu benar sih ... Tasku ini isinya memang harta karun! Tidak cuma soal catatan wawancara dari berbagai nara sumber tapi juga banyak dokumen berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Kalau bawa harta karun begini, skripsiku pasti bakal lancar jaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "Dan topik pilihanku ini — \"Ziarah Kembalinya Api Keramat\", adalah topik yang sangat penting dan menarik, jadi aku pasti bisa lulus kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Oh, tentu saja ini semua ide Kak Tahmures. Tidak salah deh dia jadi teman baikku, hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Terima kasih sekali lagi ya, {NICKNAME}. Kalau tidak ada kamu, orang jahat itu pasti bakal rusak bukuku dan rampok uangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Tidak lama ini, aku bantu orang merapikan buku dan informasi untuk bisa dapatkan uang. Kalau sampai dirampok sih, aku tidak tahu harus pakai uang apa untuk beli bahan baru lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Tapi, akhirnya kamu bakal tetap pakai semua uang untuk beli buku. Kalau dompetmu tidak aku sita, kita sudah mati kelaparan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "Aku ... tidak beli buku sebanyak itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Ya sudah, cukup ngobrolnya. Kita sekarang kumpulin bahan di Warga Mata Air dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Ya sudah, dadah. Nanti kalau kita ketemu lagi, skripsiku pasti sudah selesai. Pas itu aku akan traktir kamu makan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Kamu tetap saja ketemu masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
