					]
				},
				{
					"id": 250310504,
					"content": "Huff ... Buat khawatir saja. Kalau kamu tidak kembali lagi, aku bakal cari sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
