			"dialogs": [
				{
					"id": 721690201,
					"content": "Bagaimana Pengembara, apa kamu mendapatkan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Oho! Kepiting ini sepertinya lumayan. Ternyata kamu hebat juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Baiklah, karena semua bahan sudah lengkap, aku akan mulai memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "Pengembara, tunggulah sebentar, biar kusiapkan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
