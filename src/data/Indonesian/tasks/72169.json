			"dialogs": [
				{
					"id": 721690301,
					"content": "Roe Kourayaki... kenapa dinamakan Roe Kourayaki ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690302,
					"content": "Sudahlah, biar kumasak saja dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690303,
					"content": "Selesai! Sambutlah \"Crab Roe Kourayaki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690304,
					"content": "Aku mau satu! Hmmm... yang ini saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690305,
					"content": "Aku mau yang kecil saja, yang besar aku tidak sanggup menghabiskannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690306,
					"content": "Oh, Pengembara, yang ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690307,
					"content": "Aku juga sudah mencatat resep \"Crab Roe Kourayaki\" ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690308,
					"content": "Masakan ini tidak terlalu sulit, cobalah buat sendiri kalau kamu ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690311,
					"content": "Selanjutnya kita akan pergi ke sekitar <color=#00E1FFFF>Yashiori Island</color>. Kalau kamu senggang, cari kami saja di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690309,
					"content": "Baiklah, aku juga mau coba rasanya dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690310,
					"content": "Hei! Julie! Sisakan buatku, jangan dihabiskan semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
