					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Nama makanan ini sungguh sesuai dengan karakter Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "Ya, pertama kali melihatnya kupikir ini kuliner khas Mondstadt, ternyata ini makanan khas lokal Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Namanya terdengar indah, pasti rasanya juga enak, ini semua berkat kamu, Xudong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "Kita bertemu lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "Woah! Pengembara, hehe, sudah kubilang kita pasti bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong baru saja mendapat resep baru dari kota! Namanya \"Crab Roe Kourayaki\", bagaimana, apa terdengar indah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Makanan ini tidak sulit dimasak. Tapi butuh banyak Crab...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Aku sudah ada beberapa Crab biasa, sekarang sedang menyiapkan beberapa... Special Crab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Special Crab?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Betul, Crab yang bersarang di bawah pohon Thunder Sakura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Bilang saja... Crab yang tersambar petir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Hahaha, pokoknya aku penasaran sekali, Crab yang hidup di tempat semacam itu... apa rasanya kalau dimakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Tapi... karena petir tidak henti-hentinya menyambar di sekitar pohon Thunder Sakura, kami jadi tak berani mendekat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Di buku tertulis... Sama seperti sebelumnya, kita harus menyentuh Thunder Sakura Bough, agar Electrogranum bisa melekat ke tubuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "Dengan begitu, kamu tidak akan bisa tersambar petir di sekitar pohon Thunder Sakura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Tapi kamu bisa lihat sendiri petir yang menyambar di sekitar pohon itu, meski di buku tertulis dengan jelas, aku tetap tidak berani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Tapi asal bisa lari dengan cepat, harusnya tidak masalah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Kamu ini... Memangnya kamu bisa lari lebih cepat dari sambaran petir?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Jadi kita di luar saja, coba pancing kepitingnya keluar dengan ranting pohon atau apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "Menurutku, lebih baik kita gali saluran saja di sekitar sini, supaya bisa menarik keluar air dan Crab-nya sekalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahaha... Pendapat kalian sangat berbeda, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "Pengembara, kalau kamu mau, kamu bisa coba menangkap Crab di sekitar pohon Thunder Sakura itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Kalau berhasil mendapatkannya, berikan padaku, akan kubuatkan untukmu masakan yang lezat darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Oh iya, tunggu sebentar... umpan ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Kalau kamu mau pergi menangkap Crab, pakai umpan ini untuk menarik mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Jadi, kamu tidak akan terlalu kerepotan saat menangkap Crab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Crab yang hidup di sekitar pohon Thunder Sakura... uh, entah seperti apa rasanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Apa ada makanan lezat lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
