					"content": "Sekarang aku akan mengajarkanmu resep <color=#00E1FFFF>Sticky Honey Roast</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Eh tunggu, bukannya kamu bilang itu menu kebanggaanmu, terus kamu mau mengajarkan itu pada kami begitu saja?",
					"roleType": "TALK_ROLE_NPC",
