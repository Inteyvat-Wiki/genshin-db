					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040202,
					"content": "Kamu lagi baca buku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Eh. Kakak datang cepat juga ya. Aku baru saja buka bukunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040205,
					"content": "Ayah Lovi yang suruh Lovi kasih buku ini ke aku. Katanya kalau ada bagian yang bingung langsung tanya saja ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040206,
					"content": "Tapi jujur ya ... Heh. Tidak ada satu pun yang di buku ini yang aku \"ngerti\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040207,
					"content": "Ya sudah deh, aku kembali ke tempat kumpul dulu. Toh aku memang sudah ketahuan, tetap harus ikut aturan mainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040203,
					"content": "Kamu benar-benar senang belajar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
