			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Kak, sembunyi di sana yuk. Pasti lebih oke dari pilihan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Verut, jangan pergi jauh-jauh! Kalau kamu sampai hilang, aku tidak bisa langsung cari kamu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040103,
					"content": "Ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Waaah! Kakak! Sekarang Kakak lagi kosong? Ayo ikutan petak umpet! Lovi sudah sembunyi dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Tentang Lovi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Nanti saja kukenalkan! Ayo cepat! Dia sudah hafal banget sama tempat ini ... kita harus cari tempat lain buat sembunyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut pun pergi dengan cepat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "Aduh Verut ini ya ... kapan sih dia bisa nurut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040110,
					"content": "Maaf ya, jadi harus temani kami main sekali lagi. Entah kenapa Verut semangat banget hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040111,
					"content": "Dapat teman main baru kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Aku sependapat. Tapi asal dia senang saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040113,
					"content": "Semoga dia tidak jadi terlalu semangat terus ikut-ikutan Lovi sembunyi di tempat aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040118,
					"content": "Kakak, kalau gitu tolong main sama kami sekali lagi ya. Maaf jadi ngerepotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040119,
					"content": "Aku juga harus cari tempat sembunyi, kalau tidak nanti Verut ngambek. Kalau dia sampai nangis, aku juga yang kebingungan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040120,
					"content": "Aurele pun pergi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Tentang Lovi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Anak perempuan yang kami baru kenal juga. Dia lihat kami main petak umpet, terus dia jadi mau ikutan main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040116,
					"content": "Kepribadiannya mirip Verut. Mereka cocok, sangat kompak, bisa nakal bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040117,
					"content": "Tapi kayaknya ayahnya tidak punya waktu buat temani dia main, sama kayak kami berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040104,
					"content": "Kalian masih main petak umpet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
