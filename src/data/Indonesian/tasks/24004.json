			"dialogs": [
				{
					"id": 240040501,
					"content": "Kenapa kalian berdua lihat aku kayak gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040502,
					"content": "Kakak ini ... lagi cari tempat sembunyi buat baca buku ya? Enggak serius main sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Iya nih, kan jarang-jarang bisa main bareng. Yang serius dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Habisnya tempat-tempat yang bagus sudah kalian ambil. Aku juga enggak jago main petak umpet, jadi aku baca buku saja untuk menghabiskan waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040505,
					"content": "Ah! Kakak tukang bohong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Huh! Kutu buku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Hah? Duh seriusan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040508,
					"content": "Kalian maafkan dia deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Hehehe, Lovi jago deh main petak umpetnya, dia tahu banyak tempat-tempat seru buat sembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Hehehe, seru memang kalau ada Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut jago manjat tembok. Dia cepat, tenaganya juga gede. Dia sering bantu angkat aku naik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Kalau kami kerja sama, kayaknya selain Kakak, enggak bakal ada yang bisa nemuin kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Oke, sudah cukup ya mainnya hari ini. Lovi, kita anterin kamu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurele"
