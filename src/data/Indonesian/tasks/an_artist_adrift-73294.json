		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Kacau, kumuh amat! Yang ginian kamu sebut kemah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Tapi pemandangan di sini bagus, lalu kalau jalan ke pantai rasanya lapang sekali. Jujur saja lebih enak di sini daripada waktu aku di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Hidupmu di Fontaine tuh kayak apa sih sebenarnya? Kok kayaknya beda sama kehidupan seniman terkenal di bayangan Paimon ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Sejujurnya, rumahku di Fontaine sangat kecil. Aku bukan tipe yang suka pamer ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Masalahnya, kemah petualang saja jauh lebih bagus dari ini. Eh? Ini ... mana hewan peliharaanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Em, aku tidak punya. Mungkin ini bekas petualang yang pernah diam di sini. Oh ya, omong-omong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Aku sih inginnya menyambut kalian lebih baik lagi, tapi sebagian besar barangku tenggelam waktu rakitku hancur. Aku juga tidak bisa berenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Tapi kalau kalian bisa bantu menemukan barang-barangku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "Sudah basah kuyup apa masih bisa dipakai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Semuanya sudah dibungkus rapi sih, tapi ada beberapa barang yang .... Yah, kalau sudah hilang, ya sudah. Aku bisa gambar ulang ... ya, gambar ulang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#{NICKNAME}, kita bantuin saja yuk? Kayaknya dia kasihan banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Tidak ada yang bisa kumintai tolong, terpaksa aku harus merepotkan kalian. Biar aku tunggu di sini sambil bikin teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
