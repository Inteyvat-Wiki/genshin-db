					"Anjing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Aneh ya, kenapa bisa ada anjing di sini? Dan dia kayak lagi jagain sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Memandang dengan was-was.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732941003,
					"content": "Anjing pintar nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Menggonggong kecil.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732941007,
					"content": "Oh iya, kita ada lihat mangkuk makanan di kemah Julien, kan? Mungkin itu buat anjing ini ya. Tapi aneh, Julien bukannya bilang dia tidak bawa binatang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*kaing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732941009,
					"content": "Anjing itu berlari ke arah kemah ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Eh, dia lari .... Nanti kita coba tanya si Julien. Sekarang ... Paimon lebih penasaran sama gundukan pasir ini. Periksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "Ini anjing liar dari mana lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Menggeram kecil.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
