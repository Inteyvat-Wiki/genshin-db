			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Kelihatannya dia enggak baik-baik aja deh ... Kelaparan? {NICKNAME}, mau kasih dia makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Semoga beres makan tenaganya balik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "Bukannya bias atau lagi baik nih, tapi kata Paimon makanan buatan kamu itu enak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Kamu memberikan Teyvat Fried Egg kepada orang yang terkapar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "A-Aku ... aku hidup kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Wuah, dia pasti kelaparan banget ya. Padahal cuma dikasih telur ceplok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Ah, sungguh kenikmatan tiada tara, bahkan mampu menghidupkan kembali! Kalau tahu telur ceplok bisa seenak ini, harusnya kubeli saja telur misterius dari orang tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Telur misterius apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Katanya telur itu bisa menangkal bala sepanjang hari. Harusnya beli satu ya ... atau selusin sekalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Uh, kok mencurigakan sekali ya, kayaknya tipu-tipu deh. Eh, tapi kenapa kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Oh ... aku ini seorang seniman ternama dari Fontaine, datang ke Sumeru untuk mencari inspirasi. Panggil saja aku Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "Cari inspirasi? Di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Kayaknya ada tempat lain yang lebih cocok buat cari inspirasi deh. Yang pemandangannya lebih bagus dan lebih aman gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Lagi pula kalau kamu memang seniman dari Fontaine, kenapa enggak bawa apa-apa? Kamu ... mata-mata Fatui ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Tuduhan yang begitu kejam! Hal buruk separah apa yang pernah kalian alami sampai tega menuduh seperti itu? Sungguh, aku ini seorang seniman, dan tidak punya identitas selain itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Sebenarnya aku ... sudah dapat cukup inspirasi di sini dan sedang bersiap pulang ke Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Tidak kusangka cuaca di sini kering sekali, bahkan jauh lebih kering dari Lembah Chenyu. Belum lagi badai pasirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Aku sendiri lebih suka cuaca yang lembap, jadi rencananya mau pulang lewat jalur air sekalian ganti pemandangan. Tapi rakitku tergulung ombak dan aku tidak pandai berenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Berarti hidupmu di Fontaine lebih susah ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Memang, tapi tidak bisa berenang bukan satu-satunya alasan ... Ah, sudahlah. Akhirnya aku menemukan tempat istirahat di dekat perairan, lalu harusnya masih ada daun teh yang belum kebasahan. Sebagai tanda terima kasihku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Mau ajak kami minum teh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Ten-Tentu saja! Aku harus berterima kasih untuk telur ceplok tadi. Aku harus panggil kalian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Oh iya, Paimon sampai lupa kenalin diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#Aku {NICKNAME} dan dia Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Nama yang luar biasa sekali. Baiklah, mari kita minum teh. Kemahku dekat sekali dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "Sang penegak kebenaran dan asistennya yang masih magang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Kami duet maut paling keren sepanjang masa, {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Panggil kami Emas Berkilau dan Perak Mengkilap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#{NICKNAME} si Emas Berkilau dan Paimon si Perak Mengkilap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Ada juga ya orang yang bilang dirinya sendiri \"ternama\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Haha, dia bukan Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Kok gitu sih ngomongnya! Setiap orang pasti pernah lah pingsan karena kelaparan, barang sekali saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
