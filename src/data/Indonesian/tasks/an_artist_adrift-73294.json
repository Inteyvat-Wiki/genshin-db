			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Kami sudah kembali! Lah! Ternyata benar peliharaanmu ya, Julien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Mengeluarkan suara mengancam.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732941203,
					"content": "Hebat ya, Pepper. Sudah berani menggeram padaku? Lupa sama yang ngasih makan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Anjingnya punya nama! Tapi apa orang ini baik-baik saja? Kok malah berdebat sama anjing ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Kayaknya mereka cukup akur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(Kayak gitu kok dibilang akur sih?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Woi, Julien, kami sudah nemu barang-barangmu yang hilang nih! Pepper itu peliharaanmu, kan? Kenapa tadi pakai bohong segala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Aku? Dengan si tak tahu terima kasih ini? Mending aku pelihara Rifthound sekalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Hubungan sama yang kayak gitu enggak bakal bertahan lama, jamin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Setuju. Kalau kelaparan saja bisa sampai pingsan, gimana kalau ketemu Rifthound ... makan Teyvat Fried Egg berapa biji juga enggak bakal ketolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Oh iya, tapi dia tadi lagi jagain sejenis papan gambar gitu di pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Mungkin dia mau menyembunyikannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Serius? Dasar anjing bandel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Menggonggong, seperti sedang protes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732941218,
					"content": "Kamu masih berani protes? Kalau aku enggak ikutin kamu ke arah sini, aku sudah bisa pulang ke Fontaine lewat jalan biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Eh? Bukannya tadi kamu bilang lewat jalur air buat ganti pemandangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Baiklah, aku mengaku. Sebenarnya bukan demi ganti pemandangan. Aku bisa sampai di sini karena mengikuti si bandel ini. Tapi jalanan di sekitar sini berliku-liku, gampang sekali tersesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Oooh, ternyata gitu toh. Kenapa enggak bilang dari awal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Emmm, demi ... demi harga diri seorang seniman ternama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Hih, kalau mau bohong jangan terbata-bata gitu ngomongnya. Belajar lagi sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Tapi kalau bicara soal pemandangan di Sumeru, {NICKNAME} dan Paimon kebetulan tahu banyak tempat bagus. Boleh lah kami antar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "Ti-Tidak usah. Maksudnya ... terima kasih untuk kebaikan kalian, tapi ... Aku ini seniman terkenal yang percaya bahwa pemandangan luar biasa itu harus kita temukan sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Ah, tehnya sudah jadi. Ayo diminum dulu. Lalu, apa mungkin ada telur ceplok lagi buat teman minum teh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Kenapa telur ceplok?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Iya! Si {NICKNAME} gitu-gitu juga pinter masak loh. Mau makan apa juga dia pasti bisa bikin, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Kalian minum teh dan menikmati camilan.\\nRasa tehnya agak sulit dijabarkan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Teh ini, eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Ah, ada teman yang jual ke aku. Katanya bisa membangkitkan hikmat yang tertidur dalam diri. Menurutku sih enak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Aku bersyukur temanku enggak ada yang kayak gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Kenapa bilang begitu? Punya teman itu anugerah. Aku bisa ke Sumeru pun, semuanya karena saran dari seorang teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Terima kasih untuk bantuan kalian hari ini. Aku tidak tahu apa segini cukup atau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Enggak usah diambil pusing. Kamu yakin enggak perlu dibantu nyari inspirasi? Paimon takut kamu nyasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "Inti berziarah ... Eh, maksudnya inti sebuah perjalanan adalah menapakinya dengan kaki sendiri. Aku tidak mau merepotkan kalian lagi, biar aku kerjakan ini sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Ya sudah deh kalau itu maumu. Hati-hati ya, jangan kelaparan sampai pingsan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Mau lagi dong, boleh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#{NICKNAME}, lidahmu harus dikerok nih kayaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Haha, aku bukan bermaksud pelit ya, tapi rencananya aku masih akan tinggal lama di Sumeru. Jadi tehnya mesti diirit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Mana ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Hah ... Tapi minum teh enggak sama camilan juga rasanya kurang yahut. Bikinin apa kek yang enak, ayo laaah~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Mungkin dia melindunginya biar tidak dicuri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Tapi begitu lihat kita, dia langsung ngibrit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Aku enggak cium bau-bau alkohol sih ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Apa dia memang biasanya kayak gitu ya? Antik nih orang ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}