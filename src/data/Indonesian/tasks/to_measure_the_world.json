				},
				{
					"id": 230250523,
					"content": "Berarti kamu mau membantuku ya, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250524
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250524,
					"content": "Sebenarnya aku sudah pesan satu set suar yang bisa digunakan untuk mengumpulkan data yang diperlukan untuk hipotesisku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250525
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250525,
					"content": "Sebaiknya suar ini dipasang di tempat tinggi seperti tebing, puncak gunung agar datanya bisa ditransmisikan tanpa adanya gangguan topografi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250526
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250526,
					"content": "Tapi badanku pasti tidak kuat untuk mendaki tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250527,
						230250529
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250527,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250528
					]
				},
				{
					"id": 230250528,
					"content": "Terima kasih! Lokasi sampelnya ada di sekitar sini, kasih tahu aku kalau sudah selesai ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250529,
					"content": "Sebelum dipesan memangnya kamu tidak perhitungkan faktor ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250530
					]
				},
				{
					"id": 230250530,
					"content": "*uhuk* Waktu itu aku lebih mengutamakan sensitivitas alatnya sih, jadi aku harus mengorbankan jangkauannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250531
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250531,
					"content": "Lagian kalau ada sedikit kesalahan saja di data awal, data hasil perhitungannya akan berbeda sekali ... Yah, intinya aku minta bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250515,
