			"dialogs": [
				{
					"id": 230250701,
					"content": "Eh? Suarnya sudah dipasang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Terima kasih banyak, ini imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Sekarang tinggal menunggu data yang mereka kumpulkan, habis itu kita akan bisa membuktikan hipotesisku yang sebelumnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Tapi omong-omong, bagaimana caranya aku mengambil suar di atas sana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
