			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "Hmm ... ternyata begitu. Asal aku masukkan variabel ini, aku bisa menyelesaikan masalah kemarin yang muncul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Tapi kalau begitu, apakah kesimpulannya juga akan berubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Ada perkembangan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Ah, maaf, aku lupa kamu masih di sini ... Ini, terimalah imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "Kalau perkembangan ... walaupun sudah menyelesaikan beberapa masalah, sepertinya muncul masalah baru lagi ... penelitian memang seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "Sebelum mendapatkan kesimpulan akhir, aku mungkin akan perlu bantuanmu lagi, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
