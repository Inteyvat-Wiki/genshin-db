				},
				{
					"id": 230250517,
					"content": "Sampai saatnya nanti, kamu akan jadi penolongku dalam teori ini, aku akan menulis namamu di daftar ucapan terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250518
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250518,
					"content": "Uh ... kalau tidak, kamu juga bisa mengambil posisi sebagai penulis kedua juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250519
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250519,
					"content": "Buru-buru sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250520
					]
				},
				{
					"id": 230250520,
					"content": "Kalau tidak bisa menyajikan hasilnya, biaya penelitianku mungkin akan bermasalah ... ini lebih gawat bahkan dibandingkan langit yang runtuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250521,
						230250522
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250521,
					"content": "Aku tidak tertarik untuk jadi penulis kedua ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250522,
					"content": "Yang penting imbalannya cocok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250510,
					"content": "Langit tidak akan runtuh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250512
					]
				},
				{
					"id": 230250503,
					"content": "Aku sibuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250504
					]
				},
				{
					"id": 230250504,
					"content": "Oh! Jangan begitu dong, apa ada yang lebih gawat dari runtuhnya rumah sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Rumahmu ... akan runtuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "*uhuk-uhuk* Bukan. Tapi kalau kamu tinggal di satu rumah, terus kamu tidak pernah melihat keseluruhan rumahnya, dan tidak ada orang yang bisa menjamin kekuatan strukturnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Kalau tinggal setiap hari di rumah seperti ini pasti tidak aman, kan? Dunia ini juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
		},
