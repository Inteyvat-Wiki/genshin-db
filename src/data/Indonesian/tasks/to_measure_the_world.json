			"dialogs": [
				{
					"id": 230250201,
					"content": "Hei teman, apa boleh minta waktumu sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250202,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Apa kamu pernah berpikir: Apa yang terjadi kalau langit runtuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250209,
					"content": "Kamu salah makan obat ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Mungkin, tapi kenapa langit tidak runtuh? Kenapa tanah tidak longsor? Kalau tidak dipikirkan baik-baik, pertanyaan-pertanyaan ini selamanya tidak akan terjawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250213,
					"content": "Sebenarnya aku punya jawaban yang sempurna untuk pertanyaan-pertanyaan ini, tapi aku butuh lebih banyak data untuk mendukung jawabannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250214,
					"content": "Perlu bantuanku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "Berarti kamu mau membantuku ya, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250224,
					"content": "Sebenarnya aku sudah pilih tempat yang cocok untuk observasiku ini, tapi ada beberapa monster di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250225,
					"content": "Tolong usir monster-monster itu, supaya aku bisa melakukan observasi dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250226,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Terima kasih, ayo kita berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250228,
					"content": "Kamu juga ikut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Data-data ini harus aku konfirmasi sendiri supaya bisa tahu letak kesalahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250230,
					"content": "Hanya mengutak-atik di atas tumpukan kertas hanya akan membuatmu makin jauh dari jawabannya. Ayo kita berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250215,
					"content": "Semoga kamu beruntung, sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Tung-Tunggu dulu! Pikirkan lagi, kalau karyaku bisa diterbitkan, pasti akan jadi karya yang menggemparkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250217,
					"content": "Sampai saatnya nanti, kamu akan jadi penolongku dalam teori ini, aku akan menulis namamu di daftar ucapan terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250218,
					"content": "Uh ... kalau tidak, kamu juga bisa mengambil posisi sebagai penulis kedua juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250219,
					"content": "Buru-buru sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Kalau tidak bisa menyajikan hasilnya, biaya penelitianku mungkin akan bermasalah ... ini lebih gawat bahkan dibandingkan langit yang runtuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250221,
					"content": "Aku tidak tertarik untuk jadi penulis kedua ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Yang penting imbalannya cocok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Langit tidak akan runtuh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "Aku sibuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Oh! Jangan begitu dong, apa ada yang lebih gawat dari runtuhnya rumah sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250205,
					"content": "Rumahmu ... akan runtuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "*uhuk-uhuk* Bukan. Tapi kalau kamu tinggal di satu rumah, terus kamu tidak pernah melihat keseluruhan rumahnya, dan tidak ada orang yang bisa menjamin kekuatan strukturnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250207,
					"content": "Kalau tinggal setiap hari di rumah seperti ini pasti tidak aman, kan? Dunia ini juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Farghani"
				}
			]
		},
