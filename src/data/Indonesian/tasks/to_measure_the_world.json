					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Aku juga tidak menyangka akan banyak merepotkanmu ... harap terima imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
