			"dialogs": [
				{
					"id": 230250801,
					"content": "Oh! Pengembara, akhirnya kamu datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Penelitiannya lancar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Berka dirimu, perkembangan beberapa hari ini sangat drastis, suar-suar itu seharusnya sudah mengumpulkan banyak data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Sekarang tinggal menunggu data-data itu, terus aku akan bisa membuktikan tebakan yang kubuat beberapa hari lalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Lah? Ternyata cuma tebakan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "*uhuk-uhuk* Ada juga perkembangan optimalisasi rumus, kalibrasi alat ukur, soalnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Coba lihat diriku, kan tidak mungkin aku naik ke tempat kamu meletakkan suarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "Sepertinya aku harus merepotkanmu lagi untuk mengambil kembali suarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Apa boleh buat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "Tolong ya, Pengembara, aku akan menyiapkan imbalan yang pantas untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Lain kali tolong pikirkan dulu cara mengambil kembali suar-suar itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Aku juga pernah memikirkannya sih, seperti menambah perangkat untuk menyimpan kembali data, memperluas jangkauannya atau sejenisnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Tapi biayaku akan bertambah dan aku tidak tahu apa ketepatan dataku akan jadi terpengaruh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "Intinya aku kali ini tetap harus mengandalkanmu, Pengembara, tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Kalau gitu apa bedanya dengan tidak ada perkembangan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
