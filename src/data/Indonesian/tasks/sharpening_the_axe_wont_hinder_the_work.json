			"dialogs": [
				{
					"id": 205030201,
					"content": "Minta tolong apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Aku mencari senjata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Di sebelah sana, pilih saja sendiri. Jika kamu ingin yang lebih baik, aku juga bisa membuatnya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Eh benar-benar bisa disesuaikan ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Tentu saja. Menjual, membuat sesuai permintaan pelanggan, dan mengasahnya adalah pekerjaan seorang penempa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Yang kamu perlukan adalah bijih besi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "Dari mana aku bisa mendapatkan bijih besi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Ore ada di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "Sepertinya kamu bingung. Baiklah akan kuberi tahu lokasi sumber bijih besi terdekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Bawakan Iron Chunk padaku dan aku akan menempa senjata yang kamu inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "Baiklah, terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Tak perlu berterima kasih. Baiklah, aku akan melanjutkan pekerjaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "Apa kamu menjual bijih besi di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Tidak, kamu bisa membelinya dari orang lain, bijih besi yang kumiliki tidak untuk dijual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Aku mencari senjata untuk Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Eh aku tidak pernah dengar tentang ini! Jadi kamu mau Paimon bertarung di garis depan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Eh dia kecil sekali ya, jadi senjatanya juga harus disesuaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				}
			]
		},
