						205030604
					]
				},
				{
					"id": 205030604,
					"content": "Pekerjaan seorang penempa membutuhkan konsentrasi yang tinggi, aku tidak suka bicara banyak dengan tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Jika hasil baik, bisnis akan membaik. Hal lainnya tidak begitu penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
