			"dialogs": [
				{
					"id": 50130801,
					"content": "Wilayah Putra-Putri Gema sudah aman. Semua monster sudah dibasmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "Biar aku yang urus Tumor Abyss-nya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Warga Mata Air, aman! Sudah rata semua musuhnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Penguasa Angin Malam juga aman. Aku lanjut ke Bunga Bersayap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "Kondisi di sana masih agak gawat. Aku jalan ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "Tidak usah. Sudah beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Apa?! Sudah?? Tapi barusan kamu masih di Stadion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Ya gitu deh. Kamu enggak tahu saja sudah berapa lama aku gatal ingin ganyang kepala monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "Oh ... oke deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, suku Berlimpah Jaya gimana kabarnya? Kan jauh banget tuh dari Stadion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Oh, tidak usah cemas. Barusan aku dapat kabar dari Varesa, katanya mereka aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "Berarti semua area sudah aman ya. Kekuatan Abyss melemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "Ya! Mereka bisanya cuma main keroyokan! Percuma! Soalnya sekarang kita bisa pakai Gita Kebangkitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Tahan dulu. Abyss barusan mengirim pasukan besar ke Stadion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Berarti mereka juga sadar situasinya berbalik karena Gita Kebangkitan. Jadi mereka mengincar Api Keramat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Enak saja, mereka pikir kita bakal biarin? Kawan, kita kumpul di Stadion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "Tumor Abyss turun lagi, dan semuanya di dekat Stadion. Kita pencar, sapu bersih semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Oh, dan kita perlu orang buat jaga gerbang utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Baiklah! Ini pertempuran terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
