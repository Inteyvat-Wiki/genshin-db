			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Tentang gigi ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Gigi? Coba tunjukkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Hm... bentuk dan ukurannya memang terlihat tidak biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Aku bukan ahlinya dalam meneliti bahan... Tapi Orban sudah memakai banyak bahan untuk menempa senjata, mungkin dia tahu sesuatu mengenai ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Kenapa kamu tidak tanyakan saja padanya? Dia ada di sana, kamu pasti tidak akan melewatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
							"2"
						],
						"stepId": 7010207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "Tentang gigi ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "Gigi? Ugh, jangan bilang kamu menemukan barang-barang rongsokan di atas gunung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "Eh? Gigi ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "Ke-kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Tekstur gigi ini terlihat sangat bagus, dan juga sangat keras seperti kuku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "Dan dari tampilannya... ini terlihat seperti gigi naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "Gigi naga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Iya, ini adalah gigi naga. Dikatakan bahwa senjata yang terbuat dari gigi naga akan menjadi sangat keras dan tajam... dan juga akan memiliki kekuatan yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "Namun, gigi naga bukanlah sesuatu yang bisa diambil begitu saja. Menurut legenda, hanya para pahlawan terkenal saja yang bisa memperoleh gigi naga dan senjata dari gigi naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Hahaha, seperti kata pepatah, jika kamu tidak mempunyai senjata yang bisa mengalahkan seekor naga, bagaimana mungkin mengalahkan naga dan mendapatkan giginya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Jadi apakah \"gigi\" ini adalah gigi naga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Sejujurnya, aku juga tidak pernah berurusan dengan gigi naga sehingga tidak bisa mengatakan dengan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Kurasa, \"gigi\" ini adalah gigi dari seekor monster yang sangat besar atau semacamnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Tapi karena kamu sudah berusaha keras untuk membawa \"gigi\" ini, kita bisa saja menganggapnya sebagai gigi naga yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Hm... tapi ini tidak cukup untuk dijadikan senjata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "Pergilah dan kumpulkan tiga lagi \"gigi\" yang seperti ini lalu datanglah lagi ke sini, aku juga akan memeriksa berbagai data milikku dan melihat bagaimana mengolahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Oh ya, selain <color=#00E1FFFF>gigi naga</color> ini, kamu juga memerlukan beberapa bijih besi yang bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "Hm, saat kamu berada di atas gunung itu, kamu juga bisa mengumpulkan 50 <color=#00E1FFFF>Starsilver</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Selain itu... aku juga membutuhkan <color=#00E1FFFF>Northlander Polearm Billet</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020219,
					"content": "Jika sudah terkumpul kamu bisa memberikannya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
