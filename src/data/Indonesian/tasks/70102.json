			"dialogs": [
				{
					"id": 701020301,
					"content": "Tentang gigi naga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Oh kamu sudah kembali. Oh ya, sebelum kamu pergi mengumpulkan gigi itu... ah, kamu sudah mengumpulkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Maaf, aku ada sedikit masalah, tidak peduli cara apa pun yang kugunakan, aku tetap tidak bisa menghilangkan serpihan-serpihan pada gigi ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "Mungkin ini memang benar-benar \"gigi naga\"... Menurut data yang kuperiksa tadi, ada beberapa cara khusus jika ingin menggunakan gigi naga sebagai bahan membuat senjata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Salah satunya adalah membiarkan gigi naga menyerap semacam \"kekuatan kehidupan\" yang berhubungan dengan naga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Kemudian gunakan gigi naga yang telah menyerap energi kehidupan itu untuk menangani gigi naga lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Tapi untuk menyerap energi kehidupan itu... hm... aku juga tidak punya petunjuk apa pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "Pengembara, apakah kamu punya ide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Bi-biar kupikirkan dulu caranya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Bagus sekali... kalau begitu aku akan memberimu \"gigi naga\" ini, kuserahkan hal ini padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Bagaimana pun, jika giginya saja sudah merepotkan seperti ini, maka naga benar-benar adalah makhluk yang rumit dan menyusahkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
