					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Gimana, dapat sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Huh ... cuma ada perintah yang enggak jelas, dan juga ini! Setangkai bunga kering!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Eh ...! Boleh kasih ini buat aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Ini tuh yang si orang jahat tinggalin loh, memangnya kamu enggak takut kalau ada ... racunnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Enggak perlu khawatir, aku pernah melihat bunga ini ... orang itu, aku seharusnya pernah melihatnya ... berikan padaku, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Ini ambil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Terima kasih, Nara {NICKNAME} dan Putih Melayang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru membawa bunga kering ke Hutan Mawtiyima ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
