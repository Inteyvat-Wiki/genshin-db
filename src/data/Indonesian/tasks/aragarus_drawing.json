			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "Nara Emas dan Si Putih Melayang! Akhirnya kita ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Wah, lain kali kalau mau muncul tiba-tiba \"ketuk pintu\" dulu dong! Bikin kaget saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "Kami bukan orang jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "Hmm ... masuk akal juga omongan kalian ... Jadi, kelihatannya Nara Emas dan Putih Melayang bukan Nara yang jahat ya. Jadi bisa bantuin aku sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Tentu saja dengan senang hati. Aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Ini Paimon, sekarang jangan lupa lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Lagi ...? Uhhh, ehem. Namaku Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Kita pernah datang ke sini bareng-bareng, tapi kamu sudah lupa ... Aduh, gimana ya jelasinnya! {NICKNAME}, ayo kita jelasinnya bareng-bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Kalian menceritakan pada Aragaru tentang petualangan secara detail.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Begitukah ... Walaupun aku sudah enggak ingat. Namun, enggak tahu kenapa, aku bersedia percaya padamu ... Lagi pula, kalian punya bunga yang aku berikan, aku bisa merasakan keberadaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Ah, benar! Nara jahat meninggalkan kemah, ayo kita lihat barang apa yang dia tinggalkan. Mungkin kita bisa tahu apa yang dia rencanakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Kami membantumu untuk mengusir orang jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
