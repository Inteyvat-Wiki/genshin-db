			"dialogs": [
				{
					"id": 730580401,
					"content": "Ayo pergi ke markas penjahat Nara dan cari tahu apa yang mereka lakukan di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Bagaimana kamu menentukan kalau mereka itu orang jahat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Uh ... tidak tahu, tidak jelas! Tapi aku tahu Nara {NICKNAME} dan benda Putih Melayang pasti bukan orang jahat! Aragaru percaya kalian kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
