					"nextDialogs": [
						400391102
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391102,
					"content": "Beberapa dari kalian, pergi dan muat barangnya ke kapal, cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391103
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391103,
					"content": "Apa pun yang sedang kalian lakukan, sudahi. Apa pun barang yang kalian pegang, tinggalkan. Sekarang semuanya jadi milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391104,
					"content": "Ka-Kapten Beidou?! Se-Sedang apa Anda di sini!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391105
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391105,
					"content": "Aku juga mau tanya hal yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391106,
					"content": "Yah, memangnya apa lagi? Kami untung besar! Kami ketemu begitu banyak harta karun yang mengapung begitu saja di tengah lautan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391107
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391107,
					"content": "Kalau ada yang Kapten suka, silakan ambil! Anggap saja tanda hormat kami untuk Kapten Beidou yang hebat, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391108
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391108,
					"content": "Oh begitu? Baguslah, aku ambil semuanya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391109,
					"content": "Eh ... Aku ... tapi ... Ayolah, jangan begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391110
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391110,
					"content": "Aku dan rekan-rekan sudah susah payah mengumpulkan semua ini ... boleh dong sisakan sedikit saja buat kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391111
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391111,
					"content": "Biar kuperjelas lah: Semua barang ini bukan milikmu, dan tidak akan pernah jadi milikmu. Jadi tinggalkan semuanya ini dan pergi sejauh mungkin dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391112
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391112,
					"content": "I-Itu sih agak ... Eh, begini saja, bagaimana kalau kita bicarakan dulu saja? Kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391113
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391113,
					"content": "Hah ... mau mengulur waktu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391114
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391114,
					"content": "Cukup basa-basinya. Kita selesaikan saja dengan cara lama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
