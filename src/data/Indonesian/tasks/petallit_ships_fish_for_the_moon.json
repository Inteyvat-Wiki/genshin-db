		},
		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "Banyak sekali barang yang hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390202,
					"content": "Barang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "Jade Chamber yang baru ini kehilangan banyak sekali barang yang ada di dalam pendahulunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390204,
					"content": "Semua karya sastra, perabotan, dan pernak-pernik koleksiku ... semuanya ikut tenggelam bersama Jade Chamber yang dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390205,
					"content": "Sebagian besar hancur, dan hanya segelintir saja yang masih utuh tersebar di perairan. Sulit sekali mengumpulkan semuanya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390206,
					"content": "Cuma orang yang ahli melaut saja yang bisa melaksanakan tugas ini, tapi ... aku tidak yakin kalau Beidou bisa memancing semuanya sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390207,
					"content": "\"Mancing\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "Hah, kamu suruh Beidou mancing semua barang-barangmu yang ada di laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390209,
					"content": "Istilah \"suruh\" itu sepertinya kurang tepat. Ada kesepakatan di antara kami, dan kedua pihak juga saling diuntungkan. Kami selalu seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390210,
					"content": "Kamu bayar Beidou untuk kerjakan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "Aku memang membayarnya. Tapi selain itu, dia masih dapat kompensasi lain juga. Hehe, katakanlah urusan ini sedikit lebih rumit dari yang kamu kira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390212,
					"content": "Yang jelas, sekarang Beidou sedang ada di sekitar Guyun Stone Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390213,
					"content": "Kalau minat, kalian cari dia saja ke sana. Siapa tahu dia butuh bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003904",
							"2"
						],
						"stepId": 4003904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "Ugh, Ningguang ... kali ini kamu benar-benar menguji kesabaranku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390402,
					"content": "Maaf saja, kalau Jade Chamber hancur berkeping-keping saat menghantam permukaan laut, otomatis isinya juga ikut hancur dong. Jangan kira karena aku sebegitu hafal dengan lautan, aku jadi mampu memancing masa lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390403,
					"content": "Berarti proses pencariannya berjalan lancar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "Oh, Pengembara. Ada apa, jauh-jauh di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390405,
					"content": "Aku datang untuk membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "Bagus! Kalian datang tepat waktu. Semua anak buahku sedang sibuk dengan urusan lain, jadi aku sangat butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390407,
					"content": "Lihat, bahkan Xinyan saja aku tarik buat bantu-bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390408,
					"content": "Wah, ada Xinyan juga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "Ya, ada acara apa nih? Kamu mau konser di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390410,
					"content": "Betul itu! Tidak resmi sih, Kak Beidou mau bikin pesta di kapal, jadi aku ikutan mengisi acaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390411,
					"content": "Tapi semuanya ambyar saat seseorang yang mengaku sebagai sekretaris Ningguang datang. Dia membawa Kak Beidou pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390412,
					"content": "Namanya Baiwen atau Baixiao ya ...? Ah, sudahlah, pokoknya namanya Bai sesuatu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390413,
					"content": "Ningguang kepikiran ide cemerlang dan minta aku ke laut untuk mencari dan menyelamatkan barang-barang berharga koleksinya. Dan dia berani bayar lebih untuk kerjaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390414
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390414,
					"content": "Huh. Dia berani bayar mahal, jadi kami terima saja pekerjaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390415
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390415,
					"content": "Sekarang kalau mau cari pernak-pernik kecil, kami juga harus naik perahu yang lebih kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390416
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390416,
					"content": "Semua perahu yang kami punya sudah berangkat. Dan sepertinya masih kurang satu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390417
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390417,
					"content": "Aku punya perahu.",
