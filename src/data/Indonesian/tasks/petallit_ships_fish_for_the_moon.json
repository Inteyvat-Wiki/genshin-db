			"dialogs": [
				{
					"id": 400390801,
					"content": "Berhenti! Semuanya berhenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390802,
					"content": "Kalian buta ya? Masa kalian tidak tahu Kapten Beidou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390803,
					"content": "Hehe, Kapten Beidou, sudah lama tidak berjumpa. Anda masih saja hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390804,
					"content": "Lama tak jumpa, Carmen. Cukup lama untuk membuatmu semakin gemuk saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390805,
					"content": "Kamu harus lebih perhatian lagi sama lingkar pinggangmu, kalau masih mengandalkan taktik sembunyi di semak-semak. Kelihatan, tahu tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390806,
					"content": "Ah, Anda bisa saja ... Hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390807,
					"content": "Langsung saja ya. Aku perlu semua barang-barang ini. Tinggalkan semuanya dan aku tidak akan mempersulit kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390808,
					"content": "Tentu, tentu, semua terserah Kapten Beidou. Kalian dengar, kan? Tinggalkan semua barangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390809,
					"content": "Ini, semuanya ada di sini. Jadi, uh ... ka-kami pamit dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390810,
					"content": "Carmen pun pergi bersama para Treasure Hoarder ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Wow, dia langsung nurut begitu saja, tidak tanya apa-apa pula ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390812,
					"content": "Cepat sekali menyerahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "Larinya juga sama cepatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390814,
					"content": "Jangan buang-buang waktu lagi dengan mereka. Kita masih harus cari barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390815,
					"content": "Ah, tapi kita harus memuat barang-barang ini ke atas kapal. Pengembara, ayo bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		},
