			"dialogs": [
				{
					"id": 210270201,
					"content": "Pengembara? Little Meng? Ada apa kemari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 210270202,
					"content": "Ah? Eh, anu ... kakak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270203,
					"content": "Kami mau pinjam dapurmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Dapurku silakan saja kalian pinjam, tapi kalau boleh tahu, kenapa kalian tiba-tiba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 210270205,
					"content": "Ternyata begitu ... Baiklah, kalian pakai saja dapurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 210270206,
					"content": "Little Meng, waktu bepergian di luar, kamu jangan pilih-pilih makanan lagi loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 210270207,
					"content": "Ba-Baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270208,
					"content": "Kakak, tolong ajarkan aku buat 1 masakan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270209,
					"content": "Nanti waktu aku bepergian sama papa, aku mau berikan dia kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270210,
					"content": "Serahkan saja pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, kita mendingan masak apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
