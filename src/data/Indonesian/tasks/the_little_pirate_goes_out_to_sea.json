			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#Kak {NICKNAME}! Pas sekali kalian datang, baru saja aku mau mencari kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270102,
					"content": "Eh? Little Meng, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "Kalian ingat kan waktu itu aku meminta tolong kalian mengapungkan botol berisi masalah-masalahku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270104,
					"content": "Sebenarnya aku sudah tidak berharap lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270105,
					"content": "Tapi beberapa hari lalu papa bilang kalau teman kerjanya mencari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270106,
					"content": "Kata paman itu, mereka sedang menyiapkan bisnis yang berhubungan dengan jamur dan mereka berencana pergi ke Sumeru untuk melihat-lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270107,
					"content": "Lalu mereka tanya papa, apakah papa mau ikut dengan mereka untuk lihat kondisi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270108,
					"content": "Mereka juga bilang ... boleh bawa aku juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270109,
					"content": "Awalnya papa tidak setuju, tapi ... ada seorang paman yang mengeluarkan sepucuk surat dan mengajak papa bicara berdua saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270110,
					"content": "Setelah mereka selesai mengobrol, papa setuju membawaku ikut ke Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270111,
					"content": "Meski aku tidak mengerti kenapa papa tiba-tiba berubah pikiran, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270112,
					"content": "#Aku bisa pergi jalan-jalan ke Sumeru! Kak {NICKNAME}, aku bisa pergi ke Sumeru loh! Asyiknyaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270113,
					"content": "Selamat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#Pasti ini berkat botol apung itu, terima kasih ya, kak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270117,
					"content": "Kata Papa, setelah mereka sampai di Sumeru, mereka akan pergi ke tempat bernama Desa Qiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270118,
					"content": "Desa Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Ya, kata papa di sana adalah desa teh. Ada banyak sekali pohon teh, dan kualitasnya sangat bagus. Tapi namanya susah sekali ya diingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270120,
					"content": "Tapi sudah cukup deh bicara tentang ini! Sebelum pergi ke sana, kita harus pergi ke Sumeru dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270121,
					"content": "Sumeru kan jauh sekali dari sini, pasti perjalanannya lama sekali deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270122,
					"content": "Tapi kudengar kalau mau bepergian, kita harus lakukan banyak persiapan. Kita harus menghadapi berbagai situasi selama perjalanan yang panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270123,
					"content": "Kakak kan sering bepergian di luar, kakak bisa berikan aku beberapa tips waktu bepergian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270124,
					"content": "Misalnya ... hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270125,
					"content": "Apa yang biasa dimakan waktu bepergian di luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270126,
					"content": "Papa bilang biasanya mereka bakal membuat makanan sendiri. Tapi aku hanya bisa buat beberapa masakan sederhana, dan aku tidak tahu enak atau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270127,
					"content": "#Ohohoho! Memasak! Itu kan keahlian kami. Benar kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Biar aku ajarkan kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Kalau begitu, kita perlu cari tungku masak dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Hemmm, bagaimana kalau kita pinjam dapur Koki Mao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Koki Mao? Huwee, Paman itu biasanya menakutkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270133,
					"content": "Koki Mao? Menakutkan dari mana? Dia baik kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "Oh, oh ya? Tapi setiap kali makan di sana bersama papa, waktu aku keluarkan Qingxin dari masakan, alisnya pasti berkerut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270129,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Bisa-bisa aku pergi juga ke Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Benarkah? Kalau begitu ayo kita ketemu lagi di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
