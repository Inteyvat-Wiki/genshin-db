			"dialogs": [
				{
					"id": 6080101,
					"content": "Fiuh, kapan ya terakhir aku pakai petir saat Festival Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "Sebelumnya sering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "Panggil petir untuk menyambar orang? Tidak kok, jarang lah. Tapi bisa lepas kayak gini ... rasanya asyik juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Ha, profesorku dulu bahkan sempat bahas soal itu dalam surat berapa hari kemarin. Tentunya, aku perjelas di sana kalau aku selalu \"memperlakukan orang dengan baik\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "Wajar lah kalau murid mengikuti teladan gurunya. Dan guruku itu orang tua lemah lembut dari Darshan Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "Ngerti kan? Kali ini aku cuma setrum orang dengan lembut. Lembut sekali, sampai Jean juga tidak usah sampai harus turun mengintervensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "Setrum ... lembut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "Nona Lisa sepertinya sedang senang hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Ah, kali-kali gerak badan kan bagus ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
