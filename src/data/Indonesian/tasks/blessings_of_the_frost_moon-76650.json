			"dialogs": [
				{
					"id": 766500401,
					"content": "Baiklah, Arca Rembulan-nya taruh di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500402
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500402,
					"content": "Hmmm, ternyata semua berjalan lancar ya. Paimon kira bakal ada sesuatu yang hebat waktu kita taruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500403,
					"content": "Hehe, ini hanya patung tua biasa saja, sebuah peninggalan sejarah. Jadi memang tidak ada kekuatan ajaib apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500404
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500404,
					"content": "Nilai sebenarnya terletak pada cerita di baliknya. Tugasku adalah menggali dan membuktikan cerita-cerita itu, lalu menceritakannya kepada semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500405,
					"content": "Asyik! Untungnya kita bisa balikin ini dalam keadaan utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500406,
					"content": "#Terima kasih atas kerja keras kalian, {NICKNAME}, dan Paimon. Terimalah buah-buahan ini untuk memuaskan dahaga kalian. Tadi aku minta hewan-hewan hutan untuk mengumpulkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500407,
					"content": "Dan setelah itu, maaf. Tapi aku masih butuh bantuan kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500408
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500408,
					"content": "Boleh, butuh apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500409
					]
				},
				{
					"id": 766500409,
					"content": "Maaf kalau aku terdengar agak lancang. Tapi aku melihat kalau kalian berdua punya banyak teman, dan kalian juga pernah pergi ke banyak tempat-tempat rahasia dan tersembunyi selama bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500410
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500410,
					"content": "Jika kalian menemukan catatan tentang Bani Bulan Embun saat bertualang nanti, apa aku boleh meminjamnya untuk menyalinnya dan menambahkan ke perpustakaan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500411,
						766500412
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500411,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500413
					]
				},
				{
					"id": 766500413,
					"content": "Aku mewakili Bani Bulan Embun, mengucapkan terima kasih sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500414,
						766500415
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500414,
					"content": "Aku lanjut makan buah dulu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500416
					]
				},
				{
					"id": 766500416,
					"content": "Fiuhhh, buahnya enak banget! Jauh lebih enak dari yang biasa Paimon makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500417,
					"content": "Hehe, hewan-hewan ini tinggal di hutan ini sejak lahir, jadi mereka paling tahu buah mana yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500418
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500418,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500419
					],
					"speakerTitle": "Puffin"
				},
				{
