			"dialogs": [
				{
					"id": 766500301,
					"content": "Patungnya gede banget ... yah, burung sama tupai doang enggak akan bisa geser itu patung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Seharusnya sih mereka enggak bakal bisa lewatin cerminnya ya. Tapi Lauma, sebenarnya Arca Rembulan ini berharga banget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "Kalau dihitung dengan Mora? Kurasa tidak begitu berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "Hasil ukirannya kasar, dan bahan batunya umum ditemukan di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Tapi bagi Pelantun Rembulan di masa itu, dan bagi Bani Bulan Embun di generasi ini, patung ini adalah harta yang tak ternilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Setidaknya, sekarang aku sudah memastikan sendiri kalau Arca Rembulan ini memang ada. Aku jadi bisa memastikan kebenaran beberapa dokumen yang berhubungan dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Berarti misi kali ini sukses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#{NICKNAME}, terima kasih atas bantuannya. Aku tidak salah menilai, Cermin Purnama tidak bisa menghalangimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500309,
					"content": "Anak ini sangat kagum dengan kemampuanmu dalam mengoperasikan mekanisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500311,
					"content": "Lauma, apa katanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#Dia bilang, {NICKNAME} adalah pemburu harta terhebat yang pernah dia lihat. Kalau diizinkan, dia ingin mengikuti {NICKNAME} berburu dan membuka semua peti harta di seluruh dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "Wah, aku jadi kayak maling dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500316,
					"content": "\"Mulai sekarang, kalau ada peti harta yang tidak bisa dibuka, aku akan meminta bantuan Anda!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "Uhhh, oke, bye-bye? Kita bahkan enggak dikasih pilihan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500318,
					"content": "Tenang, dia tidak akan mengetuk jendela rumahhmu setiap hari dengan Mora di paruhnya, lalu mengajakmu untuk mencari harta karun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500319,
					"content": "Dan dia tidak akan mengunjungi kamarmu di tengah malam, sambil mengeluh tentang kunci yang tak bisa dia congkel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500320,
					"content": "#{NICKNAME}! Pastiin pintu sama jendela sudah dikunci semua sebelum bobo nanti malam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500321,
					"content": "Tenang, anak itu tidak ada niat jahat. Hanya saja ... dia agak sedikit lebih cerewet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500322,
					"content": "Sekarang ayo kita pulang. Sudah hampir waktu makan malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500323,
					"content": "Oh ya, kita juga harus memikirkan bagaimana cara membawa patung ini ke perpustakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500324,
					"content": "Sepertinya aku memang harus meminta beberapa teman untuk membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500314,
					"content": "Aku memang sudah buka banyak banget harta karun sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
			]
