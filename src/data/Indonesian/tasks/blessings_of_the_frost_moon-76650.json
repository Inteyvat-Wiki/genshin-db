				{
					"id": 766500202,
					"content": "Patung itu sangat berharga ya? Kenapa sampai dikunci rapat begini .... Apa jangan-jangan di dalamnya ada perangkap? Kayak bakal ada anak panah bermunculan kalau salah injak lantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "Aku sudah siap mental.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "Tenang saja, aku sudah meminta anak ini untuk memeriksa tempat ini terlebih dahulu. Tidak ada perangkap berbahaya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500206
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500206,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500207
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500207,
					"content": "Oooh, mantap! Bagus deh, tapi kerjaan begitu cocok banget ya buat Weasel Thief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500208,
					"content": "Tapi kelihatannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "Haha. Benar sekali. Setiap kali aku meminta tolong padanya, aku harus membayarnya satu Mora saat bertemu kembali dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500211,
					"content": "Heh, emang cocok ya sama namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500212,
					"content": "Hmmm, tapi karena dia ada tolongin Lauma jagain Arca Rembulan-nya, mungkin dia perlu nama baru ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500213,
					"content": "Bagaimana kalau ... \"Weasel Guardian\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500214,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500215,
					"content": "Hehe, Paimon kan bisa terbang, jadi kamu enggak bakal bisa tangkap Paimon. Weeek~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500216,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500217,
					"content": "Hei, hei, jangan memanjatku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "Ayo, ayo, harus sopan pada tamu kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500220
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500220,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500221,
					"content": "Jadi, aku harus ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "Untuk mengambil Arca Rembulan, kita perlu menyalakan sepasang mekanisme yang ada di dua lokasi berbeda. Perlu dua orang untuk melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "#{NICKNAME}, tolong urus mekanisme yang di sebelah sana. Aku pegang yang di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Tapi gimana caranya biar nyalainnya bareng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "Jangan khawatir, aku punya mata di atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500228,
					"content": "Dia akan memberi tahu posisimu dan mekanisme apa yang ada di depanmu. Tenang, ikuti saja petunjuk dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500222,
					"content": "Bagaimana cara membuka mekanisme ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "Jangan tarik rambutku ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "Weasel Thief ini tidak mau kerja gratis ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
