			"dialogs": [
				{
					"id": 766500101,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500102,
					"content": "Ini bukan masalah kamu punya berapa banyak teman. Kalau kamu panggil semua burung ibis di Pulau Hiisi pun, kamu tetap tidak akan bisa memindahkan \"Cermin Purnama\" itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "Dan kalau pun kamu bisa, Arca Rembulan di dalamnya masih akan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500105,
					"content": "Digali? Hmmm, bisa saja. Tapi kamu juga tidak bisa memindahkan Cermin itu dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪♪♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500107,
					"content": "Eh? Kamu benar-benar bisa memanggil semua burung ibis di pulau ini kalau perlu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "Dan kamu sendiri berpikir kalau rencana ini tidak berguna, meskipun semua keluarganya turun tangan pun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500110,
					"content": "Wow, ramai amat ya di sini. Bahkan ada seekor Weasel Thief yang lagi heboh berdebat sama burung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "Apa mereka mau kerja sama buat mencuri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Lebih tepatnya, kami sebenarnya \"merencanakan operasinya\". Kudengar kalau kita harus \"memperhitungkan segalanya\" agar bisa berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Tapi cara yang dipakai oleh rekan-rekanku ini ... agak bertentangan. Mereka juga terlalu terus terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500116,
					"content": "Oke, oke, aku percaya kok kalau kamu punya banyak teman-teman yang berkuasa. Tapi dari mana kamu belajar kalimat seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500118,
					"content": "Dari seorang gadis kecil dengan tangan besi dan pakai topi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500120,
					"content": "Oh, bicara saja kalau memang senang. Tapi tolong jaga perasaannya, oke? Jangan sembarangan mempelajari perilakunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Aku mau bicara serius dengan {NICKNAME} dan Paimon, jadi tolong jangan terlalu berisik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 766500123,
					"content": "Wow, beneran jadi diem loh. Hebat banget ya bisa ngomong sama binatang? Paimon juga mau deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "Paimon, percayalah. Kamu tidak akan menyukai kekuatan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Kedengarannya sangat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "Ah, jangan salah paham. Tidak akan terjadi hal yang gawat, kamu juga tidak akan jadi gila atau apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "Meskipun begitu, kadang aku juga merasa itu membuatku jadi tidak tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Awalnya, saat aku sadar kalau aku bisa mengerti bahasa hewan, aku senang sekali. Tapi lalu aku sadar kalau ada masalah juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "Karena kemampuan ini selalu aktif setiap saat, dan aku tidak bisa mengendalikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Eh ... iya juga ya. Kalau kamu enggak bisa kendaliin, itu berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Mau di hutan, atau di tepi sungai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "Benar sekali. Orang-orang suka berkata kicauan burung di dalam hutan akan membuat hati mereka jadi tenang dan suasana hatimu membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Tapi, ke mana pun aku pergi, aku tidak bisa merasa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Saat berada di dalam hutan, aku bisa mendengar suara kucing liar, kelinci, rusa, badak, dan burung ibis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Mereka selalu berdebat sengit tentang siapa yang menghancurkan sarang siapa, dan pohon mana yang kualitasnya paling bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Jadi telingamu tidak pernah bisa istirahat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "O-Oke, ternyata ngomong sama binatang enggak seasyik itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "Kalau dibangunin sama kicauan burung sih enak, tapi ... kalau kicauannya berubah jadi suara ribut-ribut, ya Paimon malas juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "Paimon sih mana bangun kalau kicauan burung doang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Aku sendiri ... sudah terbiasa sekarang. Bahkan aku akan merasa ada yang aneh kalau saat aku bangun suatu hari nanti dan tidak bisa mendengar diskusi burung Finch tentang gelas mana yang paling cocok untuk mandi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Weasel Thief"
				},
				{
					"id": 766500146,
					"content": "#Terima kasih sudah mengingatkanku, aku nyaris lupa ada urusan apa. {NICKNAME} sudah datang, sepertinya masalah akan segera teratasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Aku banyak teman orang dalam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "Tidak, tidak, kamu saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "Aku perlu orang yang bisa masuk ke dalam sebuah gudang dengan cara membuka segel Cermin Purnama yang dibuat oleh Pelantun Rembulan sebelumnya. Tapi bagi seseorang dengan bakat sepertimu, hal ini pasti mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Dibuat oleh Pelantun Rembulan sebelumnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "Tenang, kamu pasti bisa. Ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "Aku butuh latihan langsung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Aku butuh waktu untuk mengumpulkan orang-orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "Biasa aku perlu goyangin Paimon berapa kali baru bangun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "Tidak peduli ke mana pun, pasti ada yang berisik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "Asalkan ada binatang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "Aku jadi merinding ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "Atau lagi berdiskusi soal pembagian hasil curian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
