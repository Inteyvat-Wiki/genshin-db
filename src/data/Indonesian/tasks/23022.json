			"dialogs": [
				{
					"id": 230220101,
					"content": "Kalau kekuatan di bagian ini ditambah, kita harus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Kalau kamu menggunakan desain seperti ini, maka tidak ada bedanya dengan yang lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Kalian sedang mengerjakan desain kapal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "Ah, si Pengembara toh. Iya, Qishan dan aku sudah berdiskusi beberapa ... aspek rancangan sejak terakhir kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Kami ... menyiapkan sebuah skema desain baru setelah berdiskusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Tapi kami masih sedikit berbeda pendapat dalam material yang dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Tapi kali ini kuikuti sarannya! Aku membeli material bagus, tapi ya harganya juga mahal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "Pengembara, seperti yang kamu lihat. Aku tidak bisa memindahkan semua ini sendirian. Qishan juga tiak terlalu kuat, jadi bisa tolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Kita pindahkan bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Kamu memang bisa diandalkan. Ayo kita segera berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Material kali ini dipilih langsung oleh Qishan, seharusnya kali ini tidak muncul masalah apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Dan kali ini aku sudah siapkan imbalan yang lebih banyak, terima kasih atas bantuanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Jangan bicara lagi, ayo kerjakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
