			"dialogs": [
				{
					"id": 715330101,
					"content": "Hmm, ada yang tidak beres nih ... ternyata membuat Kartu Ucapan itu sulit juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, lagi bikin Kartu Ucapan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME}! Kebetulan sekali. Saya tidak mengira kita bisa ketemu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Ikut merayakan Lantern Rite nih ceritanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Oh, bukan, bukan. Saya kemari untuk mengantar surat. Kebetulan saja di sini sedang merayakan Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Nona Klee ingin punya Kartu Ucapan Lantern Rite, maka dari itu saya terpikir untuk beli satu, sebagai oleh-oleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Tapi ternyata ... kita harus membuatnya sendiri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Saya sudah habiskan cukup banyak waktu untuk membuatnya, tapi tetap rasanya ada yang kurang. Entah di mananya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME} lebih tahu mengenai adat dan kebiasaan Liyue, boleh kasih saya sedikit petunjuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Hmm, apa ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
