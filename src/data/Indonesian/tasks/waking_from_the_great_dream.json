					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "Aku ... merasakan yang namanya \"rasionalitas\". Wahai pendatang, apakah kamu penerus Narzissenkreuz, ataukah ancaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "Melihatmu menarik pedang, sepertinya jawabannya sudah jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Eh? Jadi benda ini yang namanya Narzissenkreuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "Karena kamu sudah mendengar namaku, maka dengarkanlah dan pahami prinsipku untuk menyelamatkan dunia. Karena kamu sudah mendengar namaku, maka benih-benih yang terselamatkan akan muncul di dalam kesadaranmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "Banyak orang-orang yang berhadapan denganku, datang karena tertipu oleh kebohongan. Di waktu seperti ini, aku tidak ingin menyia-nyiakan tenagaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Berbahagialah, bersukacitalah. Setelah semuanya berakhir, aku akan menjawabnya, aku akan menunjukkannya. Sekarang kembalikanlah pedang agung itu kepadaku, kemudian pergilah dan cari tempat berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "Paimon enggak mau kasih pedangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "Bodoh, sungguh bodoh. Tapi aku memaafkanmu, meski tindakanmu bodoh, tetapi aku akan tetap menyelamatkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "Aku bisa merasakannya, meski Pengubahan Empat Kuadran bisa diputarbalikkan, tapi keseluruhan peta pohon mengalir masih belum diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "Sudah tidak ada cara lagi untuk menyelamatkan semua orang. Aku akan memperluas rasa belas kasihanku dan menghabiskan kekuatan kehidupanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "Jika aku hanya bisa menyelamatkan 50% dari semua orang, maka aku akan berusaha sebisaku untuk menyelamatkan 60%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Sekarang, aku datang kembali untuk mengambil Pedang Agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416502,
