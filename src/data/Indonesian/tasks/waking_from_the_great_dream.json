							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Tidak mungkin ... Jelas-jelas tadi aku sudah sampai tahap \"tiada jalan kembali\". Kenapa bisa kembali lagi sampai tahap serendah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "Dan aku juga sudah kehilangan kendali atas Lautan Primordial sepenuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Kenapa, kenapa begini? Kenapa kalian harus melakukan hal seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "Dunia baru tidak bisa dilahirkan, semua orang akan mati dalam mimpi cangkang telur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Kamu tuh harus bangun dari mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "Masalah seperti kiamat itu sesuatu yang solusinya perlu dipikirkan semua orang di Teyvat bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Aku mengerti. Ini karena pedang agung itu. Dia tidak ada di pihakku. Setiap ayunannya memotong tekad mereka yang berada di sekitarku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Sampai akhirnya sifat kemanusiaanku yang pengecut, kepribadianku juga kembali padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "Lautan Primordial tidak akan meluap secepat itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Aku sudah menyadari dari awal kalau nilai yang dimasukkan dalam \"formula dunia\" telah berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Siapakah yang mengendalikan kekuatan kehidupan, dan manusia seperti apakah yang membukakan alam binatang buas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "Masih ada satu \"variabel\" lagi, yaitu dirimu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "Orang yang ditakdirkan untuk menyaksikan kekalahan seekor paus pelahap segalanya, saksi dari segalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "Ternyata begitu, ternyata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "Aku juga pernah bermimpi untuk menjadi seperti dirimu. Tapi ... mimpi ini baru saja hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "Semua yang kulakukan tidak ada artinya, bagaikan sebuah mimpi yang kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "Ini lebih rendah dari mimpi. Mimpi tidak bisa melukai, tapi aku ... bukan, kalian, dan mereka ... sudah bayar mahal karena perbuatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Ah, ternyata kamu. Aku sama sekali tidak menyadarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Apa kamu tahu siapa aku sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "Nama hanyalah sebuah panggilan. Aku sudah sangat akrab dengan dua jenis warna yang ada di dalam jiwamu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "Direktur Lyris tidak tahu apa yang sudah terjadi, tapi dia terus memeluk Mary-Ann yang berada di ambang kematian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "Dia tidak bisa memahami masa kini dan masa depan yang terlalu rumit, dia hanya ingin menyimpan masa lalu. Jadi dia melakukan satu-satunya hal yang ia bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "Namaku Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "Kalau begitu, halo, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "Aku mau memaafkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Kenapa bicaramu begitu aneh. Sejak awal rencanaku memiliki tujuan yang mulia dan suci, tidak ada niat egois sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "Tidak ada yang bisa menilaiku, tidak ada yang bisa mengadiliku, tidak ada yang bisa memaafkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "Tujuanmu mungkin memang mulia, tapi kegilaanmu telah melukai banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Bahkan rumusnya saja salah kamu masukkan. Memangnya tidak boleh dimaafkan kalau berbuat salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "Benar apa katamu. Maafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "Lalu Narzissenkreuz, ayo kita berdua kembali. Kamu masih harus bertemu dengan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Sekarang sih dia sudah lebih gampang diajak bicara, tapi permintaan kayak gini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Eh?! Biasa bukannya kita harus adu mental dulu, lalu bujuk-bujukan selama setengah hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Seperti kataku sebelumnya, aku tidak merasa melakukan kesalahan apa pun. Kini seluruh pekerjaanku telah hancur, tetapi dunia tetap terselamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Biarkan mereka memaki dan menertawakanku. Hatiku sudah kosong, dan hanya satu keinginan yang tersisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Aku ingin kembali ke awal, saat pahlawan Narzissenkreuz belum memulai perjalanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "Tapi ini sudah tidak mungkin lagi. Lagi pula, nasib seseorang tidak ditentukan oleh manusia sendiri, dan sekarang kekuatanku untuk bermimpi juga sudah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Kesatria {NICKNAME} ... kalau begitu sekarang kita bersiap-siap dan setelahnya kita segel lagi Lautan Primordial-nya, lalu keluar dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "Paus itu sudah dikalahkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Seharusnya dari awal aku menyadari kalau nilai yang dimasukkan ke dalam \"formula dunia\" berubah. Karena ada \"variabel\" yang datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Tidak semua hal yang datang dari luar alam semesta ini bisa dibilang \"Yang Turun\" atau \"Variabel\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "Ternyata aku masih kurang menghitung satu \"variabel\" lagi, yaitu dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "Yang menyaksikan segalanya, yang mencatat segalanya, yang merancang segalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Hanya seseorang yang nilainya setara dengan satu dunia yang bisa memegang gelar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
