			"dialogs": [
				{
					"id": 732950101,
					"content": "Apa kita kasih dia makanan gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950102,
					"content": "(Melihat ke arahmu dengan penuh harapan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anjing"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "Kamu enggak apa-apa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950402,
					"content": "Te-Te ... *huff* Terima kasih sudah menolongku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950403,
					"content": "Kemarin aku mimpi indah, Caterpillar sedang berdiri di ujung jalan peziarahan sambil melambaikan tangan. Tapi dalam mimpi aku sempat berpikir, \"Aneh ya, kenapa jalannya habis gua ada gua lagi, gua terus?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950404,
					"content": "Tapi Caterpillar berdiri, menunggu di ujung jalan yang sempit itu. Aku lari dan lari, tapi sebelum sampai ke sana ... aku dibangunin anjing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950405,
					"content": "Lupakan soal anjingnya deh. Aku yakin mimpi itu pertanda baik, jadi aku langsung siapkan alat gambar lalu berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950406,
					"content": "Akhirnya aku malah berputar-putar di labirin seperti Cicin buntung. Lalu aku diserang para Hilichurl ... aku gagal kabur, tambah lagi tas sketsaku juga jatuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950407,
					"content": "Sudah jatuh tertimpa tangga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "Salah siapa coba? Tempat ini lebih membingungkan daripada jalur air di bawah Fontaine! Tunggu, kudengar orang Sumeru tinggal di pepohonan, jangan-jangan tempat ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950409,
					"content": "Astaga! Apa yang di ... keluarkan, oleh orang Sumeru sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950410,
					"content": "Ngaco, ngaco sengaco-ngaconya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950411,
					"content": "*huff* Hidupku ini isinya kegagalan saja. Selalu salah langkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950412,
					"content": "Kenapa aku meninggalkan tempat yang aman tadi pagi? Aku lihat pertanda baik, tapi semua itu cuma dalam mimpi. Kenapa malah dianggap nyata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950413,
					"content": "Kenapa aku tidak langsung jujur sama kalian waktu ketemu kemarin? Kalau aku terima tawaran kalian, tidak bakalan jadi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950414,
					"content": "Kenapa aku dulu nekat meninggalkan Fontaine? Tidak pergi pun hidupku di sana masih tergolong enak ... sementara di sini, satu hal baik pun tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950415,
					"content": "Ja-Jangan menyerah gitu ngomongnya! Kami masih mau kok anterin kamu ke tempat-tempat keren. Tapi sekarang, cari barangmu yang hilang dulu, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950416,
					"content": "Meskipun kita enggak yakin bisa ketemu juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950417,
					"content": "Haha, bisa jadi sudah dipakai cebok sama Hilichurl! Ya sudahlah, toh bukan barang mahal juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950418,
					"content": "Coba kalau ngomong yang jujur apa adanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "Iya! Harganya mungkin murah, tapi nilainya mahal sekali kan buat kamu? Pokoknya kami bantu cari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950420,
					"content": "Eh, si Pepper ke mana ya? Enggak bareng kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950421,
					"content": "Heh, makhluk kejam tak berperasaan itu ... sudah pergi dari kapan. Aku berani jamin, dia lagi santai-santai di daerah kekuasaannya yang nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950422,
					"content": "Sulit dipercaya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950423,
					"content": "Pokoknya kamu balik ke kemah dan rawat lukamu dulu! Nanti kalau barangnya sudah ketemu, kami ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950424,
					"content": "Terima kasih ... teman-temanku. Ah, di dunia ini yang paling bisa diandalkan memang teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329506",
							"2"
						],
						"stepId": 7329506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anjing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "Ah, itu Pepper kan? Sepertinya dia melindungi sesuatu! Sebentar, kok kayaknya deja vu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950602,
					"content": "(Pepper menggoyangkan ekornya saat melihatmu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "Anjing"
				},
				{
					"id": 732950603,
					"content": "Eh, dia lagi jagain sketsanya si Julien ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950604,
					"content": "Pepper menggonggong dua kali, kemudian cepat-cepat pergi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "Yah dia pergi lagi. Terakhir kali juga gini ... ngomong-ngomong, kenapa Hilichurl perlu sketsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950606,
					"content": "Mungkin buat dijadiin pajangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "Masa sih ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950608,
					"content": "Beneran buat cebok deh kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#Hih! {NICKNAME}, JOROK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "Sesuai dugaan, dia sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950802,
					"content": "Hei, Julien! Sketsamu ada nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950803,
					"content": "Ah! Teman-temanku, terima kasih banyak! Tak kusangka kalian rela repot demi barang murahan begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950804,
					"content": "Jangan bilang gitu, kamu ini seniman terkenal dari Fontaine, kan? Sketsamu pasti bisa dijual mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950805,
					"content": "Em, mungkin juga? Tapi jujur saja aku tidak begitu peduli dengan uang. Maksudku, seni yang sesungguhnya itu tak bisa dinilai pakai uang, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950806,
					"content": "Hehe, kamu memang seniman sejati! Kata-katamu saja rasanya ... nyeni! Oh ya, tadi kami ketemu Pepper lagi jagain sketsamu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950807,
					"content": "Sama seperti sebelumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "Iya! Kata Paimon sih dia peduli banget sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950809,
					"content": "Maksudmu, makhluk yang membawaku ke jalan aneh meskipun sudah kuberi dia makan terus? Lalu pergi meninggalkanku melawan Hilichurl sendirian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950810,
					"content": "Ya-Yah ... mungkin dia punya pertimbangan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950811,
					"content": "Kamu ngomong gitu, tapi sebenarnya kamu suka sama dia, kan? Kalau tidak mana mungkin kamu sampai foto dia pake Kamera khusus segala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950812,
					"content": "Foto? Foto apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950813,
					"content": "Ada foto anjing di antara sketsa-sketsamu. Mirip banget sama Pepper. Warna fotonya juga unik, kamu pasti pake Kamera khusus, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950814,
					"content": "Um ... sebenarnya itu aku gambar sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950815,
					"content": "Eh? Se-Serius? Ternyata kamu asli seniman jagoan ya. Gambarmu enggak cuma realistis, tapi warnanya juga em ... nyeni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950816,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950817,
					"content": "(Paimon salah ngomong ya?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950818,
					"content": "(Jangan tanya aku, aku mana ngerti.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "Sebenarnya aku juga tidak mau menggambar yang seperti itu. Aku ... aku cuma mau jadi seniman kelas satu. Memangnya harus sesulit ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950821,
					"content": "*huff* Maaf, tidak seharusnya aku bohong pada kalian. Sudah bohong sekali, artinya harus bohong dua kali buat menutupi yang pertama, lalu begitu seterusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950822,
					"content": "Sebenarnya aku ini hanya orang payah yang tidak bisa membedakan warna dengan \"tepat\" seperti orang normal. Tapi aku tidak mau menyerah menggapai cita-cita menjadi seniman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950823,
					"content": "Jadi aku meminjam ... kemampuan seorang teman. Sekarang aku bisa menggambar apa pun sama persis dengan aslinya, tetapi aku tetap tidak bisa membedakan warna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950824,
					"content": "Tunggu. Sama persis dengan aslinya? Dan itu bukan hasil latihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950825,
					"content": "Bukan. Temanku ini punya kemampuan yang lumayan hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950826,
					"content": "Oh ya? Paimon ragu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "Lebih tepatnya, aku tidak bisa menggambar sesuatu yang hasilnya tidak sama persis dengan aslinya. Mungkin ini yang disebut \"harga sebuah kekuatan\". Aku tahu kedengarannya tidak masuk akal, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950828,
					"content": "Julien menyalin Adventure's Experience untukmu.\\nKamu terus membandingkan yang asli dan salinannya, tapi kamu tidak menemukan perbedaan apa pun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "Satu-satunya perbedaan adalah, setelah salinan itu dibaca habis, pikiran tetap terasa kosong saja ...\\nSeperti sudah membaca, tapi tidak dapat apa-apa. Hanya waktu saja yang terbuang percuma.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "Bentuknya sih kayak pinang dibelah dua sama aslinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950829,
					"content": "Tentu saja akhirnya aku tidak jadi seniman terkenal, tapi malah jadi ahli memalsukan barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950830,
					"content": "Melanggar hukum dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950831,
					"content": "Betul. Jadi setelah masa hukumanku habis, aku bertekad untuk kerja halal. Kali ini aku harus bisa jadi seniman tulen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950832,
					"content": "Tapi kemampuan menggambar sesuatu sama persis dengan aslinya ini ... kalau bukan Caterpillar yang kasih, pasti sudah kuanggap ini kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950833,
					"content": "Aku yang sekarang ini tak ubahnya sebuah Kamera yang rusak, hanya bisa menghasilkan foto yang warnanya tak karu-karuan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950834,
					"content": "Awalnya kukira bisa sembuh kalau berziarah menyusuri jalur Oceanid ... agar aku bisa membedakan warna seperti orang lain, dan memiliki kreativitas seperti seorang anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950835,
					"content": "Tunggu dulu, Caterpillar itu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "Temanku ... teman yang sangat bisa diandalkan. Dia juga yang bilang kalau berziarah mengikuti jalur para Oceanid, aku pasti bisa menemukan obat ajaib Sumeru yang bisa menyembuhkan segalanya dan memberi hidup baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950839,
					"content": "Kok kedengaran mencurigakan sekali ya?! Temanmu ini kayak apa sih orangnya? Yakin enggak kena tipu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950840,
					"content": "Dia sangat berwawasan, pengalamannya juga segudang. Apa untungnya dia menipu? Kalau pun ada yang tidak beres, sudah pasti karena akunya yang salah ... hidupku ini memang cuma serentetan kegagalan yang datang silih berganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950841,
					"content": "Obat ajaib ini pasti dijaga dengan sangat ketat ... bukan sesuatu yang bisa didapatkan orang biasa sepertiku. A-Aku ... sudah pasrah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950842,
					"content": "Aku yakin anjing itu juga sebenarnya tidak mau ikut ke Sumeru. Kalau tidak, kenapa dia terus menghalangiku? Harusnya kutinggal saja dia di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950843,
					"content": "Kalau kata Paimon sih, dia mau kok ikut kamu. Dan dia juga kelihatan suka banget sama gambarmu ... ayo, jangan nyerah gitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950844,
					"content": "Kata-kata yang sangat menghibur ... tapi aku sudah pasrah. Kalian berdua sudah banyak membantu, dan aku tidak bisa memberi imbalan yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950845,
					"content": "Aku akan segera bersiap kembali ke Fontaine setelah istirahat. Mungkin ini sedikit keterlaluan, tapi maukah kalian antar aku kembali ke jalan utama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950846,
					"content": "Andai aku lebih cepat menyerah, atau tidak termakan gengsi sendiri ... mungkin sekarang aku sudah di jalan yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950847,
					"content": "Anterin kamu ke jalan utama sih gampang. Ya sudah, kalau sudah memutuskan mau apa sih, sana istirahat dulu yang benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950850,
					"content": "Terima kasih, teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950837,
					"content": "Jalur ziarah apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "Caterpillar menyebutkan tentang jalur yang disusuri para Oceanid, yang berujung di Sumeru. Di sana ada obat ajaib yang bisa menyembuhkan segalanya dan memberi hidup baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950819,
					"content": "(Mungkin darah seni Paimon levelnya ketinggalan jauh.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
