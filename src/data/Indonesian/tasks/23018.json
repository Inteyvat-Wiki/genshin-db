					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Karena para pelajar juga melakukan hal yang sama ... maka aku jadi bisa makan daging dengan tenang, terima kasih!",
