			"dialogs": [
				{
					"id": 230180301,
					"content": "Eh? Ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Ini obatnya, ingat untuk berdoa pada Archon Dendro di rumah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "Terima kasih. Berdoa ke Archon Dendro ya ... ini memang harus sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
