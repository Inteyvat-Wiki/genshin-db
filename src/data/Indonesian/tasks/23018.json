			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*huff* Bikin sakit kepala saja deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Akhir-akhir ini kita benar-benar kekurangan orang, aku sudah beberapa hari tidak istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "Pengembara, kalau kamu ada waktu, bolehkah bantu aku berikan obat ini pada pasien? Dan tolong bantu lihat kondisi mereka juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Kalau gitu tolong ya, dalam nama Archon Dendro, aku benar-benar butuh pertolongan seseorang yang tidak cuma mengandalkan Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ha, dalam nama Archon Dendro ... sepertinya aku sudah biasa sekali ya mengucapkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Kamu istirahat saja dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Aku tidak bisa istirahat, masih ada beberapa pasien yang lebih parah dan aku harus menyiapkan obat untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "Uhh, pasti mereka bertanya padaku lagi bagaimana cara mendapatkan berkah dari Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "Tolong ya pengembara. Aku benar-benar butuh pertolongan seseorang yang tidak cuma mengandalkan Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Apa yang terjadi di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "Kamu pengembara kan, di sini adalah \"Bimarstan\", sebuah rumah sakit umum ... hmm ... rumah sakit yang menyebarkan berkah dari Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Kami akan memberikan pengobatan pada siapa pun tidak peduli kaya atau miskin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Tapi karena itu ... pasien yang datang akhir-akhir ini terlalu banyak dan kami sangat sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "Uhh, walaupun belas kasih Archon Dendro pada kami tidak terbatas ... tapi tenaga kerja di rumah sakit ada batasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Ada beberapa pasien yang tidak mau mendengarkan dokter, dan terus bertanya padaku bagaimana cara menerima berkah dari Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, berkah dari Archon Dendro ... Ya ampun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Kalau Archon Dendro bisa memberikan berkah langsung dari langit, mereka tidak akan sakit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "Huh, maaf, aku tidak seharusnya berkata begitu, jangan beri tahu Golshan ya, kalau tidak dia pasti menceramahiku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Bukankah kamu pengikut Archon Dendro yang taat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Iya, memangnya ada penduduk Sumeru yang bukan pengikut Archon Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Tapi kamu bisa mengganti kata taat, aku adalah seorang ... pengikut Archon Dendro yang logis, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Hmm ... maaf, aku terlalu letih, ini cuma emosi sesaat, jangan dianggap serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Ada yang bilang pengobatan adalah berkah dari Archon Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*huff* Anggap saja itu cuma sebuah cerita, oke? Jangan mempercayai hal itu begitu saja seperti para pasien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Kalau memang Archon Dendro bisa melakukan semua hal, kalau gitu aku akan memberikan jamur pada pasien dan mereka akan sembuh begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
