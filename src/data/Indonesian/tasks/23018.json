			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Kali ini obatnya mau diberikan kepada Gurgen di kebun obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Dia bekerja terlalu keras beberapa hari lalu dan tangannya terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Berikan obat ini padanya dan sekalian beri tahu dia, hari ini diam saja di rumah dan berdoa pada Archon Dendro. Pekerjaan di kebun masih bisa nanti",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Setelah mengirim obat, kembali dan cari aku, aku sudah siapkan imbalan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Doa pada Archon Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Kalau aku tidak bilang begitu mana mungkin dia mau dengar? Sudah, pokoknya ikuti saja kata-kataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
