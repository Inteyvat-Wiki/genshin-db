			"dialogs": [
				{
					"id": 230181601,
					"content": "Kamu sudah pulang? Apakah semua berjalan lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Beberapa hari ini dia belum makan daging lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "Apa? Aku hanya menyuruhnya makan makanan yang memiliki rasa ringan, bukan tidak boleh makan daging sama sekali kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Mungkin dia begitu agar bisa menerima berkah Archon Dendro dengan lebih baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "Baiklah ... Aku akan mengubah kata-katanya lagi nanti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "Terima kasih ya, mohon terimalah imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
		},
