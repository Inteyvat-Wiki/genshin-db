			"dialogs": [
				{
					"id": 722040301,
					"content": "*haah* Semakin lama semakin tidak jelas, semuanya semakin kabur saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Halo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "*haah* Ingatanku semakin hari semakin jelek. Begitulah kalau sudah tua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Bagaimana ini? Aku tidak tahu kalau Kito dan Kina sudah lapar, atau apakah mereka baik-baik saja main di luar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Mereka pasti baik-baik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Oh, Kito, Kina! Apa kalian jatuh atau menabrak sesuatu di jalan? Kalian tidak nakal manjat pohon lagi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Ah, kalian ini bisanya bikin nenek tua ini khawatir saja! Aku tidak tahu apa yang terjadi belakangan ini, tapi kok rasanya semakin lama semakin sedikit saja orang di pulau ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Dan aku sudah tinggal ingat sedikit saja dari mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "Ah, bagaimana jadinya kalau aku sampai lupa pada kalian berdua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "Ini, ambil kelopak bunga ini. Kalau nenek sampai lupa pada kalian, tunjukkan saja ini pada nenek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Nenek masih punya banyak cerita buat kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Ada kejadian apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
