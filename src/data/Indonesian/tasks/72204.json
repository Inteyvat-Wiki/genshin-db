				{
					"id": 722040401,
					"content": "Tapi lain kali saja. Kalian pergi, main saja. Nenek akan tetap di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Kelopak bunga, kelopak bunga, bagaimanakah rupa kampung halamanmu?",
