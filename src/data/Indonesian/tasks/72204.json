				{
					"id": 722040901,
					"content": "Ah, sudah datang ya. Kito! Kina! Sini, sapa tamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "Una"
				},
				{
