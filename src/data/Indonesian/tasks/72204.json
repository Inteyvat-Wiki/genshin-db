			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Ah, Abe ya? Bagaimana kabarnya jamur-jamur di rumahmu? Haha ... Jangan ganggu tetua agung lagi. Aku tidak akan setuju tak peduli seperti apa dia memaksa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Haha, maaf! Seorang diri mengurus rumah ini lumayan sibuk juga. Maaf ya, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "Maaf ... *haah* Aku minta maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Halo, nenek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Ah! Kamu! Kamu ... Sini, cepat masuk jangan bikin malu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Bagaimana mancingnya? Apa, tidak dapat satu ikan pun? Ah, sudahlah. Hasil kebun kita seharusnya cukup. Yah, tapi tidak akan cukup kalau untuk diserahkan ke Great Thunderbird ... Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Apa kamu bilang? Upacara tahun ini berakhir dengan baik! Tahun-tahun berikutnya juga pasti baik. Tetua agung bahkan bilang kita akan punya anak yang sehat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Kenapa ngomong ini sekarang? Apa kamu sudah lupa apa yang terjadi dengan Klan Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
					"content": "Tolong tenangkan dirimu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Kalau kamu mau berbalik dari Great Thunderbird dan hilang ditelan ombak, silakan saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Anakku ... Anakku yang malang ... *haah*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "\"Kama\" ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
