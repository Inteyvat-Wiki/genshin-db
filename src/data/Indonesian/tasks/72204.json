					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Oh. Halo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "Maaf, tapi semakin tua, pikiranku semakin kabur. Maaf, tapi siapa kamu? Apa kita sudah kenal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Namaku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Aku belum pernah dengar nama seperti itu sebelumnya. Apa kamu orang luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Aneh. Kamu seharusnya tidak bisa mendarat di sini tanpa seizin Great Thunderbird ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Thunderbird telah lama tiada ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Ah, melihatmu, aku jadi ingat suamiku yang malang. Aku bahkan sudah tidak ingat lagi wajahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Waktu itu kami masih muda, dan kepala kami penuh dengan segala macam khayalan liar ... Tapi sebagian orang tidak juga dewasa. Bahkan setelah sebegitu banyak waktu dihabiskan bersama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Dia meninggalkanku di sini. Dia membuat sebuah rakit dan mencoba berlayar menyeberang laut, ke tempat orang luar tinggal. Dia bilang dia ingin berburu dengan bebas dan memetik bunga-bunga yang cantik di sana ... Bunga cantik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Dia selalu bilang begitu sejak kami masih muda dulu ... Dia masih saja tidak dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Kemudian, anak tetua agung menemukan dia ... terbaring di pantai, terdiam bagaikan cangkang kerang, lebih putih dari pasir ... Dia menggenggam bunga-bunga ini di tangannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Tetua agung itu menangis, dan berkata ... perahu nenek moyang kami menolak dirinya. Arwahnya akan gentayangan di tanah orang luar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Ketika itu, aku baru saja melahirkan anak kami ... Bagaimana bisa aku memberitahukan ini kepadanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Setelah itu, anakku juga punya anak, dan aku mengirim anakku ke perahu perak, sementara aku tetap diam di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Kalau sesuatu yang mengikatku dan membuatku khawatir ... mungkin Kito dan Kina ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Sepertinya ini perlu penjelasan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Panggil saja aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
