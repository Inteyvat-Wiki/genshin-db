					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, kalian sudah datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Ampun ya, kalian suka sekali lari-lari ke sana kemari. Kaki nenek tua ini sudah tidak kuat mengikuti kalian! Apa jadinya kalau kalian sampai kena masalah, hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Halo ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Apa? Anak kecil seperti kalian bisa-bisanya bilang begitu sama nenek tua ini? Sakitnya tuh di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Yah, karena kalian sudah ada di sini, jangan lari-lari sembarangan ya, paham? Temani nenek sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Maaf, aku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Nah, sampai mana ceritanya? Oh, iya ... waktu kakeknya kakek kalian masih muda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Jauh di balik Lautan Kabut, di pulau kediaman orang luar, tinggal sebuah klan yang bernama Sumari. Menurut kabar, klan itu dikepalai seorang wanita berwujud rubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Katanya, bunga dengan kelopak sewarna petir tumbuh di pulau itu, dan orang-orang Sumari membangun rumah dan hidup rukun di antara pegunungan dan dataran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Lalu ... haa ... Bunganya ... huu ... *zzz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "*zzz* Di balik Lautan Kabut, ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Ah, nenek baik-baik saja kah ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Ah? Kito, Kina? Mau pergi? *haah* Maaf, aku pasti ketiduran lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Jangan lupa bawa ini sebelum ke luar ... Nenek sudah simpan ini untuk kalian: bunga dari tanah di balik Lautan Kabut. Jangan sampai hilang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Sebaiknya jangan diganggu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Baiklah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Kamu salah orang deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
