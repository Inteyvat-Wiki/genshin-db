				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Er'ye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Sekarang, semakin aku mendengarkan semakin aku benar-benar tidak mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090302,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "Oh ternyata pengembara, ada banyak pertunjukan baru di Heyu Tea House.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090304,
					"content": "Tapi opera baru ini... walaupun terlihat hidup, tapi aku tidak bisa mengerti sedikit pun, tapi anak muda sangat menyukainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090305,
					"content": "Anda pikir seperti itu bagus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Itu pertanyaan yang bagus. Secara pribadi, aku tidak keberatan mendengar beberapa karya klasik lama. Lagi pula aku pernah melakukannya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090307,
					"content": "Tetapi pada saat yang sama, Pelabuhan Liyue mengalami banyak perubahan. Beberapa opera baru tampaknya juga cocok dengan suasana hati yang berkuasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090308,
					"content": "*huff* namun, perubahan ini terasa terlalu cepat. Opera lama sudah lama tidak dimainkan. Aku ingin tahu apa yang akan Rex Lapis — ah tidak, sebaiknya kita tidak membicarakan itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
