			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "Apa yang sudah kamu pelajari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "Ada banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Oh, benarkah? Coba ceritakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "Ada banyak anjing di dermaga selatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Oh, bagus bagus, pengalaman yang sangat hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "Ada banyak kelompok burung di Bubu Pharmacy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Ah ya... sebuah pemandangan indah penuh kedamaian, benar-benar bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Beberapa hanya mementingkan makanan saja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Haha, tidak ada yang salah dengan itu. Makan adalah salah satu kebutuhan dan kegembiraan utama dalam hidup - terutama di kota seperti Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Ya, ini juga cukup menarik. Aku akan mencatat ini. Ini mungkin masih berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Beberapa orang merasa bahwa banyak hal berubah terlalu cepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Hmm, itu juga seperti yang kita harapkan. Bagi sebagian orang, Liyue tampaknya hampir kehilangan kulitnya setiap hari. Bahkan aku merasa sulit untuk mengikuti atau menerima setiap irama hidup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "Tapi ini cakupannya luas juga - aku khawatir satu puisi mungkin tidak cukup untuk menggambarkannya. Namun, aku tetap akan menuliskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "Itulah yang harus dilakukan untuk saat ini. Aku melihat bahwa pilihanku bijak dalam meminta bantuanmu, teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "Aku percaya bahwa ini akan menambah setidaknya beberapa pandangan baru ke dalam puisi antologi milikku berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "Ah iya, selain beberapa barang, aku juga sudah menyiapkan hadiah kecil untukmu. Mohon terimalah sebagai tanda terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Setelah puisi baruku diterbitkan, kamu dapat menukar tanda tangan ini dengan sebuah buku gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
