			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Bagus, bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "Apanya yang bagus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "Oh, ternyata pengembara. Bukankah sebelumnya juga pernah ada hal penting begini di kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Untungnya, tidak ada yang gawat setelah kejadian itu. Yang terpenting adalah... restoran-restoran di kota ini juga masih menjalankan bisnisnya dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "Kalau tidak, aku tidak bisa makan begitu banyak hidangan enak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Jadi karena makanan ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Jangan meremehkannya. Cara paling baik untuk menilai kualitas suatu tempat adalah dengan melihat makanan di tempat tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Ah... aku jadi lapar lagi karena kebanyakan ngobrol, aku harus makan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
