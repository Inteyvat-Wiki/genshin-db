				"objectNames": [
					"Hasegawa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Halo, ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Halo, apa kamu pernah baca \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Aku pernah baca, novel itu menarik. Baik tokoh-tokohnya maupun alur ceritanya, semuanya menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Tapi belakangan ini... kurasa penulisnya lagi malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Eh... Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Ada banyak sekali kemampuan tambahan buat tokoh utama, yang belum pernah diceritakan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Biar disebut \"pencerahan\" pun, tiba-tiba menambah kemampuan begitu rasanya murahan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Plot yang murahan membuat tokohnya jadi ikut terlihat murahan. Aku sangat berharap penulisnya mau mempertimbangkan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "...Pengembara, kita... kita tanya lagi orang berikutnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201305,
