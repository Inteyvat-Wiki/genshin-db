				"objectNames": [
					"Yuzu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Halo, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Halo, apa kamu pernah baca \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Eh? Pernah sih. Dulu aku suka, tapi... Jujur ya, ceritanya semakin ke sini semakin aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Tidak peduli siapa lawannya, tokoh utamanya tiba-tiba saja dapat kemampuan baru dan langsung bisa mengalahkan lawan dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Dulu aku suka \"Onibudou\" karena tokoh utamanya selalu punya cara yang cerdik untuk mengalahkan lawannya. Tapi sekarang... sepertinya penulisnya mulai malas cari ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Lalu, kemampuan tokoh utama itu sebagian besar hanya keluar sekali saja. Kan jadi seperti asal-asalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Aku heran sebenarnya apa yang ada di pikiran penulisnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Ehem... Kita cari lagi pembaca yang lain. Komentar satu orang tidak bisa mewakili semuanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
