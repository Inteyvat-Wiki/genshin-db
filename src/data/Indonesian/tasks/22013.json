				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Sebenarnya kamu sudah baca tanggapan pembaca belum? Belakangan ini penilaianmu menurun drastis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Jangan panik begitu, ini cuma gejolak biasa sebelum puncak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Setelah ceritanya masuk ke plot utama, mereka akan berubah 180 derajat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Sebelum hari itu tiba, novelmu sudah keburu kandas di tengah jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "Ada apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "Pengembara, untunglah kamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Semenjak kembali dari \"pencarian inspirasi\"-nya tempo hari, Junkichi terus saja menambahkan kemampuan aneh-aneh ke tokoh utama \"Onibudou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "Yae Publishing House sudah terima begitu banyak tanggapan negatif dari para pembaca. Mereka tidak paham untuk apa kemampuan-kemampuan itu ditambahkan. Mereka jadi mengira novelnya ditulis asal-asalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Mereka cuma belum paham saja. Asalkan aku konsisten, mereka lama-lama juga paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Makanya kan tadi aku sudah bilang, sebelum mereka paham, novelmu sudah keburu kandas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Sudahlah... Oh iya, aku ingat kalau di sekitar sini ada pembaca \"Onibudou\" juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Kalau kamu yakin pembacamu semua suka, langsung saja tanya mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "Oke, siapa takut! Aku yakin mereka semua paham. Pengembara, mau ikut? Kamu bisa jadi saksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "Ide bagus. Kalau ada Pengembara, kamu tidak bisa berkelit lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Oke, aku ikut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Baiklah kalau begitu, kami jalan dulu. Aku yakin mereka akan memahamiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Sebenarnya berapa banyak latar yang kamu tambahkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Se-sedikit. Iya, cuma sedikit saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "\"Sedikit\"? Kalau kamu lanjut, kemampuan tokoh utamamu akan jauh melampaui kemampuan tokoh-tokoh lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Ehem! Kami berangkat. Aku yakin mereka paham!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
