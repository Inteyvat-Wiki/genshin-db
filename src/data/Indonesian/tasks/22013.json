			"dialogs": [
				{
					"id": 220130501,
					"content": "Halo, ada yang mau kalian bicarakan denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130502,
					"content": "Halo, apa kamu pernah baca \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "Pernah. Aku suka sekali dengan tokoh utamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130504,
					"content": "Tapi, aku semakin lama semakin lelah membacanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130505,
					"content": "Lelah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "Di beberapa bab terakhir, tokoh utamanya tiba-tiba dapat banyak kemampuan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "Ada banyak sekali bagian yang menceritakan dari mana asalnya kemampuan-kemampuan itu, dan cara menggunakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "Lalu, nama-nama kemampuannya juga semakin tidak jelas. Susah sekali untuk diingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "Tapi kalau aku lanjut baca pun, rasanya susah untuk mengikuti alur ceritanya kalau tidak paham soal kemampuan-kemampuan tidak jelas tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "Eh, mungkin lebih baik aku berhenti dulu baca novel ini. Mendingan aku ganti baca novel lain yang lebih simpel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Eh... Aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Kita balik saja yuk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "Baiklah... Kenapa jadi begini ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
