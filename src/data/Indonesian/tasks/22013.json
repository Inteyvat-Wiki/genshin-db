			},
			"dialogs": [
				{
					"id": 220130601,
					"content": "Bagaimana? Kalian sudah menanyakan pendapat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "...Kok dia jadi lesu begitu? Pendapat macam apa yang kalian dengar tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "Tuh kan... Hei Junkichi, sekarang kamu percaya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Aku tidak habis pikir, kenapa bisa begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Jadi selama ini ide-ideku, cara penulisanku, semuanya... tidak menarik bagi para pembaca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Kan aku sudah bilang, melanjutkan cerita dengan hanya bergantung pada penambahan latar itu bahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Penambahan seperti itu mungkin awalnya seperti angin segar, tapi setelahnya, para pembaca justru akan jadi jenuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Aku bicara dari pengalamanku setelah sekian lama berkecimpung di bidang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "I-iya, aku paham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Untung masih ada waktu... Penilaian untuk yang kemarin tidak bisa diubah, tapi minimal kamu sekarang bisa buat lanjutannya jadi lebih mantap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "Terima kasih, Pengembara. Setidaknya pukulan ini membuat dia sadar dan belajar. Dan untungnya, dia belum jatuh terlalu dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Terima kasih sekali lagi. Ini sedikit imbalan untukmu, terima ya.",
					"roleType": "TALK_ROLE_NPC",
