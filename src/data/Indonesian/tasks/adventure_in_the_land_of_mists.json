					"content": "Sudah nemu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330202
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330202,
					"content": "Cari lebih teliti, siapa tahu ada mekanisme atau jalan rahasia apa gitu!",
					"roleType": "TALK_ROLE_NPC",
