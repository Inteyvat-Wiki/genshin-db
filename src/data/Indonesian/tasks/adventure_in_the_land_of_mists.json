			"dialogs": [
				{
					"id": 751330301,
					"content": "#Kebuka loh! Makasih {REALNAME[ID(2)|SHOWHOST(true)]}, kita berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} memang keren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Tapi jangan sombong dulu. Masih banyak tantangan menanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Jalannya sudah kebuka, kita jelas enggak boleh mundur setengah jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Setuju, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Ciii! Ciii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330308,
					"content": "Kenapa? Enggak mau masuk? Takut ya? Ini sudah setengah jalan, pantang kalau mau mundur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Gluk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330310,
					"content": "Dia ketakutan banget tuh kayaknya. Jangan dipaksa deh. Apa di bawah sana ada bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Aku juga takut nih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Kenapa jadi KAMU yang takut? Berani dong! Lihat tuh si {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Seru nih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Paimon enggak nyangka kamu bakal sesemangat ini. Tapi Paimon tahu sih kamu bisa beresin apa pun yang ada di bawah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Tenang, contoh tuh Saurian mini kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Kalau Coco takut, dia suruh tunggu di sini ... eh, jangan deng. Ditinggal sendirian juga bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Tidak ada jalan lain. Aku sama Coco tunggu sini, kalian bawa Pyrophosphorite-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Apa pun yang ada di bawah sana, ingat! Kalian harus balik lagi ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "Kami tidak akan meninggalkan siapa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "Aku percaya. Kami tunggu di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330322,
