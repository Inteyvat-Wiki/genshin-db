				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Paimon enggak nyangka Coco bakal arahin kita ke sini. Benteng aneh ini mirip sama tempat kita ketemu Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Tuh, muralnya saja sama! Tapi enggak ada bekas kotornya. Apa karena kita lebih tinggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}! Ini pasti Raja Ular yang si Bona omongin. Garang betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Iya, itu Raja Ular Och-Kan. Katanya, dia menindas dan menyiksa orang-orangnya demi membangun Tonatiuh, sampai akhirnya menarik perhatian Abyss. Ajal serta kejatuhan kerajaannya pun tiba tak lama setelah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Tapi itu cuma legenda. Penutur cerita sukuku punya versi lain lagi tentang nasib Raja Ular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "Mungkin dia masih mengarungi langit di atas Tonatiuh. Atau mungkin naga jahat yang selalu mencoba menjegal kita itu hantunya yang gentayangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "Kuchi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330108,
					"content": "Jangan cerita horor gitu dong! Coco ketakutan tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "Fuwaaa! Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#Si {REALNAME[ID(2)|SHOWHOST(true)]} gatel pengin ngerjain sesuatu semenjak kita berhasil ngalahin naga jahat. Apa dia merasa kesaingin gitu ya sama Coco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Nah, di mana Altar yang kita cari-cari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Kalau Coco benar, harusnya ada di bawah kan ... Eh, padahal kirain bakal ada di tempat yang lebih tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "Salah ya? Altar Api Purba masih di dalam gunungnya kan? Gimana caranya dia pindah ke langit, kalau gunungnya masih ada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "Apa mungkin ada cara khusus buat mindahin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "Terus sekarang gimana? Kamu yakin banget waktu di bawah tadi. Kita juga enggak paham bahasa Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "Kulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330117,
					"content": "Fuwaaa! Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} tahu sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Aku paham. Dia mau bilang kalau ini percuma dipikirin secara logis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "Ngarang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "Apa pun yang ada di bawah sana, kayaknya kita tetap harus lihat. Kita kan lagi bertualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#Paimon enggak nyangka si {REALNAME[ID(2)|SHOWHOST(true)]} bakal semangat banget gini. Ya sudah, kita cari jalan ke bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
