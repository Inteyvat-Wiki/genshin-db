			"dialogs": [
				{
					"id": 761001601,
					"content": "Gimana kabarnya Bjorn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "Kritis. Serangannya terlalu tiba-tiba, dan demi melindungi kami, dia ... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "Medan perang terlalu bahaya, dan dia tidak bisa dipindahtempatkan. Kami terpaksa beri pengobatan darurat di lapangan, tapi dengan persediaan cuma segini-gininya, dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "Kapten ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "Maaf ... misi ... gagal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "Kamu berhasil kok! Posisi berhasil dipertahankan, dan semua orang selamat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "Oh ya? Benarkah ... bagus ... baguslah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "Jangan banyak bicara. Kamu perlu istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "Kalau tidak sekarang ... nanti sudah tidak bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "Tidak boleh bicara begitu! Ini perintah kapten, kamu ... kamu akan baik-baik saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Hah ... baiklah ... laksanakan ... aku ... tidak akan ngomong begitu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "Tapi sekarang setidaknya aku ... bisa ketemu Veyde ... tanpa penyesalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "Dia bilang kita ... Lightkeeper ... seperti rumput Winter Icelea ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "Di hadapan Perburuan Liar ... kita semua rapuh ... seperti rumput Winter Icelea ... yang gampang pecah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "Tapi selama daunnya masih ada ... selama akarnya masih menancap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "Di musim berikutnya ... dan berikutnya lagi ... dia akan tetap berbunga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "Kita tidak akan gagal ... ya kan ... Kapten ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "Ya. Tidak akan gagal! Monster itu akan dikirim ke akhirat, oleh tanganku sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "Kamu ... yang paling kuat ... di antara kita ... Kapten ... aku percaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001621,
					"content": "Percayalah, Bjorn. Aku tidak akan ingkar janji. Istirahatlah ... nanti setelah kamu bangun, situasinya pasti sudah membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001623,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#{NICKNAME}, Paimon. Kita harus pergi. Misi belum selesai, jangan berlama-lama di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001625,
					"content": "Illuga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761001626,
					"content": "Kita harus terus. Demi Bjorn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "Habisi musuh, raih kemenangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "Oke ... ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
