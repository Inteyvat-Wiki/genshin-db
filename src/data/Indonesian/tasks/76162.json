			"dialogs": [
				{
					"id": 761000701,
					"content": "Minggir, minggir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Hehe ... kenapa buru-buru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000703,
					"content": "Kalian semua pada akhirnya akan mati ... tapi ada beberapa ... yang bakal mati lebih cepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000704,
					"content": "Dia terus-terusan mengeluh kenapa tidak mati tiga tahun lalu ... sekarang ... keinginannya sudah terkabul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000705,
					"content": "Bjorn? Kamu apakan dia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Dia lemah ... terlalu lemah ... pecundang ... semut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000707,
					"content": "Mati ... cuma itu saja gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000708,
					"content": "Jangan asal ngomong kau! Dia tidak lemah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Oh ... jadi menurutmu ... dia kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000710,
					"content": "Tapi ... orang kuat pun ... pada akhirnya akan mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000711,
					"content": "Aku kira kamu ... paham soal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000712,
					"content": "Yang lebih kuat dari kamu ... semuanya mati juga, ya kan. Tiga tahun lalu ... sepuluh tahun lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000713,
					"content": "... Diam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Ya ... yang lemah ... cuma kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000715,
					"content": "Kalau tidak ... kenapa setiap kali ... setiap kali ... cuma kamu yang selamat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000716,
					"content": "Kamu lari ... lari dari medan pertempuran ... pecundang pengecut yang takut mati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Suara Monster"
				},
				{
					"id": 761000717,
					"content": "Illuga, jangan didengerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Cukup! Waktunya KAMU yang mati!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#{NICKNAME}! Aku ... kita ... bereskan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
