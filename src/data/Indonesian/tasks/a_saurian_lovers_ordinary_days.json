			"dialogs": [
				{
					"id": 750240601,
					"content": "Shrawrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Bunga Marigold\""
				},
				{
					"id": 750240602,
					"content": "Jangan terlalu semangat! Kami cuma mau lihat orang di sana terluka apa enggak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Waktunya duel nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Ayolah! Jangan cepat nyerah gitu dong! Kami kan enggak punya niat jelek! Kami juga tahu kok, err ... kamu itu sebenarnya enggak suka berantem ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Shrar! Grawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Bunga Marigold\""
				},
				{
					"id": 750240607,
					"content": "Kacau nih, makin marah kayaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"Oh Bunga Marigold, Bunga Marigold kesayanganku ....\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
			"id": 7502407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
