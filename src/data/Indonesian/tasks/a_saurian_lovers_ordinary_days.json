			"dialogs": [
				{
					"id": 750240101,
					"content": "Sayangku, antusiasmemu ... sungguh luar biasa. Ayo kita minum es dulu untuk dinginkan kepala, baru kita bicara, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "Shrawrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "\"Bunga Marigold\""
				},
				{
					"id": 750240103,
					"content": "Pada awalnya kamu mendengar jeritan \"aduh\", lalu suara teredam dari sesuatu yang berat menghantam tanah, kemudian suara rintihan Saurian ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Eh?! Dia baik-baik saja kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Aduh, mereka dikepung ... Enggak kelihatan apa-apa nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Coba Paimon lihat dari atas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bilang biar dia saja yang cobain, kalau gitu tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Kayaknya ada yang aneh deh. Orang itu belum mati kan? Eh amit-amit tok tok tok! Bisa jadi dia cuma pingsan! Ayo cepat kita tolongin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Halo, numpang lewat dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "Shrar! Grawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "\"Bunga Marigold\""
				},
				{
					"id": 750240113,
					"content": "Mmrawr...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "\"Ombak Kecil\""
				},
				{
					"id": 750240114,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "\"Batu Giok\""
				},
				{
					"id": 750240115,
					"content": "Haduh, mereka enggak mau bergerak sama sekali ... ada apa sih di sini? Kalau menurut orang tadi sih harusnya dia kenal Saurian ini kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Seandainya ada lebih banyak petunjuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "Nguk ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Eh? {REALNAME[ID(2)|SHOWHOST(true)]}! Kamu ketemu sesuatu ya? Gas! Kita buntutin di belakang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
							"2"
						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"Hari ini hujan ... Aku sudah siapkan <color=#00E1FFFF>Sour Sauce Kipper</color> favoritnya Ombak Kecil. Lihat dia senang saja aku sudah puas ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240202,
					"content": "\"Bahkan kalau dia lagi berenang santai pun, tinggal keluarkan <color=#00E1FFFF>Sour Sauce Kipper</color>-nya dan sim-sala-bim! Dia akan langsung melompat keluar dari air dengan postur sempurna!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240203,
					"content": "\"Aku tidak pernah meragukan cintanya padaku. Hanya saja, sepertinya dia jauh lebih suka <color=#00E1FFFF>Sour Sauce Kipper</color> daripada aku ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240204,
					"content": "Jadi ... Ombak Kecil tuh namanya Koholasaurus ini ya? Berarti Sour Sauce Kipper dalam panci yang di kemah sana punyanya dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"Mata bundar besar, ekor melengkung, dan suara yang ceria ... Batu Giok, oh Batu Giok, apa ada Saurian yang lebih lucu darimu di dunia ini ...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240206,
					"content": "\"Kamu sekalipun tidak pernah ditipu atau diragukan, hidup bagaikan seorang teman yang senang menemanimu bermain ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240207,
					"content": "\"Kalau aku tidak sesibuk itu, aku juga akan senang bermain bersamamu seharian, melihatmu berlari di antara pohon-pohon di bawah matahari seperti anak angin yang bebas tak terkekang! ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240208,
					"content": "#Ah, jadi namanya si Yumkasaurus kecil ini Batu Giok ya. Kayaknya anaknya ceria ya! Mungkin bisa cocok sama {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"Aku melintasi gunung dan lembah hanya untuk mencarimu. Kalau benar-benar tidak ingin melihatku, kamu bisa pergi begitu saja ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240211,
					"content": "\"Tapi kamu malah mempertimbangkan kecepatanku, berhenti dan berjalan sebentar-sebentar, bahkan membantuku mengumpulkan banyak sekali Grainfruit, dan bebatuan yang berkilau itu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240212,
					"content": "\"Oh, Bunga Marigold ... Bunga Marigold kesayanganku ... Hanya aku yang tahu, kalau ada hati yang lembut terbungkus dalam cangkang yang keras. Dan bertempur dengan berani tidak pernah menjadi maksud awalmu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Buku Harian Seseorang"
				},
				{
					"id": 750240213,
					"content": "Err ... Jangan-jangan Bunga Marigold itu si Tepetlisaurus yang emosian? Yang model kayak gitu, hatinya dibilang lembut? HALOOOW??? Tidak salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Intinya, kembali ke topik. Jadi tiga Saurian ini ... temannya dia? Terus kenapa mereka gebuk dia sampai pingsan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Tolongin dia dulu deh, baru interogasi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Ya juga sih ... Andai saja kita bisa punya cara untuk buat Saurian minggir ... Oh ya, buku hariannya kan bilang kalau Ombak Kecil suka makan Sour Sauce Kipper, kan? Ada di kemah tuh, siapa tahu bisa menarik perhatiannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Kalau Batu Giok ... Coba minta {REALNAME[ID(2)|SHOWHOST(true)]} berteman sama dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Nah boleh tuh! Batu Giok kan suka main! {REALNAME[ID(2)|SHOWHOST(true)]} cuma perlu bawa dia main saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Nguk, nguuk, NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#Nah kan, {REALNAME[ID(2)|SHOWHOST(true)]} juga jadi semangat. Mending kita coba cara yang mudah dulu. Kalau pakai Sour Sauce Kipper terus enggak dimakan, kan sayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Adu jotos sama Bunga Marigold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Err ... Kita mengusung tema kedamaian dulu deh ya. Misalnya, minta {REALNAME[ID(2)|SHOWHOST(true)]} untuk ngajak Batu Giok main ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
