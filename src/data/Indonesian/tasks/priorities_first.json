				},
				{
					"id": 760000202,
					"content": "Kayaknya enggak penting deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "Kalau dilihat dari lokasi, kayaknya memang enggak mungkin sih nyimpan barang penting di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "Kalau gini sih kita wajib lihat ke dalam! Parah, ini kalau dibiarin Paimon bisa kepo terus, penasaran terus, enggak bisa dikeluarin, kayak sembelit gara-gara kebanyakan makan sosis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "Pintunya dikunci, tapi kali ada jalan lain buat masuk ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "Kayaknya sih ada eksperimen yang jahat banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "E-Eksperimen jahat ... kalau iya, pengamanan di sini kurang pakai banget dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
