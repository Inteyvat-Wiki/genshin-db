						750691308
					]
				},
				{
					"id": 750691308,
					"content": "Iya, cuma suara air terjun di sini yang bisa menutupi suara air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691309
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691309,
					"content": "Apa kamu bisa dengar? Ada seseorang yang merintih di telingamu, seolah sedang sekarat ... Tidak ada jeritan, hanya suara napas dari paru-paru mereka yang sekarat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691310
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691310,
					"content": "Lalu kamu akan melihat wajah yang pucat, menatapmu penuh amarah. Ah, itu seperti ... wajahmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691311
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691311,
					"content": "Ah, hanya di air terjun ini sajalah aku bisa kabur dari suara yang terus menghantuiku itu. Hehe, kamu jadi tidak bisa dengar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691312
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691312,
					"content": "Wahai pejuang pemberani, jika kamu terus berada di sini, kamu bisa jadi sepertiku. Jadi, pergilah selagi bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691313,
					"content": "Tidak ada apa-apa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691314
					]
				},
				{
					"id": 750691314,
					"content": "Begitu ya ... Wahai pejuang, dengarlah nasihatku. Pergilah dari sini segera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
