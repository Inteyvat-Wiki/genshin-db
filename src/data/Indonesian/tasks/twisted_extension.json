				},
				{
					"id": 750691204,
					"content": "Aku ... pejuang dari tim petualang, walaupun aku tidak sekuat Tuan Taika sih. Tapi aku juga punya kekuatanku sendiri.",
					"roleType": "TALK_ROLE_NPC",
