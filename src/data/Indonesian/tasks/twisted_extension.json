				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Halaman yang robek dengan tulisan awal yang rapi ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690502,
					"content": "\"Sesuai dugaan, jumlah monster Abyss semakin banyak ... Tim petualang akhirnya gagal, dan rencana untuk mundur kini sedang dijalankan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690503,
					"content": "\"Kita harus mengevakuasi anggota yang tersisa dengan selamat. Berhati-hatilah pada mereka yang hilang di malam hari, atau mereka yang kembali dari tempat yang tidak ada cahaya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690504,
					"content": "\"Monster Abyss semakin sering muncul. Mungkin sebentar lagi markas ini bakal ketahuan, tapi sebelum itu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690505,
					"content": "(Tulisannya mulai berantakan ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690506,
					"content": "\"Ah, dingin ... dingin sekali ... Di sana, sebelah sana, darahnya mulai mengering ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690507,
					"content": "\"Suara air terjun, begitu kencang ... Ya, bagus. Selama ... ada di bawah air terjun, makan akan menjadi sunyi ... wajah-wajah pucat, mulut yang terbuka, darah yang mengering ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690508,
					"content": "\"Di sana ... di ... sana ... sesuatu ... ada sesuatu di sana ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Buku Harian Quenin"
				},
				{
					"id": 750690509,
					"content": "\"Di bawah air terjun di bawah air terjun di bawah air terjun di bawah air terjun di bawah air terjun di bawah air terjun ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buku Harian Quenin"
				}
			]
		},
