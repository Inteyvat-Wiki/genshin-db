			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ah, tempat ini pengunjungnya tidak banyak ... karena bahaya sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Apa kamu juga anggota tim petualang ...? Hmph, mereka bilang bayangan Ular Hitam turun dari Tonatiuh ... jadi kalian harus berhati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Atau bagusnya sih pergi saja mumpung masih sempat. Mereka itu benar-benar monster yang bersembunyi di dalam tim ... Suara itu, kutukan itu ... ugh, benar-benar berisik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "Karena ada air terjun, di sini jadi agak tenang. Haha ... Raungan air terjun itu bisa mengalahkan suara-suara lainnya, jadi kamu tidak bisa dengar apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
