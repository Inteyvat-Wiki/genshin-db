			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kotak Kayu Mencurigakan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "Untuk saat ini coba kita teliti dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "Pesan dari kotak ini ... kedengarannya nakutin deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371103,
					"content": "Padahal ini kan barang berbahaya, kok malah ditaruh di Danau Cider? Apa jangan-jangan barangnya punya dua orang Knight di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371104,
					"content": "Ada celah gede nih di papan kayunya, coba kita intip isi dalamnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371105,
					"content": "Coba Paimon lihat ... Kayaknya ada yang bulat-bulat merah di dalamnya ... bulat, jauh lebih gede dari Sunsettia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371106,
					"content": "Tunggu, apa jangan-jangan bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371107,
					"content": "Kok Knights of Favonius naruh sebuah kotak bom di pinggir danau? Apa jangan-jangan mau dipakai buat meledakkan ikan-ikan yang menyerbu Danau Cider kayak yang Lisa bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kotak Kayu Mencurigakan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "Haha! Bom! Aku mau main!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "Kok malah semangat gitu? Masih enggak jelas loh bomnya sekuat apa. Gimana kalau nanti bisa ngelukain orang yang enggak salah apa-apa, kan bahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371203,
					"content": "Mumpung isinya ikan goreng semua, buang ke danau sajalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "Iihhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371206,
					"content": "Kamu ngomong gini, jadi agak penasaran deh kan Paimon jadinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371207,
					"content": "Biasanya sering dengar kalau Klee mau ngebom ikan ngebom ikan gitu, terus jadi dihukum deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371208,
					"content": "Eh sekarang kotak bomnya sudah ada persis di sini, dan kalau sudah di pinggir danau gini, jadi beneran mau penasaran nyoba sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371209,
					"content": "Kalau cuma lempar satu saja masih oke kali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371210,
					"content": "Kita lempar satu satu yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "Kamu dan Paimon membuka kotak kayu yang mencurigakan dan masing-masing mengambil bomnya. Kalian mempelajari caranya menyalakan api, menghitung mundur, \"Tiga, dua, satu,\" lalu menarik sumbunya, kemudian jauh-jauh melemparkannya ke Cider Lake ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "Suara gemuruh terdengar dari dalam air, dua bunga air di danau meledak ke permukaan, melontarkan sekawanan Angler tinggi ke udara ....\\nKamu menatap Paimon sambil tertawa riang bertepuk tangan. Setelahnya, kalian langsung mengumpulkan ikan-ikan yang berhasil diledakkan, lalu bersiap-siap pergi dari situ ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "Tapi \"operasi iseng rahasia pengeboman ikan\" kali ini sepertinya tidak berhasil. Saat bomnya meledak, kalian hampir saja ketahuan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "Ahhh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371216,
					"content": "Kupingku!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371217,
					"content": "Kamu bikin aku takut saja! Kenapa, kamu baik-baik saja kan, Phonia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik dan Pasrah"
				},
				{
					"id": 705371218,
					"content": "Tiba-tiba ada ledakan di dalam air ... Aku hampir tuli! Dari suaranya, ini pasti bom milikmu, Ematol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371219,
					"content": "Hah? Kan aku berdiri di dekatmu terus dan tidak ngapa-ngapain? Coba lihat, aku mana punya bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371220,
					"content": "Dasar! Kamu pasti mau melihatku sengsara, kan? Kamu sudah pasang sumbu waktunya dan melemparkan beberapa bom ke danau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371221,
					"content": "Kalau itu tuduhanmu, seharusnya aku menyiapkan Kamera untuk merekam kamu tersungkur di tanah sambil menangis. Rugi banget dong ya kalau tidak begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371222,
					"content": "WOI! Uang sewa rumah buat bulan depan, tidak ada diskon lagi untukmu! Biaya air juga, biaya perabotan juga, biaya makan juga ... GANTI RUGI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371223,
					"content": "O-O-Oh, jangan dong! Iya, iya deh Phonia — kakakku yang baik! Walaupun aku sering bercanda, tapi masalah bom yang barusan sungguh bukan ulahku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371224,
					"content": "Seandainya aku bisa membuat beberapa ... lama tenggelam di air, dan sumbu waktu yang sangat bisa diandalkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371225,
					"content": "Apa perlu terakhir kali kita berkomplot melawan para Hilichurl itu, aku masih harus meledakkan bom secara manual di dekat titik penyerbuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371226,
					"content": "Masuk akal. Otakmu tidak secerdas itu. Seharusnya mustahil kamu bisa pakai alat itu buat mempermainkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371227,
					"content": "HEI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371228,
					"content": "Berarti kamu juga bohong dong! Kan dulu kamu bilang pendengaranmu akan rusak oleh suara apa pun saat menggunakan perangkat deteksi itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371229,
					"content": "Intinya sekarang kan kamu tidak tuli juga, ngapain sih masih semangat buat ribut gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371230,
					"content": "Kapan sih kamu bisa paham! Kemampuan pendengaranku akan terus menurun dan pelan-pelan akan meledak! Kamu ngomong keras-keras begini denganku juga jadi salah satu faktornya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371231,
					"content": "Kalau sampai suatu hari nanti aku tidak bisa membedakan cetak suara lagi, itu pastilah hari aku kehilangan pekerjaanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371232,
					"content": "Dan saat itu, kamu juga tidak akan punya tempat untuk tinggal lagi karena aku akan menyewakannya ke orang yang berani bayar lebih! Lalu ... lalu aku akan jadi nelayan! Terserah kamu nanti bagaimana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara Kepahitan Berbalut Kekesalan"
				},
				{
					"id": 705371233,
					"content": "Ka-Kalau begitu nanti aku tetap bakal berdebat denganmu ... tapi suaraku pelan-pelan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Panik Penuh Keraguan"
				},
				{
					"id": 705371234,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Suara Samar yang Tak Jelas"
				},
				{
					"id": 705371235,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Suara yang Semakin Tak Jelas"
				},
				{
					"id": 705371236,
					"content": "Entah deh mereka ngobrol apa ... Kayaknya sih lagi berantem ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371237,
					"content": "Yey! Seru banget deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "Seru banget ya! Ayo kita lempar satu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371240,
					"content": "Eh enggak deng, cukup sekali saja. Kalau kebanyakan nanti kita bisa ketahuan sama mereka yang mungkin saja datang buat nyelidikin. Kita enggak boleh sampai tertangkap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371241,
					"content": "Walaupun rasanya kayak ... kena masalah besar, tapi minimal rasa penasaran Paimon selama ini sudah terjawab, puas deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371238,
					"content": "Ya, enggak masalah juga sih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371211,
					"content": "Ayo lempar bomnya kuat-kuat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371204,
					"content": "Kamu enggak penasaran gitu rasanya melempar bom?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				}
			]
		},
		{
			"id": 7053713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
