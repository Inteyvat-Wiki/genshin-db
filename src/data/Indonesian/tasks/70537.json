			"dialogs": [
				{
					"id": 705370101,
					"content": "Kotak kayu mencurigakan yang belum pernah terlihat sebelumnya. Sebuah catatan terjepit di celah penutupnya. Ada tertulis, \"Properti Tim Investigasi, barang yang sangat berbahaya. Hati-hati memindahkannya.\"",
					"roleType": "TALK_ROLE_NPC",
