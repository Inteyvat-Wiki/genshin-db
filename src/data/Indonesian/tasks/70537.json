						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kotak Kayu Mencurigakan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371301,
					"content": "WAW! TAKUT DEH! Pergi yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371302
					]
				},
				{
					"id": 705371302,
					"content": "Ya, betul! Ini kotak yang isinya bom semua! Kita harus jaga jarak sejauh mungkin dari kotaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
