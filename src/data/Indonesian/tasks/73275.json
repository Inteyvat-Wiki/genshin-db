						732750307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750307,
					"content": "Tolong jaga baik-baik para tunas ini ya. Aku ingin menyimpannya untuk Sabbah. Kalau aku sudah tidak ada, bunga-bunga ini kuserahkan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Kamu sudah banyak membantuku. Meski kamu tidak meminta upah dariku, tapi aku akan merasa bersalah kalau tidak memberikan apa pun kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Tunas ini baru saja tumbuh dari tanah, Sabbah menawarkan untuk memberikannya kepadamu. Dia bahkan membungkusnya dengan hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Ambillah mereka sebagai kenang-kenangan dari kami. Semoga kamu tetap tabah seperti tunas ini dan tidak pernah kehilangan iman yang kamu percayai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
