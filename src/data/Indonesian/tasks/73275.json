			"dialogs": [
				{
					"id": 732750102,
					"content": "Mawar Emas sudah bertunas, hore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Aku penasaran kok kamu bisa menemukan benihnya sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Dari tempat yang jauh sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Benih yang ditanam Paman Shafaqat memang tersebar sampai ke setiap sudut padang pasir, namun pada akhirnya kembali lagi ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Tolong jaga baik-baik para tunas ini ya. Aku ingin menyimpannya untuk Sabbah. Kalau aku sudah tidak ada, bunga-bunga ini kuserahkan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Anakku, terima kasih, aku tidak punya barang berharga apa pun untukmu. Terimalah beberapa buah dan bunga ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
