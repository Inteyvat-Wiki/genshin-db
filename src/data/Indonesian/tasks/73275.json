				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "Tentang balada ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Kamu masih ingat lagu ini? Tambah satu lagi anak muda yang mengingatnya, hehe. Bagus ... bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Mawar oh mawar, kabulkanlah permintaanku. Bunga mekar dari batu, Mawar Emas bernyanyi untukku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"Aku tidak terikat di dataran mana pun, aku pergi ke mana pun lagu membawaku. Nyanyianlah yang menentang nasibku, dialah yang menundukkan takdirku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"Melampaui diriku, melampaui waktu. Bahkan melampaui hidup yang terus layu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
