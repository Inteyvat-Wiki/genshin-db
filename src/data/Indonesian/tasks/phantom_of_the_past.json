					"speakerTitle": "Paimon"
				},
				{
					"id": 705120702,
					"content": "Terus di sini bahayanya apa? Cuma bayangan dari masa lalu doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
