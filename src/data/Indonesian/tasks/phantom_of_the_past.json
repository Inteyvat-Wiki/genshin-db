			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "WAAAH! Ini monster-monster munculnya dari mana sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Tunggu ... Itu bukannya Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Kok dia kelihatan beda dari biasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Lihat! Dia fokus, pakai kekuatan penuh! Jadi gini ya si Kapten Pyro kalau dia lagi dalam kondisi puncak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "Itu pasti Diluc waktu dia bertarung di sini dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "Hei, benar juga. Sekarang kalau Paimon perhatikan, Diluc kelihatan lebih muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "Tapi apa yang terjadi pada waktu itu? Kenapa Diluc bertarung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Hmm. Mungkin lebih baik tanya langsung saja kalau ketemu dia nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}, sekarang kita ngapain nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "Kita jangan gegabah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Oke, coba kita lihat dulu Diluc muda gimana sepak terjangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Ayo kita amati situasinya dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "Ley Line memperlihatkan adegan yang terjadi pada waktu itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
