					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Tenda ini kayak bukan punya Diluc, mungkin punya petualang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Oh, di sana ada buku sama catatan. Baca yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "\"Tuan Darknight Hero yang terhormat, kejadian yang pernah kita alami bertahun-tahun yang lalu kini kembali terjadi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Selidiki"
				},
				{
					"id": 705120404,
					"content": "\"Ketika itu Tuan berhasil mengatasinya, namun tampaknya ada rangsangan pada Ley Line yang menyebabkan ingatan tentang monster yang muncul di kala itu lepas kembali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Selidiki"
				},
				{
					"id": 705120405,
					"content": "\"Saya yakin Tuan ingin secepatnya membasmi ancaman yang paling besar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Selidiki"
				},
				{
					"id": 705120406,
					"content": "\"Saya akan menghubungi pihak-pihak yang terkait sesuai prosedur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Selidiki"
				},
				{
					"id": 705120407,
					"content": "Hmm ... dilihat dari kata-katanya, kayaknya ini ditulis sama seseorang yang Diluc kenal baik. Sementara kita sebut saja dia \"Temannya Diluc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Dia lihat sesuatu yang buruk terjadi, terus tulis surat buat Diluc, terus pergi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Kok kayak enggak ada tanggung jawabnya sama sekali ya? Gimana kalau orang lain lihat catatan ini? Terus bukunya juga malah ditinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Sekarang kalau Paimon pikir lagi ... ingat tidak Ley Line aneh yang ada di pantai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Paimon yakin itu pasti \"kejadian\" yang dia maksud dalam surat tadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Selain itu, semuanya oke saja sih. Enggak ada monster sama sekali di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, mau baca catatan temannya Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Kalau enggak, kita samperin saja si Ley Line anehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
