			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Eh kalian, sudah lama ya. Kalian bersemangat, seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Halo Nona Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "Ada perlu apa hari ini? Mau bicara bisnis dengan Tuan Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Cuma mau beli jus anggur kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Yup. Nona Adelinde, kebetulan nih, boleh tidak kami minta tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "Kami selalu kehabisan setiap kali mau beli jus anggur spesial yang diskonan, makanya kami ke sini lebih awal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Boleh tidak sisakan sebotol buat kami? Kami siap kalau harus bayar DP kok, buka harga saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Boleh. Dan tidak perlu pakai DP segala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Tapi mungkin kalian harus tunggu agak lama ya. Jus harga spesial itu pembuatannya lumayan makan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Setiap musim panas, Tuan Diluc akan turun tangan memilih dua gentong buah anggur yang paling bagus untuk dijadikan jus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "Lah? Terus kenapa dikasih harga spesial? Buah paling baik harganya harusnya paling mahal dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Tuan Diluc tidak bilang apa-apa soal itu. Kalau tebakanku sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "Harga spesial itu sengaja untuk pemasaran. Pelanggan datang kalau ada diskon besar-besaran kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Atau Tuan ingin supaya jus buah jadi lebih sohor, dan orang jadi punya alternatif kalau ingin minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "Alternatif yang tentunya sangat bagus buat para peminum kelas berat, supaya tidak mabuk dan bikin onar. Lalu bagus juga buat kalangan yang tidak minum alkohol, ada sesuatu yang baru untuk dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Bukannya bisa berakibat buruk buat bisnis kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Tuan Diluc bukan hamba uang. Kurasa beliau lebih ingin supaya orang tahu batas ketika minum, daripada untung besar dengan menghalalkan segala cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Bayangkan, semua orang bisa minum anggur bagus dan bersenang-senang tanpa perlu jadi orang pemabukan yang bikin susah orang lain ... Mukjizat pun terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Wih, Tuan Diluc pandangannya jauh ke depan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Jadi, apa sekarang Diluc lagi milih-milih anggur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Belum. Ada yang harus beliau urus terlebih dahulu. Setelah semuanya selesai, baru pilih anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "Kalau kalian tertarik, aku yakin Tuan Diluc akan senang kalau bisa bertemu dan bertukar pikiran dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "Ada \"urusan\" apa dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Kalian sudah tahu kan, setiap kali Tuan Diluc mendengar kalau ada tamu tidak menyenangkan yang muncul di Mondstadt, dia akan pergi sendiri untuk, eh, \"menyambut\" mereka secara langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Harusnya sekarang beliau ada di dekat Falcon Coast. Aku tidak tahu sampai kapan dia akan ada di sana ... Oh iya, mau masuk dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Aku harus jaga di sini untuk menunggu tamu lain, tapi Hillie dan Moco akan dengan senang hati melayani kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "\"Tamu tak menyenangkan\"? Maksudnya gimana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Ini pasti ada kaitannya dengan \"kerja sambilan\" Diluc yang itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "Oh? Maksudnya Darkni—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Ehh maksudnya ... Abyss Order yang jahat dan licik itu merencanakan sesuatu lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "Kalau iya, Tuan Diluc kan teman kita, mana boleh kita cuma duduk-duduk di sini doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "Kalau kalian berdua mau bantu, bagus. Tuan Diluc percaya pada kalian dan kemampuan kalian juga sudah tak diragukan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "Terima kasih sudah mau bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "Ah enggak apa-apa kok! Semakin cepat masalahnya Tuan Diluc selesai, semakin cepat kita bisa minum jus anggur enak, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Yuk, {NICKNAME}, kita langsung saja ke Falcon Coast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Baiklah, kami tunggu di dalam ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Ummm ... Tapi Paimon kok jadi merasa enggak enak ya kalau kita cuma duduk-duduk di rumah Diluc sementara dianya sendiri lagi sibuk di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Mending kita ke Falcon Coast saja, bantuin Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Diluc memang kuat, tapi siapa sih yang bakalan nolak kalau dibantuin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "Kayaknya malah berpotensi rugi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Penting yah ... bisa iya, bisa tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
