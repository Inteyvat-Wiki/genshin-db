			"dialogs": [
				{
					"id": 3061101,
					"content": "Kita sampai. Ini salah satu <color=#00E1FFFF>reruntuhan kuil Four Winds</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Kuil ini sudah lama terbengkalai. Orang Mondstadt juga sudah hampir tidak pernah ke sini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "Mungkin bagian dalamnya sudah jadi sarang monster, atau sudah dikuasai Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Bahkan Stormterror juga sudah meninggalkan kuilnya sendiri ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "Stormterror?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "Aku sendiri masih belum terima, tapi ... Stormterror dulunya salah satu dari \"Four Winds\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "HAAAAAHHH!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Sebentar ... kerasa tidak barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "Anginnya ... ada yang tidak beres ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Kita periksa ke dalam, {NICKNAME}. Hati-hati, kekuatan naga sudah sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
