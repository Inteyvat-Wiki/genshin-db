			"dialogs": [
				{
					"id": 3061001,
					"content": "Fiuh, capeknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061002,
					"content": "Tapi tindakan kita kali ini akan sangat membantu Master Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061003,
					"content": "Dulu, kami selalu bisa melindungi dan menjaga agar kota kami tetap aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061004,
					"content": "Dan semua itu juga kebanyakan berkat jasa Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061005,
					"content": "Sekarang, Stormterror sendiri yang langsung turun menyerang kota ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061006,
					"content": "\"Angin bisa berubah, dan kita harus bisa menyikapinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061007,
					"content": "Bijak sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "Itu omongannya Lisa sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061010,
					"content": "Oh iya, soal \"Four Winds\" yang tadi kita bahas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061011,
					"content": "Kalau kalian ingin tahu lebih banyak tentang sejarah kami, boleh tanya sama Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061012,
					"content": "Aku bukan bilang aku tidak tahu sejarah kami ya! Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061013,
					"content": "Seorang pustakawan memang seharusnya lebih tahu soal itu daripada seorang Outrider, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061008,
					"content": "Itu kamu yang ngomong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
