			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Kalian datang juga. Maaf ya sudah terus merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "Sepertinya kamu sudah baikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Hahaha, terima kasih. Pikiranku akhirnya sudah terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Ada beberapa hal yang memang tidak boleh terlalu dipaksakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Apa kamu mau menemaniku pergi ke sisi barat pantai malam ini? Aku mau memberi sesuatu untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Wah, ini semacam harta karun dari laut ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "Kamu akan tahu nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "Di sini tempatnya. Terakhir kali, ayahku pergi berlayar dari tempat ini. Dan dia juga pergi di waktu semalam ini. Sejak itu, aku tidak pernah bertemu dengannya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "Kamu pasti merindukan dia. Apa harapanmu adalah ingin bertemu ayahmu sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Hahaha, aku memang merindukan Ayah. Tapi warga samudra pada akhirnya memang harus kembali ke samudra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "Harapanku sebenarnya adalah, ingin menjadi nelayan yang lebih hebat dari ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "Waktu kecil aku selalu ingin ikut ayah berlayar, tapi dia selalu menyuruh ibu menyeretku pulang. Dia bahkan membawa anak tetangga yang lebih tua dan tidak mau membawaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "Dia selalu bilang, \"Jangan suka berkeliaran di pesisir pantai, Momiji. Pergilah kerjakan hal-hal yang dilakukan perempuan\", atau \"Ambillah uang dan belilah rok, jangan suka main ke kapal\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "Aku sangat tidak rela. Kenapa harus begitu? Apa itu \"hal yang harus dilakukan perempuan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "Aku boleh membeli permen, memetik bunga, dan menjadi putri kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "Tapi kenapa tidak boleh bertualang, pergi dan bermain di laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "Sekali dilarang, aku malah semakin mau melanggarnya. Setelah ayah pergi, aku bekerja menjadi nelayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "Aku akan menjelajahi area samudra yang tidak bisa dia jelajahi. Aku juga akan menangkap ikan yang tidak bisa dia tangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "Biar aku saja yang mewarisi teknik memancing Kujirai. Biar aku saja yang membuat reputasi keluarga Kujirai semakin gemilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Meski legenda Lunar Leviathan hanyalah legenda, aku juga tidak akan berhenti melangkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "Iya, kamu pasti akan berhasil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Karena ikan legendaris itu ternyata tidak ada, jadi aku akan melempar harapanku ke samudra. Kurasa ayah juga akan melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "Kalian ada harapan apa? Ayo kita tulis harapan kita bersama, masukkan ke dalam botol dan lempar ke laut sekuat tenaga. Suatu hari nanti, harapan kita pasti akan terwujudkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Wah— Apa ini benar-benar akan berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "Tapi Paimon punya banyak harapan... Paimon jadi galau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Terima kasih atas bantuan kalian selama ini. Aku tidak tahu bagaimana harus berterima kasih, jadi aku hanya siapkan beberapa hadiah ini... Semoga kalian menyukainya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Wah— lihat! Apa itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "Gerombolan ikan yang besar sekali! Mereka juga bercahaya! Sepertinya mereka suka botol harapan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "Dilihat-lihat, gerombolan ikan ini mirip sekali dengan bulan besar di dalam laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "Ikan-ikan ini... Ikan-ikan ini Moonfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "Ah! Aku tahu, aku tahu!! Ternyata begitu! Ternyata merekalah Lunar Leviathan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Eh? Mereka \"Lunar Leviathan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "Benar sekali. Aku tidak mungkin lupa wujudnya. Kelap-kelip kecil yang membentuk wujud bulan ini... Lunar Leviathan saat itu juga muncul setelah Jiawei melepas botol harapannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "Pantas saja selama ini belum ada orang yang berhasil menangkap Lunar Leviathan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Ternyata alasannya karena Lunar Leviathan adalah Moonfin yang bergerombol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Moonfin ini... ternyata suka botol harapan sederhana ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Hehe, mungkin mereka suka harapan-harapan yang dimasukkan orang-orang ke botol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Haha! Mungkin saja, kalau begitu lihat saja kehebatan si Kujirai Momiji ini menangkap semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "Kami juga mau ikut! Biarkan kami membantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "Kalau begitu, izinkan aku untuk memberikan joran ini pada kalian. Joran ini adalah joran khusus keluarga Kujirai untuk menangkap Lunar Leviathan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "Hadiah ini tidak cukup untuk mewakili rasa terima kasihku pada kalian, tapi terimalah sedikit niat kecilku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Ayo gunakan joran itu untuk menangkap semua Moonfin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}