			"dialogs": [
				{
					"id": 711209101,
					"content": "Kalian lagi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711209102,
					"content": "Tolong jangan macam-macam, kawan. Pura-pura tidak lihat saja, kami juga akan pura-pura tidak tahu kalian lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209103,
					"content": "Kalian jagain apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Tebak saja sampai mampus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209105,
					"content": "EH! NYOLOT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "*ehem* Uhuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209107,
					"content": "(Sini aku kasih tahu. Tapi jangan bilang siapa-siapa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209108,
					"content": "(Apa, apa!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "Kami jaga tempat ini ... dari orang seperti kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209110,
					"content": "WAAAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Ada suara aneh dari dalam gua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Aku kentut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711209113,
					"content": "Eh ... iya, kentut. Bau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209114,
					"content": "Semuanya aman ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
