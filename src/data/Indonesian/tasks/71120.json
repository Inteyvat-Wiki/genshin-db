			"dialogs": [
				{
					"id": 711200101,
					"content": "Eh, jauh-jauh! Ini daerah kekuasaan bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200102,
					"content": "WOI, galak amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Siapa kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Tebak. Kalau kalian baik, kita teman. Kalau kalian ricuh, kita urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711200105,
					"content": "Sana pulang, otakmu jatuh di jalan tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200109,
					"content": "Mencurigakan ih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Mencurigakan ...? Ha, kami ini cuma penjaga pintu. Yang mencurigakan itu kalian, nyelonong sana nyelonong sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711200111,
					"content": "Terserah lah, pokoknya kita tidak ada urusan! Enyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200106,
					"content": "Bos siapa sih maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "\"Bos siapa\" katanya ... HA! Kalau tahu, kalian bakal gemetar sampai terkencing-kencing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200108,
					"content": "Semua demi kebaikanmu sendiri ya! Pergi saja, dan jangan cari gara-gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Coiled Serpent"
				}
			]
		},
