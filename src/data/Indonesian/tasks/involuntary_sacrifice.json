					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Ya, benar. Mereka memiliki nyali besar untuk mengincar apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "Semua benda-benda kuno yang berkaitan dengan The Seven, dewa-dewa dan naga... tidak ada satu pun yang bisa luput dari ambisi dan ketamakan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Tapi kali ini berbeda... Mereka pikir mereka siapa? Berani-beraninya menyentuh harta Abyss Order yang berharga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "Oh, Pengembara, kalian rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Loh? Ganyu, apa yang kamu lakukan di sini dengan Lan? Apa ada misi baru yang ingin dibagikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Halo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Kami tadi mendiskusikan Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Iya, kami tadi membicarakan tentang Treasure Hoarder yang berani-beraninya mencari masalah dengan Abyss — ini benar-benar jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Akhir-akhir ini, kami mendapat informasi dari Bagian Urusan Sipil bahwa dua bos kelompok Treasure Hoarder di Liyue dan Mondstadt akan bergabung untuk merencanakan sesuatu yang besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "\"Dua bos besar...Treasure Hoarder\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Mereka dikenal dengan julukan \"Big Sis' of the South\" dan \"Raptor of the North\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Ah! Raptor! Seingat Paimon, dia pernah melarikan diri dari kejaran Amber di Mondstadt... Tapi siapa lagi itu \"Big Sis' of the South\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "\"Big Sis\"... artinya kakak perempuan tertua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Benar sekali. Dia adalah pemimpin Treasure Hoarder di Liyue. Setahuku Treasure Hoarder memanggilnya dengan sebutan \"Bos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Beberapa orang mengatakan bahwa Dewa Pencuri mengaruniakan sebuah hadiah kepadanya karena keahliannya dalam melakukan eksploitasi, dan karena itulah dia menjadi Big Sis' para dewa. Tapi itu mungkin juga cuma kabar burung saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "Dan lagi, Treasure Hoarder telah menemukan reruntuhan yang belum pernah dijelajahi — yang sebenarnya sedang dijaga diam-diam oleh Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Tidak peduli sebesar apa risikonya, yang bisa dipikirkan Treasure Hoarder hanyalah \"harta apa yang tersembunyi di dalamnya\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Mereka telah menyusun rencana. Mereka akan mengirim umpan untuk mengalihkan perhatian pasukan Abyss Order dari reruntuhan, kemudian mengirim seorang pencuri yang berpengalaman untuk masuk dan mencuri harta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Demi tujuan itu, Big Sis' dan Raptor baru-baru ini merekrut seorang \"Grand Thief\" dari Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "\"Grand Thief\"? Wah, julukannya terdengar sangat mengesankan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Benar sekali. Dia adalah tokoh legendaris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "Sang Grand Thief sangat dihormati oleh Treasure Hoarder, persis dengan kami para petualang yang juga memuja para petualang legendaris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Contohnya seperti petualang terkenal Alice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Oh, jadi kamu juga tahu penulis Panduan Wisata Teyvat? Iya, posisi Grand Thief sama tingginya dengan sang penulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Jadi walaupun Big Sis' dan Raptor sudah menjadi dua orang yang begitu dikenal di Liyue dan Mondstadt, mereka masih harus mengerahkan banyak usaha untuk meyakinkan pencuri sekelas dia untuk melaksanakan rencana ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "Karena perubahan besar terjadi di Liyue baru-baru ini, Bagian Urusan Sipil dan para Millelith jadi sangat sibuk  sampai tidak ada waktu untuk menyelidiki lebih lanjut gosip tentang rencana para Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Tapi semua hal yang berhubungan dengan Abyss membuatku merasa seperti ada ancaman tak dikenal yang tersembunyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "Karena itu, aku memutuskan untuk memasang permintaan misi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Kebetulan sekali aku di sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Ehem! Serahkan misi ini kepada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Oh, terima kasih banyak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "Untung sekali misi ini bisa ditangani oleh anggota Adventurers' Guild yang andal. Kalau begitu, semoga beruntung. Adventurers' Guild akan mengurus rincian keterangan misi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Aku juga mengerti bahaya dari Abyss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Sama seperti petualang legendaris Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Oh, kalian pernah menemui beliau di Mondstadt? Iya, posisi Grand Thief sama tingginya dengan beliau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "Dia \"Bos\" Treasure Hoarder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Kamu cukup tahu banyak juga ya. Kamu pasti sering berurusan dengan Treasure Hoarder sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
