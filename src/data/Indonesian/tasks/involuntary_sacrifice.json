			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "I-ini... kelihatannya seperti orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000202,
					"content": "Apa dia... sang Grand Thief?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000203,
					"content": "Tapi kenapa posisi tubuhnya seperti itu? Apa dia sedang berdoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000204,
					"content": "!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000205,
					"content": "*terkejut* I-itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000206,
					"content": "Patung The Seven?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "Ke-kenapa Patung The Seven... di-digantung terbalik...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000209,
					"content": "Dan tangan patungnya... Seingat Paimon, bukannya tangan Patung The Seven seharusnya menggenggam sebuah benda bulat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000210,
					"content": "Tapi, patung ini... Apa yang digenggamnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000211,
					"content": "Uh... Paimon punya perasaan buruk tentang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000212,
					"content": "Si Grand Thief juga tidak bergerak sedikit pun. Apa menurutmu dia sudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000213,
					"content": "Halo...? Apa kamu baik-baik saja, Tuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000214,
					"content": "(Tidak bereaksi dan tidak terdengar suara napas sedikit pun.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "Di-dia sudah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, Paimon... semakin merasa tidak nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000217,
					"content": "Tempat yang mengerikan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000219,
