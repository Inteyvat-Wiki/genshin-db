						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Jangan khawatir, kami akan pergi mencari <color=#00E1FFFF>Sunsettia</color> yang segar untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
