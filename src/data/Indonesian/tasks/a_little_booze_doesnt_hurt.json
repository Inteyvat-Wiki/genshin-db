				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "Aku sepertinya butuh minum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Tapi jika Eury tahu aku minum, tamat sudah riwayatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "Eh? O-oh... ya, aku hanya ingin minum anggur sedikit saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Istriku Eury tidak suka jika aku minum, walaupun saat aku di rumah aku tidak pernah menyentuh anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "Yang bisa kulakukan adalah menunggu sampai dia pergi belanja lalu aku menyelinap keluar untuk minum sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "Kamu terlalu banyak minum anggur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Hei, kenapa bilang begitu! Orang Mondstadt bagaimana mungkin tidak minum anggur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "Tolonglah, pergi dan alihkan Eury untuk beberapa saat, biarkan aku minum anggur sedikit saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Saat Eury pergi belanja, jika ada banyak pilihan dia akan bingung dan butuh waktu lama untuk memutuskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Jika ada banyak pilihan, dia bisa terus memikirkannya sepanjang hari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Hahaha, terima kasih banyak teman, semoga hidupmu selalu berlimpah anggur keberuntungan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "Kamu mau minum untuk berapa lama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Hahaha, tergantung dari seberapa lama kamu bisa menahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "Eh ti-tidak, aku hanya ingin minum sedikit dengan tenang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Tolonglah, aku janji! Kamu bisa memercayai janji seorang peminum Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
