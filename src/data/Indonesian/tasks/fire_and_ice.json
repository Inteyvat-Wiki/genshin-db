			"dialogs": [
				{
					"id": 761830201,
					"content": "Penting untuk meluangkan waktu untuk bersantai sesekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830204,
					"content": "Oke. Sampai jumpa di Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
