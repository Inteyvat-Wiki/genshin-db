			"dialogs": [
				{
					"id": 761830101,
					"content": "Terima kasih undangannya, Sandrone. Makanan ini rasanya persis seperti yang kuingat. Benar-benar nostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830102,
					"content": "Sama-sama. Kalau kamu suka, kita bisa lebih sering kumpul-kumpul lagi setelah aku kembali ke Snezhnaya, seperti dulu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830103,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830104,
					"content": "Ngomong-ngomong soal Snezhnaya, bagaimana keadaan di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830105,
					"content": "Rencana Yang Mulia Tsaritsa telah membuat kemajuan awal, tetapi Operasi Stuzha ternyata lebih sulit diimplementasikan daripada bayangan Walikota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830106,
					"content": "Kalau begitu, sepertinya kita berdua akan sibuk mulai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830107,
					"content": "Meski begitu, kita masih punya waktu untuk minum teh sesekali, atau bahkan nonton pertunjukan Rombongan Teater Kolorevetsky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830124,
					"content": "Ya, dan kita masih punya waktu untuk minum teh sesekali, atau bahkan nonton pertunjukan Rombongan Teater Kolorevetsky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830108,
					"content": "Odette masih menari balet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830109,
					"content": "Ya. Setiap kali aku melihatnya, dia terlihat semakin hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830110,
					"content": "Luar biasa. Aku ingin melihat penampilannya lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830111,
					"content": "Menurutku ini sangat menarik. Meskipun dia belajar dari Rosalyne, tapi temperamen dan gaya mereka sangat berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830112,
					"content": "Dan itu bukan hal yang buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830113,
					"content": "Benar ... Rosalyne menari dengan semangat yang berapi-api, sedangkan Odette seperti es yang tak tergoyahkan, dingin dan misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830114,
					"content": "Sepertinya dia membawa beban yang berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830115,
					"content": "Namun, saat dia tampil di atas panggung, gerakannya begitu murni, seolah hatinya bebas dari noda apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830116,
					"content": "Atau mungkin dia menyembunyikan hal-hal seperti itu di tempat yang tidak akan dilihat siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830117,
					"content": "Mungkin. Pada akhirnya, bukankah itulah yang dilakukan sebongkah es? membekukan celah-celahnya? Tapi dia tidak rapuh, dia teguh. Bisa dibilang, justru berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830118,
					"content": "Setidaknya dalam aspek itu, dia mirip dengan Rosalyne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830119,
					"content": "Dia berbahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830120,
					"content": "Dia memiliki tekad yang kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830121,
					"content": "Memang benar. Pantas saja ada desas-desus bahwa dia adalah kandidat favorit untuk mewarisi gelar \"La Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830122,
					"content": "Hah ... Kalau kita sudah lebih dekat dengannya, kita bisa mengundangnya ke pesta teh kita. Kuharap dia tidak akan menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830123,
					"content": "Sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "The Knave"
				}
			]
		},
