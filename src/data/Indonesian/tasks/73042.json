			"dialogs": [
				{
					"id": 730420101,
					"content": "Nara Emas, Arakanta sudah dengar banyak tentang kamu. Kamu Nara baik. Mau main?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Main sama Arakanta mudah saja! Yang penting asyik. Sekarang, Nara belajar dulu aturan mainnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta akan memunculkan banyak partikel Dendro, yaitu \"Aranara\" yang bersembunyi di dalam lingkaran. Nara jadi \"Rishboland Tiger\" yang besar dan kuat. Ayo, kejar \"Aranara\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "Kalau \"Rishboland Tiger\" berhasil menangkap semua \"Aranara\", artinya Nara \"Menang\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Bagaimana? Nara mau kan main sama Arakanta sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
