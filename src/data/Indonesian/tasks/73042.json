			"dialogs": [
				{
					"id": 730420601,
					"content": "Asyik sekali! Arakanta senang main sama Nara Emas! Nara Emas cepat, keren, mirip Rishboland Tiger betulan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "Seru kalau bisa main bersama dengan Aranara yang lain dan Rishboland Tiger, tapi jauh lebih seru lagi kalau bisa bermain dengan teman baru dan teman Nara-ku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Kenapa Rishboland Tiger mengejar Aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Rishboland Tiger dan Aranara adalah teman, artinya bisa bermain bersama. Tapi Arakanta sadar kalau Nara juga bisa takut pada Rishboland Tiger, jadi demi Festival Utsava, terpikirlah permainan baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "Terima kasih, Nara. Bunga Aranara ini untuk Nara Emas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
