						700081303
					]
				},
				{
					"id": 700081303,
					"content": "Cat's Tail ya... tapi Bibi Grace bilang, anak-anak nggak boleh minum-minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
