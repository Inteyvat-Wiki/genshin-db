			"dialogs": [
				{
					"id": 700081201,
					"content": "Halo, ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081202,
					"content": "Tentang Minuman Baru Cat's Tail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "Maaf, aku sedang bertugas saat ini, tidak bisa minum-minum dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081204,
					"content": "Ini adalah minuman non-alkohol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "Oh? Baiklah... kalau begitu tidak masalah. Kebetulan aku juga haus, jadi aku akan mencicipinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081206,
					"content": "Oh! Rasanya cukup enak, dan rasa sejuk ini juga menyegarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081207,
					"content": "Minuman ini produk baru dari Cat's Tail ya? Aku akan ke sana untuk mencicipinya lagi saat ada waktu luang nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
