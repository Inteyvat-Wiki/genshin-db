			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Oke, sepertinya kita sudah mendapatkan semua bahan yang dibutuhkan. Ayo kita mulai buat minumannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "Rasanya akan seperti apa ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Oh, apakah kamu tertarik untuk mencicipinya juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Umm... proses pencampurannya sendiri tidak terlalu rumit. Kamu cuma perlu mengikuti langkah-langkah yang telah kubuat, pasti akan berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "Kamu mau coba bikin sendiri, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Boleh, sini aku cobain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Bagus. Aku jelaskan dulu ya proses pembuatan minuman ini. Pastikan kamu mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "Pertama-tama, masukkan <color=#00E1FFFF>Sweet Flower</color> ke dalam, lalu tuangkan anggur sebagai dasar koktailnya... Tentu saja kita akan menambahkan <color=#00E1FFFF>Milk</color> untuk memberikan tekstur lembut dan manis yang kita inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Untuk menambah rasa, tambahkan <color=#00E1FFFF>Windwheel Aster</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Jangan terburu-buru mencampurnya, kamu harus <color=#00E1FFFF>membiarkannya dulu sebentar</color>, biarkan aroma bunganya keluar secara perlahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Kemudian taburkan <color=#00E1FFFF>Dandelion Seed</color>, anggur akan terlihat seindah bintang yang bertaburan, dan terakhir masukkan <color=#00E1FFFF>es batu</color> ke dalamnya dan selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "Jadi begitu cara pembuatannya. Kamu tidak boleh mengacaukan langkah-langkahnya kalau mau membuat sesuatu yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Kalau kamu sudah hafal langkah-langkahnya boleh langsung dicoba ya. Kalau lupa, tanyakan saja lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
