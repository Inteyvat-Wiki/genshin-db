				{
					"id": 700081401,
					"content": "Bagaimana? Sudah minta orang-orang untuk mencicipinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081402
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081402,
					"content": "Aku bahkan menemukan beberapa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Bermabuk-mabukan selama festival ya... Ah, pantas saja kerumunan di Angel's Share bertambah banyak saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081404,
					"content": "Tapi, menurutku ini baik-baik saja. Selain orang-orang yang tidak sabar untuk mabuk-mabukan, masih ada anak-anak dan penjaga kota yang juga butuh menikmati kegembiraan festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081405,
					"content": "Aku akan terus menyempurnakan campuran spesial ini. Terima kasih atas bantuanmu, terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081406,
					"content": "Ah, iya, dan selamat menikmati Festival Windblume ya.",
					"roleType": "TALK_ROLE_NPC",
