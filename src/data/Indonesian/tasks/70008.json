					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081306,
					"content": "Enak sekali! Manis dan dingin! Ini minuman baru Cat's Tail ya, kak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Nora"
				},
				{
