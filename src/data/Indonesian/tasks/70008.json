			"dialogs": [
				{
					"id": 700081101,
					"content": "*huff* Festival belum lengkap tanpa ditemani minuman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Tentang Minuman Baru Cat's Tail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Oh, kamu mau aku mencicipinya? Hahaha! Tidak masalah, aku ini ahlinya anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Coba kucicipi... Eh? Ini... sama sekali tidak ada rasa alkoholnya, rasanya lebih seperti minuman susu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Jangan salah paham dulu, maksudku rasanya enak, tapi menurutku minuman non-alkohol tidak cocok dengan festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Bagaimanapun, banyak orang yang tidak sabar untuk mabuk-mabukan di Festival Windblume ini, jadi mungkin tidak banyak yang akan memilih minuman seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
