			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Kelihatannya kita memang harus mengeluarkan menu minuman baru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Oh, ternyata kamu. Aku sedang memikirkan menu minuman baru dengan tema Festival Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Semua orang akan bersenang-senang di kota selama festival, dan aku yakin mereka tidak akan keberatan memiliki makanan dan minuman untuk menemani mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Tapi kalau cuma menyediakan minuman beralkohol nanti mereka mabuk, kalau mabuk mereka akan ditahan oleh para Knight sampai mereka sadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Selain itu, akan merusak mood juga kalau sampai ada bau alkohol yang terlalu menyengat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "Hah, akan seperti itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Aku pernah dengar bahwa beberapa orang benar-benar menikmati suasana mabuk, tapi kalau mabuk sampai jatuh di pinggir jalan selama festival bukanlah pemandangan yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "Oleh karena itu, aku memutuskan untuk membuat minuman non-alkohol yang menyegarkan, berbahan dasar susu dan memiliki rasa \"angin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Untuk lebih menekankan makna \"angin\", sepertinya kita bisa mencoba dua bunga sekaligus. Dandelion dan Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "Tapi kalau aku mengumpulkan bahan-bahannya sendirian pasti akan memakan waktu lama. Jadi, bersediakah kamu membantuku mengumpulkan beberapa bahan, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Aku akan pergi mencari Dandelion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Terima kasih banyak. Dengar-dengar Dandelion di dekat Starsnatch Cliff memiliki kualitas yang cukup bagus, jadi bantu aku untuk mengambilnya ke sana ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Aku akan pergi mengumpulkan beberapa Windwheel Aster, dan kita akan bertemu kembali di sini setelah kita selesai mengumpulkan bahan masing-masing ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Kita akan membuat minumannya di sini dan meminta beberapa orang untuk mencicipinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Aku akan pergi mencari Windwheel Aster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Kalau begitu tolong pergi ke Windrise dan kumpulkan Windwheel Aster untukku, karena Windwheel Aster di sana kualitasnya bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Aku akan pergi mengumpulkan beberapa Dandelions Seed, dan kita akan bertemu kembali di sini setelah kita selesai mengumpulkan bahan masing-masing ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Kita akan membuat minumannya di sini dan meminta beberapa orang untuk mencicipinya...",
					"roleType": "TALK_ROLE_NPC",
