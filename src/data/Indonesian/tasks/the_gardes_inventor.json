				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "Halo, kawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110102,
					"content": "Eh, Garde ada urusan apa sama kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Hehe. Coba tebak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110104,
					"content": "Apa ini soal kita suka terbang ke sana kemari di kota terus mengotori tembok kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Ah, jadi kamu melakukan hal-hal itu juga ya? Bentar, aku tambahkan dulu ke catatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110107,
					"content": "Tunggu, kamu mau coba tipu kami ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "Haha, aku bercanda kok. Oke kita kenalan dulu ya. Aku Chenee, terus ini seniorku, Frejus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110109,
					"content": "Seniorku punya ide penemuan baru yang perlu dicoba. Apa kalian berdua tertarik untuk membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110110,
					"content": "Penemuan baru? Apaan lagi nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Meriam jarak jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110112,
					"content": "Seperti yang kalian lihat sendiri, model meriam sebelumnya itu harus dikendalikan operator, jadi kalau diserang musuh kita akan kehilangan meriam dan operatornya. Tapi kalau senjata itu bisa dikontrol dari jauh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110113,
					"content": "Kita bisa meminimalisir korban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110114,
					"content": "Kamu bikinnya juga gampang gitu kelihatannya! Yah itulah kenapa kamu disebut \"anggota Garde yang menolak undangan dari Institut Penelitian Fontaine sampai tiga kali!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110115,
					"content": "Tiga kali nolak Institut Penelitian Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110117,
					"content": "Iya! Nih ya aku kasih tahu, dari dulu mereka sudah mengincar dia, bahkan rela bayar mahal asalkan dia mau melakukan penelitian untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110118,
					"content": "Tapi dia tetap tinggal di sini karena dia suka sama pekerjaannya! Ah, benar-benar mengharukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110119,
					"content": "Walau demikian, dia tidak bisa membiarkan bakatnya tersia-siakan begitu saja, jadi dia kadang-kadang suka bikin penemuan baru buat bantu kerjaan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110120,
					"content": "WOOW!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Ehem, kamu terlalu memuji ah, Chenee. Masih ingat yang kubilang sebelumnya? Jadilah seperti padi, semakin berisi semakin merunduk, semakin berilmu, harus semakin rendah hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110122,
					"content": "Siap grak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110123,
					"content": "Pokoknya, aku mau minta bantuan kalian berdua untuk memverifikasi kelayakan dari meriam jarak jauh ini. \"Lokasi\" dan \"target\" juga sudah kami siapkan, pokoknya tenang saja deh, kami pasti bayar kalian dengan layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110124,
					"content": "Hehe, kalian datang ke orang yang tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "Sepanjang perjalanan, kami berdua ini sudah lihat banyak hal. Kami bisa bantu kasih masukan penemuan kamu ini bisa dipakai apa tidak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "Bagus! Kalau begitu, semangat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110127,
					"content": "Oke ... ayo ke sebelah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110105,
					"content": "Atau soal aku latihan berpedang di kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}