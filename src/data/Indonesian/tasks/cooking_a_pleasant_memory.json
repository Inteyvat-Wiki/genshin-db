					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "Keluargaku dari dulu sudah berbisnis di jalan ini, dari Chasm sampai ke Sumeru. Kami mengimpor bijih batu permata dari Liyue, dan mengekspor rempah-rempah dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Ada suatu kali, entah karena kejadian apa, aku sudah lupa. Yang jelas, ayahku meninggalkanku di Desa Gandharva lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Aku ingat dulu aku kenal dengan satu teman di hutan. Kami berlarian ke mana-mana, terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Lalu apa yang terjadi aku sudah lupa. Siapa namanya, bagaimana tampangnya, aku sudah lupa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Yang aku ingat waktu itu, aku sangat bahagia. Lalu akhirnya ayah pulang dan menjemputku. Aku pernah berpikir untuk mencarinya kembali, tapi selalu tidak ada kesempatan, lalu aku jadi lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Kalau bukan karena kamu meminta gula dariku, aku pasti sudah benar-benar lupa dengan kejadian ini. Kok bisa jadi begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "Iya, ini dia! Tidak kusangka kalian bisa bawakan secepat ini. Ini asli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "Bukan karena mau bohongi aku, ja—jadi kalian memalsukannya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "Kalau kita bisa palsukan sesuatu cuma dari deskripsimu saja, itu sih keajaiban namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Kalau enggak percaya, coba saja sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "Kalian tidak taruh yang aneh-aneh di dalamnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Sudah pasti enggak! Haduh! Kalau enggak mau coba, kami ambil balik deh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "Jangan ... jangan, aku coba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Jangan diambil dulu, oke? Aku coba sekarang, ini langsung kucoba ... Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, benar ... ini \"rasa kebahagiaan\", benar memang rasa ini ... hehe ... aku tetap merasa senang setelah mencobanya tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "Aku tidak menyangka bisa mencicipi rasa seperti ini lagi, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "*huff* Bagaimana ya ... \"rasa kebahagiaan\" ini masih sama seperti dulu, tapi aku tidak merasa sebahagia saat pertama kali memakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Mungkin gula yang diberikan kurang manis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "Bukan, bukan masalah rasa ... tapi saat aku mencicipi \"rasa kebahagiaan\" ini bersama temanku .... Itu pertama kalinya aku mencicipinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Aku merasa waktu itu jauh lebih bahagia dari sekarang, kenapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#Itu wajar kok. Kan walaupun makanan yang dibuatnya sama, tapi tiap kali {NICKNAME} buat juga rasanya nanti bisa saja jadi beda-beda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Perasaan Paimon juga beda-beda tiap kali makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Memang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "Tidak, tidak mungkin. Pasti ada cara yang bisa buat aku merasa sangat bahagia seperti saat pertama kali aku mencicipi \"rasa kebahagiaan\" ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "Aku tahu, waktu itu aku makan dengan teman. Jadi \"rasa kebahagiaan\" ini harus dimakan bersama teman supaya bisa terasa lebih enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "Pasti begitu. Kalian Nara yang baik dan sudah menemukan \"rasa kebahagiaan\" ini. Kalian teman baikku. Aku akan buatkan untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "Ya, kita teman baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka pun mulai memasak dan memasukkan Zaytun Peach serta gula ke dalam panci ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Lalu Arasaka menghidangkannya padamu dan Paimon.\\nTernyata selain rasa yang sangat \"manis\", tidak ada rasa lain lagi.\\nMungkin ini adalah \"rasa kebahagiaan\".",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah, ini rasanya. Enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Hmm, makanan ini rasanya lumayan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Lumayan \"membahagiakan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Terlalu manis ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Paimon setuju, memang sih manis banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "Oh ya, wah? Sepertinya aku terlalu banyak memasukkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Tapi ... Heh. Ternyata memang harus makan dengan teman baru bisa bahagia saat makan \"rasa kebahagiaan\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Walaupun rasanya agak beda dengan yang pertama kali, tapi aku bisa merasakan perasaan bahagia yang berbeda ... saat makan dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Yang penting kamu bahagia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "Awalnya aku kira kalian pasti punya maksud jahat, tapi kalian tidak mempermasalahkan kesalahpahamanku. Malah membantuku menemukan \"rasa kebahagiaan\" ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Aku bisa membuat makanan \"kelezatan yang hakiki\" dan menyelesaikan \"latihan masak\" ini berkat bantuan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "Ini bukan apa-apa kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "Bukan apa-apa? Kalian sudah banyak membantuku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Oh ya. Aku akan mengajari kalian cara membuat makanan ini. Jadi kalian bisa berbagi \"rasa kebahagiaan\" ini dengan teman kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "Asal kalian kasih makanan \"super lezat\" ini pada mereka, mereka pasti jadi mengerti apa itu \"rasa kebahagiaan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "Tolong. Aku mau minum ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "Aku mau minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Memangnya iya begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Ada yang salah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
