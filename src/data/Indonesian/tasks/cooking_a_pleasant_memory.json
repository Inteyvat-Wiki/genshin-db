			"dialogs": [
				{
					"id": 730190301,
					"content": "Eh-eh? Apa kalian sudah menemukan \"rasa kebahagiaan\"nya? Ada di Desa Gandharva ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190302,
					"content": "Kalau ada Nara yang menggendong benda seperti drum, \"rasa kebahagiaan\" pasti ditaruh di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
