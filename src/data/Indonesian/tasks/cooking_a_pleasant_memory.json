					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "Kamu harus menyerap hujan dan embun dengan baik, agar bisa cepat tumbuh besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Halo! Kamu ... Ara ... Ara ... apa ya kemarin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Apa kamu kakak Arapacati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "Oh ya juga ya, trik ini boleh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "Besarlah, besarlah, supaya jadi makanan yang enak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "Dia kayaknya enggak dengar kita deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! Apa kamu Arasaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Kyaaa! Nara ... tinggi sekali, menakutkan sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Aku mohon ... jangan petik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Oke, kami enggak akan petik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Bagus. Hehe ... Aku sudah merawat Zaytun Peach ini sedikit demi sedikit, sejak mereka masih jadi benih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "Tidak! Kalian Nara jahat! Kenapa sih kalian sembarangan menyerang Zaytun Peach yang bukan kalian tanam sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "Nara kok ... kok bisa punya kebiasaan menakutkan seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "Kita enggak melakukan apa pun dan belum sempat petik loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "Belum saja sudah begitu menakutkan. Kalau benar dilakukan, bisa bikin aku jantungan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Jangan begitu, biar Arasaka pikir-pikir dulu. Demi jerih payahmu menanam Zaytun Peach dan usaha \"latihan masak\"-mu, kamu tidak boleh berhenti di sini. Ayo, jangan takut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Ah, rupanya kamu Arasaka ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Wah, ka—kalian kok bisa tahu namaku ... kalian dari mana? Baru pertama kali bertemu kok sudah tahu namaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Kamu sendiri yang bilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Habislah aku! Mulutku harimauku. Namaku akan dipakai untuk kutukan yang mengerikan ... Tolong ampuni aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Apa pun akan kulakukan untuk kalian, selain memberikan Zaytun Peach-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Enggak usah segugup gitu deh, sebetulnya Arapacati yang suruh kami cari kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara—Arapacati? Ah, dia \"adik\" kesayanganku, cahaya dalam lebatnya hutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Kamu menceritakan apa yang terjadi kepada Arasaka.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Wah, Festival Utsava, Festival Utsava kok cepat sekali ... Oh, jadi kalian Nara yang mau ikut Festival Utsava kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Maaf, sudah panggil kalian Nara jahat. Kalian pasti Nara baik, karena cuma Nara baik saja yang bisa masuk Vanarana dan ikut Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Festival Utsava-nya akan segera tiba. Tapi, kalau \"latihan masak\" belum kuselesaikan dan aku langsung kembali ke Vanarana ... Ah, tidak ... Kita harus ikut Festival Utsava ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Kok malah jadi tambah gugup? Bukannya kamu masih punya Zaytun Peach yang ditanam itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "Ka—kalau cuma Zaytun Peach yang kutanam saja tidak akan cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "Kita harus bawa juga \"rasa kebahagiaan\". Kalau tidak, Zaytun Peach akan tetap jadi Zaytun Peach biasa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas, dan Araphala tidak percaya kalau di dunia ini ada yang namanya \"rasa kebahagiaan\". Aku mau buat untuk mereka, nanti Nara juga boleh coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "\"Rasa kebahagiaan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hehe, \"rasa kebahagiaan\", dulu aku pernah cicip sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "\"Rasa kebahagiaan\" itu warnanya putih, begitu diremas akan hancur ... jadi Valuka putih. Tapi tidak sekeras dan sesakit Valuka, dan ditaruh di dalam gelembung yang keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "Valuka putih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Apa Valuka putih itu pasir warna putih? Terus gelembung yang keras itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Hummm ... enggak ngerti deh. \"Rasa kebahagiaan\" itu ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "Ke—Kenapa kamu tanya-tanya? Jangan-jangan kamu mau rebut \"rasa kebahagiaan\" dariku? Mengerikan sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "Kami mau membantumu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Membantuku? Kamu mau bantu apa? A—Aku bisa mengambilnya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "Tapi di sana ada banyak Nara yang mondar-mandir, dan salah satunya ada yang berbau mirip Nara Valuka. Uhh ... aku takut ... kalau saja Nara-nya tidak sebanyak itu, aku pasti bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "*huff* Oke, aku tidak berani masuk ke Desa Gandharva untuk mengambilnya, terlalu banyak Nara di sana. Lagi pula di sana pohonnya mati semua, sangat menakutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "Aku punya satu teman Nara yang tinggal di sana. Tapi sudah lama sekali. Sekarang dia sudah berubah dan tidak bisa mendengarku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Oh, begitu ya ... Jadi \"rasa kebahagiaan\" yang kamu bilang itu sebenarnya ada di Desa Gandharva, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "\"Rasa kebahagiaan\" itu bukan tumbuh dari tanah, tapi dibuat oleh Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "Aku benar-benar mau coba lagi. Aku masih ingat waktu pertama kali mencobanya, perasaanku jadi senang sekali. Rasanya enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Saat bersama teman Nara di hutan, aku menghitung banyaknya sinar matahari bagai lempengan emas yang jatuh dari celah dedaunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "Kami bernyanyi dan mencicipi \"rasa kebahagiaan\" bersama. Setiap kali aku melihat sinar matahari dari celah dedaunan, aku langsung teringat dirinya. Dan setiap aku teringat dirinya, aku langsung teringat \"rasa kebahagiaan\" itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "Jadi aku ingin Arapacati mencicipi rasa itu. Dan begitu Festival Utsava dimulai, aku mau Nara itu juga ikut mencicipinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Oke. Paimon sudah mengerti. Serahkan saja sama Paimon dan {NICKNAME}! Betul kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Aku juga ingin gembira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Benarkah? Kalian tidak membohongiku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Ya enggak lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Tapi Desa Gandharva kan banyak banget orangnya, terus kita mau cari di mana petunjuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Aku tahu. Belum lama ini aku melihat satu Nara yang lewat, dia <color=#00E1FFFF>pergi ke Desa Gandharva</color>. Barangnya dia bawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Ada benda seperti drum di punggungnya yang dipakai untuk menaruh barang bawaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "Ada benda seperti drum di punggungnya ya ... <color=#00E1FFFF>Pasti itu ransel atau keranjang gendong</color>, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Oke, kami akan bantu kamu cari \"rasa kebahagiaan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Karena aku sudah berjanji pada Arapacati ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Waaah! Paimon menakutkan sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Hei! Paimon cuma mau bantu Arasaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "... Gelembung yang keras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "\"Rasa kebahagiaan\" yang kamu maksud itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Kami sudah tahu dari awal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "APA?! Sudah tahu dari awal?!? Ternyata kalian sejak awal sudah memperhatikanku ... A—Apa yang sebenarnya kalian inginkan dariku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Zaytun Peach? Ti-tidak boleh ... kalau benda yang lain pasti kuberikan ... Tapi kalau Zaytun Peach , tidak, apa pun yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
