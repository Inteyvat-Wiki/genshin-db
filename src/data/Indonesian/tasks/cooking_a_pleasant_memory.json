			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Hmm? Halo. Ada apa? Apa kalian cari sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Iya, sebenarnya kami mau cari sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Hehe, tentu saja! Semua orang yang kemari pasti cari \"sesuatu\". Tapi kalau cuma bilang \"sesuatu\", aku tidak akan bisa tahu \"sesuatu\" apa yang kalian mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Emm ... iya sih, gimana bilangnya ya, yang kami mau itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Yang putih dan kotak-kotak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "Yang putih dan kotak-kotak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Betul, kalau diremas akan hancur jadi pasir, terus bisa ditaruh di dalam gelembung yang keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "Deskripsi yang ... aneh sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Kalau cuma dengar saja, aku tidak tahu benda apa itu. Tapi yang tadi dibilang, benda yang putih dan kotak-kotak itu dipakai buat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Kegunaannya, dipakai buat apa tahu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Bisa dimakan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "Benda putih dan kotak-kotak yang bisa dimakan ....?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "Ah, aku tahu! Aku tahu yang kalian maksud ... HAHAHAHA ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "Apanya yang lucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Waaah .... HAHAHAHA. Putih kotak-kotak, kalau diremas langsung hancur jadi pasir ... bisa dimakan juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Bukannya itu \"gula\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Gelembung yang keras, bukannya itu botol kaca untuk menyimpan gula ya? Ya Archon! Gelembung yang keras, hahahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "Apaan sih, jadi itu gula ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "Aku jadi tersipu malu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Aduh, aku tertawa sampai mau nangis. Beberapa tahun terakhir aku terus pergi ke mana-mana untuk berbisnis, entah kapan terakhir kali aku tertawa seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Boleh dibilang, aku rindu sekali masa-masa itu. Aku ingat dulu waktu masih kecil, pernah ada seorang teman yang baru pertama kali makan gula, dan dia juga bicara hal yang mirip ucapan kalian barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "\"Benda putih kotak-kotak ini enak sekali! Hebat sekali! Rasa kebahagiaan.\" Katanya saking terkejutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha ... itu sudah dulu sekali. Sekarang aku coba ingat-ingat lagi, tapi aku sudah lupa tampangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Ah! Karena aku bisa tertawa sesenang ini, kuberikan sebotol gula ini sebagai hadiahnya untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Hati-hati ya. Gelembung keras ini meski sangat kuat, tapi kalau jatuh ke tanah bisa hancur juga. \"Gelembung keras\", HAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "Ini memalukan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Dipakai untuk memasak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Untuk memasak, putih kotak-kotak, jangan-jangan bumbu masak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
