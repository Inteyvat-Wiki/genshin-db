				},
				{
					"id": 100060702,
					"content": "Kerja bagus, Sebas. Pasti tidak mudah menjadi dirimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "Heh. Seekor kucing yang bisa meniru suara orang lain sama anehnya dengan yang pertama kali dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060704,
					"content": "Yah, jangan terlalu kaget. Aku bukan kucing biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
