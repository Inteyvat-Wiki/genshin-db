				]
			},
			"dialogs": [
				{
					"id": 100060101,
					"content": "Halo, Durin! Jadi selama ini kamu di sini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#Oh, {NICKNAME}, Paimon. Sedang apa kalian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Hehe, pertanyaan yang benar itu, ngapain sih kamu di sini baca buku terus? Cuacanya lagi bagus, lho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Oh. Yah, sejak aku punya lebih banyak kesempatan untuk berinteraksi dengan orang-orang Mondstadt, aku jadi sulit membedakan kapan mereka sedang bercanda atau serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Misalnya, terakhir kali aku ke toko bunga, aku melihat bunga yang cantik. Lalu, aku memberi tahu pemilik tokonya, dan dia berkata:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "\"Hehe, kalau kamu suka rumput liar ini, coba tambahkan Mint dan Sweet Flower, lalu jadikan buket bunga.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Jadi aku melakukan sesuai yang dia katakan. Tapi waktu aku memperlihatkan rangkaian bunga yang sudah jadinya, dia menatapku dengan tatapan yang menyeramkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Kamu memiliki sudut pandang yang unik, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Kemudian, Albedo berpendapat bahwa hal ini terjadi karena aku kesulitan memahami \"makna di balik kata-kata\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "Jadi, setelah aku mempelajari tulisan Mondstadt, dia bilang aku bisa datang ke sini dan membaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Aku lahir dari sebuah buku cerita, jadi aku merasa bahwa buku-buku ini mungkin bisa mengajarkanku lebih banyak tentang \"aturan\" dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "Dan, yah, sepertinya aku lupa waktu ... Jadi, um, kalian butuh sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Teman-teman memang sering mampir hanya untuk menyapa, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Oh, begitu. Kalau begitu aku sudah belajar satu aturan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "Yap! Ngomong-ngomong, kita ada hal yang perlu dibahas, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "Ya, kami membawa pesan dari Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Oh ... I ... Ini dari Bibi Rhinedottir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Tidak, aku ... Aku hanya terkejut. Rhinedottir adalah teman ibuku ... Dan ibu dari naga yang dulu ada di tempatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Aku menggantikan posisinya — mengambil takdir yang seharusnya menjadi miliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Jadi, kalau dia tidak suka padaku ... Yah, aku tidak tahu harus bagaimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "Kurasa dia tidak mendendam padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Yah! Kami ada di sini untukmu! Tapi serius, Paimon rasa ini bukan hal yang buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Mendengar ucapanmu aku jadi lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Ya, sepertinya harus aku buka ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "Bagaimanapun juga, kami ada di sini bersamamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Jangan gugup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Jadi kami ke sini atas permintaan Hexenzirkel ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Sepertinya yang bermasalah justru dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
