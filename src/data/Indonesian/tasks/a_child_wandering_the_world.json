					}
				]
			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "Sebenarnya, dari sudut pandang biologi, aku bukanlah seekor kucing sama sekali, melainkan makhluk hasil alkimia. Kamu tidak akan menganggap dirimu sebagai Specter hanya karena bisa melayang di udara seperti mereka, bukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Specter? Sebenarnya kamu mau ngomong apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Oh, aku tahu! Sebas bermaksud kalau kamu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Sebaiknya hentikan pikiranmu itu, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Pikiran apa? Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Oh, dan mengingat bagaimana pesan Master Rhinedottir berakhir, kurasa teknik ini sudah tidak berguna lagi. Aku akan menghancurkannya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Jarang sekali ada orang yang bisa membuatnya mempertimbangkan kembali. Sungguh prestasi yang mengesankan, anak muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "Sudah, aku pergi dulu. Masih ada pesan lain yang harus kusampaikan. Mungkin kita akan bertemu lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
