					}
				]
			},
			"dialogs": [
				{
					"id": 100060601,
					"content": "Hmm. Sepertinya Albedo memang tidak salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "Lain kali, jangan tiba-tiba menyerang kami pakai segerombolan monster cuma buat ngebuktiin sesuatu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Tapi, sekarang aku merasa bisa mengontrol kekuatanku dengan lebih bebas setelah kita mengalahkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "\"Setelah mendengar tentangmu, aku telah mempersiapkan sebuah teknik yang dapat menyegel kekuatan kegelapan dalam darahmu. Aku berencana untuk menggunakan kesempatan ini untuk menurunkannya kepadamu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "\"Tentu saja, ada harga yang harus dibayar untuk menggunakannya. Meski ini akan mempertahankan keberadaanmu di Teyvat, tapi juga akan melemahkan hubunganmu dengan dunia ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "\"Dan bagaimanapun juga, kamu adalah anak M. Bagaimana aku bisa menghadapinya dengan hati yang tenang, jika kekuatan yang tak terkendali itu membuatmu mengalami nasib yang sama seperti anak yang datang sebelum dirimu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "\"Tapi melihatmu sekarang, sepertinya kekhawatiranku tidak beralasan. M adalah ibu yang luar biasa, dan jauh lebih mumpuni dibandingkan diriku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "\"Dan aku harus mengakui, aku begitu penasaran sejauh mana kamu bisa berkembang — bagaimana kamu, sebagai makhluk alkimia yang benar-benar terintegrasi dengan dunia ini, akan menemukan tempatmu dalam kehidupan sosial manusia?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "\"Aku belum pernah melakukan eksperimen seperti ini sebelumnya. Oleh karena itu, kamu mungkin memegang kunci untuk beberapa jawaban yang tak terduga.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Hei! Kamu keliru. Durin bukan bahan percobaan! Dia teman kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Aku tidak begitu mengerti, tapi ... aku menghargai kebaikanmu, Tante Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
