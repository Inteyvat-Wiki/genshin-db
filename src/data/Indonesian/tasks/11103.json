					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030907,
					"content": "Aku mohon. Adeptus yang hebat, lepaskan aku. Aku tidak akan mengulangi perbuatanku lagi, aku janji...",
