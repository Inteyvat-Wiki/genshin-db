						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Sisanya biar kalian serahkan padaku, kalian bersiaplah untuk menyambutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Di mana aku...? Eh? Kalian sepertinya tidak asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030705,
					"content": "Apa yang terjadi dengan tubuhku? Aku merasa... ringan. Seperti tidak mempunyai berat badan sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030706,
					"content": "Kita menggunakan ilmu Adeptus untuk membawa jiwamu kemari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "Ilmu Adeptus? Hahaha! Kamu berani mengaku sebagai Adeptus di hadapan Adeptus yang asli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030708,
					"content": "Tapi mengenai masalah ada di mana aku sekarang... Aku benar-benar yakin barusan aku sedang tidur di Wangshu Inn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030712,
					"content": "Ah, iya — pasti begitu! Tentu saja. Haha, seperti yang sudah diduga dari seorang Adeptus sepertiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030713,
					"content": "Aku pasti sedang bermimpi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030714,
					"content": "Hmm... Orang ini sepertinya tidak ada harapan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Ini bukanlah mimpi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Oh? Apa artinya ini? Apa kalian pikir aku akan mengizinkan kalian berbuat seenaknya di mimpiku sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030718,
					"content": "...Baiklah, waktunya untuk memberinya pelajaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Alasannya adalah... Kamu dapat merasakan sakit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Karena kamu sudah mati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "Ma..Mati?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030711,
					"content": "Bagaimana mungkin, aku barusan sedang tidur nyenyak di Wangshu Inn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
