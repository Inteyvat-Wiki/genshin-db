						111030912
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030912,
					"content": "Dia sangat ketakutan karena aura Xiao hingga tidak dapat berkata-kata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Oh Adeptus yang agung... Bolehkah aku bertanya mengenai namamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030914,
					"content": "Conqueror of Demons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "Ternyata kamu! Benar-benar kamu! Aku tidak pernah menyangka bisa bertemu dengan Conqueror of Demons, Vigilant Yaksha itu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030917,
					"content": "Kamu juga mengetahui tentang Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Tentu saja, karena kakekku adalah seorang ahli literatur kuno, jadi aku sejak kecil mendengarkan cerita tentang Conqueror of Demons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030919,
					"content": "Sampai sekarang aku masih menjadi kolektor buku yang berkaitan dengan Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030920,
					"content": "Tapi sejak aku menemukan Simbol Seribu Izin saat membongkar barang-barang milik kakekku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030921,
					"content": "Sebenarnya pada awalnya karena aku menyukai Adeptus, jadi aku hanya menirunya saja, tapi lama kelamaan aku malah terjerumus lebih dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030922,
					"content": "Kisah seperti ini benar-benar ada ya... jadi bisa dikatakan bahwa kamu adalah penggemar Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Iya, benar. Terima kasih karena kalian telah mempertemukanku dengan Conqueror of Demons secara langsung, aku merasa ini seperti mimpi yang menjadi kenyataan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030924,
					"content": "Uh, sebenarnya maksud kami bukan itu sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Oh, Conqueror of Demons yang hebat, tolong izinkan aku bersumpah di hadapanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030926,
					"content": "Mulai hari ini aku akan kembali ke jalan yang benar, dengan berbuat baik, dan menolong lain. Aku juga tidak akan lagi merusak reputasi dari Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030927,
					"content": "Aku akan mengingat sumpahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Terima kasih... terima kasih atas pengampunan Anda, dan semua yang telah Anda lakukan untuk Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111030929,
					"content": "Dia terlihat tulus saat bersumpah tadi. Sepertinya dia tidak akan menipu orang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Oh, tunggu! Kita belum mengambil kembali Simbol Seribu Izin. Ayo kita kembali ke Wangshu Inn besok pagi dan cari dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Vigilant Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Sudah tidak berani mengatakan bahwa kamu adalah Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "Tidak berani lagi, tidak berani lagi, aku hampir saja mati di hajar oleh kalian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
