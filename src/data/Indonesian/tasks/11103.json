			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bronze Sparrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "Roh-roh terbang membubung tinggi di atas gunung, sementara tubuh ini terus beristirahat seraya dunia terus berlalu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030102,
					"content": "Em... Maaf telah mengganggumu, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Bolehkah kami meminjam tempat membakar dupa dan beberapa lampu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "Oh begitu... bukankah ini benar-benar hal yang jarang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030105,
					"content": "Datang ke kuil, bukannya untuk menyembah dewa atau Adeptus, tapi malah mengambil tempat pembakaran dupa mereka. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030106,
					"content": "Kami tahu agak kurang sopan untuk meminta, tapi kita cuma butuh meminjamnya sebentar kok — sungguh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Kamu membutuhkannya untuk melakukan ritual Dream Trawler, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030108,
					"content": "Wah... Bagaimana kamu mengatahuinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Aku sudah tinggal di kuil ini lebih lama dari yang kamu kira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030110,
					"content": "Mungkin karena aku sudah cukup lama di sini, sehingga memahami beberapa hal tentang ilmu Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030111,
					"content": "Wow. Paimon tidak pernah dengar ada hal semacam ini sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Ah, itu tidak penting. Ambillah yang kalian butuhkan. Aku juga senang jika barang-barang ini bisa berguna untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030113,
					"content": "...Lagi pula, barang-barang itu di sini juga tidak begitu berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030114,
					"content": "Sepertinya ada sesuatu yang kamu pikirkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Hah, tidak perlu mencemaskan aku. Silakan, ambillah yang kamu butuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bronze Sparrow"
				},
				{
					"id": 111030116,
					"content": "Baiklah kalau begitu... Terima kasih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Tidak masalah. Ambillah yang kamu inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bronze Sparrow"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
