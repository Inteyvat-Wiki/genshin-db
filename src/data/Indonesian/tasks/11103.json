			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Pembakar dupa ini... seharusnya oke... kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Setidaknya tidak sebobrok kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Selanjutnya... kita hanya perlu mengambil Lampu Tujuh Bintang, kan? Semakin cepat kita beraksi, maka akan semakin cepat kita selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Hah? Ke mana dia pergi?! Padahal tadi dia di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Aku pikir setelah kalian mengambilnya, kalian akan lupa padaku dan pergi begitu saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Ah! Ini kan suara orang itu!...Helo? Di-di mana kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Tubuhku telah tiada selama ribuan tahun yang lalu. Yang kamu lihat barusan hanyalah ilusi dari ilmu Adeptus yang disebut Mortal Lingering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Sekarang kamu telah mendapatkan Lampu Tujuh Bintang dan Pembakar Dupa yang digunakan untuk ritual Mortal Lingering, wujudku pun secara alami menghilang dari pandanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Aku dulunya adalah junior dari para yaksha, dikenal dengan nama Pervases, nama yang diberikan oleh Rex Lapis sendiri. Karena kurangnya kemampuanku dalam bertarung, aku pun terbunuh dalam medan pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Hari ini adalah hari kematianku. Harapan terakhirku adalah untuk dapat melihat Liyue di zaman moderen, jadi aku pun menggambil kesempatan untuk datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Ngomong-ngomong... Apakah kalian adalah utusan dari Conqueror of Demons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Jadi kalian berdua saling kenal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Aku dapat merasakan auranya... dan juga besaran karmanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*huff* Bahkan setelah ribuan tahun, dia masih harus memikul rasa sakit yang luar biasa itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "...Aku benar-benar malu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Jangan merasa begitu, Pervases — kamu telah mengorbankan nyawamu demi Liyue, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "Hidup ini sangat berarti, benar... Tapi kalau aku memikirkan beban yang harus ditanggung Conqueror of Demons, menurutku kematian adalah jalan keluar yang mudah, bahkan tidak ada apa-apanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Haha, aku minta maaf. Seharusnya hari ulang tahun adalah hari yang sangat membahagiakan, dan demikian juga, sangat sulit untuk bisa menahan kesedihanku di hari kematianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "Aku takut Mortal Lingering tidak akan bertahan lama. Kalian berdua berhati-hatilah, dan sampaikan salamku kepada Conqueror of Demons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Tentu saja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "*huff* Kalau saja aku dapat mencicipi beberapa Grilled Tiger Fish sekali lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "Dengan ombak dan badai aku berburu ikan, dengan angin dan salju aku membasmi kejahatan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Sepertinya dia telah pergi, ah... Paimon benar-benar berharap bahwa setidaknya seseorang akan mengingat Pervases sang yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Kita harus segera pergi. Tapi mungkin bisa balik lagi kapan-kapan buat bakar dupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "Selamat tinggal, Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "K—Kamu adalah hantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "Hahaha... Kamu tidak sepenuhnya salah juga. Perbedaan antara Adeptus dan hantu memang tipis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
