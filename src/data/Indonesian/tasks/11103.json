					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Apa kamu sudah mengumpulkan barang-barang untuk ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Hmm... pembakar dupa dan lampu ini... Bentuknya sangat bagus, seolah-olah dibuat khusus untuk melakukan ilmu Adeptus. Dari mana kamu mendapatkan semua ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Kita mendapatkannya dari Adeptus bernama Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Pervases juga menitipkan salam untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "...Ya, ini adalah hal yang sepertinya akan dilakukan oleh Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Seperti yang kuduga, sepertinya dia tidak dapat meninggalkan Liyue... Aku berharap agar dia dapat beristirahat dengan tenang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Baiklah, mari kita mulai ritualnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Taruh pembakar dupa di tengah, di kelilingi oleh Lampu Tujuh Bintang, dihiasi benda-benda yang dingin. Beri tahu aku jika kalian selesai agar kita dapat melanjutkan ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Berikutnya adalah hal paling penting dalam ritual Dream Trawler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Ada empat langkah dalam melakukan ritual ini: bakar dupa, meditasi, baca mantra, lalu lepas anak panah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Itu... sepertinya repot sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Seni Adeptus adalah hasil ilmu pembelajaran Adeptus selama ribuan tahun. Jangan menganggap bahwa hal ini merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Jika tidak serius dalam hal ini maka akan menyebabkan tubuhmu dimangsa oleh teknik ini sendiri, atau bahkan menyebabkan jiwamu terpisah dari ragamu selamanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Agh! Sudah, jangan bicara lagi! Paimon minta maaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "Menyerahkan dupa berarti menaruh dupa diatas tempat pembakaran, untuk menghormati Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "\"Meditasi\", untuk membersihkan pikiran dari kebusukan-kebusukan, dan untuk memperjelas penampakan target pada saat menggunakan seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "\"Membaca Mantra\", baca mantranya dengan jelas dan lantang: \"Devayaksha, bawalah sang pendosa tersebut\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Akhirnya, kita akan menembakkan sebuah anak panah ke setiap patung yaksha untuk membuat sebuah kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Jika semuanya berjalan dengan baik, setelah beberapa saat jiwa Starsnatcher akan dibawa ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Kalau tidak ada pertanyaan lagi, mari kita mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Jadi... Ayo kita mulai dengan membakar dupa dulu, ya kan? Lalu memberikan penghormatan kepada Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "*Menelan ludah*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
