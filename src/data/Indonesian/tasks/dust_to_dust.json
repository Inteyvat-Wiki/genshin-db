			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Kalian sudah kembali. Bagaimana Jueyun Karst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031802,
					"content": "Begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031806,
					"content": "Yah, memang belum sempat ketemu semuanya kan ... Mengutip kata-kata para Adeptus: \"Takdir yang menentukan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031807,
					"content": "Tidak apa! Kan masih bisa coba peruntungan lagi kalau senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031808,
					"content": "Lagi pula, info soal Conqueror of Demons saja sudah sangat berharga. Sebagai gantinya, aku juga ada info buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031809,
					"content": "Mengenai meninggalnya Archon ... Tanggapan Liyue Qixing membuatku benar-benar berpikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031810,
					"content": "Mereka mengeluarkan maklumat. Katanya, karena pelakunya belum tertangkap, tidak ada yang boleh melayat dan memberikan penghormatan terakhir ke Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031811,
					"content": "Mereka bahkan mencoba menghentikan penyebaran informasi. Yah, tapi karena ini terjadi ketika Rite of Descension, para Qixing pun kelabakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031812,
					"content": "Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Semua orang Liyue tahu kalau Rex Lapis itu dewa sekaligus Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031814,
					"content": "Selain sebagai Dewa Kontrak, Archon Geo juga dikenal sebagai Exuvia, Prime of Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031815,
					"content": "Para Adeptus yang masih ada sampai hari ini, semuanya pernah tanda tangan kontrak untuk melindungi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031816,
					"content": "Pantesan mereka peduli banget sama Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Iya. Mereka wajib dan juga sangat mampu untuk melaksanakan tugas mereka sesuai kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031818,
					"content": "Kalau para Qixing dinilai sudah tidak mampu menjalankan tugas, maka para Adeptus berhak mengambil tindakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031820,
					"content": "Urusan ini sama bikin aku susah juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Setuju. Rasanya ada yang tidak beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Jiwa sang Archon Geo telah naik ke langit. Untuk apa Qixing menyembunyikan tubuhnya? Benar-benar mencurigakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031822,
					"content": "Betul juga! Kan kita datang ke sini mau cari dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Kalau Liyue Qixing menyembunyikan Exuvia dan enggak memperbolehkan siapa pun mendekat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#Berarti perjalanan {NICKNAME} mencari The Seven selesai sampai sini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "Bukan urusanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Tidak ada komentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Oh? Kalian mencari The Seven? Buat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031828,
					"content": "Heh ... Jawaban bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031829,
					"content": "Mana bisa seorang Knight dibodohi semudah itu oleh Fatui, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031830,
					"content": "Tapi urusanmu itu, aku bisa bantu juga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031831,
					"content": "Eh? Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Beri aku waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031833,
					"content": "Waktu ... untuk menemukan seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031834,
					"content": "Seseorang yang bisa kasih jalan keluar dari situasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031835,
					"content": "Menarik. Semakin mereka coba menutup-nutupi, semakin kacau situasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031836,
					"content": "Kalau ingin melihat sendiri bagaimana akhirnya, kalian harus bertahan hidup sampai pertemuan kita berikutnya, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
