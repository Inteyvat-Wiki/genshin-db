			"dialogs": [
				{
					"id": 120440301,
					"content": "Ada cewek di sana! Ngapain dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440302,
					"content": "Kok kayaknya dia enggak sehat ya ... kita samperin yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440801,
					"content": "Ada apa sih? Tadi kita cuma saling berpandangan sebentar ... terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440802,
					"content": "Sebentar, ini orang-orang datang dari mana? Ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440803,
					"content": "Kayaknya mereka lagi ngantre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "Iya ya ... oh, si cewek tadi! Dia masih di situ, tanya yuk. Kayaknya dia tahu ini ada apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440805,
					"content": "Kalau pergi sekarang, masih ada waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 120440806,
					"content": "Harus dijelaskan berapa kali sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 120440807,
					"content": "Tidak bisa balik lagi kalau lapor. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 120440808,
					"content": "Hmm ... cemas karena kurang inspirasi kreatif ... yah, inspirasi bisa memberikan ruang gerak yang cukup bagi orang-orang yang mudah cemas. Semoga terapi ini bisa membantu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440809,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 120440810,
					"content": "Penyesalan karena kesalahan masa lalu, dan rasa putus asa menghadapi kenyataan masa kini ... aku bisa bantu kamu menjalani hidup dengan pola pikir positif, tapi tetap ini harus dibereskan sendiri, pada waktunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440811,
					"content": "Makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Nishiguchi"
				},
				{
					"id": 120440812,
					"content": "Berikutnya! *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440813,
					"content": "Kenapa sih dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440814,
					"content": "Kamu enggak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "Aman. Berikutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440816,
					"content": "Um ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440817,
					"content": "Mmm! Enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440818,
					"content": "Wah, di luar dugaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440819,
					"content": "Ah? Ada apa nih ... *EEEUUU*! Duh, maaf, maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440820,
					"content": "Maaf kenapa? Kami enggak tahu ini lagi ada apa, lebih enggak tahu lagi kenapa kamu minta maaf. Boleh jelasin ini sebenarnya lagi ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440821,
					"content": "Sepertinya kamu tidak sengaja masuk ke dalam mimpiku. Sini, aku bangunin ya. Biar aku jelasin ada apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440822,
					"content": "Mimpi? Kapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440901,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#Hai! Sudah segar? Ah, tidak disangka {NICKNAME} datang menghampiriku di dalam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "Kita sudah kenal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Oh, bukan. Ada temanku yang sering cerita tentang kamu ... terus, aku kebetulan lumayan mahir menerka profil seseorang dari reputasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "Jadi siapa kamu sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "Ah, iya, iya. Ini pertama kalinya kita ketemu, jadi harus perkenalan dulu yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "Namaku Yumemizuki Mizuki, boleh panggil Mizuki saja biar pendek. Aku Yumekui-baku, sejenis Youkai Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "Yumekui-baku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "Ngik! Ngik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Little Baku"
				},
				{
					"id": 120440910,
					"content": "Eh, itu si kecil yang tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "Seperti itulah wujud asli kaum kami. Dia ya, yang bawa kalian masuk ke dalam mimpiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Baku biasa makan mimpi buruk manusia, tapi untuk mencerna \"makanan\" itu, kami juga harus dalam kondisi bermimpi. Tempat kita ketemu tadi itu tempat biasa aku mencerna mimpi buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "Aku pasti kebanyakan makan sih, soalnya jadi ada sedikit gangguan pencernaan ... untungnya kamu datang di saat yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "\"Kecelakaan\" yang tidak bikin celaka, haha. Makasih banyak, sekarang aku bisa mulai mencerna mimpi buruknya dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Iya, tadi kamu kelihatan kayak enggak enak badan, makanya kami samperin. Kami enggak tahu sih kenapanya, cuma ya mungkin bisa bantu apa gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "Paimon sebel banget kalau dapat mimpi buruk pas tidur. Senang deh sekarang tahu ada orang yang bisa makan dari situ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Makasih ... tapi aku tetap harus minta maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "Kenapa lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "Waktu kamu di dalam tadi, aku tak sengaja makan salah satu mimpimu, yang tidak buruk. Mimpi indah, malah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "Hari ini aku makan banyak banget mimpi buruk, sampai tidak sengaja telan yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "Yumekui-baku bisa makan mimpi indah juga ya? Tapi memangnya kenapa? Salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440922,
					"content": "Salah dong. Mimpi adalah salah satu hal terindah yang bisa dimiliki seseorang. Terus aku datang main telan saja seenaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440923,
					"content": "Ini sudah aturan tidak tertulis untuk kaumku. \"tidak boleh makan mimpi indah orang lain tanpa izin\". Ceroboh, ceroboh banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440924,
					"content": "Jangan gitu ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "Tapi ... apa kamu tidak jadi merasa depresi gitu? Pikiranmu tidak jadi penuh dengan ingatan yang menyebalkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440927,
					"content": "Enggak sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Luar biasa ... baru kali ini aku dengar ada orang yang kondisi mentalnya bisa tetap stabil setelah mimpi indahnya ditelan Youkai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440929,
					"content": "#Umm ... mungkin karena mimpi indah si {NICKNAME} terlalu banyak jumlahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440930,
					"content": "Mungkin, tapi aku jadi berutang sama kalian. Ah, ini saja. Nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440931,
					"content": "Ini ... Undangan khusus Aisa Bathhouse ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440932,
					"content": "\"Usaha kami dipenggawai oleh ahli psikologi klinis, kami memberikan pelayanan spa dan fine dining. Silakan insan-insan yang berbeban berat, datang dan tanggalkan kesusahanmu di sini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440933,
					"content": "Itu tempat kerjaku. Ada alamatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440934,
					"content": "Yang punya undangan VIP ini berhak menerima pelayanan termewah, tanpa dibebankan biaya ... Waduh, benar juga. Aku harus segera balik kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440935,
					"content": "Sampai ketemu lagi! Datang ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440936,
					"content": "Jadi dia Yumekui-baku yang makan mimpi buruk, sekaligus ahli psikologi klinis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440937,
					"content": "Yah, nyambung sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Paimon enggak pernah kepikir sama sekali buat ikut terapi. Tapi ya memang Paimon juga enggak pernah stres gimana sih ... kecuali pas pusing milih makanan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440940,
					"content": "Eh, ngomongin makan ... di pemandian itu ada fine dining segala! Kita punya undangan VIP. Artinya, boleh makan sepuasnya sampai kenyang, ya kan? Asyiiik! Kesempatan sekali seumur hidup, enggak boleh disia-siain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440938,
					"content": "Dan keren juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "Aku baik-baik saja kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
