			"dialogs": [
				{
					"id": 120440201,
					"content": "Ah, ingat enggak pas kita ngejar Tanuki ke sini tempo hari? Duh, masa-masa jaya tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
