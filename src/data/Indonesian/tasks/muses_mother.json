						740730702
					]
				},
				{
					"id": 740730702,
					"content": "Benar juga ya, jawabannya bayangan! Api kan enggak bisa bakar bayangan, lalu bayangan juga selalu ada di samping kita.",
					"roleType": "TALK_ROLE_NPC",
