					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730404
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730404,
					"content": "Meskipun kita sudah dapat jawabannya, tapi pintunya juga sudah dibuka orang lain ... Kita harus gimana dong sekarang?",
