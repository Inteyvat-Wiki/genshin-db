			"dialogs": [
				{
					"id": 740732101,
					"content": "Kamu memeriksa bagian atas mekanisme dengan teliti, tapi tidak menemukan apa pun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "Ternyata di sini enggak ada apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732103,
					"content": "Lebih tepatnya, sudah diambil orang lain terlebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732104,
					"content": "Berarti rencana kita gagal dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732105,
					"content": "Lahirnya \"Rasionalitas\" merupakan gabungan dari keempat kuadran yang ada. Kita masih punya kesempatan asal kita bisa mendapatkan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732106,
					"content": "Kalau begitu, ayo kita cepat ke tempat selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
