				},
				{
					"id": 740730202,
					"content": "Meski memang benar api tidak bisa membakar batu, dan dia juga bersembunyi di balik organ manusia. Tapi batu itu tidak lahir dalam sekejap, kan?",
					"roleType": "TALK_ROLE_NPC",
