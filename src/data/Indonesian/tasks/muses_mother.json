			"dialogs": [
				{
					"id": 740732201,
					"content": "Kamu memeriksa bagian atas mekanisme dengan teliti, tapi tidak menemukan apa pun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732202
					]
				},
				{
					"id": 740732202,
					"content": "Ternyata di sini juga enggak ada apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732203,
					"content": "Jadi Caterpillar, sebenarnya kita mau cari apa sih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732204
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740732204,
					"content": "Kita sedang mencari bahan-bahan untuk menempa Pedang Agung Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732205,
					"content": "Asosiasi Narzissenkreuz telah menciptakan kembali empat jenis material kosong yang dibutuhkan di dunia materi ini berdasarkan filosofi misterius dari Kerajaan Bawah Tanah dan Fontaine Kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732206
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732206,
					"content": "Aku tidak bisa memahaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732207
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732207,
					"content": "Hal-hal misterius seperti itu memang hanya bisa dirasakan, mungkin lebih sulit dipahami daripada kekuatan elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732208
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732208,
					"content": "Beberapa puluh tahun lalu, aku pernah menginput materi pelajaran tingkat pengantar hingga menengah dari Darshan Spantamad di Akademiya. Ternyata kekuatan elemen juga tidak seajaib itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732209
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732209,
					"content": "Apa iya? Tapi bagaimanapun juga, intinya ini adalah perpaduan antara teknologi kuno Fontaine dengan teknologi kuno Kerajaan Bawah Tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732210
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732210,
					"content": "Di dunia ini muncul empat jenis materi, yaitu Ingatan, Harapan, Jiwa, dan Kepribadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732211
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732211,
					"content": "Demi mencegah ambiguitas, lebih baik kita sebut dengan pecahan \"Ingatan\", pecahan \"Harapan\", pecahan \"Jiwa\", dan pecahan \"Kepribadian\" saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732212
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732212,
					"content": "Terus kok barang-barang ini bisa dipakai buat menempa Pedang Agung sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732213,
					"content": "Di dalam filosofi misterius Asosiasi Narzissenkreuz, kuil adalah mikrokosmos dari alam semesta, para anggotanya adalah perwakilan dari para dewanya, dan minyak suci adalah kemauan yang kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732214
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732214,
					"content": "Pedang Agung adalah \"Rasionalitas\" yang menghancurkan segalanya. Pedang ini harus dilahirkan dari kehendak manusia yang utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732215
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732215,
					"content": "Sungguh misterius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732216
					]
				},
				{
					"id": 740732216,
					"content": "Huh, ya begitulah yang namanya filosofi misterius — diri dilekatkan pada apa pun yang terlihat cukup mirip, lalu saat hal semacam ini menjadi ajaib, pada akhirnya fiksi menjelma menjadi kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732217
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732217,
					"content": "Yah pokoknya, ayo kita cepat-cepat ke tempat selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
