			"dialogs": [
				{
					"id": 740730501,
					"content": "Kayaknya belum lama ini sudah ada orang yang ke sini. Apa mekanisme di depan situ sudah dibuka ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730502,
					"content": "Api unggun di sana lagi kebakar tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730503,
					"content": "Tapi ... kenapa harus nyalakan api di sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730504,
					"content": "Coba Paimon lihat ada tulisan apa di tablet batunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730505,
					"content": "\"Tempat ini adalah ku ... kua ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730506,
					"content": "Kuadran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730507
					]
				},
				{
					"id": 740730507,
					"content": "\"Kuadran ingatan. Aula ingatan, juga ruang di antara ingatan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730508,
					"content": "\"Terlahir dalam sekejap\" ... \"Selalu bertentangan, menemanimu dalam istirahat abadi, tak pernah terpisahkan\" ... \"Tak terjangkau kobaran api\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730509,
					"content": "Ini teka-teki deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730510,
					"content": "Jawabannya pasti ... api! Tuh ada api unggun di dekat sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730511,
					"content": "Memangnya ada teka-teki yang jawabannya tertulis di soalnya ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730512
					]
				},
				{
					"id": 740730512,
					"content": "Benar juga sih, kalau begitu menurutmu jawabannya apa dong?",
					"roleType": "TALK_ROLE_NPC",
