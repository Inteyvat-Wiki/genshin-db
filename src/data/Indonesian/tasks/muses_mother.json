			"dialogs": [
				{
					"id": 740730101,
					"content": "Api unggunnya masih kebakar. Tapi omong-omong, kenapa harus nyalakan apinya di sini? Jelas-jelas ini di reruntuhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Coba Paimon lihat ada tulisan apa di tablet batunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Tempat ini adalah kuadran ingatan, aula ingatan, juga ruang di antara ingatan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Terlahir dalam sekejap\" ... \"Selalu bertentangan, menemanimu dalam istirahat abadi, tak pernah terpisahkan\" ... \"Tak terjangkau kobaran api\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Teka-teki ya? Peradaban kuno Fontaine dan Asosiasi Narzissenkreuz memang suka sekali dengan teka-teki. Entah karena mereka suka barang antik atau karena memang tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "Aku sudah mencoba mencari semua kata kuncinya, tapi tidak ada jawaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Tapi ini adalah teka-teki yang sudah diselesaikan, mungkin jawabannya ada hubungan dengan api unggunnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "Tapi memangnya, ada gunanya kita memikirkan teka-teki yang sudah dipecahkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Tentu saja masih ada. Sama seperti kita berdua yang sudah jadi seperti sekarang, tapi kita masih harus mencari tahu apa yang terjadi di masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "Benar juga katamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Kalau begitu menurutmu apa jawabannya, Kesatria {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
