					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Klee mau naik Kereta Gedak-Geduk sama Nona Panglima! Naik, naik, naik terus ... WAAAAA!!! Tapi, hmm kayaknya itu bikin dia sedikit pusing deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Ah, Klee sadar ya? Bagus sekali. Apa mungkin itu karena bintang-bintang yang dia lihat waktu pusing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Iya, kemarin kayaknya banyak bintang-bintang warna emas yang terbang-terbang di sekitarnya. Tapi sekarang jauh lebih sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Kalau Mama ada di sini, dia pasti bakal bilang kalau bintang-bintang adalah ikan yang jatuh ke awan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
