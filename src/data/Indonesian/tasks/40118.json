				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Keturunan klan bangsawan Lawrence, aku juga belajar banyak hal di sepanjang perjalanan ini ... misalnya, memanggang roti gepeng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Oke bagus, harusnya panas segini sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Tidak disangka kamu tahu cara membuat roti ... Kupikir kamu tipe yang tidak akan pernah dekat-dekat sama dapur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Ah, aku sebenarnya mau tanya ke kamu ... Apa kamu punya waktu nanti? Bisa tidak ajari aku cara bikin camilan yang enak itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Oh? Tapi itu sepertinya butuh waktu. Lagi pula, kita di sini bukannya buat saling kenal satu sama lain layaknya keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Oke, jadi lagi-lagi kamu khawatir tentang hubungan kita dengan keluarga Lawrence, baiklah ... Tapi kamu sendiri bilang kalau kita cuma orang biasa, jadi kenapa kita tidak belajar dari satu sama lain layaknya sepupu pada umumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
