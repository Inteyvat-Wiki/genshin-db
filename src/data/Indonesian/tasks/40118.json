			"dialogs": [
				{
					"id": 401181101,
					"content": "Ini pertama kalinya aku minum teh dengan rasa begini. Sepertinya teh Inazuma berbeda sekali dengan Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah iya benar, sepertinya orang Sumeru senang sekali menambahkan rempah di dalam teh mereka, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Iya, benar! Tapi aku masih belum biasa ... Kalau aku boleh bilang sih, aku lebih pilih minum kopi, walaupun kadang aku jadi tidak bisa tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
