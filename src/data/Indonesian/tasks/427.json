			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Salam, aku adalah Otto dari Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "Wah, ada apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Tolong keluarkan Surat Izin Meluncurmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Su, Surat Izin Meluncurnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Meluncur tanpa membawa Surat Izin Meluncur melanggar Undang-undang Mondstadt pasal 7, ayat 12 tentang berlalu lintas! Ikut aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Kamu memiliki hak untuk diam. Apa pun yang kamu katakan akan terbawa oleh angin selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Tunggu... aku adalah seorang instruktur. Ini adalah tes meluncur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Ah, begitu rupanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Tetapi sepertinya saat ini adalah saat yang tidak tepat untuk melakukan tes meluncur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Memangnya kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "Knights of Favonius baru menerima laporan, ada Raptor yang meluncur di sekitar sini. Jadi aku kira peserta ujian ini salah satu dari komplotan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Raptor? Maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Seorang buronan Mondstadt. Dia selalu menggunakan wind glider waktu beraksi, jadi orang-orang menyebutnya Raptor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Wow. Apa dia terbang dengan cepat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Sampai sekarang... kita belum pernah berhasil mengejarnya. Kali ini kami mau menggunakan relik Katedral untuk memancing dan menjebaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "... tapi dia malah berhasil membawa kabur relik yang berharga itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Tapi untungnya, para suster sudah menaruh tanda rahasia elemental yang bisa dilacak pada relik itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "... tapi gerakan orang itu sungguh cepat, kita tidak bisa mengikuti jejak yang ditinggalkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Kalau memang dia ahli meluncur, pasti aku harus turun tangan! Ke arah mana orang itu kabur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Yang kami ketahui, orang itu terakhir terlihat di dekat Springvale, tapi mungkin sekarang dia sudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Jangan khawatir! Asal aku dan {NICKNAME} mengejarnya bersama-sama, dia tidak akan bisa lolos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Jangan khawatir! Begitu berhasil menangkap buronan itu, aku akan langsung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "... langsung, ehem! Melapor ke Grand Master Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "Jadi ujian Surat Izin Meluncurku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Di, dimakan Baron Bunny...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
