			"dialogs": [
				{
					"id": 4270201,
					"content": "Hey, aku di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270202,
					"content": "Aku sudah atur semuanya, ayo kita lanjutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270203,
					"content": "Sama seperti sebelumnya, terbang lewati tanda-tandanya, dan capai tujuan akhir tanpa berhenti di tengah jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270204,
					"content": "Aku sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"42704",
							"2"
						],
						"stepId": 42704,
