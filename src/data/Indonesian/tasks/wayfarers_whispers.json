			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}, sini, sini. Ada yang mau Paimon tunjukin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690102,
					"content": "Lihat nih, hasil jepretan Paimon di sepanjang perjalanan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690103,
					"content": "Kita sudah pernah ke berbagai tempat, sampai ke pelosok segala. Waktu kamu sibuk menjelajah, Paimon sibuk motret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690104,
					"content": "Nah, ini semua hasil jepretan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690105,
					"content": "Masih ingat dua album foto yang kita beli di Damoville Purveyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690106,
					"content": "Ingat kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "Harus ingat! Paimon ngabisin semua tabungan buat beli itu! Harus bayar di muka dan inden-nya LAMA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690111,
					"content": "Nah, albumnya kan beli dua, buat seorang satu. Biar sepasang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690112,
					"content": "Album Paimon sudah penuh. Yang kamu gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690113,
					"content": "Buat jaga-jaga, Paimon sudah beli lagi album baru. Buat cadangan sih, tapi boleh buat kamu kalau yang punya kamu sudah penuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690114,
					"content": "Paimon suka foto-foto ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "Iya! Kita kan sudah keliling ke mana-mana. Banyak pemandangan indah yang orang biasa seumur hidup pun belum tentu bisa lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690116,
					"content": "Kan sayang banget kalau enggak diabadikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690121,
					"content": "Dan yang paling penting, ini kenangan penting buat kita berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690122,
					"content": "Om Pacal pernah bilang, \"Masa lalu dan masa depan sama-sama berarti.\" Bener banget enggak tuh omongannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690123,
					"content": "Paimon mau pinjemin Kamera juga ke kamu. Biar bisa foto lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690124,
					"content": "Kita sebentar lagi bakal berangkat ke Snezhnaya. Firasat Paimon, ke depannya enggak bakal segampang yang dulu-dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690125,
					"content": "Makanya mending kita tata rapi kenangan perjalanan ini. Mumpung masih bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690126,
					"content": "Jadi, apa pun kesulitan yang ada di sana nanti, kita akan tetap berani dan kuat untuk maju karena punya kenangan saat-saat yang pernah kita lalui bersama, suka maupun duka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690117,
					"content": "Paimon si paling murah hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "Hehe, sudah pasti dong. Paimon itu kan pemandu paling baik di seantero Teyvat! Lebih dari sekadar murah hati nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690119,
					"content": "Sebenarnya alasan Paimon beli satu album lagi karena memang suka banget foto-foto sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690120,
					"content": "Kita sudah lihat banyak sekali pemandangan indah sepanjang perjalanan ini! Masa enggak diabadikan sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690108,
					"content": "Yang mana ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "Eh, kamu lupa? Tega banget! Padahal Paimon ngabisin semua tabungan buat beli itu! Harus bayar di muka dan inden-nya LAMA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690110,
					"content": "Ya sudahlah. Kamu juga sibuk dan banyak pikiran. Paimon si pemandu paling hebat dan paling baik hati ini enggak bakal kesinggung sama hal kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}