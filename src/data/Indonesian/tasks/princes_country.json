			"dialogs": [
				{
					"id": 401290601,
					"content": "Fiuh, kelar juga! Monster jahat sudah dibasmi, Kerajaan Siluman Air berhasil direbut kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Ya. Sekarang waktunya menghadiri upacara pengangkatan Thelxie ... Tapi aku tidak menyangka bakal semulus ini, kukira akan makan waktu lama untuk sampai ke pusat reruntuhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290603,
					"content": "Ini salahku. Harusnya bilang dari awal ke Tuan Freminet kalau kita perlu mahkota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290604,
					"content": "#Karena {NICKNAME} dan Dewi Paimon terlalu kuat! Semua monster dilibas sekali pukul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "Tidak apa, Madam Zuria. Kita balik lagi setelah mahkotanya jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290606,
					"content": "Terima kasih banyak untuk waktunya. Terima kasih juga Thelxie, anak mama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie jadi jago banget berantem ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Rasanya tidak ada yang bisa menghentikan dia ... seperti sudah jadi pangeran seutuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290610,
					"content": "Tuan Freminet, aku juga percaya itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290611,
					"content": "#Kita balik dulu ke kemah. Aku sudah minta tolong {NICKNAME} carikan bahan di jalan tadi, supaya mahkotanya bisa segera jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290612,
					"content": "Terus kita bisa tambahin lagi detail ke kisah Petualangan Fantastis Thelxie! Kerajaan Siluman Air sudah berhasil direbut kembali, waktunya nambahin gambarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
