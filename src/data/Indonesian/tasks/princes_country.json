			"dialogs": [
				{
					"id": 401290101,
					"content": "Apa keadaan anakmu sudah lebih baikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290102,
					"content": "Terima kasih perhatiannya, Tuan Freminet. Kondisinya stabil, dokter keluarga bilang hari dia boleh diajak jalan-jalan ke luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290103,
					"content": "Madam Zuria! Freminet! Kami datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Hehe, orangnya sudah lengkap ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290105,
					"content": "Belum! Kita masih kurang satu. Tapi Paimon tahu dia ada di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "HEI! THELXIEEE!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Woah! Thelxie sudah punya pedang dan tameng. Gagah betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Ya, dengan senjata di tangan, Thelxie jadi kelihatan jauh lebih garang. Tuan Freminet memang luar biasa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290110,
					"content": "Kami juga bantu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "Iya, kalian pintar pilih material. Semuanya berkualitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290112,
					"content": "Soal itu, Madam Zuria bilang ingin menyelesaikan petualangan dengan upacara pemahkotaan. Boleh tidak minta tolong sekali lagi untuk mengumpulkan bahan buat mahkotanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290113,
					"content": "Kalian bisa cari sambil kita menuju ke reruntuhan. Tadinya aku mau kumpulkan sendiri, tapi rasanya kalian bisa nemu yang lebih cantik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290114,
					"content": "Beres bos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Kayaknya sudah siap semua nih. Mau jalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Tunggu sebentar. Aku barusan kepikiran ... karena Thelxie sudah punya tampilan baru, sepertinya kita sudah bisa gambar halaman baru di bukunya. Bagaimana menurut kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290117,
					"content": "Ooh! Paimon jadi semangat nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Mau gambar apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Hmm, ambil referensi dari cerita yang kita sudah tahu? Cuma dibikin lebih ceria sedikit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290120,
					"content": "Jadi kita buang yang sedihnya, ganti sama yang bikin senang? Boleh, Paimon setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Oke, aku coba ya. Aku tidak pandai menggambar, tapi sudah cukup sering lihat hasil karya orang lain. Soal isi gambarnya ... tolong beri tahu aku apa yang ingin kalian lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290122,
					"content": "Apa ya ... gambar senjatanya dulu deh. Sang Pangeran mendapat Pedang Keberanian dan Tameng Keteguhan. Dia berhasil lolos dari cengkeraman keraguan, dan sudah siap memerangi kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290123,
					"content": "Oke, senjata ya ... ada yang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290124,
					"content": "Paimon mau lihat temannya! Sekarang Thelxie sudah punya teman, berantemnya jadi sama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Oke, teman ... ada lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290126,
					"content": "Jangan lupa diwarnai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Warna. Ah ... warna! Itu penting sekali. Jalan yang harus dilaluinya tidak lagi kelabu, tapi penuh warna dan harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290128,
					"content": "Siapa sangka halaman ini bisa jadi begitu menginspirasi ... bagus. Ide kalian semua bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290129,
					"content": "Oke sip! Kelihatan semangat semua tuh, terutama si Thelxie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "Anakku, kamu lihat kan? Merasa terinspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290132,
					"content": "Aku yakin iya, Madam Zuria. Dan ini baru halaman pertamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290133,
					"content": "Iya! Paimon sudah enggak sabar ingin lihat hasil akhirnya! Kita beresin secepatnya ya, sambil tetap yakin dan percaya di dalam hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Mhm! Aku jadi menantikan saat kita sampai sana, jadi ayo lanjut ke Kerajaan Siluman Air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290135,
					"content": "Asyik! Petualangan Fantastis Thelxie, mulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
