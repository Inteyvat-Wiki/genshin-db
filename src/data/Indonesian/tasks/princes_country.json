			"dialogs": [
				{
					"id": 401290801,
					"content": "Madam Zuria, Freminet, mau gambar dulu enggak? Paimon sudah ingin banget tambahin isi bukunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290802,
					"content": "Kamu cuma mau digambar jadi Dewi Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290803
					]
				},
				{
					"id": 401290803,
					"content": "Eh, enggak usah diomongin juga kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290804,
					"content": "Haha, santai. Dengan senang hati. Kalau begitu, ceritanya begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290805
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290805,
					"content": "Setelah melalui berbagai rintangan, Pangeran Thelxie dan rekan-rekannya yang pemberani akhirnya tiba di gerbang Kerajaan Siluman Air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290806
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290806,
					"content": "Di saat ini, sang peri mungil menampakkan wujud aslinya, yakni Dewi Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290807
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290807,
					"content": "Yihaaa! Dewi sudah datang! Dia memuji ketulusan hati semua orang dan sebagai ganjarannya, dia memberkati mereka semua, bahkan mendoakan agar tujuan sang pangeran bisa segera tercapai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290808,
					"content": "Dengan bermandikan anugerah dari sang dewi, sang pangeran dan rekan-rekannya menyerbu masuk ke kubu penjahat, mengusir para monster, dan membebaskan para siluman air rupawan yang dikurung. Sang Pangeran berhasil merebut kembali kerajaannya, tetapi mahkotanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290809
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290809,
					"content": "Oh, mahkotanya belum jadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290810,
					"content": "Tidak ... mahkotanya ada dalam jangkauan, tapi para monster membawanya kabur. Mereka belum menyerah dan berencana untuk menyerang balik, tapi sang pangeran yakin bisa merebut mahkota itu di pertempuran berikutnya. Pelangi kemuliaan akan turun ke atas kerajaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290811
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290811,
					"content": "Oh, Paimon sudah bisa lihat adegannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290812,
					"content": "Wow, cantik banget gambarnya ... Madam Zuria jago deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290813,
					"content": "Terima kasih ya. Halaman kedua sudah selesai, perjalanan Thelxie sudah hampir mencapai akhirnya, dan upacara pemahkotaan akan segera diadakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290814,
					"content": "Anakku ... kamu pasti tersenyum ketika saat itu tiba, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290815,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290816
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290816,
					"content": "Paimon yakin dia akan senang, Madam Zuria! Siapa tahu dokter sudah ada kabar baik waktu kita pulang nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290817,
					"content": "Aku harap juga demikian, ya dewi kami yang mulia. Oh, Tuan Freminet, mengenai waktu untuk membuat mahkota ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290818,
					"content": "Tenang. Sehari juga beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290819,
					"content": "Ah, terima kasih sekali lagi atas kerja kerasnya. Baiklah, kita ketemu lagi dua hari dari sekarang untuk petualangan terakhir, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290820
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290820,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290821
					]
				},
				{
					"id": 401290821,
					"content": "Sampai ketemu dua hari lagi teman-temanku sekalian ♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290822
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290837,
					"content": "♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290822,
					"content": "Oke, waktunya berangkat. Freminet masih mau kerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290823,
					"content": "Iya, harus ke kota buat cari bahan dasar mahkotanya. Aku mau coba beberapa desain, pilih satu yang paling bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290824,
						401290825
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290824,
					"content": "Berdedikasi sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290825,
					"content": "Kerja keras ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290826,
					"content": "Ya, Paimon tahunya kamu jarang terima kerjaan dari orang lain ... tapi ternyata dedikasinya enggak main-main ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290827,
					"content": "Ah ... itu karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290828,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290829,
					"content": "Karena ... aku berharap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290830
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290830,
					"content": "Ah, kenapa mukamu jadi kayak gitu? Merah amat ... kayak malu terus mau pakai helm lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290831,
					"content": "AHH! Mukaku merah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290832
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290832,
					"content": "Jangan ngerjain Freminet ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "Hehe, iya deh, iya ... Kami enggak ganggu deh, Freminet. Sampai ketemu dua hari lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290834,
					"content": "Oke, makasih ... dua hari ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290835,
					"content": "Dah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "Semoga semua orang yang jatuh ke tempat gelap dapat melihat keindahan, dan mengalami mukjizat juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
