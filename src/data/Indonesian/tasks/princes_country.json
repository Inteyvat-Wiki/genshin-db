			"dialogs": [
				{
					"id": 401290901,
					"content": "Jadi ini reruntuhan dalam air yang ditemukan Freminet ... hebat, tapi enggak terlalu persis sih sama bayangan Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Ini Kerajaan Siluman Air, Paimon, bukan reruntuhan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Iya, Paimon tahu kok. Tapi ... Paimon kira kita bakal beneran lihat dunia dongeng, kayak rumah siluman air yang warna-warni, sama jembatan pelangi juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Maaf ... aku ingin pasang dekorasi, tapi waktunya tidak cukup kalau dikerjakan sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "Aman. Waktunya mengkhayal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "Dih, sudah ada yang curi start ya, masuk duluan ke dunia fantasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#{NICKNAME} sudah paham intisarinya. Paimon juga, semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290908,
					"content": "Eh, jangan anggap remeh Paimon! Paimon juga bisa kok jadi super halu ... sudah waktunya ... mode fantasi Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "EHEM ... Wahai petualang muda! Aku adalah Paimon, dewi yang berkuasa atas tanah ini. Sebutkanlah tujuan kalian mengunjungi bangsa ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "Kami adalah rekan-rekan Pangeran Thelxie, wahai dewi yang mahatinggi. Kami ingin membantunya merebut kembali kejayaan serta kemuliaan yang diambil daripadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290912,
					"content": "Merebut kembali kemuliaan! Dewi ini memiliki tiga, emas, perak, dan perunggu yang mulia. Yang mana gerangan kepunyaan sang pangeran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290914,
					"content": "Uhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Paimon, kok ngaco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Sekali-kali tidak! Ini ujian dewata. Dari jawaban barusan, dewi ini telah menyimpulkan bahwa kalian adalah petualang gagah berani tanpa nafsu serakah yang tersembunyi di lubuk hati! Maka dari itu, kalian layak dihormati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Terimalah anugerah dari sang dewi. Ketiganya adalah milik kalian, kemuliaan akan dikembalikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Dan bagi pangeran ini ... sang dewi akan memberkatimu dengan pelangi kemuliaan, agar masa depanmu senantiasa bersinar terang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Puji syukur kami panjatkan kepada dewi yang mahatinggi. Kekuatan telah meliputi sekujur tubuh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290921,
					"content": "Aku ... juga. Apakah ini berkah dewata yang disebutkan dalam legenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290922,
					"content": "Semuanya berkat kemurahan hati Dewi Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hehe! Ehem ... baiklah petualang, majulah, janganlah gentar, musnahkan para monster yang menguasai kerajaan kalian! Kiranya apa yang dicari dapat ditemukan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
