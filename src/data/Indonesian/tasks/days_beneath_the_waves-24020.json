	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Sialan! Ini terakhir kalinya aku menyelam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, ternyata kamu. Senang deh bertemu denganmu! Aku ... Hampir saja tamat riwayatku tempo hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Aku sedang melakukan pekerjaan di dalam air, sama seperti yang biasa kulakukan. Aku menyelam, menghindari rumput laut, sampah, dan aku juga tidak tertusuk apa-apa tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Tapi selagi aku sibuk mengangkat barang-barang dari laut, sekelompok monster tiba-tiba muncul dari dalam lumpur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Aku tidak ingat mereka itu makhluk apaan, tapi mereka langsung menerjangku — aku cuma bisa kabur dan berenang ke atas sekuat tenagaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "Tapi tidak berapa lama kemudian, aku malah ketemu robot ikan aneh, dan mereka langsung main terjang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "Aku tidak tahu kenapa aku bisa sampai di pesisir, pokoknya tahu-tahu sampai, terus tanpa luka juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "Bahaya, jangan kerja di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Tidak bisa! Nih lihat, si Goldman kasih aku tempat ini ... Dia tidak peduli kalau ada yang luka atau mungkin mati pas kerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Tapi seiring berjalannya waktu, ancaman dan bayarannya tidak akan bisa membujuk orang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Jadi dia ganti taktik, dia bilang siapa pun yang berani datang bakal dikasih bayaran Mora tiga kali lipat lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Jadi ... Aku dan beberapa orang lain yang kekurangan uang terpaksa ambil kerjaan ini, kami juga bahkan beli beberapa tombak ikan demi mempertahankan diri di dalam air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Tapi tidak sampai beberapa hari, senjata kami rusak atau hilang ... Yang lainnya pergi ke kota buat ambil senjata baru, sedangkan aku tetap berjaga di garis depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "Terus kenapa tadi kamu pergi nyelam ke dalam air ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Ya itu gara-gara mereka pergi dan tak kunjung balik! Kalau aku tidak segera mulai, aku tidak tahu lagi sampai selarut apa baru bisa selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Biar kubantu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "Tidak, tidak bisa! Ini monster sungguhan, bisa berantem! Petualang biasa tidak akan bisa lawan. Tidak boleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "Aku bukan petualang biasa loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Yah ... apa boleh buat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Ya sudah kalau kamu maksa sih. Aku akan tandai lokasinya untukmu ... Tapi tolong, hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "Tatap-mata-aku ... apa aku kayak petualang biasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Berarti tadi kamu nyelam tanpa senjata buat pertahanan diri sama sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Pindah tempat ke yang aman saja lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "Kali ini ada kejadian apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
