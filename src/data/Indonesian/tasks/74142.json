			"dialogs": [
				{
					"id": 741421401,
					"content": "Wuah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421402,
					"content": "Paimon, aku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "Kali ini juga cepat banget! Paimon bahkan belum sempat berkedip ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421404,
					"content": "Baguslah kalau gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#Oke! Si biang kerok juga sudah balik! Canotila, kamu bikin {NICKNAME} khawatir banget loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421406,
					"content": "Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "*Hiks* Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Eh? Waduh ... Paimon enggak nyalahin kamu kok! Canotila, jangan nangis, cup, cup, nanti Paimon kasih kamu makanan enak deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(Apa yang terjadi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(Kami berhadapan dengan situasi yang berbahaya di dalam.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Oh ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421412,
					"content": "Jangan nangis, Canotila, kamu kan Melusine pemberani! Nih Chicken-Mushroom Skewer favorit Paimon. Ini hadiah buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "*Hiks* ... Terima kasih, Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "(Mengunyah)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Wuah, rasanya aneh banget! Ini makanan manusia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "Hei! Kalau enggak mau makan, balikin ke Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Tapi ... terima kasih, Paimon. Terima kasih juga, Kak {NICKNAME} sudah nyelamatin aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "Apa rencanamu selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Tidak tahu, tapi aku tidak mau baca buku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "Canotila, rasanya itu terlalu ekstrem deh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Hmm, tapi \"Kitab Kebenaran\" benar-benar seram ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(Sebenarnya apa yang terjadi sih?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(Sulit dijelasin ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Kamu baru bisa tahu kalau sudah ke sana.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(Maksudnya apaan sih! Paimon jadi kesel ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "Intinya, aku tidak mau tinggal di sini lagi. Aku mau tinggal sama semua orang di Desa Merusea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421428,
					"content": "Pilihan bagus! Para Melusine bisa jagain kamu baik-baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421429,
					"content": "#Iya. Terima kasih ya, Kak {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421425,
					"content": "(Tapi, untung kamu tidak ikut pergi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
