						],
						"pointId": 6837
					}
				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#Ah! Ternyata Kak {NICKNAME}. Eh, Paimon tidak ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Celah itu ... Kamu sedang lihat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Eh? Celah apa? Bukannya ini cermin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Oh, tapi aku memang lagi cari sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Aku lagi cari petunjuk \"Cermin Misteri\" ... Harusnya sih bentuknya seperti gambar, dan sama seperti \"Kitab Kebenaran\", orang juga bisa \"meditasi\" dengan cermin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Tentang \"gambar\" Empat Kuadran dan Menara Gestalt ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#Oh, jadi ada di tempat seperti itu? Oke deh! Terima kasih, Kak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
