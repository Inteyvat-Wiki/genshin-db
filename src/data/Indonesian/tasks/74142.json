			"dialogs": [
				{
					"id": 741421301,
					"content": "#*Hiks* ... Terima kasih, Kak {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Tidak tahu ... Aku cuma mau lihat bunga matahari yang mekar dan anjing lucu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Tapi aku mendadak dikejar monster yang seram di tengah jalan. Terus langit juga jadi makin gelap. Aku juga dengar banyak suara, tapi aku tidak mengerti mereka lagi bicara tentang apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "Aku takut banget, jadi aku ikuti cahaya emasnya dan terus lari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Setiap kali monsternya mendekat, dunianya jadi sedikit lebih gelap ... Taman, istana, pohon besar, dan bunga-bunganya hilang semua, yang tersisa cuma reruntuhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Terus, monsternya berhasil kejar aku ... *hiks* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Kamu tidak perlu khawatir lagi sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Anjing kecil, tolong antar dia pulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Gadis kecil, jangan datang lagi. Tidak ada apa-apa di sini, tapi dunia luar sana sudah menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Eh? Kamu si anjing kecil? Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "Apa kita masih bisa ketemu lagi? Apa dunia ini masih bisa jadi taman bunga yang cantik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Tidak. Selamat tinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "Kamu, akan kutanyakan sekali lagi, apakah aku di matamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Anjing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Bagus. Kamu sudah mengusir seseorang yang tidak seharusnya di sini. Dan berkat dirimu, kehancuran dunia ini juga berhasil dihentikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Tapi, bukanlah sebuah keputusan yang bijak untuk tetap berada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "Aku rasa juga begitu. Tolong kirim aku pulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Sebuah keputusan yang bijak. Kalau begitu, selamat tinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Sebenarnya apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Awalnya tempat ini sudah hampir hancur sepenuhnya karena kedatangan seseorang yang tidak seharusnya di sini, dan fondasi dunia ini pun terguncang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "Itukah yang kusaksikan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Aku tidak mungkin tahu apa yang sudah kamu alami. Bagaimanapun juga, aku bukanlah kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "Jadi, kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "Itu tidaklah penting. Yang penting adalah penguasa dari dunia ilusi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Mereka percaya mereka bisa menyelamatkan dunia, tapi tidak tahu apakah dunia ini perlu diselamatkan. Mungkin dunia yang mereka ingat tak lebih dari sore hari di mana bunga matahari tidak pernah mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Tapi itu kisah tentang mereka dan bukan tentang diriku. Aku hanyalah sebuah kenangan akan teman mereka. Mereka dulu yakin bisa menyelamatkanku, tapi pada akhirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "Kupu-kupu menjadi kepompong, dan ulat keluar dari dalamnya. Lalu ulat itu kembali kepada kehampaan yang tak pernah lahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Tapi, semua ini tidak penting. Aku sudah tidak memiliki apa pun, dan kini aku hanyalah bayangan dari ingatan mereka, yang tersisa dari kegigihan mereka untuk \"menyelamatkanku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Walaupun begitu, aku tidak membenci mereka. Karena meski mereka menyerah dan berubah, keberadaanku di dunia yang dibentuk dari ingatan dan ilusi ini adalah bukti kegigihan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "Aku sudah puas pernah menjadi teman mereka. Apa pun yang terjadi padaku, aku akan selalu bersyukur atas persahabatan yang pernah kami miliki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "Baiklah, ceritanya sampai di sini saja. Kamu juga sudah merasakan pengaruh tempat ini pada dirimu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Selamat tinggal. Kita tidak akan bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
