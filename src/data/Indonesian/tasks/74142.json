						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#Eh, Kak {NICKNAME} ... Bukannya kita barusan ketemu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420402,
					"content": "Kapan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "Hmm, aku juga tidak yakin ... Lagi pula di tempat seperti ini cukup susah deh buat tahu waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420404,
					"content": "Canotila, sini ikut aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "Tempat ini aneh banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "Tapi bukannya kita sendiri yang bisa nentuin apa yang aneh dan tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420407,
					"content": "Um, aku juga tidak punya maksud lain, tapi aku benar-benar suka di sini. Tempat ini penuh kehidupan dan warna. Aku tidak pernah melihat pemandangan seperti ini di dunia sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420408,
					"content": "Aku cuma lihat setangkai bunga matahari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "Benarkah? Wah! Di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420410,
					"content": "Tempat dulu kita ketemu anjing kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "Oh! Kalau begitu aku ke sana sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420412,
					"content": "Tunggu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
