			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Kasih tahu aku tujuanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Coba biar kujelaskan begini. Entah keraguan apa yang muncul di benak kalian, tapi satu-satunya tujuan kami di sini adalah untuk menyelidiki sumber bencana di Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Bencana apaan? Paimon enggak lihat ada tanda-tanda bencana tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "Bencana yang terjadi lima ratus tahun lalu hanyalah permulaan. Perang melawan kegelapan tidak pernah berhenti dan saat ini kita sedang berdiri di salah satu medan perangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "*huff* Sersan Staf Sementara kita kelaparan sampai ngomong yang tidak-tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Dia memang suka bicara berlebihan sih, tapi baru kali ini dia bicara sesuatu yang tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Lupakan. Maksud Antoha itu ... Yah, intinya kalian orang Liyue bukanlah musuh kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Setidaknya kalian bukanlah musuh kami Kompi Sembilan dalam operasi ini ... Tapi aku tidak jamin bagaimana rekan-rekan kami yang hilang menganggap kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Aku akan membantumu sebagai sesama manusia, tapi sekali ini saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "Te-Terima kasih! Kami tidak akan pernah melupakan jasamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
