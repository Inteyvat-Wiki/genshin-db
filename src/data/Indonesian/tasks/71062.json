				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Memangnya sejak kapan kita berteman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Apa yang kamu mau? — Persediaan, senjata, intel, atau Mora? Kami sedikit pun tidak kekurangan. Ambil semuanya kalau kamu mau, tapi kumohon tolonglah kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Lihat, Sersan Staf pengemis kita baru saja melakukan hal yang sangat memalukan ... Betapa menakjubkannya kehilangan martabat terakhir yang kita miliki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Jangan banyak bicara! Memangnya kamu pikir kita bisa mengenyangkan perut dengan sindiran ketusmu semacam itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Bergabunglah dengan barisan kami! Biarkan sepatu bot berbaris kita mengguncang bumi bak guntur! Berbarislah bersama kami menuju bintang kutub malam yang terang! Marilah, kami tidak akan pernah meninggalkanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Seseorang tolong buat dia diam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Ugh ... walaupun mereka semua orang jahat, tapi kelaparan bikin mereka kelihatan kasian banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "Kami tidak punya muka untuk mengakuinya ... tapi seperti yang kamu lihat, kami tidak mampu bertarung lagi. Yang kami inginkan hanyalah makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106217,
