			"dialogs": [
				{
					"id": 710620128,
					"content": "Terus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Kami akan pergi dan tidak akan pernah kembali. Aku berjanji padamu ... atas nama kehormatan Kompi Sembilan, atas nama leluhur kita yang membela tanah Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "*huff* Kasihan, sudah kelaparan, menyedihkan pula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Cukup. Lagi pula kamu tidak lebih baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Awalnya ada 64 orang saat kami tiba, 64 orang seluruhnya! Sekarang tinggal ada empat jiwa kelaparan yang tersisa. Memangnya kami bisa punya modus apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Wah! Tapi gimana kalian bisa jadi gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Itu bukan fokus pembicaraan kita sekarang ... Tanpa adanya makanan, keempat orang yang tersisa dari Kompi Sembilan bisa meninggal kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
