	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "*huff* Maaf mengganggu perjalanan kalian. Aku Anton Melnikov, Sersan Staf Sementara Kompi Sembilan. Panggil saja aku Anton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Perkenalkan, mereka Danila, Temur, Radomir ... dan, uh, Romanski. Dia tidak ada di sini ... Dia ada di ... kemah perawatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Romanski sudah tidak ada, kemah perawatan juga sudah tidak ada, Antoha. Dia ... tidak kuat bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, kan sudah berapa kali kubilang. Saat ini aku yang bertanggung jawab atas kompi. Panggil aku Sersan Anton!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Hah?! Bertanggung jawab atas kompi? Sersan Staf?! Memangnya kamu pikir siapa kamu? Sejak Kapten menghilang, kamu bertingkah sok penting sekali ya. Kamu kira lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Cukup, Temur ... Perutmu yang lapar pasti sudah membuatmu bingung. Tenangkan diri dan hematlah tenagamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Baik, \"Sersan Staf Sementara\" Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Sersan Staf Sementara, lucunya! Berapa lama kita harus menjalankan perintah dari Sersan Staf palsu yang bahkan tidak paham dengan apa yang dia lakukan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Hey, Temur, ternyata otak dan perutmu memang sama-sama kosong ya. Apa perlu kamu nikmati dulu beberapa tinjuan supaya kamu bisa sadar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Ayo kalau berani! Maju saja! Aku juga tertarik untuk membuat otakmu sadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Bagus! Sekarang sudah bukan waktunya lagi bicara tentang akal sehat dan kesabaran. Menarik sekali! Ayo kita habiskan sekalian sisa energi kita di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Ehem ...! Diam! Kamu ingin tetap bertempur, ya? Oke, kalau begitu kamu pergi saja ke sana dan lawan monster yang muncul dari lumpur hitam itu! Lawan mereka dengan perutmu yang keroncongan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Kalau kita masih mau hidup, dan bisa keluar dari sini dengan selamat, kita harus bersatu! Kurasa aku tidak perlu mengulang perkataanku, kan? Oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Satu, dua, TERIAK: \"KALAU BUKAN KITA, SIAPA LAGI YANG BISAAA?!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Kalau bukan kita, siapa lagi yang bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Kalau bukan kita, siapa lagi yang bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "Uh, hehe ... Teman, kamu pasti sadar kalau ... saat ini kami sedang tidak terlalu berapi-api untuk bertarung ... Lagi pula, kami juga sedang menghadapi sebuah masalah kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hmph ... \"masalah kecil!\" Gaya bicaramu sudah seperti Kapten saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Berhubung dia tidak ada di sini, aku yang menjadi Sersan Staf! Tutup saja mulut busukmu sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "Maaf, teman ... Kami sangat membutuhkan bantuanmu saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
