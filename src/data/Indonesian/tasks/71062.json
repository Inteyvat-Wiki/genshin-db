			},
			"dialogs": [
				{
					"id": 710621001,
					"content": "Bagaimanapun, terima kasih karena sudah memberikan kami makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "Kami akan mencari cara untuk keluar dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Kalian sudah kembali. Bagaimana? Ada kabar apa dari stasiun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "Stasiunnya sudah terbengkalai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Kalau begitu ... Terus, apa yang kalian temukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Kalian sudah tidak disambut lagi di Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Apa kamu punya berita lain selain ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Uh ... Ini ada surat yang kami temuin. Kayaknya sih ini surat buatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Para anggota Fatui tersebut membaca isi suratnya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, ini surat dari Yanbo. Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Apa yang terjadi? Para Millelith juga sudah pergi? Coba sini kubaca ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*huff* Ada apa dengan mereka! Kita bertarung demi mereka! Bukankah kita ini sekutu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Tidak ada istilah sekutu lagi. Tidak ada lagi kerja sama ... Sebenarnya sebagai anggota Fatui, kami tidak lagi menjalin hubungan kolaboratif dengan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Ini pengkhianatan! Orang-orang Liyue sudah mengkhianati kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Mungkinkah mereka justru berpikir sebaliknya? Mereka pikir kita si Fatui yang sudah mengkhianati mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Lelucon macam apa ini! Kita datang ke sini untuk melindungi orang-orang Liyue! Masih ingatkah dengan apa yang Kapten bilang sebelum keberangkatan? \"Ekspedisi ini tidak ada hubungannya dengan konspirasi dan intrik apa pun!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Tapi pada akhirnya itu tetap tidak bisa mencegah konspirasi dan intrik datang menimpa kita, kan? Ini bukan sesuatu yang bisa kita kendalikan, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "Oke, aku paham. *menghela napas* ... Aku sudah memutuskan — kita harus mundur, semakin cepat semakin baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Tidak apa-apa. Aku akan bertanggung jawab penuh. Kalau ada pembelot di antara kita ... Kalau ada pembelot yang menodai Kompi Sembilan, itu pastilah aku, tidak ada yang lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "Danila benar. Kita di sini untuk melindungi penduduk Liyue dari Bencana Hitam. Mana mungkin kita bisa pergi seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Apakah kamu pikir ini saat yang tepat untuk memikirkan gengsimu, Mirka? Semua ini masih belum jelas untukmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Apa kamu masih tidak paham kalau orang-orang Liyue tidak membutuhkan perlindungan kita, dan mereka pun tidak mengharapkan kehadiran kita! Mereka bahkan sudah mengalahkan rekan-rekan kita yang mengira dirinya tak terkalahkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Ya, kalian sudah mengkhianati kepercayaan rakyat Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Kita harus mundur dengan langkah yang sehalus-halusnya. Jangan sampai Millelith lokal tahu akan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Kapten bilang bahwa kita harus siap untuk mengabdikan hidup kita di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Dia juga bilang bahwa dia tidak akan membiarkan siapa pun mati sia-sia! Dan dia tidak ingin seluruh kompi terkubur di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "Setidaknya kita masih hidup. Setidaknya tidak semua Kompi Sembilan gugur. Kamu paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Ya, Pak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Baiklah, ada yang punya pertanyaan lagi? Aku tidak ingin mendengar keberatan. Bubar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#Bagaimanapun, terima kasih sudah menolong, {NICKNAME}! Ambillah Mora dan beberapa persediaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Lebih baik kalian pikirkan apa langkah kalian selanjutnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
