			"dialogs": [
				{
					"id": 710620202,
					"content": "Mohon pertimbangkan permintaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Ini makanan yang kalian mau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Mereka lemah banget ya. Baru satu dua serangan saja sudah kewalahan gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Cukup! Tolong hentikan! Berikan kami makanan dan kami akan menuruti apa pun yang kalian mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Hmm ... segitunya banget mereka haus akan makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Kasih tahu aku tujuanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Coba biar kujelaskan begini. Entah keraguan apa yang muncul di benak kalian, tapi satu-satunya tujuan kami di sini adalah untuk menyelidiki sumber bencana di Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "Bencana apaan? Paimon enggak lihat ada tanda-tanda bencana tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "Bencana yang terjadi lima ratus tahun lalu hanyalah permulaan. Perang melawan kegelapan tidak pernah berhenti dan saat ini kita sedang berdiri di salah satu medan perangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "*huff* Sersan Staf Sementara kita kelaparan sampai ngomong yang tidak-tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Dia memang suka bicara berlebihan sih, tapi baru kali ini dia bicara sesuatu yang tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Lupakan. Antoha ada benarnya juga ... Kalian orang Liyue bukanlah musuh kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "Setidaknya kalian bukanlah musuh kami ... Tapi aku tidak jamin bagaimana rekan-rekan kami yang hilang menganggap kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Baiklah ... aku akan membantu kalian, tapi jangan harap lain kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Bagaimana caranya aku percaya dengan kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*huff* Maaf, tapi ada ... masalah kecil ... dengan jaringan komando kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "\"Masalah kecil\"?! Kita sudah mengkhianati saudara-saudara kita di saat kita cuma berdiri saja di sini saat menyaksikan orang lain mengusir mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Terus apa yang mau kamu sarankan? Mengundang mereka dan membiarkannya merebut makanan kita? Lebih baik kamu jangan banyak bicara dan makan saja makananmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, jangan menggampangkan. Rantai komando kita sudah pupus. Sudah tamat. Kapten dan perwira berpangkat tinggi lainnya kalau tidak hilang, ya sudah mati ... kita tidak punya pilihan lain selain mundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Tapi banyak orang yang tidak mau mundur ... Mereka lebih memilih untuk menjaga relik para pejabat dan bertarung sampai gugurnya orang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Lebih tepatnya bertahan sampai kelaparannya orang terakhir ... Menurut perjanjian kerja sama, seharusnya atasan mengirimkan kami makanan dan memberikan perintah, tapi sudah lama waktu berlalu dan kami belum mendengar kabar apa pun dari atasan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Kami setia pada Fatui dan Lord Harbinger — dan memang seharusnya begitu — tapi kami tidak bodoh ... Orang mana pun yang punya akal sehat pasti akan menyarankan kami untuk mundur dalam keadaan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Jadi apa rencana kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Uh ... Aku sadar kalau ini bukan urusanmu. Dan aku tidak akan menghalang-halangimu kalaupun kamu memilih untuk pergi, tapi saat ini kami benar-benar sudah terperosok ke dalam jurang dan hanya bisa mengandalkan pertolonganmu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Aku minta waktu buat berpikir sebentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Yah ... berhati-hatilah selalu. Kawan-kawan lain kami yang masih ada tidak akan seramah kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "Sebenarnya ini adalah informasi rahasia ... Ada Stasiun Pengisian Energi di dekat permukaan tanah. Semua perbekalan untuk kami pasti akan melewati tempat itu, dan terkadang kami juga menerima perintah dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Kami sempat mengutus beberapa orang untuk meminta makanan ke sana, tapi mereka tidak kunjung kembali ... Aku tidak bisa mengambil risiko lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "Sudah lama tidak ada yang pernah turun dari Stasiun Pengisian Energi, tapi bagaimanapun ... Aku harap kamu bisa menggantikanku untuk memeriksa situasi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Coba kupertimbangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Aku jadi merasa tidak enak sudah merepotkanmu begini, tapi aku perlu tahu dengan apa yang terjadi di lapangan ... Kalau tidak, itu artinya sama saja dengan aku membuat keputusan yang gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "Sudah, sudah! Omonganmu ini bikin pusing kepala Paimon saja! Sudah, nanti kalau kami lewat sana juga bakal kami awasi kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Jadi kamu perlu aku membantu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
