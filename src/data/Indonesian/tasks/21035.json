				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "Waduh, susah juga ya ternyata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350202,
					"content": "Maaf, aku konyol sekali tadi. Aku tidak sangka akan gugup dan tegang saat bertarung sungguhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350203,
					"content": "Intinya, aku masih harus banyak berlatih. Pengembara, terima kasih. Ini imbalan untukmu, mohon diterima ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350204,
					"content": "Kamu benar mau pergi dari Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "Aku belum terlalu yakin, masih harus dipikirkan lagi. Selain itu, aku masih ingin coba membujuk Que'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		}
	]
}