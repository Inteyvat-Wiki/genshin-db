			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "Ahh, Que'er ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "Pengembara? Kebetulan sekali! Tidak kusangka bisa bertemu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "Aku ... sedang latihan di sini. Aku mau pergi dari Liyue, berkelana ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "Kok tiba-tiba mau pergi dari Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "Yah, ini sedikit memalukan ... dari dulu aku terus bahas soal membangkitkan Klan Guhua, tapi selama ini ... aku mau \"mencari panduan dari para Adeptus\", tapi akhirnya aku cuma bengong saja di Jueyun Karst ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "Meskipun aku bersyukur ada Que'er yang menemani, dalam hati aku tahu kalau yang kulakukan itu tidak berguna untuk kebangkitan Klan Guhua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "Beberapa waktu lalu, aku sedang belanja di kota lalu tidak sengaja mendengar pembicaraan seorang pedagang Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "Dia bilang, \"Kamu tidak bisa menemukan solusi sebuah masalah di tempat kejadiannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "Aku memikirkan kata-kata ini lama sekali. Mungkin ... pedagang Fontaine ini menyarankanku untuk pergi ke luar Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "Bepergian memang bisa menambah wawasan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "Aku pikir juga begitu! Tapi ... Que'er tidak mau pergi dari Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "Biasanya kalau dia marah-marah, aku tahu dia cuma merajuk. Dimanja dan dibujuk sebentar juga reda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "Tapi kali ini dia benar-benar marah besar. Dia tidak mau dengar kata-kataku sama sekali, dia bahkan pulang ke kota sendirian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "Tapi kamu tidak usah ambil pusing dengan hal-hal tidak penting begini. Pengembara, aku mau minta tolong, boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "Meskipun aku belajar ilmu bela diri, tapi aku belum pernah ada kesempatan untuk praktik. Kalau aku pergi ke daerah lain, cepat atau lambat aku akan menghadapi konflik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "Pengembara, aku sudah sering dengar tentang ceritamu bertualang ke seluruh penjuru dunia, kamu pasti jago sekali menghadapi monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "Mau tidak temani aku cari monster untuk dilawan? Sekalian ajari aku satu dua hal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Di dekat sini ada tempat berkumpul para monster. Ayo, kita ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "Aku takut jurusku terlalu cepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "I-Ilmu bela dirimu setinggi itu ya? Hahaha, kalau begitu, mohon gerakannya diperlambat, sedikit saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "Dan juga bisa untuk mengalihkan beban pikiran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "Bukannya kamu mau membangkitkan Klan Guhua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "Lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
