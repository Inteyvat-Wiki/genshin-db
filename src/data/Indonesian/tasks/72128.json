					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Maaf, setiap kali kamu hanya bisa memilih satu kotak harta karun untuk dibuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Oke, cepat pilih satu kotak untuk dibuka. Hehe, semoga kamu beruntung.",
