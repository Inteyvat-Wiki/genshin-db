				},
				{
					"id": 721280502,
					"content": "Apa kamu sedang mengumpulkan keong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Penglihatanmu benar-benar tajam. Ya, aku mengoleksi keong jenis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Tapi aku tidak bisa memberi tahumu alasanku mengumpulkan keong-keong ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "Apa ada sesuatu yang istimewa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "Dari sudut pandang berbisnis, tentu saja ada sesuatu yang istimewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "\"Keong yang pernah kena energi Tatarigami\"... Hahaha, pasti bisa dijual dengan harga tinggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "Ehem! Ngomong-ngomong, kalau kamu memberikan keong itu kepadaku, kamu bisa membuka kotak harta lho. Apa kamu sudah tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "Oke, kesempatan kali ini sudah terpakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Kalau mau membuka kotak harta lagi, datang lagi sambil bawa keongnya setelah beberapa waktu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "Sangat mencurigakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
