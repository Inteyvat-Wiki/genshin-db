			"dialogs": [
				{
					"id": 721280102,
					"content": "Eh, tunggu sebentar. Kotak-kotak ini tidak bisa dibuka sesuka hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "Kotak ini punyamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Tentu saja, kotak-kotak ini sengaja aku letakkan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "Di dalamnya ada semua jenis harta yang aku kumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "Kalau kamu mau membuka kotak harta itu, bisa saja. Tapi... kamu juga harus memberikan sesuatu untukku sebagai gantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "Kamu mau Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Hahaha, tidak perlu Mora juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "Barang yang aku mau itu semacam \"keong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "Kamu pasti sering menemukan berbagai macam keong di sekitar pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "Kalau kamu mau membuka kotak harta dan mengambil harta karun di dalamnya, kamu bisa memberikan keong sebagai gantinya untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "Tapi... aku tidak akan memberi tahumu apa yang ada di dalam kotak harta ini atau harta apa yang bisa kamu dapatkan. Hal itu tergantung keberuntunganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "Bagaimana? Kalau kamu mau membuka kotak harta, kamu bisa memberikan keong sebagai gantinya untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "Kamu mau barang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "Di dalamnya ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
