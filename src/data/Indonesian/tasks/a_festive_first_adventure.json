			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Kok tidak ada orang yang datang ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "Pengembara! De-dengarkan aku sebentar... Sekarang ini sedang ada Festival Lantern Rite kan? Adventurers' Guild ingin memanfaatkan kesempatan ini untuk mencari anggota baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "Lalu kudengar kalau kak Qian membuat sebuah permainan baru... Aku lupa namanya, tapi aku tidak mau ketinggalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "Jadi aku memikirkan sebuah aktivitas baru, namanya \"Pengalaman Pertama Bertualang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "Sederhananya, aku akan menandai beberapa Lentera Xiao kemudian menerbangkannya hingga membentuk sebuah jalur di atas langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Kemudian orang-orang yang ingin mencobanya bisa langsung menggunakan Wind Glider mereka dan terbang mengikuti jalur Lentera Xiao tersebut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "Dengan begini orang-orang bisa merasakan petualangan yang mendebarkan sambil melihat keindahan alam Liyue ditemani Lentera Xiao. Sangat menarik kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "Awalnya aku sudah merancang dua jalur terbang. Tapi saat aku sedang menyiapkannya bersama dengan Millelith, mereka bilang jalur-jalur ini harus dicek dulu keamanannya. Jadi harus ada yang melakukan uji coba dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "Kamu pasti sudah sangat berpengalaman kan? Ka-kalau boleh... Bisakah kamu membantuku mengujinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Terima kasih banyak! Kalau begitu ayo kita berangkat ke Mt. Tianheng. Jalur pertamaku akan dimulai dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
