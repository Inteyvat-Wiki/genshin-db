			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Sudah sampai di garis finish! Kamu sangat pandai terbang ya... Bagaimana jalur ini menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "Sangat cocok dengan festival ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Hehehe, tentu saja! Semua ini kuhias dengan spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Kalau begitu, ayo kita pergi ke jalur selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "Lenteranya sangat indah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
