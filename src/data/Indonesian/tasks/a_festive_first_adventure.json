					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Baguslah kalau begitu. Dengan begini aku sudah bisa melaporkannya kepada Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380504,
					"content": "Dengan adanya acara seseru ini, pasti ada banyak orang yang akan bergabung ke Adventurers' Guild deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380505,
					"content": "Oh iya, ini hadiah karena telah membantuku menguji coba, terima kasih ya.",
