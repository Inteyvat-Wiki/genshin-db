			"dialogs": [
				{
					"id": 413380201,
					"content": "Ini dia titik mulainya. Lihat deh, bahkan sudah kuhiasi dengan Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "Baiklah. Silakan dimulai saja kalau sudah siap. Coba terbang ke garis finish sambil mengumpulkan semua Lentera Xiao yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
