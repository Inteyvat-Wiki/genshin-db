			"dialogs": [
				{
					"id": 711149940,
					"content": "Setelah mengusir semua Treasure Hoarder, kalian membawa orang yang dikepung Treasure Hoarder ke paviliun untuk beristirahat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Terima kasih, terima banyak ya. Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140802,
					"content": "Kamu ... Nona Qiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#An-Anda kan {NICKNAME}! Tak kusangka bisa bertemu lagi dengan Anda. Ini ... sudah kedua kalinya aku berutang besar pada Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140804,
					"content": "Bukannya kalian lagi belajar cara syuting film di Fontaine? Kok tiba-tiba balik ke Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Belajarnya sudah selesai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Daripada dibilang sudah belajar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Lebih tepatnya kami terpaksa \"cari uang dulu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Kalian berdua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140809,
					"content": "Tuan Geisert memang profesional sekali, berbagai macam panduan yang dia berikan pada kami juga berguna sekali. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "Film kami yang dia pandu terlalu fokus untuk mengekspresikan arti dan konsep, sedangkan untuk hal yang spesifik dan plot ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "Kalau menurut kata-katanya Tuan Geisert, \"Plot dan lainnya itu urusan belakang layar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Tapi, yang mau kami buat itu film untuk mempromosikan daun teh Desa Qiaoying. Kalau terus belajar seperti ini, benar-benar berbeda dengan tujuan kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Jadi! Aku putuskan untuk berhenti belajar, lalu kembali dulu untuk syuting sebagian film dokumenter dan menggunakannya sebagai praktik untuk mempraktikkan hasil belajar kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140814,
					"content": "Dan alasan lainnya juga, karena dana kami hampir habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "A-Aku sudah ceritakan soal rencanaku, kan? Asalkan film dokumenter ini sukses besar, nanti uang \"investasi\" kita bakal langsung balik deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140816,
					"content": "#Lalu singkat cerita, kami dicegat sama Treasure Hoarder di jembatan gantung, tapi untung ada {NICKNAME} yang membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Bukannya ... tempat ini agak jauh dari Desa Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Lah, kalau mau foto-foto Desa Qiaoying kenapa malah ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "Duh, itu kan karena aku mau ambil pemandangan yang indah dan masukkan ke dalam film supaya kelihatan lebih keren ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140820,
					"content": "Karena terlalu fokus syuting, siapa sangka kami malah menarik perhatian Treasure Hoarder. Kami lari sampai ke sini, tapi mereka tetap bisa mencegat kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140821,
					"content": "Eh, sebentar. Jangan-jangan tukang foto profesional yang diungkit Nona Woliu kemarin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Benar, maksudku ya Nona Qiu dan kawan-kawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "Nona Woliu, ka-kamu muncul dari mana? Aku bahkan tidak lihat kamu tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140824,
					"content": "Karena aku bakat bersembunyi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Ternyata kalian saling kenal ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Yah, karena Nona Woliu itu peneliti hidrologi profesional yang sudah paham sekali dengan medan di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140827,
					"content": "Kami juga sudah konsultasi dengannya berkali-kali soal pemilihan tempat wisata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140828,
					"content": "Kami bahkan mengundang Nona Woliu bergabung dengan tim film kami loh! Tapi, dia bilang baru akan pertimbangkan kalau sudah punya waktu luang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140829,
					"content": "Bos, anu ... waktu kita lari tadi, sepertinya kotak kita yang isinya film dan peralatan ketinggalan di sana deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Kayaknya di dalamnya ... masih ada sebagian film yang kita rekam deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140832,
					"content": "#Nona Woliu! {NICKNAME}, Paimon, terima kasih banyak ya! Ka ... Kalau ada waktu, datanglah ke Desa Qiaoying dan cari aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140833,
					"content": "Bagaimanapun juga ... aku harus siapkan sedikit imbalan atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140834,
					"content": "Kami pamit dulu ya! Cepat, cepat! Di mana kotaknya? Ayo cepat cari, cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140835,
					"content": "Nona Qiu dan kawan-kawannya pun buru-buru pergi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Kayaknya ... kotak Nona Qiu itu sudah melewati banyak cobaan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Seperti kata pepatah \"bersakit-sakit dahulu, bersenang-senang kemudian\". Film buatan Nona Qiu pasti bakal sukses deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "Ya sudah, aku berikan imbalannya dulu. Nanti habis aku pasang peralatan yang terakhir ... aku juga akan cari waktu untuk ngobrol sama Nona Qiu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Kalau tidak, mereka tidak akan tahu harus ke mana untuk syuting film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Umm, tadi mereka bilang aku bisa pergi ke Desa Qiaoying untuk cari mereka, kan? Nanti aku pergi cari mereka ke sana dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
