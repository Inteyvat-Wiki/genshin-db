						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "Penyesuaiannya harusnya bisa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Pengembara, kalian sudah selesai pasang peralatannya? Terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Tunggu aku selesai pasang yang ini ya, nanti kuberikan imbalan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Mending tadi langsung suruh aku pasang semuanya saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Terima kasih atas tawaranmu. Tapi, peralatan ini lumayan spesial dan bagian yang perlu diatur cukup banyak. Jadi aku tidak mau terlalu merepotkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Kita pergi ke jurang di sebelah sana dulu untuk memasang peralatan ini, lalu aku bisa berikan imbalan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Kedengarannya rumit banget ya ... Kamu selalu kerja kayak gini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Haha, sekarang ini aku cuma perlu memasang peralatannya di atas tanah ... Pernah suatu kali saat melakukan peninjauan, aku harus cari cara untuk memasang peralatannya di dasar tengah-tengah sungai yang deras ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Memangnya tidak bisa langsung naik perahu ke sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Yah, kalau cuma tenggelamkan peralatan di dalam sungai, tentu saja aku bisa naik kapal, kemudian ke sana untuk melemparkannya ke dalam air. Lalu, pergi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Tapi waktu itu aku harus mengukur kekuatan arus air. Jadi, aku perlu membuat peralatan khusus yang bisa diam di tengah arusnya, tidak boleh mengapung ke atas dan juga tidak boleh tenggelam ke dasar air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Untungnya ada jembatan gantung di sungai itu. Kalau tidak ada jembatan gantung, aku terpaksa minta orang memasang tali di antara dua gunung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Jadi peralatannya digantung menggunakan tali, lalu menariknya dengan tali lain, baru diturunkan hingga ke tengah arus sungai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Ehem ... kita tidak usah bicarakan ini dulu. Sekarang kita juga tidak perlu menghadapi situasi ini ... Meski nanti kita juga akan melewati jembatan gantung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Ke sini. Jembatan gantungnya sudah dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
