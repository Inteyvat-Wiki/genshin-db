			},
			"dialogs": [
				{
					"id": 711140901,
					"content": "Duh, mending kita syuting di Desa Qiaoying saja deh dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140902,
					"content": "Semuanya baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#{NICKNAME}, Paimon, aduh! Berkat kalian, peralatan dan filmnya sama sekali tidak ada yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140905,
					"content": "Tapi, kami masih tetap mau ke sana untuk ambil gambar sih. Kayaknya kami harus rekrut petualang untuk temani kami deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140906,
					"content": "Jadi, gimana syuting film kalian tentang teh itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Hmm ... film ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140908,
					"content": "Punya adegan pembuka yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Dan punya prospek yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Maksudnya ... kalian belum syuting apa-apa ya?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "Aduh, dana kami saat ini ... agak mepet. Biaya Tuan Geisert setinggi pengetahuannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140912,
					"content": "Meski kami juga sudah buat beberapa film kecil dan menghasilkan sedikit uang, tapi untuk membuat film dokumenter skala besar begini, benar-benar harus bakar banyak uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140913,
					"content": "Terutama karena Bos juga menolak pedagang-pedagang yang mau jadi sponsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Dia juga menolak banyak undangan kerja sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Kalian itu tahu apa! Ini semua supaya kita bisa syuting film sempurna yang sesuai standar dan visi kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140916,
					"content": "Tapi, Bos, bukannya tujuan awal kita buat film itu demi cuan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Aku ... Po-Pokoknya jangan pikirkan masalah ini dulu deh. Pasang peralatannya saja sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, imbalan ini untukmu. Terima kasih sudah tolong aku berkali-kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140919,
					"content": "Nanti setelah filmku selesai, aku pasti akan undang kamu untuk nonton, terus undang kamu untuk minum teh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, cari sudut pencahayaan yang bagus! Kali ini kita harus selesaikan dalam satu kali syuting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140921,
					"content": "Bos, ini kan juga bukan adegan perkelahian yang pakai orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Kalau adegan pemandangan, mau syuting sekali atau berkali-kali kan ... sesuai keberuntungan saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "In-Iintinya siapkan dulu peralatannya! Tu ... Tunggu dulu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 711140903,
					"content": "Setidaknya peralatan kalian enggak hilang, kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
