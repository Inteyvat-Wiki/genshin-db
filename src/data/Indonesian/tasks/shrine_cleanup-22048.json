			"dialogs": [
				{
					"id": 220480101,
					"content": "Kuilnya jadi berantakan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Miaw, ternyata kamu. Selamat datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480104,
					"content": "Ah, sekeliling kuilnya jadi berantakan lagi. Tidak enak dilihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480105,
					"content": "Kalau begini, kita tidak bisa menyambut manusia yang datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480106,
					"content": "Apakah kamu bisa membantu diriku membersihkan kuilnya lagi, seperti waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480107,
					"content": "Bukannya kamu punya Taisuke dan Etsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "Diriku... tidak akan memulai pembicaraan dengan dua manusia hijau itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480109,
					"content": "Manusia yang tinggi itu selalu melihat diriku dengan tatapan yang aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480110,
					"content": "Dan manusia hijau satu lagi terlihat sangat... lemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480111,
					"content": "Miaw miaw, pokoknya mereka berdua tidak bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480115,
					"content": "Pokoknya, tugas yang satu ini cuma bisa mengandalkanmu saja. Pakai saja tongkat panjang itu untuk membersihkan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480116,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Pokoknya kuserahkan padamu ya. Diriku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480119,
					"content": "Diriku akan menunggumu di sini, miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480117,
					"content": "Aku sudah tahu, kira-kira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Kamu bisa minta tolong Tuan Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "Manusia batu ini selalu sibuk mengetuk sana sini. Entah apa yang sedang dia ketuk-ketuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480114,
					"content": "Jelas-jelas batunya sudah selesai diketuk. Tidak tahu dia sedang mengetuk apa lagi sekarang... Merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				}
			]
		},
