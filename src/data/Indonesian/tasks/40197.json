			"dialogs": [
				{
					"id": 401970201,
					"content": "Wah? <color=#C4D6EAFF>Putih oke ya, putih</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Rasa krim? Tradisional, tapi lezat banget. Oke deh, ACC.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Oke, sekarang {NICKNAME} sudah jadi pemilik suvenir peta. Gambarin sana kumis rasa apa saja sampai puas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hehe, petanya \"enak\" ya. Kami bakal jaga baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Bagus! Kepuasan pelanggan adalah prioritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Beres semua, sekarang tinggal nyantai. Lupain kerjaan, nikmatin taman bermainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
