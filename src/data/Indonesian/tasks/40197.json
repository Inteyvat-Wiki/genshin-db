			"dialogs": [
				{
					"id": 401970101,
					"content": "Sekarang setelah sudah sampai begini, kita harus menambahkan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Secubit garam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Secubit merica, sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Ah, brilian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Kalian lagi meneliti apa? Makanan pencuci mulut yang baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Lada sepertinya kurang cocok untuk pencuci mulut ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Bukan makanan pencuci mulut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "Kami sedang membicarakan naskahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Heh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "Partner, fotografer, sutradara pemula kesayanganku! Kreativitas kita harus bisa mengimbangi luapan antusiasme penggemar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Tidak ada tempat untuk naskah membosankan di panggung! Terus, kejutan dalam cerita harus bisa menghantam penonton seperti semburan merica! Bikin semuanya kaget sampai bersin! Ha-CHIU!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "Di dapur juga logikanya sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "Aku pernah dengar Nona Emilie mau pakai merica buat parfum. Mungkin aku bisa coba kreasikan makanan penutup pakai bahan itu juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hmm ... lada untuk melengkapi manisnya krim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Wah, dua orang itu kompak banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Paimon enggak kebayang sih kue lada merica tuh kayak apa rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Wah, wah, Escoffier mau bikin kue baru lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Iya, pakai merica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Wah, menarik tuh! Kalau sudah jadi, aku mau icip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "Ini Paimon doang, atau memang semua orang kayak jadi lebih antusias setelah kerjaannya kelar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "Ya kenapa enggak boleh? Setelah kerja keras membuahkan hasil ... harus dirayakan dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "Kayak Macaron yang baru matang ... tambahin saja segala macam buat isinya! Jangan takut kemanisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "Macaron! Kapan lagi dibolehin kasih gula sebanyak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Kasih gula sebanyak itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Kasih gula sebanyak itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970127,
					"content": "Eh, kenapa kita kasih gula sebanyak itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lepine-Pauline, kamu datang! Sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Tentunya! Sesuai rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Hm? Kamu tadi ngerjain tugas penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "Betul sekali! Mohon diterima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970132,
					"content": "Apaan nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Wuah! Ini foto panoramik, taman bermainnya kena, ada ilustrasi semua orang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hehe, karena Film Fantasyland ini sukses besar, sengaja nih bikin suvenir unik buat kenang-kenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Kita bikin taman bermain ini sama-sama, satu bata demi satu bata. Jadi ya, semua mau andil bikin peta juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Jujur sih, yang paling berjasa di sini tuh Nona Lepine Pauline, kan dia yang jago gambar. Tapi ya kami semua juga ikutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Benar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#Selain itu, {NICKNAME} dapat hak paling istimewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "Kamu boleh kasih kumis di potretku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
