			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Lyylikki, bagaimana kabarmu akhir-akhir ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Ah! Halo Nona Lauma, akhir-akhir ini semuanya lancar sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "Pasokan bahan masakan tidak pernah terputus, tidak ada yang membuat masalah, dan aku sudah makin mahir masak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Oh iya, \"teman\" yang Anda sebutkan sebelumnya... maksudnya hewan-hewan kecil ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Mereka nurut sekali, setiap hari sigap mengawasi orang-orang yang antri makan. Aku tawarin mereka makanan, tapi tidak ada yang mau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Mereka semua tahu bertanggung jawab. Saat bertugas, mereka akan diam di posisi dan fokus pada pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Tapi jika tugas sudah selesai, boleh kalau kamu ingin memanjakan mereka. Hehe, aku yakin mereka akan sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Oke! Kalau gitu hari in aku akan masak enak buat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Terima kasih atas kerja kerasmu, Lyylikki. Cari saja aku kalau kamu butuh bantuan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Tidak usah repot! Masih aman kok. Ada Tuan Kantor dan Nona Jahoda juga yang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Kalau begitu aku tidak ganggu lagi. Sampai jumpa, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Ah, aku sudah harus keluarin makanan lagi ... Oh, Nona Lauma? Mau coba yang ini? Baru matang loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Baiklah, sekarang waktunya penyajian ... Wah? Ke mana piringnya? Baru juga dicuci ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}