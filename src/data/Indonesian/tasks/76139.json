			"dialogs": [
				{
					"id": 761390101,
					"content": "Belakangan ini industri penerbitan sepi sekali. Mungkin sebaiknya aku fokus pada investasi saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Aku mau lihat kupon investasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Silakan, ini 2.000 Mora per kupon, jatuh tempo setiap minggu. Nah, silakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "Ugh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "Ti-Tidak apa-apa. Aku cuma tidak menyangka Bos Nefer akan datang. Bos ... juga mau beli kupon investasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "Oh, tidak. Aku cuma menemani temanku yang satu ini jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Kudengar bisnis investasimu berkembang pesat, Tuan Dhabit. Setelah melihatnya sendiri, ternyata memang benar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Oh, biasa saja kok, hahaha ... cuma demi sesuap nasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Memangnya yang ginian bisa jadi duit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Tentu saja bisa. Tuan Dhabit adalah pebisnis yang sangat andal. Ikuti petunjuk darinya, dan kamu tidak akan rugi. Betul, Tuan Dhabit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Be-Benar ... Ahahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Kalau gitu lihat deh gimana hokinya hari ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "Ha-Hari ini? Kebetulan ... kebetulan sekali! Yang baru saja kamu beli adalah ... investasi jangka pendek! Hasil dan kerugiannya bisa langsung dihitung dan dicairkan saat ini juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Mengarang indah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Uh ... jangan dipikirkan. Intinya, terima kasih sudah membeli kupon investasi jangka pendek dari kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Ini pengembalian investasinya, semoga harimu menyenangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Ya ... baguslah kalau bisa untung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Serius? Hehehe, beliin yang bentuknya kayak burung dong! Itu kesukaan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Kalau begitu, aku juga harus pergi dulu. Tuan Dhabit memang luar biasa sekali, jujur dan amanah. Sukses selalu usahanya.",
					"roleType": "TALK_ROLE_NPC",
