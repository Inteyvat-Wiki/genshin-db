			"dialogs": [
				{
					"id": 756600101,
					"content": "*huff* Cuacanya bagus. Cocok sekali buat jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "Hmm? Wah, wah, wah, ada \"Tu{RUBY#[D]Harapan}maini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Kebetulan sekali, Xilonen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Kamu memberi tahu Xilonen tentang ujian Irade ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ah, begitu ya ... Aku hampir lupa tadi ada bantu dia. Tempat ujian suku kami kebetulan ada di dekat sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "Awalnya cuma \"Si Bencana Tetlahuitl\" Nkunga, dan \"Belati Pasir Seit'aad\" Amuru yang bantu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Tapi mereka berdua kurang tertarik sama \"fleksibilitas\", senangnya langsung main bentrok, jadi hasilnya juga jadi tidak seimbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "Setelah Pacal dengar soal ini, dia langsung minta saranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Jadi tempat ujian yang sekarang itu hasil kerjaanmu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Kira-kira lah. Pacal, Irade, dan aku utak-atik sedikit setelah diskusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Sekarang ujiannya lebih ke menguji siapa yang mampu mengamankan posisi menguntungkan dan bergerak dengan cerdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Aku mau ikut ujiannya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Semua orang di Natlan sudah tahu kehebatanmu, aku ragu ada tantangan yang tidak bisa kamu hadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Ujiannya ada di sebelah sana, dicoba saja kalau tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Semoga enggak sulit-sulit amat ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "Kamu benaran bisa buat apa saja ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Perangkatnya sederhana saja kok. Gampang dibuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Latih pejuang suku jadi lebih kuat untuk ke depannya hanya dengan satu kali usaha? Bagus dong, nanti aku bisa punya lebih banyak waktu luang untuk selesaikan pesanan lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Aku lagi jalanin misinya Irade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}