			"dialogs": [
				{
					"id": 708140401,
					"content": "Apakah semua petualang melakukan hal-hal berbahaya seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140402,
					"content": "Tapi bagaimana jika mereka terluka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
