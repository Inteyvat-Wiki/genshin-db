				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Eh? Kamu sudah kembali? Apakah kamu sudah menyelesaikan misinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Kamu hebat sekali... Aku kembali ke Adventurers' Guild untuk mengatur kembali misi kita berdasarkan yang kuberikan kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Ada banyak sekali misi seperti membasmi monster, jadi petualang seharusnya melakukan hal semacam ini ya sepanjang waktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "Tapi selain tentang monster, ada laporan tentang banyaknya Treasure Hoarder yang terlihat di sepanjang jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Apakah ini benar-benar juga sesuatu yang harus ditangani oleh Adventurers' Guild? Rasanya lebih seperti tanggung jawabnya Millelith...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Kami bisa menanganinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Begitu ya, para petualang benar-benar dapat melakukan apa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Kalau begitu, aku akan menyiapkan imbalan yang memadai untukmu — jadi silakan ambil misi ini juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Apa? Sudah ada misi yang lain? Kami belum mendapatkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "Akan ada lebih banyak imbalan! Aku sudah mendiskusikan ini dengan Lan. Jadi selama kamu bisa menyelesaikan misi berikutnya, akan ada lebih banyak imbalan yang menantimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Aku serahkan tugas ini padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Kali ini, dua imbalan akan dikeluarkan sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "Metode rahasia yang diajarkan Lan kepadaku \"Rahasia untuk membuat para petualang menerima misi dengan patuh\" sangat berguna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Asalkan imbalannya menarik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Petualang benar-benar mengesankan... Sepertinya segala hal dapat dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
