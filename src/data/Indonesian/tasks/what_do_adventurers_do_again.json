					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "Apa ada yang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Apakah kamu menemukan pedangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "Kamu masih ingat saja... sayangnya, masih belum ada petunjuk apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Sepertinya aku masih di titik awal, menunggu hal-hal untuk terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Jika ada misi yang bersangkutan lagi, aku mungkin akan mencarimu — Ketika itu terjadi, aku akan mengandalkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081401",
							"2"
						],
						"stepId": 7081401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "A—Apakah kamu seorang petualang? Apakah kamu ke sini untuk menerima misi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "T—Tolong... tunggu sebentar, biarkan aku mencarikannya untukmu... \"Speed Glider\", \"Panduan Bertahan Hidup di Alam Liar\" terus \"Pelatihan Pendakian Bebas\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Semuanya tidak terdengar seperti Adventurers' Guild...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Aku tahu, dan Lan juga mengatakan hal yang sama, tetapi bukankah semua \"petualangan\" dalam buku seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Kalau aku tidak memberikan misi ini, apa yang harus kuberikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Misalnya, sesuatu seperti membasmi monster...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "B—Bukankah itu berbahaya? Maksudku, memang sih ada banyak monster di sekitar Lisha, dan mereka adalah ancaman bagi orang yang lewat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Tapi kebanyakan orang biasa pasti tidak bisa melawannya. Mereka bahkan mungkin terluka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Bisakah kamu melakukannya? Kalau begitu... kuserahkan padamu. Aku akan mendiskusikannya dengan Lan dan memberikan imbalan yang sesuai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Petualang bukanlah orang biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Begitukah... K—Kalau begitu, aku akan membiarkanmu menanganinya. Aku akan mendiskusikan pembayaranmu dengan Lan nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
