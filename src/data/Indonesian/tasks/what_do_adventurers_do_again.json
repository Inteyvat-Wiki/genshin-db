			"dialogs": [
				{
					"id": 708140701,
					"content": "Kamu sudah menyelesaikan misinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Wow... jadi ini kemampuan dari petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Kalau kamu tidak keberatan, dapatkah kamu menjawab beberapa pertanyaanku tentang para petualang dan misi-misinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "Selain mengalahkan monster, misi lain apa yang diambil petualang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "Kami membantu orang memperbaiki gerobak dan rumah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Wow, bukankah ini berarti petualang bisa melakukan segalanya? Aku baru tahu ternyata pekerjaan petualang sangat fleksibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Terima kasih! Aku akan mengingatnya... Oh iya, ini imbalan untukmu, silakan diambil, kami sudah sangat bermurah hati loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "Lain kali kamu ke sini untuk mengambil misi dariku, aku pasti akan memberikan yang terbaik untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "Kami juga membantu orang memetik bunga dan menangkap ikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "Kami juga akan mengantarkan makanan dan bermain dengan anak-anak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
	]
