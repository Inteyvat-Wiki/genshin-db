			"dialogs": [
				{
					"id": 752380201,
					"content": "Hmph ... Tunggu saja sampai aku ketemu dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380204,
					"content": "Sudah selarut ini? Baiklah, Nona Guillotin, hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
