			"dialogs": [
				{
					"id": 752380101,
					"content": "Tehnya sesuai seleramu tidak? Atau lebih suka sesuatu yang lebih kuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380102,
					"content": "Teh saja sudah cukup. Aku merasa bersalah kalau minum alkohol di siang hari, lebih baik jangan sering-sering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Ngomong-ngomong, Nona Guillotin, ada urusan apa kamu jauh-jauh ke Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Aku hanya sedang jalan-jalan dan mengunjungi kenalan lama. Lagi pula, aku ingin mengucapkan terima kasih untuk bantuanmu selama Festival Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380105,
					"content": "Kamu terlalu sungkan. Apa kamu datang jauh-jauh begini hanya untuk itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Selain itu, meski kamu tidak mengungkitnya sebelumnya, aku tahu aku pernah membuat masalah untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380107,
					"content": "Ah ... Masalah dengan bawahanmu itu ya? Insiden yang melibatkan Ineffa si robot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Heh ... hidup itu lucu ya? Kamu bisa tiba-tiba menjadi teman dengan bos dari mantan musuhmu ... Bahkan jadi bosmu sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Kuharap kamu mau menerima ini sebagai permintaan maaf dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380110,
					"content": "I-Ini ... Ini edisi terbatas ... Bukan, edisi kolektor?! Dan ini genre favoritku?! Kok kamu bisa tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#Aku minta saran dari {NICKNAME}. Dia tahu selera bukumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Aduh ...! Kenapa perasaanku jadi campur aduk begini??! Aku senang, tapi juga malu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "(Tentu saja aku senang dia tahu seleraku, tapi apa harus bilang terang-terangan begitu? Aku malah lebih berharap dia sendiri yang kasih aku hadiahnya!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Kamu suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380116,
					"content": "Ah ... Te-Terima kasih! Kamu terlalu baik, Nona Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Kalau cocok, lain kali aku akan bawa lebih banyak untukmu. Tentu saja, aku akan minta {NICKNAME} ikut memilihnya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380118,
					"content": "... Denganmu?! Maksudnya ... Kalian pergi ke toko buku sama-sama untuk bisa dapat buku ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "Iya. Dia benar-benar berusaha memilih yang terbaik. Mungkin lain kali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380120,
					"content": "... Jangan sampai ada lain kali!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Oh ... A-Aku ... Uhm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
