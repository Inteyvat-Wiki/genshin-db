			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "Setelah itu, aku langsung bawa mereka kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "Mondstadt menyambut kalian, pengembara yang mengikuti angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Namaku Jean, Grand Master Knights of Favonius. Dia Lisa, pustakawan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "Oh! Anak-anak manis, kalian ke sini untuk bantu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "Kalian imut sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Sayangnya, waktu kalian kurang tepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Stormterror yang kembali aktif baru-baru ini telah mengakibatkan cukup banyak permasalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Sederhananya, sekarang aliran elemen dan Ley Line di Mondstadt jadi seperti bola benang yang diacak-acak kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Bagi seorang mage, situasi ini teramat parah. Kulit dan suasana hatiku mau pecah rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Kalau bukan karena gangguan ini, Knights of Favonius pasti bisa bantu kamu lebih dari sekadar pasang poster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "#Silakan istirahatlah di Mondstadt. Kami akan membantumu menemukan {F#kakakmu}{M#adikmu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Aku sebaiknya ikut bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Paimon juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Bagus. Sekarang kita perlu rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Stormterror menyerang Mondstadt langsung. Mungkin ini kesempatan kita untuk langsung urus sumber masalahnya..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Lisa sudah berhasil menemukan sumber kekuatan Stormterror, berkat sihirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Sumbernya berasal ada di reruntuhan <color=#00E1FFFF>Kuil Four Winds</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "Stormterror bisa menciptakan badai sekencang ini, karena mengambil kekuatan reruntuhan kuil-kuil tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Maka target kita saat ini adalah, urus <color=#00E1FFFF>tiga</color> dari empat kuil yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Aku yakin kalian sudah tahu kenapa kita hanya tiga kuil saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Paimon enggak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Mungkin cuma orang sini saja yang tahu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Knights of Favonius, kita berpacu dengan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "Badainya semakin ganas. Terus bertahan tidak ada gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Kita harus gerak cepat, ke <color=#00E1FFFF>reruntuhan</color> <color=#00E1FFFF>kuil-kuil itu</color> sebelum situasinya semakin parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Kita tanya nanti saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Baiklah, kalau begitu tolong ya. Penginapannya di sebelah mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Woi! Jangan malas gitu dong! Mending kita ikut bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}