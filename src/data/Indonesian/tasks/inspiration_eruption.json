			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "Tipe permainan seperti ini menginspirasi juga ya, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "Permainan baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "Pengembara! Pas banget! Aku butuh orang nih buat tes permainan baruku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Nih lihat. Namanya permainan \"Letupan Inspirasi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "Benar-benar bisa menangkap keseluruhan proses bagaimana para penyair menciptakan puisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "Maksudnya minum, minum, dan minum lagi, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Coba cerahkan aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Hahaha, kocak. Memang sih minum anggur bisa membuat kreativitas mengalir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "Tapi, anggur saja tidak cukup untuk menginspirasi penyair luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Sebelum tulis puisi, kita harus mulai dengan cari inspirasi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Beberapa senang bepergian, beberapa lebih senang menyendiri, sedangkan yang lainnya ... senang menggunakan anggur untuk memicu kreativitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "Ini bagian yang paling menantang, karena kita tidak bisa merasakan di mana inspirasi itu sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "Jadi kebanyakan kita merasa belum menemukan inspirasi, terus jadi panik dan depresi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "Tapi inspirasi sudah pernah singgah dan meninggalkan bekasnya di dalam benak kita tanpa disadari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "Ketika saatnya tepat, bekas itu akan muncul sebagai mahakarya syair, atau lukisan ... atau yang lainnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "Terus bisa diubah jadi permainan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Hahaha, tentunya! Proses pembuatan puisi itu jelas dan mudah dimengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "Dan kebetulan ada beberapa perancang permainan Mondstadt yang berminat dengan ideku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "Setelah diskusi dan bertukar pikiran, hasil yang keluar adalah \"Letupan Inspirasi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "Langsung coba deh kalau minat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "Main satu-dua kali, siapa tahu kamu bakat jadi penyair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
}