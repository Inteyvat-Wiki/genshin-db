			"dialogs": [
				{
					"id": 750101201,
					"content": "Sobat kecilku balik lagi. Gimana, berhasil dapat teman Alpaca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "Nguk, nguuk, NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Haha, kamu girang amat! Aku sampai jadi ingin ikutan girang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Eh, Wactana. Masa sih kamu enggak peduli gitu sama Alpaca-nya? Yang sudah temenan sama si {REALNAME[ID(2)|SHOWHOST(true)]} tuh sempat gawat banget tadi.",
