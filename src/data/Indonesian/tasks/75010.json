					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "Oh ya? Wah, berarti aku harus kasih tahu si Setengah Matang biar lebih hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "Kamu terlalu santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "Mau gimana lagi, aku menikmati hidup! Ayo, kalian juga ikutan senang kek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Ah, kalau misalnya {REALNAME[ID(2)|SHOWHOST(true)]} suka sama mainan Alpaca yang itu, ambil saja buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#Wah, si {REALNAME[ID(2)|SHOWHOST(true)]} mesti diajarin konsep \"jangan terlalu nunjukin kalau ingin sesuatu\" nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "Enggak usah lah. Oh, ingat ya, main lagi ke sini kapan pun kalian mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "Kasihan si Setengah Matang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Yah ... dia memang gampang banget cemas. Sekalinya dilepas dari tugas menjaga Alpaca, bisa stres sampai botak dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "Kayak gini nih sudah paling betul. Dia dapat kepuasan kerja, aku puas hidup santai. Sama-sama untung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
