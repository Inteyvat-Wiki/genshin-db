			"dialogs": [
				{
					"id": 750100201,
					"content": "Ah, ada sesuatu yang berbulu menghalangi jalanmu ... berbulu ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Alpaca Energik"
				},
				{
					"id": 750100203,
					"content": "Wawawaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "\"Setengah Matang\""
				},
				{
					"id": 750100204,
					"content": "Hmm—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Alpaca Energik"
				},
				{
					"id": 750100205,
					"content": "Eh? Kalian semua teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "Nguk, nguuk, NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "Seseorang yang sepertinya penggembala Alpaca datang dan menenangkan para Yumkasaurus ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Sabar, sst, sabar dulu, Setengah Matang! Tuh, yang kayak gini nih yang bikin kamu dikasih nama kayak gitu. Selalu saja gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "Wawa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "\"Setengah Matang\""
				},
				{
					"id": 750100210,
					"content": "Jangan khawatir, dia nih memang sifatnya terlalu serius dalam menjalankan tugas. Kalau ada orang asing, galaknya langsung keluar. Tapi berkat itu juga sih aku bisa aman damai mengurus para Alpaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Nah! Ada keperluan apa di tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "Cuma lagi bertualang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "Ah, petualang! Yah, si Setengah Matang lihat kalian sebagai sosok bahaya yang hawa-hawanya maut. Seram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Wah, Paimon baru tahu Yumkasaurus bisa dipekerjakan buat jadi gembala Alpaca kayak gitu. Kirain Alpaca-nya mau dimangsa loh! Ternyata cuma salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Ah, kesalahpahaman yang sangat umum terjadi. Rekanku ini memang garang, tapi dia dekat banget dengan para Alpaca. Teman dekat lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "Nguk, fuwaaa! FUWAWAWAAA!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Hmm? Kenapa, sob? Mau berteman sama mereka juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "Fuwaaa, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "Wah, iya loh. Tapi memang sih, dia biasanya cuma main sama kami berdua. Mungkin dia juga ingin punya teman sebangsa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Bagus memang. Imut pula, Tepetlisaurus unyil dikelilingin sama teman-teman Alpaca-nya ... Aku sih enggak bakal bosan lihatnya. Mungkin bisa lahap habis tiga mangkuk Blazed Meat Stew sambil terus nontonin mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "Yah, tapi keputusannya di tangan Alpaca. Persahabatan itu harus dari dua pihak, bukan dipaksakan. Iya kan, Setengah Matang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Mrmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "\"Setengah Matang\""
				},
				{
					"id": 750100225,
					"content": "#Kenapa? Enggak mau gaul sama {REALNAME[ID(2)|SHOWHOST(true)]}?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#HEH! Jangan galak gitu, apaan sih kamu. Biar si {REALNAME[ID(2)|SHOWHOST(true)]} yang usaha sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "Anak kecil baru bisa dewasa kalau sudah ngerti yang namanya usaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Tepetlisaurus kalian nih pedenya lebih dari cukup! Potong telinga ini kalau salah. Sudah ya, aku mau rebahan dulu. Panggil saja kalau ada sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "Eh, salah. Kalau mau manggil, panggil si Setengah Matang saja. Dia yang ahli Alpaca ... hehehe, bercanda. Oke deh, semangat ya, sobat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "Biarin. Kalau mereka enggak mau gaul, masih ada kita!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "#Uh, Paimon ngerti sih kamu sayang sama si {REALNAME[ID(2)|SHOWHOST(true)]}, tapi jangan langsung pesimis gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100230,
					"content": "#Anak kecil tuh harus didukung, disemangatin biar tumbuh sehat dan kuat! {REALNAME[ID(2)|SHOWHOST(true)]} pasti bisa! Paimon yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100214,
					"content": "Mau cek situasi, lagi ngebayangin diri sendiri hidup tenang sebagai gembala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100215
					]
				},
				{
					"id": 750100215,
					"content": "Kamu datang ke tempat yang tepat. Saurian di sini bisa banget ngejagain Alpaca. Gembalanya tinggal hidup santai, kayak aku gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				}
			]
		},
