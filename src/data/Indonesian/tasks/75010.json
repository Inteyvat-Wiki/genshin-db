						750101608,
						750101610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101608,
					"content": "#Temannya {REALNAME[ID(2)|SHOWHOST(true)]} adalah temanku juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101609
					]
				},
				{
					"id": 750101609,
					"content": "Dan Paimon. Eh ... kenapa malah jadi kayak enggak mau kalah gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101612,
					"content": "Tapi bahaya sih kalau si Alpaca ini dibiarin sendirian. Mending kita laporin ke Wactana yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#Paimon yakin dia bakal ikut senang kalau tahu si {REALNAME[ID(2)|SHOWHOST(true)]} dapat teman baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
