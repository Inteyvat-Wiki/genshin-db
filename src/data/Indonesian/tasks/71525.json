					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Halo semua, aku Iron Tongue Tian. Aku datang membawa papan pengumuman Kamp Pelatihan Adu Kumbang Zirah Membara Arataki. Papan ini juga merangkap izin mengadakan kegiatan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662002,
					"content": "Wah! Gambarnya ... si Gembala Sapi dan Pentung Merah? Kok gini amat sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Wah, mantul! Sayangnya bukan Tuan Besar ini yang bikin sendiri ya ... Tapi lihat tuh desainnya! Garis-garisnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "Keren banget! Gile! Kelihatan jelas gimana kerennya Tuan Besar ini pas lagi main adu kumbang! PANAS MEMBARA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Eh, Bang ... tunggu, salah deh. Gimana sih biasanya kalau manggil orang di belahan dunia sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Itu ... \"Koh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662007,
					"content": "Nah, betul! Koh Tian, ini gambar keren amat! Geng Arataki mengucapkan terima kasih sebanyak-banyaknya, sampai enggak tahu berapa banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Ehem, tidak perlu panggil \"Koh\" segala, Bung Arataki. Dan aku bukan pelukis, hanya sekadar tukang dongeng saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662009,
					"content": "Karya ini buatan seorang nona muda yang kerja di Bagian Urusan Sipil. Nona Yanfei punya hubungan yang baik dengan dirinya, jadi ketika dengar ada acara seperti ini, dia mau kontribusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662010,
					"content": "Ohh, jadi ini berkat Nona Yanfei! Duh, penyelamatku benar-benar sudah pikirin semuanya ... pas banget ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Grandmaster Hanakado muda ini juga bilang kalau kamp pelatihanmu itu adalah program pelatihan intensif yang bisa membentuk masa depan dunia adu kumbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662012,
					"content": "Aku sendiri bukan pemain adu kumbang, tapi aku sudah sering dengar tentang permainan itu dan sudah lama ingin coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662013,
					"content": "Siapa tahu, mungkin permainan ini bisa jadi bahan untuk dijadikan cerita baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662014,
					"content": "Adu kumbang adalah salah satu bidang permainan yang perlu bakat serta kecocokan. Coba lihat Lavender Melon Pembelah Langit dan Bumi, dia bisa langsung hebat saat kali pertama turun ke arena, padahal sebelum itu hanya nonton saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662015,
					"content": "Kalau Koh Tian sudah menguasai dasar-dasar teknik adu kumbang dan memahami daya tariknya, mungkin kita bisa kebagian promosi gratis dari ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662016,
					"content": "Wow! Keren banget kalau bisa begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Oke lah kalau begitu ... Bang, eh, Kang, eh, Mas, eh eh KOH! KOH TIAN! Eheheheh ... Uh ... Se-semoga yang terkuat bisa menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
