			"dialogs": [
				{
					"id": 716662101,
					"content": "Luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662102,
					"content": "Rupanya Geng Arataki sudah mengubah adu kumbang menjadi sebuah olahraga kompetitif yang memacu adrenalin. Ya, benar-benar bisa dijadikan cerita yang menarik. Diulang terus juga tidak bakal bikin bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662103,
					"content": "Koh Tian asli hebat nih mainnya! Mantaaaaaaaaap arwah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "\"Mantap jiwa\", Raja Oni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662105,
					"content": "Ah, terserah Tuan Besar inilah mau ngomong gimana! Intinya ... makasih sudah dukung acara kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Sama-sama, Bung Arataki. Aku ingin tinggal lebih lama untuk menyaksikan pertandingan dan mengumpulkan inspirasi cerita. Tolong hiraukan saja aku, anggaplah di sini tidak ada orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "\"Yuk Dengarkan Analisis Selanjutnya\""
				},
				{
					"id": 716662107,
					"content": "Duh, aku belum pernah deh main adu kumbang lawan orang yang ... berbudaya kayak gitu. Ngomongnya sopan amat. Ini apa sih namanya, kok rasanya kayak geli-geli gimana ... AH, BELAJAR! YA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Awal yang bagus untuk Kamp Pelatihan Adu Kumbang Zirah Membara Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
