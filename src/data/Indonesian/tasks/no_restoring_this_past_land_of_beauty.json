			"dialogs": [
				{
					"id": 710220101,
					"content": "Kali ini terjadi di Tianqiu Valley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Oh, ternyata {NICKNAME}. Kebetulan sekali, tidak kusangka bisa bertemu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "Ngomong-ngomong, apakah belakangan ini kalian pernah mengunjungi Tianqiu Valley dan Nantianmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Belakangan ini Adventurers' Guild terus mendapatkan laporan tentang gempa yang terjadi di antara Tianqiu Valley dan Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "Awalnya hanya getaran kecil saja, tapi belakangan ini menjadi semakin kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Lalu baru-baru ini Adventurers' Guild juga menerima laporan bahwa ada bagian gunung dan reruntuhan yang longsor karena gempa yang sangat kuat. Lalu kami menemukan munculnya sebuah gua raksasa di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "Laporan itu juga menyebutkan kalau di dalam gua itu terdapat monster yang tidak diketahui. Berdasarkan deskripsinya, sepertinya mirip dengan Geovishap dan Primo Geovishap yang pernah mengacau dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Oh, aku ingin memintamu untuk pergi ke gua raksasa di Tianqiu Valley itu. Tolong periksa efek dari gempa tersebut ke lingkungan di sekitar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "Tolong periksa juga kondisi monster di sana. Kita harus mencari cara untuk menanganinya kalau monster-monster itu muncul dalam jumlah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Tentu saja kamu akan mendapatkan imbalan setelahnya, karena ini juga salah satu pekerjaan Adventurers' Guild. Bagaimana, kamu mau membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Terima kasih banyak. Pastikan kalian sangat berhati-hati saat mencari petunjuk di sana ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
