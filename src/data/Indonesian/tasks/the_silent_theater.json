				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "Itu pohon Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Oh, lukisan ini ya. Kalian sudah tidak asing lagi dengan pohon putih ini, tapi apakah kalian tahu pengkhianatan malaikat pertama terjadi di bawah pohon ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Sepertinya belum tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Paimon penasaran nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Hmm, kalau begitu aku akan menceritakan kisah horor romantis yang sudah lama tidak kuceritakan. Tapi aku harus samarkan dulu identitas orang-orangnya ... Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "#Dahulu kala, ada seorang pengembara yang menjelajahi bintang-bintang. Tapi dia berbeda dengan {NICKNAME}, ceritanya panjang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Suatu hari, dia mengunjungi Putri Bintang Fajar di bawah pohon perak, dan tidak lama kemudian, dia bertanya tentang rahasia terlarang kerajaan kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Kata-katanya membuat sang putri bertanya-tanya. Kenapa dia bisa mengetahui hal-hal yang tidak diizinkan oleh para dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Pemuda itu mengungkapkan asal-usulnya, dan juga menunjukkan sesuatu yang tidak pernah dilihat oleh sang Putri, yaitu kehendak bebas dan cinta spiritual yang mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Kata-katanya membangkitkan jiwa sang Putri yang dikurung oleh dewa. Hatinya terbang tinggi, melampaui batas yang tidak pernah dia lintasi sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "Putri Bintang Fajar memberitahukan rahasia kerajaan kepada pemuda itu. Di antara mereka berdua, tidak hanya tumbuh rasa cinta, tetapi juga tekad untuk melawan para dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "Ini mah cerita cinta biasa! Mana bagian horornya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Bagian mengerikannya akan segera dimulai. Mereka sangat ingin membantu para rakyat mendapatkan kehidupan yang bebas tanpa ikatan, tetapi pengkhianatan seperti ini tidak akan dimaafkan oleh para dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Para dewa menjatuhkan petir dan murkanya, membumihanguskan tempat tinggal mereka. Dan setelah pertempuran besar ini mereda, sang Putri kehilangan kekuatan dan kebijaksanaannya untuk selamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Bahkan teman-teman yang dulunya dekat dengannya pun ikut terkena kutukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "Ugh ... ternyata bagian akhirnya serem banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Tapi kita kan tadi ngomongin dari malaikat pertama sampe ke cerita ini? Jangan-jangan ini berdasarkan kisah nyata ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Mm-hm, betul sekali. Itulah bagian yang paling menyeramkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Hmm, kalau begitu aku akan menceritakan kisah horor romantis yang sudah lama tidak kuceritakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Tapi aku harus samarkan dulu identitas orang-orangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Aha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Sepertinya aku pernah dengar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
