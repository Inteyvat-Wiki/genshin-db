			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "Wah, bikin kaget saja! Tiba-tiba Paimon kesedot ke dalam lukisan. Tunggu, tempat ini kok familiar ya ... ini kan meja tempat para penyihir berkumpul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Semuanya dimulai saat Alice mengundangku ke pesta teh untuk pertama kalinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Tapi, hari itu aku tidak hadir karena waktu itu aku belum memutuskan apakah aku akan resmi bergabung dengan Hexenzirkel atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Dari semua orang yang hadir, hanya Alice yang tahu identitas asliku. Dia memperingatkanku untuk tidak berbicara dan tidak mengungkapkan identitasku, dan hanya diam-diam mengamati semua orang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "Lalu, lalu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Kemudian aku memutuskan bahwa itu adalah balas dendam atas keraguanku untuk bergabung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Percakapan mereka begitu menarik, bagaimana bisa aku menahan diri untuk tidak ikut serta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Bagaimana kamu bisa menahan diri untuk tidak berbagi saat ada yang bertanya sesuatu yang kamu sudah tahu jawabannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Ini berkaitan dengan taruhan Alice dan Barbeloth, ciptaan terlarang Rhinedottir, dan kecakapan politik Ivanovna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Seperti sebuah pertunjukan yang indah di dalam cangkir teh, hanya dari kata-katamu saja sudah memicu naluriku untuk mengungkap kebenarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Jadi, kamu langsung \"bicara\" di pikiran semua orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Mana mungkin, meski aku merasa sesak sampai sulit bernapas, aku tetaplah malaikat yang bertanggung jawab, dan aku tahu perbedaan antara \"ingin bicara\" dan \"boleh bicara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Jadi pada akhirnya, aku hanya diam-diam berbicara dengan Alice melalui telepati, dan setuju untuk bergabung dengan Hexenzirkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Dia bisa menerima yang terakhir dengan cepat, tapi yang pertama ... dia bilang beberapa hari ini kepalanya sakit sampai pergi ke Liyue untuk mencari dokter. Tapi ini juga bukan sepenuhnya salahku dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
