			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "Oh! Simulanka! Eh ... kenapa bisa ada novel ringan Yae Publishing House berserakan di lantai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Kalau bicara tentang awal mulaku menulis, tentu saja itu berkat Nyonya Anya yang sangat kukagumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Dia adalah anggota terakhir yang bergabung dengan Hexenzirkel, namun juga yang paling cepat pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Aku suka setiap cerita yang dia tulis. Entah itu sebuah ide atau naskah yang sudah jadi, Anya selalu pandai memberikan kejutan kepada pembaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Hexenzirkel sering membahas tentang sihir. Menurutku, Anya menguasai sihir yang unik, yang dapat menenun cinta dan perhatian menjadi kata-kata yang menyentuh hati orang lain, atau alur cerita yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Aku pernah meminta pendapat tentang bagaimana cara menulis cerita, dan aku belajar banyak darinya. Tapi pada akhirnya, musuh terbesarku adalah aku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Karena malas memulainya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Ha! Bisa dibilang begitu. Berkomunikasi langsung dengan pikiran itu sangat praktis. Ternyata malaikat pun bisa jadi malas ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Tapi akhir-akhir ini aku memutuskan untuk berusaha agar salah satu teman Seelie-ku tidak selalu mengeluh saat bertemu dengan teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Wah, ah! Paimon akhirnya bisa baca novel yang ditulis langsung sama Nicole ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Siapa yang bilang aku jadi mulai menulis? Maksudku aku berhasil membeli beberapa karya populer selama ratusan tahun belakangan ini untuk dibaca saat senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Yup, itu maksudnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Berkomunikasi langsung dengan pikiran itu sangat praktis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Ternyata malaikat pun bisa jadi malas ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
