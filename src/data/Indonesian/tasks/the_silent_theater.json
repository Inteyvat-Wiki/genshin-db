					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "Oh, kalian datang! Aku tadinya berpikir apa perlu memberikan petunjuk yang lebih jelas untuk kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Tapi kalau petunjuknya terlalu jelas, itu malah bisa mengganggu rencana perjalanan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Di saat aku sedang ragu-ragu, untungnya kalian muncul bagaikan hujan di musim kemarau! Jadi semuanya akan lancar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Halo, Nicole. Kamu terlihat semangat banget! Kamu juga ... semangat bicara hari ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "Terima kasih atas pujiannya. Yuk kita pergi ke ruangan berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
