			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risutaiosu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Berhenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450402,
					"content": "Oi, berhenti! Berhenti kataku! Ayolah, aku sudah bilang berhenti! Apa kamu tidak dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450403,
					"content": "Eh, Paimon mana bisa langsung berhenti gerak begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450404,
					"content": "Ada-ada saja, minta Paimon jangan gerak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "Tidak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450407,
					"content": "Eh, baiklah, kalau begitu coba berbalik. Aku tidak pernah melihat pakaian seperti ini sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450408,
					"content": "Secara estetika tidak begitu oke, tapi menarik juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450409,
					"content": "Kalau kamu tidak suka, kenapa harus lihat-lihat sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450410,
					"content": "Oh ya? Asal kamu tahu ya meminta para wanita itu untuk menjadi model untukku tidaklah sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450411,
					"content": "Yah, aku juga sudah bosan sih lihat tampang orang-orang dari Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450412,
					"content": "Lalu mengenai pakaianmu, aku baru melihatnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450413,
					"content": "Hmm, aku tahu. Jadi itu cara mereka menggabungkan pakaian ... Wow, kalian orang luar benar-benar tidak tahu malu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450414,
					"content": "Begitu ya. Kalau pola bajunya seperti itu, berarti bentuk tubuhnya juga begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450415,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450416,
					"content": "Membuat patung. Aku mencampur lumpur dengan air, lalu membentuknya dengan kedua tanganku. Ini membuatku tenang — hanya ini saja yang bisa membuatku jadi tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450417,
					"content": "Dan kamu tahu tidak apa yang membuatku tak tenang? Duduk di ruang pertemuan, membaca semua hal yang memang sudah dituliskan para orang dewasa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450418,
					"content": "Ah, sudahlah. Aku juga sudah bosan melihat bentuk tubuhmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450419,
					"content": "Sekarang jangan ganggu aku lagi. Sana pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450405,
					"content": "Apa kamu bakal jatuh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
