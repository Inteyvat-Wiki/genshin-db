				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "Pengembara dari daratan yang jauh ... *uhuk* kamu terlihat lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Kelelahan itu tidak baik loh, banyak penyakit berawal dari kelelahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Kamu harus memastikan bahwa kamu sudah beristirahat cukup, jadi kamu— *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*uhuk* *uhuk* — bisa tumbuh dengan sehat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Kayaknya kamu deh yang enggak sehat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Ahaha, ini namanya penyakit tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "Kamu harus menjaga tubuhmu agar jiwamu juga sehat, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*huff* Andai saja aku masih punya banyak waktu. Aku pasti bisa jadi dokter terhebat di dunia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "Dengan begitu, walau dengan tubuh yang begini, aku pasti bisa keluar ruangan dengan tubuh sehat dan bermain sesuka hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
