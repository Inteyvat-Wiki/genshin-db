			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Hmm? Aku belum pernah lihat orang berpakaian sepertimu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "Apa kamu seseorang yang jatuh dari ... dari atas langit itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "Jadi dunia tidak berakhir di tangan bangsa kita yang mulia! Baiklah, serahkan petamu padaku agar bisa kuteliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Kamu menyerahkan petamu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Ah, betapa rumitnya. Tidak hanya bentang alamnya yang tergambar secara akurat, tetapi bahkan jalur pegunungan dan sungainya begitu jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Baiklah. Seberapa besar bangsa \"Teyvat\" ini? Bagaimana kalau dibandingkan dengan Byakuyakoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat itu sebuah benua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "Lalu, Enkanomiya ... Yaitu, Byakuyakoku, adalah petak kecil di ujung selatan peta ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "Omong kosong! Daratan kami begitu besar dan luas! Bagaimana mungkin hanya sepetak kecil ini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Peta ini mungkin tampak digambar dengan sangat indah, tetapi sebenarnya hanya tipuan saja. Huh, sudahlah jauhkan peta itu dariku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "Sungguh memalukan bahwa tadi aku sempat terkesima dengan tipuan murahan seperti itu, mataku jadi ternodai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Ya sudah, terserah kamu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224503,
