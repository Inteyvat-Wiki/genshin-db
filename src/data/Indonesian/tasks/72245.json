			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rikoru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "Apa? Jangan ganggu aku. Aku sedang berpikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450102,
					"content": "Iya, aku sedang memikirkan sesuatu yang sangat penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450103,
					"content": "Sesuatu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450104,
					"content": "Apa kamu pernah melihat sesuatu yang disebut sebagai Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450105,
					"content": "Bangunan tertinggi di seluruh negeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450106,
					"content": "Aku sedang berpikir bagaimana caranya aku bisa membangun bangunan lebih tinggi dari itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450107,
					"content": "Tapi kan bangunan itu menjulang tinggi supaya bisa menerangi Byakuyakoku, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450108,
					"content": "Apa alasannya kamu mau membangun bangunan yang tinggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450109,
					"content": "Untuk menunjukkan kemuliaanku dong! Kemuliaan Rikoru yang Hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450110,
					"content": "Aku akan menunjukkan kepada Aberaku siapa sebenarnya yang hebat di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450111,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Iya. Dia yang membangun Dainichi Mikoshi dan menyelamatkan Byakuyakoku. Aku dulu begitu mengaguminya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450114,
					"content": "Tapi ternyata, dia mengincar takhta. Jika bukan karena para orang dewasa itu, aku pasti sudah mati sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450115,
					"content": "Karena itu aku akan membangun bangunan yang lebih tinggi dari Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450116,
					"content": "Be-Berapa lama kamu mau membangunnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450117,
					"content": "Aku tidak peduli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450118,
					"content": "Masyarakat Byakuyakoku harusnya senang karena aku meminta mereka membangun bangunan bersejarah untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450119,
					"content": "Ah sudahlah! Jangan ganggu aku lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450120,
					"content": "Coba kupikirkan. Kalau baloknya sepanjang ini ... Kalau kita melakukannya seperti itu, bantalan beban dan sambungan kayunya bakal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450112,
					"content": "Aberaku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
