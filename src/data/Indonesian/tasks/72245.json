			"dialogs": [
				{
					"id": 722450701,
					"content": "*huff* Jadi kamu si pengembara dari jauh itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "Apa yang kamu kejar? Membayangkanmu melewati pegunungan sampai ke tempat ini saja sudah menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Menyedihkan? Kenapa harus sedih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Bagi seorang penyanyi lagu, semua yang ada di dunia ini menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Di mana ada pertemuan, pasti ada perpisahan, dan mereka yang terlahir suatu hari pasti akan kembali ke tanah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "Pertemuan terlalu singkat untuk menghilangkan rasa sakit karena perpisahan yang lama ... Dan untukmu, Pengembara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Hanya mereka yang mengejar sesuatu maka bisa berkelana ke segala penjuru sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Mereka yang tinggal menetap, semua melihat perjalanan sebagai sesuatu yang romantis, namun untuk seorang pengembara, mungkin malah menjadi kepahitan yang tidak terkira ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Kalau kamu datang lebih cepat, mungkin aku akan bernyanyi untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Tapi aku sudah berjanji dengan seseorang bahwa aku tidak akan bernyanyi lagi sampai aku bisa mendengar suaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "Aku hanya bisa mendoakan yang terbaik bagimu, walaupun kamu terlihat jauh lebih tua dariku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Semoga harapanmu terkabul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
