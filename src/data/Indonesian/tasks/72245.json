				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "Oh ho! Menilai dari penampilanmu, kamu pasti pengembara dari bangsa lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "Dari mana kamu berasal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "Kami dari Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Jelaskan pemandangan Mondstadt pada Piramumon dengan sederhana ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Aku tidak pernah mendengar kota seperti itu. Jadi tempat seperti itu memang ada ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Hahaha! Seperti yang kubilang! Dunia tidak mungkin hanya sebesar Byakuyakoku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Maksudku, jika hanya ada Byakuyakoku saja, maka dunia ini pasti sepi sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Teks kuno juga mengatakan tentang waktu sebelum bangsa kami ditemukan. Dari sejak itu aku mulai percaya bahwa ada daratan lain selain daripada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Tapi aku masih takut. Takut bahwa di luar sana justru tidak ada apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "Kedatanganmu ke sini membuatku tenang, Pengembara. Haha, jadi memang benar-benar banyak tempat menarik di luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "Sayang sekali karena ada festival Rite of Solar Return yang harus kuhadiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "Pengembara, bagaimana kalau kamu katakan padaku caramu datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Saat festival berakhir. Aku akan ambil kesempatan untuk keluar diam-diam dari Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "Kita minum jus buah saja! Ayo bareng, hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
