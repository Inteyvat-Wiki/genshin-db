			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "Kita masih di hari yang sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Sudah kuduga tidak semudah itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "Nahida, kemarin malam kamu sudah tahu kalau kita belum lepas dari samsara, kan? Kenapa kamu enggak bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Apakah ada gunanya? Kalian malah harus melewati malam hari dengan masalah baru, dan hari besoknya juga tetap akan sama saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "Daripada begitu ... lebih baik kalian istirahat sebisanya dalam momen penuh harapan itu. Kesempatan seperti itu jarang ada, dan kupikir bisa membuat pikiran kalian lebih lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "Benar juga sih ... Ah sudahlah, toh kamu juga maksudnya sih perhatian ya sama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "Tentu saja. Setidaknya selama beberapa waktu kita bersama ini, kalian berdua adalah segalanya bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Uh ... Paimon senang sih dengarnya, tapi sepertinya kamu terlalu terburu-buru deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "Hehehe ... Maksudku, meskipun aku meminta kalian memecahkan teka-teki ini, tapi hanya kalian berdua yang masih bisa melihat dan merasakan keberadaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "Dengan kata lain, kalau tidak ada kalian, sama saja seperti aku tidak ada di dunia ini. Itulah kenapa kubilang kalian berdua adalah segalanya bagiku. Mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Uhh, Nahida sudah mulai bicara soal hal yang membingungkan lagi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "Sudah cukup mengobrolnya. Pengembara, apa petunjuk baru kemarin bisa membantumu memahami situasi sekarang dengan lebih baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "Teori \"lingkaran waktu\" itu ternyata salah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "Eh? Kenapa teorimu sebelumnya sudah tidak kamu anggap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Kemampuan bertarung Dehya semakin berkembang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Oh iya, benar juga. Kenapa kita enggak sadar ya? Kalau memang cuma lingkaran waktu saja, harusnya kondisi fisik seseorang juga terulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Lalu, apa hipotesis barumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "Penyakit Dunyarzad juga bertambah parah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "Ternyata kalian di sini, aku mencarimu dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Seperti dugaan kita, hari ini Dehya juga tidak terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Terluka? Kenapa aku bisa terluka? Jangan remehkan aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Yah, karena kamu kan masih membiasakan diri dengan pedang barumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "Jujur saja, aku juga merasa ini aneh. Rasanya sudah pas sekali di tanganku ... Tunggu dulu, kenapa kamu bisa tahu aku punya pedang baru? Aku belum beri tahu siapa-siapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "Ah, lebih baik kamu yang jelaskan deh. Paimon sampai sudah bosan jelasinnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "Sebenarnya kita tidak perlu menjelaskan semuanya juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Oh, boleh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Kamu tiba-tiba jadi terbiasa dengan pedangmu karena ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Kita sudah melewati hari ini berkali-kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "Selama aku pergi, kalian ini kenapa sih? Apa kamu dicuci otak oleh sejenis aliran aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Emmm, jangan terlalu dipikirkan. Dengar saja dulu apa yang kita katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "Baiklah kalau begitu. Aku mengerti maksud kalian. Jadi tubuhku sudah terbiasa dengan pedang baruku ini, hanya saja aku tidak mengingatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Benar sekali, ingatanmu akan terhapus setiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Kalau begitu aku tidak setuju, karena itu tidak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Eh? Kenapa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Kalau kita memang mengulang Festival Sabzeruz berhari-hari, lalu bagaimana dengan barang-barang yang kita pakai, uang yang kita keluarkan, dan makanan yang kita makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Secara logis, harusnya dompetku sudah kosong melompong dari dulu-dulu. Tidak mungkin aku tidak menyadarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "Aku juga pernah memikirkan hal itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Tapi kalau para Sage ada di balik semua ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Benar juga ... Mereka bisa pakai Akasha buat merekam apa yang dilakukan setiap orang pada hari itu, lalu pakai sumber daya seluruh kota buat mengembalikan semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Kayaknya tidak terlalu mungkin sih, tapi tetap ada kemungkinan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "Tidak, itu tidak mungkin. Aku punya buktinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Kamu punya buktinya? Di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "*huff* Kalian berdua serius sekali ya untuk masalah tidak masuk akal seperti ini. Ya sudah, kutemani kalian bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Ayo ikut aku. Nona Dunyarzad, tolong ikut juga denganku. Aku tidak bisa menjamin daerah ini sudah aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Kalau mereka memanfaatkan sumber daya seluruh kota, dan informasi yang disediakan oleh Akasha ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Dan ingatan kita tentang hari ini akan terhapus pada setiap malam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Langsung ke intinya saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "Ini dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Eh? Ini bukannya boneka kayu latihan? Lalu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Lihat bekas pedang di bonekanya? Itu hasil dari latihan beberapa hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Kalau para Sage tidak datang menggantinya setiap hari, pasti bonekanya sudah hancur kan sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "Iya benar, tapi kalau ternyata mereka menggantinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Berarti para Sage harus bisa membuat ulang semua bekas pedang yang kubuat dari sesi-sesi latihanku sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Meskipun aku ini petarung bayaran, tapi aku tetap seorang ahli bela diri. Sekolahku dulu selalu menekankan pentingnya \"pengendalian\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "Kekuatan, arah, dan titik masuk dari setiap tebasan harus diperhitungkan dan terkendali. Itulah kenapa aku bisa ingat setiap bekas pedang di boneka ini, dan juga kondisi pikiranku saat aku menebasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "Sama seperti kata pepatah, setiap ahli pedang memiliki gaya uniknya sendiri, bahkan ahli pedang yang sama tidak bisa membuat dua tebasan yang sama persis. Meniru bekas-bekas pedang ini adalah suatu hal yang tidak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "Masa tidak mungkin sih? Bagaimana kalau mereka pakai mesin canggih buat mengukir setiap bekasnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Orang-orang sering mengatakan kalau foto dari Kamera tidak bisa menggantikan lukisan seorang seniman, karena sebuah foto tidak memiliki jiwa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "Ini juga sama. Hanya melihat sekilas saja aku bisa membedakan antara bekas tebasan yang diukir dengan bekas hasil latihan pertarungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "Masuk akal juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Fiuh ... Berarti sekarang sudah jelas kan? Hei, apa ini permainan Putar Otak yang sedang populer di kalangan para pelajar itu? Ternyata seru juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Sudah dulu ya, sudah lumayan larut. Aku harus mengantar Nona Dunyarzad ke panggung Nilou. Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "*huff* Kembali ke titik awal lagi ya. Apa teori ingatan yang dihapus kita juga salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "Tapi setidaknya kita sudah punya beberapa kesimpulan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "Aliran waktunya tidak terulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Yap, benar sekali. Jadi ... apa ada ide baru sekarang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Coba kupikir-pikir ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Aneh? Paimon malah merasa semuanya aneh belakangan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Kenapa ... kita tidak terpikirkan untuk keluar dari kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Eh? Keluar dari kota ... benar juga ya! Aneh banget kita tidak terpikirkan cara sesimpel itu. Harusnya banyak yang jadi jelas kalau kita bisa melihat jalannya waktu di luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "Paimon enggak habis pikir ... Kita tidak memikirkan ini karena pemikiran kita terlalu sempit atau karena terlalu lelah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "Memang aneh sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Bagaimana kalau kita balik dan tanya Nahida? Mungkin ada sesuatu tentang keluar dari kota yang kita lupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Harusnya kita sudah memikirkan ini dari dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "Aku tiba-tiba sadar kalau ada sesuatu yang aneh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "Kita tidak ada di dunia nyata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Sepertinya kita harus membuang teori ini juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
