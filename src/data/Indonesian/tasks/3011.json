			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Nahida, kami sudah balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Hari ini kalian cepat kembalinya. Ada sesuatu yang baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "Bisa dibilang begitu. Kita cukup yakin kalau waktunya tidak terulang-ulang, dan kita tidak berada di dunia nyata. Tapi di saat yang sama, kita punya pertanyaan baru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Apa yang akan terjadi kalau kita keluar dari kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Keluar dari kota ... Seingatku, kalian pernah bicara soal rencana ini dua kali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "Kita pernah? Tapi kita enggak ingat sama sekali! Apa yang terjadi setelah rencana kita itu? Kita bilang apa setelah balik dari luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "Coba kuingat-ingat ... Sepertinya kalian tidak pernah memberitahuku hasilnya. Oh, lebih tepatnya kedua kali itu, kalian berdua tidak kembali semalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Tapi kalian berdua memang kadang-kadang tidak kembali semalaman sih, jadi tidak terlalu kupikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "Memang benar sih kita sering lupa waktu kalau sedang menyelidiki. Tanpa sadar sudah keesokan hari saja. Tapi ... kita berdua tidak ingat apa pun tentang keluar dari kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Benarkah? Aneh juga ya. Secara teori, harusnya aku sudah mengembalikan semua ingatan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Ayo kita coba lagi besok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Yap! Ada sesuatu yang mencurigakan di sini. Ayo kita cari tahu besok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*bip*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Mungkin ini dia kuncinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Apa kita pernah mencoba keluar dari kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
