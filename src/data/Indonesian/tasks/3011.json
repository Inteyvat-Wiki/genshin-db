			"dialogs": [
				{
					"id": 30111113,
					"content": "Yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Kita tidak berada di waktu yang berulang-ulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Oooh! Berarti suara \"bip\" yang kita dengar setiap malam, bisa jadi menandakan penghapusan ingatan kita ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "Itu dia kenapa waktu orang-orang bangun, semua masih mengira Festival Sabzeruz belum berlangsung. Sebenarnya sudah keesokan harinya, tapi semua mengira masih hari kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Tapi ingatan tubuh tidak bisa dihapus, jadi makanya Dehya semakin lama semakin terbiasa dengan pedang barunya! Iya, masuk akal banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "Hmmm, deduksi yang bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Nahida, kita benar atau salah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Kalau diumpamakan secara sederhana, kalian mengira Pyro Crystalfly sebagai Firefly pada malam hari. Kalian terlalu fokus pada fakta bahwa mereka bercahaya, sampai melupakan bentuk aslinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Apanya yang sederhana ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Kesimpulannya masih salah ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Bagaimana kalau kalian coba bicara lagi dengan Nona Dehya? Mungkin kalian bisa dapat sesuatu yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "Benar juga, petunjuk yang terakhir juga berkat bantuan Dehya kan. Yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Tepatnya, ingatan kita yang dihapus sebelum hari berakhir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
