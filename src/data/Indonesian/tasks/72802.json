			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko dan keluarganya mungkin ada di dalam rumah. Ayo kita ketuk pintunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Mereka sepertinya sedang membicarakan sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Omong-omong, entah bagaimana kabar tanuki yang dulu kita tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Kamu ini benar-benar terlalu baik hati. Kaki tanuki itu hanya terluka sedikit, sebenarnya dia bisa mengobati dirinya sendiri kalau pun ditinggalkan di dalam semak belukar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Aku kan tidak tega. Saat itu dia melihatku sambil menangis, sungguh kasihan. Bagaimana bisa aku tidak membawa dia pulang dan merawatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Sudahlah, berbuat baik juga suatu hal bagus. Hanya saja makannya banyak sekali, hampir mengalahkan aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "*tok tok*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "Aku adalah pengembara yang datang sebelumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Oh, pengembara itu, tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "Ha-halo! Aku Atsuko, salam ke... bukan... kita bertemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Maaf, karena aku sangat merindukan rumah, setelah menyerahkan surat itu pada kalian, aku berubah pikiran dan naik kapal pulang ke rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Ahaha... yang dulu itu hanya salah paham, maaf ya membuat kamu datang kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Kamu bisa kembali ke Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "... Ah, aku punya jalanku sendiri, haha. Kamu tidak perlu memedulikan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Itu, aku sudah menyiapkan imbalan, tolong diterima. Terima kasih atas bantuan kalian. Cepat... eh, cepat pergi lanjutkan urusan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Kenapa perkataan Nona Atsuko berlawanan? Jika begitu mudah kembali ke Inazuma, untuk apa meminta bantuan kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Bagaimana dengan bisnismu di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Bisnis? Bisnis apa? Aku masih punya bisnis di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "... Ah, benda seperti itu tidak sepenting keluarga. Aku sudah lama menyerahkannya pada orang lain... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Oi oi, Atsuko yang sesungguhnya sulit mendapatkan pekerjaan di Liyue, bagaimana bisa dalam sekejap jadi orang kaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Siapa kamu sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "A-aku adalah Atsuko! Aku punya wajah Atsuko, suaranya Atsuko, apa lagi yang bisa dicurigai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Kamu ya! Berhenti deh memaksakan diri begitu... Ah sudahlah, lupakan saja. Aku tidak mau bicara tentang ini lagi. Aku harus kerja besok, jadi aku pergi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Oi, Atsuko! Anak ini... kenapa tiba-tiba marah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "Maaf, Pengembara. Anak ini pasti terlalu lelah bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Tapi kamu juga sudah melihatnya, dia memang putri kami. Tentang surat yang kamu bawa... mungkin saja anak ini sudah lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Bagaimanapun, terima kasih telah datang membantu. Tentang imbalan... harap tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Apakah terjadi sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Tidak ada, kami masih bisa memberikan imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Atsuko, bukankah dia pergi bekerja di siang hari? Tapi upah yang dia bawa pulang setiap hari sedikit aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Ada yang biji aneh, ada yang buah liar, dia tidak pernah membawa Mora kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Walau barang-barang ini juga ada nilainya, tapi kami harus pergi menjualnya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "Bagi pengembara seperti kamu, pasti lebih baik langsung mendapatkan Mora sebagai imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Harap datang lagi besok, saat itu, aku akan langsung memberikan Mora padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Jika ada kesulitan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "Bagaimana dengan rumah mewahmu di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Rumah mewah? Rumah mewah apa? Aku masih punya rumah mewah di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
