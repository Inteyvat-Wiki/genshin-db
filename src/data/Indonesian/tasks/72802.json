				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Besok siang masak berapa masakan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Porsi makanan anak kita semakin banyak, kamu masak banyakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Ah? Maaf, kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Permisi, apakah ini rumah Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Benar, kamu ada keperluan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Ini adalah surat dari Atsuko yang dititipkan padaku untuk kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Surat, kenapa anak ini tiba-tiba menulis surat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "Panjang sekali suratnya... Jelas-jelas sudah pulang ke rumah, jika ada yang ingin dikatakan kan bisa langsung disampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "...Apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "Pengembara ini... Kamu terkejut mendengar ini? Atsuko pernah meninggalkan rumah dan berkelana, tapi dia sekarang sudah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Karena sudah pulang, untuk apa meminta orang lain mengirimkan surat. Kalian salah orang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Tunggu sebentar Ibu, aku sudah membaca sekilas surat ini. Tulisan dan nada ini memang milik putri kita Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "Di dalam surat juga tertulis, dia tidak berencana pulang dalam waktu dekat, berharap kita menjaga diri baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "Apa yang sebenarnya terjadi? Apakah dia meminta pengembara ini membawa surat, lalu dia sendiri juga pulang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Aku rasa mungkin ada salah paham, tunggu anak itu kembali lalu kita tanyakan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Pengembara, kebetulan sekali hari ini Atsuko pergi karena ada urusan, kami akan menanyakan dengan jelas saat dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Jika kamu berkenan, silakan cari kami lagi besok malam, anak itu akan menjelaskannya langsung padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Sekarang dia ada di mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Anak itu berkata dia ada pekerjaan, dia terburu-buru pergi setelah makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Benar, setiap hari dia selalu pergi pagi dan pulang malam. Kami hanya bisa bertemu dia di malam hari. Entah apa yang dilakukan anak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Pokoknya, silakan datang kembali besok malam. Jika anak itu melakukan kesalahan, pasti kami akan membuat dia langsung meminta maaf padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Maaf telah membuatmu datang ke tempat yang begitu jauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Atsuko, anak ini, sungguh membuat orang khawatir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Kenapa malam hari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Anak itu berkata dia ada pekerjaan, selalu pergi di siang hari setiap hari setelah makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko... sudah pulang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Permisi, apakah kalian orang tua Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
