			"dialogs": [
				{
					"id": 728020301,
					"content": "Kenapa kepulangan putri kita lebih cepat dari tanggal di dalam surat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Jangan berpikir sembarangan, mungkin ada salah paham. Lebih baik bantu aku memikirkan makan siang untuk besok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
