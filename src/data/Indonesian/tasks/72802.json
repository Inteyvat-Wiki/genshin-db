			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "Atsuko saat ini sedang tidak di tempat, silakan datang kembali saat malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Atsuko seharusnya sudah kembali jika sudah malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
