			"dialogs": [
				{
					"id": 728020601,
					"content": "Anak kita pergi ke mana lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Walau pergi bekerja, dia pasti berpamitan sebelum pergi, tapi kenapa hari ini dia pergi tanpa pamit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Semalam setelah kamu pergi, Atsuko berkata dia sangat lelah, langsung masuk ke kamar dan tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Saat kita berdua bangun pagi hari, dia sudah tidak ada di ranjangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Kita mencarinya ke berbagai tempat, tapi tidak menemukan putri kami, suamiku bahkan langsung mencari di tempat yang lebih jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Tapi aku sudah menunggu setengah hari di sini, sama sekali tidak melihat jejak putriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "Ah, apakah dia pergi berkelana lagi? Kita harus bagaimana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Ibu, jangan panik, aku akan pergi mencarinya lagi. Kamu kembali saja ke kamar Atsuko untuk bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Anak itu tidak menutup jendela dengan baik saat pergi, membuat kamar penuh dengan daun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "Oh ya, Pengembara, ini adalah imbalan yang dijanjikan. Silakan terima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "Ah, apa yang sebenarnya sedang dilakukan Atsuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Apakah Atsuko pergi bekerja lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
