			"dialogs": [
				{
					"id": 701140101,
					"content": "Langka sekali Nona Sandrone bisa menyempatkan diri untuk datang ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Kamu banyak membantuku saat meneliti larik numerologi-nya. Jadi aku ingin berterima kasih kepadamu secara langsung,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140103,
					"content": "Kamu terlalu memuji. Hal-hal semacam itu sebenarnya di luar bidang keahlianku. Keberhasilannya sepenuhnya berkat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Itu adalah hasil kerja bersama. Hmm ... Ngomong-ngomong, di mana Durin? Kamu kan bisa dibilang walinya, aku pikir dia tidak akan jauh darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140105,
					"content": "Tidak salah, sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Tapi belakangan, kemampuan sosialisasinya sudah banyak berkembang. Jadi aku memberinya kebebasan untuk mengatur rutinitasnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Kamu tidak khawatir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140108,
					"content": "Sedikit. Dulu kalau dia sendirian dan berhadapan dengan seseorang yang karakternya ... katakanlah \"kuat\", dia cenderung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Meniru kebiasaan aneh?Mencontoh cara bicara yang unik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140110,
					"content": "Tepat sekali. Sepertinya kamu pernah mengalami hal serupa, Nona Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hmph, masih perlu ditanya? Aku ini sudah ahlinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140112,
					"content": "Biasanya sepulang dari bertemu Grand Master Varka, aku akan bawa Durin menemui Sucrose dan membantu penelitiannya. Biasanya itu bisa membantu menenangkan pikirannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Tapi kalau dia terlalu lama bersama Jean, kami biasanya pergi kunjungi Klee supaya dia ingat kembali cara bersantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Kedengarannya merepotkan sekali ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140115,
					"content": "Hitung-hitung aku hanya menjaga keluargaku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Kalau kamu, bagaimana kamu menangani situasi seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Aku? Aku tidak punya tenaga untuk urusan ribet begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140118,
					"content": "Tapi menurutku, jika seseorang pada dasarnya memang baik, sebesar apa pun pengaruh yang mereka terima, mereka tetap akan kembali ke jati dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140119,
					"content": "Hmm ... Pengamatan yang bagus. Mungkin aku bisa terapkan cara berpikir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
