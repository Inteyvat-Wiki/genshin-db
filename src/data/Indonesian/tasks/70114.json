			"dialogs": [
				{
					"id": 701140201,
					"content": "Terima kasih sudah mentraktirku, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "Baiklah, sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
			]
