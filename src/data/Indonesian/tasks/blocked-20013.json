			"dialogs": [
				{
					"id": 200130201,
					"content": "Ternyata seorang Pengembara! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130202,
					"content": "Dapatkah kamu membantuku sebentar saja...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130203,
					"content": "Penghalang jalan di sini adalah satu-satunya yang menghambat petualanganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130204,
					"content": "Dapatkah kamu menyingkirkannya untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130205,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "Ah, andai saja aku sepertimu, aku pasti akan menjadi petualang yang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130206,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Tidak, petualangan hebatku tidak bisa berhenti di sini, kumohon tolong bantu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
