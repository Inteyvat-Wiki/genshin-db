			"dialogs": [
				{
					"id": 200130301,
					"content": "Terima kasih banyak, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Aku sedang dalam perjalanan ke suatu tempat di mana Stanley dulu pernah bertualang. Seandainya aku tahu mereka akan muncul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Aku masih belum cukup kuat, kalau Stanley, dia pasti bisa menghadapi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Jika kamu ingin bergabung denganku... ah lupakan, aku tidak bisa mengandalkan orang lain untuk segala hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Aku akan melanjutkan perjalananku. Ini untukmu, aku mengumpulkan banyak makanan sepanjang jalan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "Tapi, ini juga tidak bisa benar-benar disebut sebagai makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
