					"nextDialogs": [
						411460302
					]
				},
				{
					"id": 411460302,
					"content": "Benar juga, seingatku... Angelo tadi memesan — dan sudah melunasi — seporsi Flaming Red Bolognese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460303,
					"content": "Sesudah itu, dia meminta kami mengirimkan pesanannya ke dekat Brightcrown Canyon. Tetapi tempat itu cukup jauh dari sini dan aku kekurangan orang untuk mengantar ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460304,
					"content": "Kalau kamu mau membantuku, boleh kah kamu membantuku mengantarkan pesanan ini kepadanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
