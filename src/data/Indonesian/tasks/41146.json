				{
					"id": 411460101,
					"content": "Akan kuantarkan ke sana sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460102
					]
				},
				{
					"id": 411460102,
					"content": "Mohon bantuannya ya, tempat itu terlalu jauh dan kami sedang kekurangan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460103,
					"content": "Oh, iya, ingat untuk berhati-hati saat kamu membawanya ya. <color=#00E1FFFF>Jangan berlari terlalu cepat atau menggunakan Wind Glider, apalagi memanjat...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460104,
					"content": "Kalau kamu menabrak sesuatu di jalan, takutnya saus daging dan mi-nya akan terpisah... Kalau sudah begitu sepertinya para tamu tidak mau menerimanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
