			"dialogs": [
				{
					"id": 740540801,
					"content": "Tarik tuas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#Wah! {NICKNAME}, kamu ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Kamu menarik tuas tanpa ragu.\\nSelanjutnya, diiringi dengan suara raungan seperti gemuruh yang memekakkan telinga, seluruh menara mulai bergoyang dengan keras, seolah-olah langit runtuh dan tanah retak ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Lalu ... diiringi sebuah suara letusan, mesin tersebut mengeluarkan setumpuk pita kertas yang jatuh tepat di telapak tanganmu.\\nSemuanya kembali menjadi hening.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Cuma ... ini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Umm ... Paimon enggak ngerti apa yang terukir di atasnya, tapi kelihatannya cukup penting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, mending kita simpan pita-pita kertas ini dulu deh? Mungkin nanti bakal kepakai di suatu tempat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
