			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Semua orang sudah kasih kita petunjuk yang berguna. Ayo kita rangkum dan rapikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Beberapa dari petunjuk yang kita dapat jelas dan sederhana, tapi ada juga yang ngawur banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "Kita harusnya bisa tahu identitas dan di mana lokasinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Iya, coba aku pikirin dulu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Oke, tenang dulu Layla. Aku tahu informasinya berantakan, tapi gini doang pasti bisa rapi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(Pertama, identitas si Seelie menurut petunjuk yang dikumpulkan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Kemudian kita analisa lokasi penampakan dan tujuannya ... Lalu rangkum semua.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(Setelah itu, kita harusnya bisa menebak pergerakannya. Yuk bisa yuk!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
