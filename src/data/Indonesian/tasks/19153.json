				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Oke, aku sudah tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Dapat apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Satu, berdasarkan info yang kita terima dari Katayoun, bisa diasumsikan kalau Seelie ini murid Darshan Rtawahist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "Kemungkinan dia berasal dari Darshan lain bisa kita eliminasi, karena mustahil bisa dapat akses ke dua buku itu kalau tidak melalui si pustakawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Lalu terlepas dari cerita kemampuannya yang gila itu, semua penampakan terjadi di lokasi yang direkomendasikan Akademiya untuk observasi astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "Dengan kata lain, mungkin sebenarnya dia cuma sedang meneliti saja. Dan topik penelitiannya sangat mirip dengan punyaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "Pertanyaan yang aku taruh bukan sembarangan, tapi dia sehari saja sudah bisa jawab. Artinya dia juga paham dengan bidang studi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "Jadi kalau dengan pertimbangan seperti ini, kita hanya tinggal tunggu dia muncul di lokasi observasi astrologi berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "Pemikiranmu sudah tepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Eh, oh ... Biasa saja kok. Masih ada faktor lain yang aku curigai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "Tapi itu tidak penting. Sekarang lebih baik kita pergi, petunjuknya memang sudah jelas, tapi kan belum tentu juga kita berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Aku kasih tahu kamu nanti kalau memang si Seelie tidak muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "Hebat, kalau bisa gini sih beresin skripsi itu perkara cetek lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}