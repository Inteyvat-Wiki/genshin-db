			"dialogs": [
				{
					"id": 745120101,
					"content": "Dilihat dari data ini sepertinya penemuan ini sukses. Terima kasih ya kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Iya, makasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "Lihat kan, sudah kubilang pasti lancar! Dengan kejeniusanmu itu, Frejus, cuma meriam jarak jauh sih cetek lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "I-Iya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "Kalau begitu, ayo kita mulai dengan gadget berikutnya — aku punya ide bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "Gimana kalau bikin kapal yang bisa menjelajah di angkasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "Atau mesin penggali raksasa yang bisa ngebor sampai ke dalam tanah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Hah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Sepertinya dia sengaja mau bikin hidup si Frejus susah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Itu kayaknya terlalu susah deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Tapi kan kamu orang yang nolak tawaran Institut tiga kali. Aku yakin kamu pasti bisa kan bikin yang gituan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "Tentu saja. Yah mungkin bakal sulit, tapi bukan masalah besar sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "*huff* Aku tidak ingin hal itu terulang lagi. Terbang tinggi ke angkasa atau menjelajah ke dalam tanah, keduanya terdengar membosankan. Di atas dingin banget, di bawah pengap banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "Aku paham rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "Kalau gitu, gimana kalau bikin sesuatu yang bisa dipakai sehari-hari? Ooh! Aku kan suka tidur tuh kalau pagi-pagi, gimana kalau kamu bikin oven yang bisa masak sarapan otomatis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Ooh, itu kayaknya masih mungkin tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Pendapat awal dia emang sengaja enggak mungkin gitu deh kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Oke, biar kupikirkan dulu desainnya bakal gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Bagus! Sepakat ya — kalau ternyata memang tidak bisa, artinya kamu yang harus bikinin sarapan buat aku. Setuju, Frejus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "Apa? Permintaan macam apa itu ... Kalau begitu, kamu tidak usah khawatir, penemuan kecil macam itu sih aku masih bisa. Aku kan \"jenius\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
