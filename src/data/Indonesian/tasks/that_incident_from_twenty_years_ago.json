			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "Kayaknya di sini ada lubang pohon. Kayaknya sih kosong ya, enggak ada apa-apa di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Eh? Tunggu dulu. Kayaknya ada catatan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "\"Nara baik itu ajari Arakasyapa cara membaca. Arakasyapa harus lindungi Nara baik ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "Maksudnya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
