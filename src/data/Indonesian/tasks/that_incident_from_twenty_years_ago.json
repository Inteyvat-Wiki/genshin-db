			"dialogs": [
				{
					"id": 735200101,
					"content": "Jadi kalian berdua sudah putuskan, mau beli informasi dari aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hem ... Paimon sih memang penasaran ya sama informasi eksklusif yang kamu bilang tadi. Tapi kami mau cek harga dulu dong! Kalau kemahalan, enggak jadi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Satu juta Mora, harga pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "Mahal banget! Kayaknya batal deh. Satu juta Mora itu sudah bisa beli banyak banget makanan tauk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Tunggu dulu ... Coba kulihat dulu ... Eh? Ternyata Paimon kecil pelanggan ke-1.001 hari ini, jadi informasi yang harga awalnya satu juta Mora, sekarang bisa diberikan dengan gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Eh? Serius ada yang gituan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Tunggu dulu? Jangan-jangan ini promo menjebak nih. Gratisannya di depan, belakangnya pasti ada biaya layanan lah, biaya ini lah itu lah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "Terserah kalau tidak mau! Pelanggan selanjutnya! Pelanggan——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Tunggu, tunggu, tunggu! Paimon yang salah ngomong tadi! Kami dengar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Informasi eksklusif Dori yang pertama! Apa kalian masih ingat Mahkota Kebijaksanaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Pasti dong! Dengar-dengar cuma pemenang yang bisa pakai mahkota itu. Kayaknya sih mewah banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Benar sekali! Mahkota yang disumbangkan Sachin kepada Akademiya memang termasuk barang antik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Tapi mahkota ini pernah hilang satu kali loh setelah dia sumbangkan ke Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Eh? Kok kami enggak pernah dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Hehe ... Kalau semua orang sudah tahu sih, mana mungkin jadi \"berita eksklusif\" lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Tentu saja, tidak ada asap kalau tidak ada api. Jadi informasi ini juga punya saksi matanya tersendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "Di luar kota sebelah selatan, ada anak muda yang bernama Kashmer. Kalau kalian tertarik, kalian boleh tanyakan kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "Kata sandinya ... \"kejadian dua puluh tahun yang lalu\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
