			"dialogs": [
				{
					"id": 740660201,
					"content": "\"Seni Negosiasi\" ...? Heh! Dilihat dari namanya saja bosenin banget. Paimon sih enggak bakal tertarik yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Eh? Di sini kok ada kejepit catatan sih. \"Pergi ke tempat pendaftaran di resepsionis dan ikuti survei kepuasan internal Kantin Bersama untuk mendapatkan hadiah Kupon Khusus ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "\"Kupon Khusus\" ... Wah! Ini nih! Ada Kupon Khusus nih! Enggak disangka dapat bonus kayak gini. Yuk deh pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
