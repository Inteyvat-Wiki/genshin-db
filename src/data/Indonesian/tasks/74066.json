					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Tapi kami tetap enggak bakalan makan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "Duh ... Aku tahu kalian sudah pernah baca buku itu. Pokoknya aku tulis \"ya\" di sini ya ....",
