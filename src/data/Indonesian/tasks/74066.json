			"dialogs": [
				{
					"id": 740660301,
					"content": "Tempat pendaftaran di resepsionis ... Ini deh. Yuk kita coba keberuntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Nona Monglane, halo~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Duh, kok kayaknya serem amat.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Mau coba praktekin \"Seni Negosiasi\"?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Oh iya, Paimon sampai lupa. Enggak nyangka bukunya bakal langsung kepakai.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Coba Paimon lihat ya ... Ini dia! \"Kalau kamu menekan posisi lawanmu dengan suaramu dulu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "Ini dia! Tekan posisi lawan! Paimon mengerti, jadi suara kita harus kencang kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "HEI! NONA Monglane! HALOOO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "Aku sudah dengar kok. Butuh bantuan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Eh. Seriusan ampuh loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "Hehe. Nona Monglane. Kami datang mau ikutan survei kepuasan nih. Eh, enggak, maksudnya, Paimon datang temenin dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Jangan khawatir, {NICKNAME}. Kita kan punya buku ini. Paimon akan diam-diam buka dan kasih tahu kamu. Pokoknya ... Ya! Kamu ikutin isyarat Paimon saja ya!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Orang yang datang karena lihat catatan di dalam buku lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Iyaa! Benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Ada berapa lembar sih yang ditaruh di dalam bukunya ...? Duh. Ya sudah lah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Uhuk ... Mohon tunggu sebentar. Aku akan jelaskan peraturannya dulu. Survei kali ini berisi 5 pertanyaan, silakan jawab dengan cepat berdasarkan intuisimu. Harap diperhatikan, kamu harus menjawab dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "Sudah mengerti? Kita akan mulai kalau kamu sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
