					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Ini teori yang aneh banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "Kamu ... enggak apa-apa, kan? Kayaknya ada yang enggak beres deh. Salah makan?",
