					],
					"speakerTitle": "Tirda"
				},
				{
					"id": 250271404,
					"content": "Tapi, kalau dari pandangan pribadiku, aku bakal bilang liriknya ... sedikit terlalu kompleks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271405
					],
					"speakerTitle": "Tirda"
				},
				{
