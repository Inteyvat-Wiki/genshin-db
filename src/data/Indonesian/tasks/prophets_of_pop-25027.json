			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Tuan Milu akhirnya merilis rekaman barunya. Beli atau tidak ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Coba ceritakan soal rekaman Milu Nui ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Eh? Oh! Rekamannya bagus kok! Haloa dan Saurian kecil semua suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Setiap kali mereka tidak mau tidur, aku pasti akan putarkan lagu \"Lantunan Hari Semi\" dari Tuan Milu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Biasanya mereka bakal langsung tertidur dengan tenang sambil mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Duh, tapi Haloa selalu bilang kalau dia suka musik yang lebih intens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Kalau Tuan Milu bisa ciptakan beberapa lagu yang lebih riang, dia pasti bisa lebih senang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
