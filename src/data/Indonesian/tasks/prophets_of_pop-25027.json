						250270504
					]
				},
				{
					"id": 250270504,
					"content": "Ah ... Begitu ya? Terima kasih, semua masukan ini memang berharga sekali. Aku akan coba untuk sesuaikan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Tapi kalau dengar dari nadanya ... Kok kayaknya mereka juga anggap rekamanku itu \"lagu anak-anak\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "Tidak, tidak ... Aku harus berubah ... Tapi, mau ubah dari mana ya?",
