			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Si Pakaa ... benar-benar keras kepala! Dia sama sekali tidak mengerti falsafahku dalam musik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "Ho, kamu ... pengembara? Halo. Aku Milu Nui, seorang musisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "Kalau kamu pernah ke Xochicuicatl Records, kamu pasti sudah pernah dengar laguku di bagian musik pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Rekaman itu mengandung pemahamanku terhadap \"musik pop\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Cuma Pakaa tidak mengerti saja, dia selalu bilang \"musik pop\"-ku itu kayak \"musik anak-anak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "Apa pun yang aku bilang, dia tetap taruh rekamanku di bagian anak-anak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "Memang sih, anak-anak itu suka, dan ada orang tua yang belikan untuk anak-anaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "Tapi justru anak-anak itu pendengar yang paling jujur, kan! Dan ada banyak anak-anak di suku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Jadi, kalau rekaman populer di kalangan anak-anak, harusnya masuk ke bagian musik pop dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Yah ... benar juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Benar, kan! Heh! Aku sudah tahu Pakaa itu bodoh! Nanti setelah lagu baruku selesai, aku pasti bakal buat dia mengakuinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "Aku tidak lagi percaya selera musiknya, sih ... Pengembara, sejauh apa Anda paham soal musik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "Bisa main musik? Atau nyanyi deh, nyanyi juga boleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Semuanya pernah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "Keren! Aku yakin Anda bisa memahami falsafahku dalam bermusik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "Aku perlu orang seperti Anda kalau mau bikin lagu baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "Tenang, imbalannya pasti memuaskan. Kerja keras Anda tidak bakal sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "Baiklah. Menurut intuisi Anda apa yang harus aku lakukan pertama-tama supaya bisa menciptakan lagu yang hebat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Itu semua apaan? Enggak bisa ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "Tidak masalah kok! Orang seperti Anda ini menikmati musik dari hati. Jadi aku percaya penilaian Anda pun pasti adil dan objektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "Bisa jadi musik pop khusus anak-anak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "Falsafah musik yang gimana nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
