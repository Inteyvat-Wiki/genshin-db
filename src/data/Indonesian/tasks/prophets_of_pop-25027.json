					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Ohhh! Rekaman baru ya! Saurian kecil pasti bakal senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Coba ceritakan soal rekaman Milu Nui ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Aku suka lagunya Paman Milu. Saurian kecil di rumah apalagi, lebih suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Setiap kali mereka lagi mau kumat, Mama pasti selalu menyetel lagu Paman Milu, tidak lama kemudian, mereka langsung tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Hmm ... tapi lagunya panjang banget. Aku enggak hafal-hafal liriknya. Boro-boro nyanyi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Hehe, kalau bisa bikin lagu yang liriknya lebih pendek, aku pasti setel sepanjang hari biar anak-anak senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
