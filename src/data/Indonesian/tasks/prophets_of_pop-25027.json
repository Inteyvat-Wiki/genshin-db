					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "Meski prosesnya berliku-liku, tapi bagaimanapun, akhirnya kali ini aku bisa dapatkan sampel suara yang lumayan banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Dengan persiapan yang tepat, aku sudah bisa mulai merekam suara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
