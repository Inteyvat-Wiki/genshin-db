			"dialogs": [
				{
					"id": 250270401,
					"content": "Lihat burung-burung di sana, dengarkan kicauannya! Ah, suaranya sangat bisa dijadikan bahan untuk karya terbaruku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Tapi, kalau cuma sedikit saja kayaknya terlalu monoton. Kalau kita bisa cari kawanannya lalu merekam suaranya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Eh, itu ada kawanan Koholasaurus di depan. Dengar tidak mereka menggaruk batu pakai cakarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Mereka itu sensitif, jadi kita jangan terlalu dekat. Aku akan minta tolong Warga Mata Air untuk mengumpulkan yang aku butuh setelahnya. Mereka pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Oh, dua petarung yang sedang adu jurus. Bagus, bagus, suara pertempuran memang semerdu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Oi, siapa di sana? Ngapain kalian! Mau dihajar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Pejuang Suku yang Marah"
				},
				{
					"id": 250270407,
					"content": "Kami lagi ... ngumpulin bahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
