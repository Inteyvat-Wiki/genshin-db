					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Kita masih punya cadangan bahan untuk membuat pupuk ini, tapi \"Harra Fruit\" sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "Pengembara, apa kamu bisa bawakan Harra Fruit?",
					"roleType": "TALK_ROLE_NPC",
