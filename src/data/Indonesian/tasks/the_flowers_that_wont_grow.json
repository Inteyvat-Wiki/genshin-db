			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "Selain masalah kesuburan tanahnya, mungkin faktor \"air\"nya juga bermasalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Mungkin karena kami mengubur mawarnya terlalu dalam sehingga air yang didapatnya tidak cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "Pengembara, bantu kami sirami mawar ini bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
