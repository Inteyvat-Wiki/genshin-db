				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Huff ... sudah hampir selesai, kadar air di dalam tanah seharusnya sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "Terima kasih, Pengembara. Kalau kamu tidak membantu, kami pasti akan kewalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "Aneh ... kenapa kali ini air yang dibutuhkan banyak sekali ya baru bisa meresap ke dalam tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "Kurasa air yang kita pakai kali ini sudah dua kali lipat lebih banyak dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Mungkin itu perasaanmu saja karena sudah terlalu lelah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "Seluruh tanahnya akan tergenang air kalau disirami air dua kali lebih banyak. Tapi lihat, kelihatannya tingkat kelembapan tanah sekarang normal kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Teorinya sih begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "Semoga mawar ini bisa tumbuh dengan baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "Tenang saja, demi pasien dan dokter di \"Bimarstan\", kami pasti akan merawat mawar ini dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "Ini sebagai bentuk terima kasih kami. Harap diterima, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "Eh, tapi aku benar-benar merasa air yang kita pakai kali ini jauh lebih banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
