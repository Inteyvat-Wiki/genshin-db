				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "Harusnya sudah cukup, terima kasih banyak, pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Kesuburan tanahnya pasti jadi oke dengan pupuk khusus ini, mawarnya pasti bisa tumbuh subur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Semoga tidak seperti pupuk-pupuk sebelumnya yang tidak menghasilkan apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Kalian dulu juga sudah pernah pakai pupuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Pernah pakai yang biasa, tapi hasilnya tidak memuaskan ... atau mungkin lebih cocok kalau dibilang tidak berefek sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Tapi pupuk itu sangat berguna waktu digunakan di ladang lain, entah di mana masalahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "Ya sudahlah. Ini sedikit imbalan sebagai rasa terima kasihku. Terimalah, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
