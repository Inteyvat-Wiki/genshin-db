			"trigger": {
				"objectNames": [
					"Gurgen",
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Tidak bisa begini terus, Ayah. Mawarnya tidak tumbuh dengan normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Kita harus pikirkan jalan keluarnya. Kalau tidak, tahun ini kita tidak akan bisa menyerahkan tanaman obatnya tepat waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "Tanahnya sih baik-baik saja, rumput liar dan hama juga sudah dibasmi, terus kenapa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "Apa yang buat kalian galau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Hmm? Kamu mau beli tanaman obat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Jadi begini, kami menyiapkan tanaman obat untuk \"Bimarstan\" secara rutin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Salah satu tanaman obat yang paling penting itu \"Sumeru Rose\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Mawar juga bisa dijadikan obat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Nah kalau ini aku juga tidak jelas, harus tanya ke dokter di Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Pokoknya mereka bilang mawar ini dapat mengobati panas dalam kalau dicampur dengan obat lain. Juga bisa mengobati penyakit lambung. Ada lagi manfaat lainnya ... tapi aku juga lupa apa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "Kalau begitu, aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Kenapa dengan mawar ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Tidak tahu kenapa pertumbuhan mawar-mawar ini sangat lambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Berdasarkan pengalaman kami, biasanya ini karena tanahnya yang bermasalah atau karena ada hama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Tapi, dulu kami pernah menanam tanaman obat di sini dan semuanya bisa tumbuh subur kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "Kami membasmi hama setiap hari, jadi mustahil kalau penyebabnya itu hama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Eh, tapi sekarang fokusnya bukan apa dan kenapanya. Intinya, kalau begini terus, mawar-mawar ini tidak akan bisa dikirim ke \"Bimarstan\" tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Jadi kami berencana untuk menambah pupuk agar tanahnya lebih subur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Tapi kami berdua masih harus mengurus ladang yang lain, jadi kami tidak punya waktu untuk mengumpulkan bahan untuk membuat pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "Pengembara, demi kesehatan para pasien di \"Bimarstan\" ... apa kamu bersedia membantu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Aku bersedia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Coba aku teliti dulu situasinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
