			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Sepertinya sudah tidak ada jalan lagi... Ugh, dia pasti ada di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, lihat ke seberang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Akhirnya kamu berhasil mengejarku juga... Loh? Seorang gadis kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850304,
					"content": "Kamu pasti \"Raptor\"! Kamu tidak bisa melarikan diri lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Hahaha! Aku tidak perlu melarikan diri! Kamu tidak akan bisa ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850306,
					"content": "Huh, jurang ini memang dalam dan jaraknya pun jauh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Gadis kecil, kamu lebih baik pulang saja dan panggil Grand Master ke sini. Kalau dia ke sini, aku pasti segera menyerahkan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850308,
					"content": "Kamu menghina Outrider dari Knights of Favonius? Lihat saja, aku akan terbang ke sana dan menangkapmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Tenang dulu, Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "Huhu... Kamu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Menyebalkan, jelas-jelas dia berada di seberang. Coba saja kita bisa meluncur ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Tapi bagaimana dia bisa menyeberang ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Apa ada jalan rahasia untuk ke sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Dari pengamatanku, aku tidak melihat ada jejak jalan rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Selain itu, tidak ada tempat untuk membangun jalan rahasia di dinding tebing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Sampai jumpa, gadis kecil——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850323,
					"content": "Tidak, dia mau melarikan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Kita tidak bisa menunda-nunda lagi, mau tidak mau sekarang kita harus \"meluncur\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Jangan cemas, aku adalah juara meluncur Mondstadt. Raptor saja bisa terbang ke sana, aku pasti juga bisa melakukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Hei, Outrider! Kemungkinan selamatmu melompat ke sini jauh lebih kecil daripada kamu terjun bebas tanpa wind glider dari patung Archon Anemo di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850328,
					"content": "Aku mengerti maksud Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Benar sekali, {NICKNAME}. Selain \"meluncur\", tidak ada cara lain lagi yang memungkinkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, masih ingat buku yang aku pinjamkan kepadamu? Buku dongeng yang dikira sebagai buku panduan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "\"Burung-burung pada awalnya tidak bisa terbang. Terbang adalah hadiah mereka karena memiliki keberanian untuk terjun ke jurang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Lihat saja kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Semangat, Outrider!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Mari kita tunjukkan keberanian Outrider kepada dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Tunggu... Berhenti! Kamu tidak akan berhasil! Kamu lebih baik pulang ke rumah, gadis kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850337,
					"content": "Raptor bilang aku tidak akan pernah berhasil. Tapi, kalau kamu mendengar dengan seksama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "Sang angin mengatakan bahwa – aku bisa melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Ini akan membutuhkan keberanian yang serius, tetapi tidak sepenuhnya mustahil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Mungkin dia memakai kekuatan elemental?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, bisakah kamu melihatnya dengan Elemental Sight? Tidak ada juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Apa dia menggunakan kail, paku, atau sejenisnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Kalau jarak ini saja terlalu jauh untuk meluncur, mana mungkin bisa menyeberang hanya dengan benda-benda seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Di permukaan tanah juga tidak terlihat ada bekas paku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Amati dulu keadaan sekeliling... Ini yang pernah kamu ajarkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Yeah! Aku berhasil menangkapnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Sebenarnya aku baru menyadari arus angin tersebut saat berada di udara, dan arus angin itu satu-satunya yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Arah yang dituju Raptor untuk melarikan diri sama saja dengan bunuh diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "Dengan kata lain, kalau Raptor ingin pergi, dia harus melewati kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Aha! Jadi itulah kenapa dia terus menghasut kita untuk menyerah, sehingga dia bisa terbang kembali ke sini lalu melarikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Sayang sekali kita tidak bisa dihasut semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#Semua berkat analisa {NICKNAME}! Ini pasti yang disebut-sebut orang: \"Begitu kamu mengeliminasi yang tidak mungkin, apa yang tersisa, tidak peduli seberapa sulit dipercaya, adalah kebenaran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Singkatnya, meluncur adalah 7% teknik, 3% insting, dan 90% keberanian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Apa yang kamu lakukan tadi sepertinya 99% keberanian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, rasanya sama seperti saat pertama kali mengikuti tes meluncur... Walaupun aku sangat gugup, tapi aku berhasil mendapat SIM dengan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Sayangnya beberapa ujian setelah itu tidak pernah membuatku gugup lagi, rasanya jadi seperti kurang sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "Kamu... Tunggu sebentar. Bukannya kamu sudah mendapat SIM? Apa maksudmu dengan \"tes berikutnya\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Ah... ini karena di Mondstadt banyak larangan meluncur dan larangan mendarat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "Jadi setiap kali aku mendapat SIM pasti akan segera disita. Aku sudah mengulang tes sekitar 15 kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Dan aku selalu melewati tes hanya dengan mencoba sekali saja. Aku rasa buku panduan kecilku itu benar-benar hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
