				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "Huff ... Terima kasih Pengembara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "Untung tidak kenapa-kenapa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Namaku Elber, seorang pedagang. Awalnya aku cuma ingin istirahat di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "Tapi tidak kuduga, aku diserang Hilichurl ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Kamu tidak punya pengawal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Iya, kami sudah dengar di kota kalau para pedagang dari luar biasanya akan sewa Eremite untuk membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Aduh, aku ... aku bukannya tidak rela keluarkan biaya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "Para Eremite itu kasih harga yang tinggi sekali, satu per satu semakin tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "Aku kan cuma pedagang kecil, mana mungkin bisa bayar semahal itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "Aku kan pikir, aku juga bisa sedikit seni bela diri, rute pengiriman juga tidak terlalu jauh, makanya aku langsung berangkat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "Tapi tidak kusangka, waktu Hilichurl itu menyerang, dua Sumpter Beast-ku jadi kaget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "Sebelum aku sempat melawan, aku sudah ditabrak oleh Sumpter Beast satunya, kemudian setelah aku berdiri, aku ditendang lagi sama Sumpter Beast lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Waduhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "Lalu, dua Sumpter Beast itu melarikan diri, dan aku dikepung oleh gerombolan Hilichurl ... untung kalian datang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "Tapi semua hartaku ada di dua Sumpter Beast itu ... Pengembara, apa kamu bisa bantu aku cari mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "Aku ... aku tidak mau ditendang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Tidak apa-apa, tidak usah khawatir. Mereka sebenarnya sangat jinak, hanya saja Hilichurl-Hilichurl tersebut menjatuhkan makanan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "Mereka sudah berjalan jauh sambil mengangkut barang, jadi pasti sangat lapar. Makanya mereka jadi agresif sekali setelah makanannya dijatuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "Begitu ya rupanya ... diganggu waktu makan dan makanannya dijatuhkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Huuuh, pasti kesal sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "Paimon cepat ya kalau yang beginian ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Begini saja ... kutitipkan makanan ini padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Setelah kalian temukan Sumpter Beast, kasih makanan ini ke mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "Asal ada makanan, mereka pasti tidak akan mengamuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "Aku dulu pernah perhatikan, ada satu Sumpter Beast yang menabrak Hilichurl, terus dia lari begitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "Satunya lagi sepertinya dibawa kabur sama Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "Aku akan tandai perkiraan arah ke mana dua Sumpter Beast itu pergi ... aku serahkan ini kepadamu ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "Asal barang-barangku kembali, aku pasti akan kasih imbalan yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "Aku ... aku takut ditabrak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "Tak ada orang yang melindungimu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Hanya masalah kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
