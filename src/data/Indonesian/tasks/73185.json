				},
				{
					"id": 731850504,
					"content": "Paimon yang kasih makanannya saja deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "Ka-kamu saja! Cepat! Hus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Selamat menikmati ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "Soal kakimu, itu bukan sengaja ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "Sumpter Beast menelan makanannya dengan perlahan, kakinya mulai terlihat sedikit tenang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Dia kayaknya enggak kesal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "Ayo cepat kita bawa dia pulang, hati-hati ya! Jangan sampai ditendang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850511,
					"content": "Kembali ke tempat Elber bersama dengan Sumpter Beast",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Baguslah ... kukira Sumpter Beast ini benar-benar sudah hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850513,
					"content": "Terima kasih, terima kasih sekali, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850514,
					"content": "Aku harus segera periksa kondisi Sumpter Beast ini, semoga dia tidak terluka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "Elber"
				},
				{
