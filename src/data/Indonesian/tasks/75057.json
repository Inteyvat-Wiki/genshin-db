			"dialogs": [
				{
					"id": 750013201,
					"content": "Luar biasa. Sungguh terjadi, dan sungguh berhasil. Seperti di dalam cerita dan lagu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "Suara yang riuh dan nyaring tiba-tiba senyap. Paku Bayangan Kecil kembali ke posisinya semula, jatuh dari langit menimpa bumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "Wah ... ternyata sungguh ada yang bisa ... ini bukan mimpi, kan? Kalian semua nyata? Aku tidak halu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Bangun! Bangun! Benerin sendiri sana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "WOI, tega amat sih kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#Tapi apa kata Paimon tadi? Si {NICKNAME} tuh super kekar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Kamu juga setuju kan, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}, kamu sama sekali tidak terpengaruh sama Abyss ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Santai, cuma Abyss doang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Bahkan para pejuang kami yang paling kuat pun harus selalu waspada ketika berhadapan dengan Abyss. {NICKNAME}, kamu bukan orang sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Haha, kalau begini, bisa jadi cerita yang kubuat dari peristiwa ini bisa melebihi ceritanya Sanhaj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Keren sih, tapi Sanhaj itu siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Yah, bagi kalangan \"orang yang menuturkan cerita kepada sukunya\", nama Sanhaj dari suku Penguasa Angin Malam memang layak dijadikan panutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Waktunya semakin singkat. Aku akan bercerita soal Sanhaj di lain kesempatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Baiklah. Ayo kita ke Paku Bayangan Kecil berikutnya. Aku mau segera menyelesaikan masalah ini, dan mulai menulis setelah matahari terbenam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "Siap! Berangkat~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Sejauh ini belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Wah, padahal aku datang buat cari tahu suara mengerikan itu asalnya dari mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Sambil bilang ke diri sendiri \"Titu, bukan apa-apa kok\". Tapi ini ternyata apa-apa! Apa-apa banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "Dan ada Tepetlisaurus kecil juga ... kamu ya, yang bawa dua orang asing ini ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "Dan ... kamu yang menjatuhkan Paku Bayangan-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "Tidak boleh ... ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Eh? {NICKNAME}, kita bikin salah lagi ya ini? Duh. Untung yang lihat cuma satu, kita bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha, jangan gitu lah! Salah? Kebalikannya! Kalian berjasa besar. Jadi namamu {NICKNAME}? Kalau temanmu? Siapa namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#Dia {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Namaku Titu, orang yang menceritakan {RUBY#[D]penutur cerita} kisah-kisah kepada suku kami. Aku juga ditugaskan untuk \"menjaga dan mengawasi\" pilar batu di lembah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "Dan tentunya, Paku Bayangan Kecil yang kamu jatuhkan barusan ... satu dari tiga, adalah urusanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "U-Urusan ... waduh, kita mesti bayar ganti rugi ya? Gara-gara jatuhin pilar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Dih, tahu gini jangan kasih tahu nama asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Ganti rugi ... \"Titu tiba-tiba mendapat pencerahan. Mungkin dirinya bisa menggunakan kesempatan ini untuk memaksa kedua orang yang baru dia temui membantunya mencapai tujuan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "Nah, bagus tuh buat dijadiin cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, maaf. Aku terlalu fokus memikirkan soal cerita. Aku bertugas {RUBY#[D]penutur cerita} menceritakan kisah-kisah ini ke warga suku. Sudah bertahun-tahun lamanya, aku perlu cerita baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "Dan tentunya, beberapa hari setelah aku merenung, Paku Bayangan-nya malah bertingkah. Ini ibaratnya kayak ... Kalau mau tampar orang, kenapa cuma sekali? Ya berkali-kali lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Ehem. Intinya, aku bukan mau memeras kalian. Pikir saja, masa niatan jelek disebutin terang-terangan kayak barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Kita sudah kenalan, sudah tahu nama masing-masing, tapi tinju belum melayang. Berarti kita sudah berteman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Karena itu ... apa kalian bersedia mendengar permintaan seorang teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Asal bukan minta ganti rugi, silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Tidak, tidak kok! Bukan itu. Gini ... waktu kalian jalan di lembah tadi, apa kalian melihat Phlogiston padat raksasa yang berukirkan pola-pola warna emas tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Lokasinya di tengah-tengah lembah. Kelihatan jelas dari mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Kayaknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "\"Urusan\"-ku tadi ada kaitannya dengan pilar batu raksasa itu. Namanya Paku Bayangan ... dan belakangan ini dia sedang bermasalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "Jujur, aku tadinya sudah menyerah. Lalu tiba-tiba kalian muncul. Ceritanya saja sudah kepikiran, \"Paku Bayangan-nya tak bisa dipulihkan, suku kita pun tertimpa musibah yang mengerikan\" ... lumayan kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Hah? Itu kan cuma pilar batu. Masa sih bisa sengeri itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "Terus, Paku Bayangan Kecil ini apaan sih? Yang kami jatuhin tuh yang \"kecil\"? Yang di tengah yang \"gede\"? Bukannya sama saja ya, pilar batu gede semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "Hmm. Kalian berdua orang asing, berarti ini perlu dijelaskan dulu sedikit. Ini berhubungan dengan legenda yang diceritakan turun-temurun di suku kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "Alkisah, Wayob menaruh Paku Bayangan di tempat ini untuk menahan bayangan Raja Gunung Berapi pada tempatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Tapi sebenarnya, yang \"ditahan\" di bawahnya itu Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "Begitulah sifat cerita-cerita di Natlan. Kisah yang dibumbui narasi, retorika, dan perumpamaan. Fungsinya sebagai peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Hah, apa?! Serius, yang disegel di bawah sini tuh ABYSS?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Betul sekali. Dan baru-baru ini, dua dari total tiga Paku Bayangan tercabut dan melayang ke langit. Kalau yang ketiga juga lepas, maka segala kejahatan yang ada di perut bumi akan naik seperti air pasang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Jadi jujur saja, kalian yang tidak sengaja menjatuhkan pilar batu itu adalah keberuntungan buat orang kami. Jelas tidak usah ganti rugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "Malahan, aku ingin minta tolong kalian jatuhkan yang lainnya sekalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Wah ... {NICKNAME}? Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "Kalau Abyss terlibat, kita tidak bisa tinggal diam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Bahkan si {REALNAME[ID(2)|SHOWHOST(true)]} saja semangat ya. Okelah kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Aih, laksana lidah api yang membara di tengah kegelapan, demikianlah para pahlawan bangkit di masa kesusahan besar. Kejayaan manusia bersinar terang pada saat-saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Ini bisa jadi bahan cerita yang bagus juga. {NICKNAME}, kamu punya sesuatu yang bahkan tidak dimiliki oleh para pahlawan di dalam cerita. Aku menantikan sepak terjangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "Baiklah. Mari berangkat, wahai para pahlawan. Kita lihat kondisi Paku Bayangan terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Mungkin aku bisa bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Tidak tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Hmm. Padahal itu kelihatan banget. Ya sudahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Ini ulah si Paimon. Aku cuma kebetulan lewat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "BESTIEEE! Gitu terus tiap ada kejadian kayak gini! Kenapa sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "Haha, tenang. Justru kejadian ini bisa bikin semua orang lega. Namamu Paimon? Kalau temanmu? Siapa namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}