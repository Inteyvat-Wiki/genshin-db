			"dialogs": [
				{
					"id": 221100301,
					"content": "Bagaimana? Apa Ruin Hunter sudah dikalahkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Ruin Hunter berhasil kamu tangani dalam satu hari kerja... Mungkin aku pernah merasa ragu akan kemampuanmu, namun sekarang rasa ragu itu sirna dalam seketika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "... Masih belum menemukan sesuatu yang berhubungan dengan \"pedang\" ya? *huff* Aku mulai membenci suaraku saat melontarkan pertanyaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "Jangan cemas. Aku telah menyiapkan sejumlah imbalan untukmu. Kamu selalu menyelesaikan misi dengan baik. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "\"Hidden Blade\", di manakah kamu disembunyikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Kamu akan menemukannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "... Apa kamu sedang menghiburku? Terima kasih, tapi masalah sekecil ini tidak akan membuatku merana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Tidak peduli berapa lama, dan ke mana pencarian ini membawaku... Aku akan menemukan pedang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Aku akan memperluas lokasi pencarian. Mungkin suatu hari nanti aku akan meminta bantuanmu lagi. Tenang saja, aku akan memberimu imbalan yang memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Ini imbalanmu. Aku harus pergi karena ada beberapa misi yang harus dicek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "Hidden Blade... Aku pasti akan menemukanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Misi-misi ini tidak berhubungan dengan pedang sama sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Semua itu karena semua misi yang berhubungan dengan \"pedang\" sudah kuselesaikan. Namun hasilnya tetap nihil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Jadi aku merasa... hanya satu hal yang dapat membuat kakakku kehilangan senjatanya, yaitu saat di mana dia menghadapi situasi yang sangat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Lalu aku mulai menerima misi-misi lain yang cukup berbahaya untuk mencari petunjuk keberadaan Hidden Blade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Jumlah misi yang berbahaya cukup banyak dan aku tidak sanggup menyelesaikannya sendirian. Oleh karena itu aku meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
