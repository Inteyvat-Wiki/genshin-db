			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Ini tidak berguna sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "... Sepertinya kamu punya banyak waktu luang. Entah karena kemampuan kamu terlalu kuat atau karena terlalu lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Tapi seharusnya kemampuanmu tidak akan terlalu lemah. Misi-misi yang kuberikan telah kamu selesaikan dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Karena kamu punya banyak waktu luang, maka terimalah lagi misi dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Tapi target misi kali ini cukup berbahaya. Aku ingin kamu mengalahkan \"Ruin Hunter\". Bagaimana? Apa kamu bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Kamu benar-benar seorang petualang yang sangat optimis, sama seperti kakakku... Mungkin saja suatu hari nanti kamu akan sehebat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Sudah, obrolannya cukup sampai di sini. Lokasinya berada di Guili Plains. Bersiap-siaplah kemudian pergi kalahkan Ruin Hunter itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Setelah mengalahkannya, jangan lupa cari sesuatu yang berhubungan dengan \"pedang\" dan bawa pulang untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "... Tapi kalau tidak ada, ya sudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Semoga beruntung. Semoga pencarian pedang kali ini berbuah manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Apa kali ini aku masih harus mengamati keberadaan \"pedang\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Ya, setelah mengalahkan Ruin Hunter, jangan lupa perhatikan sekeliling dan carilah sesuatu yang berhubungan dengan \"pedang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Aku harus memperingatkanmu kalau Ruin Hunter adalah lawan yang kuat. Kamu harus memusatkan perhatian padanya jika ingin mengalahkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "Dan untuk sesuatu yang berhubungan dengan pedang - alangkah baiknya jika kamu menemukannya, tapi tidak masalah juga bila kamu tidak menemukannya. Sedangkan untuk Ruin Hunter, aku akan membayarmu bila kamu mengalahkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
