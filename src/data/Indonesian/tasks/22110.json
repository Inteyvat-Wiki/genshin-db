			"dialogs": [
				{
					"id": 221100201,
					"content": "Bagaimana? Apa Ruin Hunter sudah dikalahkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Tidak apa-apa. Untuk mengalahkan Ruin Hunter, kamu memang harus melakukan persiapan yang matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
