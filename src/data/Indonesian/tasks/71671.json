				]
			},
			"dialogs": [
				{
					"id": 716710101,
					"content": "Wah, Domain ini kacau banget. Pantas Yelan saja pusing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710102,
					"content": "Pertempuran zaman dulu mana yang lagi direka ulang di sini? Kayaknya sih yang bikin pasukan kewalahan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710103,
						716710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710103,
					"content": "Perang Archon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				},
				{
					"id": 716710105,
					"content": "Ih, jangan asbun! Jangan, jangan, jangan! Gila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710106,
					"content": "Ah, kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710107
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710107,
					"content": "Hmm, dan kalau lihat dari muka ... kalian kembali membawa kemenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710108
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710108,
					"content": "Iya dong! Tapi di dalam sana asli, asli mencekam banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710109,
					"content": "Kamu menjelaskan pertempurannya ke Keqing dan Yelan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716710110
					]
				},
				{
					"id": 716710110,
					"content": "Luar biasa ... kalian mengalami semua itu dan tetap bisa menang! Hebat. Kerja bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710111
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710111,
					"content": "Setelah kalian masuk, jumlah monster yang keluar berkurang drastis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710112,
					"content": "Dan meski akar masalahnya belum berhasil diberantas, tapi kalian sukses melemahkan gangguan Ley Line-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710113,
					"content": "Yang artinya, monster yang keluar juga lebih lemah. Nah, sekarang prajurit biasa juga sudah cukup kuat untuk melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710115,
						716710116
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710115,
					"content": "Atau ... suruh mereka masuk Domain itu. Biar tahu bahaya sungguhan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710117,
					"content": "#{NICKNAME}, kamu kenapa ih? Kok malah jadi senyum-senyum gitu? Jangan haus darah woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710118,
					"content": "#Oh, satu lagi. Kita dapat surat dari Yujing Terrace. Tianquan dan Kaiyang dua-duanya setuju untuk secara resmi membina hubungan kemitraan jangka panjang dengan {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710119
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710119,
					"content": "#Berkat usaha {NICKNAME} yang tak kenal lelah, gangguan Ley Line kali ini mungkin malah bisa dijadikan keuntungan bagi pihak kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710120
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710120,
					"content": "#{NICKNAME} berhak menggunakan semua sumber daya yang ada di garnisun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710121
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710121,
					"content": "#Selama gangguannya masih aktif, Millelith akan mengurus semua monster yang kabur dari Domain, sekaligus mengasah kemampuan tempur mereka di lapangan. {NICKNAME} sendiri tentunya bebas keluar masuk Domain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710122
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710122,
					"content": "Situasinya berbalik. Awalnya krisis, sekarang jadi ajang latihan untuk anak baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710123,
						716710124
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710123,
					"content": "Kabar baik dong. Aku juga akan terus berikan yang terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710125,
					"content": "Fiuh ... lega banget dah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710126,
					"content": "Nah, tadi kita lagi ngobrol apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710127,
					"content": "Oh, Ley Line. Kata kamu Ley Line tuh menarik banget enggak sih? Coba kalau ada cara buat keluarin semua rahasianya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710128,
					"content": "Siapa tahu suatu hari nanti kita ketemu orang pintar yang kasih kita buku \"Primbon Ley Line: Anda Bertanya Buku Ini Menjawab\", atau apa gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710124,
					"content": "Bahayanya sudah lewat, aku akan tetap dukung kalau dibutuhkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710116,
					"content": "Gangguan Ley Line ini bukan musuh biasa, perlu waktu kalau mau dibasmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710104,
					"content": "Bencana Khaenri'ah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				}
			]
		}
	]
}