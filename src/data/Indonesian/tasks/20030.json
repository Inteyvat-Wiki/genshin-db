					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "Selamat datang di <color=#00E1FFFF>Adventurers' Guild</color>. Aku sudah mengawasimu sejak lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300102,
					"content": "#Mengawasi {NICKNAME}? Eh, apa dia membuat masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Oh tidak tidak, tapi mengawasi petualang hebat juga adalah tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300104,
					"content": "Saat aku melihatmu, aku bisa melihat sebuah potensi yang sebanding dengan seorang petualang legendaris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300105,
					"content": "Paimon juga bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Paimon selalu merasa aman saat bertualang bersama {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Ya, tapi bagi petualang, pengalaman jauh lebih penting daripada potensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300108,
					"content": "Kamu harus terus mengumpulkan <color=#00E1FFFF>\"Adventure EXP\"</color> untuk meningkatkan <color=#00E1FFFF>\"Rank Adventure\"</color> milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300109,
					"content": "Tanpa membuang banyak waktu lagi, izinkan aku memperkenalkanmu kepada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300110,
					"content": "Tunggu dulu! Maksudmu sekarang kami sudah menjadi petualang resmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "Jangan khawatir, Adventurers' Guild tidak akan membebani anggotanya dengan berbagai biaya atau kewajiban lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300112,
					"content": "Dengan kata lain, banyak keuntungan yang bisa didapatkan oleh anggota, dan tidak ada kerugiannya sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300113,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "Singkatnya, setiap kali Rank Adventure meningkat, Adventurers' Guild akan memberimu hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300117,
					"content": "Ini hadiah karena telah menjadi anggota, harap dikonfirmasi terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300118,
					"content": "Hadiah Adventure Rank",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Berikan aku keuntungannya sekarang juga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Haha... Anak muda sekarang ini benar-benar terus terang sekali ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "Tanpa basa-basi lagi, izinkan aku untuk menyambutmu karena telah bergabung dengan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Ini <color=#00E1FFFF>Panduan Petualang</color> milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "Eh, ada sertifikatnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "Bergabungnya anggota baru adalah hal penting, tentu saja harus ada upacaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Ini mencatat banyak informasi mengenai komisi dan imbalan dari Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Ini juga merupakan bukti keanggotaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Oh ya, masih ada satu hal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "Terkadang, kamu akan merasa terhambat saat sudah mencapai Rank Adventure tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "Jika itu terjadi, kamu harus menyelesaikan beberapa misi luar biasa untuk bisa mendapat pengakuan dari Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "Misi yang...luar biasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Singkatnya kita dapat menyelesaikan beberapa petualangan untuk naik ke Rank Adventure berikutnya. Sejenis Misi Ascension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Tapi itu urusan nanti. Kesempatan akan datang dengan sendirinya saat kamu sudah memiliki banyak pengalaman bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Baiklah, hari ini cukup sampai di sini saja, masih banyak kesempatan untuk kita bertemu di lain waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "Berjuanglah petualang! Gapailah cita-citamu bagaikan bintang di langit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Apa ini... selebaran iklan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Iya, tapi penggunaannya lebih praktis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}