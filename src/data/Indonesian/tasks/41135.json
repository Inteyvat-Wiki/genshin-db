			"dialogs": [
				{
					"id": 411350301,
					"content": "Apakah kamu sudah membasmi monster-monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "Aku sudah membasminya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "Terima kasih banyak, Pengembara. Seharusnya mereka sudah tidak berani macam-macam lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "Sebaiknya kamu segera kembali ke kota. Aku sangat tidak enak hati karena harus membuatmu berada di luar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "Ah, kalau kamu sudah kembali ke kota... Bolehkah kamu membantuku memperhatikan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "I... ini hal yang sangat mudah! Kamu hanya perlu memperhatikan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Saat kamu kembali ke kota... Bisakah kamu menolongku untuk memastikan bahwa Glory aman-aman saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "Seharusnya sih dia aman-aman saja karena ada di dalam kota. Tapi aku tidak bisa berhenti mengkhawatirkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "Tolong bantu aku melihat keadaannya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "Terima kasih, Pengembara. Oh iya, jangan bilang ke Glory kalau aku ada di sini. Bilang saja aku masih bertugas di tempat yang sangat jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "Maaf ya, aku mohon katakan padanya seperti yang kubilang tadi. Aku punya alasanku sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
