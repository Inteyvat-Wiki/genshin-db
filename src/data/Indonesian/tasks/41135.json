			"dialogs": [
				{
					"id": 411350401,
					"content": "Semoga Godwin baik-baik saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Godwin memintaku untuk datang menjengukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin? Apakah kamu tahu dia ada di mana? Aku sudah lama tidak mendengar kabar darinya, aku sangat khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "Dia masih bertugas di sebuah tempat yang sangat jauh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Oh, begitukah? Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "Kalau tidak ada batu-batu meteorit ini, aku pasti sudah menanyakan lokasi dia kepada para Knights of Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "Aku baik-baik saja karena aku terus berada di dalam kota. Tapi Godwin pasti menjalankan tugasnya di luar sana, sedangkan batu-batu meteorit ini jatuh ke seluruh penjuru dunia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "*huff* Aku hanya berharap dia baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "Dia pasti baik-baik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Terima kasih, itulah yang paling penting. Oh iya, bisakah kamu membantuku sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "Aku sudah membeli beberapa Dandelion Seed dari Flora. Awalnya aku ingin meminta bantuan seseorang untuk menebarnya dari suatu tempat tinggi... agar angin bisa membawanya kepada Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "Tapi kamu juga tahu sendiri kondisi di kota sekarang ini, benar-benar tidak ada orang yang sempat membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Berhubung kita bertemu di sini, apa kamu keberatan untuk membantuku mengirimkan Dandelion Seed ini kepada Godwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Terima kasih! Dia pasti ada di tempat yang sangat jauh sekali sekarang. Apalagi dia sedang melakukan ekspedisi bersama dengan Grand Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350416,
					"content": "Tolong berikan Dandelion Seed ini kepadanya, sampaikan kepada dia kalau aku baik-baik saja. Lalu minta dia untuk selalu menjaga diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
