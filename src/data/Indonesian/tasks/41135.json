			"dialogs": [
				{
					"id": 411350101,
					"content": "Bagaimana kabar Glory sekarang ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "Ah, halo Pengembara. Saat ini sangat berbahaya berada di luar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "Kalau kamu ingin mencari tempat aman, sebaiknya kamu segera kembali ke kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "Bagaimana dengan kamu sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Aku... untuk sementara waktu ini tidak akan kembali dulu. Aku tidak akan meninggalkan tugasku sebagai Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "Aku tidak bisa pulang ke kota Mondstadt karena beberapa alasan. Tapi aku masih bisa membantu dengan cara lain di luar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "Setelah batu meteorit itu jatuh, banyak monster yang terkena efeknya dan menjadi lebih ganas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "Kalau didiamkan saja, lama-lama akan menjadi sangat berbahaya. Aku sedang bersiap-siap membasmi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Kamu bisa sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Yah, meskipun jumlah mereka cukup banyak... Asalkan aku berhati-hati harusnya... harusnya sih bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "Tapi kalau aku membasmi mereka sendirian, tidak tahu kapan akan beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "Pengembara, maukah kamu membantuku membasmi beberapa kemah monster-monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Terima kasih banyak, kamu benar-benar membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Kenapa kamu tidak meminta bantuan Knights of Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Meminta bantuan mereka? Bagaimana ya... Aku tidak bisa meminta bantuan mereka karena alasan tersendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Tolong bantu aku untuk membereskan kemah monster-monster itu. Anggap saja ini juga kontribusimu dalam membantu Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
