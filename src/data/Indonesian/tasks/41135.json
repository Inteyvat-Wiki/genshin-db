					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "Tapi seandainya pun dia mendapat kabar, sepertinya dia juga tetap tidak bisa segera ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
