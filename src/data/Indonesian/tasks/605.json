			"dialogs": [
				{
					"id": 6050201,
					"content": "Kalian, terima kasih sudah berjuang mempertahankan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "Sisanya biar kami saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Kapten Kaeya, Swan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "Eh! Aku baik-baik saja. Kakimu tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, kalian berdua sebaiknya minta diobati dulu di gereja. Jangan memaksakan diri, sisanya biar kami urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Tapi, Tuan Diluc ... Bukannya Anda sudah keluar dari Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "Lalu? Memangnya cuma Knight saja yang boleh jaga gerbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "Biarkan. Tuan Diluc memang ... orang yang ringan tangan, seperti biasa. Kalau ada warga biasa yang mau bantu, kenapa harus ditolak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "Baik. Terima kasih untuk bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "Ya, terima kasih banyak! Kami akan segera kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "Sekarang aku ada waktu luang, rencananya mau bikin ramuan untuk orang-orang yang masih bertarung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051105,
					"content": "Rencana bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Ingat, hati-hati ya. Aku tahu kemungkinannya kecil, tapi kalau misal kamu ketemu situasi yang tidak bisa ditangani sendiri, mundur ke tempat aman. Jangan cemaskan kondisi garis depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
