				"points": []
			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "Aku tidak tahu ... apakah cara ini akan berhasil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Kamu masih mencari pedangmu itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "Oh, ternyata kamu, Pengembara. Benar sekali, aku masih mencari Unseen Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Tapi sampai sekarang, aku masih belum dapat petunjuk yang jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Tapi apa boleh buat. Mencari pedang di Liyue itu ... ibarat mencari jarum di tumpukan jerami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Ada yang bilang kalau dari dulu sudah dihancurkan oleh monster. Tapi kalaupun benar, aku tetap akan cari setiap bagian dari pedang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "Maaf, bicaranya jadi meluas ke mana-mana. Aku sudah menandai lokasi yang perlu diperiksa kali ini di petamu. Mohon bantuannya ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Semoga saja ... pedang itu tidak benar-benar hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
