			"dialogs": [
				{
					"id": 210330403,
					"content": "Gagang pedang ini ... kelihatannya masih utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Ada hubungan sama Unseen Razor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Harus diteliti lebih jauh dulu ... Oh iya, selama beberapa waktu ini aku juga mencari bagian pedang itu ke berbagai tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "Aku sudah mengumpulkan banyak sekali bagian senjata. Ada yang beli di pasar, alam liar, bahkan beli dari petualang lain ... Kupikir bisa jadi petunjuk untuk menemukan Unseen Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Tapi sampai sekarang, aku masih belum menemukan titik terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Ah, tidak apa lah. Kita punya pepatah di Liyue, \"di mana ada tekad, di situ ada jalan\". Aku akan terus mencari sampai menemukan Unseen Razor itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "Pengembara, ini. Terima kasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
