				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "Lari lagi ... dan cuma sisa satu yang masih pakai ban renangnya ... gimana ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Berapa lama lagi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Hmm ... ada yang lagi foto-foto Flowcurrent Bird ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Yah, memang lucu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Iya, goyangannya itu loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Ya kan? Lucu, goyang kiri kanan kalau jalan. Lalu gembung jadi kayak bola dan mengambang-ngambang di air ... ahhh ... senang banget lihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Bagus sekali, nona muda warna putih! Ya, pencipta para Flowcurrent Bird ini memang layak dipuji dan ditinggikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "Mereka memang— ... Ah, kita belum kenalan ya. Namaku Jonvelle, seorang fotografer pecinta Flowcurrent Bird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Nama Paimon ... Paimon, dan dia {NICKNAME}. Tapi kenapa kamu menghela napas terus? Sekeliling kamu kan Flowcurrent Bird semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Ceritanya panjang ... intinya, banyak yang seperti aku, dan semuanya ingin ambil foto paling menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Berapa hari kemarin aku dapat ide jenius ... masukin semua Flowcurrent Bird yang ketangkap Kamera-ku ke dalam ban renang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "Tujuannya buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Yah, tidak buat apa-apa sih. Flowcurrent Bird kan bisa berenang, jadi sebenarnya tidak perlu ban renang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "Tidak ada artinya! Sama seperti mengeluarkan Mora untuk mendapatkan Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Kayaknya ... itu terlalu maksa deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "Ya, fotografi seperti ini memang harus selalu mencari makna yang lebih dalam dari selembar foto ... dan di situlah letak permasalahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Ya, Flowcurrent Bird yang asli kan tidak pakai ban renang. Alhasil, adegan itu mustahil diabadikan ke dalam bentuk foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Yah, kan kamu sendiri yang maksa nyari \"makna yang lebih dalam\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Eh, bisa kita kan yang pasangin ban renang ke Flowcurrent Bird-nya? Yuk, {NICKNAME}, sesama pecinta burung harus saling bantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Yes, makasih loh, sesama pecinta burung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Be-tul-tul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Wah, serius? Mau bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hehe, asal kami kebagian jatah foto lucu saja kalau sudah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "Ba-Baiklah! Aku utang budi sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Aku ... lebih suka Flying Squirrel kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Eh, jangan ngomong gitu sekarang dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Ya, ini bukan sesuatu yang dipikirin orang biasa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Flowcurrent Bird yang bisa berenang dan mengambang dengan aman ... pakai ban renang. Nah, kan fotonya jadi punya makna tertentu yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Ya, \"pemakaian berlebihan\" dan \"sia-sia\" ... seperti itu maknanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Aku masih lebih suka Flying Squirrel sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Yah, itu juga lucu. Tapi masa tega sih bilang \"Flying Squirrel lebih lucu\" langsung di depan Flowcurrent Bird-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
