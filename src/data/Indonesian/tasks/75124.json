			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, pas sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Aku nyaris tidak percaya urusan foto mustahil ini bisa beres secepat ini ... berkat bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Flowcurrent Bird, goyangannya, badannya yang bulat duduk di ban renang! Adegan yang begitu luar biasa, aku sampai terharu lihatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "Memangnya sampai sebegitunya ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Kadang tujuan hidup yang kita kejar sampai akhir hayat memang tidak untuk dimengerti oleh orang lain yang menyaksikan ... bahkan mungkin di cap gila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Tapi aku yakin dan percaya pecinta Flowcurrent Bird akan semakin bertambah jumlahnya ... selama kabar baik dan foto-foto ini terus aku tambah dan sebarkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Paimon juga yakin dan percaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Ah, terima kasih banyak! Ini, silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
