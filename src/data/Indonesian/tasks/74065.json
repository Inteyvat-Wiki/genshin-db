			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Kok baru datang sih! Semua Fontemer Aberrant sudah habis kami sikat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Jadi begitu, akhirnya terjadi juga kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "Apanya yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "Jadi waktu aku sampai di tempat kejadian, kerjaannya sudah diselesaikan sama orang lain. Aku tidak perlu ngapa-ngapain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "Ini untuk kalian. Terima kasih ya! Malam ini tidurku pasti nyenyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
}