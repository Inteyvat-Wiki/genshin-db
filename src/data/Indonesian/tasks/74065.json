			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Eh, eh ... Kalian kan {NICKNAME} dan Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650102,
					"content": "Apa kita saling kenal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Jangan bersikap dingin begitu. Aku masih ingat betul kejadian waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650105,
					"content": "Kejadian waktu itu ... Ah! Kami masih punya banyak pertanyaan yang mau ditanyain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "Iyakah? Aduh ingatanku ... Waktu itu apa ya? Aku lupa semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650107,
					"content": "Orang bijak bilang, daripada memikirkan masa lalu, lebih baik memikirkan masa depan. Bagaimana kalau kita bahas kerja sama untuk masa depan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650108,
					"content": "Sekarang aku punya lowongan kerja bergaji tinggi, tapi khawatir malah kurang orang. Kalian berdua mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650109,
					"content": "Hmm, jangan kira kami bisa terjebak dengan mudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "Imbalannya bagus, gimana nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "#Itulah alasan aku suka berbisnis dengan orang seperti {M#Tuan}{F#Nona} {NICKNAME}! Jadi, eh ... sepakat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650113,
					"content": "Begini, kuhitung-hitung dulu. Kalian pasti puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650114,
					"content": "Seratus Kupon Khusus. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650115,
					"content": "SERATUS?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Hmm, kagum kan sama orang baik sepertiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650117,
					"content": "Buat beli botol Fonta saja kurang deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "NAH! Paimon sih enggak nyangka banget kamu berani ngomong cuma segitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "Aku masih kurang baik? Aduh, dasar anak muda seperti kalian ... jeli sedikit dong menilai kebaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650122,
					"content": "Kalian jangan salah, kalau disuruh kerja yang gampang tapi untung begini, orang-orang miskin di luar sana juga rebutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650123,
					"content": "Decembre, tukang tipu sialan! Akhirnya ketangkap juga. Terakhir aku lihat kamu mondar-mandir dekat kamar surat, terus berani suruh-suruh pendatang baru kerja dibayar murah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME}, Paimon? Kalian tidak termakan bualan ngawurnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "*hiks* Sudah pernah sih, ketipu sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "Huh, ternyata aku terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Pokoknya jangan percaya sepatah kata pun darinya. Dia sengaja mengincar pendatang baru di Benteng Meropide, ataupun pendatang yang relatif belum lama dan kurang paham aturan di sini. Sudah banyak orang yang ditipunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "Eh, menipu apanya ... enak saja! Memangnya apa bedanya kita? Kalian para penjaga juga menggunakan Kupon Khusus untuk mengirim orang bekerja serabutan, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650132,
					"content": "Tapi kami tidak akan menyelundupkan sebagiannya untuk masuk kantong sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "Maksudnya apa? Jangan asal main tuduh dong kalau tidak ada bukti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650134,
					"content": "Heh. Mau lihat bukti ya? Yuk. Ruang Tahanan itu tenang dan luas, memang cocok untuk lihat data. Benar-benar deh. Jelas-jelas masih ada kerjaan di Tambang Geode yang menungguku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#Oh ya, {NICKNAME} dan Paimon, kalau sedang senggang, boleh bantu aku tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "Memangnya kami kelihatannya selalu senggang ya?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "Kalau imbalannya mantap sih, aku bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Haha! Tentu saja akan sesuai aturan. Kalian pasti tahu standarnya. Aku tidak tipu juga, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Jadi begini masalahnya, ada Fontemer Aberrant di Tambang Geode ... Kalau dibiarkan begitu saja, mungkin akan ada bahaya, makanya harus dibereskan secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Aku antarkan dia ke Ruang Tahanan dulu. Serah terima dengan teman-temanku mungkin tertunda sebentar ... Kalau semua administrasinya sudah beres, aku akan ke sana cari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Oke, kalau begitu jangan kelamaan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Pasti secepatnya, tapi administrasinya sih ... Aku tidak bisa jamin ya seberapa lama. Untuk masalah yang di sana, aku minta tolong sama kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Kali ini sih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "Kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Hmm ... ya waktu itu sempat terjadi beberapa hal sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "Kalau aku yang kasih kamu seratus supaya kamu bantuin aku kerja, aku masih untung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Wah, jangan-jangan ini yang kamu rencanakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "Perasaanku enggak enak nih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
