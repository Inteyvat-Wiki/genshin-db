			"dialogs": [
				{
					"id": 700070801,
					"content": "Tentang kebisingan di perpustakaan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Jadi begitu... Kurasa kita bisa menggunakan \"metode itu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Nona Lisa pernah bilang jika seseorang melanggar peraturan perpustakaan, dia harus dihukum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "Bolehkah kamu masuk ke dalam perpustakaan dan menyampaikan pesan Nona Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Merusak halaman buku, menyelipkan mawar ke dalam buku, meletakkan buku ke rak dengan cara yang salah... semua ini jelas merupakan pelanggaran peraturan perpustakaan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Ayo kita pergi dan sampaikan pesan Lisa kepada orang-orang di perpustakaan yang datang berbuat ulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
