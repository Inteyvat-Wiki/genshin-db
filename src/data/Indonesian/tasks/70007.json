			"dialogs": [
				{
					"id": 700070301,
					"content": "Ya? Ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Perempuan Dimabuk Asmara"
				},
				{
					"id": 700070302,
					"content": "Harap tenang saat di perpustakaan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Maaf, aku akan lebih berhati-hati. Terkadang aku tidak bisa menahan diri untuk tidak menyuarakan perasaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Perempuan Dimabuk Asmara"
				},
				{
					"id": 700070305,
					"content": "Saat kamu tidak memperhatikan, aku akan mengeluarkan sekuntum bunga mawar dari antara halaman bukunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Lelaki yang sedang Sulap"
				},
				{
					"id": 700070306,
					"content": "Mawar yang lahir dari buku ini sama seperti dirimu yang penuh kelembutan dan keindahan intelektual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Lelaki yang sedang Sulap"
				},
				{
					"id": 700070307,
					"content": "Wow?! Luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Perempuan Dimabuk Asmara"
				},
				{
					"id": 700070308,
					"content": "Suara kalian terlalu berisik! Selain itu jangan gunakan bukunya untuk melakukan trik sulap! Nanti robek loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Kamu mungkin harus menahan suaramu juga, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Ups, maaf. Paimon tidak bermaksud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "Jadi sekarang kamu paham kan? Terkadang beberapa hal berada di luar kendali kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Perempuan Dimabuk Asmara"
				},
				{
					"id": 700070312,
					"content": "Aku benar-benar minta maaf, ke depannya aku akan menjaga volume suaraku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Perempuan Dimabuk Asmara"
				},
				{
					"id": 700070313,
					"content": "Sepertinya mereka cuma masuk telinga kiri keluar telinga kanan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Seseorang mengeluh bahwa kalian terlalu berisik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
