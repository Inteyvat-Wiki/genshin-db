			"dialogs": [
				{
					"id": 700070401,
					"content": "Pernyataanmu tentang \"fluktuasi emosi dapat memengaruhi keakuratan penelitian dan analisis\" ini masih belum memiliki argumen yang memadai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Perempuan yang Terlihat Rasional"
				},
				{
					"id": 700070402,
					"content": "*huff* Aku mengerti. Mungkin aku terjebak dalam hambatan yang aneh untuk penelitianku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Lelaki yang Terlihat Rasional"
				},
				{
					"id": 700070403,
					"content": "Kamu datang di saat yang tepat. Aku sedang mengalami sedikit masalah dan butuh pendapatmu tentang hal ini sebagai orang awam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Lelaki yang Terlihat Rasional"
				},
				{
					"id": 700070404,
					"content": "Jika aku ingin membuktikan kebenaran teoriku, aku harus memastikan bahwa diriku tidak mengalami fluktuasi emosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Lelaki yang Terlihat Rasional"
				},
				{
					"id": 700070405,
					"content": "Tapi aku tidak pernah bisa melakukannya, terutama saat aku berdebat dengannya, rasanya aku tidak bisa tetap tenang dan berpikir jernih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Lelaki yang Terlihat Rasional"
				},
				{
					"id": 700070406,
					"content": "Aku juga heran. Apa kamu kurang tidur? Atau mungkin kemarin kamu minum terlalu banyak alkohol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Perempuan yang Terlihat Rasional"
				},
				{
					"id": 700070407,
					"content": "Apa pun itu, kalian tidak boleh berbicara dengan suara keras di perpustakaan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Bagaimanapun juga kalian berdua harus kecilkan volume suara kalian terlebih dahulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Maaf, tapi aku tidak bisa tenang sampai aku menemukan akar permasalahan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Lelaki yang Terlihat Rasional"
				},
				{
					"id": 700070410,
					"content": "D-dia... sama sekali tidak mendengarkan kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Ugh, pokoknya kalian juga tidak boleh sampai mengganggu orang lain. Terus buku yang sudah selesai dibaca jangan dijejalkan begitu saja ke dalam rak buku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Ugh... mereka benar-benar mengabaikan kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
