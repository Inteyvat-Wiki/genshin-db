			"trigger": {
				"objectNames": [
					"Pemuda yang sedang Kasmaran",
					"Pemudi yang sedang Kasmaran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "Kisah yang sangat mendebarkan! Sayang sekali mereka tidak mendapatkan akhir yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070202,
					"content": "Kita pasti tidak akan berakhir seperti mereka kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Pemudi yang sedang Kasmaran"
				},
				{
					"id": 700070203,
					"content": "Tentu saja, walaupun kita terpisah, aku akan menemukan cara untuk kembali ke sisimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070204,
					"content": "Harap tenang saat di perpustakaan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Hah? Sepertinya suaraku sudah pelan-pelan saja dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Pemudi yang sedang Kasmaran"
				},
				{
					"id": 700070207,
					"content": "*huff* Sama seperti kisah di dalam buku saja — kehadiran mereka seperti rintangan dalam percintaan kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070208,
					"content": "Buku yang sudah selesai dibaca harus dikembalikan ke tempatnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Lihat buku-buku ini tergeletak sembarangan, kasihan nanti petugas perpustakaannya kalau berantakan begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Ya, ya, tahu kok. Bisakah kalian tidak mengganggu kami lagi? Kalian telah menyela kami di momen yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070211,
					"content": "Momen penting...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "Tidak peduli berapa banyak rintangan yang ada, apakah kamu berjanji untuk tetap sama seperti dirimu yang sekarang dan tidak akan pernah berubah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Pemudi yang sedang Kasmaran"
				},
				{
					"id": 700070213,
					"content": "Ya, aku bersumpah demi hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070214,
					"content": "Sepertinya agak berlebihan... memikirkan akan kehilanganmu saja sudah membuat hatiku hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Pemudi yang sedang Kasmaran"
				},
				{
					"id": 700070215,
					"content": "Ah, sifat lembutmu membuatku semakin jatuh cinta padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Pemuda yang sedang Kasmaran"
				},
				{
					"id": 700070216,
					"content": "Kita seperti bicara sama tembok ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Seseorang mengeluh bahwa kalian terlalu berisik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
