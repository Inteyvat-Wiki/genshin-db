				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "Sepertinya suasana hatimu sedang buruk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Maaf... soalnya perpustakaan akhir-akhir ini sangat bising, aku jadi tidak bisa mempelajari Hilichurlian dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "Saat Festival Windblume dimulai banyak orang datang ke sini untuk berkencan. Pada awalnya mereka membaca buku dengan tenang lalu mulai berbincang-bincang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "Terlebih lagi... mereka melakukan banyak hal yang mengerikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Memutar sudut buku... menempelkan benda-benda aneh di antara halaman-halaman buku... bahkan mereka meletakkan buku-buku dengan posisi terbalik ke dalam raknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "Perpustakaan bukan tempat untuk berkencan! Mereka hanya akan mengganggu orang yang benar-benar ingin membaca dan melakukan penelitian di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt seharusnya menjaga ketertiban di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "Apa yang bisa dia lakukan? Mengusir orang tidak akan menyelesaikan akar masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "Karena itulah aku butuh bantuanmu. Tolong buat semua orang di sini agar bisa diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Terima kasih, yang paling ribut adalah tiga pasangan di sana. Jika kamu bisa membuat mereka sadar betapa mengganggunya ocehan mereka, aku akan bisa melanjutkan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "Tapi hati-hati ya, mereka cukup sulit untuk ditangani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "Aku coba dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "Kamu bisa membicarakannya dengan Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Tapi dengar-dengar dia sedang berpatroli dengan Grand Master. Jika dia ada di sini, para pasangan itu pasti akan berperilaku baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "Kamu terdengar lebih galak dari biasanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
