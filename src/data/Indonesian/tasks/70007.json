			"dialogs": [
				{
					"id": 700071001,
					"content": "Eh!? Apa? Lisa akan segera kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Oh, tidak! Kalau ada orang-orang mengacaukan buku-buku perpustakaan, bahkan ada yang merusak halaman bukunya, dia pasti marah besar deh, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "Benar sekali. Bisa gawat nih, siapa yang akan menyelamatkan kita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "Oh, apa yang harus kita lakukan? Oh, oh! Mungkin masih ada waktu kalau kita mulai bereskan sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "Cara yang sangat cerdik, cukup tidak terduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071006,
					"content": "Semuanya ide dari Wyratt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Berkat reputasi Lisa juga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Tapi Nona Lisa mungkin akan marah jika dia melihat kondisi sebelumnya. Bagaimanapun, ini adalah perpustakaan, tempat untuk belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Akhirnya aku bisa melanjutkan penelitianku dengan tenang. Terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
