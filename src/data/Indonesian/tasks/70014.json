					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700140102,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700140103,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700140104,
					"content": "Dada! Muhe mani yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700140105,
					"content": "Dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700140106,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140107
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700140107,
					"content": "Ya zido? Ye? Mi?",
