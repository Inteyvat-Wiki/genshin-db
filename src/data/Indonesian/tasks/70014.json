					"nextDialogs": [
						700140109
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700140109,
					"content": "Kurasa berdasarkan pengalamanmu beberapa hari ini, kamu sudah cukup jelas memahami apa yang dia inginkan. Kuucapkan terima kasih dulu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700140110,
					"content": "Lokasinya sudah ditandai di peta. Semoga kali ini kamu berhasil menemukan apa yang selama ini kamu cari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140111
					],
					"speakerTitle": "Ella Musk"
				},
