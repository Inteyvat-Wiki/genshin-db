			"dialogs": [
				{
					"id": 402250101,
					"content": "Tunggu, ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "Kapal Alcor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Sebenarnya, ini adalah kapal kedua di armada kami. Alcor masih di kampung halaman, berpatroli di Hutan Batu Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou! Kapten tentara bayaran terkenal yang mengarungi lautan luas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Eh, iya, haha. Kita kan sudah sering ketemu, kenapa jadi formal begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "Ceritanya panjang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Oke, jangan berdiri saja. Ayo duduk dan cerita, biar kusuruh anak buahku siapkan ini itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ah, gitu toh. Jadi, kamu kenal sama bos besar Curatorium of Secrets ya ... Koneksi orang dalammu memang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "Oh ya, soal pendaftaran ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Benar! Kami perlu mencatat siapa saja yang ikutan pameran dan apa barang jualannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Nah, catat saja: aku dan beberapa awak kapal jadi peserta, sisanya tinggal di kapal. Untuk barang dagangannya ... ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Apaan nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Beberapa waktu lalu, Ningguang rombak Guizhong Ballista. Si cantik yang kamu lihat ini adalah salah satu model barunya yang sudah disempurnakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Daya tembak yang sangat dahsyatnya, dilengkapi dengan kendali jarak jauh untuk serangan akurat bahkan dari jarak yang sangat jauh. Kuyakin orang pasti akan berebut mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Kamu yakin mau jualan ginian?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, santai saja. Dibandingkan dengan model yang kini dipakai Millelith, ini bisa dianggap sebagai barang antik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "... Nefer enggak bercanda ya ternyata pas bilang \"enggak ada batasan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Tapi, siapa yang mau beli barang kayak gini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, pasti akan ada yang tertarik. Lagi pula pembeli dari seluruh Teyvat kan akan hadir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, maaf. Aku sibuk mengurus kargo, jadi lupa bilang kalau di sini ada Yelan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "Enggak apa-apa. Kamu ke sini buat ikutan pameran juga, Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "Tidak, aku datang ke sini hanya untuk urusan pekerjaan. Kapten Beidou sangat baik hati sudah mengizinkanku menumpang. Jadi, tidak perlu mendaftarkanku sebagai peserta pameran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Ngomong-ngomong, sudah lama tidak bertemu, {NICKNAME}. Kalau ada kesempatan, sampaikan salamku pada kepala Curatorium of Secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Pekerjaan apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Pekerjaan yang ... sensitif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Kayaknya itu pertanda kita jangan banyak tanya-tanya deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "Kayaknya sih gitu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Kalau begitu, aku pergi dulu. Setelah urusanku selesai, kalian kutraktir minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Sudah waktunya! Aku sudah tidak sabar buat mencicipi rasa Nod-Krai, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Oke, pendaftarannya selesai. Ikut kami, kami akan ngantar kalian ke lokasi acara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
