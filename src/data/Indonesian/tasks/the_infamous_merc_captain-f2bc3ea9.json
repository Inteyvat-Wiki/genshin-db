			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou memerintahkan krunya untuk menurunkan kargo dan mengikuti kalian ke lokasi acara.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Jadi, ini tempatnya ya? Boleh juga lokasinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Kalau kalian sempat, tolong bantu aku menguji sistem kendali jarak jauh benda ini deh. Seru banget loh, kalian pasti suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
