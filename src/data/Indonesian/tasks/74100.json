			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "(Endus)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003102,
					"content": "Guk, guk, orang baik. Elus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003103,
					"content": "Oke, Mori dielus dan dikasih makanan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Kamu mengelus Mori.\\nKarena Mori adalah seekor (anjing) yang terbuat dari air, makanya dia basah.\\nTapi Mori terlihat senang.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Guk guk, terima kasih orang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003106,
					"content": "Aku akan elus kamu lain kali, Mori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Guk ... Mori nakal, jadi tidak dielus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003108,
					"content": "Apa hubungannya dengan anak baik dan nakal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Guk, guk! Anjing baik dielus, anjing nakal di ... perbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003110,
					"content": "*hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003111,
					"content": "Melihat Mori bersedih, kamu mengulurkan tanganmu untuk mengelus Mori.\\nKarena Mori adalah seekor (anjing) yang terbuat dari air, makanya dia basah.\\nMata biru Mori kini terlihat bersinar kembali.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Guk, guk, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				}
			]
		}
	]
