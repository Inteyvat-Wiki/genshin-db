					"nextDialogs": [
						706510104
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510104,
					"content": "Jika kamu ingin mengumpulkan bijih, aku tahu tempat yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510105,
					"content": "Tetapi bijih besi juga banyak macamnya, ada yang paling sering digunakan Iron Chunk, yang mudah digunakan adalah White Iron Chunk, dan kualitas paling bagus adalah Crystal Chunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510106,
					"content": "Ada juga mineral yang disebut Magical Crystal Ore, yang kualitasnya sangat baik dan dapat menempa benda-benda berkualitas sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
