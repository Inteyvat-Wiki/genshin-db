				{
					"id": 706510201,
					"content": "Namun, Magical Crystal Ore sulit untuk diproses, jika ingin menggunakannya sebagai bahan tempa, kamu harus menggunakan banyak bahan lain untuk membantunya.",
					"roleType": "TALK_ROLE_NPC",
