				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Wah, ramai banget! Semua Kuuhenki joget-joget ngelilingin Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Uh, sebentar ... itu sih bukan joget! Mereka kayak ... kayak mau ngubur dia di bawah keimutan hakiki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "To-Tolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500106,
					"content": "Ulurkan tanganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Fiuh ... terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500108,
					"content": "Kenapa Kuuhenki-nya pada bertingkah kayak tadi? Biasanya kan lebih kalem gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500111,
					"content": "Aku tadi ajak mereka main. Tapi terus, mainnya jadi terlalu bersemangat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500112,
					"content": "Ngelilingin kamu kayak tadi sehabis main ... kayak guguk kecil gitu ya, lucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Mungkin itu cara mereka menunjukkan rasa terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mm, hanya saja kali ini, rasa terima kasih mereka sederas salju longsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500115,
					"content": "Ngomongnya gitu, tapi Paimon yakin kamu nih senang banget manjain mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "Kalian berdua mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500117,
					"content": "Coba ... dikelilingin kayak tadi maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Hmm, bisa diatur. Asal bisa menjawab dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500121,
					"content": "Oh, boleh tuh. Kayanya asyik juga, penasaran nih sama permainannya Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760500123,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "Maksudnya ... main sama Kuuhenki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
