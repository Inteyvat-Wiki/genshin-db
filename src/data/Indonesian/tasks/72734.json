			"dialogs": [
				{
					"id": 727340101,
					"content": "Tidak disiplin, kampungan, tidak orisinal, payah ... Dan tidak kompak sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340102,
					"content": "Aduh, ribut apa sih kau? Ohhh, soalnya semua kawanmu pada kalah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340104,
					"content": "Yang kumaksud itu justru — gaya bertarungmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340105,
					"content": "Ha? Habis kena jitak Specter ya? Ini bukan sirkus, woi. Mau tahu gaya Tuan Besar ini macam apa? Kekuatan tak terbendung, semangat tiada tanding, dan kumbang tak kenal kalah! Sini, aku kasih lihat. Gratis. Asal nyalimu besar saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Haduh, jadi ingat kenangan buruk. Aku tidak suka tipe yang berisik dan kepedean kayak gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340107,
					"content": "Tapi si pirang ini kayaknya gampang \"di-bully\" ya. Baiklah, HEI PIRANG! Maju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340108,
					"content": "Pfft ... HAHAHAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "HAHAHAHA! Sobatku sayang, dengar tadi si badut ini bilang apa? Kamu gampang \"di-bully\" katanya? HAH! Tolong, kasih dia paham sopan santunnya Geng Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Dengan senang hati, bos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon bingung dah ... Orang-orang ini kayak enggak tahu apa-apa soal lawan mereka! Mereka cuma nongol satu-satu buat dibantai, nambahin skor menang kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Anggotanya si Grandmaster Hanakado latar belakangnya variasi, campur aduk dari mana-mana ya! Enggak bisa ditandingin lawan strateginya kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Oh, tydaaack~ Jangan \"bully\" diriku~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
