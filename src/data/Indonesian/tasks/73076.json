			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "Aduh ... Hanya di Sumeru kamu bisa merasakan udara segar alami begini. Udara di Fontaine sudah seperti racun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760102,
					"content": "Hmm? Ya? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760103,
					"content": "Kami hanya penasaran ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "Apa kamu tinggal di tenda ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760105,
					"content": "Ya, aku sudah tinggal di sini untuk sementara waktu... Haha, aku tahu. Aneh sekali melihat orang Fontaine tinggal di tenda di alam liar Sumeru, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760106,
					"content": "Untuk alasannya ... Biar kujelaskan padamu. Oh ya pertama-tama, nama kalian berdua siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760107,
					"content": "Nama Paimon ya ... Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760108,
					"content": "#Namaku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#Baiklah, {NICKNAME} dan Paimon ya. Oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760110,
					"content": "Aku Santon, seperti yang kamu lihat, aku datang dari Fontaine. Dan kenapa aku bisa ada di Sumeru, tentu saja karena aku suka hutan di sini! Aku suka hutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760111,
					"content": "Tinggal di kota begitu lama, badanmu akan lemah karena kekurangan olah raga, lalu mentalmu akan menjadi lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760112,
					"content": "Hanya di alam kita baru bisa hidup berdampingan dengan semua makhluk hidup. Hutan adalah tempat terbaik untuk dekat dengan alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760113,
					"content": "Jadi, aku datang ke Sumeru. Karena bagaimanapun juga, hutan di sini adalah hutan terbaik di seluruh Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760114,
					"content": "Kok rasanya Paimon mengerti tapi enggak gitu paham ... Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760115,
					"content": "Tapi hutan di Sumeru sangatlah berbahaya, ada berbagai macam monster di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760116,
					"content": "Tapi tentu saja harus berbahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760117,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760118,
					"content": "Kalau tidak berbahaya, tidak akan ada perasaan ingin bertahan hidup! Tidak perlu khawatir, aku sebenarnya juga seorang pemburu terkenal di Fontaine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760119,
					"content": "Hmph, kamu bilang suka hutan, rupanya sukanya berburu di hutan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760120,
					"content": "Kamu ini pemburu gelap dari Fontaine ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760121,
					"content": "Kelihatannya kita harus turun tangan nih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "Tunggu, tunggu. Kalian salah paham. Aku bukan pemburu gelap ... memburu secara ilegal adalah tindakan kekerasan yang sangat melawan hukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760124,
					"content": "Kalau kamu ketahuan memburu di Fontaine, maka hidupmu akan hancur, dan aku tidak akan berani berbuat begitu. Yang pemburu Fontaine sering lakukan, sebenarnya adalah \"menghadapi hewan buas\" saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760125,
					"content": "Menghadapi ... hewan buas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760126,
					"content": "Coba kalian pikir. Kalau hewan buas mendekati manusia, maka keduanya akan terluka ... Itulah kenapa mereka harus dicegah mendekati pemukiman manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760127,
					"content": "O-Oh, begitu ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760128,
					"content": "Dengan begitu, tempat tinggal penduduk tidak perlu takut diganggu oleh binatang buas, dan bagi makhluk tersebut aktivitas manusia juga tidak mengganggu kehidupan mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760129,
					"content": "Sebenarnya, aku juga pernah mendengar di sekitar sini ada hewan buas, dan aku sudah diminta untuk mengusir mereka. Sebagai pemburu, aku tidak bisa hanya duduk diam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760130,
					"content": "Tentu saja, aku juga merasa tertarik dengan hewan buas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760131,
					"content": "Lihatlah, ini salah satu yang luar biasa, \"Buaya yang tumbuh terlalu besar\". Ia juga dikenal oleh anak-anak sebagai \"Raja Buaya\". Rasanya seperti hewan dari sebuah legenda deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760132,
					"content": "Dengar-dengar sering muncul di dekat perairan sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760133,
					"content": "Dan ada juga Rishboland Raja dan Sumpter Beast raksasa yang menghalangi jalan menuju Liyue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760134,
					"content": "Rishboland Raja ini sepertinya berada di hutan lebat di sebelah barat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760135,
					"content": "Kalau Sumpter Beastlord-nya ... Oh, maksudku si Sumpter Beast raksasa itu ... Ada beberapa saksi ketakutan yang bilang kalau hewan ini berkeliaran di daerah timur dan menyerang siapa pun yang lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760136,
					"content": "Kedengarannya lumayan berbahaya semua ya....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760137,
					"content": "Ya, kalau kamu ketemu, harus hati-hati ... Ehm, tidak tahu kenapa, tapi kalian ada aura yang sama dengan pemburu, mungkin perasaanku saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760138,
					"content": "Kalau kamu kebetulan bertemu dengan mereka, tolong bantu aku untuk mengusir hewan-hewan buas ini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760139,
					"content": "Dengan begitu tempat tinggal di sekitar sini bisa aman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760140,
					"content": "Yah, kalau kita ketemu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760142,
					"content": "Keamanan di sekitar tempat tinggal, keamanan hewan buasnya, dan tentu saja keamanan kalian sendiri, semua ini harus diperhatikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760143,
					"content": "Siap, mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760122,
					"content": "Pemburu akan merusak ekosistem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
