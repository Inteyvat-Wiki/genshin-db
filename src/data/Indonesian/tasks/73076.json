			"dialogs": [
				{
					"id": 730760401,
					"content": "\"Sumpter Beastlord\", itu masalah beberapa hari yang lalu. Aku sedang mencari beberapa bijih khusus dan entah bagaimana aku sampai ke luar gunung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760402,
					"content": "Dan ada Sumpter Beast yang sangat besar. Duh, besar sekali. Aku belum pernah lihat yang sebesar ini dalam hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760403,
					"content": "Dia langsung menyerangku waktu dia melihatku, untung saja aku bisa kabur dengan cepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760404,
					"content": "Di bagian gunung yang mana? Ya, itu gunung bagian barat, tepatnya ... aku juga tidak ingat jelas, tapi memang ada di barat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hong"
				}
			]
		},
