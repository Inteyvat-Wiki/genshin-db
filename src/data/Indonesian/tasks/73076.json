				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "Oh, Sumpter Beastlord? Maksudmu Sumpter Beast yang sangat besar itu, ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760502,
					"content": "Aku sedang menuju ke Liyue dua hari yang lalu, dan aku melihatnya ketika melewati Chasm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760503,
					"content": "Untung saja dia sedang tidur. Aku berjalan diam-diam dan melarikan diri. Waktu dia tidur, dia terlihat seperti sebuah bukit kecil karena ukurannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760504,
					"content": "Kamu mau tahu di mana aku melihatnya? Posisi Liyue kan selatan dari sini, jadi harusnya ada di arah sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760505,
					"content": "Bukannya kalau dari Sumeru ke Liyue biasanya lewat jalur air? Kenapa malah lewat Chasm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760506,
					"content": "Ini urusan pribadiku ... Tidak ada hubungannya dengan kalian ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760507,
					"content": "Oke, itu saja yang aku tahu. Aku masih punya urusan lain ... Tinggalkan aku sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najib"
				}
			]
		},
		{
			"id": 7307606,
