				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anaya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "Eh, tentang Sumpter Beastlord ... Aku melihatnya ketika aku berada di hutan malam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760602,
					"content": "Malam itu mendung. Saat aku sedang dalam perjalanan, aku melihat ada bayangan seukuran gundukan menuju ke arahku dengan suara gemuruh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760603,
					"content": "Aku pingsan. Dan aku tersadar keesokan harinya. Orang yang membawaku kembali mengatakan kalau aku pingsan di bawah kaki gunung ... Tapi tidak ada luka yang serius ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760604,
					"content": "Tentang lokasinya ... Aku juga tidak tahu pasti ... Mungkin di timur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anaya"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307607",
							"2"
						],
						"stepId": 7307607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "Eh, apa? Kamu sudah mengusir hewan buas itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760702,
					"content": "Aku belum ketemu apa-apa ... Jadi, apa mereka benar-benar mengerikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760703,
					"content": "Eh, tidak juga sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Haha, sepertinya memang mudah sekali ya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760707,
					"content": "Aku merasa lega setelah tahu kalau hewan buas itu telah diusir. Tapi sayang saja bukan aku yang melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760708,
					"content": "Melihat mangsa direbut oleh pemburu yang lebih kuat di alam memang hal yang biasa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760709,
					"content": "Hahaha, lain kali aku tidak akan kalah darimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760710,
					"content": "Kita juga tidak akan kalah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760712,
					"content": "Tapi bukannya \"menghadapi binatang buas\" seharusnya tugas Penjaga Hutan di Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760713,
					"content": "Tentang itu ... Aku sebenarnya mendapat tugas dari seorang Penjaga Hutan yang kukenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760714,
					"content": "Beberapa masalah dengan The Withering sudah membuat mereka kehilangan banyak tenaga kerja dalam penyelidikan. Tapi, aku juga tidak tahu detailnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760715,
					"content": "Jadi, pekerjaan \"mengurus hewan buas\" ini diserahkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760716,
					"content": "Ternyata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760717,
					"content": "Terima kasih atas bantuanmu! Ini bayaranmu. Silakan ambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760705,
					"content": "Iya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "Oh ya? Kuharap aku juga bisa melihat mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				}
			]
		},
