					"Santon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "Bagaimana, apakah kalian sudah bertemu dengan hewan-hewan buas itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760302,
					"content": "Kalau kalian kebetulan bertemu dengan mereka di jalan, tolong bantu untuk mengusir hewan buas itu ya. Ini juga demi kebaikan kedua belah pihak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760303,
					"content": "Tentang Raja Buaya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Dengar-dengar Raja Buaya itu ada di sekitar perairan timur ... Namun, aku tidak pernah melihatnya, walaupun sudah beberapa kali ke sana. Sepertinya dia sangat licik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760305,
					"content": "Tentang Rishboland Raja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "Berdasarkan cerita di sekitar sini tentang Rishboland Raja, dia sering keluar dari hutan yang berada di barat dari sini pada tengah malam, kemudian dia menculik anak-anak nakal yang tidak mau disuruh tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760307,
					"content": "Kurasa cerita tentang menculik anak-anak itu hanya buatan para orang tua saja sih untuk menakut-nakuti anak mereka, tapi Rishboland Tiger memang lebih aktif di malam hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760308,
					"content": "Dengar-dengar banyak pengembara yang berjalan di malam hari dan dikejar oleh Rishboland Tiger yang sangat besar. Tapi untung saja tidak ada masalah besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760309,
					"content": "Tentang Sumpter Beastlord ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "Aku dengar kalau Sumpter Beast liar bersifat teritorial, dan orang asing akan diserang begitu mereka memasuki wilayah mereka. Aku khawatir Sumpter Beastlord juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760311,
					"content": "Wilayah kekuasaannya ada di suatu tempat di sebelah timur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760312,
					"content": "Sebenarnya dia seberapa besar sih sampai dipanggil Sumpter Beastlord, sungguh membuat orang khawatir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760313,
					"content": "Kami masih mencari tahu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "Oke, semangat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				}
			]
		},
