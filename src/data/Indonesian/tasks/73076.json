			"dialogs": [
				{
					"id": 730761001,
					"content": "\"Tentang penampakan Rishboland Tiger baru-baru ini:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "Selembar Pemberitahuan"
				},
				{
					"id": 730761002,
					"content": "\"Tolong jangan berkeliaran setelah malam. Rishboland Tiger ini sering muncul di malam hari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "Selembar Pemberitahuan"
				},
				{
					"id": 730761003,
					"content": "\"Tolong jangan taruh makanan di sekitar sini. Memberi makan Rishboland Tiger dan membuatnya kenyang bukan cara terbaik untuk tetap aman. Sebaliknya, ini akan membuatnya tetap berjaga di tempat tersebut untuk waktu yang lama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Selembar Pemberitahuan"
				}
			]
		}
	]
