				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "Pengembara! Kamu datang tepat waktu, apa kamu bisa membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Kamu juga sudah tahu kan jika kondisi di atas sana itu sangat berbahaya. Bahkan para petualang berpengalaman saja tidak berani mengatakan bahwa mereka dapat sepenuhnya mengatasi situasi di Dragonspine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Aku ditempatkan di sini atas perintah Grand Master untuk memperingatkan penduduk Mondstadt agar tidak pergi ke atas gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Meskipun, aku sudah berhasil membujuk banyak warga Mondstadt untuk tidak pergi ke sana, tapi para petualang itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Kamu juga tahu kan, meski aku sudah menasihati mereka untuk jangan pergi ke sana, mereka tidak mau mendengar dan tetap ingin pergi ke atas gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Aku tidak tahu sudah berapa banyak hal yang berhubungan dengan petualang yang telah kutangani... tapi jumlah petualang yang ingin pergi ke gunung semakin meningkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Tidak mungkin untuk mengatur setiap petualang... jadi, kami berencana untuk menaruh beberapa persediaan pasokan darurat di beberapa tempat di Dragonspine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Dengan begitu, para petualang yang telah merasakan kerasnya kondisi di atas sana dan siap untuk kembali akan memiliki lebih banyak kesempatan untuk keluar dari gunung ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Tapi... jika ada petualang yang \"beruntung\" dan masuk terlalu jauh ke dalam, mereka hanya bisa mengandalkan diri mereka sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Singkatnya, dapatkah kamu membantu meletakkan persediaan pasokan darurat ini di gunung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Kalau begitu tolong ya. Andai saja jika para petualang itu sepertimu, yang memiliki kekuatan dan tahu kapan harus maju dan mundur, itu akan bagus sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Aku telah menandai tiga lokasi di peta milikmu. Letakkan saja <color=#00E1FFFF>sebuah Ham</color> di setiap tempat tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "Ah, kuharap para petualang itu bisa lebih mawas diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Apakah ini berguna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Berguna atau tidak... singkatnya, lebih baik memiliki sesuatu daripada tidak sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Dalam lingkungan yang keras seperti di atas gunung, selalu merupakan hal yang baik untuk dapat memasok persediaan darurat lebih banyak. Jadi, tolonglah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
