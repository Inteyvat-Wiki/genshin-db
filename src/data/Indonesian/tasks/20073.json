			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Apa semua persiapan pasokannya sudah selesai diletakkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Baguslah, kalau begitu aku bisa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Namun, aku tetap berharap semua orang yang naik ke atas gunung ini benar-benar sepenuhnya siap dan tidak akan menggunakan pasokan darurat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Bicara soal itu, pakaianmu juga terlihat tipis sekali ya, apa ini gaya baru di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Silakan ambil hadiah ini dan kembalilah, pakai baju yang lebih tebal sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
