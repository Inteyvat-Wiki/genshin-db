			"dialogs": [
				{
					"id": 706580101,
					"content": "Hai, apa kamu menikmati kemeriahan Festival Windblume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580102,
					"content": "Ya, terima kasih atas rekomendasimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Event hari ini sedikit berbeda dengan yang sebelumnya. Namanya \"Nyanyian Angin Merdu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580105,
					"content": "Aku yakin kamu sudah pernah melihat para penyair dari Mondstadt. Kamu bisa memainkan lagu-lagu yang merdu sama seperti mereka dengan berpartisipasi dalam event ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580106,
					"content": "Rasakan embusan angin dari atas gunung dan tepi sungai, mainkanlah musikmu sepenuh hati dan jiwa. Inilah cara yang ampuh untuk melupakan semua kekhawatiranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580107,
					"content": "Tapi aku masih belum berpengalaman dalam bidang ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Jangan khawatir. Aktivitas ini sudah didesain sedemikian rupa supaya siapa saja yang belum berpengalaman memainkan musik pun tetap dapat menikmati kesenangan dari memainkan musiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580110,
					"content": "Ikuti saja petunjuk dan ketukannya, selanjutnya dijamin tidak akan ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580111,
					"content": "Kedengarannya meyakinkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Baiklah kalau begitu. Selamat Festival Windblume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580112,
					"content": "Oke, akan kucoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Apakah suaranya akan merdu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
					"content": "Aku masih belum sempat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				}
			]
		}
