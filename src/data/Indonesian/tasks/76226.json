			"dialogs": [
				{
					"id": 762260101,
					"content": "Maalaus, coba lihat! Paimon sama yang lainnya udah nemuin semua lukisanmu nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Hehe, enggak usah sungkan. Soalnya lukisan-lukisan ini juga ada kontribusi dari Paimon sama kamu, loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "Sejak kapan Paimon bisa ngerti maksudnya Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "Aduh, Paimon kan udah ikut kamu ke Aula Bulan Perak berkali-kali, wajar dong kalau Paimon bisa ngerti maksudnya Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "Terus Maalaus bilang gimana hilangnya lukisan itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Ehh ... ini ... coba Paimon pikir dulu ya ... Maalaus bilang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Kayaknya dicuri sama Kuuhenki yang lain ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Hmm ... bisa juga dicolong sama mesin transportasi ajaib di bulan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Hmm ... bisa juga sih Columbina yang nyolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Mana mungkin sih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Eh? Iya juga ya ... jangan-jangan Paimon salah paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "Ternyata cuma nebak-nebak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hehe, belajar bahasa asing enggak semudah itu dong ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "Paimon butuh guru yang bagus. Nanti pas ada kesempatan, Paimon mau minta Columbina ngajarin Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
