				},
				{
					"id": 762260202,
					"content": "Pasti Columbina yang ngajak kamu ke sini kan? Soalnya dia pernah bilang mau ngajak kamu ke Bulan buat pameran lukisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
