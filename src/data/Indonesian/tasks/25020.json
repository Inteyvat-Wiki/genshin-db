				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora! Nurut ya! Jangan gerak! Tinggal dilap sedikit lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "Aum. Aum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Hei, nak! Kita mandi sebentar yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Tuh, di kolam sana. Habis mandi, nanti boleh lanjut main lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "GROAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "Eh! Tunggu! Jangan kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "Buset, apaan tuh yang barusan lewat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "Kamu tamu ya? Maaf! Hora akhir-akhir ini super bandel, lari melulu. Dia tidak nakutin kamu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Tadi kamu mau suruh dia mandi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Suruh? Itu sih sudah \"memohon\" sepertinya. Akhir-akhir ini hujan terus, setiap kali dia pergi main, pasti tubuhnya berlumuran lumpur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Aku sih sudah berniat memandikannya. Tapi dia itu main terus kerjaannya, tidak bakal bisa diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Tapi sebagai manusia biasa, aku selalu kewalahan mengikuti keaktifannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Sudah pernah coba pancing pakai makanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Sudah, tapi dia seakan bisa membaca pikiranku. Selama aku ada di sampingnya, dia langsung mogok makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Begitu aku memalingkan kepala, dia langsung menggali tanah, menghabiskan makanannya, terus menggali lubang lagi untuk kabur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Ya, namanya juga Tepetlisaurus ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Ya justru. Dan kalau sudah besar nanti, entah masalah apa yang akan dibuatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Aku cuma berharap dia tidak membuat kacau di Toko Cheven ... Kalau sampai terjadi, mana sanggup aku ganti rugi semua batu permatanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "Duh, sekarang kayaknya aku harus coba ide si Batz yang waktu itu deh. Tapi apa Tepetlisaurus bakal benar-benar suka sama bola ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Siapa tuh Batz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Oh. Dia penanggung jawab Tepetlisaurus di suku. Orangnya pintar, mahir musik, dan sepertinya siapa pun baik manusia atau Saurian pasti suka padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "Dulu ... aku pernah membahas masalah ini dengannya, dia langsung kasih aku satu gambar untuk membuat \"Bola Mengambang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "Ini barang yang dia dapatkan dari Mataoho. Saurian kecil suka banget. Aku disuruh coba kasih ke Hora juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Baru saja aku selesai mengumpulkan bahan dan siap mulai, Hora malah kumat. Enggak bisa diam, kayak cacingan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Apa boleh buat lah. Harapanku bergantung sama Bola Mengambang kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Kamu mau bantu? Wah! Nasib baik apa ini? Aku bisa ketemu sama orang sebaik kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Kalau begitu, silakan ke kotak di belakang dan ambilkan beberapa Embercore Stem. Sementara itu aku akan di sini untuk mulai membuat Bola Mengambangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Bilang saja kalau ada yang bisa dibantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Duh! Hampir ketabrak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
