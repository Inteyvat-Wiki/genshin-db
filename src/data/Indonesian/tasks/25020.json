			"dialogs": [
				{
					"id": 250201001,
					"content": "Ya benar ini. Terima kasih ya. Aku tinggal ... aduh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201002,
					"content": "Maaf ... Waktu aku sedang ikat kerangkanya, tanganku tergores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201003,
					"content": "Ternyata pekerjaan yang seperti ini sulit bagiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201004,
					"content": "Tunggu ya, aku akan ikat bunganya ke kerangka dulu, baru dilapisi kain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201005,
					"content": "Cazcal lanjut bergulat dengan Bola Mengambang-nya ... dan berhasil menyelesaikannya setelah bertambah tiga luka sayatan di tangan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "Beres! Sekarang kita cari Hora, dia pasti lagi gali-gali di bawah pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201007,
					"content": "Balut dulu deh tangannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Oh, tidak usah khawatir kok. Luka kecil saja. Nanti aku bungkus pakai sembarang kain saja. Gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201009,
					"content": "Kita cari Hora dulu deh. Nanti dia terlalu asyik mainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
