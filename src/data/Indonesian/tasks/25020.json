				]
			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "Aum? Aum aum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200502,
					"content": "GROAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200503,
					"content": "Hora memainkan Bola Mengambang dengan gembira, sambil berguling-guling di dalam kolam. Air bercipratan ke mana-mana, dan lumpur yang menutupi tubuhnya pun akhirnya tercuci bersih ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Hahaha! Sepertinya dia suka sekali sama bolanya. Langsung main di kolam loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Yuk ke sana. Ini dia hitungannya sudah mandi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "Aum? Aum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200507,
					"content": "Hei, Nak. Suka ini tidak? Hadiah ini untukmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "Groar, grrroar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200509,
					"content": "Mau mandiin saja susahnya minta ampun. Tapi ... hahaha. Akhirnya aku sudah tahu cara menghadapimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "Groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200511,
					"content": "Ngapain sentuh aku? Luka ini ... luka kecil kok. Tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "Aum. Aum. Aum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200513,
					"content": "Dasar. Kok tiba-tiba jadi murung gitu? Tadi kan mainnya senang sekali? Apa sudah capek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "Terima kasih ya, sobat. Ini untukmu, anggap saja sebagai imbalan. Tidak ada yang berharga di dalamnya. Tapi tolong diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "Aum. Aum. Aum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200516,
					"content": "Hei tunggu! Jangan langsung masuk ke kolam! Hora! Tadi kan badannya sudah kering!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
