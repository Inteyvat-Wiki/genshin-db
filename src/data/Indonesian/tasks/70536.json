			"dialogs": [
				{
					"id": 705360101,
					"content": "Hehe, Dodoco ngalahin banyak Spikey Fish Warrior! Bahkan Spikey Fish King juga bukan tandingannya, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "Dodoco, Jumpy Dumpty, sama Sparks 'n' Splash punya Klee memang paling keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "Benar-benar jagoan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Permainan ini kok jadi ngingetin Paimon sama kejadian yang di Danau Cider itu ya ... Mungkin Lisa juga kepikirannya dari situ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Tapi kalau dipikir-pikir nih ya, ngapain juga harus repot-repot nemu spesies yang mengganggu kalau mereka bisa langsung minta tolong Klee buat ledakin yang mencurigakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "Langsung saja kasih bomnya ke kita terus kita ledakin, kan beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Kamu sama Klee memang cocok ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Ohoho, dari ekspresi kalian, kayaknya kalian puas ya mainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "Eh ada Kak Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "Akhirnya kamu balik juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "Kami senang banget main Petualangan Bom-Bastis Dodoco! Permainan yang kamu bikin ini seru banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Makasih sudah main, aku senang kalau kalian menikmatinya. Hmm, mungkin aku harus kasih pembaruan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "Oooh, hore! Klee mau lihat Dodoco bertualang ke mana-mana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "Eh, tunggu dulu ... Kak Lisa pasti sudah ngabisin banyaaak waktu buat bikin permainannya, pasti capek! Enggak boleh gitu sama Kak Lisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Aw, makasih loh sudah perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Tapi kalau itu bisa bikin kamu senang selama kamu di kota, aku sih senang-senang saja menghabiskan banyak waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "Tentu saja, aku paham kamu lebih memilih bertualang kapan pun kamu mau. Permainan ini cuma cara buat menghabiskan waktu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "Oh ya, aku punya beberapa berita menarik, dan aku juga bawa hadiah buat kamu, Manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "Hadiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "Aku juga punya hadiah buat Kak Honorary Knight sama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Oke hadiahnya nanti dulu, aku kasih tahu dulu beritanya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "Apa insiden di Danau Cider sudah dibereskan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "Benar. Dua Kesatria dari Tim Investigasi menemukan sarang spesies aneh dan sudah membereskannya dengan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "Para kesatria juga sudah menemukan penyebab dari invasi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "Spesies itu secara tidak sengaja ditaruh ke danau oleh seorang pedagang tanpa niat jahat, jadi para Kesatria melepaskannya setelah menceramahinya dan memberinya denda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "*fiuh ...* Untungnya mereka enggak gitu ngerepotin. Tapi kalau kata Paimon sih pedagang itu juga ceroboh banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "Air di Danau Cider aman sentosa deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "Sudah waktunya bagi-bagi hadiah? Klee duluan ya, boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Klee pulang ke rumah tepat waktu tiap hari tanpa diingatkan oleh siapa pun, jadi aku penasaran apa sebenarnya rencanamu belakangan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Hehe~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "Waktu di rumah tadi malam, Klee baca bukunya Kak Albedo, terus belajar bikin ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "Tadada~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "Wow, Dodoco-nya ngelempar Jumpy Dumpty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "Iya! Klee bikin mainan Dodoco dari Petualangan Bom-Bastis Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Tapi Klee enggak bisa bikin dia ngelempar bom beneran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "Semoga ini bisa bikin Kakak ingat waktu seru-seruan bareng Klee, dan bisa ngusir bosan, ngusir masalah juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "Mainan Dodoco raksasa! Paimon suka deh kejutan kayak gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "Kalau gini, ke mana pun kami pergi rasanya kayak lagi pergi bertualang bareng Klee sama Dodoco ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "Makasih loh Klee, hadiahnya kreatif banget! Bagus lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "Hehe, Klee senang Kakak suka sama hadiahnya! Klee bikinnya sampai capek banget loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "Hadiahnya Kak Lisa apa? Mau lihat dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Yah, sepertinya hadiahku kalah kreatif darimu nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "Ini buku cerita tentang Petualangan Bom-Bastis Dodoco~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "Buku cerita, yeay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "Wow, buku cerita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "Si Manis kembali ke Mondstadt dan bergabung dengan Klee untuk bertualang bersama Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "Bersama-sama mereka mengalahkan Spikey Fish Warrior dan menikmati teh bersama-sama di sore hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Ini akhir yang paling cocok untuk Petualangan Bom-Bastis Dodoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "Wow, apa kamu sudah rencanain semuanya waktu bikin permainannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "Tidak dong. Sebagai pemeran utama dalam cerita, kamu, si Manis, dan Klee memainkan peran penting loh untuk mewujudkan cerita ini menjadi nyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Aku cuma meninggalkan lembar kosong saja di dalam buku untuk ilustrasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "Tapi aku baru saja memikirkan ide yang lebih baik — karena kita semua ada di sini dalam rangka acara yang spesial, kenapa kita tidak berfoto bersama saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "Boleh! Kita kan ketemu teman terus main bareng, wajar sih kalau kita rayain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "Yuk kita foto bareng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "Ayo, Kak Honorary Knight dan Paimon! Kak Lisa sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360163,
					"content": "Klee senang banget hari ini! Tiga, dua, satu ... Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360161,
					"content": "Kamu harus menghargai kebahagiaan kecil yang muncul di hidup!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "Mulai sekarang Dodoco bakal pergi bertualang terus sama kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "Industri anggur Mondstadt damai sejahtera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "Apa Klee bisa main di luar lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "Paimon enggak ada ya acara mainan bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "Makan tuh, ikan nakal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
}