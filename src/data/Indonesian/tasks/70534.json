			"dialogs": [
				{
					"id": 705340101,
					"content": "Aku tidak tahu kenapa harus buat permainan baru lagi sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "Pengembara, kamu bikin aku kaget saja. Kamu juga datang untuk ikut Kejuaraan Raja Invokation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Oh, ini sebuah permainan kecil yang dibuat oleh seorang petualang dari Adventurers' Guild. Jadi simpelnya ... ini sebuah permainan yang menggabungkan Genius Invokation TCG dengan pertarungan, namanya Taktik-Taktik Dadu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Sekarang kita kan lagi mengadakan Kejuaraan Raja Invokation, lalu Adventurers' Guild suka dengan Taktik-Taktik Dadu buatan petualang ini sampai membuat satu event khusus untuk permainan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Memangnya permainan kartu bisa digabungkan dengan pertarungan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahahaha, jujur saja aku juga kurang tahu. Tapi aku punya buku peraturannya, coba lihat deh tebalnya seperti apa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Tapi kalau dari pengertianku, sepertinya inti dari permainan Taktik-Taktik Dadu ini ada di \"Dadu\" nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Pokoknya kalau kamu tertarik, langsung saja datang ke sini untuk mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Aku tidak kepikiran bagaimana cara menggabungkannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Permainan baru apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
