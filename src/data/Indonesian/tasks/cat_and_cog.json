			"dialogs": [
				{
					"id": 761850101,
					"content": "Mm, tehnya enak dan camilannya juga. Terima kasih atas undangannya, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Senang kalian menyukainya. Aku juga membawa camilan untuk Ashru. Benar, kan, Ashru? Sini. Kucing pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850103,
					"content": "Meong~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Aku harap persahabatanmu dengan Nod-Krai dan Curatorium of Secrets akan bermanfaat bagi kerja sama kita di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Aku juga berharap begitu. Ini, Ashru, coba yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850106,
					"content": "Ngomong-ngomong, soal hal yang aku tanyakan sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Haha, cakarmu yang kecil lembut sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850108,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Nona Sandrone ... Jangan bilang kamu menggunakan pesta teh ini sebagai alasan untuk datang ke sini dan memanjakan kucingku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Hah ...? A-Aku? Enggak mungkin! Aku menganggap urusan dengan Curatorium of Secrets sangat serius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850111,
					"content": "Ashru, kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Meong~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850114,
					"content": "Kalau begitu, mari kita bicarakan perincian dari \"kesepakatan\" kita, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "... Hmph. M-Memangnya kenapa kalau aku mau mengelus Ashru ... siapa yang enggak mau?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850116,
					"content": "Hewan kecil biasanya waspada terhadap mesin. Aku sudah susah payah membuat dia percaya sama aku waktu aku mengerjakan larik numerologi-nya di sini. Apa salahnya aku elus-elus dia sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850117,
					"content": "Hah, tidak perlu marah begitu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Sana, Ashru. Aku juga tidak berhak mengatur kamu mau nempel ke siapa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Meong~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Tapi setelah selesai mengelusnya, jangan lupa kita masih ada urusan yang harus dibahas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Sudah kubilang, aku serius soal urusan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
