			"dialogs": [
				{
					"id": 761850201,
					"content": "Teh memang terasa lebih enak saat dipasangkan dengan \"informasi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850204,
					"content": "Oh, hati-hati ya. Dan jangan lupa mampir kalau lagi luang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
