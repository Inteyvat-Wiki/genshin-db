			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins! Kamu datang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Tentu saja. Aku ingin berterima kasih, sebab mercusuar ini jadi terlihat jauh lebih baik setelah dipelihara oleh kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Hehe, perkara kecil saja kok. Tapi yah, mau dibenerin kayak gimana juga tetap saja di sini gelap banget. Tetap ada tempat yang di luar jangkauan sinarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Benar. Seakan waktu di pemakaman terhenti di saat penutupan pertempuran malam itu, jauh berbeda dengan keadaan di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Aku awalnya tidak bermaksud mengubah lingkungan di sekitar sini. Kalianlah yang menyalakan mercusuar, dan membuka kembali pintu aliran waktu di pulau ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Apa hal itu akan memengaruhi kehidupanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Jika kamu ingin menanyakan apakah ini akan membuatku tidak nyaman, jawabannya adalah tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "Hidup adalah siklus. Tanpa kita, arwah-arwah di pulau ini akan menghilang dan kembali ke Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Jadi tidak perlu khawatir kalau mercusuar tidak bisa menerangi seluruh pulau. Seiring hantu menghilang, kabut yang menyelimuti tempat ini juga akan memudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Habis gelap terbitlah terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Maaf, kami tidak sengaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Tidak perlu minta maaf. Aku tidak keberatan dengan perubahan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
