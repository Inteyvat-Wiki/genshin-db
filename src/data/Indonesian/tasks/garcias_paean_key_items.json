				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "Pengembara, sudah dapat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Luar biasa! Segini pasti cukup. Akan aku teliti begitu kembali. Kalau ada pelumas ini, \"mesin hitung\"ku pasti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Harus kupelajari dulu. Lutong, sisanya kuserahkan kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Baik, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "Ini imbalanmu, Pengembara. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Emm ... dengan rendah hati, mungkin kami masih butuh bantuan Anda ke depannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Jangan khawatir, asalkan aku masih mengurus urusan tata bukunya, Anda pasti bisa dapat imbalan yang layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*menghela napas* Sebenarnya alasanku mau berkelana dengan Tuan Garcia adalah karena aku tidak mau menjadi sama seperti kedua orang tuaku yang seumur hidup persoalannya hanya sebatas mengurus tata buku di suatu departemen di Bagian Urusan Sipil Liyue saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Tapi ternyata sekarang ... selain daripada pekerjaan operasional yang kami urus bersama, aku juga masih harus membantu Tuan Garcia mengatur tata bukunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Mungkin inilah yang dinamakan \"takdir\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
