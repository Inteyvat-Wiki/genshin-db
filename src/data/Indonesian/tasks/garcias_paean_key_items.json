			"dialogs": [
				{
					"id": 230135001,
					"content": "Tuan, sepertinya ini tempatnya. Sekarang tinggal cari orang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Tuan? Tuan Garcia? Apa Tuan mendengarkan saya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Eh? Oh ... aku dengar kok. Ayo, kita cari orang. Harusnya sih tidak akan makan waktu lama ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Apa kamu ... baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "Pengembara, hahaha ... aku tidak apa-apa. Memangnya aku terlihat sedang ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Sekarang aku mencurahkan seluruh perhatian untuk penelitian \"mesin hitung\", dan kurasa tinggal sedikit lagi saja sampai membuahkan hasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Kalau rela, bisa tolong carikan aku Slime Condensate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Mumpung ada kamu, jadi tidak usah cari orang di kota. Aku ada sedikit uang, jadi upahnya bisa lebih layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "Kalau begitu tolong ya, Pengembara. Aku masih harus pikirkan cara mengubah struktur mesinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Bisa kok, tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
