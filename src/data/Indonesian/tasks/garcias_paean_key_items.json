			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, uang kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Kita akan selalu punya cara untuk bertahan hidup, Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "Ada pepatah kuno dari kami orang Liyue, \"Di mana ada kemauan, di situ ada jalan.\" Saya rasa ini cocok sekali untuk menggambarkan keadaan kita sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Pepatah ini artinya sekalipun ada rintangan yang menghadang, tapi kita pasti akan bisa menemukan cara untuk melewatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Aha, perumpamaan yang sangat cocok sekali. Kelihatannya kondisi kita sekarang ini tidak terlalu gawat juga, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Tuan Garcia, menurutmu orang yang menulis pepatah ini waktu itu ... punya jurus ampuh apa yang bisa membuat kita bisa menembus gunungnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Eh? Oh, sial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
