			"dialogs": [
				{
					"id": 230131101,
					"content": "Tuan Garcia, sekali lagi saya menyarankanmu dengan tulus hati kalau kita sebaiknya menjual beberapa buku untuk mendapatkan uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Tidak! Tentu saja tidak! Lutong sahabat karibku, kamu ini mau aku menjual jiwaku ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Tuan, tapi ini kan bukan jiwamu yang mau dijual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Kenapa kamu masih di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "Pengembara, kamu ada di sini juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Eh ... percobaanku sebelumnya gagal. Ada yang salah dengan Slime Condensate-nya saat aku encerkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Pelumas yang dihasilkan tidak melumasi bantalan \"mesin hitung\", malahan membuatnya semakin gampang macet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Jadi aku butuh lebih banyak Slime Condensate untuk percobaan ini. Apa kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "Kalau begitu urusan Slime Condensate-nya kuserahkan padamu, Pengembara. Aku akan menyiapkan imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Apa kalian tidak punya cara untuk mencari uang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Bukan tidak punya cara cari uang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "Tapi tidak ada kemampuan untuk cari uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Terima kasih sudah melengkapi kalimatnya, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "*menghela napas* Memalukan sekali ... Walaupun kubilang sudah membuat \"mesin hitung\"-nya, tapi fiturnya terlalu sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Bagaimana ya, bahkan untuk \"mengoperasikannya\" saja aku masih harus menjalankannya secara manual dan tidak bisa beroperasi secara otomatis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Tapi ... aku akan terus menyempurnakannya! Aku sangat yakin kalau suatu hari nanti \"mesin hitung\"ku akan menjadi sebuah penemuan yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Sebuah ... sebuah penemuan yang menyatakan pergantian era lama ke era baru! Lalu aku pasti punya cara untuk mendapatkan uang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "Ta—Tapi sebelum itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Kamu masih butuh Slime Condensate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
