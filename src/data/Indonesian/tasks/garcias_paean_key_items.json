					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Betul, Nona Kaia. Tuan Garcia memang tidak bilang apa-apa, tapi dia jadi susah konsentrasi ketika bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "Terus dia tidak mau main ke kafe lagi. Sekarang selalu minta aku yang ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Bahkan Tuan Ahangar saja mau bantu bicara dengan Tuan Garcia kalau perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Saya juga tidak tahu harus bagaimana. Saya tidak ada pengalaman menghadapi situasi begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "Selalu saja ada halangan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
