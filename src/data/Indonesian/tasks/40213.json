			"dialogs": [
				{
					"id": 402130101,
					"content": "Maaf, semua salahku! Bisa ada kelalaian seperti ini, membiarkan orang asing menggunakan aset Biro Desain ... Aku pasti akan menyelidikinya sampai tuntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "\"Praporshchik\""
				},
				{
					"id": 402130102,
					"content": "Tidak perlu memeriksanya, bawa orang-orangmu kembali dan ambil alih kembali fasilitas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "\"Kapitan-Poruchik\""
				},
				{
					"id": 402130103,
					"content": "Tidak perlu memeriksanya ... ini perintah dari atasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "\"Praporshchik\""
				},
				{
					"id": 402130104,
					"content": "Tidak perlu periksa, paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "\"Kapitan-Poruchik\""
				},
				{
					"id": 402130105,
					"content": "Siap, Kapitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "\"Praporshchik\""
				},
				{
					"id": 402130106,
					"content": "Eh? Sejak kapan kalian di sini? Fasilitas ini bagian dari Biro Desain Eksperimental Kuuvahki. Orang yang tidak berkepentingan harap segera pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kapitan-Poruchik\""
				}
			]
