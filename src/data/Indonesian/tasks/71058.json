				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "*uhuk uhuk* Tu-Tunggu! Siapa kalian? Kenapa ada di sini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "Terus ... kenapa kalian serang aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Justru kami yang mau tanya! Kami lihat kamu mengendap-endap, tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Kan kamu orang jahatnya, jadi silakan, kamu yang bicara duluan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Katarina. Namaku Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Hanya nama saja yang boleh kukatakan, sisanya rahasia. Mohon maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Eh ... Kami kan cuma nanya keadaan, bukan mau interogasi loh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Ma-Maaf. Itu saja yang boleh kukatakan",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Fatui mau ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Apa sih! Orang jahat zaman sekarang, suka banget main rahasia-rahasiaan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Hehe, iya. Kami memang orang jahat, dan begitulah cara kerja kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "Oke, waktu tanya jawab sudah selesai ... Kami sedang ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
