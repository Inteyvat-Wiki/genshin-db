				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Terima kasih ya ... kalian tidak menusukku dari belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Sama-sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Heh ... Aku tidak tahu kenapa kamu bisa punya prasangka seperti itu. Tapi merayu orang di tempat seperti ini sama sekali tidak romantis ... Kalau mau bicara, datang ke tempatku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina pun pergi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Hah? Dia Fatui loh! Masa mau dilepas gitu saja? Enggak akan lapor ke Millelith?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Uh, ya sudah. Lagian dia memang enggak ngapa-ngapain kita sih, lepasin saja lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Apa semua Fatui hatinya susah percaya sama orang? Selalu curiga, begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "Kalian datang, sesuai perkiraan. Silakan duduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Sebentar ya, biar kubuatkan ... Ah, tehnya ternyata sudah habis ... Gula juga ... Kalau susu, oh ada ... tapi sudah basi. Nanti dibuang deh ... Maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Tapi Fire-Water masih ada banyak, lalu ada juga biskuit kering dan selai asam. Cukup lah kalau cuma buat sekadar teman minum teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Hebat! Kalian pikir minum teh pakai Fire-Water itu biasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Iya, memangnya tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Hem ... Enggak deh. Makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Kenapa? Hehe, di sini tidak ada yang melarangmu minum. Semua terserah kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Kamu lagi apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "\"Berbagi makanan dan sedikit info di waktu yang tepat, sangat berguna untuk membungkam mulut-mulut yang penasaran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "Begitulah yang tertulis di buku panduan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Oke, terus infonya mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Eh? Barusan kan aku sudah kasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Apa sih? Tadi kamu ngomong apa gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "Buku Panduan Pelatihan Pasukan Terdepan Fatui, pasal 4-4, baris 32: \"Berbagi makanan dan sedikit info di waktu yang tepat, sangat berguna untuk membungkam mulut-mulut yang penasaran\". Itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Untuk balas jasa karena kamu sudah tolong aku, isi buku panduan pelatihan yang rahasia saja rela aku bagi. Hehe, ketulusanku tidak tersampaikan ke kamu sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "Yang itu apa gunanya coba?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Hehe, kita sudahi saja bercandanya. Aku memang sangat berterima kasih atas bantuan kalian. Tapi tindakanku ini juga tidak ada maksud lain di belakangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Eh, kalau ingat tindakan kalian dulu, Paimon susah loh, bisa percaya ada Fatui yang baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Apa tujuanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Tidak aneh kalau pihak luar gagal memahami tujuan utama Fatui. Tapi kalau tidak sedang bicara tentang tujuan, dan tidak mengindahkan kepada siapa kami berpihak, kami ini cuma manusia biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "Selain itu, segala tindakan yang kami ambil hanya bertujuan untuk mempersiapkan diri menghadapi pertempuran terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "Pertempuran terakhir ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Benar, yang harus kita hadapi akhirnya adalah musuh bersama dan malam panjang yang tidak bisa dihindari. Bahkan warga Snezhnaya sudah menerima peringatan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Jadi, di dunia yang kejam ini, semua darah dan air mata yang diteteskan oleh manusia ... tidak akan ada yang sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Yuk bersulang! Kamu enggak mau? Hmph, ya sudah aku bersulang sendiri saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "Kamu sedang cari pembenaran untuk perbuatan jahatmu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Mungkin juga ya ... Entahlah, aku tidak peduli. Kamu ingin dengar penjelasan, dan aku sudah memberikannya. Hanya saja versiku mungkin tidak sesuai dengan yang kamu mau. Begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Hemmm .... Paimon enggak nyangka kalian tiba-tiba jadi ngomongin hal serius gini ... Aneh, tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "Oh ya, aku sudah memperkenalkan diriku. Tapi aku belum tahu nama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Namaku Paimon! Kamu pasti sudah pernah dengar juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Oh! Nama kalian ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "Hehe. Gimana? Nama kami pasti sudah tersebar sampai seluruh benua Teyvat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "Maaf, aku betulan belum pernah dengar nama kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Aku tidak bermaksud menyinggung kalian. Cuma aku sudah diutus ke sini lama sekali. Selain informasi yang diberikan dari barisan perbekalan, bisa dibilang kami sudah buta sama sekali dengan informasi apa pun yang ada di atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "He? Kalau begitu ....",
