			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Kamu tidak akan bisa menemukan tempat persembunyianku kali ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Kalau kamu sembunyi di tempat yang kayak gitu sih nanti yang bakal cari kamu bukan aku lagi, tapi papa mamamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030103,
					"content": "Kalian lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Aku lagi main petak umpet sama kakakku! Tapi ... dia sudah tahu semua tempat sembunyiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut ... kita kan sudah main sejak lama, semua tempat sudah pernah kamu pakai buat sembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030106,
					"content": "Bahkan di tempat-tempat terlarang itu ... aku kan sudah berkali-kali jelaskan kenapa tidak boleh sembunyi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030107,
					"content": "Tempat-tempat itu tidak berbahaya kok, papa mama saja yang berlebihan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Tapi kalau kamu sembunyi di tempat seperti itu, nanti baju dan celanamu jadi kotor atau rusak. Papa mama kan sudah capek bekerja, jangan sampai menambah pekerjaan mereka lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030109,
					"content": "Oh ... ya sudah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Bagaimana kalau ... aku temani kalian main?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Yang benar?! Kakak mau temani kita main?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, jangan merepotkan orang lain ah! Maaf ya, adikku ini memang tahunya cuma main saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030114,
					"content": "Tidak apa kok, aku memang lagi senggang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "Oke deh! Tuh Kak, dia sudah setuju kok! Kali ini aku pasti lebih jago sembunyi daripada Kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "Ya sudah deh, kalau begitu tolong ya Kak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030118,
					"content": "Verut, Kakak ingatkan lagi ya jangan sembunyi ke tempat-tempat itu. Hari ini papa mama pulangnya malam, kalau bajumu rusak tidak ada yang bisa bantu perbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030119,
					"content": "Iya, iya, aku ngerti kok. Kakak sudah bilang berapa kali ... Aku mau sembunyi dulu, Kakak ikut main juga ya! Ayo, ayo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Kamu duluan saja, aku sudah tahu mau sembunyi di mana kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030121,
					"content": "Yang benar? Kakak omong besar doang ah! Pasti nanti Kakak yang tertangkap duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurele dan Verut pun masing-masing pergi bersembunyi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Ah, tidak repot kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Rasanya sih aku tidak bisa menemukan kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
