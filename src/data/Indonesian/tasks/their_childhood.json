			"dialogs": [
				{
					"id": 240030701,
					"content": "Kapan ya Verut bisa jadi lebih dewasa .... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030702,
					"content": "Kamu tidak mau pergi sembunyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Sebenarnya aku sedang tidak ingin main. Kalau bukan karena Verut yang terus mengajakku main petak umpet, aku sih mau baca buku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030704,
					"content": "Papa mama sibuk sekali bekerja, jadi aku ingin cepat dewasa agar bisa meringankan beban mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030705,
					"content": "Tapi Verut selalu bilang dia kangen mama. Jadi aku cuma bisa temani dia main supaya dia tidak nangis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030706,
					"content": "Maaf ya Kak kalau aku bawel. Aku tunggu di titik kumpul dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030707,
					"content": "Mudah-mudahan Verut tidak bikin bajunya jadi kotor ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
