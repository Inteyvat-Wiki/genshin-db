			"dialogs": [
				{
					"id": 240030901,
					"content": "Kak! Kakak yang kasih tahu soal tempat sembunyiku ya? Kok cepat sekali aku ketahuannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Kan sudah kubilang, tempatmu sembunyi terlalu gampang ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030903,
					"content": "Aku ini sudah banyak pengalaman main petak umpet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Oh ya?! Kalau gitu Kakak bisa sering-sering datang ke sini enggak? Nanti kita main sama-sama lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Papa Mama selalu enggak ada di rumah, Kakak juga selalu baca buku ... enggak ada yang temani aku main ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Kamu kan juga bisa baca-baca buku dari rak buku seperti Kakak. Lebih seru dan lebih berguna daripada main petak umpet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030908,
					"content": "Me-Mending aku minta Mama ajarin aku jahit baju ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "Aku ini ahlinya main petak umpet.",
