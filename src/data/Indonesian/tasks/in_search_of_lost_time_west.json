			"dialogs": [
				{
					"id": 740120501,
					"content": "Wah, ketat banget! Paimon enggak bakal mau kerja sama orang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "Dia masih ngomong soal \"rasa kehormatan bersama\" ... Makan saja enggak boleh, masih ada rasa kehormatan apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Yang dia bilang masuk akal sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Benar-benar peraturan yang aneh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Yah, disiplin memang penting sih ... tapi ya enggak perlu sampai segitunya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Makanya! Orang yang makin enggak tahu gimana melakukan kerja yang nyata, makin suka menerapkan kedisiplinan dan bikin aturan yang aneh kayak gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Eh? Kalau dipikir lagi, mungkin kita bisa bikin keributan dan mancing si kapten tim yang namanya Shumilov itu turun, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#Terus, kita mungkin bisa naik ... {NICKNAME}, yuk kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
