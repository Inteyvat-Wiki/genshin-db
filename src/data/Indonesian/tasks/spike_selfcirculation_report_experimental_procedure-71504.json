			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#Hei, {NICKNAME}, kami sudah beres nih. Pas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040202,
					"content": "Si orang Sumeru itu sudah jelaskan soal balon ini kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040203,
					"content": "\"Orang Sumeru\" apaan, Hosseini itu ke sini buat bantu kita mengurus masalah lumpur hitam loh, setidaknya ingat lah namanya, sopan santun itu perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "E-Eh, itu ... aku sebut gitu biar kesannya lebih akrab saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040205,
					"content": "Terserahlah. Oke, balon sudah siap, dan alatnya sudah dimuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, kalau perlu bantuan si penambang juara .... *uhuk* sudahlah, aku tidak dalam kondisi yang tepat buat bantu-bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040207,
					"content": "Sadar juga akhirnya. Sudah, sana istirahat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "*huff* Kalau sudah siap, tinggal jalankan saja balonnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tu"
				}
			]
