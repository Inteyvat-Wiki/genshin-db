			"dialogs": [
				{
					"id": 715040101,
					"content": "*uhuk* *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040102,
					"content": "Hosseini, kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040103,
					"content": "Kurasa pengaruh hawa di sini mulai terasa. Mungkin aku terlalu lama diam di sini waktu memikirkan cara memindahkan Pursina's Spike ke bukaan Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040104,
					"content": "Tenang, tidak apa-apa. Aku sudah istirahat dan sudah merasa baikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040105,
					"content": "Dan aku juga terpikir satu jalan keluar, tapi ... Yah, boleh dibilang memikirkan cara untuk memindahkan Pursina's Spike tidak lebih susah daripada cari alasan untuk perpanjangan waktu pengumpulan jurnal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040106,
					"content": "Lumpur hitam melekat di permukaan tanah, jadi kita bisa akali situasi ini dengan cara memindahkan Pursina's Spike pakai balon transport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040107,
					"content": "Ohhhh, ide bagus tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040108,
					"content": "Yah, cara ini bisa mengatasi sebagian masalah lumpur kita, tapi untuk area-area yang sudah terblokir, mungkin balon transport-nya tidak bisa lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040109,
					"content": "Dan tentunya, masih ada monster yang tertarik oleh lumpur hitam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040110,
					"content": "Yah, urusan yang satu itu mau tidak mau jadi bagianmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040111,
					"content": "#Jangan takut! Monster mana yang kuat lawan Paimon dan {NICKNAME}? Sekali hajar langsung rata semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040112,
					"content": "Oke Paimon, semangat ya berantemnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "Eh? Ko-Kok gitu sih? Paimon kan tugasnya nyemangatin kamu dari pinggir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040115,
					"content": "Hahaha! *uhuk* *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040116,
					"content": "Waduh, tertawa sedikit saja batuknya sampai separah ini ya. Ya sudah, sekarang Tu dan Hao lagi menyiapkan Pursina's Spike dan balon transportnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040117,
					"content": "Aku tadinya mau ikut memuat Pursina's Spike, tapi sekarang berdiri agak lama saja bikin aku batuk parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040118,
					"content": "Memalukan ... setelah ini selesai, aku akan mulai melatih fisik juga, disamping melatih mental ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040119,
					"content": "Kamu cari mereka dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040113,
					"content": "Nih, Paimon boleh pakai pedang punyaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
