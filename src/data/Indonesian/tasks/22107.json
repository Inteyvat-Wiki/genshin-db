					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Tidak tahu karena alasan apa mereka bisa bertemu, mengenal satu sama lain dan saling mencintai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*huff* Sayang sekali aku bukanlah seekor merpati. Aku tidak akan pernah merasakan manisnya percintaan merpati... Oh, betapa kejamnya takdir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Tapi kamu bisa pergi merasakan rasa manisnya merpati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Rasa manisnya merpati? Tunggu, tunggu... Kamu... Aku... Kamu tidak mungkin...",
