					"content": "Bukankah persahabatan semulia ini harus kita jaga dengan baik?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Lagi pula, pertanda sebaik ini ditemukan dengan susah payah. Dan kamu... kenapa kamu menghancurkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Sudahlah, tolong tinggalkan aku sendiri di sini. Aku butuh waktu untuk menenangkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
