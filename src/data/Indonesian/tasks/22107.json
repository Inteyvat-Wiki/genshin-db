						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Aku melihat sebuah toko yang hari ini usahanya lancar jaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Usahanya lancar jaya, berarti uangnya juga masuk dengan deras? Ini lumayan bagus... terdengar menjanjikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Apa yang ditabur, itulah yang akan dituai. Kesabaran dan ketekunan akan menghasilkan buah yang manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "... Pertanda ini memberitahuku bahwa, tidak peduli dalam kehidupan manusia ataupun dalam percintaan, kita harus bersabar dan bertekun untuk mendapatkan hasil yang manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "*uhuk* Anu, terima kasih atas bantuan kalian. Aku harus memikirkan pertanda ini baik-baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Qiming! Suatu hari nanti aku akan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
