			]
		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210710",
							"2"
						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Aku melihat sepasang burung bertengger di atas atap...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Wah! Bagus sekali! Ini pertanda baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Dua ekor burung merpati yang saling mencintai menjauh dari kelompoknya dan saling bertatap-tatapan. Yang hanya mereka inginkan adalah bisa mengepakkan sayap bersama-sama melintasi cakrawala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "Maksud yang tersirat dari pertanda ini: Aku pasti akan bertemu seseorang yang hanya mencintaiku seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "... Kemudian aku dan dia menghadapi kesulitan dan rintangan sulit bersama, membebaskan diri dari orang-orang yang menghadang, lalu bersama-sama mengarungi dunia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "*uhuk* ! Anu, terima kasih, terima kasih... Aku akan mencari waktu untuk menanyakan hal ini dengan Qiming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210711",
