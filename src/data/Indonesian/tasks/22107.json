				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "\"Cinta itu mungkin masih jauh darimu, atau mungkin sudah dekat di depan mata. Kamu tidak perlu memaksanya untuk datang. Karena suatu hari nanti, cinta akan datang dengan sendirinya kepadamu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070102,
					"content": "Apa yang sedang kamu bicarakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "Keberuntungan cintaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070104,
					"content": "Seperti itulah yang diramalkan Qiming tentang keberuntungan cintaku. Cinta itu mungkin masih jauh darimu, atau mungkin sudah dekat di depan mata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070105,
					"content": "Dia pasti mengisyaratkan sesuatu... Tapi apa maksud dari perkataannya itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070106,
					"content": "Pendongeng pernah mengatakan bahwa saat \"keberuntungan\" datang menghampiri, beberapa pertanda akan muncul di sekitarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070107,
					"content": "Aku rasa \"keberuntungan cintaku\" sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070108,
					"content": "Apa kamu bisa membantuku memeriksa di sekeliling, mengecek apakah ada \"pertanda\" tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "Hore! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070110,
					"content": "Kenapa kamu tidak mengeceknya sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "Apa kamu mendengar sebuah pepatah yang mengatakan, \"Orang yang tidak terlibat dapat menilai dengan objektif, sedang yang terlibat akan menilai dengan lebih subjektif\"? Kalau aku mencari pertandanya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070113,
					"content": "... Aku mungkin akan merasa segala hal yang kulihat adalah pertanda kedatangan \"keberuntungan cinta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070114,
					"content": "Itulah sebabnya aku meminta bantuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
