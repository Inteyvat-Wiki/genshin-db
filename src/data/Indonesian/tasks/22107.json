				{
					"id": 221071901,
					"content": "Ada segerombolan anak anjing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071902
					]
				},
				{
					"id": 221071902,
					"content": "A-apa maksud pertanda ini? Apa maksudnya berarti percintaanku harus berakhir sebelum dimulai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071903
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071903,
					"content": "Loh? Tapi anak-anak anjing itu kelihatannya berteman baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071904,
					"content": "Aku tahu mereka. Hubungan mereka memang baik, mereka sering bermain bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Walaupun kelihatannya baik, tapi kenyataannya adalah... Tak ada satu pun dari mereka menemukan pasangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "Ditambah lagi, karena ada teman bermain, mereka tidak memedulikan masalah pasangan sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Mereka sekarang sudah punya kesempatan untuk mencari pasangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "Apa maksudmu? Apa... Kamu menangkap dan memisahkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "Ide seperti itu cukup bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "Saat kita terperangkap dan kehilangan arah, terkadang kita memerlukan dorongan dari orang lain untuk bisa keluar dan mencari cinta sejati kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Terima kasih banyak! Aku akhirnya mengerti apa maksud pertanda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071912,
					"content": "Qiming, aku pasti akan...",
