						221071402
					]
				},
				{
					"id": 221071402,
					"content": "A-apa maksud pertanda ini? Apa maksudnya berarti percintaanku harus berakhir sebelum dimulai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Loh? Tapi anak-anak anjing itu kelihatannya berteman baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "Aku tahu mereka. Hubungan mereka memang baik, mereka sering bermain bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Walaupun kelihatannya baik, tapi kenyataannya adalah... Tak ada satu pun dari mereka menemukan pasangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Cepat atau lambat mereka akan menua, dan kemudian semuanya akan terlambat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Apa arti pertanda ini adalah... Aku hanya bisa bermain dengan teman-temanku untuk mengisi waktu, lalu selamanya tidak bisa menemukan pasangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "Aku, aku ingin menenangkan diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
