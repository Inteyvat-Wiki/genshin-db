					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "Aku bangga sekali sama kalian ... ayo, pasti bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
