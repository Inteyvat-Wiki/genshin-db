				},
				{
					"id": 150400703,
					"content": "Ini sih bakal kelihatan dari jauh banget kalau sudah diwarnai. Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
