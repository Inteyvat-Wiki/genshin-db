			"dialogs": [
				{
					"id": 150400701,
					"content": "Baiklah. Tamu yang terhormat, kita sudah sampai di lokasi \"Asha Mengudara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
