			"dialogs": [
				{
					"id": 150400601,
					"content": "Ha, seru sekali! Asyik! Makasih banyak lawanku yang tercinta, yang barusan itu MANTAP!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "Bukan lawan kaleng-kaleng rupanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "Kerja bagus, kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Selamat atas kemenangannya, {NICKNAME}. Dan terima kasih banyak untuk penolong kami dan Asha untuk kerja sama tim yang luar biasa kompak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Waktu pertama dengar kamu menafsirkan maksud Asha tadi, jujur aku tidak percaya. Tapi setelah melihat pertandingan barusan, rasanya ... luar biasa sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Aku juga ngerasa gitu! Tegang banget waktu kalian tanding tadi, serunya kayak nonton pertandingan final Ziarah Kembalinya Api Keramat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Aku mengerti. Ketika pertarungan mencapai puncaknya, aku sendiri sulit menahan diri untuk tidak terbang dan ikut menembak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Sebentar, pelurumu memangnya bisa buat mewarnai ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Bisa saja. Tapi warnanya entah apa. Lagian Asha itu juga tidak bisa terbang lebih lama, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Umm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Haha! Tinggal selangkah lagi untuk menyelesaikan tantangan Asha Mengudara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "Kedua pahlawan, silakan nyalakan kuas Asha Mengudara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Mainkan timeline penanda Asha)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Keren, kan? Aku bisa rekomendasikan satu titik bagus buat foto bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "Kamu dan Asha kompak banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Harusnya aku minta si Paimon turun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Oh, sekarang baru ingat sama Paimon? TELAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
