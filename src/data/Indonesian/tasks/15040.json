			"dialogs": [
				{
					"id": 150400301,
					"content": "Wah, keren banget! Jadi sesuai sama namanya, \"Padang Bunga Berbusa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Kerja bagus, kalian! Sekarang tinggal kasih tahu si karyawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Sebentar, semuanya ... tunggu .... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Pas banget nih munculnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Santai, santai! Ambil napas dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*huff* Fiuh ... baiklah. Salam kenal semuanya, aku karyawan yang bertugas mengurusi acara utama di Tebing Warna, tantangan \"Asha Mengudara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Tadi aku lihat padang rumputnya berubah jadi padang bunga dari atas. Warnanya juga berseni sekali, cantik ... teropongku sampai nyaris jatuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "Kalian adalah penyelamat Tebing Warna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Hehe, cuma bantu-bantu saja kok. Mereka berdua yang kerja tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "#{M#Tuan-tuan penyelamat tebing}{F#Tuan dan Nona penyelamat tebing}, apa kalian berdua bersedia mencoba tantangannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "Atau ... boleh tidak kalian bantu mewarnai tempat kami juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Kayaknya keren banget tuh ... tapi memangnya boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Tentu saja boleh! Malah aku bakal bersyukur sekali kalau kalian bersedia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Kalian sudah sangat membantu rekanku yang malang, izinkan aku mewakilinya mengucapkan terima kasih yang sebesar-besarnya. Dan aku rasa pengalaman ini jauh lebih berharga daripada sekadar kompensasi berupa uang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Uhh, kalau Paimon sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Paimon setuju, dengan senang hati! Ya kan? Haha ... gimana cara ke sananya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Silakan ikuti aku. Kita naik balon udara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
