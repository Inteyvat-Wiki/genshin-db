					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360304,
					"content": "Selamat, Tuan Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360305,
					"content": "Kita menang ... aku tidak ... aku ... terima kasih, terima kasih kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360306,
					"content": "Lihat kan? Penilaianku soal industri hiburan di Fontaine belum pernah salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360307,
					"content": "Baiklah, produser film \"Si Dua Masketir\" Tuan Xavier dipersilakan naik ke atas panggung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Pembawa Acara Festival"
				},
				{
					"id": 401360308,
					"content": "Terima kasih banyak ... terima kasih atas dukungan, pengakuan, dan waktu kalian. Dalam kesempatan kali ini, aku juga hendak mengucapkan terima kasih kepada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360309,
					"content": "Waktu cepat sekali berlalu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360310,
					"content": "Rasanya baru kemarin kamu mengajariku cara memegang senapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360311,
					"content": "Kamu akan balik lagi ke Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360312,
					"content": "Tentunya! Aku senang sekali tempat ini. Begitu banyak hal baru dan menarik sampai aku sulit mengingat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360313,
					"content": "Kamu sendiri? Tertarik main ke Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360314,
					"content": "Aku belum pernah kepikiran sebelumnya ... tapi mungkin bisa mulai dipertimbangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360315,
					"content": "Aku akan menunggu. Senang sekali rasanya jika kamu bisa bertamu ke rumah dan mencicipi teh dan hidangan manis khas bangsa kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360316,
					"content": "Ya. Berkabarlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360317,
					"content": "Semua tujuanmu kemari tercapai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360318,
					"content": "Ya. Kamu juga, sekali-kali baliklah ke Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360319,
					"content": "Ogura dan tokonya apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360320,
					"content": "Setahuku dia baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360321,
					"content": "Titip salam ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360322,
					"content": "Baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360323,
					"content": "Aku dengar badai petirnya sudah reda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360324,
					"content": "Perangnya juga sudah berakhir. Kepulauan sudah kembali damai dan makmur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360325,
					"content": "Aku senang mendengarnya. Cocok untuk menjemur kain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360326,
					"content": "Aku ingin berterima kasih sekali lagi kepada para pemeran dan kru yang mengerjakan film ini! Aku tidak akan bisa menyelesaikan semuanya tanpa kalian, apalagi dapat berdiri di panggung ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360327,
					"content": "Dengan dukungan semua anggota, izinkan aku mengumumkan nama perusahaan baru kami, yakni \"Studio Masketir\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360328,
					"content": "Oh boleh juga tuh namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360329,
					"content": "Baiklah, semua kru dan pemeran dari Studio Masketir dipersilakan untuk naik ke panggung dan berfoto bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Pembawa Acara Festival"
				},
				{
					"id": 401360330,
					"content": "Oh! Paimon kira kita enggak bakal disuruh foto loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360331,
					"content": "Aku rasa Bu Sutradara kita adalah yang paling berhak mengangkat piala ini tinggi-tinggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360332,
					"content": "Hah? Eh, jangan lah ... tidak usah ... malu-maluin banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360333,
					"content": "Hak sutradara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360334,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360335,
					"content": "Cuma kamu yang boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Terima nasib, jangan berontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360337,
					"content": "Sudah siap semuanya? Tiga, dua, satu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Pembawa Acara Festival"
				},
				{
					"id": 401360338,
					"content": "Studio Masketir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
