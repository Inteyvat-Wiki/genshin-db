			"dialogs": [
				{
					"id": 401360101,
					"content": "Waktu pun berlalu ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Sudah lama ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "Hei, kalian. Maaf aku jarang kelihatan, sibuk dengan urusan marketing dan persiapan rilis sih, setelah kita selesai pasca produksinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "Upacaranya hari ini kan ya? Paimon penasaran kita menang enggak tuh \"Anugerah Furina\"-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Sembilan puluh persen menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Paimon enggak nyadar kamu sudah di sini. Lebih awal dari yang lain loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Aku yakin mereka akan segera datang. Hmm ... Xavier, kalau nanti disuruh naik panggung, kru kita ini bukannya harus punya nama ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Hah?! Tapi kan belum tentu menang. Jangan dirayakan sebelum diumumkan ah, nanti kita malah kena sial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Buka matamu hei! Sudah lihat reaksi penonton kan? Kita dipuji habis-habisan sama kritikus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Sudah bicara sama staf gedung opera juga kan? Mereka bilang mau menambah jumlah penayangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Itu duit hasil jualan tiketnya bisa kamu pakai buat buka studio film sendiri ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "Ta-Tapi kan yang hebat itu kru-nya! Berkat kalianlah semua ini bisa terjadi, jadi menentukan mau apa namanya tidak bisa cuma aku sendiri yang pilih dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Yah, pokoknya pikirin saja dulu. Aku yakin yang lain pasti setuju-setuju saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Baiklah ... {NICKNAME} dan Paimon, maaf ... boleh minta tolong kalian berkunjung ke Benteng Meropide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Ha? Tapi kami mau ikutan upacaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Aku ingin minta tolong kalian ajak Nona Chevreuse. Dia kan salah satu pemeran utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Aku tidak bisa menghubungi dia, jadi belum kasih undangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Menurut koran, para pelaku kasus pembunuhan senjata api akan diantar ke Benteng Meropide dengan dikawal langsung oleh kapten Pasukan Patroli Khusus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Oh, Paimon ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Tunggu ya Xavier, sambil pikirin gih mau kasih nama apa yang kece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Baiklah, tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
