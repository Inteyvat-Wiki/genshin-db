				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "Halo, Nona Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Oh? Pengucapan yang sempurna ... Sepertinya kita punya teman yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "Seseorang yang bernama Nona Columbina yang merekomendasikan jasamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "Nona Columbina adalah wanita yang sangat sulit ditebak. Aku yakin pertemuanmu dengannya pasti penuh kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "Memang benar. \"Sulit ditebak\" adalah deskripsi yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Senang berkenalan denganmu. Namaku Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "Le duc sous l'eau sendiri, senang berkenalan denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "Aku tidak mengira penyihir hebat sepertimu tahu tentangku. Sungguh suatu kehormatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "Atau mungkin kamu melihat kedatanganku di bintang-bintang, Nona Trismegistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Hehe ... Karena kita sudah saling kenal, tidak perlu terlalu formal. Panggil saja aku Barbeloth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "Kalau begitu, panggil saja aku Wriothesley. Ini bukan urusan resmi, jadi tidak perlu pakai gelar. Aku hanya warga Fontaine biasa yang sedang menikmati waktu luang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "Aku menemukan Conch Madeleine yang baru dipanggang dalam perjalanan ke sini. Kudengar para penyihir suka pesta teh. Silakan, ambillah satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Oh ya, ini adalah hidangan penutup yang sangat populer di pesta teh kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "Aku sudah cukup lama di sini, dan meramal banyak orang, tapi ini pertama kalinya ada yang datang membawa hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Terima kasih, Tuan Wriothesley. Aku pasti akan berbagi dengan Alice dan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "Rasanya telingaku jadi gatal? Barbie! Kamu harus menyisakan sedikit untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "Aku tidak bisa membiarkan Nicole mengambil semuanya begitu saja hanya karena aku terlambat, seperti yang dulu pernah dia lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "Ehem! Ya ya, aku akan pastikan dia menyisakan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Jujur saja, waktumu kurang tepat. Aku berharap bisa menjaga kehormatan Hexenzirkel di depan teman baru kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "Tidak apa-apa kok. Memangnya kenapa? Orang yang berkuasa tidak harus terus serius. Semua orang berhak punya kepribadian sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "Benar sekali! Faktanya, optimisme dan keceriaan merupakan persyaratan utama untuk memasuki Hexenzirkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "Baru pertama kali aku dengar soal syarat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "Soalnya baru saja kubuat! Hexenzirkel seharusnya membawa kebahagiaan bagi dunia. Sudah sewajarnya kita ceria dan optimis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "Kalau menurutku sendiri, aku mendukung semua orang untuk menikmati hidup dengan cara yang mereka inginkan, tentu saja asalkan tidak melanggar hukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "Itu syarat yang mungkin akan sulit untuk dipatuhi seorang Alice ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Wah, kalau begitu agak mengkhawatirkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "Hei, kalian berdua tahu tidak sih kalau aku masih di sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "Lagi pula, aku tidak akan melakukan tindakan kriminal di depan Pengelola Benteng Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "... Dan sekalipun aku mau, aku yakin ruanganmu jauh lebih luas dibanding ruang tahanan Knights of Favonius. Benar kan, Tuan Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Haha! Ruang isolasi biasa tidak mungkin bisa menahan penyihir legendaris sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "Aku yakin Nona Alice dengan sukarela menerima hukumannya, tidak diragukan lagi berkat kerendahan hatinya dan kepercayaannya yang tidak bisa dipertanyakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Tepat sekali, seratus untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Tolong hentikan, Tuan Wriothesley. Kamu seharusnya jangan menyemangatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Kalau suasana hatinya jadi bagus, tidak ada manusia yang bisa tahu apa yang akan dilakukan Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "Aku tahu persis maksudmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#Betul! {NICKNAME} itu Honorary Knight Knights of Favonius, tahu! Jangan ngomongin jelek-jelek soal ruang tahanan itu di belakangnya, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "Berarti tugas Honorary Knight adalah mengejar para penyihir yang kabur? Itu pasti akan jadi tontonan yang luar biasa. Jangan lupa undang aku untuk menontonnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "Kamu pasti suka banget kan nonton drama yang bakal kejadian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Tapi Paimon enggak sangka kamu bakal datang ke sini sendiri, Wriothesley. Lumayan kan, Paimon jadi enggak perlu repot-repot nyebur ke bawah air buat jemput kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "Ini pasti kekuatan ramalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "Ah, ngomong-ngomong, sepertinya sudah waktunya kita membahas urusan yang serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Tuan Wriothesley, baik sebagai penghormatan pada Nona Columbina atau sebagai terima kasih atas kue-kue manis darimu, silakan ambil satu kartu Lunar Arcana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Mungkin ada hadiah dari takdir tersembunyi di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "Apakah itu bisa dihitung sebagai ramalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "Kurang lebih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Kalau begitu, tidak akan ada satu pun penduduk Fontaine yang tidak menganggapnya serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Setelah mengatakan betapa seriusnya dia, Wriothesley langsung mengambil kartu paling atas ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "Aku tidak terlalu familier dengan kartu-kartu ini. Kartu ini sepertinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "Kartu Kaisar yang tegak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "Kamu terlihat kehilangan kata-kata ... apa ini kartu yang jelek? Tidak perlu khawatir, aku bisa menerima apa pun yang kamu katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "... Justru sebaliknya. Kartu ini melambangkan kekuasaan abadi dan otoritas yang tak tergoyahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "Jika ini merepresentasikan masa depanmu, maka kamu sudah mencapai tujuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "Tapi ... hehehe, takdirmu terus bergerak maju, selamanya berubah. Itu berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Mungkin yang berubah bukan orangnya, tapi lingkungannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Mmhmm ... Setidaknya untuk sementara ini, kecenderungan seperti itu memang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Kalau begitu, aku bisa lebih percaya intuisiku mulai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "Aku sebelumnya mengunjungi Nod-Krai untuk urusan resmi dan mendapat cukup banyak informasi. Sejak saat itu, aku terbiasa terus memperhatikan berita lokal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "Kemudian pada suatu malam, saat aku sedang menatap bulan yang bersinar terang sekali, aku tiba-tiba berpikir bahwa dunia sedang berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "Dunia terus berubah, namun dengan hadirnya variabel-variabel besar seperti ini, kita semua harus bersiap menghadapi hal yang tidak diketahui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "Meski begitu, melihat kartu yang kamu pilih, sepertinya kamu tidak perlu terlalu khawatir. Apa pun perubahan yang terjadi di lingkunganmu, kamu memiliki cara untuk beradaptasi atau bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "Berita yang bagus! Sepertinya pukulan yang kuterima tidak sia-sia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "Itu adalah pukulan yang penuh dengan harapan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "Karena penasaran, aku punya pertanyaan yang mungkin agak lancang ... Semoga kamu tidak keberatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "Licik sekali! Kamu sengaja mencoba membangkitkan rasa penasaran kami, Tuan Wriothesley! Sekarang, kami mau tidak mau harus bertanya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "Kalau begitu izinkan aku bicara terus terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "Sejak dulu aku selalu penasaran ... Bagaimana sebuah ramalan bisa memastikan dia sendiri terkabul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Contohnya diriku. Ramalanku mengatakan bahwa aku akan tetap stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "Tapi bagaimana jika, setelah mendengar ramalan ini, tiba-tiba aku merasa ingin melawan dan langsung melakukan sesuatu secara impulsif? Apa yang akan terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "Contohnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "Kamu meledakkan Benteng Meropide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Ya boleh, contohnya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "Kamu mau bahas itu lagi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "Tidak, jangan berani-berani ya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "Haha! Kebetulan sekali! Pas banget aku kenal seorang ahli peledak yang sangat pandai. Aku sangat merekomendasikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "Tapi tentu saja Honorary Knight akan bertindak sebagai penjaganya, muncul di saat kritis untuk menghentikan hal buruk terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "... Dan begitulah caranya ramalan itu terpenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "Dia terdengar seperti kekuatan yang sangat ... meledak-ledak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "Dan imut. Sangat imut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "Hah, kita lagi ngomongin Klee ya?! Wriothesley mungkin enggak tau kalau Klee itu anak Alice, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Sebenarnya, gelar lengkapnya adalah anak dari sang Petualang Hebat yang Pernah Berkunjung ke Berbagai Dunia, Dodo-King, sang Pelindung Mondstadt Kuno ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "Tidak ada waktu buat menyebut semua itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "Iya, iya ... dia itu Anak Alice si Dodo-King yang Paling Imut, yaitu sang Spark Knight sejati, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Kita seharusnya kembali ke rencana awalku dan mengadakan pesta yang meriah untuk semua orang, supaya aku bisa memperkenalkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "Dengan begitu, ketika Klee pergi ke Fontaine, dia akan punya banyak teman baru untuk minum teh bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "Kedengarannya seperti rencana yang bagus. Aku sudah tidak sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "Lagi pula, tidak mungkin aku menolak secangkir teh yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "Keberuntungan besar akan mendatangi mereka yang selamat dari bencana besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Tolong hormati ruang tahanannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
