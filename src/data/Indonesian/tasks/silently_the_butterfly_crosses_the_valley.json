					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "Hehehehe, karena Herblord mempercayakan pohon ini padaku, aku tidak bisa biarkan dia layu begitu saja! Terima kasih banyak, manusia baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151203,
					"content": "Tapi bisa-bisanya kamu lupa mantranya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Masalah sepele begitu tidak perlu dipikirkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151205,
					"content": "Ngomong-ngomong, kalau kamu tertarik, aku kasih tahu satu rahasia kecil! Kalau kamu patahkan ranting bunga dan masukkan ke dalam kendi obat yang rusak di luar kediaman, nanti gerbang batunya akan terbuka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
