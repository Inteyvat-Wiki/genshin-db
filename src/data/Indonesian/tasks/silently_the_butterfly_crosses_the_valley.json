			"dialogs": [
				{
					"id": 711150601,
					"content": "Fiuh ... betul. Begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150602,
					"content": "Dulu Herblord menggunakan kupu-kupu warna-warni untuk menghias pintu, tapi mekanismenya sudah hancur. Kupu-kupu dan kendi obat ini aslinya dipakai untuk memelihara Pohon Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150603,
					"content": "Pohon Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Betul! Pohon Adeptus ini ditanam oleh Herblord, dulu sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150605,
					"content": "Walaupun sudah layu sekarang, Herblord pernah bilang asalkan kupu-kupu warna-warninya masih ada, pohonnya bisa hidup lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150606,
					"content": "*huff* Dia langsung pergi ketika sudah tidak mampu lagi mempertahankan wujud manusia. Apa kabarnya ya sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150607,
					"content": "Terus aku harus ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, maaf. Aku malah jadi teringat kenangan akan Herblord ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150609,
					"content": "Ehem, dengar baik-baik ya manusia! Cukup masukkan kupu-kupunya dalam kendi ini, maka pohon yang telah layu ini dapat hidup kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150610,
					"content": "Hehe, ini mekanisme Adeptus yang dirancang Herblord. Ajaib sekali kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150611,
					"content": "Aku coba deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "Baiklah, kalau begitu aku serahkan padamu ya, manusia baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150613,
					"content": "Kenapa kupu-kupu warna-warni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Eh? Kenapa ya ... Mungkin karena Herblord suka kupu-kupu berwarna warni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150615,
					"content": "Uh ... Pokoknya tolong bantu masukkan kembali kupu-kupunya ke dalam kendi ya, manusia baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
		},
