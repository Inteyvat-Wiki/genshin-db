			"dialogs": [
				{
					"id": 711150401,
					"content": "Uh... Eh? Siapa kalian? Mengganggu mimpi indahku saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150402,
					"content": "Eh?! Siapa tuh yang lagi bicara? Hih serem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150404,
					"content": "AAAHHH!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "HAHAHAHA! Kalian memang pantas takut! Kalau aku tidak terjebak dalam batu, kalian pasti sudah di dalam perutku sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150406,
					"content": "Hah? Oh Ternyata cuma patung batu yang bisa ngomong tuh ... Paimon pikir ada monster apaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Heh, apa maksudmu \"cuma patung batu yang bisa ngomong\"! Harusnya kamu takut kalau patung bisa bicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150408,
					"content": "Yah, soalnya kami sudah pernah ketemu bejibun patung yang mirip kamu di luar sana sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "A-Apa! Hmph, baiklah. Apa boleh buat kalau kalian tidak takut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150410,
					"content": "Ngapain juga kamu takut-takutin orang! Padahal cuma patung biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hei! Walaupun aku \"cuma patung biasa\", tempat ini adalah kediamannya Herblord! Dan dia tidak suka diganggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150412,
					"content": "Makanya aku yang harus usir semua pengganggu! Bahkan meski Herblord kini telah tiada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150413,
					"content": "Tapi kalian beda dari manusia biasa ya. Bisa-bisanya tidak terkejut melihatku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150414,
					"content": "Boleh tidak aku minta bantuan kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150415,
					"content": "Oh? Kamu butuh bantuan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Ehem. Kalian lihat kupu-kupu warna-warni ini? Sejak Herblord pergi, teman-teman kecil ini mulai bermunculan di mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150417,
					"content": "Sst, sebentar, di kepalamu ada seekor! Diam dulu, biar kami bantuin tangkap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
