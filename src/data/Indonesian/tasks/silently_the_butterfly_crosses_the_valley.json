			"dialogs": [
				{
					"id": 711151101,
					"content": "HEH, tukang bohong! Kami sudah masukin semua kupu-kupunya ke dalam kendi, tapi Pohon Adeptus-nya kok enggak ada perubahan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "Hmm? Siapa kalian? Pengganggu ... Oh, ternyata kalian ya, manusia baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151103,
					"content": "Oohh! Aku tidak sangka kalian benar-benar temukan kupu-kupu warna-warninya! Padahal aku cuma asal bunyi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151104,
					"content": "Tidak, tidak! Maksudku ... aku juga merasakan kekuatan Adeptus! Selanjutnya kita cuma perlu baca mantra Herblord, dan pohon itu bisa dihidupkan kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151105,
					"content": "Tunggu sebentar, mantranya bagaimana ya? Coba kuingat-ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151106,
					"content": "\"Pohon yang lahir di musim dingin, mekar dan layu seiring berjalannya waktu. Kembalilah ke masa jayamu, di musim semi ini ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151107,
					"content": "Kupu-kupu warna-warni terbang ... terbang ... Aku lupa kata-kata selanjutnya, tapi akhirnya semuanya hidup lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
		},
