			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Fiuh ... betul. Begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150502,
					"content": "Dulu Herblord menggunakan kupu-kupu warna-warni untuk menghias pintu, tapi mekanismenya sudah hancur. Kupu-kupu dan kendi obat ... aslinya dipakai untuk memelihara Pohon Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150503,
					"content": "Pohon Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Betul! Pohon Adeptus ini ditanam oleh Herblord, dulu sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150505,
					"content": "Walaupun sudah layu sekarang, Herblord pernah bilang asalkan kupu-kupu warna-warninya masih ada, pohonnya bisa hidup lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150506,
					"content": "*huff* Dia langsung pergi ketika sudah tidak mampu lagi mempertahankan wujud manusia. Apa kabarnya ya sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150507,
					"content": "\"Kupu-kupu berwarna-warni dalam kendi, pulihkan kembali pohon yang sudah layu ....\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Betul, betul! Tunggu ... kok kalian bisa tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150509,
					"content": "Terserah deh, intinya begitu! Kamu cuma perlu masukkan kupu-kupunya dalam kendi ini, terus kasih ke pohon layunya! Kalau begitu kuserahkan pada kalian ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
		},
