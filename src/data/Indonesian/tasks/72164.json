				},
				{
					"id": 721640310,
					"content": "Pokoknya, pekerjaan itu kuserahkan padamu ya. Ada serangga-serangga yang menyelinap masuk ke kuil, dan diriku harus pergi mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640311,
					"content": "Jadi, siapa yang biasanya merapikan kuil...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "Hibiki. Kadang Domeki juga membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640313,
					"content": "Hibiki sering menggunakan tongkat itu dan menggerakkannya ke sana kemari di lantai. Lalu dia juga akan menuangkan air ke lantai. Ugh, air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
