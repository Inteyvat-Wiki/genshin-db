				{
					"id": 721640201,
					"content": "Apakah kamu sudah selesai \"bersih-bersih\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640202,
					"content": "Semuanya sudah bersih berkilau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Miaw, miaw. Bagus sekali. Diriku juga sudah mengusir serangga-serangga penyusup itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640204,
					"content": "Hmm, kuil ini semakin terlihat seperti kuil. Kotaknya sudah diperbaiki, dan kuilnya sudah bersih... Ya, harusnya akan ada semakin banyak orang datang untuk berdoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Miaw, miaw... Kita harus mengembalikan kejayaan kuil ini, ya... Miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Hari ini cukup sampai sini. Terima kasih atas segala bantuan kalian... miaw, miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640207,
					"content": "Berbicara bahasa kalian... melelahkan sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640208,
					"content": "Diriku akan beristirahat dulu. Mungkin bantuan kalian akan dibutuhkan lagi nanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640209,
					"content": "Kalau waktu itu tiba, kembalilah lagi ke sini... miaw, miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
