			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Miaw... Kotak itu benar-benar berguna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "Ah, kamu sudah kembali. Kotak yang kamu perbaiki benar-benar menunjukkan gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "Tak lama setelah kalian pergi, dua manusia hijau datang ke kuil, miaw, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "Mereka tidak hanya memberikan beberapa Mora, tapi manusia hijau yang tinggi itu juga sangat bersemangat saat mendengar diriku bicara. Ah, manusia memang mudah sekali terkejut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "Tetapi, Kotak Uang ini benar-benar menakjubkan sekali. Mungkin kalau diperbaiki sekali lagi, akan semakin banyak orang yang datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "Uh, bukan begitu cara kerjanya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Benarkah? Urusan manusia memang merepotkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "Pa—Paimon rasa masalah ini ada hubungannya dengan kondisi kuil deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Ada apa dengan kuil ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "Sedikit berantakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Ah, benarkah begitu? Anak-anak bandel itu memang suka sekali bermain di dedaunan kering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "Ah, tapi kalau diriku tidak salah mengingat, Hibiki dulu sering menggunakan tongkat panjang dengan ujung runcing untuk mengumpulkan daunnya. Kalau dia melakukannya, pasti itu tindakan yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "Bagian mana yang mau disapu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Tentu saja diriku tidak tahu tentang berbagai pekerjaan manusia, kan? Tapi ... kalau Hibiki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "Hibiki sering menggunakan tongkat itu dan menggerakkannya ke sana kemari di lantai. Ya, diriku ingat suka bermain mengejar tongkat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "Tapi karena sekarang diriku adalah pengganti kepala pendeta, diriku tidak pantas melakukan hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "Tapi diriku ingat kalau Hibiki juga menggunakan air di lantai... air adalah benda yang buruk sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "Terkadang Domeki juga akan datang, lalu menggunakan dua bilah besi untuk memotong sana sini! Dedaunan dan ranting pohon pun berjatuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Seorang manusia yang sangat tinggi dan bersuara lantang. Dia dan Hibiki sering bermain bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "Huh. Si berandal itu selalu memotong ranting kesukaan diriku. Sungguh mengesalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "Kedengarannya seperti sedang bersih-bersih. Atau bisa dibilang beres-beres juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Pel lantai, bilas dengan air, lalu memotong ranting pohon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "Kedengarannya seperti pekerjaan yang familier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Jadi ini yang disebut \"bersih-bersih\"? Diriku sudah mengerti, bisakah kalian melakukannya juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "Ah ya, kalian tidak perlu \"memotong sana sini\". Diriku menyukai ranting pohon seperti apa adanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "Tongkat panjang, dedaunan, dan airnya saja sudah cukup. Apa kalian mengerti kata-kata diriku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "Kamu tidak perlu khawatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Miaw! Ya, ini tugas yang diberikan pada diriku secara langsung oleh Hibiki. Tugas penting yang hanya bisa diselesaikan diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "Bolehkah... aku tanya siapa itu Hibiki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki adalah Hibiki. Dia kepala pendeta di Kuil Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "Jadi namamu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Nama diriku adalah Neko, nama yang diberikan oleh Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "Biasanya dia yang selalu menyambut tamu di kuil, diriku tidak perlu mengurus kuilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "Dulu, diriku tidak punya nama atau jabatan. Diriku tidur di mana pun diriku mau, dan bermain dengan siapa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Suatu hari, Hibiki bilang kalau dia akan memanggil diriku \"Neko\", karena diriku sering tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640140,
					"content": "Sekarang Hibiki tidak di sini, tapi sebuah kuil harus punya kepala pendeta, jadi diriku yang mengambil posisi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640141,
					"content": "Itulah kenapa diriku ingin membuat kuil ini menjadi ramai lagi sebelum Hibiki kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640142,
					"content": "Benar sekali! Sekali dia kembali, diriku bisa tidur lagi di pelukannya, dan tidak perlu menunggunya memperbaiki Kotak Uang, atau menunggunya selesai membersihkan dedaunan dengan tongkat panjang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640143,
					"content": "Pokoknya, pekerjaan itu kuserahkan padamu ya. Ada serangga-serangga yang menyelinap masuk ke kuil, dan diriku harus pergi mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640123,
					"content": "Potong sana sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "Mungkin maksud Neko memotong ranting pohonnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "Apa yang sebenarnya mau kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
					"content": "Mungkin bisa dibereskan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				}
			]
		},
