					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "Nama diriku adalah Neko, nama yang diberikan oleh Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640304,
					"content": "Biasanya dia yang selalu menyambut tamu di kuil, diriku tidak perlu mengurus kuilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640305,
					"content": "Dulu, diriku tidak punya nama atau jabatan. Diriku tidur di mana pun diriku mau, dan bermain dengan siapa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640306,
					"content": "Suatu hari, Hibiki bilang kalau dia akan memanggil diriku \"Neko\", karena diriku sering tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640307,
					"content": "Sekarang Hibiki tidak di sini, tapi sebuah kuil harus punya kepala pendeta, jadi diriku yang mengambil posisi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
