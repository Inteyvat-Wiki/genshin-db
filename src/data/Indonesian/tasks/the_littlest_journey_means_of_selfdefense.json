					"Master Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Eh? Dua bijih ini tidak sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300102,
					"content": "Tentu saja tidak. Kualitas dan harga barang yang ditempa dari kedua bijih ini akan jauh berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300103,
					"content": "Ummm, tapi kedua bijih ini hanya sisa ini saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300104,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300105,
					"content": "Kalian berdua sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Halo, kak {NICKNAME}! Aku sedang bantu Papa memeriksa alat-alat besi yang dia pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300107,
					"content": "Paman Pandai Besi ini baik sekali! Dia bahkan janji akan membuatkan pedang kecil untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300108,
					"content": "Tapi dia bilang tokonya sedang kekurangan bahan-bahan mentah. Jadi pesanan Papa mungkin akan sedikit terlambat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300109,
					"content": "Aku juga tidak tahu kapan pedangku akan jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300110,
					"content": "*huff* Apa boleh buat. Belakangan ini kami sedang sibuk sekali, jadi kami sudah kehabisan bijih besi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300111,
					"content": "Tempat-tempat yang punya banyak bijih juga dipenuhi monster, aku tidak berani menambang ke sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300112,
					"content": "Yang bisa kulakukan adalah bertahan melewati musim sibuk ini, lalu meminta bantuan seorang petualang menemaniku pergi menambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300113,
					"content": "Tapi, kira-kira kapan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300114,
					"content": "#Kak {NICKNAME}, kudengar orang-orang bilang kalau kamu pandai melawan monster ya? Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300115,
					"content": "Kalau benar, bisakah bantu aku? Pliiis ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300116,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "Pengembara, apa kamu mau pergi melihat situasi di sana? Kalau begitu akan kutandai tempat aku biasa menambang di petamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300119,
					"content": "Oke, sudah. Hati-hati ya, tempat itu penuh dengan monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300120,
					"content": "#Tolong bantuannya ya, kak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300117,
					"content": "Co-Coba kuusahakan dulu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
