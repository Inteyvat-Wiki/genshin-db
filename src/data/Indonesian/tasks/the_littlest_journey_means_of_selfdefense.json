			"dialogs": [
				{
					"id": 210300201,
					"content": "Bagaimana situasi di sana, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300202,
					"content": "Harusnya sudah cukup aman sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#Wow, kak {NICKNAME} memang paling hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300204,
					"content": "Papa bilang dia akan mencari beberapa orang untuk menjaga kami selama perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300205,
					"content": "#Kuharap orang-orang itu sama hebatnya denganmu, kak {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300206,
					"content": "Paman Pandai Besi, berarti sekarang Paman sudah bisa lanjut menambang dan membuat alat-alat besinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, tentu saja! Berikan aku waktu untuk siap-siap. Aku akan pergi mencari bijihnya dan langsung kembali untuk lanjut menempa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300208,
					"content": "Tapi meskipun begitu, aku tidak bisa membawa banyak bijih kalau sendirian. Semoga aja di sana sudah tidak ada monster sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Zhang"
				}
			]
		},
