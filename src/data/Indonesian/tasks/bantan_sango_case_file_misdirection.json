				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "Pengembara, kita bertemu lagi. Terima kasih bantuanmu waktu itu, Sango sudah mengetahui identitas pencurinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Tapi untuk menangkapnya, butuh melakukan beberapa persiapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "Sango akan mengurus hal lain, ayo kita lanjutkan tugas kita yang sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Masih mau cari ribut dengan Treasure Hoarder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Betul. Meskipun pencuri itu tidak ada hubungannya dengan Treasure Hoarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Tapi Treasure Hoarder juga tidak melakukan hal baik. Jadi kali ini kita buat saja mereka \"membantu\" kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Sango sudah menandai di petaku, lokasinya tidak jauh dari kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "Dari dalam kota... Sango sudah memberikan instruksi ke Amano dan Andou. Mereka juga akan bekerja sama dengan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Dan lagi... Sango sudah berjanji ke mereka kalau semua kredit akan diberikan ke mereka saat kasus ini selesai. Mereka pasti senang bekerja sama dengan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Kita biarkan Sango yang berpikir dan merencanakan, kita lanjut \"berbicara\" dengan Treasure Hoarder itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Aku akan menandai lokasinya di petamu. Ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Menipu pelakunya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Betul. Kita harus terus membuatnya berpikir kalau tujuan kita adalah Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "Dengan begini, Sango punya lebih banyak waktu menyempurnakan rencananya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "Hehe... Lagi pula para Treasure Hoarder juga tidak melakukan hal baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "Jadi kali ini kita lanjut buat mereka \"membantu\" kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
