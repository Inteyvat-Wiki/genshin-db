			"dialogs": [
				{
					"id": 220350204,
					"content": "Hmm, pergerakan kali ini cukup besar. Amano dan Andou akan bekerja sama dengan kita agar pencuri tahu berita tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Masih berapa lama lagi kita harus melakukan hal ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Tidak lama lagi, cuma sampai persiapan Sango selesai, lalu kita bisa menutup kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "Hadiah ini untukmu, Pengembara. Terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "Sango yang memutuskan jumlahnya, seharusnya sangat sesuai. Silakan diterima, siapa tahu akan merepotkanmu lagi di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
