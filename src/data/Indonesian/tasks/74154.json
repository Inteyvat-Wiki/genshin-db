						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Kalau berdasarkan dari kegigihan kalian, sudah kusangka kalian harusnya tidak akan pergi begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "Aku malah mengira kalian akan langsung lapor ke Maison Gardiennage, ternyata tidak. Sepertinya kalian punya pemikiran sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Kenapa kalian mengurung Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Jujur, aku mulai kagum sama kalian. Kalau semangat kalian digunakan di tempat yang tepat, mungkin bisa jadi orang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "Cuma sayangnya, bukan dalam hal ini. Duh, kalian benar-benar enggak takut mati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "Kamu mengintimidasi orang yang salah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Eh? Apa karena kalian sama sekali tidak paham situasi ini, atau mengira sedang menegakkan keadilan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "Ngomong-ngomong tentang pedagang yang mati tenggelam di berita barusan, namanya Brandt. Hmm, dia orang yang pandai bersilat lidah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Apa kamu tahu? Berita bilang kalau dia sebenarnya bukan mati tenggelam, tapi dibunuh lalu ditenggelamkan ke danau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "Setelah petugas Marechaussee Phantom menjalani penyelidikan yang panjang, hasilnya cuma menyimpulkan kalau dia dibunuh, dan orang yang membunuhnya layak dihukum mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Lalu di berita juga ditulis seperti ini. Bagaimana situasi sebenarnya? Apa pembunuhnya yang lebih pantas mati, atau justru korban sendiri yang lebih pantas mati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hmm ... Ini pertanyaan susah. Untuk sekarang aku belum ketemu jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Eh, malah melenceng dari topik! Ini tidak ada hubungannya dengan apa yang mau kita bicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Kamu sebenarnya mau ngomong apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Aku mau bilang, langsung bertindak gegabah sebelum benar-benar paham adalah hal yang konyol dan bisa berakibat buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Diam saja melihat ketidakadilan, itu baru hal konyol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha, kalau bertemu di situasi berbeda, mungkin saja kita bisa jadi teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Meski aku suka dengan cara berpikirmu, ada hal yang harus kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "Ini terakhir kalinya aku bersabar. Kalau aku lihat kalian berkeliaran di sekitar rumahku lagi, aku pasti akan bertindak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Setelah Athos mengoceh tidak jelas, dia pun pergi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Sikapnya yang aneh membuatmu terkejut. Kamu sedang memikirkan sikap apa yang harus diambil dalam hal ini ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Ketukan pelan terdengar dari kaca jendela belakang, diikuti dengan suara *kraaak* yang sangat pelan, ada selembar kertas yang jatuh dari jendela ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Di kertas ada tulisan tangan berwarna cokelat, sepertinya ditulis menggunakan kopi dan dalam kondisi terburu-buru ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Cepat lihat, apa tulisannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "Ini Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Ssssst ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "Maaf, kita harus lebih hati-hati sama mangkuk makanan kucingnya. Ayo kita tunggu sinyal darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Aku akan langsung bertindak saat melihat ketidakadilan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Sebenarnya kalian dengan Benoit ada hubungan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
