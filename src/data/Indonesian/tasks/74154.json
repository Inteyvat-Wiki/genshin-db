					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, lihat! Daging ikannya masih segar, terus lantainya juga bersih. Pasti barusan ada orang yang bersihin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Pasti ada orang di rumah Benoit, ayo kita periksa ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "... Yang dia bilang masuk akal juga. Dia tidak bisa menghilang terus-terusan, paling tidak dia harus muncul sesekali, jalan-jalan misalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Paling tidak, bisa mencegah tetangga melapor ke Maison Gardiennage. Aku tidak mau menarik perhatian Pasukan Penembak Patroli Khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Ayah ingin sekali jalan-jalan keluar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "Bo-Bolehkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "Tentu saja boleh. Bukan cuma boleh, kami malah dengan senang hati menemanimu jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "Hati-hati ya, jangan sampai ini jadi kesempatan dia buat minta tolong. Dua orang aneh itu terus memperhatikan kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Ayah tidak akan begitu, aku yakin kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Ayah, apa ayah mau membiarkan Maison Gardiennage tahu soal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "Tahu apa? Kok ngomongnya pelan banget sih, enggak kedengaran jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Mereka mau keluar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Hmm, kita agak jauhan saja. Kali ini harus cari akal buat bicara sama Benoit, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Oke, ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Bagaimana? Perasaan Ayah sudah baikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "Kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "... Tolong aku! Eh, jangan deh, jangan tolong aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "Ayah bilang apa sih, sebentar minta tolong sebentar menolak ditolong? Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Eh, ternyata kalian. Pantas saja ayah mau nyapa kalian, ternyata kenalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "... Tidak, bukan! Kami tidak kenal, tidak kenal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "Tidak kenal? Kok bisa, aku lihat mereka sengaja menunggu ayah di sini loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "Bahkan baik banget membantu kami membawa koran, lalu pergi ke Fleuve Cendre mencari Snodgrass buat ngobrol, tetangga kita yang dulu itu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "Aku rasa kalian pasti dekat. Pantas, Ayah selama ini sangat suka anak-anak, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Aku juga suka banget anak-anak, tapi tidak setulus ayah. Aku paling suka anakku sendiri, sayangnya dia sudah tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Apa yang sebenarnya kalian lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Aku dan Athos itu anaknya ayah. Ayah sayang kami, kami juga sayang ayah, bukannya sudah jelas ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, hari ini cuacanya bagus banget, cocok buat jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Ya, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Kamu sudah baca The Steambird hari ini? Ada banyak berita menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Belum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "Ada berita tentang lansia yang meninggal. Kabarnya dia bertemu dengan perampok, dan karena tidak ada yang menemaninya, dia tidak sengaja terjatuh dari tebing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Oh ya? Tragis sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Ada lagi berita tentang pedagang yang mati tenggelam. Dia sepertinya minum terlalu banyak, mabuk terhuyung-huyung berjalan ke tengah danau, dan akhirnya mati tenggelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Astaga, dia sial banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "#Berita terakhir yang paling menarik. Ada orang yang suka ikut campur urusan orang lain, duh, {M#dia}{F#dia} tidak sengaja salah minum obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "Dia mengira racun itu obat, langsung dia minum begitu saja. Akhirnya dia mati kesakitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Astaga, ada banyak cara orang meninggal. Ayo ceritakan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "... Maaf, maaf, tidak akan kuulangi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "Ayah bicara apa sih? Kami tidak bermaksud menyalahkan ayah. Tapi ayah berlarian begini, pasti capek banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, ayo kita pulang dan bacakan koran untuk ayah. Ayah sudah berlangganan banyak koran, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Ya, ngobrolnya sudah terlalu lama, saatnya kita pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Ayahku sayang, ayo kita pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Kenapa kalian melakukan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Maksudmu menemani ayah keluar jalan-jalan? Ini kewajiban yang harus dilakukan sebagai anak. Kalau tidak, gimana aku bisa membalas kasih sayang ayah padaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}