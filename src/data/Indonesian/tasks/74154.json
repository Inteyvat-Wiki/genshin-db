			"dialogs": [
				{
					"id": 741540201,
					"content": "Wah, pasti enggak beres nih, Paimon saja tahu ada yang enggak beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, kamu kan pintar, sekarang kita harus gimana, nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit mau minta tolong, tapi bersikukuh supaya kita jangan tolong dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Kalau begitu kita periksa lagi di sekitar rumah Benoit? Di jendela belakang rumahnya ada kotak yang aneh, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Pasti dalamnya ada sesuatu, mungkin itu bisa buktiin spekulasimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Pasangan suami istri ini mungkin dari Fleuve Cendre ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Dari reaksi mereka, sepertinya ada yang disembunyikan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Aku punya beberapa spekulasi, meski masih kurang bukti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
