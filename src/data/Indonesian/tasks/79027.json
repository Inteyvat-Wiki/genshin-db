			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "Halo halo, datang juga kalian. Kukira kalian sibuk terbang ke sana kemari karena punya sayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270102,
					"content": "Sudah lupa ya sama kawan lamamu Miitoboru, yang diam saja di sini berendam di air asin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270103,
					"content": "Kami kan sudah di sini, jangan lebay ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "Terus kali ini mau dibantuin apa sama kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "Tidak penting-penting amat sih ... ingat waktu dulu kalian bantu cari bagian badanku yang hilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270106,
					"content": "Bagaimana ngomongnya ya ... Mungkin keinginanku yang sudah tercapai, atau karena perairan di sini semakin mengurangi kemampuan bicaraku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270107,
					"content": "Belakangan ini aku lebih sering tidak sadarkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270108,
					"content": "Karena mesin itu sudah mati ... mungkin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "Oh ... Aku menjelma jadi Waverider milikmu, dan bisa berkomunikasi denganmu, semuanya gara-gara ulah mesin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270111,
					"content": "Berarti begitu efek mesin itu habis, Miitoboru ... jadi enggak bisa bawel lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, pikirin jalan keluar, cepat ... kalau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Paimon jangan cemas, aku sudah sangat sangat senang bisa dapat kesempatan untuk ngobrol begini sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270114,
					"content": "Aih, kalau dipikir lagi ... Aku yang cuma sebuah kapal, bisa berkesempatan bicara dengan kalian selama beberapa hari ini ... Ajaib, seperti mimpi yang liar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270115,
					"content": "Tapi aku ... masih punya satu permintaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270116,
					"content": "Silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "Ingat dulu aku pernah bilang kalau badanku sudah ketemu, aku mau bawa kalian berlayar? Yah, berhubung badanku sudah jadi bangkai amburadul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270125,
					"content": "Hampir semua harta sudah dibawa pergi, sisanya juga tidak ada yang bagus gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270118,
					"content": "Kali ini aku bersumpah, harga diri sebagai kapal bajak laut yang jadi taruhannya. Ada harta karun! Dan tolong percaya padaku, kalau tidak aku rela jadi makanan ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, Miitoboru mungkin bentar lagi sudah enggak bisa ngomong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#Terus , kayaknya kali ini betulan ada harta. Pergi yuk, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Gimana Paimon saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Ayo! Kembangkan layarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Siap kapten! Silakan naik, kita berlayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270122,
					"content": "Dasar, ya sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Miitoboru juga korban mesin ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
