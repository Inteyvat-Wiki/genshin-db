			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "Kosekimaru! Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "Ada harta loh bener. Ini, miniatur kapal bajak laut! Intuisimu kali ini enggak error lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "Oke, jadi mau ngomong apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790271005,
					"content": "Kosekimaru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(Kosekimaru sama sekali tidak menjawab ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790271007,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "Kamu ... dia ... tadi katanya mau ngomong begitu kita balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "Kosekimaru ... dasar tukang tipu! Jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "Kosekimaru sudah tidak bisa bicara lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
			]
		}
	]
}