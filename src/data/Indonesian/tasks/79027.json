			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "Bahaya banget! Paimon kira kita bakal kelelep tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "Wah, Kosekimaru keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Kapal ya kapal, biarpun bisa ngomong, tetap saja cuma kapal. {NICKNAME} yang bakat jadi nakhoda, bawa kita selamat dari badai tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270604,
					"content": "Mau sekali lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Haha, jangan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270607,
					"content": "Aku rasa badai tadi itu aku pemicunya. Perairan di sini jadi tidak stabil, beda dengan dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270608,
					"content": "#Tapi ... {NICKNAME}, Paimon, kita sudah sampai! Hartanya ada di atas sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270609,
					"content": "Lah, ini kan tempat yang pertama kita kunjungin waktu cari harta? Di atas sana cuma ada lambung kapal Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Aku yakin ada harta di sana. Radar harta, intuisi bajak laut! Yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270611,
					"content": "Eh, tadi kamu bilang ada dua hal yang mau diomongin sama kami kan? Satu kamu sudah ingat nama kamu, yang keduanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Kirain sudah lupa, hahaha. Nanti ya, aku kasih tahu kalau kamu sudah balik dari sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270605,
					"content": "Makasih, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
