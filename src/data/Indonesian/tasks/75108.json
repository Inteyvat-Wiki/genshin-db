			"dialogs": [
				{
					"id": 751080101,
					"content": "Masak sih mau, tapi ... Paimon masak apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Paimon ingat, dulu kita pernah berikan makan ikan ke Blubberbeast Berrypuff. Makanan ikan harusnya oke deh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Kalau mau Blubberbeast dan {REALNAME[ID(2)|SHOWHOST(true)]} makan dengan senang, kayaknya menu khusus Natlan deh, Grilled Fish in Mint Sauce kayaknya boleh juga tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Nah itu menu andalanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Oke, kita mulai ya! Paimon bakal ngasih masukan juga dari samping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Potong lebih dalam lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Oke, makin dalam, rasanya makin sedap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Rasanya lebih asin deh, pasti lebih enak deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Mmm ... Benar sih, pasti rasanya makin mantap. Blubberbeast dan {REALNAME[ID(2)|SHOWHOST(true)]} pasti suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Saus mint, makin rame makin asyik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Nanti pasti rasanya segar, enak banget pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Cabe, produk wajib sih itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "Pedas dikit oke lah ya, cukup buat mancing selera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Dipanggang pakai api gede, wuh, garing di luar lembut di dalam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Hehe, kayaknya sih wangi yah, Paimon mulai ngiler deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Setelah proses memasak yang luar biasa. Ikan khusus yang kamu panggang untuk Blubberbeast dan {REALNAME[ID(2)|SHOWHOST(true)]} sudah selesai ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Dipanggang pelan-pelan, biar empuk dan juicy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Wah, luar biasa, ikan panggang rahasia turun temurun khas {NICKNAME}. Mungkin Paimon bisa buat resep khusus sendiri juga ya, buat teman-teman yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Kayaknya makhluk di Fontaine lumayan takut sama rasa pedas sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Tapi kalau sama sekali enggak ada cabe, kayaknya pas makan rasanya kurang setengah deh. Kita taruh dikit, boleh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Eh, makhluk laut kayak Blubberbeast bukannya takut sama mint ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Kayaknya enggak gitu deh logikanya. Blubberbeast kan di dalam air, jadi begitu naik ke daratan pasti panas dan kering, kalau tambah sedikit mint, bukannya bisa bantu redain suhunya dikit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Rasanya sudah oke, tidak perlu garam lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Iya sih, nanti kan masih banyak bumbu yang lain, jadi enggak usah kasih terlalu banyak garam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Potongnya jangan terlalu dalam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "Ya boleh juga, bisa lebih pertahanin rasa ikan aslinya dengan begini, jadi Blubberbeast pasti bakal suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Lupa-lupa ingat sih resepnya, tapi enggak apa-apa deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
