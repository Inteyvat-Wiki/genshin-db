				"points": []
			},
			"dialogs": [
				{
					"id": 706570101,
					"content": "Halo, aku Lizz dari Knights of Favonius. Aku yakin kamu sudah pernah mendengar tentang ini sebelumnya, tapi Mondstadt menyelenggarakan segala macam aktivitas yang seru selama Festival Windblume berlangsung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570102,
					"content": "Ya, aku pernah mendengarnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Aku bertanggung jawab menyambut semua tamu yang datang ke Mondstadt, untuk memastikan semua orang bisa menikmati festival ini semaksimal mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570105,
					"content": "Karena sebagian acara festival diadakan di luar tembok kota, jadi harus ada yang memperkenalkan semua acara ke para pengunjung. Sayang sekali kalau mereka melewatkan acara-acara seru yang sudah kami siapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570106,
					"content": "Hari ini, izinkan aku memperkenalkan \"Sang Penembak Jitu\" dengan sepenuh hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570107,
					"content": "Dari namanya saja sudah cukup jelas kan? Tembak target secepat dan seakurat mungkin untuk mencapai skor tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570108,
					"content": "Kedengarannya menarik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "Jangan khawatir, sini aku tandai lokasi target untukmu. Kamu tidak akan tahu kecuali kamu mencobanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570111,
					"content": "Nanti kamu akan mendapatkan hadiah berharga berdasarkan skormu! Tidak peduli kamu pemain biasa atau perfeksionis, yang pasti menyenangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570112,
					"content": "Aku tidak mungkin menolak kesempatan itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Iya, kamu harus mencobanya! Jangan lupa datang lagi kalau kamu ingin mengetahui kegiatan yang akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570115,
					"content": "Selamat bersenang-senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570113,
					"content": "Terima kasih atas penjelasanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Kedengarannya cukup menantang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "Aku baru pertama kali mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
