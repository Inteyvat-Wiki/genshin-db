			"dialogs": [
				{
					"id": 722120601,
					"content": "Tapi, diriku sedikit penasaran. Bagaimana caranya membuat batu yang begitu keras menjadi mirip sepertiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Apa manusia batu itu sangat kuat? Atau dia punya kekuatan magis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
