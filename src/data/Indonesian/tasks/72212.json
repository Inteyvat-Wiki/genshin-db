			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Waktu kalian datang sungguh tepat. Diriku butuh bantuan kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "Apa yang kamu perlukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "Diriku ingin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "Kamu meletakkan batu yang sangat besar dan sangat tinggi dan mirip dengan diriku di sebelah kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "Ba-Bagaimana cara kita cari benda seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Maksud dia itu patung, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Apa pun namanya, diriku ingin sesuatu yang mirip dengan batu rubah di pulau yang nan jauh di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Dulu Hibiki sering bilang kalau ada banyak sekali batu di pulau itu, dan bahkan bertanya apa diriku ingin dibuatkan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "Diriku merasakan kalau Hibiki menginginkannya, pasti itu hal bagus. Maka itu, diriku memintamu untuk membuatkan batu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "Tapi aku tidak bisa memahat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Hmm, bagaimana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Oh ya, bagaimana kalau kita tanya Taisuke? Dia kan sangat suka kucing. Mungkin dia mau belajar memahat demi Neko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Yah, tidak ada salahnya kita coba cari Taisuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "Benar juga! Dia kan sangat suka kucing, mungkin dia bisa bantu kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
