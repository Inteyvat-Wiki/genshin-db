				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Ah, halo. Kalian sedang sibuk apa hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Membantu Neko membuat patung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Eh... Apa? Patung, di sini? Sungguh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "A-Aku akan belajar memahat sekarang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Se-Sepertinya tidak sempat deh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Hmm, ini permintaan dari Neko lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Begini saja, kurasa tidak sulit mencari pengrajin yang butuh pekerjaan... karena masalah di Tatarasuna saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "Adventurers' Guild mendapatkan banyak permintaan tentang ini, dan kudengar juga masih banyak orang yang mencari pekerjaan di Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Aku juga sempat melihat kemah sejenis saat sedang menjalankan misi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Mungkin kamu bisa coba peruntunganmu di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Terima kasih ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Heh, jangan dipikirkan. Tidak seberapa kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "Kalian tahu? Sekarang aku jadi penasaran apa yang akan terjadi kalau kuil itu ramai lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Terutama \"Hibiki\" yang sering disebut Neko itu. Kira-kira orang seperti apa dia, sampai sangat dicintai oleh kucing itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Sudah, jangan hiraukan aku, aku hanya berbicara pada diri sendiri. Kalian pergi cari pengrajinnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Entah mereka bisa memahat batu atau tidak... Yah, serahkan saja pada keberuntunganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Mengakulah, Nona Etsuko, kamu juga mau membantu Nona Neko, kan? Haha, kamu ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, apa rencana survei kita sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Eh, ha-hampir selesai. Maaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Kamu tidak seperti dirimu biasanya, Etsuko ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "Kenapa? Tidak biasa melihatku memberimu informasi duluan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
