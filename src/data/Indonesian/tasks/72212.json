				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "Ah, kalian sudah kembali. Manusia ini pasti si manusia batu itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120402,
					"content": "Ini pengrajin yang kita cari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "...Apa?! Kucingnya... benar-benar bisa bicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Miaw, miaw, miaw... Kenapa kamu terkejut begitu... Memangnya aneh diriku bisa bicara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120406,
					"content": "Jangan heboh begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Tunggu, jadi maksudmu ini hal biasa saja untukmu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "Lumayan biasa saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "Apa saja yang sudah pernah kamu alami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Baiklah, cukup... Kita tidak berkumpul untuk berbincang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120412,
					"content": "Kembali ke topik utama. Manusia batu, bisakah kamu mengubah batu menjadi seperti bentuk diriku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120413,
					"content": "Eh? Manusia batu? Maksudnya aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "\"Mengubah batu\" katamu... Yah, aku bisa mencobanya sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Benarkah? Bagus sekali, miaw miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120416,
					"content": "Ja-Jadi begini... Hmm, punya pekerjaan lebih baik daripada menganggur. Maksudku, aku belum pernah bekerja untuk seekor kucing... Jadi nanti kita akan diskusikan bayaranku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Hmm. Aku tetap harus mempersiapkan beberapa hal. Ada lumayan banyak batu di pulau ini, aku harus mencari yang bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "Oh, ya. Bagaimana aku harus memanggilmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "Diriku adalah Neko, pengganti kepala pendeta di Kuil Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120420,
					"content": "Kalau panggilanku, kamu bisa memanggil diriku sesukamu, wahai manusia tinggi pengetuk batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120421,
					"content": "Begitukah? Baik, kalau begitu aku akan memanggilmu Nona Pendeta. Kamu ini kan bosku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "Bos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "Ka-kalau begitu aku akan lihat-lihat dulu di sekitar untuk mengambil batunya, kalian tunggu saja di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Bekerja untuk seekor kucing, benar-benar aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "Tuan Ooshima sepertinya sudah tidak memikirkan soal bayarannya lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "Hanya kucing bicara saja kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Ya, si manusia batu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
