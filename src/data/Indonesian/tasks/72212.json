			"dialogs": [
				{
					"id": 722120301,
					"content": "*huff* Kira-kira kapan aku bisa dapat kerja lagi ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Kalian mencariku? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Apa kamu tahu cara memahat batu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Eh? Bagus... bagus sekali kalau begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Tunggu, maaf aku belum memperkenalkan diri. Namaku Ooshima Junpei dan dulu aku bekerja di Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Setelah kecelakaan itu, kami semua dievakuasi pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "Tapi sampai sekarang masih belum ada pemberitahuan kapan kita bisa kerja lagi, jadi aku hanya menganggur saja terus di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Jadi kamu mencari seseorang yang bisa memahat batu, kan? Yah, memang bukan keahlian khususku sih, tapi aku lumayan pandai kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "Kalian mau memahat bentuk seperti apa? Mungkin bisa beri tahu aku dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Sebenarnya inilah yang terjadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Eh... Biar kuulang, jadi ada seekor kucing berbicara yang memintamu mencari pengrajin untuk membuat patung seperti bentuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Bukannya aku tidak percaya sih. Tapi kedengarannya... sulit dipercaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "Dan kalaupun aku setuju, bagaimana cara... pengganti kepala pendeta itu membayarku? Bagaimanapun juga aku tidak akan kerja cuma-cuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Tenang saja, pasti aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Memangnya benar-benar aman...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Aman? Aku... Hmm, aku jadi merasa kalian mau menipuku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Tapi... Ya sudahlah. Tak apa, aku sedang menganggur juga. Tidak ada salahnya aku ikut dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "Tapi aku tetap berharap akan dibayar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Kami sedang cari pengrajin yang bisa memahat batu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
