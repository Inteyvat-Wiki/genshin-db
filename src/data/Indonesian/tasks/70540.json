			"dialogs": [
				{
					"id": 705400101,
					"content": "MENG!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Datuk Meong"
				},
				{
					"id": 705400102,
					"content": "Ih, kucingnya galak banget! Nona Rosaria, tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Kasih sedikit ruang gerak lah. Kalau terlalu dekat, nanti mukamu kena cakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Waduh, si Valerina kayaknya ribut sama kucing lain lagi tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Penampungan kita kedatangan kucing baru ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Honorary Knight! Pawang Kucing Sejati! Kucing besar ini menerobos masuk mengejar si Bola Salju! Kayaknya mereka ketemu waktu dia jalan-jalan, dan akhirnya dibuntuti sampai ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Tenang, tenang, di sini tidak ada yang mau jahat sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Semua yang jahat, yang memaksa kamu bertahan hidup dengan menghalalkan segala cara ... tidak ada di sini. Kamu aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Kamu dikelilingi orang baik sekarang. Mungkin kadang menyebalkan dan suka ikut campur, tapi semua demi kebaikan. Santailah. Hidup santai bukan hal buruk, kamu tinggal membiasakan diri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*grrr* *nguuung*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Datuk Meong"
				},
				{
					"id": 705400112,
					"content": "Dia ... NGERTI YANG BARUSAN?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Berhasil juga. Ha, kucing pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Wah, ini kucing jauh lebih gede daripada yang lainnya! Warnanya kayak jus Bulle Fruit ya. Pakai syal segala lagi ... dan ada semacam desain apa gitu di syalnya? Oh! Lambang Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Oke, harus dikasih nama yang bau-bau kesatria! Galak sih ini kucing. Gimana kalau ... \"Datuk Meong\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Datuk Meong"
				},
				{
					"id": 705400117,
					"content": "Kamu memang pintar sekali mengambil hati kucing. Lihat, dia sudah jauh lebih santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Kata Paimon sih kali ini Rosaria sih yang andilnya lebih gede. Datuk Meong langsung jadi kalem setelah ngedengerin kamu tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Rosaria makin lama makin jago nih ngurus kucing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Buat aku sama saja sih. Tapi ... untungnya mereka lucu-lucu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "#Sini {NICKNAME}, Paimon ajarin caranya bikin si Datuk Meong tenang! Paimon siapin dulu jurusnya ya, dijamin sukses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Rosaria makin senang deh ngurusin ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Tapi dia kok kayak yang ... gagah banget gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}