			"dialogs": [
				{
					"id": 730410101,
					"content": "Ah, Nara Emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "Teman Nara-ku, ayo bermain bersama Aralila! Aranishat sangat lemah, jangan main sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Pfft ... kemarin Aralila kalah dari Aranishat. Aralila lebih lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "Ok, jangan pedulikan apa itu matahari dan bulan, kebetulan sekali teman Nara-ku di sini, ayo kita bermain bersama teman Nara-ku, ayo tanding siapa yang lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Oke, Aranishat tidak takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "Aralila sembunyi dulu, teman Nara-ku cari ya. Habis itu giliran Aranishat yang sembunyi, teman Nara juga harus mencarinya. Yang pertama ditemukan kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "Teman Nara-ku yang baik, mau main? Kita bisa mulai kalau kamu sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
