			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah ... aku dulunya adalah bahasa itu sendiri, tapi sekarang aku sudah menjadi subjek ilusi yang hancur, kembali ke \"simbol\" yang tidak sempurna ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Iiih! Orang aneh yang ngomongin hal-hal aneh dan muncul dari buku aneh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Aneh\" adalah subjek unik yang tidak bisa dijelaskan, ditulis, dan diidentifikasi. Diriku sendiri tidak sesuai dengan definisi tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Aku hanya mencoba mencari jalan menuju \"kenyataan\" di antara halaman buku, tapi tidak sengaja terjebak dalam metafora yang tidak berujung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Aku sudah menjadi sisa yang tak dapat disimbolkan. Berkat campur tanganmu, tirani bahasa telah terlepas dariku. Akhirnya, sekarang aku bisa mulai mengenali lagi diriku sendiri secara keliru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Tolong jangan pakai bahasa alien ngomongnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "Aku tidak sengaja jatuh ke dalam halaman buku dan tidak bisa keluar, terima kasih sudah menarikku keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
