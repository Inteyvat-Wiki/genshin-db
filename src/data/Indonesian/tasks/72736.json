			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grandmaster Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Luar biasa, luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360102,
					"content": "Tidak kusangka Geng Arataki punya banyak anggota yang jago adu kumbang. Sepertinya kalian sudah sangat paham sampai ke seluk-beluknya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360103,
					"content": "Aku tarik kata-kataku dulu. Kalian lawan yang layak dan patut diperhitungkan. Izinkan aku maju ... dengan kekuatan penuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360104,
					"content": "Oke! Bapak Gembala, silakan! Kamu bosnya kan, ini saatnya kamu pamer kebolehan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "Tapi omongan barusan jangan dimasukin hati juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Maju, Raja Oni Pendekar Kumbang Sejati!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "HAHAHAHAHAHAHAHA! Sudah sampai ke pertarungan akhir ya? Siap-siap, saksikan kemenangan Tuan Besar ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Aku tidak tahu bagaimana caramu memimpin anak buah, tapi hasil tidak pernah bohong: Geng Arataki mendominasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Grandmaster Hanakado! Bersiaplah!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Sang Raja vs Sang Grandmaster! Pertandingan bersejarah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grandmaster Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Aku paham. Jadi begitu ya ... Ayo kita bertarung sekali lagi. Kali ini, aku akan baca semua taktik dan mekanikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360202,
					"content": "Kalah menang tidak penting. Pertandingan dan kesenangan, itu saja. Setuju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360203,
					"content": "Jarang sekali dapat lawan yang kuat seperti ini. Rasanya rugi kalau pertarungan di antara kita selesai cuma sampai sini, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360204,
					"content": "Oh JELAS! SINI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Tapi apa tadi, mau baca semua taktik dan mekanik punya Tuan Besar ini? Ngimpi kau, bocah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Akui saja kalau Tuan Besar ini yang lebih hebat. Aku ladeni kamu adu kumbang, berapa ronde juga tidak takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Bapak Gembala dan Grandmaster Hanakado kayaknya belum capek tuh. Sudahlah, biarin saja mereka! Terus saja adu kumbang sampai kumbangnya sudah enggak bisa diadu-adu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}