			"dialogs": [
				{
					"id": 100090801,
					"content": "Bagus sekali ... Eksekusimu sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Asli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Ya, aku tidak melihat ada kecacatan sama sekali dalam proses peracikannya ... Biar kuambil sedikit untuk menguji komposisi produknya. Sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose mengambil sedikit ramuan dan menggunakan alat uji untuk memeriksa komposisinya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Ya, eksekusinya sempurna, dan begitu juga dengan ramuan yang dihasilkan. Persis seperti yang kuharapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "Jadi, apa percobaan ketujuh ini berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Setelah diperiksa, sepertinya sama persis dengan enam percobaan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Oh ... Bukannya itu bakal ngehasilin hasil yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Tidak selalu. Hasil eksperimen bisa berbeda meskipun variabelnya mirip. Kita tidak akan tahu hasilnya seperti apa — itulah yang membuat eksperimen menjadi berharga sejak awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Ayo, mari kita uji coba yang ini. Aku sudah menanam sebelumnya beberapa Sweet Flower yang bisa kita gunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Kita hanya perlu nyiramin ramuan ini dan lihat apa yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
