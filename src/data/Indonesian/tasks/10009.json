			"dialogs": [
				{
					"id": 100090601,
					"content": "Baiklah, bahannya udah siap, kualinya ada di sana, kita bisa mulai. Tapi, hm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Masih ada yang kurang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Tidak, tidak. Hanya saja ... Apa kamu keberatan kalau aku mengamati dari samping? Maksudku, ini hanya untuk keperluan akurasi pencatatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "Aku tahu banyak orang tidak suka diamati saat melakukan eksperimen, jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Oh silakan saja, aku sih tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Terima kasih. Kalau begitu, aku siap kapan pun kamu siap. Aku juga akan mencatat semuanya dengan detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "Jadi, kamu sudah siap memulai eksperimennya?",
