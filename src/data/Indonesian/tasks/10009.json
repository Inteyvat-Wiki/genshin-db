			"dialogs": [
				{
					"id": 100091101,
					"content": "*fiuh* Berhasil juga. Ukurannya memang besar, tapi Whopperflower ya tetap aja Whopperflower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
