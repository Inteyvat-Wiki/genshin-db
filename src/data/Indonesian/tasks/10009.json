				},
				{
					"id": 100091102,
					"content": "... Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091103,
					"content": "Tapi, uh ... memangnya bisa sampai sebesar itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Aku hanya bisa membuat perkiraan kasar selama pertarungan, tapi ukurannya setidaknya ... 16 kali lipat dari ukuran aslinya, mungkin bahkan lebih besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091105,
					"content": "Ini berarti eksperimennya ... berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "Tunggu, bukannya itu bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Aku masih belum yakin apa dampaknya ... Tapi kalau percobaan selanjutnya berhasil mendapatkan hasil yang sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Itu berarti ada sesuatu yang berbeda ... Mungkin batasan dan hukum di dunia ini sedang berubah karena suatu faktor yang tidak diketahui ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Aku tidak bisa bilang ini baik atau buruk, tapi minimal dari sudut pandang alkimia, batas yang meluas berarti membuka lebih banyak kemungkinan untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "Bagaimanapun juga, ini menandakan berakhirnya tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091111,
					"content": "Kayaknya sih begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hmm. Meski begitu, bisa jadi ini adalah efek dari orang yang membuat ramuannya. Mungkin juga ada sesuatu yang spesial dari Whopperflower ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "Masih banyak yang perlu dikonfirmasi, jadi kurasa tugas ini membuka jalan untuk pertanyaan-pertanyaan lebih lanjut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "Ya, kami bersedia bantu kapan saja kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Kita bisa coba serum pertumbuhan itu ke Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Hehe, coba bayangin ... Paimon pasti bisa ngegebuk segerombolan Treasure Hoarder sampai babak belur kalau ukuran badan Paimon jadi 16 kali lipat lebih besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Aku tidak yakin sih soal itu. Serum itu hanya bekerja pada Whopperflower karena struktur internalnya cukup mirip dengan Sweet Flower ... Tapi Kalau kamu yang meminumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "Kamu mungkin bisa jadi 16 kali lebih besar, tapi kamu juga mungkin berubah jadi sejenis sayuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "Yah, enggak. Enggak jadi deh kalau gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Oh, ngomong-ngomong, Paimon mau tanya ... Kenapa semua penelitianmu fokus sama hal-hal seputar Sweet Flower dan Sunsettia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Oh, jawabannya sederhana. Baik Sunsettia maupun nektar Sweet Flower rasanya manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Jadi, dalam hal ini, tidak sengaja membuat Whopperflower 16 kali lebih besar memiliki manfaat tersembunyi, karena sari Whopperflower ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "... Rasanya persis kayak Sweet Flower?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Benar sekali! Setelah aku mengekstrak gula dari nektarnya, aku akan memberikanmu sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091125,
					"content": "Hehe, oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
