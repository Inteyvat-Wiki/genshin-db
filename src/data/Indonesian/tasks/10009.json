			"dialogs": [
				{
					"id": 100090101,
					"content": "Hmm ... Melihat hasil sebelumnya, aku harus lakuin beberapa penyesuaian ke eksperimen ini, juga mastiin semua bahan dan peralatan sudah siap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#Lalu ramuan yang harus aku buat ... Oh, {NICKNAME}, Paimon! Ada apa ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "Hehe, kami mau bantuin \"tugas\" kamu. Kira-kira kamu lagi butuh bantuan enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "\"Tugas\"-ku ... Oh, maksudmu yang dibicarakan Master Albedo? Yang dari Hexenzirkel itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "Wah, kamu datang tepat waktu. Eksperimen masih berlangsung, dan aku baru saja mau mengerjakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "Masih berlangsung? Bukannya kamu sudah mengerjakannya selama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Ya. Ini sejalan dengan topik penelitian lain yang sedang kukerjakan, jadi tidak terlalu menambah beban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "Apa? Eksperimennya ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Sejauh ini aku belum \"berhasil\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "Oh, jadi gagal terus ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Ini bukan sekadar \"gagal\" saja. Kerangka teori di balik tugas ini ternyata lebih rumit dari yang kubayangkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "Jadi, sebenarnya tugas apa ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Oh, benar juga! Kamu belum ngasih tahu kami eksperimen apa yang kamu kerjain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Sebuah eksperimen untuk mengembangkan ramuan yang dapat mengubah Sweet Flower menjadi 16 kali lebih besar dari ukuran normalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "Dengan kata lain, formulasi \"Reagen Augmentasi Botani Tipe IV, Iterasi VII\" — seperti yang kamu juga pasti tahu, ini adalah percobaan ketujuh kalinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Wow! Jadi intinya, kita perlu membuat serum pertumbuhan! Atau, versi ketujuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "Y-Ya ... Kurang lebih begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "Ini adalah percobaan ketujuhku, tapi kali ini aku tidak banyak mengubah formulanya, karena baik prinsip teori di balik eksperimen ini maupun hasil prosesnya membuktikan bahwa tidak ada yang salah dengan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "Tapi kamu belum \"berhasil\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Ya. Menurutku, bukan rumusnya yang salah, tapi ... Ada elemen kunci lainnya yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Ohhh ... Hehe, kalau begitu Paimon tahu apa yang harus dilakukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Biar kami bantu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Ya! Kami datang ke sini memang untuk itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Um, kita bisa mencoba, tapi ... aku perlu mengubah perbandingan dalam formula aslinya, dan itu mungkin akan membuat ramuan jadi lebih tidak stabil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "Enggak, kita ENGGAK akan mencoba itu! Tunjukkan saja resep aslinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "Ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "Tapi, aku masih kekurangan dua jenis bahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "Hehe, kalau itu kami bisa bantu. Apa saja yang perlu kami cari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "Aku butuh air dari mata air Springvale sebagai bahan dasarnya, juga pecahan Eye of the Storm ... Tapi, yang terakhir itu mungkin agak sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "Kita pasti bisa! Ayo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Mungkin kita bisa coba menambahkan sedikit sari Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Hehe, karena itu kita membantu ka—... Tunggu bentar, Paimon BUKAN bahan loh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
