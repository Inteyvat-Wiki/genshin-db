					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Eh? Kok ada Kamera di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Di mana ada berita, di situ ada Kamera\". Belum pernah dengar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Kayaknya pernah dengar deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Tapi kalimat ini baru aku pikirkan saja loh. Memangnya kamu pernah dengar di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Eh. Rupanya benar ya kata mereka, tidak ada yang baru di dunia ini. Apa pun yang dikatakan, ditulis, semuanya itu cuma pasti tiruan dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "Kan sudah ada Kamera, beritanya mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Berita ... sama seperti memancing. Harus sabar menunggu. Mengambil keputusan yang tepat di saat yang tepat, baru bisa memancing ikan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Eh, tidak, maksudku ... baru bisa memancing berita heboh. Eh? Kayaknya kurang pas deh. Sudah, lupakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Kayaknya tidak profesional sekali. Kamu bukan wartawan ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Kamu sudah salah lihat. Heh! Aku itu wartawan amatiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Oh ya, jadi wartawan amatiran ngapain deh di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Mau selesaikan topik yang diberikan sama seniorku, untuk menangkap momen-momen hidup saat para penjaga Benteng Meropide sedang bekerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Tapi dulu sempat habiskan banyak sekali waktu untuk mengurus dokumen sesuai prosedurnya ... Kalian lihat saja deh nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly mengeluarkan setumpuk dokumen, di atasnya tertulis berbagai jenis persyaratan dengan berbagai tanda tangan. Begitu dilihat langsung bikin pusing ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Begitu semua prosedur ini sudah beres, aku jadi kelewatan waktu kerja para penjaga. Kalau diumpamakan di dunia memancing, sekarang sama sekali tidak ada ikan yang bisa dipancing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Eh? Tapi itu kan jelas-jelas ada penjaga yang lagi kerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Tapi yang mau aku pancing itu jenis Platinum Collection. Kalau yang Initial Configuration atau Water Body Cleaner sih, kayaknya kurang mantap ... Meski sudah selesaikan topiknya, senior pasti tidak akan puji aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Kalau tidak mau pulang dengan tangan kosong, ya tidak boleh pilih-pilih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Benar juga sih, aku harus andalkan kemampuanku sendiri, jangan sampai berangan-angan untuk pancing ikan di luar kemampuanku ... Duh, aku ini pemancing dan wartawan amatiran yang tidak berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Ya sudah, jangan yang sedih-sedih lagi bahasannya. Semangat! Kalian boleh bantu aku? Tolong! Aku akan kasih imbalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Cepat banget sih berubahnya ... Bantu juga harus lihat dong bantu apa. Kamu kasih tahu dulu mau ngapain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Penjaga di sana, Grainville. Berdasarkan pengamatanku, dia bisa dijadikan berita, dan nilainya sama dengan Maintenance Mek: Situation Controller ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Kalau bisa foto dia, harusnya bakal bisa tuliskan berita yang lumayan deh. Seniorku pasti diam seribu bahasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Tapi dia sama sekali tidak jalan ke sini! Kalian boleh bantu arahkan dia ke tempat yang cocok dengan sudut Kamera ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Kamu yang langsung jelasin dan suruh dia datang saja dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Kalau memang begitu, dia pasti akan jadi sadar kamera, terus gayanya jadi tidak alami. Jadi sia-sia dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Coba aku pikirin lagi ya ... Idealnya sih begini, matikan dulu pengeras suara, terus laporkan ke Grainville, bilang kalau pengeras suara di sini rusak, dan minta dia datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Kalau begitu, pasti bisa terfoto, momen-momen hidup saat para penjaga Benteng Meropide lagi bekerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Penyelesaian topiknya bergantung kepada hari ini! Tolonglah aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Kayaknya sih enggak susah, {NICKNAME}, mau coba bantu dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Bawa Kamera ke sana saja, beres kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Duh ... Tapi latar yang cocok itu di sini. Dan kalau dia sampai lihat Kamera-nya, pasti jadi kaku dan gerakannya jadi tidak alami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Kalau begitu, terus tunggu di sini saja. Dadah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Kalian sudah mau pergi? Serius? Tidak mau bantu aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Eh ... Kami kan tidak mungkin munculkan Platinum Collection kayak main sulap juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Jangan bahas soal berita lagi. Aku suka memancing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Oh ya? Baguslah. Sebenarnya aku juga pemula di dunia memancing. Aku sedang bingung mau berguru dari siapa. Misalnya, kalau kepancing Maintenance Mek, tapi dia gigit orang, bagaimana tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Ya dilepaskan saja lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Jadi begitu ya pilihanmu. Ya ... boleh dipertimbangkan. Akan aku ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "Eh? Kok jadi bahas memancing sih? Kalian pintar sekali ganti topik ya! Kayaknya aku masih harus belajar banyak sebagai seorang wartawan amatiran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Topik memancing itu kan kamu sendiri yang bahas duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Kasih makan bogem tuh biar dia tahu diri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Dibuatin jadi makanan saja untuk Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Wow! Meski Paimon percaya banget sama masakan {NICKNAME}, tapi kalau benda seperti itu sih, harusnya enggak bisa dimakan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Belum pernah dengar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Oh! Berarti sekarang sudah pernah dengar, kan? Ya sudah, tolong ingat ya kalau ingin mengutipnya di tempat lain, harus disertakan juga sumbernya. Sumbernya itu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
