		},
		{
			"id": 7406304,
			"completionStepIds": [
				7406304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406304",
							"2"
						],
						"stepId": 7406304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Halo. Di sana kayaknya ada pengeras suara yang bermasalah ... di sana tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "Bermasalah lagi? Aneh banget deh ... Jelas-jelas kemarin sudah minta Clynes untuk perbaiki. Kayaknya memang levelnya masih belum sebanding sama aku deh. Padahal kan tinggal diketok dua kali saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "Terima kasih. Aku akan cek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "Maaf ya merepotkan!",
