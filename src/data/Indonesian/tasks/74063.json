			"dialogs": [
				{
					"id": 740630501,
					"content": "Akhirnya, topik dari senior sudah beres juga! Aku juga sudah jadi wartawan yang bisa mandiri! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630502
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630502,
					"content": "Benar-benar hidup sih fotonya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630503,
					"content": "Iya, kan. Lihat nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630504,
					"content": "Kalau soal fotonya hidup sih tidak tahu ya. Tapi sangat berseni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "Kalau soal seni, Paimon nyerah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630508,
					"content": "Yakin begini saja sudah oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630509,
					"content": "Memangnya ada masalah? Aku rasa keren tuh fotonya! Senior pasti tidak sangka aku bisa foto sebagus ini! Dia pasti terkejut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630510,
					"content": "Enggak ngerti lagi deh sama standarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630511,
					"content": "Duh ... ini loh yang namanya \"makna simbolis itu lebih penting daripada isinya itu sendiri\". Aku yakin senior pasti bisa mengerti makna di baliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630512,
					"content": "Tapi yah bagaimanapun juga, terima kasih untuk bantuannya. Ini imbalannya. Lain kali kita bahas-bahas lagi soal memancing ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630506,
					"content": "Hidup sekali fotonya. Kayak bisa tiba-tiba bergerak saja deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "Duh ... Kayaknya kalau lihat lebih lama bisa pusing deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
