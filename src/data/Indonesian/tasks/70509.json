				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#Halo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090102,
					"content": "Hai! Paimon bakalan lebih kaget lihat ada kamu di sini kalau tadi belum kedatangan teman-teman kita yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090103,
					"content": "WADUH! SHENHE? Astaga, ini baru ngagetin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090104,
					"content": "Tempat ini lumayan susah dicari. Angel's Share ... namanya susah dilafalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090105,
					"content": "Untungnya, ada Tuan Zhongli yang berbaik hati menunjukkan arah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090106,
					"content": "Kamu enggak tahu jalan? Eh, tunggu ... kamu jauh-jauh ke sini cuma mau minum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090107,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090108,
					"content": "Tidak apa-apa, kan kita teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090109,
					"content": "Mau minum apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "Ini menunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090111,
					"content": "Boreal Watch ya ... Hmm, \"Boreal\" maksudnya iklim dingin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090112,
					"content": "Yah, kata \"Boreal\" di sini harusnya merujuk ke Wolf of the North. Jadi kamu benar, dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090113,
					"content": "Caramel Pinecone ... bisa diminum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090114,
					"content": "Oh, Paimon sudah cobain yang itu! Itu kopi karamel biasa sih, \"Pine\" di sini maksudnya warnanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090115,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090116,
					"content": "Nama-nama ini bikin bingung. Tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090117,
					"content": "Sudahlah, terserah kamu saja. Yang penting rasanya mirip denga Qingxin atau Violetgrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090118,
					"content": "Tanaman obat semacam itu tidak tumbuh di wilayah sini. Kalau mau minum yang pahit-pahit, pilihannya paling cuma kopi doang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090119,
					"content": "Mau coba yang manis-manis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090121,
					"content": "Ide bagus tuh. Kamu sudah latihan ilmu Adeptus segitu lama. Waktunya coba hal baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090122,
					"content": "Kita bikin Snow-Covered Kiss saja buat Shenhe! Namanya cocok banget kan sama orangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050903",
							"2"
						],
						"stepId": 7050903,
						"stateName": "QUEST_STATE_UNFINISHED"
