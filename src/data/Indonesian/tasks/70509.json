				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "Hmm, manis dan lembut. Tidak ada pahitnya sama sekali. Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090202,
					"content": "Namanya Snow-Covered Kiss! Kocok susu sampai berbusa, lalu tuangin ke atas jus buah. Mirip salju kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090203,
					"content": "Jangan tanya kenapa ada kata \"kiss\" di namanya ya! Soalnya Paimon juga enggak ngerti. Palingan juga cuma trik pemasaran doang biar lebih laku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090204,
					"content": "Trik pemasaran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090205,
					"content": "Eh? Bukan ya? Paimon cuma nebak saja sih. Mungkin maksudnya lebih ke sesuatu yang bau-bau romantis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090206,
					"content": "Romantis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090207,
					"content": "Aduh ... gimana jelasinnya ini? Sudah dong, Paimon capek bikin cerita terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090208,
					"content": "Busa susu ini tidak terlalu berasa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "Hmm, nah betul itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090211,
					"content": "Begitu manisnya jus buah menyentuh bibirmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090214,
					"content": "Begitu ya. Sepertinya aku sudah mengerti sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090215,
					"content": "Eh? Masa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090216,
					"content": "Lah, kok malah jadi Paimon sih yang bingung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090217,
					"content": "Aku kadang mengunyah tanaman obat Adeptus ketika ada di pegunungan. Aku pernah menyaksikan saat-saat tunas baru muncul dari tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090218,
					"content": "Rasa tegang yang muncul dalam hati di saat itu ... mirip dengan yang kurasakan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090219,
					"content": "#{NICKNAME}, terima kasih sudah menjelaskan nama-nama aneh ini padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090220,
					"content": "Mungkin aku akan perlu bantuanmu lagi suatu hari nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090212,
					"content": "Rasanya seperti tunas yang menyembul menembus salju untuk menciummu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "Mirip dengan salju di pegunungan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}