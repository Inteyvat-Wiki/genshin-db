			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "Eh, botol ini sedikit berat, sepertinya ada sesuatu di dalamnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280102,
					"content": "\"Kemarin, teman lama kami datang, membawakan sebuah berita buruk...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280103,
					"content": "\"Sudah lama tidak mendapatkan balasan, mungkin yang dia katakan benar, aku harus menerima kenyataan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280104,
					"content": "\"Tapi tidak peduli bagaimana pun, kalau kamu masih berkelana dan menerima pesanku ini, aku harap kamu mau membalas suratku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280105,
					"content": "\"Berikan stempelmu di atas suratmu, dengan begitu aku akan dapat dengan mudah mengenali kalau itu kamu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280106,
					"content": "\"Apa kamu masih ingat \"Uyuu Restaurant\"? Kita bisa bertemu di sana, uang untuk anggurnya juga sudah dikirim bersama surat ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280107,
					"content": "\"Kalau kamu menerima pesanku ini, dan kamu bukanlah orang yang aku harapkan...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701280108,
					"content": "\"Aku harap kamu bersedia menyimpan suratku ini, atau kamu bisa membantuku menemukan siapa pemilik sebelumnya, aku akan memberikan Mora ini sebagai imbalan terima kasihku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botol Terdampar"
				}
			]
		}
	]
}