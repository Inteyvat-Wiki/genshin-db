			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751570101,
					"content": "*hiks* Bisa-bisanya aku dikurung begini ... harga diriku sebagai Penguasa Angin Malam, hilang! Muka ini mau disimpan di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570102,
					"content": "Aib suku ... aib suku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570103,
					"content": "Kamu lagi? Kali ini kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570104
					]
				},
				{
					"id": 751570104,
					"content": "Ah, penolongku yang budiman, kita ketemu lagi. Maaf harus melihat yang barusan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570105,
					"content": "Ah, bukannya aku sudah pernah memperkenalkan diri ya? Namaku Conulaf, calon imam Penguasa Angin Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570106,
					"content": "Ya, saat ini aku sedang dalam pelatihan untuk menjadi imam. Ya ... tetua suku bilang nenek moyangku, Sanhaj, sering bertaruh dengan orang-orang suku lain. Sering mengerjai orang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570107,
					"content": "Maka dari itu, para tetua menyuruhku dengan mengatakan, \"Pergi, bikin taruhan, dan menangkan! Setelah itu baru kamu jadi Penguasa Angin Malam sejati.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570108,
					"content": "Jadi tadi aku lewat sini dan melihat ada turnamen ... terus aku ikut taruhan deh. Yah, peduli amat orang punya \"juara bertahan Tepetlisaurus\" atau \"Qucusaurus pendatang baru terkuat dalam satu dasawarsa\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570109,
					"content": "Soalnya Saurian terkuat tuh sudah jelas: Iktomisaurus kami dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570110,
					"content": "Nah, pola pikirku awalnya seperti itu ... dan aku pun pasang taruhan. Ke pihak yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570111,
					"content": "Aku jadi punya utang ... dan alhasil, dikurung di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570112,
					"content": "\"Hehe, tahu tidak,\" katanya. \"Kami bakal balikin duitmu sepuluh kali lipat kalau Iktomisaurus-mu yang menang. Kalau tidak ya sudah, betah-betahin saja di dalam\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570113
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570113,
					"content": "Gimana ini? Duh, coba kalau benar ada Iktomisaurus yang bisa bikin dua Saurian petarung itu makan debu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570114,
					"content": "Biar aku bisa bebas, dan duit balik sepuluh kali lipat! Ah ... salah. Yang pentingnya, Iktomisaurus Penguasa Angin Malam tidak boleh diremehkan suku lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570115,
					"content": "Penolongku yang budiman ... *hiks* Tolonglah, andai saja ada Iktomisaurus seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570116
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570116,
					"content": "Ah, sudahlah. Omong kosong apalagi itu. Toh penolongku yang baik juga bukan orang suku kami, gimana caranya bisa dapat Iktomisaurus? Muncul tiba-tiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570117
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570117,
					"content": "Nyari sih bisa ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570118
					]
				},
				{
					"id": 751570118,
					"content": "Ha-Hah? Serius??? Kalau gitu, aku ... aku bisa betah-betahin diri di dalam kandang ini sebentar lagi, sampai ada kabar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
