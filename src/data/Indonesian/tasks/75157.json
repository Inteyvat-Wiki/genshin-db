					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570302
					],
					"speakerTitle": "Pejuang \"Putra-Putri Gema\" yang Bersemangat"
				},
				{
					"id": 751570302,
					"content": "Sikat, Bor Beton! SIKAT! Goyang dulu, keker dulu, lalu SIKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
