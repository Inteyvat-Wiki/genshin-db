			},
			"dialogs": [
				{
					"id": 412120701,
					"content": "Bagaimana kondisi buku sketsanya, Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120702,
					"content": "Cukup baik. Ada beberapa lembar yang hancur, tapi sebagian besar catatanku masih selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120703,
					"content": "Suhu di gunung salju terlalu rendah, apalagi di dekat gua itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120704,
					"content": "Ditambah lagi, para Hilichurl itu meludahi seluruh isi buku. Aku tidak berani membayangkan apa yang akan terjadi bila aku membiarkan lembar-lembar sketsa yang basah membeku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120705,
					"content": "Kertas yang membeku sangat rapuh dan mudah hancur, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120706,
					"content": "Untungnya kamu berhasil menyelamatkan buku sketsa itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "Kamu pintar sekali, kamu memang layak menjadi alkemis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120708,
					"content": "Kalau saja buku itu rusak, kamu pasti marah besar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120709,
					"content": "Kenapa kamu berpikir seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120710,
					"content": "Kamu pernah mengatakan kalau di dalam buku terdapat banyak gambar sketsa dan catatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120711,
					"content": "Harus kuakui, buku sketsa ini memang selalu kubawa ke mana pun aku pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120712,
					"content": "Tapi aku tidak akan marah besar karena hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120713,
					"content": "Kalau isi buku ini tidak selamat, aku bisa menggambarnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120714,
					"content": "Ugh, pemikiran kamu sangat realistis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120715,
					"content": "Aku tidak setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120718,
					"content": "Bagaimana pun, isi buku sketsa ini adalah hasil jerih payahmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "Benar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120720,
					"content": "Isi buku ini adalah kenangan akan usahamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "Benar, benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120722,
					"content": "Jangan membuang benda yang berisi kenangan semudah itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "#Betul! Ah, {NICKNAME} memang hebat, Paimon juga merasa demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120724,
					"content": "...Kamu benar. Menggambar ulang semuanya akan sangat merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120725,
					"content": "Pasti karena kamu sangat berbakat kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120726,
					"content": "Lihat saja, kamu menguasai banyak kemampuan dan pengetahuan yang diimpi-impikan orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120727,
					"content": "Tapi orang sepintar itu biasanya suka melupakan hal-hal kecil. Mungkin ini salah satu kelemahan dari menjadi pintar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120728,
					"content": "Albedo juga pernah memuji kamu pintar, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "Tidak perlu diragukan lagi, Paimon memang makhluk yang sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120730,
					"content": "Paimon suka lupa hal-hal kecil juga, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "AHH! Waktu Paimon sedang mengatakan kata-kata bijak, jangan ejek Paimon dong!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120733,
					"content": "Kalau begitu ayo kita ganti topik pembicaraan. Cyrus pernah mengatakan kalau para Hilichurl di gunung ini suka menyerang dan merampok para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120734,
					"content": "Tempat yang kita kunjungi tadi pasti salah satu dari kemah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120735,
					"content": "Hilichurl di area ini sangat kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "Ya, Hilichurl di area ini lebih kuat dari Hilichurl di kaki gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120737,
					"content": "Aku juga sependapat. Aku rasa... ini ada hubungannya dengan naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120738,
					"content": "Kekuatan yang tersisa dari kerangka Durin memperkuat monster-monster itu. Ditambah dengan cuaca dingin yang parah, membuat beberapa kawasan pegunungan menjadi tanah tak berpenghuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120739,
					"content": "Pengembara, bisakah kamu mengeluarkan pedangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120740,
					"content": "Setiap kali bertarung, pedang ini akan menghisap kekuatan dan menyimpannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120741,
					"content": "Ditambah lagi, berkat pemurnianmu, kekuatan jahat dalam pedang yang ternodai darah naga sudah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120742,
					"content": "Ini adalah fenomena yang menarik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120743,
					"content": "Ini sudah bukan kejadian pertama yang kami temui. Kami sangat ahli dalam memurnikan kejahatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120744,
					"content": "Jadi seperti inilah bentuk pemurnian... Aku tahu kamu punya keahlian untuk memurnikan, tapi aku belum pernah menyaksikannya dengan mata kepala sendiri sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120745,
					"content": "Pedang yang dapat menghisap kekuatan pasti sangat berbahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "Ya, aku tidak mengatakan kalau pedang ini senjata yang aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120747,
					"content": "Untung pedangnya tidak direbut oleh Hilichurl itu, kalau tidak bisa gawat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120748,
					"content": "Bukannya Fatui lebih berbahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "Hilichurl juga berbahaya loh! Bagaimana kalau mereka berubah menjadi kuat, menjadi super, eh, Hilichurl Ultra!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120751,
					"content": "Hilichurl Ultra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "Hilichurl Ultra Jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120753,
					"content": "Hilichurl Salju Ultra Jahat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "Salju Ultra? Kamu membuat namanya jadi aneh deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120755,
					"content": "Ngomong-ngomong, kalau memang pedangnya sangat kuat, apa pedang ini juga dapat menghisap energimu, Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120756,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120757,
					"content": "Kamu mau mencobanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120758,
					"content": "Wuaaa! Tatapanmu dingin sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120759,
					"content": "Paimon hanya bercanda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "Aku tidak marah. Yang pasti aku masih berharap kamu dapat terus menggunakan pedang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120762,
					"content": "Walaupun pedang ini berbahaya, tapi kenapa kamu masih memercayai kita? Sungguh tidak disangka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120763,
					"content": "Albedo, yang kamu katakan berbeda dengan yang kamu lakukan... Paimon tidak mengerti apa yang benar-benar ada di pikiranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120764,
					"content": "Aku tidak mengerti maksudmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120765,
					"content": "Tapi kalau kamu memang ingin tahu kenapa aku memercayai kalian, mungkin karena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120766,
					"content": "Ada suatu kekompakan di antara kaum aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120767,
					"content": "Kaum aneh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "Orang-orang yang sendirian... yang berbeda dengan orang biasa. Seperti kamu dan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120769,
					"content": "(...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(Apa maksud dari perkataannya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "Paimon tidak bermaksud buruk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "Bukannya Treasure Hoarder lebih berbahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "Aku tidak merasa Paimon memiliki masalah itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "Kalau jadi kamu, aku pasti marah besar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
