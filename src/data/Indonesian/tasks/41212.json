					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "Di depan tidak ada jalan lain lagi, selain mulut gua raksasa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120602,
					"content": "Apa dia masuk ke dalam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "Dilihat dari jejak kaki yang ditinggalkannya, dia pasti masuk ke dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120604,
					"content": "Kalau begitu tunggu apa lagi? Jangan biarkan dia kabur begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120605,
					"content": "Tunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120606,
					"content": "Gunung ini terlalu luas. Meski ada jalur untuk melewati perut gunung, jalannya tidak akan semulus jalan biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120608,
					"content": "Apa kamu merasakannya? Angin yang berembus membawa hawa dinginnya batu, dan dengarkanlah gaungan gema di dalamnya. Ruang di dalam pasti sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120609,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120610,
					"content": "Karena itu, tidak ada gunanya tergesa-gesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120611,
					"content": "Ta-tapi kita sudah sejauh ini — kita tidak bisa membiarkan dia kabur begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120612,
					"content": "Bukankah buku sketsa itu penting untukmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "Penting sekali, tapi kita tidak boleh bertindak gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120614,
					"content": "Aku tahu cara lain, hanya saja kita perlu mengerahkan sedikit usaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120615,
					"content": "Kalau tebakanku tidak salah, pintu keluar gua ini ada di sisi lain gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120616,
					"content": "Kamu ahli terbang, bukan? Aku juga cukup menguasainya. Bersiap-siaplah, kita akan terbang dalam sekali jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
