			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Albedo! Kami sudah kembali nih~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120102,
					"content": "Oh, dia sedang kedatangan tamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120103,
					"content": "Ya, tamu yang kelihatannya cukup familier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Meminta petualang pemula menjelajahi gunung salju adalah tindakan yang gegabah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120106,
					"content": "Tetapi dalam setiap petualangan, kita memang harus berani mengambil risiko untuk melampaui batasan diri! Petualangan tidak akan berarti bila tidak ada perjuangan dan kesulitan yang menantang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120107,
					"content": "Tempat ini memang penuh dengan Hilichurl jahat dan salju yang tebal, tetapi seorang petualang tidak akan menghentikan langkahnya begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120108,
					"content": "Katakan saja tujuanmu ke sini, Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120109,
					"content": "Hahaha, ayolah~ Bercakap-cakap itu sama dengan bertualang, yang terpenting adalah prosesnya, bukan tujuannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120110,
					"content": "Bahkan jika kamu dirampok dan harus meninggalkan kemahmu, kamu masih bisa membakar api unggun dan memasak di tengah dinginnya salju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120111,
					"content": "Bagi pemula, petualangan di gunung salju akan menjadi pengalaman yang tidak terlupakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120112,
					"content": "Hmm, iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120113,
					"content": "Mereka mungkin tidak menyukaiku atau bahkan membenciku, tetapi suatu hari nanti mereka pasti akan berterima kasih kepadaku. Inilah semangat petualang yang harus terus diturunkan dari generasi ke generasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120114,
					"content": "Oh ya, lalu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120115,
					"content": "Ya ampun, Albedo mulai lagi. Dia selalu bersikap dingin saat lawan bicaranya membicarakan topik yang tidak menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120116,
					"content": "Dia sama sekali tidak tertarik dengan petualang, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "Oh ya? Paimon yakin dia tertarik denganmu, kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120118,
					"content": "Tapi entah karena para pemula terlalu lemah, atau gunung salju terlalu berisiko, kami sudah mengalami kerugian yang sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120119,
					"content": "Apa? Apa maksudmu dengan \"kerugian besar\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120120,
					"content": "Oh, kamu...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120121,
					"content": "Halo, Cyrus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Sudah lama tidak berjumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120123,
					"content": "Ah~ petualang muda dan temannya, senang sekali bertemu dengan kalian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120124,
					"content": "Aku harap medan di gunung ini tidak membuat kalian kesulitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120125,
					"content": "Tugas apa pun yang diberikan kepada kami tidak akan membuat kami kesulitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120126,
					"content": "Hahaha, baik, baik! Aku suka kepercayaan diri kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120127,
					"content": "Kenapa kamu harus melawan angin dan badai salju untuk ke sini? Apa ada pekerjaan penting yang membuatmu ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120128,
					"content": "Aku datang ke sini untuk mengumpulkan data terbaru mengenai Hilichurl dan meminta dia untuk menjadi asistenku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120129,
					"content": "(Hah? Sejak kapan?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Oh, begitu. Ternyata kalian berkumpul ke sini untuk mengejar mimpi dan tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120132,
					"content": "Semoga semuanya lancar. Aku harus pergi sekarang — untuk mengecek para petualang pemula itu. Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120201,
					"content": "Aha, lihat apa yang terjadi tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120202,
					"content": "Albedo merahasiakannya dari Cyrus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "Yah, bagaimanapun juga itu adalah pedang magis, wajar saja dia tidak ingin orang lain mengetahuinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120204,
					"content": "Aku bisa mendengar kalian, loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120205,
					"content": "Apa aku tidak seharusnya bertanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "\"Harus\" dan \"tidak harus\" itu tidak ada. Tanyakanlah apa yang ingin kamu tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120207,
					"content": "...tapi sekarang bukanlah saat yang tepat. Aku masih ada urusan penting yang harus ditangani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120208,
					"content": "Urusan? Paimon rasa, kamu juga akan melibatkan kami, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120209,
					"content": "Kamu sudah semakin pintar ya, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120210,
					"content": "Hei! Paimon dari dulu sudah pintar, tahu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120211,
					"content": "Aku menemukan beberapa habitat baru dengan jenis monster yang berbeda. Aku yakin bisa mengumpulkan data yang bervariasi dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120212,
					"content": "Kamu sangat menyukai penelitian, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Ketekunan adalah kunci dalam penelitian, dan ketekunan adalah sifat dasar yang harus dimiliki seorang alkemis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120214,
					"content": "Apa kamu sudah siap? Ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120130,
					"content": "(Dia sepertinya tidak ingin banyak orang terlibat dengan pedang magis itu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "Apa kita pernah melihat wajah itu sebelumnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
