					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120301,
					"content": "Hmm? Sepertinya tidak ada siapa pun di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120302,
					"content": "Para monster juga diutus untuk menjalankan tugas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120303,
					"content": "Kalau begitu sebelum mereka muncul, apa kamu ingin berjalan-jalan atau beristirahat dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120304,
					"content": "Bagaimana kalau kita beristirahat dan berbincang santai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Aku juga sepemikiran denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120309,
					"content": "Kalian mau berbincang-bincang? Paimon ikut, dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120310,
					"content": "Aku tahu kamu pasti mempunyai banyak pertanyaan - baik tentang aku ataupun tentang situasi saat ini. Seperti yang pernah kukatakan sebelumnya, aku akan menjawabmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120311,
					"content": "Tapi aku tidak mau menipumu, ada beberapa hal yang tidak bisa kukatakan kepadamu. Biarkan aku menyimpan rahasia ini untuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120312,
					"content": "Wah, tidak disangka Albedo sangat terus terang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120313,
					"content": "Dia lebih jujur dari yang kukira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120316,
					"content": "Iya! Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120318,
					"content": "Kenapa kamu membuat suara aneh, Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "Bagaimana mungkin aku yang membuatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120322,
					"content": "Ah, ternyata Hilichurl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "Apa kamu yang membuat suara aneh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "Mana mungkin Paimon melakukannya? Kenapa kamu tidak menanyai Albedo saja?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120314,
					"content": "Dia tidak berbelit-belit seperti yang kukira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "Bagus sekali. Aku ada beberapa pertanyaan untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120308,
					"content": "Baiklah, apa yang ingin kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				}
			]
		},
