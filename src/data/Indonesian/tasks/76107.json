			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Dunia ilmiah baru bisa berkembang kalau punggawa-punggawanya menjunjung tinggi azas kerja sama, paham ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Hmm ... benar juga. Aku sendiri pernah ditugaskan untuk mengumpulkan beberapa jurnal ilmiah dari Institut Penelitian Fontaine oleh beliau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "Sebagai pakar di bidangnya, aku rasa memperbaiki kerusakan pada Landcruiser ini tentunya urusan sepele saja bagi Anda, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
