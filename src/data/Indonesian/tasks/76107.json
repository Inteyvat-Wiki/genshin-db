					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "A-Astaga! Nama Profesor Mosso bahkan sudah terdengar sampai ke sini, ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hmph. Profesor Mosso sudah meninggal tiga puluh tahun yang lalu. Dan kamu akan menyusulnya sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
