			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "Aku ... peneliti khusus yang ditunjuk oleh Marionette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "Peneliti khusus? Nona Harbinger berdiri di puncak penelitian mekanika dan kuuvahki. Beliau tidak perlu bantuan pihak luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
