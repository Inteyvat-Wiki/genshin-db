			"dialogs": [
				{
					"id": 761071101,
					"content": "Aku Harbinger kalian, Marionette!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Eh? Se-Sebentar, kamu serius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hmph, aku menghargai keberanianmu, tapi kebohongan yang begitu terang-terangan ini terlalu meremehkan Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
