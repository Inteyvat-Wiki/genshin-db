					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Kamu menghajar Landcruiser itu dengan tinju dan kepalan. KLONTANG, KLONTENG! Berhasil! Dia sudah tidak bisa bergerak lagi sekarang.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Ini ... rusak total loh. Gimana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "Hmph, dari tadi aku sudah merasa ada yang aneh. Peneliti sungguhan tidak banyak mulut! Kamu jelas palsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
