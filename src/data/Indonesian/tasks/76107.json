			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Eh, aku ... lebih fokus pada penelitian teori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Ah, begitu rupanya. Penelitian teori kuuvahki adalah ilmu yang sangat dalam, sungguh luar biasa! Sedangkan perbaikan Landcruiser lebih ke ilmu terapan, keduanya memang tidak bisa dicampuradukkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Tapi Nona Marionette sedang tidak di tempat. Silakan coba ke Komandan Azalea dulu, mungkin beliau sudah diinformasikan perihal koordinasi dengan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
