				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, akhirnya kamu kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050102,
					"content": "Penyesuaiannya sudah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "Sudah selesai semua. Cuma aku agak khawatir karena Pursina's Spike untuk sementara harus ditinggal di dalam terowongan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050104,
					"content": "Aku juga sudah minta Khedive sediakan obat buat Tu dan Hao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, sekarang semuanya bergantung padamu. Nyalakan Pursina's Spike dan tutup bukaan sumber lumpur hitam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050106,
					"content": "Sejujurnya, dulu waktu Khedive datang minta tolong, aku sudah berpikir untuk pulang ke Sumeru saja kalau semuanya gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050107,
					"content": "Dan lagi pula, sudah cukup banyak uji coba dan eksperimen yang dilakukan terkait Pursina's Spike. Data yang dikumpulkan juga sudah lebih dari cukup untuk dijurnal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050108,
					"content": "Tapi Tu dan Hao ... Aku tidak tega membayangkan mereka yang harus berkutat dengan lumpur hitam ini seumur hidup kalau aku pergi begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050109,
					"content": "Aku pun sadar, kalau penelitianku tidak bisa membantu mereka, dan cuma bisa dipakai sebagai data buat jurnal ilmiah, artinya ... penelitianku tidak berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050110,
					"content": "Itulah kenapa aku putuskan untuk cari cara menghentikan muntahan lumpur dari Ley Line ini. Perlu diakui bahwa ... terpapar lumpur hitam ini juga menjadi peringatan keras untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050111,
					"content": "#Aku yakin sepenuhnya pada kemampuanmu, tapi area yang banyak aliran lumpurnya masih sangat bahaya. Jangan kecolongan, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050112,
					"content": "Tentunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Hahaha! *uhuk* *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050115,
					"content": "#Yang aku maksud itu kamu, {NICKNAME}. Pursina's Spike memang bisa menurunkan efek lumpur pada monster jika dinyalakan di bukaan Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050116,
					"content": "Tapi monster yang berkerumun di sana jumlahnya jauh di luar perkiraan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050117,
					"content": "Jadi tolong jaga diri baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050113,
					"content": "Iya, Pursina's Spike nya aku jaga baik-baik kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}