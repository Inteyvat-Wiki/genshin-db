			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, bagus, bagus! Oke, sini ya model cilik yang pintar ... Oke, anak baik! Tiga, dua, satu, senyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Ah lihat ini, luar biasa, kan? Karya siapa nih? Benar, ini karyaku — maha karya yang luar biasa, perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Terima kasih banyak! Haha! Nah, ini sisa bayaran yang belum kubayar! Ah ... terus ini juga. Lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Ooh, sisa bayarannya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Tunggu. Cuma satu Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Bagus ... sekarang pemeran utama kita yang sebenarnya akan muncul! Ayo masuk, jangan malu-malu! Kamu ini bintang utama, jadi naiklah ke panggung layaknya seorang bintang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Fyuh, oke selesai! Nih, ambil salinannya, anggap saja hadiah dariku ... dan ini tandanya kalian sudah dapat duluan maha karya ini daripada galeri mana pun di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Terima kasih. Akan kami simpan baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Tapi, sisa bayarannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Berikutnya aku bakal ke sini ... Nih, kuberi tanda di petamu. Mungkin saja kita bakal ketemu lagi nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "Dan mungkin saja aku masih perlu bantuanmu lagi nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "Ih, kamu manfaatin kami ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Loh, itu kan bukan aku yang memutuskan. Ini namanya jodoh — iya, jodoh! — kalau jodoh pasti bertemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "Sampai jumpa dan semoga perjalanan kalian lancar ya teman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico mengambil tasnya dan langsung lompat ke balon udara.\\nKamu menyaksikan balon tersebut bergoyang-goyang, Magnifico tertawa terbahak-bahak lalu menstabilkan dirinya sambil terbang bersama balon udara tersebut.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Kok dikit banget ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "Nguk? Nguu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Iya ... Paimon juga kecewa nih ... Kirain sisa bayarannya bakal lebih banyak daripada DP-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
