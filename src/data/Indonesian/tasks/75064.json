			"dialogs": [
				{
					"id": 750641101,
					"content": "Hmm, berikutnya Iktomisaurus di bawah terang bulan! Ya, bagus. Perlu pencahayaan ideal sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Hmm ... Aha! Waktunya bersinar, wahai temanku, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Cilik? Pfft, jelas-jelas dia lebih tinggi dari kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "Nguuu? Ngu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Bagus, bagus ... Waktunya tepat sekali ... Haha! Maha karyaku hampir selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Kalau gitu kamu harus foto yang bagus ya, sama kayak foto para gadis Fontaine! Hehe, gitu kan kalimatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Nguu, nguuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, tenang dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Sudut ini! Lalu juga cahaya bulannya! Ah! Sungguh sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Sebentar ... aku perlu dua lagi sumber cahaya. Yang satu menyorot rupa Iktomisaurus, supaya kontras sinar hangat dan malam gelapnya kena. Biar lebih misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "Lalu sumber cahaya satunya menerangi siluet Saurian. Bukan bikin ribet ya, ini wajib hukumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Oke, ya benar begitu! Duh kayak mimpi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Eh ... Sialan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Maaf, mungkin konsentrasi elemen di udara sini beda sama di Fontaine. Jadi kayaknya ada yang salah sama alatnya ... Tapi tenang, biar kuperiksa dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "*bersenandung* Hmm ... Ini juga bukan ... Di sini juga bukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Sial, sial, sial! Ahhh! Bikin aku kesal saja, dasar kamu daki biawak! Arrgghhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
					"content": "Kamu ... Kamu ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "Hei, hei, tenang dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Keluar asap tuh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Yah ... rusak total deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641123,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641124,
					"content": "Heh. Jangan lihat aku gitu dong. Setidaknya sekarang perasaanku sudah jauh lebih mending!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641125,
					"content": "*huff* Yah, seperti yang kalian lihat sendiri tadi. Cahaya buatan kita rusak deh — padahal aku sudah keluar banyak Mora. Benar-benar mengecewakan, persis kayak mantan istriku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641126,
					"content": "Oke sekarang ... berhenti dulu deh. Tenang, jangan panik. Kami kan di sini buat bantuin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641127,
					"content": "*huff* Maaf ... Ya sudah. Apa yang harus kulakukan? Oh iya, aku perlu menyinari <color=#00E1FFFF>bagian kiri muka Iktomisaurus</color>, terus juga <color=#00E1FFFF>kontur punggungnya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641128,
					"content": "Enggak masalah! Yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "Magnifico mulai menyetel Kameranya sekali lagi, sedangkan kamu sedang memikirkan gimana caranya membuat pencahayaan yang cocok dan ideal ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "Loh, kenapa? Kalian cerai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
