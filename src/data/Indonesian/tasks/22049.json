			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "Oh, bukannya ini teman baru anakku? Kamu ke sini untuk main bersamanya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490102,
					"content": "Bagaimana kabar usahamu hari ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Baik, sangat baik! Hahaha, gadis kecilku benar-benar pandai mengotak-atik, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490104,
					"content": "Hari ini kalian datang mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490107,
					"content": "Aduh, sayang sekali! Dia bilang kalau dia lagi pergi mengumpulkan material untuk membuat kembang api baru, jadi dia sedang keluar sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490108,
					"content": "Huh. Jadi dia pergi ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "Apa? Err, kamu bilang apa tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490110,
					"content": "Yoimiya! Dia pergi ke mana?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "Oh, uh... aku sebenarnya tidak terlalu yakin. Dia memang bilang mau ke mana, tapi kamu kan tahu, telingaku ini sudah tidak bisa dengar jelas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490112,
					"content": "Apa kamu ada suatu keperluan dengannya? Apa kamu mau membeli kembang api?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490113,
					"content": "Kami mau mengajak Yoimiya main...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Ah, kurasa kalian tidak cukup beruntung kali ini. Setiap kali dia pergi berkutat dengan kembang apinya, kamu tidak akan bisa tahu kapan dia akan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490115,
					"content": "Bagaimana kalau begini saja? Dia sudah membuat kembang api baru dan meninggalkan beberapa di toko sebelum keluar. Bagaimana kalau kalian mengambilnya dan memainkannya saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490118,
					"content": "Ugh, di mana ya kembang api itu ... di sekitar sini harusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490119,
					"content": "Uh, apa boleh begini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Oh, tidak apa-apa kok. Jangan khawatir. Kami memiliki banyak stok di toko. Jadi ambil saja dan bermainlah dengan seru di luar. Jangan cemaskan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490122,
					"content": "Ditambah lagi, anakku memang berniat mencari orang untuk mencoba memainkan kembang api ini. Karena kalian kemari, kebetulan kalian bisa mencobanya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490123,
					"content": "Kalian main saja dengan tenang, dan ceritakan padaku bagaimana keadaannya setelah selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490124,
					"content": "Saat Yoimiya pulang, aku akan memberi tahu kesanmu padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490125,
					"content": "Tenang saja. Aku yakin, anak itu pasti senang bukan kepalang saat tahu kalau kalian yang memainkan kembang apinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490126,
					"content": "Pergilah. Jangan lupa untuk nyalakan kembang api itu di luar kota. Kalau kalian menyalakannya di dalam kota, kalian akan menarik perhatian orang-orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490120,
					"content": "Kita tidak memberi tahu Yoimiya dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Kami mau memainkan kembang api...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Hahaha, ternyata begitu. Bagus kalau begitu. Yoimiya sudah membuat kembang api baru dan meninggalkan beberapa di toko sebelum keluar. Bagaimana kalau kamu mengambilnya dan memainkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490105,
					"content": "Apa Yoimiya ada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Ah, kamu datang ke sini untuk mencarinya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		},
