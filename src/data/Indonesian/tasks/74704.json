			"dialogs": [
				{
					"id": 747040101,
					"content": "Hei, Columbina! Lagi lihat-lihat ikan di akuarium kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040102,
					"content": "Ya. Tempat ini dihias jadi indah sekali. Ada banyak ikan yang belum pernah kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040103,
					"content": "Dulu pernah ke akuarium?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040104,
					"content": "Belum pernah, tapi aku pernah lihat akuarium-akuarium di Snezhnaya. Cuma, waktu itu mataku belum terbuka total, jadi aku tidak bisa menghargai semuanya baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040105,
					"content": "Kalau sekarang gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "Indah sekali. Aku tidak tahu kalau dunia bawah laut berwarna sekali. Rasanya seperti ... hidup di musim semi abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040107,
					"content": "Wah, lihat ikan itu. Menurut kalian mirip tidak sama Sandrone? Dua ikan di sana, satunya buntuti yang lain ... Mereka seperti kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040108,
					"content": "Eh, benar juga ya! Setelah kamu bilang begitu, jadi kerasa mirip kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040109,
					"content": "Yang sok sibuk di sana juga buat aku teringat Lauma. Yang di karang itu kayaknya diam-diam mengamati semuanya, persis kayak Nona Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040110,
					"content": "Eh ... Jadi waktu Columbina lagi lihat-lihat ikan, suka nyari yang mirip sama temen-temennya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040111,
					"content": "Bukan begitu sih. Lebih tepatnya karena aku suka teman-temanku, jadi secara tidak sadar, aku selalu ingat mereka dalam kehidupan sehari-hari. Termasuk waktu lihat ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040112,
					"content": "Wah! Paimon seneng banget dengarnya. Terus, ada ikan lain yang buat kamu teringat sama seseorang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040113,
					"content": "Hmm ... akhir-akhir ini aku punya banyak teman baru. Sepertinya kalau mau dicari satu-satu yang mirip, susah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040114,
					"content": "Benar juga. Tapi kita juga bakal terus nambahin isi akuariumnya kok. Columbina bisa mampir lagi kalau lagi senggang, siapa tahu bakal ketemu teman lain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040115,
					"content": "Kalian mau taruh teman-temanku ke akuarium?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747040116,
					"content": "Bukan dong! Paimon lagi bahas ikan yang mirip temanmu, halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}