			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Berhenti! Orang luar tidak boleh masuk ke Chasm ... oh, kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Gawat, ayo kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Paimon, jangan ribut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahaha, maaf mengagetkan. Mana bisa aku lupa sama wajah yang pernah menyelamatkanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Aku juga belum lama tiba di sini. Tak kusangka bisa bertemu dengan penolongku, aku sungguh beruntung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Penolong? Memangnya kami pernah buat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Jangan merendah! Aku juga ada di Jade Chamber waktu kalian bertarung melawan monster laut. Aku terluka, tapi sudah pulih sepenuhnya beberapa waktu lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Mungkin kalian tidak ingat, tapi aku tidak mungkin lupa pada kalian. Semua orang yang ikut pertempuran itu menyaksikan bagaimana kalian rela berkorban untuk Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Tentang Chasm ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Dua tahun yang lalu ada kecelakaan aneh di tambang, dan Qixing akhirnya mengeluarkan perintah penutupan. Sebagian besar pekerja tambang juga sudah dievakuasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Sayangnya, tambang sebesar ini harus berhenti beroperasi. Pekerjanya juga sudah diberi kompensasi, dan sudah pindah haluan untuk mencari nafkah. Aih, orang kalau sudah berpencar akan sulit disatukan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "Maaf, bicaranya sudah kejauhan. Aku yakin kamu ke sini karena ada urusan penting, jadi aku tidak akan halangi. Kalau ada yang mau ditanyakan, langsung saja cari Muning. dia ada di kemah yang dekat pintu masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Ah, lalu bukannya aku tidak percaya sama kalian, tapi ... tolong jangan lakukan tindakan yang melanggar hukum ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Tenang, masa enggak percaya sih sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Kamu kenal aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Ketahuan, ayo kabur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
