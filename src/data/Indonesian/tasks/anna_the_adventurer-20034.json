			"dialogs": [
				{
					"id": 200340301,
					"content": "Bennett masih sama saja ya, bisa diandalkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "Fischl juga sama, omongannya masih tetap ... bikin orang terkesima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "Bagaimana pendapatmu tentang Bennett?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Pendapatku tentang Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Waktu aku baru bergabung dengan Adventurers' Guild, Bennett menjawab semua pertanyaanku dan juga banyak membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Tapi dengar-dengar, dia itu sering tertimpa nasib malang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "Terkadang kenyataan memang tidak adil ya. Padahal dia orangnya sangat baik hati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "*huff* Misinya selesai deh. Terima kasih, Pengembara. Aku akan melapor ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Tapi kenapa aku selalu dapat misi mengawal kargo balon udara selama beberapa hari berturut-turut ... Apa tidak ada misi lain di Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "Bagaimana kabar Fischl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Fischl ... Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "Dia juga bisa diandalkan! Teknik memanahnya bagus, dan dia sudah mengerjakan banyak misi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Meskipun perkataan-perkataan dia ... sangat sulit dimengerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "Tapi di-dia adalah petualang yang sangat berpengalaman! Eh salah, maksudku penyelidik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
