				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl, kamu tadi larinya terlalu cepat! Bahaya loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "Petir ilahi sang Prinzessin ini tidak akan pernah membiarkan benih-benih kejahatan tumbuh dan menyebar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Wah, ada Fischl dan Bennett. Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "Oh, ada Anna dan Pengembara. Kalian ke sini untuk menyelesaikan misi dari Adventurers' Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "Oh! Wahai pengikut yang diberkati sang Prinzessin, sepertinya untaian nasib telah menggiringmu hingga ke tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Mein Fräulein bilang, dia tak menyangka bisa bertemu kamu di sini. Dia sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "Aku sedang menemani Anna menyelesaikan misi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "Ya, aku dan Pengembara sedang mengantar kargo balon udara di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "Tapi, aku tiba-tiba melihat gerombolan Treasure Hoarder menerjang kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Aduh, maaf, maaf ya. Ini salahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Awalnya aku dan Fischl menerima misi ini, dan ingin melacak keberadaan gerombolan Treasure Hoarder ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Oz dengan susah payah berhasil melacak arah pergerakan mereka. Dan saat kami bersiap-siap untuk menangkap mereka, aku malah tersandung dahan pohon dan terjatuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "Suara pas aku jatuh mengagetkan gerombolan Treasure Hoarder itu, lalu mereka langsung kabur deh ... Selanjutnya ya kami cuma bisa terus lari dan mengejar mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "Tidak ada gunanya bergundah gulana. Kilat ungu penghakiman sudah ditakdirkan untuk menghukum para penjahat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "Tapi Mein Fräulein, yang menangkap penjahat-penjahat itu adalah Pengembara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "O-Oz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "Ngomong-ngomong, terima kasih ya. Untung kalian menghadang di depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "Sepertinya nasibku hari ini cukup mujur ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "Aku senang bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Hehe, kalau begitu aku akan menggiring para Treasure Hoarder ini ke Adventurers' Guild dulu ya. Kalian berhati-hatilah waktu mengerjakan misi, jangan sampai tersandung sepertiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
