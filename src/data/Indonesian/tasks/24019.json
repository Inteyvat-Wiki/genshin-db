			"dialogs": [
				{
					"id": 240190801,
					"content": "Kamu ... Teganya kamu! Mereka ini beda sama burung camar sialan yang di Palais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Maaf, aku ... enggak sengaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "Ck, aku bahkan tidak sempat hentikan kamu barusan ... Kenapa? Apa salah mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Yah sudahlah. Mereka sudah pergi semua. Mau gimana lagi, besok-besok aku datang lagi bawa makanan deh, minta maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
