			"dialogs": [
				{
					"id": 240190301,
					"content": "Sopan semua kan? Yang jelas lebih baik daripada orang-orang kasar di Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Mereka jinak banget ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Iya kan? Aku merasa tubuh dan pikiranku langsung tenang kalau duduk di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Bayangkan, jadi burung camar. Makan ada yang kasih, hari-hari dihabiskan buat berjemur dan merenungkan makna kehidupan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "Kenapa aku jadi Gestionnaire, bukan lahir sebagai Violetgold Angler Gull?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
