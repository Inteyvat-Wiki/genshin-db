			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Sepertinya begini saja cukup. Aku harap mereka semua kenyang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Lagi ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Kasih makan burung camar. Mereka bentar lagi kenyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Loh ... kok kalian jadi dekat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Bukannya mereka maling kentang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Tidak. Banyak yang datang ke sini untuk kasih mereka makan, jadi burung camar yang di sini tidak tertarik dengan kentang gorengku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Tapi bukannya waktu itu kamu bilang kalau kejauhan dari kantor bisa telat balik kerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, itu sih bukan masalah. Hari ini libur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Tidak ada teman kantor yang bakal giring aku bahas urusan kerjaan, tidak ada orang atau binatang yang maling kentang ... Tempat ini oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "Terus burung camar di sini ramah. Mereka tidak mengincar kentang goreng, tidak galak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Mereka sepertinya sudah mulai kenal aku setelah dikasih makan beberapa kali, soalnya mereka tidak lari kalau aku elus mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Mereka sopan sekali dibandingkan dengan burung camar yang di dekat Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Kalau burung bisa pakai cakarnya buat ngetik, kerjaan kita manusia bakal direbut semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Burung camar mana peduli sama urusan orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Tapi setidaknya tidak bikin urusan jadi tambah parah. Semua orang tahu bahwa ada hal-hal terlalu berat bagi burung camar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Ya sudahlah. Kamu mau coba berteman dengan burung-burung sopan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Waduh, sudah jadi \"burung sopan\" ya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Tersinggung tidak tuh kalau aku samperin gitu saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Tidak lah, namanya burung sopan. Jinak kalau kamu tidak acak-acak bulunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Nih, ikan khusus buat mereka. Simpan saja di mangkok situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Tenang, mereka baik kok. Yang kasih makan semua dianggap teman, terus tidak banyak tanya juga ikannya dari mana, masaknya pakai apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Terus ada kiat-kiat apa nih kalau mau berteman sama burung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Tidak ada. Paling jangan pegang bulunya langsung tanpa peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Burung camar mana yang bisa bahasa manusia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Siapa tahu. Mungkin mereka cuma pura-pura tidak mengerti biar hidupnya lebih nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
