			"dialogs": [
				{
					"id": 710702901,
					"content": "Ah, kalian datang juga! Selamat datang ke markas regu pembongkar dan pemasok minuman untuk regu penjelajahan Chasm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702902,
					"content": "Anggota satu-satunya, tidak lain tidak bukan, aku sendiri, Clitopho, mengucapkan salam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702903,
					"content": "Silakan diminum! Ini gratis kok, terima kasih untuk semua bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702904,
					"content": "Habis ini kamu ada rencana apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Karena aku sudah resmi jadi anggota, tentunya aku akan ikut regu. Kalau mereka tinggal, aku juga tinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702907,
					"content": "Yah, kalau Khedive dan Kak Jinwu bisa bantu ajukan untuk minta lebih banyak orang yang turun membantu, lebih bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702908,
					"content": "Aku mana bisa jadi ketua regu pembongkar, kalau anggotanya cuma aku seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702905,
					"content": "Kamu mau tetap tinggal di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
