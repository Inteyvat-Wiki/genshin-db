				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Ampun ... Eh? Ah, halo. Maaf, tapi barusan kamu agak mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Impas dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Oke, oke, jangan gitu ah. Kondisi sekarang lagi gawat, tahu? Gawat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Sudah lihat pecahan batu kristal itu kan? Dugaanku sih, di bagian tambang yang lebih dalam ada lagi yang lebih besar ... Kurasa kamu juga sudah tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "Teorinya, tingkat energi akan kembali stabil setelah potongan yang di atas \"kembali\" ke sumbernya. Yah, memang itu sudah terjadi, tapi ... gelombang yang dipancarkan salah ... benar-benar salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Ngomong apa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Kamu tidak sekolah ya? Oke, sederhananya sekarang kita sedang berhadapan dengan dua kekuatan yang saling bergesekan, seperti kacang kedelai di penggilingan. Mengerti tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Kita bicara skala waktu yang besar, tapi saat ini kita memang sedang digencet oleh dua kekuatan dari dua sisi, atas dan bawah. Beri dia waktu lebih lama, dan kita akan digiling sampai jadi ampas kedelai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Kalau tidak percaya, lihat saja si Zhiqiong ... Aku sudah lihat jadi seperti apa seseorang setelah berdekatan dengan hal semacam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Hari ini dia batuk-batuk lalu keluar darah, besok mungkin dia akan batuk sampai paru-parunya ikut keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Aku bisa bantu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Eh? Aku cuma perlu waktu untuk berpikir ... jalan keluarnya pasti ada kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Intinya, sekarang kamu lebih baik lanjut menjelajah dan cari tahu apa yang sebenarnya terjadi di bawah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Jangan khawatir, aku tidak akan duduk diam saja menghadapi masalah ini. Aku bertanggung jawab atas keselamatan regu penjelajahan, dan aku juga tidak mau rugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Kamu bisa tanggung jawab atas keselamatanku juga tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Yah ... harus kuakui kemampuanmu di luar dugaan, jadi ... Kamu bisa bertanggung jawab untuk keselamatan dirimu sendiri kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Ah, sudahi saja omong kosong ini. Kalau kamu sampai celaka, aku pasti ganti rugi. Puas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Coba bicara bahasa manusia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
