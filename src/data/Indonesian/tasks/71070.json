				"points": []
			},
			"dialogs": [
				{
					"id": 710702801,
					"content": "Haha! Kamu sudah kembali. Silakan, duduk dan istirahatlah. Anggap saja rumah sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702802,
					"content": "Yang kayak gini mana cocok jadi tempat tinggal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "Hahahaha! Dasar anak muda, ngomong enggak pakai filter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Berkat kamu, suasana di kemah jadi lebih santai. Kalau sebelumnya kamu sempat tegang, dapat kesan kalau aku orang yang terlalu serius, maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "Urusan yang penting sudah beres, sekarang tinggal sisa pekerjaan jangka panjang ... yaitu menetap di sini dan mengamati perubahan yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "Untuk sementara, sudah ada tambang yang akan dibuka sebagian. Tapi masuk sampai ke dalam sini masih belum boleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Kami harus menutup area ini dan mencegah para penambang ... bukan, mencegah siapa pun untuk turun sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "Memangnya aku manusia gua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
			]
		},
