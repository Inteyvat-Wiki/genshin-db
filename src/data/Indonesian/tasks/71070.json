				},
				{
					"id": 710703002,
					"content": "Data energi yang terbaca sudah mulai stabil. Terima kasih atas kerja kerasmu. Aku pasti akan tulis namamu di dalam tesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703003
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703003,
					"content": "Tapi sebagai penyandang gelar ketua regu penjelajahan, aku masih harus tinggal di sini untuk jangka panjang dan mengawasi perubahan yang mungkin terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703004
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703004,
					"content": "Ya terserah, tapi aku harus pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "Aku tidak akan memaksamu untuk tinggal. Tapi regu penjelajahan akan selalu menyambutmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
