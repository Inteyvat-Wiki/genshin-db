	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, kamu sudah datang. Terima kasih sudah bantu kami buka jalan. Zhiqiong juga sudah bantu banyak. Sekali lagi terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Tentang perkemahan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Bagaimana, lumayan kan? Memang keahlianku sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Sejak usia belasan, aku sudah ikut Ayah belajar yang seperti ini ... Cara mendirikan kemah, cara mengolah lampu kristal, cara merawat peralatan menambang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Aku terus belajar dan dia terus menua. Pada akhirnya, waktu penglihatannya sudah tidak bagus lagi, aku yang ambil alih tugas ayah merawat peralatan keamanan tambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Setelah itu aku ... juga menua. Sisanya tidak ada yang menarik. Aku dapat laki, kehilangan laki, dan punya anak gadis yang pergi sekolah ke Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Kadang, waktu para lelaki di tambang pergi lebih awal, anak-anak yang mereka tinggal di sini semuanya aku yang urus. Makanya aku selalu sedia permen dan manisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Jadi ya ... Dalam ingatanku, anak-anak selalu manis, melihat ke arahku sambil menunggu dikasih permen atau batu kecil warna-warni buat dimainkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Wah, sekarang Kak Jinwu bawa permen enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Permen? Eh ... aku tidak punya permen mahal seperti yang di kota. Tapi kalau gulali biasa ada. Mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Oh, jadi permen yang kayak gitu yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "Orang datang dan pergi, yang tersisa tinggal kenangan. Dan kalian para petualang dari luar sana, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Tentang Zhiqiong ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong termasuk generasi baru di tambang. Dia lahir di Desa Mingyun. Sebenarnya hampir semua penambang yang pengalaman di Chasm asalnya dari sana, Zhiqiong saja yang lahirnya terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Ah, jangan salah paham dulu, aku bukan bilang sekarang ini kondisinya buruk. Maksudnya, Desa Mingyun sudah lama berhenti produksi karena bijih di sana sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Zhiqiong lalu datang ke Chasm, tapi tempat ini juga berhenti produksi setelah kecelakaan tempo hari itu ... Anak itu mungkin tidak ditakdirkan untuk jadi penambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Saya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Setelah itu, orang-orang menemukan jalan mereka masing-masing. Aku tetap tinggal di tambang untuk merawat peralatan, dan dia menjadi seorang petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Anak itu belum dewasa dan sering tidak peduli pada diri sendiri. Mungkin karena pengalamannya di tambang masih terlalu sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Kalau dia sudah terbiasa hidup sebagai pekerja tambang dan punya pengalaman menolong orang-orang dari situasi bahaya dengan kedua tangannya sendiri ... Dia pasti bisa lebih menghargai nyawanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Aku tidak selayaknya minta begini, tapi ... Aku harap kamu bisa lebih lagi mengawasi dan menjaganya, jangan sampai dia meregang nyawa cuma karena ceroboh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Jaga diri baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
