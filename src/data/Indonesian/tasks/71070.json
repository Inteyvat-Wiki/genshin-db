					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702701,
					"content": "Maaf ... sifat keras kepalaku sudah bikin kalian semua jadi repot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702702
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702702,
					"content": "Ke depannya, aku akan terus menyempurnakan petanya, dan bantu Kak Jinwu pasang suar untuk memantau aktivitas lumpur hitam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702703,
					"content": "Itu ... katanya ada hubungannya dengan Bencana Hitam lima ratus tahun yang lalu. Kita cuma belum tahu apakah itu sisa-sisa masa lalu, atau pertanda untuk hal yang akan terjadi lagi di masa depan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702704,
					"content": "Terima kasih karena sudah mengingatkan aku sampai mana batas manusia biasa, dan ... mengarahkanku untuk mencari makna kehidupan dalam waktu kita yang terbatas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702705,
					"content": "Waduh, kok Zhiqiong ngomongnya jadi penuh filsafat gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "Aku sendiri juga belum pernah mikir kepanjangan gitu loh, kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "Kamu sebagai seniorku sudah benar-benar banyak bantu ... Lihat, aku bikin peta saja harus minta tolong dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702708,
					"content": "Apa lagi kalau sudah menyangkut bahaya, senior berdua pasti jadi terlibat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702709,
					"content": "Aku cuma peduli pada keselamatanmu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Ah ... pasti, aku tidak akan menyerah. Aku akan istirahat sampai pulih total, terus lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702710,
					"content": "Tidak apa-apa, kuharap petamu bisa cepat selesai ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
			]
		},
