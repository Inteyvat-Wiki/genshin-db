			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Halo! Bagaimana perjalananmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Halo! Apa kabar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Berkat kesempatan yang kamu berikan tempo hari, dan karena kita berhasil mencampur bahan peledak, semua orang jadi lebih mau menerimaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Dan akhirnya aku bisa mulai pikirkan nantinya mau kerja apa. Tenang, harusnya sih tidak bakal jadi Treasure Hoarder lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "\"Harusnya\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Eh, \"pasti\". PASTI tidak bakal jadi Treasure Hoarder lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Dadah! Jaga diri ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Benar nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
