			"dialogs": [
				{
					"id": 766530201,
					"content": "Sebenarnya apa yang salah? Kalau cuma teori sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Tidak perlu konfirmasi pesanan ini ... Ginette, insinyur dari Fontaine ... pesanan ini paling menarik untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Akhirnya Anda datang! Kalau begitu masih ada harapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "Halo, kami adalah asisten Aino. Ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Dia mendesain robot yang bisa menggunakan kuuvahki untuk berkomunikasi jarak jauh, sangat menyenangkan! Tapi rusaknya terlalu banyak, jadi terpaksa mencariku untuk melakukan pemecahan masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Sungguh memalukan, aku hanya ingin mencoba dan penasaran, tidak mendapatkan hasil apa-apa. Pada akhirnya, aku harus mengandalkan praktik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Kedengarannya enggak sulit kok, serahkan saja sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Aku agak malu sih, tapi ... aku ingin mengubah isi pesananku. Sebelumnya — waktu menunggu jawaban, tidak ada hal lain yang bisa kulakukan, dan aku juga mengacaukan beberapa hal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Aku jadi penasaran, mungkin ganti lingkungan bisa menyelesaikan masalah ini, jadi aku cari beberapa area dengan kuuvahki yang berbeda untuk melakukan uji coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "Tapi robotnya malah rusak dan hilang kontak ... Jadi, selain menyelesaikan masalah yang sudah disepakati, mungkin juga bisa bantu aku cari kembali robot-robot itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Hilang semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Kalau ada biaya tambahan, aku akan cari cara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Hmm ... Ada banyak metode deteksi yang sesuai. Robot-robot itu digerakkan oleh kuuvahki, dan tempat mereka bergerak akan meninggalkan jejak kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Aku akan menyiapkan alat khusus untuk kalian. Kalian cuma perlu menggunakannya untuk mengumpulkan jejak kuuvahki yang cukup, dan aku bisa mendeteksi keberadaan robot yang sesuai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Hmm ... Sepertinya akan sangat menyenangkan. Karena itu, aku tidak akan meminta biaya tambahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Oh ya? Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}