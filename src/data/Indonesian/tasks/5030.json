						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "Ah, kalian. Senang melihat kalian baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Gimana kabar anakmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Entahlah. Komunikasi terputus, dan terlalu banyak korban luka yang harus diobati. Sekarang fokusnya ini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Tapi aku percaya padanya. Dia pasti bisa memutuskan yang terbaik dalam keadaan sesulit apa pun. Dia putraku, dialah kebanggaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
