			"dialogs": [
				{
					"id": 50300601,
					"content": "Aku bersyukur Mayahuel ada di sini. Berkat dia, kita jadi bisa menangani lebih banyak pasien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
