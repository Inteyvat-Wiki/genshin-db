					"content": "Oh, kalian berdua. Aku kira kita tidak akan pernah bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "Aku mengerahkan seluruh kemampuan dan kami menang. Meski harganya ... sangat mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "Kalian masih lanjut? Hati-hatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Bertempur melawan Abyss adalah kehormatan. Tapi kemenangan tidak diraih dalam kehormatan dan kejayaan, melainkan ketika kita berhasil bertahan hingga esok paginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
