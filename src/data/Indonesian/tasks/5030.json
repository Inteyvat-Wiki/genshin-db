					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Ya Archon, harus gimana lagi aku ini ... kurang orang, kurang barang, luka-luka ini setengahnya saja tidak bisa aku obati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Aku perlu tenaga ahli di sini ... TIDAK, jangan mikir begitu. Harus bisa, pokoknya HARUS bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Aku lihat kamu bawa Chuychu pulang ... turut berduka. Chuychu adalah dokter paling berbakat yang pernah aku kenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Kami rekanan bisnis. Dia selalu minta standar paling tinggi untuk keperluan medis, dan sering juga dia rela keluar duit pribadi demi menolong pasien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Dia bilang pengalaman lebih berharga daripada uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Katanya dia mau terus menempa ilmunya supaya bisa menolong lebih banyak orang, terutama satu orang yang paling ingin dia selamatkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Tapi pada akhirnya, dia tidak mampu menyelamatkan dirinya sendiri. Dan kini Natlan ... kehilangan salah satu generasi mudanya yang paling berbakat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
