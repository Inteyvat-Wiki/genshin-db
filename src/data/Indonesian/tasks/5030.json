					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "Cuma nepatin janji! Kan mau ketemu lagi di Stadion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Heh ... ini pertama kalinya aku menghabisi monster Abyss, dan aku tiba-tiba merasa ... kalau mereka tidak sekuat yang diceritakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "Aku terlalu lama tenggelam dalam ketakutan ... jadi kepikiran, kira-kira berapa nyawa yang selamat kalau saja aku memilih untuk berani ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "Jangan mulai mikir yang aneh-aneh. Sekarang ini prioritas kita adalah bertahan hidup, supaya kisah mereka yang telah gugur dapat diceritakan ke generasi penerus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Mereka hidup selamanya di dalam hati kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
