			"dialogs": [
				{
					"id": 50301501,
					"content": "Kalian baik-baik saja! Syukurlah, kami sudah cemas setengah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "Perjalanannya gimana? Aman damai sentosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Uh, tidak juga sih. Kami ketemu monster Abyss di jalan, dan harus bertarung mati-matian. Tapi benar ya, mereka ini bisa banget berguna di saat paling genting. Ilmunya seimbang sama pejuang yang terlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Hehe, badanku belum lupa caranya baku hantam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Aku beruntung bisa selamat. Kita harus bertahan, dan rebut kembali yang dirampas dari kita!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Kalian juga, tidak boleh gugur! Harus bertahan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
