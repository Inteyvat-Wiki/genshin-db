			},
			"dialogs": [
				{
					"id": 50301101,
					"content": "Oh, halo kalian! Terima kasih ya! Osawe, lihat siapa yang datang! Bilang \"makasih\" sama pahlawan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301102
					],
					"speakerTitle": "Iyoba"
				},
				{
					"id": 50301102,
					"content": "Makasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301103
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301103,
					"content": "Ah, enggak usah gitu juga. Kami senang kalian selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301104,
					"content": "Aku belum bilang makasih sama kakak-kakak lain yang nolongin kita juga. Itu loh, Fa-Fatolo—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301105
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301105,
					"content": "FATUI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "Ya, itu namanya! Fatui. Mereka juga hebat banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "Yah, jujur dulunya aku kurang suka sih sama Fatui, tapi peristiwa kali ini mengubah pandanganku. Orang baik ada di setiap organisasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
		},
