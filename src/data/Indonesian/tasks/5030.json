				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Kalian berdua! Terima kasih banyak untuk semua dukungannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Banyak orang Natlan melihat bertempur melawan Abyss sebagai suatu kehormatan, tapi lalu jadi lupa diri karena semangat dan akhirnya malah terjebak dalam situasi yang membahayakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Kalian benar, bertempur itu penting, tapi bertahan hidup lebih penting. Kita berjuang membela orang-orang yang terkasih, juga demi kesempatan untuk dapat bertemu lagi dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Aku menceritakan pandangan kalian ke rekan-rekan, dan mereka semua sama-sama ikut terinspirasi. Sekarang semuanya bertarung dengan tekad yang lebih kuat! Kami berhasil membalikkan situasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Jadi sekali lagi ... terima kasih banyak! Dari lubuk hatiku yang paling dalam!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
