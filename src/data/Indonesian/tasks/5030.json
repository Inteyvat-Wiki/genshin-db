						50301002
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301002,
					"content": "Baguslah, kamu selamat. Para Saurian yang nolongin kamu ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301003,
					"content": "Oh, mereka balik lagi ke alam liar, bantuin para pembawa pesan di lapangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301004
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301004,
					"content": "Aku tidak betah kayak gini, tidak bisa apa-apa, tidak bisa ambil bagian. Apalagi setelah tahu kondisi di luar sana seperti apa. Tapi ya, jadi manusia juga harus tahu batasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raman"
				}
			]
		},
