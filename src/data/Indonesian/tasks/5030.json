			"dialogs": [
				{
					"id": 50300301,
					"content": "Keadaannya gimana? Obat-obatan aman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Hampir habis. Masih ada persediaan darurat, tapi itu untuk dokter dan pejuang. Tidak boleh disentuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Aku tahu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
