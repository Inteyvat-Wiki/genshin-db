			"dialogs": [
				{
					"id": 726680101,
					"content": "Bagus sekali. Setidaknya harapan semua orang yang mencari \"Lunar Leviathan\" bisa dianggap sudah terwujud semua ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Sudah semua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Kamu lihat saja, si Jiawei bukannya sudah menemukan istri yang super kaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuck juga menjadi penulis buku terkenal karena buku \"Lunar Leviathan\" yang ditulisnya, walaupun isinya salah sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Dan Kujirai Momiji apa lagi. Dia sudah jadi nelayan wanita paling terkenal di Inazuma, dia bahkan melakukan sesuatu yang tidak bisa dilakukan ayahnya — menangkap \"Lunar Leviathan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Jadi Paimon rasa harapan {NICKNAME} juga akan terwujud! Hehehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Paimon tadi buat harapan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Rahasia dong! Kalau dikatakan keras-keras gitu nanti jadi tidak bisa terwujud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "Lunar Leviathan tidak akan sejahat itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Hmm— Oke, dengarkan baik-baik ya! Paimon cuma akan bilang sekali saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "Harapan Paimon adalah semoga harapanmu terwujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Suaramu terlalu kecil. Kamu bilang apa tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Hmph, Paimon tidak akan mengulanginya lagi! Paimon mau permen~ Lalala~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
