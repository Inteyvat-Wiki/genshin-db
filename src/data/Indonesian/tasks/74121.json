			"dialogs": [
				{
					"id": 741210101,
					"content": "Terima kasih! Terima kasih banyak! Kalian benar-benar penolongku! Aku akan mengingat jasa kalian selama-lamanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "Jangan bahas ini lagi deh, Paimon lebih penasaran kenapa kamu bisa sampai di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "*huff* Kepiting-kepiting ini pasti tertarik dengan aroma ayam panggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Paimon juga tertarik sama aromanya kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "Kamu kan beda sama kepiting! Coba lihat mereka, kayaknya mereka sedang pilih aku atau ayam panggang untuk jadi makanan pembuka. Tapi kalau mereka akhirnya pilih yang \"segar\" sih, ngeri juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "Masuk akal, memang yang segar lebih enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "Hei! Paimon kan lagi bahas soal Henri, bukan soal kepiting! Kalau orang normal mana mungkin mau dikubur di pasir, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "Jadi, kamu butuh bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Tentu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "Eh ... Maksudnya, tentu tidak perlu! Tidak usah gali aku keluar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Wow! Iya, iya! Sudah tahu! Tidak usah sekeras itu! Ya sudah, kita cabut deh, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "Eh, tunggu dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "Ya? Kenapa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Aku ... *uhuk* Begini ya. Tolong dengar baik-baik. Ini cara perawatan wajah yang baru ditemukan!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "Hei! Kan sudah dibilang! Enggak usah teriak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "Jangan ragu-ragu lagi! Aku adalah orang yang sempurna! Aku pilih teknik perawatan wajah yang sehat dan sesuai dengan ilmu pengetahuan!!! Makanya aku kubur diriku sendiri di pasir yang lembap ini dengan tanganku sendiri!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "Cepat pergi dari sini!!! Jangan sampai tutupi sinar matahariku!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Oke ... Jadi kita cabut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Tapi karena kalian penasaran!!! Apa boleh buat! Aku terpaksa harus jelaskan keajaiban dari perawatan muka seperti ini!!! Umm ... cacing dan hewan di tanah lainnya akan bisa membersihkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "#(Duh, keras banget suaranya. {NICKNAME}, dia kenapa sih? Tiba-tiba enggak jelas begitu ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "(Rasanya aneh sekali deh ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Iya? Kenapa tuh?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(Yuk kita lihat-lihat di sekitar dulu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "Eh? Kalian sudah mau pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Kami mau lihat-lihat sekitar dulu, nanti baru balik lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "Oke!!! Cepat pergi!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Aku malah lebih penasaran kenapa kamu terkubur di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "Iya tuh, perlu bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
