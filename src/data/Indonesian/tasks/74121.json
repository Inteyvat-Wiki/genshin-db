			"dialogs": [
				{
					"id": 741210601,
					"content": "Heh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210602,
					"content": "*huff* Tidak ada yang aku ... Ini perawatan muka terbaru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "Wah! Kapan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Kami sedang jalan-jalan ... Jalan-jalan itu ... sejenis olahraga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210605,
					"content": "Olahraga itu harus bergerak. Jadi kami digerakkan sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "Ini kerjaan kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Kalau iya memangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "Oh, Hunter! Aku sudah ingat, coba lihat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "Dia itu orang yang dimaksud atasan kita, jangan sampai berurusan sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "Tunggu. Kalian lagi ngomongin apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Tidak ada. Kami cuma sedang jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "Benar, kami cuma sedang jalan-jalan kok. Kalau tidak ada masalah lain, kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "Kami akan lanjut jalan-jalan ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "Tunggu. Kalian tidak perlu lakukan hal yang berbahaya kepadaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "Kan sudah dapat pelajaran, kamu ngerti maksudku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "Pelajaran apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Tidak apa-apa kok. Maksudku, memanggang ayam itu kan berbahaya, dan bisa mengakibatkan masalah. Ini saja sudah pelajaran berharga. Yuk pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "Tapi, ayam panggang itu kan ... Debord ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "Jangan bahas soal ayam panggang lagi! Kita harus lanjut jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "\"Lain kali biar Kak Sonny yang traktir kita makan ayam panggang.\"\\nSambil berkata, Turner berjalan pergi dengan Hunter.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Terima kasih! Terima kasih banyak! Aku tahu kalian pasti sudah mengerti maksudku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Sepertinya memang benar sama seperti yang dibilang {NICKNAME}. Ayo tolong Henri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "Tapi kalau mau gali kamu keluar pasti perlu banyak tenaga, jadi ayam panggangnya buat kami saja ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Ah? Ah? Sial ... Ya sudah deh! Aku terpaksa iyakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Butuh waktu yang lama bagi kalian untuk menggali Henri keluar dari pasir, dan mengeluarkan dia dari gentong.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Kamu dan Paimon mulai menikmati ayam panggangnya yang harum.\\nHenri sepertinya juga ingin makan, tapi dia tetap menjaga janjinya dengan seluruh kehormatan dirinya dan tidak berkata apa-apa.\\nTapi, setelah Paimon melihat Henri begitu menahan diri, Paimon jadi tidak tega dan menawarkan ayam panggangnya kepada Henri.\\nAyam panggangnya garing di luar dan memiliki wangi lemak yang menggoda sekali! Nom nom nom!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
