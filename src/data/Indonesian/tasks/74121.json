						],
						"pointId": 5746
					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "Heh. Jadi mereka bukan mau aku mati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "*huff* Tidak ada yang bisa dirahasiakan dari kalian. Benar sekali, aku yang merusakkan mesin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Tapi kenapa kamu rusak mesinnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Tentu saja karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Dulu, aku hidup miskin dan menderita sekali. Akhirnya, aku bertemu dengan kakak yang sangat baik. Dia memberikan minuman kesehatan yang bisa membuatku lebih bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Dia juga baik sekali sama aku, makanya aku ingin berterima kasih kepadanya. Akhirnya, kesempatan itu datang. Dia perkenalkan aku sama orang yang kelihatannya kaya sekali dan minta aku bantu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Kerjanya sih serabutan ya, misalnya koleksi komponen mesin dari Institut Penelitian Fontaine. Orang kaya itu berani bayar harga tinggi sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Kok keren amat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Benar, kan? Kali ini mereka juga minta aku cari mesin yang aneh, ambil intinya dan serahkan kepada mereka. Di satu sisi aku mau membalas kebaikan kakak, di sisi lain, ya demi uang. Tentu saja aku berusaha keras dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Tapi, orang-orang jahat itu ... Mungkin mereka cuma melihat aku bisa merubah nasib dan dapat uang banyak. Akhirnya mereka ganggu aku dan peringatkan aku supaya jangan serahkan komponen ini kepada bosku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Aku tidak mau dong! Aku kan sudah terima pekerjaan ini, dan sekarang aku mau protes dengan perlakuan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "Jadi hasilnya, seperti yang kalian lihat, aku dikasih pelajaran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh ... benar-benar kasihan deh. Tapi, kok pekerjaanmu ini kayaknya cuan banget sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Tentu saja. Makanya ini alasan aku tidak mau kasih tahu kalian kenapa aku protes. Tapi karena kalian sudah selamatkan nyawaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Kalau selamatkan nyawa sih berlebihan ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "Aku juga rasa tidak ada yang bisa disembunyikan dari kalian. Jadi mending langsung dikasih tahu saja. Anggap saja kita kerja sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Ada orang yang mendirikan mesin-mesin aneh di beberapa tempat di atas tanah dan di dalam air. Cara mengenalinya mudah sekali kok, di sekitar mesin itu selalu ada cahaya aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Tolong bereskan mesin-mesin itu dan berikan aku inti mesin yang ada di dalamnya. Totalnya ada <color=#00E1FFFF>7 buah</color>. Setelah semuanya beres, kita akan bagi setengah-setengah, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Lumayan tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Tapi mesinnya untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Bisa merusak lingkungan, ini mesin jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "Merusak lingkungan? Contohnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "Mana aku tahu? Kan aku bukan orang Institut Penelitian Fontaine. Lagi pula, memang sudah sering terjadi hal-hal aneh, makanya pasti bisa merusak lingkungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Yah ... masuk akal juga sih. Soalnya setiap kali ketemu tempat yang bau-bau gaib gitu, selalu ada masalah enggak lama kemudian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, kita bantu Henri saja yuk?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Haha. Ya sudah, berarti sepakat ya. Tolong <color=#00E1FFFF>bawakan tujuh inti</color>. Kita akan jadi kaya bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "Mesinnya untuk apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Aku mau 70%, tapi 20%-nya bayar di depan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "Duh ... Ya sudah deh. Tapi benar-benar tidak bisa dikasih dulu ke kamu. Aku masih harus tunggu barangnya lengkap dikumpulkan baru bisa hitung-hitungan dengan bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Tapi mesinnya untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
		},
