					"id": 400761601,
					"content": "Kita kembali ke sini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761602
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761602,
					"content": "Kayaknya cerita ini belum berakhir deh. Ayo kita lanjutkan petualangannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
