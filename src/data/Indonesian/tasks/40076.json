					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Wah! Kok, kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Rumah lain di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "Kita lagi ngapain di rumahku!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "Rumahmu? Ini rumahmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Oh, ini di luar dugaanku ... Aku pernah dengar kalau Nona Megistus hidup dengan sederhana, tapi rumah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Ada label di buku-buku yang tergeletak di lantai ini, tulisannya \"Barang langka, cuma 990.000 Mora saja ....\" Hei! Itu sih mahal dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Masih ada banyak buku mahal lainnya di sini ... Jadi ini ya kamarnya seorang ahli astrologi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Kamar ini didesain dengan sangat indah ... Tempat ini pastilah sangat mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Mona ternyata kaya ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Aku kan cuma bokek kadang-kadang saja, bukan artinya aku miskin sungguhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "Masa sih? Kan aku pernah mentraktirmu bersantap malam, bahkan mengajakmu makan malam juga di rumahku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Mein Fräulein, tolong jangan terlalu eksplisit begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "*uhuk* Kamu telah menerima berkah, mengikutiku untuk memberi hormat pada Kaiser der Verurteilung yang mengutuk kerajaan Immernachtreich, beraninya kamu melupakan hal sebesar itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "Oh iya, masakan rebus-rebusan dan potongan daging segar ibumu enak sekali! Hmm, aku jadi ingin makan itu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Nona Megistus, sekarang bukan waktunya untuk membahas hal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Makanan Mondstadt, ya? Kalau gitu sih aku juga mau! Dengar-dengar kan Mondstadt kan terkenal sama kuliner lezatnya, apalagi daging-dagingannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hmph, baiklah. Biar kuberi kehormatan padamu untuk bertemu dengan Ayahanda Raja dan Ibunda Ratu lain kali bersama Tuan Putri ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Asli? Hei {NICKNAME}, kita juga bakal ikut kan ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Oh ya, udah lama enggak berkunjung ke rumah teman, aku tidak akan menolaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Ugh ... kira-kira hadiah apa yang mau kita bawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Kalian berdua begitu bermurah hati. Namun kalian tidak perlu resah, pastikan saja kalian membawa diri kalian masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Kalian harus mencicipi masakan dagingnya. Setahuku itu adalah rahasia dapur keluarga mereka. Dan pastinya sih lezat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Meskipun begitu, sepertinya kita harus memecahkan teka-teki terlebih dulu? Sebenarnya, sejak aku masuk rumah hingga sekarang, aku agak terusik dengan dekorasi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "Ah, iya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "Ternyata selama ini aku keliru menilaimu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Kita balik ke tempat ini lagi. Jadi ... apa kali ini sudah beneran keluar dari alam fantasinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "Aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "Tidak ada petunjuk mengenai Fatui dan perangkat itu dalam alam fantasiku ... jangan-jangan, hal ini tidak berhubungan dengan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Atau mungkin alam fantasi ini bukannya bagian dari \"proses\", melainkan \"hasil\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Huh, gimana maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Dengan kata lain, alam fantasi-alam fantasi ini bukannya petunjuk yang bisa mengarahkan kita buat mengungkap teka-tekinya, tapi mereka ya cuma sebatas hasil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Seseorang melakukan sesuatu sehingga alam fantasi ini menjadi wujud nyata, tapi mereka hanyalah produk yang pasif, jadi mereka tidak bisa memberi tahu kita apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "Kalau gitu sih fantasi-fantasi itu cuma sesuatu tentang kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Materialisasi murni dari diri sendiri ... Hmmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Semuanya, mungkin kita harus kembali ke titik awal masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#Hari pertama mendarat di pulau, aku dan {NICKNAME} memeriksa kemah Fatui bersama. Ada perangkat aneh di sana, dan Fatui yang ada di sekitarnya tidak sadarkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "Para peneliti yang berbicara kepada kami mengklaim bahwa perangkat itu hanya penemuan industri Fatui. Mereka bahkan berjanji tidak akan mengganggu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Ya, pria gemuk yang pakai topi itu kelihatannya setengah ketiduran. Dia terus saja ngomong yang enggak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "Aku penasaran, mungkinkah \"kegilaan\" dan \"alam fantasi\" itu dua hasil berbeda yang disebabkan oleh pengaruh perangkat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Kemudian semua ini terkait dengan perangkat yang rusak. Perbedaannya bukan pada perangkat itu sendiri, tetapi orang-orang yang terpengaruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "Karena itu, mimpi dan ilusi sangat sulit untuk dibedakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "Jadi maksudmu, kita terpengaruh dengan cara yang berbeda karena kita berbeda dari mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Benar. Dan berdasarkan pengamatan beberapa hari ini, aku rasa ... Perbedaan antara kita dan mereka, adalah kita memiliki tekad yang lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "Hmmm, masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "Orang dengan tekad yang kuat tidak akan terjerumus dalam kegilaan, mereka hanya akan berhalusinasi. Sedangkan mereka dengan tekad yang lebih lemah, tidak dapat mempertahankan alam fantasi yang stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "Artinya kita harus langsung kembali ke kemah Fatui dan hancurkan perangkat itu sekarang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "Tidak, harusnya \"diperbaiki\" dan bukan \"dihancurkan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "Maksud Mein Fräulein adalah menghancurkan perangkat itu dengan gegabah mungkin bisa berakibat fatal, lebih baik cari solusi untuk memperbaikinya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Ya, lebih baik berhati-hati daripada menyesal nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Kalau tebakanku benar, perangkat itu mungkin akan memengaruhi otak manusia, kita harus hati-hati dalam menanganinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "Ayo kita pergi sekarang! Sudah tidak ada waktu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "Wah ... Pemandangan yang begitu luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Ini adalah bukti kuat kalau Anda memang benar seorang ahli astrologi yang jenius, Nona Megistus. Kamu benar-benar penyihir terbaik yang pernah ada di Immernachtreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Terima kasih, tapi sejarah Immernachtreich belum begitu tua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "Bintang seperti berlian yang bersinar dan bulan seperti mutiara. Ini adalah langit berbintang paling indah yang pernah aku lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "Sungguh indah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Mona pasti memiliki lautan bintang yang luas dan tidak terbatas di hatinya untuk memiliki alam fantasi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "Aku sedang berpikir, hal ini pasti adalah apa yang kita dambakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Langit ini sangat indah, bahkan bisa dibilang lebih indah dari langit yang biasa aku lihat melalui ramalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Setiap bintang ada di posisi yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "Sudah jelas ini pasti alam fantasiku. Hanya di sini aku bisa melihat pemandangan yang luar biasa seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Luar biasa? Kok kamu bisa ngomong seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "Apa kalian tahu? Langit Teyvat dipenuhi oleh bintang yang sangat indah. Semua jawaban seperti tersembunyi di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "\"Kapan putraku yang hilang akan ditemukan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "\"Apakah dia benar-benar mencintaiku?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "\"Apakah aku bisa sembuh?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "Apa pun yang terjadi, akan tercatat dalam lintasan bintang takdirmu. Di antara begitu banyak orang di dunia, akan ada sebagian yang keluar dari jalurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Saat bintang yang mewakilimu berada di orbit, berarti kamu selalu sehat, bahagia dan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Sebaliknya, jika bintangmu keluar dari orbit, semuanya akan menjadi buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "Itulah sebabnya langit berbintang dalam ramalan tidak akan pernah terlihat sempurna seperti ini. Beberapa bintang terkadang tersesat dan beberapa jatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "Aku ingin semuanya bahagia dan berharap semuanya tetap di jalur masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "Untuk itu, aku memberikan saran dan mengatakan yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Aku tahu ini tidak berguna, takdir manusia sudah ditetapkan di langit malam. Aku hanyalah satu di antara yang lain, tidak bisa mengubah apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Walaupun begitu ... di luar astrologi dan kata-kata kebenaran, aku tetap yakin ada secercah ilusi yang tidak nyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "Manusia harus hidup di jalan realitas, tapi ... terkadang aku terlalu tinggi menilai diriku, dan aku masih berharap dan percaya pada \"keajaiban\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "Di lautan bintang yang luas ini, ada bintang untuk kamu, aku, dia dan semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "Berapa peluang bintang bertemu satu sama lain? Apakah pertemuan-pertemuan ini merupakan keajaiban yang paling indah dalam takdir? Aku tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Tapi akan selalu ada kamu dan aku di langit berbintang Teyvat. Bahkan jika astrologi benar-benar rasional ... takdir tidak kekal, kejam, dan romantis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, sepertinya dulu kamu terus memikirkannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Apa sudah dapat jawabannya sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "Aku rasa, aku tahu apa yang bersembunyi dalam bintang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "\"Sekarang, aku akan menggenggam takdirku sendiri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
