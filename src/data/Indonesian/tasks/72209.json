				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Hari ini juga hari yang tenang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Ah, sudah datangkah kalian? Diriku tidur nyenyak sekali kemarin malam setelah kalian bersihkan kuilnya... miaw, miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Dua orang hijau itu datang lagi kemarin untuk berjalan santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Meskipun begitu, tidak ada manusia lain yang berdoa di kuil ini. Aneh sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "Tapi waktu dua manusia hijau itu datang, sepertinya mereka tertarik dengan rak kayu itu, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Diriku ingat Hibiki menyebutnya \"papan kayu doa\", dan raknya disebut \"rak kayu doa\". Sepertinya banyak orang yang datang demi kayu-kayu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Hmm... Apa ini berarti manusia menyukai kayu? Memang ada banyak pengunjung yang menyumbang Mora lalu menggantungkan papan kayu kecil itu ke rak kayu di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "Bukan suka dengan kayunya sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Begitukah? Apa karena mereka suka rak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Kenapa jadi suka raknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Bagaimanapun juga, rak kayunya sudah rusak dan papan kayunya sudah semakin sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Diriku tidak tahu apa yang manusia inginkan dengan kayu atau rak, tapi sebuah kuil harus punya semua itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Pasti tidak ada orang yang datang ke sini karena rak kayunya rusak, kayu di atas juga sudah tidak ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Maka itu, diriku harus meminta bantuanmu lagi ... untuk memperbaiki rak kayu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "Ya, serahkan saja pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Omong-omong, harusnya kita masih punya sisa kayu dari memperbaiki Kotak Uang itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Tentang hal seperti ini, diriku masih bingung... Kenapa manusia begitu suka dengan kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Uh, sudahlah lupakan saja... Paimon ingat kita masih punya sisa kayu. Ayo kita cari di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Bagaimanapun juga, diriku akan menyerahkan masalah rak kayu itu pada kalian. Kuil ini tidak bisa merawat dirinya sendiri kan, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Kalau kotak dan rak kayu itu sudah diperbaiki, harusnya orang yang datang ke sini bertambah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Sudah berapa lama rak kayu ini rusak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Lama sekali. Rak itu sudah rusak sebelum Kotak Uang itu, dan kotak itu sudah rusak sejak dahulu kala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Jadi kamu sama sekali tidak tahu kapan ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Hah. Diriku ini tidak memperhatikan berapa kali matahari terbit dan terbenam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Yah, seharusnya bahan yang kita pakai untuk memperbaiki Kotak Uang itu masih ada sisanya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Tentang hal seperti ini, diriku masih bingung... Kenapa manusia begitu suka dengan kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Uh, sudahlah lupakan saja... Paimon ingat kita masih punya sisa kayu. Ayo kita cari di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Bagaimanapun juga, diriku akan menyerahkan masalah rak kayu itu pada kalian. Kuil ini tidak bisa merawat dirinya sendiri kan, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "Sepertinya tidak ada hubungan dengan itu juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
