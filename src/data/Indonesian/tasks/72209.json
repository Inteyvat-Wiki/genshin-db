			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Miaw, miaw, miaw... Rak kayu itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "Sudah kuperbaiki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Oho! Benarkah? Ah, kuil ini sudah jadi semakin rapi sekarang! Miaw, miaw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Baiklah, sekarang tolong beri tahu dua manusia hijau itu kalau rak kayunya sudah diperbaiki, dan mereka bisa menggantungkan papan kayu mereka. Mereka juga bisa mengajak orang lain untuk datang, lalu memasukkan Mora ke kotaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Kenapa bukan kamu saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "Tidak! Ma-Manusia hijau tinggi itu menyeramkan. Di-Dia bisa membaca hati seekor kucing... Penyamaranku tidak berguna di hadapan matanya yang tajam! Miaw, miaw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Apalagi dia bersemangat sekali setiap kali bicara dengan diriku... Miaw, miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
