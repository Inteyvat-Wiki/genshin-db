			"dialogs": [
				{
					"id": 722090601,
					"content": "Diriku sudah melihat kalau dua manusia hijau itu sedang bersiap menggantungkan Papan Kayu Doa mereka. Kalian berdua memang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Baik, setelah mereka selesai, diriku akan memberi tahu manusia lainnya agar mereka semua datang ke kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Miaw, miaw, miaw... Sepertinya selain \"bersih-bersih\" dan memperbaiki kotak itu, rak kayu ini juga sama pentingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "Bagus, bagus sekali. Miaw miaw miaw! Kalau begini, kuil ini pasti akan ramai lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Kenapa kamu mau memperbaiki kuil ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Nyaa, miaw ... Kenapa ...? Tentu karena diriku adalah pengganti kepala pendeta. Sudah menjadi tugasku untuk merawat kuil ini, agar banyak orang yang datang untuk berdoa, dan membuat kuil ini tempat yang ramai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Selain itu, Hibiki pasti akan sedih kalau dia kembali dan melihat kuil ini rusak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Miaw, miaw, tapi dengan bantuanmu, kuil ini pasti akan segera kembali ke masa kejayaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Diriku mungkin masih membutuhkan bantuanmu dari waktu ke waktu. Jangan tolak diriku ya kalau waktunya tiba, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
