			"dialogs": [
				{
					"id": 722090201,
					"content": "Rak Kayu Doa itu sepertinya sudah rusak lama sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Sedang apa kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "Oh, halo, Pengembara. Nona Etsuko dan aku sedang menyelidiki area di sekitar kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Meskipun berbagai fasilitas kuil ini sudah hancur sejak dulu... tapi semuanya masih lengkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Para warga dari desa dekat sini pasti masih sering datang untuk berdoa. Kurasa kehancuran kuil ini ada hubungannya dengan Desa Koseki yang ditelantarkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
