				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "Kemampuanmu memperbaiki Rak Kayu Doa ini hebat juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Tapi Papan Kayu Doa-nya ... Tidak terbaca sama sekali. Sudah berapa lama sejak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Nona Etsuko! Aku menemukan beberapa balok kayu di dekat sini, dan aku mengukir Papan Kayu Doa untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Karena kalau Rak Kayu Doa-nya sudah diperbaiki, berarti butuh Papan Kayu Doa untuk digantungkan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Apa harapanmu, Nona Etsuko? Aku bisa menggambarnya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Menggantung Papan Kayu Doa di kuil ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Hehe, menarik sekali. Berikan aku satu Papan Kayu Doa itu, akan kugambar sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "Wah, sepertinya mereka mau menggantungkan Papan Kayu Doa mereka ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Ayo kita beri tahu Neko. Dia pasti senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "Yah, aku tahu satu dua hal saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
