					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "Apa? Kalian berhasil memecahkan segel Formasi Tujuh Bintang? Wah, peristiwa ini harus masuk laporan mingguanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Nulisnya yang bagus ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "*uhuk* Tolong ya, ini situasi yang serius loh. Serius banget malah. Tingkat keparahannya seperti apa, biar para Qixing yang tentukan sendiri nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Jadi nanti saat laporannya sudah terkirim, pasti akan ada orang dari Qixing yang bakal datang ke bawah sini untuk menghentikanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "Bahkan aku sendiri saja tidak akan bisa menyelamatkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Ini sih namanya \"kode yang terlalu jelas\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Kamu takut ya? Baiklah, ayo jalan! Masih ada orang yang menunggumu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
