				"points": []
			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "Bagaimana kondisi di bawah sana? Ada bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(Menjelaskan pengalamanmu kepada Muning)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Ternyata begitu, kedengarannya sangat berbahaya. Kalau begitu, mohon jaga Kak Jinwu dan Zhiqiong dengan baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Bukannya kamu harusnya menghentikan aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Tentu saja aku punya kewajiban untuk menghentikanmu. Cuma setiap kali kamu lari terlalu cepat jadi aku juga tidak sanggup menghentikanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "Perasaan aku lari juga tidak secepat itu ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Tidak, kamu memang sangat cepat larinya, begitulah yang tertulis di surat kabar. Itu fakta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Baiklah, lariku cepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Yup, jadi, harap berhati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "Lancar jaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Baiklah kalau begitu. Asal tidak ada masalah, Qixing pasti tidak akan menyalahkan aku juga kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
	]
