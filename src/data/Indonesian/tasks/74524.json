			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "Wah, ternyata si bocah ya? Kamu sudah tahu jadwalku hari ini dan sengaja datang ke sini untuk menemuiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Kamu baru saja ketemu dengan Shogun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Hehe, penciumanmu tajam juga. Aku hanya bawakan beberapa camilan manis dan novel ringan yang sedang populer untuk temanku yang tidak suka keluar rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Ei juga mulai mengikuti seri-seri terbaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Dia bilang sih, dia mau memahami perubahan gaya hidup dan kesukaan masyarakat Inazuma belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Tadi dia sempat diskusi denganku. Awalnya, dia sedang serius menganalisis preferensi pembaca berdasarkan isi ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "... Tapi tidak lama kemudian, dia tiba-tiba bertanya penasaran: \"Jadi, bagaimana akhir cerita karakter itu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Hehe, sepertinya bahkan Ei pun tidak bisa menahan diri dan jadi tertarik dengan cerita yang seru ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Ekspresimu tadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Oh? Jadi ini alasan sebenarnya kamu hari ini ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Oh, aku tahu deh. Kamu pasti sering kangen aku saat dalam perjalanan, makanya mau ambil beberapa foto untuk kenang-kenangan, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Kalau begitu silakan saja. Pastikan kamu memilih sudut yang pas ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "Sangat layak untuk diabadikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Aku mencium sesuatu yang manis ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
