			"dialogs": [
				{
					"id": 721380201,
					"content": "Ah, kamu datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380202,
					"content": "Apakah kamu sudah memetik tanaman obat yang kuminta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
			"id": 7213803,
