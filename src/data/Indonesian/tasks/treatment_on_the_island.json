			"dialogs": [
				{
					"id": 721380501,
					"content": "Fuh... Jantungku hampir copot, terima kasih kamu telah menolongku, aku tidak akan melupakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "Hal ini mungkin terlihat biasa saja, mahkluk yang sudah terpapar Tatarigami akan secara tidak sadar memancarkan daya tarik dengan aura negatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Karena resep obat ini mampu menyerap energi Tatarigami dalam jumlah besar, sudah sewajarnya mereka juga ikut tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Oh... jadi begitu, aku sudah paham cara memodifikasi metode racikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Hanya saja kegagalan sebelumnya menghabiskan sebagian bahan obat, jadi aku butuh bahan obat baru untuk melanjutkan percobaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Pada perjalanan berikutnya, harap {NICKNAME} lebih memperhatikan bahan obat pulau ini, letakkan saja dalam keranjang bambu di depan rumah pada pagi hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Aku pasti akan memberikanmu imbalan yang sesuai, tolong tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#Tidak apa-apa kalau {NICKNAME} sedang sibuk dengan urusan lain, nanti aku bisa minta bantuan orang lain untuk memetiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Kalau begitu sampai jumpa, Pengembara {NICKNAME}. Semoga perjalananmu lancar di Pulau Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Kami akan usahakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
