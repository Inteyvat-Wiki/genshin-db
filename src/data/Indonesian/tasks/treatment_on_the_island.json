						721380706
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380706,
					"content": "Mungkin butuh pengamatan lama untuk memutuskan apakah tanaman obat ini ada efek samping bagi tubuh, aku tidak tahu... Eh?",
					"roleType": "TALK_ROLE_NPC",
