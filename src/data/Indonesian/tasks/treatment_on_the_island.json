			"dialogs": [
				{
					"id": 721380401,
					"content": "#Terima kasih {NICKNAME}. Aku mohon maaf jika sudah merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380402,
					"content": "Tidak apa kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "Aku sudah membuat obat baru dengan tanaman obat yang kamu petik, hanya saja tidak ada target uji coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380405,
					"content": "#Karena itu apakah {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380406,
					"content": "Silakan katakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#{NICKNAME} bisakah aku mengetes efek obat padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380408,
					"content": "Obat baru masih belum stabil, saat ini tidak dapat memprediksi efek terburuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380409,
					"content": "Karena itu aku berharap ada orang yang menyaksikan keberhasilanku... atau membantuku membereskan akibat dari kegagalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380410,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "Jangan dipikirkan.",
