	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Wah! Bu-bukan aku pelakunya, aku cuma seorang dokter di daerah sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Kalau tidak percaya, aku bisa bawa kalian ke tempatku, ambil saja semua yang kalian butuhkan, tolong lepaskan aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Atau bawa saja aku menemui jenderal besar kalian! Dia mengenalku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Sepertinya kamu salah paham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Huh...? Kalian tidak terlihat seperti prajurit Shogunate... atau pasukan Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "Kalian... orang asing? Bagaimana bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Hmm... Apa pun itu, sebaiknya kalian cepat pergi dari sini. Pulau Yashiori sekarang sangat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Sampai saat ini, Tatarigami masih belum hilang, Tenryou Commission juga kelihatannya tidak akan menarik mundur pasukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "Pulau ini sudah tak nyaman untuk ditinggali, apalagi sebagai tujuan wisata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Kalau kamu orang asing yang kabur dari pengejaran Commission, sebaiknya pergi ke arah barat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "Tenryou Commission tidak menerima kehadiran pengungsi tanpa asal-usul yang jelas, tapi para bajak laut mungkin akan melepaskanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Apa yang terjadi di pulau ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Huh... lihat saja sendiri. Apa yang sudah diperbuat orang kota dan pasukan Sangonomiya itu kepada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Diawali oleh ledakan di Tatarasuna, langit malam itu jadi berwarna sangat aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Banyak kerabat kehilangan pekerjaan, tak ada makanan dan pakaian, orang-orang pulang ke rumah dengan penuh luka, suasananya sangat menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Dan juga banyak teman yang... tidak bisa melarikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Lalu, para pasukan dari Sangonomiya merusak jimat segel Serpent, mengakibatkan munculnya Tatarigami, sehingga orang-orang pun kabur menyelamatkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Penyakit aneh yang dibawa Tatarigami terus bermunculan, banyak para penduduk yang sakit keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Terlibat dalam konflik kedua kubu prajurit, ini hanya masalah waktu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Tempat apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Awalnya, ini adalah lokasi utama tempat produksi batu kristal yang dibutuhkan untuk \"Jade Steel\" Inazuma. Selama bijihnya masih ada, kami bisa hidup sejahtera tanpa terlalu banyak tekanan dari para petinggi di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Sekarang? Sudah tidak banyak orang yang tersisa di pulau ini... Maksudnya, \"orang\" sepertiku, yang masih bisa diajak bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Kenapa kamu tidak pergi saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Siapa juga yang tidak mau pergi? Anak Komisaris Tenryou Commission saja pernah mengundangku... dia harusnya masih memimpin para prajurit sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "\"Sebagai seorang dokter, kamu berbeda dari warga sipil, menetap di pulau ini sangat berbahaya, bekerjalah untukku di kemah prajurit, aku bisa merekomendasikanmu langsung ke ayahku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "Setidaknya itu kata-kata dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Sebelum perang, aku pernah mengobati Komisaris Pulau Narukami. Sungguh suatu kehormatan bagi seorang dokter desa seperti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Sekarang... coba pikirkanlah baik-baik. Tuan Komisaris pasti tidak mungkin kekurangan dokter, sedangkan Pulau Yashiori? Hanya aku sendiri yang merawat semua pasien di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Makanya aku tidak akan pergi, aku juga tidak mau bekerja khusus mengobati para prajurit saja. Musuhku hanyalah Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Ada yang perlu kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Tidak apa... Ugh, sudahlah, aku memang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Aku memerlukan tanaman obat spesial untuk membuat obat. Aku mencoba mengobati penyakit aneh yang disebabkan Tatarigami. Walau tidak tahu apakah akan efektif... tapi lebih baik mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Hanya saja... Tanaman obat itu dikotori oleh Tatarigami, dan sebagian besar ada di lingkungan yang berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Dipisahkan sungai dan laut, diikuti oleh monster di mana-mana, dan efek Tatarigami juga sangat terasa di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Dengan keberanian dan kemampuanku, sepertinya sulit mengatasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Lagi pula aku bukanlah dokter yang berani menempuh bahaya untuk mengumpulkan bahan obat, yang kugunakan hanyalah terapi pengobatan yang lambat... Sudah lama tidak bereksperimen resep obat baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "Orang asing, kulihat kamu membawa \"Wind Glider\", pasti kamu seorang pengembara yang berpengalaman. Bahaya semacam ini pasti bukan apa-apa buatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Jadi, kuharap kamu bisa menolongku mengumpulkan bahan obat di lokasi-lokasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Setelah berhasil mengumpulkannya, temui aku di sini. Jangan khawatir, aku pasti akan memberikanmu imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Meskipun kita tidak saling kenal, semoga kamu bisa mempertimbangkannya. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "Dan juga, berhati-hatilah di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Kamu terlihat putus asa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Panjang ceritanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Sungguh mencurigakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
