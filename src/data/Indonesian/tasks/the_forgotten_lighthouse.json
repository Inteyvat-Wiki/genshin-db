			"dialogs": [
				{
					"id": 762050101,
					"content": "Gimana ya ... harus gimana ini ... kalau dihitung waktunya, seharusnya sebentar lagi mereka datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "Paimon sudah datang! Eh, Nicole, jangan usir kami dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Aduh, aduh, maaf sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Masih belum siap ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Bagaimana ya menjelaskannya ... Aduh, sepertinya aku tidak bisa jelaskan dengan baik. Aku hanya bisa jelaskan semuanya dari awal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Semuanya dimulai dari saat para penyihir menantang Archon Anemo untuk pertama kalinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, itu sih jauh banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Huh, keterlaluan banget sih, harus aku bilang sendiri itu memalukan banget .... Sudahlah, tidak ada cara lain, fakta ya fakta ... asal Alice tidak tahu, aku harusnya tidak akan ditertawakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Kayaknya apa yang dia pikirin bocor lagi deh, dan ... memang bukan muncul dari \"mulut\" dia sendiri sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Ssst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Aku sementara menyembunyikan bulu itu di tempat paling tinggi di perpustakaan, berpikir kalau tingkat kesulitannya ditingkatkan, rasa pencapaian setelah menyelesaikan tantangan juga akan jadi lebih besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Tapi aku benar-benar tidak pandai mengendalikan angin bebas itu. Seolah-olah setelah mencapai ketinggian tertentu, bagaimanapun caranya aku tidak bisa terbang lebih tinggi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Enggak bisa pakai sihir buat ambil bulu-bulunya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "Kalau begitu, permainannya jadi tidak ada artinya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Betul juga sih ... kalau gitu buntu banget dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, bisa bilang sesuatu lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Bilang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "Di Simulanka, bahasa adalah sihir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Ah! Aku mengerti! Ayo kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Hmph, curang ah! Malu sekali kalau harus bilang sendiri ....",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Sudahlah, tidak ada cara lain, fakta ya fakta ....",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Asal Alice tidak tahu, aku harusnya tidak akan ditertawakan ....",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Mungkin kata-katamu bisa jadi tangga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
