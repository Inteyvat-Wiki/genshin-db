			"dialogs": [
				{
					"id": 762050201,
					"content": "Jaraknya jauh banget woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Semua makna adalah referensi, dan nama suci ditentukan. Kata-kata terjalin, dan semua utusan bersatu. Di kuil suci ini, biarlah dengan kata-kata kubangun tangga di hadapanmu.",
