			"dialogs": [
				{
					"id": 762050301,
					"content": "Dapat! Wah, seru banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Me-Meskipun sekarang kepala Paimon masih berdengung, kayaknya tadi ngomongnya kenceng banget buat bikin tangga tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Hmmm? Berani mengeluh? Kamu tidak takut penyihir hebat seperti aku akan mengubah semua isi peti harta menjadi wortel hanya dengan satu gerakan jariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "Pa-Paimon enggak maksud ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hehe, tentu saja, aku juga bercanda kok. Bagaimana mungkin aku menjadi malaikat pendiam yang mengingat semua detail dalam kehidupan sehari-hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#Pada hari penentuan itu, {NICKNAME} dan Paimon menaiki tangga tujuh tingkat. Yang menunggu di hadapan mereka adalah siluet seseorang yang familier di mata mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Cahaya berkumpul membentuk sayap di punggungnya. Sosoknya masih sama anggun dan cantiknya seperti saat pertama kali mereka bertemu, tetapi sepasang matanya memancarkan kilauan yang kejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#\"Kenapa?\", tanya {NICKNAME} dan Paimon secara bersamaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "\"Semuanya dimulai di hari Paimon mengeluh karena aku berteriak terlalu keras.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "Hei! Di sini kata-kata itu ada sihirnya lho, jangan bilang hal yang seram gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Sudah, sudah, Paimon cuma bercanda ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
