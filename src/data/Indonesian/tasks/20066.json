				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Duh... pusing sekali, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Aku berlatih untuk pemilihan Knights of Favonius berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "Uhhh, tapi biar bagaimanapun juga, aku tidak sekuat Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "Daripada kekuatan, kupikir berlatih teknik lebih cocok untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "Contohnya, aku berpikir bagaimana caranya untuk menghancurkan semua boneka kayu ini dengan satu serangan... Aku tahu mereka tidak begitu kokoh, tapi hanya ini yang kupunya. Ayahku mendapatkannya dengan susah payah jadi aku tidak boleh protes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "Jika kamu ada waktu, ayo pikirkan caranya bersamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "Biar aku pikirkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Tak masalah, pikirkan baik-baik, boneka kayu ini tidak akan ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Begitu pula dengan hidupku yang tidak akan ada kemajuan karena aku terjebak untuk menyelesaikan masalah ini, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "Dari jarak ini, mungkin solusi terbaik adalah berusaha mengatasi satu sisi lalu melemparkan bom ke sisi lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Hahaha aku bercanda, aku bahkan tidak tahu bagaimana cara mendapatkan bom tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "Ayo kita pikirkan bersama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Kamu suka bertarung dalam kelompok? Wah aku iri sekali... Alangkah baiknya memiliki orang yang dapat selalu membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "Orang sepertiku, hanya bisa belajar bertarung sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
