				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "Biasanya dia ada di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "Bocah, mau minta slip keberuntungan? Atau nengok teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "ASTAGA! Muncul dari mana woi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Lama tak jumpa, Nona Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "Wah nada bicaramu ramah sekali. Kamu mulai terdengar mirip seperti dia ... Tapi cukup basa-basinya, ada apa? Sepertinya ada urusan mendesak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Kami mau lacak orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "Masih ingat waktu aku diam-diam-tapi-tidak-sembunyi-sembunyi kasih tahu kalian lokasi praktiknya kemarin? Masa belum ketemu juga sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Tuh kan! Dia memang sengaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "Fokus dulu. Kalian di sini meminta pertolonganku. Jadi, bisa jelaskan dulu situasinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "Iya jadi ... kami datang ke tempat yang kamu bilang, tapi orangnya berhasil kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Terus tahu-tahu dia enggak praktik di situ lagi. Katanya sih lagi cari kedamaian dan ketenangan ... yah, entah harus ke mana lagi nyarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*huff* Padahal aku sudah susah payah kasih tahu lokasi yang kemarin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Entah ini bisa bantu apa enggak, tapi kami juga jadi tahu hal baru soal dia kemarin. Contohnya, ada orang yang ciri-cirinya sama kayak Emura Ichigensai pernah ikut terapinya Mizuki ... tapi namanya \"Emura Chuuya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Hah? Emura Chuuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "Kamu kenal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Aku pernah minta Yae Publishing House menggelar acara bagi para kontributor kolom surat pembaca. Harapannya, acara itu bisa jadi kesempatan yang menyenangkan untuk bertemu dan berbincang dengan orang-orang sepemikiran ... sampai akhirnya dia muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Apa berarti Emura si tukang bikin onar dan Emura si tabib ajaib itu orang yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Kalau dari info yang sudah kita pegang sekarang sih, kayaknya iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Oke. Kalau begitu ... coba alamat yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Eeeh ... serius? Orang sinting mana yang bikin rumah di tempat kayak gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "Ini alamat yang pernah dia kasih ke Yae Publishing House. Konteksnya, waktu itu dia pesan beberapa lusin buku sekaligus. Dan minta pembayarannya COD.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "Bagian gudang membaca suratnya, lalu langsung menyimpulkan kalau pengirimnya cuma orang iseng. Pesanan ditolak, dan hasilnya ... mereka ikut disebut di dalam surat keluhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Tentunya sekarang kita bisa menyimpulkan kenapa dia tinggal di tempat seperti itu. Pribadi yang antisosial begitu umumnya tidak diterima di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Benar juga sih ... yah, enggak salah kami minta petunjuk sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Aku senang bisa bantu teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Maksudnya Mizuki? Ternyata kamu memang niat nolongin dia ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "Aku tahu dia sudah setor banyak sekali ke Aisa Bathhouse. Wajar dong kalau aku prihatin lihat usaha temanku goyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Oh, gitu? Padahal kemarin kamu kayak datang nyari ribut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Mizuki pasti cerita kalau kami ini saingan, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Dia selalu beranggapan gitu, sejak kami masih jadi teman sekelas dulu. Sekarang aku sudah jadi Guuji di Kuil Agung Narukami, tentunya dia makin merasa perlu membuktikan diri lewat usahanya di Aisa Bathhouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "Dan tentunya dia akan sangat enggan bila si saingan datang dan menawarkan jalan keluar waktu situasinya sulit ... Makanya, kalau memang mau bantu, ya harus hati-hati juga biar orangnya tidak tersinggung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "Tumben banget kamu peduli sama begituan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Yang barusan aku anggap pujian deh. Mizuki itu selalu peduli dengan perasaan orang, sekali-kali gantian lah dia yang dihargai dan dijaga perasaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Nah, berhubung posisimu sulit ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "Bagus sekali, kamu mengerti maksudku. Nah, meskipun aku yakin kamu ingin mengobrol lebih lama, sepertinya kamu sangat terburu-buru saat datang tadi. Kamu tidak buru-buru pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "Waduh, iya juga. Buruan, kasih kabar ke Mizuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "Gimana kalau aku saja yang turun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Kamu tahu di mana Emura Ichigensai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
