			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Hari ini aku melaut, tapi karena bengong, jaringnya hilang ... Ah sudahlah, bukan hal penting kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Iya, aku juga ... tapi sudahlah, bukan hal penting kan? Cuma beberapa bandit yang kabur, bukan kiamat juga kan, hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Hei, kalian berdua! Murasaki dan Shion sakit gara-gara mimpi buruk kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Wah, ada yang kesal nih. Kenapa tuh? Haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Iya, kenapa tuh? Hehehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "Kenapa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "Ih mereka kok aneh gitu! Padahal tadi Paimon sudah agresif banget, tapi mereka enggak kesinggung sama sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "Biar aku saja. Tuan-tuan yang terhormat, apa kalian masih ingat semalam pergi ke Aisa Bathhouse untuk terapi mimpi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Masa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "Iya gitu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Hm ... Apa kalian mimpi buruk belakangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "Tidak ah. Memangnya dunia ini sengeri apa sih sampai harus mimpi buruk segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Hmm ... enggak ah. Mimpi buruk itu kan jarang terjadi. Dunia seindah ini, hidup senyaman ini, mau mimpi apa coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "Ada apa nih? Kok mereka kayak yang lupa gitu habis ngapain semalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Paimon sih percaya apa kata mereka. Toh mereka juga kelihatannya enggak terganggu sama mimpi buruk ... Tapi itu artinya metode si Emura Ichigensai beneran tokcer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#Tidak, ini sangat tidak wajar ... {NICKNAME}, Paimon, coba fokus dulu. Aku mau coba sesuatu yang tidak biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Wow, kamu ngapain ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Aku mau masuk ke alam bawah sadar mereka. Aku menyadari kalau kesadaran mereka berdua ini sudah terpisah, yang artinya aku bisa masuk. Sama seperti ke dalam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "Tidaaak! Bajingan, penjahat! Tidak boleh lepas! Tidak boleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida Yang Mengamuk"
				},
				{
					"id": 120460321,
					"content": "Lautnya cukup ganas hari ini ... Aku di sini dulu saja sampai lautnya tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko Yang Ketakutan"
				},
				{
					"id": 120460322,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Lihat kan? Masalahnya masih ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Susukida sepertinya punya sumbu pendek, yang mengakibatkan dia bertindak kelewatan. Aku yakin hal ini sering menyebabkan pergumulan dalam pekerjaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "Sedangkan Umihiko ... sejak dia hampir mati di laut, dia jadi takut pada ombak badai. Sekarang dia sangat takut melaut, dan itu berdampak besar pada penghasilannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Emosi negatif mereka sudah terisolasi dari pikiran mereka dan mengambang di alam bawah sadar. Karenanya, kalau dilihat dari luar, mereka kelihatannya senang-senang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Tapi emosi yang ditekan begitu akan terus bergejolak dari alam bawah sadar, dan akhirnya berubah menjadi mimpi buruk yang tidak bisa dicerna oleh Murasaki dan Shion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "Kenapa bisa begini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "Kalau pun ini ulah Emura Ichigensai, kurasa dia bukan sekadar penipu. Mungkin dia memang bisa memengaruhi emosi manusia. Makanya belum ada seorang pun korbannya yang sadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "Ada yang aneh tidak waktu terakhir kali ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Enggak tuh. Kemarin mereka jauh lebih serius daripada sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Eh, berhubung kamu nanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Kamu mengingat mimpi aneh kemarin malam dan menyampaikannya pada Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "Kenapa baru ngomong sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "Soalnya kirain bukan apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "Wah, wah wah ... Oke, kita harus temukan si Emura Ichigensai itu sekarang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki ... Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "#Ada sesuatu yang tak lazim dengan Emura Ichigensai. Mimpi {NICKNAME} buktinya ... semua yang datang konsultasi ke tempatnya sudah jadi korban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Kalau kita tidak menemukan dan menghentikannya sesegera mungkin, mental korban akan rusak parah dan tidak bisa pulih lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Ihhh ... baiklah, kita cecar saja dua orang ini. Eh, kalian! Tahu enggak kapan si Emura Ichigensai bakal balik lagi ke sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "Kenapa buru-buru gitu? Memangnya kenapa kalau dia balik lagi sekarang, atau nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Ya, dia akan datang sendiri kalau sudah siap. Buat apa diburu-buru, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Uhh, NYEBELIN BANGET!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "Kalian berdua jelas ingat kejadian semalam. Sangat ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Hanya saja, kalian tidak ingin membicarakannya, karena dalam kondisi sekarang mental \"gembira\" kalian tidak bisa memahami konsep mimpi buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Baru memikirkannya saja sudah bisa mencabik mental. Kalian tidak bisa mengutarakannya dengan kata-kata, tapi rasanya sedikit lagi saja kalian akan hancur berkeping-keping ... betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "Hentikan. Semua akan baik-baik saja selama tidak dipikirkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "Pengobatan Emura Ichigensai telah membuat kalian lemah dan terluka. Tapi jangan takut, aku akan mengeluarkan kalian dari kondisi penyangkalan diri yang tidak benar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "Asalkan semua pertanyaanku bisa kalian jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Baiklah ... tapi sungguh, kami tidak tahu apa-apa. Kami sudah tanya, dan jawabannya cuma bahwa hari ini dia tidak akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Iya, ah ... sesi kemarin cukup membuat dirinya ... lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Kabur lagi dari aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "Mereka betulan enggak tahu apa-apa? Sial. Kayaknya buntu nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "Jadi kurasa kalian juga tidak tahu ya dia tinggal di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "Enggak. Kami sudah tanya, tapi penjaganya saja enggak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "Kalau gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Sudah tahu apa yang dicari di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Kayaknya bisa ... Karena sekarang aku sudah tahu alasan mereka mimpi buruk. Bisa diobati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Kita mulai dari sana deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "Jujur, kalian sudah memberi andil besar dengan membawaku kemari. Jangan repot-repot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "Eh, kami masih mau ikutan sesi terapi lagi! Semakin cepat kamu bebas dari masalah Emura Ichigensai, semakin cepat juga kami bisa puas terapi sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "Jadi, kami enggak akan mundur sampai ini semua selesai dan pemandian air panasnya bisa berjalan normal seperti biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "Sepertinya tidak ada pilihan selain menerima bantuan kalian lagi. Aku harus memastikan bahwa Murasaki dan Shion segera mendapatkan pertolongan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Tapi aku tetap perlu kerja sama kalian. Kalau Emura Ichigensai sudah ketemu, tolong jangan langsung mendekatinya. Langsung kabari aku dan awasi dia sampai aku tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "Aku tidak ingin kalian dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Ah, itu sih buat apa dipikirin! Kalau kamu tahu penjahat macam apa saja yang sudah kami jadiin perkedel, ha! Yang ginian sih ikan teri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "Iya deh iya. Kami bakal jaga jarak dan langsung ngabarin kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Bagus. Ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "Kamu berani banget ngomong mau ngelacak orang ini. Ya bagus sih kamu mau bantu Mizuki, tapi ... sekarang gimana? Gimana kalau kita enggak bisa nemuin dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Enggak lupa kan? Dua orang ini enggak guna! Enggak tahu apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Iya, mereka enggak tahu apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Miko? Tunggu, iya juga ... dia yang ngasih tahu kita soal tempat ini kemarin! Mungkin dia tahu lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "Jangan buang waktu lagi! Ke Kuil Agung Narukami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Tapi aku curiga Miko tahu sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Biar aku yang melacak Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Sudah bisa bantuin Murasaki dan Shion sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
