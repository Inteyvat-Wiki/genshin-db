			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, kami mau bikin janji buat terapi berikutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460203,
					"content": "Agh ... sakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120460204,
					"content": "Aduh ... Mereka kenapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "Mereka sudah begitu sejak bangun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "Sepertinya ini gangguan pencernaan yang cukup parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "Hah? Kok bisa? Apa mereka kebanyakan makan mimpi buruk semalam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "Sepertinya bukan ... Kemarin cuma ada empat pelanggan, termasuk kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "Paimon yakin ini salah si dua orang kemarin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "Benar. Ada yang salah dengan mimpi buruknya mereka ... Kemampuan kami mencerna mimpi bukan cuma soal jumlahnya. Tapi tergantung sama intensitas emosionalnya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Intinya, tidak seharusnya orang normal punya mimpi buruk sampai segini parahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "*hoek*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460213,
					"content": "Situasinya cukup parah. Kalau aku tidak bisa cari cara untuk bantu mereka mencerna mimpi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "Kami bisa bantu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "Cari dua pasien kemarin, terus telusuri apa penyebab mimpi buruknya. Kalau tidak, aku juga tidak bisa mengobati ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, aku tahu kalian pernah bicara dengan mereka berdua. Apa mungkin bisa dilacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "Coba ya ... Hmm, memang sih mereka bilang mau konseling lagi ke si Emura Ichigensai. Kayaknya kita bisa ketemu mereka di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Tunjukkan jalannya. Aku ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
