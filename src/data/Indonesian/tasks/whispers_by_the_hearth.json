			"dialogs": [
				{
					"id": 742500201,
					"content": "Terima kasih atas jamuannya, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500204,
					"content": "Baiklah, sampai ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
