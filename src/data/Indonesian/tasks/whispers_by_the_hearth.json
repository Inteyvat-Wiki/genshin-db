			"dialogs": [
				{
					"id": 742500101,
					"content": "Sekarang setelah pikir-pikir lagi, aku tidak jadi tuan rumah yang baik waktu kalian berkunjung ke Snezhnaya sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500102,
					"content": "Tidak perlu begitu, Nona Sandrone. Meskipun kita tidak pernah ngobrol, kamu selalu sediakan hidangan terbaik untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*huff* Maaf ya. Waktu itu aku terlalu sibuk. Lain kali kalau berkunjung, aku pasti akan sambut dengan lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500104,
					"content": "Dulu kamu juga tidak pernah izinkan aku mencoba penemuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Kalau soal itu, ada alasan yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500106,
					"content": "Hmph ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Sebenarnya, Ayah sudah suruh kami tidak ganggu kamu sebisa mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Jangan khawatir, aku tidak keberatan kok kalau diganggu sesekali. Kalian bisa datang minum teh kapan pun kalian mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500109,
					"content": "Oh ya? Sebenarnya ... aku selalu ingin minta kamu memeriksa Pers ... Aku punya ide perbaikan yang mau didiskusikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Tentu saja, itu kan bidang keahlianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500111,
					"content": "... Terima kasih, Nona Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Apa menjadi Harbinger benar-benar sesulit itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Kalau dipikir lagi ... memang sedikit. Ada banyak hal yang harus dipertimbangkan. Meskipun begitu, sebagian besar kesulitan yang kualami datang dari rekan-rekanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500114,
					"content": "Jadi artinya ... bergaul dengan orang lain itu keterampilan wajib?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "Mungkin begitu ... Tapi aku rasa kamu tidak perlu memusingkan masalah itu. Setidaknya, Lyney pasti tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500116,
					"content": "Haha, kamu terlalu memuji, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Kamu mau jadi Harbinger? Ah, lupakan saja, bukan urusanku tanya-tanya soal itu. Anggap saja aku tidak berkata apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500118,
					"content": "Hmm ... Masih terlalu jauh bagiku. Aku tidak perlu buru-buru pikirkan soal itu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Kalau kamu jadi Harbinger, berarti kamu tidak punya waktu untuk temani kami dalam misi lagi dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "Kalau begitu ... berarti ... Lynette dan aku juga harus jadi Harbinger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "Sudah kubilang, tidak usah dipikirkan sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Lagian, ke mana pun aku pergi, aku tidak akan pernah tinggalkan kalian berdua. Aku janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah ... Kadang-kadang aku iri dengan keluarga kecil kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
