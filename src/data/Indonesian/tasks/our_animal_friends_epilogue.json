			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, aku dengar kamu sudah temukan semua hewan yang diberi alat pelacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "Ini ... mengejutkan sekali. Karena beberapa dari hewan tersebut sangat sensitif, bisa langsung lari begitu lihat sosok tak dikenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "Tapi mereka tidak menjauh dari kamu. Menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "Yah, karena aku sobat semua makhluk berbulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "Haha, luar biasa sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "Aku pernah digerami, bahkan sampai digigit berapa kali waktu mau kasih makan. Padahal sudah ditemani staf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "Nih, bekasnya ... sakit pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "Tapi biar pun mereka tidak suka sama aku, yang penting hidupnya tenang lah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "Sama dengan para pecinta hewan. Semua orang cuma mau melindungi habitat hewan-hewan supaya tidak terganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "Aku tahu petualang biasa melihat hewan liar sebagai makanan, tapi kami juga tidak melarang para anggota Barisan Cakar untuk berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "Tapi ya, jangan sampai ada pembantaian membabi buta juga. Kalau semua orang sepemikiran, aku yakin lingkungan kita akan jadi lebih indah dan kaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "#Sebagai salah satu anggota, aku senang kalau {NICKNAME} juga mau menganut prinsip yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "Tentunya dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "Aku sudah tahu orang seperti dirimu pasti setuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "Kalau orang bisa sudah bisa berpikir seperti itu, maka kami sudah berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "Kalau ada kesempatan, silakan ikut lagi di acara Barisan Cakar berikutnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "Yah, semoga luka gigitan dan cakaran di lenganku ini tidak nambah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "Aku pertimbangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "Tidak apa, toh kami juga tidak memaksa. Tapi tolong pertimbangkan lagi ketika hendak mengakhiri nyawa hewan tak berdosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "Bakat alamiah petualang ya gini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
