				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Lanjutkan kerja bagusmu, Connor. Kita pasti bisa merekrut Diona sebagai bartender tetap di Dawn Winery!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Aku juga berharap begitu. Aku sudah berjongkok selama berminggu-minggu demi kesempatan ini... Tidak boleh sampai terlewatkan sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Kerjamu kali ini benar-benar bagus, Connor. Asalkan kita bisa membuat Diona bekerja di sini, semua kerja keras kita akan terbayarkan. Ini baru langkah pertama saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Ingat ya, Diona harus melihat ketulusan hati dan semangat kita! Lalu ingat juga, jangan sampai berlebihan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Tenang saja. Kita sudah latihan berkali-kali, Elzer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "Kalian sedang membicarakan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Eh?! Oh, hehe... tidak kok. Kita hanya sedang membicarakan tentang bisnis Dawn Winery, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "I—Iya, kita hanya membicarakan bisnis. Ayo kita bahas lagi tentang pengeluaran Dawn Winery belakangan ini, Elzer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
