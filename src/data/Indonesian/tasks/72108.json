				},
				{
					"id": 721080932,
					"content": "Gara-gara itu aku disegel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Seratus tahun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Ugh! Berhentilah mengejekku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Sudahlah. Sudah jadi masa lalu. Aku juga punya beberapa ide tentang penghalang di dekat hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Dulu waktu aku melawan kitsune licik itu, aku pernah melihatnya di pantai timur. Sepertinya Thunder Sakura tapi ada gerbang torii nya, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Dulu saat orang itu melawan iblis, aku khawatir beberapa iblis akan keluar untuk menyakiti kami, jadi aku menggunakan sihir untuk menyegel tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Coba kulihat, Kichiboushi disegel di bawah jurang di sisi timur. Pergilah ke sana dan bantu lepaskan segelnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Terima kasih, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Oke, jangan banyak bicara lagi. Cepat pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Kalau kamu bertemu dengan kitsune licik itu, ingat sampaikan salamku ya. Bilang saja... coba kupikirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "Sialan kamu, aku kesal sekali. Kembali dan lawan aku! Kita masih punya urusan yang harus diselesaikan! Dan bantu aku buka segelnya selagi kamu melakukannya! Benar, bukan karena aku tidak bisa melakukannya sendiri, melainkan kamu masih berutang budi padaku! Gyoubu Koban bilang dia merindukanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Terlalu banyak yang harus diingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "Seribu tahun?",
