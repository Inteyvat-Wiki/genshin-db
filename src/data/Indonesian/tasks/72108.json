			"dialogs": [
				{
					"id": 721080931,
					"content": "Apa? Aku tidak menyadari benda itu begitu penting. Seharusnya kamu bilang dari awal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
