			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Hehe, bagus! Sepertinya mereka cukup senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "...Eh? Oh, tidak masalah. Coba aku tanyakan mereka untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban tanya, \"berhubung kamu kan manusia, tapi kok baumu seperti tanuki ya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "...Benar juga! Sebaiknya kamu jelaskan padaku! Kenapa baumu seperti tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "Eh? Lama sekali kamu baru bertanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "Miko bertopeng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "Benar! Itulah yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "Sebelumnya miko bertopeng memberi kami makanan yang sangat mewah terus bilang dia pakai sihir dari bake-danuki yang dia pelajari secara diam-diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "Apa? Berani-beraninya dia mempelajari sihir kami secara diam-diam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Hmmm, apakah mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "Kitsune yang licik itu. Kalau dia masih hidup, seharusnya dari awal dia sudah datang menyapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "Dia itu miko bertopeng. Katanya kamu adalah teman lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "Topeng? Aku tidak tahu topeng apa pun, dan aku pun tidak tahu miko mana pun. Aku cuma tahu kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "Ngomong-ngomong, kitsune licik itu pernah muncul dalam wujud miko deh. Memangnya dia terlihat seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Dia pakai topeng kitsune putih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "Ada lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Rambut hitam pendek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Pakai baju miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Hmm... tidak kenal ah. Belum pernah lihat orang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "Benaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "...Eh? Ya, oke, serahkan padaku deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei bilang \"menyenangkan sekali bermain denganmu, terima kasih!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "Paimon juga sangat senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Tentang sisir itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Aku ini bake-danuki Ioroi yang terkenal di dunia. Tentu saja aku akan menepati janjiku. Kamu boleh memiliki sisirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Tapi, kamu mau apa dengan sisir itu? Baunya mungkin seperti kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Jadi begini nih yang terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
