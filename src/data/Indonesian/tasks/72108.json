			"dialogs": [
				{
					"id": 721080101,
					"content": "Akhirnya sampai juga. Di sini pasti Chinju Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "Miko bertopeng itu bilang kalau dia ada teman lama di dalam Chinju Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "Kalau begitu, ayo kita cepat masuk ke dalam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
