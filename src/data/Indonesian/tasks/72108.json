			"dialogs": [
				{
					"id": 721080801,
					"content": "Ooh... aku mau garuk-garuk perutku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "Hmm? Kenapa kamu kembali? Cari <color=#00E1FFFF>tiga tanuki</color> — Shousei, Gyoubu Koban dan Kichiboushi serta bermainlah dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080803,
					"content": "Pergilah sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210807",
