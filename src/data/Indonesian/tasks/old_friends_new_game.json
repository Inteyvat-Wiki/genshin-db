			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#{NICKNAME} si Komet Emas dan Paimon si Bintang Kejora ... Kita ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Tetap penuh semangat, seperti biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Kamu juga semangat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "Ha-Haniyyah! Dan Pak Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Kebetulan banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Ngomong-ngomong, kalian berdua lagi ngapain di sini? Paimon ingat di sini dulunya kios Floral Jelly ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "Ah, ada pahlawan kita, dua-duanya pula! Dengar suara kalian saja sudah bikin aku makin pede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Baiklah. Sekarang saatnya laporan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "Sebelumnya, kalian memutuskan untuk menunda Turnamen Piala Nilotpala untuk Pawang Penjinak supaya Akademiya punya waktu untuk mengembangkan Wisdom Orb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Kalian berdua ingin tahu bagaimana kelanjutannya, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Betul! Layla, Cyno, atau peneliti yang bertanggung jawab yang akan kasih kabar kalau ada perkembangan soal itu, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Si Paimon sih dikasih tahu juga enggak bakalan ngerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Yah, jujurnya sih iya. Kami belum tentu bisa bantu. Yang ada malah ngeganggu ya, kayaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Kalian benar-benar sabar dan hati-hati. Aku sendiri langsung deg-degan dan tegang kalau ingat lagi kejadian di turnamen itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Karena itu, beberapa waktu lalu aku tanyakan beberapa orang dari Akademiya mengenai perkembangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Untuk saat ini, Wisdom Orb masih dalam tahap pembuktian teori. Dengan kata lain, masih perlu waktu lama sampai bisa diproduksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Tapi diskusi mengenai turnamen yang pertama sudah mereda, dan perlahan-lahan dilupakan. Kita tidak boleh menyia-nyiakan publisitas dari acara tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Karena itu, aku memutuskan untuk bikin suatu \"Kegiatan Bertema\" bareng Nona Haniyyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "\"Kegiatan Bertema\"? Apaan lagi itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Oh, jadi itu gunanya bidak jamur yang di meja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Pak Balfour lagi cari sponsor untuk mengadakan turnamen berikutnya. Dia bahkan pergi ke Liyue untuk belajar marketing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Saat belajar di sana, dia jadi tahu satu permainan yang bernama \"Theater Mechanicus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Jadi dia membeli hak waralaba untuk permainan itu di Sumeru, lalu mengembangkan permainan baru dengan aku sebagai konsultannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Kami kasih nama: \"Fungus Mechanicus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Fungus Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Biar Paimon tebak ... ini mainnya Fungus diadu sama robot, betul gak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Haha! Bintang Kejora memang hebat! Sekali tebak langsung benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Menurutku permainan ini selain mudah dimengerti dan dipromosikan, ada potensi besar untuk dikembangkan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Kalau kita berhasil pasarkan permainan ini sebagai turunan dari Turnamen Pawang Penjinak, orang-orang bakal ingat lebih lama lagi sama turnamen itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Dengan cara ini, kita bisa menarik perhatian lebih banyak penonton dan peserta saat turnamen berikutnya diadakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Tentu saja, ini hanya bisa dilakukan dengan persetujuanmu. Soalnya kamu yang berhak menentukan semuanya tentang turnamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Boleh. Coba saja dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Hmm, Paimon dan {NICKNAME} enggak ngerti sih soal bisnis, tapi kayaknya omongan Pak Balfour oke juga tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Bapak dan Haniyyah sudah kerja keras untuk ini, dan Paimon percaya sama kalian. Gaskaaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Kami memang belom nyobain, tapi Paimon yakin nantinya banyak yang suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Bagus! Karena kalian sudah setuju, aku akan langsung mempromosikan Fungus Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Permainan ini masih dalam tahap pengujian. Kita harus panggil orang untuk coba mainkan dan minta masukan dari mereka, lalu bikin perbaikan yang perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Dan aku yakin orang yang sudah keliling Teyvat dan menjajal segala macam permainan yang seru, pasti punya masukan paling keren dari semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Hehe, kalau begitu ayo, {NICKNAME}! Kamu kan jagonya yang beginian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Aneh, rasanya kayak disuruh separo dipaksa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Hehehe! Tapi Haniyyah, Paimon mau nanya dikit dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Mau tanya kabar si Topi Gendang sama yang lainnya, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Betul! Paimon kangen banget sama para sobat jamur. Sekarang mereka gimana keadaannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Tenang, mereka semua sehat dan bersenang-senang tiap hari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Si Putar-Puter dan Tukang Samber sekarang ada di <color=#00E1FFFF>rumah sementaraku di sebelah utara Pelabuhan Ormos</color>. Salah satu peserta turnamen sebelumnya yang menjaga mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Topi Gendang dan Pyro Sukacita ada di dekat sini. Bintang Kejora, kamu boleh main sama mereka kalau mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Di dekat sini?! Ihh, asyik! {NICKNAME}, kamu cobain permainannya, Paimon main sama Topi Gendang! Oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Hush hush, pergi sana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Baiklah, cukup basa-basinya. Ayo, Komet Emas, saatnya main Fungus Mechanicus versi uji coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Nanti aku nyusul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Ahsyiap! Komet Emas, maju, jalan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Kalian mati-matian banget ngusahain ini ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Aku tidak tahu mau kasih masukan kayak mana juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Eh, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}! Kok ngelantur sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Dulu kita sama-sama ikutan Turnamen Piala Nilotpala loh, masa lupa? Ingat-ingat coba serunya main sama teman Fungus kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Kita kenal sama Haniyyah di sana, terus Pak Balfour itu anggota staff turnamen yang paling bertanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Tunggu, apa jangan-jangan kamu juga sudah lupa sama si Topi Gendang dan Putar-Puter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Ooh, ingat, ingat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Tuh kan! Paimon sudah mau cariin kamu dokter syaraf loh!",
