				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Bagaimana, Komet Emas? Apa kesanmu bermain Fungus Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Kalau lihat dari raut wajahmu, kurasa kamu belum ada komentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Baru main sekali doang sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Betul. Kurasa memang susah untuk menilai kelebihan dan kekurangan Fungus Mechanicus kalau hanya dengan konten percobaan yang cuma sedikit ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Jangan khawatir, aku dan Nona Haniyyah akan tinggal di sini untuk sementara. Kami akan menyiapkan satu stage Fungus Mechanicus baru setiap harinya. Totalnya ada tujuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Datang saja kapan pun kamu senggang, nanti kamu boleh menjajal semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Kamu memang bertindak sebagai pengawas dan pengambil keputusan akhirnya, tapi permainan ini adalah buah pikiran Nona Haniyyah dan aku. Waktu yang dihabiskan di sini sebenarnya bukan kewajibanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "Karena itu, kami akan bayar setimpal dengan usaha yang kamu keluarkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, baiklah. Aku enggak nolak deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Haha! Tidak pakai basa-basi, ya. Aku suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "Aku sudah mengajukan izin tinggal yang cukup lama untuk dua teman Fungus kita, jadi mereka akan ada di Pelabuhan Ormos selama tahap pengujian Fungus Mechanicus berlangsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Bintang Kejora juga bisa main lebih lama sama si Topi Gendang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Senang deh si Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Hehe. Ya sudah, mending kamu ke tempat si Topi Gendang dulu. Dia sudah kangen juga tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Bawa ini buat si Topi Gendang dan Pyro Sukacita. Kesukaan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Aku juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Jangan takut, uangnya pasti bakal balik di turnamen berikutnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Harus cobain lagi baru bisa komentar.",
					"roleType": "TALK_ROLE_PLAYER",
