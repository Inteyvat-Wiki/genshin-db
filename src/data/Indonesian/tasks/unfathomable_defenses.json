			},
			"dialogs": [
				{
					"id": 400841001,
					"content": "Wah? Sudah beres lagi? Kenapa suasananya jadi berat gini? Miko menang kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841002,
					"content": "Wah, pertandingan kalian juga sudah selesai? Kalian lama sekali, berarti nyaris kalah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841003
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841003,
					"content": "Hehe, kamu santai sekali buat ukuran orang yang baru tanding di semifinal. Segampang itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841004,
					"content": "Ahaha, iya. Pertandinganku tadi jauh dari kata nyaris. Setelah beberapa pukulan, Tukang Samber dan aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841005
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841005,
					"content": "Kalah mengenaskan dari Haniyyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841006
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841006,
					"content": "Lah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841007,
					"content": "Kamu ... pikir ini lucu? Apa aku ini bahan lelucon sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841008
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841008,
					"content": "Hehe, tidak kok, Haniyyah. Aku tahu tekad kamu sangat kuat, toh kamu sudah yakin mau bantai satu spesies demi ini ... Mana berani aku menghinamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841009
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841009,
					"content": "Tapi ingat, kalau kamu terus melangkah di jalan ini dan kemudian menemukan bahwa akhirnya jauh dari harapan ... Akan jadi apa tekadmu itu nanti? Aku tidak sabar ingin lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841010
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841010,
					"content": "Itu ... bukan urusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841011
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841011,
					"content": "Main langsung kabur saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841012
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841012,
					"content": "Nona Yae kalah, tapi kok kayaknya malah si Haniyyah yang kesal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841013
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841013,
					"content": "Perkembangan situasinya jadi semakin menarik. Si Tukang Samber berhasil melukai Pyro-1 sesaat setelah pertandingan dimulai, dan terlihat jelas kalau Haniyyah panik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841014
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841014,
					"content": "Aku cuma menunjukkan kalau dia masih saja menipu diri, dan pertahanannya sudah mulai retak. Dia lebih rapuh dari dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841015,
						400841016
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841015,
					"content": "Menipu diri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				},
				{
					"id": 400841017,
					"content": "Maksudnya si Haniyyah itu enggak sekejam kelihatannya? Jadi dia ada pedulinya ya sama si Pyro-1 ... Tapi dia tidak mau ketahuan sama Miko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841018,
					"content": "Betul sekali. Sekarang kesempatan kita untuk menyingkapkan perasaannya yang sesungguhnya. Bocah-bocah kecilku, sekarang cuma kalianlah yang bisa mengembalikannya ke jalan yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841019
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841019,
					"content": "Tapi Haniyyah sudah pergi dari tadi. Harus cari ke mana kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841020,
					"content": "Yah, sekarang aku yakin dia lagi merenung, memikirkan apa yang bisa membuat dia meragukan diri setelah sekian lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841021
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841021,
					"content": "Jawabannya ada dalam diri kalian bertiga. Aku yakin kalian sudah tahu dia pergi ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841022,
						400841023
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841022,
					"content": "Paimon, Layla, aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841024,
					"content": "#Tempat aku pertama kali ketemu sama {NICKNAME} dan Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841025
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841025,
					"content": "Mungkin ... waktu itu kan Layla sempat bilang mau bawa sobat jamurnya pulang, terus tiba-tiba si Haniyyah langsung berubah suram ... Layla kayaknya benar deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841026,
					"content": "Yuk kita samperin si Haniyyah terus kotbahin dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841027,
					"content": "Kamu diam di sini dulu, Dek Layla. Aku tahu kamu ingin menolong Haniyyah, tapi dia bukan tipe orang yang bisa kamu hadapi. Serahkan semuanya ke mereka berdua kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841028
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841028,
					"content": "Betul juga sih ... terus bahaya kalau aku salah ngomong lagi. Kalian juga jalannya cepat, kalau aku ikut, nanti malah harus istirahat setiap 10 menit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841029
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841029,
					"content": "Nah, bocah. Tunggu apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841030,
						400841031
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841030,
					"content": "Ini semua yang sudah berhasil kami ketahui sampai saat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841032,
					"content": "Eh eh? Ternyata kalian lebih sibuk dari yang kukira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841033
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841033,
					"content": "Nih, aku kasih hadiah: Semoga beruntung ya. Aku akan katakan pendapatku lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841031,
					"content": "Lihat dan katakan pendapatmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841023,
					"content": "Jangan-jangan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841016,
					"content": "Pertahanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				}
			]
		},
		{
			"id": 4008412,
			"completionStepIds": [
				4008411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008411",
							"2"
						],
						"stepId": 4008411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841201,
					"content": "Ah? Kenapa kalian bisa tahu aku ada di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841202,
					"content": "Kami ngikutin jejak Pyro-1! Kami agak khawatir sama kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841203,
					"content": "Sebentar ... Kamu lagi ngehibur Pyro-1?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841204,
					"content": "Ironis? Aku tahu ... dan aku suka. Kalau saja Pyro-1 bukan Fungus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841205
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841205,
					"content": "Kita akan bertemu lagi di final. Apa pun yang mau kalian katakan, katakan nanti saja kalau kalian bisa menang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841206,
						400841207
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841206,
					"content": "Kami ingin tahu kenapa kamu bertindak seperti ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				},
				{
					"id": 400841208,
					"content": "Wanita rubah itu bilang kalian akan mengatakan hal seperti itu ... Kalian berhati bersih, murni, dan percaya yang terbaik ada dalam setiap hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841209
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841209,
					"content": "Kamu tidak akan mengerti, jadi percuma kujelaskan. Baca saja ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841210
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841210,
					"content": "Uh, apaan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841212,
					"content": "Ini catatan riwayat nenek moyangku. Mereka diserang gerombolan Fungus di hutan, dan banyak orang yang terluka serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841213,
					"content": "Tidak ada yang spesial dari peristiwa itu, dan tidak masuk juga ke dalam catatan resmi. Tapi keluargaku menceritakannya berulang kali semenjak aku masih kecil, dan selalu memperingatkan bahwa Fungus itu sangat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841214,
					"content": "Jadi gitu ya ... pantesan kamu antipati banget sama Fungus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841215,
						400841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841215,
					"content": "Kami ikut sedih mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841217,
					"content": "Iya! Terus bukannya kisah keluargamu itu malah menjadikan turnamen ini lebih bermakna? Wisdom Orb itu kan penemuan yang bisa bikin manusia dan Fungus akhirnya bisa hidup berdampingan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841218,
					"content": "Tidak segampang itu mengubah Fungus jahat jadi Fungus baik. Sudah banyak peneliti yang mencoba hal serupa di desaku dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841219
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841219,
					"content": "Tapi semuanya gagal, menyerah, dan pergi. Bahkan Wisdom Orb ini cuma bisa menekan sifat agresif Fungus untuk sementara saja. Tanpa benda ini, mereka tetaplah makhluk yang berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841220
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841220,
					"content": "Selain itu, Peningkat Kecerdasan membuat Fungus menjadi kuat secara tidak wajar. Bukan hal yang baik kalau ada terlalu banyak energi elemen di sebuah tempat, terutama untuk orang-orang yang kondisinya memang sudah tidak baik. Kalau orang yang sensitif memakai Wisdom Orb, gejala gangguan kesehatan akan cepat terasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841221
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841221,
					"content": "Jadi kuat secara tidak wajar ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841222
					]
				},
				{
					"id": 400841222,
					"content": "Tunggu, Layla batuk-batuk terus loh belakangan ini ... apa itu gara-gara Wisdom Orb?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841223,
					"content": "Kalian pasti sudah mengerti kalau si Kautilya itu cuma peduli sama penelitiannya semata. Dia cuma mau membesarkan pengaruh dan mempromosikan acara pawang penjinak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841224
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841224,
					"content": "Sementara itu, Elchingen memanfaatkan situasi. Dia terkesan dengan penelitian Kautilya, lalu menginvestasikan uang dalam jumlah besar untuk mempromosikan turnamen ini. Konsekuensinya, orang jadi tidak terlalu waspada ketika ada di dekat Fungus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841225
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841225,
					"content": "Aku tidak percaya pada mereka, sama sekali. Aku tidak percaya makhluk ganas seperti Fungus bisa hidup berdampingan dengan manusia. Sayangnya, aku cuma mantan tentara bayaran. Siapa juga yang mau dengar omonganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841226
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841226,
					"content": "Aku cuma bisa ikuti aturan main mereka sampai kemenangan ada di tangan. Lalu aku akan lanjut berjuang demi mencapai tujuan yang kuinginkan, sambil menjegal mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841227,
					"content": "Aku awalnya sedikit berharap kalau kalian akan membantu perjuanganku ... tapi sepertinya aku terlalu naif. Tidak masalah, terserah kalian mau pikir apa. Aku akan menang, dan kalian tidak akan bisa menghentikanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841228,
					"content": "Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841229
					]
				},
				{
					"id": 400841229,
					"content": "Buku catatan ini cuma peninggalan masa lalu. Mau kalian simpan atau buang, terserah. Setelah babak final selesai, aku akan mengumumkan pemusnahan semua Fungus ... termasuk Pyro-1.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841230
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841230,
					"content": "Waktunya mengucapkan selamat tinggal pada masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841216,
					"content": "Tapi sekarang keadaannya sudah beda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841207,
					"content": "Kami ingin kamu melihat Fungus dari sisi lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				}
			]
		},
		{
			"id": 4008413,
			"completionStepIds": [
				4008413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
