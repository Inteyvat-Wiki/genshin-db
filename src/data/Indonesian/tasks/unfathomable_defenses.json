			"dialogs": [
				{
					"id": 400840801,
					"content": "Aku tegang, tapi semangat juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840802,
					"content": "Jangan menahan diri! Si Putar-Puter sudah teruji kehebatannya, dia bawa tim hebat, jadi biarkan sobat jamur kalian juga mengerahkan seluruh kekuatan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840803,
					"content": "Bersiaplah, Layla dan Putar-Puter!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
