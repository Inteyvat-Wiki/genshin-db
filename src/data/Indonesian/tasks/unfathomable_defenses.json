			"trigger": {
				"objectNames": [
					"Pedang Baja Kembar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "Jadi kalian. Pasangan paling bodoh di Piala Nilotpala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "Pedang Baja Kembar"
				},
				{
					"id": 400840402,
					"content": "HEH, kalau ngomong dijaga! Mau ribut???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840403,
					"content": "Ck, kelakuan kalian ke Fungus. Payah, payah sekali! Kalian menginjak-injak filosofi pawang penjinak terbaik sepanjang masa, Nona Haniyyah yang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "Pedang Baja Kembar"
				},
				{
					"id": 400840404,
					"content": "Pawang penjinak terbaik sepanjang masa? Enggak meyakinkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840405,
					"content": "Filosofi yang salah harus diluruskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "Silakan dicoba saja! Mau lawan Haniyyah? Mana mampu kalian! Sana pulang kampung saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pedang Baja Kembar"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
