				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "#{NICKNAME}, Paimon, aku berhasil lolos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840602,
					"content": "Layla keren! Tujuan tercapai nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840603,
					"content": "Selamat ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "Kudengar kalian menang lawan Pedang Baja Kembar yang tak pernah kalah? Kok malah muram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840605,
					"content": "Gimana ya jelasinnya ... Dia nyebelin banget sama kami. Dia juga ngomong yang aneh-aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840606,
					"content": "Kamu menjelaskan pertandingannya pada Layla ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "Aku paham maksudmu ... Yah, pawang penjinak seperti itu kadang memang bikin aku ... agak sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840608,
					"content": "Sedih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "Iya. Dia tidak tahu apa-apa soal Haniyyah, tapi berani buka mulut cuma dari asumsi saja, bahkan sampai meniru-niru segala. Kalau Haniyyah tahu, dia juga pasti risih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840610,
					"content": "Terus dia juga jahat sekali sama sobat jamurnya. Padahal kan mereka bisa jadi teman ... Terus bukan cuma dia yang rugi, kontestan lain juga jadi tidak semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840611,
					"content": "Iya! Layla memang baik, coba kalau semua orang mikirnya kayak kamu. Turnamen ini pasti bakalan lebih ceria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840612,
					"content": "Yah, ini semua karena aku tidak mengincar posisi teratas sih. Aku cuma ingin bawa pulang si Putar-Puter, itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840613,
					"content": "Dan sepertinya di pertandingan berikutnya kita akan berhadapan. Kita bawa senang saja ya, menang kalah tidak penting, ini cuma kompetisi antar sahabat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840614,
					"content": "Siap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "Oke sip! Sekarang waktunya cari tahu siapa yang lebih kuat, si Topi Gendang atau si Putar-Puter! Yang kalah traktir yang menang makan malam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840616,
					"content": "Wah wah, kalian kelihatannya senang sekali. Aku melewatkan apa nih waktu pergi tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840617,
					"content": "Miko, akhirnya kamu balik juga! Kabur diam-diam sampai kami tidak sempat kasih tahu kamu soal bukti ... EHEM, maksudnya kami mau ngobrol sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840618,
					"content": "Yah, aku juga capek sekali loh ini. Aku cuma ikutan turnamen ini buat senang-senang, ehhh malah masuk semifinal. Aku jadi tidak ada waktu buat cari bahan novel sama Souka dan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840619,
					"content": "Aku yakin kalian berdua akan bersenang-senang dengan pertandingan persahabatan kalian. Sementara, sayangnya aku harus lebih serius. Ya bagaimanapun kan lawanku si nona keras kepala itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840620,
					"content": "Ya, tidak ada menyangka ya ... Nona Yae lawan Haniyyah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840621,
					"content": "Liat saja sisi baiknya! Mungkin Miko bisa menang lawan Haniyyah, jadi kita enggak usah capek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840622,
					"content": "Biarpun itu berarti kita enggak bisa kasih tahu kalau dia salah jalan ... Paimon maunya Miko yang menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008408,
