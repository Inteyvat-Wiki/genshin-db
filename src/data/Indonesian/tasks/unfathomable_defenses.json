						"rawParams": [
							"4008413",
							"2"
						],
						"stepId": 4008413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841301,
					"content": "Waduh, kalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841302,
					"content": "Tapi kamu dan para sobat lainnya luar biasa sekali, Putar-Puter! Hebat, aku suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841303
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841303,
					"content": "Terima kasih ya semua! Putar-Puter dan aku kalah terhormat. Kalau lawannya bukan kamu, mungkin aku akan kecewa ... Tapi kami kalah menghadapi yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841304,
					"content": "Kalian juga jago loh! Rasanya tadi sedikit lagi si Topi Gendang bisa gepeng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841305,
					"content": "Ngebebasin para Fungus di arena dan kita cuma nonton saja tanpa tekanan buat harus menang ... Seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841306,
					"content": "Kalau saja semua pertandingan bisa seperti ini ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841307
					]
				},
				{
					"id": 400841307,
					"content": "Kalau saja semuanya bisa sesantai yang barusan ... Sekarang si Miko pasti lagi bertarung sengit sama si Haniyyah! Paimon jadi tegang nih, kita tengok ke sana yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008414,
			"completionStepIds": [
				4008414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008414",
							"2"
						],
						"stepId": 4008414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedang Baja Kembar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841401,
					"content": "Tidaaak! Ini tidak mungkin terjadi ... aku sudah latih Fungus-ku tanpa henti-hentinya. Apa mungkin latihanku kurang ketat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841402
					],
					"speakerTitle": "Pedang Baja Kembar"
				},
				{
					"id": 400841402,
					"content": "Wew. Meski kita bisa ngalahin dia ... tapi rasanya Paimon lagi enggak semangat buat ngerayainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008415,
			"completionStepIds": [
				4008415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008415",
							"2"
						],
						"stepId": 4008415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841501,
					"content": "Tadi enggak kayak rencana ... Yah, cuma ada satu pilihan lagi yang tersisa: Kita harus ngalahin Haniyyah di babak final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841502,
						400841503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841502,
					"content": "Setidaknya kita bisa tahu bagaimana perasaan dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				},
				{
					"id": 400841504,
					"content": "Haniyyah kan pernah bilang sesuatu tentang peneliti lain yang berusaha hentikan kerusakan yang disebabkan Fungus di masa lalu juga, kan? Harusnya ada informasi lain di catatannya. Yuk kita baca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841506,
					"content": "Ini kayaknya ... catatan penelitian. Harusnya leluhur Haniyyah simpan setelah semua penelitinya pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841507,
					"content": "Wew. Bagian yang ini kelihatannya super ribet. Terus tulisan tangannya jelek banget, banyak kata-kata teknis juga ... Paimon enggak ngerti sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841508,
					"content": "Tunggu, tapi ada kata-kata yang kayaknya pernah lihat deh ,... Oh ya, kita pernah baca di dokumen yang dikasih Dori ke kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841509,
						400841510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841509,
					"content": "Jadi catatannya dan dokumennya berhubungan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841511,
					"content": "Ya, kita lebih teliti sedikit bacanya, terus kita bandingin apa yang tertulis di catatan-catatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841512,
					"content": "Alat penangkap? Withering Potion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841513,
						400841514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841513,
					"content": "Perangkatnya dipakai untuk menangkap Fungus dan membuat mereka tenang dan mudah didekati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841515,
					"content": "Jadi gitu ya ceritanya ... Fungus cuma nyerang leluhur Haniyyah gara-gara ulah ramuannya ... Terus para penelitinya ngebangun perangkat itu buat coba menangkap Fungus yang ngamuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841516,
					"content": "Terus, kalau Floral Jelly itu versi lebih tinggi dari Withering Potion, dan Wisdom Orb itu bukan penemuan Kautilya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841517,
					"content": "Berarti dia cuma kasih nama baru untuk penemuan orang lain, dan dibuat jadi penemuan diri sendiri! Dia benar-benar pembohong besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841518,
						400841519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841518,
					"content": "Pembohong besar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841520,
					"content": "Tapi kenapa Kautilya mau orang-orang pakai Wisdom Orb ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841521,
						400841522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841521,
					"content": "Mungkin dia mau selesaikan pekerjaan peneliti yang sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841523,
					"content": "Kalau begitu kita harus peringatkan Elchingen dong. Dia tidak boleh biayai Kautilya lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841524,
					"content": "Kalau untuk Haniyyah ... Dia enggak tahu kalau Fungus nyerang leluhurnya gara-gara Fungus-nya lagi kepengaruh sama potion ... Pantesan dia jadi dendam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841525,
					"content": "Jangan khawatir, Topi Gendang. Paimon tahu kok kalau kamu enggak bakal jadi jahat cuma gara-gara Floral Jelly. Kamu kan sudah jadi Fungus yang baik, bahkan habis kami matiin Wisdom Orb-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841526,
					"content": "Wah! Kamu bisa ngerti Paimon ngomong apa? Makin pinter saja kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841527,
						400841528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841527,
					"content": "Paimon, tunggu dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841529,
					"content": "Eh? Sejak kapan? Paimon bahkan enggak sadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841530,
					"content": "Apa itu berarti ... Topi Gendang sekarang ikut kita karena keinginannya sendiri sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841531,
						400841532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841531,
					"content": "Pengalamannya dengan kita sejauh ini lumayan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841533,
					"content": "Nah, kan! Paimon rasa Fungus enggak bakal lepas kendali kali ini. Ada Fungus yang bisa mengerti manusia dan cocok sama kita, kayak si Topi Gendang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841534,
					"content": "Tapi Haniyyah benar sih soal satu hal: Wisdom Orb punya batasnya. Dan kalau begitu, berarti Fungus enggak bakal bisa hidup sama manusia selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841535,
					"content": "Hiks ... Padahal Paimon benar-benar pengen si Topi Gendang ikut sama kita sampai ke mana pun ... Apa enggak ada cara lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841536,
						400841537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841536,
					"content": "Kita jaga jarak dulu deh untuk sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841538,
					"content": "Yah ... sayang sekali sih. Tapi kayaknya enggak ada cara lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841539,
					"content": "Kita masih punya sedikit waktu lagi sebelum babak final. Apa kita perlu laporin Kautilya ke Akademiya gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841540,
						400841541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841540,
					"content": "Kita masih belum tahu persis kekuatannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841542,
					"content": "Benar sih ... Kalau dia bisa ngerencanain skema sebesar ini, pasti itu sudah lama banget direncanain. Kalau dia sampai tahu kita lagi pasang mata ke dia, dia pasti bakal jadi waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841543,
					"content": "Tapi yah, bagaimanapun, kita benar-benar harus ngelakuin yang terbaik di babak final. Ayo kita kalahin Haniyyah dan kasih dia pelajaran. Terus, kita juga harus minta Elchingen buat bantu kita mengekspos kecurangan Kautilya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841541,
					"content": "Jangan buru-buru dulu deh sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841537,
					"content": "Ayo kita cari cara untuk tingkatkan lagi Wisdom Orb-nya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841532,
					"content": "Kita sudah bisa saling mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841528,
					"content": "Wisdom Orb-nya tidak aktif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841522,
					"content": "Agar dia bisa terkenal dengan hasil karya orang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841519,
					"content": "Meskipun, aku tidak terlalu terkejut sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841514,
					"content": "Tapi Withering Potion bisa bikin mereka jadi ganas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841510,
					"content": "Oke! Kalau begitu kita taruh bersampingan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841503,
					"content": "Setidaknya kita dapat catatannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				}
			]
		}
	]
}