			"dialogs": [
				{
					"id": 752400101,
					"content": "Selamat datang di Piala Pahlawan Ayar! Aku adalah penyelenggara acara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Ini adalah hari terakhir kompetisi. Kalau mau menang, kamu harus mengalahkan tiga petarung terbaik kami secara berturut-turut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "Apa itu \"Piala Pahlawan Ayar\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "Ini adalah pertarungan untuk kejayaan Ayar! Gunakan tinju, senjata, atau trik lain untuk mengalahkan lawan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "Lalu, Ayar itu orang, atau ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "Kawan, di sini hanya juara saja yang berhak bertanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "Naiklah, kita lihat apa kamu benar-benar layak mendapatkan kehormatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
