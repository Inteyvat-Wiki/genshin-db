			"dialogs": [
				{
					"id": 750860301,
					"content": "Datang juga! Taruka sudah cerita kalian sekeren apa. Katanya aku harus berusaha keras kalau mau ngejar kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750860302,
					"content": "Ck, dia pikir aku enggak ada kesempatan menang sama sekali ya! Kurang ajar betul tuh anak sama kakak sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750860303,
					"content": "Jadi jangan harap aku mengalah di pertandingan nanti. Kamu juga, jangan aneh-aneh ya! Kita lakukan yang terbaik, dan biar yang terbaik yang menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750860304,
					"content": "Nantangin gitu, nanti nyeseeel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "Hahaha, memang itu tujuannya! Biar kamu panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750860308,
					"content": "Sudah cukup ngomongnya. Kita mulai saja ya, siap-siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750860306,
					"content": "Aku cuma ngincar hadiah partisipasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "Hah! Mau main siasat apa? Kamu ngomong gitu cuma buat bikin aku lengah. Enggak mempan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "Lliwa"
				}
			]
		},
