			"dialogs": [
				{
					"id": 750861204,
					"content": "Kamu dicegat Qucusaurus, lalu dikasih surat.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750861201
					]
				},
				{
					"id": 750861201,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750861202
					],
					"speakerTitle": "Qucusaurus"
				},
				{
					"id": 750861202,
					"content": "Surat undangan balap terbang nih! Ada banyak persyaratan yang berhubungan sama waktu ... yah, namanya juga balapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750861203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750861203,
					"content": "#Paimon enggak tahu bakal jadi apa nih, hati-hati ya, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
