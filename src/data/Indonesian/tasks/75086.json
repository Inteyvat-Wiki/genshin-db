					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750860404,
					"content": "Si Lamizana itu ... sama sekali enggak bisa diandelin! Tapi kita enggak ada petunjuk lain nih, mau cek TKP saja enggak? Di garis finis?",
					"roleType": "TALK_ROLE_NPC",
