			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "*huff* *huff* Terima kasih, benar-benar terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Serius deh, tadi aku sedang melukis di sana, lalu tiba-tiba aku sudah dikepung saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Mereka terus mengincar lukisanku, sampai kukira mau dimakan atau apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Tapi tentu saja tidak kubiarkan. Jadi kuambil lukisannya dan kabur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Tapi mereka berhasil menyusulku sebelum aku kabur jauh ... lalu untung saja kalian datang menolongku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Ada masalah apa dengan lukisannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Ti-Tidak tahu! Aku memang selalu menggunakan Whopperflower Nectar sebagai bahan catku. Itu loh, barang yang kamu carikan buatku sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Tunggu ... apa mungkin catnya yang menarik perhatian mereka? Tapi harusnya bukan deh, karena tidak ada baunya sama sekali setelah kucampur ke dalam cat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "Aku tidak berani ganti formula cat seenaknya. Harus cari cara lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "Eh, padahal dikira Whopperflower saja paham indahnya lukisan, dan datang kemari untuk menikmati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "Kamu ngapa-ngapain mereka memangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}