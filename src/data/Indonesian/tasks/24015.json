			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "Tidak, tidak ... kalau kita buang cahaya dan bayangannya, bagaimana nanti dengan efek lapisannya dong ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "Ekspresi dari warnanya saja belum cukup, kontras warnanya juga kurang kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "Duh, padahal cuma membuang beberapa elemen saja, tapi semuanya jadi berantakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Ah, ternyata kamu. Lama tak jumpa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Maaf ya jadi salah sangka. Aku lagi memikirkan masalah pada lukisan ini, lalu tak sengaja jadi mondar-mandir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Mungkin kamu tidak mengerti, tapi aku memang jadi tidak bisa diam kalau sedang ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Semakin lama aku diam sambil menghadapi masalah itu, aku malah jadi semakin stres. Itulah kenapa aku suka berpikir sambil jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Kubiarkan kakiku membawaku ke mana pun selagi aku berpikir, yang penting aku tidak berdiam diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "Jadi ... ini sudah sering terjadi. Maaf membuatmu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "Jadi sudah ketemu solusinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Sayangnya belum ada solusi ... aku tidak tahu harus mulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Kalau aku buang pencahayaannya, gambar ini jadi kurang berlapis. Tapi kalau aku kurangi kontur dan bentuk objeknya, struktur gambarnya jadi kurang jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "Mana pun yang kubuang pasti akan membuat semua gambar ini hancur berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Tapi aku cuma sedang berbicara dengan diri sendiri saja kok. Tidak perlu memikirkanku, aku hanya mencari solusi untuk masalahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Aku harus kembali dan cari penyangga lukisanku dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "Jadi apa masalah yang sedang kamu pikirkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Kami kira kamu sedang dalam bahaya loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
