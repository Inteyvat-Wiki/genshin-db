					"nextDialogs": [
						761250244
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250244,
					"content": "Kamu juga tahu kan kalau tidak ada keajaiban yang gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250245,
					"content": "Hei, kamu mau pergi ke mana? Eh, maksud Paimon ... kita jarang ketemu, boleh tidak kalau kami ikut sebentar?",
