						761250240
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250240,
					"content": "Sandrone! Lagi apa kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
