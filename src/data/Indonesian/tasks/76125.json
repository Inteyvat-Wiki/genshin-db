					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "Aku ... belum menyerah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Columbina, dan semua teman-temannya .... Tidak akan menyerah begitu saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Beri kami sedikit waktu lagi. Aku tidak bisa janji apa-apa, tapi aku akan lakukan semua yang aku bisa ....",
