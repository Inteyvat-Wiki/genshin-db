						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "Kuuhenki ini ... kayaknya yang suka main lira itu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "Kuuhenki ini ... menurut Paimon dia kelihatan agak gelisah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Bagaimana kalau kamu mainkan sesuatu? Kalau mereka dengar melodi yang akrab bagi mereka, mungkin bisa tenang sedikit ....",
