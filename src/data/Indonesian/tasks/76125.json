					"nextDialogs": [
						761250242
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250242,
					"content": "Dia belum kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Sudah kuduga.",
