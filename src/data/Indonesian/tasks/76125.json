				},
				{
					"id": 761250218,
					"content": "(Aku tidak boleh terus larut dalam rasa bersalah.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Columbina tidak mengorbankan dirinya hanya untuk kita berakhir seperti ini, apalagi ....)",
