			"dialogs": [
				{
					"id": 205190501,
					"content": "... Kamu ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "Aku masih menunggu jawaban suster Victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "Masalah ini... bagaimana pun akhirnya, aku sudah siap...",
