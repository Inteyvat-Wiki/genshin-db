			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190101,
					"content": "Bertemu lagi, bagaimana kabarmu akhir-akhir ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190102,
					"content": "Oh, ngomong-ngomong tentang Jilliana, hidupnya biasa-biasa saja, tidak baik dan tidak buruk. Tidak begitu buruk adalah karena sampai sekarang dia tidak meninggalkan kota Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190103,
					"content": "Tidak begitu baik adalah karena dia sudah mengaku kepada Victoria, tapi Victoria tidak melakukan apa pun sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190104,
					"content": "Bagaimana mengatasi masalah ini, kita juga hanya bisa menunggu dan melihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190105,
					"content": "... Apa yang ingin kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190106
					]
				},
				{
					"id": 205190106,
					"content": "Jangan menatapku dengan mata yang begitu mengerikan, aku bukan orang jahat, tapi aku berbaik hati memberi tahumu cara membantu Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190107,
					"content": "Baiklah, sejujurnya kali ini aku datang mencarimu karena \"masalah kecil\" yang tersisa dari masalah sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190108,
					"content": "Singkat cerita, kamu berhasil mengusir Treasure Hoarder, tapi di saat yang bersamaan kamu juga membuat \"Jilliana menetap di kota Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190109,
					"content": "Sejauh yang aku tahu, Treasure Hoarder tidak akan tinggal diam dengan sebuah pengkhianatan. Di area sekitar Mondstadt ada jejak sejumlah Treasure Hoarder, dan semuanya adalah orang yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190110,
					"content": "Yang aku khawatirkan adalah mereka ingin mencari masalah dengan Jilliana, sebagai pembalasan dendam. Aku hanya bisa meminta tolong padamu melawan penjahat-penjahat yang berbahaya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190111,
						205190113,
						205190115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190111,
					"content": "Ini adalah hal yang bisa kamu lakukan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190112
					]
				},
				{
					"id": 205190112,
					"content": "Huh, aku juga hanya diperintahkan, kalau bukan karena desakan pria itu menginginkan kamu melakukan hal ini, aku juga tidak akan terus mencarimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190113,
					"content": "Aku akan mengurusnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190114
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190114,
					"content": "Jangan mengatakan kata-kata yang begitu kejam, aku tidak memiliki kekuatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190115,
					"content": "Ini adalah masalah Knights of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190116
					]
				},
				{
					"id": 205190116,
					"content": "Itu tidak salah, tapi melihat keadaan saat ini, pria itu mengatakan semakin sedikit orang yang tahu mengenai masalah Jilliana akan semakin baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190117,
					"content": "Selain itu, pria tersebut tidak ingin Knights of Favonius ikut campur dengan masalah ini. Lagi pula, Knights of Favonius terbiasa buka-bukaan dan melebih-lebihkan masalah yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190118,
					"content": "Contohnya, Huffman yang dapat diandalkan, kalau dia mendengar ada Treasure Hoarder di sekitar kota Mondstadt, dia pasti akan langsung melapor ke Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190119,
					"content": "Kalau Knights of Favonius sampai mengerahkan pasukan besar-besaran, Treasure Hoarder akan terbagi menjadi beberapa bagian dan melarikan diri. Rencana menyingkirkan Treasure Hoarder sepenuhnya akan sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190120,
					"content": "Jadi, kali ini hanya bisa meminta tolong padamu untuk melakukan \"pertarungan tunggal\", dan tidak membuang-buang waktu dalam menyingkirkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190121,
					"content": "Tetapi para Treasure Hoarder begitu berani mendekati kota Mondstadt, mungkin saja para Knights of Favonius sudah menyadari kedatangan mereka, dan sudah bersiap-siap untuk menyerang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190122,
					"content": "Tapi, semua ini bukan hal yang harus kita pikirkan lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190123,
					"content": "Jangan khawatir, kali ini aku sudah menyiapkan hadiah imbalan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190124
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190124,
					"content": "Lagi pula pria itu memberiku Mora dalam jumlah yang cukup banyak, tidak seperti sebelumnya, aku yang harus membayarmu sendiri... Oh iya, aku akan menandai lokasi Treasure Hoarder itu berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190125
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190125,
					"content": "Jadi, bagaimanapun lindungi Jilliana, Rudolf, Lily, dan misi kota Mondstadt kuserahkan padamu, semoga berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
