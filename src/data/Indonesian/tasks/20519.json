				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "... Treasure Hoarder! Maaf, apa kamu ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Ada sekelompok Treasure Hoarder di sekitar Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Treasure Hoarder? Kami sedang bersiap-siap mengejar Treasure Hoarder. Sekelompok penjahat itu berani mendekati kota Mondstadt, tidak tahu apa yang mereka inginkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Tapi apa pun alasannya, yang pasti bukan hal yang baik. Kali ini kami menyiapkan banyak orang untuk menghadapi mereka... Aku khawatir kami tidak bisa mengurus laporanmu untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Tapi laporanmu sudah dicatat, setelah kami selesai menghadapi sekelompok Treasure Hoarder itu, aku akan segera mengurus laporannya. Sekali lagi terima kasih atas laporanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
