					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "Kamu sudah kembali, benar-benar efisien, aku jadi tahu kenapa pria itu begitu menyukaimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190202,
					"content": "Berikan hadiah imbalannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "Dingin seperti es... Baiklah, ini bayaran untukmu. Aku juga hanya pesuruh, mengertilah sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190204,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "Tidak perlu, hadiah imbalan ini untukmu, dan... senang bekerja sama denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051903,
