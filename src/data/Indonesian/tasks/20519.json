			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "Apakah kamu masih siap-siap? Yah, bersiap-siaplah baru berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190402,
					"content": "Sebenarnya siapa identitas pria itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "Tidak peduli bagaimana kamu bertanya, aku tidak akan memberi tahumu, ini adalah dasar dalam berbisnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190404,
					"content": "Bahkan kalau sampai terungkap... semua hal itu pasti adalah informasi yang memang \"perlu diungkapkan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190405,
					"content": "Ah, benar juga, coba kamu pikirkan lagi tentang apa yang kukatakan sebelumnya, apa saja hal yang \"perlu diungkapkan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190406,
					"content": "Sebenarnya apa tujuan kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "Tujuan... Aku juga tidak tahu tujuan dari pria itu. Tapi yang pasti tujuannya juga adalah untuk melindungi kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190408,
					"content": "Hmm... seharusnya dalam menghadapi permasalahan besar ini, dia tidak bertindak dengan mengandalkan \"perasaan\" saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190409,
					"content": "Ah, tidak, masalah seperti ini bukan aku yang seharusnya memikirkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
