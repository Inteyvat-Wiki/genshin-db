			"dialogs": [
				{
					"id": 220320301,
					"content": "Ah, benar! Inilah cita rasa kampung halaman yang selalu kurindukan... sungguh... hiks... sungguh membuatku jadi terharu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320302,
					"content": "Terima kasih! Dengan makanan seenak ini, aku juga jadi tambah semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320303,
					"content": "Ini untukmu, semoga perjalananmu kelak lancar selalu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203204,
