			"dialogs": [
				{
					"id": 220320701,
					"content": "Jadi ada masakan apa saja yang menggunakan ikan? Kita bantu dia pilih saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320702,
					"content": "Hmm... Apa ya ikan kesukaan Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320703,
					"content": "Black-Back Perch Stew yang pedas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320704,
					"content": "Squirrel Fish yang asam manis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320705,
					"content": "Dan Mondstadt Grilled Fish yang kaya rasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320706,
					"content": "Itu semua sih, kesukaanmu kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "Hehe, tenang, percaya deh sama selera Paimon. Ayo pilih satu~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320708,
					"content": "Kalau begitu kita masak Black-Back Perch Stew saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "Oke! Ayo kita cepat buatkan seporsi Black-Back Perch Stew untuk Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320710,
