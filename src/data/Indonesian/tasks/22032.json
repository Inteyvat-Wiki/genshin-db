				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "Eh? I-ini masakan Inazuma kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320502,
					"content": "Kurasa yang kumau bukan masakan ini... Ugh, ya sudahlah, yang penting bisa mengenyangkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320503,
					"content": "Tapi terima kasih ya, pengembara. Terimalah barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203206,
			"completionStepIds": [
