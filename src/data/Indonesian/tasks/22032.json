					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "Ugh, rasa ini... sepertinya bukan masakan Liyue, tapi juga bukan masakan Inazuma. Rasanya sangat menyegarkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320402,
					"content": "Meskipun bukan masakan yang kumau, tapi aku sudah cukup terpuaskan karena dapat merasakan rasa masakan yang menyegarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320403,
					"content": "Terima kasih, pengembara. Terimalah barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
