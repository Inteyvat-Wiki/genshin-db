				},
				{
					"id": 220320714,
					"content": "Kupikir-pikir dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "Ya~ Kalau sudah tahu mau buat apa, ayo cepat kita masak untuk Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
