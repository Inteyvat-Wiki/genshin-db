					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "Oke! Ayo kita cepat buatkan seporsi Squirrel Fish untuk Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320712,
					"content": "Kalau begitu kita masak Mondstadt Grilled Fish saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "Oke! Ayo kita cepat buatkan seporsi Mondstadt Grilled Fish untuk Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
