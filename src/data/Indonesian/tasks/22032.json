			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Ah, coba kalau ada makanan Liyue sekarang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "Bajumu ... kamu Pengembara itu ya? Maaf, aku cuma sedikit kangen rumah saja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Barusan kamu bilang ingin makan masakan Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Eh? Jangan-jangan... Kamu bisa bikin masakan Liyue ya? Mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "Ka-Kalau begitu tolong, kumohon masak sesuatu yang otentik khas Liyue ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Coba kupikir dulu ... Aku sekarang lagi ingin makan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Hmm ... aku mau makan ikan! Aku jadi ingat ikan yang sering dimasak oleh ibu saat aku kecil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "Ikannya dicuci bersih, dua sisinya dikerat dan masukkan bumbu serta arak ke dalamnya, lalu biarkan beberapa waktu. Setelah itu, goreng sampai dua sisinya berwarna emas kekuningan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Tambahkan air panas dan sausnya, lalu rebus perlahan. Langkah terakhir, pakai api besar sampai sausnya meresap ke dalam ikan dan mengental. Dan ikan pun siap disajikan! Ah! Sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "Adikku yang masih kecil mencium aromanya, meloncat sambil bertepuk tangan dan berteriak, \"Hore! Hore!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "Huhu ... Ibuku pandai sekali memasak ikan. Kapan ya aku bisa pulang dan makan masakannya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Biar kuperkenalkan diri dulu. Namaku Tang Wen, seorang sejarawan dari Liyue. Sebelum ini, aku meneliti budaya dan cerita rakyat Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "Aku sudah mengumpulkan semua bahan yang diperlukan dan sudah bersiap-siap pulang ke Liyue, tapi baru-baru ini jadi banyak peristiwa besar yang terjadi di Inazuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "Dan aku merasa seperti sedang hidup di waktu yang bersejarah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "Peristiwa-peristiwa yang terjadi di zaman ini pasti akan meninggalkan bekas yang mendalam di sejarah Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "Menyaksikan sejarah dengan mata kepala sendiri, kemudian mencatat semuanya secara lengkap dan jelas untuk generasi mendatang. Demikianlah tugas seorang sejarawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "Aku memang semangat, sangat semangat ... Tapi semangat saja tidak bikin perut kenyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Lapar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Bukan lapar sampai segimana juga sih... Masakan Inazuma enak kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "Aku doyan sekali tempura, padahal itu kan cuma ... Yah, cuma gorengan biasa kan, tepung semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "Setelah makan buatan lokal sekian lama, aku mulai kangen masakan kampung halamanku. Sedihnya, di sini belum ada restoran yang menyajikan masakan Liyue asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "Akhirnya kuputuskan untuk mengajukan misi saja ke Adventurers' Guild, tapi sampai sekarang belum ada yang mengambil misinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "Aku coba deh, boleh kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
}