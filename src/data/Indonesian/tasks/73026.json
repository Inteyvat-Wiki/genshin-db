			},
			"dialogs": [
				{
					"id": 730260501,
					"content": "Banyak kejutan di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260502,
					"content": "Ini wajar, tunggu, akhirnya ada kesempatan menyebutkan kalimat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260503
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260503,
					"content": "\"Sejarah ribuan tahun Khaenri'ah kuno sedang mengawasi kita!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260504
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260504,
					"content": "Aduh, agak sombong ya. Ini kutipan terkenal dari Sage Vahumana, Iskandar, jangan-jangan kalian belum pernah baca biografinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260505,
						730260506
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260505,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260508
					]
				},
				{
					"id": 730260508,
					"content": "Walaupun aku sudah pernah membacanya berulang kali secara langsung, tapi aku tetap tidak bisa menahan rasa antusiasku waktu pertama kali melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260509
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260509,
					"content": "Banyak banget tanaman yang merambat, sepertinya sudah lama tidak ada yang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260510,
					"content": "Berdasarkan \"Penelitian Terkait Ruin Golem Khaenri'ah Kuno\", peneliti terakhir yang masuk ke Ruin Golem Khaenri'ah kuno untuk penelitian sistematis itu Pir Kavikavus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260511
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260511,
					"content": "Kalian pasti tidak tahu, Pir Kavikavus adalah peneliti terhebat sepanjang sejarah Kshahrewar. Dia sudah dapat julukan peneliti jenius sebelum umur 30.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260512
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260512,
					"content": "Dia seharusnya bisa menjadi Sage suatu hari nanti, tapi karena sebuah kecelakaan yang terjadi saat inspeksi, semua prestasinya pun hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260513
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260513,
					"content": "Sejak saat itu, divisi Kshahrewar pun tidak bisa bangkit lagi. Kalau dia masih hidup, aku tidak perlu memikirkan soal masalah biaya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260514
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260514,
					"content": "Omong-omong, meneruskan karier Pir Kavikavus adalah cita-cita akademisku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260515
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260515,
					"content": "Lupakan dulu soal cita-cita akademisku, intinya sekarang langkah selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260516,
						730260518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260516,
					"content": "Hancurkan pintu masuk yang ditutup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260517
					]
				},
				{
					"id": 730260517,
					"content": "Yup, kalau gitu kita harus mengaktifkan Ruin Golem-nya lebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260520,
					"content": "Benar, mengaktifkan Ruin Golem ini untuk mendapatkan data penelitian yang berharga adalah titik terobosan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260521
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260521,
					"content": "Bagaimanapun, kalau mau lebih berhasil dari orang lain, kita harus membuat sebuah inovasi, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260522
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260522,
					"content": "Kalau gitu cepat aktifkan Ruin Golem-nya, pasti akan ada perangkat yang bakal menyala waktu ditekan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260523,
					"content": "Perangkat ... walaupun memang ada, seharusnya Ruin Golem akan aktif saat \"Katup Pemisah\" di ruang kendali dibuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260524
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260524,
					"content": "Tapi aku dulu pernah bilang kalau semua Ruin Golem mengandalkan kekuatan kegelapan dalam inti mereka untuk bergerak. Dan inti Ruin Golem ini ... sudah tersegel di bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260525
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260525,
					"content": "Jadi walaupun kita masuk ke dalam ruang kendali, kita tetap tidak bisa mengaktifkannya dengan menggunakan cara yang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260526
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260526,
					"content": "Apalagi elevator ini sudah tidak bisa diaktifkan. Kita tidak bisa naik ke ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260527
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260527,
					"content": "Ugh, lalu gimana sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260528,
						730260530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260528,
					"content": "Coba dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260529
					]
				},
				{
					"id": 730260529,
					"content": "Hei! Walaupun aku punya lisensi penelitian tertinggi di Akademiya, tapi bukan berarti kita bisa merusak mesin ini sesuka kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260531
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260531,
					"content": "Kata orang \"ada banyak jalan menuju roma\", Khaenri'ah juga mempertimbangkan kondisi seperti itu, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260532
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260532,
					"content": "Mungkin karena kurang menguasai kekuatan kegelapan, berdasarkan penelitian Akademiya, reruntuhan raksasa yang diciptakan di versi awal punya sistem kekuatan cadangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260533,
						730260539
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260533,
					"content": "Sistem daya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260534
					]
				},
				{
					"id": 730260534,
					"content": "Berbeda dengan inti yang bisa menyediakan energi yang hampir tidak terbatas, sistem ini dibuat dengan menggabungkan beberapa energi kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260535
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260535,
					"content": "Dan sumber daya ini diperoleh dari balok energi yang menyimpan energi dari Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260536
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260536,
					"content": "Berdasarkan teori dari peneliti Vahumana, sistem daya seperti ini sudah digunakan sebelum mesin ruin pertama diciptakan di Khaenri'ah kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260537
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260537,
					"content": "Aku sudah periksa sebelum masuk, Ruin Golem ini juga termasuk model awal, jadi dia juga pasti punya sistem daya cadangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260538
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260538,
					"content": "Ruang kendali inti ada di lantai bawah, kita harus pikirkan cara untuk ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260539,
					"content": "Langsung bilang saja selanjutnya bagaimana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260540
					]
				},
				{
					"id": 730260540,
					"content": "Uhm ... Ruang kendali inti ada di lantai bawah, kita harus pikirkan cara untuk ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260530,
					"content": "Artinya ini cara yang kurang umum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260531
					]
				},
				{
					"id": 730260518,
					"content": "Mengembangkan penelitian akademis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260519
					]
				},
				{
					"id": 730260519,
					"content": "*huff*, kamu lupa kita datang untuk memeriksa reruntuhan? Walaupun penelitian akademis juga penting, tapi kita harus memikirkan cara untuk mengaktifkan Ruin Golem-nya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260506,
					"content": "Kamu pelajar Kshahrewar, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260507
					]
				},
				{
					"id": 730260507,
					"content": "Yah, pengetahuan itu kan tidak terbatas ya. Aku tidak ingin pembelajaranku dibatasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260508
					],
					"speakerTitle": "Jazari"
				}
			]
		},
		{
			"id": 7302606,
			"completionStepIds": [
				7302603
			],
			"beginWay": "TALK_BEGIN_AUTO",
