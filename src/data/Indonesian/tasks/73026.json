			},
			"dialogs": [
				{
					"id": 730260801,
					"content": "Cepat sekali sudah kembali, aku masih mempelajari struktur mesin ini. Ternyata kalian sudah berhasil mengaktifkan elevator ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260802
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260802,
					"content": "Jangan-jangan kamu bohong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260803
					]
				},
				{
					"id": 730260803,
					"content": "Ah ... lagi pula aku cuma pernah membaca ini dalam deskripsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260804
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260804,
					"content": "Asal kamu tahu saja ya, tidak ada lebih dari 3 orang di seluruh Akademiya yang bisa baca blueprint ini. Jadi bisa menebak dengan benar itu ya hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260805
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260805,
					"content": "Intinya, elevator ini bisa berfungsi normal, selanjutnya aktifkan perangkat relai di lantai ini, lalu seharusnya kita sudah bisa pergi ke ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260806
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260806,
					"content": "Coba aku lihat ... perangkat di lantai ini, harus diaktifkan dengan mengaktifkan empat perangkat relai di ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260807
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260807,
					"content": "Kalau tidak bisa menemukan balok energinya, untuk sementara dikeluarkan dari perangkatnya dulu juga boleh sih. Asal bisa terhubung saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260808
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260808,
					"content": "Kalau gitu aku akan menunggu kalian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		},
		{
			"id": 7302609,
			"completionStepIds": [
				7302614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302614",
							"2"
						],
						"stepId": 7302614,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jazari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260901,
					"content": "Hmm? Kalian sedang apa di atas? Sepertinya aku dengar sesuatu waktu sedang periksa sirkuit induktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260902
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260902,
					"content": "Tidak peduli apa yang sedang kalian lakukan, tolong lebih hati-hati. Kalau sampai terjadi sesuatu, aku bisa susah saat menjelaskannya dalam laporanku untuk ke Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260903,
						730260906
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260903,
					"content": "Kami bertemu operator.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260904
					]
				},
				{
					"id": 730260904,
					"content": "Operator? Kalian menganggap itu serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260905
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260905,
					"content": "Walaupun itu orang Khaenri'ah, dia juga tidak mungkin hidup ratusan tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260909,
					"content": "Omong-omong, intinya kalian sudah hubungkan semua perangkat relai sampai lantai tengah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260910
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260910,
					"content": "Aku juga hampir selesai di sini, selanjutnya kita akan pergi ke ruang kendali di lantai atas sama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260911
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260911,
					"content": "Sama seperti tadi, kita seharusnya bisa mengaktifkan sistem kendali Ruin Golem ini dengan menghubungkan sumber energi ke ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260906,
					"content": "Kami bertemu seseorang yang dikenal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260907
					]
				},
				{
					"id": 730260907,
					"content": "Hm, jangan-jangan kamu juga sama dengan anak ini ... tidak apa-apa, aku akan memberikan dua surat rekomendasi pada Akademiya supaya kalian berdua bisa akrab juga nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260908
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260908,
					"content": "Bukan gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302611,
			"completionStepIds": [
				7302611
