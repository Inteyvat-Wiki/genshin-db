			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261101,
					"content": "Ugh ... selain lempengan batu yang hitam ini, sepertinya tidak ada benda berharga lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261102,
					"content": "Lempengan batu apa, jangan meremehkannya. Setelah mengaktifkan sistem pengendali dan melewati ini bisa langsung melihat ke luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261103
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261103,
					"content": "Kelihatannya sistem pengendali di sini masih berfungsi dengan baik, barang buatan Khaenri'ah kuno memang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261104
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261104,
					"content": "Awalnya aku mengira sudah tidak ada kesempatan lagi, tapi sepertinya keinginan untuk mendapatkan \"Penghargaan Pir Kavikavus\" cuma tinggal menunggu waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261105
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261105,
					"content": "Kalau begitu, cepat coba buka mesin ini, Paimon sudah enggak sabar deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261106,
						730261107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261106,
					"content": "Oh sudah jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				},
				{
					"id": 730261108,
					"content": "Jangan buru-buru, kita harus mengikuti standar pengoperasian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261107,
					"content": "Cepat lakukan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				}
			]
		},
