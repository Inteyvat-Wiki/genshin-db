			"dialogs": [
				{
					"id": 730260101,
					"content": "Di dalam sini enggak berbeda jauh dengan robot yang Paimon masuki waktu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260102,
					"content": "Waktu itu? Sebelumnya kalian sudah pernah masuk ke Ruin Golem yang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260103
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260103,
					"content": "Iya! Sebelumnya di padang pasir ada orang yang namanya Afratu, dia pernah minta bantuan kami untuk buat penelitian robot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260104,
					"content": "Afratu? Sial, jangan-jangan dia sudah mengincar gelar \"Peneliti Ruin Golem Termahsyur\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260105
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260105,
					"content": "Sepertinya tidak begitu juga deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260106
					]
				},
				{
					"id": 730260106,
					"content": "Seingatku dia adalah peneliti dari Vahumana, dia tidak seharusnya tertarik dengan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260107
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260107,
					"content": "Tapi kalau dipikir-pikir, bukan tidak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260108
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260108,
					"content": "Terlebih lagi dia pernah bilang, \"Sejarah ribuan tahun Khaenri'ah kuno sedang mengawasi kita!\" Ini kata-kata dari Sage Iskander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260109
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260109,
					"content": "Jangan sibuk sama peneliti termahsyur dulu, tempat ini jarang banget didatangi sama orang kalau dibandingin dengan tempat yang kita kunjungi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260110,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260111
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260111,
					"content": "Berdasarkan \"Penelitian Terkait Ruin Golem Khaenri'ah Kuno\", peneliti terakhir yang masuk ke Ruin Golem Khaenri'ah kuno itu Pir Kavikavus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260112
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260112,
					"content": "Kalian pasti tidak tahu, Pir Kavikavus adalah peneliti terhebat sepanjang sejarah Kshahrewar. Dia sudah dapat julukan peneliti jenius sebelum umur 30.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260113
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260113,
					"content": "Seharusnya dia bisa jadi Sage cepat atau lambat, tapi karena kecelakaan yang terjadi dalam sebuah ekspedisi, semua hasil penelitiannya pun hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260114
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260114,
					"content": "Sejak saat itu, Kshahrewar pun tidak bisa bangkit lagi. Kalau dia masih hidup, aku mungkin tidak perlu pikirkan lagi soal masalah biayaku siang dan malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260115
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260115,
					"content": "Omong-omong, meneruskan karier Pir Kavikavus adalah cita-cita akademisku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260116
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260116,
					"content": "*huff* Intinya, yang harus kita lakukan sekarang adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260117,
						730260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260117,
					"content": "Hancurkan dan buka paksa pintu masuknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260118
					]
				},
				{
					"id": 730260118,
					"content": "Ya, kalau gitu kita harus aktifkan dia lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260121,
					"content": "Benar, mengaktifkan Ruin Golem ini untuk mendapatkan data penelitian yang berharga adalah titik terobosan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260122
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260122,
					"content": "Kalau mau bertanding dengan orang di depan, kita harus buat inovasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260123
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260123,
					"content": "Jadi, kita cuma perlu ke ruang kendali untuk aktifkan dia, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260124,
					"content": "Uhm ... Secara teori memang cuma perlu masuk ke ruang kendali untuk mengaktifkan \"mesin\" Ruin Golem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260125
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260125,
					"content": "Tapi aku dulu pernah bilang kalau semua mesin ruin mengandalkan kekuatan kegelapan dalam inti mereka untuk bergerak. Dan inti Ruin Golem ini ... sudah tersegel di bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260126
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260126,
					"content": "Jadi meski kita masuk ke dalam ruang kendali, kita tetap tidak bisa mengaktifkannya dengan menggunakan cara yang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260127
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260127,
					"content": "Apalagi elevator ini sudah tidak bisa diaktifkan. Kita tidak bisa naik ke ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260128
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260128,
					"content": "Ugh, terus sekarang gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260129,
						730260131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260129,
					"content": "Coba dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260130
					]
				},
				{
					"id": 730260130,
					"content": "Hei! Meski aku punya lisensi penelitian tertinggi di Akademiya, tapi bukan berarti aku bebas merusak sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260132
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260132,
					"content": "Kata orang \"ketika satu pintu ditutup, pintu lain akan dibuka\", Khaenri'ah juga pasti mempertimbangkan kondisi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260133
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260133,
					"content": "Penelitian Akademiya menunjukkan bahwa mesin ruin yang awal juga punya sistem daya cadangan, mungkin karena kekuatan gelap yang mereka gunakan saat itu masih dalam tahap awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260134,
						730260140
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260134,
					"content": "Sistem daya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260135
					]
				},
				{
					"id": 730260135,
					"content": "Berbeda dengan inti yang bisa menyediakan energi yang hampir tidak terbatas, sistem ini dibuat dengan menggabungkan beberapa energi kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260136
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260136,
					"content": "Dan sumber daya ini diperoleh dari balok energi yang menyimpan energi dari Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260137
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260137,
					"content": "Berdasarkan teori dari peneliti Vahumana, sistem daya seperti ini sudah digunakan sebelum mesin ruin pertama diciptakan di Khaenri'ah kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260138
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260138,
					"content": "Aku sudah periksa sebelum masuk, Ruin Golem ini juga termasuk model awal, jadi dia juga pasti punya sistem daya cadangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260139
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260139,
					"content": "Ruang kendali inti ada di lantai bawah, kita harus pikirkan cara untuk ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260140,
					"content": "Langsung bilang saja selanjutnya bagaimana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260141
					]
				},
				{
					"id": 730260141,
					"content": "Uhm ... Ruang kendali inti ada di lantai bawah, kita harus pikirkan cara untuk ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260131,
					"content": "Artinya masih ada cara yang tidak biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260132
					]
				},
				{
					"id": 730260119,
					"content": "Mengembangkan penelitian akademis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260120
					]
				},
				{
					"id": 730260120,
					"content": "*huff* Kamu lupa ya kalau kita datang untuk periksa reruntuhan? Walaupun penelitian akademis juga penting, tapi kita harus pikirkan cara untuk aktifkan dia dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302605,
