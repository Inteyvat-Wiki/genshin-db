			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260601,
					"content": "Wah! Ternyata beneran bisa aktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260616,
					"content": "Bagaimana? Mesin di dalam Ruin Golem ini, baik dari perangkat relai maupun pintu mekanismenya, semuanya bisa disediakan dari balok energi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260602
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260602,
					"content": "Tapi kok kayak enggak terjadi apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260603,
					"content": "Aduh, ini karena sistem ini dibuat dengan menggabungkan beberapa relai energi kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260604
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260604,
					"content": "Kalau begitu, sistem energi ini baru bisa aktif kalau kita mulai dengan menggabungkan energi yang ada dari lantai dasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260605
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260605,
					"content": "Semua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260606
					]
				},
				{
					"id": 730260606,
					"content": "Kalau dilihat dari tingkat kerusakan Ruin Golem ini, beroperasi dengan kekuatan penuh sepertinya agak sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260607
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260607,
					"content": "Tapi saat kalian mengaktifkan perangkat relai itu, aku menemukan ini di ruang daya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260608
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260608,
					"content": "Sepertinya ini blueprint Ruin Golem ini, mungkin ini ditinggalkan orang yang bertugas untuk memelihara sistem di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260609
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260609,
					"content": "Menurut blueprint ini, sepertinya kita cuma perlu menghubungkan beberapa perangkat relai untuk mengaktifkan mesin ini ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260610
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260610,
					"content": "Setidaknya kita bisa mengaktifkan elevator dan naik ke ruang kendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260611
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260611,
					"content": "Kedengarannya enggak terlalu meyakinkan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260612,
					"content": "Yah, tidak ada jalan lain lagi sekarang. Lebih baik kalian coba hubungkan perangkat elevator dan mengaktifkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260613
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260613,
					"content": "Eh? Kamu enggak ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260614,
					"content": "Aku harus di sini untuk foto ... ah bukan, maksudnya untuk meneliti bagian dalam dari Ruin Golem, ini pekerjaan yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260615
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260615,
					"content": "Lagi pula aku juga tidak bisa banyak membantu. Kalau ada masalah teknis baru cari aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		},
