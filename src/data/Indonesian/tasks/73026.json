			},
			"dialogs": [
				{
					"id": 730261301,
					"content": "Aku sudah bilang harus mengikuti standar pengoperasian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261302,
					"content": "Kita juga tidak mengoperasikannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "Lengannya patah nih, jatuh! Paimon rasa mesinnya memang rusak deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261304,
					"content": "Baiklah, intinya aku akan mencatatnya sebagai kesalahan eksperimen, ugh ... semoga tidak memengaruhi keseluruhan laporanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261305,
					"content": "Bagaimanapun juga Ruin Golem ini kelihatannya sudah tidak bisa beroperasi, sudah tidak ada gunanya kalian tetap di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261306,
					"content": "Kalian datang karena ingin periksa kontaminasi reruntuhan, tapi sayangnya kelihatannya Ruin Golem ini sekarang sudah tidak ada gunanya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261307,
					"content": "Tapi mungkin ada kemajuan dari apa yang sudah dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261308,
					"content": "Kalau gitu aku tidak akan merepotkan lagi, lagi pula aku masih harus menyelesaikan penelitian lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261309,
					"content": "Cari aku kalau urusan kalian sudah selesai ... itu pun kalau aku tidak dihukum karena merusak Ruin Golem ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261310,
					"content": "Lalu aku juga bisa membantu kalian untuk melakukan penelitian terhadap Chaos Core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261311,
					"content": "Walaupun aku adalah penanggung jawabnya, tapi aku akan membagikan sebagian dana untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261312,
					"content": "Semua orang bisa memulai karier akademis selama punya rasa ingin tahu! Semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		}
