					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420909,
					"content": "Tapi ini adalah festival besar, masa kita tidak menerbangkan Lentera Xiao?",
