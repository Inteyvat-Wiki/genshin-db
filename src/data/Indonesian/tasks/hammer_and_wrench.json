			"dialogs": [
				{
					"id": 413421202,
					"content": "Oh, ini bisa dipakai, terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413421203,
					"content": "Masih ada sedikit pekerjaan yang tersisa... Bisakah kamu membantuku untuk pergi ke pelabuhan dan menghitung persediaan yang baru tiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413421204,
					"content": "Seharusnya di sana ada tiga kotak, semuanya tertumpuk di pelabuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413421205,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Kalau begitu mohon bantuanmu, aku akan menyelesaikan semua pekerjaan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				}
			]
		},
