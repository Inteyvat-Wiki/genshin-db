			"dialogs": [
				{
					"id": 413420602,
					"content": "Lentera Xiao itu diberikan oleh Siyu untuknya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420603,
					"content": "Apa kamu mendengarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Oh, aku sangat mengenalnya. Jadi tidak sulit untuk menebaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420606,
					"content": "Dia melakukan hal yang sama tahun lalu, setelah keluar berjalan-jalan, dia kembali dan bekerja untuk menancapkan paku di sisi perahu sepanjang malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420607,
					"content": "Aku tahu kenapa dia melakukan hal itu, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420608,
					"content": "Pengembara, bisakah kamu membantunya sebentar? Tidak ada salahnya menyibukkan diri saat hari festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420609,
					"content": "Baik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "Maaf merepotkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420611,
					"content": "Aku rasa dia sudah mau bekerja di kapal... cepatlah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Hammer Li"
				},
				{
