			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? Di-dia menerbangkan Lentera Xiao itu untukku? A-aku harus melihatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420502,
					"content": "Hahaha, dia pasti menuliskan harapan ini untukku, sejak aku kecil aku memang mengharapkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420503,
					"content": "Tahun demi tahun berlalu dalam sekejap mata. Waktu berlalu begitu cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420504,
					"content": "Tapi, kenapa dia memintamu untuk menerbangkan Lentera Xiao ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420505,
					"content": "Dia masih ada banyak urusan di rumah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Oh begitu, baiklah... tidak apa-apa, ini juga sudah cukup bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420508,
					"content": "Hidupnya Siyu sekarang pasti baik, baguslah kalau begitu... hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420509,
					"content": "Baguslah... maaf, aku masih ada banyak pekerjaan yang harus diselesaikan. Aku mohon pamit dulu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi \"The Wrench\""
				},
				{
					"id": 413420506,
					"content": "Dia bilang akan pulang untuk membantu suaminya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
