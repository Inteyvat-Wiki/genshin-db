				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Baiklah, ayo kita lepaskan Lentera Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "Mengirimkan Lentera Xiao ke siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "Oh pengembara, jadi begini, Wrench Wang selalu merawatku sejak aku kecil dan dia telah banyak membantu selama hidupku. Dia sudah seperti kakakku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "Namun pada hari festival pun, dia masih saja sibuk bekerja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "Aku ingin memberikan Lentera Xiao padanya, hehe. Kami berdua sudah berteman sejak kecil dan waktu kecil dia sangat suka melihat Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "Dia pasti akan sangat senang kalau diberi Lentera Xiao. Pengembara, bisakah kamu membantuku memberikan Lentera Xiao ini padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "Apakah kamu tidak mau memberikannya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Aku juga ingin memberikan sendiri, tapi masih banyak hal yang harus kukerjakan di rumah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "Sekarang aku harus pergi membeli barang, dan suamiku sendirian mengerjakan pekerjaan rumah. Aku harus segera kembali untuk membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "Jadi, mau tidak mau aku harus meminta bantuanmu. Tunggu nanti ada waktu, aku dan suamiku akan pergi melihat Wrench Wang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "Semoga pada saat itu Wrench Wang tidak sibuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "Akan lebih baik jika kamu memberikannya sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
