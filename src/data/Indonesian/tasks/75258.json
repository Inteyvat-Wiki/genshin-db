			"dialogs": [
				{
					"id": 752580101,
					"content": "Hah? Kok ada orang yang pingsan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Heeei! Kamu bisa dengar Paimon? Kamu baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Kalian membantu pria yang tergeletak di tanah kembali tersadar perlahan-lahan ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ow, ow, ow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580105,
					"content": "Hei, kamu kebanyakan minum ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Kepalaku sakit ... Kok aku bisa ... Biar kuingat-ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580108,
					"content": "Ah! Aku ingat! Kurasa aku dibuat pingsan seseorang ... tapi aku tidak lihat siapa orang itu. Tunggu, bukan kalian, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580109,
					"content": "Hei! Malah kami yang membantumu berdiri! Kamu seharusnya berterima kasih sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Oh, maaf ... Umm, aku kerja di bar Me & Dew. Awalnya aku mau mengirim beberapa barang ke pelabuhan di utara. Hmm ... Dan ada pedagang dari Nod-Krai yang membeli beberapa Aphimead dari kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580111,
					"content": "Barang-barangku! Oh tidak! Barang-barangku hilang! Apa mereka mencurinya? Tunggu, tidak mungkin KALIAN yang mencurinya, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580112,
					"content": "Kok kamu curiga terus sama kami sih?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Oh, iya juga ya. Maaf, maaf ... Pasti ini karena pikiranku belum jernih kembali. Terima kasih ya, kalian berdua. Aku harus kembali ke bar dan mengabari mereka apa yang terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580114,
					"content": "Kalau memang ada bandit, sebaiknya kamu menjauh dari pelabuhan utara. Jangan sampai kena bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karyawan Tak Sadar"
				},
				{
					"id": 752580106,
					"content": "Kamu perlu kuantar pulang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
}