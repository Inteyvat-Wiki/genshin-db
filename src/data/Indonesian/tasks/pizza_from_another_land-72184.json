					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840502,
					"content": "Pizza yang ditambahkan dengan bahan lokal dari Inazuma, aku benar-benar tidak bisa membayangkan rasanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840503,
