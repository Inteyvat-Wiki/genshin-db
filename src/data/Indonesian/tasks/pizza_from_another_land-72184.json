			"dialogs": [
				{
					"id": 721840301,
					"content": "Pengembara, kamu sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Bagaimana, apa kamu sudah menanyakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "Tentang tanggapan dari para pelanggan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Menggunakan Lavender Melon untuk membuat pizza... Itu tidak sulit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Bahan lain sudah siap. Hm, karena disarankan untuk \"menambahkan beberapa bahan lokal dari Inazuma\", maka aku akan menambahkan beberapa bahan lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Hm, Sea Ganoderma? Naku Weed? Hm... Bagaimana dengan Fluorescent Fungus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Mau kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Oh! Maaf, aku terlalu sibuk memikirkan bahan-bahan yang ingin kutambahkan! Sepertinya Lavender Melon di toko hanya tersisa sedikit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "Pengembara, bisakah kamu membawakan sebuah Lavender Melon untukku... Itu satu-satunya bahan yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Baik, mohon bantuanmu ya, aku hanya membutuhkan sebuah Lavender Melon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Apa masih ada bahan lain yang kurang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Bahan lain masih cukup. Tolong bawakan saja sebuah Lavender Melon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
