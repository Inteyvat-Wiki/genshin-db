					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840504,
					"content": "Pizza ini kelihatan... lumayan enak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "Terima kasih bantuanmu, Pengembara. Terimalah barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "Pasti akan kunikmati pizza ini dengan sepenuhnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
