			"dialogs": [
				{
					"id": 721840201,
					"content": "Hai, ada apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840202,
					"content": "Tentang pizza di \"Kiminami Restaurant\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "Oh, maksudmu pizza itu, rasanya cukup enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Tapi... aku tidak terbiasa dengan rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Aku merasa jika pizza itu ditambahkan dengan bahan lokal dari Inazuma seperti Lavender Melon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Mungkin rasanya akan lebih bisa diterima oleh banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
				}
			]
		},
