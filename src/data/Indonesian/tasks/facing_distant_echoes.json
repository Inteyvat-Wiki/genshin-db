			"dialogs": [
				{
					"id": 726550301,
					"content": "Hmm? Apa kamu perlu pemanasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Bisakah kamu mengatakan sesuatu tentang reruntuhan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Yah, aku kan Petugas Teknis, jadi aku tidak terlalu familier dengan sejarah benua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Namun, aku yakin reruntuhan ini ada hubungannya dengan bencana yang terjadi lima ratus tahun lalu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "Aku tumbuh dengan mendengarkan pelaut tua menceritakan kisah tersebut. Katanya baik laut maupun daratan tidak bisa kabur dari Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Namun bagiku, itu tidak lebih dari cerita hantu yang mereka ceritakan untuk menakut-nakuti anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Maksudku, hal yang menakutkan harus bisa dilihat oleh matamu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Apa kamu tahu sesuatu mengenai mesin misterius tersebut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
