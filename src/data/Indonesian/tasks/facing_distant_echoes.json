			"dialogs": [
				{
					"id": 726550101,
					"content": "Oh, sepertinya kita sudah melihat lokasi target kita! Bagus! Jadi sekarang aku bisa kembali tidur di atas kapal lagi, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "Apa? Kamu mau pergi begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Tentu saja tidak, kita sudah dekat sekali! Ayo pergi sekarang dan kita tangkap sebuah mesin Ruin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Huh, Paimon pikir kamu mau balik ke kapal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*huff* Yah, ah sudahlah. Ayo ikuti dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
