			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Kalau bisa buat roti yang enak, pasti bisa bikin semua orang jadi semangat. Tapi sepertinya agak susah dengan keadaan sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Ada masalah apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Begini, aku sedang berencana membuat roti jenis baru, roti berbentuk jamur yang dulu pernah dibuat ibuku waktu aku masih kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "Kalau tidak salah ingat, roti ini dibuat dengan isi saus yang terbuat dari Mushroom dan Berry, lalu dimasukkan ke dalam adonan yang sudah diuleni, kemudian dipanggang semuanya di dalam oven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "Dan yang paling penting adalah harus menggunakan Flour yang digiling dari gandum segar, karena dengan begitu roti yang dibuat baru bisa menghasilkan aroma yang menenangkan hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "Awalnya aku hanya ingin mengambil sedikit gandum, tapi mungkin karena rekan-rekanku tidak punya waktu untuk mengawasi ladang gandum di sini, sekarang malah ada banyak makhluk aneh di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "Kalau ada Tuan Valdis, pasti dia bisa menangani hal ini, tapi aku benar-benar tidak ahli untuk hal seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "Jadi kalau boleh, maukah kamu membantuku mengambil sedikit gandum? Hanya perlu sedikit saja. Sebagai gantinya, aku bisa ajari kamu cara membuat roti jamur yang enak. Kumohon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Eh, jangan pergi dulu, bisa tolong bantu aku tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
