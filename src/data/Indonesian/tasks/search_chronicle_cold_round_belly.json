			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Oh, kalian berdua datang juga! Aku sudah menunggu kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Sudah berhasil berteman sama Pyro Regisvine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Duh, jangan dibahas lagi deh. Setelah negosiasi kemarin, dia sih sudah tenang, tapi sebentar saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "Begitu kembali lagi, dia langsung mau seruduk aku lagi! Ngeri ah! Kayaknya kalian benar deh, agak tidak mungkin kalau mau berteman sama makhluk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Nah, tapi buahnya sih memang enak ya, ada rasa Pyro-nya. Kayaknya teman Natlan-ku bakal suka deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Hah? Rasanya gimana tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Mau coba? Kalau kalian mau, aku bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Eh, eng-enggak usah lah. Oh ya, jadi kapan mau tantang Primo Geovishap-nya nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Oh ya. Aku rasa kali ini bisa menang sih. Soalnya Primo Geovishap itu mirip sama Tepetlisaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Kalau kalian jalan-jalan ke Natlan dari Sumeru kayak aku, harusnya kalian bakal langsung ketemu mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Yah, pokoknya, Paimon sih enggak terlalu berharap banyak sama yang ini ya. Kok enggak mau sama si Hatchling-nya saja ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "Soalnya perutnya tidak bulat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "Perut Geovishap Hatchling tidak bulat. Pasti karena mereka gulirnya cepat banget. Makanya tidak bisa banyak timbun lemak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*huff* Tapi sebenarnya alasan utamanya itu karena kurang berdampak sih. Hatchling itu tidak ada apa-apanya kalau dibanding sama temanku yang punya Saurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Tapi kalau Primo Geovishap kan beda lagi. Meski cuma di cerita, tapi sudah pantas jadi lawan yang sepadan. Jadi kalau lawan dia, pasti bisa kelihatan kuat kan sebagai tokoh utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Oke. Jangan buang-buang waktu lagi, si Primo Geovishap sudah menunggu kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Ya sudah, ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Aku masih ada urusan lain. Dadah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Tidak masalah. Aku akan tunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}