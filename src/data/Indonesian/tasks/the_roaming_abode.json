			"dialogs": [
				{
					"id": 711050601,
					"content": "Eh? Harusnya di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Kok enggak ada orang, ya? Kayaknya di sekitar sini enggak ada jejak apa pun deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Jangan-jangan dia sudah balik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Kayaknya enggak mungkin banget deh. Kakeknya Xiangjun kan terluka, masa dia bisa jalan sejauh itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Tapi, di sini juga enggak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Apa dia ketemu orang baik di jalan, lalu ditolongin dan dibawa ke desa? Kata Paimon sih ada kemungkinan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Kita balik ke Desa Qiaoying buat tanya-tanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Ambil dulu \"air suci\"-nya deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Ha? Oh iya. Kalau kakeknya si Xiangjun berhasil ditolong, dia bakal perlu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Bisa dianggap kita sekalian bantuin dia juga lah. Hehe, {NICKNAME} baik deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
