			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paman Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "Oh, halo Pengembara,. Kulihat kalian lagi buru-buru, apa ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050802,
					"content": "Ah, kami ... Paman Luo tahu enggak rumahnya Xiangjun dan kakeknya di mana? Kami mau cari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun? Aku tidak pernah dengar nama ini. Dia orang sini? Harusnya aku kenal semua orang di desa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050804,
					"content": "Enggak pernah dengar? Enggak mungkin deh ... Kami ketemu anak perempuan di luar, dia bilang namanya Xiangjun dan rumahnya di Desa Qiaoying. Dia minta kami bantu dia cari kakeknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Dia juga punya satu rakit bambu yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Hmm ... rakit bambu sih di mana-mana juga ada, tapi nama Xiangjun ini ... aku yakin tidak ada orang dengan nama ini di desa. Kalian tahu siapa nama kakeknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050807,
					"content": "Kakeknya itu pengumpul tanaman obat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Pengumpul tanaman obat? Coba aku ingat-ingat dulu. Dulu di desa ini ada sih, tapi sudah meninggal tiga tahun lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050809,
					"content": "Sudah meninggal?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Dia bertemu monster di luar ... duh ... Tapi harusnya dia bukan orang yang kalian cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050811,
					"content": "Karena pengumpul tanaman obat ini memang kurang waras. Dia tidak pernah menikah, apalagi punya keturunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050812,
					"content": "Ini ... gimana sih sebenarnya? Kalau gitu, Xiangjun kemarin itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "Jangan-jangan dia siluman!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Tanaman obat apa yang biasanya dia petik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Bunga dan rumput yang tidak pernah aku lihat. Aku cuma paham soal teh, mana tahu kalau soal tanaman obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050816,
					"content": "Tapi aku ingat waktu kejadian itu dia ketemu di area Mt. Xuanlian. Waktu itu tangannya masih menggenggam erat sebotol air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050817,
					"content": "Dia bilang di halamannya ada tanaman dewa yang harus disirami pakai air suci supaya bisa tumbuh. Aku rasa dia benar-benar bodoh. Itu cuma air sungai, apanya yang spesial coba? Demi air itu dia sampai mempertaruhkan nyawa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050818,
					"content": "Yah ... tapi setelah dia dikebumikan, air itu kami siramkan ke pekarangan rumahnya. Semoga arwahnya tenang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050819,
					"content": "Air suci dari Mt. Xuanlian? Kami juga tadi sempat ambil loh di sana ... jadi kayaknya pengumpul tanaman obat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Orang yang sama deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Aneh sekali. Bagaimana kalau ... kalian ikut aku, aku antarkan kalian ke pekarangan rumahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Paman Luo"
				},
				{
					"id": 711050822,
					"content": "Dan kalau kalian sempat mengambil air, mungkin boleh tolong siramkan juga nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paman Luo"
				}
			]
		},
