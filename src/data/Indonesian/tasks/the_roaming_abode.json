			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"Aku bangun kesiangan! Aku harus cepat kembali sebelum besok. Kalau tidak, tidak ada yang jaga Xiangjun ... Bodohnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050202,
					"content": "\"Aku ingat ada jalan kecil dari Lembah Yaodie ke Mt. Xuanlian... Aku bisa sampai kalau lewat jalan kecil itu, lalu tembus satu gua ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050203,
					"content": "\"Katanya ada monster di sekitar, tapi mending coba dulu lah ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050204,
					"content": "Kayaknya ini punya si kakek deh. Dia kayaknya lewat jalan kecil! Yuk, cari jalannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
