			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"Meski awalnya aku khawatir ada monster ... tapi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050502,
					"content": "\"Mengalir banyak ... kakiku ... tidak bisa dihentikan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050503,
					"content": "\"Aku ngantuk sekali ... tapi Mt. Xuanlian sudah di depan mata ... Xiangjun ... aku pasti dapat air sucinya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050504,
					"content": "\"Xiangjun ... aku pasti bisa dapat air sucinya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Catatan Milik Entah Siapa"
				},
				{
					"id": 711050505,
					"content": "Gawat ... dia diserang monster, kayaknya lukanya parah deh ... Terus dia masih mau ke Mt. Xuanlian buat ambil air suci?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Kita cepat ke sana. Semoga masih keburu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
