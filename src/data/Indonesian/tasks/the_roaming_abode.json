			"dialogs": [
				{
					"id": 711050101,
					"content": "Kakek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Eh? Kenapa malam-malam sendirian di sini? Namamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Namaku Xiangjun ... aku ke sini cari kakek ... dia diculik siluman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "Si-Siluman? Di sini ada siluman? Yang kayak mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "A ... Aku juga tidak tahu ... kakek bilang ada siluman di gunung, jadi aku tidak boleh sembarangan keluyuran ... tapi, Kakek sudah naik gunung tiga hari dan belum pulang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Itu buat nakut-nakutin kamu saja, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Paimon juga ngerasa gitu deh ... Dia ada bilang enggak mau apa ke gunung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Kakek itu pengumpul tanaman obat di desa. Baru-baru ini Kakek nemu tanaman dewa yang katanya cuma bisa tumbuh kalau disiram pakai air suci dari Mt. Xuanlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Jadi ... apa mungkin kakek ketemu siluman penjaga air suci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Xiangjun, kamu enggak perlu cemas. Ini sudah malam banget, kakekmu mungkin cuma repot saja turun gunung. Kami anterin pulang, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Tapi, aku mau nolongin Kakek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "Kami bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Ya! Kalau kamu enggak mau pulang, mungkin bakal bikin kakekmu tambah repot loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Ah ... aku tidak boleh buat kakek tambah repot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Nah kan, biar kami yang cari dia saja, ya. Rumahmu di mana? Kami antar kamu pulang dulu yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "Enggak usah repot, rumahku di Desa Qiaoying kok. Aku bisa pulang sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "Apa kalian bisa langsung cari kakek? Aku takut dia kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Yah, boleh saja sih. Kamu tahu enggak kakek perginya ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Aku cuma tahu dia pergi ke arah sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Baiklah. Kami ke sana deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Terima kasih, kakak-kakak! Kalau begitu aku pulang sekarang deh. Aku tunggu di rumah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
