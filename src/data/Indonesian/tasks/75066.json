				]
			},
			"dialogs": [
				{
					"id": 750660401,
					"content": "Kamu masih di sini, pejuang pemberani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660402,
					"content": "Menurut para peneliti, tiran Kota Bara di zaman dahulu kala ... tahu ... cara untuk menghentikan korosi Abyss. Jadi kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660403,
					"content": "Tapi memang ada yang menakutkan dari tempat ini, wahai pejuang pemberani. Akhir-akhir ini, aku mulai merasa agak ... aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660404,
					"content": "Terkadang, sewaktu terbangun, kamu bisa melihat bahwa jalanan yang kemarin masih bagus, sekarang malah sudah hancur ... Terus apa rumah-rumah batu itu memang begitu bentuknya? Perasaan bentuk awalnya lebih utuh deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660405,
					"content": "Tapi terkadang, waktu aku terbangun, aku juga bisa melihat teman-teman yang seharusnya sudah tidak ada di sini lagi ... Apa mereka monster? Pasti begitu ... Mereka monster yang mengambil wujud teman-temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660406,
					"content": "Tugasku ... di sini adalah membasmi para monster itu, tapi ... kenapa? Kenapa aku harus melakukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660407,
					"content": "Pokoknya, tempat ini aneh. Kalian pergilah ... secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
