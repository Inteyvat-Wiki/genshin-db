			"dialogs": [
				{
					"id": 750660301,
					"content": "Kenapa kalian masih di sini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660302,
					"content": "Pemimpin tim petualang, pahlawan yang memakai topeng elang itu sudah ... Kami sudah tidak berdaya lagi melawan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660303,
					"content": "Kalian harus pergi secepatnya. Ini adalah tempat terkutuk, wahai pejuang pemberani. Ini bukan tempat yang boleh ditempati oleh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
