				]
			},
			"dialogs": [
				{
					"id": 750660201,
					"content": "Ah, tempat ini benar-benar terkutuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660202,
					"content": "Jangan berlama-lama di sini. Segeralah pergi dari sini ... Ya, kalian harus pergi sebelum gelombang gelap datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660203,
					"content": "Benar, gelombang gelap. Bayangan raksasa itu akan segera tiba. Kita harus ... memastikan bahwa semua orang bisa keluar dengan selamat. Semuanya ... harus keluar ... dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
