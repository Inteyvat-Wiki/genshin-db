				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "Kalian... Bagaimana bisa menemukan tempat ini? Jelas-jelas tempat ini sangat tersembunyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011202,
					"content": "Aku tidak tertarik dengan tempat persembunyian kalian. Aku hanya ingin bukuku kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "Punya waktu untuk membuat tempat persembunyian dan memasang segel, tapi tidak punya waktu untuk meminjam buku di perpustakaan dengan benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "Benar-benar cecunguk yang tidak bisa menghargai pekerjaan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "Oh, ternyata demi <color=#00E1FFFF>buku itu</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011206,
					"content": "Tidak disangka di Mondstadt ada orang yang berniat menggali rahasia di dalam buku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011207,
					"content": "Kamu, kamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011208,
					"content": "Aku adalah pustakawan. Bukankah sudah jelas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Tolong kembalikan buku itu. Ini peringatan terakhirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "Huh, karena kamu masih menyembunyikan identitasmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011211,
					"content": "... aku tidak punya alasan untuk menyerahkan buku itu padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011212,
					"content": "Karena buku itu berisi tentang \"rahasia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011213,
					"content": "Eh? ARGH!! Kamu, kamu mau apa?! Kekuatan elemental sekuat ini, apa kamu——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011214,
					"content": "AAARGGGHHH!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011215,
					"content": "Ku, kuat sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "Fuh... Orang yang tidak mendengarkan peringatanku memang harus diberi sedikit hukuman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "Lisa juga tidak mendengarkannya berbicara sampai selesai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "*fuhh* Sungguh pekerjaan yang merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "Baiklah, kita cari bukunya sekarang. Seharusnya buku itu ada di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "Ini sepertinya bukan hukuman yang sedikit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "Me, mengerikan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
		},
