			"dialogs": [
				{
					"id": 250340101,
					"content": "Dia tidak suka kalian, minggirlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Apaan sih? Bocah, kamu kenal Saurian itu? Dia temanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340103,
					"content": "Grrr ... Groarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Oh, dia mulai resah. Sana pergi, bocah! Kami tidak suka memukul anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340105,
					"content": "Bawa kantongnya, anak-anak! Saurian ini pasti bisa laku mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340106,
					"content": "Jangan mendekat! Jangan sampai aku pakai kekerasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "Ke-Kekerasan? Kamu??? HAHAHAHA! Dengar tidak anak-anak? Dia mau pakai KEKERASAN!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340108,
					"content": "Aduhhh, atut banget nich, atuuut! Bocah, berani buka mulut berarti siap terima risikonya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340109,
					"content": "Groar ... GROAR! GROAAAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Heh, Saurian ini galak juga ya. Baiklah, bocah, kamu tidur siang dulu ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340111,
					"content": "Yang harusnya tidur siang tuh kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "Kakak! Mereka mau menculik Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Groar, groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "Eh, ada orang iseng. Gimana kalau kamu minggir dulu? Kamu tidak ikut campur, kami tidak ganggu kamu. Tidak ada yang rugi. Enak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340116,
					"content": "Jangan macam-macam sama Qica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Ha, tidak bisa kompromi rupanya. Ya sudah, kita pakai aturan biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340119,
					"content": "Anak-anak! SIKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pencuri yang Tidak Sabaran"
				},
				{
					"id": 250340117,
					"content": "Mau ngatur? Sudah mampu bayar gajiku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Ingat, berani berbuat, berani tanggung jawab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
