					"id": 731041216,
					"content": "Hmm ... Memang aneh sih ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Hmm ... Tuan Kayvan, kalau kamu tertarik, aku bisa mengenalkan seorang peneliti yang ahli dalam hal memancing.",
