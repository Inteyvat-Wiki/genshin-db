					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Dia sudah membuat banyak desain umpan dan joran yang populer di pasaran sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "Aku tidak tahu sih kenapa kamu tidak pernah bisa dapat ikan. Tapi ... kan tidak ada salahnya berguru ke yang lebih profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Barangkali dia tertarik dengan kasusmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Maksudnya tertarik dengan fakta kalau aku tidak pernah bisa dapat ikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Tapi betul juga sih. Ini kesempatan supaya aku tahu sebenarnya ada apa denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Oke. Perihal rekomendasi, serahkan saja padaku!",
