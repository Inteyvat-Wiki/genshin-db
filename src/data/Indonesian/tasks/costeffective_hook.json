			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Tolong bantu aku, aku benar-benar butuh bantuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Tidak bisa. Silakan pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Wah, mereka kenapa sih kok ribut-ribut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "Halo, orang asing. Bisa bantu aku membujuk nona ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Hari ini dia tiba-tiba mencari dan menggangguku, lalu menyuruhku membantunya memancing beberapa barang antik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Dia bukan cuma menakuti ikan-ikanku, tapi dia juga sudah menghabiskan waktuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Nona, kenapa gayamu seperti sedang sangat terdesak sekali sih? Jangan-jangan kamu mau ambil untung dari barang-barang antiknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Bukan, Tuan Kayvan, aku Helbet dari pihak Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Akademiya menemukan barang antik dan bertanggung jawab untuk menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "Tapi kemarin kapal pengangkut barang-barang ini bermasalah dan mengakibatkan beberapa barang terjatuh ke dalam sungai hingga mengalir ke hilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Kalau begitu cari saja seorang profesional untuk mencarinya! Kenapa kamu mencari pemancing sepertiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Kalau cari mereka terlalu lambat, aku pernah diberi tahu tentang \"pemandangan di kail\", Tuan Kayvan sepertinya setiap hari selalu mendapatkan barang hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Dan kamu juga sering memancing di sini, jadi aku mau minta tolong padamu, siapa tahu bisa memancing beberapa barang antiknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Kamu benar-benar putus asa ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Ehem, Nona Helbet, aku turut bersimpati atas apa yang kamu alami, tapi aku hanyalah seorang nelayan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Pancinganku hanya untuk memancing ikan, tidak ada yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Jelas-jelas enggak pernah dapat seekor ikan pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Ehem! Aku selalu fokus melatih kemampuan memancingku dengan pemikiran seperti ini dan tidak pernah terpikirkan untuk menggunakan kemampuan ini untuk hal yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Jadi sebaiknya kamu cari orang lain saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "E-eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Kalau tidak ... begini saja, aku tidak akan memintamu untuk membantu mencari barang yang hilang. Aku cuma minta kamu ganti tempat memancing, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Kamu anggap saja ... anggap saja aku membayarmu untuk memancing ikan! Tolong ya, tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Kalian ini ya, aku ini seorang nelayan loh! Nelayan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "Ganti tempat memancing kedengarannya ide bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Tolonglah, lihat! Aku sudah menyiapkan imbalannya, bantu aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Kalian benar-benar keras kepala ya ... baiklah, anggap saja ganti suasana. Kamu mau aku memancing di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Terima kasih banyak, ikuti aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "Sama seperti dulu, Pengembara. Tolong bantu aku kumpulkan bahan untuk membuat umpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Coba kupikir-pikir ... bahan kali ini adalah Mint, tapi harus ambil dari tempatku biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Aku telah menandai area umumnya. Aku mengandalkanmu. Setelah kamu membawa bahan-bahannya, aku akan bahas tentang pembayarannya lebih rinci denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Aku akan mengikuti Nona Helbet ke tempat pemancingan, kita ketemu di sana nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Nelayan juga bisa memancing berbagai macam barang, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Kalau hasil pancingan Kayvan memang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Aku ini memancing untuk mendapatkan ikan, oke?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
