					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "Tapi apa benar peneliti kutu buku benar-benar tahu soal mancing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
