			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "Cepat sekali! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Tolong segera mulai, kalau tidak barang-barang itu ... eh ... ikan-ikan itu akan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "Jangan diburu-buru. Aku perlu merasakan aliran airnya dan melempar joran dengan pikiran yang tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040404,
					"content": "Biarkan aku coba, bisa dapat ikan sebesar apa di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040405,
					"content": "Kayvan membuat umpan dan mulai memancing.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Setelah lama menunggu, Kayvan mendapatkan sebuah bungkusan yang basah.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "Barang apa ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040408,
					"content": "Ini ... coba aku lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "Ini dia! Ini adalah salah satu barang antik yang jatuh ke air! Barangnya masih utuh dan tidak kemasukan hewan air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "Kamu benar-benar berhasil memancing barang antiknya! Kamu memang \"Pemandangan Luar Biasa di Ujung Kail\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "Itu maksudnya memuji ya? Aku sama sekali tidak bisa merasa senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Oke, barang antik di tempat pertama sudah berhasil didapatkan. Lalu tempat ... pemancingan ikan selanjutnya ada di sebelah barat dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "Ah, ayo kita cepat berangkat, biar aku juga bisa lebih cepat kembali memancing dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "Tidak masalah, ikuti aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "Pengembara, umpan khusus kali ini kita ganti jadi Harra Fruit saja. Perasaanku mengatakan kalau bahan ini sangat cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "Ada sebuah tempat yang punya kualitas Buah Harra yang sangat bagus, aku akan memberikan lokasinya padamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "Kami pergi dulu, nanti kita ketemu di lokasi selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
