			"dialogs": [
				{
					"id": 745230401,
					"content": "Angin ini ... membawa aroma ombak laut, aroma kayu dari kapal pedagang di kejauhan, dan juga ... aroma sahabat dari masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#Senang bertemu denganmu lagi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Kazuha, lama tidak jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "Armada Crux sedang berlabuh di Inazuma untuk mengisi persediaan. Karena jarang berkunjung ke tanah kelahiranku, jadi aku ingin jalan-jalan sebentar sambil melihat pemandangan kampung halaman sekali lagi, dan mendengarkan suara angin di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Angin di Ritou selalu lebih kencang dibanding di tempat lain, dipadukan dengan perpisahan dan pertemuan kembali, harapan dan kebimbangan ... sebuah tempat di mana kamu bisa mendengar banyak cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Aku boleh ambil fotomu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Hehe, segala sesuatu ada wujudnya, begitu pula dengan angin. Hanya saja, wujud angin hanya bisa terlihat sekilas di saat daun berguguran, ombak bergulung, atau saat jubah seorang pengembara berkibar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Aku berharap, melalui diriku, kamu dapat menangkap wujud angin yang hanya sekilas itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Baiklah, aku akan mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Kalau begitu, semoga kamu bisa menulis puisi yang sesuai dengan momen ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Cukup berpose seperti biasa saja dan rasakan embusan anginnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Aku juga ingin mengabadikan angin yang bertiup di saat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Kamu sedang apa di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
