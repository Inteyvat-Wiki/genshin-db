			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Paimon, kalian sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Kali ini kami berhasil ambil banyak foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "Bagus sekali! Terima kasih banyak atas bantuan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "Saat kalian membantu mengambil foto, aku mulai berpikir, aku tidak boleh diam saja ... Kalau tidak, aku jadi tidak akan bisa maju ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Jadi, aku memberanikan diri untuk minta bantuan beberapa orang yang lewat. Aku juga sudah berusaha keras mengambil banyak foto! Data pengujiannya seharusnya sudah cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Hmm, muridku memang hebat! Ini juga berkat {NICKNAME} yang mau membantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lepine-Pauline! Kamu kapan baliknya? Ninette bilang ke Paimon kamu lagi sibuk sama urusan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Tentu saja, itu bisnis besar yang bisa buat aku kaya raya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Beberapa waktu lalu aku memang sibuk banget, terima kasih sudah membantu Ninette ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Teknik dan selera artistiknya tidak perlu diragukan lagi, hanya saja dia agak pemalu. Berkat bantuan kalian, dia sudah bisa berani mengambil satu langkah penting ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310112,
					"content": "Kamu sebenarnya lagi sibuk apa sih? Kok kayak misterius banget. Jangan-jangan kamu denger rumor aneh lagi, terus mau masukin semua uangmu ke situ ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "Mana mungkin! Aku, Lepine-Pauline, sudah belajar dari pengalaman! Kali ini benar-benar proyek besar yang pasti untung, tidak akan rugi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Kenapa justru kedengaran mencurigakan ya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "Hehehe, tidak seru kalau aku kasih tahu sekarang. Nanti kalau sudah jadi, kalian pasti jadi yang pertama aku undang untuk mencobanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310103,
					"content": "Efek lensa \"Shutterflash\"-nya benar-benar bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
