				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "Ya ... beberapa lencana ini seharusnya cukup untuk penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Ini imbalanmu, mohon diterima ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "Pengembara, apa maksud tatapanmu? Aku jadi merinding ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "Ehem! Aku kembali bekerja dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
