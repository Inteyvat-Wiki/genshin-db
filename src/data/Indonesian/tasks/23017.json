						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "Pengembara! Kamu datang tepat waktu, aku baru saja selesai minum kopi dengan Kaia dan mau melanjutkan pekerjaan. Aku kenalkan padamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "Ini adalah orang yang kamu bilang dulu? Senang bertemu denganmu, aku Kaia, seorang ... hmm ... seorang penari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Halo, Garcia pernah menceritakan dirimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hihi, begitu ya? Baguslah kalau begitu, aku pikir dia cuma ingat dengan mesinnya dan Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Anda boleh menganggap saya sebagai pengecualian, Nona. Saya yakin Tuan Garcia juga pasti senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Tidak boleh, kalau tidak ada kamu, Garcia pasti akan cepat bangkrut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Maaf, tapi saya agak tidak setuju dengan ucapanmu ini, Nona. Saya percaya Tuan Garcia setidaknya pasti akan menyisakan uang untuk membeli dua gelas kopi apa pun yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Tiga gelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Saya selalu kagum dengan rasa peduli Anda, Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "A-Ayo kembali ke topik awal! Pengembara, aku sedang mencari beberapa lencana yang dibawa oleh Treasure Hoarder, kamu bisa menjualnya padaku kalau kamu menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Aku akhir-akhir ini juga ... mendapatkan sedikit uang, kamu tidak perlu khawatir masalah imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
