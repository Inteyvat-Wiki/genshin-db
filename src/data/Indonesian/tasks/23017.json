			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Halo? Uhm ... Kamu ingin tanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Kenapa kamu bisa kenal Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "Pertanyaannya blak-blakan sekali ya? Tidak heran sih ini memang khas seorang pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Aku mengenal Garcia karena... dia dipekerjakan sebagai staf akuntansi untuk rombongan kami oleh pemimpin kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Hahaha, sebenarnya aku belum pernah bertemu dengan seseorang sepertinya yang bisa cocok dengan kelompokku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Waktu kami sedang bermain musik, menari, minum, dan bernyanyi ... dia cuma berada di pinggir menghitung bersama Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Suatu hari, aku melihat dia memakai baju yang aneh dan ada suatu gambar di bajunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Aku penasaran dan bertanya padanya gambar apa itu, dia bilang itu adalah gambar desain dari beberapa mesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Dia bisa menggambarnya di baju karena tidak menemukan kertas waktu berdiskusi tentang mesin dengan orang lain dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Jadi dia menggunakan arang untuk menggambar desainnya di baju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Lalu kita terus berdiskusi mengenai baju yang tidak dicuci bersih itu dan mesin-mesin itu ... tentu saja, dia yang lebih banyak bicara, aku cuma mendengarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Hihi, dia memang orang aneh, tapi di saat yang sama ... juga orang yang berkarisma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
