					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260302,
					"content": "Pohon tenggerannya dalam kondisi baik. Aku yakin upacaranya pasti akan berjalan lancar kali ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260303,
					"content": "Ini mudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "Mengerikan juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "Hehe. Kami berdua kan petualang andal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260306,
					"content": "#Oh ya, {NICKNAME}, kamu berasal dari mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260307,
					"content": "Orang yang datang ke sini sebelumnya bicara tentang sebuah tempat bernama Inazuma dan Pulau Narukami. Apa kamu dari Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260308,
					"content": "Kalau kamu bilang begitu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "Eh, iya benar, kita memang datang dari Pulau Narukami sih ... Eh tunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260310,
					"content": "Paimon hampir saja lupa kalau kita ke sini kan buat ambil Maushiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260311,
					"content": "Kami berasal dari tempat yang sangat amat jauh sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "Iya benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260313,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260314,
					"content": "Wow! Kamu bahkan memanjat ke atas punggung seekor naga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260315,
					"content": "Yah, itu bukan hal yang nyaman untuk didiskusikan sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "Luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260318,
					"content": "Dunia ini luas sekali, Nak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260319,
					"content": "Aku tidak pernah tahu bahwa begitu banyak tempat di luar lautan kabut. Jika suatu hari nanti aku pergi dari sini, aku pasti akan melihat semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260320,
					"content": "Mereka selalu bilang bahwa jiwa kita akan tersesat jika meninggalkan kabut, dan kabut itu melindungi kita dari kegelapan yang ada di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260321,
					"content": "Tapi aku sudah bertemu dengan beberapa orang yang berasal dari luar. Karena itu aku tahu bahwa ada orang tinggal di Laut Sunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260322,
					"content": "Kalau ada kesempatan, kamu boleh ikut denganku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Baiklah! Sepakat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260324,
					"content": "Kalian berdua pergi saja duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260325,
					"content": "Saat upacaranya sudah berakhir, ayo kita jelajahi dunia di luar Pulau Tsurumi bersama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260326,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
