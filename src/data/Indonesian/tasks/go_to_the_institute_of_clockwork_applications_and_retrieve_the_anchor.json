			"dialogs": [
				{
					"id": 740880601,
					"content": "Iya ... Aku masih tidak bisa lupa kalau si Choiseul itu terus mengelak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "Terus si Raimondo ... sombong dan arogan sekali. Kamu lihat tidak cara dia melihatku tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Aku rasa kamu jauh lebih baik daripada mereka berdua. Kalau kamu ada di posisi mereka, pasti tidak akan ada kejadian seperti ini deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
