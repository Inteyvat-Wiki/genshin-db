			"dialogs": [
				{
					"id": 740880401,
					"content": "#Harusnya di sini ada Suar Survei. Akan kubuka pintunya, dan sisanya kuserahkan padamu ya, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
