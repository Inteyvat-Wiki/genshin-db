			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Aku percaya bahwa tempat ini tadinya adalah \"Institut Aplikasi Roda Gigi\" milik Butor. Dalam bidang mesin roda gigi, Monsieur Butor adalah salah satu pemegang otoritas terkuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Namun, secara akademis, pengembangan dan kemajuan mesin roda gigi tradisional telah mencapai batasnya. Dari segi pengaplikasiannya, mesin roda gigi tradisional jelas tidak begitu diuntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Jadi, program Monsieur Butor akhirnya dihentikan di Institut. Pendanaannya dipotong, dan dia kesulitan merekrut peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "Setelah beberapa insiden begitu, grup Monsieur Butor akhirnya dibubarkan, dan akhirnya tempat ini jadi ditelantarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "*huff* Monsieur Butor benar-benar tidak beruntung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408806,
