			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Eh, ternyata {NICKNAME} dan Paimon! Tidak kusangka akan bertemu kalian di sini! Pertanda baik nih, pertanda baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori! Kok kamu sendirian di sini? Lagi buka kios? Eh, tapi Paimon enggak lihat ada barang di kiosmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Maaf, tapi Dori sang pedagang keliling yang terkenal sedang tutup toko hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Aku sekarang sedang mempelajari orang-orang Nod-Krai, yang hidup santai dan bebas di \"utopia\" ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Serius? Dori yang bukan sedang sibuk berbisnis dan mencari Mora? Itu lebih aneh daripada hujan lebat di padang pasir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Meski aku sedang menikmati liburan yang langka, toko-toko dan karyawanku yang rajin masih menghasilkan Mora yang tidak ada habisnya untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Asalkan angka di rekeningku masih terus meningkat, aku tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Jadi, kalian berdua ada masalah apa? Meski aku masih liburan, tapi aku tidak akan pernah menolak pelanggan yang datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Oh, ternyata ingin mengabadikan pemandangan unik Nod-Krai! Kalian sudah bertanya ke orang yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Aku mungkin tidak seberapa familier kalau dibandingkan dengan orang lokal, tapi aku bisa kasih kalian banyak rekomendasi lokasi untuk merekam yang pemandangan unik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "Sebagai teman, aku akan menjadi pemandu kalian. Harganya akan juga diberi diskon teman, hanya 500.000 Mora sehari! Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Wah, Dori emang hebat. Bisa saja ada cara mendapatkan Mora dari kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Eh, aku hanya ingin membuat pelangganku yang paling penting bisa mendapatkan kenangan yang paling indah dan tidak terlupakan di Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Karena kamu seniat itu bantuin kami ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hmm? Foto? Foto aku maksudnya? Kedengarannya menarik. Tapi, jangan dipakai buat ngiklan loh ya. Hak cipta fotoku mahal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Tenang saja, kami cuma mau foto teman lama, buat kenang-kenangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Baiklah, baiklah. Karena {NICKNAME} yang minta, aku akan menjadi model untuk kalian. Tolong foto aku yang elegan dan menawan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Coba ... fotonya kasih keterangan \"Liburan Dori, Lord Sangemah Bay, di Utopia Petualang\". Bagus, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Boleh foto-foto tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
