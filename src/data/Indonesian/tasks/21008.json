					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Dataran Guili berada di atas berbagai formasi batuan, sehingga ada beberapa daerah sedikit lebih terjal, seperti lereng yang menuju ke arah Coast to Observatory di barat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "Tapi jalan menuju laut di daerah timur sangat rata. Kalau ada waktu, kamu bisa melihat Yaoguang Shoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
