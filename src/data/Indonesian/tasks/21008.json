					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Begini ceritanya. Temanku bertugas menambahkan bahan bakar, sedangkan aku bertanggung jawab menyalakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Walaupun kedengarannya sepele, tapi peran kita masing-masing sangat penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
