			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "Ada apa dengan obornya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "Oh, ternyata Pengembara. Coba lihat ke depan, apa kamu melihat Coast to Observatory? Obor di atasnya harusnya menyala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "Jalan di dataran Guili tidak mudah ditelusuri, banyak monster bersembunyi di dalam. Api obor yang menyala memberi penerangan untuk para pejalan kaki dan menandakan bahwa tidak ada monster yang mengancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "Tapi... Aku sibuk membereskan monster-monster dan lupa menyalakan api obor. Saat aku mengingatnya, semuanya sudah terlambat. Api obor telah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Ah, begini. Ada orang yang akan datang mengecek apinya. Aku mengulur waktu di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "Kalau kamu yang berdiri di sini, atau kalau di sini tidak ada orang, pasti keadaannya akan lebih gawat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "Jadi, tolonglah pengembara! Pergi dan nyalakan obor itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080201,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "Kalau begitu terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Di sepanjang jalan ini ada tiga Coast to Observatory, setiap menara mempunyai obor masing-masing. Setelah menyalakan mereka, kembali dan kabari aku ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "Di ujung jalan ada patung The Seven. Kamu bisa menyembahnya untuk mendapat perlindungan Lord Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "Biar bagaimanapun... Aku serahkan urusan ini kepadamu. Ingat untuk mengeceknya kalau melewatinya, jangan lupa ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
