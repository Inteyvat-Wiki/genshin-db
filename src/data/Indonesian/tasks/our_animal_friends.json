			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Oke, nanti makanan ini akan kami bungkus dan antar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Setiap hewan punya perilaku unik. Kami tidak mengurung mereka di kandang, tapi ada perawat khusus yang memonitor kondisi fisiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "Mencari hewan-hewan ini bukan perkara mudah. Harus pakai alat pelacak khusus buatan Nona Lamiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "Aku tidak begitu paham tentang ini, jadi lebih baik dia saja yang jelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Ya, biar aku bantu jelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "Teknologi di balik Inscribed Mirror berkaitan dengan Akasha, dan pengoperasiannya lumayan rumit, tapi ini sudah teruji dan dijamin aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "Kami sudah taruh pelacak mikro di tubuh hewan. Cukup lihat sinyal di alatnya, dan dia akan memperlihatkan semua yang dilihat oleh si hewan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "Alat ini bisa ditingkatkan lagi fungsinya, tapi data yang ada sekarang sudah cukup untuk melacak hewan aktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "Itu saja. Kalau sudah siap, selamat bergabung ke Barisan Cakar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "Pakai Inscribed Mirror untuk menemukan sobat berbulu kita. Hadiah dari pecinta hewan dan hewannya sendiri menunggu untuk disapa olehmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
