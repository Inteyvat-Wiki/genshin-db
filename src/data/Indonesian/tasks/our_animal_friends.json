			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "Silakan, selamat datang di himpunan pecinta hewan \"Barisan Cakar\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680102,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#Ah, {NICKNAME}. Apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680105,
					"content": "Himpunan kami ini lagi mengadakan acara. Berminat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680106,
					"content": "Acara apaan nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Gampangnya, kami mengajak orang bergabung ke Barisan Cakar, himpunan pecinta hewan yang disponsori oleh Feiyun Commerce Guild. Kami menampung hewan langka dan hewan terlantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680108,
					"content": "Feiyun Commerce Guild sudah bekerja sama dengan banyak sukarelawan dari berbagai bangsa untuk menyelesaikan masalah hewan liar, dengan cara adopsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680109,
					"content": "Berapa tahun terakhir ini kita berhasil ekspansi, makanya bisa mulai kerja sama dengan peneliti seperti Nona Lamiya di bidang perlindungan hewan langka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680110,
					"content": "Dan aku senang penelitianku bisa berhasil seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680111,
					"content": "Haha, kita sepikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680112,
					"content": "Berkat sukarelawan dan peneliti berpandangan jauh ke depan seperti Nona Lamiya, banyak hewan liar yang kini sudah punya rumah. Hewan langka juga dapat perlindungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680113,
					"content": "Selain dari Liyue, fasilitas Barisan Cakar ada di mana pun Feiyun Commerce Guild beraktivitas. Di Mondstadt ada, di Sumeru juga ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680114,
					"content": "Yah, acara ini kami adakan untuk menunjukkan rasa syukur dan terima kasih kepada para sukarelawan. Dan agar tahu berapa banyak sahabat kami di luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680115,
					"content": "Kamu bisa pergi ke tempat pengadopsian untuk lihat kondisi mereka. Dapat hadiah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680116,
					"content": "Hadiahnya disiapkan oleh karyawan dan pecinta hewan lainnya. Tentunya, kamu harus siapkan sesuatu juga untuk para pecinta hewan sebelum ambil hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680117,
					"content": "Nanti, semua hadiah akan diambil oleh staf profesional dan diantarkan ke pengadopsi yang aslinya. Tidak usah mahal-mahal, yang penting niatnya tersampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680118,
					"content": "#Gimana, {NICKNAME}? Tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680119,
					"content": "Boleh dilihat dulu lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "Bagus! Pasti luar biasa jadinya kalau orang terkenal sepertimu ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680122,
					"content": "Kalau sudah siap, langsung serahkan hadiahnya. Staf kami akan menyerahkannya ke orang yang dituju setelah acara selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680123,
					"content": "Menurut pengalamanku sih, beberapa dari mereka memilih barang khas wilayah tertentu, dan ada juga yang suka makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680120,
					"content": "Aku ikut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
