					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "Hebat juga kamu, orang asing! Awan-awan mulai tersingkap, sepertinya dugaanku ada benarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Selanjutnya masih ada dua jimat penangkal yang harus diperbaiki, di Serpent's Head dan Jakotsu Mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Kalau kamu tidak keberatan, aku ingin meminta bantuanmu mengurus dua jimat penangkal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Terima kasih atas bantuanmu, meski aku bukan orang kaya, tapi aku jamin akan memberikanmu imbalan yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Meski tidak tahu kapan ini bisa berhasil, setidaknya kita sudah semakin dekat untuk bertemu kembali dengan orang yang kita cintai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Oh ya, kalau kamu sudah selesai di sana, temuilah aku di bagian barat pulau. Invasi pemberontak juga pernah terjadi di Fort Mumei, bisa jadi ada hubungannya dengan kejadian aneh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
