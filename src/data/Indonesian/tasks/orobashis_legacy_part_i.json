			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Kamu menatap kota itu, tiba-tiba, sebuah energi aneh seperti menyerbumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Sentuh Jimat Penangkal"
				},
				{
					"id": 721290202,
					"content": "Kamu menyadari bahwa energi itu tidak menolakmu, tetapi menginginkan sesuatu darimu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Sentuh Jimat Penangkal"
				},
				{
					"id": 721290203,
					"content": "Oh... sepertinya masih ada yang kurang dari jimat penangkal ini, ayo kita coba cari ke sekeliling?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Coba pakai Elemental Sight buat melacak jejak Elemen yang terpencar di sekitar sini, siapa tahu bisa ketemu sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
