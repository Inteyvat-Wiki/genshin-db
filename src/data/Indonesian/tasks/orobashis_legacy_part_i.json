				{
					"id": 721290601,
					"content": "Apa? Cepat sekali sudah diperbaiki jimatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Oh, tidak apa-apa, pelan-pelan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "Sedang kuusahakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Tak usah dipaksa kalau memang tidak bisa, jangan tinggal terlalu lama di tempat berbahaya seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
