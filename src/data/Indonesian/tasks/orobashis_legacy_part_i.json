			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "Lentera dari batu dengan bentuk yang aneh seperti memancarkan energi yang mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721290102,
					"content": "Lentera dari batu ini sangat aneh... membuat orang merasa sangat tidak nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Eh, sepertinya ada tulisan di pinggir lenteranya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Para pengembara, kalau kamu punya pertanyaan tentang kota ini, silakan pergi ke Musoujin Gorge dan berbicara dengan Tuan Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721290105,
					"content": "Kelihatannya tulisan ini masih baru, dan sepertinya baru ditulis. Ada beberapa kata yang agak buram karena terkena hujan:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721290106,
					"content": "\"...Tolong beri tahu Tuan Kaji, kami sudah mencoba... tapi sayang sekali... mungkin bisa menemukannya di sekitar sini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721290107,
					"content": "\"...Tolong katakan pada Tuan Kaji untuk segera pergi ke tempat penampungan secepatnya. Keluarganya sangat merindukannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721290108,
					"content": "Sepertinya Kaji sangat peduli dengan lentera dari batu. Apa kita pergi saja ke Musoujin Gorge dan tanya ke dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
