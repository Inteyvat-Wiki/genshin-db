			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea ... adalah senior yang aku hormati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Setelah kakek meninggal, para tetua memilih aku menjadi kepala suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "Aku sering punya ide-ide baru yang agak gila, jadi orang-orang yakin aku bisa memimpin suku ini menuju masa depan yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Tapi untuk waktu yang sangat lama, aku bahkan tidak tahu harus berbuat apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Tapi Tante Atea selalu ada menyemangati. Setiap ada salah, dia tidak pernah bikin aku merasa bodoh. Dia akan bantu menganalisis salahnya, supaya lain kali bisa lebih benar dan tidak salah yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "Aku sangat menghormatinya, jadi ... aku akan ingat teladannya, dan terus bekerja keras untuk jadi kepala suku yang layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
