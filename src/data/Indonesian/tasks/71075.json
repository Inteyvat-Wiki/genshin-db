			"dialogs": [
				{
					"id": 710750101,
					"content": "Eh, kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Si Erge ya, sudah cari sekian lama masih belum ketemu. Tapi kamu kan lebih hafal tempat ini, harusnya bisa dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Belum ketemu? Tinggal tunggu orang yang bisa nemu, suruh dia, lalu rampas temuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "Aku dijuluki \"Bocah Tua Qingce\" oleh orang-orang dunia persilatan. Tidak ada penambang di Chasm yang berani menghalangi aku, dan kalau ada, aku mana punya muka untuk keluar! Sudah, cepat kasih barangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Harta karun Millelith, biar kami Treasure Hoarder saja yang simpan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Aku tidak peduli kalian cari apa, tapi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "Kau kira kami bakal percaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "Hmph. Kukira kalian lebih kekar, soalnya setiap hari naik turun Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Pilih, mau dibikin babak belur dulu, atau mau sukarela kasih Ketopong Berkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "Mending kamu jangan coba-coba cari gara-gara sama aku lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Wuih, nyalinya gede juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Rasanya kamu perlu dikasih pelajaran ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
