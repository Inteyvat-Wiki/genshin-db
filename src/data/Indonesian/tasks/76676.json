			"dialogs": [
				{
					"id": 766760101,
					"content": "Bagus, bagus! Harus kuakui, sejauh ini pertukaran ini benar-benar sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760102,
					"content": "Teman-teman kita dari Sumeru sudah menguasai tarian Natlan ... Tarian kita berpotensi mendunia di seluruh Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760103,
					"content": "Aku harap kita bisa gantian saling berkunjung dan menjadikan pertukaran ini sebagai tradisi rutin ke depannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760104,
					"content": "Jadi, Saurian dari Natlan juga bisa menari sama pedang kayak Eremite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760105,
					"content": "Ada juga \"tarian pertempuran\" yang legendaris ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "Hah? Maksudmu ... intimidasi yang dilakukan Uncle Scimitar dan yang lainnya untuk menakut-nakuti Consecrated Red Vulture waktu Nusta pertama kali bertemu dengannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760108,
					"content": "Dia tidak memberitahumu dari mana asalnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760109,
					"content": "Ada. Apa ya nama tariannya ...? \"Duet Flame-Mane dan Pengawal Heron\"? Nama yang menggabungkan keanggunan dan kekuatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760110,
					"content": "Ooh, kedengarannya familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760111,
					"content": "Aku jadi ingat dua orang teman ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#{NICKNAME} dan Paimon pasti sudah menduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760114,
					"content": "Area kalian bertemu dengan Consecrated Red Vulture itu kebetulan dekat dengan jalan yang sering dilalui iring-iringan Pemangsa Membara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760115,
					"content": "Beberapa waktu lalu, waktu rombongan yang mengawal Kak Dehya dan Kak Candace kembali ke Desa Aaru, mereka juga bertemu dengan sekawanan burung bangkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760116,
					"content": "Terus, mereka berdua menjadikannya \"pelampiasan\" karena merasa belum cukup olahraga selama perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760117,
					"content": "Sejak itu, setiap kali anggota Pemangsa Membara meniru aksi Dehya dan Candace, kawanan Red Vulture akan langsung terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760118,
					"content": "Sudah kuduga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760119,
					"content": "Kurasa mereka benar-benar apes hari itu bisa ketemu Dehya sama Candace dua-duanya sekaligus ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760120,
					"content": "Salah sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "Bagus! Sayang sekali aku melewatkan kesempatan untuk belajar dari kedua jagoan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760123,
					"content": "Waktu kita ke Sumeru lagi nanti, kenalin aku sama mereka ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760124,
					"content": "Aku mau tanya-tanya ke mereka soal teknik tinjunya, terutama cara mereka mengatur irama waktu melemparkan tinju mereka yang cepat dan kuat banget itu. Tenaga mereka tersalurkan dari telapak kaki, ke paha, lalu ke pinggang dan dada, baru terakhir ke tangan dan tinju mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760125,
					"content": "Aha, kalau waktunya tiba nanti, kalian pasti masih bisa minum sampai puas deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760126,
					"content": "Aku siapkan sesuatu biar kalian tidak mabuk deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760121,
					"content": "Kerja bagus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "Kurasa aku bisa tebak apa yang terjadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "Yang bisa menakuti Red Vulture ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
}