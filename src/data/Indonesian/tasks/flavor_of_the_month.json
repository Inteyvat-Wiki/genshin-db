			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Sebenarnya, aku sedang berencana untuk membuat sebuah masakan baru yang sesuai dengan tema dari Festival Windblume — secara spesifik, \"cita rasa angin\", dan sekarang aku sedang menyiapkan bahan-bahan yang diperlukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "Aku sudah meminta tolong Allan untuk pergi ke Brightcrown Canyon dan membantuku berburu daging yang paling segar, tapi dia belum kembali juga sampai sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "Kalau begini terus, bahan-bahanku sudah tidak akan segar lagi. Bisakah kamu membantuku untuk pergi ke Brightcrown Canyon dan memantau situasi di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Terima kasih! Aku akan membiarkanmu mencicipi masakan baruku saat kamu kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
