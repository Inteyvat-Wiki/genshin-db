				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Terima kasih. Semua bahan-bahannya sudah terkumpul semua sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000902,
					"content": "Oh iya, ini untukmu. Ambillah sebagai ucapan terima kasihku untuk bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000903,
					"content": "Tapi bagaimana cara kita mempersiapkan makanan yang memiliki \"cita rasa angin\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000904,
					"content": "Direbus, digoreng... Hmm, tidak. Kita masih harus tetap mempertahankan rasa asli bahan-bahannya, lalu menaburkan Dandelion Seed di atasnya sebelum disajikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
