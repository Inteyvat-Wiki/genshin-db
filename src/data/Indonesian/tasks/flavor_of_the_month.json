						"rawParams": [
							"7080006",
							"2"
						],
						"stepId": 7080006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "A-aku selamat... Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "Aku tidak pernah menyangka kalau berburu seekor boar akan sesulit ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "Jadi, tentang bahan-bahan yang Brook inginkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Oh, Brook yang menyuruhmu ke sini? Oke, aku sudah dapat Raw Meat segar yang dia mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "Tapi aku ceroboh saat mengejar boar tersebut dan tidak sengaja membuat monster yang ada di sekitar menyadari keberadaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "Aku berhasil mendapatkan raw meat-nya, tapi aku juga terkepung oleh monster-monster itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "Pengembara, maukah kamu mengantarkan daging ini untuk Brook? Karena aku harus ke kota dan mendapatkan perawatan untuk lukaku dulu di Katedral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "*huff* Ah, aku sudah menduga apa yang ingin Draff katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080007",
							"2"
						],
						"stepId": 7080007,
