			"dialogs": [
				{
					"id": 708001001,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "Kamu... Oh, aku ingat. Kamu asisten Xiangling, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001003,
					"content": "Pertandingan memasak saat itu masih kuingat dengan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001004,
					"content": "Aku kalah dengannya waktu itu. Tapi kali ini aku akan membuat sebuah masakan dengan \"cita rasa angin\". Setelah itu, aku akan mengajaknya bertanding lagi dengan mengandalkan masakan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001005,
					"content": "Demi masakan ini, aku sudah meminta seorang petualang untuk pergi ke Dragonspine dan mengambil Chilled Meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001006,
					"content": "Tapi petualang itu — Schuster namanya... sampai sekarang dia belum kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001007,
					"content": "Dengar-dengar Dragonspine adalah tempat yang berbahaya. Apa mungkin petualang itu sedang kesulitan...? Apa kamu bisa membantuku mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001008,
					"content": "Tidak masalah, aku bisa melakukannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "Terima kasih sudah mau membantu. Jangan lupa jaga kehangatan tubuh dengan api unggun ya, suhu di Dragonspine sangat dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
