			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "Ah, kalian sudah kembali. Apa kamu sudah membawa Raw Meat-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Hmm, coba kulihat... Kelihatannya masih sangat segar. Kurasa raw meat ini masih bisa digunakan. Daging ini akan kugunakan sebagai bahan utamanya... Lalu, kita tinggal menyiapkan sedikit bumbu yang bisa mengangkat \"cita rasa angin\" itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000704,
					"content": "Dan kalau kita membicarakan hal itu... Tentunya hanya \"Dandelion Seed\" yang aku maksud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000705,
					"content": "Pengembara, maukah kamu membantuku untuk mengumpulkan beberapa Dandelion Seed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000706,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Baguslah! Kuserahkan padamu. Sementara itu aku akan menyiapkan daging ini. Bawa Dandelion Seed itu kembali ke sini begitu kamu sudah berhasil mengumpulkannya, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
