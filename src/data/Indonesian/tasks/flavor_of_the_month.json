					"Terrified Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "A, akhirnya aku terselamatkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001302,
					"content": "Ka, kamu yang buat apinya? Te, terima kasih, pengembara yang baik hati... Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001303,
					"content": "Apa kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Akhirnya aku merasa hangat juga. Aku akan baik-baik saja... Aku sebenarnya mendapat misi untuk mengambil Chilled Meat di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001305,
					"content": "Aku mulai mencari Chilled Meat di pinggiran Dragonspine. Tak lama kemudian, aku menjatuhkan sumbu apiku dan tersesat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001306,
					"content": "Kalau kamu tidak datang, entah apa yang akan terjadi padaku. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001307,
					"content": "Tentang misi Brook...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Ah, jadi Brook yang mengutusmu untuk mencariku. *huff* Dia pasti sudah tidak sabaran lagi. Tapi aku sepertinya tidak sanggup lagi mengantarkan daging ini untuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001309,
					"content": "Aku merasa tidak enak sih, tapi Pengembara, apa kamu bisa membantuku mengantar Chilled Meat untuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001310,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Terima kasih banyak. Aku harus pergi ke perkemahan di kaki gunung untuk mendapatkan semangkuk sup panas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				}
			]
		},
