				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Wow! Berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "Yah, kulihat kamu memangnya sudah mahir, memangnya jago memanah. Orang biasa seperti aku sudah latihan bertahun-tahun juga tak bakal bisa unggul dari kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Dan karena aku berlatih memanah di tempat sial ini setiap hari, aku sudah lama tidak lihat unagi hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Kamu suka unagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Begitu ya. Aku suka banget unagi sampai ingin buat tambak sendiri. Mereka lucu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Tentunya, unagi jadi semakin lucu kalau sudah dihidangkan di atas piring. Bentuknya indah, rasanya juga nikmat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Karena suka unagi, aku jadi ingin punya tambaknya. Latihan memanah demi bisa membuat budidaya unagi. Tujuan utamaku malah jadi terasa sedikit melenceng tidak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "Tapi dipikir-pikir lagi, aku lebih doyan unagi liar. Jadi buat apa juga sampai perlu membuka tambak segala ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "Ah iya, terima kasih sudah membantuku. Ini buat kamu, semoga beruntung ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Tidak sedoyan itu juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}