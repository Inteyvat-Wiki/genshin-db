			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Sudahlah, mungkin aku kurang beruntung hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Hasil latihan memanahku semakin hari semakin buruk saja, kalau terus menerus seperti ini, lama-lama mendingan kutembakkan saja anak panahnya sekalian ke lututku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Kenapa kamu latihan memanah di tempat seperti ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "Hah, ini semua gara-gara Jibashiri itu, dia yang menyarankanku melakukan hal ini! Dan sekarang aku penasaran ... apa mereka adalah orang yang senang tertawa di atas penderitaan orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Omong-omong, apa kamu paham soal budidaya unagi? Latihanku rasanya tidak ada kemajuan, mungkin sudah waktunya aku beralih profesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "Memangnya apa bedanya Unagi yang di tambak sama Unagi yang ditembak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Oh, lupakan saja perkataanku barusan. Kelihatannya kamu tidak tahu apa-apa soal budidaya unagi itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Kalau mau budidaya unagi, kamu harus cari bibit unagi dulu. Tapi bibit unagi terlalu kecil untuk dilihat dengan mata telanjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Lalu kupikir karena para pemanah bisa menembak target yang jauh, penglihatan mereka pasti sangat bagus. Jadi aku tanya Jibashiri yang dekat denganku, bagaimana caranya melatih penglihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "\"Akashi, latihan itu harus bertahap. Kalau dasarnya kuat, kemajuanmu pasti juga akan lebih stabil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "\"Bibit unagi sangat kecil dan gerakannya tidak menentu. Tentu saja kamu harus mulai dari target yang diam. Target yang terlalu dekat juga tidak berguna, kalau mau bisa, kamu harus niat dan harus serius.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Aku terima sarannya lalu berlatih memanah di sini, tapi sampai saat ini belum ada hasilnya. Memangnya ada ya, yang bisa menembak target sejauh itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Barangkali kamu mau coba? Kalau iya, kamu boleh berdiri di atas batu yang di depan itu, nanti targetnya akan kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Oke, lihat nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Kalau begitu biar kulihat kebolehanmu! Kalau berhasil, jangan lupa balik lagi ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
