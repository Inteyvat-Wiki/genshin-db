			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "Halo, kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "\"Pekarangan bunga\" yang tempo hari benar-benar indah. Kalian berdua berbakat, cepat sekali belajarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "Silakan, ini tema barunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Baiklah, langsung saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "Asyik! Langsung saja, kami sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "Haha, mata kalian berbinar-binar, nyaris seperti lautan bunga yang cerah. Bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "Baiklah, tema hari ini akan sedikit lebih sulit. Bagus buat kalian pakai latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "\"Lembut namun kokoh, teratai di batas air\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Silakan renungkan makna temanya dan pilih bunga yang paling cocok dan bagus untuk \"pekarangan bunga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "Aku masih ada urusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "Tidak apa. Ikebana perlu konsentrasi penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Selesaikan dulu saja semua urusan yang ada. Nanti kalau sudah bisa fokus sepenuhnya, aku yakin hasil pekarangan bunga kalian juga akan sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268801",
							"2"
						],
						"stepId": 7268801,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268803",
							"2"
						],
						"stepId": 7268803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Selama beberapa hari ke depan, aku akan diam di sini dan membimbing tamu-tamu Festival Irodori, agar mereka dapat menikmati indahnya \"pekarangan bunga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "Jangan lupa, datanglah ke sini setiap hari untuk dapat tema baru. Total ada empat tema yang bisa kamu selesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "Kalau masih ada pertanyaan, silakan. Aku jawab semampunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "Tentang bunga-bunga yang ada di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Bunganya semua dari Sakuya's Flowers. Kualitas mereka bagus dan harganya juga murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "Mungkin kamu sudah pernah ketemu sama Sakuya. Dulu kami satu perguruan ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sakuya juga mahir seni merangkai bunga, tapi waktu dia dengar bakal ada banyak orang di Festival Irodori, dia jadi gugup lalu urung datang. Katanya susah konsentrasi di lingkungan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "Jadi, aku yang mewakili dia mempromosikan Sakuya's Flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "Kami akan bantu kalau diperlukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "Baiklah, ada pertanyaan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Terima kasih, Nona Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Tidak perlu sungkan. Silakan datang lagi kapan pun kalian ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "Tentang Yashiro Commission ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "Yashiro Commission selalu mendukung seni merangkai bunga di Inazuma. Sponsor kami di acara kali ini juga sang Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Beliau sendiri sangat berbakat di bidang ini sedari kecil. Dulu aku pernah menontonnya membuat ikebana, bahkan sempat bertukar pikiran dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Usiaku memang lebih dewasa darinya, tapi kemampuan ikebana maupun pemahamanku mengenai seni merangkai bunga jauh tak sebanding dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Ketika kondisinya memungkinkan, dia selalu menyediakan dana untuk memasarkan ikebana setiap tahunnya. Aku dengar dia bahkan rela pakai uang tabungannya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Dia juga pernah bilang kalau dia ingin agar ada lebih banyak orang yang bisa memahami ikebana. Dan itulah alasan kenapa dia rajin mempromosikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Oh, Ayaka ternyata punya peran besar yah dalam seni merangkai bunga di Inazuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "Semoga keinginannya bisa terwujud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Terima kasih. Kalian berdua orang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "Untuk sekarang segitu dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Silakan datang lagi kapan pun kalian ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
}