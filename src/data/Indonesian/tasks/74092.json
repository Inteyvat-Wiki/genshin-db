			"dialogs": [
				{
					"id": 740920101,
					"content": "Kenapa ... harus begini sih ... Keterlaluan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Nona Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! Kamu di sini toh! Bagus ... Kamu ... setidaknya kamu tahu kebenarannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Tenang dulu, Nona Chronie. Kamu ... baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Kalau ... Kalaupun artikelku tidak dipublikasikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Ada apa dengan artikelmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Iya! Kami penasaran kapan kami bisa lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Tidak lihat ya ... Oke tidak lihat, bagus, kalian berdua mungkin tidak lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Kok kamu ... kayak yang grogi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Jadi ... Sejak aku kembali dari Institut Penelitian Fontaine, aku mulai tulis artikelku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Aku tulis semua yang kulihat, semua yang kudengar, dan kutulis dalam bentuk draf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Seperti misalnya bagaimana Institut ternyata tidak pernah benar-benar menghapus Arkhium, tapi malah memulai proyek penelitian Arkhium lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Seseorang yang pernah bekerja dengan Edwin diutus untuk menjelajahi reruntuhan Institut, tapi dia meninggal dalam ledakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "Teknisi Senior Raimondo menolak untuk mengonfirmasi kematiannya dan malah bilang kalau ledakan itu bagian dari rencana proyek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Ditambah lagi mesin raksasa yang tidak terkontrol di reruntuhan itu, juga air yang berpolusi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "Semua yang ingin ditutup oleh Institut Penelitian Fontaine, sudah kutulis rinci di artikel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Tapi ... setelah kuserahkan, eh katanya Institut malah menuntutku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Berdasarkan regulasi editor, semua yang kulaporkan tentang Institut Penelitian Fontaine di dalam artikel harus ditinjau dulu kredibilitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Dan artikelku tentang Institut Penelitian Fontaine jadi ditolak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "Ditinjau kredibilitasnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Tidak, ini bukan soal laporannya, tapi soal akunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "Singkatnya, Institut Penelitian Fontaine menuduhku memasukkan pandangan emosional yang subjektif ke dalam laporan karena masalah pribadi dengan Institut dan menyebarkan info yang melenceng ke publik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "Tapi ... memang kamu ada konflik kepentingan apa dengan Institut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Dia cuma ambil beberapa foto batu dan mesin yang rusak ... Memangnya bakal ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "Mungkin karena kamu ekspos tindakan mereka yang tidak benar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Mereka ... Mereka menuduhku membocorkan rancangan terakhir Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Mereka bersikukuh bahwa foto yang kuambil di reruntuhan itu membocorkan bagian dari rancangan Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Mereka pasti periksa satu per satu fotonya dengan teliti. Kayaknya mereka tidak akan tarik tuntutannya deh dan aku harus melanjutkan tinjauan kredibilitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "Ini jelas rencana untuk mencegah artikelku agar tidak tersebar ke publik ... tapi aku tidak akan menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "Ini, ambil ini! Ini salinan dari koran yang aku cetak diam-diam. Aku akan bagikan salinan ini lebih banyak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Aku harus beri tahu kepada semua orang kebenaran di balik Institut Penelitian Fontaine, dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Nona Chronie! Kamu sedang apa di sini? Aku cari kamu ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Oh, ada yang datang. Aku tidak bisa terus berdiam diri di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Ini salinannya, simpanlah. Aku menulis semua kebenarannya! Semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Berdasarkan aturannya, kamu harus pergi ke Maison Gestion untuk tinjauan rutin sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Hei, tolong jangan kabur ya, Nona Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "Ini cuma Fonta, dan ini mungkin cuma salah paham! Kalau bisa dijelaskan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Tunggu! Berhenti, Nona Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Memangnya laporanmu tidak bisa dipercaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Kamu sedang apa di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}