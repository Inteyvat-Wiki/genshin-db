			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Ah, kalian! Makasih ya sudah bawakan Ukiran Berwarna-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Tapi menafsirkannya enggak segampang itu ya, ternyata. Kemiripannya dengan Ukiran Phlogiston cuma dari penampilan luarnya saja ... ini jauh lebih rumit dari bayanganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Tapi sudah tidak bisa mundur lagi ... harus beres, gimana pun caranya! Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
}