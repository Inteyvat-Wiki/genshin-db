					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "Aku hanya ingin membantu meringankan bebannya. Menceritakan hal ini kepada dia malah akan menambah bebannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "Tenanglah, seperti yang kukatakan, aku akan pergi sekarang. Lihat saja, tidak ada yang perlu dikhawatirkan bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "Sampai jumpa lagi... Mungkin saja kita akan bertemu lagi.",
