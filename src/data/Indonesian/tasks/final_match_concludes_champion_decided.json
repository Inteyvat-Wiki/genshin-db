			"dialogs": [
				{
					"id": 765120101,
					"content": "#Sejauh ini, {NICKNAME} harusnya sudah tahu hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120102,
					"content": "Uhuk, biar aku ingat-ingat lagi skripnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120103
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120103,
					"content": "Pertempuran yang luar biasa ini akhirnya berakhir, sekarang saatnya mengumumkan hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120104
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120104,
					"content": "#Kami persilakan penguji akhir kami {NICKNAME} untuk memilih juara menurut pandanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120105
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120105,
					"content": "#Kali ini {NICKNAME} yang tentuin siapa juaranya? Wah ... ini pertama kalinya {NICKNAME} jadi juri paling penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120106,
						765120112,
						765120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120106,
					"content": "Aku pilih anjing lucu \"Gaumaru\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120107
					]
				},
				{
					"id": 765120107,
					"content": "Iya nih, Paimon juga setuju kalau \"Gaumaru\" paling hebat, punya aura kayak \"Taroumaru\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120108,
					"content": "Nguuu! Nguuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120109
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120109,
					"content": "Hebat sekali, \"Gaumaru\"! Usahamu tidak sia-sia, hasilnya luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120110
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120110,
					"content": "Hasilnya sudah bisa diprediksi, selamat kepada kedua sahabat dari Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120111
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120111,
					"content": "Setuju, sahabat Ninken kita memang benar-benar kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120125,
					"content": "Meski tidak ada upacara penghargaan yang mewah, kalian semua lebih mengutamakan pertandingan sesungguhnya, dan sangat rendah hati dalam keseharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120126
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120126,
					"content": "#Pengakuan {NICKNAME} adalah kehormatan tertinggi di Nod-Krai, jauh melebihi trofi emas dan medali biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120127
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120127,
					"content": "#Hehe~  Di seluruh Teyvat, kalian mungkin yang pertama kali nerima penghargaan dari {NICKNAME} kayak gini lho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120128,
					"content": "Tidak perlu penghargaan lainnya, kami sudah puas kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120129
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120129,
					"content": "Benar kan, Budanova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120130
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120130,
					"content": "Tentu, lain kali, kami akan danai turnamen ini supaya bisa lebih meriah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120131
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120131,
					"content": "Mending ada babak penyisihan yang skalanya ratusan orang. Jadi, ada banyak ahli yang belum terdata dan punya afiliasi yang bisa ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120132
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120132,
					"content": "Masuk akal. Para Bombardier juga senang bisa mensponsori acara seperti ini, aku akan tuliskan proposal untuk Mayor Valeriy dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120133
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120133,
					"content": "Shuumatsuban juga ... eh ... kalau dananya sampai puluhan juta Mora, lupakan saja deh. Pasukan Ninken bakal lebih aktif dalam perlombaan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120134
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120134,
					"content": "Kaing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120135
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120135,
					"content": "Terima kasih untuk niatnya. Kurasa, kalau kompetisi kayak gini punya sponsor yang terlalu dominan, mungkin akan ada perubahan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120136,
					"content": "Contoh, di antara kalian bertiga, tidak merekrut pesaing yang tidak terhubung tapi berprestasi baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120137
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120137,
					"content": "Eh,  maksud Kazuha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120138,
					"content": "Karena itulah, Adventurers' Guild yang relatif netral jadi pilihan terbaik untuk menyelenggarakan kompetisi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120139,
						765120140
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120139,
					"content": "Kompetisi ini harus bebas dari kepentingan pihak apa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120141,
					"content": "Hmm ... Paimon kayaknya udah ngerti deh! Biar Paimon aja yang ngomong blak-blakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120142,
					"content": "Meski kali ini kedua kontestan dari Fatui sopan banget, tapi sebagian teman kalian itu jahat banget lho, bahkan langsung serang kami waktu ketemu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120143,
					"content": "Kalau Fatui ambil peran penting dalam kompetisi ini, kalian pasti bakal rekrut pemain peringkat atas kan, berarti ... Paimon sama yang lain jadi bantu kalian nyari jagoan buat hajar Paimon sendiri dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120144,
					"content": "Haha, ketahuan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120145
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120145,
					"content": "Aku paham maksud kalian, tapi aku tidak bisa berjanji atas nama orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120146
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120146,
					"content": "Unit yang berbeda punya misi dan cara kerja yang berbeda. Sebagai seorang letnan rendahan, aku tidak ada apa-apanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120147
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120147,
					"content": "#Benar kata Tuan Kaedehara, kekhawatiran {NICKNAME} dan pemandu Paimon juga realistis sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120148
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120148,
					"content": "Ya sudah, kalian berdua, jangan berpikir yang aneh-aneh lagi. Nikmati saja pertarungan ini kayak Gaumaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120149
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120149,
					"content": "Nguuu! Nguuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120150
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120150,
					"content": "Benar juga, sebagai pejuang tingkat bawah, tidak perlu pikirin urusan rumit yang seharusnya jadi tanggung jawab komandan, yang penting itu cuma fokus bertempur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120151
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120151,
					"content": "Lain kali waktu kita bertarung lagi, aku pasti akan tunjukkan keterampilan yang lebih kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120152
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120152,
					"content": "Aku ... akan bawa kue yang banyak untuk kalian semua~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120140,
					"content": "Memang tidak boleh dicampur sama tujuan lain ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120112,
					"content": "Aku rasa penampilan Onyx Agate yang paling menonjol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120113
					]
				},
				{
					"id": 765120113,
					"content": "Fatui yang berbadan gede, bawa pedang gede ... meemang susah banget sih buat dihajar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120114,
					"content": "Aku? Terima kasih untuk pengakuanmu, ini dorongan terbesar untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120115
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120115,
					"content": "#Semua orang bertarung dengan baik, mungkin aku lebih beruntung karena bisa mengikuti ritme {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120116
					],
					"speakerTitle": "Onyx Agate"
				},
				{
					"id": 765120116,
					"content": "Wuf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120117
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120117,
					"content": "Lihat kan, Gaumaru? Kamu harus belajar banyak dari Onyx Agate ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120118
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120118,
					"content": "Luar biasa, Bombardier Poruchik Stepanyan. Mayor Valeriy pasti bangga denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120119,
					"content": "Menurutku juaranya Diminished Seventh Arpeggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120120
					]
				},
				{
					"id": 765120120,
					"content": "Hmm ... Ngomong-ngomong, Fatui bertopi yang pernah kita lawan di Fontaine itu dilatih sama dia ya? Wah, hebat banget dong dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120121,
					"content": "#Wah, wah, terima kasih pujiannya ... Sepertinya Paimon harus lebih sering siapkan camilan mewah untuk {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120122
					],
					"speakerTitle": "Diminished Seventh Arpeggio"
				},
				{
					"id": 765120122,
					"content": "Gluk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120123
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120123,
					"content": "Kalau kamu juga mau makan kue Nona Budanova, kamu harus jadi lebih kuat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120124
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120124,
					"content": "Waduh, ternyata yang kita lawan itu instruktur Fatui senior ... Pantas kalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Onyx Agate"
				}
			]
		}
	]
}