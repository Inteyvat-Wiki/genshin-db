							"2"
						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "Wow! Tadi kita masih ada di samping bidak catur, terus \"wuuush\", dan JREEENG, kita ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "Kok bisa gitu ya? Keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Hehe, mau sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Lagi, lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "Jaim dikit bisa enggak sih! Kelakuan jangan kayak bocah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "Ini wajar, karena koordinatnya sudah bergeser. Mungkin karena faktor usia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "Eh ... Ini bukannya ngarai yang tadi kita datangi waktu di awal? Kenapa bawa kami ke sini? Memangnya ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "Si unyil kok kepo amat sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "Aneh, harusnya ada di sini ... Ah! Ini dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "Sudah ah, aku pusing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Dih, gara-gara kamu bilang gitu, Paimon juga jadi ikutan kerasa pusing dikit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "Saat pecahan yang bersinar menyatu dengan botol ajaib Liloupar, kamu merasa sedikit dari kekuatanmu juga ikut terserap ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "\"Shiruyeh adalah Khorramdin\".\\nUcap dia yang memakai topeng tembaga.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "\"Tidak akan ada yang mewarisi namamu. Aku akan menghancurkan semua ilah di dalam bait-bait dewamu. Hai penjahat, biarlah kamu selamanya meringkuk di liang kubur\".\\nUcap dia yang memakai topeng tembaga.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "Dari tatapan mata Jinni yang memikat, kamu menyaksikan masa-masa ketika Gurabad diliputi kegelapan ....\\nGurabad adalah kota sumber air, namun kini penghuninya tercerai-berai layaknya air yang tercurah.\\nJinni tanpa akal budi bermunculan dari mesin-mesin yang dingin, persenjataan para prajurit ... Anggur merah, sari buah delima, pun berhamburan ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "Buah-buah delima diremukkan, diinjak-injak sampai menjadi lumpur. Gemuk dan layu, kaya dan sederhana .... Buah-buah merah bersorak merayakan turunnya Khorramdin: kegembiraan hidup, dan manisnya pembalasan.\\nSarinya semanis anggur, mengalir ke seluruh penjuru kota, mengubah tempat penampungan air menjadi lautan merah ....\\nPara budak ditenggelamkan, dan para tuan berseru dan meratap, terbawa aliran deras lautan malam.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "Kemudian kamu melihat sang Raja yang mengenakan topeng tembaga. Dia lari ke balik bayang-bayang, ke dalam pelukan Shirin.\\nWajahnya sayu dan keriput, sisa-sisa akal budi dan kehidupan menghilang bak debu yang ditiup angin malam.\\nDan Raja Kisra, telah berubah wujud menjadi monster gelap. Mereka adalah kaummu yang sedarah, namun kamu bersorak-sorai, mengecap manisnya pembalasan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "Gurabad, lukamu tak dapat disembuhkan, aibmu tak dapat ditutupi.\\nHendaknya mereka yang mendengar bertepuk dan bersorak!\\nSiapa dari antara kamu yang belum menderita di bawah kekuasaan tirani tak berkesudahan?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "\"Gurabad, lukamu tak dapat disembuhkan, aibmu tak dapat ditutupi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd pernah menjadi kekasih Liloupar. Karena dikasihi oleh para Jinni, dia mampu berubah dari seseorang yang hanyalah gembala rendahan hingga menjadi raja di tengah-tengah manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "Awalnya aku kira dia lebih dari sekadar rekan manusia fana. Aku jatuh hati pada pandangan matanya ... Namun akhirnya, keangkuhan dan keegoisan seorang raja pun menodai jiwanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "Dia tidak ada bedanya dengan raja-raja fana lain yang pernah hidup dan telah berpulang. Hanya tahu berkelana dalam mimpi penaklukan dan penindasan, membangun istana di atas pasir isap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "Dan oleh karena itu, kamu menggulingkannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Saya menghukumnya. Ayah ke anak, dan anak ke anaknya lagi, sampai tiga generasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan, Shirin, darah daging saya ... Dengan darah saya merencanakannya, dengan madu saya melaksanakannya, dan dengan bara ambisi saya menghukum mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "Tapi itu belum semua ... Tidak. Masih belum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "Soal \"hukuman\" yang kamu sebut ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Parvezravan, putra saya yang angkuh. Dia menginginkan kekuatan tanpa batas, dan saya mengabulkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "Saya membuatkan untuknya suatu mesin yang ditenagai oleh sisa-sisa arwah Jinni, dalam impian yang gelap gulita dia membangun mekanisme raksasa yang dapat menelan segala hal buatan manusia, layaknya air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "Kekayaan yang tak terkira pun datang, tetapi itu juga dibayarkan dengan terenggutnya daya hidup para buruh dan terampasnya harta milik para petani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Para bangsawan dan hartawan meratap. Demikianlah kemenangan makhluk fana, akhir dari segala perbudakan. Tapi hanya saya saja yang tahu. Saya sendiri saja yang mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "Dihapuskannya perbudakan adalah awal mula penghambaan yang kejam dan tanpa akhir. Pemilik budak tidak lagi diwajibkan merawat budaknya, dan para budak tidak lagi bebas dari kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Aduh, Paimon mulai mabok nih dengernya ... Kamu ngomongin apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "Kemiskinan menimbulkan kebencian, dan kebencian melahirkan ambisi. Harta benda menjadikan orang tamak, dan ketamakanlah yang menjaga bara ambisi agar terus menyala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "Ambisi membuatnya memaksa Shirin, ratunya sekaligus saudarinya, untuk memanggil Jinni yang tanpa akal budi dan tak berbentuk. Kesengsaraan yang dirasakannya menyenangkan hati dan menguatkan saya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "Untuk dapat membesarkan darah daging mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "Maksudnya Shiruyeh ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Shiruyeh adalah Khorramdin yang bertopeng tembaga. Rakyat jelata dan budak memandangnya sebagai pembawa titah ratu, sang pemberi kesukaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "Dia membawa mereka ke dalam pelukan keadilan ... yakni kematian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Hmm? Si unyil masih di sini rupanya. Kenapa diam saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Hmm ... Soalnya Paimon enggak terlalu paham cerita kamu barusan, dan kedengarannya ... ngeri banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Oh, jangan dipikirkan ... Itu cuma cerita tentang masa lalu dan takdir saya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "Wah ... Eh ... Paimon bingung harus ngomong apa di saat begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "Berkat Anda, saya bisa kembali ke taman tuan saya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Loh, kenapa tiba-tiba ngomong gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Gurabad adalah tempat yang ditakdirkan untuk saya. Saya akan kembali ke kota ini, karena masih ada yang harus diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Apa karena ... kamu sudah bikin banyak salah di zaman dulu, terus sekarang mau balik gitu, nebus dosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Berbuat salah? Ha! Sekali pun tidak pernah. Tapi anak-anak saya masih di sana. Dia dan Shiruyeh ... pasti sangat kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "Jadi maksudnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "Kekuatan kegelapan sudah semakin kuat, dan hanya kekuatan seorang ibu yang mampu menghadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "Saya kira kekuatan jurang kekelaman bisa digunakan untuk menghukum semua yang saya benci, tapi kita semua menuai apa yang kita tabur. Maka dari itu, takdir saya adalah kembali ke Gurabad dan menghadapi penghakimannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "#{M#Tuanku}{F#Nonaku}, maaf saya tidak bisa lebih lama ada di sisi Anda. Maaf karena saya tidak bisa lebih jauh mengenal Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "Tapi saya percaya takdir akan mempertemukan kita kembali. Anda adalah sosok yang tidak akan jatuh oleh karena pencobaan. Saya percaya ... pilihan ini sudah benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "Pilihan yang benar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "Pada hakikatnya, bukan Tuanlah yang memilih Jinni, melainkan sebaliknya. Bahkan jika berpisah, saya rasa ikatan di antara kita tidak akan bisa diputuskan begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "Jadi saya mohon ... terimalah pemberian terakhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "Dekatkanlah saya ke telinga Anda ... sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "Botol gaib itu kamu dekatkan ke telinga ...\\nDiiringi tawa renyah, kamu mendengar bisikan langsung di dalam telinga, menggunakan bahasa yang lembut dan halus ....\\nPerkataannya ibarat aliran kesadaran yang merasuk ke sukma, dan kamu dapat memahami setiap kata yang terucap.\\nPada akhirnya, kata-kata menghilang, berganti sensasi merinding yang masih tertinggal di dalam telinga ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Oleh karena bimbingannya, kamu mulai mengenali bait-bait kuno ....\\nTapi dia pun tidak lagi berkata-kata.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "Waduh, cahaya di dalam botolnya meredup! Liloupar! Kamu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar? Liloupar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(Cahaya di dalam botolnya menghilang, lalu mulai berkelap-kelip kembali. Tapi dia kini diam seribu bahasa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "Dia sudah pergi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Begitu ya ... Jadi barusan itu ternyata perpisahan ... Apa kita bakalan ketemu lagi sama dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "Kita ... pergi? Sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "Gurabad ... menunggunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "Kamu mau pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "Topeng tembaga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "Ah, Khorramdin adalah Raja Shiruyeh yang mengenakan topeng tembaga. \"Pembawa Titah Ratu\", \"Penyelamat Kaum Jelata dan Budak\". Hahaha, pengkhianat licik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "Pada akhirnya, dia memimpin semua yang mengikutinya menemui maut. Kota Gurabad beserta seluruh isinya dia campakan ke dalam jurang maut, sirna ditelan bumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "Tentang jatuhnya kota Gurabad ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "Jadi ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
