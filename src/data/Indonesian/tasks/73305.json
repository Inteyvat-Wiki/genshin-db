					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Eh? Liloupar? Kamu kenapa? Kok tiba-tiba diam saja ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Sttt ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Eh sebentar ... kenapa dia nyala gitu. Ada yang beda nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "Botol sang Jinni menyala kelap-kelip, frekuensi sinarnya sama dengan getaran bidak catur.\\nKamu bisa mendengar suara aliran waktu, seperti suara tetesan air di dalam penjara ... Lamanya terasa seperti satu masa hidup berlalu, namun juga terasa seperti hanya sekejap saja.\\nDan Liloupar diam seribu bahasa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Lalu kamu melihat suatu kota raksasa yang dingin, besar serta kembung muncul dari balik tirai kabut.\\nPermukaan tanah terbelah dan menelan semua yang ada di Gurabad ....\\nDan di sana, di tebing lereng bukit itu, pintu gerbang kota itu terpasang. Begitu buruk rupanya, seakan-akan semua kenajisan dunia lama terkandung di dalamnya. Akan tetapi, entah kenapa sampai hari ini tidak ada satu pun orang yang pernah memandangnya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "Gurabad ada di sana. Saya sudah ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "Kepalaku sakit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Waduh. Kalian ini kenapa sih? Lain kali kalau ada yang beginian kasih tahu Paimon dulu dong! Paimon paling enggak suka dibikin kaget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Maaf ya, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Huh! Paimon mau NGAMBEK! Wekkk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Aih ... seperti anak kecil saja. Tidak perlu khawatir, unyil. Saya pasti akan mengembalikan {M#Tuanku}{F#Nonaku} pada Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "Ketika saatnya tiba, dia akan memberi Anda ganti rugi pakai banyak sekali makanan enak ... Dan \"Mola\", mata uang kalian. Betul, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "\"MORA\". Mora. Wah, ngapain harus aku benerin segala ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Nah, gitu dong! Paimon catet nih ya! Makan enak, Mora ... Oke sip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "#Oke, sudahan dulu main-mainnya. Ayo kita ke Gurabad, {M#Tuanku}{F#Nonaku}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Kita mau ngapain ke sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "#Kenapa? Saya juga tidak tahu ... Mungkin alasannya sama sekali tidak penting. Tapi saya harus ke sana. Oleh karena itu, {M#Tuanku}{F#Nonaku} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "#Kalau memang harus ada suatu alasan, anggaplah agar {M#Tuanku}{F#Nonaku} bisa menyaksikan masa lalu dan pelajaran yang saya dapatkan darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Kedengarannya kayak enggak ada habis-habisnya ya ... terus Paimon enggak terlalu ngerti juga sih, tapi ... kedengarannya kayak mau perpisahan loh kalau kamu ngomongnya gitu. Memangnya ada kejadian buruk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Haha, tidak kok. Hanya saja ... Di sana ada hal yang harus kalian lihat dengan mata kepala sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "Aduh, apaan sih! Boleh, terus saja kasih teka-teki! Ngomong saja dibikin ribet, HUH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Intinya, mohon ikut dengan saya. Saya akan menuntun Anda ke Gurabad ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad ... Di sana ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Tidak ada apa-apa. Tidak ada apa pun ... yang tersisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Hanya ada ingatan para arwah, impian semu yang tak akan pernah terwujudkan, dan manisnya balas dendam ... itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "Mungkin saya sudah lancang meminta ini, tapi ... Saya ingin agar Anda dapat melihat masa lalu dan pelajaran yang saya dapatkan darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Jangan memutuskan seenaknya woi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Aku sih tidak apa-apa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "Huh! Kamu ngomongnya gitu mulu tiap kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
