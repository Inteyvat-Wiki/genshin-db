			"dialogs": [
				{
					"id": 733052201,
					"content": "Tolong hubungkan saya dengan bidak catur itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052202,
					"content": "Hubungkan? A-Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052203,
					"content": "Temukan bagian yang menjorok keluar dan masukkan ke dalam cekungan yang ada di botol. Semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052204,
					"content": "Lah? Ada cekungan ... di botol kamu? Mana ada, mulus rata gitu botolnya ... enggak ada bolong apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052205,
					"content": "Ada kok. Anda saja yang tidak bisa lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052206,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052207,
					"content": "Karena saya barusan cuma ngarang cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "Liloupar"
				},
				{
