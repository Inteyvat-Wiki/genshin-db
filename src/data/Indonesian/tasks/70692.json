			"dialogs": [
				{
					"id": 706920101,
					"content": "Wah, Knight muda, kelihatannya kamu udah bawa pahlawan hebat kita kemari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "\"Maniak Grafiti\""
				},
				{
					"id": 706920102,
					"content": "Halo, Honorary Knight kita dan Asisten Putih-nya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920103,
					"content": "Mika sama ... teman-teman dari Natlan? Kalian lagi ngapain nih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920104,
					"content": "Kami di sini untuk menyebarkan informasi tentang sesuatu yang disebut Sauri-Sauri Seluncur, dan kami pikir ini akan sangat berguna untuk para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920105,
					"content": "Dia menggabungkan mekanisme inti Rekan Pengintai yang dibawa Amber dari Sumeru dengan desain mainan Saurian kecil yang dikasih teman-temanku dari Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920106,
					"content": "Mekanisme Rekan ... Oh, Paimon ingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920107,
					"content": "Sama seperti Rekan Pengintai dari Sumeru, Sauri-Sauri Seluncur bisa dipakai untuk memantau monster atau memeriksa medan di darat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920108,
					"content": "Tapi karena fokusnya lebih ke fitur yang kedua, dia lebih mengutamakan kontrol dan presisi saat bergerak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920109,
					"content": "... Honorary Knight, kamu tertarik untuk mencoba terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920110,
					"content": "Wah, perkenalan yang serius banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "Eh? Apa ... memangnya aku terlalu tegang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920113,
					"content": "Sepertinya benar ... padahal sebelumnya aku sudah bisa rileks dan lebih natural di depanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920114,
					"content": "Tapi belakangan ini, aku dengar banyak cerita tentang keberhasilanmu dari teman-teman di bangsa lain. Kamu jadi makin hebat dan makin luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920115,
					"content": "Setiap kali aku berpikir kalau aku harus bisa membantu dan tidak jadi beban untukmu, aku jadi tegang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920116,
					"content": "Jadi gitu ya kalau Mika mikirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920117,
					"content": "Kamu sudah melakukannya dengan sangat baik, Knight muda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "\"Maniak Grafiti\""
				},
				{
					"id": 706920118,
					"content": "#Di Natlan, kalau para pejuang dari suku bertemu dengan {NICKNAME}, ada yang sampai bicara tidak karuan saking senangnya, bahkan ada yang sampai tidak bisa bicara sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "\"Maniak Grafiti\""
				},
				{
					"id": 706920119,
					"content": "#Sebagai orang yang bekerja bersama {NICKNAME}, kamu sendiri sudah seperti legenda. Bahkan saat bicara dengan kepala suku kami pun, kamu tidak perlu sungkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "\"Maniak Grafiti\""
				},
				{
					"id": 706920120,
					"content": "Betul! Kamu harus lebih percaya diri, Mika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920121,
					"content": "Hmm ... sejujurnya, aku tidak pernah benar-benar berpikir dari sudut pandang itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920122,
					"content": "#Pokoknya, kalau {NICKNAME} sudah puas setelah uji terbang Sauri-Sauri Seluncur, mesin pembantu yang imut dan bisa diandalkan ini pasti akan sangat membantu banyak kelompok petualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920123,
					"content": "Ini keahlianku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "Baik! Aku akan segera menyetel Sauri-Sauri Seluncur, uji terbangnya bisa segera dimulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920124,
					"content": "Biar aku coba kemampuan Sauri-Sauri!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "Tidak perlu formal banget kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}