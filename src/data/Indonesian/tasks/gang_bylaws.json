			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "Gimana nih? Masa kita enggak jadi main kartu nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Apa coba main di tempat lain ya. Tapi di mana lagi yang aman dari orang dewasa, selain di kolong jembatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Oh! Aku tahu! Kita minta tolong Kak Yoimiya nyalain petasan, buat nakutin orang-orang yang merebut tempat kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Terlalu kejam deh ... Tapi memang dia duluan sih yang mulai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Iya kan! Salah sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Atau ... kita pulang dan bikin PR aja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Kalau terlalu sering main kartu dan tidak belajar, nanti kita gedenya jadi kayak dia, <color=#00E1FFFF>sudah dewasa tapi malah ngumpet di kolong jembatan</color>, kan jelek banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
