			"dialogs": [
				{
					"id": 191431101,
					"content": "Kalian diam di sini. Jangan coba aneh-aneh, jangan kabur. Awas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431102
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431102,
					"content": "Oke siap bosku. Kami juga sudah tidak bisa ke mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "Sekarang sih iya. Tapi awas kalau berani berubah pikiran begitu sudah ada tenaga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431104,
					"content": "Tidak! Kami janji! Tidak akan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
