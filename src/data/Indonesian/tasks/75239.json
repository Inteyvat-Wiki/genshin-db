			"dialogs": [
				{
					"id": 752390101,
					"content": "Si Zhaka itu ... belum selesai kerja sudah kabur. Boneka-boneka itu juga entah ditaruh di mana. Aku pasti harus protes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "Boneka apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "Itu beberapa boneka kecil yang terinspirasi dari Koholasaurus. Aku sedang mewarnai mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Tapi muridku, Zhaka, belakangan ini tidak masuk kerja. Dia masih ada tiga boneka setengah jadi yang belum diwarnai, dan aku juga tidak tahu di mana boneka itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "Apa kamu bisa bantu aku mencarinya? Seharusnya ada di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanei"
				}
			]
