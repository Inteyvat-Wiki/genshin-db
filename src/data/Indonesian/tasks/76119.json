			"dialogs": [
				{
					"id": 761190101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190102,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190104,
					"content": "Sepertinya mereka lagi senang-senang tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Salam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Salam juga untukmu, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190108,
					"content": "Sedang main game baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Iya. Aku lihat orang-orang main sama teman mereka pakai gelas di The Flagship, jadi aku pinjam idenya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190110,
					"content": "Mereka akan taruh batu permata di bawah gelas, lalu mengocok gelas-gelas itu dengan cepat di atas meja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190111,
					"content": "Setelah berhenti, mereka akan minta pemain lain menebak di bawah gelas yang mana permata itu berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190112,
					"content": "Kuuhenki sangat suka berputar-putar sambil dibalut kain, jadi aku pakai topi Nona Penyihir sebagai referensi dan buat beberapa perbaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190113,
					"content": "Sangat imut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Tunggu. Jadi kamu pergi ke The Flagship ... ada yang kenal kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Ada yang tanya sih, terus aku bilang, \"Hari ini aku lagi cosplay jadi Dewi Bulan. Mirip banget kan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190117,
					"content": "Wah, kamu benar-benar udah niru trik dari Malam Doa Rembulan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "Dan mereka percaya sama kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Yah ... Tidak sepenuhnya sih, tapi setelah itu mereka juga tidak bicara lagi denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190120,
					"content": "Aktingku tidak alami ya? Lain kali aku akan terus latihan di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190121,
					"content": "Kok rasanya kayak ada yang belajar yang salah ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar ingin kamu menebak di mana dia bersembunyi. Mau ikut main satu ronde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190124,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Kalau begitu, tolong siapkan 100.000 Mora untuk mulai. Ini memang peraturan The Flagship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190126,
					"content": "Oke, harusnya sih kamu enggak perlu ikut pelajaran itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
