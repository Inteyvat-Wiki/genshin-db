						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "Apa itu terlalu mudah bagimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190203,
					"content": "Kalau kamu main lagi nanti, aku akan coba acak topinya lebih cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190204,
					"content": "Paimon penasaran ... gimana kamu main sama mereka tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Kalau enggak pakai kuuvahki, kamu enggak bisa lihat apa-apa, tapi kalau pakai ... malah kelihatan terlalu jelas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Hmm, aku boleh buka mata kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761190207,
					"content": "Oh ya. Aku enggak kepikiran soal itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
