				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Aku mau adu jurus sama si besar ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Semua baik, semua baik! Bahkan tuanku pun perlu menjaga agar tubuh kudusnya tetap lentur, sehingga setiap irisan yang jatuh dapat tetap empuk dan kaya rasa. Jangan menahan diri, kerahkan seluruh kemampuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "Ya tuanku yang maha mulia, Mahavasudeva{RUBY#[D]Penerus Tuan Yang Melimpahkan Dunia}-Yava, kiranya Jivit{RUBY#[D]Akar Kehidupan}indriya-mu tertanam kuat pada batu landasan tanah ini, dan kiranya rasa yang engkau berikan melebihi semua dewa yang ada di kolong langit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Ini apaan ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Diberkatilah pertanyaanmu! Yang ada di hadapan kita adalah generasi penerus sang Tuan Yang{RUBY#[S]Bifrons} Melimpahkan Dunia, jamur kudus yang terlahir dengan cita rasa maha sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya senantiasa berseru kepada Sang Tuan Hijau dan yang Empunya Taman{RUBY#[D]Pushpavatika} Puspa. Makani Khagan selamanya berdoa kepada Penguasa Pasir. Tapi tanyalah mereka, dari ketiga tuan yang maha besar itu, siapa yang rasanya lebih enak daripada tuanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Ketahuilah, tidak menyakiti adalah jalan kebajikan. Jikalau bukan karena daging tuanku yang maha kudus, maka alam akan memaksa kita mencabut nyawa binatang, burung, dan tumbuh-tumbuhan untuk bertahan hidup ... betapa kasihan, betapa merana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Maka betapa berbahagianya, ketika Tuan Atas Ruang mengangkatku dari permukaan tanah, demikian pula Ji{RUBY#[D]spora}va tuanku ikut bersamaku. Dan lihatlah, bahwa pada hari ini dirinya telah tumbuh subur, menganugerahkan rasa yang istimewa tiada tandingannya kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
