			"dialogs": [
				{
					"id": 760090601,
					"content": "Wah, firasatku benar! Kalau kedua batu itu dibarengin, sesuatu yang sangat hebat akan terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090602
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090602,
					"content": "Eh, tapi kalau begini, batu yang baru saja ditemukan jadi hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090603,
					"content": "Eh? Tidak apa-apa kok. Kak Paimon lupa ya, awalnya aku cari itu cuma buat sogok Mai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090604
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090604,
					"content": "Karena kita sudah punya \"cerita\" tentang batu yang tiba-tiba terbang, jadi batunya sendiri sudah tidak penting lagi. Lagi pula, Mai sangat pandai bercerita, dia pasti juga bakal suka cerita baru ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090605
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090605,
					"content": "#Makasih banyak ya, Kak {NICKNAME} dan Kak Paimon! Prosesnya beda, tapi hasilnya tetap oke kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090606
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090606,
					"content": "#Oh iya, ini batu yang aku temukan tadi! Karena batu ini juga cantik, jadi aku mau kasih ke Kak {NICKNAME} sebagai tanda terima kasih!",
