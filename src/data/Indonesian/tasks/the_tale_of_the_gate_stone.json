			"dialogs": [
				{
					"id": 760090501,
					"content": "Kami kembali! Kasha, kata kamu batu ini cantik enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090502,
					"content": "#Wah, cepat amat! Kak {NICKNAME} memang pantas disebut petualang profesional, hebat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090503
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090503,
					"content": "Hehe, hal kayak gini cuma sepele saja. Bukannya disuruh gali lubang di labirin sedalam ratusan meter, atau jalan ribuan meter buat foto-foto di tempat yang berjauhan kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090504,
					"content": "Hmm ... Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090505
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090505,
					"content": "Eh, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090506,
					"content": "Hmm ... Cantik sih cantik, tapi entah kenapa rasanya dia kayak tertarik ke batu besar ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090507
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090507,
					"content": "Eh? Kok Paimon enggak rasain apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090508,
					"content": "Aku juga enggak yakin ... cuma perasaan doang. Firasat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090509
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090509,
					"content": "Kayak ... di ceritanya Mai, Reed Miller bisa ketemu sama Putri Peri juga karena dapat petunjuk dari Dewi Bulan. Firasatku ini pasti juga sama kayak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090510
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090510,
					"content": "Ohh! Apa ini yang disebut kemampuan meramal masa depan ... Enggak deh, Paimon yakin Dewi Bulan juga enggak sekurang kerjaan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090511,
					"content": "Jadi ... Firasatmu suruh buat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090512,
					"content": "Hmm ... coba deh. Taruh batunya di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090513
					],
					"speakerTitle": "Kasha"
				},
				{
