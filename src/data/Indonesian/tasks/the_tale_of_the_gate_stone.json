					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "Hmm ... kayaknya bukan yang ini juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090202,
					"content": "Ah, halo, Kakak yang belum pernah kulihat sebelumnya, dan ... Hmm, Nona Peri putih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090203,
					"content": "Selamat datang di Enklave Bulan Embun! Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090204,
					"content": "#Enggak, cuma penasaran saja kenapa kamu sendirian di sini. Oh iya, nama Paimon ya Paimon, sedangkan dia ini {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090205,
					"content": "#Oke, Kak {NICKNAME} dan Kak Paimon! Tampaknya kalian bukan orang dari Kota Nasha ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090206,
					"content": "Kami petualang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#Benar. {NICKNAME} dan Paimon adalah petualang yang sangat hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090211,
					"content": "Enak sekali ya. Bisa bertualang ke berbagai tempat dan melihat berbagai pemandangan bersama teman baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090212,
					"content": "Benar sekali, kami sudah pergi ke banyak tempat. Jadi tadi kamu sedang apa sendirian di sini? Apa kamu sedang mencari sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090213,
					"content": "Hmm, aku lagi cari batu yang cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090214,
					"content": "Oh, Paimon ngerti. Kamu mau koleksi kan? Bukan cuma anak-anak, beberapa orang dewasa juga punya hobi kayak gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090215,
					"content": "Eh, bukan. Batunya buat sogok Mai, biar dia mau culik aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090216,
					"content": "Ohh, ternyata begitu, agar dia bisa menculik ... Tunggu dulu, kamu ngomong apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090217,
					"content": "Kedengarannya agak tidak masuk akal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#Eh? Kak {NICKNAME} belum pernah dengar cerita tentang Reed Miller si pencuri ulung dan Putri Peri ya? Mai bilang semua orang di luar sana tahu cerita ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090221,
					"content": "\"Kemarilah, Nona yang matanya bersinar seperti rembulan. Biarkan aku menyuap hatimu dengan permata yang indahnya sepadan dengan kilau di matamu, dan membawamu pergi dari sangkar emas ini ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090222,
					"content": "Aku juga kurang paham artinya, tapi kalau kita kasih sesuatu yang disukai orang lain, itu berarti kita boleh pergi bertualang sama dia, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090223,
					"content": "Kayaknya maksudnya bukan gitu deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "I-Iya, arti kalimat itu sebenarnya ... Eh, pokoknya bukan sesuatu yang boleh dilihat anak-anak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090227,
					"content": "Ngomong-ngomong, siapa itu Mai yang kamu bilang? Kenapa dia ajarin hal-hal aneh ke anak kecil? Patut dipertanyakan tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090228,
					"content": "Mai bukan orang jahat kok! Kami seumuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090229,
					"content": "Sama seperti Kakak berdua, dia juga petualang dari luar! Aku lihat dia mondar-mandir di sekitar perkemahan, jadi aku samperin dan aku langsung minta dia cerita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090230,
					"content": "Entah kenapa, dia kayaknya mengira kami ini kelompok aneh yang menakutkan, yang suka mengorbankan anak-anak ke Dewi Bulan. Dia berusaha terlihat tenang, sambil mohon-mohon supaya aku tidak bunuh dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090231,
					"content": "I-Ini kesalahpahaman yang aneh banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090232,
					"content": "Iya kan? Entah dia dengar dari mana beritanya, aneh banget. Tapi karena lucu, jadi yaaa ... enggak aku bantah, enggak aku iyain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090233,
					"content": "Seharusnya kamu membantah loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090234,
					"content": "Pokoknya, sebagai gantinya, Mai janji mau jadi teman baikku. Dia juga ceritakan banyak sekali cerita dari luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090235,
					"content": "Papa Mama enggak pernah bolehin aku baca cerita dari luar. Katanya, itu cuma sampah yang disukai sama orang-orang tak beriman ... Tapi cerita-cerita dari Mai menarik banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090236,
					"content": "Misalnya, nelayan yang jatuh cinta pada peri, bandit besar yang sudah tiga kali mati tapi tiga kali juga lolos dari tangan Penguasa Alam Barzakh, atau makhluk pengubah wujud yang ingin menjadi manusia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090237,
					"content": "Ada orang baik, ada orang yang tidak begitu baik, dan ada orang yang benar-benar jahat. Kaya atau miskin, baik atau jahat, pada akhirnya semuanya sama, matinya menderita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090238,
					"content": "Menurutku, orang tuamu benar, ini memang bisa dibilang sampah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "Benar, cerita kayak gitu emang enggak cocok buat diceritakan ke anak kecil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090243,
					"content": "Tapi, aku sudah bukan anak kecil. Mai juga bilang dunia luar terlalu kacau, terlalu bahaya buat anak kecil kayak aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090244,
					"content": "Aneh kan. Padahal dia tidak bisa pakai karu{RUBY#[S]kuuvahki}nia Dewi Bulan, dan umur kami kurang lebih sepantaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090245,
					"content": "Tapi tidak apa-apa, aku ini pintar kok. Sebelum ketangkap sama aku, dia terus ngomong soal \"batu\" atau semacamnya. Berarti, dia memangnya lagi nyari batu-batu cantik, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090246,
					"content": "Kalau punya <color=#00E1FFFF>batu cantik</color>, harusnya bisa tuh nyogok dia. Aku juga mau kayak nona peri yang diajak pergi sama Reed Miller!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090247,
					"content": "Jangan pakai kata \"sogok\" lagi deh! Sebenarnya kamu itu cuma mau cari batu yang cantik buat kasih ke teman baikmu, enggak perlu pakai istilah aneh kayak gitu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090248,
					"content": "Um ... Kami juga mau keliling di sekitar sini sih. Kalau kami ketemu pecahan yang cantik, akan kami bawain buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090249,
					"content": "Wah, serius? Makasih banyak loh, Kakak-Kakak yang baik hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090240,
					"content": "Aku ingin dengar, bisa ceritakan lebih detail?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "Hm? Baiklah. Misalnya, rekan Reed Miller, \"Musang Bayangan\" yang bersumpah tidak akan pernah melangkah ke bawah sinar bulan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090242,
					"content": "Hei, sekarang bukan waktunya bahas masalah kayak itu! Lagi pula cerita kayak gitu enggak cocok buat diceritakan ke anak kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090225,
					"content": "Benar, gitu cara aku culik si Paimon ikut bertualang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#Heh, jangan ajarin yang aneh-aneh ke anak kecil! Paimon emang paling suka masakan {NICKNAME}, tapi bukan berarti kita temenan karena kamu \"culik\" Paimon loh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090218,
					"content": "Tapi kalau di Nod-Krai, hal begitu justru biasa saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "Bahkan di Nod-Krai, hal begitu juga enggak biasa loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090208,
					"content": "Sebenarnya aku adalah dalang yang mengendalikan Kota Nasha ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#Wah, kedengarannya keren! Apa aku bisa jadi pengikut Kak {NICKNAME}? Kayak di cerita-cerita gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "Kasha"
				},
				{
