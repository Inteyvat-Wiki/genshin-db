				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, ini dokumen-dokumen yang aku perlukan! Oh terpujilah Archon, ada di sini semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Kenapa ngerjain pembukuan di kafe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "Ya-Yah ... soalnya perlu banyak kopi biar tidak salah hitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Ini biaya semua kantor di Palais loh ... harusnya kerjaan ini perlu lima orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Tapi selain aku, semua orang di kantor entah dipinjam sama kantor lain, lagi sibuk, atau lagi dinas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Jadi begitu tiba waktunya hitung-hitungan biaya, sisa aku sendiri. Sudah berapa hari aku tidak tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Bukan cuma hitung biaya, tapi mencocokkan semua bon dan kuitansi juga. Mataku sudah berkunang-kunang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Tapi syukurlah dokumennya ketemu. Kalau boleh, biar aku yang kawal Nona Isadora kembali ke Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "Terima kasih, Bu Muirne. Aduh, kamu dan Pengembara adalah orang paling baik yang aku temui dalam tiga bulan terakhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "Yang lainnya antara marah-marah doang atau suruh aku kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Eh, tidak, tidak boleh ngeluh terus. Harus cepat balik, nanti Nona Keiser marah lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}