			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Ha. Ke mana perginya ...? Sial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Ugh. Kalau begini aku tidak bisa menulis salinannya juga dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Kehilangan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Ah, semoga saja \"cuma\" hilang ya. Toh aku orangnya optimis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "Yang kayak gitu bisa disebut optimis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Yah ... bisa jadi, kalau yang hilangnya itu buku besar pengeluaran setengah tahunan kantor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Yang harus segera diberikan ke Nona Keiser ... dan yang halamannya hilang lima lembar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Lima halaman itu isinya lima bulan berbeda. Banyak catatan biayanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Baru sadar semua hilang waktu peninjauan akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Kalau bukan lupa taruh di mana, mungkin memang belum dikerjakan saja ... Tapi kalau begitu, dari mana pula munculnya angka biaya-biaya ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Ugh, mikirinnya saja aku sudah tidak berani. Kalau benar sampai lupa, Nona Cadme bakal suruh aku periksa buku besar sepuluh tahun terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Kayaknya gawat juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Loh, ya memangnya! Kalau dokumen itu belum dibikin, atau hilang, berarti ada kantor-kantor yang bakal kena masalah anggaran di bulan depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Sial ... sial sekali. Aku cuma ingat habis begadang bikin pembukuan untuk dibawa ke Palais hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Begitu sampai sini, aku dikagetkan segerombolan burung camar, lalu tanganku selip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "Hmm ... mungkin dokumennya hilang pas itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Aku bantu cari deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "Asli? Wah, makasih loh! Oke, kita ikuti jalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Catatan itu bukan rahasia kok. Jadi langsung ambil saja kalau ketemu, tidak usah takut kelihatan dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Ah, aku sempat ketemu Bu Muirne! Dia bahkan membantu mengusir burung camar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Kita bisa tanya dia, siapa tahu dia lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "Yuk, cari barengan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Memangnya kehilangan barang itu pertanda baik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
