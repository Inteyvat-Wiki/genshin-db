			"dialogs": [
				{
					"id": 240020201,
					"content": "Nona Isadora, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Bu Muirne, mau tanya dong. Ingat tidak tadi pagi aku bawa setumpuk berkas ke kantor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Ingat. Kamu diserbu Violetgold Angler Gull.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "Iya, betul sekali! Begitu burungnya diusir, aku buru-buru ke kantor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Apa mungkin ada yang jatuh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Aduh ... tidak ingat nih. Kebetulan waktu itu aku juga lagi sibuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Tapi kalau memang darurat, mungkin boleh coba \"reka ulang\" perjalanan kamu ke kantor tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Eh, sungguh? Aku ... tidak mau merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Kami cuma sedang cari barang ... jauh lebih gampang daripada kerja di Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Aku ingat Nona tadi bawa tumpukan berkas. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Betul. Laporan biaya harus dibuat sedetail dan seakurat mungkin. Matamu tajam juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Semua harus dicatat, mulai dari yang besar-besar seperti biaya menyewa pengrajin untuk perawatan tembok luar Palais, sampai yang kecil misalnya ganti gembok laci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "Itulah kenapa laporan biaya setiap bulannya selalu tebal, sampai harus diikat tali segala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Pendek kata, tidak mungkin dokumen yang hilang cuma selembar ... kalaupun jatuh, pasti setumpuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Sebentar lagi sudah mau jam kamu masuk kerja nih ... jadi ayo langsung kita cari sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
