			"dialogs": [
				{
					"id": 220160801,
					"content": "Ah, tuan, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160802,
					"content": "Kenapa kamu menyetujui ajakan Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Seperti apa yang dikatakan Tuan Xudong, saat ini... Kalau aku mau makan kenyang, cara terbaik adalah bekerja untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "Lagi pula, aku merasa Nona Julie dan Tuan Xudong adalah orang yang bermoral tinggi, suatu kehormatan untuk bisa pergi bersama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Parvaneh sendiri... adalah orang yang waspada, sudah sewajarnya dia curiga padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Dan dia hanya waspada saja, tidak menolakku, itu... sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "Kamu benar-benar terus berkelana di alam liar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Aku selalu berkata jujur. Setelah keluar dari Shogunate, aku terus berkelana di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "Biasanya aku mengisi perutku dengan buah-buahan liar. Kalau sedang beruntung, aku juga bisa mendapatkan hasil buruan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Aku juga kadang membantu orang yang kesulitan, seperti mengusir monster, atau melawan Kairagi. Dari situ aku bisa mendapatkan sedikit imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Hehe... untuk orang sepertiku yang hanya bisa mengayunkan pedang, jarang sekali ada kesempatan mendapatkan pekerjaan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Apalagi aku seseorang yang \"keluar dari Shogunate\", orang-orang selalu mengelompokkanku sama seperti Kairagi. Jadi... susah sekali mencari pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "Aku juga tidak punya tempat tinggal dan keluarga di Inazuma. Selain berkelana di luar, tidak ada lagi tempat untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160814,
					"content": "Kenapa kamu meninggalkan Shogunate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "Aku hanya... tidak setuju dengan kebijakan Shogunate di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160816,
					"content": "Aku hanyalah seorang samurai, aku juga tidak mengerti apa kebijakan itu akan berguna atau tidak untuk bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160817,
					"content": "Yang kutahu adalah kalau kebijakan mereka bertentangan dengan prinsipku. Jadi, aku memutuskan untuk pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160818,
					"content": "Hehe, mungkin aku yang terlalu kuno dan tidak bisa menerima perubahan... Kamu boleh menertawakanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160819,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "Sampai jumpa lagi, tuan.",
					"roleType": "TALK_ROLE_NPC",
