			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "Parvaneh... dan Pengembara, kenapa kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Aku datang membantu kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "Begitukah? Terima kasih banyak ya, sepertinya Julie pergi ke tempat yang lebih dalam lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Ada banyak monster di sana, sepertinya akan sulit kalau hanya ada kita berdua, untung kamu datang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Ayo kita berangkat, Julie harusnya ada di dalam hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Aku datang untuk menagih makan besar itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "Tidak masalah, tapi kalau hanya aku sendiri, sepertinya sulit memasak semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "Pengembara, tolong bantu kami mencari Julie dulu, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Sepertinya Julie sudah masuk ke tempat yang lebih dalam lagi, monster di sana banyak sekali, kalau hanya kita berdua sepertinya akan sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Kalau Julie sudah kembali, akan kumasakkan makan besar itu untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "Ka-Kamu ini... kalau pancinya sampai rusak, kita mau masak pakai apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "Jangan meremehkan teknik pembuatan panci Liyue. Panci ini khusus dibuat untukku latihan, sangat tahan banting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Lagi pula hanya beberapa monster saja. Kalau melawan monster saja hancur, pasti bukan panci yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Sepertinya harapanmu untuk panci ini sangat tinggi ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong benar-benar keren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "Tentu saja, ini kemampuan wajib seorang koki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "Aku belum pernah dengar tuh?! Kenapa seorang koki harus bisa mengalahkan monster dengan panci!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Baiklah, Julie, ayo kita segera pergi dari sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "Tu-Tunggu dulu, kita harus bantu Paman, dia pergi ke dalam hutan sendirian untuk melawan Kairagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "Kairagi? Bukan monster? Kenapa masih mau berhubungan dengan orang seperti itu sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "Na-Nanti akan kujelaskan... tapi kita harus bantu Paman dulu, dia hanya sendirian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "Baiklah. Pengembara, temani kami sebentar lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "Ayo kita berangkat sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "Kamu mau melawan Kairagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "Tentu saja, panciku ini sudah tidak sabar untuk melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Lagi pula, seorang koki tidak boleh kabur begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "Sudah kubilang, jangan berharap terlalu tinggi pada koki dan pancinya ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "Aku bisa beli panci itu di mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Hahaha, pertanyaan bagus, aku meminta paman di Hanfeng's Ironmongers untuk membuatkannya khusus untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "Kudengar paman menambahkan material dari Chasm ke panci ini. Kalau kamu mau membelinya, cari saja dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "Tapi setahuku Chasm sudah lama ditutup kan? Kalau kamu cari dia pun, belum tentu bisa dia buatkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Parvaneh juga sama kerennya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "Eh? Aku?... hahaha, aku hanya melemparkan beberapa buku ke kepala musuh-musuh itu, aku masih mengandalkanmu untuk mengusir monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Tunggu dulu, ke mana buku \"Kesucian Menyertai\" jilid ke-6 ku? Jangan-jangan kulempar ya tadi... aku masih belum selesai baca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
