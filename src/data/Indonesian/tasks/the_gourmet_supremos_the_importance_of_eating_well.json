				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "*uhuk* Aku sampai dibuat kewalahan begini, bisa-bisa ditertawakan oleh kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "Paman, kamu tidak apa-apa kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Aku hanya sedikit lengah saja, tidak masalah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Julie, sekarang tolong kamu jelaskan tentang semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Ceritakan semuanya dengan jelas, kalau tidak... berarti semua bukuku terlempar percuma... Ah... sampai lecek begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "Sebenarnya persoalannya sederhana... Aku hanya ingin mengantar makanan untuk Paman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "Sudah kubilang... kamu kan baru bertemu dia sekali, kenapa kamu... percaya sekali sih dengan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "Paman pasti orang baik kok! Waktu itu jelas-jelas dia sedang lapar sekali, tapi dia masih mau membagikan bahan makanan untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "Orang yang masih mau berbagi makanan saat sedang lapar, pasti orang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "Caramu menentukan baik dan buruk sangat polos ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "Mungkin kamu bukan tinggal di Teyvat, tapi di negeri dongeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Hahaha, tapi aku merasa apa yang dikatakan Julie itu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "Menurutku, orang yang bisa tetap bertoleransi meski lagi lapar pasti bukan orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Benar-benar logika yang sederhana dan tidak berbelit-belit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Lanjutkan ceritamu, Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "Jadi aku menyiapkan Chicken-Mushroom Skewer, lalu menuju ke tempat aku bertemu dengan Paman pertama kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "Sampai sana, ternyata aku benar-benar bertemu dengan Paman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Tapi saat aku mau menyapa Paman, tiba-tiba aku melihat dia sedang berhadapan dengan beberapa Kairagi, seperti sedang membicarakan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Baru saja aku mau menjauh, tapi para Kairagi itu melihatku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Selanjutnya, biar diriku yang menjelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Mereka itu... beberapa dari mereka adalah teman lama saat diriku mengabdi untuk Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Setelah terjadi perubahan mendadak di Inazuma, kami meninggalkan Shogunate dan hidup sendiri-sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "Yang barusan itu cara mereka mencari nafkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "Betul. Kami tidak punya pekerjaan lain selain mengayunkan pedang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "Setelah itu mereka menjadi \"Kairagi\" seperti yang kalian lihat sekarang, mencari nafkah dengan menjarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Aku tidak mau bergabung dengan mereka, jadi aku pun berkeliling untuk mencari pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Tapi tidak ada yang berani menerimaku setelah tahu aku ini seorang samurai yang meninggalkan Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "Dan seperti yang Anda lihat, aku cuma bisa pergi ke alam liar untuk mencari makan dan bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Beberapa hari terakhir ini, rekan lamaku mencariku karena sedang kekurangan orang, jadi setiap hari mereka membujukku untuk bergabung dengan mereka, tapi aku selalu menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Hari ini... saat Nona Julie muncul, mereka mengira aku bagian dari salah satu grup yang mau melawan mereka. Jadi mereka pun menyerangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "Benar-benar tidak masuk akal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "Apa yang mereka perbuat memang tidak masuk akal. Tapi kalau berada dalam posisi mereka sekarang, sama sekali tidak ada yang masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "Lalu Paman pergi menghadapi para penjahat itu dan aku menunggunya kembali. Tapi tiba-tiba sekelompok monster muncul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Seharusnya kamu bisa melawan mereka, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Biasanya sih bisa. Tapi tadi pagi sebelum pergi aku tidak makan dulu, jadi perutku lapar, tidak ada tenaganya sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "Lalu waktu para Kairagi itu melihatku, Chicken-Mushroom Skewernya sudah jatuh entah ke mana... Untung Paman melindungiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "Itulah alasan kenapa makan pagi sangat penting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Tapi, memang ada banyak Kairagi seperti mereka di Inazuma. Kami selalu merasa dalam bahaya karena masih harus tinggal di Inazuma untuk beberapa saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "Kita bisa mengalahkan monster-monster kecil dengan mudah, tapi lain cerita kalau melawan orang-orang yang menguasai ilmu pedang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "Hmm... Permisi, barusan kamu bilang sedang cari pekerjaan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "Apa kamu mau bergabung dengan kami saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "Asyik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "Tapi, bukannya dia samurai yang meninggalkan Shogunate? Membawa orang seperti dia di Inazuma... apa tidak membawa masalah buat kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "...Itu benar. Dengan identitasku, aku khawatir akan menimbulkan masalah untuk kalian kalau bergabung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Hahaha, kurasa tidak akan jadi masalah. Kami cuma berkeliling mencari bahan untuk dimasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "Dengan identitas Paman, paling cocok melakukan sesuatu yang tidak berhubungan dengan Shogunate atau samurai sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Kalau paman bekerja jadi pengawal atau penjaga, malah akan menimbulkan kecurigaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "Dan lagi, tidak ada alasan membiarkan orang baik seperti Paman kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "Sebagai seorang koki, aku tidak bisa membiarkannya. Ada banyak masalah yang tidak bisa kuurus, tapi setidaknya aku bisa menjamin kamu tidak akan kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Tuan, tuan sangat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Hehe, bagaimana, Paman? Mau bergabung dengan kami? Meskipun gajinya kecil, tapi setidaknya cukup lah untuk makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "De-Dengan senang hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "Horee~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "Yah, mungkin ini adalah hal baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "Oke! Semuanya sudah bekerja keras, dan sudah pada kelaparan. Meskipun tidak mudah memasak di sini... tapi aku akan mencari cara untuk memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "Pengembara, kamu juga tidak perlu kerja lagi, aku akan menyiapkannya dan kamu tunggu di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "Kalau begitu, ayo makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Cukup deh... Haha, aku pakai nasi sisa untuk buat Onigiri ini. Meskipun tidak begitu rapi, tapi cukup untuk mengisi perut. Ayo makan semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "Oh iya, Pengembara. Terima kasih atas bantuanmu. Resep ini dari Paman Munehisa, dan aku menyalinnya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "Kata dia resep khusus ini ditulis waktu dia masih bekerja di Shogunate. Kalau tertarik, kamu bisa mempelajarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Oke, cukup bicaranya, ayo kita makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "Lain kali ingat untuk makan pagi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Mereka terlalu sensitif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "Dalam situasi mereka, bersikap sensitif memang hal yang wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Tapi kurasa mereka sebenarnya hanya mencari alasan untuk memberiku pelajaran karena \"tidak patuh\", dan mau menunjukkan kekuatan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Bagaimanapun juga, aku sudah menolak ajakan mereka berkali-kali, jadi mereka pasti kesal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Jangan-jangan, para Kairagi itu semuanya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Tidak tentu. Tapi mereka semua adalah pengecut yang mengayunkan pedang ke orang lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "Kenapa kamu meninggalkan Shogunate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Aku hanya... tidak setuju dengan kebijakan Shogunate di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Aku hanyalah seorang samurai, aku juga tidak mengerti apa kebijakan itu akan berguna atau tidak untuk bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Yang kutahu adalah kalau kebijakan mereka bertentangan dengan prinsipku. Jadi, aku memutuskan untuk pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Hehe, mungkin aku yang terlalu kuno dan tidak bisa menerima perubahan... Kamu boleh menertawakanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "Akhirnya kenyang juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160502,
					"content": "Kenapa kamu mau membantunya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "Maksudmu Paman Munehisa? Tentu saja karena etika profesional seorang koki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160504,
					"content": "Bercanda kok. Tapi aku benar-benar tidak tega melihat orang baik sepertinya kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160505,
					"content": "Tidak, tidak... mungkin bisa dibilang... aku tidak ingin melihat siapa pun kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160506,
					"content": "Kelaparan adalah hal yang mengerikan, aku... pernah merasakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160507,
					"content": "Saat sedang kelaparan... orang bisa melakukan hal-hal yang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160508,
					"content": "Kurasa kalau setiap orang di dunia bisa makan enak, mungkin bisa mencegah terjadinya banyak hal buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160509,
					"content": "Meskipun bukan sesuatu yang bisa kulakukan sendirian, tapi sebagai koki setidaknya aku bisa menjamin orang-orang di sekitarku makan kenyang dan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160510,
					"content": "Haha, terus terang aku cuma mau semua orang bisa makan kenyang dan enak. Benar-benar impian yang tidak seru, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160511,
					"content": "Itu cita-cita yang sangat bagus kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "Hehe, terima kasih loh. Ayo makan lagi, jangan menyisakan makanan. Itu dosa besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
