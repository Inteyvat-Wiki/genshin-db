			"dialogs": [
				{
					"id": 220160701,
					"content": "Dua orang ini benar-benar deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Sepertinya kamu masih tidak terlalu memercayainya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Maksudmu Kamei Munehisa? Tentu saja... kami baru bertemu beberapa kali, mana mungkin semudah itu aku percaya padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "...Tapi, aku percaya dengan penilaian Xudong meskipun aku tidak memercayai Kamei Munehisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "Kamu dari Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Bisa dibilang begitu... Awalnya aku keluar dari Sumeru Akademiya untuk meneliti, lalu bertemu Xudong di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Dia mau keliling dunia untuk mempelajari resep baru, dan penelitianku juga berhubungan dengan makanan. Setelah diskusi beberapa kali, akhirnya kami memutuskan untuk bepergian bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "Awalnya kami pergi ke Mondstadt, lalu tiba-tiba dikepung oleh banyak musuh, untungnya Julie membantu kita mengusirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Lalu Julie mendengar kalau kita berencana bertualang untuk mencari bahan-bahan makanan, lalu dia langsung mau bergabung dengan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Meskipun dia bilang kalau dia memang mau bertualang ke banyak tempat, tapi kurasa dia hanya ingin makan makanan enak saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "Setelah ini sepertinya kita akan menuju Sumeru. Topik penelitianku juga sudah hampir selesai, saatnya kembali ke Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Hmm, kalau mereka ke Sumeru, mereka harus mencicipi makanan khas Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
