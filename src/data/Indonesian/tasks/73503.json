			},
			"dialogs": [
				{
					"id": 735030301,
					"content": "\"Mencoba laut dangkal pada cabang kebijaksanaan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kotak yang Berisi Teka-Teki"
				}
			]
		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Ini adalah peti harta terakhir, yang kali ini tidak perlu teka-teki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Tapi, apa yang harus ditaruh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Benda yang cukup berharga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Masuk akal sih, nilai dari benda yang ada di dalam peti harta ini, setidaknya harus sepadan dengan kerja keras si pemecah teka-teki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Bicara tentang nilai, yang paling tepat tentu saja adalah Mora. Ah, aku taruh lebih banyak Mora deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "Oke, teka-teki ini sudah selesai, terima kasih atas bantuanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Ini untukmu, anggaplah sebagai imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "Oh, sebenarnya aku mau diskusi lebih dalam soal teka-teki ini denganmu, tapi aku harus kembali ke Akademiya, masih ada urusan di sana yang harus diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Jika dalam perjalanan kamu menemukan teka-teki yang aneh, atau teka-teki yang membingungkanmu, langsung saja cari aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Kita bisa bahas detailnya bersama, lalu ... Kita taruh teka-teki baru buat petualang lain! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "Sampai jumpa, Pengembara. Hati-hati dalam perjalananmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Semoga Treasure Hoarder yang bernama Narzam tidak menyebabkan masalah serius ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Sesuatu yang punya nilai praktis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Nilai praktis? Wah ... apa barang yang punya nilai praktis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Oh ya! Aku baru saja dapat resep dari seseorang beberapa hari lalu. Yuk taruh di kotak ini sebagai hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "Pengalaman berpikir keras ini adalah harta terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Hahahahaha! Kamu benar! Benar sekali! Memikirkan sesuatu dengan keras memang merupakan pengalaman yang sangat berharga! Jika dibandingkan dengan itu, hal-hal lain jadi tidak berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Enggak gitu juga sih! Taruh sedikit Mora atau resep di dalamnya! Kalau enggak juga kan bisa taruh sayuran atau buah-buahan, jangan enggak taruh apa-apa banget lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Iya iya, aku bercanda kok. Aku pasti akan taruh sesuatu di dalamnya sebagai hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
