					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Astrolog itu akan kehilangan kemampuan dan tidak dapat melihat kabut bayangan lagi. Karena itu, prinsip adalah prinsip.",
