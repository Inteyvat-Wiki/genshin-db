			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tuan Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Penginapan dibuka di tempat seperti ini, tentu saja bisnisnya tidak ramai)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, kamu datang tepat pada waktunya! Apa kamu melihat sebuah cincin giok di tengah perjalananmu ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Tuan Zhu"
				},
				{
					"id": 105000203,
					"content": "Cincin giok? Aku tidak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Waduh, cincin kesayanganku ditelan Slime begitu saja saat aku lengah. Itu cincin pemberian ibuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Tuan Zhu"
				},
				{
					"id": 105000205,
					"content": "Kamu tidak perlu khawatir, ada Mona di sini. Kemampuan astrologinya sangat hebat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Tidak bisa. Astrologi dipakai untuk meramalkan sesuatu yang serius, bukan untuk hal-hal yang sepele seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Tapi bukankah kamu pernah bilang kalau pemilik toko ini sangat baik kepadamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Ini adalah hubungannya dengan kehormatan dan konsep pemikiranku. Bila seorang astrolog berpikir bahwa astrologi dapat menyelesaikan semua masalah, bintang-bintang tidak akan memberi petunjuk kepadanya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Astrolog itu akan kehilangan kemampuan dan tidak dapat melihat kabut bayangan lagi. Karena itu, prinsip adalah prinsip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Sayang sekali kemampuan sehebat ini tidak dipakai untuk menghasilkan uang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*huff* Awalnya aku ingin memberikan kalian 20.000 Mora sebagai imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Tuan Zhu"
				},
				{
					"id": 105000212,
					"content": "20.000?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Ti, tidak kok. Hanya saja aku merasa orang yang menemukan cincin sangat beruntung, bisa mendapatkan 20.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Kamu tadi baru mengatakan tentang kehormatan seorang astrolog.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "*Ehem* Memang benar, tapi... Pemilik toko rela mengeluarkan begitu banyak uang demi cincin itu. Cincin itu pasti bermakna sangat dalam baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Tidak baik juga kalau kita pergi begitu saja. Kita cari dulu cincin itu. Mungkin ada cara lain untuk mencarinya selain dengan menggunakan ramalan astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, Paimon tahu maksudnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
