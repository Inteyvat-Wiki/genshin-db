					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*huff* Awalnya aku ingin memberikan kalian 20.000 Mora sebagai imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Tuan Zhu"
				},
				{
					"id": 105000213,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "Wajahmu kelihatan aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "20.000?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Kamu tadi baru mengatakan tentang kehormatan seorang astrolog.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "Prinsip adalah prinsip bukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "Ti, tidak kok. Hanya saja aku merasa orang yang menemukan cincin sangat beruntung, bisa mendapatkan 20.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "*Ehem* Memang benar, tapi... Pemilik toko rela mengeluarkan begitu banyak uang demi cincin itu. Cincin itu pasti bermakna sangat dalam baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Tidak baik juga kalau kita pergi begitu saja. Kita cari dulu cincin itu. Mungkin ada cara lain untuk mencarinya selain dengan menggunakan ramalan astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, Paimon tahu maksudnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "Kenapa lagi-lagi aku dilibatkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, tugas ini kuserahkan kepadamu. Ini tugas pertama yang diberikan guru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Hmm, karena cincinnya ditelan oleh Slime, kita bisa gunakan \"Elemental Bait\" untuk memancing para Slime di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "Kamu tahu tidak? Saat sedang membuat anggur, Dawn Winery tidak sengaja menciptakan sesuatu yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "Walaupun resepnya rahasia, tapi resep ini punya daya tarik yang kuat terhadap para Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Hebat kamu, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Jangan bilang kalau kamu sebenarnya berencana untuk memakannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Sebenarnya... Hehehe, aku diam-diam membawanya sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Aku partner yang bisa diandalkan, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "Aduh, jangan terlalu memikirkan alasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Sepertinya kalian sudah punya rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Ya, kami akan segera kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050009,
			"completionStepIds": [
				1050002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050002",
