					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Tidak bisa. Astrologi dipakai untuk meramalkan sesuatu yang serius, bukan untuk hal-hal yang sepele seperti ini.",
