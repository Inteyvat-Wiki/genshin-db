				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "Ke, kenapa kamu tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "Karena aku adalah ahli ramalan astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "Kalau tidak ada pertanyaan lagi, ayo kita berangkat sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Otakku penuh dengan pertanyaan sekarang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "*fuhh* Benar-benar merepotkan. Baiklah, aku akan menjelaskannya dengan sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "Namaku Astrologis Mona Megistus. Karena salah menyebut nama itu tidak sopan, aku biasanya meminta orang-orang memanggilku Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "Aku adalah seorang ahli astrologi. Aku sedang dalam misi mengambilkan sebuah kotak di Mondstadt untuk guruku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Ini adalah perjanjian yang pernah dibuat beliau dengan temannya 50 tahun lalu. Namun sayangnya di usianya yang sekarang, beliau tidak bisa berjalan lincah seperti dulu lagi. Jadi dia mengandalkanku untuk melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Mengambil kotak... Sepertinya hal ini tidak berhubungan dengan kami sama sekali. Kenapa kamu harus melibatkan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Karena... Aku masih ingin mengadu kemampuan dengan penjaga kotak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "Guruku dan temannya bersaing seumur hidup dalam bidang okultisme, tapi sampai sekarang belum ada yang menang dan kalah. Kalau aku bisa menang, maka berarti aku lebih hebat dari guru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "Oh, jadi kamu ingin membuktikan diri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "Ehem, yang benar adalah ingin membuktikan kedudukan dan kemampuan ilmu astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Tapi dari hasil ramalan astrologiku, teman guruku sudah meninggalkan Mondstadt, dan penerusnya lah yang menjaga kotak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Sama sepertiku, kemampuan sang penerus pasti sudah melampaui kemampuan gurunya. Aku tidak boleh lengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "Aku ingin memenangkan perlombaan ini, jadi orang pertama yang kupikir untuk menjadi asistenku adalah kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "Aku... tidak bisa ilmu astrologi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "Kenapa dia bisa terlibat di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Pengetahuan yang diwariskan guru kepadaku masih harus terus diteruskan kepada orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "Kalau misalnya aku membawa muridku saat bertemu dengannya, bukankah berarti aku sudah melampaui dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "Dan kamu adalah pahlawan Mondstadt, setara dengan statusku, jadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "Aku tidak mau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "Aduh, kamu tidak perlu benar-benar menjadi muridku, kamu hanya perlu bersandiwara saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Ditambah lagi, pergi mengambil kotak bersamaku adalah hal yang menguntungkan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Setelah aku bertemu dengan sang penerus dan bertukar ilmu, aku jadi bisa melihat nasibmu dengan lebih jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Lalu aku juga bisa menjawab segala sesuatu yang dulunya sulit diramal, seperti tentang dewa dan saudara yang menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "Itu memang cara yang lebih cepat dibandingkan dengan mencari di seluruh pelosok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "Syaratnya cukup menarik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Khukhukhu, keputusan yang bijaksana. Ayo kita berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Tapi sebelum pergi, aku ingin mengunjungi satu tempat terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Baiklah, aku akan menemanimu bermain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "Sejak kapan aku menjadi muridmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "Bagaimana bisa kamu terpikir aku untuk menjadi asisten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "Kesimpulannya adalah kamu hanya ingin kelihatan hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "Apa sih? Aku hanya ingin menggunakan kesempatan untuk membuktikan kedudukan dan kemampuanku di astrologi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "Pertama, siapakah kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
