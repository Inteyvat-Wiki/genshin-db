			"dialogs": [
				{
					"id": 747090101,
					"content": "#Terima kasih atas kerja keras kalian, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Aku sudah mengerti kondisi pasien kita, jadi aku sudah racikkan obat Melusine khusus untuk mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Menambahkan racikan khusus ini ke dalam tangki air seharusnya bisa membantu menenangkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Jadi kamu mau ngubah tangkinya jadi spa raksasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "Ini beneran rencana yang kamu banget, Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Tapi bukannya ini hanya meredakan gejala mereka sementara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Kamu benar sekali. Aku perlu mengundang berbagai jenis ikan untuk pemeriksaan fisik sebelum bisa menentukan apa masalah sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Aku akan membuat daftar pasien yang perlu diperiksa berdasarkan karakteristik yang aku butuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "Aku akan berterima kasih sekali kalau kalian bisa bantu awasi ikan yang memenuhi kriteria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "Untuk benar-benar menyembuhkan mereka, kita masih harus menemukan akar masalahnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
