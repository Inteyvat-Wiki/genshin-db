			"dialogs": [
				{
					"id": 227010601,
					"content": "Ya, itu untuk sakit kepalanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Kalau kamu butuh obat, aku bisa mengumpulkannya untukmu. Kenapa harus minta tolong kepada orang yang lewat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010603,
					"content": "Dan juga, kita tidak tahu apa pun tentang mereka atau pun latar belakang mereka, bagaimana kalau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010604,
					"content": "... Cukup, Que'er. Mereka sudah membantu kita, jangan berpikiran buruk terhadap orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Terima kasih sekali lagi, ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Ya, ambil dan segeralah pergi. Dia sakit kepala tidak boleh kena angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010607,
					"content": "Ayo cepat kita ke sana untuk menghindari angin, aku akan membuatkan teh manis untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Que'er"
				}
			]
		},
