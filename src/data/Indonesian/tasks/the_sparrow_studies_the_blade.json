			"dialogs": [
				{
					"id": 227010701,
					"content": "Sebenarnya, itu untuk sakit tenggorokanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "Ehem! Temanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "... Apakah kamu mengatkan bahwa aku lemah? Oh, kamu pikir suaraku seperti ini karena sakit tenggorokan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010704,
					"content": "Yah tapi untungnya bunga-bunga Qingxin ini tidak sia-sia, karena bisa digunakan untuk menyembuhkan sakit kepalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010705,
					"content": "Que'er, dengarkan aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Ayolah, cepat pergi dari sini, jangan sampai kena angin! Aku akan membuatkan teh manis untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010707,
					"content": "Dan kamu, ambillah ini dan segeralah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Que'er"
				}
			]
		},
