			"dialogs": [
				{
					"id": 227010501,
					"content": "Kamu sudah kembali! Mengenai hal yang kupercayakan padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Aku sudah mendapatkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "Seharusnya ini cukup, terima kasih, teman. Silakan ambil ini sebagai imbalannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Hah? Untuk apa bunga-bunga Qingxin ini? Oh tidak, kamu sakit kepala lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Que'er"
				}
			]
		},
		{
