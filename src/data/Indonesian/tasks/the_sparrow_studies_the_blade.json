			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Di sini saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Sebenarnya ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*huff* Ini tentang dia... Little Que'er, juniorku. Kami selalu berlatih bela diri bersama, seperti wujud dan bayangan, kemampuannya tidak kalah denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Kami datang ke sini untuk mencari petunjuk tentang Adeptus, tetapi perjalanan ini sangat berat, dan temanku itu suka berbicara tiada henti... Beberapa hari yang lalu dia jatuh sakit karena flu, dan sekarang sakit tenggorokan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Aku merasa kemampuan bertarungmu cukup hebat, aku dengan rendah hati memohon kepadamu untuk membantuku mencari tiga bunga Qingxin di atas tebing sebelah, untuk direndam di dalam air panas dan digunakan untuk menyembuhkan tenggorokan Que'er yang sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "Terima kasih banyak, teman. Que'er adalah orang yang bersemangat, dan aku tidak bisa meninggalkannya sendirian untuk mencari obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Kenapa kamu melakukan hal ini tanpa sepengetahuannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Kamu mungkin merasa ini lucu. Que'er memiliki semangat juang yang kuat dan dia tidak akan membiarkan orang lain menganggapnya lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Kalau aku memberi tahunya bahwa aku pergi mencari obat untuknya, dia pasti akan menolak tanpa berpikir dua kali. Karena hal itulah, aku harus bertindak tanpa sepengetahuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Selain itu, aku juga tidak bisa meninggalkannya sendirian di sini saat aku pergi mencari obat. Itulah sebabnya aku harus meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
