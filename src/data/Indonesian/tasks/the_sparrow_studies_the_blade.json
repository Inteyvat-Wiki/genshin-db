					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Apa yang kamu inginkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Hei! Tunjukkan sedikit rasa hormat saat kamu berbicara kepadanya, mengerti!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010203,
					"content": "Itu tidak perlu... akulah yang memulai pembicaraan dengan mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Hmph! selama mereka bukan pencari Adeptus yang ingin mengambil tempat kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010205,
					"content": "Ya, terima kasih atas pengertianmu... aku rasa kita akan baik-baik saja. Sekarang, sebaiknya kamu beristirahat dulu, selagi aku berbicara dengan teman ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Tapi, apakah ada sesuatu yang tidak bisa kamu katakan di depanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010207,
					"content": "Ini hanyalah hal yang akan membuatmu bosan, kamu tidak akan tertarik untuk mendengarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hmm, baiklah, pasti kamu mau bicara tentang Klan Guhua, lagi... Baik, kalau kamu tidak ingin aku mendengarnya, aku akan membiarkanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010209,
					"content": "Teman, ikuti aku ke sana, kita akan berbicara empat mata denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
