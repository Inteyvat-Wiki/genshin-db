				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "Ini dia barangnya. Terima kasih ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Kamu mau buka toko bunga ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Aduh, bukan begitu ... aku sekali beli langsung banyakan, biar tidak bolak-balik ke sana terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Kamu istirahat saja dulu di sebelah! Mau kutanam dulu bibitnya terus kuberikan pupuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef mulai menata pot bunganya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Selesai! Begini sudah oke. Nanti Nermin tinggal menyiramnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "Pengembara, bisakah kamu ... membantuku mengantarkan pot bunga ini untuk Nermin ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Kenapa kamu tidak pergi sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Aku harus terus mengawasi persimpangan jalan ini. Kalau nanti ada kiriman makanan atau barang kebutuhan lainnya, aku harus mencari orang dari desa untuk menerimanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Kamu juga pasti sudah merasakannya sendiri ... suhu di sini. Kalau proses serah terimanya terlalu lama, barangnya bisa keburu rusak karena kepanasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "Tolong ya, Pengembara. Nermin tinggal di dekat sini, aku hanya butuh bantuanmu untuk mengirimkannya pot bunga ini saja. Aku akan pikirkan cara untuk mengangkut sisanya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "Kamu ngapain beli sebanyak ini?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
