				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Seseorang di dalam mendengar ada yang datang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Halo, apa ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330503,
					"content": "Tentang bunga di pot ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Ini ... kiriman bunga dari Raef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330505,
					"content": "Di dalamnya sudah ditanam bunga? Sungguh? Wah, terima kasih ya sudah mengantarkannya, aku suka sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330506,
					"content": "Tapi ... apa aku bisa merawatnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330507,
					"content": "Apa kamu pernah menanam bunga sebelumnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Aku ... tidak begitu pintar merawat tanaman. Banyak tanaman yang dulu kutanam pada layu semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330509,
					"content": "Bunga ini pastinya lebih halus, kalau saja sampai layu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330510,
					"content": "Emm, tidak boleh begitu. Berhubung bunganya sudah ada di tanganku, aku harus merawatnya baik-baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330511,
					"content": "Mungkin Nenek Kulsoom tahu solusi untuk menyelesaikan masalah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
