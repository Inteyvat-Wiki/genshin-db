				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "Eh, kamu sudah balik, Pengembara. Terima kasih ya ... Nermin bilang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Dia khawatir tidak bisa menanam bunganya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Aduh ... akan kubantu dia mempelajarinya. Kalau masih saja tidak bisa aku akan tanya ke orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "Kalau masih saja tidak bisa, aku ... aku mau ... carikan bunga yang gampang ditanam dan dirawat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "*ehem* Ngomong-ngomong ... terima kasih atas bantuanmu, Pengembara. Ambillah imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Sebentar lagi aku mau kirim barang lainnya buat Nermin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Tunggu, peralatan berkebun ini apa tidak ada panduannya? Aku benar-benar tidak tahu cara pakainya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "Kamu belum pernah kirim bunga buat dia ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Ya tidak sampai belum pernah kirim juga sih ... tapi semua bunga yang dulu kuberikan itu semuanya yang sudah tumbuh. Jadi waktu sampai di desa, bunganya sudah hampir kering kepanasan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Karena alasan itu, kali ini kuputuskan untuk memberikan Nermin bunga yang baru saja ditanam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
