			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "Ah, tamu yang terhormat, jika... ingin beristirahat, silakan saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410203,
					"content": "Kami ingin memberikan Lentera Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "Lentera Xiao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410205,
					"content": "Yu, Lentera Xiao ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng? Hei, apakah kamu yang membuat Lentera Xiao ini? Te-terima kasih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410207,
					"content": "Kakak ini yang mengajariku membuatnya. Sebenarnya hasilnya tidak terlalu bagus, apakah... kamu suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Lentera Xiao ini bagus sekali! Aku sangat menyukainya. Aku sedih karena entah kapan aku ada waktu untuk membuat Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410209,
					"content": "Terima kasih, Mengmeng. Nanti aku akan memanggil orang untuk membantuku menggantung Lentera Xiao ini di atas pintu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410210,
					"content": "Kenapa memanggil orang untuk membantu menggantung Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Oh itu... Iya, ayahku sedang sakit, jadi tidak bisa ke sini untuk menggantungnya. Aku terlalu pendek pasti tidak sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410213,
					"content": "Aku hanya bisa meminta bantuan orang di sekitar untuk menggantung Lentera Xiao di atas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410214,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Kamu mau membantuku? Terima kasih. Aku khawatir nanti kalau aku pergi cari orang untuk membantuku, tidak ada yang menjaga kedai ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410215,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Apakah di rumah tidak ada orang yang bisa menggantungnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
