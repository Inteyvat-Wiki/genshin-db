			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "Lentera Xiao ini bagus sekali, terima kasih, kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410402,
					"content": "Yu, ayo kita pergi bermain. Aku tahu satu tempat, bunga-bunga di sana sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "Barusan kakak ini mengajariku membuat Lentera Xiao. Aku juga akan mengajarimu setelah kembali dari sana, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Hmm... Tidak bisa, aku masih harus membereskan kedai teh. Meskipun tidak banyak tamu yang datang, tapi Tavern harus tetap bersih. Itu yang ayahku katakan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410405,
					"content": "Kalau begitu kita ngobrol saja, tidak perlu membuat Lentera Xiao. Bagaimana? Sebentar saja lalu kita kembali jadi tidak akan menghabiskan waktumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410407,
					"content": "Aku akan membantu membersihkan kedaimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "Eh? Tidak apa-apa? Tapi jadi terlalu merepotkanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410410,
					"content": "Kita pergi sebentar saja, dan segera kembali. Jadi tidak menghabiskan banyak waktumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "Kalau begitu terima kasih, kakak. Aku benar-benar berterima kasih padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Serahkan tugas bersih-bersih ini padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
