			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "Sepertinya mereka berdua masih bermain, jadi jangan terlalu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Tapi dalam suasana begini... mungkin kita jangan terlalu banyak mengganggu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Ingin mendengar apa yang mereka bicarakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Apakah memberikan karangan bunga pada ayahmu akan membuatnya cepat sembuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "Aku tidak tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410707,
					"content": "Di buku dikatakan bahwa hidup dengan bahagia bisa menyembuhkan penyakit dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Mengmeng rasa kamu sudah sangat berbakti, setiap hari membantu menjaga kedai, pasti ayahmu sangat bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Tapi, terkadang ayahku mengatakan... \"Jangan berada di kedai terus, banyak-banyaklah pergi bermain\" dan sebagainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410710,
					"content": "\"Nanti bunga-bunga di sekitar habis dipetik kalau kamu tidak menemani Mengmeng bermain.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410711,
					"content": "Ada banyak bunga di sini, tidak akan ada habisnya... Tunggu, aku buatkan rangkaian bunga untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Terima kasih Mengmeng, sudah waktunya kita kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410713,
