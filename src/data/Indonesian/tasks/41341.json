					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Aduh membuat Lentera Xiao itu sulit sekali ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "Ah kakak, apa kakak tahu cara membuat Lentera Xiao? Mengmeng tidak bisa membuatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Ada yang tidak terpasang, ada yang sulit dipahami, terkadang bahannya malah jatuh, atau benangnya putus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "Mengmeng ingin membuat Lentera Xiao ini untuk Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu terus menjaga kedai tehnya, dan tidak ada waktu bermain, apalagi waktu untuk membuat lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Tetapi dia seharusnya memiliki keinginan untuk diwujudkan kan, jadi Mengmeng pun ingin membuatkan lentera untuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "Aku akan membantumu membuatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Tapi, Mengmeng ingin membuat sendiri untuk diberikan padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "Selain itu, Mengmeng ingin tahu rahasia membuat Lentera Xiao. Dengan begitu aku bisa menjelaskannya ke Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "Kakak, apakah... kamu bisa mengajari Mengmeng membuat Lentera Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Makasih, kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Lentera Xiao ini seharusnya... sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "Terima kasih , kakak! Ayo kita cepat berikan Lentera Xiao ini pada Yu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "Aku akan buatkan satu untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
