			"dialogs": [
				{
					"id": 706750101,
					"content": "Oke, Prince sudah bikin penyesuaian di Papan Undangan. Setiap orang yang dapat undangan bisa masuk ke kamar khusus di sini untuk duel denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750102
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750102,
					"content": "Temanmu tidak usah jauh-jauh ke sini. Dan kamar ini juga diatur sedemikian rupa agar siapa pun bisa enak berduel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750103
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750103,
					"content": "Ha? Apa maksudnya \"mana ada kucing yang bisa kayak gitu\"? Ck, kamu belum cukup kenal sama Prince ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750104
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750104,
					"content": "Dan kamu juga belum paham sebetulnya kucing bisa apa saja! Nah, silakan pakai papan barunya dan undang temanmu berduel di kamar khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shuyun"
				}
			]
		}
