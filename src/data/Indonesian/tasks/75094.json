					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "Hmm, kayaknya kondisi oke, terus ada petunjuk pemakaian inkubatornya juga. Cobain yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
