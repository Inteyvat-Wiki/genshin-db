					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#Mau pakai inkubatornya? Supaya dia netas? {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
