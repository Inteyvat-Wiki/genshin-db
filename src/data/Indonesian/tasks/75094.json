				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Wow ... Paimon jadi takut! Monsternya datang tiba-tiba. Untung Paimon super kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Kalau gitu lain kali Paimon yang maju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Hah? Enggak, enggak, enggak! Kamu enggak bisa andalin Paimon! Paimon enggak mau kalau harus lawan monster horor nan mengerikan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "Fuwaaa! Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}, si cilik ini mulai gelisah. Yuk kita cari saja buat netasin telurnya dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Aktifkan inkubator.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "Inkubatornya sudah bisa bekerja lagi ...\\nSekarang cuma bisa nunggu ...\\nBerjam-jam berlalu, tapi tidak terjadi apa-apa pada telur Saurian. Kok tidak berubah ya ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "Nguuu ... Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Aneh. Kok enggak ada apa-apa. Mungkin kita salah? Yuk coba lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Coba lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Kamu mereset inkubator berdasarkan instruksi ...\\nTapi tidak ada seperti yang sebelumnya, jadi telurnya juga masih tidak berubah.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Duh ... Kita harus tunggu berapa lama lagi sih, mata Paimon sudah lima watt ... Otak Paimon pusing terus perut Paimon sudah keroncongan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Fuwaaa ... Nguuuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Hah?! Tunggu? Tunggu! Telurnya bergerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Gimana kalau tunggu lagi beberapa menit ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Setelah sekian lama ...\\nTelur Saurian-nya tidak berubah, tidak ada reaksi, tidak ada tanda-tanda menetas.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Masih enggak ada reaksi ... mungkin inkubatornya rusak? Tapi lampunya nyala! Mungkin masalahnya ada pada telurnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "Hmm, kalau cuma nunggu jadi sia-sia ... Mungkin telurnya harus diambil sama kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Selapar apa pun kamu, jangan pernah makan telur Saurian ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "Fuwa! Fuwawa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Ya pasti dong enggak Paimon makan! Jangan kasih {REALNAME[ID(2)|SHOWHOST(true)]} ide yang aneh-aneh deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Hei cilik, eh maksud Paimon ... kalau masalahnya memang di telurnya, berarti selama ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "*hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Jangan sedih {REALNAME[ID(2)|SHOWHOST(true)]}. Toh kita enggak bisa ngapa-ngapain juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Mungkin karena lingkungan di sini tidak cocok ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Benar! Mungkin telurnya enggak mau menetas karena mikirnya Natlan masih sama kayak sebelumnya dan sekarang bukan waktu tepat untuk pulang ke rumah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Gimanapun juga dia selalu sembunyi di sini, dan tidak tahu bahwa Natlan itu indah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "Jadi ayo kembali dan jaga baik-baik! Setiap hari, kami akan ceritakan tentang pemandangan menakjubkan itu, petualangan mendebarkan, dan semua itu melalui orang-orang yang sudah kita temui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "Pendek kata, kita kasih tahu betapa indahnya Natlan sekarang! Kalau dia tertarik, nanti juga menetas sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "Nguk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Atau ... telurnya tidak mengira sekarang adalah waktu yang tepat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, gimana menurutmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "Nguuu ... Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "Tidak begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Hah?! Tapi ... tadi ... Paimon ngelindur? Eh enggak deh. Kamu lihat juga kan, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "Nguuu ... Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Ah ... jadi si cilik ini tidak lihat juga? Jadi memang cuma imajinasi Paimon? Jadi sekarang gimana nih kita, {NICKNAME}, apa kita tunggu dulu sana",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Apa mungkin ... masalahnya memang di telurnya? Ta-Tapi kalau gitu, artinya ini tidak akan pernah bisa menetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "Masalahnya ada di telurnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Hah? Jadi ... artinya telur ini tidak akan pernah menetas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Hmph, sudah cukup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Ya kan! Tampilannya sudah serem gitu loh, jadi Paimon kira itu pasti musuh super kuat banget! Mengecewakan. Pukulannya bahkan tidak lebih kuat daripada si kecil di sini ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
