			"dialogs": [
				{
					"id": 705330101,
					"content": "Hebat. Ternyata penemuanku bisa dipakai untuk hal seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "Pengembara! Kita ketemu lagi. *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "Kirain sudah pergi dari Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "Rencananya sih begitu tapi ... ada perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "Ehem. Kembali ke topik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "Kali ini aku diminta Adventurers' Guild Mondstadt untuk membuat Lukisan Mekanik yang bisa dibongkar pasang, berdasarkan gambar kartu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "\"Kartu\" maksudnya itu, permainan ... Ah, Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "Katanya, lukisan ini akan digunakan di Kejuaraan Raja Invokation buat memeriahkan suasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "Duh, aku tidak bisa repot seperti ini. Harusnya aku fokus pada penemuanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Ah iya, aku bawa lukisan mekanik Mondstadt. Silakan kalau mau dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "Penemuanmu ada masalah lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "Tidak, tidak kok! Kali ini bukan itu ... dan tidak pernah seperti itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "Dulu aku minta tolong karena masalah monster, bukan masalah penemuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
		}
	]
