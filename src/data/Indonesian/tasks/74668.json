					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Eh? Barusan Patung The Seven-nya bersinar yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Aneh! Dulu-dulu rasanya enggak gini deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "Apa anehnya? Biasa juga nyala kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME} enggak kerasa apa-apa gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Ah? Air ... Airnya ngomong ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Hebat kalau bisa! Tapi kamu masih bisa bercanda kayak gitu, artinya enggak ada masalah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Tapi setelah bersinar barusan, udaranya kayak lebih lembap ya. Mungkin karena energi Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Hehe, Paimon dengar kalau bisa manfaatin Energi Elemental dengan baik di Fontaine, kita bisa nyelam! Mungkin ada harta karun tenggelam tuh di bawah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Urusan nyelamnya kamu saja yah. Paimon bakal ... tunggu kamu di tepian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "Yah, sepi dong nyelam sendirian ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Huuuu! Tapi kan, tapi kan ... ngeri banget di bawah air tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "Gimana kalau Paimon kebawa arus, terus pusing sampai muter-muter tujuh keliling, dan jadi enggak bisa terbang lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Kayak waktu sebelum Paimon ketemu kamu di Mondstadt dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Gampang, tinggal dipancing lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "Oh ya? Ya sudah deh ... Paimon ma-mau ikut kamu nyelam. Huh! Awas kalau bohong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Paimon, kerja, kerja, kerja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Wah, kok rasanya jadi kayak napas pakai insang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Terserahlah! Mana, kasih lihat Paimon insangnya! Cih, kamu ternyata enggak apa-apa. Sia-sia Paimon khawatir tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Aliran air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Memang wilayah kekuasaan Archon Hydro ini. Bahkan Patung The Seven-nya juga air mancur ... NGACO! Sinar barusan ASLI ANEH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}