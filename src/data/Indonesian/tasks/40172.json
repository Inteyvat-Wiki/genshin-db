					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720204,
					"content": "Minta waktu dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720205
					]
				},
				{
					"id": 401720205,
