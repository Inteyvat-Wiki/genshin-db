			"dialogs": [
				{
					"id": 401720401,
					"content": "Ada kitab gulungan tenun baru lagi! Kali ini ... peta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720402,
					"content": "Peta? Peta apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720403
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720403,
					"content": "Apa mungkin ... Mare Jivari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720404,
					"content": "Mare Jivari?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720405,
					"content": "Mare Jivari yang sudah berubah jadi tanah gersang semenjak perang itu. Atau lebih tepatnya, tempat yang jadi dikenal dengan nama Mare Jivari setelah peristiwa yang terjadi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720406,
					"content": "Abu monster dan pejuang yang bertarung di sana meliputi seluruh medan pertempuran. Kadang, tangisan dan pekikan yang menusuk tulang terdengar entah dari mana. Kadang pula, seluruh wilayah itu akan terbakar api yang menjulang ke langit, sampai suara-suara mengerikan itu tak dapat terdengar telinga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720407
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720407,
					"content": "Tempat yang penuh bahaya dan misteri. Selama berabad-abad, petualang paling jago dari yang jago mencoba membuktikan diri ke sana ... dan akhirnya harus meregang nyawa di tanah yang gersang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720408,
					"content": "Sampai dua atau tiga puluh tahun lalu, ketika peristiwa aneh mulai terjadi. Orang-orang bilang ada makhluk hitam setinggi gunung yang gentayangan di Mare Jivari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720409
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720409,
					"content": "Dan tak lama kemudian, seluruh area itu hilang dari muka bumi. Tidak ada yang tahu kenapa, tapi tempat yang menakutkan itu lenyap begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720410,
					"content": "HAH? Kok bisa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720411,
					"content": "Iya kan? Tapi kalau tidak salah, peta ini menunjukkan lokasi Mare Jivari sebelum hilang ditelan bumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720412,
					"content": "Di mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720413
					]
				},
				{
					"id": 401720413,
					"content": "Ujung barat Natlan. Sangat terpencil, jauh dari pemukiman suku mana pun. Tidak pernah didiami orang, tapi sejak Mare Jivari lenyap, mulai ada orang yang berdatangan ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720414,
					"content": "Tapi itu cuma kabarnya saja. Aku sendiri belum pernah ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720415
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720415,
					"content": "Efek umur kali ya. Semakin tua, semakin malas bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720416
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720416,
					"content": "Nenek cuma malas karena jauh. Jangan bikin alasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720417
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720417,
					"content": "Tahan! Ada roh yang menghampiri pecahan itu dan kitab gulungan tenunnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720418
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720418,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720419
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720419,
					"content": "Oh, badan Leyla gerak lagi tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720420,
					"content": "Reaksinya kuat. Apa jangan-jangan dia memang sedang mencari Mare Jivari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720421
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720421,
					"content": "Aku juga merasakan ... ada roh di dekat kita. Dalam kondisi hampir utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720422,
					"content": "Hiii ... Paimon kok malah merinding ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720423,
					"content": "Rencananya berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720424
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720424,
					"content": "Jadi, eh ... dia sudah bisa dibangunin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720425,
					"content": "Hari ini belum. Memulangkan roh ke tubuhnya itu lebih rumit dari sekadar menuangkan air dari satu botol ke botol lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720426
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720426,
					"content": "Aku harus pinjam pedang upacara, dan menyiapkan beberapa hal lain juga. Perlu dua hari lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720427
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720427,
					"content": "Tapi tenang, rohnya memang betul sudah kembali. Tinggal selangkah lagi, kita ketemu dua hari dari sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
}