			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "Pengembara! Tolong, kemarilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240102,
					"content": "Maaf, bolehkah aku minta waktumu sebentar? Apa kamu tertarik untuk menerima komisi baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240103,
					"content": "Tidak ada salahnya untuk mendengarkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "Jadi situasinya begini. Akhir-akhir ini di laporan Guild tertulis bahwa Hilichurl di alam liar mulai berkumpul lagi dan mengganggu rute para pedagang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240106,
					"content": "Kami telah mengutus sejumlah petualang untuk menyelidikinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240107,
					"content": "Semuanya melaporkan fenomena yang aneh — katanya di mana pun mereka menemukan sekelompok Hilichurl berkumpul bersama, pasti selalu ada satu Unusual Hilichurl di antaranya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240108,
					"content": "Kami yakin kalau \"Unusual Hilichurl\" ini adalah dalang di balik gangguan yang terjadi akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240114,
					"content": "Jadi, kita memerlukan seseorang untuk menangkap Unusual Hilichurl, atau setidaknya mengusirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240109,
					"content": "Pengembara, apa kamu tertarik untuk menerima komisi ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240110,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "Terima kasih! Aku sudah menandai lokasi untukmu di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240113,
					"content": "Terdapat aktivitas Hilichurl yang dilaporkan di setiap area ini. Silakan mulai menyelidikinya dengan mengunjungi area-area tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240115,
					"content": "Jika kamu bertemu dengan Unusual Hilichurl... Tolong berhati-hatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240111,
					"content": "Kami akan usahakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "Komisi seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "Untung kami datang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "Apa kamu baik-baik saja...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "Ah... hampir saja, untung kalian datang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240204,
					"content": "*huff*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240205,
					"content": "Aku tidak ngerti, padahal semuanya berjalan dengan mulus... Omongan apa ya yang salah tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240206,
					"content": "Ah, ya sudahlah... Terima kasih karena telah menyelamatkanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240207,
					"content": "Kelihatannya dia kecewa sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240208,
					"content": "Hmm... Kalian sudah lihat kan yang barusan terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240223,
					"content": "Strategiku sebelumnya untuk mencoba berinteraksi dengan Hilichurl ternyata terlalu berisiko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240210,
					"content": "Begitu ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "Apa ada yang bisa kulakukan untuk membantumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "Tapi... aku menyesal sekali karena sudah melewatkan kesempatan emas untuk berkomunikasi dengan Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240212,
					"content": "Sepertinya pekerjaanku tentang kamus kompilasi kosakata harus ditunda lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240213,
					"content": "Aku bisa membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "Jadi, aku akan meminta seseorang untuk mewakiliku memverifikasi keakuratan isi buku milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240214,
					"content": "Be-benarkah? Asyik! ...Baiklah, kalau begitu kalian pegang buku ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240215,
					"content": "Wah, emosi anak kecil berubah begitu saja. Padahal barusan lagi sedih, tapi sekarang semangat sekali karena bisa menyuruh kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240217,
					"content": "...Prinsipnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "Kalau kamu menemukan kesulitan saat berkomunikasi dengan mereka, kamu bisa mengatasinya dengan membaca buku ini... Yah, prinsipnya sih begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240218,
					"content": "Jadi kamu sendiri tidak ngerti apa yang kamu tulis di bukumu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240219,
					"content": "Masalah pada penelitian baru bisa ketemu kalau sudah dicoba! Kalau belum, gimana aku tahu teoriku benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240225,
					"content": "Hmm... Ah tidak, sudahlah, kamu mungkin tidak akan mengerti apa yang akan kukatakan barusan. Selain itu... terima kasih lagi karena sudah menyelamatkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240221,
					"content": "Selamat datang di tim kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "Karena kita sudah sejauh ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "Baiklah, jika kamu tidak keberatan, aku akan bergabung denganmu dan sekarang kita akan pergi untuk menemukan Hilichurl yang bisa diajak berinteraksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Ella Musk"
				}
			]
		}
	]
}