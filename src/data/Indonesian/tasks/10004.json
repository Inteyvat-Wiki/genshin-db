			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! Kami punya sesuatu nih buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Oh, {NICKNAME}, Paimon! Kalian kelihatannya semangat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Punya sesuatu buat aku? Jangan-jangan ... ada cara cepat dan mudah untuk dapetin Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Yah, sebenarnya, ini semacam \"tugas\" dari mastermu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Aku enggak mau terima deh, makasih! Ugh, tapi sepertinya aku tidak punya pilihan ya ... ambisi dalam hidup itu penting, dan sebagainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "Aku tahu ini akan jadi siksaan. Aku sudah terlalu paham dengan nenek tua itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Kenapa kamu enggak coba-coba lihat dulu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Hmm, buku ini ... sepertinya biasa saja buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Wah! Ada surat yang jatuh dari bukunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Oh! Mungkin dia lagi nyoba ... ngajak damai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Entahlah. Yang jelas, sepertinya aku harus membuka ketiga surat ini secara berurutan. Baiklah, ayo kita mulai dari yang pertama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Kalau ini memang \"tugas\" dia, seharusnya tidak masalah kalau kita semua membacanya. Ayo, kita baca apa isinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "\"Oh, sudah lama sekali ya, muridku. Sayang sekali, akhir-akhir ini aku semakin kesulitan untuk bangun dan bergerak ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Hmph, berusaha memanfaatkan rasa simpati ya. Setidaknya dia bisa berusaha membuatnya terdengar lebih tulus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "\"Ingat saat aku mengejarmu, dan kamu lari ketakutan, berusaha menggunakan ilusi Hydro-mu untuk mengalihkan perhatianku? Ah, rasanya baru kemarin ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "\"Sekarang, kamu sudah pergi sendiri, sementara aku cuma berbaring di kursi goyang seharian. Aku benar-benar harus mulai berolahraga lagi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Kalau begitu, cari cara lain saja, dasar nenek tua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Um, kalau dirasa-rasa, kayaknya ini lumayan personal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "\"Aku yakin sekarang kamu penasaran kan dengan tujuan dari surat ini. Dan untuk itu, kusampaikan ... Jika kamu ingin belajar cara meramal nasib sebuah kerajaan, atau bahkan seluruh dunia ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "\"Pergilah ke Sumeru dan cari gerbang menuju kerajaan bawah tanah. Setelah sampai di sana, bukalah surat kedua.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Hmm, tapi dia memang pandai memancing orang, pastinya sih begitu. Apa dia serius mau mewariskan teknik rahasianya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Sepertinya dia memang sudah semakin tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "Hubungan kalian berdua aneh juga ya. Kalau ngobrolin hal-hal yang sensitif ... kalian malah bertengkar. Tapi kalau lagi ngebahas hal-hal akademis yang garing, kalian malah jadi emosional ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Ngomong-ngomong, \"gerbang menuju kerajaan bawah tanah\" ini kedengarannya enggak asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Tunggu, kamu pernah mendengarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Ya. Kayaknya apa yang lagi kita pikirin sama deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Mantap habis! Berarti aku tidak perlu investigasi lagi! Tidak perlu menyewa pemandu, perlu penginapan, bahkan tidak perlu menghambur-hamburkan Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "Ayo, jangan buang waktu lagi, kita berangkat sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "Dan karena barusan kamu enggak nyebut biaya transportasinya, tebakan Paimon sih artinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Yep! Cara yang biasa kita pakai! Ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
