			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Fiuh, jadi inget waktu musim panas ya. Segar banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "Jadi, inikah gerbang menuju kerajaan kuno Khaenri'ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "Aku yakin banyak rahasia dan tragedi yang tersembunyi di baliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Oke, kalau gitu ayo kita buka surat yang kedua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Coba kulihat ... Yap, yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "\"Seperti pepatah kuno Sumeru: Pengetahuan yang dihafal tidak akan berbuah, sampai disiram dengan hujan kebijaksanaan. Oleh karena itu, ada sebuah fenomena di tanah ini yang dikenal sebagai 'Tanda Apaosha.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "\"Itu adalah tanda langit yang menyala sebagai reaksi terhadap hasrat yang terlalu menggebu untuk mencari kebenaran. Dalam hal ini, mungkin lebih tepat untuk menyebutnya 'Tanda Kebenaran' ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "Catatan-catatan dari kerajaan kuno ini menyebutkan bahwa ada beberapa danau bawah tanah yang besar di Khaenri'ah, jernih dan tenang bagai cermin, permukaannya memantulkan bintang-bintang sejati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "\"Ini karena 'Tanda Kebenaran' yang tercipta di dalam air mampu menembus langit palsu dan terhubung dengan alam semesta luar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "Ternyata begitu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "Untuk mengamati gaya gravitasi dan pengaruh benda-benda langit, seseorang harus bisa melihat menembus langit palsu. Hanya dengan mendapatkan parameter kosmik ini, seseorang dapat meramalkan nasib dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "\"Sekarang, tugasmu adalah: Bukalah 'Tanda Kebenaran' di depan gerbang Khaenri'ah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "Sisanya adalah serangkaian hal tentang upacara yang dibuat si nenek tua untuk memanggil benda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Ya, semua lintasan planet dan ... simbol-simbol ini ... Paimon bahkan sudah enggak ngerti lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "Jadi, gimana menurutmu, Mona? Kamu mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Yah, walaupun aku malas mengakuinya, tapi sepertinya parameter yang dia buat bisa berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Sejujurnya, prospek ini sangat menarik. Sementara kalau sekarang kembali hanya akan membuatku membayar penginapan satu malam lagi. Jadi ... tidak ada waktu yang lebih tepat daripada sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Para utusan bintang yang abadi, para pengembara di antara bidang ekliptika dan ekuatorial, saudara-saudara celestial yang bersinar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Melintasi jalan berliku kekosongan gua. Aku, Mona Megistus, sang Astrolog, memohon kekuatan Hydro untuk menyeimbangkan takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "Demi kebijaksanaan dan kebenaran, biarlah dahaga ini terobati. Aku, Mona Megistus, sang Astrolog, memanggil kalian, wahai bintang-bintang, berdirilah di hadapanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "Ber-Berhasil enggak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Aaah! Monster? Kok bisa ada monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "Gagal. Tanda Kebenaran hanya terbuka sesaat saja, cukup untuk monster-monster itu menyelinap masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Sial! Aku bahkan enggak sempat lihat bintang-bintang sejati. Ya sudah deh ... akan kulampiaskan ke kalian saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
