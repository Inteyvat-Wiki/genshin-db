					"Lanyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Halo, apa ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Aku datang untuk mengambil baju ganti Ningguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ah ya, aku ingat. Tunggu sebentar ya, akan kuambilkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Setelah menunggu sekian lama, akhirnya Lanyang kembali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Ini dia. Tolong berikan bajunya ke Nona Ningguang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Lama juga kamu ambilnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Ya, ruangan ini penuh dengan barang-barang pribadi Nona Ningguang. Tidak hanya baju ... juga ada perhiasan dan aksesori lainnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Baru-baru ini Nona Ningguang meminta kita mengatur ulang ruangan ini. Sekarang masih sedang dalam proses, jadi berantakan sekali. Itulah kenapa aku lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Sepertinya koleksi pribadi Ningguang banyak sekali ya ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Pokoknya kamu sudah bisa mengambilnya. Terima kasih sudah mau repot-repot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Mungkin beginilah repotnya jadi sultan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
