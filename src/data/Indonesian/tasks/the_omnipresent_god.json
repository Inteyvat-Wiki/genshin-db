				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Jawab rasa penasaranku ini. Apa alasan yang membuatku melihatmu lagi di depan mataku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200302,
					"content": "Apa kamu mengira tindakan gegabahmu bisa melindungi orang-orang itu? Atau ... apa kamu memang hanya ingin menemuiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200303,
					"content": "Para Fatui memperdayai Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh? Tentunya kamu tidak membangunkanku dari meditasi abadi, hanya untuk mengatakan ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200306,
					"content": "Kalau memang demikian, berarti kamu terlalu meremehkanku. Aku sudah mengetahui seluk-beluk Dekrit Perburuan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200307,
					"content": "Kamu tahu segala hal yang terjadi di dunia luar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Tidak juga. Aku hanya tahu segala hal yang berkaitan dengan keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200309,
					"content": "Dekrit Perburuan Vision dilaksanakan dengan seizinku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200310,
					"content": "Aksi para Fatui sejauh ini belum menjadi ancaman bagi keabadian. Jika tidak, mereka sudah lama dimusnahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200311,
					"content": "Tapi Dekrit Perburuan Vision sangat merusak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Ambisi pribadi tidak punya tempat mutlak di keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200314,
					"content": "Kamu mungkin belum menyadarinya kalau seringkali ... manusia kehilangan lebih banyak hal lagi, saat mengejar ambisi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200315,
					"content": "Pikirkanlah hal ini — tidak ada yang akan kehilangan nyawa karena Vision-nya diambil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200316,
					"content": "Mereka yang kehilangan nyawanya justru malah orang-orang yang bersikeras mengejar ambisi sendiri, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200317,
					"content": "Teppei ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "Pengembara, keberadaanmu memang merupakan sebuah pengecualian di mataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200319,
					"content": "Terdapat banyak ketidakpastian yang tak terbatas dalam dirimu. Dengan kata lain, kamulah yang berjarak paling jauh dari keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200320,
					"content": "Jadi, aku tidak akan memaksamu memahami maksud tindakanku. Yang terpenting adalah, aku menapaki jalan keabadian demi rakyatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200321,
					"content": "Tempat ini adalah Plane of Euthymia-mu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Yang terbuat di alam bawah sadarmu, betul?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Benar. Ternyata kamu sangat memahaminya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200324,
					"content": "Sudahlah. Kamu sedang mencari kesempatan untuk menggoyahkan kehendakku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200325,
					"content": "Aku ke sini bukan untuk memperdebatkan prinsipmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Aku ke sini untuk menghancurkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200328,
					"content": "Baiklah, wahai kamu yang menentang keabadian ... Silakan memberiku pencerahanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200312,
					"content": "Warga Inazuma sudah kehilangan banyak hal karenanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Dekrit Perburuan Vision tidak seharusnya diterbitkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
