			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Kamu kalah, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200503,
					"content": "Ya, aku kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200504,
					"content": "Kenapa kamu tidak mau percaya pada rakyat sendiri dan kekuatan ambisi mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Ambisi mereka sudah jauh melampaui ruang dan waktu, dan tidak bisa dipadamkan oleh siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Ketika semua orang berusaha sekuat tenaga untuk maju ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Jadi ini pelajaran yang kamu dapat dari perjalananmu di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Ada bangsa di mana manusia fana menyingkirkan para dewa dan terus melangkah maju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Jadi, apakah kita harus membuang kemajuan begitu saja ... demi angan-angan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "Kamu dan aku sudah pernah menyaksikan harga yang harus dibayar untuk kemajuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200514,
					"content": "Keabadian ... hanya keabadianlah jalan satu-satunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200515,
					"content": "Prinsip Langit ... bagiku hanya omong kosong belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Singkat cerita, yang kamu inginkan sebenarnya hanyalah melindungi Inazuma tercintamu selama-lamanya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Kamu terlalu menyederhanakan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200518,
					"content": "Tapi apa bangsa ini sudah layak untuk menerima keabadian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Kehilangan ambisi, kehilangan potensi perubahan, tak beda dengan bangsa yang cangkangnya kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Huh, aku jadi penasaran, kehilangan macam apa lagi yang akan terjadi kalau bangsa semacam itu dihancurkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, tarik kembali ucapanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200522,
					"content": "Keabadian yang tak akan berubah, adalah janjiku pada rakyatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200523,
					"content": "Tetapi yang rakyatmu butuhkan bukanlah janji-janjimu. Mereka ingin perhatianmu ... ingin \"tatapan\" ilahimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "Maksudmu Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200525,
					"content": "Hidup manusia paling lama seratus tahun. Mereka tidak akan tahan hidup dengan kehilangan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200526,
					"content": "Tapi aku sudah pernah mengalami semua itu. Karena itulah aku memilih untuk membimbing mereka ke jalan yang benar untuk menuju keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200527,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Tapi keabadian adalah takdir yang terlalu kejam untukmu, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200530,
					"content": "Kamu bukan hanya berhenti memperhatikan dunia, tapi juga berhenti memperhatikan dirimu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Pasti rasanya sangat sepi di sini, sendirian selama berabad-abad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Tapi itu memang diperlukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200533,
					"content": "Dengan menolak kemajuan, kamu akan kehilangan banyak hal ... Kamu berusaha mencegah kehilangan, tapi apa kamu pernah pertimbangkan, seberapa besar kerugian yang akan kamu alami kalau terus diam di sini untuk keabadian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Jelas-jelas kamu kesepian, lalu demi keabadian, kamu memilih untuk meregangkan kesendirian itu hingga tak terbatas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Katakan padaku, kenapa langit di sini yang awalnya begitu suram sekarang bersinar kembali? Kenapa malah sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Tempat ini adalah Plane of Euthymia-mu, dunia di dalam hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Jadi artinya ... Kamu sebenarnya senang sekali bisa bertemu lagi denganku. Kamu sejak awal sudah tidak bisa menahan rasa kesepian yang berkepanjangan di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Tidak ada lagi yang bisa kukatakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200539,
					"content": "Hehehe, oh, tapi aku punya banyak sekali cerita untuk kamu. Biar kuceritakan semua yang terjadi selama beberapa abad ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Berapa lama ceritanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200541,
					"content": "Kitsune punya ingatan yang sangat baik. Aku ingat jelas setiap detail peristiwa yang terjadi selama ratusan tahun ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Jadi sepertinya aku perlu beberapa abad lagi untuk menceritakan semuanya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Ha ... Hahaha ... Miko, aku tidak pernah menyangka kalau aku berkesempatan untuk bertemu denganmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200544,
					"content": "*huff* Bertemu lagi denganmu, berarti sebuah perubahan dalam keabadian ... dan sebuah kejutan yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200545,
					"content": "Hehe, karena kamu sudah mengakuinya, berarti kita masih bisa berteman dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Sungguh sebuah percakapan yang kekanak-kanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200547,
					"content": "Karena aku sudah kalah oleh dirimu dan rencanamu, aku akan mengabulkan keinginanmu dan mencabut Dekrit Perburuan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200548,
					"content": "Tapi mengenai keabadian dan apakah bangsa ini perlu melangkah maju, aku perlu waktu untuk mempertimbangkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200549,
					"content": "Hehe, justru kamulah yang sejak awal bertingkah seperti anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Mereka dapat melampaui ekspektasi para dewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Dan bahkan dapat mengambil tugas para dewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
