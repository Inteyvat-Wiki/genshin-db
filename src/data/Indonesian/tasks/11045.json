			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "Kurasa kalian juga pasti pernah menemukan banyak misteri dan teka-teki selama perjalanan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "Sama seperti tes fisik, aku juga akan mengamati kecerdasan kalian melalui tes praktik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "Aku ingin kalian menjelajahi reruntuhan ini, dan beri tahu aku jawaban apa yang kalian temukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "Terdapat 2 teka-teki di kedua sisi reruntuhan ini. Setelah kedua teka-teki ini terpecahkan, mekanisme yang terdapat di tengah reruntuhan ini seharusnya akan menjadi aktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "Sama seperti tes fisik, kalian boleh berusaha memecahkan teka-tekinya dengan cara apa pun, dan aku akan mengamati gerak gerik kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "Sepertinya aku sudah semakin ahli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "Kamu memang seorang petualang yang berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "Kalau begitu, silakan dimulai. Kalian bisa memulai dari sisi manapun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Di mana ada kemauan, di situ ada jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Kalian harus mengingat kalau ini adalah tes kecerdasan, keberuntungan tidak akan dihitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Boleh tes tertulis saja tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "Ini adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Gambar yang asing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "Sepengetahuanku, ini adalah semacam teks yang tersebar di seluruh Teyvat. Tetapi aku masih belum berhasil memecahkan misteri teks ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "Masih banyak sekali yang belum kupahami. Aku juga masih tidak mengerti kenapa benda ini bisa berada di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "Kita catat saja dulu isinya. Aku akan meluangkan waktu untuk menelitinya lebih dalam nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "*huff* Lagi-lagi suatu hal yang tidak dimengerti. Misteri inilah, eksperimen itulah... Kapan kita akan melihat hasil kerja keras kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "Tapi sepertinya kalau kamu mau mendapatkan imbalan, kamu harus mau berusaha terlebih dahulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "Aku benar-benar telah mendapatkan banyak informasi dari semua hal ini. Bila dibandingkan, hadiah yang bisa kuberikan sangat amat kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Aku akan kembali ke perkemahan terlebih dahulu. Saat kalian kembali ke sana, sepertinya aku bisa memperlihatkan sebuah keajaiban kecil kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "Kalau begitu, sampai ketemu nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Paimon masih sangat penasaran dengan hasil dari semua kerja keras kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "Kalau urusanmu sudah selesai, ayo kita juga kembali ke perkemahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Jangan terburu-buru, kalian harus membuktikan kepadaku bahwa kalian tidak berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450414,
					"content": "Eh? Kamu! Ternyata kamu belum pergi dari sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "Tentu saja, aku terus mengamati semua yang kalian dan Albedo lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450416,
					"content": "Sepertinya kalian benar-benar lengah. Atau mungkin kalian tertipu oleh cara berpikirnya yang unik dan sifatnya yang ramah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450417,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Menuruti perintah orang asing, meminum ramuan tak dikenal, dan mengikuti eksperimen-eksperimen aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450420,
					"content": "Sepertinya bukan karena kalian naif, tapi karena kalian telah ditipu. Atau mungkin, kalian telah bekerja sama dari awal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450421,
					"content": "Sepertinya kamu adalah seorang suster yang terlalu was-was...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "Aku hanya mau membantu penelitiannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "Terserah apa pendapatmu tentang Albedo, tapi aku jauh lebih mengerti tentang dia daripada dirimu, orang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450425,
					"content": "Aku hanya ingin tahu satu hal: apakah ilmu alkimianya telah mengubahmu menjadi sesuatu yang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450426,
					"content": "Mana mungkin! Paimon pasti bisa merasakannya! Lagi pula, Albedo tidak menggunakan ilmu alkimianya sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "Kamu pasti tidak bisa merasakan gerak-gerik dari alkemis selevel Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450428,
					"content": "Pokoknya aku tidak bisa membiarkan seorang yang berpotensi menjadi berbahaya untuk kembali ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450429,
					"content": "Jadi, apa yang mau kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "Kamu datang untuk memastikan, silakan dipastikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "Kuakui kalian cukup pintar. Asalkan aku bisa memastikan kalau benda-benda yang kalian sentuh tidak berbahaya, maka itu sudah menjadi bukti yang cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450432,
					"content": "Aku sudah selesai memeriksa benda-benda lainnya, hanya simbol-simbol ini yang belum kuperiksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450433,
					"content": "Tapi kita juga tidak bisa membaca artinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "Aku tahu, lagi pula... sepertinya benar-benar hanya simbol, bukan sebuah mekanisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450452,
					"content": "Tapi untuk berjaga-jaga, lebih baik kusalin terlebih dahulu. Aku juga akan menjadikan lokasi ini lokasi penting dan harus diinspeksi secara rutin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450434,
					"content": "Baiklah. Untuk sekarang ini, sepertinya kalian bukan sebuah ancaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450435,
					"content": "Sama seperti harapanku. Aku akan sangat kesal kalau kalian sampai membuatku bekerja lembur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450436,
					"content": "Le... lembur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "Sebelum kita berpisah, aku hanya ingin menasehatimu, orang asing. Jangan terlalu memercayai Albedo, setidaknya jangan seperti hari ini. Kalian melakukan banyak hal berbahaya hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450439,
					"content": "Dia sudah pergi, benar-benar seenaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Sepertinya tidak banyak ya orang seperti dia di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Mungkin dia hanya merasa tidak aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Ah, Paimon sudah tidak peduli! Ayo kita temui Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Mungkin dia hanya sedikit sensitif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Kurasa dia bukan orang jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Maksudmu dia merencanakan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "Kuanggap aku berhasil melewati tes kecerdasan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "Sepertinya aku pernah melihatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Kalian sudah kembali! Waktunya pas sekali, aku hampir berhasil mendapatkan kesimpulannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "Tapi lama juga kalian turun ke sini, apakah kalian menemukan masalah di perjalanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Tidak ada apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Saatnya kalian mendengar hasilnya. Hari ini aku telah mendapatkan banyak sekali data dan aku sedikit kesulitan menganalisa semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "Tapi kesimpulan awal yang bisa kutarik dari semuanya adalah... Kamu sama seperti manusia biasa dari dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Lihat saja sudah bisa tahu hal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "Kita bekerja keras membanting tulang hanya untuk mendengar kesimpulan seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Tenang, tenang dulu. Mungkin kalian merasa ini adalah hal yang sudah seharusnya, tetapi sebenarnya segala hal di dunia ini tidak seperti penampilannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Apakah kalian pernah memikirkan kemungkinan ini? Kalau dunia Teyvat ini memiliki respon penolakan yang alami terhadap seorang yang datang dari luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Hanya dewa yang tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "Aku sempat berbicara soal hukum alam dari dunia ini. Kita berdua berbincang seperti ini kelihatannya adalah hal yang biasa saja, tapi bisa saja ini adalah sebuah keajaiban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "Karena benda lain yang datang dari dunia luar sepertimu adalah biji yang pernah kuceritakan. Di bawah hukum alam dunia Teyvat, biji ini gagal untuk tumbuh, apalagi berbunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "Tapi setelah aku mengamatimu, aku menemukan ide baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Ilmu alkimiaku juga mendapatkan inspirasi dengan menirumu, kemudian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Wah! Sepertinya, sepertinya ada sesuatu yang muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "Dari tidak ada menjadi ada, dari tunas menjadi subur, hingga berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Bukankah dengan memelihara sesuatu yang bukan dari dunia ini, kita juga sedang memelihara dunia ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Ahhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "Cantik sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*fuhh* Sepertinya hanya sebatas itu saja yang bisa kita lakukan. Mekar sesaat saja, tetapi indah tiada duanya. Pencapaian tertinggi dalam hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Paimon kira dengan semua usaha kita, biji itu bisa mekar selamanya. Tetapi sepertinya dia bahkan tidak berbuah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "Hidup terdiri dari berbagai jenis makhluk yang bebas, kita tidak bisa menentukan nilainya dari masa hidupnya. Hidup yang sekejap saja juga berharga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Umur pendek juga bukan sesuatu yang buruk. Hidup yang dijalani dengan efisien, dengan sempurna, dan tidak akan dihantui oleh rasa kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "Jadi, apakah kamu mengerti perkataanku tadi tentang, \"mungkin kita bisa berbincang seperti ini adalah sebuah keajaiban\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Yah, setidaknya aku masih belum layu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Eh? Kenapa suasananya menjadi berat begini ya...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hehehe, jangan murung begitu, {NICKNAME}, kan ada Paimon di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Albedo, sekarang Paimon semakin ingin menjadi temanmu~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "...terima kasih, kalian berdua. Meskipun aku telah menerima bahwa kesepian merupakan bagian dari hidup, tapi tidak ada salahnya juga memiliki teman baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, kamu telah membantuku menemukan inspirasi untuk membuat bunga itu mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Jadi aku adalah spesimen yang berguna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Bukan, waktu yang kuhabiskan dengan kalian berdua di atas gunung itu telah menjadi sesuatu yang sangat berharga bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "Kalau... di kemudian hari, aku masih membutuhkan bantuan kalian, maukah kalian membantuku lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Kamu tetap bisa mencariku saat tidak memerlukan bantuan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Baiklah kalau begitu... terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "Meskipun aku telah menekankan kepadanya kalau hasil eksperimennya \"biasa saja\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "Tapi sebenarnya, benda apa yang mengendap di bawah tabung ini? Seharusnya tidak ada endapan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "Dia yang lahir dari dunia akan terkekang oleh ketidakmurniannya, dan dia yang terlahir dari kapur bebas dari ketidakmurnian... Sepertinya kita berdua sama, kita sama-sama terdiri dari \"materi\" yang belum sepenuhnya dimengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "Kalau suatu hari nanti, aku akan lepas kendali dan... menghancurkan Mondstadt... menghancurkan segalanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
					"content": "Bisakah aku mengandalkanmu untuk menghentikanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450532,
					"content": "#(Aku tidak tahu bagaimana kabar {M#adikku}{F#kakakku} sekarang...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "Hidupnya pendek sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Mungkin saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "Hanya begitu saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Dihadang oleh seorang suster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Ah, tenang saja. Dia hanya menjalankan tugasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
