			"dialogs": [
				{
					"id": 110450621,
					"content": "Maaf ya, banyak sekali masalah di penelitian ini. Ada beberapa kesimpulan yang telah kususun rapi, tetapi ternyata berbeda dengan data eksperimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "Di lain sisi, beberapa kesimpulan yang dibuat Albedo dari instingnya, semuanya sesuai dengan fakta yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "Aku sudah cukup senang karena kita sudah melihat banyak perkembangan, jadi... jangan terlalu berkecil hati! Tuan Albedo juga telah menyemangatiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "Kalau kamu ingin mendengar hasilnya dengan lebih rinci, lebih baik kamu bertanya langsung ke dia. Aku harus pergi bekerja dulu.",
					"roleType": "TALK_ROLE_NPC",
