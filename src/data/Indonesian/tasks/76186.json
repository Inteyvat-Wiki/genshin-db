			"dialogs": [
				{
					"id": 761860101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860103,
					"content": "... Jadi, bagaimana kabar Bani Bulan Embun akhir-akhir ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860104,
					"content": "Sangat baik. Kembalinya Dewi Bulan telah memperkuat tekad kami untuk mengikuti jalan yang telah ditakdirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Begitu? Baguslah kalau begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860106,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860107,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Hah ... Kurasa kita memang tidak punya topik yang bisa diobrolkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860109,
					"content": "Kurasa ... itu karena ada terlalu banyak sengketa antara Bani Bulan Embun dan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Secara pribadi, aku sangat berterima kasih karena kamu sudah melindungi Nod-Krai dan menyambut kembali Dewi Bulan, Nona Sandrone. Tapi kalau soal rekan-rekanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Aku paham. Karena berbagai alasan, kita gagal menjalin hubungan yang bersahabat, atau bahkan hubungan yang saling menguntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860112,
					"content": "Tapi Fatui sudah tidak berusaha mengambil apa pun dari Bani Bulan Embun, dan aku sudah mengingatkan bawahanku untuk tidak mempersulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860113,
					"content": "Menurutku, karena kita bertetangga, meskipun kita tidak bisa hidup berdampingan dengan harmonis, ada baiknya kalau kita bisa saling menghormati satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860114,
					"content": "Kurasa itu akan butuh waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Tentu saja. Tapi kita bisa mulai dengan mengambil langkah-langkah kecil. Apa kamu mau coba teh herbal buatanku ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860116,
					"content": "Teh herbal? Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hmm ... Rasanya sangat kaya ... Apa kamu menyeduhnya dengan teknik Bani Bulan Embun? Kebanyakan orang luar yang pernah kutemui tidak suka rasa teh kami. Kenapa kamu bisa—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Belajar. Dan dengan rasa hormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860119,
					"content": "Ah, sungguh langkah pertama yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Kuharap cocok dengan seleramu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860121,
					"content": "Aku sangat suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Interaksi hangat ditemani teh hangat selalu menjadi cara yang bagus untuk membangun hubungan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Kurasa interaksi kita ini juga tidak terkecuali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
