			"dialogs": [
				{
					"id": 761860201,
					"content": "Teh herbal yang sungguh nikmat, Nona Sandrone. Aku seperti bisa merasakan ketulusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860204,
					"content": "Baiklah. Lain kali, aku harus undang kamu untuk minum teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
