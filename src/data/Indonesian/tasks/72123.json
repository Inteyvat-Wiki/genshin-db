				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Huh! Jadi kamu wanita yang menghalangiku cari uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "Kalian tidak tahu diri! Berani-beraninya menyentuh Thunder Sakura. Nona Miko tidak akan membiarkan kalian berbuat seenaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Tidak usah banyak omong! Kalian tidak tahu aku siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "Tuan, si Pengembara itu orang yang mengganggu kepentingan Anda. Kalau Tuan tidak turun tangan, bisnis kita bisa gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Hah, badan kecil banyak lagak! Mau sok jago di depanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Skirmisher"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212317",
