			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "Jangan... jangan kejar lagi... Sudah tiga putaran, aku sudah tidak kuat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Bersekongkol dengan orang asing demi keuntungan, kamu benar-benar bikin muak! Mau sepuluh putaran lagi pun aku tidak akan melepaskanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "Haah... Pengembara, lihat mukamu kalem begitu, artinya masalah ini sudah beres. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "Kekuatan Thunder Sakura tidak boleh sampai jatuh ke tangan orang-orang seperti mereka, apalagi para Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "Aku tidak tahu Fatui punya niat jahat apa, tapi sekarang orang ini sudah tertangkap, aku pasti cari tahu sampai ke akar-akarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Sisanya biar aku yang urus. Aku tahu di mana markas para prajurit-Shogun, orang ini sudah tidak bisa lari lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
