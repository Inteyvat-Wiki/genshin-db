			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Ahh, kenapa jadi aku yang kena batunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Tidak tahu malu, berani-beraninya bersekutu dengan Fatui... Dewa Narukami pasti akan menghukum kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Ja-jangan pikir kalian bisa menggertakku, sudah mengacaukan transaksiku, masih mau menyeret orang-orangku! Aku masih punya jurus pamungkas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212319",
							"2"
