					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "Tentang Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Jadi begitu... Tapi, Treasure Hoarder kan cuma maling kelas teri, masa sih bisa mengakibatkan kerusakan separah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Mungkin ada alasan lain di balik layunya Thunder Sakura... Aku punya beberapa dugaan, tapi aku tidak yakin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Di Kannazuka ini, kepercayaan Inazuma maupun Sangonomiya tidak punya pengaruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Sejak Dekrit Perburuan Vision diumumkan, sering ada konflik antara Pasukan Shogun dan para pemberontak di sini. Aku rasa mereka juga tidak peduli kalau Thunder Sakura rusak karena mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Kalau kata Nona Miko, \"Tentara hanya peduli soal kejayaan dan penghargaan\". Bicara dengan mereka sama saja bicara pada tembok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "Kami sudah bersiap untuk hal seperti ini, tapi tak disangka kondisi Thunder Sakura sudah separah ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "Bagaimanapun juga, sekarang yang paling mendesak adalah menyingkirkan para Treasure Hoarder. Pengembara, apa aku bisa mempercayakannya kepadamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Tolong jangan disepelekan. Thunder Sakura yang melemah membuat situasinya jadi berbahaya. Bagimanapun juga, pohon-pohon ini bertujuan untuk menekan dia yang bersemayam di bawahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Ah, aku terlalu banyak bicara... Lu-lupakan saja. Singkatnya, tolong ekstra hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "Aku juga perlu waktu untuk mempelajari temuanku. Yang menjadi tanda tanya besar adalah, siapa orang di balik para Treasure Hoarder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Masalah ini semakin lama semakin rumit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Kalau cuma menyingkirkan mereka sih mudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Sepertinya tidak akan semudah itu. Thunder Sakura yang melemah membuat situasinya jadi berbahaya. Bagimanapun juga, pohon-pohon ini bertujuan untuk menekan dia yang bersemayam di bawahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
