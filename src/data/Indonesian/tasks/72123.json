				{
					"id": 721230402,
					"content": "Maling kelas teri sudah kusingkirkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Bagus. Setidaknya kondisi Thunder Sakura akan stabil. Nona Miko juga bisa lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "Berani-beraninya para maling kelas teri itu mencuri kekuatan Thunder Sakura untuk kepentingan sendiri. Mereka tidak bisa dimaafkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "Kamu menemukan kristal yang terbentuk dari kekuatan Thunder Sakura di perkemahan Treasure Hoarder? Bahaya sekali... Harus segera ditangani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "Kamu sudah banyak membantuku, aku tidak bisa lagi memintamu menghadapinya seorang diri. Kali ini aku ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "Tidak ada waktu lagi. Kita berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
