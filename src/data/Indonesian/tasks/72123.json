					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "Ngomong-ngomong, apa kalian tahu pohon Thunder Sakura itu ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "...Kalau melihat reaksimu, sepertinya kamu tidak tahu ya. Wajar sih, kamu kan pengembara dari luar negeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "Kelima pohon Thunder Sakura itu tidak susah ditemukan kok. Ikuti saja <color=#00E1FFFF>pesisir pantai barat</color>, mulai dari <color=#00E1FFFF>titik paling utara</color> pulau tempat Kujou Encampment sampai ke <color=#00E1FFFF>titik paling utara Tatarasuna</color>, dan kamu akan ketemu tiga pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Sisa dua pohon lainnya, satu ada di gunung di bagian <color=#00E1FFFF>barat laut Tatarasuna</color>, satunya lagi ada di gunung lain di <color=#00E1FFFF>bagian barat daya Tatarasuna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "Setelah tahu arahnya, lebih mudah kan mencarinya. Masalah Thunder Sakura ini kuserahkan padamu ya. Hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
	]
