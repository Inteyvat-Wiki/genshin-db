			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "Ja-jangan bunuh aku! Masalah Thunder Sakura tidak ada hubungannya denganku! Sumpah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "Kenapa kamu tahu kami mau tanya soal Thunder Sakura? Kamu merasa bersalah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon berani taruhan deh, kamu pasti dapat sesuatu yang mirip Electro Hypostasis ini secara ilegal, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "Aku... kalian... apa hubungannya dengan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Semuanya berhubungan dengan kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "Betul, kami sedang menegakkan keadilan! Apa yang kalian lakukan pada Thunder Sakura, dan dari mana asalnya benda ini? Jawab! Yang jujur ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "Kalau tidak mau bilang, hehehe... kamu boleh cicipi pedang Pengembara ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "A-Ampun! Ampun! Ta-tapi kan, pohon itu juga tidak ada yang peduli. Masa aku tidak boleh bawa saudara-saudaraku cari uang darinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Ada pembeli yang tertarik dengan Thunder Sakura, mereka bahkan memberi cara dan alat untuk menyerap kekuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Lakukan sesuai keinginan pembeli dan buat lubang di pohon itu, kami bisa pakai alatnya untuk menyerap kekuatan Thunder Sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Lalu masukkan kekuatan itu ke dalam kristal, dan jreng! Kami akan dapat harta senilai tiga rumah besar Tenryou Commission!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "Pembeli itu juga menawarkan imbalan yang sangat besar! Uangnya tidak akan habis seumur hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Kalau kamu melepaskanku, hadiahnya akan kubagi. Aku 90%, kamu 10%. Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Kurang lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "Apa? Sialan, aku sudah baik hati memberimu jalan. Nanti kalau si pembeli sudah datang, kalian pasti nangis minta ampun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Sudah jago dia rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Tuyul kecil, jangan banyak lagak! Saudara-saudaraku akan segera datang bawa bala bantuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "Panggil saja seratus orang sekalian! Sehelai rambut Paimon juga gak bakalan tersentuh. Pengembara akan menghajar kalian semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Kamu dengar tidak, Yamada? Tuyul kecil ini bilang kalian tidak akan bisa menyentuhnya. Masa diam saja dikatai begitu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "Yamada? Siapa... Waduh! Cepat, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Eh? Gak ada siapa-siapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Mimpi ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
