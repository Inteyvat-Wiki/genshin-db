			"dialogs": [
				{
					"id": 3081401,
					"content": "Dragon of the East, Lion of the South, Wolf of the North, Falcon of the West ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081402,
					"content": "Mereka adalah Four Winds, pelindung Mondstadt yang setia pada Barbatos, sang Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081403,
					"content": "Dvalin. Itu nama asli Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081404,
					"content": "Tapi sepertinya semua orang Mondstadt sudah lupa, sejak ada masalah \"Stormterror\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081405,
					"content": "Dan sekarang kamu pun paham kenapa Dvalin cuma bisa mengendalikan tiga Four Winds saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081406,
					"content": "Karena dia sudah menghabiskan dirinya sendiri sejak awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "Tapi kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Mungkin karena ... kebencian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081410,
					"content": "Kebencian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081411,
					"content": "Kebencian terhadap Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081412,
					"content": "Kebencianyang membuat Dvalin jadi lebih kuat, bahkan melebihi angin. Menjadi Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081413,
					"content": "Tapi kenapa salah satu dari Four Winds ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081414,
					"content": "Jadi benci sama tempat yang harusnya dia lindungi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081415,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081416,
					"content": "Sebagai orang Mondstadt, aku malu mengakui ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081417,
					"content": "Ini, bacalah. Ini kisah yang terjadi di zaman dahulu, lebih dari seabad yang lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081408,
					"content": "Kenapa dia jadi begini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
