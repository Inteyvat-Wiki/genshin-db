			"dialogs": [
				{
					"id": 3081301,
					"content": "Berdiri di luar begini saja sudah bisa terasa gangguan elemen yang ada di dalam. Rasanya tidak nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
