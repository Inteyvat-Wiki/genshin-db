			"dialogs": [
				{
					"id": 715380101,
					"content": "#Halo {NICKNAME}. Selamat Hari Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Wah ... ada kasus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Aku dipaksa liburan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Dipaksa ... liburan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Aturan Maison Gardiennage. Seluruh jajaran petugas dan karyawan wajib menggunakan semua jatah cuti sebelum pergantian tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Waktu hitung-hitungan cuti akhir tahun selesai, Pasukan Patroli Khusus mendapati kalau aku ... belum pernah cuti sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Pekerjaanmu berat juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Tidak. Para perwira dan petugas kerja mengikuti jadwal, semua dirotasi. Tapi selaku kapten, aku selalu bertugas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Dan aku juga pasti diturunkan bila ada yang darurat. Akhirnya ... aku jadi lupa ambil cuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Aku sendiri sih tidak masalah, tapi rekan-rekanku yang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Semua ribut, katanya \"aturan ada untuk dipatuhi\". \"Kepemimpinan yang baik adalah dengan memberikan teladan\". Intinya, tidak bisa bilang tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Ada Gestionnaire yang bilang kalau Liyue adalah tempat terbaik untuk liburan ketika musim Lantern Rite. Dia ... langsung belikan tiketnya. Dan tiba-tiba saja aku sudah ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Tapi dia benar. Liyue memang cantik sekali di waktu ini. Aku baru saja datang dari Desa Qiaoying, Dim sum teh di sana enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Aku sudah bungkus juga buat oleh-oleh anggota lainnya. Sekalian ikutan tradisi sini, bikin Kartu Ucapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Sayangnya ... aku kurang pandai dalam urusan seperti ini. Hasilnya selalu aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}, kamu bisa bisa bikinnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Aku bisa kasih saran sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "Yang lain juga sama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Kamu ... ada kerjaan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
