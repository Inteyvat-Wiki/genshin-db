			"dialogs": [
				{
					"id": 715380301,
					"content": "Wah, hasilnya bagus sekali! Hmm ... ini tidak boleh digratiskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Ini, ambil sedikit Dim Sum-nya sebagai ucapan terima kasih. Aku senang sekali bisa dapat kartu dari kamu, tidak sia-sia liburan kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "Tapi aku sudah lumayan lama juga di sini. Kira-kira anggota di markas latihannya benar tidak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Baiklah. Waktunya bikin rencana ujian kebugaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
