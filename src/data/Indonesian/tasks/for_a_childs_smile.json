			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "Tak kusangka kamu bisa menemukanku semudah itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250502,
					"content": "Ini kan pertama kalinya untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "Kupikir ini akan menjadi tempat yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250505,
					"content": "Pada faktanya, aku sangat ahli dalam menemukan roh jahat dan aku memiliki banyak pengalaman dalam melacak tempat persembunyian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250506,
					"content": "Di tempat ini, semuanya berdebu dan ada banyak benda persegi di sekelilingnya, juga terlindung dari cahaya. Roh jahat biasanya lebih suka tempat seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250507,
					"content": "Kamu mencoba menggunakan ilmu sihir untuk bermain petak umpet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Ya, kurasa pengalamanku sebagai pengusir setan tidak bisa diterapkan dengan baik dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250511,
					"content": "Karena kamu sudah menemukanmu, sepertinya aku harus mengaku kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250512,
					"content": "Ini permainan yang sederhana tapi menyenangkan sekali kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250513,
					"content": "Mungkin lain kali kita bisa main bersama lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Boleh, kita juga bisa mengundang teman-teman lainnya untuk ikut main bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250517,
					"content": "Baiklah, ayo kita jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250515,
					"content": "Untung kamu bukan hantunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Hah, iya, pastinya akan membutuhkan waktu berjam-jam bagiku untuk menemukan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250509,
					"content": "Tapi, kamu dapat terlihat dengan mudah di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Hmm, kurasa aku terlalu gugup jadi lupa hal yang paling penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250503,
					"content": "...Kenapa kamu sembunyi di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
