					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710122401,
					"content": "Muncul dari mana orang itu! Aku sama sekali belum pernah melihatnya sebelumnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "Bagaimana caranya kamu bisa membuatnya keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Jadi begini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Ternyata memang \"waktu dan angin\" ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Jadi di pulau terpencil itu, ada jam matahari lain yang persis seperti ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "Selain itu, cara memecahkan teka-tekinya pun sama persis. Kedua jam matahari ini, dan kedua tempat ini, pasti saling berkaitan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Aku harus menemukan cara agar bisa segera ke pulau itu untuk mengeceknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "Terima kasih, pengembara. Aku akan menemukanmu saat aku sudah siap, ayo kita pergi ke pulau tak berpenghuni itu bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
