				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "\"Benih kisah baru yang mengendarai angin, dan disuburkan oleh waktu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Ukiran yang dirusak"
				},
				{
					"id": 710120202,
					"content": "Jam matahari yang ada dalam catatan itu seharusnya yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Tapi apa yang istimewa dari jam matahari ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Hmm... coba kita cek lebih teliti lagi catatan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "Eh? Pengembara, apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "Tentang Eye of the Storm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Eye of the Storm? Aku sudah lama tinggal di sekitar sini, dan belum pernah melihat yang seperti itu, cuma ada angin kencang yang tiba-tiba bertiup tanpa jelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "Tapi, yang pasti di sini belum pernah ada Eye of the Storm. Kalaupun ada, aku pasti ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Percaya saja padaku, kalau ada seseorang seperti itu yang datang ke sini untuk mengganggu penelitianku, aku pasti tidak akan melupakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "Lebih tepatnya... seharusnya sih dibilang melakukan penelitian bersama temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "Temanku juga seorang sarjana dan pernah belajar bersamaku di Sumeru Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "Setelah itu, dia menjadi seorang arkeolog dan mensurvei seluruh dunia, sementara aku terus melanjutkan pendidikanku di Akademiya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "Saat dia datang ke Mondstadt, dia dengan antusias memberitahuku bahwa dia sedang melakukan penelitiannya di Thousand Winds Temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "Dia juga mengatakan \"Saat aku berhasil mengungkap rahasia kampung halamanmu, hal pertama yang akan kulakukan pasti adalah memberi tahumu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "Setelah itu tiba-tiba tidak ada kabar lagi dari dia, aku telah meminta seseorang mengirim surat kepada Cyrus, dan memohon bantuan Adventurers' Guild untuk mencari keberadaan temanku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "Tapi tetap saja masih tidak ada kabar apa-apa, jadi aku menghentikan penelitianku dan bergegas kembali ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "Tapi, di sini hanya ada petunjuk jam matahari, tidak ada petunjuk lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Tentang jam matahari di pulau itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Hah? Ternyata masih ada jam matahari yang sama persis, di sebuah pulau terpencil di tengah laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Oh, aku ingat sekarang, saat cuacanya bagus, aku pernah melihat pulau itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Tunggu, katamu... di samping jam matahari di pulau itu kamu juga menemukan sebuah catatan? Apakah maksudnya dia pernah ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Terima kasih, jika ada kesempatan, aku akan mengunjungi pulau itu, sekarang aku masih ingin melakukan penelitianku dulu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "Aku akan melanjutkan penelitianku, jika kamu tertarik, kamu dapat melihat catatan penelitianku yang kutaruh di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Siapa tahu ada sesuatu yang bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "Apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Aku? Aku sedang melakukan beberapa penelitian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				}
			]
		},
		{
			"id": 7101211,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
