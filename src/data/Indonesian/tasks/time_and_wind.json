					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Waktu dan angin... sebenarnya apa ya penelitian yang dia lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Waktu dan angin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, ini adalah kata-kata dari surat terakhir yang temanku tulis untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Dia berkata bahwa ada rahasia tentang Mondstadt yang terselubung dalam \"waktu dan angin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Tapi aku sendiri yang orang lokal saja belum pernah mendengar istilah ini, tahu dari mana orang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Kamu pernah belajar di Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Iya, meskipun aku adalah orang Mondstadt, tapi aku selalu belajar di Sumeru Akademiya, aku tinggal lebih lama di sana daripada di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Kamu ingin tahu yang ada di dalam Sumeru Akademiya? Bukannya rahasia sih ... di dalamnya ... bagaimana ya menjelaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Apakah isinya sekelompok... orang aneh? Deskripsi semacam ini agak tidak sopan... seharusnya dideskripsikan sebagai sekelompok orang yang \"mengesankan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Jika kamu memiliki kesempatan untuk mengunjungi Sumeru Akademiya, kamu dapat merasakannya sendiri, tapi setelahnya ... jangan tinggal terlalu lama di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
