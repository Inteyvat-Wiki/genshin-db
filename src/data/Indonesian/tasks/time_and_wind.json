			"dialogs": [
				{
					"id": 710120101,
					"content": "\"Benih kisah baru yang mengendarai angin, dan disuburkan oleh waktu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Ukiran yang dirusak"
				},
				{
					"id": 710120102,
					"content": "Maksudnya apa ya? Paimon sama sekali tidak paham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Hmm, tapi sepertinya ada rahasia yang tersembunyi di tempat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Ayo kita cek di sekeliling, siapa tahu kita akan menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
