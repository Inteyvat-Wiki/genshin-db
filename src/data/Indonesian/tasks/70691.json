			"dialogs": [
				{
					"id": 706910101,
					"content": "Kakak Honorary Knight! Di sini, di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Klee punya teman baru! Mau main bareng kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Para kakak sudah ngajarin kami permainan baru, namanya \"Jejak Sang Salju\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Aturannya juga tidak susah, ini semacam petak umpet yang spesial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Wah! Klee, Yaoyao, Sayu, kalian sudah punya teman baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Dari namanya saja, permainan ini kayak versi Jejak Sang Angin yang lebih canggih ya? Hehe, Paimon jadi enggak sabar main bareng kalian deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Petak umpet? Keren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Achoo ... Walaupun di kemah sudah tidak terlalu dingin, tapi aku masih sedikit ngantuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hmm? Aku salah lihat tidak ya, atau memang beneran ada {NICKNAME} sama Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Benar kok. Memang ada {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Hai Yaoyao! Hai Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Ide bagus! Yuk gerakkan tubuh dan main yang asyik, pasti enggak akan ngantuk lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "Terus bukannya Nona Sumire yang serius banget itu bilang kalau semakin lama main di gunung salju semakin bagus buat keterampilanmu, Sayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Eh, kalian ternyata ingat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Oke ... Tapi kalau aku sampai kalah dari teman-teman atau bahkan dari si Ninken super itu, ke depannya bakal jadi lebih susah deh buat malas-malasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Kayaknya aku harus berusaha sungguhan deh dalam perjalanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Santai! Aku punya resep gulai baru pakai Jueyun Chili sama lada bubuk, nih baru saja kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Makan dulu sebelum main, biar tidak kedinginan waktu main petak umpet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Asyik! Tunggu sebentar, aku makan dulu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Ih, Paimon mau juga dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Oke deh ... yuk kita mulai main petak umpet di gunung salju ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Hehe! Gunungnya ketutup salju semua — tempat persembunyian yang sempurna sih buat Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Mau main petak umpet bareng kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Aku juga mau kenalan sama teman-teman baru Klee~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
