			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Guk? Ada apa, {M#Tuan}{F#Nona} Pengembara Emas? Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Nona Pudel"
				},
				{
					"id": 762140302,
					"content": "Kamu menyampaikan undangan pesta teh dari Tuan Kucing Abu kepada Nona Pudel ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Eh? Sudah waktunya ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Nona Pudel"
				},
				{
					"id": 762140304,
					"content": "Terima kasih! Guk, andaikan aku tidak sibuk, aku pasti akan mengundang Nona Kucing Oyen ... dengan begitu, Tuan Kucing Abu mungkin juga tidak akan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Nona Pudel"
				},
				{
					"id": 762140305,
					"content": "Entah itu kucing atau anjing, semuanya bisa hidup berdampingan dengan damai ... pasti bisa. Intinya, aku akan pergi ke pesta teh sekarang. Terima kasih sudah mengingatkanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Pudel"
				}
			]
		},
