			"dialogs": [
				{
					"id": 762140201,
					"content": "Meong. Teknik pedangmu ... membuat aku terkesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Nona Kucing Oyen"
				},
				{
					"id": 762140209,
					"content": "Terima kasih, knight asing yang terhormat. Penjahat yang arogan dan kuat itu tidak akan mengganggu kampung halamanku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Nona Kucing Oyen"
				},
				{
					"id": 762140210,
					"content": "Kalau begitu, silakan katakan. Kenapa kamu datang ke istanaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Nona Kucing Oyen"
				},
				{
					"id": 762140202,
					"content": "Istana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Uh ... karena ini adalah dongeng, itu pasti bagian dari dunia dongeng, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Kamu menyampaikan undangan pesta teh dari Tuan Kucing Abu kepada Nona Kucing Oyen ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Nona Kucing Oyen"
				},
				{
					"id": 762140208,
					"content": "Aku mengerti. Terima kasih, knight asing yang terhormat. Kalau begitu, aku akan mengikuti saranmu dan pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Kucing Oyen"
				},
				{
					"id": 762140204,
					"content": "Yang Mulia, izinkan aku menyampaikan laporan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Cepat banget kamu bisa memerankannya! Ehem, karena itu bagian dari persiapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
