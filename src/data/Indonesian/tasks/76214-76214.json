			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Meong ... sudah waktunya pesta teh, meong. Apa mereka tersesat ya, meong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140102,
					"content": "#Ah, {M#Tuan}{F#Nona} Pengembara Emas, kamu pasti pahlawan yang terpilih, meong! Bisakah kamu bantu aku mencari kedua temanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140103,
					"content": "Temanmu itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Oh, masih ada dua nona yang belum datang. Satunya adalah kucing yang bisa bicara sepertiku, tapi dia berwarna oranye, meong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140107,
					"content": "Satu lagi adalah seekor nona pudel yang sangat sopan dan lemah lembut, meong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140108,
					"content": "Meskipun satunya kucing dan satu lagi anjing, kita tetap bisa duduk minum teh bersama, semuanya pasti senang, kan? Meong~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140109,
					"content": "Demi kedamaian Meouranopolis, tolong bantu aku, meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuan Kucing Abu"
				},
				{
					"id": 762140104,
					"content": "Standar disebut seorang pahlawan kok jadi gampangan banget ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Oh, jangan memperdebatkan detailnya, meong. Tidak peduli kamu punya pedang suci legendaris itu atau tidak, ketemu Cawan Kemurnian yang legendaris atau tidak, pahlawan tetaplah seorang pahlawan, meong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Tuan Kucing Abu"
				}
			]
		},
