			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Ternyata, identitas asli dari Stormterror adalah Dvalin – salah satu dari Four Winds! Kita seharusnya tidak melupakan begitu saja pengorbanan yang dulu dia lakukan untuk Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Untungnya hubungan kita dengan Dvalin sang \"Dragon of The East\" belum mencapai tahap yang tidak bisa diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Semua ini berkat orang-orang setia seperti kalian dan juga Master Jean. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Selama ada Knights of Favonius, kedamaian dan kebebasan akan terus ada di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
