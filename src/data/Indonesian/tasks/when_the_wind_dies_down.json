			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "Akhirnya kalian kembali! Sang Honorary Knight akhirnya kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Iya, {NICKNAME} baru saja kembali, dia habis main kejar-kejaran sama Dvalin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "Kamu baru pulang kemarin, kan? Jean pulang lebih awal ke Mondstadt dan dia menceritakan aksi heroik kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*huff* ... Kapan ya, aku bisa punya kesempatan seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Terima kasih atas referensi kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Tidak, masalah ini selesai berkat kalian juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "Di hari di mana aku menuntun kalian datang ke Mondstadt, aku hanya sedang menjalankan tugasku sebagai Outrider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "Sama-sama! Tapi ... apa kamu menunggu kami di sini sepanjang waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Tidak dong! Cuma karena aku tidak ada di barisan depan bukan berarti aku tidak ada kerjaan lain ... Malahan aku sedang sibuk membereskan dampak setelahnya dari krisis yang lagi kita bicarakan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Dampak setelahnya? Di sini maksudnya? Apa yang terjadi di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Saat Master Jean tidak ada, para monster yang berada di sekitar menyerang kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Untungnya, kita tidak terlalu kaget. Aku sudah mendeteksi para Hilichurl bergerak mendekati kota beberapa saat lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Oh iya! Paimon ingat waktu kita pertama kali bertemu, kamu juga sedang membasmi salah satu kemah mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Tepat. Dan kalau kita tidak melakukan persiapan dari awal, sekarang Mondstadt mungkin sudah berada dalam keadaan yang lebih gawat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Untung kamu sudah menahan mereka duluan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Iya. Tapi aku punya firasat kalau kita masih belum keluar dari bahaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Para Hilichurl seharusnya tidak punya kemampuan untuk mengkoordinasi serangan begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Dugaanku, Abyss Order berada di balik semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Apa mereka yang ngendaliin Hilichurl-Hilichurlnya? Hmm ... Untung kita sudah nyelamatin Dvalin, kalau enggak, mereka pasti bakal ngendaliin Dvalin juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Benar. Dan sebagai Outrider, mulai sekarang aku harus terus mengawasi Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Ugh, maaf. Kalian harusnya sekarang merayakan kemenangan, bukannya malah mendengarkan cerita yang suram ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Hmm ... Aku pernah janji akan mentraktir kalian makan \"Sticky Honey Roast\", kan? Sebelum semua orang jadi sibuk karena Stormterror ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Bagaimana kalau kita rayakan sekarang? Apa kalian lapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Pastinya dong! Walaupun Amber lupa, tapi Paimon selalu mikirin makanan itu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Bagus, ayo jalan! Aku juga sudah lama tidak makan Sticky Honey Roast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Tunggu aku di <color=#00E1FFFF>Good Hunter</color>. Aku akan segera menyusul setelah membersihkan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Tapi kenapa para Hilichurl melakukan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Iya, aneh kan. Hilichurl seharusnya tidak punya kemampuan untuk mengkoordinasikan serangan seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Percayalah padaku, itu bukanlah \"kesempatan\" yang kamu harapkan untuk sering terjadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Kamu benar. Kedamaian seperti ini sulit didapatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "Berkat bantuan kalian, masalah ini berhasil diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
