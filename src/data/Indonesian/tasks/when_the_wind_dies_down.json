			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Hidup para pahlawan! Terima kasih, akhirnya semua ini berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Karena insiden Stormterror, banyak rute perdagangan yang ditutup. Sampai saat ini sih kita masih bisa bertahan tanpa buah dan sayuran segar ... Tapi kalau persediaan anggur mengering, tamatlah kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Aku tidak bisa membayangkan hidup tanpa anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "*huff* Semoga rute perdagangan bisa segera dibuka kembali dan berjalan seperti semula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
