			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Oke! Ini dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "Bahaya! Malapetaka! Semangat Bertualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "Adventurers' Guild! Akhirnya misi kita untuk mencari kucing dan anjing yang hilang sudah berakhir! Era petualangan baru ada di hadapan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Wahai anak muda, cepat bergabung ke Adventurers' Guild hari ini juga! Di tengah kekacauan ini, mari kita bersama-sama mengalahkan naga dan menyelamatkan kota kita tercinta, Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Oke, jadi mengenai hal itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "...Apa!? APA!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "Serangan naga sudah berakhir? Aku sudah melewatkan pidato Master Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "...Huh! Harusnya Stormterror bertahan dulu dong! Kami belum sempat bergabung ke dalam pertempuran itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39807",
							"2"
						],
						"stepId": 39807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Halo, mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Kok kamu judes begitu sih? Padahal aku selalu berpikir kita ini teman baik",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Oh, halo. Aku tidak lihat kamu di sana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "Hahaha ... Sepertinya setelah bertarung, bukan hanya kemampuan bertarungmu saja yang meningkat, tetapi juga kecerdasanmu. Benar-benar seorang kesatria panutanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "Berada di hadapan pahlawan baru Mondstadt adalah sebuah dorongan moral yang cukup besar. Dan kata-kata ini datang dari seorang kesatria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Kaeya lagi-lagi mengeluarkan kata-kata manisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Haha, omong kosong! Aku bicara dari lubuk hati yang terdalam loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "Kamu lagi apa di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Aku sedang mencari tempat untuk menenangkan pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Padahal Knight yang lain sedang sibuk membersihkan sisa-sisa pertempuran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Berpikir juga sangat melelahkan. Percayalah, aku sih lebih milih membersihkan sampah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "Oh, kamu memikirkan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "Aku sedang memikirkan ... Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "Seekor naga menimbulkan kekacauan di Mondstadt, dan Grand Master sedang tidak berada di kota. Seharusnya itulah kesempatan emas bagi Abyss Order untuk bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "Kalau kamu adalah salah satu dari Abyss Order, apa kamu hanya akan mengutus Hilichurl untuk \"memanfaatkan kesempatan emas\" ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Kamu benar. Rasanya ada yang tidak beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "Karena itu, demi mengetahui fakta di balik ini semua, aku memutuskan untuk menunggu aksi mereka selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Kemudian tibalah hari kalian menghancurkan Stormterror's Lair, dan tangisan para Hilichurl terdengar dari pintu gerbang kota ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "Dan di hari yang sama itu juga aku melihat sosok bayangan yang berkeliaran di dalam kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "Di dalam kota?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Saat para Knight sedang melawan musuh di luar, bukankah bagian dalam kota benar-benar tidak terlindungi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Kecuali aku tentunya. Jadi aku langsung saja menghampiri penyusup Abyss Order lalu ... hmm, sebut saja aku mencoba mendekatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Melalui berbagai cara, aku berhasil mengumpulkan beberapa informasi yang cukup menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "Jadi situasinya begini: Abyss Order ... mereka bergabung di bawah seorang pemimpin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "Abyss Order punya pemimpin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Benar. Dan pemimpin inilah yang merencanakan siasat untuk menjadikan Dvalin sebagai senjata perang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "Sebenarnya apa yang kamu lakukan untuk mendapatkan informasi ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Hehehe ... Anggap saja aku memang punya bakat dalam berbahasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#Ada lagi ... Pemimpin Abyss Order punya nama untuk pemimpin mereka ini ... Mereka memanggilnya {F#\"Pangeran\"}{M#\"Putri\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#{F#\"Pangeran\"}{M#\"Putri\"} ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Baiklah, maaf karena informasinya harus terhenti sampai di sini saja, tapi aku lihat Amber sedang jalan ke arah sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Dia sepertinya masih marah karena aku tidak menemaninya melawan musuh di gerbang kota ... Aku lebih baik kabur sebelum dia melihatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "Baru saja aku lihat Kaeya terus tahu-tahu dia kabur! Jelas sekali dia merasa bersalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "Dia banyak melakukan sesuatu di balik layar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Oh ya? Soalnya kedengarannya itu cuma alasan dia saja untuk lepas dari masalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Tapi kita lupakan saja soal dia hari ini. Aku sudah bekerja keras dan sekarang lapar sekali. Ayo kita pesan makanan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Hai Sara! Pesan satu Sticky Honey Roast ya, makasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "Iya kan! Keterlaluan sekali dia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Aku setuju. Sebagai seorang Kapten Kavaleri dia malah memberikan contoh buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "Sepertinya masih ada hal lain yang tersembunyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Apa lagi yang kamu rencanakan kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Aku? Tidak ada. Malah justru aku sedang berpikir \"orang lain\" sedang merencakan apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Aku sedang mencari tempat untuk menenangkan pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Ah, ternyata Kaeya yang tampan ada di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Oh, jadi kamu memang punya rasa sama aku ya. Dan orang-orang malah bilang kalau pesonaku itu palsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "Oke, karena masalah Stormterror sudah berakhir, apa rencana kalian selanjutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "#Paimon pikir ini sudah saatnya untuk meninggalkan Mondstadt dan terus mencari ke pelosok tujuh bangsa sampai kita menemukan petunjuk tentang {F#kakaknya}{M#adiknya}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Oh begitu ya? Ah ... Berarti sudah saatnya untuk mengucapkan salam perpisahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Aku akan merindukan Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Hei, jangan sedih! Ke mana pun kamu pergi, dan ke mana pun angin membawamu. Kamu akan tetap menjadi teman Knights of Favonius dan Honorary Knight bagi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Semoga Angin menyertaimu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Ya! Mondstadt akan selalu menyambut kedatangan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "Oke, ayo makan dulu sebelum makanannya  jadi dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "Mmm, enak bangeeeeet! Catatan untuk diri Paimon sendiri, makanan yang disarankan Amber layak ditunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Iya dong! Walaupun aku sendiri tidak percaya diri soal urusan dapur, tapi kalau urusan menu, boleh percaya pada seleraku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Oh ya, aku hampir lupa beri tahu kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
					"content": "Jean sedang menunggumu di <color=#00E1FFFF>Katedral</color>, sepertinya dia ingin bicara tentang Holy Lyre der Himmel ... Kamu lebih baik segera ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980908,
					"content": "Aku pasti akan kembali lagi mengunjungi kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "Aku juga akan merindukan keluargaku di Knights of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
