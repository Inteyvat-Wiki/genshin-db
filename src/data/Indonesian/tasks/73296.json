			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Gimana? Bagus kan? Si Pepper juga kelihatannya senang tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Setelah melihat dengan mata kepala sendiri, rasanya seperti kehabisan kata-kata. Caterpillar benar, dunia di luar kotak begitu luas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Kotak ... Julien tinggal di tempat yang sangat kecil ya, di Fontaine sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "Ehem. Banyak pemandangan bagus ya di Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "Ah! I-Iya, betul. Dia sudah bilang mau jadi seniman serius, jadi ayo kita ganti suasananya lagi buat ... eh ... memperkaya wawasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Dia bilangnya mau nyerah, tapi kata Paimon sih ini masih terlalu awal! Masih ada waktu buat mikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Pikir lagi deh, Julien! Masih ada lagi kok pemandangan yang kayak gini, bahkan mungkin lebih keren! Yang belum pernah lihat kamu sebelumnya. Mungkin yang kayak gitu baru bisa kasih inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Sedangkan soal buta warna ya ... Kamu sendiri kan yang bilang: \"Kita melihat dunia dengan cara yang berbeda\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "\"Keindahan tetap ada untuk semua\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Ya ... omongan kalian benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Itu omongan kamu sendiri loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Aku ... haha, aku tahu. Aku tahu, tapi tetap mengikuti jalan yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Kita bisa tahu tempat ini juga karena dibawa sama si Pepper kan. Masih percaya kalau ini \"jalan yang salah\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Yah, memang sayang sekali kami enggak bisa bantuin kamu nyari jalur yang diambil sama Oceanid dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Memangnya ada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Sampai sekarang, aku masih percaya ... Tapi ada atau tidaknya sudah tidak penting lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Karena aku sudah mendapat jawaban yang aku inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "Terima kasih, temanku. Bagaimana caranya aku bisa menunjukkan rasa syukurku ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "Coba kalau aku bawa telur burung aneh itu ... Jimat pengusir bala macam itu lebih cocok buat petualang seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Iya, sayang ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME} ... kamu percaya begituan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Aku akan diam di sini untuk sementara. Tempat ini sangat menenangkan, cocok untuk introspeksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Sepertinya kali ini aku bisa menggambar sesuatu yang berbeda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "Terima kasih, teman-teman. Semoga perjalanan kalian lancar selalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Terima kasih, tapi tidak perlu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Apanya yang enggak perlu! Yah, misalnya enggak bisa mengusir bala juga, mungkin rasanya ratusan kali lebih mantap daripada telur biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
