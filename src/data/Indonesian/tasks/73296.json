				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "Katanya seniman harus lihat dulu objek seni dari segala sudut sebelum mulai berkarya. Itu asli atau cuma ... \"stereotipe\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "Kita lihat-lihat dulu deh sekitar. Kalau masih belum cukup, nanti cari tempat tinggi biar lebih jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "Ide bagus. Baiklah, aku siap berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#Hehe, mau balapan? {NICKNAME}, siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
							"2"
						],
						"stepId": 7329604,
						"stateName": "QUEST_STATE_UNFINISHED"
