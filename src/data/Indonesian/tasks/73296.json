			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "Suasana alam di tempat ini kerasa banget! Rasanya jadi mau gambar sesuatu, kan? Dapat inspirasi enggak nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "Nah, yang gitu baru namanya stereotipe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Uh ... tapi Paimon saja jadi pengen ngegambar loh. Soalnya tempatnya terasa hidup banget, warnanya jelas dan cerah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "Ehem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Maaf, Paimon enggak maksud ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Haha, tidak apa kok. Kita melihat dunia dengan cara yang berbeda, itu saja. Keindahan tetap ada untuk semua, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "Betul! Paimon suka tempat ini. Rasanya bisa menyucikan hati dan jiwa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "Kayak Paimon perlu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "Teman-teman, terima kasih kalian sudah baik sekali. Ya, bahkan pada diriku yang tidak mampu jujur sedari mula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "Kalian berdua memang jernih hatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Hehe ... jangan lebai gitu juga ah. Masih banyak pemandangan yang lebih mantep dari ini loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME} tahu kan maksud Paimon! Kita kasih liat Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
