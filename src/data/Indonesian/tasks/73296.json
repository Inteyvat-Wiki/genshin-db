			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon, {NICKNAME}, kalian sudah datang! Ah, bertualang di alam liar memang tidak bisa kalau tanpa teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Kita sudah setuju untuk nunjukkin jalan, kan? Jadi pemandu sih gampang, enggak ada susah-susahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Tapi kamu yakin sudah mau balik Fontaine? Banyak tempat bagus loh di sini! Kapan lagi coba ke Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "Pemandangan hutan hujan cakep banget loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Pohon dan sungai, enggak habis-habis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Kedengarannya menarik, tapi ... aku sejujurnya kurang persiapan untuk pergi jauh. Perjalanan kali ini memang gagal, tapi aku dapat pelajaran berharga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Hmmm, ya sudah! Ke yang dekat sini dulu saja. Bagus loh, sayang kan kalau enggak lihat apa-apa sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Rekomendasi dari Paimon selalu mujarab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Yah, kalau kalian memaksa ... tidak sopan jadinya kalau terus menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Hehe. Paimon ini pemandu nomor satu di Teyvat! Kalau soal jalan-jalan serahkan saja pada Paimon. Awas, jangan sampai ketinggalan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Pemandangan padang pasir kerennya pakai banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Pasir dan reruntuhan sejauh mata memandang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
