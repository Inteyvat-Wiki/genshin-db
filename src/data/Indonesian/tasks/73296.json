					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961604,
					"content": "Tapi pemandangan di sini memang lain dari yang lain. Aneh, kenapa aku baru sadar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961605,
					"content": "Pemandangan dari atas juga bagus loh! Ke sana yuk, tapi hati-hati jalannya!",
