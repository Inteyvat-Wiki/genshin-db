			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "Mona! Kita berhasil menyingkirkan banyak meteorit berkat bantuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130102,
					"content": "Ah, kebetulan sekali! Ada suatu hal yang memerlukan bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130103,
					"content": "Apakah kalian ingat? Aku pernah berkata bahwa meteorit-meteorit ini merupakan konstelasi milik seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130104,
					"content": "Sebenarnya, mustahil sekali kalau bintang-bintang yang berada jauh di angkasa, bisa jatuh ke tempat ini. Tapi kenyataannya, hal ini benar-benar terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130105,
					"content": "Kalau kita ingin memecahkan misteri ini, sepertinya kita harus mencari pemilik dari konstelasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130106,
					"content": "Dari anggapanmu, sepertinya orang-orang yang berada di dekat meteorit akan tertidur dan bermimpi tentang gunung es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130107,
					"content": "Dataran penuh salju dan gunung tinggi yang tidak dikenal... Setidaknya kita tahu ini bukan Dragonspine. Kalau tidak, orang-orang pasti mengenalinya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130108,
					"content": "Apakah semua orang yang tertidur memiliki mimpi yang sama? Di mana tempat mereka berada di dalam mimpi itu? Kita harus mencari jawaban dari pertanyaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130109,
					"content": "Aku perlu bantuanmu untuk mencari lebih banyak informasi mengenai mimpi ini. Semakin banyak semakin baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130110,
					"content": "Hmmm, sepertinya kita bisa mencari di tempat yang ramai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130111,
					"content": "Ayo kita coba berbicara dengan korban lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130112,
					"content": "Aku harus tetap berada di lingkungan yang tenang. Mohon bantuan kalian untuk mencari informasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130113,
					"content": "Apakah masih ada tempat yang belum kita datangi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130114,
					"content": "Di daerah Liyue, ada tempat yang bernama <color=#00E1FFFF>Desa Qingce</color>... Meskipun di sana bukan tempat yang \"ramai\" sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130115,
					"content": "Tapi Desa Qingce sepertinya mirip dengan Wangshu Inn yang dijadikan tempat untuk berobat oleh para prajurit Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111302",
							"2"
						],
						"stepId": 4111302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "Halo, kami adalah anggota Adventurers' Guild. Kami ingin bertanya apakah Desa Qingce juga terkena dampak dari meteorit yang jatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "Ah, seorang petualang! Kebetulan sekali, kami benar-benar sedang kekurangan orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "Sudah beberapa hari ini meteorit-meteorit terus berjatuhan di tempat ini. Benar-benar membuat kami kesusahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "Bila berjatuhan di <color=#00E1FFFF>persawahan</color>, tidak akan ada orang yang berani memanen padi. Dan bila jatuh di <color=#00E1FFFF>pintu masuk utama</color>, orang-orang akan kesulitan untuk keluar masuk desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "Apakah kalian bisa membantu kami membereskan meteorit-meteorit itu? Benda itu benar-benar menyusahkan saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "Ternyata Desa Qingce juga terkena imbasnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "Apa boleh buat, kita harus membantu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111303,
