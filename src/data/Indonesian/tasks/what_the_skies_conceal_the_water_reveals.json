					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "Apakah ini yang diinginkan oleh orang-orang Fatui? Kekuatan elemental ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "Mungkin saja. Kalau benar begitu, makhluk-makhluk lain juga akan berusaha menguasai kekuatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
