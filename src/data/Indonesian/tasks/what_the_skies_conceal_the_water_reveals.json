			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bro Huang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "Halo, apakah kamu melihat ada korban yang sempat terbangun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131402,
					"content": "Pas sekali, <color=#00E1FFFF>Gao the Sixth </color> baru saja terbangun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "Bro Huang"
				},
				{
					"id": 411131403,
					"content": "Ayo kita cari dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "Eh, tapi tubuhnya sekarang sangat lemah karena dia baru saja terbangun. Mohon memperlakukannya dengan lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Bro Huang"
				},
				{
					"id": 411131405,
					"content": "Wahai kamu orang yang telah kembali dari penderitaan. Ratumu ingin menanyakan sesuatu kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Makanan... Butuh makanan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131407,
					"content": "Apa kamu tidak apa-apa? Sepertinya kamu lapar sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ah... uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131409,
					"content": "Ingin makan apa? Sebutkan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Aku ingin makan... masakan rumah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131412,
					"content": "Bagaimana kalau masakan khas Desa Qingce? Kamu pasti akan menyukai <color=#00E1FFFF>Qingce Stir Fry</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Aku bisa membuatkan sesuatu untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gao the Sixth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Wah! Rasanya seperti hidup kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131102,
					"content": "Hei, apakah kamu bermimpi saat sedang tertidur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "Iya! Mimpi yang paling melelahkan sepanjang hidupku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131104,
					"content": "Benarkah? Mimpi macam apa yang bisa membuatmu selelah ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Apakah kamu bermimpi berada di atas gunung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Bagaimana kamu bisa tahu? Aku berada di gunung bersalju yang sangat tinggi dan sangat dingin. Aku tidak pernah melihat gunung seperti itu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131109,
					"content": "Apa yang kamu lakukan di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "Aku juga tidak tahu... Rasanya seperti sedang kerasukan. Hanya satu hal yang terlintas di pikiranku saat itu, kalau aku harus mendaki gunung itu hingga ke puncak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131111,
					"content": "Apa ada sesuatu yang penting di puncak gunung itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "Siapa yang tahu? Aku merasa telah menjadi orang lain saat itu. Aku juga tidak tahu penyebabnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131113,
					"content": "Jadi bukan kamu sendiri yang ingin mendaki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Bagaimana menjelaskannya ya... Rasanya seperti ada orang yang mengendalikanku, dan dia menanamkan ide untuk mendaki gunung itu ke kepalaku. Memang terdengar gila, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131115,
					"content": "Jangan-jangan, ada arus kegelapan yang merasuki hatimu???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "Bukan keinginan diri sendiri, melainkan keinginan yang tiba-tiba muncul dari alam bawah sadar. Ini benar-benar mirip dengan pengendalian pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "Sebenarnya aku sudah terbiasa, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Korban-korban lainnya juga berkata kalau mereka sangat kedinginan sampai tidak bisa bergerak lagi... Apakah mereka juga mendaki gunung yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "Apa semua orang memimpikan hal yang sama ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Ini benar-benar luar biasa... Ayo, kita harus segera memberi tahu <color=#00E1FFFF>Mona</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "Sepertinya kalian berdua membicarakan hal yang berbeda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Kamu bermimpi menjelajahi dataran salju?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Bukan dataran salju, melainkan gunung salju. Tinggi sekali, dan sangat dingin... Saat aku tertidur, aku langsung bermimpi sedang berada di kaki gunung tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao the Sixth"
				}
			]
		},
