					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "Kondisinya sama dengan dua korban lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "Hei, apakah orang ini sempat terbangun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "Tidak, hanya mengigau sesekali saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131205,
					"content": "Mengigau bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "\"Dingin sekali...\", \"Tidak kuat lagi...\", kata-kata seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131207,
					"content": "Dingin? Sebelumnya ada orang yang berkata serupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "Daerah yang dingin... pegunungan. Di mana tempat yang dimaksud?",
					"roleType": "TALK_ROLE_NPC",
