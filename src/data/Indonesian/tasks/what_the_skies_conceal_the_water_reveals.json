			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "Seorang astrolog amatir pun bisa tahu kalau dia adalah anggota Eleven Fatui Harbingers! Dia sangat berbahaya. Kenapa kalian berhubungan dengannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130716,
					"content": "Apa? Anak muda itu adalah seorang Harbinger? Kekejaman mereka sungguh tidak mengenal batas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130717,
					"content": "Ternyata dia seorang Harbinger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Pasti dia memiliki maksud tersendiri untuk mendekatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130719,
					"content": "Lagi pula dia sangat kuat! Aku bisa merasakannya, kekuatannya melebihi apa pun yang bisa kamu bayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130720,
					"content": "Sebenarnya aku tidak mau mengakuinya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130721,
					"content": "Oh? Jangan-jangan dia lebih kuat dari Mona, astrolog terhebat sepanjang masa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130722,
					"content": "Si-siapa bilang! Mungkin kekuatannya sedikit lebih hebat dariku, tapi ilmu astrologiku masih jauh lebih hebat darinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130723,
					"content": "Ah, Paimon teringat sesuatu... Kita juga bertemu dengan anggota Fatui di Wangshu Inn, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130724,
					"content": "Kenapa orang-orang Fatui sangat tertarik dengan meteorit ini...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130725,
					"content": "Sepertinya mereka sedang merencanakan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130726,
					"content": "Hmmm, apakah mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130727,
					"content": "Ah! Jangan-jangan... orang-orang Fatui yang menyebabkan meteorit itu jatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130728,
					"content": "Paimon! Kurasa kamu sudah mencuri kalimat yang mau kukatakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130729,
					"content": "Ehehe... maaf. Mulut Paimon memang lebih cepat dari kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130730,
					"content": "Memangnya ada sihir yang bisa memanggil meteorit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "Woah, hebat sekali mereka bisa menarik bintang dari langit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130732,
					"content": "Ozvaldo Hrafnavins, bagaimana pendapatmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130733,
					"content": "Menurutku tidak ada hal yang mustahil di dunia ini, mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130734,
					"content": "Selama mereka dapat membayar harganya, mereka akan terus menebar benih kehancuran ke mana pun mereka pergi... Orang-orang Fatui, aku akan mengingat dosa-dosamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130735,
					"content": "Aku juga percaya bahwa keajaiban bisa saja terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130736,
					"content": "Pembawa pesan bintang, hasil kerjamu sangat memuaskan! Aku akan menyuruh anak buahku untuk melindungimu, kamu akan selalu aman dari kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130737,
					"content": "Maksudnya adalah... aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130738,
					"content": "Tidak perlu! Menurut Paimon, kita sudah cukup kuat. Tidak perlu memperbaiki sesuatu yang tidak rusak kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130739,
					"content": "Fischl, apakah kamu sedang meremehkanku? Aku bahkan lebih kuat daripada yang kamu bayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130740,
					"content": "Mein Fräulein memercayai dirimu dengan sepenuh hatinya. Mein Fräulein hanya mencemaskan dirimu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130741,
					"content": "Tidak perlu mencemaskanku. Kalian berada di situasi yang lebih berbahaya. Sebaliknya, kalian yang mungkin membutuhkan bantuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130742,
					"content": "Mona, kamu baik sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "Ke-kenapa kamu tiba-tiba berbicara seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130746,
					"content": "Kalau begitu kita selesaikan masalah baru ini terlebih dahulu. Menurut astrolabku ini, ada sebuah <color=#00E1FFFF>meteorit raksasa </color> yang baru saja jatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130744,
					"content": "Fischl, kamu baik sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Su-sudah seharusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Fischl"
				}
			]
		},
