					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131304,
					"content": "Oh, sepertinya ada... Kemarin dia sempat berteriak, \"Tinggi sekali!\". Entah apa yang dimaksud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
