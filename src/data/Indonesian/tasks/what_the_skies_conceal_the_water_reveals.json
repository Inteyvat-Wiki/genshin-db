				},
				{
					"id": 411131305,
					"content": "\"Tinggi sekali\"? Mungkin maksudnya puncak gunung yang tinggi sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131306,
					"content": "Gunung mistis bersalju, puncaknya yang menjulang tinggi, sumber dari kekuatan kegelapan...",
