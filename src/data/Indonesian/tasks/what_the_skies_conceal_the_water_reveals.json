		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Mona, kami telah menemukan sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130702,
					"content": "Gunung bersalju yang tinggi menembus awan, sepertinya di sanalah tempat benih kegelapan tumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130703,
					"content": "Gunungan bersalju? Hanya itu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130704,
					"content": "Itu adalah gunung bersalju yang muncul dalam mimpi semua orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "Gunung yang tingginya melebihi awan, belum pernah dilihat oleh siapa pun, dan suhu di puncaknya sangatlah dingin. Entah mengapa orang yang memimpikan gunung ini seolah dipaksa untuk mendaki gunung tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130706,
					"content": "Mendaki gunung... sampai ke puncaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130707,
					"content": "Orang macam apa yang mau mendaki puncak gunung sedingin itu? Dan sebesar apa hasratnya sampai-sampai orang lain pun bisa terpengaruh olehnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130708,
					"content": "Apakah mungkin banyak orang-orang yang disiksa di atas gunung itu, kemudian mati terkubur salju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130709,
					"content": "Atau mungkin... seseorang yang tertantang untuk menaklukkan puncak gunung bersalju tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130710,
					"content": "Biar kucoba sekali lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130711,
					"content": "Ketemu! Sedikit samar, tapi aku bisa melihat petunjuk baru. Orang itu bernama... <color=#00E1FFFF>Leonard</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130712,
					"content": "Waw! Cepat sekali, Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130713,
					"content": "Kan sudah kubilang kalau aku ini jenius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130714,
					"content": "Leonard... Paimon belum pernah mendengar nama ini sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111308",
