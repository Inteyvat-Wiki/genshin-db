			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Kamu Tejima ya? Jadi, kenapa kamu tiba-tiba ingin pergi dari sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Aku...? Per... pertanyaannya bukan kenapa aku mau pergi... tapi kenapa aku harus tetap tinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Kamu kan sudah tinggal di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Semua orang bergantung padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Benar... tapi aku tinggal di sini bukan karena itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "...dan apa yang membuatku mau datang ke sini 30 tahun lalu? Dan kenapa aku tidak pernah terpikirkan untuk pergi selama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "Aku tidak tahu jawabannya, karena aku tidak ingat lagi. Sejak mereka mengambil Vision-ku, rasanya seperti... sebagian ingatanku hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Dulu, aku tahu kalau aku mau tinggal di tempat ini... tapi apa pun yang membuatku ingin tinggal, sudah tidak ada lagi sekarang. Jadi kupikir, apa yang menghentikanku untuk pergi? Toh kekosongan dalam diriku akan tetap ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Oke... Jadi, kalau kita bisa bantu mengingat alasanmu tinggal di sini, berarti kamu tidak perlu pergi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Hmmm... Tapi kalau kamu tidak ingat apa-apa, susah juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Mungkin kamu harus coba mengingat-ingatnya lagi, siapa tahu... semua ingatanmu bisa kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Oh, aku baru ingat... Terakhir kali aku bawa buah untuk Tejima, aku melihat dia menulis buku harian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "Aku menulis buku harian...? Jujur saja aku tidak ingat, tapi kalau kamu pernah melihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Iya, iya, kamu menulis buku harian! Lalu aku juga ingat kamu bilang mau menuliskan hal-hal yang perlu diingat —— yang akan menjadi sangat penting nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Bagus! Jadi, kalau kita mau membuat Tejima tetap tinggal, kita hanya perlu mencari buku harian itu. Pasti ada di sekitar sini, ayo kita cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Kalau boleh, tugas mencari buku harian itu kuserahkan padamu ya... kita harus kembali ke desa untuk memberi tahu yang lainnya tentang kondisi Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
