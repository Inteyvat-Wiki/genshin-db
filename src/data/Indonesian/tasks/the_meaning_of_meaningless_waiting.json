			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Coba kita lihat, di mana ya orang yang Ayaka bilang barusan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Kenapa Anda begini? Setelah sekian lama, kenapa tiba-tiba begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Benar, ini semua terlalu tiba-tiba. Kita tidak punya waktu untuk bersiap-siap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "Anak-anak sangat berharap Anda dapat membawa mereka keluar untuk bermain... Tolonglah, kami mohon agar Anda mau mempertimbangkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Itu pasti orang yang dibilang Ayaka tadi. Ayo kita ke sana dan lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Ini seperti buku harian milik Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Ayo kita lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Hari ini, penduduk desa dan aku memasak Dry-Braised Salted Fish bersama. Aku mengacaukannya dan membuatnya jadi agak gosong, jadi aku harus berpura-pura kalau itu adalah Black Snakehead.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Hari ini, aku menolong seorang anak kecil yang jatuh ke sungai. Dia bilang bahwa teman baiknya, Banbu, masih ada di dalam air. Aku mencarinya sepanjang hari sebelum sadar bahwa Banbu itu nama kepiting peliharaannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"Hari ini, aku pergi menerbangkan layang-layang. Benangnya putus, jadi aku berlari secepat mungkin untuk menangkapnya. Lalu aku sadar aku tidak akan pernah mendapatkannya lagi, jadi aku hanya duduk di suatu tempat dan melihatnya terbang menjauh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Hmm... Seperti buku harian biasa dari seorang penduduk desa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Eh? Tunggu — masih ada lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"Hari ini, aku pergi berdoa lagi ke kuil, dan tetap di sana untuk beberapa saat. Omamori yang kamu berikan padaku sudah agak pudar, tapi benda itu masih tetap menjadi hartaku yang paling berharga...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "Nah ini baru informasi yang kita cari! Waktunya pergi ke kuil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Jadi ini omamori yang disebut Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Menarik... kalau lihat warna dan desainnya, Paimon rasa ini milik seorang anak kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "Tapi, kalau dia terus membawa benda ini, pasti ada energi elemental yang tersisa kan. Menurutmu bakal berguna kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "Oke kita sudah sampai! Ini sepertinya tempat yang sering didatangi Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "Tanah ini seperti bekas galian... Mungkin Tejima mengubur sesuatu di sini — sesuatu yang membuatnya tetap tinggal di desa selama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "Pasti ada sesuatu yang hebat, jadinya dia sampai bertahan di sini selama 30 tahun. Ayo gali dan kita lihat isinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "Ini seperti... surat? Kertasnya sudah menguning — pasti sudah lama sekali surat ini ditulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "\"Desa Konda\"... Kedengarannya tak asing — itu di mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "Di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Eh? Jadi alasan Tejima datang ke sini itu buat menunggu seseorang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Tapi dia sudah ada di sini 30 tahun... sepertinya orangnya tidak datang-datang ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Baiklah, ayo berikan barang-barang ini kembali ke Tejima terus baru kita jalan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Iya, ini... Memang tulisan tanganku... dan sepertinya omamori dan surat itu juga milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "...Tapi aku tidak ingat apa pun yang tertulis di buku harian itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Tetap saja... jelas sekali kalau aku memang menunggu seseorang di sini, dan aku memutuskan untuk menunggu selama 30 tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Selama bertahun-tahun, sepertinya aku mencatat semua yang kupikir menarik... semua yang bisa kuceritakan padanya nanti saat kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "Dan lihat saja apa yang terjadi setelah bertahun-tahun... Waktu berlalu begitu cepat, 30 tahun terasa seperti sekejap mata saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Bagaimana mungkin aku melupakan sesuatu yang begitu penting bagiku? Hmm... Sekarang setelah kupikir lagi, setelah Vision diambil dariku, rasanya diriku seolah... menjadi kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Cinta, penyesalan... semua yang kurasakan untuknya... semua menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Apa itu membuatmu merasa sedih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "Tidak... tidak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Lagi pula, aku juga sudah lupa dia siapa. Wajahnya, suaranya, semua hal yang kami alami bersama... Aku hampir tidak mengingatnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "Seolah dia tidak pernah ada di hidupku... seolah seperti, beberapa tahun tersebut hanyalah sebuah mimpi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Jadi, apa kamu masih berencana untuk pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Sepertinya... tidak. Jika ini adalah sesuatu yang sudah kutunggu selama hidupku, sepertinya aku harus terus menunggunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Walaupun, bagaimana jika nanti dia akhirnya datang, dan ternyata aku bahkan tidak ingat namanya sama sekali... Bukannya itu akan mengecewakan dirinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Saat aku memikirkannya... Ada sedikit rasa sedih di dalam hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Aku heran... Kenapa aku berpikir begini ya padahal aku tidak ingat dia itu siapa? Seolah ada perasaan kosong, seperti... ada yang hilang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "Terima kasih kepada kalian berdua karena telah membantuku mengingatkan alasan kenapa aku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Aku harus tetap berada di sini, dan terus menunggunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima tidak terlihat begitu sedih, tapi... ini membuat Paimon sedih sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Ya, aku juga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Sepertinya benar apa yang dikatakan Ayaka dan Thoma. Kalau Vision-mu hilang, semua harapan dan mimpi-mimpimu juga akan hilang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Itu menjelaskan kenapa Tejima menjadi seperti tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Tapi... setidaknya kita berhasil membantunya... ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*huff*... Ayo kita cari orang selanjutnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Kehilangan sebuah alasan untuk bersedih, mungkin adalah hal yang paling menyedihkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
						"stepId": 200406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Ah... Kamu pasti datang untuk membujuk Tejima tetap tinggal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "Tejima sudah menjaga tempat ini sejak dia datang ke sini 30 tahun yang lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Mengusir para Treasure Hoarder, menghalau monster yang mendekat, melerai para penduduk yang bertengkar... dia telah berkorban banyak sekali untuk menjaga tempat ini, kita sangat amat menghormati dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Tapi tiba-tiba, dia bilang mau meninggalkan kita... Kita jadi bingung —— apa kita berbuat salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Kalau memang begitu, kita akan segera meminta maaf... Kami hanya ingin agar dia tetap tinggal di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
