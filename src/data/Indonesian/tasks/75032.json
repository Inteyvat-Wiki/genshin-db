			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Sulit, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "Kapten pasti marah besar kalau dengar anggota pasukan terbang bisa dikejar semudah itu sama petualang yang kebetulan lewat. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Baiklah, tidak perlu kecewa. Seharusnya aku berterima kasih padamu karena sudah menjaga harga diriku sebagai mantan penunggang Saurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "Kamu jago terbang, tapi masih terlalu dini untuk bisa menandingiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Kalau percaya diri, mau coba lagi? Jangan mudah menyerah selagi muda. Kalah itu bukan masalah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
