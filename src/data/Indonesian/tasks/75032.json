			"dialogs": [
				{
					"id": 750320101,
					"content": "Pemandangannya bagus ya? Cocok sekali buat terbang. Melambung tinggi di langit bersama angin ... Pasti seru deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "Halo, pejuang! Kalau mau coba terbang, silakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "Ayahku bangun tempat ini buatku, tapi aku tidak keberatan kalau ada yang mau pakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Makasih, aku baru kepikiran mau coba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "Sama-sama! Semua yang suka terbang adalah sahabat Manyoya! Itu namaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "Kayaknya kamu masih terlalu muda untuk jadi penunggang Saurian di pasukan terbang. Kamu pejuang cadangan ya? Atau lagi latihan untuk jadi pejuang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "Kami cuma petualang yang kebetulan lewat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "Oh? Jarang-jarang ketemu petualang yang suka terbang. Tadinya aku pikir kamu lagi latihan untuk ujian pasukan terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "Melambung tinggi di langit ... Itu perasaan yang sulit dilupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Semua orang pasti suka perasaan bebas itu, aku juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "Kayaknya kamu berpengalaman banget ya. Kamu dari pasukan terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Haha! Dulu iya, aku sudah pensiun sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "Aku sudah terbang selama bertahun-tahun. Walaupun belum tua-tua amat, tapi aku ini veteran di pasukan terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "Kondisi tubuhku sudah tidak sebaik dulu, jadi sudah saatnya pensiun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "Tidak perlu merasa kasihan begitu. Haha! Aku sendiri tidak sedih kok, walaupun memang disayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "Penunggang Saurian kami yang masih muda baru saja mulai mengangkasa, tapi aku sudah tangkap bintang jatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Tidak ada yang abadi. Aku tidak bisa terbang sepanjang hari seperti dulu lagi, tapi setidaknya masih ada kesempatan untuk terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "Makanya aku datang ke sini, untuk mengenang kembali masa laluku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Sayangnya terbang sendiri rasanya lumayan membosankan kalau tidak ada rekan-rekanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "Oh, apa kamu tertarik terbang bersamaku? Pasukan kami sering adakan kompetisi kecil-kecilan buat habiskan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "Yang dapat skor tertinggi nanti kita lempar ke udara, yang skornya paling rendah harus traktir makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "Hubungan kalian erat banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Iya, semuanya hebat-hebat. Kami ini rekan sekaligus rival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Ah, tapi aku sudah tidak bisa menikmati suasana begitu lagi ... Kemampuanku juga sudah banyak menurun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "Tapi walaupun fisikku sudah melemah dan penilaianku melambat, pengalaman akan selalu bertambah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "Jadi aku pensiun cuma dari pasukan terbang saja, bukan pensiun terbang di langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "Gimana? Mau bersaing? Pede bisa ngejar penunggang Saurian veteran di langit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "Boleh, aku mau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "Aku sempat khawatir kamu bakal pikir aku ini orang aneh karena mendadak bahas soal ini dengan anak muda sepertimu. Untung tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "Bilang saja kalau mau coba. Kita tetapkan ini sebagai targetnya:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "Cukup tunggangi Saurian-mu dengan kecepatan penuh di sepanjang jalur balap dan selesaikan dalam batas waktu. Aku akan bantu kamu hitung skornya. Hasilnya akan dibagi jadi empat tingkatan. Kamu akan kuhitung menang kalau skormu lebih dari tingkat kedua tertinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "Cari saja aku kalau sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Aku pikirkan dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Makasih, nanti aku coba deh kalau ada waktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
