			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Sebenarnya kapan aku bisa menjadi petualang hebat ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Oh ternyata kamu, kemarin Cyrus menceritakan petualangan yang pernah dialaminya. Kali ini berlokasi di <color=#00E1FFFF>Stormbearer Mountains</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Dia bilang: \"Perisai besar itu sungguh seperti mimpi buruk bagiku, tidak peduli seberapa keras kamu menyerang, perisai itu tetap kokoh berdiri... Sementara itu, monster di balik perisai tersebut menatap tajam dan menertawakanku yang tidak berdaya ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Sebuah perisai kayu yang mampu menahan banyak serangan... Wah, aku ingin sekali melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Tapi banyak hal lain yang harus kulakukan... Aku tidak dapat membayangkan monster seperti apa yang mempunyai perisai sehebat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Hm... jika kamu tertarik, bisakah membantuku mencari monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Terima kasih banyak! Aku ingin mendengar ceritamu saat kamu kembali nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Ayo kita pergi bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Aku? Ah tidak bisa, masih banyak pekerjaan di Adventurers' Guild yang harus kuselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Akhir-akhir ini Adventurers' Guild tidak begitu menguntungkan. Jadi walaupun aku mendapat pekerjaan, umumnya hanya menjalankan tugas-tugas kecil untuk membantu orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Misalnya membantu Draff, mencari kucing milik Margaret, memetik beberapa bunga untuk Flora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "Hahaha, ketika aku bergabung dengan Adventurers' Guild, aku tidak menyangka petualangan semacam inilah yang akan kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
