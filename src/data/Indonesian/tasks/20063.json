				{
					"id": 200631601,
					"content": "...Baiklah, jangan menatapku seperti itu lagi, maafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631602,
					"content": "Jadi, Hilichurl...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631603
					]
				},
				{
					"id": 200631603,
					"content": "Ya, baiklah, memang benar. Monster di ceritaku hanyalah seekor Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "Hah... tapi dengarkan aku dulu, setiap anak muda di Mondstadt sangat ingin bergabung dengan Knights of Favonius, sehingga sulit sekali membujuk mereka untuk bergabung dengan Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631605,
					"content": "Alasannya, karena Knights of Favonius bertarung melawan seekor naga sedangkan Adventurers' Guild hanya melawan monster kecil seperti Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631606,
					"content": "Jika tidak ada kisah petualangan yang bisa diceritakan... Maka tidak akan ada yang mau mendaftar ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "Aku tahu mengarang cerita percuma saja... Tapi aku sendiri juga sudah tua, tidak mungkin aku benar-benar menaklukkan monster legendaris seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631608,
					"content": "Hah... ketika aku sudah pensiun nanti, apa yang akan terjadi dengan Adventurers' Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
