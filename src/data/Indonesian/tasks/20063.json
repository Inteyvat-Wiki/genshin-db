						200631404
					]
				},
				{
					"id": 200631404,
					"content": "...Cryo Slime? Sepertinya berbeda sekali dari yang diceritakan oleh Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631405,
					"content": "Kamu tidak salah mencari kan? Ah Stanley, apa kamu ingin memeriksanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631406,
					"content": "Ah, ehem! Tiba-tiba saja aku ingat ada cerita baru yang belum kuceritakan, Jack, apa kamu mau mendengarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631407
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631407,
					"content": "Tapi bagaimana dengan Cryo Slime ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631408,
					"content": "Aku jamin kamu belum pernah dengar cerita ini! Dulu sekali waktu aku masih muda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
