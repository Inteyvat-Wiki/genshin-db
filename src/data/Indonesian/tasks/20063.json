				"points": []
			},
			"dialogs": [
				{
					"id": 200630601,
					"content": "\"Para monster yang terbakar itu menggerakkan tubuhnya perlahan ke arahku... Aku melawan dan berteriak, tapi percuma; monster itu hanya menatapku dengan tatapannya yang buas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630602,
					"content": "Itu monster yang diceritakan Stanley. Dia juga menceritakan bahwa dia akhirnya berhasil mengalahkannya dan dengan menggunakan seluruh kemampuannya, dia memadamkan api di tubuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630603
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630603,
					"content": "Tapi setiap kali aku menanyakan padanya, dia tidak mau berkata lebih lanjut. Aku penasaran sekali dengan teknik yang dimiliki oleh Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
