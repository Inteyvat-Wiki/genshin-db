				"points": []
			},
			"dialogs": [
				{
					"id": 200631001,
					"content": "\"Aku melihat banyak kristal es di tubuh monster itu, membuatnya terlihat seolah lebih besar, lebih menyeramkan... Kakiku seperti membeku di tempat seraya aku terus mengayunkan senjataku... Aku berhasil memotong beberapa kristal es... Dan entah mengapa aku terpana dengan keindahan kristal es tersebut...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "Itu yang dikatakan Stanley padaku. Tapi dia mabuk sekali pada waktu itu. Saat dia sadar, dia bahkan tidak ingat lagi semua yang dia katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631003,
					"content": "Pada prinsipnya, tentu saja kamu harus melaawan monster tipe Cryo dengan Pyro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631004
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631004,
					"content": "Tapi, aku tidak dapat membayangkan kekuatan Pyro seperti apa yang kamu perlukan untuk melawan kekuatan Cryo sebesar itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
