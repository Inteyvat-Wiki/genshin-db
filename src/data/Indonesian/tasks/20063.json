			"dialogs": [
				{
					"id": 200631201,
					"content": "Jack, dengarkan aku dulu... bukan begitu ceritanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631202
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631202,
					"content": "Tapi... ah, kamu sudah kembali! Bagaimana? Apa kamu menemukan monsternya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Ketemu, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "Hanya Pyro Slime? Tidak mungkin. Bagaimana mungkin berbeda sekali dengan yang diceritakan oleh Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Ah, kebetulan sekali! Stanley, tolong ceritakan kembali tentang petualanganmu pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "Tentang monster yang tubuhnya terbakar api itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "O-oh, monster itu, ya... Aku sepertinya terlalu banyak minum waktu itu... Jadi, aku tidak begitu ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631208,
					"content": "Tidak apa-apa, aku masih ingat, aku bahkan mencatatnya dengan jelas di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631209
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631209,
					"content": "Wow! Jack, aku baru saja ingat satu kisah yang belum kuceritakan padamu, ini dulu sekali sewaktu aku masih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
