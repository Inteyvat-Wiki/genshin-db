					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "\"Perisai besar itu sungguh seperti mimpi buruk bagiku, tidak peduli seberapa keras kamu menyerang, perisai itu tetap kokoh berdiri... Sementara itu, monster di balik perisai tersebut menatap tajam dan menertawakanku yang tidak berdaya ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630802,
					"content": "Itu yang dikatakan Cyrus padaku... Aku masih ingat dengan jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630803,
					"content": "Dia juga mengatakan padaku bahwa untuk mengalahkan monster itu, kita harus fokus kepada perisainya lalu mencari celah untuk menghancurkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630804,
					"content": "Jika tidak begitu, saat monster itu mengangkat perisainya maka kita tidak bisa lagi menyerangnya. Tidak peduli seberapa hebatnya teknik bertarungmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630805,
					"content": "Dan akhirnya, Cyrus juga berkata, bahwa monster itu juga menunggu waktu yang tepat untuk menyerang. Saat kamu lengah, wwalau hanya sebentar, dia akan melancarkan serangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630806,
					"content": "Bisa mengalahkan monster sehebat itu, Cyrus benar-benar petualang yang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630807,
					"content": "Sayangnya, aku tidak mempunyai kekuatan seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
