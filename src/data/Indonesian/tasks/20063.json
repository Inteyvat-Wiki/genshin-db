			"dialogs": [
				{
					"id": 200630301,
					"content": "Aku hanya ingin pergi ke luar untuk bertualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Kemarin Stanley menceritakan kisah lain tentang petualangannya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Kali ini dia bahkan lebih mabuk dari biasanya, jadi agak tidak jelas... Tapi aku ingat kali ini berlokasi di dekat <color=#00E1FFFF>Dawn Winery</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "Dia berkata begini... \"Aku melihat banyak kristal es di tubuh monster itu, membuatnya terlihat seolah lebih besar, lebih menyeramkan... Kakiku seperti membeku di tempat seraya aku terus mengayunkan senjataku... Aku berhasil memotong beberapa kristal es... Dan entah mengapa aku terpana dengan keindahan kristal es tersebut...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Sebenarnya monster seperti apa yang membuat Stanley sampai kewalahan seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Aku benar-benar ingin melihatnya sendiri... Tapi jika aku pergi, aku pasti lari ketakutan saat melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Tapi, jika itu kamu, seharusnya tidak masalah, bisakah kamu membantuku mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Terima kasih banyak! Saat kamu menemukannya, tolong ceritakan padaku ketika kamu kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Ayo kita pergi bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Aku juga ingin sekali pergi. Tapi dengan banyaknya kesibukan di Adventurers' Guild... kamu tahu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus sepertinya sebentar lagi pensiun,dia bilang dia akan tinggal di Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman belum meninggalkan kota lagi sejak putrinya lahir. Sungguh disayangkan. Dia adalah Petualang kami yang hebat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Sementara itu Stanley juga dalam masa istirahat dan sudah lama tidak pergi bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "Jadi sekarang Adventurers' Guild mengambil banyak pekerjaan kecil dari masyarakat untuk menutup banyak biaya, dan mereka masih kesulitan untuk menemukan orang untuk tugas-tugas itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "Jadi aku harus bekerja keras, aku tidak bisa mengharapkan Bennett untuk melakukannya, dia juga sedang kesulitan sekarang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
