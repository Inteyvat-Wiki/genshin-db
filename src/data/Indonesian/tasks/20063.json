					"nextDialogs": [
						200631304
					]
				},
				{
					"id": 200631304,
					"content": "Bagus! Eh apa...? Hanya Hilichurl biasa dengan perisai kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631305,
					"content": "Mustahil. Mungkin maksud Cyrus berbeda... Apakah kamu yakin tidak salah tempat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631306,
					"content": "Oh Cyrus juga ada di sini, hei Cyrus, ayo cepat katakan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631307,
					"content": "Emm... ya, kamu benar Jack, itu monster yang berbeda dengan yang kutemui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631308,
					"content": "...Eh, kenapa Cyrus mengedipkan matanya seolah memohon pada kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200631309,
					"content": "Hahaha, tentu saja, tapi tak masalah, karena jika monster itu bisa ditemukan dengan mudah, pastinya aku tidak berani lagi keluar dari kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631310
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631310,
					"content": "Tapi, terima kasih atas kerja kerasmu, sekarang aku pergi dulu, masih ada urusan lain yang harus diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
