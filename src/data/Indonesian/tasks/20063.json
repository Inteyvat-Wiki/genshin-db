			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "Oh, aku jadi ingin melihatnya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Lihat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Wah, kapan kamu datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Kemarin, Stanley mabuk dan memberitahuku tentang semua petualangannya di <color=#00E1FFFF>Dadaupa Gorge</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "Dia bilang, \"Para monster yang terbakar itu menggerakkan tubuhnya perlahan ke arahku... Aku melawan dan berteriak, tapi percuma; monster itu hanya menatapku dengan tatapannya yang buas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Meskipun aku belum pernah melihatnya sendiri, tapi jika Stanley saja berkata demikian, kurasa itu pasti sebuah pertarungan yang sengit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "Ah... aku ingin sekali mencari dan melawan monster yang dibilang Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Tapi dengan kekuatanku yang sekarang, yang ada malah aku babak belur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "Oh tapi, jika kamu bersedia... Bisakah kamu membantuku mencari monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Bagus! Kalau begitu, tolonglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Aku bisa menemanimu untuk pergi mencari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Andai aku bisa, aku juga akan pergi denganmu, tapi sayangnya aku masih banyak urusan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "Urusan apa katamu? Sayangnya, hanya menjadi petualang untuk Adventurers' Guild di Mondstadt tidak memberikan banyak penghasilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Jadi sekarang aku juga banyak melakukan pekerjaan lain untuk orang-orang di kota. Seperti mencari kucing yang hilang, memotong rumput, dan sebagainya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "Jadi biarlah petualangan hebat ini kuserahkan padamu. Ceritakan semuanya padaku saat kau kembali nanti, aku ingin dengar semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
