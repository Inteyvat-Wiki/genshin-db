			"dialogs": [
				{
					"id": 230110601,
					"content": "Bagaimana? Apa kayu yang kubeli sudah sampai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Kamu menjelaskan semua kejadiannya kepada Viktor ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Monster lagi? Kenapa aku merasa gerobak di seluruh dunia gampang sekali diserang monster ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Sudahlah, yang penting kayunya sudah ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Nih, imbalan yang sudah aku janjikan. Hitung dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "Terus ... anu, bagaimana keadaan Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "Aku tidak sempat bilang selamat tinggal kepada dia waktu aku pergi, dia tidak marah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Dia sehat sekali kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Baguslah kalau begitu *uhuk* Jangan menatapku begitu dong, aku cuma khawatir sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "Ya sudah deh. Ini, hitunglah imbalanmu, Pengembara, tidak akan ada yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Kembalilah dan kunjungi dia sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Kalau begitu, Tuan Vsevolod pasti akan menendangku, lupakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "Aku juga tidak terlalu berani langsung kirim surat kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110613,
					"content": "Menerima sepucuk surat dari Fatui, kedengarannya tidak terlalu baik, kan. Hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				}
