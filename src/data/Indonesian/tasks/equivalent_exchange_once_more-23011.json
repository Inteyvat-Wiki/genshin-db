			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Ugh ... bagaimana cara mengukir di sini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Hai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Aduh, siapa sih! Jangan ganggu aku, aku lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "Ah?! Pengembara?!? Kenapa kamu bisa ke Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Jangan-jangan Rudolf yang kirim kamu untuk menghajarku? Aku cuma kasih hadiah untuk Lily dulu sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Aku cuma kebetulan datang ke sini ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Kamu masih bertualang ya, tenagamu tidak habis-habisnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Tapi, aku tidak sangka bisa bertemu denganmu di Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "Waktu aku dipindahkan dari Mondstadt, perintah awalku sebenarnya langsung kembali ke Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Tapi, di tengah jalan aku diberikan perintah baru untuk membantu Tuan Vsevolod di kota Sumeru. Aku juga diberi tahu kalau aku sudah dipindahkan untuk jadi anak buah Lord \"Pulcinella\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "\"Pulcinella\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Benar. Ugh. Tidak. Aku tidak boleh cerita lebih dari ini. Kalau tidak Tuan Vsevolod akan bilang aku tidak bisa menjaga rahasia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "Eh, nama-nama Lord Harbinger ini bukan rahasia, kan. Entah kenapa dia sensitif sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Jadi kamu sedang apa di Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Oh, aku dan Tuan Vsevolod bertugas untuk koordinasi logistik. Sederhananya, pergi belanja ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Walaupun kedengarannya tidak terlalu penting, setidaknya itu lebih baik daripada harus terus bengong di katedral Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Hehe, lagi pula pekerjaan ini juga tidak terlalu sibuk dan tidak ada orang yang terus mengawasiku sepanjang waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "Aku juga sudah asah kemampuan mengukir yang sudah aku dalami sejak kecil. Ada banyak kayu besar di Sumeru kan, kebetulan bisa digunakan untuk latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "Tidak disangka mainan yang aku ukir itu disukai anak-anak. Anak-anak ini terus ribut mau, jadi aku berjanji untuk kasih mereka mainan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Kamu Fatui, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Benar, memangnya kenapa? Aduh ... memangnya ada peraturan kalau Fatui tidak boleh kasih mainan untuk anak-anak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Ditambah lagi aku sekarang pengurus logistik, hal-hal yang heboh itu, biar saja orang-orang di atas yang mengurusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Intinya, kondisiku sekarang seperti ini. Meski tidak bisa kembali ke Snezhnaya, tapi aku lumayan suka Sumeru. Di sini ada makanan dan hiburan, lingkungannya juga bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "Setelah selesai kerja, aku akan pergi beli makan dan mengukir kayu di tempat yang cahayanya yang cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Walaupun ... Haha. Kelihatan kok, semua orang tidak terlalu percaya padaku, sama seperti saat pertama kali kamu bicara denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Tapi aku juga tidak bisa ngapa-ngapain, siapa suruh aku jadi Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Aku sekarang juga tidak percaya sama kamu loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Ya sudah ... Intinya aku sudah cukup puas dengan kehidupanku sekarang, dan aku sekarang sudah punya sedikit tabungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "Kalau terus begini, mungkin beberapa tahun lagi aku bisa menetap di Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "*uhuk* *uhuk* Sudah sudah. Pengembara, kamu kan sudah datang ke Sumeru, kalau kamu tertarik, kita bisa melanjutkan \"pertukaran setara\" kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Tapi, kali ini aku tidak punya cerita yang bisa diceritakan lagi, aku cuma bisa memberikan imbalan Mora kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Mending seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Baiklah, aku akan jelaskan komisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Beberapa hari lalu, aku pesan kayu pada Hamawi, tapi sampai sekarang dia masih belum kirim barangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Karena aku masih bekerja sekarang, aku tidak berani pergi mencarinya. Kalau tidak Tuan Vsevolod pasti marah kepadaku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "Pengembara, bantu aku tanyakan kepada Hamawi, kapan kayuku akan dikirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Siapkan saja imbalannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Tenang saja, aku pasti akan menyiapkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "Intinya, aku serahkan hal ini kepadamu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Kamu tidak sedang merencanakan sesuatu, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Apa aku pernah melakukan sesuatu yang aneh waktu bertransaksi denganmu dulu? Tenang saja, aku tidak suka melakukan hal merepotkan seperti itu, lebih baik aku hidup tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Apa ini komisi dari \"Fatui\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Tentu bukan, ini cuma komisi dari \"Viktor\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Siapa yang percaya sama kamu? Jangan dekat-dekat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Kamu tidak sedang mencoba mengorek informasi dari anak-anak, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Hei! Aku tidak akan berbuat hal seperti itu, kamu punya stereotipe jelek apa sih sama Fatui?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Harbinger lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Benar, yuk balik denganku ke Mondstadt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Ha, ha, ha, baiklah. Jadi kamu perlu borgol waktu membawaku pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Sudahlah, aku tidak mau bercanda denganmu lagi. Masih ada kerjaan yang harus kuselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "Vik-Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
