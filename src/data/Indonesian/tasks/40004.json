		{
			"id": 4000408,
			"completionStepIds": [
				4000408
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000408",
							"2"
						],
						"stepId": 4000408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bei'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040802,
					"content": "Lagi pula surat itu terlihat seperti omong kosong! Tidak ada gunanya beradu senjata untuk hal begini... ini, ambil saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040803,
					"content": "Jadi begitu ya — Paimon sudah tahu dari awal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME}, ayo sini kita baca suratnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040805,
					"content": "Ternyata begitu, kalau begitu biar kukirim keduanya pergi ke pertemuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040806,
					"content": "Pengirimnya tampaknya sedang merencanakan sesuatu yang benar-benar jahat untuk Lantern Rite. Sepertinya mereka ingin membakar seluruh kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040807,
					"content": "Bagus, semua orang senang. Kamu senang, kami juga senang. Namun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040808,
					"content": "Keduanya terlihat sangat berbeda dengan kita... Kamu tidak berpikir itu akan menjadi masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040809,
					"content": "Tidak perlu khawatir, kalau kita menyamar, tidak ada yang tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040810,
					"content": "Aku masih tidak tenang memikirkannya, tapi karena ada dukungan Adeptus, semoga saja tidak terjadi apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040811,
					"content": "Ka-kalau begitu keselamatan Liyue berada di tanganmu sekarang. Semoga berhasil, bahkan Treasure Hoarder saja tidak mau melihat kota itu terbakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040812,
					"content": "Baiklah, kalau begitu kami serahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040813,
					"content": "Eh tunggu dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040815,
					"content": "Tempat kita bertemu lagi selanjutnya adalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040817,
					"content": "Kuharap kita bisa bertemu di suatu tempat dengan pemandangan Lentera Mingxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "...aku tidak menyukai daerah yang ramai. Apalagi saat-saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040819,
					"content": "Haruskah di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040820,
					"content": "Yap yap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "...aku mengerti. Aku akan menunggu kabar darimu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4000409,
