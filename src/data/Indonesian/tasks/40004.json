			"dialogs": [
				{
					"id": 400040901,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040902
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040902,
					"content": "Tapi bukannya itu arah ke Pelabuhan Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Benar. Di sini tidak ada apa-apa. Jadi ke sana adalah arah ke Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040904,
					"content": "Jika kamu sedang mencari tempat tinggal, aku sarankan kamu pergi ke Wangshu Inn. Harga yang wajar, layanan pelanggan yang luar biasa, dan pemandangan yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040905,
					"content": "Kami ingin melihat surat kaleng itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "Kenapa kamu bisa tahu tentang surat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040907,
					"content": "...hm, salah satu Adeptus di Liyue memberi tahu kami soal itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "Oh ya? Entah mengapa aku ragu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040909,
					"content": "Kalian tidak perlu meragukannya. Akulah yang mengutus mereka untuk menyelidiki hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Jika ada pertanyaan lain, tanya saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "Ka-kamu... Vigilant Yaksha!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040912,
					"content": "Hei! Hati-hati dengan nada bicaramu itu ya! Atau kamu memang benar-benar ingin menantang seorang Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "Bukannya kami tidak percaya bahwa kamu Adeptus, tapi... semua orang harus melihat permasalahan yang lebih penting dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040914,
					"content": "Anda juga tahu, kami Treasure Hoarder bukan ancaman serius bagi orang-orang. Kami hanya seorang kriminal rendahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040915,
					"content": "Jadi jika Anda benar-benar seorang Adeptus, tolong... kasihanilah kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040916,
					"content": "Tentu saja, jika kamu ternyata bukan seorang Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040917,
					"content": "Maka, jangan salahkan senjata kami yang memperlakukan semua orang sama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Crafty"
				}
			]
		}
	]
