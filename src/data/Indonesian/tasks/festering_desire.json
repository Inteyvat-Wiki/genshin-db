			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "Ah, ternyata Sucrose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "Kamu juga datang untuk menjelajahi gunung salju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "Argh! Ka, kamu membuatku kaget... Tolong jangan mengagetiku saat aku sedang memikirkan laporan penelitian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100204,
					"content": "Tapi kamu hanya terlihat sedang melamun sambil berdiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "Ti, tidak kok! Aku tadi memikirkan nama spesies baru Sweet Flower yang kuteliti. Ukuran bijinya empat kali lebih besar dari yang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100206,
					"content": "Empat kali lebih besar? Pasti rasanya enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Oh, kamu tertarik? Bagus sekali! Lain kali aku akan menunjukkan hasil pekerjaanku kepadamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100209,
					"content": "Sayang sekali, kalau saja aku tidak ke gunung ini... Aku mungkin bisa memperlihatkan contoh hasilnya kepadamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100210,
					"content": "Oh ya, bukannya kamu biasa meneliti di kota? Kenapa malah ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Aku dan Timaeus sedang membantu Tuan Albedo menyelesaikan data penelitian. Timaeus baru saja pergi, kalian tidak melihatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100212,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Kata Timaeus, pemikirannya tidak setajam Tuan Albedo dalam melakukan pendataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100214,
					"content": "Ada beberapa hal yang bisa dipahami Tuan Albedo hanya dengan sekali lihat, sedangkan kami memerlukan banyak waktu untuk memahaminya. Mungkin ada perbedaan yang jauh di antara pengetahuan dan pengalaman kami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100215,
					"content": "Timaeus terlihat sangat murung. Dia bilang dia ingin berjalan-jalan dulu di tempat lain. Jadi aku sedang menyelesaikan sisa-sisa pekerjaan sendirian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100216,
					"content": "(Rasanya Timaeus sengaja meninggalkannya di sini...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "Awalnya aku mau berkeliling di sekitar sini setelah menyelesaikan tugasku, tapi tak disangka aku menemukan beberapa data menarik dari laporan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100218,
					"content": "Yah, sepertinya pencarian rahasiaku harus ditunda lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100219,
					"content": "Rahasia? Rahasia apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "Hah? Hmm... Apa kalian sekarang ada waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100221,
					"content": "Tentu saja ada, kami punya banyak waktu untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Apa aku boleh meminta bantuan kalian? Sebenarnya, aku merasa Tuan Albedo sedang menyembunyikan sesuatu dariku dan Timaeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100223,
					"content": "Bukannya dia gurumu? Apa yang bisa disembunyikan seorang guru kepada murid-muridnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Dia memang guruku, tapi rasanya dia selalu menyembunyikan sesuatu dariku... Kutebak dia pasti sedang menyembunyikan rahasia besar alkimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100225,
					"content": "Tunggu. Kenapa kamu terdengar begitu yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Aku dan Timaeus tergila-gila dengan penelitian alkimia. Kalau itu hal yang lain dari alkimia, Tuan Albedo tidak mungkin menyembunyikannya dari kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100227,
					"content": "Hmm... Kamu benar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "Apa kamu bisa membantuku menyelidiki apa yang disembunyikan Albedo? Tolonglah~ Aku, aku sangat penasaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100229,
					"content": "Hmm... Bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Kalau Sucrose memang menginginkannya, kita bisa mencoba mencari tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Horeee! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100233,
					"content": "Baiklah, biarkan kami pergi cari tahu dulu, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "Aku juga penasaran dengan rahasia Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "Apa itu bisa dimakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
