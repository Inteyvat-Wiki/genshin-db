			"dialogs": [
				{
					"id": 412109901,
					"content": "Rahasia Tuan Albedo pasti sangat mencengangkan. Kalau tidak, kenapa dia harus menyembunyikannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
