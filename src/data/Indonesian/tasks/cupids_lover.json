			"dialogs": [
				{
					"id": 740750101,
					"content": "\"Di sinilah letak kuadran jiwa, kuil jiwa, ruang jiwa ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "\"Menemanimu dalam istirahat abadi\" ... \"Terlahir dalam sekejap, selalu bertentangan, tak pernah terpisahkan\" ... \"Akulah harta yang paling berharga dalam hidup\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Fuhh ... enggak ada yang bikin seram kali ini. Jadi jawabannya ternyata jam saku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "Ngomong-ngomong, bukannya kamu juga punya satu, Ann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Hmm, jam memang mahal sih ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "Jadi jawabannya pasti uang, alias Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Meninggal berlinang harta adalah tragedi terbesar kedua. Jangan tanyakan apa yang pertama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "Memangnya apa tuh tragedi terbesar yang pertama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Sepertinya aku tahu deh. Jawabannya pasti \"meninggal tanpa ditemani sepeser Mora pun\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Pandangan ini rasanya tidak terlalu bagus. Memangnya di dunia ini tidak ada hal yang lebih penting daripada itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "Kan sudah kubilang, makanya tidak perlu ditanyakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Maafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Tapi kembali lagi — berdasarkan alasan yang tadi, kurasa jawabannya bukanlah jam saku mewah, maupun Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "Kalau gitu apa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "Jawabannya sederhana — aku bisa menemukan teka-teki serupa dengan tingkat kecocokan 70%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Teka-teki ini asalnya dari novel klasik ratusan tahun yang lalu. Teks aslinya, \"Aku lahir ketika mata kita sesaat berjumpa. Aku berlari membelakangi orang yang kukejar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "\"Bahkan setelah seluruh daging, tulang, dan organ telah dipotong, aku masih berbaring bersamamu di dalam sumsum yang tersisa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "Jawabannya adalah \"cinta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Aku paham sekarang. Jam saku ini sama seperti yang kupunya — pasti ada kenangan cinta juga di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Andai saja jam saku ini bisa terbuka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Ya, suatu hari ia pasti bisa terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Hebat kamu, anjing bodoh! Kamu memang anjing mekanik yang paling imut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "Dengan senang hati. Tapi kata \"imut\" buatku adalah deskripsi yang subjektif. Aku lebih senang dipanggil \"Prototipe 4ACV07 yang dapat diandalkan dan berguna\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Nah! Justru itu yang bikin kamu jadi imut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "Kalian lagi mengulangi percakapan lama tidak sih? Kok rasanya seperti pernah melihat adegan ini ya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "Lupakan saja. Teka-teki di sini sudah terpecahkan, ayo kita bergegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
