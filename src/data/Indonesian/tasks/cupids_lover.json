					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751803,
					"content": "Sepertinya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751804,
					"content": "Sebenarnya siapa sih yang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751806,
					"content": "Kami dulu pernah berseteru dengannya di Elynas. Ah maaf kuralat — akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "Dulu waktu kulihat korban yang mengenaskan di depan gerbang itu, aku langsung mengenali tulisan tangannya. Ternyata dia masih aktif ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751808,
					"content": "Lalu ... buat apa dia ambil barang-barang di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "Sederhana saja. Dia ingin menempa ulang Pedang Agung Narzissenkreuz. Kan perihal Asosiasi Narzissenkreuz ini masih belum selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751810,
					"content": "Ayo, sebaiknya kita cepat-cepat ke tempat yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
