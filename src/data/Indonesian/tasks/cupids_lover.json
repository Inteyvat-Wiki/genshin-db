				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "Kayaknya belum lama ini ada orang yang datang ke sini. Paimon kaget deh kita ketemu sama seseorang yang lebih hebat dari kita dalam urusan kemampuan eksplorasi arkeologinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "Apa itu ... jam saku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "Kayak biasa, coba Paimon baca dulu petunjuknya di tablet batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "\"Di sinilah letak kuadran jiwa, kuil jiwa, ruang jiwa ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "\"Menemanimu dalam istirahat abadi\" ... \"Terlahir dalam sekejap, selalu bertentangan, tak pernah terpisahkan\" ... \"Akulah harta yang paling berharga dalam hidup\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Ah, ini sudah sangat jelas, kawan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Hmm ... Jam saku yang sangat berharga, tapi juga harta karun di dunia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Ooh, Paimon tahu! Pasti Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "Ka-Kayaknya bukan deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "Iya juga sih, jawaban teka-teki masa gampang gitu. Jawabannya pasti ... itu loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "Ah, ini! \"Kekayaan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Bagus! Saking bagusnya enggak mungkin benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "Aduh! Ayolah, masa Paimon diragukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "Oke, kalau kamu pintar, apa coba jawabannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Hari ini cuacanya bagus ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "Hei! Jangan ngalihin topik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "Sudahlah, itu enggak penting. Kita masuk lebih dalam lagi dan lihat-lihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "Hei! Kalau enggak tahu ya ngaku! Jangan malah lari cepat-cepat gara-gara malu. Eh, tunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750207,
					"content": "Ini sebuah teka-teki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
			]
		},
