				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "*fuhh* Bagaimana aku bisa melewatinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Oh... Halo. Ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "Apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "Aku ingin pergi ke menara pengawas di Stormbearer Point. Aku ingin melihat apakah ada badai yang muncul di laut atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "Tapi sekelompok monster menghalangi jalanku... Aku sedang berpikir bagaimana cara melewatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "Oh, jangan khawatir, aku tidak meminta kamu mengantarku ke watchtower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "Ini adalah tugasku, dan aku harus melakukannya entah bagaimanapun caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "Silakan lanjutkan urusanmu. Jangan mencemaskanku, biar aku memikirkan caranya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
