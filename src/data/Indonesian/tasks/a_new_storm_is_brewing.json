				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "Hm... hari ini pun laut tenang dan tidak ada angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Generasi keluargaku dipercaya oleh Lady Vennessa untuk menjaga Mondstadt dengan mengawasi tanda datangnya badai dari sini,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Sejak Lord Barbatos melindungi Mondstadt, kami tidak pernah lagi diterpa oleh badai, dan watchtower pun perlahan-lahan ditinggalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Walaupun demikian, aku tetap tidak bisa berhenti untuk datang ke menara pengawas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Kamu sungguh berdedikasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Terima kasih, tapi bicara mengenai kewajibanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Aku lebih suka untuk tidak melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Baiklah, terima kasih sudah membantuku, ini Windwheel Aster untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "Dulu, keluargaku akan melihat seberapa banyak Windwheel Aster yang tumbuh di suatu daerah untuk menentukan seberapa kuat angin di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Karena Windwheel Aster tidak bisa tumbuh di tempat yang tidak berangin atau sering dilanda badai besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Mereka hanya tumbuh di tempat dengan angin yang sepoi-sepoi seperti Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Aku harap mereka bisa terus tumbuh dengan baik di sini selamanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "Ini adalah sejarah yang menyedihkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Ya, aku harap sejarah tidak akan terulang kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
