			"dialogs": [
				{
					"id": 200400501,
					"content": "Meski dia bilang begitu, tapi tetap saja di depan sana banyak monster berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400502,
					"content": "Ayo kita bersihkan area ini untuk Nona Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400503,
					"content": "Lihat dia... Dia mungkin benar-benar berpikir ingin menerobos langsung ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400504,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "Iya, dan orang yang seperti itu layak untuk dibantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400505,
					"content": "Aku belum pernah melihat orang yang seserius dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Itu benar-benar situasi terburuk yang mungkin terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400508,
					"content": "Untuk mencegah hal tersebut, ayo cepat kita singkirkan monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
