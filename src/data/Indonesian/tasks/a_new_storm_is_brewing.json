			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "Apa kamu masih ada urusan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400202,
					"content": "Di depan sekarang sudah aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Eh? Benarkah? Terima kasih banyak Archon Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400204,
					"content": "Ah maksudku - maaf, aku seharusnya berterima kasih kepada kamu！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400205,
					"content": "Bagaimana aku bisa membalas jasamu？ Ah, aku tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400206,
					"content": "Datanglah ke puncak menara pengawas, aku akan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
