			"dialogs": [
				{
					"id": 190570701,
					"content": "Maaf ya, tadi aku tidak sopan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Detektif Heizou? Dia sih paling tidak suka orang seperti aku, yakin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Dia kelihatan sopan dan ramah, tapi ... Aku tahu dia memperlakukan kami pelaku penipuan dengan berbeda. Dia seperti ada dendam pribadi sama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Apa mungkin dia pernah ketipu ya? Mustahil, memangnya ada ya orang sepintar itu sampai bisa menipu Detektif Heizou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
