			"dialogs": [
				{
					"id": 190570901,
					"content": "Yah, cari gara-gara sama Heizou itu memang tidak bijak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Eh? Penasaran sama apa yang terjadi? Bukan apa-apa sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Begitu tahu kasus itu diurus Heizou, aku menyerah dan langsung mengaku. Memangnya bisa apa kalau di depanmu ada \"Angin Ribut\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "Angin Ribut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Si Heizou. Semua tahanan di penjara sebut dia dengan julukan itu, kalian belum pernah dengar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Tidak bisa lari atau pun sembunyi. Di mata para tahanan, Heizou bagaikan bencana alam, tidak ada yang bisa luput darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Eh, menyesal sekarang sih percuma ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
