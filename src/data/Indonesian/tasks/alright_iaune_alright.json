					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "*huff* Kenapa bisa gini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "Oh Pengembara, senang bertemu denganmu. Lagi ngopi di sini? Sini kutraktir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "Kenapa? Mukamu kok capek banget. Dipaksa begadang lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "Terima kasih perhatiannya, tapi kali ini masalahnya pribadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "Aku lagi memikirkan ... tentang makna pekerjaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "Aku tadinya yakin bahwa Maison Gestion adalah organisasi yang kuat, adil, dan efisien. Tempat semua orang saling bantu dengan kerelaan hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "Bahwa di bawah pengelolaannya, Fontaine akan terus berkembang ke arah yang lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Tapi sekarang, tempat itu tak ubahnya mekanisme yang sebentar lagi rubuh. Gerigi, tuas, dan komponennya acak-acakan semua ... cuma luarnya saja yang kelihatan rapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "Dan dia bisa jalan cuma karena kebetulan dan pembelajaran. Bukan berasal dari pertimbangan yang matang ataupun rancangan yang mumpuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Aku ... Aku mau melakukan sesuatu, tapi tidak tahu harus mulai dari mana. Aku takut kalau ada sedikit saja yang salah, rumah ini akan langsung runtuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Tuan Roialte selalu suruh aku lebih santai, toh salah apa pun sudah tidak bisa bikin keadaan bertambah parah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "Waduh ... kok gitu sih ngehiburnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "*huff* Maaf, aku harusnya tidak mengeluh. Padahal aku ke sini untuk menjauh dari semua itu .... setidaknya untuk sementara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Sini, aku bikinin kopi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Yang benar? Kamu bisa? Hebat! Aku selalu ingin belajar, tapi tidak pernah sempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Kalau begitu tolong, ya. Aku tunggu di sini ... Semoga sih kerjaan tidak menghantuiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Hari ini libur ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
