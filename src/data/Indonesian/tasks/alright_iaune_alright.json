				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "Pengembara ... Kamu benar-benar bikin kopi buatku? Um, maaf sudah merepotkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Jangan sungkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Kopi ini ... jauh lebih enak dari yang di Maison Gestion! Aduh, salah. Sama sekali tidak bisa dibandingkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Kalau aku bisa minum kopi ini setiap hari, dijamin tidak bakal setengah mati nahan kantuk waktu kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Terima kasih kopinya. Aku akan balik kerja lagi setelah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Semangat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Iya. Aku harus cepat terbiasa dengan kerjaanku dan menjadi orang yang bisa menangani berbagai hal sendiri seperti Tuan Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*huff* Kira-kira berapa banyak masalah yang harus kuhadapi sebelum bisa seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Pantang menyerah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Minum dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
