				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "Pengembara, mau bantu di sini lagi? Makasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "Ah, kali ini enggak dulu. Kami cuma mau bikinin kopi buat seorang teman, soalnya dia lagi ... eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "Dia lagi galau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "Teman, maksudnya si Iaune? Yang duduk di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "Kamu kenal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Roialte dan aku itu teman lama. Dia pernah cerita ada anak muda yang ceria dan pekerja keras melamar ke kantornya. Anak muda itu Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "Jangan terlalu dipikirkan. Anak muda yang baru masuk ke Maison Gestion pasti kaget dulu awalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "Kalau sudah betah dan nemu posisi yang pas di sana juga bakal baik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "Kok kayaknya kamu pengalaman banget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "Ah, soalnya itu pengalaman pribadi. Aku ini juga tadinya lobak yang ditanam di Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "Tapi ya, kurang puas rasanya cuma jadi lobak. Akhirnya aku \"mencabut\" diri sendiri lalu ... buka kafe ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "Ada sejarahnya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Hahaha, bisa jadi! Tapi sekarang sih aku cuma bos kafe biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "Nah, kalian bukannya mau bikinin Iaune kopi? Aku setel dulu deh mesinnya, nanti langsung saja kalau sudah mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "Kayaknya bakal panjang kalau diceritain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "Banyak tekanan kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
