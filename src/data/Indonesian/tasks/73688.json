			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Ah, kalian berdua akhirnya sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Ugh, si Hirotatsu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "Pengembara sudah kalahin kamu beberapa hari lalu dan menang. Kamu mau bilang apa lagi, hmmmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "Jangan khawatir, aku di sini bukan buat cari gara-gara. Aku cuma mau minta maaf. Pengembara, aku kalah olehmu secara adil beberapa hari lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Ilmu pedangmu hebat sekali. Setiap tebasannya benar-benar akurat tapi tidak agresif, dan itu sudah cukup untuk menggambarkan karaktermu. Aku minta maaf karena sudah salah menilaimu dan menyinggungmu dengan tindakan dan kata-kataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Tidak apa-apa, aku tidak masalah kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Kalian berdua pasti di sini untuk menjemput Nona Kamisato. Dia sekarang sedang di ruang ganti dan harusnya akan segera keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "Pengembara, sebelum nona muda keluar, aku punya permintaan yang mungkin bisa kamu pertimbangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Oke, apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Meskipun nona muda itu tidak pernah menyebutkan pertandingan ekshibisi hari ini kepada kami para pengikutnya, tapi dia telah menyisihkan beberapa jam setiap malam untuk melatih ilmu pedangnya, padahal dia sibuk sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Nona muda memang selalu tekun dan teliti. Walaupun ini cuma pertandingan ekshibisi dan tidak penting kalaupun dia kalah, tapi aku percaya dia akan melakukan yang terbaik untuk menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Sebagai pengikutnya, aku tentu percaya padanya, tapi ... aku masih berharap kamu bisa mendukung nona muda di arena dan menjamin keselamatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Oke, jangan khawatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "Pengembara, kupercayakan nona muda padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Oh, itu pasti Ayaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Wow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "Oh? Ada apa? Kenapa kalian berdua diam begitu ...? Apa ada yang salah dengan pakaiannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Enggak kok! Ayaka, kamu kelihatan wah banget ... Cantik banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Kamu cocok sekali dengan baju itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Iya, betul, kamu kayak nona muda yang baru turun dari kapal Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Oh ya? Aku sudah khawatir kalau ini terlalu berlebihan ... aku jadi tidak yakin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Tapi setelah dengar pendapatmu aku jadi lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Paimon enggak sabar mau lihat tampang orang-orang waktu mereka lihat Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "Terima kasih atas pujiannya, Paimon. Pengembara, karena sekarang kita sudah siap, ayo kita ke arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "Nona, Pengembara, kuucapkan semoga beruntung pada pertandingan ekshibisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Ini pakaian yang indah dan cocok sekali sama kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Nih lihat! Bahkan ada lambang Klan Kamisato di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Iya, Onodera meminta seseorang dari keluargaku untuk membuatnya beberapa hari belakangan ini. Kudengar ini berdasarkan sugesti yang ditulis oleh penonton waktu pemungutan suara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Pakaian ini benar-benar dijahit dengan baik dan bahkan memberi ruang gerak yang bebas lebih dari dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Aku menikmati pertarungan kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
