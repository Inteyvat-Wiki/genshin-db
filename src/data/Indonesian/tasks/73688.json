			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Kemampuanmu begitu luar biasa. Aku benar-benar tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Aku merasa terhormat bisa bertanding denganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Hadirin yang terhormat, setelah pertarungan yang sengit, juara Pertarungan Pedang Jiwa Pejuang sudah diputuskan! Pemenangnya adalah ... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "Besok, kami akan menyelenggarakan pertandingan final ekshibisi ... Pengembara dan Nona Kamisato melawan utusan yang dipilih oleh Yang Mulia Shogun, mesin berbentuk manusia yang dikenal dengan nama \"Maguu Kengou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Sampai jumpa di arena nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "Pengembara, tadi itu pertandingan yang begitu menegangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "Selamat, Pengembara. Kamu sudah meraih gelarmu sebagai juara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon enggak tahu kalau musuh besok ternyata Maguu Kengou ... Kok namanya mirip banget sama si nyebelin yang ada di Pulau Yashiori. Oh, kayaknya pertarungan ini enggak gampang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Jangan khawatir, Paimon. utusan Shogun mungkin memang kuat, tapi pertandingan besok tidak melarang penggunaan Vision. Kita pasti bisa jadi tim yang kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Selama kita bisa membaca gerakannya, kesempatan untuk menyerang balik akan muncul dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Oh, dengar kamu PD gitu Paimon jadi lumayan lega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Aku tidak bisa menjamin kalau kita bakal menang, tapi kita harus mencoba yang terbaik. Kita berikan pertandingan yang tak akan pernah bisa dilupakan oleh para penonton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Kita pasti bisa menang, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Aku bisa melihat kalau kalian berdua sudah semangat sekali ya, tapi bagusnya simpan energi kalian dan istirahat yang cukup malam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Kita juga bakal bisa lihat pakaian baru Ayaka waktu kita bangun esok. Ayaka pakai baju Fontaine ... Oh, Paimon sudah enggak sabar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ah, iya. Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Aku juga sudah tidak sabar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "Hah, Pengembara ... kamu juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Hehe, sepertinya tidak ada jalan lain, Nona Ayaka. Kalau besok tidak sibuk, aku juga akan datang untuk melihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Ah, kalau begitu sudah diputuskan ya. Aku akan tunggu kamu besok pagi di Kediaman Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Kamu mau aku jemput besok pagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Pasti bakal jadi pertandingan yang seru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
