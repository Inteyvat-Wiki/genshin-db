			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "Hei lihat, Nona Kamisato dan Pengembara sudah tiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Walaupun aku sudah lihat ilustrasi pakaian ini sebelumnya, tapi melihat Nona Kamisato memakainya benar-benar jadi lebih unik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Tidak sia-sia aku antri dari pagi-pagi sekali supaya dapat kursi di barisan depan. Aku benar-benar menantikan pertandingan hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Wow, Ayaka benar-benar jadi pusat perhatian waktu dia muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Tuan-tuan dan nona-nona, mohon perhatiannya. Pertandingan ekshibisi Jiwa Pejuang akan segera dimulai. Silakan memasuki arena secara beraturan dan silakan duduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "Nona Kamisato, Pengembara, tolong ikut aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "Sudah siap belum, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Boleh, ayo jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Bagus. Ayo lakukan yang terbaik. Aku menantikan saat-saat untuk bertempur di sisimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Aku masih butuh waktu untuk siap-siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "Oh, jangan khawatir, masih ada waktu kok. Saat kamu sudah siap, kita bisa masuk ke arena bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Ayaka, sebelah sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Tadi itu pertandingan yang luar biasa sekali. Aku tidak tahu banyak soal ilmu pedang, tapi aku sendiri saja bahkan sampai terbawa oleh atmosfer di arena. Sampai sekarang aku masih berdebar-debar loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Jurus lawanmu itu bikin Paimon kaget terus, tapi kayaknya kalian berdua sudah siap ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "Pengembara, Nona Kamisato, selamat atas kemenangannya di pertandingan ekshibisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Hei, itu Sara. Kamu datang buat nonton kompetisinya juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Aku diperintahkan oleh Yang Mulia Shogun untuk memantau kompetisinya. Kalian berdua menunjukkan kerja sama dan ilmu pedang yang luar biasa. Tidak hanya menampilkan keindahan ilmu pedang pada para penonton, tapi aku juga jadi bisa belajar sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Aku tersanjung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Kalian semua sudah sibuk dengan berbagai persiapan kompetisi. Hari ini menandakan akhir yang sempurna pada acara Jiwa Pejuang ini. Jerih payahmu sudah diakui oleh Yang Mulia Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Aku harus kembali ke Tenshukaku dan melaporkan apa yang terjadi di pertandingan ekshibisi ini pada Yang Mulia Shogun. Semuanya, aku undur diri dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Ngomong-ngomong, kalian semua sudah ada rencana apa sekarang? Kalau tidak ada, ayo pergi ke Uyuu Restaurant buat makan-makan kemenangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "Ide bagus! Kita sudah terlalu fokus sama kompetisinya belakangan ini, jadi sudah lama kita enggak makan enak! Ayo jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Fyuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Ada apa, Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Oh, tidak apa-apa. Efek dari kemenangan ini sepertinya baru kurasakan sekarang. Kujou Sara bilang dia belajar juga dari pertandingan ini, dan aku juga merasa demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Walaupun penonton tidak menyadarinya, tapi banyak sekali momen di mana aku bisa celaka kalau bukan karena adanya dirimu di sisiku yang menepis serangan musuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Tanpa dirimu, mustahil bagiku untuk menang dengan kekuatanku sendiri. Sesuai dugaanku, ilmu pedangku masih jauh dibanding dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Ayaka, kamu juga beberapa kali membantuku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Benarkah? Mendengarmu bilang begitu malah membuatku jadi ingin latihan tanding denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Sebenarnya, sudah lama aku mengharapkan kesempatan untuk latih tanding denganmu sejak pertama kali kita bertemu. Dan harapan itu sudah setengahnya terwujud pada pertandingan ekshibisi hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Lain kali, kita akan cari kesempatan untuk latih tanding beberapa ronde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Tentu. Tapi ... tolong rawat pedangmu baik-baik sampai saat itu tiba. Jika suatu hari nanti pedang itu jatuh ke tanganku, maka hidupmu juga jadi milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Hehe ... Aku selalu ingin mengucapkan kalimat seperti itu. Aneh tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Mirip sama Nona Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Woi, nungguin apa lagi sih? Ngomongin apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "Kami cuma sedang berandai-andai kalau ada kesempatan untuk bertanding, supaya ketahuan siapa pendekar pedang yang lebih hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Woah, kalau urusan pedang-pedangan, kamu jadi serius banget ya. Tapi si {NICKNAME} itu temanmu, kan? Ngapain musti bertanding segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "Justru karena kami teman, maka kami harus sering-sering berlatih tanding biar bisa saling belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Oh. Iya juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "Pengembara, yang barusan rahasia kita berdua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Ha? Ayaka ngomong apa barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Bukan apa-apa kok. Jalan yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Kamu imut banget sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Ayaka terlalu merendah ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
