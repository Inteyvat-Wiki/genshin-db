			"dialogs": [
				{
					"id": 80200201,
					"content": "Dain ... WOOOI, DAIN! Kenapa malah bengong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200202,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "Ada apa, Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "Orang hilang ... bisa tolong beri tahu aku seperti apa orangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "Ah, eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "Cowok muda, usia awal dua puluhan ... Dain, ada apa sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "Tiba-tiba muncul ingatan di kepalaku ... yang tadinya tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "Ingatan tentang ... dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "Hah? Mungkin ... mungkin kita kebanyakan ngobrolin soal dia kemarin, dan jadi kebawa mimpi gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "Bukan, itu bukan mimpi. Ingatan ... ingatan yang tiba-tiba muncul di kepalaku setelah bangun tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "Dan aku yakin belum pernah ketemu dia sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "Baiklah. Jadi apa yang kamu \"ingat\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Aku ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "Memberikan mata Field Tiller pertama ke dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "APAAAAAA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "Oke, berarti orang ini ada hubungannya sama Abyss Order. Pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "Betul. Dan sepertinya dia bisa \"menanamkan\" ingatan ke dalam benak orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "Gimana caranya coba ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Eh, berarti ... ingatan warga desa soal dirinya ... jangan-jangan palsu semua? Mungkin mereka aslinya sama sekali enggak kenal dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "Tapi kenapa dia lakuin ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "Apa pun rencana Abyss Order, pagi ini kita dapat satu kebenaran penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "Tujuan mereka ... masih tetap mendapatkan mata Field Tiller pertama. Mereka belum menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "Dan akulah satu-satunya orang yang tahu di mana lokasinya. Mungkin \"ingatan\" baru itu adalah salah satu cara mereka untuk mengacaukan pikiranku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "Tapi matanya masih aman, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "Wajar kalau kamu khawatir. Tapi aku rasa Abyss Order masih belum bisa mengubah realita dengan cara seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "Namun mengingat mereka begitu fokus berusaha demi mendapatkan mata ini, aku kira kita juga harus meningkatkan kewaspadaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "Ikut aku. Kita cek langsung apakah matanya masih aman atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "Kami mau dibawa ke tempat kamu ngumpetin matanya nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(Gimana kalau kita diikuti? Kalau langsung ke sana, dan benar ada yang membuntuti, itu kan sama saja kita ngasih tahu mereka lokasinya!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Mungkin itu alasan Abyss Order memberi Dain ingatan itu ... supaya dia menunjukkan jalan ke mata!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(Tapi kali ini objeknya Dain, dan aku yakin dia juga sudah memikirkan kemungkinan ini ... mungkin malah sudah punya rencana penanggulangan juga.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "Dain di depan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "Gimana kalau ternyata \"ingatan\" itu sungguhan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
