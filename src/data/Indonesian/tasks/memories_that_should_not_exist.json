			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Sesuai dugaan. Ingatan palsu itu jebakan, Abyss Order cuma ingin kita menuntun mereka kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Karena mereka sudah di sini, kita punya peluang untuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Argh ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain! Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Terasa tidak? Ada gangguan aliran Ley Line ... pasti ulah Abyss Order ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Wah, kamu sensitif banget ya sama yang gituan. Paimon sih enggak kerasa apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "Kalian berdua, dengarkan ... pakai mekanisme di sebelah sana dan tinggalkan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Tinggalkan kamu sendirian? Yakin aman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "Abyss Order sudah bergerak. Kalau kalian kembali ke Desa Vimara sekarang, aku rasa orang yang hilang itu akan bisa ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "Anggap saja kita ... menyerang dari dua arah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain benar ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Tapi rasanya ada yang salah di sini. Apa ya ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Hmph ... aku tahu sengaja masuk jebakan adalah satu-satunya cara untuk bertemu muka denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Kamu mempertaruhkan keselamatan diri, dan mata itu ....",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "Nyalimu luar biasa, Dainsleif. Dan sekarang kurasa akulah yang masuk ke dalam perangkap sang Twilight Sword.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "Jadi kamu ke sini sendirian? Mana anak buahmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Ketika Twilight Sword hendak maju berperang, bala tentara yang kuutus di depan hanya akan berbaris ke gerbang maut. Lebih baik aku sendiri saja yang maju.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Aku tahu banyak yang perlu dibicarakan ....",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "Tapi jika ingin berbincang, coba kalahkan aku terlebih dahulu.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
