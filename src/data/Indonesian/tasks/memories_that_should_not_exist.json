					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "Waspadalah. Aku merasakan keberadaan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
				},
				{
