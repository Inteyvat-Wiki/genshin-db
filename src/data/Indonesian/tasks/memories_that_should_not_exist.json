						],
						"pointId": 330400551
					}
				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Kalian kembali ke Desa Vimara untuk mengorek lebih banyak informasi. Pertanyaan demi pertanyaan dilontarkan kepada penduduk desa, hingga hari pun berganti malam ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "Ah, jadi kalian ke Desa Vimara untuk menjalankan misi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "\"Seseorang yang hanya ada di dalam ingatan dan kenangan orang lain\" ... menarik sekali. Aku setuju kalau ini bukan kasus orang hilang biasa. Tapi, kaitannya dengan Abyss Order masih belum jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Petunjuk yang sudah kita pegang cuma perihal Hilichurl yang jadi lebih aktif, dan itu saja belum cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Baiklah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "Betul! Suara misterius yang dia dengar waktu ada di dalam ingatan saudaranya ... yang mengaku sebagai \"Pendosa\" ... itu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, izinkan aku bertanya ... Apa kamu percaya kalau saudaramu mengkhianatimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "Aku inginnya sih percaya sama dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Hmm ... kamu terdengar ragu. Berarti kamu masih belum paham apa yang sebenarnya terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Masih ada harapan untuk rekonsiliasi. Hubungan kalian belum masuk ke tahap tidak bisa damai kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "\"Pendosa\" yang kalian tanyakan ... itu lain cerita. Dia dan rekan-rekannya telah mengkhianati aku. Mengkhianati bangsa mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Namanya ... Vedrfolnir \"The Visionary\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "Aku malu mengakui ini, tapi dia dan aku ... sedarah. Dia kakakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Kakak ... mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Apa yang terjadi di antara kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Ada lima orang ... lima Pendosa dari Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "Hroptatyr \"The Wise\", Vedrfolnir \"The Visionary\", Rhinedottir \"Gold\", Surtalogi \"The Foul\", dan Rerir \"Rächer of Solnari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Tak peduli separah apa ingatanku terkikis, aku tidak akan pernah melupakan nama-nama ini ... dan suatu hari nanti, aku akan membalas dendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "Tunggu! Kok kayaknya ada nama-nama yang enggak asing .... Rhinedottir itu kan yang nyiptain si Albedo, Surtalogi itu gurunya Skirk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Terus yang barusan siapa ... Kakaknya Dain, Vedrfolnir ... kalau suara Pendosa itu dia, berarti yang nyuruh si Chlothar bikin Abyss Order ... dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Ternyata semuanya berhubungan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(Kalau ini benar, berarti tablet batu yang di reruntuhan Fontaine ... yang isinya ramalan tentang bencana Fontaine ... itu juga hasil karya Vedrfolnir.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Mereka tadinya orang-orang yang sangat dihormati di Khaenri'ah. Sosok yang mengemban harapan bangsa. Yang terbaik, yang paling ahli di bidangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Kami berenam ... adalah pihak yang seharusnya mencegah bencana terjadi. Yang harusnya bisa menghentikan Vinster King menggoyahkan asas-asas dasar dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Namun di balik semua itu, mereka berlima mendambakan sesuatu yang lebih. Mereka tidak kuasa menahan godaan Abyss, dan bersama-sama membagi kekuatan yang bisa menghancurkan dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Oleh sebab itu mereka disebut Pendosa, namun mereka juga keberadaan yang melampaui pemahaman manusia. Masing-masing memegang kekuatan yang dapat meremukkan dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Ketika bencana besar terjadi, tidak satu pun dari mereka yang bangkit membela bangsanya. Tidak ada satu pun yang berusaha mencegahnya ... tiada maaf bagi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "Setelah itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "Ya. Kalau mereka tidak dihentikan, suatu hari nanti yang akan mereka khianati adalah dunia ini dan seluruh isinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Pasti sulit sekali membicarakan hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "Santai. Aku memang tidak bermaksud menyembunyikan apa pun darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Dain, jadi selama ini kamu nyelidikin apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "Aku lanjut menyelidiki Roda Takdir. Sudah agak lama semenjak pergerakan awalnya dieksekusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "Setelah mengamankan mata Field Tiller pertama, kita berhasil menghentikan langkah mereka sebelum membuahkan hasil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Paimon ingat! Mereka mau pakai itu buat si Osial kan, terus mau bikin dewa baru atau apa gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "Betul. Namun sangat jelas terlihat kalau itu cuma uji coba teknis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "Mata itu adalah pion vital dalam rencana, tapi mereka yang gagal mendapatkannya entah bagaimana bisa melewati tahap uji coba dan lanjut ke tahap berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Ada banyak tanda-tanda yang mengarah ke sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "Jadi gimana ini? Jangan-jangan sudah telat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "Yang sangat mendesak adalah ... kita harus segera tahu apa gunanya Roda Takdir itu. Setelahnya, baru kita bisa menebak apa tujuan sebenarnya Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Menurut info yang sudah kudapat selama ini, Roda Takdir itu ada hubungannya dengan Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Ley Line?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, tempo hari kamu bisa melihat ingatan saudaramu, betul? Aku yakin itu akibat aliran Ley Line di sana sedang tidak stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Penyelidikanku baru-baru ini menunjukkan bahwa di setiap area tempat Abyss Order aktif, Ley Line di sana menjadi bermasalah setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Dan salah satu dari sekian banyak hal yang mengalir bersama Ley Line ... adalah ingatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Tunggu, misi di Desa Vimara ... sosok yang cuma ada di dalam ingatan orang ... ini ada hubungannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Ingatan ... Ley Line ... Roda Takdir ... orang hilang yang sepertinya memang tidak pernah ada ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Di mana benang merahnya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Ada kemungkinan. Besok pagi aku akan ikut penyelidikan kalian. Kasus orang hilang ini bisa jadi kunci untuk memecahkan semua misteri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Kalau kita mau kerja bareng Dain lagi, jelas harus punya cukup tenaga! Besok kita ke tempat yang agak jauhan yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*hoam* Ampun, ngantuk banget ... kemarin Paimon kebanyakan mikir ... semua salah si Dain, pakai ngomong yang ribet-ribet segala ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Aku juga bobonya enggak nyenyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Sudahlah, kita ke si Dain sekarang. Hari ini bakal sibuk dah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Pusing 'pala Fungus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Terima kasih karena sudah mau cerita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "Saudaraku bertemu saudaramu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "Sebenarnya apa yang terjadi di Khaenri'ah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "Yah, bisa dibilang begitu kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "Sekarang gantian kamu tepati janji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
