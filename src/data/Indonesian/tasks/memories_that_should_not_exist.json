			"dialogs": [
				{
					"id": 80200101,
					"content": "Eh, sebentar ... orang itu ... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Ah, kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "Temanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Baiklah kalau begitu, aku pulang duluan deh. Sekalian lihat kondisi Pak Kepala dan yang lainnya juga. Sampai nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Ya, sampai ketemu lagi Atossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Kenapa sih kamu hobi banget muncul tiba-tiba? Jangan-jangan kamu memang sengaja ya mau bikin kami jantungan setiap kali ketemu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Tidak kok. Tidak ada maksud, tidak ada alasan pribadi juga. Kita sama-sama mengejar Abyss Order, tentunya jalan kita cepat lambat pasti bersilangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Ah, kamu lagi nyelidikin Abyss Order ya. Pantesan tadi berantem sama monster ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Tentunya. Ah, kalian bukannya kemari untuk tujuan yang sama ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Kami memang mengikuti Abyss Order ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "Hm, sama saja. Mungkin agak terlambat, tapi aku yakin kalian juga sudah menyadari bahwa ... ada yang aneh dengan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "Abyss Order hampir pasti sedang merencanakan sesuatu di sini. Atau lebih buruknya, mereka sudah menjalankan rencananya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Jadi menurutmu Abyss Order yang menyebabkan Hilichurl di sekitaran sini jadi lebih aktif?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Kalau lihat keadaan, aku ragu itu motif utamanya. Hilichurl yang agresif hanya sekadar efek samping saja dari apa pun itu yang sedang mereka coba lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Tapi efek samping ini bisa jadi masalah bagi warga lokal. Apa enggak mending kita diam dulu di sini buat sementara, jagain desanya gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "Cara terbaik untuk melindungi warga adalah dengan mencari tahu apa tujuan sebenarnya Abyss Order di sini. Supaya tidak terjadi tragedi lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Ya sudah, kita tanyain warga lagi yuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Apa yang harus dijelaskan, akan dijelaskan. Aku tidak berniat menyembunyikan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Jangan khawatir ... akan ada banyak waktu untuk berbicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Lalu kamu juga ... berutang banyak penjelasan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Tapi kejadian kali ini enggak sengaja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
