			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "Wah, benar-benar pertarungan yang sengit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141502,
					"content": "Rasakan! Ini akibatnya kalau berani meremehkanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141503,
					"content": "Mona benar-benar hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "Tentu saja! Paimon, kamu juga merasa kalau aku hebat kan? Iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141505,
					"content": "Tentu saja! Kalau tidak ada Mona, kita pasti sudah kewalahan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141506,
					"content": "Heh, dengar tidak?! Dasar Fatui Harbinger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141507,
					"content": "Tapi... kalau melihat ekspresinya yang sangat terkejut, sepertinya dia tidak berbohong. Guruku pernah mengajarkanku sesuatu yang disebut \"langit palsu\". Apakah ada hubungannya dengan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141508,
					"content": "Ah... *ehem* Aku jadi bicara yang tidak-tidak. Ayo kita selesaikan misi penting kita ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>Inti meteorit</color> yang kita cari pasti ada di dekat sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111416",
							"2"
						],
						"stepId": 4111416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "Wow, ini pasti inti meteorit itu. Kelihatannya berbeda dengan meteorit lainnya! Terlihat lebih... bersinar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141602,
					"content": "Batu ini mengandung kekuatan elemental dan hasrat manusia yang kuat. Memang inilah inti yang kita cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141603,
					"content": "Haruskah... kita hancurkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Hmmm, kalau dia tidak disingkirkan, para korban tidak akan bangun dari tidurnya... Inti meteorit ini adalah sumber dari semua masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141605,
					"content": "#Yang semangat ya, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141606,
					"content": "Wow, ternyata. Sungguh di luar dugaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141607,
					"content": "Orang yang mendaki gunung itu, berusaha mencapai puncak gunung yang tak dikenal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "Siapa yang menyangka kalau keinginan seorang manusia dapat bertahan selama ribuan tahun di angkasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141610,
					"content": "Ternyata ilmu astrologi memang benar-benar hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141611,
					"content": "Kenapa tiba-tiba kamu berkata seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141612,
					"content": "Kemampuan untuk berkomunikasi dengan bintang akan membantu kamu menguak misteri dalam persejarahan manusia. Tapi tentu saja, selain aku, tidak banyak astrolog lain yang bisa melakukan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141613,
					"content": "Mona, terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "Eh... kenapa bicaramu tiba-tiba jadi serius begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141615,
					"content": "Oh iya, kalau soal cara bicara, aku jadi teringat dengan Fischl. Gadis itu benar-benar ajaib...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141616,
					"content": "Paimon juga merasa begitu! Dia itu sangat... sangat apa ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141617,
					"content": "Sangat penuh dengan ide aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "Yah, meskipun begitu, kalau dipikir-pikir sepertinya omongan dia ada benarnya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141620,
					"content": "Jangan-jangan dia itu tipe orang yang menggunakan cara yang salah, tapi mendapatkan jawaban yang benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141621,
					"content": "Mungkin saja seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141622,
					"content": "Tapi Paimon masih tidak habis pikir, Pilos Peak yang sangat tinggi itu bisa berubah menjadi pulau sekecil ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141623,
					"content": "Puncak gunung yang tinggi itu telah berubah menjadi pulau kecil. Sekarang orang-orang Mondstadt sudah bisa mencapai tempat itu dengan menggunakan perahu bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141624,
					"content": "Dengan kata lain, sekarang semua orang bisa mendaki Pilos Peak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141625,
					"content": "Semua orang bisa mencapai puncaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "Apakah menurutmu Leonard akan puas? Meskipun tenggelamnya Pilos Peak adalah sebuah kecelakaan, tetapi sekarang orang-orang Mondstadt sudah bisa terbang dengan bantuan kekuatan Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141627,
					"content": "Kalau semua bisa terbang, berarti mereka bisa mencapai puncak yang lebih tinggi lagi, menjelajahi tempat-tempat yang baru dan masih misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141628,
					"content": "(Leonard, apakah mimpimu sudah terkabulkan?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "Oke, kita sudah membereskan inti meteorit itu! Para korban yang tertidur seharusnya sudah mulai terbangun kan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141630,
					"content": "Berarti kita juga telah menyelesaikan misi dari Adventurers' Guild dengan sukses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141631,
					"content": "Ya, kuharap semuanya... segera pulih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "Sangat aneh dengan daya imajinasi tinggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Orang yang gigih itu, meneruskan semangatnya ke masa depan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}