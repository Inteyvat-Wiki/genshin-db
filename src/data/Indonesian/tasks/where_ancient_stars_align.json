						],
						"stepId": 4111414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "Penulisnya Leonard... Leonard... Ini dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140802,
					"content": "Menurut data, buku panduan petualang yang ditulis Leonard ada di <color=#00E1FFFF>lantai satu</color> sisi <color=#00E1FFFF>barat laut</color> perpustakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140803,
					"content": "Barat laut... Seharusnya di situ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
