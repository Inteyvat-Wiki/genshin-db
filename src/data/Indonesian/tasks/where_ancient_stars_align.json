		{
			"id": 4111409,
			"completionStepIds": [
				4111409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111409",
							"2"
						],
						"stepId": 4111409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "Ini dia, Paimon menemukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140902,
					"content": "Coba kulihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140903,
					"content": "Isinya sudah berantakan, tidak bisa dimengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Heh, sudah kuduga akan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140905,
					"content": "Seorang astrolog biasa pasti akan menyerah begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140906,
					"content": "Tapi aku adalah Mona, orang yang akan menjadi astrolog paling hebat sedunia. Tidak ada hal yang bisa menghalangiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140907,
					"content": "Aku tinggal menggunakan astrolab ini untuk memperkirakan bagian yang hilang, lalu ditafsirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140908,
					"content": "*fuhh* Akhirnya selesai juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140909,
					"content": "Jadi, apa isinya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140910,
					"content": "Seperti perkiraanku, Leonard adalah petualang yang hidup 2.000 tahun lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140911,
					"content": "Cita-cita hidupnya adalah untuk mendaki gunung salju Pilos Peak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140912,
					"content": "2.000 tahun? Jadi batu-batu meteorit ini adalah... konstelasi milik orang zaman dahulu kala?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140913,
					"content": "Entah karena alasan apa, konstelasi miliknya tiba-tiba dipanggil datang ke dunia ini. Menurutku ini ada hubungannya dengan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140914,
					"content": "Paimon setuju, setiap kali ada kejadian aneh, pasti ada anggota Fatui yang terlibat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140915,
					"content": "Setiap meteorit ini mengandung kekuatan elemental yang memancarkan sejenis bentuk hipnotis ke orang-orang di sekitar. Inilah yang menyebabkan orang menjadi tertidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140916,
					"content": "Selain itu, jika tebakanku benar, seharusnya di antara meteorit-meteorit ini ada sebuah inti meteorit yang merupakan kristalisasi dari jiwa Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140917,
					"content": "Di mana inti itu berada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Kalau aku menjadi Leonard, aku pasti ingin inti meteorit ini mendarat di puncak gunung salju yang tidak pernah bisa kudaki itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140919,
					"content": "Jadi inti itu ada di puncak Pilos Peak? Tapi Pilos Peak itu di mana? Paimon tidak pernah mendengar nama tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140920,
					"content": "Aku juga pertama kali mendengar nama itu. Kalau dilihat dari perbandingan peta zaman dulu dengan sekarang, sepertinya Pilos Peak ini sudah tidak ada lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140921,
					"content": "Masa puncak gunung setinggi itu bisa hilang sih?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140922,
					"content": "Dulu aku pernah membaca kalau Archon Anemo, Barbatos, menggunakan kekuatannya untuk meniup bersih es dan salju. Seluruh bentuk geografi Mondstadt pun berubah karena hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140923,
					"content": "Gunung yang ada di zaman itu sudah berubah menjadi sebuah lautan samudra. Tetapi gunung setinggi itu, pasti tetap meninggalkan jejak di laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140924,
					"content": "——Puncak gunung itu masih dapat dilihat dari permukaan air. Tempat yang dulu dikenal sebagai Pilos Peak, sekarang dikenal sebagai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>Musk Reef</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Balladeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "Oh? Ternyata ini yang dulunya dinamakan Pilos Peak? Sekarang jadi kecil sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141102,
					"content": "Wah, ada orang yang mendahului kita. Apakah ini tempat wisata yang populer... atau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141103,
					"content": "Ah! Ternyata kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141104,
					"content": "Uh... Eh? Kalian lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141105,
					"content": "Bagaimana kalian bisa ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Melihat penampilan dia... Sepertinya dia baru saja bangun dari mimpi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141108,
					"content": "Bagaimana bisa... ada orang yang bangun dengan kekuatannya sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141109,
					"content": "Heh! Kalau kalian tidak bisa melakukannya, bukan berarti aku juga tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141110,
					"content": "Kalian hanya terlambat satu langkah dariku. Aku telah berhasil menyelesaikan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141111,
					"content": "Sudah Paimon duga! Semua ini hanya tipu muslihat Fatui kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141112,
					"content": "Tidak perlu tegang begitu, hari ini aku tidak sempat menemani kalian bermain. Lain kali masih ada kesempatan untuk menghadapi kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141113,
					"content": "Tunggu! Apa tujuan kalian sebenarnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Kamu juga memimpikan hal yang sama dengan orang lain itu kan? Mimpi tentang gunung bersalju itu? Berapa banyak yang kamu tahu tentang Leonard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141115,
					"content": "Leonard? Siapa itu Leonard? Huh, aku masih ada urusan yang lebih penting untuk diurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141116,
					"content": "Aku telah menyadari suatu hal... yang lebih mengerikan dan lebih krusial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141117,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141118,
					"content": "Hal apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "Bintang-bintang di langit, bahkan langit itu sendiri... Semuanya hanya sebuah kebohongan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141120,
					"content": "Bintang di langit adalah sebuah kebohongan? Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141121,
					"content": "Kamu mengejek prinsip astrologi Mona? Kalau memang iya, sepertinya kamu perlu argumen yang lebih meyakinkan dari \"Bintang dan langit adalah sebuah kebohongan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141122,
					"content": "Siapa yang akan percaya? Kan kita tinggal menengadah ke atas langit di malam hari untuk melihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141123,
					"content": "Hah... hahahahaha! Aduh, kamu polos sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141124,
					"content": "Tetapi kamu memang tidak salah. Karena aku sendiri pun masih berpikir seperti itu... hingga kejadian barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141125,
					"content": "Hingga kejadian barusan? Maksudmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141126,
					"content": "Huh, aku tidak punya waktu untuk menjelaskannya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141127,
					"content": "Jester sialan... Bisa-bisanya dia memberikan tugas macam ini dan tidak memperingatkanku. Huh, apa dia sengaja ingin menakuti-nakutiku!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141128,
					"content": "Sekarang saatnya aku memastikan \"kebenaran\" itu. Selamat tinggal, para pecundang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Balladeer"
				},
				{
					"id": 411141106,
					"content": "Apakah kamu baru terbangun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
		{
			"id": 4111414,
			"completionStepIds": [
				4111405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
