			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "Eh? Apakah Fischl sedang menunggu kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140102,
					"content": "Waktunya telah tiba. Meskipun mein Fräulein enggan, tetapi sudah tiba saatnya untuk memberi tahu hal ini kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140103,
					"content": "Telah tiba saatnya bagi kita untuk berpisah, wahai rekan-rekan seperjalananku. Meski kita telah menghadapi berbagai rintangan, kalian telah menunjukkan keberanian yang tiada banding. Aku dapat merasakan angin yang berembus... berembus untuk menghormatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140104,
					"content": "Hei, hei, hei! Mengapa tiba-tiba begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140105,
					"content": "Fischl, kamu sudah mau pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "Meteorit-meteorit raksasa ini membuat orang-orang tertidur, bahkan terhadap prajurit-prajurit yang terkuat. Sekarang semua tempat sedang membutuhkan bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140107,
					"content": "Mein Fräulein dan diriku berencana untuk menggantikan para prajurit itu untuk menjaga para korban. Kami harus memercayakan sisanya kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}... Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140109,
					"content": "Kamu adalah seorang pendengar yang baik, aku senang berbicara denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140110,
					"content": "Sejujurnya, orang-orang di Adventurers' Guild hanya mau berbicara denganku saat mereka membutuhkanku menjelaskan laporan penyelidikan dari Oz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140111,
					"content": "Aku benar-benar menikmati perjalanan pendek kita bersama. Aku minta maaf harus berakhir tiba-tiba begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140112,
					"content": "Heee? Caramu berbicara sepertinya sedikit berbeda dari biasanya...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140113,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140114,
					"content": "(Ah! Gawat! Tidak sengaja keceplosan...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140115,
					"content": "Ma-maksud mein Fräulein... Dengan keberanian dan kepandaian yang tiada duanya, kalian pasti dapat menyelesaikan tugas apa pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140116,
					"content": "Uh... bahkan sekarang \"terjemahan\" dari Oz juga terdengar aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140117,
					"content": "*uhuk uhuk* Mein Fräulein hanya ingin mengatakan bahwa dia percaya bahwa kalian pasti akan menemukan kebenaran di balik semua misteri ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140118,
					"content": "*uhuk* Tepat sekali. Kalian adalah pelayanku yang setia. Para Ritter der Verurteilung, bawa mereka keluar dari kegelapan dan kembali ke sumber cahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140119,
					"content": "Siapa yang kamu sebut pelayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140120,
					"content": "Oz, Fischl, terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "Kita akan bertemu lagi. Mari kita berkumpul bersama lagi saat semua ini telah berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140122,
					"content": "Ah, sayang sekali dua orang itu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140123,
					"content": "Tetapi kita tidak boleh murung. Aku punya kabar baik, aku telah menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140124,
					"content": "Aku mengikis batu meteorit itu dan menggunakan bubuknya untuk meramal, ternyata hasilnya sangat efektif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140125,
					"content": "Batu-batu ini sudah berumur ratusan, bahkan ribuan tahun. Sepertinya Leonard adalah orang yang hidup di zaman dahulu kala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140126,
					"content": "Kemudian batu-batu meteorit ini sepertinya menyampaikan keinginan hatinya. Keinginan hatinya yang tidak pernah memudar setelah ribuan tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140127,
					"content": "Seseorang dari zaman dahulu kala dengan semangat membara untuk mendaki gunung... Aku berani bertaruh kalau dia adalah seorang petualang juga, sama sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140128,
					"content": "Seorang petualang? Jelas saja dia ingin mendaki gunung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140129,
					"content": "Sepertinya gerakan kita masih terlalu lambat, saat ini kita sedang berlomba dengan waktu. Kita harus mengubah strategi kita dan menyelesaikan masalah ini langsung dari akarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140130,
					"content": "Setuju! Paimon rasa sekarang kita harus fokus pada Leonard ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140131,
					"content": "Ya... kalau meteorit ini benar-benar membawa keinginan Leonard, nampaknya apa yang dikatakan Fischl memang benar, keinginan itu telah menjadi suatu bentuk \"kutukan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140132,
					"content": "Heh, jarang-jarang dia benar... *ehem* Sudah cukup, seorang astrolog hebat tidak boleh menghakimi orang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140133,
					"content": "Singkat kata, sekarang kita hanya perlu menghilangkan kutukan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140134,
					"content": "Ayo berangkat, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140136,
					"content": "Kalau mau mencari informasi tentang petualang, tentunya harus mulai dari <color=#00E1FFFF>Adventurers' Guild </color>dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111407,
			"completionStepIds": [
				4111407
			],
