			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "Ada banyak petualang yang bernama seperti ini, aku juga tidak tahu siapa sebenarnya yang kalian cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140702,
					"content": "Tapi aku teringat bahwa aku sempat membaca buku seseorang dengan nama penulis seperti ini. Bagaimana kalau kalian mencoba mencarinya di perpustakaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140703,
					"content": "Tapi seingatku ada sebuah buku yang ditulis oleh Leonard, mungkin sebaiknya kalian coba mencari ke <color=#00E1FFFF>Perpustakaan</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111414",
