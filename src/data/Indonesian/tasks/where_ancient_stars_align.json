							"4111405",
							"2"
						],
						"stepId": 4111405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "Ketemu! Buku Panduan Petualang \"Tentang Gunung dan Laut\" yang ditulis oleh Leonard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141402,
					"content": "Tapi... banyak halaman yang sudah hilang, Paimon tidak mengerti isinya sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141403,
					"content": "Ah, masa sia-sia saja kita datang ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141404,
					"content": "Jangan menyerah, coba berikan ke Mona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "Ah, benar juga. Mungkin dia bisa memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111415",
