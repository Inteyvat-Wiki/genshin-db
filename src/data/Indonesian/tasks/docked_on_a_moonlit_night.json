				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080202,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "Gimana? Du-Duh, kok diam saja sih? Paimon jadi tegang nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Mmm ... pahit manis rasa dalam kenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080205,
					"content": "Maksudmu rasanya berubah dari orang miskin jadi orang kaya? Rasa macam apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Hehe. Asam, dan sedikit manis. Lalu rasanya pun bertahan lama di lidah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080207,
					"content": "Menarik ... Apa rasanya mirip dengan, buka toko lalu sadar bahwa dagang buah ternyata tidak laku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "Tidak usah dibahas sampai sedetail itu. Masa lalu biarlah berlalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080209,
					"content": "Haha, mana ada yang tahu kalau sang Tianquan yang mulia ini tadinya cuma tukang buah di pinggir jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "Sama halnya dengan aku, pasti tidak banyak kan yang menyangka kalau aku ini aslinya anak desa nelayan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "Tidak juga ah. Kalau menurutku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080212,
					"content": "Kapten Beidou punya mata yang seakan menembus dalamnya lautan. Kamu seorang yang suka bertualang, yang sehari-harinya menjinakkan angin dan menundukkan ombak ... Jelas menunjukkan bahwa kamu tumbuh besar di dekat lautan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080213,
					"content": "Heh, lagi menyindir ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Jangan aneh-aneh, untuk apa juga aku harus menyindir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080215,
					"content": "Aku tahu mulutmu itu tajam sekali. Hari ini aku yang traktir, jadi jangan keterlaluan yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Bailah kalau begitu. Aku mau pesan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080217,
					"content": "Satu lagi untuk nona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "Anda pesan, kami buatkan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "Bartender, kamu dengar kata nona ini kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "Aku suka ini! Aku juga tambah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "Kamu segera membuatkan minuman tambahan lagi untuk kedua tamu ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "Jus buah Mondstadt begitu segar. Tidak ada tandingannya. Kalau saja aku bisa menikmatinya setiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080222,
					"content": "Hah? Jangan-jangan kamu mau buka jalur dagang buah Sunsettia lagi sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "Hmm, idemu bagus juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080224,
					"content": "Kamu serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "Tentu saja tidak. Sudah ada industri yang bergerak di bidang itu. Aku tidak perlu terjun ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080226,
					"content": "#Terima kasih minumannya, {NICKNAME}. Kalau kamu ingin kerja yang enak dan santai, aku siap menggajimu sebagai bartender pribadiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080227,
					"content": "Kamu juga akan sangat disambut di Alcor! Awak kapalku sangat doyan minum, kamu boleh datang dan bersenang-senang dengan kami. Aku jamin, kamu pasti suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "Eh, eh, Kapten Beidou, kamu mau rebutan tenaga kerja denganku? Tidak ada untungnya. Kamu bisa datang ke Jade Chamber kalau ingin minuman racikan Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080229,
					"content": "(Gila, aku beken amat!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "Ini cuma perasaan Paimon, atau mereka memang ngomong kayak kamu sudah jadi punyanya mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "Kalau ada kesempatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "Aku akan mengunjungi kalian. Janji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}