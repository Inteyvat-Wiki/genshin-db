			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#YO, {NICKNAME}! Pas banget. Mau gabung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "Pengembara. Kejutan yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "Kenapa kalian berdua ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Eh, kalian datang berdua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Nona besar satu ini tiba-tiba saja ingin liburan. Jadi kami main ke sini deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Tapi ternyata bayangan kami soal \"liburan\" saja sudah beda. Padahal naik gunung saja belum, eh tahu-tahu sudah sampai sini lagi saja ongkang-ongkang kaki. Manja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Ayolah, tidak perlu sampai menyakiti hati orang kan. Lagi pula, aku sengaja pilih tempat ini secara khusus karena tahu kamu doyan minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "Yah, kapten kita yang satu ini memang sudah melihat dunia sih, jadi mungkin kedai kecil seperti kurang berkesan untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "Kata siapa. Sudahlah, sekarang giliran aku yang traktir, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "Beidou mau traktiran? Kami kebagian enggak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "Kan kita bartendernya, Paimon. Astaga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Oh iya yah. Hehe ... maaf, habisnya sudah kebiasaan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "Nah, kedua nona ingin minum apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Pesan Birch Sap kecil ... yang asam yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "Satu gelas Dusk porsi besar. Makasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "Oke, tunggu sebentar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
