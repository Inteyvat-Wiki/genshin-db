					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Ugh ... boleh juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "Sepertinya kamu untung banyak ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "Hai, Pengembara! Berkat kamu, aku bisa untung lumayan banyak kali ini, sepertinya \"Masakan Emas\" memang bermanfaat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Tapi, untungnya tidak beda jauh dengan perdagangan biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Harus efek dari \"Masakan Emas\" bukan cuma seperti ini deh. Apa jangan-jangan makanan yang kumakan salah ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "Pengembara, kita coba sekali lagi. Tolong kamu pilihkan \"Masakan Emas\" lagi untukku ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Masih sama seperti dulu, pilih saja salah satu antara <color=#00E1FFFF>Mora Meat</color>, <color=#00E1FFFF>Butter Chicken</color>, dan <color=#00E1FFFF>\"Pile 'Em Up\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
