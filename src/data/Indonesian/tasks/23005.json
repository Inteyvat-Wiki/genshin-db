			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "Waktu itu untungnya sedikit, kali ini pasti untung besar. Bagaimana? <color=#00E1FFFF>Mora Meat</color>, <color=#00E1FFFF>Butter Chicken</color>, dan <color=#00E1FFFF>\"Pile 'Em Up\"</color>? Apa sudah dipilih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
