			"dialogs": [
				{
					"id": 230050601,
					"content": "Ini Apple Cider orang kaya itu? Hmm, ada aroma tidak biasa dari dalamnya yang membuat kepala ini jadi segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Baiklah! Kali ini pasti bisa mendatangkan perubahan bagi pasar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Aku tidak akan melupakan bantuan kalian berdua! Sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
