			"dialogs": [
				{
					"id": 210100001,
					"content": "Hmm... Aku harus pikirkan baik-baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100002
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100002,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Oh, bukan masalah besar. Wangshu Inn adalah bangunan tinggi, aku memikirkan berapa banyak waktu yang dibutuhkan untuk menaiki semua tangganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100004
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100004,
					"content": "Aku awalnya ingin langsung mencobanya, tapi tumpukan daun itu sangat mengganggu. Aku ingin membersihkannya dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Tapi, sambil turun tangga sambil menyapu dedaunan, memikirkannya saja sudah membuatku merasa lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100006,
					"content": "Aku coba dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100007
					]
				},
				{
					"id": 210100007,
					"content": "Hahaha. Baiklah. Terima kasih banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dandy"
				}
			]
		},
