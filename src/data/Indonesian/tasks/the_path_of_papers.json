			"dialogs": [
				{
					"id": 731053001,
					"content": "Alrani, kamu harus selamat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Alrani sendiri di Akademiya bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Alrani adalah anak yang rajin, walaupun kadang ... dia sering menemui jalan buntu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Tapi dia seorang murid yang baik, aku juga yakin dia akan menjadi peneliti yang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "Apa memang sesulit itu agar skripsi murid bisa lolos di Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Jujur saja, iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "Tinjauan skripsi itu sangat rumit. Selain harus mempertimbangkan arah penelitian, masih harus mempertimbangkan dari segi referensinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Juga harus memperhatikan jumlah skripsi dengan jenis yang sama supaya topik penelitian tidak sama dengan orang lain. Setelah proposalnya diberikan, kamu masih harus menghadapi masalah lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*huff* Tapi harus kuakui, dia benar-benar tidak beruntung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
