			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Ampun! Jangan berkelahi lagi! Semuanya salah paham!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Kurasa tidak begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Apa yang kalian lakukan pada Nona Alrani? Katakan dengan jujur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Atau ... Atau bakal kami pukul kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "Ja-jangan, jangan! Dengarkan aku dulu. Kalian semua salah paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "Kami mana berani mengganggunya, kami sama sekali tidak boleh berurusan dengannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Ceritanya panjang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Jadi beberapa waktu lalu kami kekurangan uang, lalu aku dan saudaraku ini mau cari uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Pfft, jadi kamu mencuri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "Yah ... Kami kan Treasure Hoarder ... Memang itu yang kami lakukan ....",
