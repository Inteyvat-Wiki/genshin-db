			"dialogs": [
				{
					"id": 731053101,
					"content": "Terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053102,
					"content": "Kenapa kamu begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "\"Baik\" pada Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Jangan salah paham. Aku melakukannya karena tiga alasan. Satu, Alrani membayarku untuk ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "Dua, aku cuma perlu uang, bukan nyawa orang. Kalau aku mengusirnya dan membuangnya ke alam liar, reputasiku bakal rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Ketiga, dia adalah orang berpendidikan yang punya masa depan cerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Mungkin reputasi kami sebagai Treasure Hoarder juga akan membaik kalau membantunya ...? Hmph ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Dia bayar kamu berapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Tidak sedikit. Dia bilang dia dapat uang itu karena berhasil membuat \"pupuk\". Aku tidak tahu itu apa dan tidak peduli juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053110,
					"content": "Yang penting dia sudah bayar, dan kami bakal bantu dia untuk sementara ini. Itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				}
			]
