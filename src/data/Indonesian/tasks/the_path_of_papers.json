				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani, kamu pergi ke mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Kok kayaknya Paimon ingat nama itu ... itu kakak yang selalu rusuh nulis skripsi itu, kan? Yang ketemu sama kita waktu di Pulau Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Oh iya, dia bilang dia meninggalkan Akademiya buat cari bahan skripsi. Harusnya dia sekarang sudah balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Tapi wanita di sana kok kayaknya khawatir banget ... ayo coba kita tanya dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Kalau Alrani benar-benar sudah balik ke Akademiya, kita juga bisa sekalian pergi sapa dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Hai, tentang Alrani ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "Kamu petualang dari Adventurers' Guild?! Apa kamu sudah menemukan Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "Aku tahu aku sudah menanyakan berkali-kali, tapi aku benar-benar khawatir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Wah, tenang, kami bukan suruhan dari Adventurers' Guild, kami cuma orang yang kebetulan lewat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "Anda ini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "Kalian bukan petualang? Maaf, karena tidak ada kabar dari mereka, aku jadi cemas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "Menceritakan hal yang kamu alami dengan Alrani sampai sekarang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "Ternyata Anda adalah Pengembara yang sering disebut Alrani ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "Namaku Niloofar, peneliti dari Akademiya ... kalian pasti juga sudah tahu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Walaupun aku peneliti, sebagian besar fokusku sekarang adalah membimbing para murid dalam penelitiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani adalah salah satu muridku, anak ini selalu kesulitan dalam penulisan skripsinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "Ka-kamu ... mentornya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Nona Alrani bilang dia harus nulis ulang banyak sekali skripsinya karena ditolak mentornya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Ah, ini bukan waktunya bicara soal itu. Apa yang terjadi dengan Nona Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Dia ... hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Beberapa waktu lalu, Alrani dengan semengat membawa sebuah skripsi dari Inazuma, isi skripsinya adalah penelitian tentang budaya masyarakat Pulau Watatsumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "Dia serius sekali saat menulis skripsi itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Iya aku juga tahu. Skripsinya ditulis dengan sangat baik dan dengan standar yang begitu tinggi di setiap aspeknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "Tapi ... dia terlambat dalam menyerahkan skripsinya! Dulu aku pernah menyuruhnya mengirimkan draf awalnya dulu padaku, tapi sampai sekarang aku belum menerimanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "Saat dia membawa skripsi yang sudah selesai, malah sudah ada orang yang mengumpulkan skripsi yang isinya sama persis dengan miliknya dan sudah diterima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "Walaupun aku berusaha sebisa mungkin untuk membantunya, skripsinya... tetap tidak lolos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Loh? Padahal Nona Alrani sudah mulai nulis dari lama loh. Kok bisa lama sekali sih selesainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Tunggu ... Inazuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "Dekrit Sakoku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Kenapa bisa terjadi hal begini segala sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "Aku sama sekali tidak tahu bagaimana memberitahunya ... awalnya aku berpikir untuk memberitahunya dengan lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Tapi tidak tahu siapa yang langsung memberitahukan informasi ini padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Lalu dia pun menghilang, aku sudah mencari ke seluruh Akademiya, tapi tetap tidak ketemu. Jadi aku pergi ke Adventurers' Guild dan pasang komisi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "Tapi mereka cuma menemukan catatan Alrani di sebuah tempat, tidak ada jejak Alrani sama sekali di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "Sekarang, para petualang itu seharusnya masih mencari jejak Alrani ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "A ... Aku sudah tidak tahu lagi harus bagaimana .... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "Aku akan bantu cari Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Iya! Kita bakal mulai dari tempat di mana mereka menemukan catatan Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Benarkah? Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "Aku akan menandai lokasi catatan tersebut di peta Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Oh ya, dan bayarannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "Kita bicarakan ini nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Terima kasih banyak. Aku juga akan tunggu kabar dari Adventurers' Guild di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Alrani, kamu harus selamat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "Aku akan minta dari Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Di mana lokasinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "Kami juga bakal bantu nyari Nona Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Dia benar-benar giat loh dalam menulisnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
