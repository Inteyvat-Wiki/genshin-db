					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "Dia itu ... bandit yang suka teka-teki ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Tidak ada yang tahu. Aku bisa tahu soal ini karena dulu mentorku pernah bertemu dia di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "Pertanyaan Narzam waktu itu adalah: \"Apa yang bisa mengisi sebuah ruangan kosong dengan cepat?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "Angin! Jawaban Paimon benar, kan? Pasti angin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Ugh ... cahaya lilin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Jawaban mentorku adalah: \"Elemen ada di mana-mana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Curang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Hahaha ... intinya Narzam mengantar mentorku pulang ke kota dan mereka berpamitan dengan penuh sopan santun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Kalau dia yang bersama Alrani, aku malah tidak terlalu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Tapi Alrani tidak boleh terus berada di sana, aku harus memikirkan cara untuk membantu menyelesaikan masalah skripsinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "Apa tujuan dia sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
