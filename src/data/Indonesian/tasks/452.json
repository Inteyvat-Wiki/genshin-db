			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "Te, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "Ini bukanlah hal yang sulit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "Jadi, para Hilichurl ini mulai berani bertingkah karena keberadaan kawanan serigala itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "Betul, tapi kurasa jika kamu berpikir Hilichurl itu jahat, serigala jauh lebih parah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "Mereka... menyerang Springvale pagi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Menyerang Springvale?! Keterlaluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "Aku pikir, setelah serigala itu baru selesai menyerang, ini kesempatanku untuk melintas... Tak kusangka malah Hilichurl yang muncul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "Kita harus segera ke sana, dan memantau kondisi di Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "Apakah ada bagian yang rusak? Apakah gerobakmu masih bisa jalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520311,
					"content": "Aku akan memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
