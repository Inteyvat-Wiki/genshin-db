			"dialogs": [
				{
					"id": 4520101,
					"content": "#Ah, Paimon, {NICKNAME}! Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520102,
					"content": "Halo, Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520103,
					"content": "Amber, ada sesuatu yang kami ingin tanyakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Amber, kamu kenal orang aneh di Wolvendom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520105,
					"content": "Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520106,
					"content": "Katanya dia kenal baik denganmu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520107,
					"content": "Kamu sedang bicara apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520108,
					"content": "Aneh... dia bilang akan menunggumu di tempat biasa. Apa kamu sudah lupa, atau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520109,
					"content": "Ingatanku baik-baik saja. Apa jangan-jangan... ingatanmu yang bermasalah, Paimon – karena kamu kebanyakan makan jamur matsutake ajaib?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520110,
					"content": "Aku benar-benar tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520111,
					"content": "Eh... apa ya warna jamur matsutake ajaib yang tidak boleh dimakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520112,
					"content": "Ungu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520113,
					"content": "...sepertinya benar, Paimon tidak sengaja memakannya beberapa hari lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520114,
					"content": "Tapi bukan itu intinya! Paimon tidak sedang berhalusinasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520115,
					"content": "Anak aneh dan sekumpulan serigalanya yang sama anehnya, kamu tidak kenal...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520116,
					"content": "Aku... benar-benar tidak mengerti apa yang kamu maksud-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520117,
					"content": "Tapi ngomong-ngomong soal serigala, akhir-akhir ini aku sedang melakukan suatu investigasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520118,
					"content": "Sebelumnya, para serigala tidak berkeliaran di luar Wolvendom. Tapi belakangan mereka semakin berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520119,
					"content": "Dengar-dengar, mereka menyerang kereta dekat Drunkard Gorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520120,
					"content": "Kalau kamu sempat, bagaimana kalau kita menginvestigasinya bersama-sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520121,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Hehe! Kamu memang bisa diandalkan, ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520122,
					"content": "Ayo kita pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Hai Amber, apa kabar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "Ah, kelihatannya kamu agak senggang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520126,
					"content": "Uh-oh, biasanya setelah ngomong ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520127,
					"content": "Aku sedang sangat sibuk belakangan ini. Tugas sebagai seorang Outrider sungguh tidak ada habisnya, jadi... apakah kamu mau membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520129,
					"content": "Tuh, kan... apa Paimon bilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520130,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Belakangan ini sekumpulan serigala terus menyerang kereta-kereta di Drunkard Gorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520133,
					"content": "Seperti yang kamu tahu, walaupun serigala berbahaya, tapi mereka memiliki aturan mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520134,
					"content": "Serigala di Mondstadt biasanya tidak akan berkeliaran di luar Brightcrown Mountains dan Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520135,
					"content": "Iya, yang Paimon tahu... area-area tersebut memiliki aturannya sendiri, walaupun tempat itu masih relatif primitif dan belum terjamah oleh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520136,
					"content": "Benar. Adanya serigala-serigala di sekitar Drunkard Gorge itu adalah hal yang aneh dan tidak biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520137,
					"content": "Ngomong-ngomong soal serigala, kamu kenal anak laki-laki yang di Wolvendom itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520138,
					"content": "Siapa? Aku tidak pernah dengar ada yang tinggal di Wolvendom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520139,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520140,
					"content": "\"Knight perempuan, merah\"... Yang dimaksud bukan kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520141,
					"content": "Eh? Kamu ngomong apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520142,
					"content": "Pokoknya, aku akan ke Drunkard Gorge untuk investigasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520143,
					"content": "Ikuti aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520131,
					"content": "Apa yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
