						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Bukan sekumpulan serigala... sepertinya para Hilichurl sedang menyerang sebuah gerobak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Uh... ini sudah tidak aneh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Ayo kita tolong mereka segera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
