					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Ayo coba mainkan Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580102,
					"content": "Eh? Lentera-lentera ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ternyata kalian, pas sekali kalian datang. Aku menggantinya dengan lentera yang baru karena waktu itu kalian sudah menyelesaikan yang sebelumnya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580104,
					"content": "Bagaimana? Berani mencobanya? Yang kali ini tidak semudah sebelumnya loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580105,
					"content": "Apa gambar yang direfleksikan menjadi lebih rumit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "Tidak, tidak. Gambarnya mudah dipahami kok, lalu dibagi menjadi 3 bagian, sama seperti sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580107,
					"content": "Yang menjadi lebih sulit adalah \"cara memutar lenteranya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580112,
					"content": "Oh! Ngomong-ngomong, pola kali ini adalah <color=#00E1FFFF>Mora</color>, ingat ya, kamu hanya bisa mengambil hadiahnya setelah menyusun pola yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580108,
					"content": "Cara memutarnya menjadi lebih sulit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Hehehe, kali ini ketiga lentera ini <color=#00E1FFFF>tersambung bersama</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580110,
					"content": "Sederhananya, saat kalian memutar satu bagian, bagian yang lain bisa saja ikut terputar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580111,
					"content": "Baiklah, kalian langsung coba saja sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				}
			]
		},
