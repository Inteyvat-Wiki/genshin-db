			"dialogs": [
				{
					"id": 413580201,
					"content": "Bagaimana? Sudah menemukan hartanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580202,
					"content": "Kami sudah menemukan semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "Semuanya sudah ketemu? Wah kalian pandai sekali mencari harta karun ya. Banyak orang yang datang ke sini dan menyerah setelah memutar satu lentera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580204,
					"content": "Nah, karena kalian sudah menemukan semua harta karunnya, ini hadiah untuk kalian. Semoga kalian bersenang-senang di Festival Lantern Rite ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
