			"dialogs": [
				{
					"id": 721450101,
					"content": "\"... Dikatakan bahwa utusan Omikami memiliki 3 mata: satu untuk 'jiwa', satu adalah 'cermin', dan terakhir untuk 'kebenaran'...\"",
