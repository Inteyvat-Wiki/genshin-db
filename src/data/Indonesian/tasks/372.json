			"dialogs": [
				{
					"id": 3720501,
					"content": "HAAAAAHHH!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720502,
					"content": "Kamu, benar-benar punya kemampuan yang luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720503,
					"content": "Orang sepertimu, pasti akan sering disebut di dalam syair-syair seorang penyair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720504,
					"content": "Pahlawan menyambut panggilan sang terang, dengan tangan dan hati menggenggam pedang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720505,
					"content": "Aduh sayang ... tapi aku benar-benar tidak punya waktu untuk membuatkanmu melodi saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720506,
					"content": "Kalaupun Dvalin tidak ditundukkan, hidupnya pun akan tetap layu dalam tiupan angin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720508,
					"content": "Aku bisa merasakan kesedihan Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "Dengarkan saran dari seorang knight, serahkan dirimu bersama dengan naga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "Dia akan membakar dirinya perlahan dalam api amarahnya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720509,
					"content": "Terima kasih, dan juga terima kasih telah memurnikan Kristal Air Mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720510,
					"content": "Tapi sekarang aku sudah punya rencana untuk beraksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720512,
					"content": "Memurnikan Kristal Air Mata saja sudah sangat membantu, terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720513,
					"content": "Tapi sekarang, aku sudah punya rencana sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720515,
					"content": "Apa menurutmu itu benar-benar perlu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720516,
					"content": "Lupakan saja ... aku punya rencana lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720517,
					"content": "Rencana lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720518,
					"content": "Melihat air mata ini, membuatku teringat akan seorang teman terkasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720519,
					"content": "Teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720520,
					"content": "Hehe, aku harus pergi dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720521,
					"content": "Hei! Kamu mau pergi ke mana?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720522,
					"content": "Ke \"Lambang pahlawan Mondstadt\". Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720524,
					"content": "Orang yang aneh, kita harus perhatikan dia baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Hm... {NICKNAME}, bagaimana ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720526,
					"content": "Lagi pula...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "Tapi di mata dia, kamu juga pasti dianggap orang yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720528,
					"content": "Suaranya ... terasa tidak asing di telingaku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Lagi pula?",
