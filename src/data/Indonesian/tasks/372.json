			"dialogs": [
				{
					"id": 3720101,
					"content": "Sebentar, kalian kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Orang Baju Hijau"
				},
				{
					"id": 3720102,
					"content": "Oh, aku ingat! Kalian yang membuat Dvalin kabur, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Orang Baju Hijau"
				},
				{
					"id": 3720103,
					"content": "Dvalin? Siapa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720104,
					"content": "Dvalin adalah nama asli Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "Hah? Oh, betul! Tapi kebanyakan orang memanggilnya \"Stormterror\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720107,
					"content": "Kok kamu manggilnya gitu ... memangnya kalian berdua teman dekat atau semacamnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720108,
					"content": "Oh, sangat dekat dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Orang Baju Hijau"
				},
				{
					"id": 3720109,
					"content": "#Hei {NICKNAME}, kayaknya Paimon rasa orang ini enggak beres deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720110,
					"content": "Eh ... hai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "Hai Pengembara, akhirnya kita ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Orang Baju Hijau"
				},
				{
					"id": 3720113,
					"content": "Aku Venti, seorang penyair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720114,
					"content": "Pemenang \"Penyair Terpopuler Mondstadt\" tiga tahun berturut-turut, lebih tepatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720115,
					"content": "Jadi, ada perlu apa denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720116,
					"content": "Kan kamu sudah kenal kami, jadi enggak perlu Paimon perkenalkan diri lagi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720117,
					"content": "Tentu saja tentang Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720118,
					"content": "Storm-?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720119,
					"content": "Hei, jangan pura-pura enggak tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720120,
					"content": "#Kalau gitu {NICKNAME}, tunjukkan benda itu ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720121,
					"content": "Oh! Ini kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720122,
					"content": "Loh? Kristalnya kok sudah jadi murni? Kapan kejadiannya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720123,
					"content": "Aku tidak tahu kenapa berubah seperti ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Dvalin, dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720126,
					"content": "Kesedihan yang dia rasakan ... itu yang membuatnya menangis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720127,
					"content": "Jadi ini air ... mata ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720124,
					"content": "Terakhir kali aku lihat, masih penuh dengan ketidakmurnian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Maaf, kamu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "Kan Lisa pernah memberi tahu kita, kamu lupa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
