				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "Tentang objek aneh di pinggir air ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "Oh? Kamu sudah menaruh benda itu di pinggir air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "Gimana? Apa ada sesuatu yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "Malah muncul Geovishap ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Geovishap? Barang itu berubah jadi Geovishap setelah ditaruh di air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "Oh, bukan barangnya yang berubah jadi Geovishap ya, tapi barang itu menarik perhatian Geovishap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Kaget aku! Kalau barang itu berubah jadi Geovishap waktu ditaruh di dalam air, berarti pemahamanku tentang dunia ini salah besar selama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "Jadi sebenarnya itu barang apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "Yah jadi sederhananya sih. Duh gimana jelasinnya ya ... Mmm, coba kutanya dulu, apa Geovishap itu punya karakteristik yang unik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "Misalnya, dia punya kekuatan Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Kayaknya iya sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Kalau gitu, memang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "Geovishap itu sepertinya bisa menggunakan kekuatan Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "Air bawah tanah di Chasm mengandung konsentrasi elemen Hydro yang sangat tinggi. Di beberapa titik khusus bisa muncul tanaman air seperti yang kamu pancing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "Tentu saja, Geovishap sebagai makhluk air di Chasm, meningkatkan kekuatannya dengan makan rumput laut yang mengandung kekuatan Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "Ya, jadi barang itu adalah ... rumput laut yang mengandung kekuatan Hydro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "Jadi cuma rumput laut ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Iya, itu rumput laut — tapi mengandung kekuatan Hydro yang besar sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "Biasanya tidak akan bisa tumbuh di lingkungan normal, kecuali ada sebuah energi yang murni dan sangat kuat yang memengaruhi sumber airnya ... Yah pokoknya, rumput laut ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "Bisa saja suatu hari mereka tumbuh menjadi makhluk elemental yang memiliki kesadaran sendiri. Benar-benar topik penelitian yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "Aku enggak gitu merhatiin sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Kutebak kamu pasti sudah keburu bunuh dia ya? Luar biasa, memang sesuai yang diharapkan dari petualang legendaris {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Tapi hipotesisku sekarang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
}