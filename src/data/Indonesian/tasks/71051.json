				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500501,
					"content": "Tentang benda aneh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "Eh? Kamu ... mancing ini?? Benda ini kalau dilihat sekilas memang mirip dengan umpan buat mancing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "Memangnya wajar ya orang dapat beginian waktu mancing? Seniorku Anisa juga setiap hari mancing terus di Pulau Watatsumi, tapi tidak pernah dapat yang aneh-aneh tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "Mungkin karena kamu yang mancing saja kali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "Coba kulihat. Aku bisa merasakan konsentrasi elemen Hydro yang luar biasa tinggi dari dalam benda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "Air tanah di Chasm memang mengandung kekuatan elemen dengan tingkat yang tidak normal. Apa mungkin ada kaitannya dengan benda ini, dan sesuatu yang tumbuh di bawah air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Tapi begitu benda ini dikeluarkan dari air, kekuatan elemennya terus berkurang. Coba taruh dekat air, biar lebih jelas apa efeknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "Taruh di dekat air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Iya, lalu harus kita aktifkan dengan kekuatan Hydro. Jadi kita bisa tahu apa yang disembunyikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "Begini saja, kan kamu yang menemukan benda ini, coba kamu yang aktifkan. Kalau sudah ada hasilnya, beri tahu aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Kalau menemukan hal yang berguna untuk penelitian, aku pasti bayar kamu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105008,
			"completionStepIds": [
				7105104
			],
