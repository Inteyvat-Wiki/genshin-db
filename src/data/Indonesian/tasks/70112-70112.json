					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Tunggu, ini kamu lagi muji siapa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Berikutnya, mempertimbangkan bagaimana hal-hal di dunia saling memengaruhi satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Perhatikan reaksi elemen, daya jarak jauh, dan jarak dekat. Lalu, ingat untuk menghindari gangguan yang tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "Uh, ngomong apa sih?",
