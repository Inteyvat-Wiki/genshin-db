			"dialogs": [
				{
					"id": 701120101,
					"content": "Oh ya, Dexter, keadaannya sudah berbeda sekarang. Waktunya bertumbuh dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "Kamu juga harus menerima cobaan untuk menjadi dewasa dan belajar dari orang-orang dewasa. Perhatikan baik-baik, aku hanya akan contohkan sekali saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Kok jadi kayak kata-kata terakhir gitu sih ngomongnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "Ini kelas yang terakhir. Ikut kata-kataku, \"klasifikasi elemen\". Ayo, coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
