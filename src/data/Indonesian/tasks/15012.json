			"dialogs": [
				{
					"id": 150120501,
					"content": "Monsternya bikin aku panik, akhirnya aku mutar ke jalan kecil supaya tidak ketemu mereka ... dan akhirnya malah ketemu bandit. Untung ada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Kalau situasinya sebahaya itu kenapa kristalnya enggak ditinggal saja terus kamu lari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Oh, justru sudah banyak sekali yang dibuang. Yang tersisa tinggal yang paling murni saja, dan ini harus dibawa balik bagaimana pun caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "Demi Tlazolli dan Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Maaf, mereka siapa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, wajar kalau kamu tidak tahu. Tlazolli ... dulunya seorang pembuat Marga Kuno. Nechca itu anaknya.",
					"roleType": "TALK_ROLE_NPC",
