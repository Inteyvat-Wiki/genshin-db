			"dialogs": [
				{
					"id": 150121301,
					"content": "Kalau tidak salah Xilonen juga bisa bikin itu kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Oh, kalian kenal Xilonen? Haha, coba sebut nama itu di depan Tlazolli. Dia bakal terus ngoceh memuji-muji Xilonen, tidak akan berhenti sampai matahari terbenam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "\"Dia yang paling paham riwayat Marga Kuno\", \"masa depan suku\", \"pengrajin paripurna seantero Natlan\" ... seperti itu, dan semacamnya. Aku berani taruhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "Tlazolli memang rindu zaman-zaman dia masih membuat Marga Kuno. Dia tidak pernah ngomong, tapi aku tahu betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
		},
