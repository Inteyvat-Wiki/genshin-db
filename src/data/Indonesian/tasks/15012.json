					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Hadiahnya ... Marga Kuno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "Ngaco kau! Archon Pyro sudah minta Xilonen bikinin buat kita. Jangan malah dibikin kacau dan ribet yang enggak perlu ya, awas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Hadiahnya ... cukup yang biasa saja, tapi bagus. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
