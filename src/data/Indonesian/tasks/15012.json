			"dialogs": [
				{
					"id": 150120401,
					"content": "Wah, gila ya. Jago banget kaburnya, langsung enggak kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Sudah pintar berarti, enggak perlu dikasih pelajaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Fiuh ... terima kasih banyak. Padahal kupikir sudah tidak akan bisa turun gunung hidup-hidup barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Ditolongnya sama {NICKNAME} dong ... aku beruntung banget hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah, maaf, kita belum kenalan ya. Aku Cheven, pengrajin batu permata, dan biasanya bernasib sial. Tapi mungkin kali ini agak beda ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Imix yang suruh kami ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Anak itu ... *huff* Aku bikin dia cemas lagi ya. Awalnya aku kira ini paling lama juga perginya cuma dua hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Tapi ya, aku nemu lapisan bijih Kristal Vulkanik baru di dekat Paku Bayangan kemurniannya mantap, jumlahnya juga lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Aku gali agak banyak, lalu siap-siap pulang. Tapi Phlogiston di dalam kristalnya memancing monster datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "Jadi terkenal ada bagusnya juga kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
