			"dialogs": [
				{
					"id": 150120101,
					"content": "Di-Dia belum balik ... aduh, semoga Suhu Cheven enggak kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Hei, anak itu nangis tuh ... kira-kira dia kenapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}, tanya yuk. Kasihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Adik kecil, kenapa nangis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*hiks* Suhu Cheven, dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "Di-Dia bilang mau naik gunung ... mau cari Kristal Vulkanik ... tapi dia enggak pulang-pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Aku sudah lapor sama om penjaga, tapi katanya mereka lagi kurang orang ... terus jalan ke gunung bahaya banget, banyak monster dan orang jahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Katanya mereka masih harus siap-siap dulu, baru bisa kirim orang ... kalau nunggu selama itu, mana keburu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Tenang, biar kami saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Wah, serius nih? Mau bantu cari? Sebentar, aku gambarin deh tempat yang om penjaga cek tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Katanya mungkin Suhu Cheven sempat berhenti di daerah situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Mungkin suhu memaksakan pergi ke dekat Paku Bayangan ... kalau memang begitu ... huuu ... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "Tolong Kak! Tolongin Suhu Cheven! Aku mohon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "Yang jadi pahlawan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
