			"dialogs": [
				{
					"id": 220330201,
					"content": "Cepat sekali sudah kembali? Jangan bilang kamu ini sebenarnya seorang koki hebat yang menyamar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "Hmm... aku sudah tidak sabar lagi, biarkan aku mencicipinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "Silakan dinikmati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Coba kupikirkan... barusan kita bahas hidangan apa saja ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Ugh, Rice Bun, Lotus Flower Crisp, dan Tricolor Dango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "Kalau sudah tahu mau masak apa, langsung saja kita berikan ke Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
