			"dialogs": [
				{
					"id": 220330701,
					"content": "Jadi mau siapkan camilan yang mana? Lebih baik kita yang bantu pilihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Coba kupikirkan... Camilan yang paling kusuka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330703,
					"content": "Rice Bun yang murah dan enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330704,
					"content": "Lotus Flower Crisp yang cantik dan enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330705,
					"content": "Juga ada Tricolor Dango yang lembut dan empuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330706,
					"content": "Itu semua sih, kesukaanmu kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Hehe, tenang, percaya deh sama selera Paimon. Ayo pilih satu~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330708,
					"content": "Kalau begitu Rice Bun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "Kedengarannya mantap! Ayo kita cepat buatkan satu Rice Bun untuk Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330710,
					"content": "Kalau begitu Lotus Flower Crisp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "Oke! Ayo kita cepat buatkan satu Lotus Flower Crisp untuk Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330712,
					"content": "Kalau begitu Tricolor Dango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "Bagus! Ayo kita cepat buatkan satu Tricolor Dango untuk Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330714,
					"content": "Kupikir-pikir dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "Ya~ Kalau sudah tahu mau buat apa, ayo cepat kita masak untuk Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
