			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "Ah, coba kalau ada makanan Liyue sekarang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330802,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "Bajumu ... kamu Pengembara itu ya? Maaf, aku cuma sedikit kangen rumah saja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330804,
					"content": "Barusan kamu bilang ingin makan masakan Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "Eh? Jangan-jangan... Kamu bisa bikin masakan Liyue ya? Mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330819,
					"content": "Ka-Kalau begitu tolong, kumohon masak sesuatu yang otentik khas Liyue ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330820,
					"content": "Coba kupikir dulu ... Aku sekarang lagi ingin makan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330821,
					"content": "Aku mau makan camilan. Camilan Liyue yang tradisional dan manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330822,
					"content": "Belakangan ini setiap kali aku menutup mata, aku seperti sedang bermimpi dan melihat seorang pangeran camilan yang tampan tiada tara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330823,
					"content": "Kakinya memakai sepatu dari wajan, kepalanya memakai mahkota dari tofu. Badannya memakai pakaian dari beras, tangannya menggoyangkan kipas dari Flower Crisp ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330824,
					"content": "Sepertinya dia akan mengundang banyak tikus ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "Dia berjalan keluar dari toko camilan, melewatiku dengan aromanya yang wangi. Aku tidak pernah melupakan wangi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330827,
					"content": "Tolonglah bawakan aku pangeran camilan itu! Tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330825,
					"content": "Sepertinya kostumnya butuh banyak mi dan beras ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "Perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "Biar kuperkenalkan diri dulu. Namaku Tang Wen, seorang sejarawan dari Liyue. Sebelum ini, aku meneliti budaya dan cerita rakyat Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330807,
					"content": "Aku sudah mengumpulkan semua bahan yang diperlukan dan sudah bersiap-siap pulang ke Liyue, tapi baru-baru ini jadi banyak peristiwa besar yang terjadi di Inazuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330808,
					"content": "Dan aku merasa seperti sedang hidup di waktu yang bersejarah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330809,
					"content": "Peristiwa-peristiwa yang terjadi di zaman ini pasti akan meninggalkan bekas yang mendalam di sejarah Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330810,
					"content": "Menyaksikan sejarah dengan mata kepala sendiri, kemudian mencatat semuanya secara lengkap dan jelas untuk generasi mendatang. Demikianlah tugas seorang sejarawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330811,
					"content": "Aku memang semangat, sangat semangat ... Tapi semangat saja tidak bikin perut kenyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330812,
					"content": "Lapar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "Bukan lapar sampai segimana juga sih... Masakan Inazuma enak kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330814,
					"content": "Aku doyan sekali tempura, padahal itu kan cuma ... Yah, cuma gorengan biasa kan, tepung semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330815,
					"content": "Setelah makan buatan lokal sekian lama, aku mulai kangen masakan kampung halamanku. Sedihnya, di sini belum ada restoran yang menyajikan masakan Liyue asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330816,
					"content": "Akhirnya kuputuskan untuk mengajukan misi saja ke Adventurers' Guild, tapi sampai sekarang belum ada yang mengambil misinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330817,
					"content": "Aku coba deh, boleh kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
}