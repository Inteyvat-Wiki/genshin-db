				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "Eh? Ra-rasa masakan ini kok aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Tidak bisa dibilang aneh sih... harusnya ajaib, atau apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "Bisa-bisanya kamu memasak masakan seperti ini... Teknik memasakmu sungguh lain dari yang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "Terima kasih banyak! Terimalah barang-barang ini, pengembara... Masakan ini akan kunikmati pelan-pelan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
