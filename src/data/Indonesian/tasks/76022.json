			"dialogs": [
				{
					"id": 760220201,
					"content": "Hei! Si badan besar! Ngapain kamu? Cepat berhenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora ... Tidak, tidak. Orang yang membunuh Murasaki ... Mati saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samurai yang Murka"
				},
				{
					"id": 760220203,
					"content": "#Woahh! {NICKNAME}, awas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
