							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Terima kasih sudah menyelamatkanku. Aku Peco, seorang pedagang keliling. Kalau kalian tertarik dengan daganganku, akan kuberikan diskon terbaik untuk kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Ngomong-ngomong, hari ini memang sial. Aku malah bertemu dengan sosok legendaris itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "Sosok legendaris? Orang itu terkenal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Legendaris karena nama buruknya sih. Aku juga dengar dari pedagang lain ... Mereka juga ketakutan waktu itu dan bilang tidak mau lewat jalur ini lagi, terus aku tidak percaya hal itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Kamu berani juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Kami para pedagang keliling sudah sering mengalami berbagai hal. Lagi pula, kalau lagi kumpul dan saling berbagi cerita, kadang ceritanya suka \"dilebih-lebihkan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Pokoknya ... namanya \"Gonpachi\". Katanya dia pernah terlibat masalah di Inazuma, lalu kabur ke daerah terpencil ini bersama kekasihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Jadi \"Murasaki\" yang tadi dia sebutkan itu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Oh iya! Orang aneh tadi terus sebut nama itu waktu bertarung sama {NICKNAME}, benar-benar aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Orang yang sejak awal menyimpang dari jalan yang benar, meski pindah tempat, tetap sulit bertobat. Kalau tidak punya pekerjaan yang benar, ujung-ujungnya akan mengulang kesalahan yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Kalau dia hidup sendirian, cara hidup seperti itu mungkin tidak masalah. Tapi hidup dengan mengandalkan pedang, siapa tahu musuh macam apa yang bisa dia timbulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Katanya kekasihnya meninggal karena hal itu. Intinya, dia menjadi gila sejak saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "Huff ... Merampok orang itu emang jahat sih, tapi ... sesudah tahu kenapa dia jadi kayak gini, Paimon jadi agak kasihan juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Jadi Paimon, jangan demi Mora ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "Hei! Bukan itu intinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Baiklah, aku tidak mengganggu waktu kalian lagi. Tolong terima ini sebagai tanda terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Kalau suatu hari Paimon dirampok ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Hehe, kamu ada di sisiku! {NICKNAME}, pelindung Mora-ku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
