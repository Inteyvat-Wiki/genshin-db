						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Lama tidak berjumpa! Bagaimana dunia di luar Pulau Yashiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Di sini jauh lebih kaya daripada kampung halamanku, ada begitu banyak makanan enak dan hal yang menyenangkan. Tapi... aku tidak begitu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Eh? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Orang-orang di sini kurang sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Dulu saat aku masih tinggal di Pulau Yashiori, Yang Mulia terasa sangat jauh, tapi juga terasa menentramkan... Kami tidak peduli dia ada di mana, namun kami yakin dia ada di sini melindungi kami. Kami tahu dia menuntun kami melewati hari untuk menjadi orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Tapi di sini, Yang Mulia menutupi dan memaksakan segalanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "Eh, aku malah bicara panjang lebar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Kami masih berusaha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Oh iya, mengenai ibuku... Apa kamu menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
