			"dialogs": [
				{
					"id": 721971801,
					"content": "#Kamu sudah kembali, {NICKNAME}. Apa kamu membawa Crystal Ore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721971802,
					"content": "Sudah kubawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "Sedang dalam perjalanan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "Jangan khawatir, istirahatlah dulu di sini sebentar.",
					"roleType": "TALK_ROLE_NPC",
