				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Halo halo! Aku sudah kembali! Jadi, gimana nih kabarnya Kamp Pelatihan Adu Kumbang Zirah Membara Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664002,
					"content": "Pas banget, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "Penyelamatku! Terima kasih karena sudah bantu urusin izinnya! Juga untuk mahakarya seninya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Tunggu, mata itu ... muka itu ... Apa jangan-jangan kamu ... mau adu kumbang juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Lah? Memangnya tidak boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664006,
					"content": "Aku punya klien yang bisnisnya menjangkau lintas perbatasan ... Yah, singkatnya dia kasih aku banyak hadiah karena berhasil memenangkan gugatannya di pengadilan, dan salah satunya adalah seekor Onikabuto yang sangat spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664007,
					"content": "Aku tidak tahu meliharanya harus gimana, jadi minta tolong Nenek urusin. Terus tiba-tiba saja jadi kekar gini kumbangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664008,
					"content": "Jadi boleh kan kalau aku ikutan? Atau ... aku malah akan merusak suasana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664009,
					"content": "Raja Oni, kita tidak mungkin menolak permintaan penyelamatmu ini. Pengalamannya mungkin masih kosong, tapi Onikabuto peliharaannya itu kekar dan gagah sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664010,
					"content": "Permintaan yang tidak bisa ditolak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "Baiklah, Tangan Kanan Raja Oni! Waktunya kamu dan si Pentung Merah beraksi. Aku yakin sohibku yang satu ini tidak akan gentar biarpun lawannya garang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Oh pasti dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Jadi lawannya {NICKNAME} nih? Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664015,
					"content": "Aku masih belum paham betul gimana mainnya, jadi maaf ya kalau banyak salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664013,
					"content": "Makasih, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
