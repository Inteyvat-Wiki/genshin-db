			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "Onikabuto Yanfei kuat banget! Madame Ping kasih dia makan apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Nah tuh, Onikabuto penyelamatmu bukan sembarangan kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664103,
					"content": "Tapi sama seperti waktu itu, ketika jenderal-jenderalku mengeluarkan jurus mereka. Pedang paling tajam pun tidak berguna jika yang menghunuskannya bukan seorang ahli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664104,
					"content": "Bi-Bi-Bijaksana sekali, Grandmaster ... Oooke! Untung sohibku nih kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Wuih, seru banget ya! Bisa deh jadi hobi baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "\"Kontestan Super Kekar\""
				},
				{
					"id": 716664106,
					"content": "Senang deh! Terima kasih, semuanya. Aku masih mau ikutan main lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kontestan Super Kekar\""
				}
			]
		},
