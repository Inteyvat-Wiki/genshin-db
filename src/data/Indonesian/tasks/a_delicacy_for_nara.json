				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "Sulit untuk berbicara dengan Nara. Lagi pula, sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Eh! Nara {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati tidak takut. Para kakak juga berani, pasti tidak akan takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "Asal mengikuti terus <color=#00E1FFFF>gumpalan asap</color>, pasti nanti ketemu sama mereka. Kalau mereka berubah jadi aneh, ciprati saja mereka pakai <color=#00E1FFFF>Kekuatan Elemen Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati mau marah banget ini, argh, marah yang lebih ngeri daripada yang biasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Hutan sangat berbahaya, \"Marana\" mengamuk di dalam hutan. Saat berangkat, Arapacati juga telah menyuruh para kakak untuk bersatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Ternyata malah bertengkar setelah keluar, Arachatora, kamu bahkan memakan sesuatu yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati sudah putuskan, Arachatora tidak boleh petik jamur sampai Sunsettia matang sepuluh musim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Yaaah ... *hiks* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Kalau spora yang buruk sampai terbawa masuk, dan monster jamur sampai tumbuh, terus bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Kak Araphala, kamu juga! Kenapa harus pergi memetik buah terlalu jauh dari Vanarana? Di sana kan banyak hal yang buruk! Lagian Araja kan juga sudah pernah bilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Benar sekali. Buah juga harus minum air, Aranara juga harus minum air. Jadi, air adalah yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Kak Arapas, kamu juga kenapa harus pergi ke \"Varuna Contraption\" buat nyari air? Memangnya kamu tidak tahu kalau bahkan Nara Varuna yang bilang kalau air di Vanarana adalah yang rasanya paling enak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "Sekarang, kalian sudah lihat kan, cuma \"rasa kebahagiaan\" yang bisa membuat adik bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Kak Arasaka, aku dengar kakak sudah benar-benar merepotkan Nara {NICKNAME} demi \"rasa kebahagiaan\" milikmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "Itu, semua demi \"kelezatan yang hakiki\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "Tujuan menyelesaikan \"kelezatan yang hakiki\" itu untuk mendapatkan hasil dari \"latihan masak\", aih, terus kalau mengandalkan kekuatan orang lain untuk menyelesaikan latihan, apa gunanya dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati pikir Kak Arasaka harus sungguh-sungguh introspeksi diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Kami datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Eh, kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} dan Paimon sudah menanggung beban Arapacati, dan sudah mengatasi sumber masalah juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Arapacati akhirnya tidak khawatir lagi kalau para kakak akan kelewatan Festival Utsava, atau apa mereka lagi dalam bahaya atau tidak. Semua berkat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati dan para kakak, sangat berterima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Wah Paimon senang dengarnya deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Tapi, sebenarnya masih ada satu hal lagi yang Paimon penasaran sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "\"Nara Varuna\" itu sebenarnya siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "Dia itu teman kami. Teman Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#Sudah lama sekali, juga teman Aranara. Mirip dengan Nara {NICKNAME}, dia adalah Nara Emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Gitu yah. Tapi, Paimon masih mau nanya lagi nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Tentang \"persaudaraan\" di antara kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Iya. Para kakak Arapacati, siapa yang paling tua, dan siapa yang paling muda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Hmm? Tua dan muda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Maksudnya usia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "\"Usia\" ... Ah. Arapacati mengerti, seperti lingkaran pohon. Hmm, anak-anak hutan, tidak dibedakan dari \"usia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Eh? Jadi sebutan \"kakak\" dan \"adik\" itu asalnya dari mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Hm, ini. Dulu, kami memiliki teman, dia Nara juga. Nara Varuna. Dia bilang, Dia punya \"{M#adik perempuan}{F#kakak laki-laki}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "Saat Arapacati dan para kakak mendengar dia bilang tentang \"saudaranya\", dia kelihatannya sangat senang, dan juga sangat sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "Jadi, kami mengerti. Bagi \"kakak\", \"adik\" adalah Nara yang sangat penting. Bagi \"adik\", \"kakak\" adalah Nara yang sangat penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Kami rasa itu sangat baik. Lalu, Arapacati dan para kakak sepakat untuk jadi \"kakak\" dan \"adik\". Nara Varuna bilang itu bagus sekali. Kami harus saling menyayangi sebagai saudara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Benar, harus saling menyayangi saudara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Masih ada hal yang Paimon khawatirkan ... Aranara butuh makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Manusia bisa membuat hidangan dari bahan makanan, anak hutan juga bisa membuat hidangan dari bahan makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Karena Nara Varuna pernah mengajarkan kami cara Nara makan. Arapacati dan para kakak lalu memulai \"latihan masak\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Hmm, sungguh aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "Seperti bermain game ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati dan para kakak sangat serius. Karena kata Nara Varuna, bisa berbagi makanan adalah hal yang sangat menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Oh ya, kata Kak Arapas, Nara {NICKNAME} juga bisa masak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Betul, kemampuan memasak {NICKNAME} juga sudah teruji loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Jadi benar ya ... Kalau gitu nanti waktu Festival Utsava, Nara {NICKNAME} harus datang. Temani para kakak yang kurang pandai memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
