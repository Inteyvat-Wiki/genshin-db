	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "Ah! Nara Emas. *menghela napas* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati tidak takut. Nara {NICKNAME} adalah Nara yang baik, seperti Nara yang ada di dalam cerita itu. Nara {NICKNAME} dan Paimon sudah banyak bantu semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Ya, jangan takut. Arama dan Arapacati mempercayaimu, juga percaya kata-kata rumput, daun dan benih, kalian adalah Nara yang baik. Halo, Nara {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Arapacati, halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "Sebenarnya aku orang jahat loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Hei! Jangan bercanda kayak gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "Kamu tidak jahat. Arapacati tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#Tempat dengan banyak angin dan benih kecil. Mereka dan Nara sama-sama datang ke Vanarana. Mereka bilang Nara {NICKNAME} sangat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Arama juga bilang hal yang sama loh! Omong-omong, benih kecil dari tempat yang banyak anginnya ... maksudnya benih bunga dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "Mungkin juga benih Windwheel Aster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} harus bantu Arana mendapatkan Bija. Jadi ayo kita persiapkan Festival Utsava bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Oh la la ... Festival Utsava ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati terlihat aneh. Apakah ada yang mengganggumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Para kakak Arapacati, tidak pernah kembali ke Vanarana. Kalau mereka tidak pulang, kita jadi tidak bisa merayakan Festival Utsava bersama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Aku juga sudah lama tidak bertemu Arachatora, Arasaka, Arapas dan Araphala di Vanarana. Aku belum melihatnya sejak kejadian itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Sudah lama itu seberapa lama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Sudah beberapa rembulan yang lalu, waktu benih baru saja bertunas. Sekarang, benih itu pun sudah tumbuh jadi pohon besar yang bisa jadi tempat berteduh Aranara. Tingginya tujuh Arapacati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "Dari benih tumbuh sampai jadi pohon ... Wah! Ternyata sudah lama sekali! Apa kakakmu hilang, Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "\"Hilang\"? Itu sejenis benih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Oh! Rupanya benih dalam bahasa Nara itu \"hilang\". Hebat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Nara sangat hebat! Nara {NICKNAME} pasti punya banyak sekali \"hilang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Bukan gitu konsepnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "Maksudnya \"tidak tahu pergi ke mana\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "Oh. Bukan begitu. Arapacati tahu di mana lokasi Arachatora, Arasaka, Arapas, dan Araphala kok. Jadi, kakak tidak hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Mereka telah lama berlatih di luar Vanarana. Mereka \"latihan masak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "Begitu ya, \"latihan masak\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Kayaknya sih Paimon juga agak tertarik kalau gitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Hmm! Paimon lebih tertarik sama \"latihan masak {NICKNAME}\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Jadi, kayak apa sih \"latihan masak\" ini aslinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "Itu terjadi saat Festival Utsava yang lalu. Saat itu, Nara masak banyak hidangan untuk dicicipi para Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Jadi, Arachatora dan yang lainnya terus \"latihan masak\" demi bisa bikin \"hidangan\" buat Nara di Festival Utsava ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "Paimon kok jadi enggak sabar mau cepat-cepat Festival Utsava ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Tapi itu kan makanan Aranara ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Makanan kan bahasa umum semua makhluk hidup! Jadi, Paimon yakin enggak masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Tapi kalau Arapacati tahu mereka di mana, kenapa enggak cari mereka sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "Festival Utsava akan segera berlangsung, Arapacati masih harus melakukan banyak persiapan, tidak ada waktu untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Demi Festival Utsava, mereka latihan masak dan meninggalkan Vanarana. Tapi mereka tidak tahu Festival Utsava akan segera berlangsung. Dasar Arachatora, Arasaka, Arapas, dan Araphala ... bodoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#Serahkan saja pada kami! Bagaimanapun, kita dan Arama harus mempersiapkan Festival Utsava dan menemukan Aranara yang ada di hutan. Benar kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Serahkan pada kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Tapi gimana cara kami buat nemuin Arachatora, Ara ... terus \"Ara\" siapa lagi ya tadi tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas, dan Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Ummm ... Tiba-tiba banyak sekali nama, Arana, Arama, Araja, Arapacati ... kok nama Aranara sulit banget sih buat diingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, jangan mengejek nama Aranara. Nanti Aranara jadi sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Oke, oke. Paimon ngerti, jadi gimana cara kita cari mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Mereka biasa latihan masak di Vanarana. Tapi biasanya mereka akan membuat banyak asap. Jadi, Arapacati mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Semua orang sangat ketakutan waktu itu, bahkan ada Aranara yang sampai hibernasi. Untungnya Arama berani dan menghukum asapnya. Arapacati sangat marah dan akhirnya mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "Di dalam hutan, kalau melihat <color=#00E1FFFF>gumpalan asap</color>, harusnya kalian akan bisa menemukan mereka. Menurutku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Loh, ternyata kamu yang ngusir mereka jadinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Ya. Apa aku salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Enggak juga sih ... Ya sudah, {NICKNAME}, ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "Ah. Oh ya. Satu hal lagi. Kalau kakak-kakakku berubah jadi aneh, gunakan <color=#00E1FFFF>kekuatan Dendro</color> untuk ciprati mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "Dulu, mereka menghasilkan banyak asap. Seluruh Vanarana jadi penuh dengan asap. Mereka juga jadi takut dan akhirnya kabur ke mana-mana. Kadang-kadang mereka bisa jadi seperti itu kalau menyentuh jamur aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Tapi, Aranara kan peri hutan. Jadi, asal dapat menyerap <color=#00E1FFFF>kekuatan Dendro</color>, pasti bisa pulih dan sadar kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Paimon ngerti. {NICKNAME} bisa sembuh kalau makan Sweet Madame. Berarti {NICKNAME} itu perinya Sweet Madame. Ya! Super masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "... Singkatnya, ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#Nara {NICKNAME} dan Paimon, semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Singkatnya, ayo berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Penasaran banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Aku mengerti perasaanmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} bisa mengerti perasaanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Betul! {NICKNAME} juga kehilangan {M#adik}{F#kakak}nya loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Oh. {M#Adik}{F#Kakak}nya Nara {NICKNAME} juga pergi buat \"latihan masak\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Hah? Paimon rasa ada salah paham deh ... Hilang itu, maksudnya \"entah sudah ke mana\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Oh, bukan begitu. Arapacati tahu kakak tidak hilang. Mereka berlatih di luar Vanarana lamaaa sekali. \"Latihan masak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "Atau mungkin Pinecone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Jangan-jangan benih cerita yang dibawa angin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
