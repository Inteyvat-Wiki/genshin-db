			"dialogs": [
				{
					"id": 761230101,
					"content": "Ooh-hoo-hoo, aromanya enak banget! Kita udah tepat waktu di jam makan Columbina lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Huh. Kuuhenki itu ... lagi ngantri? Buat sup dari Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Wah, ini enak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Segar, sup buah yang enak begini ... Paimon enggak pernah minum yang seperti ini loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Mau tambah lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230108,
					"content": "Tambah dua lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Kamu lagi belajar masak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Ya. Aku minta resep dasar dari Ineffa, dan sudah coba beberapa kali. Kuuhenki dan hewan-hewan sepertinya suka sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230112,
					"content": "Ada masalah di dapur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Hmm ... lengan bajuku terlalu lebar. Kalau tidak hati-hati bisa kena panci ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230114,
					"content": "(Jadi, bukan masalah memasaknya yang bikin kamu kesulitan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Tapi aku masih agak kesulitan kalau bikin makanan manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230116,
					"content": "Harus bisa tahu suhu dan takaran yang tepat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230117,
					"content": "(Sepertinya dia tidak banyak masak untuk dirinya sendiri selama ini.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Lagi pula, makanan manis dan camilan memang sangat sulit dibuat sempurna kalau kerja sendirian ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Mau aku bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Boleh. Kita mulai dengan krumkake, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230121,
					"content": "Beberapa saat kemudian ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Kamu mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230123,
					"content": "(Gigitan kecil.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230126,
					"content": "(Wah, gigitan pertama itu bikin mukaku keriput seperti buah plum kering ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Tapi setelah ditelan, rasa manisnya mulai terasa ... Mungkin akan lebih enak kalau sudah terbiasa ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230129,
					"content": "Lumayan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Paimon kelewatan apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Coba ini dulu dong, boleh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Gaaaah, asam banget! Ka-kalian berdua mau ngapain Paimon sih!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230136,
					"content": "Tapi rasanya enak juga setelah dimakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "Rasa awalnya yang penting! Kok enggak ada yang bilang Paimon harus gigit dikit aja!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Kalau kamu enggak bilang apa-apa, Paimon pasti kira ini lagi dikerjain! Sengaja mau lihat reaksi konyol ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "OK. Aku coba lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230140,
					"content": "Beberapa saat lagi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Ini. Coba yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230142,
					"content": "(Wah ...! Yang ini jauh lebih enak!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Enak sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Beneran? Paimon juga mau! ... Mmm! Wow! Enak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Bisa dijadikan hadiah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230147,
					"content": "Tentu dong! Tunggu, kamu belajar masak dan bikin krumkake gara-gara mau kasih hadiah ke seseorang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Ya ... untuk teman-temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230149,
					"content": "Ide yang bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Kamu masih ingat saat pertama kali kalian datang ke sini sama-sama? Waktu itu kamu sudah siapkan makanan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230151,
					"content": "Meski makanan ini tidak bisa mengembalikan tenagaku yang hilang, tapi setidaknya bisa bikin aku lebih santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230152,
					"content": "Waktu itu aku tidak banyak pikirin, tapi sekarang aku paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230153,
					"content": "Waktu dan usaha yang dihabiskan untuk menyiapkan makanan dengan tangan sendiri itulah yang memberi jiwa pada makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230154,
					"content": "Yang aku nikmati bukan hanya makanannya saja, tapi juga kehangatan dan kebaikan dari tangan yang membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230155,
					"content": "Dan semakin sedikit tangan itu mencari balasan, semakin besar kehangatan dan kebaikan yang dibutuhkan untuk membalasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230156,
					"content": "Ehh, Paimon jadi malu kalau kamu ngomong begitu terus ... Sejujurnya, waktu itu kami emang berharap bisa dapat perhatian kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Tapi sekarang keadaannya sudah berbeda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Benar. Tapi sekarang setelah aku paham semua ini, aku ingin melakukan lebih banyak lagi ... Rasanya sangat menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230160,
					"content": "Mau ikut aku mengunjungi teman-teman kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230161,
					"content": "Selain krumkake, aku juga sudah siapkan beberapa hadiah lain. Ah, tapi harus dikirim diam-diam ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230162,
					"content": "Kenapa \"diam-diam,\" kalau Paimon boleh tanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Yah, kalian selalu saja bikin aku \"terkejut dan senang\". Sekarang aku juga ingin lihat bagaimana reaksi teman-temanku kalau situasinya dibalik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230164,
					"content": "Fiuh. Kita udah lari ke mana-mana! Akhirnya beres juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Tapi reaksi mereka cukup ngejutin loh. Ada yang enggak sadar kalau itu hadiah dari Columbina ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino sih langsung makan saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Tidak apa. Aku sudah tahu pasti begitu. Yang penting mereka senang menerima hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230168,
					"content": "Kalau gitu, Lauma pasti tahu dong kalau krumkake dan karangan bunga di mejanya itu dari kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon bisa paham kalau dia ragu untuk pakai karangan bunganya, tapi yang benar aja, dia menatap krumkake itu ada sepuluh menit dan masih enggak berani makan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Aku khawatir mau dia abadikan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Jahoda sepertinya benar-benar kaget tadi ... Mungkin kita tidak seharusnya menaruh hadiah langsung di belakangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230172,
					"content": "Dia kaget sampai melompat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Mungkin dia emang lebih waspada dari biasanya? Tapi dia kayaknya lebih tenang waktu Ashru datang dan main sama tiang garuk yang kamu kirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Untuk teman-teman lain yang tidak ada di Nod-Krai, aku minta bantuan kalian untuk mengantarkan hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761230176,
					"content": "Harus kuakui, kamu pandai memilih hadiah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230178,
					"content": "Ooh! Akhirnya giliran kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Eh? Permen? Paimon kira kita bakal dapat krumkake kayak yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Ya, kamu kan sudah coba saat mencicipi tadi. Kalau ada variasi lain kan enak juga, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230181,
					"content": "Ya ... ini benar-benar enak juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Senang mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230184,
					"content": "Dan masih ada satu hadiah lagi. Ini, untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230185,
					"content": "Ini ... wind glider?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Aku pernah dengar kalau langit itu milik para burung, dan daratan milik para binatang buas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230187,
					"content": "Lalu ruang luas di antara keduanya dikhususkan untuk petualang yang mengenakan wind glider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230188,
					"content": "Dengan adanya ini, semoga jalanmu ke depan selalu terang bagai cahaya bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230189,
					"content": "Aku suka sekali. Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Terima kasih juga, sudah mau temani aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761230182,
					"content": "Bahkan lebih enak dari permen Malam Doa Rembulan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Kalau ada makanan yang kamu mau, bilang saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "Kamu cepat sekali belajarnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230130,
					"content": "Tapi masih bisa ditingkatkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230124,
					"content": "(Gigitan besar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				}
			]
		}
	]
