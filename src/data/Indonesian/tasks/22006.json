				{
					"id": 220060701,
					"content": "Untunglah, piring giok ini tidak rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060702,
						220060706
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060702,
					"content": "Kenapa tidak kamu berikan saja pada mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "Sebuah relik dapat dipelajari oleh para pelajar, digunakan oleh para seniman, dan dipamerkan pada sebuah pemeran untuk dilihat orang-orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "Namun tidak boleh diberikan kepada pencuri untuk dijual demi uang yang bahkan jumlahnya tidak banyak. Itu bukan hanya tidak menghormati peninggalan budaya yang berharga, tapi juga sudah dianggap menginjak-injak sejarah itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "Aku tidak akan berdiam diri melihat orang yang memperlakukan sejarah dan relik seperti sampah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "Piring giok ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060707
					]
				},
				{
					"id": 220060707,
					"content": "Eh? Apa kamu tertarik dengan piring giok ini? Kamu tertarik dengan harganya apa nilai sejarahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060708
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060708,
					"content": "Aku bercanda, piring giok ini adalah peninggalan dari zaman Perang Archon, kalau tidak salah adalah perang antar suku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Jika aku bisa menafsirkannya, mungkin aku bisa mengisi beberapa kekosongan yang ada di dalam catatan milik Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060710
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060710,
					"content": "Atau mungkin kekosongan dalam catatan tersebut sudah terisi, aku hanya tidak diperbolehkan untuk mengetahuinya...",
