			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "Di mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "Kamu kehilangan apa lagi kali ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Oh, kali ini aku tidak kehilangan apa pun — aku masih mencarinya! Tapi aku masih tidak bisa menemukannya di mana pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Sebenarnya di mana ya? Setelah semua upayaku pergi untuk mengonfirmasi keberadaannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Bantulah aku mencarinya juga, relik yang begitu berharga tidak boleh sampai hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "Baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Coba kamu cari ke sebelah sana, aku akan terus mencari di sebelah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "Kita harus bisa menemukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "Relik macam apa kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "Sebuah... relik yang... benar-benar kuno! Dapat ditelusuri kembali seribu — tidak, sepanjang perjalanan kembali ke Perang Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "Pokoknya adalah sebuah relik yang sangat berharga dan tidak boleh hilang begitu saja! Jadi tolong bantu aku menemukannya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
