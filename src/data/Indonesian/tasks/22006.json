			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "Terima kasih, Pengembara! Mengerikan sekali... Para Treasure Hoarder semakin merajalela akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Namaku Soraya, seorang pelajar yang sedang berkunjung. Sebenarnya aku sedang melakukan penelitian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Beberapa hari yang lalu, aku mengikuti jejak petunjuk ke reruntuhan, di mana aku menemukan sebuah piring batu giok yang mencatat rincian sejarah dari zaman Perang Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Tapi setelah aku menggalinya keluar, para Treasure Hoarder langsung menyerangku. Aku mencoba melarikan diri, tapi mereka berhasil menangkapku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Kalau bukan karena bantuan kalian, aku dan piring giok ini akan berada dalam masalah besar. Sekali lagi terima kasih banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Apakah kamu juga seorang pelajar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "... Juga? Maksudmu masih ada pelajar lain di sekitar sini? Misalnya siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er...? Tunggu sebentar... tadi ketika aku akan disergap oleh para Treasure Hoarder, aku mendengar seseorang mengeluh tentang Bao'er memonopoli semua harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Kebetulan yang aneh... Bisakah kamu menceritakan sedikit tentang Bao'er yang kamu temui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Singkat cerita ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "... Hmm. Lokasi yang ditunjukkan oleh Bao'er kepadamu sama dengan lokasi yang kutargetkan. \"Kebetulan\" seperti ini benar-benar terlalu kebetulan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Kalau dia sebenarnya adalah Treasure Hoarder, maka aku curiga mereka pasti mengikutiku selama beberapa waktu... Berharap mendapatkan harta reruntuhan yang baru dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Bao'er menginginkan semuanya untuk dirinya sendiri, jadi dia berpisah dari kelompoknya dan bertindak lebih dulu. Tapi area ini terlalu besar untuk dicari satu orang, jadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "Sepertinya dia hanya memanfaatkanmu, Pengembara. Khawatirnya dia sudah lama mengincar lokasi ini — hanya saja aku maupun rekan-rekannya selangkah lebih maju darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Jangan khawatir, ini masih dugaanku saja, tapi Bao'er... terdengar seperti nama yang mencurigakan, bisa saja itu nama palsu, atau mungkin nama kode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Pengembara, bisakah kamu membantuku mengabaikannya? Apa pun yang terjadi, piring batu giok ini tidak boleh jatuh ke tangan yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Terima kasih, tapi kalau kamu kembali dengan tangan kosong, dia mungkin akan curiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Begini saja, aku punya sesuatu yang tidak terlalu berharga yang bisa kamu berikan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Meskipun ini hanya barang kecil yang kurang berharga, tapi semoga cukup untuk menghindari kecurigaannya untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Nah, kamu sebaiknya segera kembali, meskipun kamu baru saja mengalahkan rekan-rekannya, tapi karena dia bertindak sendiri, seharusnya dia tidak segera menyadarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Oh iya, lain kali kalau dia memintamu untuk mencari sesuatu, dan kamu benar-benar menemukan sesuatu, kamu dapat membawanya kepadaku. Aku biasanya menginap di Wangshu Inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "*fuh*... Walaupun yang bisa kulakukan sangat terbatas... tapi kalau aku dapat melindungi relik bersejarah dengan aman bisa dibilang telah melakukan sesuatu yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Kembali dengan tangan kosong mungkin akan membuatnya curiga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Benar juga... Kalau begitu, aku punya sesuatu yang tidak terlalu berharga yang bisa kamu berikan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Meskipun ini hanya barang kecil yang kurang berharga, tapi semoga cukup untuk menghindari kecurigaannya untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
