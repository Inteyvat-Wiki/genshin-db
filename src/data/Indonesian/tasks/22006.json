			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "Kenapa lama sekali, apa kamu menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060602,
					"content": "Aku menemukan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Ah... ini tidak jelek, tapi ini bukan barang yang kucari, yang kucari sedikit lebih besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060605,
					"content": "Tapi, ini juga sebuah relik, jadi biar kuambil. Jangan khawatir, aku pasti menggunakannya sebaik-baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060609,
					"content": "Terima kasih, ini untukmu sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060610,
					"content": "*huff* Tapi relik yang hilang itu, sungguh mengkhawatirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060603,
					"content": "Apa ini benda yang kamu cari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Meski ini terlihat bagus, tapi ini bukanlah yang kucari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060607,
					"content": "Tunggu, kamu tidak tahu cara menjaga relik dengan benar, bisa-bisa kamu malah menghancurkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060608,
					"content": "Biar aku yang menjaga relik ini, aku pasti akan menggunakan sebaik-baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				}
