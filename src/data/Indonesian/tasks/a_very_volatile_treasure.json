			"dialogs": [
				{
					"id": 102020101,
					"content": "Ah, Klee juga di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020102,
					"content": "Aku... *hiks hiks* aku menyerahkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020103,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020104,
					"content": "A-aku... bom milikku... telah melukai orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020105,
					"content": "Hiks hiks... aku melanggar Panduan Keselamatan Favonius, aku pasti tidak bisa melihat matahari lagi besok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020107,
					"content": "Tunggu, sepertinya ada salah paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Klee, tolong jawab aku dulu. Orang yang terluka itu, di mana dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020109,
					"content": "Orang yang terluka oleh Klee itu adalah Abyss Mage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020110,
					"content": "Ta-Tapi Mr. Fluffball hanya seorang pencuri biasa, dia tidak perlu meledak begitu karena bomku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020111,
					"content": "Ah... Paimon kan sudah bilang kalau Abyss Mage itu orang jahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020112,
					"content": "Mereka itu tipe orang yang paling jahat. Mereka bukan cuma benci orang baik, mereka benci semua manusia. Jadi mereka itu musuh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020113,
					"content": "Mr. Fluffball... dia jenis orang jahat? Dia musuh manusia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020114,
					"content": "A-apa?! Ke-kepalaku sakit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020115,
					"content": "Ini kelalaianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020116,
					"content": "Karena kamu masih terlalu muda, jadi aku tidak mengatakan ini padamu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020118,
					"content": "Karena Mondstadt mempunyai harta terkuat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "Faktanya, Abyss Order adalah sebuah ancaman yang sangat aktif menyerang Mondstadt akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020119,
					"content": "Ah! Paimon mengerti sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020120,
					"content": "Mereka mengincar Klee karena mendengar gosip mengenai hartanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020121,
					"content": "Sama seperti reaksi pertama Paimon saat tahu bahwa dia... ah tidak, maksudnya reaksi saat ingin mencari harta karun itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020122,
					"content": "Jadi... artinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020123,
					"content": "Melihatmu telah membantu masalah ini, akan kuizinkan kamu untuk berpartisipasi pada Ludi Harpastum selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020125,
					"content": "Beruntung sekali kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "Aku ikut senang mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "Ludi Harpastum! Wow!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "#{F#Nona}{M#Tuan} Honorary Knight, kamu juga harus ikut ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020128,
					"content": "Hehe, sungguh akhir yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020129,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020130,
					"content": "Tapi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020131,
					"content": "Klee, sebenarnya di mana kamu menyembunyikan harta karunmu yang asli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020132,
					"content": "A-ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020133,
					"content": "Apa kamu ingin membom ikan-ikan di Starfell Lake lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020134,
					"content": "Ah, tidak! Sungguh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020136,
					"content": "(A-ah, Jean menyadarinya...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "(Hm... dia ingin kita mengikuti sandiwaranya...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020137,
					"content": "Klee?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020138,
					"content": "A-aku akan pergi ke <color=#00E1FFFF>ruang tahanan</color>, hiks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020139,
					"content": "Klee pasti bosan kalau dia dikurung sendiran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
