				{
					"id": 102020401,
					"content": "Tebak siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Ah, aku mendengar suara Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Ruang Tahanan"
				},
				{
					"id": 102020403,
					"content": "Mau kami bantu keluar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Oh, boleh juga. Eh, tidak, tidak! Klee harus menjadi anak baik dan merenungkan perbuatanku, jangan menggodaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Ruang Tahanan"
				},
				{
					"id": 102020406,
					"content": "Selama aku masih dikurung, aku membuat harta karun baru... versi Ludi Harpastum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Ruang Tahanan"
				},
				{
					"id": 102020407,
					"content": "Harta karun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Hehe... aku membuatnya berbentuk seperti harpastum! Benar-benar lucu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Ruang Tahanan"
				},
				{
					"id": 102020409,
					"content": "Kamu membuatnya berbentuk seperti harpastum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Tunggu saja sampai Ludi Harpastum tiba! Orang-orang pasti menyukainya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Ruang Tahanan"
				},
				{
					"id": 102020412,
					"content": "Yah... kalau Jean dengar dia pasti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Waktu pengurungannya pasti jadi lebih lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Tapi tetap saja itu bom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Kamu mau cemilan atau makanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
