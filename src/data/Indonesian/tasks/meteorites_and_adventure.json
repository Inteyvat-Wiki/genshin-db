					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Betul, aku menerima tugas dari Adventurers' Guild untuk memeriksa hal-hal yang berhubungan dengan meteorit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250204,
					"content": "Tetapi entah kenapa monster-monster yang ada di sekitar batu meteorit ini, sepertinya berbeda dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250205,
					"content": "Dari segi kekuatan, gerak-gerik mereka, dan hal-hal lain semuanya berubah. Jumlah mereka juga kelihatannya semakin banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250206,
					"content": "Tadi monster-monster itu mengetahui keberadaanku. Karena itu, aku terpaksa kabur dari hadapan mereka sampai ke tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250207,
					"content": "Aku harus segera kembali dan melaporkan masalah ini ke tuan Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250208,
					"content": "Apakah ada hal aneh yang lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Hal aneh lain? Hmmm... sebenarnya aku enggan mengatakan ini, tapi ada banyak ilmuwan dan pelajar yang tidak mau kembali ke kota untuk berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250210,
					"content": "Aku sudah membujuk mereka berulang kali, tapi mereka tetap bersikeras melanjutkan penelitian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250211,
					"content": "Di sisi lain, pengembara yang bisa pergi ke luar sini juga tidak banyak, mana mungkin kita sanggup memperingatkan orang-orang tersebut setiap saat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250212,
					"content": "Orang-orang ini sungguh merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250213,
					"content": "Baiklah kalau begitu, Pengembara. Kamu juga sebaiknya segera kembali ke kota, berbahaya kalau kamu terus ada di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				}
			]
		},
