			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*huff* Andaikan aku juga bisa pergi melihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ternyata kamu. Sebenarnya tidak ada hal yang terlalu spesial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Tapi ya... lumayan spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Maksudmu meteorit itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Betul, kamu juga sudah melihatnya kan. Belakangan ini batu meteorit terus berjatuhan dari langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Aku heran... Entah karena perlindungan Archon Anemo, atau karena keberuntungan saja, sampai sekarang belum pernah ada batu meteorit yang jatuh di dalam kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Tapi banyak batu meteorit yang jatuh di luar kota sana. Apalagi kabarnya orang yang menyentuh meteorit itu akan tertidur lelap, dan tidak bisa dibangunkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Tuan Cyrus telah mengumpulkan beberapa pengembara dan menugaskan sebagian dari mereka untuk memperingatkan orang-orang yang masih berada di luar sana untuk segera berlindung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Sebagian lainnya diminta membantu Knights of Favonius untuk memastikan lokasi jatuhnya meteorit-meteorit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Kemudian melakukan pencarian dan penyelamatan di sekitar lokasi jatuh tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Sementara aku... Aku hanya diminta oleh tuan Cyrus untuk tetap tinggal di dalam kota dan menjaga orang-orang yang tertidur itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Mungkin karena kemampuanku tidak terlalu dapat diandalkan ya... Tapi kalau aku selalu mendapat tugas yang ringan seperti ini, bagaimana aku bisa berkembang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "*huff* Bagaimanapun juga, aku tetap harus melakukan tugasku dengan sebaik mungkin... Pengembara, bolehkah aku meminta bantuanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Aku mau memintamu untuk pergi ke luar sana dan mencari informasi tentang meteorit-meteorit itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Untuk apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Tuan Cyrus selalu berkata bahwa persiapan kita harus sangat matang kalau kita mau pergi bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Seandainya aku bisa membujuk tuan Cyrus dengan mengatakan bahwa aku telah mempelajari situasinya, dan persiapanku sudah matang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Mungkin... mungkin saja dia akan mengizinkanku untuk pergi ke luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Namun karena aku sedang sibuk menjaga orang-orang ini, aku jadi tidak punya waktu untuk mengumpulkan informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "Hanya kamu yang bisa kumintai tolong, Pengembara! Tolong bantu aku memeriksa situasi di luar sana. Kamu cukup... pergi ke Whispering Woods saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Segera beri tahu aku bila kamu menemukan sesuatu di sana. Nasibku untuk bisa pergi ke sana dan juga melakukan investigasi... sangat bergantung kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Kamu ingin diam-diam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Hah? Diam-diam...? Oh tidak! Tidak sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Meskipun aku sangat ingin sekali pergi keluar dan meneliti... tapi pekerjaan di dalam sini juga sangat penting! Tidak mungkin aku kabur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Yah, tapi... tuan Cyrus selalu berkata persiapan kita harus sangat matang kalau kita mau pergi bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Seandainya aku bisa membujuk tuan Cyrus dengan mengatakan bahwa aku telah mempelajari situasinya, dan persiapanku sudah matang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Mungkin... mungkin saja dia akan mengizinkanku untuk pergi ke luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Namun karena aku sedang sibuk menjaga orang-orang ini, aku jadi tidak punya waktu untuk mengumpulkan informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Maksudmu promosi diskon setengah harga toko Good Hunter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Apa?! Kenapa aku tidak tahu! Apakah promosinya masih ada sampai hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Ah! Bukan... Bukan ini yang mau kubicarakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Kamu juga pasti telah melihatnya, batu meteorit yang terus berjatuhan dari langit belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
