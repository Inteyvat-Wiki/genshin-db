			"dialogs": [
				{
					"id": 790290101,
					"content": "Ada patung di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*huff* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290103,
					"content": "Halo, kenapa menghela napas sendirian di depan gua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Baru-baru ini aku mulai hidup di gua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290113,
					"content": "Kamu tinggal di dalam gua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "Aku juga tidak punya jalan lain! Tiba-tiba ada segerombol aktor yang datang ke pulau dan berisik setiap harinya, membuat orang susah tidur ... Makanya aku ke sini untuk mencari ketenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290104,
					"content": "Lalu entah dari mana datang sekelompok Hilichurl mengambil tempat peristirahatanku, jadinya aku mau tak mau kedinginan di luar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290105,
					"content": "Ah ... Aku berjanji pada diriku sendiri, kalau ada orang yang bisa membantuku, aku akan memberitahunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290106,
					"content": "Beri tahu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Beri tahu tentang Harta Karun Bajak Laut Rahasia yang ada di legenda! Meskipun aku juga hanya mengetahui seperempat bagiannya saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290108,
					"content": "Seperempat bagian petunjuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Kalian juga tampaknya sedang mencari harta rahasia itu. Bagaimana kalau kalian bantu aku singkirkan Hilichurl yang ada di dalam, dan akan kuberi tahu lokasi petunjuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290110,
					"content": "Dengar-dengar kalau kamu bisa menemukan keempat bagian petunjuknya, kalian akan menemukan harta karun yang para bajak laut sembunyikan di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Kapten Night Raven"
				},
				{
					"id": 790290111,
					"content": "Oke, sepakat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
