			"dialogs": [
				{
					"id": 3890601,
					"content": "Kita tidak bisa maju lagi, sepertinya reruntuhan ini dilindungi oleh <color=#00E1FFFF>segel</color> yang sangat kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Apa ini perbuatan Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Bukan. Reruntuhan ini dulunya adalah bagian dari suatu kota kuno,. Dvalin kebetulan saja sekarang bersarang di reruntuhan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Reruntuhan ini bahkan lebih tua dari The Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt adalah kota tanpa pemimpin, tapi sebelumnya ada pemimpin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Kota ini dipimpin oleh seorang tirani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Lain kali ... kalau kita ada kesempatan akan kunyanyikan lagunya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Tanda di segel ini ... kalau pengetahuan arkeologiku tidak salah, sepertinya ini <color=#00E1FFFF>mesin penggerak cahaya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Kalau kita kembalikan <color=#00E1FFFF>bagian-bagiannya</color> terus <color=#00E1FFFF>dimasukkan lagi ke tempat asalnya</color>, kita bisa <color=#00E1FFFF>mengaktifkannya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Kita harusnya sudah hampir selesai dalam menyelesaikan upacara untuk mesin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Coba letakkan <color=#00E1FFFF>bagian terakhirnya</color> dan kita lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
