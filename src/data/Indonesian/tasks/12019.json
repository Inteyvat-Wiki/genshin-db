			"dialogs": [
				{
					"id": 120190101,
					"content": "Hmm? Apa kamu masih ingin membicarakan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Tentang Dango Milk ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Aku yakin sekali kalau dia sangat menyukainya. Hatinya pasti berbunga-bunga saat meminumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Yang sebenarnya ingin dia katakan adalah, \"Menurutmu seberapa cepat kamu bisa membuka cabang di Plane of Euthymia?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Tentang Raiden Shogun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Bonekanya ya. Kudengar sangat sulit untuk mengubah prosedur operasi boneka itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Sepertinya ini adalah pertama kalinya masalah ini muncul dalam sejarah. Bayangkan, masalahnya bahkan bisa membuat Ei yang pintar dan hebat itu kebingungan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Ini adalah masalah yang bahkan tidak bisa diselesaikan dengan Musou no Hitotachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Tentang novel ringan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Apa kamu tidak merasa terlahir kembali jadi Raiden Shogun itu seru? Itulah yang dibutuhkan sebuah novel ringan ... keseruan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Tapi kalau buat dia ... mungkin terlalu kekinian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Ooh, mungkin bagus juga kalau judul untuk sekuelnya \"Lahir Kembali Sebagai Guuji Yae\". Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "Sudah cukup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}