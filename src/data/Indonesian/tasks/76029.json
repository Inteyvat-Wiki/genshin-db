			"dialogs": [
				{
					"id": 760290401,
					"content": "(Suara lira? Columbina lagi main musik buat para Kuuhenki ya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(Terakhir kali ke sini, lira-nya belum dibenerin. Yah, pas itu Columbina belum kenal sama yang lain juga sih.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
