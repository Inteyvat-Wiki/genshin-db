			"dialogs": [
				{
					"id": 760290101,
					"content": "Salam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290102,
					"content": "Columbina mau keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Ya. Mau memperbaiki lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290104,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "Ada satu lira Kuuhenki yang rusak. Lira itu kesayangannya, jadi aku ingin memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290106,
					"content": "Kuuhenki banyak bakat juga ya ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Iya, dia sering main musik di sini. Kadang aku mengiringi dengan nyanyian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290108,
					"content": "Dari dulu Paimon mau bilang ini, kamu ... benar-benar manjain banget para Kuuhenki ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Selama ini mereka setia menemaniku. Dan sering membawakan benda-benda yang menghibur juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290110,
					"content": "(Lauma pernah cerita soal ini. Kuuhenki secara naluri memang selalu berusaha untuk membuat Dewi Bulan tersenyum.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Tapi kalau boleh nanya, gimana caranya kamu benerin lira? Bukannya kamu sama sekali enggak mau kelihatan sama orang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hmm ... biasanya aku minta tolong ke binatang kecil atau Kuuhenki untuk menaruh barang yang perlu diperbaiki di depan rumah pengrajinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290113,
					"content": "Biasanya, pengrajin akan segera memperbaikinya. Tapi kadang harus tunggu beberapa hari dulu sampai mereka sadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290114,
					"content": "Kok ribet ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Mau kami saja yang urus tidak nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290117,
					"content": "Santai, siapa tahu kami bisa benerin hari ini juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "Baiklah. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290119,
					"content": "Sama-sama. Ngomong-ngomong, biasanya kamu simpan barangnya di depan rumah pengrajin yang mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "Aku tidak tahu namanya. Di depan rumahnya ada lengan mekanik yang besar. Bentuk rumahnya bulat, seperti cangkang siput.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290121,
					"content": "(Wah, itu kan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "Sering tercium aroma Krumkake juga dari dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760290123,
					"content": "Paimon kayaknya ... tahu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
