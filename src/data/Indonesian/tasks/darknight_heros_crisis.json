			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Interogasi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "Bagaimana bisa kalian menemukanku? Favonian yang menyebalkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650402,
					"content": "Aku bukanlah Knights of Favonius. Katakan sejujurnya, apa rencana kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Ternyata kamu pernah membaca \"surat\" itu... Tapi jangan mengira aku akan memberi tahu kalian rahasia kami, khu khu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650404,
					"content": "Kamu sepertinya belum mengerti situasimu sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Gunakan <color=#00E1FFFF>Searing Hand</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "Apa kamu baru saja mengeluarkan api dengan Pyro Vision? Argh! Panas sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650601,
					"content": "Ayo kita lihat sampai kapan kamu bisa menjaga rahasia ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Gunakan <color=#00E1FFFF>Searing Hand</color> sekali lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Berhenti! Berhenti! Argh! Aku mohon... hentikan! Sakit sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650406,
					"content": "Gunakan <color=#00E1FFFF>Searing Hand</color> sekali lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Uhuk, uhuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4651403,
					"content": "Tidak perlu berpura-pura mati. Kobaran api seperti ini masih tidak akan mematikan... Loh? Dia sepertinya <color=#00E1FFFF>jatuh pingsan</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "Woi! Belum saatnya untuk tidur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Argh! Sakit!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650901,
					"content": "Baik, aku katakan! Aku katakan! Aduh, aduh, aduh... Cepat hentikan! Aku akan katakan <color=#00E1FFFF> semuanya</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650902,
					"content": "Abyss Order... Kami telah mengumpulkan orang-orang yang membenci \"Darknight Hero\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650903,
					"content": "Kami akan berkumpul di <color=#00E1FFFF>gerbang utama</color> besok malam sekitar pukul 10 untuk menyerang Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650904,
					"content": "Hanya itu yang aku tahu. Tolong jangan siksa aku dengan api itu lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Interogasi"
				},
				{
					"id": 4650905,
					"content": "Hanya itu? Hmm... Ya sudah, aku rasa kamu tidak berani menyembunyikan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "Coba <color=#00E1FFFF>interogasi</color> rencana serangan mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
