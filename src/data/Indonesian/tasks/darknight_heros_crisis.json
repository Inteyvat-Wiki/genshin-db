						4650302
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650302,
					"content": "Tersembunyi di reruntuhan seperti ini... memang gaya khas Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
