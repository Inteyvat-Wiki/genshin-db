			"dialogs": [
				{
					"id": 725010201,
					"content": "Kenapa Nona Moriko selalu memberiku tugas yang aneh-aneh sih ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "Kamu masih menggambar ilustrasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "Kamu kehabisan inspirasi lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "Ah! Pengembara, kok kamu bisa ada di sini?! Sudah lumayan lama kita tidak bertemu, kukira kamu sudah bertualang ke tempat lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "*huff* Coba kondisiku lebih sehat ya, aku bisa bebas jalan-jalan seperti kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "Dan jadi tidak akan ada juga Nona Moriko yang setiap hari datang dan menanyaiku urusan pekerjaan melulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "Ilustrasiku yang tempo hari sukses besar. Sejak itu banyak novelis yang datang minta gambar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "Padahal Nona Moriko sudah menolak banyak pekerjaan, tapi sisanya masih banyak sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "Selain itu, para penulis Yae Publishing House juga makin lama makin .... kreatif bikin karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "Awalnya kukira cerita-cerita mereka cuma bakalan berkutat di seputar Liyue dan Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Tapi sekarang tokoh utamanya sudah bertualang sampai ke Sumeru, bahkan ada yang sampai Fontaine segala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "Oke, mengeluhnya segini dulu. Pengembara, Kamera punya kamu masih bisa dipakai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "Bisa sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Mau minta tolong foto-foto lagi ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Hehe, imbalanku yang dulu itu lumayan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "Pengembara, aku mohon dengan amat sangat, minta foto-foto dari seluruh penjuru dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "Haiyah, baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Kan kamu bisa pasang permintaan di Adventurers' Guild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "Kalau begitu tolong ya! Hehe, buku catatanku sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "Kalau kamu tidak datang hari ini, aku juga bakal minta Nona Moriko cari kamu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "Wuah! Jangan dong, tidak bisa itu! Tolonglah, aku mohon! Aku sudah pernah pasang permintaan misi di sana, tapi tidak ada yang bisa pakai Kamera sejago kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "Kali iniii saja, ya? Ya? Kalau sampai lewat tenggat waktu, Nona Moriko kayaknya bakalan pindah rumah ke sini buat mengawasi aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "Perutku sudah tidak kuat makan Sakura Chazuke buatannya! Tolonglah, Pengembara, kamu harus membantuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Iya, iya, paham ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Fiuh ... lega deh. Tunggu sebentar ya, cari dulu buku catatanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}