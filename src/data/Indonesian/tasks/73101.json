			"dialogs": [
				{
					"id": 731010101,
					"content": "#Ah, Nara {NICKNAME}, bagaimana? kamu mau melihat pertempuran dengan Bulky Iron Chunk di dalam mimpi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010102
					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010102,
					"content": "Kami harus melepas selapis demi selapis Ararakalari yang kami gunakan pada Bulky Iron Chunk. Sampai terakhir bisa melawan Bulky Iron Chunk tanpa Ararakalari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010103,
					"content": "Jadi, kali ini Aradashan tidak akan membantumu menahan Bulky Iron Chunk. Tapi tidak apa-apa, Arasata, Arayuta, dan Arasaha masih tetap membantumu, mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aradashan"
				}
			]
		},
