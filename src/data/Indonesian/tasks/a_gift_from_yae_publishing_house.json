			"dialogs": [
				{
					"id": 706960101,
					"content": "Halo, halo. Lama tak jumpa. Ke mana saja kamu dalam perjalananmu baru-baru ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Kamu bercerita ke Miko tentang pengalamanmu di Dragonspine.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Aww. Kayaknya mereka semua menggemaskan sekali ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Pasti jadi petualangan yang seru buat mereka, datang dari berbagai tempat untuk bertemu dengan teman seperjuangan .... Ah, benar-benar kisah yang penuh dengan romansa masa muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "Sepertinya Kisah Pertarungan Soulblazer ini punya banyak penggemar setia ya. Mungkin sudah waktunya cetak ulang lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Untuk para penggemar yang begitu setia, sudah sepantasnya kuberikan ungkapan terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Bagaimana kalau aku kasih komik gratis? Hmm ... karena jumlahnya banyak, aku harus pastikan siapkan yang cukup buat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Ini semua cetakan edisi pertama, tidak akan bisa ketemu di tempat lain. Tolong jaga baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Pasti akan kubagikan ke yang lainnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
