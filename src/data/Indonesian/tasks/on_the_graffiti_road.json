			"dialogs": [
				{
					"id": 755040101,
					"content": "Hei! Sudah kembali ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040102
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040102,
					"content": "Dari tatapan kalian sih, pasti kalian sudah puas nikmati pemandangan, dan sudah dapat inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040103
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040103,
					"content": "Biasa saja sih, tapi seru kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040104,
					"content": "Setelah punya target, jadi benar-benar bisa lihat detail yang kalau dulu enggak bakal keperhatiin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040105,
					"content": "Pandangan kami juga lebih terbuka, dapat banyak banget bahan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040106,
						755040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040106,
					"content": "Tapi belum tentu semuanya bisa dipakai buat grafiti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				},
				{
					"id": 755040108,
					"content": "Oh, santai, jangan buru-buru! Kalian keliling Natlan juga kan tujuannya biar paham \"Avant-Garde\" tuh yang macam mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040109
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040109,
					"content": "Oh ya. Coba ceritain apa saja yang kalian lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040110
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040110,
					"content": "Menunjukkan catatan kalian di buku panduan grafiti dan foto-foto ke si Lemot Cetar ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						755040111
					]
				},
				{
					"id": 755040111,
					"content": "Tunggu ... Kalian bisa banget ya foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040112
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040112,
					"content": "Tidak kusangka kalian pengalaman banget pakai Kamera. Ini komposisi fotonya terbaik banget. Kayaknya tidak sadar sudah bikin sebagus ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040113
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040113,
					"content": "Kalau memang begitu, kalau aku banyak ngomong juga percuma. Malah bisa menghambat perkembangan kalian. Sebenarnya kalian cuma perlu sedikit panduan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040114
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040114,
					"content": "Ini catatanku, simpanlah. Siapa tahu kalian bisa membacanya sambil menikmati pemandangan sepanjang perjalanan. Siapa tahu bisa berguna kalau kalian mau jepret foto yang nyeni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040115
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040115,
					"content": "Eh? Paimon pikir kamu bakal periksain setiap fotonya, terus ... kasih kuliah panjang soal Avant-Garde bla-bla-bla gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040116,
					"content": "Paimon penasaran mau coba grafiti juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040117,
					"content": "Semua ini justru makin menunjukkan bakat kalian yang luar biasa! Kalian ini otodidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040118
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040118,
					"content": "Malahan kalau dikasih terlalu banyak teori dan panduan, potensinya bisa hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040119
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040119,
					"content": "Makanya, aku rasa aku mau ganti peran saja. Dari mentor jadi senior yang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040120
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040120,
					"content": "Nanti begitu inspirasinya meluap dan waktunya sudah tepat, langsung ambil cat dan kasih tahu dunia kehebatan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040121
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040121,
					"content": "Eh? Memangnya kita seberbakat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040122,
					"content": "Hehe. Berarti semua misi yang dulu kita dapat dari sutradara film dan seniman itu ada hikmahnya juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040123,
						755040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040123,
					"content": "Terima kasih pujiannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040125,
					"content": "Santai! Kalau dengan kemampuanmu sih, pasti bisa cepat ngerti dan menguasai estetika Avant-Garde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040126
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040126,
					"content": "Aku biasanya ada di kampung suku Penguasa Angin Malam untuk mempersiapkan pembangunan markas Aliansi Grafiti. Jadi kalau ada yang ingin ditanya, ke sana saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040127
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040127,
					"content": "Nanti kalau kalian datang, aku mau kasih perlengkapan bikin grafiti yang top markotop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040128
					],
					"speakerTitle": "\"Si Lemot Cetar Membahana\""
				},
				{
					"id": 755040128,
					"content": "Wah! Jadi markasnya mau dibangun di suku Penguasa Angin Malam? Oke, sudah ingat! Semoga lancar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040129,
						755040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040129,
					"content": "Senang banget deh kali ini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040131,
					"content": "Nanti kalau sudah santai, kita lihat catatan si Lemot Cetar yuk! Biar insting kreatifnya makin tajam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040132,
					"content": "Siapa tahu suatu hari nanti kita bisa cari duit dari grafiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755040130,
					"content": "Sampai jumpa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040124,
					"content": "Kami bakal lebih berusaha lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040107,
					"content": "Falsafah konsep Avant-Garde-ku masih perlu dipoles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				}
			]
		}
	]
}