			"dialogs": [
				{
					"id": 230260201,
					"content": "E-Ehem ... Kamu mungkin sudah tahu kalau setiap Darshan di Akademiya punya fokus penelitiannya masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260202,
					"content": "Jadi pertanyaannya, apa nama Darshan dengan peneliti Amurta terbanyak, dan juga yang memiliki peneliti terbanyak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260203,
					"content": "Amurta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Bagus, benar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260205,
					"content": "Armuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Uh, sayang sekali tapi cukup jauh dari jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260207,
					"content": "Atamur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Haha, sayang sekali, tapi salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
