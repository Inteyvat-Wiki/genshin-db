			"dialogs": [
				{
					"id": 230260401,
					"content": "Coba lihat ke atas, kamu bisa melihat pohon yang menopang Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260402,
					"content": "Pertanyaan selanjutnya mudah, tapi ada banyak orang yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260403,
					"content": "Dengarkan baik-baik, apa nama pohon yang menyokong Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260404,
					"content": "Pohon besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "Hahaha, ini nama yang bagus. Tapi sayang, jawabannya salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260406,
					"content": "Pohon Suci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
					"content": "Hahaha, hebat! Hebat! Jawabannya benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260408,
					"content": "Pohon Raksasa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260409
					]
				},
				{
					"id": 230260409,
					"content": "Yah, namanya cukup mantap, tapi sayang sekali kamu salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
		{
