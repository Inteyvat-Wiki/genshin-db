			"dialogs": [
				{
					"id": 230260301,
					"content": "Mungkin kamu pernah melihat \"peneliti keliling\" yang menyebut dirinya sebagai Driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "Sebenarnya, ada salah satu Darshan di Akademiya yang memiliki banyak Driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Darshan ini fokus belajar mengenai elemen dan meneliti berbagai hal yang berkaitan dengan elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Pertanyaanku adalah apa nama Darshan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Benar sekali, Spantamad. Darshan ini berisi para peneliti elemen yang menganggap bahwa Ketujuh Elemen Besar adalah dasar dari semua zat dan kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Haha, salah, peneliti Haravatat meneliti tentang bahasa, simbol dan logika ... percayalah padaku, itu sangat rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Ritasatya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Uh, sayang sekali jawabanmu salah. Ritasatya adalah markas utama para peneliti Rtawahist, inti penelitian mereka adalah tentang langit di atas kita ... hehe, kedengarannya menarik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
