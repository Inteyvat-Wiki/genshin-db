				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Apakah pertanyaan-pertanyaan ini terlalu sulit ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "Eh? Pengembara! Tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Kamu memanggilku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Benar! Hahaha, aku memintamu berhenti karena mau minta tolong padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Kamu kehilangan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Ah? Kenapa sepertinya kamu ... familier sekali dengan hal ini ya? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Bukan, bukan, aku tidak kehilangan barang, dan tidak kekurangan bahan penelitian. Kalau soal mencari inspirasi ... aku sudah mengumpulkan cukup banyak sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Ehem, sebenarnya demi membantu murid baru lebih cepat memahami kata-kata khusus yang digunakan di Sumeru, aku sedang menyiapkan sebuah \"Q&A\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "Sederhananya, aku ingin menggunakan format tanya jawab untuk menjelaskan kata-kata yang rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Dengan begitu proses belajar akan lebih efektif dan tidak membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Tapi, aku tidak terlalu mengerti tingkat kesulitan soal-soal ini ... jadi aku mau meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Aku tidak terlalu mengerti tentang Akademiya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Hahaha, tidak masalah. Kamu pasti akan lebih mengerti tentang Akademiya setelah menjawab pertanyaan-pertanyaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Jangan khawatir, soal-soal ini tidak terlalu sulit, cuma beberapa ... pertanyaan sehari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Kalau begitu ayo mulai, dengar baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Kenapa rasanya aku pernah melakukan hal seperti ini juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Maksudmu pertanyaan yang ditanyakan Svan dari Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Tapi kalau Svan sih waktu itu kan sudah ngasih jawabannya ke kita! Tapi kalau peneliti ini ... kayaknya enggak akan ngasih dulu jawabannya buat kita deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Kamu kekurangan material?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Kamu mau pergi mencari inspirasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
