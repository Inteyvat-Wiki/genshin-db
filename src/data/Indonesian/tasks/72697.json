			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#{NICKNAME}, Paimon! Akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970102,
					"content": "Pabrik Mainanku sudah mau buka nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970103,
					"content": "Pabrik Mainan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970104,
					"content": "*uhuk* Yah, aku dan Mesin Gede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970105,
					"content": "Aku sudah sederhanakan proses produksinya, dan berhasil memotong cukup banyak waktu yang dibutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970106,
					"content": "Sekarang memang belum sampai ke level \"langsung selesai\", tapi setidaknya sudah \"ngebut\" lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970107,
					"content": "Wuidih, keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970108,
					"content": "Lalu ada lagi, si Material Collector juga sudah aku perbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970109,
					"content": "Dulu kan kalian harus bolak balik setiap satu tahap selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970110,
					"content": "Rasanya tidak efisien, betul kan? Jadi aku bikin penyesuaian, dan sekarang prosesnya akan langsung berubah sesuai dengan material yang kalian kumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970111,
					"content": "Mengubah proses ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970112,
					"content": "Mengikuti material yang kami kumpulkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970113,
					"content": "Bingung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "Duh, gimana ya jelasinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970115,
					"content": "Contoh: tahap pertama perlu 10 Sunsettia, tahap kedua perlu elemen Hydro, dan tahap ketiga perlu dua inti dari Hydro Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970116,
					"content": "Terus anggap saja misalnya kalian sudah mengumpulkan 10 Sunsettia sambil mengenakan Material Collector. Nah, dalam kondisi begitu ... alatnya tuh otomatis tahu kalau tahap pertama sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970117,
					"content": "Selanjutnya ia bakal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970118,
					"content": "Aha! Ia pasti bakal langsung mulai ngumpulin bahan buat tahap berikutnya, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970119,
					"content": "Seratus buat Paimon! Alatnya akan langsung masuk ke tahap Pengisian Daya Elemen dan mulai mengumpulkan elemen Hydro. Setelah tahap itu selesai, dia akan langsung pindah ke tahap berikutnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970120,
					"content": "Langsung mulai tahap ketiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "Betul. Kalian tinggal cari 2 Hydro Slime dan hajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970123,
					"content": "Jauh lebih praktis ya, jadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970124,
					"content": "Iya kan. Aku sampai begadang loh demi ini. Aku tadinya sih sudah pilih nama, Alat Luar Biasa Anti Gagal 3-In-1.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970125,
					"content": "Material Collector memang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970126,
					"content": "Oh jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970128,
					"content": "Tapi kenapa Material Collector ini kamu kasih ke kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970129,
					"content": "Hehe ... Untuk sementara ini, aku tidak bisa pergi dari Ritou. Dan tidak bisa kumpulkan bahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970130,
					"content": "Ayo dong, tolong. Kamu akan dapat bagian dari keuntungan penjualan dan bonus satu mainan gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970141,
					"content": "Ingat voucher tempo hari? Kamu bisa tukar sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970142,
					"content": "Mainan hasil eksperimen kalian yang mana pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970131,
					"content": "Apa? Setelah kami capek-capek kayak kemarin, kamu cuma mau kasih kami duit seperak sama satu mainan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970132,
					"content": "#Keterlaluan! Ayo {NICKNAME}, yang beginian jangan diladenin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970133,
					"content": "Tunggu! Kalau aku kasih uang dan dua buah ... eh, tiga mainan deh. Mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970134,
					"content": "Halah. Yuk ah, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "Empat deh! EMPAT! Tolong jangan tekan aku lebih dari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970136,
					"content": "*huff* Kalau saja aku tidak punya utang, kamu mau ambil semua juga boleh kok. Tapi saat ini aku masih harus cicil pembayaran ke Asosiasi Perdagangan Internasional ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970137,
					"content": "Ya sudahlah. Aku mengalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "Denger ya, kami mau karena kami memang niat nolong kamu. Bukan karena butuh duit atau ingin mainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970139,
					"content": "Hehe. Makasih loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970140,
					"content": "Akhirnya bisa lega ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970121,
					"content": "Lanjut ke tahap Aktivasi Inti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}