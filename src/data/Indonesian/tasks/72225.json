			"dialogs": [
				{
					"id": 722250201,
					"content": "Tolong bantu kami soal pohon tenggeran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250202,
					"content": "Aku akan tetap bersama dengan Kak Ku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
