			"dialogs": [
				{
					"id": 722250101,
					"content": "Aww ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}! Paimon! Kalian datang tepat waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250103,
					"content": "Ada apa sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "Aw, aw, aw, kurasa pergelangan kakiku terkilir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250105,
					"content": "Kak Ku terluka lagi. Bisakah kalian membantu kami dan melakukan pemberian pada pohon tenggeran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250106,
					"content": "Aku sudah menduga akan seperti ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "Jangan khawatir, serahkan saja pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250109,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250110,
					"content": "Oh ya, bukannya kamu sensitif terhadap elemen, Ruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250111,
					"content": "Kenapa kamu tidak melakukannya sendiri saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250112,
					"content": "Uh ... Aku sudah melakukannya di upacara, tapi hasilnya tidak berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250113,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "Aku ... tidak tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250117,
					"content": "Baiklah. Biarkan kami yang bereskan urusan pohon tenggeran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250115,
					"content": "Kalau begitu, biar aku saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "Kuserahkan orang yang terluka itu padamu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
