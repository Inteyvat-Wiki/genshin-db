			"dialogs": [
				{
					"id": 150240901,
					"content": "Banyak banget kitab gulungannya. Paimon ingat sih pernah lihat yang kayak gini di kampung suku lain. Isinya catatan sejarah kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240902,
					"content": "Yang ini kayaknya beda dari yang lain. Gede banget. Kira-kira apa ya isinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240903,
					"content": "Warnanya juga beda ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240904
					]
				},
				{
					"id": 150240904,
					"content": "Iya, benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240905,
					"content": "#Sana tuh, ada yang kelip-kelip! {NICKNAME}, lihat enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240906,
					"content": "Mungkin itu cara keluar dari sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "Ngelihat apa yang tadinya enggak kelihatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
					"id": 150240908,
					"content": "Oooh, betul juga! Paimon setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
