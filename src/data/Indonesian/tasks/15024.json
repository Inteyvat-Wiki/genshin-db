			"dialogs": [
				{
					"id": 150240301,
					"content": "Halo, eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240302,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240303,
					"content": "Oke, mungkin dia enggak ngerti kita ngomong apa ... kayaknya sih otaknya lagi ke manaaa gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240304,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240305,
					"content": "Walah! Maaf, enggak maksud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "Siapa kalian! Berani-beraninya tidak sopan ke tetua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "Oh, maksudnya ... begitu ya. Baiklah. Maafkan kesalahpahaman barusan, ternyata kalian diundang ke sini, dan itu berarti tugasku untuk menyambut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Perkenalkan dulu, namaku Caholom, salah satu imam suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "Dan ini Tetua Iktomisaurus, Tlapopoctiztetl Yang Agung, totem hidup suku Penguasa Angin Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "Wah, namanya panjang betul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "Biasanya kami panggil beliau \"Tetua Tlapo\" saja supaya gampang. Kalian juga boleh memanggilnya demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "Kami diundang ke sini dengan cara yang ... tidak biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Ah, yang Anda maksudkan adalah kemampuan spesial tetua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "Tetua Tlapo sudah hidup berabad-abad lamanya, dia memegang rahasia yang bahkan kami para imam pun tidak mampu menerangkan. Reaksi Anda masih wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "Tapi satu hal, Tetua Tlapo telah menunjuk Anda berdua untuk menunaikan satu tugas penting. Oleh sebab itu, kalian akan diuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "Tugas apa dan ujian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Kalau berkenan, izinkan aku membawa kalian ke tempat kepala suku. Aku kira beliau lebih bisa menjawab pertanyaan-pertanyaan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Um ... oke deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Baiklah. Silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Gunakan kain tenun ini untuk segera berpindah ke Altar Obsidian, tempat kepala suku berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "Tenang, ini hanya salah satu dari sekian banyak kemampuan mistis suku kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
