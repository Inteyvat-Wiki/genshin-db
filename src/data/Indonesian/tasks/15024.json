						"sceneId": 3,
						"position": [
							-1680.302,
							13.722,
							9690.748
						],
						"pointId": 9383
					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "Fiuh, keluar juga akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "Sesuai dugaan. Kalian memang layak mendapat tugas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "Lalu teorimu? Terbukti belum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "Ya. Kalian melihat banyak kitab gulungan tenun yang bentuknya beda di sana. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "Betul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "Kitab gulungan khusus ini adalah peninggalan leluhur. Setelah diselidiki, aku mendapati bahwa yang membedakannya adalah penggunaan warna yang tidak dipakai untuk kitab-kitab biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "Warna misterius yang bahkan tidak bisa dilihat oleh kebanyakan orang. Aku sendiri harus pakai teknik spesial untuk membuktikan keberadaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "Tapi ada orang yang dari lahir sudah bisa melihatnya. Dan itulah kenapa aku menguji kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "Maksudnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "Ruang yang baru kalian masuki itu adalah tempat penyimpanan kitab gulungan tenun khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "Berabad lalu, Shaman agung Huitzilin memasang perangkat keamanan khusus agar siapa pun yang masuk tanpa izin akan terjebak di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "Perangkatnya masih ada sampai hari ini. Aku memang belum tahu cara kerjanya, tapi kalau cuma matikan atau nyalakan saja sih bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "Setelah seseorang terjebak di dalam, dia tidak bisa keluar tanpa bantuan orang luar ... kecuali orang itu bisa melihat warna khusus tersebut, sama seperti sang shaman agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "Aku paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "Berarti sudah jelas kalau kamu punya keahlian ini. Maka dari itu, aku bisa menyimpulkan kalau Tetua Iktomisaurus bisa melihat kemampuan ini dalam diri seseorang, dan atas dasar itulah dia menunjuk penenun kitab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "#Kekuatan super lagi nih ceritanya? {NICKNAME}, kamu memang penuh misteri ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "Tapi punya kemampuan seperti ini bukan berarti kita ngerti gimana caranya menenun kitab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "Jangan dipikirkan. Cara menenun kitab itu kurang lebih sama dengan kitab biasa. Perbedaannya adalah, obat pewarna khusus yang melahirkan warna yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "Kalau kecurigaanku terbukti, obat pewarna itulah kunci untuk menenun kitabnya ... dan kekuatan khususmu ini adalah kunci untuk mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "Proses pewarnaannya juga agak beda, tapi harusnya tidak ada kendala berarti. Asalkan kalian bisa mendapatkan bahan pewarnanya, aku bisa bantu untuk prosesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "Oke deh. Kami nurut saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "Bagus. Kalau begitu silakan manfaatkan kemampuanmu untuk mencari bahannya, sementara aku akan cari orang untuk menyiapkan kain uji coba pewarnaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "Kita bikin sampel untuk menguji dugaanku, dan jika berhasil, kita bisa mulai menenun kitabnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "Kalau setuju, imbalan yang layak akan menanti kalian setelah proyek ini selesai. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "Punya kemampuan berarti punya tanggung jawab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "Setuju! Terutama kalau ada hadiahnya ... eh, hadiahnya apa ya kalau boleh tahu? Makanan? Duh, Paimon sih inginnya makanan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "Melihat betapa pentingnya urusan ini bagi suku kami, aku rasa Mora dalam jumlah yang cukup banyak layak untuk diserahkan sebagai hadiah ... masa itu tidak lebih bagus dari makan gratis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "Duit juga boleh dong! Nah, gimana caranya nyari bahan-bahannya? Apa kami harus keliling Natlan sampai tiba-tiba ketemu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "Untungnya tidak. Aku sudah tandai lokasi yang terindikasi adanya bahan tersebut, dan sudah atur orang untuk bawa kalian ke sana juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "Dia menunggu di luar. Silakan berangkat kalau sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "Waktu di dalam tadi, aku memang melihat ada warna yang beda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
