				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caholom"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1612.193,
							16.683,
							9735.48
						],
						"pointId": 10002
					},
					{
						"sceneId": 3,
						"position": [
							-1607.536,
