				{
					"id": 150240107,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Aduh ... Paimon pingsan berapa lama tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "#{NICKNAME}, Paimon saling pandang sama si bayi Iktomisaurus sedetik doang, terus tiba-tiba Paimon kayak disedot gitu ke tempat aneh yang ada Iktomisaurus super gedenya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240110,
					"content": "Iya, sama ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "Kenapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}? Kenapa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240113,
					"content": "Di sana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "Lihat! Kayaknya si bayi Iktomisaurus itu mau kita ikut. Jiwa petualang Paimon bilang kita harus ikutin dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240116,
					"content": "Yuk kita kejar dia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "Kita dipanggil ....",
					"roleType": "TALK_ROLE_PLAYER",
