							9734.944
						],
						"pointId": 10003
					},
					{
						"sceneId": 3,
						"position": [
							-1629.187,
							16.852,
							9739.233
						],
						"pointId": 10004
					},
					{
						"sceneId": 3,
						"position": [
							-1644.502,
							15.092,
							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Wah, apaan yang barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "Salah satu tugas rutin seorang imam. Kami mencoba menghubungi arwah para leluhur untuk minta petunjuk dan pencerahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "Kepala suku ada di sebelah sana. Silakan tunggu di sini sementara aku bicara dengan beliau, sebentar saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Yah, Penguasa Angin Malam memang semisterius itu ya ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Baiklah, aku sudah memberitahukan kepada kepala suku kenapa kita ada di sini, dan kalian telah diperkenankan berbicara dengan beliau. Lewat sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "Jadi kalian berdua yang ditunjuk? Namaku Biram, kepala suku Penguasa Angin Malam. Terima kasih karena sudah bersedia menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "Tinggi ... banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Ya, beda dari kebanyakan. Aku tahu. Tapi tentu saja, kalian tidak perlu takut atau curiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "Oh, jelas enggak! Bukan gitu maksudnya. Maaf, mulut Paimon memang kadang enggak ada remnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "\"Ditunjuk\" ini maksudnya buat kerja apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "Ah, Caholom sudah memberitahuku perihal itu. Sebagai pendatang, lazim bila ini pertama kalinya kalian mendengar tentang \"penunjukan\" seperti ini. Aku yakin ini semua terasa membingungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "Sepanjang sejarah kami, hanya warga suku Penguasa Angin Malam saja yang pernah ditunjuk untuk menjalankan tugas. Ini pertama kalinya ada orang luar yang dipilih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Biar aku jelaskan. Suku ini punya tradisi mencatatkan riwayat sejarah ke dalam bentuk kitab gulungan tenun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "Dan bukan hanya sejarah kami semata. Semua legenda dan kepahlawanan suku-suku lain juga kami yang mencatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "Tradisi ini sudah ada selama berabad-abad. Kami memandangnya sebagai tugas yang mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Namun ketika ada peristiwa besar yang skalanya mencakup seluruh Natlan, kami mencatatnya ke dalam gulungan berbeda, yang diperuntukkan khusus untuk tujuan tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "Dan kitab ini hanya bisa ditenun oleh orang yang ditunjuk oleh Tetua Iktomisaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Ketika Tetua Iktomisaurus merasakan perubahan besar di aliran Ley Line, maka beliau akan mengeluarkan pernyataan resmi tentang penunjukan penenun kitab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "Wah, itu artinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "Tetua Tlapo sudah lama merasakan perubahan di Ley Line, tapi belum kunjung menunjuk penenun kitab ... sampai kalian tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "Oke, tapi kamu harus tahu dulu kalau ... kami enggak paham sama sekali tentang menenun kitab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "Dan aku sama sekali tidak terkejut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "Dalam dua ratus tahun semenjak Tetua Tlapo memegang posisinya, tidak ada satu orang pun yang beliau tunjuk, yang punya pengalaman menenun kitab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "Berarti ada dua ratus tahun sejarah yang enggak tercatat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "Tidak, semuanya berhasil mengumpulkan kitab tepat waktu. Dan semuanya mengaku bahwa mereka mendapat \"tuntunan roh suci\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Wah ... suku ini makin ke sini makin misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Ya, itu ... justru bagian itunya yang meresahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "Bahwa kami harus mengandalkan sesuatu yang sifatnya abstrak seperti \"tuntunan roh suci\" untuk mencatat peristiwa bersejarah yang penting ... sangat meresahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Wah ... kaget juga dengarnya kalau kepala sukunya sendiri yang ngomong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Aku bisa bayangkan. Kalian mungkin melihat suku Penguasa Angin Malam sebagai masyarakat yang penuh misteri, yang berbangga diri atas tradisi sihir kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "Tapi aku ini pengecualian. Aku kepala suku, tapi kalau soal tradisi, aku berdiri di sisi perubahan dan reformasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Sudah banyak upaya yang aku keluarkan untuk menafsirkan misteri-misteri yang meliputi suku ini. Dengan melakukan itu, aku berharap agar dapat terbentuk aturan yang lebih jelas, sehingga tradisi kami dapat terus lestari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Wah, keren banget loh usahanya! Jadi. apa kamu sudah tahu rahasia di balik misteri \"tuntunan roh suci\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "Sayangnya belum. Aku sudah selidiki sejak lama, tapi sampai kini masih belum bisa mengungkap seperti apa sebenarnya \"tuntunan\" tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Hanya sedikit saja peristiwa yang dicatatkan ke dalam kitab khusus selama bertahun-tahun, dengan jarak antar kitab yang sampai berdasawarsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "Dan begitu penenun kitab yang berikutnya ditunjuk, waktuku sebagai kepala suku juga sudah lama berakhir. Aku sudah tidak bisa lagi menyelidiki sampai menyeluruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "Jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Aku memang belum sampai ke intinya, tapi sejauh ini ada kemajuan. Satu-satunya cara untuk mengembangkan teoriku lebih jauh adalah jika yang ditunjuk mau bekerja sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "Maka dari itu, kami diuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Betul sekali. Tidak perlu khawatir, ini cuma salah satu media untuk membuktikan dugaan. Tidak makan waktu, dan tidak membahayakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "Baiklah. Harus ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "Aku bisa jelaskan langsung di tempatnya nanti. Tapi pertama, mohon tunggu sebentar. Aku mau melepas Jubah Pelindung Jiwa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Jubah ini salah satu pusaka kebudayaan kami yang diturunkan dari kepala suku ke kepala suku. Hanya boleh dikenakan ketika memimpin upacara tertentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram melepaskan jubahnya dan memberikannya ke imam.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Silakan ikut aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "Lihat kain ini? Kalau disentuh, kalian akan masuk ke ruang tersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "Ujiannya sederhana saja. Cari jalan untuk keluar dari ruang tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "Gitu doang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "Aku tekankan bahwa ujiannya ini tidak semudah kedengarannya. Kalau tidak bisa keluar, aku yang akan mengeluarkan kalian dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Tapi jika itu terjadi, misteri ini akan semakin sulit dipecahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Kami coba deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Bagus. Silakan, sentuh kainnya untuk memulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
			"id": 1502406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502409",
							"2"
						],
