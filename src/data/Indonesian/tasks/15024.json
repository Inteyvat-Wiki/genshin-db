				},
				{
					"id": 150240102,
					"content": "Wah, bayi Iktomisaurus ... lucu banget! Tapi kenapa ngelihatin kita terus ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
