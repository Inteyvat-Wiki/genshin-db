			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "Kalian berdua bukan orang biasa, jika terus seperti ini, aku akan mengalami kerugian besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120030802,
					"content": "Kekuatan mereka hampir habis! Ayo selesaikan mereka! Lalu kita ambil Cor Lapis itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030803,
					"content": "Hubunganmu dengan orang Fatui hanya sekadar urusan bisnis saja! Aku tidak meminjamkan bawahanku padamu hanya untuk menimbulkan masalah begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120030804,
					"content": "A-apa? Tuan, semua yang kulakukan, semata-mata adalah untuk menyelesaikan pesanan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030805,
					"content": "Kalau begitu, kamu pikirkan sendiri caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "Fatui Agent"
				},
				{
					"id": 120030806,
					"content": "Ja-jangan pergi! Ah!!! Tuan!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030807,
					"content": "Loh, Tuan?! Apa yang Anda lakukan di sini? Apa Anda terluka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030808,
					"content": "#Berkat bantuan {F#Nona}{M#Tuan} muda ini aku selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030809,
					"content": "Tuanku?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030810,
					"content": "Tuanku?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "Ka-kamu pimpinan dari Feiyun Commerce Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030813,
					"content": "Benar, aku murid dari Klan Guhua dan putra kedua dari pemimpin Feiyun Commerce Guild, Xingqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030814,
					"content": "Sial, ternyata kamu sudah memperhitungkan semua ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030815,
					"content": "Gentry Maocai, bisnis kotor semacam ini sungguh tidak pantas untuk seorang pebisnis, jadi aku akan menyelesaikannya dengan cara bisnis juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030816,
					"content": "Aku sudah merinding membayangkan apa yang orang Fatui akan lakukan padamu jika kamu gagal untuk menyediakan Cor Lapis pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030817,
					"content": "Sial... baiklah, katakan padaku bagaimana kamu ingin menjualnya padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030818,
					"content": "Karena kamu memaksa Chang the Ninth untuk memberikan diskon 70%, aku akan menggunakan cara yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030819,
					"content": "Tiga kali lipat dari harga pasar, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030820,
					"content": "Kamu benar-benar sengaja! Sungguh keterlaluan! Ka-kamu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030821,
					"content": "Sederhana saja, jadi kamu beli atau tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030822,
					"content": "Aku... huh, baiklah, baiklah! Aku janji, aku pasti akan membayarnya, puas sekarang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030823,
					"content": "Mewakili Feiyun Commerce Guild, aku berterima kasih atas kerja samamu dan kuharap kita masih bisa berbisnis dengan baik di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030824,
					"content": "Ka-ka-ka-ka-kamu... benar-benar pimpinan dari Feiyun Commerce Guild?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030825,
					"content": "Jadi sejumlah Mora yang kami gunakan waktu itu, semua itu uangmu ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030826,
					"content": "Ah, itu hanya hal kecil. Dengan begini aku bisa mendapat bisnis yang menguntungkan, dan juga bisa memberi pelajaran kepada Gentry Maocai. Sekali dayung, dua tiga pulau terlewati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030827,
					"content": "Ternyata tampang bisa menipu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "Kamu baik sekali, kamu mempunyai hati Knight yang patut dikagumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030831,
					"content": "Ah! Selama ini Paimon mengataimu si kutu buku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030832,
					"content": "Paimon pernah baca di salah satu novel bela diri jika orang kaya sepertimu marah, kamu akan memotong tangan atau kaki orang tersebut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030833,
					"content": "Aduh bagaimana nih?! Maaf! Maafkan Paimon! Sungguh Paimon minta maaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030834,
					"content": "Tenanglah, kamu bisa terbang, kakimu tidak begitu diperlukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030835,
					"content": "#AHH!! {NICKNAME}, tolong Paimon!! Ini sungguhan, Paimon tidak bercanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030836,
					"content": "Dia bercanda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "Baiklah, bercandanya sudah cukup! Kali ini aku benar-benar berterima kasih kepada kalian berdua, kalian sudah banyak membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030839,
					"content": "Legenda Tombak Dewa ini juga bagus sekali, aku puas. Maaf merepotkan kalian, tolong kembalikan buku ini pada Chang the Ninth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030840,
					"content": "Kamu masih mau menyuruh kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "Sebenarnya aku tidak berbuat apa-apa, jadi bukan aku yang seharusnya menerima rasa terima kasihnya. Kalian berdua melakukan segalanya, sampai kepada yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030842,
					"content": "Bisa berteman dengan kalian yang begitu berjiwa kesatria dan pemberani sudah cukup membuatku puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030843,
					"content": "Tuan, maaf mengganggu, mengenai ayah Anda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030844,
					"content": "Tentang itu, tolong beri tahu ayahku, kali ini aku sudah menyelesaikan masalahnya dan di saat bersamaan juga telah mendapatkan sejumlah uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030845,
					"content": "Mungkinkah tindakan baikku kali ini bisa menjadi kompensasi dari pelanggaranku sebelumnya dan aku bisa mendapatkan kebebasanku lagi? Legenda Tombak Dewa mengatakan sebuah dunia yang misterius dan aku ingin menyelidikinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030846,
					"content": "Kamu berkata begitu, tapi sebenarnya kamu hanya malas pergi saja kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030847,
					"content": "Hahaha, bagaimana jika kukatakan bahwa tidak hanya terima kasih saja tapi juga ada hadiah yang menunggumu di tempat Chang the Ninth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030848,
					"content": "Hadiah! Ka-kalau begitu masih oke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030849,
					"content": "Hah, sepertinya apa pun yang saya katakan tetap tidak bisa menahan Anda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030850,
					"content": "Seharusnya kamu bilang dari awal jika Xingqiu adalah Tuan kalian...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "A-aku juga tidak menyangka bahwa kalian tidak tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030852,
					"content": "Terima kasih karena telah mengembalikan buku ini untukku. Aku pergi dulu, semoga kita bertemu lagi lain waktu, teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030837,
					"content": "Sebenarnya buku seperti apa yang kamu baca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "Apa anak-anak orang kaya sekarang semua tidak belajar kaligrafi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "Hahaha, jangan mengerjaiku lagi. Semua keluargaku dapat membaca tulisanku, itu adalah ciri khas khusus milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030811,
					"content": "...Aku sama sekali tidak menduganya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
