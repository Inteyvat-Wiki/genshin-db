				},
				{
					"id": 120004502,
					"content": "Sebelumnya aku sungguh tidak sopan pada kalian, maafkan aku, semoga kalian dapat memaafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
