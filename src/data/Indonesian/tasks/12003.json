		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
