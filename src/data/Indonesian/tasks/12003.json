			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "Pertunjukan terakhir ini, tidak akan lengkap rasanya tanpa kehadiran kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030402,
					"content": "Benar sekali, kami berdua melakukan semuanya, kamu sebenarnya melakukan apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030403,
					"content": "Ya... tentu saja membaca Legenda Tombak Dewa sampai selesai, aku berhasil membacanya sampai selesai dan aku puas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030404,
					"content": "Divine Halberd dan Ominous Sword, Mir dan Weiyang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030405,
					"content": "Kelima volume pertama dapat dibilang luar biasa, tapi volume keenam, tidak ada kata yang cocok untuk mendeskripsikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030426,
					"content": "Kita sungguh beruntung, memiliki penulis yang begitu berbakat dan memberkahi kita dengan karya yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030427,
					"content": "Terus apa hubungannya ini dengan Gentry Maocai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030406,
					"content": "Aku hanya merasa, jika ada sesuatu yang luar biasa, kita harus memberikan penghargaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030407,
					"content": "Sisanya terserah padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "Berkat kamu, sepertinya semua akan berjalan sesuai yang diharapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030411,
					"content": "E-eh? Ke-kenapa hanya Paimon yang tidak mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030412,
					"content": "Ba-baiklah, jadi kenapa kita harus menonton pertunjukan terakhir di gudang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030413,
					"content": "Pikirkan saja, Gentry Maocai mencari Cor Lapis di seluruh Pelabuhan Liyue, dan dia tidak menemukan satu pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030414,
					"content": "Sehingga dia panik — dia tidak akan bisa menyelesaikan kontraknya tanpa bahan baku. Jika dia tidak menyelesaikan kontraknya, dia harus berurusan dengan orang Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030415,
					"content": "Lalu dia mendengar Feiyun Commerce Guild adalah pelakunya. Dia pasti menjadi panik dan cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030416,
					"content": "Gentry Maocai adalah seorang tokoh besar dan kuat dalam dunia bisnis. Tidak ada seorang pun yang berani melawannya seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030417,
					"content": "Tak peduli apakah dia ingin membalas dendam atau menyelesaikan masalah, dia tetap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030418,
					"content": "Jadi ternyata kalian, kalian yang ikut campur dalam urusan Chang the Ninth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030419,
					"content": "Oh lihat, baru saja dibicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030420,
					"content": "Aku berkeliling untuk mencari Cor Lapis, lalu aku baru tahu bahwa Feiyun Commerce Guild sudah membeli semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030421,
					"content": "Jelas-jelas Cor Lapis bukan bahan baku yang langka, tapi sekarang seluruh persediaannya habis? Apa maksudnya ini?! Apa kamu melakukan ini dengan sengaja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030422,
					"content": "Kami hanya melindungi yang membutuhkan. Setelah melihat ketidakadilan seperti itu, sangat wajar jika kita membantu dia yang menjadi korban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030423,
					"content": "Aku masih ingat, salah seorang bawahanmu mengatakan bahwa ini semua belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030424,
					"content": "Huh, kamu benar-benar cari mati, baiklah kalau begitu aku juga tidak akan ragu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030425,
					"content": "Tuan, jika berkenan, mari kita ambil Cor Lapis mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120030409,
					"content": "Apa akhir dari bukunya bagus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "Lumayan bagus... aku hanya berharap saat rencana kita sudah tiba waktunya, akan sesuai dengan yang kita harapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
