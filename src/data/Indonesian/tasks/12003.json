			"dialogs": [
				{
					"id": 120004501,
					"content": "Sungguh terima kasih banyak, dengan begini, masih ada harapan untuk bisnisku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
