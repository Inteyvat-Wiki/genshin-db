			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "Akhirnya kalian datang juga! Pagi tadi, orang dari pegadaian datang dan mengembalikan semua koleksi buku milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030902,
					"content": "Aku yakin semua ini berkat bantuan kalian! Terima kasih banyak, sungguh terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030903,
					"content": "Tak perlu sungkan, kami senang bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "Ah, tolong jangan berkata begitu, bagiku ini hal yang penting sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030906,
					"content": "Keluarga Chang awalnya adalah keluarga terkemuka di Liyue. Sayangnya, setelah aku mengambil bisnis keluarga sebagai pewaris, aku banyak mengalami kemunduran bisnis sehingga membuatku menghabiskan banyak warisan dari leluhur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030907,
					"content": "Sejak itu bertahun-tahun aku terus menabung dan berharap untuk mengembalikan kejayaan keluarga kami seperti dulu... Pada akhirnya, semua bergantung pada transaksi bisnis Cor Lapis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030908,
					"content": "Jika bukan karena kalian, mungkin dataran ini akan menjadi tempat peristirahatan terakhirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030909,
					"content": "Wah tak disangka kamu seorang tuan muda juga ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030910,
					"content": "Eh? Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030911,
					"content": "Ah tidak, tidak! Oh ya, ini bukumu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030912,
					"content": "Ohh, Legenda Tombak Dewa! Aku sudah heran kenapa dia tiba-tiba hilang, kupikir orang dari Guhua itu ingin mencuri dariku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030913,
					"content": "Klan Guhua... apa mereka ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030914,
					"content": "Seni bela diri ini sudah berumur ratusan tahun, dulu mereka benar-benar berjaya, tapi sekarang hampir tidak ada yang mengenali mereka lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030915,
					"content": "Untuk bisa membangkitkannya lagi, kamu memerlukan orang baru, tapi sulit sekali menarik orang-orang berbakat kepada seni yang sudah mati... Jadi ini seperti sebuah lingkaran setan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030916,
					"content": "Anak-anak dari Klan Guhua sekarang ini... sama seperti Xingqiu tadi, dia bilang ingin membalas budi baik tapi ternyata kamulah yang bertanggung jawab untuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030917,
					"content": "Sepertinya tidak begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "Ah, sudahlah itu tidak penting. Oh ya, kalian mau Panduan Wisata Teyvat edisi Liyue bukan, aku sudah menyiapkannya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030920,
					"content": "Ini kuberikan pada kalian secara cuma-cuma. Lalu, ada sedikit hadiah sebagai tanda terima kasih dariku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030921,
					"content": "Terima kasih, akhirnya jerih payah terbayar juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "Semua batu mineral sudah terjual dan koleksi buku milikku kembali, sulit dipercaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030924,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030925,
					"content": "Apa itu? Paimon seperti melihat ada sesuatu yang jatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030926,
					"content": "Ah tidak, tidak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030927,
					"content": "(Bocah itu... apa dia mungkin...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120030922,
					"content": "Aku hampir saja lupa mengenai hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "Mungkin kebangkitan Klan Guhua sudah dekat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "Sebenarnya kami juga tidak melakukan apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
