			"dialogs": [
				{
					"id": 728070301,
					"content": "Kamu... ah, pengembara dari luar negeri, ada perlu apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Tentang surat dari Nona Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Apa Nona Hiiragi yang memintamu mengirimnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Tulisan ini, memang dia... Syukurlah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "Terima kasih karena telah datang, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Soal \"Surat Jalan\"...karena ini permintaan Nona Hiiragi sendiri, tentu saja aku sudah menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Tapi aku tetap perlu menyiapkan \"Surat Jalan\" ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Begini saja, kamu tunggu aku di \"Kiminami Restaurant\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Kenapa harus ke sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Aku... mau meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Sebenarnya... ada beberapa barang yang mau kukirim juga ke Nona Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Awalnya aku menulis surat, dan memesan camilan pada Nona Kiminami, bersiap mengirimkan semuanya ke Nona Hiiragi sebagai hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Tapi mungkin ayah tidak senang kalau tahu aku mengirim surat ke Nona Hiiragi... Kebetulan sekali kamu datang saat aku memikirkan cara mengirimnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "Cuma sebuah hadiah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Ayah tidak suka aku berhubungan dengan Nona Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Aku mengerti kekhawatirannya, sebagai bagian dari Klan Kujou, dan juga salah satu pelaksana Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Sedangkan Nona Hiiragi berstatus putri Klan Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Kalau aku berhubungan dekat dengannya, kami bisa dimanfaatkan orang lain dan dijadikan bahan gosip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Walaupun ini hanya sebuah hadiah, tapi di mata orang lain, tidak sesederhana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Haha, lebih baik aku tidak membicarakan hal ini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "Pengembara, tunggu aku di \"Kiminami Restaurant\", akan kuantar \"Surat Jalan\" padamu setelah mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Apa ayahmu galak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Ayah... pada dasarnya galak. Aku bisa mengerti kenapa dia tidak terlalu suka aku berhubungan dengan Nona Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Aku adalah bagian dari Klan Kujou dan juga salah satu pelaksana Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "Sedangkan Nona Hiiragi berstatus putri Klan Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070324,
					"content": "Kalau aku berhubungan dekat dengannya, kami bisa dimanfaatkan orang lain dan dijadikan bahan gosip.",
					"roleType": "TALK_ROLE_NPC",
