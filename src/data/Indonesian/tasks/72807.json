					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Maksudmu Tuan Kamaji? Ada perlu apa mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Menunjukkan surat tulisan tangan)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Maksudmu ini surat yang ditulis Nona Hiiragi Chisato? Ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Tapi, kalau memang benar surat ini ditulis Nona Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Soal ini... sebaiknya kamu langsung tanya Tuan Kamaji, belakangan ini dia sering jalan-jalan di jembatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
