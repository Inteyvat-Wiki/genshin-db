			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Oh! Kualitas Raw Meat ini bagus sekali... terima kasih banyak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Aku akan memasak beberapa makanan yang enak! Mungkin setelah makan, kerjaku juga jadi lebih cepat, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Memang ada hubungannya ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Kalau makan daging, pasti akan jadi lebih bertenaga! Sebelumnya aku cuma makan ikan, rasanya tanganku bahkan tidak kuat mengangkat palu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Tadinya aku sudah khawatir, jangan-jangan patungnya akan jadi lebih lama ... Tapi sekarang sudah tidak masalah berkatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Sebenarnya, aku juga sedang bekerja untuk seekor kucing sih, tapi tetap saja tidak boleh menunda-nunda tenggat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Apa pun itu, aku akan menyelesaikan pengerjaan patung ini secepat mungkin, Nona Pendeta bilang jika patungnya sudah selesai, hal yang baik pasti akan terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Meskipun aku tidak tahu hal baik apa yang akan terjadi, tapi ... hehe, aku benar-benar menantikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Nanti, kalian juga harus datang ke kuil untuk melihat hasil karyaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
