					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "Ini... benar-benar menakjubkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140102,
					"content": "Apa patungnya sudah jadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Waktu baru mulai, batu itu sama sekali tidak mirip seperti diriku. Tapi seiring waktu, perlahan-lahan mulai menjadi mirip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140104,
					"content": "Kalian para manusia memang sangat hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140105,
					"content": "Memang sangat bising, tapi diriku ini pengganti kepala pendeta. Diriku tidak mempermasalahkan hal kecil seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140106,
					"content": "Berikan ikan-ikan ini pada manusia tinggi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140107,
					"content": "Ini adalah sesuatu yang bagus... dan mungkin bisa dianggap sebagai \"ambalannya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140108,
					"content": "Cuma ikan saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Miaw, diriku meminta Konbumaru untuk membawa anak-anak itu menangkap beberapa ekor burung, tapi tidak berakhir baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140110,
					"content": "Bagi mereka menangkap ikan itu lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140111,
					"content": "Yang benar itu \"imbalan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Meong meong meong, menyebalkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140113,
					"content": "Berikan saja padanya. Ikan-ikan ini adalah benda yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
