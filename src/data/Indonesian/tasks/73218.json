			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "\"Aku sudah memaafkan kesalahanmu atas nama Raja Botol Mistis. Tapi siapa yang akan memaafkan kita?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
