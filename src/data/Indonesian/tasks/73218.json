				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "\"Dijual: paket petualangan padang pasir. Solusi segala kendala untuk para pengelana dan pedagang yang mau ke gurun pasir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181002,
					"content": "\"Bagi seluruh pembeli paket, kami berikan jaminan keselamatan selama perjalanan bertualang Anda. Kami akan mengganti rugi sepuluh kali lipat jika Anda mendapatkan barang tiruan. Pesan sekarang juga dan dapatkan diskonnya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"Aku dengar dulu Akademiya mendirikan rumah sakit di padang pasir untuk menangani penyakit Eleazar. Tapi entah karena alasan apa tempat itu sekarang ditelantarkan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181102,
					"content": "\"Menurut cerita penduduk Desa Aaru, ada seorang pasien yang sembuh dari Eleazar melarikan diri dari sana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181103,
					"content": "\"Kalau ada informasi yang ditinggalkan di sana, mungkin saja kita bisa tahu cara menyembuhkan penyakit ini ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"Mereka bilang salah satu dari penduduk Desa Aaru menjadi pejabat tinggi Akademiya. Kita orang penduduk gurun mungkin saja akan hidup dengan lebih baik di masa mendatang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181202,
					"content": "\"Pendapatanku tidak seberapa dari memindahkan bebatuan ini tiap hari. Tapi dengan sekali pesanan untuk membawa barang seperti kapsul pengetahuan, aku akan punya cukup uang untuk menikah saat aku kembali ke kampung halaman.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181203,
					"content": "\"Tapi aku dengar pejabat itu bertugas memberantas penyelundupan. Aku rasa dia tidak akan ada di pihak kita.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181204,
					"content": "\"Cih, kita orang penduduk gurun bisa jadi seperti ini karena tidak bersatu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Mohon perhatian, bagi para petualang yang hendak menuju padang pasir, semua aktivitas petualangan ke Great Red Sand harus terdaftar di Akademiya, sesuai dengan peraturan Akademiya yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181302,
					"content": "Semua benda pusaka yang ditemukan di padang pasir pada dasarnya adalah milik Akademiya, tidak ada yang boleh mengklaim hak milik atasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181303,
					"content": "Untuk alasan keamanan, Akademiya telah merilis larangan akses ke wilayah padang pasir, kecuali ke Great Red Sand. Dilarang keras bepergian ke daerah tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181304,
					"content": "Akademiya tidak bertanggung jawab atas segala hal di luar keinginan yang terjadi akibat tidak mengindahkan anjuran ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
						],
						"stepId": 7321814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"Dengar-dengar ada beberapa orang yang untung besar dengan berjualan lemak kepompong pasir di kota. Sekarang, mereka sudah punya rumah mewah dan mengaku punya marga. Mereka bahkan mengaku-ngaku sebagai sahabat karib dari orang Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181402,
					"content": "\"Kenapa aku yang sudah menghabiskan sebagian besar hidupku untuk bekerja mengangkut batu di sini masih saja miskin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181403,
					"content": "\"Apa yang kamu tahu? Lemak kepompong pasir adalah bisnis yang mendapatkan lisensi khusus dari Akademiya. Kamu bahkan tidak terpikir untuk berkecimpung di dalamnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181404,
					"content": "\"Kalau kamu mau dapat uang, kita selundupkan buku saja. Kalau berhasil, paling tidak kita tidak perlu lagi mengangkut batu di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
						],
						"stepId": 7321815,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"Anak muda sekarang sukanya berpikir terlalu jauh. Kita orang Desa Aaru, kalau bukan untuk melindungi Greater Lord Rukkhadevata, dari awal sudah jadi kerangka di bawah reruntuhan kuil itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181502,
					"content": "\"Aku dengar ada kabar kalau Raja Deshret akan bangkit. Aku pikir Greater Lord Rukkhadevata saja tidak pernah terlihat hidup lagi setelah bertahun-tahun, apalagi Raja Deshret.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181503,
					"content": "\"Kurasa lebih baik kita bekerja dengan jujur. Kita tidak bisa hidup hanya dengan mengandalkan suplai dari Desa Aaru saja per bulannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
