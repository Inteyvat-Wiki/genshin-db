			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Sebagai pintu masuk Sumeru, Caravan Ribat adalah jalur yang penting. Papan Pengumuman ini dipasang untuk memberi semua informasi penting kepada pelaku perjalanan bisnis dan turis. Harap perhatikan papan pengumuman ini sesering mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"Cintaku, walaupun kamu jauh dariku, hatiku selalu ada untukmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180202,
					"content": "\"Aku tahu. Kamu harus melakukan urusan yang lebih penting. Lagi pula semakin tinggi jabatanmu, semakin banyak juga tanggung jawabmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180203,
					"content": "\"Tapi aku tidak bisa cerita tentang masalah yang menggangguku pada siapa pun. Aku tidak bisa menyebutkan namamu kepada mereka.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180204,
					"content": "\"Aku harap suatu hari nanti aku bisa memberitahu mereka, kalau kamu terpelajar dan bijak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
