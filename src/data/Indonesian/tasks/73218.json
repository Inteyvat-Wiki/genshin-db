			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "Rekrutmen permanen pekerja yang bertugas memelihara Tembok Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181602,
					"content": "Gratis makan dan akomodasi, gaji sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732181603,
					"content": "Pegawai berprestasi akan direkomendasikan oleh pejabat untuk menerima pelatihan lebih lanjut di Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
