				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Peneliti yang tinggal di Caravan Ribat dalam jangka waktu yang lama wajib mendaftarkan diri ke Mahamata sebelum masuk ke hotel untuk mencegah kebocoran ilmu pengetahuan atau kejadian yang tidak diinginkan lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Pelaku perjalanan bisnis perlu mencatatkan diri ke Mahamata untuk mendapatkan persetujuan masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180902,
					"content": "Dilarang membawa barang yang belum terdaftar atau barang selundupan yang dilarang untuk diimpor atau diekspor. Semua barang yang melanggar akan disita dan pihak terkait akan dipaksa keluar ke padang pasir sesuai dengan aturan yang ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180903,
					"content": "Sebagai tambahan, penduduk Desa Aaru dapat langsung melintas batas dengan membawa izin yang dikeluarkan oleh Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321810,
			"completionStepIds": [
				7321810
			],
