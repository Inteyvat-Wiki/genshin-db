			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Kepada Great Red Sand",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180302,
					"content": "Barang siapa yang tidak menghormati yang sudah meninggal tetaplah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "Akademiya melarang keras segala bentuk perusakan pada Tembok Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180402,
					"content": "Semua pelanggaran akan diberikan sanksi berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "\"Dijual oleh-oleh khas gurun, berbagai macam produk awetan buah, dan bahan-bahan pencuci mulut.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180502,
					"content": "\"Pesanan dalam jumlah besar akan disediakan jasa antar khusus.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180503,
					"content": "\"Kelihatannya bagus sekali, aku bisa membuat Dango pakai ini. Bisa diantar sampai Inazuma?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180504,
					"content": "\"Maaf, pengiriman lintas batas sekarang cuma bisa ke Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Namun, \"Gilded Journey\" adalah hotel satu-satunya di Caravan Ribat, sepertinya tidak perlu dipromosikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180602,
					"content": "Tapi sate buatan kami enak dengan cita rasa asli padang pasir. Jelas sekali terasa lebih otentik daripada yang dijual di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180603,
					"content": "Bagi pengembara yang sedang lelah, pastikan untuk mampir dan nikmatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"Diharapkan Mahamata mempertimbangkan untuk memperketat bea cukai di Caravan Ribat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180702,
					"content": "\"Sekarang penduduk gurun dapat bebas melintasi batas. Ini tidak hanya memberi peluang bandit untuk melarikan diri dan bersembunyi di hutan, tapi juga merampas kesempatan bekerja orang Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180703,
					"content": "\"Walaupun Akasha belum bisa diakses oleh penduduk gurun, misi yang dikeluarkan Citadel of Regzar itu dari awal sudah melebihi tugas prajurit bayaran. Kalau terus seperti ini, biarpun semuanya mengikuti ujian masuk Akademiya, akan ada orang yang kehilangan pekerjaannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180704,
					"content": "\"Apa maksudmu? Penduduk gurun adalah rakyat Greater Lord Rukkhadevata, yang juga orang Sumeru. Sudah sewajarnya membiarkan mereka masuk ke kota.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732180705,
					"content": "\"Kamu harus berhati-hati waktu mengatakan itu di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
