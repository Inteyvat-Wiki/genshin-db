			},
			"dialogs": [
				{
					"id": 730350401,
					"content": "Bagian tengah Pohon Ashvattha mulai bersinar. Jadi itu Bija-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350402,
					"content": "Susah memang, tapi akhirnya Rana bisa diobatin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350403,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350404,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350405,
					"content": "Arama, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350408,
					"content": "Pohon Ashvattha sudah terkena pengaruh Marana. Bija tidak bisa dihasilkan. Aku harus menanam pohon baru untuk dapat membantu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350409,
					"content": "Tapi ... itu kan bakal makan waktu lama banget dong buat numbuhin dari bibit sampai jadi pohon besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350410,
					"content": "Jangan takut, kecepatan tumbuh Pohon Vasara berhubungan dengan benihnya. Pohon Ashvattha sudah memberikan seluruh kekuatannya untukku, dan Buah Vasoma juga sudah berisi semua ingatan kami. Jadi, tidak akan masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350411,
					"content": "Terima kasih Pohon Ashvattha. Terima kasih Araji, Arayama, dan Aramaha. Kenangan kalian akan kujadikan rantai penghubung Pohon Ashvattha baru ke alam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350412,
					"content": "Arama kok jadi beda ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350413,
					"content": "Oh ya? Aku belajar banyak istilah baru dan dapat banyak ingatan baru sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350414,
					"content": "Tenang, aku tetap diriku sendiri kok. Aku tetap teman yang sedang membantu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350415,
					"content": "Kalau begitu, Bija-nya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "Vanarana Masa Lalu terkunci jauh di dalam Fane of Ashvattha. Di sanalah kita akan bertemu dengan Jelmaan Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350420,
					"content": "Dia akan terus meracuni tanah ini dan Sarva, sampai semua yang hijau berubah menjadi coklat, semua bunga menjadi layu, semua mata air menjadi cemar, dan semua makhluk menjadi musnah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350421,
					"content": "Kita harus menghancurkannya. Jika tidak, pohon yang kita tanam tidak akan kuat untuk menghasilkan Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350416,
					"content": "Aku percaya padamu. Sekarang gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "Siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#Asal Nara {NICKNAME} paham, maka tidak ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350406,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
		},
