			"dialogs": [
				{
					"id": 730350501,
					"content": "#Nara {NICKNAME}, sudah siap masuk ke dalam mimpi Pohon Ashvattha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350502,
						730350507
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350502,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350503
					]
				},
				{
					"id": 730350503,
					"content": "#Oke, kalau {NICKNAME} sudah yakin sih artinya enggak ada masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350504,
						730350505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350504,
