			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#Bagus, Marana tidak ada di sini, tidak seperti Arayama. Nara {NICKNAME}, Paimon, ini Pohon Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Bentuknya kok begitu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "Paimon jangan berkata yang tidak sopan! Nanti Pohon Ashvattha marah loh! Dia amat sangat kuat sekali, umurnya sudah amat sangat tua, Pohon Vasara-nya, lebih tua dari Aranara mana pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350604,
					"content": "Beribu bulan yang lalu, atau bahkan lebih dari itu, Sang Tuan Hijau bernyanyi di sini. Waktu itu dia baru saja pergi dari Valuka, dan hutan belum selebat hari ini. Masih banyak pasir di permukaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350605
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Ararakalari-nya lebih kuat dari semua Aranara, lagu yang dia nyanyikan adalah yang paling mendekati \"Lagu Induk\". Ashvattha menyahuti panggilannya, dan tunasnya muncul dari Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350606,
					"content": "Dia memberi tahu Pohon Ashvattha, bahwa ada banyak Nara yang pintar, elok, namun kesepian di hutan. Bersahabatlah dengan mereka, karena mereka adalah penghuni hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350607
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Lalu Pohon Ashvattha menghasilkan buah delima yang gemuk dan manis, banyak benih di dalamnya. Benih pertama yang mekar adalah Aramuhukunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "Jadi Aramuhukunda adalah Aranara yang paling pertama. Sejak saat itu, Aranara bermekaran, jumlahnya sebanyak daun di dahan pohon rindang. Kami dan para Nara, sama-sama penghuni hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350609,
					"content": "Karena itulah Pohon Ashvattha sangat kuat dan sangat penting! Seperti Nara yang melahirkan anak Nara, semua Aranara adalah keturunan Ashvattha, keturunan Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350610
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "Oh jadi begitu ya ... maaf ya, Arama ... Tapi Pohon Ashvattha ini keren banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "Paimon jangan kasar dong, masa sih ibunya orang lain dipakai buat bercandaan seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350213,
					"content": "Tentang Bija ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350214
					]
				},
				{
					"id": 730350212,
					"content": "Kan enggak maksud begitu juga! Sudahlah. Bija-nya gimana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Seperti pohon yang rindu akan tanah gembur dan air hujan, Pohon Ashvattha juga perlu mimpi dan kenangan. Tadi kan aku bilang, Pohon Ashvattha adalah yang tertua dari semua Pohon Vasara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "Serahkan tiga Buah Vasoma dari Araji, Arayama, dan Aramaha ke Pohon Ashvattha. Dengan begitu Pohon Ashvattha dapat mengumpulkan kekuatan untuk menghasilkan buah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "Buah Vasoma dari Araji, Arayama, dan Aramaha? Bukan buah dari Pohon Vasara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "Ya, itu Pohon Vasara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Nara {NICKNAME}, mendekatlah ke Pohon Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "Luar biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350221,
					"content": "Ngeri ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Ya. Semua Aranara adalah keturunannya. Sekarang kamu telah terhubung dengan semua Aranara, berkat mereka ada padamu, demikian pula Pohon Ashvattha memberkatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "Selama Mahkota Bunga ada di kepalamu, Pohon Ashvattha akan mengenalimu sebagai anak hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "Ada yang salah dengan Pohon Ashvattha. Dia sepertinya melemah ... Mungkin akibat Marana yang muncul di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "Bagaimanapun, kita harus masuk ke dalam mimpi Pohon Ashvattha, lalu serahkan Buah Vasoma ke Tree of Dreams, dan dia pun akan pulih kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#Ini kayak waktu kita di Ashvattha's Concourse, betul kan {NICKNAME}? Ulurkan tangan, \"piw-piw\", terus masuk deh ke alam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Ya! Paimon sungguh pintar. Nara {NICKNAME}, ulurkan tangan jika sudah siap, dan bertolaklah ke alam mimpi Pohon Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350229,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350234,
					"content": "Aku perlu waktu buat siap-siap ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350230,
					"content": "#Tadi Arama ada sebut soal Marana, jadi kita enggak tahu apa yang bakal terjadi di dalam! Untung ada si {NICKNAME}, asal ada dia semua aman deh, pasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350231,
					"content": "(Ulurkan tangan ke Pohon Ashvattha.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "Aku belum siap. Minta waktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "Oke. Bilang saja kalau sudah siap, aku juga akan pergi menemani kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350235,
					"content": "Oke. Bilang saja kalau sudah siap, aku juga akan pergi menemani kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				}
			]
		},
		{
			"id": 7303509,
