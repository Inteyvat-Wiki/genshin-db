			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "Beres juga akhirnya. Pohon ini bisa kelihatan dari mimpi Pohon Vasara ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350902,
					"content": "#Maaf, Nara {NICKNAME}. Maaf Paimon. Aku tidak menyangka kalau Marana sudah memangsa habis mimpi Pohon Ashvattha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350903,
					"content": "Ulat hitam yang tak terhitung jumlahnya menggerogoti akar Tree of Dreams di Sarva. Bahkan di dalam mimpi pun aku dapat merasakan tangan Marana yang sedang menggoncang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350904,
					"content": "Maaf, harusnya aku sudah sadar sejak lihat ada Marana di Ashvattha's Concourse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350905,
					"content": "#Enggak apa-apa! Lihat, kalau ada {NICKNAME}, apa juga jadi gampang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350906,
					"content": "Kalau begitu, Bija-nya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#Buah Vasoma seharusnya bisa memulihkan sebagian kekuatannya. Aku mengandalkanmu, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350913,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350914,
					"content": "Ya, aku paham. Walaupun tidak menyangka secepat ini, tapi aku tahu apa yang harus kulakukan kalau tiba waktunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350915,
					"content": "Seperti awan yang tahu kapan harus menurunkan hujan, dan hujan yang tahu bahwa dia harus jatuh ke atas tanah. Benih yang tahu takdirnya menjadi pohon besar yang menghasilkan buah pada musimnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350916,
					"content": "Kayaknya ada yang aneh nih sama Arama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350917,
					"content": "Oh, aku lagi ngomong sama Tree of Dreams. Kalian tidak bisa dengar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350918,
					"content": "Waktu itu Paimon memang sempat lihat sih kalau si Aranakin lagi ngomong sama jamur ... tapi umumnya kan orang enggak bisa ngobrol sama tanaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350919,
					"content": "Ah, begitu ya. Aku belajar hal baru lagi, terima kasih ya Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350920,
					"content": "#Nara {NICKNAME}, Paimon, tidak usah khawatir soal Bija. Kita keluar saja dulu dari alam mimpi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350907,
					"content": "Gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "Tapi memangnya, pengaruhnya ke Bija ... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350909,
					"content": "Yah, tidak segampang itu juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "Pokoknya untung ada kamu, dan untung semuanya sudah beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350911,
					"content": "Tapi memangnya, pengaruhnya ke Bija ... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
