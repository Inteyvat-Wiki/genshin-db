					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350505,
					"content": "Aku belum siap. Minta waktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
