						730350302
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350302,
					"content": "Kok bisa ada The Withering di dalam mimpi Pohon Ashvattha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350303,
					"content": "Bodo ah! Pokoknya kita singkirin dulu The Withering-nya secepat mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
