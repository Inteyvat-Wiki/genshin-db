			"dialogs": [
				{
					"id": 706990101,
					"content": "Honorary Knight! Kami beruntung sekali kamu bisa datang dan coba kios hiburan ini! Aku jadi lega sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "Sebenarnya ini pertama kalinya aku ikut proyek pengembangan. Jadi aku sedikit gugup. Otakku kayak lagi dimasak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Yang perlu aku lakukan cuma taruh cangkang di perangkat yang sudah ada. Tapi ada banyak sekali pertimbangan desain ... Ada banyak sekali parameter ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Aku tidak iri sama Kapten Albedo sih, soalnya dia harus buat perangkat dari nol ... Pasti sulit sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Aku rasa berfungsi dengan baik kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "Wah. Uhh ... Te-Terima kasih! Terima kasih, Honorary Knight. Aku tersanjung mendengar pujianmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Aku ... Aku akan berusaha sebisaku. Mudah-mudahan, aku bisa mencapai titik di mana aku bisa membangun hal berguna untuk Pasukan Gerilya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Oh, aku dapat mainan di salah satu permainan. Ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "Aku sudah punya yang sama sih. Jadi, setiap kali aku melihat mainan ini sekarang, aku jadi ingat motivasi yang kamu berikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Jangan terlalu dipaksakan. Lama-lama juga jago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
