					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME} dan Paimon, sering berantem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770705,
					"content": "Yah, kalau dipikir-pikir, kita mulai perjalanan ini untuk cari saudara yang hilang, tapi sejauh ini memang penuh baku hantam juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "Sudah biasa, aku memang doyan baku hantam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Yah ... pandai bertarung sih oke, tapi ya jangan sampai jadi hobi juga, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#Nanti kalau sudah jadi bake-danuki besar, aku bisa sehebat {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770711,
					"content": "Kichiboushi sih pasti bisa! Tapi harus janji ya, sama Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "Janji apa, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770713,
					"content": "Eh-Ehem! Kalau Kichiboushi sudah jadi lebih hebat dari Ioroi, tidak boleh menindas yang lemah, terus tidak boleh juga berantem sembarangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#Enggak boleh kayak bunga kebakaran super besar tadi, begitu lihat {NICKNAME} langsung saja main serang dan sembur-sembur api!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Terus, kapan boleh berantem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770716,
					"content": "Waktu kamu perlu melindungi diri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Hmm ... Tidak paham sih, tapi aku janji sama Paimon. Tidak boleh tindas yang lemah, tidak boleh berantem sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770720,
					"content": "Ya, Kichiboushi baik, nurut ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "Setelah ini ... Eh, ternyata ini sudah yang terakhir dari delapan tempat yang diminta Ioroi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770717,
					"content": "Waktu kamu mau melindungi orang lain ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Waktu kamu sedang membela yang benar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
