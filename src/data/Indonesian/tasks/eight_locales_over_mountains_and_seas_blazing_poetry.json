			"dialogs": [
				{
					"id": 726770301,
					"content": "Besar! Panas! Bunga kebakaran ada juga yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770302,
					"content": "Iya kan! Oh betul juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Kichiboushi, kamu diam sebentar, kami fotoin nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "Di tempat panas begini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "Justru itu esensinya!",
