					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Melukis itu makan waktu lama. Capek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Betul, betul! Melukis itu lamaaa banget, terus Kichiboushi harus tahan di satu pose terus, nanti kakinya capek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "Dulu waktu masih disegel jadi batu juga berdiri terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771031,
					"content": "Jadi, setelah segelnya pecah, kaki pegal dan sakit. Lumayan lama juga sakitnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771032,
					"content": "Aduh, kedengarannya sengsara banget deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771033,
					"content": "Tapi, Paimon kan terbang. Kaki tidak mungkin pegal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771034,
					"content": "Enak saja! Terbang itu pakai otot di seluruh badan tahu! Capek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771035,
					"content": "Wah! Bunganya kebakaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771036
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771036,
					"content": "Dengerin omongan orang dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771037,
					"content": "Flaming Flower?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771038
					]
				},
				{
					"id": 726771038,
					"content": "Betul juga, di Chinju Forest memang enggak lihat ada Flaming Flower ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771039,
					"content": "Kichiboushi mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771040,
					"content": "Mau! Kelihatan hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771041
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771041,
					"content": "#Kalau gitu kamu harus minta baik-baik sama {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771042,
					"content": "#{NICKNAME}, mau dong! Makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771043
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771043,
					"content": "Rasanya kok enggak tulus ya. Atau memang bake-danuki gaya ngomongnya begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771021,
					"content": "Soalnya Kamera mahal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771022
					]
				},
				{
					"id": 726771022,
					"content": "Eh? Kamera mahal ya? Terus kita sering banget berantem, berenang, manjat gunung, dan lainnya. Kamera kita gimana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771023,
					"content": "Waduh, besok-besok kita harus lebih hati-hati nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771006,
					"content": "Seperti Anemo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771008,
					"content": "Kosakata Paimon dan Kichiboushi sama banyaknya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771009
					]
				},
				{
					"id": 726771009,
					"content": "Hebat, seperti Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771010
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771010,
					"content": "#Eh, maksud {NICKNAME} bukan kayak gitu sih, tapi ... Kichiboushi emang pintar kok! Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771011,
					"content": "Memang mantap habis!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771012
					]
				},
				{
					"id": 726771012,
					"content": "#Lah? {NICKNAME}, kosakata kamu jadi agak berkurang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}