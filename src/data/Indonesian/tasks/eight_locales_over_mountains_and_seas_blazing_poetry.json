					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Ya. Tapi ada kalanya kita tak punya pilihan lain, kan?",
					"roleType": "TALK_ROLE_NPC",
