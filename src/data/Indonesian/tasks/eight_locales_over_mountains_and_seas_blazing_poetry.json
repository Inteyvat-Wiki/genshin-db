			"dialogs": [
				{
					"id": 726770101,
					"content": "Pemandangan di sini memang mantap habis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Banyak air, warnanya mantap, mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770103,
					"content": "Kalian berdua kayaknya bisa jadi saudara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Tapi memangnya mantap kan! Memangnya kalau kamu bakal menjabarkannya seperti apa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Seperti Cryo ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "Apa artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Tapi, pemandangan di sini memang mantap sih. {NICKNAME}, masih ingat si pelukis yang dulu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Betul, Vermeer! Waktu itu, kita pernah bantu dia pasang mutiara besar yang bersinar di dua patung di sana itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "Dia kan kasih lukisan juga buat kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "Apa ini yang kamu cari-cari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Iya! Yang itu! Kichiboushi, sini lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "Hmm! Mirip sekali! Foto ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770122,
					"content": "Bukan, ini lukisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "Eh? Tapi kan orang bisa foto, kenapa masih mau gambar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770124,
					"content": "#Hm, kalau menurutmu kenapa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Karena ingin buat sesuatu unik yang benar-benar murni milik sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Kedengarannya sih masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Gambar yang kita lukis sendiri, lebih pakai perasaan, lebih bermakna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Ya, goresan demi goresan yang ditorehkan, menampilkan keinginan dalam hati. Capek loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Oh ... Berarti aku difoto, gampang, tidak capek, tidak pakai perasaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770133,
					"content": "Loh! Ya enggak gitu juga, soalnya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Melukis itu makan waktu lama. Capek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Betul, betul! Melukis itu lamaaa banget, terus Kichiboushi harus tahan di satu pose terus, nanti kakinya capek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Dulu waktu masih disegel jadi batu juga berdiri terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770137,
					"content": "Jadi, setelah segelnya pecah, kaki pegal dan sakit. Lumayan lama juga sakitnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770138,
					"content": "Aduh, kedengarannya sengsara banget deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Tapi, Paimon kan terbang. Kaki tidak mungkin pegal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770140,
					"content": "Enak saja! Terbang itu pakai otot di seluruh badan tahu! Capek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "Wah! Bunganya kebakaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770142,
					"content": "Dengerin omongan orang dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "Flaming Flower?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Betul juga, di Chinju Forest memang enggak lihat ada Flaming Flower ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "Kichiboushi mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "Mau! Kelihatan hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770147,
					"content": "#Kalau gitu kamu harus minta baik-baik sama {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, mau dong! Makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770149,
					"content": "Bake-danuki gaya ngomongnya emang gitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Soalnya Kamera mahal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Eh? Kamera mahal ya? Terus kita sering banget berantem, berenang, manjat gunung, dan lainnya. Kamera kita gimana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Waduh, besok-besok kita harus lebih hati-hati nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "Siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Vermeer! Yang tempo hari kita bantu pasang mutiara besar yang bersinar di dua patung di sana itu. Ingat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "Seperti Anemo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Kosakata Paimon dan Kichiboushi sama banyaknya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Hebat, seperti Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770110,
					"content": "#Eh, maksud {NICKNAME} bukan kayak gitu sih, tapi ... Kichiboushi emang pintar kok! Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "Memang mantap habis!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#Lah? {NICKNAME}, kosakata kamu jadi agak berkurang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
