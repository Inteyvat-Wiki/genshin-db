					"content": "Kedengarannya sih masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Gambar yang kita lukis sendiri, lebih pakai perasaan, lebih bermakna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
