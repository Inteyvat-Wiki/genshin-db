					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771003,
					"content": "Kalian berdua kayaknya bisa jadi saudara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#Tapi memangnya mantap kan! Memangnya kalau kamu bakal menjabarkannya seperti apa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Seperti Cryo ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "Apa artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "Tapi, pemandangan di sini memang mantap sih. Jadi ingin melukis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "Memangnya Paimon bisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Paimon kan bisa belajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Melukis ... susah. Dulu lihat Utamarou melukis, bikin satu saja lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771017,
					"content": "Sudah bisa foto, kenapa masih mau gambar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771018,
					"content": "#Hm, kalau menurutmu kenapa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Karena ingin buat sesuatu unik yang benar-benar murni milik sendiri.",
