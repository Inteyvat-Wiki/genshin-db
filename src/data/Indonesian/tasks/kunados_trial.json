			"dialogs": [
				{
					"id": 722700101,
					"content": "Aku adalah Daimon dari Jibashiri. Pahlawan Sangonomiya, aku mengakuimu sebagai orang yang layak mengikuti tantangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Keberanian adalah kekuatan untuk mengalahkan semua musuhmu apa pun caranya. Kalahkan semua musuh di sini dan lepaskan Api Gerbang Tinggi, maka kamu boleh lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Semua musuh di sini adalah ilusi yang lahir dari Sunfire Phantasm dan para lawan tangguh yang kamu kenal di dalam hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Tapi kamu akan lenyap jika tidak berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Aku akan menunggumu untuk menyelesaikan tantangan ini di Menara Tiga Dunia di atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
