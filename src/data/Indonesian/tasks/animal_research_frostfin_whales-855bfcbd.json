			"dialogs": [
				{
					"id": 761920201,
					"content": "Fotonya bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Sudah puas sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Yap. Entah itu cuma rumor saja atau beneran, semoga keberuntungan akan selalu menyertai Helka di dalam perjalanannya, menjagamu dari bahaya, dan membawamu kembali ke Speranza dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "Terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Hehe, kalau begitu, balik yuk! Kak Linnea, makasih ya. Sampai ketemu di Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "Oke, dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
