			"dialogs": [
				{
					"id": 761920101,
					"content": "Sepertinya ini bukan hari keberuntungan kita ... Kita sudah tunggu lama sekali, dan belum ada satu Frostfin Whale pun yang muncul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Hmm ... Mungkin sudah waktunya balik. Mungkin kita bisa punya kesempatan lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Tapi ... kamu cuma kembali beberapa hari saja, terus lanjut ke tempat lain, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Ya sudah, tunggu sebentar lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Eh? Helka ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Kak Linnea! Ya, aku sudah balik! Tapi arsipku belum terlalu lengkap sih, jadi pemenangnya tidak bisa ditentukan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Oh? Kalau begitu perjalananmu kali ini berbuah juga ya. Aku juga tidak tinggal diam saja, aku ada tambahkan banyak kategori ke dalam catatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Kakak datang untuk lihat Frostfin Whale juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Ya, aku dengar itu spesies yang baru ditemukan. Kalau dilihat dari ukurannya sih, aku rasa perubahan lingkungan yang menyebabkan perubahan pada warna kulitnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Contohnya, konsentrasi kuuvahki di area di sekitar sini, mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "Sayang, tapi kayaknya hari ini enggak muncul deh. Kita sudah tunggu lama sekali, tapi belum muncul satu pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Kak Linnea, boleh tidak Kakak bujuk dia supaya sudahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "Aku tidak masalah sih. Aku merasa lebih baik dari biasanya waktu aku bangun pagi. Kita tunggu sebentar lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "Aku dengar orang yang bisa melihat Frostfin Whale dengan mata kepala sendiri akan bisa mewujudkan impiannya ... Berarti, dia beruntung dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "Semoga Helka bisa membawa keberuntungan ini sepanjang perjalanannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Kita tunggu sama-sama saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "Ah, Kak Linnea mah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Tidak perlu khawatir, perasaanku bilang kalau hari ini kita pasti bisa lihat Frostfin Whale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Kamu juga tahu, kan? Instingku selalu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "Oke ... Kalau begitu kita tunggu saja sebentar lagi. Tapi sebentar saja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Beberapa saat kemudian ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Lihat! Wow! Lompatnya tinggi sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "Andai aku bisa berenang secepat itu juga ... Berenang dengan mereka pasti menyenangkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Mending kita langsung nyebur sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Hei! Bahaya dong, Kak! Duh, Kak Linnea masih tetap ceroboh saja, sama seperti sebelum aku pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "Eh? Kamu tidak tertarik main dengan mereka? Mereka kayaknya senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Tapi kalau pakaianmu basah, kamu bisa masuk angin. Mending kita tetap di pinggir sini saja dan pakai Kamera buat foto mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Hmm ... Masuk akal sih, aku akan pinjam Kamera Helka dulu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
