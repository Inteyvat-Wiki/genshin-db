			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "Sensor Beacon nya sudah kamu pasang semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Terima kasih ya. Sekarang, kita tunggu sampai data terkumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "Kamu kok bisa tahu di mana aku harus pasang Beacon-nya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Aku juga ikut dalam proses pengerjaan desain Mikage Furnace. Dari titik-titik tersebut, kita bisa mengumpulkan data hampir seluruh area Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150306,
					"content": "Kalau kita bisa pasang alat pemurni di titik-titik tadi, masalah ini boleh kita tinggal tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150307,
					"content": "Kalau Tuan Flois sampai tahu situasi di ini, dia pasti ngamuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150311,
					"content": "Baiklah, terima kasih sudah mau bantu. Ini imbalan untukmu, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150312,
					"content": "Ah, satu lagi... Nanti mungkin harus minta tolong kamu untuk ambil Sensor Beacon itu kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150313,
					"content": "Kan aku tidak punya Vision, jadi tidak bisa semudah itu keluar masuk area dengan konsentrasi energi Tatarigami yang begitu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150314,
					"content": "Belum lagi orang-orang Fatui barbar itu masih ada di sana. Sejujurnya, kurasa cuma kamu satu-satunya orang di pulau ini yang kuat menghadapi Fatui dan Tatarigami sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150308,
					"content": "Apa Sensor Beacon ini dijual?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
				{
					"id": 721150309,
					"content": "Jangan bercanda. Tak perlu bahas dulu soal harganya, tapi kalau dijual, nanti aku pakai apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150310,
					"content": "Kalau suatu hari nanti kamu pergi ke Fontaine, akan kukenalkan dengan orang-orang yang menjualnya dengan harga yang oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				}
			]
		}
	]
}