			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "Halo, anak muda! Aku punya kabar baik dan kabar buruk soal Mikage Furnace. Kamu mau dengar yang mana dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "Kabar baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "Kabar baiknya, kerusakan yang ada tidak serius. Aku masih bisa memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "Kabar buruknya, Fatui yang ada di dalam tidak suka dengan kabar baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "Mereka sepertinya belum menyerah mencari cara untuk mendapatkan inti Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "Kalau mereka dibiarkan, cepat atau lambat energi Tatarigami akan lepas kendali. Lalu pulau ini dan kita semua akan meledak bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "Tapi kalau kita cuma fokus ke Fatui, energi Tatarigami yang terkandung dalam kubah penahan akan mencapai titik kritis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "Jadi kita hadapi keduanya sekaligus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Ya... Sederhananya, dilihat dari sudut pandang akademis, secara objektif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "Masalahnya ada dua: Fatui dan Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "Tapi mengingat keadaan di dalam Mikage Furnace, menghadapi masalah yang satu berarti ketemu juga dengan yang satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "Jadi intinya, masalah yang kita hadapi sekarang adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "Kamu tinggal bilang \"Iya\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Ah, oh... Iya, kita harus menghadapi keduanya sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "Tapi secara bertahap. Seperti kata pepatah Liyue, \"Makan tahu panas tidak boleh terburu-buru\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "Kok kamu bisa tahu pepatah Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Dulu kami pernah ke Liyue. Pepatah seperti ini kuanggap suvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "Aku punya suvenir dari mana-mana. Sayangnya, \"suvenir\" dari Mondstadt sudah habis kuminum... enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Oke, kembali ke pokok permasalahan. Aku punya rencana untuk mengatasi situasi di Mikage Furnace, tapi aku butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "Siap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "Aha! Aku suka orang sepertimu, sedikit bicara, banyak bertindak! Hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "Ehem, aku jadi melantur. Sekarang, ambil Sensor Beacon ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "Tolong pasang ini di beberapa titik lokasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "Sensor Beacon ini dapat mengumpulkan data kepadatan dan penyebaran energi Tatarigami di dalam Mikage Furnace. Asal ada data, aku bisa buat rencana yang lebih rinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "Lokasi untuk memasang Sensor Beacon sudah kutandai di petamu. Tolong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "Bagaimana cara kerjanya...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "Sederhananya, itu alat pengukur kuantitas dan kualitas segala jenis energi, yang menggunakan energi elemental sebagai sumber tenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "\"Sederhana\"... inginnya sih begitu, tapi alat ini tidak segampang itu untuk dijabarkan. Ah, kamu tahu tujuh elemen utama, kan? Nah, begini cara——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "Su-sudah, sudah, tidak jadi nanyanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Baiklah kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "Apa keuntungannya buat aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Keuntungan? Hmm... bagaimana kalau harta karun tersembunyi di pulau ini, dan beberapa bahan \"sisa\" di Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "Bayangkan saja, Mikage Furnace itu fasilitas peleburan terbesar di seluruh Inazuma. Pasti ada beberapa hal di sana yang... layak untuk dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Tapi! Karena tidak punya Vision, aku tidak bisa masuk ke sana, dan aku juga tidak tahu apa yang ada di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "Kabar buruk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "Kabar buruknya, para Fatui masih ada di dalam Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "Mereka sepertinya belum menyerah mencari cara untuk mendapatkan inti Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "Kabar baiknya, kerusakan yang ada tidak serius. Aku masih bisa memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Dan jelas sekali para Fatui tidak suka dengan kabar baik ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
