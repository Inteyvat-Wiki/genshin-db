			"dialogs": [
				{
					"id": 748000501,
					"content": "Oh, iya juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Kopinya dingin loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Kami sudah beres minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Terima kasih, {NICKNAME}. Terima kasih sudah diantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "Apanya yang dianter, kita cuma jalan bareng doang. Enggak ngapa-ngapain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Tidak ada hal buruk yang terjadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "Dan tidak ada bahaya apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Iya. Aku memang kebanyakan mikir rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "Kopinya enak, hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "Ada racunnya tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "Hadeh, kesel deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Coba, ngomong sompralnya direm dikit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Jangan sompral terus ah! Nih, kami sudah minum habis, dan enggak kenapa-kenapa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "Tidak, tidak. Mungkin racunnya ... spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "Pertama, campur obat ke dalam kopi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Ketika diminum, obatnya tidak bereaksi apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "Setelah beres minum kopi beracun dan pulang, si pelaku mengikuti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "Lalu saat kita tidur, dia masuk kamar, dan masukkan obat kedua ke dalam botol minum kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Besoknya, kita keluar seperti biasa, lalu minum dari botol itu. Kedua obat bereaksi di dalam tubuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "Lalu kita akan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "Suara langkah kaki yang bergegas tiba-tiba mendekat ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Tamu yang terhormat, lagi membicarakan apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Kopi? Beracun? Tolong jangan bercanda seperti itu di kedai kopiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Kalau kedengaran tamu lain dan mereka jadi berpikir aneh, kamu terpaksa diantar keluar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Tunggu, biar aku jelaskan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "Dia itu temanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Kamu menjelaskan situasi Guijarro ke Arouet. Setelah mendengarkan, dia pergi sambil diam menghela napas ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "Sebagai permintaan maaf, Guijarro membeli tiga cangkir kopi lagi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Kopi yang ini langsung dibikin sama yang punya kedai loh, dijamin aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000529,
					"content": "Sudah, jangan mikir aneh-aneh lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000530
					]
				},
				{
					"id": 748000530,
