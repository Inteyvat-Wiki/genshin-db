			"dialogs": [
				{
					"id": 748000401,
					"content": "Kenapa ngumpet lagi! Enggak ada apa-apa woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Ada Gardemek segede gitu apa tidak kelihatan? Di depan mata loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Memangnya kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Sst! Cepat pergi dari sana! Gimana kalau dia lepas kendali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Atau ... intinya tiba-tiba meledak? Atau ada yang mengendalikan dia dari jauh buat menyerang kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "Kelihatannya normal-normal saja ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Justru itu yang ngeri! Robot yang keadaannya normal tiba-tiba lepas kendali, dan nyawa orang yang kurang beruntung ada di dekatnya pun melayang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Tidak ada yang bisa diminta pertanggungjawabannya! Pelaku sebenarnya juga tidak akan pernah ketemu ... bahaya, sangat bahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "Sudah pergi tuh. Keluar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Fiuh ... dia tidak lepas kendali ya, sungguh di luar dugaan. Nyawa kita pun terselamatkan, lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Kecelakaan kayak gitu sih nyaris mustahil ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Aku mikirnya lebih ke, \"perbuatan yang disengaja\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Tunggu, kalau tanpa pelaku ... artinya tidak ada yang bisa dituntut pertanggungjawabannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "Betul! Itu dia! Cepat, ayo ke kafe! Harus langsung ditulis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Eh, pelan dikit jalannya! Tadi bukannya takut dilempar batu atau dijegal orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Enggak bakalan ada yang lepas kontrol lalu ngamuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Terus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
