			"trigger": {
				"objectNames": [
					"Mountain Shaper"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "...Tidak hanya menerobos masuk Mt. Hulao dan menghancurkan amber gunung, juga memberikan kebebasan yang bukan hakmu kepada pencuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080702,
					"content": "Para pencuri hanyalah awam dan tidak tahu tentang Adeptus. Kalian, pelanggaran dan penghinaan kalian di luar batas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080703,
					"content": "Sabar dulu! Kami bisa jelaskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080704,
					"content": "Lihat ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "Sigil of Permission. Ternyata masih ada sisanya di dunia fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080708,
					"content": "Ini ... Sigil of Permission. Ternyata masih ada sisanya di dunia fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080709,
					"content": "Di masa lalu, Rex Lapis membuat benda ini dan memberikannya kepada manusia fana. Tetapi jumlahnya terus berkurang, sangat langka, dan semestinya telah tiada sejak ribuan tahun lalu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080710,
					"content": "Berbicaralah. Diriku akan mendengarkan, dan kemudian membuktikan kebenarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080711,
					"content": "Perkatakan kebenaran. Liyue tidaklah jauh dari sini, dan diriku bukan keberadaan yang bisa kalian bodohi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080712,
					"content": "Rex Lapis ... dibunuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080713,
					"content": "Saat Rite of Descension?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080714,
					"content": "Makhluk fana mana di Liyue ... bukan, di seluruh dunia ini, yang berani melakukan pengkhianatan yang demikian? Dan siapa pula yang mampu melakukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080715,
					"content": "Rex Lapis memerintahkan Adeptus untuk melindungi Liyue, dan kami terus mematuhinya. Setelah manusia menjadi makmur, kami pun perlahan menghilang ke gunung. Semua ini demi kebaikan para manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080716,
					"content": "Tetapi kini ... Rex Lapis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080717,
					"content": "Pengembara, pesan yang disampaikan sudah diterima. Diriku sudah memahami maksud Moon Carver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080718,
					"content": "Biarlah urusan diriku selesai dahulu, sebelum menemui para Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080719,
					"content": "Ada tidak yang bisa jelaskan tentang amber di gunung ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "Paimon bisa! Di buku cerita Adeptus selalu punya kekuatan ajaib, sepertinya mereka benar-benar punya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080721,
					"content": "Bulunya bisa berubah jadi tumbuhan, air liurnya juga bisa berubah jadi sungai dan air terjun. Pasti amber juga begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080722,
					"content": "Kalau begitu hujan sebenarnya adalah ... air mata Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "Ketidakmasukakalan kalian tidak mengenal batas... Amber di sini berasal dari tumbuhan yang ditanam di sini, yang dinamai Karst Crawler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080725,
					"content": "Tubuh tanaman itu hampir seluruhnya tersembunyi di bawah tanah. Jika terinjak, akan muncul amber yang akan mengurung penyusup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080726,
					"content": "Setelah mendiami tempat ini, diriku menanam banyak karst crawler untuk menjaga agar ketenangan pegunungan ini terjaga. Tanaman yang telah menghindarkan tempat ini dari banyak gangguan selama bertahun-tahun, juga telah megurung berbagai macam benda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080727,
					"content": "Berarti amber gunung ini ... hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080728,
					"content": "Betul. Demikianlah diriku tidak boleh meninggalkan tempat ini begitu saja, karena akan membahayakan makhluk hidup yang ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080729,
					"content": "Diriku akan bertolak setelah urusan ini selesai. Sementara kalian lebih dahulu berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080723,
					"content": "Waduh, berarti amber gunung itu ... uekkk, jijik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "Moon Carver yang mengirim kami kemari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "Moon Carver ... mengutus manusia fana?",
					"roleType": "TALK_ROLE_NPC",
