				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "Saudara saya sudah menceritakan semuanya. Terima kasih Anda berdua mengasihani dan sudah menolongnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089702,
					"content": "*huff* Kami sudah hampir putus asa. Tidak ada uang untuk menghidupi keluarga, lalu ada kabar bahwa banyak harta karun tersembunyi di dalam amber Mt. Hulao ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089703,
					"content": "Kami tergiur, kemudian diam-diam pergi mendaki gunung. Niatnya hanya ambil sedikit harta karun lalu menjualnya untuk memberi makan keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089704,
					"content": "Pada akhirnya, Adeptus menghukum keserakahan kami dan mengurungku di dalam amber. Jika Anda berdua tidak datang, entah kapan aku baru bisa keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089706,
					"content": "Diutus ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "Mengenai pelanggaranmu, keadaanmu, dan pertobatanmu, diriku telah mengetahui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "Bersyukur Adeptus masih welas asih. Anda berdua diutus untuk menolong kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089707,
					"content": "Ya! Saya terus menerus berdoa memohon pengampunan Adeptus, tepat di tempat kita berdiri sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089708,
					"content": "Anda berdua diutus oleh Adeptus. Tidak mungkin salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089710,
					"content": "Wow, boleh juga aktingmu. Macam ada bakat alami gitu, buat jadi utusan Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089711,
					"content": "Terima kasih. Kami menyesal dan tidak akan berani lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089712,
					"content": "Kami bersyukur bisa mendapat belas kasih dari Adeptus. Mulai sekarang kami akan hidup di jalan yang benar, walaupun kami harus banting tulang di dermaga sekali pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089713,
					"content": "Akhir kata, kami sudah terlalu lama menginjakkan kaki di tempat ini tanpa izin. Sebaiknya kami segera undur diri. Terima kasih, utusan Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089714,
					"content": "Terima kasih utusan Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089715,
					"content": "Coba kita utusan Adeptus betulan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Rasanya Adeptus yang satu ini sumbunya pendek sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Yah, kita enggak berbuat salah juga sih, jadi ngapain juga takut ... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Siapa berani menginjakkan kaki di kediamanku? Siapa yang lancang membebaskan si pencuri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10089602,
					"content": "Manusia yang bodoh, maju dan terimalah hukumanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				}
			]
