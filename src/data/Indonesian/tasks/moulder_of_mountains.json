			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "Ampunilah kami, wahai Adeptus! Mohon belas kasihan, wahai Adeptus yang mulia ... lepaskanlah kami berdua, izinkanlah kami melihat hari esok ... tolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080202,
					"content": "Ada apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "Kamu ... siapa? Apa yang terjadi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080204,
					"content": "Kami yang tanya duluan woy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080205,
					"content": "AH! Anda bisa berjalan tanpa kendala di Jueyun Karst ... artinya Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080206,
					"content": "Anda utusan Adeptus! Anda kemari untuk menyelamatkan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080207,
					"content": "Ngomong apa sih dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080208,
					"content": "Kasihanilah kami, wahai utusan Adeptus, selamatkan kami! Kami bersaudara tidak punya uang untuk menghidupi keluarga, kemudian mendengar kabar bahwa ada harta karun di dalam amber Mt. Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080209,
					"content": "Kami bodoh, kami bersalah, niatnya hanya mencari harta karun, lalu menjualnya untuk menghidupi keluarga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080210,
					"content": "Kami mengikuti <color=#00E1FFFF>jalur pendakian</color>, tapi tiba-tiba saja ... amber gunungnya menelan saudara saya, Li Dang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080211,
					"content": "Saya berlari sampai ke sini, kemudian saya sadar: Kami masuk ke dalam kediaman suci Adeptus tanpa izin, dan kami telah dihukum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080212,
					"content": "Saya tidak tahu harus bagaimana, dan langsung berdoa memohon ampun agar Adeptus mengasihani kami. Dan akhirnya, Anda berdua, utusan Adeptus, tiba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080213,
					"content": "Hah? Kami bukan utusan Adeptus. Kami ke sini mau cari Adeptus malah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080214,
					"content": "Tidak, tidak, tidak, Anda berdua pastilah utusan Adeptus ...  Anda yang akan menolong kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080215,
					"content": "Saya tidak tahu di amber yang mana saudara saya terperangkap ... Saya mohon, selamatkanlah dia! Kasihanilah kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080216,
					"content": "Ya sudah, aku cek dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "Syukurlah! Terima kasih atas belas kasihan Anda, wahai utusan Adeptus, saya bersumpah tidak akan berani lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080218,
					"content": "Mengenai pelanggaranmu, keadaanmu, dan pertobatanmu, diriku telah mengetahui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "Wuidih! Kalau ngomong kayak gitu, kamu jadi kayak utusan Adeptus betulan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080220,
					"content": "Terima kasih Adeptus Mt. Hulao, terima kasih utusan Adeptus! Kami tidak akan pernah berani lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				}
			]
		},
