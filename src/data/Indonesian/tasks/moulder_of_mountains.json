			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "Terima kasih utusan Adeptus, terima kasih telah menyelamatkan saudaraku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080602,
					"content": "Kalian pernah ketemu Adeptus di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "Hah? Tidak sih ... Seperti semua orang lainnya, kami hanya pernah dengar bahwa ada Adeptus yang tinggal di Mt. Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080604,
					"content": "Tapi orang biasa seperti kami mana mungkin bisa bertemu Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080605,
					"content": "Tapi Anda berdua utusan Adeptus, tentulah berbeda dengan kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080606,
					"content": "Akhir kata, kami sudah terlalu lama menginjakkan kaki di tempat ini tanpa izin. Sebaiknya kami segera undur diri. Terima kasih, utusan Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080607,
					"content": "Terima kasih utusan Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10080608,
					"content": "Coba kita utusan Adeptus betulan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Rasanya Adeptus yang satu ini sumbunya pendek sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Yah, kita enggak berbuat salah juga sih, jadi ngapain juga takut ... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Siapa berani menginjakkan kaki di kediamanku? Siapa yang lancang membebaskan si pencuri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10089602,
					"content": "Manusia yang bodoh, maju dan terimalah hukumanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				}
			]
		},
		{
