			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133507",
							"2"
						],
						"stepId": 4133507,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"4133507"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "Bagaimana? Apakah kamu sudah mendapatkan Whopperflower Nectar yang kubutuhkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Coba kulihat dulu. Oh... yang ini cukup bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Setelah catnya siap, selanjutnya yang kita butuhkan cuma menemukan tempat yang cocok saja, baru deh aku bisa mulai melukis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Huh, tunggu saja sampai penyair itu melihat lukisanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "Ah, aku baru ingat! Sudah tradisinya menerbangkan Lentera Xiao di Pelabuhan Liyue pada ketika Festival Lantern Rite. Orang-orang bahkan menuliskan harapannya di lenteranya, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Hehehe, aku juga sudah menyiapkan Lentera Xiao di sini, terus buat harapannya... rahasia deh. Aku tidak akan memberi tahumu, kalau kuberi tahu nanti tidak akan terkabul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Oh, hampir saja lupa, ini untukmu, anggaplah hadiah dariku. Terima kasih sudah membantu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
