			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "Tidak, begini salah, begitu juga salah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Oh, halo. Aku sedang mengumpulkan beberapa bahan di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Mengingat Festival Lantern Rite sudah berjalan lancar, aku sedang berpikir bagaimana aku bisa membuat lukisan yang menggambarkan pemandangan Pelabuhan Liyue selama festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "*huff* Mungkin permasalahnya ada di teknik aku atau sesuatu, tapi tidak peduli bagaimana aku melukiskannya, rasanya selalu ada yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Mungkin mengubah pemandangan yang kulihat bisa memberiku lebih banyak inspirasi, tapi sepertinya aku tidak dapat menemukan tempat yang lebih baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "Pengembara, apakah kamu tahu tempat-tempat indah yang cocok untuk melukis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "Kita cari saja ke sekeliling!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Oh, boleh juga. Kalau begitu, ayo kita pergi mencarinya bersama. Mungkin kita bisa menemukan tempat pemandangan yang sangat bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Pemandangan di sini lumayan bagus juga... Oh, siapa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "Namaku Qingzhou. Aku mungkin bisa disebut sebagai seorang penyair, kalau aku berani menganggap diriku begitu sih. Kalau kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350303,
					"content": "Ah, jadi kamu seorang penyair? Haha, aku adalah seorang pelukis dan aku sedang mencari tempat-tempat indah di sekitar sini agar dapat inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "Inspirasi? Kebetulan sekali, aku juga sedang mencari inspirasi nih. Kalau boleh tahu, apa tujuanmu mencari inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350305,
					"content": "Tentu saja aku bermaksud untuk melukis pemandangan Pelabuhan Liyue selama Festival Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "Ngomong-ngomong, kenapa kamu mencari inspirasi di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Ya, kebetulan sekali. Aku juga berniat untuk menulis puisi yang menggambarkan Pelabuhan Liyue selama Festival Lantern Rite. Sama sepertimu, aku juga orang yang mencari inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350308,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350310,
					"content": "Bukankah sebuah puisi rasanya terlalu sederhana? Bagaimana mungkin festival yang begitu menakjubkan seperti Festival Lantern Rite di Pelabuhan Liyue ini dapat dijelaskan hanya dalam beberapa baris puisi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Haha, kalau kamu tanyakan padaku, tentunya hanya lukisan hebat yang bisa menggambarkan semua hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "Sebuah lukisan hebat ya? Hehe, aku khawatir karya seperti itu hanya akan menyia-nyiakan kuas dan tinta bagus. Sebuah lukisan tidak akan pernah bisa benar-benar menggambarkan keindahan Lantern Rite dan menampilkan pesona Liyue secara akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350313,
					"content": "Selain itu, bagaimana mungkin kemegahan kota seindah Liyue terlukiskan hanya dalam sebuah lukisan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350314,
					"content": "Haha, kurasa lukisan akan menjadi pilihan yang lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Haha, kurasa puisi akan menjadi pilihan yang lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350316,
					"content": "Woah, kalian berdua tenangkan diri kalian dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Percuma juga berdebat seperti ini. Saran aku nih ya, kita masing-masing buat karya yang menggambarkan Pelabuhan Liyue selama Festival Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Setelah karyanya selesai, kita dapat memajangnya dan meminta seseorang untuk menilainya. Bagaimana kalau begini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "Saranmu boleh juga. Aku akan menunggu kehadiranmu di Wangshu Inn setelah kamu menyelesaikan... lukisanmu. Kemudian kita akan meminta seseorang untuk menilai karya kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350320,
					"content": "Oke, sepakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "Ya, sepakat. Kalau begitu aku permisi dulu, aku akan pergi sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350322,
					"content": "Dia benar-benar seorang penyair yang suka omong kosong. Bisa-bisanya dia yakin sanggup menggambarkan pesona Pelabuhan Liyue selama Festival Lantern Rite hanya dalam beberapa baris puisi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "Huh, lihat saja nanti! Dia bahkan tidak akan punya kesempatan setelah aku menyelesaikan lukisanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "Aku harus menuangkan semua kreativitasku untuk membuat lukisannya. Aku juga harus menyiapkan beberapa cat dan kuas khusus untuk ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "Pengembara, bolehkah aku meminta bantuanmu untuk mengumpulkan beberapa bahan khusus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Kalau begitu tolong ya, aku mengandalkanmu. Coba kupikir-pikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Hmm... aku butuh bantuanmu untuk mengumpulkan Whopperflower Nectar dari Pyro Whopperflower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "Kalau ada itu baru aku bisa membuat campuran cat khusus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "Kamu butuh bahan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
		{
			"id": 4133505,
