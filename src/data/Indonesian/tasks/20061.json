			"dialogs": [
				{
					"id": 200610101,
					"content": "Tentang para merpati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610102,
					"content": "Para merpati itu, akan lebih baik jika dipanggang bersama dengan beberapa jamur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "Aku awalnya memelihara mereka sebagai merpati pos, untuk mengirimkan pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610105,
					"content": "Tapi entah mengapa sekarang mereka tidak terlalu bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610106,
					"content": "Entah mereka kehilangan pesannya atau mereka terbang lama tapi tidak pernah mengirimkan pesannya. Atau mereka mungkin hanya diam dan tidak bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610111,
					"content": "Jika kamu ada waktu, tolong bantu aku untuk melihat kelompok merpati yang baru saja kulepaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610107,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "Terima kasih banyak, jika kamu melihat mereka bermalas-malasan, tolong buat mereka bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610109,
					"content": "Aku akan dibenci oleh para merpati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "Jangan khawatir, daya ingat merpati tidak begitu bagus, setelah beberapa saat mereka pasti akan lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610112,
					"content": "Lagi pula kamu tidak terlihat seperti pecinta merpati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
