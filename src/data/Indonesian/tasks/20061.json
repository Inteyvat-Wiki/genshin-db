						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Seharusnya sekarang mereka akan mengirimkan surat-surat itu tanpa bermalas-malasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Walaupun aku tidak bisa selalu mengikuti dan memeriksa mereka, tapi seharusnya sekarang semuanya akan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Terima kasih banyak, ini sebagai tanda terima kasihku, jika lain kali kamu perlu mengirim surat, datanglah kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
