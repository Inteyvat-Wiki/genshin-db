			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Tuan Kayvan, coba kamu pakai umpan yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Aku telah mencobanya beberapa kali, sama seperti sebelumnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Eh? Kenapa kalian berdua pergi memancing bersama lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "Pengembara, kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Halo, kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Kamu sudah tahu alasannya kenapa masih gagal menangkap ikan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha, tak ada sama sekali. Aku dan peneliti itu sudah mencoba mengganti joran, mengganti umpan, dan mencoba berbagai cara lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Tak tahu sudah berapa banyak perairan yang kami jelajahi, berpindah berapa banyak sudut ... bahkan aku juga sudah coba-coba memancing di dalam kolam yang penuh ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Tapi entah bagaimana, mentok-mentoknya aku hanya bisa memancing benda-benda lain dan bukan ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Tenanglah, Tuan Kayvan, bukankah pelajar tersebut juga sudah berjanji untuk menyelidikinya? Dia pasti bisa membantumu mencari penyebabnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Lihatlah, dia bahkan merancang umpan baru untukmu, dan memintaku terus menemanimu memancing, sambil mencatat semua detail tentang proses memancingmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Semoga saja dia bisa menemukannya ... tapi sebelum itu, aku lebih baik memakai caraku sendiri untuk memancing ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "Pengembara, kalau kamu senggang, bantu aku cari sedikit material untuk umpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Apakah ada hasil setelah berkonsultasi dengan peneliti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
