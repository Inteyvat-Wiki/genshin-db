			"dialogs": [
				{
					"id": 230360601,
					"content": "Bagus, selanjutnya aku akan mulai memancing, kali ini pasti bisa dapat ikan besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360602,
					"content": "Kayvan mengaitkan umpan, mulai memancing ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "Tak lama kemudian, Kayvan memancing keluar sebuah kotak yang basah ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "Ini ... coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360605,
					"content": "Eh? Barang yang di dalamnya ... sepertinya lagi-lagi ada barang yang hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360606,
					"content": "Memang kamu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "Umm ... setelah menemani Tuan Kayvan mencari peneliti itu untuk mengganti umpan dan kami terus memancing di luar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360609,
					"content": "Tapi setiap kali memancing ... Tuan Kayvan terus mendapatkan barang-barang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360610,
					"content": "Misalnya barang hilang milik orang lain, bijih mineral dari dasar laut, paket yang jatuh dari kapal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360611,
					"content": "Bahkan ada seorang petualang yang tidak sengaja jatuh ke dalam perairan dan naik ke darat dengan berpegangan pada pancingan Tuan Kayvan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360612,
					"content": "Tapi, kami tidak mampu memancing seekor ikan pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360613,
					"content": "Profesiku sebagai pemancing, tamat sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360614,
					"content": "Tu-Tuan Kayvan! Jangan putus asa, li-lihatlah, pemilik barang-barang ini pasti kepanikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360615,
					"content": "Kamu bisa memancing barang-barang yang hilang ini, pemiliknya pasti sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360616,
					"content": "Kita kembalikan barang-barang hilang ini ke Adventurers' Guild, mungkin saja kita bisa mendapatkan imbalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360617,
					"content": "Tapi! Aku benar-benar! Hanya ingin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360618,
					"content": "Memancing seekor ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360607,
					"content": "\"Lagi-lagi\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				}
			]
