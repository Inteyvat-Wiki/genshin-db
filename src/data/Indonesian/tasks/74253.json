			"dialogs": [
				{
					"id": 742530101,
					"content": "Jujur saja, aku masih syok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530102,
					"content": "Yah, waktu itu aku dan Alain pikir kamu sudah pergi dari dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530103,
					"content": "Hmm ... Kalau kami bangun lebih awal, mungkin kami bisa kunjungi kamu dan Alain. Tapi ... kurasa itulah takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Nona Mary-Ann ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Takdir bekerja dengan cara yang misterius. Siapa sangka Ann dan aku bakal lihat poster film yang ada potretmu di perjalanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Jadi, kalian hubungi aku karena itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530107,
					"content": "Tepat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah ... Aroma kopinya ... benar-benar mengingatkanku ke masa lalu ... Hehe, terima kasih sudah undang kami ke pesta teh, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Tamanmu elegan sekali. Cocok sekali untuk wanita anggun sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "Ini rumah yang dulu kutinggali dengan Alain. Kurasa wajar kalau aku menjaga keindahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530111,
					"content": "Tuh kan, kamu jauh lebih jago dibanding kakakku dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain bahkan tidak pernah menghias kamarnya, dia tidak bisa berhubungan dengan hal-hal indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Benar, Rene juga sama saja. Cuma aku dan Jakob yang bisa atur ruangannya, dan mempersiapkan pesta teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Jadi dia sudah kayak gitu dari kecil? Aku kira itu cuma faktor usia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530115,
					"content": "Dia memang selalu begitu. Dia mungkin pintar di bidang akademis, agak ceroboh dalam hal lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Mungkin alasannya dia satu-satunya di antara kita yang memilih kenyataan yang menyakitkan daripada ilusi mimpi indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Aku rasa dia tidak menyesal dengan pilihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530118,
					"content": "Tidak, karena itu keinginannya sebagai pahlawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "Yang menyesal itu kita. Keinginannya harusnya tidak pernah berdiri sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "Kalau Nona Sandrone? Apa ada sesuatu yang diinginkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain dulu pernah tanyakan pertanyaan yang sama persis kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530122,
					"content": "Hmm? Jadi dia juga tanyakan pertanyaan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Kakakku pasti sudah jauh lebih dewasa. Dulu dia tidak pernah tanyakan hal seperti itu sepengetahuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "\"Harapan\" itu kata yang hampa sekali. Apa kamu bisa dapatkan semua yang diinginkan? Heh, kalau benar begitu, tidak akan ada hal buruk di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530125,
					"content": "Aku lakukan apa yang ingin kulakukan, apa yang kuyakini benar. Aku tidak tahu apa ini termasuk keinginan atau bukan, tapi ini membuatku bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530126,
					"content": "Hmm, luar biasa. Aku iri padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Lalu apa kamu ... benci Alain? Karena dia menciptakanmu ... dengan wujud Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Tidak pernah kok. Dia selalu memperjelas kalau aku itu diriku sendiri: unik, berbeda. Aku harus pilih hidupku sendiri. Jadi itu yang kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530129,
					"content": "Haha, cerita atau makanan, selama kamu senang dengan pilihanmu, itulah pilihan yang tepat untukmu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Tepat sekali. Yuk nikmati makanan yang sudah kamu siapkan penuh perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
