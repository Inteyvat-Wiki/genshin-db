			"dialogs": [
				{
					"id": 742530201,
					"content": "Hidup itu paling indah kalau semuanya tenang dan damai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530204,
					"content": "Sudah waktunya ya? Haha. Kita harus lebih sering berkumpul, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
