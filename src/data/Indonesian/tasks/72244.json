			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hmm? Aneh sekali. Aku sudah lama tidak melihat orang berpakaian seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "Dari tingkah laku kalian, kalian juga bukan dari Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "Jangan-jangan, kalian pendatang jauh yang terjatuh ke tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Benar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "Ternyata ada jalan akses ke Byakuyakoku dari dunia luar. Benar-benar mengagetkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Sejak lahir di sini, aku belum pernah melihat orang yang datang dari dunia luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Seseorang mengatakan padaku kalau dia ingin sekali mengintip dunia luar. Aku bahkan menertawai dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "Pengembara, sejujurnya, aku punya satu permintaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "Ada tujuh batu nisan kerajaan yang tersebar di seluruh Byakuyakoku, batu nisan itu adalah sisa-sisa \"Sunchi{RUBY#[S]Phaethon}ld\" kami yang telah dikebumikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "Sunchild ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Ya, kami memuja Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Setiap beberapa tahun, seorang anak akan dipilih sebagai Sunchild yang memegang kekuasaan negara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Kami punya total ... tujuh Sunchild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "Wahai Pengembara yang datang dari negeri jauh, tolong berikan hormat pada nisan-nisan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Kenapa kami yang pendatang harus melakukan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Bukannya biasanya keluarga dan temannya yang harus memberi hormat pada mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "Biasanya memang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Tapi malangnya, tidak ada satu pun orang di bangsa ini yang ingin melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "Sejujurnya, batu nisan kerajaan itu sudah lama tidak dikunjungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "Tapi kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Apa orang-orang di negara ini tidak suka Sunchild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "\"Tidak suka\" mungkin ungkapan yang terlalu baik. \"Benci\" mungkin adalah ungkapan yang lebih pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Seperti yang kukatakan sebelumnya, mereka sudah ditakdirkan menjadi Sunchild sejak lahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Tapi bagaimana mungkin anak-anak seperti ini bisa mengurus sebuah negara, kan? Karena memang sebenarnya yang mengontrol semuanya adalah orang-orang dewasa di belakang mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "Sunchild hanyalah boneka-boneka mereka. Setiap gerakan mereka sudah diatur oleh orang-orang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "Dan keserakahan orang-orang ini tidak ada akhirnya. Mereka hidup makmur di atas penderitaan rakyat dan mengontrol Sunchild untuk melakukan perbuatan-perbuatan keji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "Karena itulah, kebencian rakyat timbul dan segala dosa kejahatan itu ditanggung oleh Sunchild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "Buruk sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "Padahal Sunchild tidak bersalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Tidak bersalah? Oh tidak, jelas tidak seperti itu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Bagi rakyat Byakuyakoku, ketidaktahuan mereka adalah dosa yang terbesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "Dosa yang dilakukan dalam ketidaktahuan dapat melukai orang. Mana bisa orang yang melakukan kekejian tersebut dikatakan tidak bersalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "Susah, kan? Nasi sudah menjadi bubur. Kerusakan yang terjadi tidak bisa dipulihkan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Tapi kalau menurutmu begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Ya, kamu bisa anggap kalau ini adalah permintaan pribadiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Namaku Clymene. Aku adalah pejabat wanita yang bertugas mengurus kehidupan sehari-hari Sunchild di dalam Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Meskipun aku tahu kalau mereka telah berbuat kesalahan, dan tahu kalau mereka dikontrol ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "Mereka tetap anak-anak yang kurawat sampai dewasa. Aku mengasihani mereka dan berduka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Dan aku juga tidak bisa membenci mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Pekerjaanku memang membuatku bisa dekat dengan mereka setiap hari, tapi aku juga diawasi secara ketat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "Aku dilarang keras berbicara sepatah kata pun waktu aku berada di sisi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Tapi ketika tidak ada orang di sekitar, saat mereka putus asa dan ketakutan, mereka akan mengatakan banyak hal kepadaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "Dan aku malah tidak bisa menjawab satu patah kata pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Kalau saja aku bisa memberanikan diri sedikit dan mengatakan sesuatu kepada mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Mungkin akhir dari semua ini akan berbeda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Jadi tolonglah, kumohon. Aku merasa malu untuk menghadapi mereka, dan inilah satu-satunya cara agar aku bisa memberi hormat pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "Tolonglah, Pengembara yang baik hati. Berikan bantuanmu satu kali ini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Yang kuminta hanya sebutir Sango Pearl, untuk diletakkan di makam mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "Dengan begini, kita bisa menyalakan Soul Lamp di kuil batu, membuka jalan ke Locus, dan mendoakan arwah mereka agar tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Terima kasih. Tugas ini kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Kenapa kamu mau kami memberi hormat kepada mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
