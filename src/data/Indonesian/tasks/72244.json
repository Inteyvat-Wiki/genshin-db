			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ahhh ... Ini Kekang Ilahi dan ini memang asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "Aku tidak pernah menyangka kalau aku akan bisa melihat benda ini lagi dengan mata kepalaku sendiri. Pengembara, di manakah kamu mendapatkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "Dari Aberaku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "Dari Aberaku no Mikoto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "Aneh. Aku ingat jelas kalau dia adalah tokoh besar waktu negara kami baru didirikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "Tapi katanya dia berencana untuk merebut kekuasaan Sunchild, jadi dia dicap sebagai pengkhianat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Kalau kamu bilang kamu mendapatkan Kekang Ilahi ini darinya, berarti mungkin ada rahasia yang tersembunyi di balik semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "Jadi takdir telah menetapkan kalau Kekang Ilahi akan muncul kembali ... Ah, wajah anak-anak pun kembali terbayang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "Dengan begini, akhirnya aku bisa menebus kesalahanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "Pengembara, lemparkanlah Kekang Ilahi ke dalam kolam di Locus ini. Kekang itu pasti bisa memulihkan serpihan jiwa mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Ya, agar jiwa mereka menjadi utuh, dan agar mereka dapat berjalan menuju alam kehidupan berikutnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
