					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Ah, tujuh Soul Lamp-nya sudah menyala ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "Sepertinya kalian sudah menyelesaikan tugasnya. Aku akan selalu mengingat utang budi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "Sekarang kemarilah, biarkan aku membuka ... jalur menuju Soul Guide's Locus untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "Wahai Pengembara yang datang dari jauh, aku telah begitu banyak merepotkanmu. Tapi kumohon, kuharap kamu dapat menyaksikan upacara penghantaran arwah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Ikuti jalan ini. Aku akan menemuimu di sisi luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
