							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon. Kamu kan suka baca buku, dan kamu sering bilang kalau di luar sana ada dunia yang tidak kita ketahui. Waktu itu aku tidak memercayaimu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Aku selalu tersenyum dan mengangguk-angguk saja dengan bualanmu. Ya ampun! Harusnya aku memercayaimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Kamu bilang kalau kamu akan kabur dari Dainichi Mikoshi dan bertualang di luar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Pergilah sekarang, Piramumon. Jangan biarkan siapa pun membelenggumu lagi. Pergilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "Dan kamu, Orupeusu, Orupeusu. Apa yang harus kulakukan untuk mendengarmu bernyanyi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Semua yang bisa mendengar suaramu yang begitu merdu dan jernih pastilah ingin ikut menyanyi dalam hatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "Malam sebelum Rite of Solar Return, kamu tiba-tiba ingin mendengar suaraku. Tidak peduli apa pun yang terjadi, kamu ingin mendengar nyanyianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Kamu berkata padaku, tidak peduli seberapa buruknya aku bernyanyi, kamu tidak akan tertawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Kamu pasti sudah tahu, kan? Bahwa Solar Return yang ini akan menjadi yang terakhir untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "Tapi aku ... Sampai pada akhirnya, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "Maafkan aku, Pengembara. Aku tidak sopan sekali tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "Petugas wanita yang melayani Sunchild harus menjaga kesuciannya ... Dia tidak boleh menikah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Sehingga seumur hidup aku jadi tidak punya anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Anak-anak ini, yang kulayani dan aku juga menyaksikan mereka tumbuh besar ... Aku merasa hubunganku dengan mereka bahkan lebih pekat daripada darah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "Terima kasih, Pengembara. Terima kasih karena sudah menemukan Kekang Ilahi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "Kekang Ilahi diwariskan dari Sunchild ke Sunchild, dan ingatan yang tersimpan di dalamnya pun sudah cukup untuk mengisi kekosongan dalam jiwa mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Walaupun ingatan ini memang mempunyai dua sisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Dua sisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Tentu saja. Dalam masalah ini, ingatan menjadi dua sisi. Di satu sisi, kamu punya ingatan sendiri, dan di sisi lain, kamu juga punya ingatan orang lain tentang dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Sehingga kekosongan tersebut diisi oleh ingatan para Sunchild, yang dipatri ke dalam Kekang Emas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Serta ingatan mereka sebagai anak-anak yang dikambing hitamkan oleh Byakuyakoku, mereka yang menjadi anak-anak pengemban dosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "Ingatanku sendiri tidaklah cukup, aku harus melengkapinya dengan ingatan orang-orang di bangsa kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "Dan berkat pelanggaran-pelanggaran yang telah menimpa mereka, mereka sekarang diingat oleh Byakuyakoku, sehingga dapat meninggalkan bayangan mereka di belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "Terima kasih, Pengembara. Harapan terbesarku kini terpenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "Akhirnya aku ... bisa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Ya, Akhirnya aku ... bisa bersama dengan anak-anak itu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Ingatan juga punya sisi masing-masing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
