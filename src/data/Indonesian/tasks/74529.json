				"points": []
			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#Ah, {NICKNAME}, kamu sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Citlali, lama tidak ketemu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Eh, jangan sembarangan, aku kadang-kadang juga suka jalan-jalan keluar kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "Lagi pula, menurut hasil ramalanku kemarin malam, akan terjadi hal baik kalau aku keluar hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Lihat aja, baru keluar rumah, hal baik sudah datang dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Kalau begitu, mari kita buat keberuntungan ini berlipat ganda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Bukan tidak boleh sih ... tapi, beberapa hari lalu aku begadang semalaman untuk baca novel volume terbaru sampai selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Tolong lihat aku sebentar, bagaimana mukaku sekarang? Kantung mataku harusnya sudah hilang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Kamu sama segarnya seperti biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Yang benar? Jangan bohong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Ingat ya, foto-foto yang tidak lulus penilaianku akan kusimpan sendiri ... kamu cuma boleh ambil yang bagus-bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Kamu terlihat berseri-seri kok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Izinkan aku ambil foto kamu ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Tumben tidak tidur siang di rumah, jarang sekali lho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
