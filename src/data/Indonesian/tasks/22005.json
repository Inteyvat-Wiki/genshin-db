				{
					"id": 220050301,
					"content": "Apa kamu menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050302
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050302,
					"content": "Ini bukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Coba kulihat... paketnya... Bukan, ini rasanya jauh lebih ringan, jelas yang ada di dalamnya bukan relik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050304,
					"content": "Tapi terima kasih, aku akan tetap mencarinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050305
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050305,
					"content": "Jatuh ke mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
