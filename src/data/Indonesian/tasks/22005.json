				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Sebenarnya di mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Woah! Kamu muncul dari mana? Bagaimana kamu bisa menyelinap diam-diam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Aku? Aku... seorang peneliti. Aku mempelajari bangunan kuno dan peninggalan dari Guili Plains. K—Kamu bisa memanggilku Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "Aku terlalu asyik dalam penelitianku sehingga aku lupa menaruh paket yang kubawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "Di dalamnya ada harta yang akhirnya kutemukan... sebuah relik bersejarah yang sangat langka. Bisakah kamu membantuku mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Syukurlah! Kurasa aku menjatuhkannya di dekat sini... atau mungkin sedikit lebih jauh. Bagaimanapun, tolong bantu aku cari dengan hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "Paketmu seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Hanya... sebuah paket kotak biasa. Sebuah kotak dengan empat sisi, atas, dan bawah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Mengapa meletakkan reliknya di sana? Karena... sepertinya akan lebih praktis kalau disimpan dalam kotak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Aku melapisi kotaknya dengan beberapa pakaian untuk melindunginya dari kerusakan. Tolong bantu aku menemukannya secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "Relik seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Ugh... pokoknya sebuah relik yang sangat berharga, kamu tidak akan mengerti bahkan jika aku mencoba menjelaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Hanya seorang ahli sepertiku yang dapat menilai harganya. Tolong bantu aku menemukannya secepat mungkin ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
