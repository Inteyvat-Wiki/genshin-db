			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "Badai... sudah mereda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580102,
					"content": "Sepertinya empat Batu Pelindung sudah tersegel semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "Ka-kamu! Bagaimana caranya kamu ke atas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580105,
					"content": "Taisuke bilang, kamu melewati sejenis pintu dan kemudian menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580106,
					"content": "Sebenarnya pintu apa sih itu? Aneh sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580107,
					"content": "Sebenarnya apa yang terjadi di atas sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Etsuko dan aku tiba-tiba mendengar suara gemuruh dari atas, suaranya mirip seperti guntur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "Padahal badai seharusnya sudah mereda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Sebenarnya inilah yang terjadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Batu-batu melayang di angkasa... membentuk sebuah platform...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Huh. Fenomena itu... Kuakui kalau aku belum pernah mendengar Pulau Seirai mengalami fenomena seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "... Hal seperti itu tidak seperti fenomena alam sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580114,
					"content": "Tidak peduli bagaimanapun kamu melihatnya, fenomena itu sangat tidak wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580115,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Tapi, mau fenomena alam atau bukan, badai di Pulau Seirai sudah mereda dan misi kita sudah selesai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580118,
					"content": "Kamu tahu tidak? Kami juga menemukan bulu aneh ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Ini... Taisuke, coba lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580120,
					"content": "Oke, biar kulihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Maaf, aku tidak tahu dari mana bulu ini berasal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "Pola bulu ini dan rasa sentuhannya tidak seperti bulu burung yang kukenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "Dan kalau kamu pelajari dimensi dan rasionya, ukuran burung ini pasti sebesar platform batu di atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "Apakah bulu ini penting? Kalau mau mengetahui sejarahnya, kenapa kamu tidak ajukan saja permohonan misi di Adventurers' Guild? Siapa tahu ada seseorang yang dapat memberimu petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580125,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "Ya, kalau begitu, terima kasih atas bantuanmu, petualang. Taisuke dan aku akan melapor kembali ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580128,
					"content": "Oh ya, ini untukmu. Tidak banyak sih, tapi menurutku kamu perlu dibayar untuk bantuan yang kamu berikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, bersiaplah dan kemasi barang. Kita akan kembali ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580130,
					"content": "Eh, Etsuko... Bagaimana kalau kita pergi ke kuil sebentar dan melihat Nona Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "... Taisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580132,
					"content": "Ayolah! Kucingnya bisa berbicara loh! Bisa bicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "*huff* Benar-benar deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580126,
					"content": "Aku akan memikirkannya sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Kamu benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}