						750110326
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110326,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110327,
						750110328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
