					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110329,
					"content": "Tablet batunya mengeluarkan suara dengungan yang nyaring.\\nDan saat tanahnya bergetar, batu raksasanya menampakkan wujud aslinya ....",
