			"dialogs": [
				{
					"id": 750110301,
					"content": "Wah wah, siapa sangka ada pulau tersembunyi di pusat Jagat Apung ... *huff* Pantas saja aku merasa ada yang berbeda dari gambar yang pernah kulihat.",
					"roleType": "TALK_ROLE_NPC",
