						750110309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110309,
					"content": "#Hmm ... {REALNAME[ID(2)|SHOWHOST(true)]} bisa lihat ini?",
