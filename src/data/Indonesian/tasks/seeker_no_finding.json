			"dialogs": [
				{
					"id": 750110101,
					"content": "Jadi ini Jagat Apung, ya ... Padahal kalau dilihat dari bawah, rasanya atas sini bakalan abu-abu kosong gitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110102,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "Siapa sangka ternyata begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110104,
					"content": "Betul. Katanya benda-benda mengambang di tempat ini digabungkan oleh kekuatan Phlogiston, sebuah sumber energi yang sangat kuat ... Sungguh fenomena yang aneh, tapi begitulah pemahamannya untuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110105,
					"content": "Ini tidak cuma menjelaskan kenapa rumput dan bunga bisa tumbuh di atasnya, tapi juga bagaimana ia dapat menghangatkan kembali tanah yang sudah dingin, dan menyulut api jiwa-jiwa dalam kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110106,
					"content": "Inilah Phlogiston ... yang direnggut oleh Sage Pencuri Api langsung dari genggaman naga raksasa, untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110107,
					"content": "Hmph, aku jadi kesal sendiri gara-gara kepikiran ada beberapa orang suku yang melihat Jagat Apung ini ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110108,
					"content": "Terus berani meragukan kalau manusia biasa mampu menciptakan pulau mengapung seperti ini dengan kekuatan Phlogiston, lalu dengan seenaknya menyimpulkan kalau Sage Pencuri Api juga sejenis naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110109,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "Mereka percaya sama itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "Cuma gara-gara mereka sendiri tidak mampu, langsung yakin yang mampu pasti bukan manusia biasa. Cih, aku tidak sudi dekat-dekat sama orang tolol seperti mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110114,
					"content": "Uhh, terus hartanya? Obatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110115,
					"content": "Itu kan alasan kita jauh-jauh ke sini, tapi kok kayaknya enggak ada apa-apa di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110116,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "Hehe, kita kan lagi diuji sama Sage Pencuri Api \"gila\", mana mungkin bakal sesederhana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110118,
					"content": "Kalau informasi dari gulungan kunonya benar, kita cuma perlu cari mekanisme buat diaktifkan, selesaikan ujian terakhir, lalu kita bisa sampai ke pusat Jagat Apung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110119,
					"content": "Tapi aku juga tidak tahu bentuk pusat Jagat Apung. Kalau dipikir-pikir lagi, rasanya gambar pulau terapung yang pernah kulihat dulu agak berbeda dengan yang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110120,
					"content": "Tapi mungkin karena sudah tua juga, bahkan daya ingat yang kubanggakan dulu pun mulai kabur. Tapi karena sudah sampai sejauh ini juga, kita andalkan naluri saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110121,
					"content": "Jadi kita gimana aktifkan mekanismenya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "Hmm ... Harusnya sama seperti Ukiran Phlogiston? Bisa dinyalakan pakai Phlogiston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110123,
					"content": "Setidaknya begitu caranya menurut gulungannya. Katanya Monumen Pahatan Phlogiston yang tersebar di seluruh Natlan pada awalnya didasarkan pada mekanisme di sini ... Jadi mekanisme ini sebenarnya adalah sebuah relik yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110124,
					"content": "Kalau lihat sejauh ini, kemampuanmu lumayan menjanjikan, hehe. Cobain sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110111,
					"content": "Kan terserah orang mau percaya apa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "Aku tahu pandangan orang terhadap dunia susah diubah, tidak mungkin bahkan, tapi ya tetap saja kesal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "Chikya"
				}
			]
		},
