						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Hehe, lihat tuh, si {REALNAME[ID(2)|SHOWHOST(true)]} juga semangat. Ayo, {NICKNAME}. Pakai Phlogiston untuk nyalain mekanismenya!",
