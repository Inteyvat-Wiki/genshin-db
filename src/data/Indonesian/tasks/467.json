				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "Berikutnya masak apa ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "Oh, kamu juga pengembara dari sekitar sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "Bukan, kami hanya kebetulan saja lewat sini. Kamu masak apa? Aromanya harum sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "Begitu rupanya. Selamat datang, pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "Namaku Lynn, pakar bertahan hidup dari Adventurers' Guild. Dan seperti yang kamu lihat, aku sedang bereksperimen dengan resep masakan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "\"Makan sebelum berangkat\" - Peraturan pertama Panduan Bertahan Hidup di Alam Bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "Piknik! Paimon suka sekali piknik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "Rekan perjalananku ini juga jago masak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "Aku hanya bisa masak masakan sederhana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "Tidak apa-apa, coba perlihatkan kemampuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "Ayo, jangan sia-siakan kesempatan untuk belajar langsung dari pakar bertahan hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "Di dalam gentong di belakangku ada Mushroom dan Fowl. Coba ambil dan buatkan <color=#00E1FFFF>Chicken-Mushroom Skewer</color> untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "Betul, aku juga suka memasak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "Oh! Pancinya sudah siap, coba perlihatkan kemampuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "Senang sekali! Akhirnya aku punya teman latihan memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				}
			]
		},
