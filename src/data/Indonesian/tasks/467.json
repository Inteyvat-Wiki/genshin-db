					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670305,
					"content": "Wow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670306
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670306,
					"content": "Oh... sepertinya tidak enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Rasanya sulit diungkapkan dengan kata-kata. Ya, masih bisa dimakan lah~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#{NICKNAME} hanya belum mengerahkan kemampuannya yang terbaik. Yang ini tidak masuk perhitungan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Ya, kamu masih memiliki potensi kok, asalkan kamu banyak berlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Aku masih punya beberapa bahan makanan di dalam tas. Kuberikan untukmu saja, sebagai ucapan terima kasih atas masakan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Kami boleh mengambilnya? Tapi bukankah kamu akan kehabisan bahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Tidak apa-apa. Bahan-bahan itu bisa dikumpulkan saat <color=#00E1FFFF>menjelajahi alam liar</color>. Kalian harus memperhatikan lingkungan sekeliling dengan teliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "<color=#00E1FFFF>Good Hunter</color> juga menjual makanan dan bahan-bahannya. Kalian bisa ke sana kalau punya waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Baik, terima kasih atas informasinya. Hei! Sisakan sedikit Chicken-Mushroom Skewer untuk Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
