				},
				{
					"id": 4671203,
					"content": "Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671204,
					"content": "*Nyam nyam*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671205,
					"content": "Wow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671206
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671206,
					"content": "Oh... sepertinya tidak enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671207,
					"content": "Wah, benar-benar enak! Kamu sangat berbakat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671208
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671208,
					"content": "Hehehe, enak bukan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671209,
					"content": "Dengan kemampuan memasakmu, kamu pasti bisa membuat masakan yang lebih bervariasi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671210,
					"content": "Aku masih punya beberapa bahan makanan di dalam tas. Kuberikan untukmu saja, sebagai ucapan terima kasih atas masakan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671211,
					"content": "Kami boleh mengambilnya? Tapi bukankah kamu akan kehabisan bahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671212,
					"content": "Tidak apa-apa. Bahan-bahan itu bisa dikumpulkan saat <color=#00E1FFFF>menjelajahi alam liar</color>. Kalian harus memperhatikan lingkungan sekeliling dengan teliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671213,
					"content": "<color=#00E1FFFF>Good Hunter</color> juga menjual makanan dan bahan-bahannya. Kalian bisa ke sana kalau punya waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671214,
					"content": "Baik, terima kasih atas informasinya. Hei! Sisakan sedikit Chicken-Mushroom Skewer untuk Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
