			"dialogs": [
				{
					"id": 200430301,
					"content": "Mengapa belum dikirim juga, aduh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "Ah... kios buahku kehabisan Sunsettia. Aku sudah memesan beberapa bungkus tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Namun belum dikirim juga. Dan banyak pelangganku yang menunggunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "Eury saja sudah tiga kali datang, dia hanya ingin <color=#00E1FFFF>tiga Sunsettia</color>. Aku tidak ingin kehilangan pelanggan lama sepertinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Aku masih harus menjaga kios... Andai saja ada orang yang bersedia mengumpulkan beberapa Sunsettia di luar kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Jika memang mendesak, aku bisa bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Kamu bersedia membantu? Bagus sekali, terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "Michelle akan segera datang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Tunggu! Kenapa Michelle pergi memetik buah dengan kondisi seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Kami akan membantunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
