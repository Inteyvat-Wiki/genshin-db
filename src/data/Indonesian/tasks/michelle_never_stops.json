				{
					"id": 200430401,
					"content": "Apa kamu menemukan beberapa <color=#00E1FFFF>Sunsettia</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Seharusnya di luar kota terdapat banyak <color=#00E1FFFF>Sunsettia</color>. Aku harus menjaga kios di sini, bisakah kamu berlari dan mengambilkannya untukku?",
