			"dialogs": [
				{
					"id": 200430601,
					"content": "Apa kamu sudah bicara dengan Quinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Quinn berkata kamu harus banyak istirahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Tidak ada yang dapat dilakukan di tempat Quinn hari ini, jadi pulang saja dan istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Oh ya? *fuhh* Sepertinya aku harus mencari hal lain untuk dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Eh, eh?! Apa kamu tidak mau istirahat? Ini kesempatanmu untuk istirahat loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Kalian sebaiknya berhenti sejenak dan rasakan apa yang ada di sekeliling kalian. Angin milik Barbatos pun masih bekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Kita yang dilindungi olehnya tidak boleh bermalas-malasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Omong-omong, kamu habis melakukan apa? Mengapa kamu berkeringat banyak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "Sepertinya kamu juga sangat sibuk. Tapi itu bagus. Bila kita bekerja lebih keras, kita berkeringat lebih banyak, dan kita lebih bisa merasakan angin Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Ini, terimalah sebotol susu ini. Minum dan kembalilah berjuang, karena pekerjaan kita di dunia ini tidak ada habisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
