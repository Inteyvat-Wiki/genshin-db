			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "Columbina! Kamu kok bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hmmm? Bukannya kalian yang sarankan aku jalan-jalan keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110603,
					"content": "Iya sih, tapi kamu enggak takut ketahuan sama Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone tidak tertarik dengan penangkapanku, dan anggota Fatui lainnya tidak mengambil risiko untuk mencariku sekarang. Mereka punya masalah lain yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110605,
					"content": "(Apa dia sedang membicarakan Rerir ...? Dia memang ancaman untuk semua orang di Nod-Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Yah, sekali-sekali jalan ke luar bagus juga sih. Jadi bagaimana menurutmu? Suka sama Kota Nasha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hmmm, aliran kuuvahki-nya agak berantakan, isi hati orang-orang sangat tidak tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110608,
					"content": "Tetapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110609,
					"content": "Tapi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Makanan yang kalian berikan padaku waktu itu, kalian beli di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110611,
					"content": "(Serius? Ternyata dia lagi mikirin Berries and Fried Meat?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Emmm, kalau kamu mau bisa kita antar buat beli. Ada banyak makanan enak lainnya juga yang enggak bakal bisa kamu makan di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "Kamu terdiam saja sejak tadi. Mungkin ada yang ingin kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110614,
					"content": "Aku khawatir soal Rerir ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Sayangnya, aku tidak bisa melihat apa yang dia rencanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110616,
					"content": "Sekarang dia sudah mendapatkan wujud fisik, kekuatannya tidak bisa diremehkan sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110617,
					"content": "Tapi kekuatannya itu juga mengandung obsesi, obsesi yang sedikit lagi berubah menjadi kegilaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110618,
					"content": "Entah obsesinya itu pada bulan atau sesuatu yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110619,
					"content": "Mungkin jika kita bisa mencari tahu apa yang menjadi obsesinya, kita bisa melawan dia nantinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110620,
					"content": "Tentang Fatui ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Jadwal harian Sandrone tidak pasti, sedangkan The Doctor selalu memerintahkan orang saja, sedangkan Arlecchino ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110622,
					"content": "Hmmm? Bukan itu yang mau kamu dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110623,
					"content": "Baiklah. Apa kamu sudah pernah mengunjungi Biro Desain Eksperimental mereka? \"Senjata\" itu akan menjadi bagian penting dari rencana Tsaritsa. Setidaknya itu yang kudengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110624,
					"content": "Kamu tanya apa rencananya? Sejujurnya, aku tidak peduli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110625,
					"content": "Aku sedang memikirkan tentang pesawat luar angkasaku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Kalau kamu mau, aku bisa bantu mencarinya di dalam Sumsum Bulan Abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110627,
					"content": "Tapi dari yang kulihat terakhir kali, kurasa pesawatmu itu sengaja disembunyikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110628,
					"content": "Mungkin ada seseorang yang ingin menyembunyikan kebenarannya darimu, atau dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110629,
					"content": "Dan tidak banyak yang bisa melakukan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60110630,
					"content": "Tidak ada pertanyaan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
