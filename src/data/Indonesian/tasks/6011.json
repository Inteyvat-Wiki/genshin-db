			"dialogs": [
				{
					"id": 60110901,
					"content": "Oh? Ada perlu apa kalian ke sini? Tidak kusangka bisa ketemu lagi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110902,
					"content": "Kamu sendiri ke mana aja selama ini? Jangan-jangan kamu kabur dari sesuatu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110903,
					"content": "Oh, tentu saja tidak! Aku hanya pergi ke tempat lain untuk membicarakan bisnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110904,
					"content": "Memang berkat kalian semualah toko kecilku bisa selamat. *hiks* Terima kasih, terima kasih sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110905,
					"content": "Sudah, sudah, cukup aktingnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "Heh? Aku tidak akting sama sekali kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110907,
					"content": "Dan aku sudah bilang kalau hargaku itu bagus? Ah, tapi kalian tetap memilih Curatorium of Secrets atau apa pun lah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110908,
					"content": "*huff* Kalau pelanggan setia seperti kalian saja meninggalkanku, pengusaha lemah sepertiku hanya bisa pergi mencari nafkah di tempat lain, kan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110909,
					"content": "Kamu terlalu waspada dengan Curatorium of Secrets itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "Bagaimana tidak? Memulai bisnis kecil di luar sudah cukup sulit, apalagi kalau ada saingan tangguh seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110911,
					"content": "Ah, sudahlah. Kekayaan dan nasib itu sudah jadi satu, tidak ada gunanya mengeluh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "Sejujurnya Nefer yang sekampung denganku juga pernah membantuku waktu pertama kali datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "Kalau mau salahkan seseorang, salahkan saja aku yang selama ini belum menemukan kesempatan untuk membuat dia berutang budi padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Jadi! Kalau dia butuh bantuan apa pun, jangan lupa untuk beri tahu aku dulu ya, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
