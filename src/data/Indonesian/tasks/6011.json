					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Pria ini sungguh seperti sebuah mercusuar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Di sinilah dia tinggal, seperti sudah sewajarnya, dan memancarkan cahaya kebaikan kepada semua yang ada di sekitarnya. Tapi ketika orang menjadi terbiasa dengan cahaya, mereka mulai lupa bahwa lentera itu ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Perlahan-lahan, bahkan dia sendiri juga merasa demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "\"Yang kulakukan bukanlah sesuatu yang besar. Aku belum melakukan yang terbaik, aku harus bersabar dan terus menunggu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Mungkin ini adalah akhir yang menyedihkan, tapi aku tetap bangga padanya karena sudah menerangi jalan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Setiap bayangan yang lahir dari cahaya akan mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Kasihan sekali dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Aku pernah mendengar sebuah cerita tentang Peri Lentera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Oh, aku juga pernah mendengar cerita itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "Dan aku ingin bilang hal yang sama padanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Begitukah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Yah, kamu benar. Mungkin usaha kita terlihat sia-sia karena Rerir tetap berhasil mencapai tujuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Tapi kami akan terus mengejarnya sampai akhir, meskipun hasilnya tidak seperti yang kami inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Pekerjaan ini mirip dengan Penjaga Makam—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Kami tidak ingin membangkitkan orang yang sudah mati, melainkan memberikan mereka kedamaian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Aku lega mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "Ka-Kalian lagi ngomongin apa sih? Ada yang bisa jelasin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Nanti ya, Paimon. Tunggu kita balik nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Ya sudah deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "Bagaimanapun juga, peran utama di upacara pemakaman ini bukanlah si Peri Lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "\"Pembawa cahaya, kamu telah membangun jalan menuju kemuliaan dan keadilan dengan darahmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "\"Perjalanan berlalu dengan cepat, dan kau dan aku, meskipun terluka, akan tetap berhenti sejenak dan melihat kembali ke cinta dan kebencian.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "\"Sampai dunia menutup matanya di malam yang kelam, sampai lentera dinyalakan perlahan, khusus untuk dirinya, dan cahayanya tidak dapat dilihat selain olehnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Terima kasih untuk semuanya, Sersan Mayor Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Jangan terlalu terpaku pada hasilnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
