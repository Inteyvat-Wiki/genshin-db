						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Karena aku tidak mau cari masalah dengan Starshyna. Kalau mereka tidak bisa mendeteksinya, kurasa para atasan akan memaksaku membawa lentera Ratnik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Bayangkan, seorang Ratnik yang membawa dua lentera. Pemandangan yang aneh, sekaligus tidak sedap dipandang mata. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Kenapa lenteramu bisa terdeteksi oleh para Lightkeeper?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
