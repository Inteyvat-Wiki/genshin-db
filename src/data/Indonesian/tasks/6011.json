			"dialogs": [
				{
					"id": 60110501,
					"content": "Bos, itu ... Bos masih ingat waktu aku bilang mau tanya soal pendapatmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Dari skala 1 sampai 10, kalau nanti kita mau kerja sama orang lain lagi, kira-kira Curatorium of Secrets harus kerja sekeras apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110504,
					"content": "Hanya 1 saja? Rendah juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Tebak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Nol?! Itu bukannya kita hanya taruh nama saja, tapi tidak kerja? Kalau begitu buat apa kerja sama-sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*huff* Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Maksudku, tidak ada batas atas atau bawahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Oh! Bos memang hebat ya, selalu berpikir ke depan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Tunggu, itu sih bukan jawaban! Ayo dong bos, sebut satu angka saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
