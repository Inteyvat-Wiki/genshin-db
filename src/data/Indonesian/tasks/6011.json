			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins? Jarang-jarang kamu datang ke sini. Aku sedang sibuk, tapi silakan lihat-lihat saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Sebenarnya aku datang mengunjungi Anda, Nona Aino. Ini, aku bawa camilan dari kota, rasa mentega tradisional. Mau ditaruh di mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Ssst! Jangan sampai terdengar oleh Ineffa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "Jadi ada cerita apa nih? Jangan bilang ... para Lightkeeper akan mengambil alih masalah Perburuan Liar karena insiden meriam itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "Dan menyalahkan seorang jenius seperti Anda untuk hasil yang tidak bisa diperkirakan oleh siapa pun? Tentunya tidak ada yang berani selancang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Kalau benar begitu, bisa-bisa tidak akan ada lagi terobosan teknologi baru untuk selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hmph, dasar mulut manis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Aku turut senang jika hati Anda kini lebih tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Jadi sebenarnya ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Ah. Boleh tolong bantu perbaiki lentera ini? Aku sempat perbaiki di Kota Nasha, tapi rusak lagi setelah pertempuran terakhir itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Seorang jenius sepertiku? Memperbaiki lentera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Oh, maaf. Mungkin seharusnya aku minta tolong ke Nona Ineffa ya, berarti camilannya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "Tu-Tu-Tunggu ... maksudnya, seorang jenius sepertiku pasti bisa memperbaikinya. Tunggu saja, sebentar juga beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "Lain kali kalau ada hal seperti ini lagi, kamu ingat untuk langsung mencariku dulu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
