			"dialogs": [
				{
					"id": 60110401,
					"content": "Krumkake telah matang. Silakan dinikmati selagi masih hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Terima kasih karena kamu selalu perhatikan hal ini, Nona Ineffa. Semoga hidangan ini menjadi saksi persahabatan kita sampai ke tahun-tahun yang akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Mengerti. Tapi Krumkake tidak bisa bertahan lama. Rasanya akan berubah dalam estimasi waktu satu minggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Uh, bukan itu maksudku sih ... hmmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Sepertinya ada tamu yang bersembunyi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Ah, pasti mereka mencium wangi Krumkake. Tidak apa, ayo sini. Ineffa teman kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Benar sekali. Aku juga bisa membuat omelet sereal sesuai selera kalian, lalu aku akan membagi-bagikannya untuk kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "Mereka bilang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Mereka ... sedang membicarakan alamatmu. Mereka bilang ikut pulang denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
