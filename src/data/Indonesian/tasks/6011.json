			"dialogs": [
				{
					"id": 60110101,
					"content": "Semuanya berkumpul kembali dan saling berbagi tentang apa yang mereka alami ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Untungnya, kita berhasil menekan kerusakannya hingga skala terkecil. Hanya ada beberapa penduduk yang terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Tapi sekarang Rächer of Solnari sudah mencapai wujudnya yang utuh, dan kita masih tidak tahu tujuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Kita seperti baru melepaskan Qucusaurus ganas ke alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "Maaf. Tapi kalian semua tahu Qucusaurus, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "Pa-Paimon ngerti sih, tapi kayaknya analogimu terlalu baik deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Dia bilang dunia ini tidak berarti baginya, jadi mungkin saja dia belum punya alasan untuk melawan kita sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Kalau tujuannya hanya untuk balas dendam, kita sudah tidak bisa melakukan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Aku aku masih boleh ... mengundurkan diri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Bercanda, bercanda! Tenang saja, Bos! Kita sudah tidak bisa mundur sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Ugh... ternyata meriam yang kubangga-banggakan malah jadi bikin susah saja .... Gah! Kalau begitu, biar kuhancurkan saja sekarang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Ini bukan salahmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Iya, lagi pula masih berguna buat Perburuan Liar yang biasa kok. Tetap semangat, Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, setelah ini kamu bertemu pihak Lightkeeper untuk mengurus beberapa hal. Tenang, aku sudah jelaskan semuanya pada mereka, aman kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "Terima kasih banyak, dan terima kasih juga karena sudah membantu kami mendapatkan kebenarannya dengan lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Kalau saja kamu mau lebih sering muncul di publik, kamu tidak akan sampai menderita seorang diri juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Heh. Terima kasih atas sarannya, aku akan memikirkannya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Hmmm. Mungkin itu salah satu keuntungan dari menggantikan Sersan Mayor Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Kamu bakal dipromosiin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Dia bercanda doang, Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Oh, tunggu. Cuma Paimon yang enggak ngerti ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#Oke, {NICKNAME}. Kalau kamu ada waktu kosong, bisa ikut aku sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Ada seseorang yang ingin aku antarkan ke perjalanan terakhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "Bukan salah meriamnya juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
