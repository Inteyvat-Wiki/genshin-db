			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Loh, Kokomi belum datang juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Aneh sekali. Dia bukan tipe orang yang bisa terlambat ... Kita coba tunggu sebentar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Kenapa dia masih belum datang juga? Apa dia terkena masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Ayo kita tanyakan pada prajurit di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Apa kamu sedang mencari Yang Mulia Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Maaf, tapi dia sedang tidak ada di sini. Aku tidak tahu dia pergi ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Aneh ... Kalau begitu kita pulang saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Tidak perlu. Seingatku, Yang Mulia sudah memberikan arahan untuk situasi seperti ini dalam Petunjuk Operasional Umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Coba kuperiksa ... Ah benar, Nomor 98. <color=#00E1FFFF>\"Jika ada tamu yang datang dari jauh dan keberadaanku tidak diketahui. Arahkan mereka ke selatan hingga sampai ke pohon berdaun ungu.\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Catatan kakinya juga menuliskan kalau cara ini hanya berlaku saat Yang Mulia tidak memberi tahu ke mana dia akan pergi ... dan kalau tamu yang datang adalah tamu yang sangat penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Sepengetahuanku sih kalian memenuhi dua kriteria itu. Aku selalu membawa petunjuk ini bersamaku, jadi aku yakin ini langkah yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi benar-benar sudah memikirkan semuanya! Baiklah, ayo kita ke tempat yang dia tuliskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Ternyata kamu ada di sini! Kita bukannya mau mempersiapkan Pesta Kemenangan hari ini? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh ... Kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Ma-maaf ... Aku merasa tidak seperti diriku hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "Kamu sakit? Astaga, ayo ke dokter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Bu-bukan begitu ... Hanya saja, energiku sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "Ka-kamu butuh energi? Hah, jangan-jangan kamu robot kayak Ruin Guard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Bukan begitu, itu hanya istilah saja. *huff* Aku malu mengakuinya, tapi aku tidak bisa terus menjadi orang yang serba mampu seperti biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Kemarin banyak yang minta tolong padamu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Oh ... kamu menyadarinya? Berarti aku masih belum begitu bisa menyembunyikan perasaanku ya. Aku harus berlatih lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Sejujurnya, aku tidak begitu cocok untuk jadi pemimpin. Awalnya, cita-citaku adalah untuk membaca berbagai strategi militer dan menjadi seorang penasihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Terus berkomunikasi dengan orang lain, terus menyemangati mereka, membaca isi hati seseorang, memastikan semua orang mendapat pengakuan yang seharusnya ... Semua ini butuh usaha yang sangat keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Kita harus membuat orang merasa senang dengan keberadaan kita, tapi juga tetap harus menjaga agar kita dihormati ... Aku tidak begitu ahli dalam hal ini. Sejujurnya, aku sendiri tidak ingin diperlakukan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Tapi karena garis keturunanku, cepat lambat aku pasti akan menjabat sebagai Pemimpin Suci Pulau Watatsumi. Suka atau tidak, pasti tetap akan terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Jadi setiap kali aku merasa lelah, aku datang ke sini untuk membaca buku dan menenangkan diriku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Tenang saja, tidak akan memengaruhi pekerjaanku kok. Persiapan untuk Pesta Kemenangannya sudah kuserahkan pada orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Aku harus berpidato nanti malam dan aku tidak boleh membuat para prajurit merasa ada sesuatu yang salah. Kedamaian ini kita menangkan dengan susah payah, aku mau mereka semua merasa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Apa ada yang bisa kita bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Harusnya energiku akan kembali kalau aku istirahat sebentar lagi. *huff* Andai saja aku bisa membaca strategi militer yang kusuka, pasti akan pulih lebih cepat lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "Terakhir kali aku ke sini aku sedang membaca sebuah buku, tapi baru sampai setengah. Kutaruh di mana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Biar kita yang carikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Dan kita akan bacakan untukmu, biar kamu semakin cepat pulih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Kamu mau membantuku? Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Hehe ... Aku beruntung sekali kalian kembali ke Pulau Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Aku juga merasa kamu tertekan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
		{
			"id": 1202203,
			"completionStepIds": [
				1202217
			],
