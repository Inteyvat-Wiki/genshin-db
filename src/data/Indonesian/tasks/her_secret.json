			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220301,
					"content": "#Hei, lihat deh, {NICKNAME}. Ini bukan ya buku yang dicari Kokomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "\"Hari ini kapten Swordfish sudah kembali. Energi +4 ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ah, itu ... itu sih, em ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "Kita tidak lihat apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Berikan. Bukunya. Padaku.",
