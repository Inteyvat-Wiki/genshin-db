			"dialogs": [
				{
					"id": 722330501,
					"content": "#Masih ada pertanyaan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "Tentang Byakuyakoku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Pada zaman dahulu kala, Enkanomiya dikenal dengan nama Byakuyakoku. Tidak ada matahari maupun bulan di bawah tanah, yang ada hanyalah dua fenomena astronomi, yaitu Whitenight dan Evernight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Salah satu leluhurku adalah miko bernama Eboshi. Dia adalah orang penting dalam sejarah Byakuyakoku. Karena dirinya lah, aku menjadi penanggung jawab Watatsumi Goryou Matsuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
