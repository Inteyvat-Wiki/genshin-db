			"dialogs": [
				{
					"id": 722330401,
					"content": "#Ada lagi yang mau kamu tanyakan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "Tentang sigil kuncinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Sigil kuncinya diletakkan di lokasi Sirip dan Jantung Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "Jujur saja, kami mau mencari titik tengah antara jarak dan rahasia. Kedua kuil ini kebetulan ada di tempat yang cukup sulit ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "Kami sudah berusaha sebisanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Bagaimana cara aku menemukan altarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Kamu bisa menemukannya di bagian utara dan timur. Ada di dinding gunung kedua yang mengelilingi Moon-bathed Deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "Kalau kamu menarik sebuah garis antara Sangonomiya Shrine dan Sirip serta Jantung Watatsumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "Lalu hubungkan garis-garis itu dengan lengkungan dinding gunung, kamu akan mendapatkan dua titik tempat. Itulah tempat altarnya berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
