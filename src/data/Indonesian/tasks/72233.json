				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Halo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Halo, Tsuyuko. Sudah sampai mana persiapan kamu buat urusan koral itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ah, persiapan kami ... mengalami sedikit gangguan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Tsuyuko, kamu boleh saja pasang muka sedih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Tapi kamu enggak bisa bohongi siapa-siapa kalau kamu lempar pandangan penuh arti kayak gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ah, begitu ya. Jadi kalian juga sudah tahu situasi kami. Kalau begitu, aku tidak perlu menyembunyikan apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Dari awal juga kamu memang enggak sembunyiin apa-apa woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Kami memang sudah berhasil mendapatkan Key of the Moon-bathed Deep, dan Enkanomiya juga perlahan-lahan sudah mulai bangkit. Namun, kami kekurangan orang, dan kemajuan penyelidikan kami juga jadi sangat lambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Yah, kesulitan kali ini memang lain dari yang lain. Kami juga belum tahu apakah hubungan dengan Pulau Narukami bisa cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Kamu sadar aku cuma punya dua tangan ini, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Ah, itu sih beda lagi. Kamu harus tahu kalau tradisi kami bilang kehadiran seorang \"pahlawan\" sangatlah penting dalam proses mendapatkan koral itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Kami harus mendirikan markas, untuk membantu sang pahlawan menapak tilas langkah-langkah leluhur kami, sampai akhirnya siap untuk menghadapi ujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "Dengan cara ini, kita sama-sama menyusuri jalan menuju kemenangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Yah, rencanamu begitu, tapi kamu enggak bisa jalankan karena kurang orang kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Tepat sekali. Dan lagi, bahkan batang hidung sang karakter utama, sang \"pahlawan\" kami saja belum kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "Tunggu, kurasa aku tahu sekarang. Pahlawan kami ... Ya, pahlawan kami berambut pirang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Haduh, ampun deh, pasti ini merepotkan. Paimon mulai merasa datang ke sini itu salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Ah, penjelajahan biasa membuahkan hasil harta karun yang langka. Maksudnya, barang seperti itu biasanya akan langsung diserahkan ke Klan Sangonomiya, tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Tapi kalau kalian menemukan sesuatu, yah, kali ini keadaannya beda, mungkin kami bisa tutup sebelah mata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Tutup saja dua-duanya sekalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "Pahlawanku, pendekar saktiku, panutanku, dan penyelamat hidupku! Ini artinya kamu setuju, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Ah, kami mana mungkin menelantarkan Sangonomiya ketika krisis besar melanda, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Mantap! Sepertinya cara membujuk yang diajarkan Yang Mulia Kokomi memang manjur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Dia bahkan sudah perkirakan kalau kalian akan kembali untuk mencariku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Maaf, kamu ngomong apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Oh, tidak, bukan apa-apa. Nah, tolong ikutlah denganku. Aku mau perlihatkan sesuatu pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Kita ketemu di altar yang di sebelah bawah area depan kita. Kalau tidak kelihatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Kalau tidak kelihatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Lihat saja ke arah tenggara dan sipitkan mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Yah, kami memang punya hubungan baik dengan Yang Mulia Sangonomiya Kokomi sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
