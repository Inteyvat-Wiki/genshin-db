			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Kita menyebutnya \"sigil kunci\", itu adalah lambang yang dulu digunakan di seluruh Enkanomiya. Dia hanya akan muncul saat jalurnya akan terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Konon ini adalah set kunci kedua yang dikirimkan ke para penduduk Pulau Watatsumi saat Enkanomiya bangkit. Dan menurut catatan kami, total ada lima jenis sigil kunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Saat ini kita sudah menemukan tiga dari lima jenis di Pulau Watatsumi. Lalu kita bisa mengoperasikannya dengan cara ini dan mengembalikan ke tempat seharusnya untuk membuka segel itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Kita sudah mencabut tiga sigil yang kita temukan dari lubang kuncinya lalu meletakkannya di tempat lain di Pulau Watatsumi. Dengan begini penghalangnya bisa diaktifkan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "Tentu saja untuk mencegah anak-anak, mata-mata Fatui, penduduk Pulau Narukami, atau orang asing menyelinap masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Emmm, tapi kamu tidak termasuk \"orang asing\" itu kok, tenang saja. Hahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Saat ini kita tidak bisa menghubungi Adventurers' Guild, jadi para petualang juga tidak boleh pergi ke sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Memangnya kalian pernah memperbolehkan mereka turun ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Berdasarkan catatan sejarah, pernah. Kita sedang mencari cara agar semua pihak senang. Bagaimanapun juga, mereka adalah orang-orang yang ahli menjelajah, termasuk dirimu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Oho, jadi kali ini tidak ada orang yang curi start, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Hei, Paimon, mana sopan santunmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Hmmm, bagaimana ya? Kurasa tindakan kita kali ini tidak bisa jadi jaminan. Ada jeda waktu antara investigasi lokasi sigil kunci dan mencabut kunci, jadi kurasa pasti ada yang berhasil menyelinap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Kita kan kekurangan orang ... Jadi kalau kamu ketemu Fatui, Treasure Hoarder, Kairagi, atau sejenisnya ... Silakan beri mereka pelajaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Tunggu dulu. Kalau mereka bisa turun ke sana dengan gampangnya, buat apa kita ambil Key of Moon apalah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Enkanomiya hanya akan bangkit kalau kita berhasil mengambil Key of the Moon-bathed Deep. Hanya kunci itulah yang bisa menjalankan semua sistem yang ada di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Kalau ada orang yang masuk ke Enkanomiya bukan untuk melakukan Watatsumi Goryou Matsuri ... Mungkin saja ada jalan masuk lain yang jahat dan berliku-liku. Siapa tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "Jadi kumohon kalian cepat-cepat mengambil kembali sigil kunci lainnya di Pulau Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Sigil kunci ini diletakkan di Sirip Pulau Watatsumi dan Jantung Pulau Watatsumi. Sedangkan dua altarnya bisa ditemukan di sebuah garis yang menghubungkan kedua altar ini dengan Kuil Sangonomiya berpotongan dengan dinding gunung kedua yang mengelilingi Moon-Bathed Deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Baiklah kalau begitu, akan kutunggu kabar dari kalian di tempat biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
