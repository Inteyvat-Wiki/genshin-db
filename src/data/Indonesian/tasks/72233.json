				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Sekarang saatnya untuk melepaskan segelnya. Ini, ambillah Key of the Moon-Bathed Deep yang kamu ambil sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Coba bilang sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "Key of the Moon-Bathed Deep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Coba bilang tiga kali lagi dengan cepat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Key of the Moon-Bathed Deep, Key of the Moon-Bathed Deep, Key of the Moon-Paved ... agh! Lidahku kegigit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Tuh, kan? Udah Paimon bilang namanya aneh! Bisa ganti nama tidak sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Yah, kalau kita ganti namanya sekarang pun, baru bakalan kelihatan hasilnya beberapa abad lagi. Biarkan saja dulu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "Ehem, baiklah. Aku akan memulai ritualnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Sayangnya, kita tidak punya informasi apa-apa tentang uji coba Enkanomiya, jadi kamu hanya bisa mengandalkan dirimu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Kalau mau menyalahkan seseorang, salahkan tradisi yang mengatakan kalau kita harus \"menjaga misteri\". Semoga berhasil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Kalian juga jangan memaksakan diri ya. Yang penting kalian selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
