			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Hmm. Rasa dan tampilan ini... Tri Flavored Skewers ini bisa disebut sebagai Extreme Skewers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "Extreme... Skewers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Hehe, maksudnya ini adalah hidangan sempurna... Oh, lihat saja waktunya. Jewelry Soup dari Xudong seharusnya sudah siap juga sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Tentu saja, inilah Jewelry Soup yang kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Meski aku tidak meluangkan waktu untuk mengolah bahan-bahannya, kuah supnya mungkin juga mendidih sedikit lebih lama dari yang seharusnya, tapi rasanya harusnya masih lumayan lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Silakan dicicipi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Ya, memang ada sedikit bau gosongnya, meski tidak merusak hidangan sepenuhnya, tetapi juga tidak bisa disebut hidangan yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahaha, kali ini aku masaknya terlalu terburu-buru. Lain kali aku akan menyiapkan bahannya terlebih dahulu, seharusnya tidak akan ada masalah seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Aku kalah kali ini, tapi lain kali aku tidak akan membuat kesalahan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Sepertinya kamu ceroboh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Hahaha... Ya, aku kalah karena kelalaianku. Aku akan lebih berhati-hati di duel selanjutnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "Oh iya, Pengembara, ini untukmu, terimalah. Terima kasih telah membantu kami sekian lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Kalau kita berduel masak lagi, kamu juga harus ikut lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Extreme Skewers buatan Paman Munehisa menang telak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Extreme Skewers? Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Maksudnya, kualitas Tri-Flavored Skewer ini sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "Yang disebut \"Kesempurnaan\" berarti tidak boleh puas dengan \"lumayan\" tapi terus berjuang untuk terus mengejar kesempurnaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Begitu pula dengan memasak, hanya dengan mengejar kesempurnaan kamu baru bisa mencapai puncak keahlian memasak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "I-iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "I-iya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Bukan hanya di seni bela diri, dan juga saat memasak, tapi juga cara hidup kita sebagai seorang manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Xudong, kemarilah. Aku akan menjelaskan jalan menuju kesempurnaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "Hah? Tu-tunggu sebentar, aku akan segera ke sana sekarang. Pengembara, ini terimalah bayaranmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Ugh... Aku tidak tahu bagaimana caranya menghadapi orang yang begitu... serius. Hanya Julie yang bisa menghadapinya, tapi sekarang dia sedang tidak di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Kamu pergi rasakan Makna Terpenting dalam Memasak deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Tuan Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Eh? Iya, aku segera ke sana! Sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
