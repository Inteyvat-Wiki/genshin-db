			},
			"dialogs": [
				{
					"id": 220210701,
					"content": "Terima kasih atas kesediaanmu untuk membantu. Meski membuat Tri-Flavored Skewer ini sederhana, namun tetap harus memperhatikan kesegaran bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Aku sudah menyiapkan bahan-bahan lainnya, tetapi masih kurang beberapa Bird Egg... Untuk berjaga-jaga, bisakah Anda membantuku mendapatkan dua Bird Egg segar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Mohon bantuannya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Di mana kamu belajar cara membuat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Ketika diriku masih bekerja di Shogunate, aku sering memasak hidangan semacam ini dan dinikmati bersama rekan-rekanku sambil minum-minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Tapi sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Lebih baik tidak perlu membicarakan masa lalu lagi. Mohon bantuanmu untuk mencari Bird Egg-nya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Aku akan menyiapkan bahan-bahannya di sini, tolong bawakan Bird Egg secepat mungkin setelah kamu mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
