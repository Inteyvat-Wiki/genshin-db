				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "Sudah selesai, terima kasih, Pengembara. Cium saja aroma ini, wanginya pas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Aku akan mencicipinya dulu... Ah, bahan-bahannya dimasak dengan takaran yang pas dan aromanya juga sangat sedap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Bisa dibilang ini adalah sebuah Jewelry Soup yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "Oke, bagaimana dengan hidanganmu, Paman Munehisa? Sudah siap untuk disajikan kepada pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Hmm, sayang sekali aku melakukan kesalahan. Waktu aku mulai memasak, aku baru sadar kalau Bird Egg yang dibutuhkan kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Meski aku bisa langsung mengambil beberapa Bird Egg dari hutan di sebelah, sisa bahan lainnya jadi dimasak terlalu lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Tri-Flavored Skewers yang dibuat dengan bahan-bahan yang tidak begitu segar tidak bisa lagi disebut sebagai hidangan yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Sungguh memalukan bisa timbul kelalaian seperti ini, sepertinya aku masih membutuhkan lebih banyak latihan dalam memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Aku kalah kali ini. Tetapi lain kali, aku pasti akan mengalahkanmu, Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Semangat, Paman!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Hehe, tapi aku juga tidak semudah itu untuk dikalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "Oh iya, Pengembara, ini untukmu, terimalah. Terima kasih telah membantu kami sekian lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Kalau kita berduel masak lagi, kamu juga harus ikut lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Sebenarnya menurutku rasanya lumayan enak kok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Tidak, bahkan saat memasak pun, kamu harus selalu mengejar kesempurnaan. Tidak boleh puas dengan kata \"lumayan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "Dengan begitu, baru kita bisa mencapai puncak tertinggi dalam keahlian memasak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "I-iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "I-iya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Bukan hanya di seni bela diri, dan juga saat memasak, tapi juga cara hidup kita sebagai seorang manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Ah... Bagus! Semangat, Paman Munehisa! Aku percaya padamu, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Ugh... Aku tidak tahu bagaimana caranya menghadapi orang yang begitu... serius. Hanya Julie yang bisa menghadapinya, tapi sekarang dia sedang tidak di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "Benar-benar mengejutkan ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "Terima kasih atas bantuanmu, Pengembara. Terimalah barang-barang ini, aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Xudong, aku ingin menanyakan beberapa pertanyaan tentang memasak. Apakah Anda punya waktu luang saat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Hah? Ya! Tentu saja, aku segera ke sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
