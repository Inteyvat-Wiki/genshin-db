			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Masakanku ini adalah andalanku, siapkan hatimu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Hidangan buatanku ini pun sangat enak, silakan persiapkan hatimu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Kalian sedang apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "Oh, Pengembara. Jadi begini, Parvaneh dan Julie sedang pergi mencari bahan-bahan dan kami berencana menyiapkan makanan untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Tapi ada perbedaan pendapat antara aku dan Paman Munehisa tentang apa yang harus dihidangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Jadi aku dan Paman Munehisa berencana membuat hidangan andalan masing-masing untuk mengasah kemampuan memasak kami, sekaligus untuk memutuskan hidangan hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Aku berencana membuat masakan khas Liyue, Jewelry Soup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Aku akan menyiapkan hidangan istimewa Tri-Flavored Skewer untuk menyainginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Butuh bantuanku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Oh, kalau kamu ada waktu luang, kami butuh juri untuk menilai hidangan kami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Tetapi masing-masing dari kami cuma ada satu orang, sedangkan setiap hidangan harus disiapkan untuk porsi empat orang, mungkin tidak akan keburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Sebelum menilai rasanya, tolong bantu kami menyiapkan hidangannya dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "Tentunya karena kamu sendirian saja, jadi kamu bebas memilih mau bantu hidangan yang mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, apakah kamu sanggup menyiapkan hidangannya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Jangan khawatir, dulu aku kan pernah buka restoran di Liyue, menyiapkan masakan ini sih bukan masalah bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Tapi kalau ada yang bisa membantu, hidangannya bisa dimasak dengan lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Pokoknya kamu pilih sendiri saja kamu lebih ingin bantu menyiapkan hidangan yang mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Oh! Bagus sekali, Paman Munehisa bersiaplah, kamu akan kalah oleh masakanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Aku tidak akan mengaku kalah semudah itu, Anda tidak akan menang begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Paman Munehisa, aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Terima kasih banyak. Berhati-hatilah, Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Tidak masalah, siapa takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Paman Munehisa, apakah kamu sanggup menyiapkan hidangannya sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Anda bebas memilih sesuai keinginan hatimu. Ketika masih berada di Shogunate, aku juga sering menyiapkan hidangan untuk beberapa orang, kalau menyiapkan untuk empat orang saja tidak akan jadi masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "Tapi kalau Anda bersedia membantu, hidangan yang disajikan tentunya akan menjadi lebih nikmat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "Kalian pasti kekurangan seorang juri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Hahaha, iya, kami memang membutuhkan seorang juri untuk menilai hidangan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
