				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Ini... barang yang kupesan, akhirnya datang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "Dari pakaianmu, teman, kamu pasti bukan orang lokal Liyue. Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "Ah, teman, aku tidak tahu apa kamu sudah mendapat kesempatan untuk mencicipi hidangan Liyue atau belum, tapi hidangan Liyue benar-benar enak. Percayalah padaku, hidangan Liyue layak untuk dicicipi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "Baiklah, karena kini kargo milikku sudah tiba, aku bisa kembali makan dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
			"completionStepIds": [
				7181610
