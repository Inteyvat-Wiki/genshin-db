			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "Bagaimana caranya aku mengirimkan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "Oh ternyata Pengembara. Kamu cukup beruntung karena kamu datang ke Liyue tepat saat Lantern Rite berlangsung. Sedangkan aku, tidak punya banyak waktu untuk menikmati festivalnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "Kami orang lokal Liyue mempunyai tradisi untuk menerbangkan Lentera Xiao saat Lantern Rite. Setiap tahun, jumlah bahan pembuatan lentera yang berkeliling melalui jalur perdagangan sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "Dan ini mungkin hanya imajinasiku saja, tapi sepertinya tahun ini muatan kargonya lebih banyak dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "Aku benar-benar sibuk sendirian dan pedagang ini terus-terusan mendesakku, tanpa memikirkan kondisi jalanan di Liyue sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "Aku ingin meminta bantuan seseorang, tapi belum menemukan orang yang cocok. Apa kamu bersedia membantu untuk pekerjaan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Bagus! Aku senang orang yang terus terang begini. Andai saja orang-orang yang bekerja untuk mengawal pesanan sama sepertimu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "Namanya Fran... um.... Francis. Ugh, nama orang asing begitu susah untuk diucapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Jika kamu mau membantu, temui aku di tempat di mana bahan-bahan tersebut disimpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "Aku sudah menandai tempatnya pada petamu. Aku akan ke sana duluan, ayo kita bertemu lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "Pedagang dari Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Benar. Namanya... Fran... Francis? Aduh, nama orang asing susah untuk diucapkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "Aku tidak tahu dia mau apa dengan begitu banyak bahan, tapi... ah sudahlah, yang penting dia bayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Jangan khawatir, kamu akan mendapatkan imbalan yang setimpal setelah pekerjaan ini selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
