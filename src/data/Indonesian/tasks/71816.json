					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7181606"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181610",
							"2"
						],
						"stepId": 7181610,
						"stateName": "QUEST_STATE_UNFINISHED"
