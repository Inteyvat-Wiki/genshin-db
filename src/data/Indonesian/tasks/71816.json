			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Aku sudah menghubungi Francis. Dia sudah menerima kargonya, terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "Kapan kamu menghubunginya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Haha, oh, jangan khawatir. Pengawal bayaran sepertiku melangkah lebih cepat daripada orang-orang pada umumnya, jadi jika berkaitan dengan perihal serah terima... kami juga akan sampai di tujuan dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "Berkat jasamu penyerahan kali ini berjalan lancar. Dan aku adalah orang yang selalu memberi imbalan dengan layak. Jadi tolong tunggu sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Kamu tidak mau istirahat untuk merayakan Lantern Rite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "Dalam bisnis kami, kamu tidak akan pernah tahu kapan pekerjaan datang. Aku bahkan tidak bisa berada di rumah untuk Lantern Rite... tapi... ya sudah, mau bagaimana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Jika kamu bertualang, kamu harus pergi ke Liyue untuk merasakan suasana Lantern Rite. Semua orang harus menerbangkan Lentera Xiao pada saat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "Bagaimana dengan kamu sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Oh, aku bekerja di luar kota sepanjang tahun. Tidak pernah ada waktu untuk menerbangkan Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "Jika aku punya satu lentera yang sudah selesai dibuat, rasanya boleh juga menerbangkan lentera tersebut untuk keberuntungan, namun aku belum punya waktu untuk membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "Aku melewatkan festival meriah itu, tapi itu tidak menjadi masalah bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Aku akan membuatkan satu lentera untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "Eh? Kamu akan memberikan satu Lentera Xiao untukku? Kamu... benar-benar baik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "Apa kamu sudah menerbangkan Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "Belum. Pengawal bayaran keliling seperti kami tidak punya waktu untuk hal-hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
