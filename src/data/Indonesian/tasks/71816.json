			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Nah, di sini kita menyimpan barangnya. Aku tahu bahwa aku merepotkanmu karena harus membantuku, jadi kamu hanya perlu mengawal Kargo Balon Udara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Tapi biar kuingatkan, kargo ini membawa semua bahan-bahan yang digunakan untuk membuat Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Bahan-bahan ini tidak boleh rusak atau terbakar, jadi tolong berhati-hati saat berada di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "Harap waspadalah, monster dan Treasure Hoarder sering lewat sini juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Baiklah, kuserahkan pekerjaan ini padamu. Pastikan bahan-bahan ini sampai kepada Francis dengan selamat ya, lalu kita akan bertemu lagi di jembatan barat daya Chihu Rock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
