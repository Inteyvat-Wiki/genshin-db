				},
				{
					"id": 750141040,
					"content": "Kayaknya hidupnya juga kasihan sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Aku cuma mau hadiahnya saja kok ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Ya meski mau keren-kerenan, minimal iyain dulu dong kata-kata Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Nah gitu dong, jadi ada jaminan hadiah partisipasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "Targetnya kerendahan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Wah gitu doang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "Bukan, bukan, mana berani aku! Kalau kondisi kayak gini, Temach bakal ngomong apa ya .... Oh ya. Pasti karena jalur latihan tidak cukup untuk membuatmu berkembang ya!",
