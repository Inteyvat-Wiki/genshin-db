				{
					"id": 750141320,
					"content": "Paimon takut banget deh! Untung Paimon sembunyi dulu, kalau tidak, tiba-tiba dia sadar eh kok ada dua Saurian, pasti Paimon bakal ketangkap!",
					"roleType": "TALK_ROLE_NPC",
