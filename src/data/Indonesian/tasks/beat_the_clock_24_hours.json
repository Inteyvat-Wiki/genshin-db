			"dialogs": [
				{
					"id": 750140801,
					"content": "(Hmm ... Paimon enggak bisa lihat jelas situasinya dari sini, tapi kayaknya kita bisa terciduk deh. Mending tetap jaga jarak sambil nguping dari sini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "Kualitas barang yang terakhir memang mantap, kali ini tolong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "Gampang lah itu, kayak biasa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Ya, aku akan kirimkan sebelum lomba terbangnya, karena pasti ada yang butuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Tidak masalah. Harusnya mereka juga sudah hampir beres. Jadi, bubar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Heh? Mereka sudah mau bubar? Enggak kayak yang dibayangin ... Tapi hati-hati dulu deh. Jangan sampai terciduk.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
