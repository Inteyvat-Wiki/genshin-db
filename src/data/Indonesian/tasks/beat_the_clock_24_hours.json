						750141325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "Memang benar enggak bakal ada yang nuduh Iktomisaurus ... yah, kamu! Tapi jangan ngomong hal kayak gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "So-Soalnya ... Paimon kan lagi belajar strategi adaptasi! Kalau bukan Paimon yang buat keributan di luar, kalian juga enggak mungkin bisa kabur semulus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141327,
					"content": "Pas banget sih. Rupanya isi kotak ini bukan barang yang biasa-biasa saja. Semua ini Saurus Crackers. Setelah dijatuhin, semua Iktomisaurus jadi ngumpul, ya pantes kacau lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141328,
					"content": "Tapi Paimon enggak lihat Lamizana sih di luar, dua orang yang bahas soal transaksi sebelumnya itu juga enggak kelihatan. Tapi harusnya bukan Lamizana deh. Suaranya beda soalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141329,
					"content": "Yah, pokoknya, kita tetap kasih tahu Taruka dulu deh apa yang kita lihat tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
