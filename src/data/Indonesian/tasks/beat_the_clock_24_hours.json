			"dialogs": [
				{
					"id": 750141001,
					"content": "#Kak {NICKNAME}. Untung kalian tidak apa-apa. Aku khawatir sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Menegangkan sekali! Uh ... Tapi kita bahas nanti deh ya, soalnya susah dijelasin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Kamu menceritakan apa yang terjadi di kemah kepada Taruka ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Kok bisa ya? Kalian lihat Nona Quilla, tapi tidak lihat Lamizana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Yah, mereka ada bilang soal lomba terbang, kayaknya sih sejenis transaksi ya. Tapi Paimon juga enggak jelas sih dengarinnya. Kayaknya bakal kepakai waktu lomba itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Nona Quilla itu pedagang yang baru datang akhir-akhir ini. Kalau dengar dari Paran sih, jenis barang jualannya banyak sekali. Mungkin Lamizana mau beli barang berbahaya darinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Barang berbahaya yang mau dia pakai untuk rencana berbahayanya waktu lomba terbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Rencana berbahaya macam apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Tidak tahu sih, yang jelas dia ada rencanain sesuatu, dan berbahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Luar biasa! Jadi di sini ya. Kamu pasti {NICKNAME}, kan? Aku dengar dari Lamizana kalau kamu sudah mencoba jalur latihannya, dan hasilnya lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Sudah berlebihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Jadi begini ya, lomba terbang kan sudah mau diadakan, tapi ada kontestan yang tiba-tiba batal, kebetulan dia lawannya Lliwa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "Duh ... Taruka sih tahu ya, dia itu selalu kompetitif sekali. Kalau sampai dia menang gara-gara diskualifikasi, pasti dia bakal ribut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Ya suruh kakak jangan ikut saja. Kebetulan nih, aku bujuk dia ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "Ini ... jangan deh ya. Kali ini dia sudah habiskan banyak sekali waktu demi lomba ini. Duh ... solusi yang terbaik sih cariin satu orang yang kemampuannya kurang lebih sama biar bisa bertanding sama dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#{NICKNAME} jadi tumbal nih ceritanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Kurang lebih begitu. Jadi tidak peduli kamu peringkat ke berapa pun, kami akan tetap berikan satu hadiah tambahan untukmu, asal kamu ikut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Pantaskah aku dianggap remeh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Eh? Ah, maksudnya ... Kalau misalnya kamu dapat juara, nanti hadiahnya juga akan diberikan, bersama dengan hadiah tambahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Terima kasih karena sudah bersedia ya! Undangan lomba akan dikirimkan nanti. Masih ada yang harus aku persiapkan. Berarti kita bertemu pas hari h lomba ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran meninggalkan tempat itu dengan Carrewoof ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME}, kamu setujui supaya bisa investigasi dari jarak dekat, kan? Kalau benar-benar terjadi sesuatu waktu lomba terbang, kontestan pasti akan tahu lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Firasatku bilang semua ini tidak sesederhana itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "Kenapa ya, kok kayak pernah dengar suaranya Paran di manaaa gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Semua hal di sekolah penerbangan harus diurus olehnya. Dia dan Carrewoof selalu ke sana ke sini, bahkan mau dengar suaranya saja susahnya minta ampun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "Benar juga sih. Kalau dipikir lagi, Paimon kayaknya pernah baca cerita ini di mana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Kalau ada orang yang melakukan kejahatan berbaur dengan latar belakang, semua orang pasti tidak akan bisa langsung tahu, karena mereka sudah anggap semuanya ini jadi kebiasaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hmm ... Tapi kayaknya jangan bahas masalah ini di depan dia deh. Keluarganya dia juga pernah melakukan hal jahat dan sampai diusir dari suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "Orang-orang selalu pakai alasan ini untuk mempersulitnya. Mungkin karena ini, dia jadi ketat dengan dirinya sendiri, tapi juga peduli dengan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Tapi aku juga harus akui sih, meski dia dan Lamizana itu hubungannya dekat. Tapi selain itu, ya dia orang baik sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Lamizana itu kayak hama ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Aku rasa hama itu jauh lebih lucu seratus kali dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Untung Paimon sekarang sudah dikasih tahu ya! Kalau enggak, bukannya enggak mungkin kalau kata-kata kita bisa nyakitin dia, walaupun enggak sengaja. Oh ya, soal lomba terbangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Taruka enggak usah khawatir, kakakmu bakal dijagain sama {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hmm ... Aku akan tunggu kalian di garis akhir ya. Lamizana dan aku harusnya selesai duluan. Lihatin dia baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Wraahh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Panggung kali ini memang enggak cocok buat {REALNAME[ID(2)|SHOWHOST(true)]} deh. Kamu bareng Paimon saja ya, lihat dari samping.",
