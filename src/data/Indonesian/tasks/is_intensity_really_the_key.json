				]
			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "Halo! Mau nanya dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Tekad yang luar biasa! Sesuai reputasi {NICKNAME} dan Paimon yang legendaris! Kalian datang dari jauh untuk memperebutkan gelar \"Petarung Terkuat Berlimpah Jaya\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "Petarung Terkuat Berlimpah Jaya? Bukannya ini cuma Tantangan Pejuang biasa? Lihat tuh, antreannya panjang gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Hahaha, mereka tidak sebanding dengan kalian. Kamu harus mengalahkan \"yang terkuat\" saat ini untuk menjadi yang terkuat berikutnya, orang biasa mana bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Bagus kalian datang ... tapi sayang waktunya kurang tepat nih. \"Yang terkuat\" sedang tidak ada waktu untuk menangani urusan duniawi di sini, jadi untuk saat ini kalian tidak bisa bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "\"Yang terkuat\" itu ada di mana sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Oh, kamu mau mencari dan menantang dia? Luar biasa! Kalau untuk orang berani seperti kalian, aku bersedia kasih tahu lokasinya saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Tempuhlah jalan pelatihan yang sukar dilalui ini, sampai ke daerah pegunungan yang penuh dengan \"Air Intens\". Di sana, kalian akan menemukan jejak-jejak milik \"yang terkuat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Ya enggak apa, kita tunggu dia balik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Ternyata memang benar, satu \"intensitas\" akan saling tarik menarik dengan \"intensitas\" lainnya. Jadi \"yang terkuat\" akan berhadapan dengan \"yang terkuat\" lainnya. Menunggu adalah pilihan yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
