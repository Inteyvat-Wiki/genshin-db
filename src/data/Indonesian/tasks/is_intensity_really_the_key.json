			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "Tolong! Ada yang pingsan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Gawat! Kayaknya dia pingsan, ayo tolongin, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Sepertinya sang suhu hanya pingsan karena kepanasan, tapi tidak terluka parah. Yoleehe membawa suhu yang pingsan dengan bantuan kalian ....\\nSepertinya sang suhu masih harus berlatih lagi untuk bisa menangani \"intensitas\" setinggi ini ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
