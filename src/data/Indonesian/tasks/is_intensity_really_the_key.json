				{
					"id": 751781011,
					"content": "#Tunggu, {REALNAME[ID(2)|SHOWHOST(true)]}! Jangan lari-lari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Mungkin ada banyak lava di sekitar gunung berapi ....",
