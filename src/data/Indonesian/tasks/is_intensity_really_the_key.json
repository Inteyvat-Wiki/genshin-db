					"Loshts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "Pejuang dari tanah asing, bagaimana perjalananmu untuk mencari \"yang terkuat\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "\"Yang terkuat\" itu ada di mana sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Pergi ke pegunungan sampai ketemu daerah yang penuh \"Air Intens\". Di sana, kalian akan menemukan jejak dari \"yang terkuat\" ... mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Masih diusahakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Ah, bagus. Bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
