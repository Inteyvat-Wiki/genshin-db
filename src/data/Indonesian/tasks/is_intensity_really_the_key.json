			"dialogs": [
				{
					"id": 751781401,
					"content": "Eh? Koholasaurus kecil? Kok bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o! Jadi kamu di sini ... Ka-kalau kalian tidak keluar lagi, a-aku bakal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "Kalau sampai terluka gimana? Jangan sembarangan kabur lagi ya ... Hiks ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "Hei ... Jangan nangis dong. Lihat, Saurian-nya enggak kenapa-kenapa, kan? Dia masih semangat kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Nguk! Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ah, ya, tidak kenapa-kenapa kok. Na-Namaku Linaha, dari Warga Mata Air ... Biasanya aku yang bertanggung jawab mengurus Koholasaurus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Sendirian ngurusinnya? Hebat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "Ti-Tidak juga sih ... Kalau aku bisa kayak Kak Paimon sedikit saja, mereka pasti tidak bakal bandel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Aku lagi berpikir apa mungkin semua orang pergi bermain. Rupanya memang begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "Jadi pemandiannya jadi dingin karena si Koholasaurus menyumbat mulut Phlogiston ya? Jadi enggak bisa keluar? Pantas yang ngurus pemandian air panas enggak ngerasa apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Kak Paimon! Sebenarnya ... Masih ada dua Koholosaurus yang tidak ketemu ... Kayaknya mereka juga lagi sembunyi dan main di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Enggak masalah, serahin saja sama kami. Kami bakal sekalian cariin sambil atur suhu pemandiannya, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Serius? Makasih Kak Paimon! Aku jadi tenang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Hehe, tentu saja dong, untuk petualang legendaris Paimon yang hebat sih, ini masalah kecil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Wah! Kak Paimon keren banget! Aku mau jadi kayak Kak Paimon suatu hari nanti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "Memang, Kak Paimon itu luar biasa ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Hei, kalau lagi di tempat umum, kasih Paimon muka dong. Hari ini Paimon masakin yang enak-enak deh, oke?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Ehem, oke, waktunya berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781417,
					"content": "Kalau begitu, aku minta tolong ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				}
			]
		},
