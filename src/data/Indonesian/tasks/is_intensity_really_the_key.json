					}
				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "Dingin! Dinginnya luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Eh, eh?! Dingin? Dingin di mananya? Ini kan kolam air panas woi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Belum! Belum cukup! Kalau mau jadi \"yang terkuat\" di Berlimpah Jaya, di seluruh Natlan ... dingin segini saja masih kurang! Masih JAUH dari cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Eh? Kenapa malah duduk lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Mungkin \"intensitas\"-nya masih kurang tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "Ini \"intensitas\" apaan sih! Paimon enggak paham sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Ah! Petualang terkenal {NICKNAME} dan Paimon sudah datang! Kita selamat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "Selamat ... dari apa? Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Baiklah, aku jujur ya. Menurut suhu, dia sedang dalam perjalanan untuk menjadi \"yang terkuat\". Demi itu, dia menenggelamkan diri dalam pelatihan kolam air panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Latihan? Di pemandian air panas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Iya... kedengarannya gila, tapi dia dapat idenya dari buku ilmu silat yang berjudul \"Buku Lima Jalur Mata Air\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "Menurut buku itu, kita bisa <color=#00E1FFFF>mendidihkan air dingin</color> hanya dengan mengandalkan \"intensitas\" diri kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "Bukunya menceritakan tentang banyak sekali legenda pendekar. Ada yang bisa meninju gunung sampai tembus terowongan dalam semalam, lalu ada juga yang bisa mecahin batu permata pakai tangan kosong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Paimon enggak nyangka di dunia ini ada ilmu sehebat itu. {NICKNAME}, kalau kamu bisa ... wuih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Yang gituan namanya DONGENG ah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Gini, gini ... memang sih kedengarannya ngawur. Tapi ini bukan buku sembarang buku, suhu kami dapat dari koleksi Penguasa Angin Malam. Pasti asli dong kalau asalnya dari sana? Dan dia percaya, itu yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "Karena itulah suhu memilih tempat ini ... pemandian air \"dingin\" ini, katanya. Tujuannya supaya air dingin beku ini bisa berubah jadi air panas, cuma dengan mengandalkan \"intensitas\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Eh ... iya juga ya! Airnya dingin banget di sini. Kuat sih kuat, tapi apa enggak takut masuk angin ya diam di situ terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Kalaupun dia tidak sakit juga tidak boleh! Tantangan Pejuang ini sudah ditunda selama beberapa hari, semua orang menunggu-nunggu Master kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Tapi Master bilang kalau menyerah di tengah jalan adalah tindakan yang tidak memiliki \"intensitas\". Jadi, dia tidak akan pergi kecuali mata airnya mendidih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "Para pengurus lain juga tidak tahu kenapa airnya tiba-tiba jadi dingin. Ah, andai saja ada petualang hebat yang mau membantu kami ... aku bahkan sudah siapkan imbalan loh! Lihat, banyak begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Kamu harusnya cari suku \"Warga Mata Air\" deh ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Hei, hei, jangan langsung ditolak, kita lihat dulu berapa imbalannya!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "E-Ehem, tenang saja, kami pasti bantu biar pemandiannya bisa panas lagi. Lagi pula, kami juga tidak tega membiarkan Master sakit karena airnya mendingin dong. Seorang petualang yang baik adalah petualang yang senang membantu orang lain, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Oh, terima kasih banyak! Kalau begitu kuserahkan pada kalian ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Tunggu saja kabar baik dari kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Kamu ingin menggunakan imbalan itu untuk menyogokku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Kamu ... benaran percaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Soalnya kalau berdiri, dia lebih kedinginan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Iya juga, pantesan dia gemetaran gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
