					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Oh! Paimon tahu deh! Suruh si kecil bantu gali lubang, terus pakai lavanya untuk panasin pemandian air panasnya? Lumayan juga idenya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Nguk nguk NGUUUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#Jangan yang aneh-aneh ya! Lava itu bisa bunuh orang loh! Serius dikit dong! {REALNAME[ID(2)|SHOWHOST(true)]} sampai percaya sama kamu.",
