			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "Bagaimana? Lancar-lancar saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "Sekali pakai langsung rusak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Hmm ... begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Seperti yang kukatakan sebelumnya, teknik ini bisa menangkap esensi para hewan kecil, tapi jika kamu ingin menyimpan esensi tersebut dan membentuknya lagi, kamu perlu medium lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "Aku mengintegrasikan teknik-teknik itu ke dalam jaring ini, sehingga itu juga merupakan perangkat retensi esensi dan media rekreasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "Kedengarannya ... rumit ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Yah, intinya, setiap jaring hanya bisa digunakan satu kali saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "Ini isu yang belum bisa kuselesaikan. Jika medium tersebut tidak bisa digunakan berkali-kali, maka harga dari perangkat ini akan menjadi terlalu mahal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "Aku akan terus melanjutkan penelitianku di sini dan mencoba untuk menangani masalah ini secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "Jika kamu masih memerlukan Omni-Ubiquity Net, kamu bisa datang padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "Oh iya, itu ... meskipun jaring ini hanya bisa menangkap hewan kecil, tapi sebenarnya proses membuatnya cukup repot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "Makanya, hehe ... kalau lain kali kalian membutuhkan jaring sejenis ini, aku akan meminta biaya tambahan ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "Tenang saja! Kalian kan teman Sango, aku tidak akan minta mahal-mahal kok. Harganya pasti bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
		{
			"id": 7267205,
			"completionStepIds": [
				7267205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
