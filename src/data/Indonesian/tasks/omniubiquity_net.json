			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Apa kamu sudah bertemu Wakamurasaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "Tentang Omni-Ubiquity Net ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "\"Omni-Ubiquity Net\" ... Hm, namanya tidak buruk. Tapi, teknik itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Apa teknik itu benar-benar bisa menangkap esensi manusia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Eh, tidak mungkin ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Hanya ada catatan tentang teknik onmyoudou yang ada saja. Praktik lain apa pun telah lama menghilang ditelan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "Teknik yang kuajarkan pada Wakamurasaki hanya bisa dipakai untuk hewan kecil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Tunggu, kalau begitu kenapa kamu tidak bilang saja padanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Oh, itu ya? Aku cuma mau Wakamurasaki membantuku menyebarkan beberapa hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "\"Ketua dari Kantor Detektif Bantan Sango sekarang meminta seseorang untuk membuat jaring menggunakan Kamuna Onmyoudou yang bisa membuat orang mengatakan tentang kebenaran.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "Kamuna Onmyoudou yang telah lama menghilang, Kantor Detektif Bantan Sango, dan jaring yang memang benar bisa menangkap esensi dari makhluk hidup kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Jika ketiganya digabungkan, maka akan tercipta legenda yang terdengar luar biasa, dan memang ada benarnya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Bagi kebanyakan orang, legenda-legenda seperti itu hanya sebuah cerita kecil saja ... Tapi, untuk kriminal yang sudah punya bibit rasa takut di hatinya, cerita tersebut tidak sesederhana itu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Jadi begitu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Sisi lainnya adalah ... Wakamurasaki benar-benar berisik deh karena terus menerus menggangguku dengan omong kosong seperti \"tolong temukan teknik terkuat onmyoudou yang pernah ada!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Aku sudah bilang padanya berkali-kali tidak ada hal yang seperti itu, tapi dia tidak mau dengar! Jadi aku tidak punya pilihan lain selain memberinya \"sesuatu\" untuk dikerjakan jadi dia tidak akan menggangguku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "Bagaimana kalau Wakamurasaki malah tidak bilang apa-apa ke orang-orang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Ti-dak mungkin. Dia tidak mungkin bisa menjaga rahasia bahkan kalaupun nyawa yang menjadi taruhannya. Percayalah, aku kenal sekali dengan dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "Bagaimanapun juga, terima kasih karena sudah ke sana. Ini ambillah. Anggap saja bayaran untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Archon, semoga saja dia tidak datang lagi untuk menggangguku. Aku ini detektif, bukan onmyouji ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
