				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Ugh, dasar si Wakamurasaki ... aku seharusnya beri tahu dia tentang Kageroumaru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720102,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "Oh, halo Pengembara. Apa kamu masih ingat soal Ubiquity Net?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720104,
					"content": "Setelah kita menyelesaikan kasus sebelumnya, aku menjelaskan semua yang terjadi kepada temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720105,
					"content": "Namanya Wakamurasaki, dan dia ... Mm, dia menyebut dirinya sendiri seorang \"desainer\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720106,
					"content": "Dia cukup terinspirasi dengan caramu menggunakan jaring tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720107,
					"content": "Jadi dia terus-terusan memintaku untuk membantunya mencari teknik baru agar dia bisa melanjutkan memodifikasi Ubiquity Net ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720108,
					"content": "Aku tidak tahan lagi diganggu terus olehnya, jadi aku membantunya menemukan sesuatu yang baru di koleksi barang-barang kuno milikku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720109,
					"content": "Kalau kamu bersedia, Pengembara, pergilah ke tempatnya. Jika tebakanku benar, dia pasti sudah selesai memodifikasinya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267202",
							"2"
						],
						"stepId": 7267202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "Oke, jadi begitulah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "Halo, kamu Wakamurasaki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "Benar! Ada apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "Tentang Ubiquity Net ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "Oh, apa kamu ...? Ooh, iya aku ingat sekarang. Kamu pasti si Pengembara itu ya! Sango sudah menceritakan tentangmu padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "Caramu menggunakan jaring itu benar-benar luar biasa. Sungguh menginspirasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "Kudengar kamu memodifikasinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Yep, benar sekali! Hehe ... Sango menggali semua teknik Onmyoudou untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "Aku menggunakan teknik itu untuk memodifikasi jaring ini sekali lagi, dan aku menamakannya \"Omni-Ubiquity Net\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "Menurut Sango, teknik ini bisa digunakan untuk menangkap esensi makhluk hidup lalu menggunakan sebuah objek sebagai media untuk menciptakan kembali bentuk dari makhluk hidup tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "Dia bahkan mengatakan bahwa pencapaian tertinggi dari teknik Onmyoudou seperti ini adalah esensi manusia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "Esensi seperti itu bisa menjawab banyak pertanyaan dan tidak akan pernah berbohong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "Perlu kukatakan bahwa teknik tersebut benar-benar akan menjadi bantuan yang sangat luar biasa bagi detektif seperti Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "Kamu tahu tidak? Aku sebenarnya berpikir kenapa dia memberitahuku tentang teknik itu dan mengizinkanku untuk memodifikasi jaringnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "Ah, ah! Tapi kamu jangan bilang orang-orang tentang itu ya. Aku cuma bilang begini padamu karena kamu dan Sango adalah teman, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "Be—Benarkah sehebat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Um, masih belum sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "Tidak peduli bagaimana aku memodifikasinya, jaring ini hanya bisa digunakan untuk membuat esensi hewan-hewan kecil saja. Jadi tidak ada efeknya ke manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "Pengembara, kamu tahu tidak? Gimana kalau kamu ambil saja jaring ini. Siapa tahu, dengan melihatmu beraksi mungkin bisa memberiku inspirasi lain lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "Nih, kamu bawa saja — dan ingat, ini sekarang sudah menjadi Omni-Ubiquity Net ya, bukan sekadar Ubiquity Net!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "Ayo, pergilah, dan tangkap beberapa hewan kecil untuk mengujinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "Apa modifikasimu sukses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
			"completionStepIds": [
				7267204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
