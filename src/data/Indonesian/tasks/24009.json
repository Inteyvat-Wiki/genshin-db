			"dialogs": [
				{
					"id": 240090401,
					"content": "Apa ya ... teman-temanku kasih masukan sih, ada nih di catatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "\"Reruntuhan bawah air!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Astaga. Aku tulis ini pakai tenaga penuh ya, kertasnya hampir sobek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Tapi memang tempat seperti itu pasti indah, unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Kalau begitu, tolong fotokan ya. Lebih besar lebih baik, dan kalau bisa, kondisinya juga yang sangat hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400906,
			"completionStepIds": [
				2400906
