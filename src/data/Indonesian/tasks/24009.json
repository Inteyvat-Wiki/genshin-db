			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Apa ya ... teman-temanku kasih masukan sih, ada nih di catatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Tanaman air ... bergoyang ... cahaya dan bayangan ... perubahan ... nulis apa sih aku? Apa waktu itu kebanyakan minum ya? Sepertinya sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Ehem. Tolong menyelam dan fotokan tanaman air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Rasanya aku berminat sama komposisi cahaya dan bayangan di tanaman air waktu nulis itu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400904,
