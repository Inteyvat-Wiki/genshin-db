			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "Apa ya ... teman-temanku kasih masukan sih, ada nih di catatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "Aku nulis apa sih ini? Bawah air ... batu-batuan ... tanaman dan batuan ... kontur bebatuan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Oh ya, betul juga. Aku sedang mempelajari batu. Sampai terobsesi, karena batu mewakilkan keindahan alam yang absah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Baik, tolong fotokan bebatuan bawah air. Aku penasaran seperti apa konturnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
