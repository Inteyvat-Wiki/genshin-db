			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "Ini ... celaka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "Perlu foto yang gimana lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Kali ini ... tidak perlu. Aku mau minta tolong yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Eh, ini malu-maluin sih, tapi ... boleh bantu carikan makanan? Garlic Baguette boleh sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "Kamu ... enggak bekal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Tidak! Aku bawa banyak roti kok. Ada selai dan dendeng juga. Harusnya cukup buat sehari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Tapi aku simpan makanannya di pinggir, biar fokus melukis ... fokus sampai keasyikan. Pas mau makan, barulah sadar makanannya sudah tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Mungkin dimakan binatang ... atau mungkin dicolong orang lewat. Sudahlah, siapa pun yang ambil, kudoakan biar perutnya kenyang dan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Masalahnya sekarang, perutku sendiri ... harus diisi nih. Dan tidak bisa pulang ke kota sekarang, belum cukup bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Ya sudah, tunggu sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "Makasih loh. Beli di kota saja, banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Tolong ya ... Aduh, mulai berkunang-kunang nih. Kelaparan ... atau mungkin kebanyakan mikir ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Boleh, tunggu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Atau ... enggak punya duit buat makan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Mesti ke mana lagi nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
