			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "Pengembara! Waktunya pas sekali. Aku dapat spot foto yang bagus bukan main, dan perlu bantuanmu sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Masih cari inspirasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Tentunya. Masih kurang bahan sih, satu foto saja mana cukup untuk menggambarkan sebuah pemandangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Biasanya aku perlu sampai beberapa lusin, atau kadang malah ratusan. Buat referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "Banyak amat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Kan dulu aku pernah bilang, melukis itu intinya \"menciptakan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Kalau cuma menggambarkan yang terlihat di atas kanvas, itu sih bukan melukis namanya. Itu \"fotografi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Pelukis harus bisa menggunakan sensitivitas dan jiwa estetika untuk mengamati dunia sekitar. Memilah, mengubah, dan menyunting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Terus sampai aspek terindah dari semua benda dapat dibuat abstrak, lalu dituangkan ke atas kanvas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Gagal paham nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Kamu ya ... baiklah. Intinya, aku pakai bagian terindah dari gambar untuk diambil referensinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Contoh, keseimbangan cahaya dan bayangan di sini sempurna, tapi pemandangannya kurang kontras. Jadi aku akan ambil referensi pencahayaan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "Gambar satunya ada Pengembara yang sedang berpose. Lalu berikutnya, ada bangunan megah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "Seperti menyusun puzzle. Indah atau buas, hasil akhirnya tergantung pada nilai estetika dan pemahaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Ini bukan penjelasan yang paling rinci, tapi kita bisa mengubah pemandangan yang ada dalam bahan referensi. Cukup pahami sampai situ saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Intinya, mau minta tolong lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Eh ... iya, betul begitu. Kamu pintar sekali memotret, teman-temanku sampai ingin kenalan setelah lihat hasil jepretanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Aku yakin kalau kamu yang bantu, hasil akhirnya nanti pasti luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Jadi tolong, demi nilai estetika universal ... dan demi imbalan yang sudah kusiapkan, tentunya. Mohon bantuannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Masih perlu ngumpulin bahan lagi, gitu kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Coba bahasa manusia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Memang setiap gambar gunanya beda ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
