			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Penekanannya masih kurang ... kenapa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Kurang sesuatu ... yang menentukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Lagi foto-foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Iya. Kamera ini sumber inspirasi lukisanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Namaku Depierris, bidang keahlianku melukis. Senang berjumpa denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "O ... ke. Sama-sama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Ah, aku biasa memulai hubungan dengan teman baru lewat secangkir kopi, tapi sayangnya di dekat sini tidak ada kafe ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Hmm ... ini, bersulang pakai Fonta saja. Salam kenal! Ngomong-ngomong, apa dulu sudah pernah ke Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "Ini pertama kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, selamat menikmati waktumu di sini ya! Pergilah ke kota, lihat pemandangan di sana — misalnya, Aquabus yang melintang di atas kepala kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Lalu boleh coba jalan-jalan, lihat mesin-mesin yang canggih, biarpun tidak semuanya estetik. Yah, pelukis sih perhatiannya sama yang begitu kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Lalu kamu bisa duduk di kafe, ngopi-ngopi cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Siapa tahu ada yang ngajak ngobrol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Tapi ya, kalau misal ada orang yang mengaku anggota \"Klub Fotografi\" mengajak ngobrol ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Hati-hati, jangan kemakan omongan mereka. Ada oknum di organisasi mereka yang tidak benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Memangnya ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Kamu nanya? Dosa terbesar mereka adalah: mencoba meluluhlantakkan kehidupan berbudaya di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Aku bukan mau menakut-nakuti ya. Tahu tidak mereka biasa mendiskusikan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"Kalau bicara hasil gambar, jepretan Kamera jelas lebih unggul daripada sekadar lukisan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Coba ya, apa maksudnya \"kalau bicara soal hasil gambar\"? Omong kosong! Dan mereka bersikeras kalau itu fakta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Kalau hanya menunjukkan gambar apa adanya, di mana nilai estetikanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Yah, memang ada sebagian dari kita yang terus-menerus mencari cara untuk menggambar sesuatu secara alamiah. Tapi itu pun tetap mengandalkan pemahaman estetika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Estetika adalah kunci! Kamu paham kan maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "Ti ... dak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "Mengamati dunia dari kacamata seniman itu baru langkah pertama. Kita harus mendalami rasa dan asa lewat kuas, untuk menciptakan mahakarya yang tumbuh dari dalam hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Apa kita rela membiarkan para pecinta Kamera turun ke derajat makhluk buas yang tak mengerti cita dan karya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Aku sering ngobrol dengan teman-teman pecinta Kamera. Seringkali hasil jepretan mereka menjelma menjadi inspirasi, dan demikian pula halnya dengan guratan kuasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Yang tidak memahami seni ibarat tong kosong nyaring bunyinya. Banyak bicara, tapi hampa. Membuat murka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Aib bagi para pecinta fotografi dan seni lukis! Sungguh ... *UHUK*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Sabar, sabar. Minum dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Terima kasih. Maaf, emosiku membara acap kali membahas tentang hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Karena itulah, aku dan beberapa teman memutuskan untuk mengambil foto dengan Kamera, yang hasilnya akan digunakan untuk keperluan referensi lukisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Setelahnya, kami akan menempatkan lukisan beserta foto untuk dipamerkan. Agar semua orang bisa melihat perbedaan seni lukis dan fotografi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Namun ... sejauh ini foto yang aku punya berasa kurang bermakna. Teman-teman bilang pemandangan terindah ada di alam yang paling liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Misalnya di bawah air, tepi jurang, atau hutan rimba yang jarang dijamah manusia ... sementara aku takut pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Menyewa petualang juga sepertinya terlalu makan waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#{M#Tuan}{F#Nona}, apa mungkin kamu bersedia bekerja untuk seorang seniman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Asal jangan disuruh ngelukis saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Tenang! Setiap orang punya keahliannya masing-masing, dan itulah yang akan kita lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Dan tentunya kompensasi tetap berjalan. Aku sudah sering menyewa pengawal petualang dalam perjalanan mencari inspirasi. Aturan harus ditegakkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "Cuma kali ini, urusannya terlalu mendadak sampai tidak keburu menyewa orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Nah, sudah sepakat ya. Aku percaya dengan bantuanmu, aku akan bisa menghasilkan karya-karya yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "Aku sih hanya mahir bertualang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "Sedi ... kit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Lalu apa pengaruhnya ke aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Sama seperti yang mereka perbuat ke Fontaine. Hidup kebudayaanmu akan layu sebelum berkembang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Hobi Kamera ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Kamera ini, hobi? Bukan, bukan. Sekadar alat referensi saja. Aku lebih sayang sama kuas dan kanvas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
