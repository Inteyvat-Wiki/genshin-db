			"dialogs": [
				{
					"id": 240091001,
					"content": "Terima kasih banyak! Ini sih cukup, pasti kenyang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Ini, ambillah. Aku makan dulu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Lain kali mending bawa biskuit saja deh. Bisa disimpan di tas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
