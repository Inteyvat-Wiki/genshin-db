			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Sudah difoto belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "Nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "Ah, sempurna sekali! Ternyata kamu jago juga fotografi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "Baiklah, aku akan mengambil referensi yang terbaik dari gambar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Terima kasih. Eh, Mora-ku di mana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Baik, ini buat kamu ... ambillah! Kalau ada kesempatan, tolong bantu foto-foto lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "Nah, sekarang tinggal digabung saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
