				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "Ah...bagaimana nih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "Apa kamu lihat patung Archon itu? Oke, lihatlah ke atas sedikit... lihat tangan Archon itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580104,
					"content": "Aku ingin main di atas situ, tapi Bibi Grace tidak mengizinkanku naik ke atas patung itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580105,
					"content": "Tolonglah, bisakah kamu bicara pada Bibi Grace? Jangan biarkan dia melihat ke sini. Aku akan naik ke atas sana dengan cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580106,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580110,
					"content": "Sekarang pergilah dan alihkan Bibi Grace untuk beberapa saat, aku akan segera naik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580111,
					"content": "Nora, berhenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580112,
					"content": "Hah... aku berpaling sesaat dan dia mengganggumu. Maafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580113,
					"content": "Eh kenapa! Aku hanya ingin main di atas sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580114,
					"content": "Kubilang tidak ya tidak! Ayahmu juga pasti tidak akan membiarkanmu melakukan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580115,
					"content": "Lalu kamu, tolong jangan turuti maunya! Orang-orang akan khawatir jika kamu melakukan sesuatu berbahaya seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580108,
					"content": "Itu terlalu berbahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "Jangan khawatir, aku ahli memanjat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				}
			]
		},
