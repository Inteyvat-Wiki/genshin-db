			"dialogs": [
				{
					"id": 200581101,
					"content": "Hebat sekali! Jika aku sudah dewasa nanti, apa aku bisa terbang seperti itu juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581102,
						200581104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581102,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "Aku akan segera tumbuh dewasa! Lalu setelah ayah selesai bekerja, kami bisa bermain bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581106,
					"content": "Tapi, setelah dewasa nanti seharusnya tidak begitu sulit kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581107,
					"content": "Terima kasih banyak! Ini terimalah hadiah untukmu, ini harta karun yang kukumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581108,
					"content": "Ayo cepat ambillah... Jangan biarkan Bibi Grace tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581104,
					"content": "Setelah kamu mendapatkan izin terbang, tentu saja bisa.",
