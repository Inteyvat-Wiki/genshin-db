			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Oh, Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Kamu yang merawatnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Ya, karena satu dan lain hal, ibunya tidak ada di rumah... Jadi untuk sementara waktu, aku yang merawatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Aku juga merawat beberapa anak lain yang membutuhkan pengasuh. Ini juga merupakan pekerjaan seorang suster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "Aku seolah mendapatkan keluarga yang baru bersama anak-anak ini. Mereka anak-anak yang baik dan mereka semua juga akrab dengan Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Hmm... Timmie adalah yang kurawat paling lama. Dia mulai memanggilku Ibu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Ayah Nora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Ayahnya bernama Patton. Dia selalu menimbulkan masalah di rumah karena terlalu banyak minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "Gereja dan Knights of Favonius telah memperingatkannya berkali-kali, tapi dia tidak pernah berubah. Akhirnya, Tuan Diluc sendiri yang turun tangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Suster Victoria menganggap Patton sudah tidak bisa lagi merawat Nora, sehingga Nora dirawat oleh gereja sementara Patton diberi waktu untuk merenungkan tindakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "Tapi ketika Nora sudah dewasa, kita tidak bisa lagi terus-terusan memberinya alasan bahwa \"ayah sibuk dan tidak dapat diganggu\", tidak akan ada gunanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
					"content": "Dandelion milik Archon Anemo pun tidak selalu tersedia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
