			"dialogs": [
				{
					"id": 200580201,
					"content": "Ehh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "Apa yang ingin kamu lakukan di atas sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Bibi Grace bilang jika kamu punya rahasia, kamu bisa mengatakannya pada dandelion dan lepaskan mereka bersama angin... Archon Anemo akan membawa benih dandelion dan semua yang kamu katakan kepada orang yang kamu tuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "Dan semakin tinggi kamu melepaskan benih dandelion tersebut, semakin cepat pesan itu sampai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Aku dengar seorang petualang membantu Glory melepaskan benih dandelion bersama angin di atas patung ini. Beberapa hari kemudian, Godwin membalas suratnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Nora juga ingin mengatakan sesuatu kepada ayah, dan aku sudah punya dandelionnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Tapi... Bibi Grace tidak membiarkanku melakukannya. Dia bilang aku bisa tinggal bersama dengan ayah lagi setelah beranjak dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "Bagaimana ya caranya agar bisa tumbuh dewasa lebih cepat, aku berolahraga dengan giat tapi aku masih tetap pendek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Oh ya, aku sering melihatmu terbang mengelilingi kota. Bisakah kamu mengajariku bagaimana caranya terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Hehe, baiklah! Aku akan berdiri di sini dan memperhatikan, aku yakin kali ini Bibi Grace pasti mengizinkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Kamu ingin terbang bersamaku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Tidak tidak, Bibi Grace akan marah jika dia melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
