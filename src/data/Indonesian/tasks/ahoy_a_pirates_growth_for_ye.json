			"dialogs": [
				{
					"id": 210000501,
					"content": "Ah, untunglah ... Kemarin malam aku menulisnya semalaman. Kalau sampai hilang aku jadi harus menulis ulang semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
