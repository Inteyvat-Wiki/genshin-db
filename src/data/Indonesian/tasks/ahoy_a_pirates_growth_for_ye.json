			"dialogs": [
				{
					"id": 210000101,
					"content": "*huff* Aku bisa tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000102,
					"content": "Ada apa, Little Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "Oh kakak. Halo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000104,
					"content": "Kenapa Little Meng? Kok kelihatannya sedih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Ada apa? Mereka enggak mau main ... bajak laut sama kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Eh? Bukan, Little Lulu dan Little Fei sudah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000107,
					"content": "Aku mau jalan-jalan sendiri, jadi belum mau pulang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000108,
					"content": "Orang tuamu enggak bakal cemas kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Di jam-jam segini, papa mamaku seharusnya sih masih kerja dan belum pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000110,
					"content": "Tidak usah bahas ini lagi. Boleh aku tanyakan sesuatu, kak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000111,
					"content": "Tanya apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "Aku dengar banyak cerita tentangmu dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000115,
					"content": "Kakak pergi ke banyak tempat dan sudah alami banyak hal. Mungkin kakak tahu jawaban dari pertanyaanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000116,
					"content": "Wah, Little Meng tiba-tiba jadi serius. Pertanyaan apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "#Kak {NICKNAME}, aku ingin tanya sesuatu nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000118,
					"content": "Gimana caranya orang bisa jadi dewasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000119,
					"content": "Butuh waktu untuk tumbuh besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Jadi maksudmu, asal kita tumbuh besar, otomatis akan jadi lebih dewasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000121,
					"content": "Tapi ... kalau aku jadi dewasa setelah besar nanti, apakah tidak terlambat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000124,
					"content": "Oh, kalau kamu mau pergi ke luar Liyue, kami bisa menemanimu jalan-jalan kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Aku tidak mau merepotkan kalian. Lagi pula, seandainya aku pergi ke luar Liyue sekalipun, belum tentu aku dapat sesuatu yang berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000126,
					"content": "#Kak {NICKNAME}, aku ingin minta tolong padamu sekali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000127,
					"content": "Aku dengar kata orang, kalau kamu punya masalah yang tidak bisa diselesaikan, tulis saja masalah itu di kertas lalu masukkan ke dalam botol, lalu apungkan botol itu di sungai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000128,
					"content": "Dengan begitu, siapa tau masalahku akan terpecahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000129,
					"content": "Tapi setahuku di luar sana ada banyak monster, terlalu bahaya kalau aku pergi sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000130,
					"content": "#Jadi, aku ingin minta bantuanmu untuk menjagaku, kak {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000131,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#Terima kasih ya, kak {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000134,
					"content": "Kalau begitu ayo kita berangkat, kita pergi ke Bishui River dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000132,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Perlu mengalami banyak hal yang istimewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Mengalami hal yang spesial ... Tapi bahkan sampai sekarang, aku belum pernah menapakkan kaki keluar dari Pelabuhan Liyue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000112,
					"content": "Aku tidak punya waktu untuk main denganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahaha, kalau permainan itu sih, aku hanya temani Little Lulu dan Little Fei kok. Kalau mereka tidak ada, aku juga tidak akan memainkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
