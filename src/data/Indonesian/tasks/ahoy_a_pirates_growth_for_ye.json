					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000302,
					"content": "#Terima kasih ya, kak {NICKNAME}. Ayo kita lanjutkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000303,
					"content": "Eh? Bo-Botolku mana? Tadi masih ada di tanganku, sekarang kok hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000304,
					"content": "Jangan-jangan waktu tertabrak Whopperflower tadi ... jatuh entah di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000305,
					"content": "#Kak {NICKNAME}, tolong bantu aku mencarinya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
