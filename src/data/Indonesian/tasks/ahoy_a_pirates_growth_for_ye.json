					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Bu-Bukannya banyak masalah juga sih. Aku cuma ingin tahu gimana caranya jadi lebih dewasa saja.",
