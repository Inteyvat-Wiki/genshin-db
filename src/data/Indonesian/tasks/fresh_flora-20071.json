			"dialogs": [
				{
					"id": 200710401,
					"content": "Sini sini, kemarilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710402,
					"content": "Apa kamu masih ingat bunga-bunga yang kuminta untuk ditaruh di Dragonspine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710403,
					"content": "Sekarang sudah lewat sehari, aku ingin melihat hasil dari eksperimen penyimpanan dingin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710404,
					"content": "Apa kamu bisa membantuku untuk pergi ke gunung salju dan mengambil kembali bunga-bunga itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710405,
						200710407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710405,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710406
					]
				},
				{
					"id": 200710406,
					"content": "Kalau begitu tolong ya, aku akan menunggumu di sini, ayo cepatlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710407,
					"content": "Di mana ya aku menguburnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710408
					]
				},
				{
					"id": 200710408,
					"content": "Kamu tidak ingat? Di <color=#00E1FFFF>sebelah Patung The Seven</color>, <color=#00E1FFFF>tempat berair di gunung</color>, lalu satu lagi di <color=#00E1FFFF>dekat gua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710409,
					"content": "Sini, biar kubantu untuk menandai lagi lokasinya di petamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
