				"points": []
			},
			"dialogs": [
				{
					"id": 200710101,
					"content": "Bagaimana dengan bunga yang sebelumnya dikubur di Dragonspine itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "Aku hanya berhasil mengambil satu kotak saja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "Apa bunga yang lainnya tidak bisa diambil lagi? Um... ya sudah, bagaimanapun, situasi di pegunungan bersalju sangat sulit untuk diprediksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Tapi kalau hanya ada satu kotak saja, kita tidak akan bisa membuat perbandingannya. Sepertinya kita harus menunggu lagi kesempatan berikutnya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Terima kasih karena sudah membantuku kali ini. Ini hadiah untukmu. Mungkin aku masih akan membutuhkan bantuanmu lagi lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
			"completionStepIds": [
				2007109
