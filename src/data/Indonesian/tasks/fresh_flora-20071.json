				"points": []
			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "Bagaimana bunganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "Maaf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "Aku tidak sengaja merusak kotak dan bunganya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "Ru-rusak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "Uh... itu adalah bunga yang aku pilih secara khusus. Bunga yang bagus tidak mudah ditemukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "Apa Dragonspine itu benar-benar berbahaya? Sampai-sampai petualang seperti dirimu tidak bisa menaruh sekotak bunga di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "Namun, terima kasih telah membantuku untuk tugas ini, ini untukmu, terimalah, aku akan lanjut merawat bunga di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "Ah, atau... mungkin aku akan mencoba lagi cara yang digunakan oleh Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
