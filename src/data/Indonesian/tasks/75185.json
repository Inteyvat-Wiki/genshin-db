				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "Ini ... telur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Ngomong-ngomong, cuma kami yang bisa membuat makanan lezat seperti itu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Letakkan telurnya di atas ventilasi geotermal, dan biarkan Phlogiston yang muncul memanggangnya. Waktu sudah matang, ambil, dan kamu akan dapat Magma Egg sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Tapi hati-hati ya, kalau sampai gosong, rasanya bakal jadi ... spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
