			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "Hei, kalian ya. Pengembara asing yang gesit. Bagaimana? Apa kalian sudah coba membuat Magma Eggs sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Sudah coba, habis dimakan, langsung bertenaga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Iya, kan? Rasanya semua nutrisi dari gunung berapi meluap-luap di setiap gigitannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Katanya kalau kamu makan setiap hari, tubuhmu akan jadi semakin kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Terlalu matang deh. Aku hampir pingsan setelah memakannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Hahahah, rasa gosongnya masih menempel terus ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "Tapi jujur saja kalau sudah terbiasa, tidak begitu parah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Belum sih, mungkin kapan-kapan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Haha oke deh, tak apa kok. Semoga perjalananmu lancar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		}
