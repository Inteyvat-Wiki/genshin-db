			"dialogs": [
				{
					"id": 751850201,
					"content": "Kalian cuma perlu selesaikan \"Tantangan Magma Egg\" — menghancurkan ventilasi geotermal di sana, lalu ambil telur hitam di dalamnya, kamu sudah bisa mencicipi kelezatan kuliner yang baru matang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
