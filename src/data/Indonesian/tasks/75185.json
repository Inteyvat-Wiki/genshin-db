			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "Wah, kalian berdua jago juga ya. Baru sebentar saja sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Coba aku lihat ... Oh, warna gelap dan aroma kuat ini benar-benar membuatku menelan air liur. Ayo cepat dimakan selagi panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Ini resepnya. Kalau kamu ingin mencoba Magma Egg lagi, kamu bisa masak sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
