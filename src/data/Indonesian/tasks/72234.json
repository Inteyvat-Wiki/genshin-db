					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Sudah kembali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "Kamu sudah ke semua tempat yang tadi aku sebutkan? Mungkin kamu yang sudah berkelana ke seluruh penjuru, bakal merasa tempat-tempat yang tadi kusebutkan semuanya biasa saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Kurasa tidak juga, tempat-tempatnya bagus kok. Beda dari yang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Ah, aku memang belum pernah bilang-bilang sama orang lain tentang tempat-tempat itu sih. Bisa tahu pendapat kamu saja, aku sudah senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Mungkin masih banyak tempat lain yang lebih bagus. Di sini memang gelap gulita sih, makan juga tidak ada pilihan, belum lagi harus tetap waspada dengan para vishap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Tapi karena aku sudah sekian lama hidup di sini, rasanya berat juga hati ini kalau harus pergi. Semua pemandangan di sini membuatku rindu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Apa kamu juga merasakan hal yang sama? Biarpun tempatnya seperti ini, kalau sudah lama ya jadi betah juga kan, serasa di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Masa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "Pokoknya, terima kasih karena sudah sudi mendengarkan celotehan tak pentingku. Ini, ambillah. Tidak seberapa memang, tapi cuma ini yang aku punya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Tidak sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Biasa saja sih. Aku sudah lihat pemandangan yang lebih mantap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}