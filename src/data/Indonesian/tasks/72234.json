			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "Bagaimana, duduknya nyaman tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Eh apaan nih, bikin kaget saja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Maaf, maaf. Aku tidak bermaksud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Namaku Kabayama. Tempatmu duduk itu adalah tempat biasanya aku duduk. Suasana di sini tenang, cocok buat merenungkan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Jadi maksudnya sekarang kamu mau kembali duduk di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Oh tidak perlu, terima kasih. Kelihatannya, kamu bukan berasal dari sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Wah, kamu pasti sudah banyak memakan asam garam ya. Sementara aku belum pernah ke luar sama sekali, biarpun sudah sering berpindah-pindah rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "Ah, bicara soal pindah rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Karena sering pindahan sewaktu muda dulu, aku hampir tidak punya teman dekat. Ketemu tempat seperti ini sewaktu jalan-jalan pun, aku tidak punya siapa-siapa untuk berbagi keindahannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Huh, bisa kasih lihat kamu keindahan tempat ini saja sudah bagus buatku. Kalau lihat tempat-tempat semacam ini lagi di sepanjang perjalananmu, kembali dan mengobrol saja lagi denganku. Itu bahkan lebih bagus lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Salah satu dari tempat itu ada di bawah gerbang batu, di titik tertinggi The Narrows; tempat yang lainnya adalah area terbuka yang dikelilingi oleh karang di samping Evernight Temple; dan satunya lagi ada di samping reruntuhan yang menjulang dari Serpent's Heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Aku sudah menandai tempat-tempat itu. Aku juga menggantungkan lampu di tempat yang tinggi untuk penerangan. Kamu pasti bisa menemukan tempat itu dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
