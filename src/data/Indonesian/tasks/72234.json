					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Sudah kembali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "Kamu belum menemukan semua tempatnya ya? Sayang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Biar kuberi tahu kamu sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Salah satu dari tempat itu ada di bawah gerbang batu, di titik tertinggi The Narrows; tempat yang lainnya adalah area terbuka yang dikelilingi oleh karang di samping Evernight Temple; dan satunya lagi ada di samping reruntuhan yang menjulang dari Serpent's Heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "Aku sudah menandai tempat-tempat itu. Aku juga menggantungkan lampu di tempat yang tinggi untuk penerangan. Kamu pasti bisa menemukan tempat itu dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
