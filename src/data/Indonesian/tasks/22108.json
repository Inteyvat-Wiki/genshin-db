			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Kali ini aku tidak menemukan petunjuk apa pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Siapa kamu? Kalau kamu datang untuk memahami Guild, bicaralah dengan Katheryne di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "Oh, kamu Adventurer? Maaf, walaupun aku adalah Ketua Cabang, tapi aku tidak terlalu peduli dengan Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "Jadi aku tidak mengenal orang baru... Tapi dari penampilanmu, kamu tidak seperti pendatang baru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "Bagaimana kalau kamu membantuku saja? Tapi hal ini tidak berhubungan dengan misi Guild ya, ini adalah permintaan pribadi dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Antusias sekali kamu. Tapi menerima misi tanpa menanyakan secara detail bukanlah tindakan yang bijaksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Tentang misimu, aku ingin meminta bantuanmu untuk mengalahkan dua Hilichurl yang memegang perisai raksasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Perisai mereka memiliki kekuatan \"Geo\". Walaupun tidak berbahaya, tapi kamu tetap harus berhati-hati saat menghadapi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Yang harus kamu lakukan adalah mengalahkan mereka. Setelah itu datanglah kepadaku, dan aku akan membayarmu imbalan yang memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Oh ya, kalau kamu menemukan sesuatu yang berhubungan dengan \"pedang\", tolong bawakan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Kalau tidak ada juga tidak apa-apa. Asalkan kamu mengalahkan para Hilichurl, aku akan memberimu imbalan yang memuaskan. Kamu siap-siap saja untuk bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Bantuan seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "Kamu sangat waspada. Apa kamu pernah mengalami hal yang tidak mengenakkan sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2210802,
