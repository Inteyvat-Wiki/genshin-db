				"points": []
			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "Apa kamu sudah mengalahkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Tidak apa-apa, tidak perlu terburu-buru. Seorang petualang yang bertindak dengan tergesa-gesa pasti akan menempatkan dirinya dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "Tapi kamu juga jangan terlalu lamban, karena imbalan yang kamu dapat tergantung dari seberapa cepat kamu menyelesaikan misinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
