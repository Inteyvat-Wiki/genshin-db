			},
			"dialogs": [
				{
					"id": 221080301,
					"content": "Apa kamu sudah mengalahkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Bagus sekali! Kamu mengerjakannya dengan cukup baik. Kamu pantas disebut sebagai seorang petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Ini imbalanmu. Terima kasih banyak. Keadaan di sekitar sini akan menjadi lebih aman setelah Hilichurl dikalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "Apa kamu menemukan sesuatu yang berhubungan dengan \"pedang\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "...Baiklah, tidak masalah. Hal ini memang sudah sesuai dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Terima kasih, terimalah imbalanmu. Kamu bisa melanjutkan urusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
