			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Wah, akhirnya kamu datang juga. Aku sudah lama menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240202,
					"content": "Untuk apa kamu menungguku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Jangan dingin begitu dong. Aku mau meminta bantuanmu untuk melakukan sebuah hal yang sangat penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240204,
					"content": "Kamu juga pasti sudah melihat meteorit-meteorit yang berjatuhan itu. Meskipun sampai sekarang tidak ada meteorit yang jatuh ke kota Mondstadt, tapi kondisi Mondstadt sekarang juga tetap saja kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240205,
					"content": "Dengan keadaan Mondstadt yang sedang kacau begini, pasti ada saja orang-orang yang berusaha memanfaatkan keadaan ini untuk mengambil keuntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240206,
					"content": "Maksudmu... Treasure Hoarder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "Aha, tajam sekali instingmu. Kamu memang seorang petualang yang berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240212,
					"content": "Meskipun para Knights of Favonius sudah memperketat pertahanan mereka, tetapi pasti masih saja ada celah karena mereka harus berpatroli mengelilingi kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240213,
					"content": "Para Treasure Hoarder yang rela melakukan apa pun demi uang itu... Mereka pasti sudah merencanakan untuk masuk ke dalam kota dan mengambil \"untung banyak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240214,
					"content": "Lalu apa yang bisa kulakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Wah, kamu bersemangat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240216,
					"content": "Hahaha, kalau begini sepertinya rencana yang dibuat oleh pria itu sudah tidak perlu kugunakan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240222,
					"content": "Baiklah, singkatnya... Pria itu telah berhasil menangkap beberapa anggota Treasure Hoarder yang dulu sempat mengintai kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240223,
					"content": "Menurut mereka, ada 3 kelompok Treasure Hoarder yang berencana menyelinap dan meraup keuntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240224,
					"content": "Nah, jadi kita akan membantu mereka, dengan cara menyediakan \"jalur masuk terbaik\" untuk mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240225,
					"content": "Aku harus bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "Yang harus kamu lakukan sangatlah mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240232,
					"content": "Untuk memastikan mereka tidak tertangkap sekaligus, para Treasure Hoarder yang datang mengintai tidak langsung kembali ke markas mereka untuk melapor. Melainkan mereka akan menaruh surat laporan mereka di suatu lokasi rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240233,
					"content": "Agar lebih aman lagi, mereka mengirim tiga anggota untuk melakukan pengintaian. Lalu ketiga orang ini akan mengirim laporan mereka ke tiga tempat berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240234,
					"content": "Yang tidak mereka sangka adalah kalau ketiga pengintai ini berhasil ditangkap oleh pria itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240235,
					"content": "Para anggota Treasure Hoarder yang lain baru akan bergerak saat mereka telah mendapatkan laporan pengintain itu, dan memilih jalur masuk paling bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240236,
					"content": "Tapi kali ini mereka tidak perlu repot-repot. Pria itu telah membantu mereka merencanakan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240237,
					"content": "Ambil tiga pucuk surat ini dan taruhlah di tempat-tempat yang telah ditentukan oleh para Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240238,
					"content": "Melaporlah kepadaku setelah kamu selesai meletakkan semua surat itu. Setelah itu... nanti saja baru dibicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240226,
					"content": "Apakah mereka bisa dipercaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Hahaha, kamu sangat berhati-hati ya. Tenang saja, orang-orang Treasure Hoarder itu semuanya pengecut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240228,
					"content": "Pada akhirnya, mereka semua hanyalah maling bau kencur yang hanya mementingkan uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240229,
					"content": "\"Kami akan membayarmu kalau kalian mau bekerja sama, tapi kalau kaian berani macam-macam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240230,
					"content": "Mereka langsung menurut untuk bekerja sama dengan kita begitu kita mengatakan perjanjian itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240217,
					"content": "Para Knight pasti bisa mengatasinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Hahaha, sudah kuduga kamu akan berkata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240219,
					"content": "Tenang saja, orang itu sudah menyediakan banyak anggaran untuk ini, kamu pasti akan mendapat imbalan yang pantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240220,
					"content": "Kalau kamu mendapatkan barang-barang saat melakukan tugas ini, barang itu juga akan jadi milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240221,
					"content": "Lagi pula, hanya kamu yang bisa melakukan tugas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240208,
					"content": "Maksudmu... Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Hahaha, tentu bukan dong. Buat apa Hilichurls mengambil keuntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240210,
					"content": "Kalau mereka berani mendekati tembok kota, para Knights of Favonius pasti akan segera mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240211,
					"content": "Maksudku tadi adalah para Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
