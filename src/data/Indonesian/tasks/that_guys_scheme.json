			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Apakah sudah kamu bereskan para Treasure Hoarder itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240802,
					"content": "Sudah beres semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Tidak heran pria itu memilihmu sendiri, kamu benar-benar gesit dalam menyelesaikan masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240804,
					"content": "Ini imbalanmu, ambillah. Senang, senang bekerja sama denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240805,
					"content": "Siapa tahu kita bisa bekerja sama lagi di kemudian hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
