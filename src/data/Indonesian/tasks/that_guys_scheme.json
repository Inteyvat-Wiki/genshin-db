						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Apakah kamu sudah meletakkan semua suratnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Sudah cukup kalau begitu, para Treasure Hoarder itu pasti akan mengikuti jalur masuk yang ada di surat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240604,
					"content": "Lalu \"waktu yang paling tepat\" untuk merampok menurut mereka pasti antara malam hari hingga subuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240605,
					"content": "Untuk \"jalur masuk terbaik\"-nya... pastinya cuma ada satu, bukankah begitu? Sini, biar kutandai lokasinya di petamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240606,
					"content": "Sekarang semuanya sudah siap, kita hanya perlu menunggu mereka masuk ke perangkap kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240607,
					"content": "Kalau Knights of Favonius sampai tahu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Hmmm, benar juga. Karena cara kita ini sebenarnya melanggar peraturan, kita yang akan repot kalau Knights of Favonius sampai tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240609,
					"content": "Tapi tenang saja, pria itu berani menjamin kalau tidak akan muncul masalah seperti itu. Kita... percaya saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240612,
					"content": "Baiklah, kita hanya perlu menunggu malam tiba. Lalu kamu tinggal membereskan para Treasure Hoarder yang akan menyelinap masuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240610,
					"content": "Bagaimana kalau mereka tidak muncul...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Pasti muncul kok, tenang saja. Semua rencana ini dirancang sendiri oleh pria itu, pasti akan berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
