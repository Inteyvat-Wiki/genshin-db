			"dialogs": [
				{
					"id": 411245201,
					"content": "Kamu belum pergi? Oh, apakah ada yang ingin kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "Sebenarnya siapa identitas pria itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Menurut pria itu sendiri, dia adalah teman lamamu. Kalian bahkan pernah bertarung bersama untuk beberapa waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "Tapi aku tidak bisa memberi tahukan namanya kepadamu. Aku bisa terkena masalah nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "Kenapa kita tidak langsung menangkap semua Treasure Hoarder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Maksudmu... Seandainya kita berhasil mengalahkan Treasure Hoarder yang datang karena surat itu, anggota-anggota yang lain pasti akan kabur setelah mendengar kabar tentang perangkap kita, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Hmmm... itu benar, tetapi justru itu tujuan asli pria itu. Tujuannya bukan \"menangkap semua\", tetapi untuk \"mengagetkan\" mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "Dengan kondisi seperti sekarang ini, para Knights of Favonius juga kekurangan orang untuk menjalankan operasi besar-besaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "Yang menjadi prioritas utama adalah membereskan masalah meteorit-meteorit itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "Sedangkan para Treasure Hoarder itu... asalkan mereka tidak berani mengganggu kita saja sudah cukup bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
