			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "Hal yang lebih penting, apa kamu melihat pria botak di sekitar sini? Aku perlu bicara dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Aku juga datang mencarinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Oh? Dia barusan ada di sini? Sepertinya dia sudah kabur, mungkin dia tahu kalau aku sedang mengejarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Icahua ... kamu tidak akan bisa kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Karena kita memang ditakdirkan bertemu, kusarankan kamu untuk menjauh darinya dan aku, agar wajah mulusmu itu tidak terkena cat putih dan merah yang kotor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Ini adalah barang-barang yang kutemukan di kemah. Kurasa dia tidak punya waktu untuk mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "Ini untukmu. Jangan khawatir, keputusan memberikan barang ini padamu adalah hakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Cepat atau lambat, nyawa orang itu akan menjadi milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Belum lihat sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Kamu tidak bohong, kan? Untuk sementara aku percaya pada wajah polosmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
