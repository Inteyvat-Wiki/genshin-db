					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "Oh ya? Pantas saja wajahmu terasa familier. Tapi aku sudah ketemu banyak orang hari ini, jadi aku tidak begitu ingat ... Tapi, ini tidak penting.",
