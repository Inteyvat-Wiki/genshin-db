			"dialogs": [
				{
					"id": 700100701,
					"content": "Tentang misi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "Akhirnya kamu kembali! Kenapa lama sekali?! Aku yakin Cyrus pasti menyuruhmu melakukan hal-hal yang lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "Aku membantunya mencari beberapa informasi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "Apa lagi yang dia rencanakan sekarang... Oh? Surat apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "Situasi asosiasi saat ini tertulis dalam surat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Huh, suratnya panjang juga. Sepertinya dia benar-benar sibuk, bahkan selama berlangsungnya Festival Windblume pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Tapi, kalau dia harus bekerja begitu keras seperti itu terus, memang inilah waktunya bagi Adventurers' Guild Mondstadt untuk merekrut beberapa anggota baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Kalau rekrutan baru kita sudah cukup, dia bisa mendelegasikan urusan-urusan yang lebih ringan kepada rekrutan-rekrutan baru itu dan dia dapat bertualang lagi denganku... *huff* Alangkah baiknya seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "Nanti aku akan membaca surat ini baik-baik. Lalu, berhubung kamu sudah bekerja lebih untuk membantu Cyrus, aku tidak akan lupa untuk memberikanmu bayaran tambahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Ambillah ini. Terima kasih atas kerja kerasmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
