			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Six-Fingered José"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "Hei~ Teman! Maukah kamu mendengarkan karya terbaruku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100402,
					"content": "Tentang perekrutan Adventurers' Guild...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "Perekrutan Adventurers' Guild? Maaf, aku tidak tertarik dengan hal-hal seperti itu. Berlarian sana sini tidak ada gunanya untuk penyair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100404,
					"content": "Selain itu, di kota Mondstadt ini, tentunya Knights of Favonius contoh model yang lebih baik untuk penyair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100405,
					"content": "Maaf, aku tidak tertarik dengan perekrutan Adventurers' Guild. Menjadi petualang yang membantu orang menangkap kucing bukanlah bahan penulisan lagu yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100406,
					"content": "Ini adalah materi perekrutannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Apakah ini... Dragonspine? Pemandangan yang sangat bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100408,
					"content": "Mungkin kalau pergi melihat-lihat tempat seperti ini akan memberiku inspirasi baru. Kelihatannya juga tidak terlihat terlalu berbahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100409,
					"content": "Hmm... nanti aku akan mampir ke Guild untuk membahasnya. Kalaupun aku tidak bergabung, aku yakin aku bisa menyewa seorang petualang untuk menemaniku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100410,
					"content": "Tur Dragonspine ya... Wah, sepertinya akan cukup menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Six-Fingered José"
				}
			]
		},
		{
			"id": 7001005,
			"completionStepIds": [
				7001012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
