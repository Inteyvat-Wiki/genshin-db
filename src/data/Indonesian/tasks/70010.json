			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Oh! Ada yang bisa kubantu? Aku baru saja akan memulai pertunjukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100502,
					"content": "Tentang perekrutan Adventurers' Guild...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Oh, mengenai itu... Aku pernah melihat sebuah pengumuman, tapi isinya tidak membuatku tertarik. Aku dapat melindungi Mondstadt dengan laguku dan tidak perlu menjadi seorang petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100504,
					"content": "Aku dengar sebagian besar dari komisi yang ada adalah pekerjaan yang aneh. Aku tidak yakin bagaimana komisi-komisi tersebut akan menguntungkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100505,
					"content": "Maaf karena aku harus menolaknya, tapi terima kasih karena sudah memikirkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100506,
					"content": "Ini adalah materi perekrutannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Eh? Gambar ini terlihat seperti Dragonspine. Patung The Seven dengan salju yang mengelilinginya... benar-benar gambar yang artistik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100508,
					"content": "Oh ya, kelihatannya tempat ini cukup tinggi, ya? Orang bilang, kamu bisa melihat jarak bermil-mil dari atas sana... Aku yakin suaraku pun akan berkumandang lebih jauh lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100509,
					"content": "Nanti aku akan pergi menanyakannya kepada Adventurers' Guild. Aku yakin di sana ada lowongan untuk petualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100510,
					"content": "Aku tidak pernah menyangka kalau para petualang bisa pergi ke tempat seperti itu... benar-benar mengesankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Helen"
				}
			]
		},
