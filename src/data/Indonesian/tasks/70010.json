					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "Bagaimana? Apa kamu sudah bertanya tentang pendapat orang-orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Sekarang kamu mengerti maksudku, kan... Memang begitulah keadaannya. Lagi pula, sekarang aku pun sudah terbiasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "*huff* Aku tidak peduli apa pun caranya... asalkan akhirnya bisa berhasil, aku akan sangat berterima kasih kepada Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "Kamu akan segera kembali ke Dragonspine untuk melaporkan keadaannya kepada Iris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Kalau iya, tolong bantu aku mengantarkan surat ini untuknya. Dia pasti ingin tahu tentang situasi terkini di Guild. Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "*huff* Aku harap kita mendapatkan rekrutan baru kali ini... Tapi, apakah orang yang merespon taktik marketing seperti ini adalah seorang petualang yang dapat diandalkan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
