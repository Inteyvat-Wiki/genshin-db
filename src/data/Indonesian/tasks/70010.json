						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "Tentang misi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "Oh, kalian sudah beres semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Semua sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Terima kasih atas kerja kerasnya. Aku juga sudah menyiapkan barang-barang yang ingin kukirimkan untuk dia. Bisakah kamu mengirimkannya? Aku akan menyiapkan imbalannya setelah kamu selesai, jadi ingat kembali ke sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "Aku tidak yakin apakah ini akan cukup untuk dia, tapi kalau dia butuh buat merekrut, catatan monster dan mineral pasti hal yang paling menarik perhatian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "*huff* Rencana perekrutan ini sepertinya tidak akan ada gunanya sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Tentang kiriman spesial dari Iris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Eh, dia memberiku sesuatu? Oh benar juga... aku memintanya datang terakhir kali, aku benar-benar lupa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "Kamu benar-benar sibuk untuk merayakan Festival Windblume?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "Festival Windblume? Aku tidak ada waktu untuk itu. Program perekrutan sebelumnya sudah ketinggalan zaman, aku sedang sibuk menyusun rencana perekrutan yang baru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Coba kulihat apa yang Iris kirimkan padaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Mineral... Tidak, benda itu tidak ada gunanya deh... anak-anak muda zaman sekarang tidak tertarik lagi dengan benda beginian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Peta Topografi... *huff* Benda ini akan berguna untuk anggota Guild, tapi sepertinya tidak ada gunanya untuk perekrutan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Catatan tentang monster? Ya, kami harus membuat beberapa salinan tambahan untuk para petualang kami, tapi lupakan deh untuk menggunakannya menarik orang baru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Oh? Apa ini? Kedua foto ini cukup bagus. Pemandangan yang sangat indah dan terlihat aman juga. Ah, benda ini pasti akan menarik perhatian seseorang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Kenapa kamu pilih ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Sepertinya dia mengesampingkan yang sebenarnya berkaitan dengan petualangan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Kamu tidak tahu ya situasi di asosiasi saat ini. Anak muda zaman sekarang memang tidak tertarik pada hal-hal tentang monster, mineral, dan peta topografi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "Untuk menarik perhatian anak-anak muda zaman sekarang, kamu harus menggunakan sesuatu yang dapat mereka gunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Sekarang sedang Festival Windblume, dan mereka pasti berpikir untuk menunjukkan pesona mereka dengan segala macam cara yang unik tapi tidak terlalu berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Bertualang di Dragonspine adalah salah satu hal yang dapat mereka lakukan. Kalau foto ini menarik perhatian mereka, mereka mungkin datang ke Guild untuk menanyakan tentang foto ini dan siapa tahu mereka juga akan bergabung ke dalam Guild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Dan... kalaupun mereka tidak bergabung... yah, setidaknya siapa tahu akan ada beberapa misi tambahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Dan kalau kamu lihat kedua gambar ini, keduanya berada tepat di pinggir jalan utama. Seharusnya tidak akan berbahaya asalkan kalian berhati-hati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "Apakah harus sampai menggunakan metode seperti ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Tapi begitulah keadaannya. Aku tidak akan melakukannya kalau bisa punya ide lain yang bisa kita gunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Tapi kalau kamu tidak percaya, bagaimana kalau kamu ambil kedua foto ini dan menunjukkannya kepada beberapa orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Pertama-tama, beri tahu mereka bahwa kami sedang merekrut, lalu tunjukkan kedua foto ini sebagai \"materi perekrutan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "Lalu kamu akan paham kenapa aku bisa memikirkan ide ini dalam waktu singkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001011",
