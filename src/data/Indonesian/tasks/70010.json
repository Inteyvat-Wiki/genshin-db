			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Tentang misi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "Apa kamu ke sini karena melihat komisi dariku? Yah aku memang butuh bantuanmu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Secara spesifik, aku mau kamu memotret dua tempat di Dragonspine. Aku akan menandai lokasi persisnya untukmu di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "Untuk imbalannya, aku akan pastikan kamu dibayar sesuai dengan aturan Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "Bagaimana? Apakah kamu mau menerima misi ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Kenapa kamu perlu foto dari kedua tempat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Ya... soalnya ini ada hubungannya dengan Cyrus nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "Sebelumnya dia memintaku untuk membelikannya beberapa produk khas Dragonspine. Katanya mau buat promosi perekrutan selama Festival Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "Sekarang sudah periode festival, tapi dia belum menghubungiku sama sekali. Mungkin dia sangat sibuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Kalau dipikir-pikir, dia memang waktunya itu juga, seharusnya dia sedang sangat sibuk merayakan festival saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Sepertinya dia sudah terlalu tua untuk itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Benarkah? Aku tidak merasakan apa-apa, aku selalu merasa... Hmm, lupakan saja deh, jangan membahasnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "Sejauh ini, aku sudah mengumpulkan beberapa mineral serta menyortir beberapa peta topografi dan catatan monster. Aku ingin taruh beberapa foto tempat-tempat indah di Dragonspine juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "Pengembara, maukah kamu membantuku pergi mendaki Dragonspine dan memotret kedua tempat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Bagus, kalau begitu kuserahkan padamu ya. Aku sudah menandai kedua tempat itu di petamu. Tolong ke sana dan kembali padaku kalau sudah selesai ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Apa kamu tidak akan mengunjungi kota untuk melihat-lihat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "Suasana di kota terlalu berlebihan untukku, aku pribadi lebih suka keadaan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Aku punya cukup banyak hal yang harus kulakukan di sini, jadi aku tidak yakin bisa kembali saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "Aku sudah menandai tempat foto terbaik di petamu. Tolong ke sana dan kembali padaku kalau sudah selesai ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
