			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "Nih jamurnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Oke, makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500703,
					"content": "Berkat bantuanmu, kemajuan penelitianku jadi ... apa ya pepatah Liyue-nya ... \"Berjalan semulus harimau ganas yang bersayap\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500704,
					"content": "Seperti harimau bersayap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Benar, harimau bersayap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500706,
					"content": "Sebenarnya apa yang terjadi pada jamur-jamur ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500707,
					"content": "Aneh sekali, padahal jamurnya sama persis dengan yang ada di Sumeru, tapi kenapa bisa bersinar? Apa karena mereka berevolusi setelah tumbuh di tempat gelap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500708,
					"content": "Tapi kenapa bentuknya sama saja walau sesudah evolusi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500709,
					"content": "Wah enggak tahu deh ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "Ya, sederhananya gini. Pada dasarnya jamur akan beradaptasi dengan lingkungannya, tapi jamur jenis ini jelas-jelas jamur yang biasanya ditemukan di dalam hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500712,
					"content": "Jadi, tidak diragukan lagi kalau jamur ini memang awalnya berasal dari Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500713,
					"content": "Terus kenapa dia bercahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Jamur ini tidak asli berasal dari Chasm, berarti cahayanya bukan hasil evolusi, melainkan akibat dari fenomena lingkungan ekologisnya yang abnormal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500715,
					"content": "Sepertinya karena dia menyerap energi pecahan-pecahan yang jatuh dari langit itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500716,
					"content": "Pecahan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Ha-Hah? ... Apa? Tadi kamu bilang, \"pecahan\" apa? Oh, maksudnya pasti berasal dari pecahan jamur yang melayang ke udara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500719,
					"content": "Terus terjadi mutasi secara acak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500720,
					"content": "Pasti benar begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500721,
					"content": "Ah, terima kasih banyak! Aku bisa mendapatkan jamur ini berkat kerja kerasmu. Silakan istirahat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500722,
					"content": "Aku mau meneliti jamur-jamur ini dulu, tolong biarkan aku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500717,
					"content": "Pecahan-pecahan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "Ada yang aneh ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}