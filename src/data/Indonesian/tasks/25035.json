			"dialogs": [
				{
					"id": 250350801,
					"content": "Dua ... tiga ... ada semua! Hebat, terima kasih. Paketnya ketemu semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "Sebentar, bukannya paket ini harusnya dikirim oleh Tundama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Ini bayarannya. Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
