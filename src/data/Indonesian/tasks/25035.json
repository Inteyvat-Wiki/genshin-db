			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Orang-orang bodoh ... kenapa bisa jatuhin paket lagi sih? Aku sudah bilang, tidak usah aneh-aneh kalau lagi kirim barang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Ada beberapa kurir kami yang melanggar aturan lagi. Hasilnya, paket jadi berserakan di sana-sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "Ck, sadar tidak sih kelakuan begitu bisa merusak reputasi suku Tirai Daun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Kalau lagi kerja, fokus! Kalau turun gunung, ya jalan saja yang betul! Bukannya meluncur kayak lagi main!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Aku sudah berkali-kali bilang, tapi dasar anak-anak muda bebal. Memang sengaja banget cari kenakalan yang menegangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "Sekarang aku jadi harus cari orang buat cariin paket yang jatuh. Siapa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Ka-Kamu? Serius? Wah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Kalau sengaja pasang iklan cari orang, bisa lama sekali baru ada yang datang. Kalau aku sendiri yang berangkat, nanti Courier's Longhouse jadi tidak ada yang jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "Tenang, aku bukan minta kamu cari jarum di tumpukan jerami kok. Aku bisa kasih tahu rute pengiriman anak-anak, dan aku bisa tebak kurang lebih paketnya jatuh di sekitar mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Aku tandai lokasinya di petamu. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Paketnya segede apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Tidak gede kok. Dan justru itulah jadi susah dicarinya. Ck, ampun, bocah-bocah teledor itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "Kalau ... kalau kamu ada waktu, boleh tolong carikan paket-paket yang jatuh itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "Courier's Longhouse lagi kurang orang. Kalau aku pergi sendiri, nanti di sini tidak ada yang jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Santai, serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Terima kasih banyak! Mohon bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
