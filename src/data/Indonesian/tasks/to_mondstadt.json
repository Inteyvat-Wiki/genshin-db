					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Baiklah, aku sudah cukup istirahat, ayo kita berangkat ke <color=#00E1FFFF>Mondstadt</color>!",
