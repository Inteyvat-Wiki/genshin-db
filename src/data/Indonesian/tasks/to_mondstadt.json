					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Selamat datang, apakah ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010202,
					"content": "Aku ingin meminjam dapurmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "Temanku ingin memakan masakan khas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Ternyata begitu, tentu saja boleh. Asal menggunakan bahanmu sendiri, silakan pakai dapurnya sesuka hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010206,
					"content": "Tetapi aku ingin bertanya, keahlian memasakmu sangat hebat bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010207,
					"content": "Tentu saja, yang aku masak semua lezat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Haha, seperti yang kuharapkan. Sebenarnya, aku punya satu saran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010211,
					"content": "Dari penampilanmu, kamu sepertinya orang luar. Sudah jauh-jauh datang ke Liyue, kenapa tidak sekalian mencoba masakan khas Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010212,
					"content": "Aku kebetulan punya resep Golden Crab, salah satu makanan khas Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010213,
					"content": "Daging kepiting yang digulung dengan tepung, digoreng, lalu digoreng kembali bersama dengan jahe dan bawang putih. Saat ditaruh di atas piring, kepiting tersebut akan terlihat seperti berbaring di atas emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010214,
					"content": "Gol... Golden Crab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "Terdengar sedikit merepotkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Golden Crab! {NICKNAME}, Golden Crab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "Iya, iya, Golden Crab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Hehe, kalau begitu ayo kita langsung pergi buat sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "Dengan keahlian memasakmu, sebentar saja pasti langsung bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "...Yah, dihitung-hitung, belajar untukmu juga deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Apakah belajar satu masakan untuk Mona tidak terlalu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Tidak juga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Haha, rendah hati sekali. Sebenarnya, aku punya satu saran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010204,
					"content": "Temanku ingin memakan masakan buatan tanganku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
