				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "Akhirnya sampai juga di Mondstadt... huff, capek sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "Mendapatkan pengetahuan yang begitu besar dan mendalam tidaklah mudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Aku tidak begitu lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Itu kan karena kamu melayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Sayang sekali, tampaknya si peramal tidak sekuat yang kita bayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "Itu karena kamu memiliki terlalu banyak bayangan yang tidak realistis tentang astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Apakah kalian juga beristirahat di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010408,
					"content": "Maaf, siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Ah, kami adalah pengusaha, baru saja menyelesaikan bisnis di Pelabuhan Liyue dan sekarang bersiap kembali ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010410,
					"content": "Kalian terlihat lelah sekali, kami sudah memesan kereta kuda, sebentar lagi datang, apakah kalian ingin ikut bersama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010411,
					"content": "Aku juga sedikit lelah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Apakah aku harus bayar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Haha, kalau begitu ayo jalan bareng, menambah teman ngobrol di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010414,
					"content": "Tidak, tidak perlu, memang satu jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010415,
					"content": "Tidak perlu, ayo jalan, ayo jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Eh? Ada apa dengan gadis ini? Apakah kamu tidak nyaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010417,
					"content": "Berhenti berpura-pura, Tuan Pencuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "Kalian mencari orang yang terlihat lemah di jalan untuk mengajak mereka naik, lalu di bawa ke hutan dan dijarah kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "Ka-kamu bilang apa! Kita sudah berbaik hati, kalian malah menuduh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010420,
					"content": "Kalau tidak mau bilang saja, dasar gila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "Jadi, apakah kita sekarang akan berbicara soal barang jarahan yang ada dengan kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Kalau tidak percaya, kita bisa panggil orang-orang untuk membuktikan, maka semuanya akan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Kalau aku kalah, aku akan memberikanmu 20.000 Mora. Kalau aku menang, kalian harus pergi ke pelabuhan Liyue untuk dipenjara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Bagaimana, kalau kamu benar-benar pengusaha, apa yang ditakuti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Ka, kamu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
