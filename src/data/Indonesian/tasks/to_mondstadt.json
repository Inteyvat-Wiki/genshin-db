					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Semua hal yang berhubungan dengan kalian menjadi kabur, jadi aku tidak bisa melihatnya dengan akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "Karena itu aku terus bertemu dengan ahli waris itu, dengan menggabungkan pengetahuan dia, mungkin aku bisa lebih akurat memprediksi nasib kalian.",
					"roleType": "TALK_ROLE_NPC",
