					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Dari sini, terus jalan ke Utara untuk mencapai <color=#00E1FFFF>Stone Gate</color>, setelahnya kamu akan tiba di Mondstadt.",
