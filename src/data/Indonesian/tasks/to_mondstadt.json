					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Setelah dipikir-pikir, menghabiskan begitu banyak Mora jadinya tidak terlalu menyakitkan...",
