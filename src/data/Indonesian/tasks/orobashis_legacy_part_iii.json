			},
			"dialogs": [
				{
					"id": 721310101,
					"content": "Lentera dari batu dengan bentuk yang aneh seperti memancarkan energi yang mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721310102,
					"content": "Ini kan... lentera batu? Kok bisa ada lentera batu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Eh, ada tulisan di atas lenteranya, coba kita lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"Rekan-rekan sekalian, apabila ada pertanyaan terkait jimat penangkal ini, silakan tanya Tuan Kaji di Musoujin Gorge.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721310105,
					"content": "Tulisan terlihat masih baru. Terdapat beberapa coretan di bawahnya:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721310106,
					"content": "\"Mohon maaf, kami tidak dapat membantu. Kemarin kami baru mendapat perintah evakuasi darurat dari Komisaris.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721310107,
					"content": "\"Aku harap kita bisa bertemu lagi suatu hari nanti dan mendiskusikan bagaimana memecahkan masalah Tatarigami ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721310108,
					"content": "Sepertinya Kaji sangat peduli dengan lentera dari batu. Apa kita pergi saja ke Musoujin Gorge dan tanya ke dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
