			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Kamu menyerahkan buku dan sobekan-sobekan halamannya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Mana lihat ... benar! Ini punyaku. Makasih banyak! Buku ini isinya penuh bukti kejahatan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "Bukti kejahatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Lihat fasilitas yang dibangun di Pulau Paha, dan mesin-mesin yang mereka bawa ... Tempat itu dulunya adalah rumah bagi banyak sekali binatang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Aku baru balik dari Rawa Garam Merah. Ubur-ubur di sana sekarat semua gara-gara mesin Fatui ... semua orang harus dikasih tahu soal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Ah? Maksudnya si Valberry Jelly dan yang lain ya? Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Kamu menceritakan soal kejadian di Rawa Garam Merah.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Jadi aku sudah terlambat ya ... tapi ini tetap harus dicatat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Aku serahkan buku ini ke kalian. Aku mau balik, rapi-rapi semua catatan di rumah supaya bisa disusun jadi artikel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Ah, terus kalau kalian mau cerita ke orang lain, wajib bilang sumbernya dari Semyon ya, oke? Soalnya masih perlu waktu lama sampai aku bisa tulis rapi dan terbitin semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "Makasih banyak ya! Sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
