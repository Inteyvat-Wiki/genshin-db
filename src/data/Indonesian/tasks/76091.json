			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Ada peri terbang! Catatan ... catatan pentingku disita sama Fatui, tolong, bantuin aku rebut kembali catatannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Paimon bukan peri, woi ... tapi yang kayak gini sih gampang lah. Eh, tapi kenapa Fatui bisa-bisanya ngambil buku catatan anak kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Mungkin mereka takut aku cerita isinya ke orang-orang ... kalau kalian bisa balikin bukunya, aku akan ceritain satu rahasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "Bahas nanti aja deh. Sekarang yang penting <color=#00E1FFFF>catatanku</color> harus balik dulu. Mungkin ada juga <color=#00E1FFFF>halaman-halamannya</color> yang tercecer di sekitar sana, tempatnya para Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
