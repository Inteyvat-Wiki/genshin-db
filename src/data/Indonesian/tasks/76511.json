			},
			"dialogs": [
				{
					"id": 765110101,
					"content": "Menurut prediksi Nona Nefer, ahli yang kita tunggu-tunggu harusnya sebentar lagi sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110102,
					"content": "Ya, Tuan Sieciech. Angin malam sudah meniupkan pertanda kehadirannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110103,
					"content": "#Salam, {NICKNAME}, Paimon. Sudah lama ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110104,
					"content": "Melihat kalian sesemangat ini sungguh menyenangkan hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110105,
					"content": "Kazuha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "Wah, enggak nyangka kamu bakal muncul di Nod-Krai, ngobrol sama Lightkeeper pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110108,
					"content": "Hmm, sebentar. Kok suasananya kayak tegang banget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110109,
					"content": "Karena memang seharusnya tegang. Kejuaraan sudah di tahap klimaks, ahli bela diri dari seluruh penjuru dunia sedang menunggu hasil akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110110,
					"content": "Kejuaraan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "Betul, selamat datang di babak final Kejuaraan Tarung Presisi Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110113,
					"content": "Daripada pertarungan bebas, kejuaraan ini lebih menekankan kepada teknik senjata yang presisi dan terlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110114,
					"content": "Itulah kenapa panitia menggandeng Adventurers' Guild untuk mendatangkan ahli pedang sejati dari Crux Fleet sebagai konsultan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110115,
					"content": "Oh, Paimon paham nih. Kazuha jadi juri ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110116,
					"content": "Betul. Aku agak kaget sih, tidak menyangka berita tentang Crux Fleet bisa sampai ke Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110117,
					"content": "Kapten dan yang lain menghadiri pameran di Kota Nasha belum lama ini. Urusan sudah selesai, artinya mereka tidak akan kembali dalam waktu dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110118,
					"content": "Sementara aku kebetulan punya waktu luang, dan juga punya pengalaman di Turnamen Crux Clash. Maka dari itu, aku menerima tawaran Tuan Sieciech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110119,
					"content": "Berkat mata dan penilaian Tuan Kazuha yang sangat adil, keputusan kami selalu akurat bahkan ketika pertandingan yang berlangsung sangat kacau dan panas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110120,
					"content": "Tapi sekasrang ada masalah. Ketiga finalis punya kelebihannya masing-masing, dan tidak ada yang bisa menembus jurus lawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110121,
					"content": "Kalau begini sih, bisa berhari-hari sebelum hasilnya ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110122,
					"content": "Hasilnya enggak jelas? Memangnya bisa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110123,
					"content": "Menurutku sebaiknya kita jalankan saja sesuai rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110124,
					"content": "Ya. Mengandalkan ahli dari semua ahli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110125,
					"content": "#Eh? Kok jadi fokusnya ke {NICKNAME} semua sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110126,
					"content": "Kalau kamu boleh tunjukkan sedikit kemampuanmu di arena, mungkin bisa ada kemajuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110127,
					"content": "Aku? Peragaan gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "Bukan. Karena kamu adalah pemenang Crux Clash, dan memang ahli bela diri berilmu sangat tinggi, maka kamu layak jadi ujian terakhir untuk menentukan siapa pemenangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110130,
					"content": "Kamu akan menghadapi ketiga finalis bergantian, lalu kami akan menilai berdasarkan seberapa menantang ilmu mereka ketika dihadapkan denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110131,
					"content": "Pada akhirnya, yang memperoleh nilai tertinggi akan jadi juaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110132,
					"content": "Dan sebagai penghargaan atas kontribusimu, setengah dari nilai hadiah utamanya untukmu, sebagai kompensasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110133,
					"content": "Itu ... bisa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110134,
					"content": "Solusi buat jalan buntu, hasilnya juga enak! Kazuha keren juga mikirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110135,
					"content": "Dulu-dulu belum pernah sih kayak gini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "Baiklah, sepakat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110138,
					"content": "#Kami mengandalkanmu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110139,
					"content": "Masing-masing lawan punya ciri khas, aku yakin kamu akan menikmati pertandingannya, seperti layaknya seorang juara bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110136,
					"content": "Pendekatan baru ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "Bikin seru suasana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "Bela diri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "Sudah lama banget loh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}