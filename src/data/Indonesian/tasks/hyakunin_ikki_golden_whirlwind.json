					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "Salam, orang asing berambut pirang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820102,
					"content": "Kita ketemu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Ah, sepertinya aku pernah lihat rambut seperti itu ... di mana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820105,
					"content": "Ah! Kamu si Topan Emas yang mencuri perhatian banyak orang di Hyakunin Ikki tempo hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820106,
					"content": "To-Topan Emas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "Waktu itu, aku duduk di antara orang-orang yang ingin menyaksikan pertarungan-pertarungan yang paling menegangkan. Dan di sanalah aku melihatmu, muncul menerjang semua lawanmu bagaikan angin topan berwarna emas yang meluluh-lantakkan rerumputan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820108,
					"content": "Jangan berlebihan begitu ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "Ah iya, baru-baru ini Hyakunin Ikki diadakan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820114,
					"content": "Hyakunin Ikki itu apa yah, aku lupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "Ah, ini turnamen bela diri terbuka, tempat orang-orang bertarung untuk merayakan sesuatu, atau bahkan untuk sekadar buang sial. Manusia dan monster berkumpul bersama, melupakan dendam dan jati diri mereka, merayakan tegangnya sensasi pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820116,
					"content": "Dan katanya, akan ada harta karun yang menanti mereka yang punya kemampuan menonjol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820117,
					"content": "Identitas panitia dan sponsor turnamen ini dirahasiakan. Sampai hari ini tidak ada yang tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820119,
					"content": "Yah, ini bukan sesuatu yang boleh dibicarakan di sembarang tempat begini. Ayo, ikutlah denganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820118,
					"content": "Begitu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "Terus ... kan omonganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "Ehem ... \"Dari kerumunan yang melihat, jika ada pendekar pedang yang ilmunya cukup tinggi, pastilah menyadari bahwa si Rambut Pirang ini melancarkan jurus terlarang \"Kouranka Daitatsumaki\"!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "Aku menulis cerita ini karena setelah melihat pertarunganmu yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820103,
					"content": "Ada tugas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
