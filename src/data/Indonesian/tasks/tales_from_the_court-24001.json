			"dialogs": [
				{
					"id": 240010301,
					"content": "Nah, itu dia. Keadaannya juga baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Kapan ya Nona Staelle bakal sadar kalau anjing tidak peduli sama yang namanya opera dan novel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Kita balik deh. Nona Staelle pasti khawatir sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
