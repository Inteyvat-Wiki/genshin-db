			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea sayangku! Imutku! Lucuku! Dari mana kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Dia cuma santai di tempat sepi saja kok. Liburan singkat lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Dan aku khawatir sekali dibuatnya! Terima kasih Bu Blathine, terima kasih banyak! Kamu akan jadi tokoh di novel baruku nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Terima kasih, tapi tidak perlu. Siapa juga yang tertarik sama kehidupan sehari-hari seorang polisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Tidak apa-apa, tinggal dikasih bumbu sedikit saja ... dijamin menarik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Rasanya jaminan seperti itu saja sudah termasuk bumbu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Ah, kesimpulannya masih harus dipikirkan lagi! Baiklah, siapa yang jadi pasanganmu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
