				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Kenapa aku meninggalkan dojo untuk menjadi pemandunya Nona Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha dan Okazaki, juga Mifune... kenapa mereka semua meninggalkanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "Aku sudah pernah mengunjungi murid-murid Iwakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "Masih ada orang yang mengaku berasal dari Iwakura? Bagaimanapun juga kan master mereka sangat tidak kompeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Namaku Iwakura Kouzou, seorang instruktur pedang di sini. Kalau kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... apakah kamu melihat mereka? Dan juga saudara-saudara Okazaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "Katayama juga. Mereka ingin menamai duel ini sebelum dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Karena, \"Jika aku menjadi samurai sejati di masa depan, maka semua duel ini dapat ditulis menjadi cerita.\" Hahaha, omong kosong seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Oh iya, dan juga Shimada, yang mulai dari era Nagatane hingga era Kouin masih belum bisa melampaui Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Mereka harus kabur karena mereka tidak dapat memahami kekuatan Dekrit Perburuan Vision dari Yang Mulia Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Aku merindukan masa lalu yang indah saat-saat mengajari mereka cara menggunakan pedang. Kenapa aku menutup dojonya dan bergabung ke militer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, kemampuan mereka seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "Aku menyesal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Begitukah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#{NICKNAME}, kalau boleh tahu, siapa gurumu? Domon? Atau Shousen? Atau mungkin Narukami sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "Lebih kepada diriku sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Jadi begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "Sepertinya reputasi Seni Iwakura telah menurun di bawah pengawasanku. Tidak ada satu pun muridku yang sanggup mengalahkan samurai yang belajar otodidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Begitukah? Aku mengerti sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Tidak peduli apa sekolah ilmu pedangmu, hal itu tidaklah penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Sepertinya reputasi Seni Iwakura telah menurun di bawah pengawasanku. Tidak ada satu pun muridku yang sanggup mengalahkan seseorang yang tidak mau mengungkapkan nama sekolahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100326,
					"content": "Aku hanya seorang master Seni Iwakura yang tidak kompeten. Sebagai seorang samurai, mereka memanggilku Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100327,
					"content": "Meskipun aku telah menghafal kunci teknik pedang rahasia, dan Visionku diserahkan kepada Yang Mulia Shogun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100328,
					"content": "...Tetapi jika ini tentang balas dendam untuk murid-muridku yang tidak tahan melihat keterpurukanku dan pada akhirnya memilih jalan iblis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100329,
					"content": "Tapi jika tidak kompeten dan kalah darimu, maka aku masih memiliki rasa haus akan balas dendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100330,
					"content": "Tempat ini terlalu kecil. Aku takutnya kamu tidak akan bisa memamerkan kemampuan pedangmu. Ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100316,
					"content": "Aku sudah belajar cukup banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
