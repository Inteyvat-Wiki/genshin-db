					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Kenapa aku meninggalkan dojo untuk menjadi pemandunya Nona Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha dan Okazaki, juga Mifune... kenapa mereka semua meninggalkanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "…Sekarang, pedang Iwakura Kouin adalah satu-satunya yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "Hakuen Michimitsu Amenoma leluhur dari keluarga Iwakura? Saat kamu dan Kunihiko pertama kali diadopsi, selagi Eiin tidak memperhatikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Kami sudah menerobos masuk. Tidak perlu merepotkan master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Tapi, Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "Ketika kamu menimbang kasih sayang dan kebenaran di kedua ujung skala, seorang samurai sejati hanya bisa berjalan di jalan kebenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Berhubung Master berkata demikian, berarti dia tidak ingin mengusir kita, melainkan tidak ada pilihan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Tentu saja dia tidak bersedia, tapi karena dia sudah memutuskan untuk menjadi pedangnya Shogun, jadi berdasarkan Dekrit Perburuan Vision, dia hanya bisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Kita hanya bisa memilih jalan kebenaran kita sendiri. Bagaimanapun juga, seorang samurai sejati hanya bisa berjalan di jalan kebenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Tetapi kebenaran master sendiri pada akhirnya dikalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "Betul sekali. Bukan hanya Kunihiko saja tapi yang lainnya juga, termasuk Iwakura Kouin, kita harus balas dendam untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Begitulah kebenaran murid-murid yang diusir seperti kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Hal ini seharusnya juga merupakan berkah master. Musuh pertama baru saja mendatangi kita seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Betul juga sih. Kamu pasti {NICKNAME}. Aku pernah dengar tentang kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "Di dunia samurai, hanya darah yang bisa membersihkan darah. Kurasa pastinya kamu sudah siap melawan Menkyo Kaiden mantan Seni Iwakura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
