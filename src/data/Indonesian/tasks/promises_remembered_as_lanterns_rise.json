			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Aku harus cepat-cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240102,
					"content": "Apa bisnis berjalan dengan baik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Tidak. Tapi sekarang ini Lantern Rite. Banyak orang pergi ke kota untuk menikmati suasana festival di sana, jadi kami kekurangan orang. Aku benar-benar melakukan semuanya sendiri di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240104,
					"content": "Namun kami tidak punya terlalu banyak tamu, jadi tidak terlalu buruk juga. Aku masih bisa menanganinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240105,
					"content": "*uhuk* Lalu, aku harus berterima kasih padamu karena telah menolongku sebelumnya, jika bukan karena bantuanmu, sepertinya aku tidak bisa kembali bekerja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Ah, jadi akhir-akhir ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "T-tidak! Tentu saja tidak, percayalah padaku! Ji-jika dia muncul lagi, se-sepertinya aku tidak bisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240109,
					"content": "Jika kamu benar-benar bertanya padaku tentang... dia... kamu sebaiknya tanya saja pada bos. A-aku tidak tahu apa-apa, sungguh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240107,
					"content": "Jadi, apakah dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
