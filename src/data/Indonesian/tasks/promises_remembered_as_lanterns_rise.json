			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "Pengembara, ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "Tentang Dusky Ming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Oh, dia? Dia menjadi cukup baik sejak kejadian waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "Tapi aku merasa kasihan padanya. Selama ini setiap musim festival, dia akan merasa lebih kesepian saat penginapan menjadi semakin ramai. Akibatnya, dia akan membuat banyak masalah, menakut-nakuti para tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "Tapi aku tahu dia hanya menginginkan seseorang untuk bermain dengannya. Bagaimana pun juga dia hanya seorang anak kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Mungkin kita bisa mengirim Lentera Xiao untuknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Mengirimnya Lentera Xiao? Itu bukan ide yang buruk. Tapi masalahnya dia cukup sulit untuk ditemukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "Jika kamu mencarinya, kamu harus menggantung Lentera Xiao di atas salah satu pohon di hutan sekitar pada malam hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "Dengan demikian, dia bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "Hm... apa dia menyukai Lentera Xiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
