			"dialogs": [
				{
					"id": 718240301,
					"content": "Bagaimana, apa kamu sudah mengirimkan Lentera Xiao-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240302,
					"content": "Seharusnya... dengan begini sudah terkirim ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Sepertinya begitu. Ini seharusnya bisa menghiburnya sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Aku penasaran, anak itu akan menuliskan harapan seperti apa ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
