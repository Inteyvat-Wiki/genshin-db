			"dialogs": [
				{
					"id": 200040501,
					"content": "Eh kalian kembali lagi. Uangnya sudah dibayarkan ke Goth, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Bagus. Untungnya uang sewa rumah tidak terlalu mahal. Hampir saja Mora-ku tidak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "Tapi sepertinya aku harus makan salad lagi untuk beberapa hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
