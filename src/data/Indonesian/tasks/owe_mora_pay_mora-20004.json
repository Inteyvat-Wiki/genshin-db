			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "Oh, kamu. Lama tidak jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "Aneh, kamu terlihat tergesa-gesa sekali. Untuk apa kamu mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Kamu ke mana saja, Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "Kami sudah mencarimu berhari-hari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Wah, waktu kalian tidak tepat. Beberapa hari lalu, The Steambird meminta satu naskah baru dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "Topik pertanyaannya adalah \"pergeseran langit dan hubungannya dengan perubahan nasib seseorang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "Karena itu, beberapa hari ini aku terus di luar untuk mempelajari bintang-bintang, dan pulang ke rumah waktu sudah larut malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Kayaknya Mona benar-benar kerja keras buat dapat Mora ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "Ya-Yah, maksudku, ada globe astronomi baru dari Fontaine yang sudah kupesan. Aku sudah membayar depositnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Sekali aku mendapat Mora dari pengiriman naskah ini, aku bisa melunasi sisa pembayaran dan mendapatkan globe astronomi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "Tapi jangan lupa dengan bayar uang sewamu ke Goth loh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "Uang sewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "Oh! Aku, anu ... aku harusnya sudah menyisihkan Mora untuk itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Tunggu sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "(Mona mulai merogoh dompetnya ....)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Ini ... dan ini! Harusnya sudah cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(Wah Mona benar-benar merogoh koceknya sampai habis ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "Baiklah kalau begitu. Bantu aku berikan Mora ini ke Goth ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
