			"dialogs": [
				{
					"id": 200040401,
					"content": "Bagaimana? Kamu sudah temukan si Ast — temanmu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Ini uang sewanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Ah, iya. Sudah cukup. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "Tapi bolehkah aku bertanya apa yang dilakukan temanmu untuk mencari nafkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "Dia sepertinya punya kemampuan andal, tapi dia selalu terlihat miskin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
