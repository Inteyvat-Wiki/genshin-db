			"dialogs": [
				{
					"id": 751970401,
					"content": "Gimana Pengembara? Bisa pakai <color=#00E1FFFF>Crafting Bench si sana</color> buat menyerap kekuatan kehidupan dari Gigi Naga-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970402
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970402,
					"content": "Tidak salah lagi! Kilau ini ... tekstur ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970403
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970403,
					"content": "Hahaha, aku tidak sangka alkimia begitu ajaib. Tuan Albedo memang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970404
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970404,
					"content": "Terima kasih bantuannya. Aku sama sekali tidak paham alkimia. Oke. Sekarang semua bahan sudah siap, silakan tunggu sebentar sambil aku menempa senjatanya ....",
					"roleType": "TALK_ROLE_NPC",
