			"dialogs": [
				{
					"id": 751970505,
					"content": "Orban mulai menempa ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "Selesai! Hahaha, kemarilah, ayo pegang ini. Bagaimana rasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970502,
					"content": "Berapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "Bayar? Tidak usah! Bisa menempa bahan seperti ini saja sudah berkat. Rezeki seperti ini jangan dihitung dengan uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970504,
					"content": "Nah, senjata ini sudah siap dibawa bertualang. Tolong dirawat baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
		{
