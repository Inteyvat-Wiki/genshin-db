			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "Oh, kebetulan. Ya, soal gigi naga ... sudah dikumpulkan ya rupanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970103,
					"content": "Waktu kalian keliling, aku kena masalah ... gigi naga ini tidak bisa dipecahkan. Dihajar pakai apa pun juga percuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970104,
					"content": "Ini ajaib sekali, belum pernah terjadi sebelumnya. Aku sudah minta orang hubungi Tuan Albedo untuk solusinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970105,
					"content": "Jadi, nah, Tuan Albedo minta Nona Sucrose untuk mengirimkan Batu Rune. Tuh, di atas Crafting Bench sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970106,
					"content": "Eh? Batu Rune? Hubungannya apa sama gigi naga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970107,
					"content": "Nona Sucrose menyampaikan pesan dari Tuan Albedo, katanya bahan ini harus diolah dulu agar bisa ditempa menjadi senjata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970108,
					"content": "Salah satu caranya yakni dengan membiarkan gigi naga menyedot kekuatan hidup naga, lalu gigi itu digunakan sebagai sumber tenaga untuk mengisi energi gigi naga lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970109,
					"content": "Kalau Batu Rune ini ... ya, Nona Sucrose bilang ini \"barang peninggalan grup musik keliling yang membantu Knights of Favonius dan pemberontak Mondstadt melawan para bangsawan seribu tahun silam\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970110,
					"content": "Pemain seruling di rombongan itu bertempur melawan monster \"Bakunawa\" di Mare Jivari. Batu Rune ini diambil dari jasadnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970111,
					"content": "Eh? Citlali bukannya bilang kalau Mare Jivari itu baru ada lima ratus tahun, kebentuk akibat pertempuran Sanhaj melawan Abyss dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970112,
					"content": "Yakin soal rombongan itu dari seribu tahun silam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "Haha, masa salah sih? Cerita kepahlawanan grup musik keliling itu sudah lama tercatat dalam kitab \"Sejarah Raja-Raja\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970114,
					"content": "Pokoknya, Tuan Albedo bilang kalau Batu Rune ini mengandung kekuatan kehidupan tak terbatas, yang mirip dengan punya naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970115,
					"content": "Tinggal pakai Crafting Bench, serap kekuatan kehidupan dari Batu Rune ke gigi naga, lalu mulai menempa deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970116,
					"content": "Keren ... banget ... Albedo memang keren banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970117,
					"content": "Jangan lupa bilang makasih ke orangnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#Nah iya tuh. Kalau enggak, entah gimana deh itu ... Pokoknya, {NICKNAME}, kita coba serap kekuatan Batu Rune dulu yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970120,
					"content": "Bagus ... nah, ambil gigi naganya. Tolong bereskan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970121,
					"content": "Alkimia memang sesuatu ... gimana caranya kita menyerap \"kekuatan kehidupan\" dari sebongkah batu berusia seribu tahun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970119,
					"content": "Oke, serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
