			"dialogs": [
				{
					"id": 751970202,
					"content": "Hai, sudah kembali lagi! Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970203,
					"content": "Eh, bagian menyerap saja belum mulai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970204,
					"content": "Kalian menceritakan semua yang terjadi ke Orban ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970205
					]
				},
				{
					"id": 751970205,
					"content": "Tidak kusangka bakal terjadi hal kayak gini ... Duh, untung kalian tidak kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970206,
					"content": "Waduh ... kalau gini sih gigi naga-nya sama sekali enggak bisa dipakai nempa dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970207,
					"content": "Oh, urusan itu sih santai saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970208
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970208,
					"content": "Waktu kalian pergi tadi, aku khusus minta seseorang ngobrol sama Tuan Albedo untuk cari tahu gimana cara mengolahnya.",
