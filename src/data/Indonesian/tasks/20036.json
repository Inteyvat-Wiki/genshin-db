			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "...Godwin... Kapan kamu pulang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Halo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "Aku kenal suara ini... Apakah kamu Pengembara yang datang dari jauh? Ah, aku bersyukur kepada Archon Anemo yang menuntunmu ke sini dengan angin... Tolong dengarkan permintaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Begini... em, kekasihku Godwin adalah seorang Knight di Knights of Favonius. Sudah lama sekali dia meninggalkan Mondstadt dan belum kunjung kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Aku belum mendengar kabar apa pun semenjak kepergiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Aku benar-benar khawatir. Dia pergi untuk bertempur melawan para Hilichurl. Dia juga mengatakan bahwa mereka sedang berperang dengan Abyss Order. Bagaimana jika dia terluka? Dia sudah pergi sekian lama, bagaimana jika dia bertemu salah satu Knight wanita yang cantik di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Ma-Maaf! A-aku terlalu banyak bicara! Ibuku selalu berkata bahwa dandelion yang terbang tertiup angin bisa membawa pergi hati dan keinginan seseorang ke tempat yang jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Jadi permintaanku adalah... bisakah kamu membantuku mengumpulkan tiga Dandelion Seed dari Windrise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Terima kasih banyak, semoga Archon Anemo selalu memberkatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "Tunggu! Aku mohon, bagi seorang pengembara sepertimu, ini pasti mudah sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
