			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "Oh, kamu sudah kembali, apa kamu mendapatkan dandelion seed tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Ya, sudah kudapatkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Terima kasih banyak, bisakah kamu meletakkannya di tanganku? Aku tidak bisa melihat, aku khawatir mereka hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Apa ini cukup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Tolong letakkan di tanganku jadi aku bisa merasakan mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Ini cukup, sekarang aku harus memberi tahu mereka semua yang ingin kukatakan pada Godwin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Emm... tolong tutup kupingmu. Jangan menguping, ini pembicaraan pribadi antar kekasih. Kamu juga pasti pernah mengalaminya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Baiklah, sekarang tolong bawa ini ke patung Archon Anemo lalu lepaskan mereka bersama dengan angin dan biarkan sang Archon membawa mereka pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Aku harap Archon Anemo membawa mereka kepada Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
