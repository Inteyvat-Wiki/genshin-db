			"dialogs": [
				{
					"id": 200360301,
					"content": "Kamu sudah melakukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "Angin di atas sana sangat kencang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Bagus sekali, angin kencang bisa membuat dandelion terbang jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Dengan begitu, mungkin mereka akan sampai pada Godwin dan memberi tahu apa yang kukatakan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Tolong ulurkan tanganmu, sehingga aku bisa memegangnya... Ini terimalah, tanda terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Masih banyak hal yang ingin kukatakan pada Godwin. Aku mungkin akan merepotkanmu lagi lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		}
