			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "Kakak lihat para Rock Crab di sana? Mereka kayak lagi bikin ritual apa gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Mungkin memang gitu kebiasaannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Masa? Oh ... ngerti nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "Banyak orang di Kota Nasha yang mirip sama Rock Crab. Ada yang jalan bergandengan, ada juga yang saling sapa pakai salam olahraga lalu bubar jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "Mungkin memang gitu juga kebiasaan di Kota Nasha. Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Betul. Kamu cepat tanggap ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "Kakak bisa enggak bikin semua Rock Crab masuk ke kolam kecil itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Hmm ... mungkin kayak manggil semua pemburu harta ke The Flagship kali ya? Seru tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "Aku penasaran bakal gimana jadinya kalau semua Rock Crab dikumpulin di satu tempat ... Kakak, lagi senggang tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Sedikit beda, tapi boleh lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
