			"dialogs": [
				{
					"id": 409110401,
					"content": "Hanya beberapa awalan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110402,
					"content": "Pengembara! Kamu datang tepat waktu, apakah kamu masih ingat dengan Elemental Crucible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110403,
					"content": "Setelah kamu menyalakan Elemental Crucible, aku juga sudah mengumpulkan banyak data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110404,
					"content": "Dan yang terpenting adalah, aku sudah yakin dia bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110405,
					"content": "Dengan adanya peralatan yang bisa diandalkan, ke depannya bisa melakukan percobaan lebih banyak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110406,
					"content": "Pengembara, kalau kamu bersedia, bisakah kamu membantuku menyalakan Elemental Crucible lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110407,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110409,
					"content": "Mau melakukan percobaan berapa kali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "Tentu saja semakin banyak semakin baik, alkemis yang tidak memiliki Vision sepertiku, hanya bisa mengandalkan percobaan ini untuk mencari tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110411,
					"content": "Jadi tolonglah, Pengembara, bantu aku menyalakan Elemental Crucible lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
