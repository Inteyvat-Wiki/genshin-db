			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "Eh, Pengembara, tolong tunggu sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Ah, sebenarnya aku agak tidak enak mengatakannya... tapi aku benar-benar membutuhkan bantuanmu mengenai sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Kamu juga tahu bahwa aku sudah lama mempelajari ilmu alkimia tapi tidak pernah membuat sebuah terobosan baru yang luar biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Lalu aku sadar kalau aku terus begini, aku tidak akan pernah bisa membuat sebuah kemajuan yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Jadi kamu ingin mempelajari bio-alkimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Jadi kamu ingin mempelajari alkimia kuno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Jadi aku memutuskan untuk mencoba sesuatu yang berbeda dan melakukan hal yang belum pernah dilakukan sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Ah tidak ada sesuatu yang baru mengenai bio-alkimia. Banyak orang yang sudah mulai mempelajarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Maksudmu alkimia zaman kuno? Ah tidak, itu bukan bidang yang bisa kupelajari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Hm... apa kamu tahu faktor terpenting dari ilmu alkimia? Jawabannya adalah elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Karena berbagai alasan, bahan alkimia yang digunakan biasanya adalah gabungan beberapa item dengan energi elemental, jadi tidak hanya energi elemental murni saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Dan dengan bahan yang begitu, maka akan menghasilkan beberapa kotoran dalam proses alkimianya. Dan kotoran semacam ini akan membuat reaksi elemental menjadi kurang efektif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Sebagai kompensasi, kita harus menggunakan bahan elemental dengan jumlah yang lebih besar. Walau demikian, kita juga masih harus memperhatikan proses transmutasinya agar kotoran tersebut tidak memengaruhi hasilnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Tapi sayangnya bagi mereka yang tidak mempunyai Vision, ada biaya tambahan jika mereka ingin melakukan proses alkimia seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "Dan masalah terbesar adalah, biaya untuk bahan-bahan tersebut tidaklah murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Biaya tagihan untuk transmutasi alkimia biasanya lebih mengkhawatirkan daripada hasil kerja kami ..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Aku juga tidak punya Vision.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Jadi kamu ingin aku melakukan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "Hah, mungkin karena itulah aku tidak pernah membuat sebuah hal baru yang luar biasa. Aku terhambat biaya yang terlalu tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "Oh benar... tapi kudengar, kamu tetap masih bisa memanipulasi energy elemental, benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Kudengar walaupun tidak punya Vision, kamu tetap bisa memanipulasi kekuatan elemental. Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Jadi begini, aku telah mengembangkan tungku baru untuk alkimia, aku menamakannya <color=#00E1FFFF>Elemental Crucible</color>. Jadi intinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Singkatnya itu adalah tempat yang bisa menampung energy elemental murni dan dapat menghasilkan reaksi elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Dengan menggunakan Elemental Crucible dalam proses alkimia, ini akan membuat kemampuan alkimiaku meningkat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Sekarang semuanya sudah siap. Tinggal memerlukan seseorang saja dengan kemampuan elemental untuk \"memindahkan\" energy elemental murni tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Jika kamu bersedia membantu, silakan temui aku di <color=#00E1FFFF>Thousand Winds Temple</color>. Aku sudah meminta beberapa orang untuk menyiapkan segalanya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Aku benar-benar berharap kali ini akan menjadi terobosan baru yang luar biasa untuk alkimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
