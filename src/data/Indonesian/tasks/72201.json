			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Ah, orang lewat yang baik hati, mohon kasihanilah aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Terima kasih, terima kasih sudah sudi mendengarkan persoalan orang tua ini ... Kemarilah, kemarilah, dengarkan ceritaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Selama kehidupan ini, aku belum pernah mendapat keberuntungan, belum pernah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Ketika aku baru lahir, tetua agung yang menyaksikan kelahiranku menyenggol lampu minyak, dan membakar rambut panjang bibiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Astaga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Kemudian, aku terkena penyakit aneh, tangan dan kakiku tidak bisa bergerak dengan baik. Lalu, aku jatuh dari keranda sampai enam tulang rusukku patah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Selang beberapa lama, aku sudah semakin besar, ketika ayahku tak sengaja memukul kepalaku dengan cangkul waktu mencoba menolong sepupuku yang hampir mati tersedak jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "Dan ada juga waktu burung pipit peliharaanku dimakan oleh Wen Kamuy keluarga kami, tepat sebelum Wen Kamuy tersebut diseruduk Boar sampai jatuh dari tebing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Setelah itu, gadis yang aku sukai tak sengaja mengorbankan tetua agung ke Thunderbird, dan dia akhirnya diasingkan dari pulau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Setelah aku dewasa, nenekku meninggal karena tak kuat melihat rupaku yang buruk dan suram. Kakekku pun menyusul tak lama setelahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Kemudian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Setidaknya ada keluargamu kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Ah, keluarga ya ... Waktu aku baru dewasa, dukun bilang kalau aku tak bisa punya keturunan, karena aku punya ... Sebentar, biar kuperlihatkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "TIDAK USAH!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*haah* Baiklah. Maukah kalian dengar satu hal terakhir? Kalau tidak keberatan, tolong lakukan satu hal ini untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Belum lama berselang, cincin emasku tidak sengaja jatuh ke liang kubur istriku waktu aku menguburkannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Itu satu-satunya kepunyaanku yang tersisa, namun aku tidak berani gali kuburnya, aku takut arwahnya marah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Jadi maksudnya, kamu mau kami yang gali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "Ah, itu ... Kalian kan orang luar ... Kalian sudah biasa mengerjakan tugas yang agak aneh begitu, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "Ah, eh, salah ... Maksudnya, orang luar seperti kalian pasti tidak bakalan membuat murka roh setempat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Pergilah ke Chirai Shrine. Makamnya ada di sebelah kuil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Asal bukan yang aneh-aneh lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Tidak perlu sejauh itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Ada yang perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
