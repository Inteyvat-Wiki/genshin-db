	"talks": [
		{
			"id": 7667301,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#Saat {M#pemuda}{F#gadis} itu melanjutkan langkahnya, dia melihat banyak patung indah yang tersebar di wilayah penyihir itu. \"Ini patung apa?\", dia bertanya dengan bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730102,
					"content": "\"Mereka adalah yang menentang diriku. Mereka meremehkan kekuatan penyihir, dan akhirnya berubah jadi batu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730103,
					"content": "Hm, aku cukup suka itu. Meski tambahan yang mendadak, tapi aku berani bilang itu ide yang bagus. Seorang penyihir seharusnya adalah sosok yang kuat dan berbahaya ... Bahaya memberi kesan misterius tertentu, dan tanpa misteri, dunia ini akan jadi tempat yang sangat membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730104,
					"content": "(Tapi mengubah orang jadi batu begitu saja ... apa tidak terlalu berlebihan? Tidak ada yang mau dekat dengan orang yang suasana hatinya berubah-ubah ... Baiklah, mungkin aku kurangi sedikit dan jadikan peringatan yang lebih samar saja.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730105,
					"content": "Mendengar ini, sang pemuda mulai berkeringat dingin. Tapi kemudian, tawa sang penyihir memecah keheningan: \"Haha ... Kamu percaya ya? Aku cuma bercanda. Patung-patung ini hanya caraku untuk mengabadikan momen tertentu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730106,
					"content": "\"Ngomong-ngomong soal patung. Untuk itu aku butuh bantuanmu. Rumah penyihir ini terasa agak sepi, dan aku ingin mengisi ruang ini dengan beberapa teman yang imut.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amati"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667302",
							"2"
						],
						"stepId": 7667302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#{M#Pria}{F#Gadis} muda itu terpesona oleh keagungan dan kecantikan sang penyihir. Setelah diam beberapa lama, dia berkata dengan sungguh-sungguh:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730202,
					"content": "\"Wahai penyihir agung dari negeri jauh, betapa cantik dan bijaksananya dirimu! Saat pertama aku melihatmu, hatiku mulai berdebar. Kini satu-satunya keinginanku adalah menjadikan harapanmu sebagai harapanku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730203,
					"content": "Sebuah senyum tipis muncul di wajah sang penyihir saat dia menjawab: \"Baiklah. Kalau begitu aku akan memberikan beberapa tugas yang sesuai dengan kemampuanmu. Pemandumu ada di sini, dan hadiahmu akan menanti di hari-hari mendatang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730204,
					"content": "Pemandu? Maksudnya bola cahaya ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "\"Rumah rahasia ...\" kata sang pengembara muda, dengan wajah kebingungan. \"Di mana 'rumah rahasia' yang kamu maksud itu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730302,
					"content": "Suara sang penyihir terdengar sedikit gugup saat mendengar pertanyaan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730303,
					"content": "(Tunggu, apa masuk akal kalau karakternya pemalu begini? ... Eh, sudahlah — untuk sekarang biarkan saja. Mr. Nine bisa meningkatkannya nanti.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730304,
					"content": "\"Ehem, kurang sopan bertanya hal seperti itu pada seorang penyihir, anak muda. Rumah penyihir masih sedang dalam renovasi. Sebentar lagi, kamu akan terpukau dengan kemegahannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730305,
					"content": "\"Ini akan menjadi ujianmu. Tunjukkan kekuatanmu, dan bantu penyihir agung ini membangun wilayahnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amati"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "\"Baiklah, anak muda. Sekarang kamu sudah tahu masalah yang dihadapi penyihir ini ... Nicola Coco butuh bantuanmu untuk membangun wilayah sucinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730402,
					"content": "Sang penyihir menuangkan secangkir teh untuk tamunya. \"Bagaimana menurutmu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730403,
					"content": "Sebuah kehormatan bisa melayanimu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "Tunggu dulu! Apa tidak sebaiknya kita pikirkan lagi sebelum terlibat sepenuhnya? Kita tidak tahu apa-apa tentang orang ini. Dia juga terlihat sedikit aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730406,
					"content": "Huh ... Tapi kalau dipikir-pikir, cangkir teh ini sepertinya tidak asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730407,
					"content": "Sudah sadar belum, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Nicola Coco ... Ah! Jangan-jangan ... Penyihir \"N\"? Nicole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730410,
					"content": "Benar. Bagaimana menurutmu tentang ceritaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730411,
					"content": "Hm ... Susah dinilai. Ceritanya belum selesai, kan? Terus gimana nasib karakter-karakternya di akhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730412,
					"content": "Belum diputuskan. Aku mau renovasi rumah dulu. Mungkin setelah itu akan dapat inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730413,
					"content": "Ngomong-nomong, kalau kamu bisa dengar suaraku, berarti kamu sedang ada di Nod-Krai. Kalau begitu, bisa minta tolong kumpulkan beberapa barang untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730414,
					"content": "Barang apa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Begini, aku mau buat beberapa patung lagi untuk menghias rumah, tapi saat ini aku sedang kehabisan inspirasi. Aku pikir kamu bisa ambil beberapa foto yang bisa memberiku beberapa ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730418,
					"content": "Seriusan? ... Oke deh. Serahkan pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730419,
					"content": "Tunggu di sini — kami bakal pergi dan coba cariin. Tapi jangan lupa selesaiin ceritanya ya kalau patung-patungnya udah selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730416,
					"content": "Apa ada hubungannya dengan patung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Tepat sekali. Aku mau buat beberapa patung lagi untuk menghias rumahku, tapi saat ini aku sedang kehabisan inspirasi. Jadi, aku pikir kamu bisa tolong foto-foto untuk memberi ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730408,
					"content": "Dia seseorang yang kita kenal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "Penyihir agung Nicola Coco, aku akan laksanakan perintahmu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
		{
			"id": 7667305,
			"completionStepIds": [
				7667313,
