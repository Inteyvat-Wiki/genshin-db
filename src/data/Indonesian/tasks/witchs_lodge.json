				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "Hei Nicole, kami udah balik nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730902,
					"content": "Cepat sekali! Kerja kalian berdua sangat cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730903,
					"content": "Ah, enggak apa. Tapi gimana cara kami kasih fotonya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Simpan saja dulu. Aku beberapa hari lagi bakal sampai sana, nanti kita lanjut bahas patung-patungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730905,
					"content": "Oke! Sampai ketemu beberapa hari lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
