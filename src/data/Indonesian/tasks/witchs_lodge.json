						],
						"pointId": 14996
					}
				]
			},
			"dialogs": [
				{
					"id": 766730501,
					"content": "Kebetulan sekali kamu yang aku cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730502,
					"content": "Aku puas dengan foto-foto yang kamu ambil — bahan referensi yang bagus. Sekarang — semua alat memahat sudah siap. Mau coba sama-sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730503,
					"content": "Alat memahat? Maksudnya balok-balok ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730504,
					"content": "Benar. Patung-patung ada di dalam batu. Kita hanya perlu buang bagian yang tidak diperlukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730505,
					"content": "Supaya lebih mudah, aku sudah menyiapkan panduan cara memahat yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730506,
					"content": "Biar aku tunjukkan. Pertama, kita buat beberapa potongan besar dan tebal untuk memahat bentuk dasar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730507,
					"content": "Angka-angka di batu menunjukkan jumlah material yang harus dipertahankan dalam satu kolom. Jadi, pertama begini ... lalu ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730508,
					"content": "Oh, mulai kelihatan bentuknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730509,
					"content": "Paham? Kalau kamu pahat baloknya seperti ini, kamu bisa lihat bentuk dasarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730510,
					"content": "Lalu, tinggal tambah sentuhan akhir ... dan, tadaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730511,
					"content": "Tunggu, apa!? Tiba-tiba berubah dalam sekejap mata! Kok bisa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730512,
					"content": "Hah, penyihir hebat tidak akan mudah buka rahasianya. Saksikan saja, dan bersiaplah untuk terpukau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730513,
					"content": "Kamu sudah paham dasar-dasar proses pemahatannya, kan? Fokus itu saja, biar aku yang urus sentuhan akhirnya. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730514,
					"content": "Baiklah. Ayo kita cobain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730515,
					"content": "Apa-apaan ...!? Ini jauh lebih sulit dari yang kamu contohin tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730516,
					"content": "Hmm? Oh, maaf, maaf. Yang ini salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730517,
					"content": "Itu yang aku mau kerjakan sendiri. Punyamu yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730518,
					"content": "Fiuh ... Syukur deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
