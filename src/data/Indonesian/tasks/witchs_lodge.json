					"nextDialogs": [
						766730702
					]
				},
				{
					"id": 766730702,
					"content": "Hmm, ada beberapa yang bagus, tapi masih kurang tampak depan. Tunggu sampai dia balik badan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730703
					],
