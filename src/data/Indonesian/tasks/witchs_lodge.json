				},
				{
					"id": 766730703,
					"content": "Groarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730704
					],
					"speakerTitle": "Mandragora"
				},
				{
					"id": 766730704,
					"content": "Ya, itu dia! Ini momen yang sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730705,
						766730706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730705,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				},
				{
					"id": 766730707,
					"content": "Waaaaaah! Tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
