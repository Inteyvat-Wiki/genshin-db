						],
						"pointId": 14930
					}
				]
			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#Dahulu kala, ada seorang {M#pria}{F#gadis} muda yang kabur dari rumah. Setelah menghabiskan Mora terakhirnya, dia berjalan melewati dinginnya musim dingin, menggigil dalam pakaiannya yang lusuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730802,
					"content": "#Tiba-tiba, {M#pria}{F#wanita} muda itu mendapati dirinya melangkah di udara kosong, dan dia terjatuh ke tempat yang aneh. Tapi sebelum sempat bereaksi, dia mendengar sebuah suara dari kejauhan:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730803,
					"content": "\"Ini adalah rumah rahasia Nicola Coco, sang Penyihir Agung Abadi. Wahai jiwa yang malang, katakan padaku keinginan terbesar dalam hatimu, dan dengan bimbinganku, kamu akan meraihnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 766730804,
					"content": "Wah ... suara yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "\"Nicola Coco\" ... Siapa itu? Emangnya kita kenal dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
