			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Sekarang kita tinggal tunggu Nicole kasih sentuhan akhir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "Kamu sudah buang semua batu yang tidak perlu, kan? Coba aku lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Hehe, selesai nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "Wah! Rumah penyihir! Sejak kapan ada di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "Apakah ini kekuatan seorang penyihir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "\"Inikah kekuatan seorang penyihir?\" Suara pemuda itu dipenuhi rasa takjub. \"Aku benar-benar terpukau.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "Aha! Akhirnya, ceritanya dilanjutin! Jadi, apa yang terjadi sama penyihir dan pengunjungnya yang muda itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "Mereka hidup bahagia selamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "Tamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "Lalu prosesnya bagaimana!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "*huff* Pelanggan yang sulit ya? Baiklah, kalau kamu memang mau dengar, aku akan cerita dari awal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#\"Yang kuinginkan sekarang hanyalah mewujudkan keinginanmu\", kata {M#pria}{F#gadis} muda itu. Kata-kata tersebut berhasil menarik perhatian penuh sang penyihir hebat, Nicola Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "Tapi tepat saat mereka mulai akrab, sekelompok tamu tidak diundang tiba-tiba menyerbu masuk, menangkap sang penyihir, dan membawa dia kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "Saat pemuda itu masih berdiri terkejut, seorang penyihir baru bernama Alynas muncul. Dia menandatangani kontrak dengan pemuda itu, dan memberi kekuatan sihir kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "Tapi setelah melewati program pelatihan yang berat, mereka malah menemukan konspirasi lain yang terjadi di balik layar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "Ternyata, penyihir hebat Nicola Coco adalah makhluk dari luar angkasa. Identitas aslinya adalah putri pertama dari Raja Meowtres III dari Planet Meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "Dia datang menyamar jadi penyihir sebagai bagian dari rencana rahasia untuk membuat seluruh dunia memuja Planet Meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "\"Wahai penyihir agung ... apa selama ini kamu bohong padaku?\" Suara sang pemuda bergetar saat hatinya mulai hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "\"Pergilah. Perang antara planet kita pasti akan pecah. Kita memang musuh sejak awal.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "Penyihir itu memalingkan wajahnya, tidak ingin siapa pun melihat air mata yang mulai menggenang di matanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "Tapi sang pemuda dengan berani mengulurkan tangan dan menahan lengannya, bersumpah tidak akan meninggalkannya. Tersentuh oleh ketulusan ini, sang penyihir memutuskan untuk melawan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "Tapi di saat itu, Alynas yang dulu pernah membantu pemuda itu, malah memilih untuk berpihak pada raja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "Alynas ternyata selama ini adalah putri kedua Meowtres III. Dia hanya membantu pemuda itu dengan harapan kakaknya bisa terpancing untuk berkhianat, agar dia punya kesempatan untuk merebut posisi Nicola dalam garis keturunan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "Nicole melanjutkan ceritanya yang panjang dan berbelit-belit. Setelah banyak alur cerita yang aneh, bahkan sang protagonis bukan lagi manusia ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "Intinya, begitulah ceritanya. Di akhir cerita, sang pemuda — yang saat itu sudah berubah jadi kucing — bekerja sama dengan sang penyihir untuk menggagalkan rencana raja. Setelah itu, mereka pulang bersama ke rumah sang penyihir, dan hidup bahagia selamanya dengan tenang dan damai. Tamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "*hils* Ceritanya bagus banget .... Cerita ini punya semuanya! Cinta sejati ... perlawanan terhadap ketidakadilan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "Rasanya cerita ini mulai dari satu kisah dan berakhir dengan kisah lain ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Memang harus begitu. Semua ciptaan pada akhirnya akan lepas dari kendali penciptanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Contohnya kami para malaikat. Dulu, kami diberi tugas untuk membimbing umat manusia, tapi karena beberapa dari kami memilih jalan yang berbeda, seluruh ras kami dihukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Kalau bahkan Prinsip Langit saja tidak bisa mengontrol ciptaannya sepenuhnya ... apalagi aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "Takdir selalu sulit dipahami, tapi ... aku masih berharap bisa membantu orang-orang yang kutemui untuk dapat akhir cerita yang bahagia. Hal yang sama juga berlaku untuk karakter dalam ceritaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "Pokoknya, ceritanya sudah selesai, dan energiku sudah mulai habis. Lain kali kalau ada cerita bagus, akan aku ceritakan padamu, boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Jadi dia putri kedua Raja Meowtres III ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "Dia bantu anak muda itu ... agar kakaknya terdorong untuk makar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "Demi merebut hak waris Nicola ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "Kamu tidak cerita bagian tengahnya sama sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
