			"dialogs": [
				{
					"id": 761220201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! Ternyata benar kamu! Kamu udah balik ya! Dengan wujud perakmu! Paimon kira enggak bakal bisa ketemu kamu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "Lukisan yang kita gambar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Kita pakai cahaya bulan untuk melukis sosok anak ini, aku juga sudah curahkan kekuatan serta berkah baru ke dalamnya, supaya dia bisa terlahir kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220205,
					"content": "Dia sudah tidak perlu menanggung semangatku. Keinginannya sekarang miliknya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Ah, dia terbang ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Ya. Aku sudah membangkitkan semua kenangan saat kalian bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220210,
					"content": "...! ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "*hiks* Paimon senang banget kamu udah balik, Luonnotar. Paimon janji bakalan lebih baik ke kamu mulai sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "Paimon tidak nyangka kejutannya akan sesenang ini ... Paimon suka banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "Terima kasih, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Tidak masalah. Aku juga senang bisa ketemu dia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220216,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220218,
					"content": "(Dia masih sangat terikat dengan Luonnotar, tapi ekspresinya berbeda dari sebelumnya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Dia melihat Luonnotar bukan hanya sebagai abdi yang dia diciptakan, tapi sebagai teman yang akrab.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "Pergilah. Kamu pasti rindu dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220221,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "Silakan datang kembali kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
