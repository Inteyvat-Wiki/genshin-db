			"dialogs": [
				{
					"id": 761220401,
					"content": "Wah! Ini pasti tempat yang kamu bilang itu, kan? Paimon enggak ada waktu itu, jadi enggak bisa lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220402,
					"content": "Benar-benar indah sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Paimon boleh terbang keliling untuk periksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220405,
					"content": "Kalau kamu mau, suatu hari aku bisa bawa kamu kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220406,
					"content": "Jadi, \"kejutan menyenangkan\" yang kamu bilang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "Oh? Jadi ini sudah cukup menjadi \"kejutan menyenangkan\" di mata Paimon? Tidak, kejutan yang sebenarnya masih belum datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220408,
					"content": "Masih ada lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Ayo. Mari kita melukis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220410,
					"content": "Tunggu. Di sini? Tapi Paimon enggak lihat ada kanvas, kuas, atau cat di mana pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Oh. Itu sangat mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220412,
					"content": "Permukaan air adalah kanvas kita, cahaya bulan adalah kuas kita, dan jalan yang kita pilih akan jadi goresan lukisannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220413
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220413,
					"content": "Dengan pantulan bulan sebagai penuntun, pikiran murni akan mengalir di bawah kaki kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		}
	]
}