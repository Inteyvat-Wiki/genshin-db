			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Eh? Aneh. Paimon yakin banget dengar suara Columbina deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "... Hyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220104,
					"content": "Eek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Salam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220106,
					"content": "Lagi-lagi bikin kaget! Sialan! Kalau kamu memang di sini, harusnya bilang dari tadi dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Aku rasa karena kamu sudah sangat paham dengan permainan ini, jadi aku harus tingkatkan kesulitannya kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220108,
					"content": "Hmph! Tunggu aja, lain kali Paimon pasti menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Bagus! Aku tidak sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220110,
					"content": "Penutup matamu kenapa, Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Oh. Sepertinya penutup mataku diambil kuuhenki saat kita main tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220112,
					"content": "Aku biasanya tidak perlu pakai mata, jadi juga tidak ada bedanya. Biar saja mereka main-main dengan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220113,
					"content": "Oh! Ngomong-ngomong, kamu enggak mau lebih sering keluar kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Kamu tidak perlu sembunyi dari siapa pun lagi, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Ya ... sekarang aku punya banyak waktu. Aku bisa pergi ke mana saja, kapan saja aku mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220116,
					"content": "Tapi aku khawatir kamu akan cemas kalau kamu datang mencari aku dan ternyata aku pergi begitu saja tanpa pamit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220117,
					"content": "Kalau situasi begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Ya! Kami cuma perlu tahu kalau kamu tuh baik-baik aja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Oh begitu. Kalau begitu akan aku pertimbangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220121,
					"content": "Cuma \"pertimbangkan\" doang ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Atau mungkin kamu memang mau di sini saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Semua yang sudah terjadi di sini ... bagiku itu semua kenangan yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220124,
					"content": "Tapi, aku punya alasan lain kenapa menunggu kalian di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220125,
					"content": "Apa emangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Untuk memberi kejutan yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761220118,
					"content": "Kamu bisa tinggalin pesan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
