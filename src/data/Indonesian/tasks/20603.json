			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "Kenapa cepat sekali kalian kembali? Sepertinya tidak ada sesuatu yang serius terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Tidak, masih ada banyak monster berkeliaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Apa? Masih banyak monster yang berkeliaran, dan bahkan lebih banyak dari sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Aneh. Bukannya kekuatan yang menyerang kota Mondstadt sudah dikalahkan sebelumnya? Kenapa mereka masih ada di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "Mungkinkah mereka masih punya rencana lain?... Aku harus mengumpulkan para petualang dan melakukan langkah lain. Kita tidak bisa menganggap remeh monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Melakukan investigasi yang cermat terhadap perilaku monster di alam liar termasuk dalam tugas Adventurers' Guild. Inilah saatnya kita menunjukkan kekuatan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Oh, iya. Silakan ambil ini sebagai upah atas usahamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
