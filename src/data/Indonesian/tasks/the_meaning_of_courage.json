			"dialogs": [
				{
					"id": 150310301,
					"content": "Selesai! Inti yang ini harusnya bisa deh. Lihat! Phlogiston di dalamnya masih aktif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Ohh, coba kulihat ... Wow, pa-panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Kita cari lagi beberapa yang kayak gini, harusnya bisa deh. Yuk lihat ke atas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
