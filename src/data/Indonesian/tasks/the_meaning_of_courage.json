				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "Hasilnya banyak banget! Kayaknya dia pakai ini buat nyemburin api!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Kayaknya armor belakangnya bisa menyemburkan Phlogiston, jadi dia bisa bergerak dengan sangat cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Ayahku pernah bilang soal mereka — mereka adalah makhluk yang tinggal di gunung berapi. Tidak disangka aku bisa lihat langsung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Aku rasa zirah ini mungkin lebih panas daripada \"Seeing Eyes\". Hehe, kali ini jamur itu pasti bakal langsung panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Oh ya tadi itu kamu hebat banget deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Eh yah ... Walau aku tidak suka bertarung, terkadang tidak ada pilihan lain kan. Jadi aku memikirkan berbagai cara supaya aku bisa siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Misalnya, aku banyak baca cerita soal pahlawan, dan pahlawan favoritku itu Fietena — yang kubilang tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Yang paling menonjol soal Fietena itu topengnya, jadi aku bikin yang mirip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "Jadi kapan pun aku pakai topeng itu, seolah dia ada bersamaku. Kalau aku mau menghormati warisannya, aku harus berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Tapi juga malah seolah jadi seperti aku bersembunyi di balik kekuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Tapi toh itu bisa bantu kamu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Oh ya? Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Rasanya kayak ... Suatu hari nanti aku harus tetap lepas topeng ini dan hadapi sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Tapi semakin aku melangkah, semakin mustahil rasanya. Aku ... tidak tahu kalau aku bisa atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Tapi kamu yang memutuskan untuk menyelidiki kasus ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Iya, KAMU punya keberanian membuat keputusan, itu namanya semangat bertualang! Bertempur itu cuma bagian kecilnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Lagian kata Paimon sih kamu sudah bagus! Pelan-pelan saja — kan ini bukan lomba juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Terima kasih karena kalian berdua percaya padaku. Aku jadi belajar banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "Dan aku juga tidak akan menyerah sampai aku harus menghadapi itu sendirian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Fyuh, habis ngobrol panjang lebar tadi, aku jadi lapar lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Hah? Sudah lapar lagi? Paimon saja masih belum beres mencerna makanan yang barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Yuk balik ke kampung suku. Kali ini kita pasti dapat pengakuan dari jamur itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Bukan topengmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Tidak perlu malu soal itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
