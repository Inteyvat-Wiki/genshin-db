			"dialogs": [
				{
					"id": 756650101,
					"content": "Selamat datang di \"Pos Persediaan Ekspedisi Saurian\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650102
					],
					"speakerTitle": "Vinesh"
				},
				{
					"id": 756650102,
					"content": "Wow, banyak banget Saurian kecilnya. Mereka mau berangkat cari Ocean Zephyr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756650103,
					"content": "Waktu tidak menunggu siapa pun. Tim pencari Ocean Zephyr sudah berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650104
					],
					"speakerTitle": "Vinesh"
				},
				{
					"id": 756650104,
					"content": "Teman-teman kecil ini ingin membantu, tapi mereka sulit mengerti apa itu Ocean Zephyr meski sudah dijelaskan oleh dokter Ifa dan Cacucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650105
					],
					"speakerTitle": "Vinesh"
				},
				{
					"id": 756650105,
					"content": "Untuk menghargai semangatnya, dokter Ifa mengizinkan mereka ikut ekspedisi ... tapi definisi \"ekspedisi\"-nya terserah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650106
					],
					"speakerTitle": "Vinesh"
				},
				{
					"id": 756650106,
					"content": "Cari apa pun boleh, mau Grainfruit kek, atau benda-benda mengilap kek. Bebas. Yang penting semua pulang dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650107
					],
					"speakerTitle": "Vinesh"
				},
				{
					"id": 756650107,
					"content": "Paimon ngerti sih ... mereka senang tuh. Main yang benar ya, teman-teman! Jaga diri baik-baik, di luar sana banyak orang jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756650108,
					"content": "FUWAHH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650109
					],
					"speakerTitle": "Tepetlisaurus Kecil yang Ceria"
				},
				{
					"id": 756650109,
					"content": "Kami memberikan bimbingan untuk Saurian yang berpartisipasi. Kalau kalian tertarik, boleh lihat-lihat kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinesh"
				}
			]
		}
