						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Wihhhh! Cyno berhasil tangkap satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Oooh, jadi ini ya dalangnya! Cepat, buka mulut! Kasih tahu Paimon semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Dia tahu sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Saat dia muncul, aku tidak langsung bergerak. Aku pantau dulu situasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Dia bukan dalangnya, tapi dia lumayan penting. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Aku terkesan. Cyno yang asli ternyata sesuai dengan reputasinya. Kalau aku tahu kamu masih ada di sini, aku tidak akan serakah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "Serakah? Maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Begitu tahu kalian sedang menuju kemari, semua pengedar kabur dan barang mereka ditinggal di sini. Tidak ada waktu untuk beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Karena barangnya ditinggal semua di sini tanpa pengawasan, aku pikir bagus juga kan kalau aku kembali ke sini dan ambil semua. \"Barang gratisan nih, kapan lagi\", begitu kira-kira yang ada di pikiranku ... Hah, sudahlah, buat apa juga dijelaskan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Kamu tahu siapa yang memproduksi dan menjual Kapsul Pengetahuan, kan? Bisa langsung saja beri tahu kami, atau mesti pakai cara paksa dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Tidak usah dipaksa, aku akan buka mulut. Tapi sebelumnya, bisa bawa aku ke tempat lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Kalau kita terus di sini, aku takut ada yang memergoki kita. Nanti keselamatan keluargaku bisa terancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Baiklah, mau pindah ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Ke Desa Aaru, kampung halamanku. Di sana aman. Bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Tentu, ayo jalan. {NICKNAME}, kamu sudah boleh buang alat pelacaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Dia orang penting?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Papa sudah pulang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "Ah, ada tamu? Selamat datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Ini putriku, Simin. Dia sedikit malu-malu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Kamu main sendiri dulu ya, sayang. Papa mau ngobrol dulu sama tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Oh ... Okei ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Semua orang yang berkutat di bisnis ini tahu nama besar Cyno. Tapi kalian berdua ... maaf, boleh tahu siapa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Nama Paimon ya ... Paimon, dan yang ini {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "Jujur, aku tidak sangka Cyno yang biasa kerja sendiri tiba-tiba punya partner. Waktu aku lihat alat pelacaknya menjauh, aku berasumsi kalau kamu memutuskan untuk pergi begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Tapi meskipun kalian berhasil menangkapku, sebaiknya hentikan saja penyelidikan kalian. Mumpung masih sempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Kapsul Pengetahuan ... mulai dari proses pembuatan, penjualan, sampai pembagian keuntungannya, semua melibatkan lusinan, bahkan ratusan orang. Nilai keuntungan yang fantastis membuat semua orang yang terlibat di dalamnya saling membantu mempertahankan bisnis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Semuanya akan berusaha mati-matian mempertahankan industri yang sudah susah payah dibangun ini. Perjuangan yang panjang menanti siapa pun yang mau mengganggu bisnis ini, termasuk kamu sekali pun, Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "Bahkan kalau akhirnya kamu berhasil pun, tidak akan ada orang yang berterima kasih. Bahkan mungkin kamu sendiri akan pulang dengan penyesalan ... Kenapa kamu ingin sekali mengacaukan usaha kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Setiap orang punya alasan untuk melakukan sesuatu. Dan tidak ada kewajiban untuk menjelaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Papa ... ini tehnya ... terus ini buat tamunya papa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Oh, iya. Aku lupa menyajikan minuman untuk tamu. Makasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Enggak apa-apa kok ... Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Teh kami rasanya lebih pahit, jadi aku kasih gula sedikit biar lebih enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "Anak papa memang pintar. Gulanya masih ada tidak? Kalau sudah habis nanti papa beli lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Masih ada kok. Aku istirahat dulu yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Kamu bilang semua orang dapat untung besar? Mana bagianmu? Kok tidak kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "Ahaha, sebenarnya itu yang mau aku bahas. Aku mau minta tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Putriku lahir dengan penyakit, jantung dan paru-parunya lemah. Olahraga ringan saja bisa bikin dia tumbang, dan nyawanya bisa terancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Karena itulah dia tidak punya teman main dan sudah biasa diam sendirian di kamar. Dia juga harus minum obat, dan harga obatnya tidak murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Aku cuma pedagang biasa. Setiap hari bangun pagi buat jualan, keliling demi mencari Mora yang tidak pernah cukup. Aku cuma bisa ikhlas melihat kesehatan putriku semakin hari semakin buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Hingga suatu hari ada orang yang datang menawariku cara untuk mendapat untung besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "Jualan Kapsul Pengetahuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Ya. Hasil penjualan benda itu cukup untuk mengobati kondisi putriku, Tidak ada hal lain yang bisa membuatku lebih bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Banyak orang yang sama sepertiku. Di matamu, penyelundupan ini mungkin tindakan melanggar hukum yang tidak bisa diampuni, tapi bagi kami ini cuma cara untuk bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Aku cerita seperti ini agar kamu mau berubah pikiran. Tolong hentikan semua ini, Tuan Cyno yang terhormat. Jangan jungkirkan bakul makanan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Kok gini sih ... Berarti kalau kita berhasil stop penjualan Kapsul Pengetahuan, anaknya bakal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Aku harus tahu kebenarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Aku bisa bantu cari dokter untuk putrimu, tapi aku juga tidak bisa biarkan penyelundupan ini terus terjadi. Ini dua hal yang berbeda, tidak boleh dikait-kaitkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "Haah, aku sudah tahu kamu akan bilang begitu. Tapi kamu mau menolong putriku, jadi ... Kalau ingin lanjut menyelidiki, silakan lihat ke belakang rumahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "Ada barang yang baru datang. Lihat saja, dan setelahnya kamu akan mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Kamu pergi ke belakang rumah bersama Cyno.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "WAH, GILA BANYAK AMAT!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Semuanya dikemas dengan rapi di dalam kotak. Dan ini baru stok satu orang pengedar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Skala sebesar ini bukan makanan produsen kelas teri. Apa jangan-jangan Akademiya juga terlibat? Tapi apa iya jumlah sebanyak ini bisa lolos pemeriksaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Lihat tuh, kapsul yang sebelah sini beda dari yang lain. Mungkin enggak isinya tentang Court of Desolation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Seharusnya seperti itu. Tunggu, ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Ada tanda yang belum pernah kita lihat sebelumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Ini stempel Matra. Berarti barang di dalamnya sudah lolos pemeriksaan Matra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Saat melihat alat pelacak, aku mulai curiga ada orang Akademiya yang terlibat. Tapi aku masih belum mengerti bagaimana caranya mereka selundupkan barang sebanyak ini keluar dari Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Sekarang semuanya jelas. Kalau punya stempel Matra ini, barang-barang bebas keluar Akademiya tanpa perlu diperiksa ulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Hah, pantas saja mereka tidak mau aku melanjutkan penyelidikan. Ternyata ada Matra yang terlibat. Memalukan sekali, sulit dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Salah paham, mungkin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, boleh minta tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Karena semua Kapsul Pengetahuan ini asalnya dari Akademiya, maka besar kemungkinan informasi mengenai Court of Desolation juga sumbernya dari data penelitian yang disimpan di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Kalau bisa masuk ke Ruang Arsip, kita bisa periksa siapa saja yang pernah melihat data penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Mengingat statusku saat ini, kalau aku tiba-tiba muncul di Akademiya bisa runyam jadinya. Cuma akan menarik perhatian yang tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Karena itu harus kamu yang pergi. Aku akan tulis surat buat Nabil. Biar dia yang antar kamu ke Ruang Arsip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Okei, serahkan saja pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Aku akan melanjutkan penyelidikannya di sini. Semua petunjuk yang kita punya mengarah ke orang dalam, tapi hampir pasti ada pihak luar Akademiya juga yang terlibat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Kita bisa dapat info tentang pengedar lain dari Bahari. Aku mau buat persiapan di sini, kalian kemarilah kalau sudah dapat informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Cyno pernah lihat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
			"id": 1301010,
