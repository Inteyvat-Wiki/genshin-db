					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Aneh ... Masa sih lelangnya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Tidak ada orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Iya, satu juga enggak ada. Apa mereka lagi istirahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Kita langsung kemari setelah mengalahkan tentara bayaran. Harusnya tidak ada waktu untuk memperingatkan orang-orang di sini soal kedatangan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Tapi mereka tetap tahu. Berarti ada salah satu dari mereka yang mendapat info dari alat pelacak, lalu membubarkan semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Terus sekarang gimana dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Kita periksa area ini. Mereka mustahil bisa memindahkan semua Kapsul Pengetahuan secepat ini. Pasti masih ada sesuatu yang bisa jadi petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Oke, ayo mulai cari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
