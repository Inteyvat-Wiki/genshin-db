			"dialogs": [
				{
					"id": 130100610,
					"content": "Dapat sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100611,
					"content": "Eh, enggak ada apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Cuma Kapsul Pengetahuan biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Mungkin Kapsul Pengetahuan yang isinya tentang Court of Desolation tidak banyak jumlahnya. Jadi mereka bawa semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Jangan khawatir, aku ada ide lain. {NICKNAME}, kalian kembalilah lewat jalan yang tadi kita lalui waktu kemari. Aku akan menunggu si sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Balik lagi ke sini setelah beberapa waktu. Pasti akan ada sesuatu yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Ah, begitu ya. Makanya kamu minta aku jangan buang pelacaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Mereka terburu-buru dan tidak ada waktu buat membereskan semua barangnya. Tidak mungkin kan barangnya dibiarkan di sini begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Begitu mereka yakin kita sudah pergi, mereka akan kembali. Pastikan alat pelacaknya sudah cukup jauh dari lokasi ini, jadi mereka merasa aman untuk kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Paimon ngerti! Kami jadi umpan, soalnya mereka pikir kami sudah cabut dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Oke deh, kami langsung ya. Kamu jaga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Ya, dan tenang saja. Kalau mereka berani kembali ke sini, mereka tidak akan bisa ke mana-mana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
