			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin",
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "Nona Ganyu, terima kasih telah menerima undanganku. Dan untuk kalian berdua, kehadiran kalian sangatlah berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Tentu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "Kamu sangat baik hati, Huixin. Terima kasih sudah mempersiapkannya dengan sepenuh hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Hehe. Sebenarnya... selain ingin berterima kasih padamu, ada hal lain yang ingin aku katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Oh? Apa ada yang bisa kulakukan untuk membantumu? Katakanlah saja langsung. Tidak perlu sungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "Ah... Bukan, bukan, aku bukan mau meminta bantuan. Em... maukah kamu mendengarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Hehe... Saat aku masih kecil, ayahku sering menceritakan banyak hal tentang dirimu, Nona Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Meskipun aku menghormati ayahku, tapi aku selalu mengagumi betapa lembut dan dapat diandalkannya dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "Aku memutuskan untuk bergabung ke Yuehai Pavilion, ini juga karena aku selalu mengidolakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Aku tidak tahu kamu begitu mengagumiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Tapi, pada kenyataannya, bekerja di Yuehai Pavilion ternyata sangatlah berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Kemampuanku tidaklah sebanding dengan kemampuan sekretaris yang luar biasa seperti kamu. Karena itu, aku selalu meragukan diriku sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Aku tidak setuju. Kamu adalah sekretaris yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Hehe, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Selama beberapa tahun ini, aku pun akhirnya menjadi seorang ibu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Hah! Jadi Paman Tian sudah menjadi seorang kakek?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Karena terpengaruh oleh cita-cita masa mudaku, dia pun akhirnya mengikuti jejakku dan menjadi seorang sekretaris di Yuehai Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "Pada awalnya, aku sangat khawatir. Menjadi sekretaris bukanlah pekerjaan mudah. Selain itu, aku juga tidak yakin apakah dia mampu melaksanakan pekerjaannya dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Tapi setelah semua hal yang terjadi... Aku memutuskan untuk mendukung pilihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Jadi, apa yang membuatmu mengubah pandanganmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "Karena dia nanti akan berjumpa denganmu, Nona Ganyu, sebagai seniornya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Kamu akan membantu dia, mengajari dia dengan lembut sambil berkata, \"Ibumu dulu juga seperti itu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Bila dibayangkan, pasti akan menjadi sebuah momen yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Kalau permintaanku ini tidak berlebihan, aku rasa dia masih membutuhkan bimbinganmu selama dua puluh tahun ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "...A-aku tidak pernah berpikir kalau aku begitu berarti di matamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "Hehe, seperti pada saat kamu menunjukkan trik ayahku. Memilikimu sebagai seorang \"saksi\" membuat orang merasa nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "\"Saksi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "...Aku memang sudah menyaksikan sejarah Liyue selama ribuan tahun. Semuanya perubahan yang terjadi, semua kisah orang-orangnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Tapi aku selalu merasa kesepian karena hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, kamu tidak tahu betapa pentingnya kata-kata itu bagiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Kamu membuatku menyadari bahwa aku memiliki hubungan erat dengan orang-orang di Pelabuhan Liyue, terlepas dari kontrakku dengan Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "Mereka mengandalkanku, menerimaku, dan merindukanku agar menjadi saksi dari kisah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "Tentu saja! Bagi kami, kamu tidaklah tergantikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Ehehe... Benar. Oleh karena itu, aku tidak akan mengecewakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Hore! Akhirnya Ganyu bersemangat lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Bahkan jika aku mau digantikan sekalipun, aku akan tetap memperjuangkan posisiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Aku tidak akan mengecewakanmu. Aku akan memenuhi kontrak itu dan melanjutkan pekerjaanku sebagai sekretaris Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Ah... sudah kubilang, kamu tidak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Terlepas dari hal itu, aku akan kembali dan melihatnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "Aku takut akan terjadi kekacauan saat aku sedang pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Tidak boleh membuang-buang waktu, ayo kembali bekerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Selamat bekerja, Nona Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Hah? Kita pergi sekarang? Paimon masih lapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Kamu tidak dipecat. Itu hanyalah sebuah kesalahpahaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baixiao",
					"Baishi",
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Ahhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Baishi, apa kamu baik-baik saja? Apa kamu ketiduran sambil berdiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Lihat... Lihat siapa yang kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Kamu bahkan memiliki waktu untuk bersantai? Sepertinya kalian bertiga cocok untuk menggantikanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "Tidak sama sekali! Kami hanya... Kami telah bekerja terlalu lama. Jika tidak istirahat sejenak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "Kukira kami sudah tidak akan melihatmu lagi, Nona Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Nona Ganyu, kami merindukanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Hmm, kalian benar-benar sangat ramah. Seingatku, kita hanya pernah bertemu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Kami telah berdoa setiap hari agar kamu dapat kembali dan melanjutkan pekerjaanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Bagi kami, kamu seperti seorang Adeptus yang turun ke dunia untuk menyelamatkan semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Lupakan kedengkian dan iri hati kami sebelumnya, tolong bebaskanlah kami dari pekerjaan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "Baiklah, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Tolong pisahkan urusan pemerintahan, bisnis, dan sipil. Lalu tandai tugas yang belum dimulai dan yang sedang dikerjakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320314,
					"content": "Aku akan mengurus sisanya.",
