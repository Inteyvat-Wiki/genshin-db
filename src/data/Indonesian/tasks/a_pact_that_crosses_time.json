					"nextDialogs": [
						110320322
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320322,
					"content": "Aku akan membalas budimu saat aku sudah menyelesaikan pekerjaanku. Bagaimana kalau aku... menemani perjalananmu?",
