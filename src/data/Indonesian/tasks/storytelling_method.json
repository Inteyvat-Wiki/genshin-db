			"dialogs": [
				{
					"id": 728120201,
					"content": "Oke, ceritanya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Aku belum pernah secapek ini. Apa ceritanya memang serumit itu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Inilah akibatnya kalau kamu tidak bikin plot. Tanpa adanya batasan, ceritanya akan saling bertabrakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Lalu, kamu jadi tidak tahu ke mana arah ceritanya. Kamu akan buntu tidak peduli apa pun itu yang kamu tulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "Haah, sudahlah... Aku sudah capek debat. Pengembara, terima kasih sudah menilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Kurasa aku belajar banyak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Ini untukmu. Aku akan lanjut menulis lagi.",
