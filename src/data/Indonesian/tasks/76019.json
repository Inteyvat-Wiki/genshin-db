					}
				]
			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "Bukti Cognoscenti? Jangan-jangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190102,
					"content": "Ko-Kok kalian mendekat sih? Kami lagi diskusi topik yang sangat rahasia, berkaitan dengan petunjuk Harta Karun Maha Besar milik Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190103,
					"content": "Baguslah! Aku juga mau ikut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "Hmm ... Oh ya, kalau begitu, ayo kita kerja sama! Aku juga lagi kesulitan kumpulin modal awal sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190106,
					"content": "Ada aku, ada kamu, dan ada juga yang bisa terbang. Total ada tiga. Kita bertiga, satu orang 500.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190107,
					"content": "Lima ratus ribu Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190108,
					"content": "Eh Vieri, bukannya kita sudah sepakat ini rahasia antara kita berdua? Aku bilang ke kamu karena aku percaya sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190109,
					"content": "Tapi 1,5 juta Mora itu jauh dari sekadar modal awal buatku. Lima ratus ribu saja mungkin masih bisa aku usahakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190110,
					"content": "Dua orang ini kelihatannya kayak petualang berpengalaman. Kalau kita kerja sama, peluang sukses kita pasti jauh lebih besar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190111,
					"content": "Aih, aku sangat percaya sama kamu, Vieri. Kalau mereka adalah calon yang kamu percayakan, aku juga tidak keberatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190112,
					"content": "Tapi, bentuk tubuh teman kecil yang bisa terbang ini berbeda dengan kita, jadi perlu lebih banyak perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190113,
					"content": "Woah, ada hadiah buat Paimon ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190114,
					"content": "Ya, karena ini produk khusus, dibandingkan versi asli \"Strength Tonic\" dari Natlan, produk ini cocok untuk berbagai kalangan. Termasuk teman-teman yang bisa terbang pun tetap aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190115,
					"content": "Soal harga, biasanya aku jual dua juta Mora sih. Tapi karena kalian teman Vieri, aku kasih harga spesial satu juta Mora saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190116,
					"content": "Satu juta Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190117,
					"content": "Itu hadiah kejutan loh, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "Lebih tepatnya kejutan yang menyeramkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190121,
					"content": "Benar, Nona Hidimbi. Aku tidak berharap si terbang ini ada gunanya, jadi tidak perlu bagi Strength Tonic ke dia kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190122,
					"content": "Sebentar, omonganmu sama sekali enggak membantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190123,
					"content": "Hmph, awalnya kami cuma mau dengar petunjuk tentang harta karun. Ternyata, kalian berdua ini satu jahat dan satu lagi bodoh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190124,
					"content": "#Mau tipu Paimon dan {NICKNAME}, enggak segampang itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190125,
					"content": "Siapa yang jahat? Siapa yang menipu? Petunjuk yang kuberi itu benar, barang daganganku juga asli. Soal harga ... itu cuma urusan bisnis. Dan kamu, si cerewet kecil ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190126,
					"content": "... Aku ini, paling benci orang sombong seperti dirimu. Jelas-jelas tidak mampu tapi malah sok hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190127,
					"content": "No-Nona Hidimbi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190128,
					"content": "Terus kamu juga, Vieri. Kalau itu topik rahasia, seharusnya dibisikkan pelan-pelan, bukan malah diteriakkan sampai mengundang tamu tak diundang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190129,
					"content": "Aku sungguh kesal. Kalau tidak kuberi pelajaran, rasanya amarah ini tidak bisa reda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190130,
					"content": "Makan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190119,
					"content": "Lima ratus ribu Mora aku langsung beli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "Kok tiba-tiba mulai nawar sih?! Kita enggak butuh barang ini kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190104,
					"content": "Kalau sudah didengar orang, itu bukan rahasia lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
