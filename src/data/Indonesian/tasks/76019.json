						760190227
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190227,
					"content": "No-Nona Hidimbi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190228
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190228,
					"content": "Terus kamu juga, Vieri. Kalau itu topik rahasia, seharusnya dibisikkan pelan-pelan, bukan malah diteriakkan sampai mengundang tamu tak diundang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190229
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190229,
					"content": "Aku sungguh kesal. Kalau tidak kuberi pelajaran, rasanya amarah ini tidak bisa reda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190230
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190230,
					"content": "Makan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190219,
					"content": "Lima ratus ribu Mora aku langsung beli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190220
					]
				},
				{
					"id": 760190220,
					"content": "Kok tiba-tiba mulai nawar sih?! Kita enggak butuh barang ini kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190204,
					"content": "Kalau sudah didengar orang, itu bukan rahasia lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190205
					]
				}
			]
