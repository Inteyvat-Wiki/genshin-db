			"dialogs": [
				{
					"id": 760190301,
					"content": "... Lakukan saja apa pun yang kamu mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Woah? Paimon dan {NICKNAME} enggak bakal lakuin hal mengerikan kayak gitu! Kamu janji enggak bakal tipu orang lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Bahkan orang bodoh kayak Vieri ... Eh? Dia sudah kabur ya? Po-Pokoknya, bahkan tipu orang bodoh kayak dia pun enggak boleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "Kalian baik sekali. Huff ... Andai saja aku bisa bertemu dengan orang baik seperti kalian waktu di Sumeru, mungkin aku tidak akan berakhir seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "Kalian tidak tanya aku apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "Intuisiku bilang sebaiknya aku tidak tanya lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "Benar-benar anak yang cerdik ... Huff, aku sudah lama tidak berbisnis. Mungkin sudah waktunya aku berganti karir, daripada jadi sasaran Serikat Voynich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "Kalau kamu bisa mikir kayak gitu dari awal, kamu juga enggak bakal dihajar tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Saat membuat keputusan penting dalam hidup, kita perlu sebuah kesempatan, entah itu baik ataupun buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "Adik, si kecil yang bisa terbang, kalau kalian perlu kesempatan ini, datanglah padaku kapan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190313,
					"content": "E-Enggak deh, makasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190314,
					"content": "Hidimbi meninggalkan kain sutra merah, lalu melambaikan tangan untuk berpamitan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 760190308,
					"content": "Beri aku dua juta Mora dan aku lanjut tanya.",
					"roleType": "TALK_ROLE_PLAYER",
