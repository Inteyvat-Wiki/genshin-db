			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "Tu-Tunggu dulu! Kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780102,
					"content": "Ada apa, gadis kecil? Ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Bawalah keajaiban mekarnya Guiztli, nyalakan senyumanmu dengan Api Keramat!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780104,
					"content": "Hah? A-Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"Atas nama Easybreeze Holiday Resort, kami persembahkan tarian penyambutan untukmu. Bersinarlah! Pipilpan Idol!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780106,
					"content": "Ah! Kalimat ini lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Iya, ini aku, Chiton. Hehe, sudah lama tidak jumpa, aku datang lagi! Kak {NICKNAME} dan Kak Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780108,
					"content": "Ter-Ternyata kamu, \"Chiton\". Pamon kira bertemu orang yang mengerikan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Apa ada sesuatu yang menarik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, aku kasih tahu kalian, ayahku bakal melatihku sendiri supaya aku bisa jadi seorang aktris yang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780112,
					"content": "Mulutnya saja galak, tapi sebenarnya dia perhatian banget sama kamu! Cuma bakal lebih bagus lagi kalau dia enggak ngajarin yang aneh-aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Oh ya, ini untuk kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780114,
					"content": "I-Ini baju pertunjukanmu? Tapi kalau enggak ada ini, kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Hehe, tenang saja. Ayah sudah buatkan kostum yang lebih cocok dengan tubuhku! Kali ini aku pasti tidak akan jatuh lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780116,
					"content": "Anggap saja kostum lamaku ini sebagai kenang-kenangan! Terimalah, anggap itu sebagai simbol persahabatan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780117,
					"content": "Saat kita bertemu lagi nanti, aku akan pakai kostum baru dan menampilkan tarian penyambutan untuk kalian! Jadi datang lagi ya, akan kutunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780118,
					"content": "Ya, kami pasti datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Chiton\"! Waktunya untuk latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Baiklah, waktunya latihan otot! Kak {NICKNAME} dan Kak Paimon, sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780121,
					"content": "Ya, sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Kamu benaran akan pergi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Pasti! Tentu saja ... akan lebih baik lagi kalau bisa nonton pertunjukan \"idola\" biasa pada saat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Gimana kabarmu akhir-akhir ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}