			"dialogs": [
				{
					"id": 700920201,
					"content": "Selamat datang di tempat paling dramatis di Teyvat, Opera Epiclese ... yang terbuat dari sihir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920202
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920202,
					"content": "Topik kali ini adalah \"debat\", makanya aku sengaja membuat ruangan sihir seperti ini. Lumayan, kan? Dramatis sekali kesannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920203
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920203,
					"content": "Berdebat? Terakhir kali kamu kalah lawan aku. Masih mau permalukan diri sendiri lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920204
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920204,
					"content": "Hehe ... kamu menunjukkan kebijaksanaan anak 16 tahun dalam perdebatan yang seharusnya untuk anak 12 tahun, mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920205
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920205,
					"content": "Mengingat kamu suka membantah ... jadi kali ini aku sudah siapkan topik yang tidak bisa dibantah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920206,
						700920207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920206,
					"content": "Permisi, maaf mengganggu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				},
				{
					"id": 700920208,
					"content": "Debat yang seru membutuhkan juri yang adil dan objektif. Di antara kita semua, kamu paling cocok. Kurasa tidak ada yang keberatan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920209,
					"content": "Terus, kalau Paimon di sana",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920210
					]
				},
				{
					"id": 700920210,
					"content": "Sebenarnya aku sudah mau bilang dari tadi, Paimon di kursi VIP di atas sudah berpose dari tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920211,
						700920212
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920211,
					"content": "Kalimat itu terdengar familier ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920213,
					"content": "Hehe ... Paimon barusan diteleportasi ke sini, jadi mikirnya pengen coba niru temen kita! Paimon kan bintang besar di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920214,
					"content": "Seingatku Paimon suka yang heboh, kan? Kursi penonton ini pandangannya paling bagus. Gimana? Paimon puas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920215
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920215,
					"content": "Ohh ... ternyata pemandangannya kayak gini ya. Eh, tapi Paimon boleh duduk di sini buat nonton? Kayaknya terlalu berlebihan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920216,
					"content": "Tenang saja, ini ruang yang dibuat pakai sihir, jadi semua tunduk kepadaku. Tidak bakal ada penjaga yang masuk dan menangkap kalian kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920217
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920217,
					"content": "Dan untuk temanku Paimon yang duduk di puncak gunung, apa kamu puas dengan kursi tamu VIP ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920218
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920218,
					"content": "Ke-keren banget! Mantap ... ini pertama kalinya Paimon duduk di tempat kayak gini, sampai Paimon kehabisan kata-kata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920219,
					"content": "Kalau begitu, biasakan dirimu ya. Soalnya nanti ada banyak momen seru yang perlu sorakan dan tepuk tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920220
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920220,
					"content": "Sudah, jangan buang waktu lagi. Ayo cepat selesaikan, keluarkan pertanyaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920221
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920221,
					"content": "Klee itu anak yang nakal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920222,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920224,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920225
					]
				},
				{
					"id": 700920225,
					"content": "Ini argumen yang harus dibantah. Kalau kamu bisa membuktikan bahwa \"Klee bukan anak nakal\", aku akan kasih hadiah kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920226
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920226,
					"content": "Siapa yang mau hadiahmu? Klee itu kan anak kandungmu sendiri, kok keluarin pertanyaan kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920227
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920227,
					"content": "Kamu ... perempuan licik! Benar-benar keterlaluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920228
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920228,
					"content": "Hehe, seperti kata pepatah, \"Buah jatuh tidak jauh dari pohonnya\". Kalau kamu sudah yakin aku ini orang jahat, ya berarti anak orang jahat juga pasti anak yang jahat, kan? Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920229
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920229,
					"content": "Keberatan! Kebodohan hakiki. Kepribadian dan tindakanmu memang buruk, tapi tidak ada bukti ilmiah yang membuktikan bahwa hal seperti itu bisa diwariskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920230
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920230,
					"content": "Lagian, dibandingkan warisan, lingkungan bertumbuh lebih penting. Orang-orang Mondstadt jauh lebih bisa diandalkan darimu dalam mengurus Klee. Klee tidak bakal jadi jahat kalau ada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920231
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920231,
					"content": "Tapi faktanya, Klee suka mengebom ikan, dan itu bukti kuat kalau dia anak nakal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920232,
					"content": "I-ini adalah sifat anak-anak polos yang belum bisa membedakan baik dan buruk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920233
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920233,
					"content": "Kapal-kapal di pelabuhan juga sering menangkap ikan, jadi Klee mana bisa membedakan kenapa boleh menangkap ikan boleh, tapi tak boleh mengebom ikan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920234
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920234,
					"content": "Tapi ya,  berapa kali pun Klee dikurung, tetap saja tidak berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920235,
					"content": "Faktanya Klee selalu mau menjalani hukumannya dengan baik, itu sudah membuktikan kalau dia mengaku kesalahan dan tidak pernah lari dari tanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920236
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920236,
					"content": "Kita tidak boleh menuduh Klee sebagai anak nakal setelah dia menanggung konsekuensinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920237
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920237,
					"content": "Lagian, setelah selesai menjalani hukuman sebelumnya, Klee memang bilang mau menangkap ikan dengan bom, tapi dia tidak pernah melakukannya \"sesuka hati\", sekali pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920238
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920238,
					"content": "Tindakannya akhir-akhir ini semuanya karena \"dihasut\" dan \"dibiarkan\" oleh orang yang dia percaya. Orang itu ibunya sendiri yang \"kacau\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920239
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920239,
					"content": "Mhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920240,
					"content": "Pada akhirnya, yang paling pantas dianggap sebagai anak nakal itu kamu! Eh, bukan, orang dewasa yang nakal! Eh tidak juga, mana ada orang dewasa yang sekekanak-kanakan ini, anak dewasa yang nakal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920241
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920241,
					"content": "Mamam tuh debat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920242
					]
				},
				{
					"id": 700920242,
					"content": "Kedengarannya keren banget ... serangan bagus! Terus gimana lawan debatnya bakal menjawab?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920243,
					"content": "Meskipun begitu, itu hanya bisa membuktikan kalau Klee secara subjektif tidak punya niat jahat. Tapi sayangnya, itu tidak bisa jadi alasan buat semua orang berpikir kalau Klee bukan anak nakal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920244
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920244,
					"content": "Masih ngotot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920245
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920245,
					"content": "Kalau begitu, dengarkan baik-baik, ini yang tidak akan pernah bisa kamu bantah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920246
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920246,
					"content": "Karena Klee sangat lucu, semua orang pasti memaafkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920247
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920247,
					"content": "Rasain lu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920248
					]
				},
				{
					"id": 700920248,
					"content": "Bener! Klee kan imut banget, bikin kesalahan kecil saja kok, terus kenapa? Lagian di mata Paimon, dia enggak jahat kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920249,
					"content": "Kelebihannya lebih banyak daripada yang sudah kamu bilang. Dia mau berbagi mainannya dengan orang lain. Kalau dia lagi mau main tapi semua orang lagi sibuk, dia akan menunggu dengan manis di samping ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920250
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920250,
					"content": "Yang paling penting, dia baik sekali dengan semua orang. Di matanya, semua orang itu orang baik, termasuk aku yang menganggap ibunya sebagai musuh bebuyutan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920251
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920251,
					"content": "Intinya, anak selucu itu, aku tidak akan membiarkanmu mengatakan dia anak jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920252
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920252,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920253,
					"content": "Oke oke, aku menyerah! Sebagai ibu, mana mungkin aku tidak setuju sama pernyataan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920254,
					"content": "Dan akhirnya aku mendengar kata-kata itu dari mulutmu sendiri. Kayaknya kamu benar-benar menganggap Klee sebagai teman baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920255,
					"content": "Putriku lucu sekail, kan? Sudah kubilang, kalau kamu berteman dengannya, kamu juga pasti merasa senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920256
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920256,
					"content": "Kok jadi bangga sih? Jadi aku jauh-jauh datang ke Mondstadt itu karena keisenganmu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920257
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920257,
					"content": "Hehe. Karena Klee punya teman baik sepertimu, aku bisa jadi lebih tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920258
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920258,
					"content": "Aku tidak sabar lihat perkembangan kalian. Kamu juga tidak bisa membayangkan kalau Klee masih suka mengebom ikan di umurku sekarang, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920259,
					"content": "Tunggu, jangan-jangan kamu mau bilang sesuatu yang super norak, seperti \"tantangan ini sebenarnya menguji ketulusan persahabatanmu terhadap Klee\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920260
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920260,
					"content": "Pintar juga. Kalau begitu, langsung saja ke pengumuman hasil tantangannya. Sekarang dipersilakan kepada para juri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920261,
					"content": "Uhuk uhuk, \"Ujian Tantangan Penyihir untuk Prune kecil ... lulus! Berikut adalah berkah dari sang penyihir\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920262
					]
				},
				{
					"id": 700920262,
					"content": "\"Semoga kamu seperti Klee, sehat, kenyang, jarang punya masalah, dan jadi anak yang bahagia.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920263
					]
				},
				{
					"id": 700920263,
					"content": "Kamu dan Klee sama-sama anak baik, jadi kalau sesekali bikin salah atau ngambek, itu masih bisa diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920264,
					"content": "Te-terima kasih? Tapi itu kan sudah topik berbeda, sudah berapa kali kubilang jangan perlakukan aku kayak anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920265
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920265,
					"content": "Jangan lupa, aku ini Pemburu Penyihir, aku tidak bakal berdamai denganmu, mimpi kali ye! Kamu sudah kalah, jadi tunjukkan dirimu, jangan coba-coba bohongi aku dengan boneka besar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920266
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920266,
					"content": "Hari ini seru sekali, lain kali kalau punya waktu, aku main lagi. Dadah~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920267
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920267,
					"content": "Hei, aku lagi ngomong, dengar tidak? Jangan kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920212,
					"content": "Begitu juga dengan adegan ini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920207,
					"content": "Apa aku cocok di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				}
			]
		},
