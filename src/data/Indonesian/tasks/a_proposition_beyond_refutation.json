			"dialogs": [
				{
					"id": 700920301,
					"content": "Semuanya lenyap begitu saja ... ini sih gaya khas Alice banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920302,
					"content": "Sialan. Aku pasti akan menemukanmu!",
					"roleType": "TALK_ROLE_NPC",
