			"dialogs": [
				{
					"id": 700920101,
					"content": "Daripada dibilang tugas, ini lebih mirip surat tantangan untuk Prune ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920102,
					"content": "\"Hehehe, pemburu penyihir cilik, sudah kepikiran cara mengalahkanku? Teriakkan deklarasi tantanganmu yang paling keren, dan siap-siap tunduk di hadapan Raja Dodo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920103,
					"content": "Gaya ngomongnya ... ini pasti Alice deh. Kalau enggak ditulis \"Pemburu Penyihir\", Paimon bakal kira ini surat buat Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920104,
					"content": "Prune kan musuhan sama Alice, kalau dia diprovokasi begini, bakal kesal enggak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920105,
					"content": "Jelas sekali Alice sengaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920106
					]
				},
				{
					"id": 700920106,
					"content": "Gimana kalau kita ngomong sama Prune tapi pakai cara yang lebih lembut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920107,
					"content": "Mau kasih tahu apa? Sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920108
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920108,
					"content": "Kaget banget! Jangan emosi dulu dong, dengerin Paimon dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920109,
					"content": "... Membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920110
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920110,
					"content": "Eh? Kok tenang banget sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920111,
					"content": "Hah. Aku sudah sering lihat trik kekanak-kanakan seperti itu. Sok misterius itu biasanya untuk anak-anak saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920112
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920112,
					"content": "Siapa yang bakal \"mengumumkan dengan lantang\" di jalan? Pejalan kaki bakal kebingungan. Aku tidak akan tertipu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920113
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920113,
					"content": "Itu sama saja kayak teriak di jalan: Aku bodoh banget lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920114
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920114,
					"content": "Aku bodoh banget lho! Aku bodoh banget lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920115
					],
					"speakerTitle": "Fonograf"
				},
				{
					"id": 700920115,
					"content": "A-apa?! Kenapa suaraku keluar dari situ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920116
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920116,
					"content": "Siapa? Siapa yang bicara? Haha, siapa yang bodoh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920117
					],
					"speakerTitle": "Orang yang Tidak Peka"
				},
				{
					"id": 700920117,
					"content": "Ada orang yang bilang dirinya sendiri bodoh banget, hahaha, pasti kalah main game ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920118
					],
					"speakerTitle": "Orang yang Kepo"
				},
				{
					"id": 700920118,
					"content": "Pasti ulah anak kecil yang nakal. Kayaknya ada bocah yang tertipu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920119
					],
					"speakerTitle": "Orang yang Rasional"
				},
				{
					"id": 700920119,
					"content": "Sialan ... cepat hentikan, jangan teriak lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920120
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920120,
					"content": "Aku bodoh banget lho! Aku bodoh banget lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920121
					],
					"speakerTitle": "Fonograf"
				},
				{
					"id": 700920121,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920122
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920122,
					"content": "Tenang dulu Prune! Jangan pakai kekerasan dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920123,
						700920124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700920123,
					"content": "Hentikan, Prune ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				},
				{
					"id": 700920125,
					"content": "A ... lice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920126
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920126,
					"content": "Hai, hai semua. Aduh~ Tidak kusangka deklarasi seperti ini menarik banget. Selamat, kamu sukses membuka tantangan topik para penyihir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920127
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920127,
					"content": "Aku sudah siapkan ruang sihir yang super keren untuk tantangan kali ini, tapi butuh waktu untuk memuat sihirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920128
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920128,
					"content": "Jadi dari tadi aku sudah kepikiran, kenapa tidak buat deklarasi tantangan jadi suara memuat halaman saja? Terus diputar terus untuk menyemangati kamu. Gimana, suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920129
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920129,
					"content": "Aku bodoh banget lho! Aku bodoh banget lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920130
					],
					"speakerTitle": "Fonograf"
				},
				{
					"id": 700920130,
					"content": "Tidak, ini bukan deklarasi, cepat matikan efek suara rusak ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920131
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920131,
					"content": "Sepertinya ada salah paham, tapi efek suaranya dan tantangan sihir itu satu paket, kalau ditarik balik berarti menyerah sama tantangannya dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920132
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920132,
					"content": "Serius? Yakin? Kalau gitu, sampai jumpa  ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920133
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920133,
					"content": "Ja-jangan pergi! Aku sudah susah payah menangkapmu. Argh ... berapa lama lagi kamu mau sihir sialan itu dimuat???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920134
					],
					"speakerTitle": "Prune"
				},
				{
					"id": 700920134,
					"content": "Lah, sudah dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700920124,
					"content": "Ada banyak fonograf di sini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				}
			]
		},
