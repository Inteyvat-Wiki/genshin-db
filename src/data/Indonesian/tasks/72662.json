					"Kujirai Momiji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "Lihat! Aku membolak-balik buku catatan pelayaran ayah berkali-kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620102,
					"content": "Di dalamnya ada lampiran yang menyebut resep umpan spesial yang pernah mereka buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620103,
					"content": "Lunar Leviathan yang mereka lihat saat itu, ditangkap menggunakan umpan spesial yang terbuat dari campuran Seagrass dan Magical Crystal Ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620104,
					"content": "Kalau kita bisa membuat umpan ini, mungkin kita bisa memancing Lunar Leviathan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620105,
					"content": "Aku punya banyak Seagrass, tapi kalau Magical Crystal Ore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620106,
					"content": "Jangan khawatir, aku punya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "Eh? Benarkah? Kamu ambil dari Araumi, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620108,
					"content": "Catatan ayah menyebutkan kalau Magical Crystal Ore yang digunakan harus digali dari reruntuhan di Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620109,
					"content": "Meski aku tidak tahu apa bedanya dengan Magical Crystal Ore yang biasa, tapi karena sudah ditentukan begitu, kita lebih baik melakukannya dan mengikuti aturan tertulis dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620110,
					"content": "Dipikir-pikir, banyak monster berkeliaran di Araumi. Situasi di sana cukup berbahaya. Ayo kita ajukan permohonan misi di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620111,
					"content": "Tidak usah, biar aku saja yang bereskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "Oh iya, aku sampai lupa kalau kamu adalah petualang yang kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620113,
					"content": "Aku sangat beruntung bisa mendapat bantuanmu. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620114,
					"content": "Aku akan pulang dulu untuk mengambil alat pembuat umpan. Nanti kita bertemu di sisi barat pantai Araumi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
