			"dialogs": [
				{
					"id": 726620301,
					"content": "Ke-kenapa bisa begini? Bahkan resep umpan dari ayah juga tidak berguna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Jangan sedih dulu, ini gara-gara si Ruin Guard itu! Pasti dia yang membuat \"Lunar Leviathan\" kabur! Kita coba lagi saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Iya, kita coba lagi saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Lebih baik kita sudahi saja. Aku sudah lelah. Mungkin kata Nantuck itu benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "*huff* Aku mau pergi berjalan-jalan dulu. Aku harus memikirkan apa yang akan kulakukan selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Ini imbalan kalian. Biar bagaimanapun, terima kasih banyak atas bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "Sepertinya Nona Kujirai sedang ingin sendiri, nanti kita kunjungi dia lagi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
