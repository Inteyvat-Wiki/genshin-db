			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "Sudah ditemukan? Cepat sekali? Kamu memang pantas menjadi petualang kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620202,
					"content": "Segini cukup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Iya, serahkan saja sisanya padaku. Asalkan begini... begini... lalu begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620204,
					"content": "Selesai deh, sudah jadi umpannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620205,
					"content": "Langkah selanjutnya adalah melempar umpan ke laut, lalu menunggu \"Lunar Leviathan\" muncul, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620206,
					"content": "Iya, aku sengaja memilih tempat ini karena waktu itu kami mendarat di tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620207,
					"content": "Lunar Leviathan yang menuntun kami pulang juga menghilang di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620208,
					"content": "Jadi kalian sudah siap belum? Jangan lupa untuk memohon permohonan saat melihat Lunar Leviathan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620209,
					"content": "Bagaimana kalau kita gagal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620211,
					"content": "Jangan berkata hal buruk seperti itu. Kita pasti akan berhasil. Lunar Leviathan pasti akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620212,
					"content": "Iya! Kita pasti berhasil! Wahai ikan raksasa, kamu harus makan umpannya ya! Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620213,
					"content": "Kalian lihat! Cepat lihat! Ada sesuatu yang bersinar di bawah permukaan air! Ada sesuatu yang menuju kemari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620214,
					"content": "Benarkah? Apa \"Lunar Leviathan\" benar-benar ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620215,
					"content": "Tolong, ada Ruin Guard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620216,
					"content": "Kenapa malah monster ini yang datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
