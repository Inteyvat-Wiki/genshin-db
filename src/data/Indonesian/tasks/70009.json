			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "Kenapa Tuan Fatooey tidak bisa merayakan Festival Weedplume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090202,
					"content": "Dia punya urusan penting yang harus dilakukan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Urusan penting? Bahkan lebih penting dari Festival Weedplume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090207,
					"content": "Tapi kalau Fatooey telah melakukan banyak hal buruk, dia bisa menjadi orang baik lagi kan kalau dia mau berubah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090208,
					"content": "Aku akan memintanya jadi orang baik saja biar dia bisa ikut merayakan Festival Weedplume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090209,
					"content": "Pria itu sangat sibuk sekarang. Ayo kita keluar dan main bersama, oke?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "Oh... oke. Kalau begitu kakak bisa membawaku keluar untuk bersenang-senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090211,
					"content": "Tentu bisa, cuma... jangan main terlalu jauh, oke?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Hore! Ayo pergi, ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090204,
					"content": "Kurasa Fatui tidak bisa ambil bagian dalam Festival Windblume.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Kenapa tidak? Apa karena Fatooey jahat? Mereka orang jahat? Papa bilang mereka tidak sikat gigi sebelum tidur dan makan pakai tangan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090206,
					"content": "Hmm... kalau mereka adalah orang jahat, pasti papa Fatooey akan sangat marah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "Pengembara? Kamu ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Dan juga... Lily? Kenapa kamu bisa ada di sini? Mana papa mama kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "Papa mama punya urusan penting yang harus dilakukan! Jadi kakak ini mengajakku bermain deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090305,
					"content": "Sesuatu yang sangat penting? Ah, Rudolf dan Jilliana, benar-benar deh mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090306,
					"content": "Kakak, apa yang terjadi dengan anak-anak anjing tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090307,
					"content": "Oh, anak-anak anjing tadi? Umm, entahlah. Mereka biasanya bersembunyi di sarangnya dan hanya muncul saat aku memberi makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090308,
					"content": "Mungkin karena kota ini begitu ramai sekarang, jadi mereka pun keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090309,
					"content": "Kamu ingin bermain dengan mereka, Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090310,
					"content": "Iya! Mau dong! Aku mau main dengan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090311,
					"content": "Hmm... coba kupikir ya, kurasa percuma juga mencari mereka. Mungkin kalau kamu meletakkan makanan di mangkuk makanan sana akan menarik perhatian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Blanche"
				},
				{
