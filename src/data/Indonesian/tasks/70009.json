			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Tuan, apakah Fatooey tidak ikut merayakan Festival Weedplume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090102,
					"content": "Aku, uh, mungkin tidak akan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090103,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Siapa? Aku? Oh, kamu lagi. Ayolah, kenapa kamu menatapku dengan penuh curiga lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090105,
					"content": "Aku baru saja bicara dengan anak itu, sama sekali tidak melakukan hal buruk kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090106,
					"content": "Sepertinya orang-orang Fatui benar-benar tidak merayakan Festival Windblume.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "Tunggu, bagaimana denganmu? Apa tuan juga tidak akan merayakan Festival Weedplume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090108,
					"content": "Yah, aku yakin Honorary Knight-nya Mondstadt punya banyak tugas yang harus dilakukan selama Festival Windblume. Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090109,
					"content": "Bukankah seseorang terlihat sombong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "*ehem* Bukan apa-apa kok, lupakan saja. Kalau kamu menganggur, kenapa tidak datang dan bantu aku melakukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090111,
					"content": "Orang tua anak ini pergi berbelanja di tengah festival, jadi dia ditinggalkan di sini dan meminta para suster yang menemaninya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090112,
					"content": "Tapi seperti yang kamu tahu, semua orang punya kesibukannya masing-masing karena festival ini, termasuk para suster. Mereka tidak punya waktu untuk bermain dengan gadis itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090113,
					"content": "Makanya dia menempel padaku, tapi seperti yang kamu tahu juga, aku tidak bisa meninggalkan Katedral begitu saja, paling aku cuma bisa menemaninya mengobrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090114,
					"content": "Sungguh memalukan, bahkan dalam hal ini aku harus menahan malu karena tatapan dari suster yang di sana itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090115,
					"content": "Kujamin dia pasti sedang berpikir, \"Oh, apa yang ada di pikiran Fatui jahat itu kali ini\" atau sesuatu semacamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090116,
					"content": "Hmm, jadi agar suster itu tidak menghampiriku dan demi kebaikan psikologis anak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090117,
					"content": "Mungkinkah Honorary Knight kita yang berhati mulia berkenan membawa anak ini keluar untuk bermain bersamanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090118,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "Oh ho, mudah sekali. Memang pantas jadi Honorary Knight! Konyolnya aku berpikiran kamu akan tawar-menawar imbalannya denganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090120,
					"content": "Ayo cepat bawa anak ini keluar untuk bermain, aku akan berada di sini dan menunggu. Sambil terus ditatap oleh para suster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090121,
					"content": "*huff* Sampai kapan hari-hari seperti ini akan berakhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090122,
					"content": "Ah, kamu cuma mau dia bisa pergi keluar dan bersenang-senang, bukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Kamu... argh, sudahlah. Aku adalah Fatui, kami ini penjahat, paham? Tidak ada hati nurani dalam darah daging kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090124,
					"content": "Ups, tidak apa-apa, cepat bawa anak ini keluar dan bermain bersamanya. Dia benar-benar telah merepotkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090125,
					"content": "Sedangkan aku... aku akan tinggal di sini, menanti tatapan dari para suster itu bisa menembus tulangku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090126,
					"content": "*huff* Sampai kapan hari-hari seperti ini akan berakhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
