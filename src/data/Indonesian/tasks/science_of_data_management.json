					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Harusnya cukup deh, semoga material-material ini bisa berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Kamu sedang merapikan dokumen-dokumen ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "Oh! Senang bisa bertemu denganmu, Peneliti Honoris Tingkat Lanjutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Benar sekali! Aku sedang lanjut merapikan dokumen dan berkas-berkasnya menurut perintah Monsieur Raimondo ... Tunggu, apa aku sudah pernah bilang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Tapi tempat ini kan gede banget! Kalau satu orang sih enggak bakal selesai-selesai. Kenapa Raimondo enggak cari orang lagi buat bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "Sekarang Institut Penelitian sedang sibuk dengan urusan lain. Wajar kalau tidak ada yang sempat membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Tapi kamu kan seorang Penanggung Jawab ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Oh, maksudmu jabatanku sebagai Penanggung Jawab Tim Pengumpulan Material Institut Penelitian Fontaine? Huh, jangan menertawakanku ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "Apanya yang Penanggung Jawab? Dari awal sudah ketahuan kalau aku ini sama seperti admin biasa yang kerjanya merapikan berkas saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Setelah Monsieur Raimondo menempatkanku di sini untuk merapikan berkas-berkas, baru aku diberi tahu soal jabatan baruku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Ada yang bilang kalau ini ide dari Monsieur Choiseul. Karena dia merasa pekerjaan kami keras, jadi akan lebih mudah memberikan kompensasi lebih nantinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ah! Jangan bilang siapa-siapa ya, aduh kok ... aku malah sembarangan cerita sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Tenang, aku bisa jaga rahasia kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Tapi itu kedengarannya bagus kok?! Karena adil dong kalau yang kerjanya banyak dapat kompensasi lebih banyak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Tapi kenapa caranya ribet begitu ya? Kenapa enggak langsung aja kasih semua orang Mora lebih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "Cara begitu sudah sering dipakai di Institut Penelitian sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "*huff* Aku benar-benar tidak bisa menebak apa yang ada di pikiran Monsieur Choiseul dan Raimondo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Tapi bagaimanapun juga aku harus tetap bekerja! Banyak sekali yang harus diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "Peneliti Honoris Tingkat Lanjutan, kalau tidak keberatan, apa mau membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "Itu sudah tugasku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Kalau begitu, tolong bantu aku bersihkan kotoran-kotoran yang ada di sekitar sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Waktu bersih-bersih, pastikan kamu <color=#00E1FFFF>tidak menyentuh berkas dan buku di sekitar</color> ya. Bakal gawat kalau sampai rusak gara-gara bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Kuserahkan padamu ya! Aku sendiri akan tetap merapikan berkas-berkas di sebelah sini. *huff* Aku tak pernah perhatikan kalau ada banyak sekali dokumen di institut ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Jangan lupa gelar \"honoris\"-nya dibikin lebih terhormat lagi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Hahaha, gampang! Nanti aku jadi saksi untuk kebaikan dan kontribusimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Pokoknya yang paling penting masih dapat uangnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
