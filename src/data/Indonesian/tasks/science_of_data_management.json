			"dialogs": [
				{
					"id": 240160401,
					"content": "Fiuh ... terima kasih ya. Kalau tidak ada kalian, entah sampai kapan aku akan ada di sini terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Yah, kalau kamu bersih-bersihnya lebih hati-hati sih ... bagus juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Maaf ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Jangan salah paham! Aku bukan menyalahkanmu, kamu sudah banyak sekali membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "Ini untukmu. Terima kasih banyak atas bantuanmu, Peneliti Honoris Tingkat Lanjutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "Lain kali aku lebih hati-hati deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
