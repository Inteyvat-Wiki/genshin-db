			"dialogs": [
				{
					"id": 240160301,
					"content": "Fiuh ... terima kasih ya. Kalau tidak ada kalian, entah sampai kapan aku akan ada di sini terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "Kamu memang pantas disebut Peneliti Honoris Tingkat Lanjutan. Apa pun itu, semua kalian selesaikan dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "Yah, aku memang luar biasa dari dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "Terima kasih sekali lagi ya, Peneliti Honoris Tingkat Lanjutan. Silakan ambil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Aku sudah berpengalaman di industri bersih-bersih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "Eh? Berarti kamu memang benar-benar multitalenta dan pantas menyandang gelar Peneliti Honoris Tingkat Lanjutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
