				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Hah? Paimon kok ngerasa ada kolam tambahan di sini? Maksud tulisannya apa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "\"Bahaya — Jauhi!\" Maksudnya gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Ya seperti yang tertulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010104,
					"content": "Wah! Sandrone. Bikin Paimon kaget saja! Apa kamu yang taruh tanda ini di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Iya. Supaya bisa menghentikan orang-orang yang penasaran agar tidak jatuh ke dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010106,
					"content": "Memangnya kolamnya kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Isinya piranha semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010108,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, cuma bercanda saja kok. Kalian benar-benar percaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010110,
					"content": "Aku baru tahu kalau ada ikan di akuarium sangat suka wilayah dan bisa jadi agresif. Jadi, aku pindahkan mereka ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010111,
					"content": "Jangan buat Paimon kaget begitu dong! Jadi, tempat ini kayak zona karantina khusus buat ikan-ikan yang agresif gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Tepat sekali, air di kolam ini jauh lebih dalam, ruangnya juga jauh lebih luas. Ini bisa membantu menenangkan ikan-ikan yang lebih suka wilayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010113,
					"content": "Aku juga sudah minta Sigewinne di Benteng Meropide untuk umpan khusus, supaya mereka bisa lebih tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010114,
					"content": "Oh, wah ... Jadi, kamu peduli banget sama kesejahteraan ikan-ikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Aku rasa tidak ada yang mau lihat akuarium berubah jadi lautan darah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010116,
					"content": "Pasti dong! Oh ya, kenapa enggak serahkan ke Paimon saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Silakan saja. Kalau ikan-ikan di kolam sudah cukup nyaman berenang ke permukaan, berarti mereka sudah mulai membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010118,
					"content": "Jadi begitu mereka sudah santai dan bahagia, kita masukkan kembali ke akuarium?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Terserah kalian mau taruh di mana. Tugasku cuma menangkap yang nakal dan pindahkan ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010120,
					"content": "Oke! Tapi papan peringatannya ngeri banget. Bisa diganti dengan yang lebih ... enggak seram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Hmm ... Kalau mau. Ikan-ikan ini milikmu, jadi keputusannya terserah kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}