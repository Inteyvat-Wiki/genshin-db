			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "Itu Arama dan Nara Emas, kamu sangat tinggi. Tapi warna perak di samping ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hmm? Kenapa dengan warna perak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Gimana ya ... pasti bisa masuk ke lubang pohon yang sempit kan, pasti praktis! Bagus bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Hmm! Seharusnya memperkenalkan diri dulu sesuai dengan budaya Nara. Ini adalah Nara {NICKNAME} dan Paimon, ini adalah Arakavi. Silakan jabat tangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "Kalian berjabatan tangan dengan Arakavi ....\\nBerjabatan tangan dilakukan dengan pelan-pelan saja.\\nRasa saat menyentuhnya sedikit spesial.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Menarik ya. Dulu aku pernah mendengar banyak cerita tentang Nara dari yang lain, tapi ini pertama kalinya bertemu langsung dengan Nara. Rasanya luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "Terakhir kali Nara datang ke sini sudah sangat lama. Banyak benih yang sudah tumbuh menjadi pohon, banyak cerita yang menjadi legenda. Dengar-dengar, dia adalah Nara yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} juga Nara yang baik, berani dan kuat, seperti pohon yang tumbuh di antara bebatuan. Dan mereka datang karena mau membantu Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Oh, Arana ya ... sudah lama tidak bertemu dia, semoga semuanya baik-baik saja. Semoga Nara di Desa Vimara baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Kamu juga kenal anak-anak di Desa Vimara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Tentu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Kami semua kenal! Arana selalu menceritakan cerita tentang Nara kecil waktu dia pulang. Jadi, Nara Iotham, Nara Bahram, dan Narana adalah teman Nara kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Ini enggak termasuk kenal lah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Jadi gimana baru bisa dibilang kenal? Harus seperti Nara yang sudah \"berkenalan\" dan \"jabat tangan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Hmm, aku paham yang Paimon katakan. Nara harus makan bersama, mencari \"harta karun\" bersama baru termasuk kenal, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "Enggak sesimpel itu juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Asal tahu ceritanya, sudah termasuk kenal. Karena dunia Arana adalah dunia musik, dunia mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Hmm, yang dibilang Arakavi benar. Bagi Aranara, selama bisa mendengarkan lagu yang mendeskripsikan Nara {NICKNAME}, bertemu Nara {NICKNAME} melalui mimpi, itu sudah termasuk kenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon rasa hal ini nanti lagi kita bicarakannya yuk ... intinya kan kita semua sekarang sudah berteman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Teman baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama dan Arakavi"
				},
				{
					"id": 730810325,
					"content": "Teman baik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Ya, kita mau mengadakan Festival Utsava, Arakavi harus siap-siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Oh gitu. Semua demi Bija? Aku sudah menyuruh Arayasa, Aradasa, dan Arasudraka mencari \"Ashvattha's Concourse\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Tebakanmu tepat ... tapi, kenapa kalian enggak tahu keberadaan Ashvattha's Concourse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Ashvattha's Concourse adalah tempat yang suci dan sakral, kita biasanya tidak akan pergi ke sana. Biarkan Pohon Vasara tidur dalam mimpinya dengan tenang. Hingga semua ingatan berkumpul di Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "Hutan akan selalu mengingat segalanya. Semua ingatan indah tidak akan hilang. Semua ingatan menyedihkan akan menjadi makanan bagi hal-hal yang baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Omong-omong, kamu bisa menemukan Arayasa, Aradasa dan Arasudraka sedang mencari Ashvattha's Concourse di luar sana. Arama, kamu pergi dan tolong mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Ya. Aku akan pergi. Kalau Nara {NICKNAME} dan Paimon bertemu dengan kami di hutan, ayo kita bertualang bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Bagus bagus. Senang berkenalan dengan kalian, Nara {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Kita bicarakan hal penting dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Gimana ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Aku dan Paimon makan bersama, mencari harta karun bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Ya! Kami bukan cuma kenal, tapi sudah jadi teman baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Nara {NICKNAME} dan Paimon, bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
