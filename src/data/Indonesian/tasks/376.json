					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Hari ini aku mau minum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760702,
					"content": "Kembalikan botol yang kamu ambil dari belakang lemari itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760703,
					"content": "... yang dingin-dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760704,
					"content": "Sekarang, aku butuh penjelasanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760705,
					"content": "Tunggu aku habiskan dulu minumku, aku akan bayar kok ... ya, bayar dengan pertunjukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760706,
					"content": "Bukan uang yang jadi masalah, tapi sepertinya kamu masih terlalu muda untuk meminum anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760708,
					"content": "Bagaimana kalau jawab pertanyaanku dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Siapa dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "Ah, jangan khawatir, aku sudah minum anggur sejak kamu masih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760709,
					"content": "Oh, kamu mau tanya siapa dia, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760711,
					"content": "Dia adalah Tuan <color=#00E1FFFF>Diluc</color>, bos dari ... eh, pemilik dari kedai ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760712,
					"content": "Dia sangat terkenal. Dan omong-omong, Dandelion Wine buatannya adalah salah satu favoritku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760713,
					"content": "Tapi biasanya aku cuma mampu beli satu dua botol saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760714,
					"content": "Aku dengar dari penjaga, baru saja ada kasus pencurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760715,
					"content": "Omong-omong, aku sangat kagum akan keberanian kalian mencuri Holy Lyre der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760716,
					"content": "Sebodoh-bodohnya orang, tetap saja jarang sekali ada orang bodoh yang senekat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760717,
					"content": "Bukan kami pencurinya! Pencuri sebenarnya masih di luar sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3760718,
					"content": "Orang ini bintang baru di Knights of Favonius! Mana mungkin orang yang semengagumkan dia mencuri pusaka suci Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760719,
					"content": "Bintang baru ...? Ah, rupanya kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760721,
					"content": "Sebenarnya, kita tidak sedekat itu juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "Aku hanya pernah dengar nyanyiannya satu kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "Jadi, kamu dan penyair ini adalah sahabat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760723,
					"content": "Ya ... meskipun kamu hanya seorang pengembara yang kebetulan melintas, kamu tetap memberikan bantuanmu di kala Mondstadt membutuhkan pertolongan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760724,
					"content": "Sayang sekali orang sepertimu bergabung dengan Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760725,
					"content": "Knights of Favonius, ckck ... tidak pernah becus menyelesaikan masalah apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760726,
					"content": "Dan terhadap <color=#00E1FFFF>Fatui</color>, mereka lemah dan konservatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760727,
					"content": "Sudahlah, aku malas membicarakan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760728,
					"content": "Sepertinya kamu tidak suka Knights of Favonius, Tuan Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760729,
					"content": "Sebenarnya cara menyelesaikan masalah kami saja yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760730,
					"content": "Aku punya harapanku sendiri terhadap kota ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760731,
					"content": "Sekarang, jawab pertanyaanku. Kenapa kalian mencuri Holy Lyre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760732,
					"content": "Kamu yakin tetap ingin tahu? Mungkin kamu akan terlibat dengan urusan Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760733,
					"content": "Tidak masalah. Entah bagaimana aku juga sering berakhir terlibat dalam urusan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760734,
					"content": "Kalau begitu, apa kamu akan percaya kalau aku jelaskan dengan pertunjukanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760735,
					"content": "Tergantung performamu. Aku punya penilaianku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760736,
					"content": "Kalau begitu, apa aku akan dibayar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760737,
					"content": "Bayaranmu berkisar dari 5 Mora sampai sebuah Holy Lyre. Semuanya tergantung dari kisahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760738,
					"content": "Baiklah. Akan kumulai pertunjukannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760739,
					"content": "Yang baru kusaksikan ini ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760740,
					"content": "Ini adalah hal rahasia. Kenapa kamu mengizinkanku mengetahuinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760741,
					"content": "Alasannya ...? Mungkin karena arah angin sudah mulai berganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760742,
					"content": "Jadi, bagaimana menurutmu, Tuan Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760743,
					"content": "Sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760744,
					"content": "Beri aku sedikit waktu, aku akan mengatur beberapa orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760745,
					"content": "Pendatang, sebagai anggota Knights of Favonius, seharusnya kamu tidak akan dicurigai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760746,
					"content": "Di poster buron pencuri hanya ada deskripsi rambut pirang. Seharusnya kamu aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760747,
					"content": "Dan kamu penyair ... sebaiknya kamu tetap tinggal di dalam kedai ini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760748,
					"content": "Tidak masalah! Aku bisa minum sepuasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760749,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760750,
					"content": "Kalau begitu, nanti malam setelah kedai tutup, kita bertemu lagi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4820221,
					"content": "Ikuti <color=#00E1FFFF>jalur yang sudah ditandai</color> sampai ke tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}