				"points": []
			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "Tuan Diluc, ini adalah pembukuan minggu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "Hmm ... bencana kali ini benar-benar berdampak besar pada bisnis kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Ya, semoga saja masalah ini cepat berlalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Hai, kami mau duduk di meja yang ... paling tidak mencolok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "Uhm ... Di lantai dua, pelanggan lebih sedikit. Kamu bisa duduk di atas sana kalau ingin lebih privasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Tapi bukankah kamu seorang penyair? Kenapa tidak pilih duduk di depan dan tengah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "Hahaha, simpan saja bayaran pertunjukkannya untuk kesempatan selanjutnya. Kami akan pergi dulu sekarang, sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Hei, awasi mereka. Penyair itu terlihat mencurigakan, aku akan mencari tahu tentangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "Tanya siapa memangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "Para \"penjaga\" Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
