					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, Tuan Diluc. Apa Anda melihat dua pencuri di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Ada apa, kenapa kamu membawa banyak penjaga ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Tuan Diluc, apa Anda sempat mendengar? Ada dua pencuri yang sedang berusaha mencuri Holy Lyre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Oh? Aneh sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Benar, kan? Holy Lyre adalah harta karun yang dimainkan oleh Dewa Anemo itu sendiri. Warisan budaya yang begitu berharga—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Untuk apa ada orang yang mengincar benda yang tidak mungkin bisa terjual? Lebih baik mencuri dari kilang anggurku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Maaf, aku malah membicarakan hal lain. Dua orang tadi sepertinya kabur ke arah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Baik, terima kasih Tuan Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
