			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor! Dominus Cassiodor ... Apa itu Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860302,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "Ternyata benar Anda! Akhirnya Anda kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860304,
					"content": "Saya diperintahkan untuk menjaga benteng ini, tapi serangan para Vishap dan makhluk barbar terlalu ganas untuk diri ini, jadi saya terpaksa mundur sampai sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860305,
					"content": "Saya tidak tahu sudah berapa tahun yang berlalu sejak saat itu ... Bagaimana kabar di luar sana? Apa kita menang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860306,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "Begitukah? Jadi kita kalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860308,
					"content": "Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Jangan bicara seperti itu, Dominus yang terhormat. Aku sudah tahu hari ini akan tiba sejak pertama kali bergabung dengan legiun Sebastos agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860310,
					"content": "Bukankah Sebastos pernah berkata dia akan menuntun kita untuk menghancurkan belenggu \"Fortuna\"? Tapi apakah mungkin semudah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860311,
					"content": "Lagi pula adalah takdir yang kita lawan, dan menantang takdir adalah suatu hal yang bahkan tidak mampu dilawan oleh dewa sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860312,
					"content": "Pada akhirnya, semua perjuangan kita sia-sia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Sekali-kali tidak, Dominus. Kita pernah mengangkat pedang melawan takdir, pernah pula membangkang terhadap aturan langit. Nubuat itu kita lawan dengan gagah berani ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860314,
					"content": "Meski akhirnya kita gagal ... Pasti sudah ada orang yang mengkhianati kita, sehingga jalan kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860315,
					"content": "Tapi hasilnya sudah tidak penting lagi. Bagaimanapun, apa yang kita lakukan akan terukir dalam \"sejarah\" dunia ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Golem Tanpa Nama"
				},
				{
					"id": 741860316,
					"content": "Hei! Kok dia mendadak jatuh begitu? Apa manusia batu juga bisa tiba-tiba pingsan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Aku belum tahu namanya ... Sepertinya dia sudah tiba di penghujung \"sejarah\"-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Kok sedih banget! Jadi dia sudah bertempur ribuan tahun di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Tapi sekarang dia akhirnya damai dan tenang. Mari kita terus maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}