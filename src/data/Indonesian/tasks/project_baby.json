					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "Tentang kemah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "Oh begitu? Jangan-jangan binatang buas menerobos masuk ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Kalau dipikir-pikir ... kalau makanan yang aku buat dulu itu bisa memikat Fungus dan burung ... mungkin wajar saja kalau sekarang ada banyak monster yang ke sini juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Ugh ... kalau begitu sepertinya aku perlu mempertimbangkan untuk membisniskan makanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "Kalau bisnis ini bisa berhasil, seharusnya bisa menghasilkan lebih banyak uang daripada pekerjaanku sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Ah maaf, aku jadi melantur ke mana-mana, haha. Omong-omong terima kasih ya, ini imbalan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
