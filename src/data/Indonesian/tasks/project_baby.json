			},
			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah! Bukankah ini area panjat ular yang aku buat dulu? Jadi bikin nostalgia, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Apa itu area panjat ular?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "Itu adalah mainan untuk ular memanjat ke sana kemari. Kan aku juga tidak mungkin membiarkan mereka selalu menempel di badanku setiap saat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Terima kasih karena sudah menemukannya, ini imbalan untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Apa dulu aku mendesainnya seperti ini? Rasanya jadi nostalgia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
