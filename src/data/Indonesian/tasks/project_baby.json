			"dialogs": [
				{
					"id": 230040901,
					"content": "Benar! Ini barangnya! Ternyata ketinggalan di kemah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040902,
					"content": "Kok kamu bikin kemah di tengah-tengah tanaman merambat sih! Kamu enggak takut terluka saat tidur memangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040903,
					"content": "Tidak dong, kemampuan bertahan hidupku di alam liar cukup baik ... dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040904,
					"content": "Dan waktu dulu aku mendirikan kemahku itu, di sekitarnya masih belum ada terlalu banyak tanaman merambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040905,
					"content": "Apa kamu sudah lama meninggalkan hutan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Sudah lumayan lama, jelasnya berapa lama ... aku sudah tidak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040907,
					"content": "Hahaha, kemampuan membuat kemahku sudah menurun sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Perkemahan yang aku dirikan dulu, sekarang sudah hampir ditinggalkan semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "Kalau sekarang aku masih tinggal di hutan hujan, kira-kira hidupku akan seperti apa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040910,
					"content": "Maaf, aku terlalu bawel. Terimalah imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
