					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Eh? Topi-topi ini ... hahaha, dulu aku membuatnya untuk para ular. Kok aku sampai bisa menjatuhkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Dulu demi menarik perhatian anak-anak untuk menonton, aku membuat topi-topi ini untuk dipakai tiap ular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Punya Jori warna merah, punya Amum warna hijau, punya Gana warna kuning, punya Drak warna biru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Ih lucu ya! Pertunjukannya pasti mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Awalnya sih mantap-mantap saja, tapi waktu ular-ularnya membuka mulut, anak-anak pasti akan menangis hebat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Eh, lupakan, ini imbalan kalian, anggaplah sebagai sedikit rasa terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
