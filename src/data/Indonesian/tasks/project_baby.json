					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Eh? Mutiara ini ... bagaimana ... di mana kalian menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Kami nemuin ini di dalam toples yang ada di kemah. Kamu yang menjatuhkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Ini adalah barang yang aku gunakan dalam pertunjukan dulu, waktu aku memainkan suling, anak-anak akan meletakkannya di atas kepala dan mulai menari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Tapi, pertunjukan seperti itu sudah sejak dulu tidak bisa menghasilkan uang, aku juga sudah lama tidak membawakannya. Aku sama sekali tidak sadar mutiara ini hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "Bagaimanapun juga, terima kasih karena kalian sudah menemukannya, imbalan ini untuk kalian, tolong diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
