			"dialogs": [
				{
					"id": 230040701,
					"content": "Benar! Ini barangnya! Ternyata ketinggalan di kemah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "Tadinya tertimpa batu loh. Lokasi kemahnya kayaknya longsor dan barangnya jatuh agak jauh. Sebenarnya enggak gampang-gampang amat sih nemuinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "Oh ya? Kok tempat itu bisa longsor ya? Seingatku dulu aman-aman saja padahal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Oh ya! Waktu aku berkemah dulu di sana, selalu ada suara aneh di malam hari dan aku merasa ada yang menyentuh tendaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "Para ular sangat waspada, mereka selalu membangunkanku setiap saat. Tapi saat aku memeriksa keluar, aku malah tidak menemukan apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Lupakan, tidak perlu membicarakan hal itu, intinya kali ini terima kasih banyak, ini adalah imbalan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
