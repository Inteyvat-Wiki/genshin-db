						230041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041202,
					"content": "Changsheng seharusnya tidak terhitung sebagai \"peliharaan\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				},
				{
					"id": 230041204,
					"content": "Ular peliharaan juga punya makanan khusus? Bukannya mereka biasanya makan tikus dan sejenisnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041205,
					"content": "Awalnya mereka juga bisa mencari makan sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041206,
					"content": "Tapi sejak saat mereka membuat anak-anak ketakutan saat mereka sedang makan, aku jadi tidak berani membiarkan mereka pergi sendiri. Setelahnya, aku sendirilah yang menyiapkan makanan untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041207
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041207,
					"content": "Ugh ... tapi, sejak aku memberikan mereka makanan, mereka mulai malas mencari makan. Mereka bahkan sama sekali tidak memakan makanan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041208,
					"content": "Huh ... Paimon pikir, \"enggak usah kerja tapi bisa dapat makan\" itu tadinya enggak nyata, ternyata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041209,
					"content": "Enak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "Paimon belum tanya rasanya loh, jangan berharap, kamu enggak akan punya kesempatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041212,
					"content": "Kalau urusan makan-makan begitu sih bagiannya Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041213,
					"content": "Kalau makan saja maju nomor satu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "Aku pasti menjatuhkan makanan di sekitar perkemahan saat sedang mencari tanaman obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041215,
					"content": "Tapi aku juga tidak bisa pergi mencari sendiri, aku harus menjaga mereka di sini supaya mereka tidak keluar karena lapar dan menakuti orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041216,
					"content": "Pengembara, apa kamu bisa membantuku mencari makanan yang terjatuh itu dan membawanya kembali ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041217,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "Terima kasih banyak, kalau aku membawa mereka untuk pergi mencari, aku tidak tahu akan terjadi hal apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041219,
					"content": "Kalau mereka tertarik untuk pergi bermain di hutan selama beberapa hari, itu akan sangat gawat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041225,
					"content": "Intinya, hal ini kuserahkan padamu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041226,
					"content": "Aku akan menandakan lokasi perkemahan yang pernah kutinggali di petamu, tolong kamu lihat-lihat di sana ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041220,
					"content": "Di sana tidak mungkin ada ular lain, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "Tidak, tidak akan, perkemahan yang aku pilih memang jauh dari tempat berkumpulnya ular, supaya terhindar dari masalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041222,
					"content": "Ada banyak perkemahan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "Waktu aku tinggal di hutan hujan, aku mendirikan banyak perkemahan sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041224,
					"content": "Walaupun sekarang sudah tidak bekerja di hutan hujan ... aku masih sering istirahat di perkemahan saat mencari tanaman obat di hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041210,
					"content": "Enak sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "Changsheng bisa marah kalau dengar perkataanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
