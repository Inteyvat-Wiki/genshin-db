			"dialogs": [
				{
					"id": 752500101,
					"content": "Saat para turis sudah pergi sambil membawa boneka, giliran tamu-tamu tak diundang yang datang ke Taman Alpaca ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Uh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Fatui yang menjambretku kemarin! Mau apa kalian ke sini lagi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Jangan takut, biar aku yang urus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Pemimpin para Fatui itu melambaikan tangannya dan menyerahkan sebuah catatan lusuh padamu. Kamu pun membukanya dan membaca beberapa tulisan berantakan di atasnya ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Ternyata kemarin itu ... mereka masukkan tangan mereka ke tasku ... untuk membayar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "Ma-Maaf ... aku salah paham sama kalian ... Tolong maafkan aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Silakan ambil semua mainan ini! Anggap saja tanda terima kasihku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Pemimpin Fatui itu menggelengkan kepala, lalu mengangkat tiga jarinya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Baiklah, aku mengerti. Kalian memang pahlawan sejati Natlan yang sangat terpuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Kalau begitu aku akan pilih tiga mainan dengan warna yang paling cocok untuk kalian. Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
