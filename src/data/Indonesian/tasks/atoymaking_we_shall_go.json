			"dialogs": [
				{
					"id": 726940301,
					"content": "Sudah beres mengumpulkan bahannya? Bahan baku sangat berpengaruh ke pembentukan mainan, pilihnya hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
