				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "Bagaimana, sudah dapat bahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940402,
					"content": "Semuanya ada di dalam Material Collector.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Mantap, sekarang tinggal pindahkan semuanya ke mesinku yang luar biasa, yang tidak pernah gagal, dan yang satu-satunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "\"Mesin Gede\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940405,
					"content": "Iya, iya. Bahan-bahannya kita masukkan dulu ke Mesin Gede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940406,
					"content": "Bertrand menyambungkan Material Collector-nya ke Mesin Gede.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "Waw! Terus apa lagi nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940408,
					"content": "Jangan-jangan mesinnya bakalan langsung bunyi \"grudug-grudug\" terus \"duar duar jeger\", terus keluar mainan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940409,
					"content": "Hahaha, ya jelaslah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940410,
					"content": "Tidak mungkinlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940411,
					"content": "Kamu mikirnya apa sih? Ini kan baru tahap pertama dari total tiga tahap yang ada. Kita masih jauh sekali dari kata selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940412,
					"content": "Oke Paimon ngerti, berarti sekarang kita harus lanjut beresin semua prosesnya, gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940413,
					"content": "Iya. Kita harus selesaikan ketiga tahap untuk bisa mulai produksi mainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940414,
					"content": "Repot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "Dasar ya, kalian ini maunya semua serba instan. Bikin mainan itu harus sabar, semua prosesnya harus kita jalankan dengan sepenuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940417,
					"content": "Sepenuh apa? Oh Paimon tahu! Kita kan bikin mainan, artinya kita harus jalanin semua proses dengan sepenuh hati, jiwa, dan cinta kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940418,
					"content": "Betul, sepenuh hati, jiwa, dan cinta untuk Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940419,
					"content": "Yeee ... Paimon enggak mikir kayak gitu loh tadinya. Tapi Paimon juga bukannya enggak setuju juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940420,
					"content": "Woi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Hehe, Paimon cuma basa-basi doang kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940422,
					"content": "Oke Bertrand, sekarang kita ngapain? Lanjut ke tahap berikutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940423,
					"content": "Jangan rusuh. Aku kan baru beres menyesuaikan mesinnya, dan proses yang ini belum sempat diuji coba. Harus ada data dulu, apa mesinnya sudah cocok sama bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940424,
					"content": "Dan semua itu perlu waktu. Kalian tunggu ya, datang lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940415,
					"content": "Capek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
