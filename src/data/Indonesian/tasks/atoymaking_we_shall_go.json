			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "Pengembara dan Paimon! Tepat waktu sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "Tepat waktu buat apa lagi nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "Buat ambil misi! Aku baru saja mau hubungi kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "Misi yang pas ... Paimon tebak, kamu mau kami cari barang atau usir Hilichurl ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "Atau mulung sampah di genteng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "Jangan salah paham dulu. Misi ini sudah pas sekali buat kalian, dan maksudnya \"pas\" itu adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "Pekerjaan ini bukan hanya terlihat menarik, tapi juga bisa dapat gaji yang banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "Bayaran mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Menyenangkannya sih tidak penting ya, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "E-Eh, penting kok! Oke, jadi kayak apa nih misinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "Pemohon adalah seorang penjual mainan asal Fontaine, namanya Bertrand. Dia datang ke Inazuma untuk mulai bisnis mainan, dan dia lagi cari asisten buat bantu-bantu produksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "Dia seorang pebisnis, dan dia berani bayar mahal. Semuanya jelas waktu dia ajukan misi kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "Tapi untuk saat ini dia tidak bisa pergi dari Ritou. Kalian boleh langsung tanya dia untuk rincian misinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "Oke, kami langsung menuju ke Ritou deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "Atau antar barang aneh-aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Hahaha! Sekarang semuanya siap! Satu mainan dijual seribu Mora, lalu kalau bisa laku sampai puluhan ribu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "Puluhan juta Mora sudah di depan mata! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "Halo, Pak Bertrand ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "Ah? Betul, itu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "Kalian pembeli yang berminat setelah dengar bisnisku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Sayangnya aku belum bisa jual apa-apa sekarang. Produksi massal belum dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "Jangan cemas, fasilitas produksinya sudah dalam pembangunan. Kalau minat, silakan daftar dan taruh deposit. Nanti kalau mainannya sudah siap, aku akan kabari kalian, dan pembayarannya bisa langsung diproses ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "Tahan dulu! Kami bukan mau belanja mainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Oh, bukan pembeli ya ... Ya sudah, ada perlu apa? Jangan buang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "Tolong dipersingkat, waktuku ini sangat berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "Astaga, sikapnya langsung berubah 180 derajat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Kami ke sini mau bantu-bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "Oh, kalian asisten kiriman Adventurers' Guild toh. Salam! Kenapa tidak bilang dari tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Betul, aku memang mengajukan misi. Boleh tahu aku harus panggil kalian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Sikapnya berubah lagi, ampun ya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Panggil saja Paimon ... Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "Kalau kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}? Kok rasanya pernah dengar nama ini ya. Apa kamu juga ... mantan buronan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Mantan yah ... tapi aku pernah buron lebih dari sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Oh, berarti aku dengar nama kamu waktu ditang— ditanyai oleh Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "Kok bisa? Memangnya kamu ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "*huff* Sepele sih sebenarnya. Aku cuma kecolongan saja waktu terakhir kali bikin mainan. Kesalahan kecil, sungguh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "Sepele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "Kesalahan kecil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Hehe, mainan yang dihasilkan bisa meledak kalau salah satu bahan yang terkandung di dalamnya terpicu. Gitu doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "Meledak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "Eh, sungguh, bukan apa-apa. Tidak sampai makan korban kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Tapi para Doushin Tenryou Commission langsung menyita semua mainan buatanku. Dari sudut pandangku ya, setidaknya mainan itu masih bisa laku kalau dijual sebagai bom yang lucu-lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "*huff* Waktu pertama tiba di sini dulu, aku pinjam modal bisnis ke Asosiasi Perdagangan Internasional. Siapa sangka aku malah jadi terdampar di Ritou, dan tidak diizinkan mengunjungi area lain di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Ya sudah sepantasnya lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "Sebentar ... Kamu kan punya utang ke Asosiasi Perdagangan Internasional ... Lah terus gimana caranya kamu bayar kami nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "Tenang, aku masih ada sisa tabungan. Dan kalau produksi sudah normal kembali, aku bisa jualan lagi kan. Utangku juga bakal dilunasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "Setelah itu, aku bisa kasih kamu bayaran yang mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "Memangnya bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "Percayalah sama potensi pasar mainan di Inazuma! Mainan buatanku sangat populer loh, sebelum orang sadar semuanya bisa meledak. Tapi tahu tidak? Setelah orang tahu, eh malah semakin populer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "Yah, kalau rencanaku ini gagal, aku bisa bayar utang dengan cara menyerahkan semua mainanku ke Kurisu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Kumohon, bantu aku. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Memangnya kamu mau minta kami ngapain sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "Yah, mainanku semuanya hasil produksi mesin. Namanya \"Satu-Satunya Mesin Industri Tenaga Pembakaran Generasi Kedua Yang Tidak Pernah Gagal\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "Bicara soal \"Satu-Satunya Mesin Industri Tenaga Pembakaran Generasi Kedua Yang Tidak Pernah Gagal\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Namanya kok gitu sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Eh, waktunya Paimon mikir nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "Oke, sebut saja \"Mesin Gede\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "Sebentar, namanya pendek amat! Tidak ada keren-kerennya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Eh jangan salah, nama yang pendek itu mudah diingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "Mesin Gede ... Hmm, Paimon merasa namanya oke juga. Enak ngucapnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "*huff* Ya sudahlah. Memang banyak orang yang bilang kalau selera penamaanku itu jelek sekali. Ya sudah, aku nurut deh sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "Selera si Paimon juga sama jeleknya kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Hahaha. Nah, si Mesin Gede ini bisa secara otomatis menganalisa bahan baku yang dimasukkan ke dalamnya, lalu dia akan pilih cara yang paling tepat untuk merakit mainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Tapi waktu itu, aku memang sempat menambahkan mekanisme aneh yang bikin mainannya jadi bisa meledak. Sekarang aku sudah merenungkan kesalahanku dan sudah membangun ulang mesinnya. Teorinya, TEORINYA sih ya, kali ini semuanya akan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "Teori. Haiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "Itulah kenapa aku perlu orang buat uji coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "Intinya, proses pengumpulannya ada tiga tahap. Pengumpulan Bahan Baku, Pengisian Daya Elemen, dan Aktivasi Inti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Kita harus kumpulkan benda-benda seperti bijih batu, buah-buahan, bunga-bungaan untuk bahan dasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "Setelah itu, kita aplikasikan energi elemental ke bahan-bahan tersebut, supaya bisa maju ke proses berikutnya. Terakhir, kita isi dayanya menggunakan inti makhluk elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Hari ini kita coba dulu tahap pertamanya deh: Pengumpulan Bahan Baku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Nih, ambil Material Collector ini. Ingat, apa pun yang kamu kumpulkan, langsung taruh di sana, supaya tidak terkontaminasi unsur lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Makasih. Biar alatnya aku atur dulu sekali lagi. Semangat ya mengumpulkan bahannya, aku mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "\"Juga\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Haha, ceritanya panjang. Aku pernah ditangkap Tenryou Commission gara-gara kecelakaan kecil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "Kamu mengajukan misi ke Adventurers' Guild kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
		{
