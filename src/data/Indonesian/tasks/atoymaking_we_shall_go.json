			},
			"dialogs": [
				{
					"id": 726940501,
					"content": "Kalau bisa dapat Mora dengan menjualnya, kembalikan uang yang aku pinjam, aku cuma perlu jual 20.000 lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940502,
					"content": "Sederhana sekali kan ... Eh, kamu sepertinya ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "Kamu mau jualan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Aku sih maunya jualan mainan, tapi ... Mainannya belum ada yang diproduksi. Boleh datang dan lihat-lihat nanti kalau barangnya sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Tidak kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "Kalau tidak ada urusan, tolong jangan ganggu dulu. Aku lagi bikin barang yang penting sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		}
	]
}