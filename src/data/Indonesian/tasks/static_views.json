			"dialogs": [
				{
					"id": 730980301,
					"content": "Coba Paimon lihat ... hmm? Ini gambar Aranara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "Tidak baik sembarangan menyentuh barang orang lain ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "Oh ya? Jelas-jelas kita sudah bereskan kemah petualang, peti harta di reruntuhan dan lainnya selama perjalanan kita entah berapa kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "Hmm ... kalau tidak begini saja! Kita kan khawatir karena enggak lihat Aranara di sekitar sini, jadi kita datang untuk cari petunjuk. Siapa tahu bisa bantu Aranara yang lagi kesulitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Benar katamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Hehe, tentu saja! Gimana pun juga, gambar ini kayaknya ... seperti pemandangan di dekat sini, kan? Wah! Jangan-jangan ini peta harta karun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, coba kita ke tempat yang ada di gambar! Siapa tahu ada harta karun yang ditinggalkan Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Oh ya. Tumben kata-kata Paimon masuk akal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
