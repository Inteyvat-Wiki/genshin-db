				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Hmm ... coba lihat ... sepertinya ada peta harta karun baru yang muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Tadi bukannya kamu bilang mau bantu \"Aranara yang kesulitan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#*uhuk* *uhuk* Ya, tapi kan kita belum temukan pemiliknya, buat orang jadi khawatir saja! Jadi {NICKNAME}, Paimon rasa kita harus ke tempat yang ditandai di gambar untuk lihat-lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Setelah sampai di sana, kita bisa dapat harta karun yang lebih banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Dapat harta karun yang lebih banyak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Ya! Eh, salah! Dapat menemukan Aranara yang perlu bantuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Hmm ... sepertinya \"kotak surat\" ini agak aneh, jangan-jangan nanti akan ada gambar baru yang dikirim lagi. Mending kita pasang mata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Menemukan \"Aranara yang kesulitan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Ya! Dan siapa tahu kita juga bisa temukan harta karun kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
