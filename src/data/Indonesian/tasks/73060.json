				{
					"id": 730600601,
					"content": "Di Monumen Yasna, orang jahat sangat banyak. Namun, Aranakula sudah kembali. Bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "Nara Emas bersama Aranakula bersembunyi dari orang jahat. Juga menghilangkan Kenangan Batu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Setelah Varuna Contraption sudah diperbaiki, bunga di kebun bisa dibawa. Aranara takkan lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Sekarang tinggal Arakunti yang ada di Grove of Dreams. Tunggu Arakunti kembali, kita bisa pergi membersihkan ulat jahat yang menggerogoti Varuna Contraption ....",
