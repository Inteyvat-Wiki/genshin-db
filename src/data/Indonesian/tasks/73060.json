			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika seharusnya segera kembali dari Ruins of Dahri. Berkat Ararakalari Arabalika, raksasa besi dan Fungus jadi tidak menakutkan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Kalau Aranakula memiliki setengah dari kekuatan Arabalika, Aranakula bisa melindungi kebun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Aranakula bahkan enggak ada setengahnya dari Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "Aranakula bisa lebih berani, sama seperti Nara Emas, hanya saja butuh waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
