			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika ternyata lancar. Namun, aku khawatir Aranakula yang ada sedang Monumen Yasna dan Arakunti yang ada di Grove of Dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula ... jamur jahatnya banyak sekali. Gimana kalau Aranakula sampai ketangkap jamur jahat lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "Jangan terlalu ketakutan, tidak ada gunanya. Nara Emas sangat kuat, mengalahkan Big Iron Chunk, seperti angin yang menghempas jembatan kayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Asalkan Varuna Contraption bisa kita perbaiki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
