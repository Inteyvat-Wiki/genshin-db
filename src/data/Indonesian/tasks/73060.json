			"dialogs": [
				{
					"id": 730600201,
					"content": "Nara Emas sepertinya enggak takut apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "Nara Emas adalah Nara yang berani, sama seperti Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "Walaupun khawatir dengan Arabalika yang ada di Ruins of Dahri dan Arakunti yang ada di Grove of Dreams, tapi pasti enggak akan ada masalah karena ada Nara Emas yang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "Setelah memperbaiki Varuna Contraption, pasti enggak akan ada orang jahat yang mengganggu kebun. Bunga di kebun, ingin kuberikan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
