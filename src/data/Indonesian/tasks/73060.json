			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "Grove of Dreams ... melodi yang tenang, suara air, suara burung yang mengepakkan sayap, suara ranting terinjak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Ngobrol sama Nara dan Paimon ... Paimon sangat menyenangkan. Namun, sayangnya Paimon enggak mau menjadi benih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Karena Paimon bukan Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Grove of Dreams sudah enggak masalah. Arabalika di Ruins of Dahri, tapi aku enggak khawatir. Nah sebaliknya \"Fungus\" banyak di Monumen Yasna, jadi aku takutnya Aranakula....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
