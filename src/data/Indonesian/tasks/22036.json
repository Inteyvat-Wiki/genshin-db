					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Oh, Vahid yang menyuruhmu datang ke sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Aku dengar ada toko pupuk baru di Ritou, jadi aku menyapa Vahid, pemilik toko tersebut, dan ingin mencoba pupuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Kalau berguna, hasil panen juga bisa meningkat banyak, dan ada harapan untuk revitalisasi Desa Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "Ah, revitalisasi Desa Konda bergantung pada orang tua sepertiku, anak muda di desa... Hmm, tidak bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Oke, kasih tahu aku bagaimana cara menggunakan pupuk ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Pertama tambahkan air, lalu tambah daun yang dihancurkan, dan aduk rata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Kenapa banyak yang perlu diperhatikan pakai pupuk ini... Oke, aku akan mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Pertama tambahkan daun yang dihancurkan, dan aduk rata, lalu tambahkan air.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
