			"dialogs": [
				{
					"id": 220360501,
					"content": "Anak muda, kita bertemu lagi. Apa yang mau kamu tanyakan kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
