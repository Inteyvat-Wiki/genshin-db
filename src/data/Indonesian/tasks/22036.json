			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Bisnis ini benar-benar sulit. Yang aku jual semuanya produk bagus untuk anak-anak dan orang tua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Tapi aneh, kenapa tidak banyak yang mau beli ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "Oh kamu, Pengembara. Ah, tidak perlu dibahas. Pupuk di tokoku masih belum terjual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Bukannya sudah dibantu Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Dia... memang membantu sedikit. Tapi masalahnya, kami berdua tidak tahu cara mempromosikan, dan cuma bisa nunggu pelanggan datang ke toko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Tapi kamu sendiri juga tahu keadaan Ritou, mana ada pelanggan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Jadi, aku pergi minta nasihat. Mereka menyarankan agar aku melakukan... \"pemasaran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Khususnya, kita harus bicara lebih banyak tentang efek dan prinsip pupuk dengan pelanggan kita. Kita juga harus buat iklan yang lebih pas, dan berikan barangnya untuk dicoba gratis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Tapi... aku benar-benar tidak mengerti hal-hal seperti itu, dan bukan aku yang mengembangkan pupuk ini. Bagaimana aku bisa mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "Tapi, meskipun aku baca manualnya, aku juga harus berkeliling dan menyebarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "Alrani sudah pergi membagikannya, aku juga nanti mau pergi. Pengembara, apa kamu bisa bantu membagikan iklan-iklan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "Bagus! Kalau begitu tolong ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Kamu bisa pergi ke Desa Konda, tempatnya tidak jauh dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Di sana ada Konda Densuke, dia tertarik dengan pupuk di toko kami. Dulu dia datang ke toko dan ngobrol denganku beberapa saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Kalau kamu bisa bawa beberapa produk kepadanya untuk dipromosikan dan memintanya untuk \"mencobanya\", mungkin dia akan bersedia membeli lebih banyak pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Alrani pergi ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Dia bilang mau sekalian ambil bahan, jadi pergi agak jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Kamu bisa pergi ke Desa Konda, tempatnya tidak jauh dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
				2203608
			],
			"beginWay": "TALK_BEGIN_NONE",
