			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "Jadi, jelaskan padaku cara menggunakan pupuknya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Ya, ya, aku belum jelaskan pupuk yang kita ambil kali ini bisa diaplikasikan secara khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Coba aku lihat... berdasarkan petunjuk di buku manual, urutan penggunaannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Pertama, masukkan pupuk ke dalam <color=#37FFFF>air</color>, lalu tambahkan <color=#37FFFF>daun yang dihancurkan</color>. Terakhir <color=#37FFFF>aduk hingga rata</color> dan aplikasikan ke tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Jangan salah urutan, nanti gagal dan memengaruhi kesan pelanggan ke kita. Bisa-bisa dia tidak mau pesan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Aku akan mengingatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Kalau begitu kuserahkan padamu. Berikan Anahitian Blessing kepada pelanggan, lalu uang muka darinya jadi hadiah untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Coba kamu ulangi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Pertama, masukkan pupuk ke dalam <color=#37FFFF>air</color>, lalu tambahkan <color=#37FFFF>daun yang dihancurkan</color>. Terakhir <color=#37FFFF>aduk hingga rata</color> dan aplikasikan ke tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "Tolong ya, Pengembara... Kita semua bekerja keras, mungkin masih ada harapan untuk pencapaian bulan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
