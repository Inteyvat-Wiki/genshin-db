			"dialogs": [
				{
					"id": 721830101,
					"content": "Ini... benih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830102,
					"content": "Ini benih \"Naku Weed\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830103,
					"content": "Kamu tahu tanaman ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Hm, aku hanya tahu sedikit namun aku sudah pernah melihat tanaman ini sebelumnya, juga pernah mendengar tentang keanehannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830105,
					"content": "Aku ingat... bahkan di hari-hari tak berangin pun, tanaman ini akan bergetar seiring dengan suara guntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830106,
					"content": "Apa tanaman itu terlihat bagus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Jika dilihat dari penampilannya... sepertinya sangat bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830108,
					"content": "Kamu ingin mencoba menanam \"Naku Weed\"? Tapi tidak ada tanah yang sesuai di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830109,
					"content": "Aku sudah memiliki tanah sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "Ah begitu? Kamu sangat luar biasa... Kalau begitu kamu sudah mendapatkan tanah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830111,
					"content": "Kalau boleh tahu, tanahmu itu di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830112,
					"content": "Bukan di Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "Oh! Aku sudah mendengar prestasimu di Mondstadt dan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830114,
					"content": "Sudah sepantasnya kamu mendapatkan tanah untuk prestasi seperti itu, luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830120,
					"content": "Hei, \"tanah\" yang kamu maksud bukan \"Serenitea Pot\" yang Nenek berikan kepada kita, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830121,
					"content": "Apa benar bisa menanam sesuatu di sana? Sepertinya Nenek tidak pernah mengatakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830122,
					"content": "Coba tanyakan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "Baiklah kalau begitu, ayo kita kembali dan tanyakan kepada Nenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830124,
					"content": "Adeptus sangat kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "Benarkah? Tapi Nenek juga sangat kuat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830126,
					"content": "Baiklah kalau begitu, ayo kita kembali dan tanyakan kepada Nenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830115,
					"content": "Di dalam poci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "Dalam... poci? Hei, jangan bercanda denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830117,
					"content": "Aku sudah mendengar prestasimu di Mondstadt dan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830118,
					"content": "Sepertinya tanahmu bukan di Liyue, tapi di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830119,
					"content": "Ah, kamu sangat luar biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				}
			]
		},
