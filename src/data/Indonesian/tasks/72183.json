			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Eh? Anak-anak, apa kalian di sini untuk mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830202,
					"content": "Tentang benih \"Naku Weed\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Benih... Oh, kamu ingin menanam benih ini di \"Serenitea Pot\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830204,
					"content": "Ini bukan sesuatu yang mustahil, lagi pula ukurannya sebesar dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830205,
					"content": "Kalian hanya membawa benih ini. Apa kalian berencana ingin menanam benih ini saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830206,
					"content": "Ya! Kami tidak tahu bagaimana cara mengumpulkan benih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Ke mana lagi kami harus mencarinya setelah selesai menanam benih ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "Baiklah, jangan khawatir. Aku memiliki sebuah kotak kecil yang telah kugunakan bertahun-tahun yang lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830209,
					"content": "Dulu aku selalu menyimpan bunga di dalam kotak ini dan bunganya bisa tahan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830210,
					"content": "Dan setelah memasukkan bunga ke dalamnya, kotak ini bisa menghasilkan beberapa jenis benih bunga... Jadi mudah dan praktis untuk digunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830211,
					"content": "Meskipun kotak ini sudah tidak sebagus dulu... Tapi setidaknya masih menyimpan sedikit energi untuk \"menghasilkan benih\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830212,
					"content": "Uh... Aku sudah jarang menggunakan kotak ini... Aku akan memberikannya kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830213,
					"content": "Kotak ini pasti akan berguna jika kalian ingin menanam beberapa jenis bunga atau tanaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830214,
					"content": "Terima kasih Nenek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Terima kasih Nenek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "Hehe, tidak usah sungkan. Cobalah, tapi menanam bunga dan tanaman tidaklah mudah. Mental kalian harus kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830217,
					"content": "Nenek sangat kuat ya... Sebelum kita mencoba kotak ini, mari kita kembali dan mencoba menanam benihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Hm, semoga benih ini cepat tumbuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
