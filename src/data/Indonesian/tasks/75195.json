			"dialogs": [
				{
					"id": 751950201,
					"content": "Astaga, ini ... tiba-tiba ada orang yang baik hati muncul entah dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Aku tadinya mau minta tolong Tatankasaurus membersihkan batu di lapangan kosong ini. Kalau ada monster yang muncul tiba-tiba, bisa sekalian dilibas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Tapi mulai saja belum, kerjaannya sudah ada yang beresin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Setiap hari bangun pagi langsung sebar pupuk di pohon buah depan pintu, gitu terus dari dulu. Ini berkat para dewa karena aku hidup tekun dan berbakti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "Orang baik yang budiman, utusan dari langit di atas! Aku, Dutta, berterima kasih dari lubuk hati yang terdalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Aku tidak punya benda berharga, cuma bisa memberimu Mora dan beberapa barang yang tidak begitu berguna. Mohon maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
