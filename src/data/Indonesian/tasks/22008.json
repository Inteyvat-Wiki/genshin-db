			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Hongdou, kamu akan membaik setelah minum obat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Tidak, tidak! Obatnya terlalu pahit, aku tidak mau minum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "Ah ternyata seorang pengembara... jadi, tubuh Hongdou sejak kecil memang kurang sehat, ini obat yang harus dia minum, berdasarkan resep yang diberikan oleh Dr. Baizhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Tapi Hongdou selalu mengatakan obatnya terlalu pahit, jadi dia tidak mau meminumnya. *huff* Bagaimana mungkin ada obat yang tidak pahit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Agar anak ini mau minum obat, aku selalu berjanji kepadanya bahwa setiap kali setelah minum obat, dia dapat memakan semangkuk Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Pengembara, jika kamu ada waktu, bisakah kamu membantuku membawakan seporsi Almond Tofu? Aku masih harus di sini untuk membujuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Sungguh terima kasih banyak, satu porsi saja sudah cukup untuk Hongdou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Dia sakit apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "Ah, aku juga tidak pandai menjelaskannya tapi Dr. Baizhu bilang penyakitnya hampir mustahil untuk disembuhkan, dan bahkan hanya untuk menjaga gejalanya saja memerlukan banyak pengobatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Aku khawatir Hongdou harus terus minum obat seumur hidupnya, dia masih kecil... aku benar-benar tidak tega memikirkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Aku benar-benar berharap biar aku saja yang sakit. Tapi... sekarang aku hanya bisa berharap agar Hongdou tidak terlalu menderita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "Pengembara, kumohon, bantu aku dan bawakan satu porsi Almond Tofu, satu saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Hongdou, kenapa tidak mau minum obatnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "Obatnya pahit sekali! Obat Lulu tidak sepahit ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Hongdou... Lulu dan teman-temannya hanya berpura-pura, itu adalah air gula dari Almond Tofu, bukan obat yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Oh... jadi Almond Tofu tidak akan membuatku membaik? Kalau begitu aku harus minum obat yang pahit ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Hongdou, minum obat ini maka kamu akan segera membaik, lalu kamu bisa makan apa pun yang kamu inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Kenapa obat tidak bisa semanis Almond Tofu? Sungguh menyebalkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "Anak ini benar-benar, ah... Pengembara, maaf merepotkanmu, tolong bantu aku dan bawakan seporsi Almond Tofu, satu saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
