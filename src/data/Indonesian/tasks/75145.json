			"dialogs": [
				{
					"id": 751450101,
					"content": "Oh, Yang Terpilih oleh Naga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "Gunung Suci itu ada tepat di hadapanmu ... jika kamu ... bisa mengalahkan musuh yang diselimuti bayangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "Yang Terpilih oleh Naga, silakan ... masuk ... ke dalam Gunung Suci ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Nguuuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Gu-Gunungnya baru saja ... meletus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Enggak ah, perasaan dari tadi enggak ada suara. Kamu ... lihat gunungnya meletus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME} sama {REALNAME[ID(2)|SHOWHOST(true)]}, kenapa muka kalian serius banget?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Kayak detektif yang tiba-tiba nemu \"fakta\" penting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Kita memang lihat \"fakta\" penting sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Kamu menjelaskan apa yang kamu lihat kepada Paimon ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Hah? Kamu lihat hal yang sama waktu kita pertama tiba di Natlan dan ketemu {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "Terus ada banyak gambar aneh juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#{NICKNAME} bilang dia lihat sesuatu yang aneh ... Uh, Paimon enggak lihat sih, jadi enggak tahu. Tapi kedengarannya kayak suara orang deh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Sepertinya orang yang sama ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Tapi kali ini kalian juga melihat ... reruntuhan yang besar dan Abyss ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "\"Gunung Suci\" ... Hmm, orang Natlan juga nyebut gunung berapi itu \"Gunung Suci\". Apa mungkin yang dilihat ada hubungannya sama gunung berapi itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} diserahkan ke kita karena alasan ini. Orang itu ingin kita masuk ke \"Gunung Suci\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Mungkin di situ kita bisa dapat jawaban soal asal-usul {REALNAME[ID(2)|SHOWHOST(true)]} ... terus mungkin bisa ketemu keluarganya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Fuwahh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Intinya ... Kata Paimon sih kita harus cari info soal gunung berapi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Oh iya! Salah satu suku Natlan, Berlimpah Jaya, kan tinggal dekat gunung berapi. Mungkin bisa tanya ke mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Pembunuh kue itu adalah ... PAIMON!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Fuwah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Ihhh sialan! Kok kamu tahu? Padahal Paimon yakin enggak ada yang lihat waktu makan kuenya ... Bercanda, yang Paimon curi sebenarnya Blazed Meat Stew!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Oke, kamu ... Tunggu, jadi yang kamu lihat apa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
