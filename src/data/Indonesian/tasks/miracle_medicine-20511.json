					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "Inikah? Sepertinya mirip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "Dilihat dari sisi mana pun, ini adalah Berry biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Ya sudahlah, dokter sudah memberikan resep ini, aku akan mengikuti arahannya membuat resepnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "Terima kasih, ini adalah upah untukmu karena sudah bersusah payah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "Aku mungkin akan membutuhkan bantuanmu lagi di masa depan. Pada saat itu terjadi, tolong jangan menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
