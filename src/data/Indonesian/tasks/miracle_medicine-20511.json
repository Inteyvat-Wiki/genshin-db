					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Apakah resep ini ada gunanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "Pengembara! Kamu datang tepat waktu, aku mengkhawatirkanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Begini, kamu masih ingat dengan adikku yang bernama Anna kan, dia masih sakit-sakitan, dan belum membaik dari dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Tapi dengar-dengar ada seorang dokter ahli di Pelabuhan Liyue yang bisa menyembuhkan penyakit, dan aku pun menyuruh orang untuk meminta resep padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Meskipun bahan-bahan dalam resep itu sangat aneh, tapi tidak ada salahnya mencoba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Hmm, coba kulihat... Apakah kamu bisa mencarikan Berry yang Ditelan Dendro Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "Benar-benar ada barang seperti inikah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Aku juga tidak tahu! Apa Berry yang Ditelan Dendro benar-benar bisa dimakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Aku mengandalkanmu! Aku tahu satu tempat di mana kamu bisa menemukan Slime dan Berry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Tolong bantu aku mengeceknya, semoga kamu menemukannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Dokter ini adalah penipu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Apakah kamu juga berpikir seperti itu? Tapi, aku juga tidak ada cara lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Aku tahu satu tempat di mana kamu bisa menemukan Slime dan Berry. Bisakah kamu pergi dan mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Aku akan mencoba obat yang kita buat. Tidak peduli apa yang terjadi, aku tidak akan membiarkan kondisi Anna menjadi lebih buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Kalau tidak ada, aku akan menangkap Dendro Slime untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Huh... Apa? Kamu menyuruhku memasukkan Berry ke mulut Dendro Slime sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Tolong, jangan biarkan aku melakukannya! Terakhir kali aku mengambil obat herbal untuk Anna, sekelompok Dendro Slime mengejarku sampai ke Springvale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Aku tahu satu tempat di mana kamu bisa menemukan Slime dan Berry. Bisakah kamu pergi dan mencarinya? Semoga kamu bisa menemukan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Tapi... ka-kalau kamu benar-benar tidak bisa menemukan apa pun... Demi Anna, tangkap Dendro Slime dan bawalah ke sini. Aku akan melakukannya! Aku... pasti bisa melakukannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
