					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "Coba kupikirkan... barusan kita bahas hidangan apa saja ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "Umm... Mora Meat, Cured Pork Dry Hotpot, lalu Goulash!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220230206,
					"content": "Kalau sudah tahu mau masak apa, langsung saja kita berikan ke Nona Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
