			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "Ugh... seandainya saja bisa makan masakan Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230102,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "Kamu... dilihat dari penampilanmu, kamu pasti seorang pengembara ya? Maaf, aku cuma sedikit kangen rumah saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230104,
					"content": "Barusan kamu bilang kamu mau makan masakan Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "Eh? Jangan-jangan... kamu bisa membuat masakan Liyue ya? Baguslah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230119,
					"content": "Ka-kalau begitu tolong buatkan aku sebuah masakan Liyue yang asli ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230120,
					"content": "Coba kupikirkan ya... masakan yang paling mau kumakan sekarang adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230121,
					"content": "Ya! Aku mau makan daging! Daging yang banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230122,
					"content": "Teksturnya yang lembut, dan aroma yang luar biasa dari lemak daging dan bumbu khas dari Liyue yang dicampur bersama, menimbulkan aroma yang super...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230123,
					"content": "Sekalinya membayangkan daging seperti itu, aku jadi tidak kuat menahan diri agar tidak gemetar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230124,
					"content": "Jadi, aku mau makan daging! Tolong bantu aku menyiapkan hidangan Liyue yang terbuat dari daging!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230105,
					"content": "Apa kamu sedang kesulitan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "Kuperkenalkan diri dulu, namaku Tang Wen. Aku adalah sejarawan dari Liyue. Dulunya aku meneliti budaya khusus dan dialek Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230107,
					"content": "Data-datanya juga sudah terkumpul dan aku sudah siap kembali ke Liyue. Tapi karena Inazuma ditutup, aku terpaksa tinggal di sini untuk sementara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230108,
					"content": "Sebenarnya bagiku penutupan ini adalah hal baik. Karena aku merasa Inazuma sedang berada dalam momen bersejarah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230109,
					"content": "Aku yakin masa penutupan Inazuma ini pasti akan meninggalkan jejak yang kuat dalam sejarah Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230110,
					"content": "Menyaksikan sejarah semacam ini dengan mata kepala sendiri, kemudian mencatat semuanya dalam sebuah buku secara lengkap dan jelas, untuk ditinggalkan kepada generasi mendatang. Inilah yang harus dilakukan seorang sejarawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230111,
					"content": "Meskipun hal ini sangat membuatku bersemangat, tapi hal ini tidak bisa mengenyangkan perutku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230112,
					"content": "Kamu lapar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "Tidak sampai kelaparan sih... Hahaha, masakan Inazuma lumayan enak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230114,
					"content": "Aku sangat suka Tempuranya, meskipun hanya dibaluti tepung dan digoreng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230115,
					"content": "Tapi setelah memakan masakan Inazuma, aku masih tetap ingin makan masakan Liyue. Dan aku masih belum menemukan restoran masakan Liyue yang benar-benar enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230116,
					"content": "Beberapa waktu lalu aku memutuskan untuk mengajukan misi memasak di Adventurers' Guild, tapi sampai sekarang belum ada respon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230117,
					"content": "Boleh aku mencicipinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
