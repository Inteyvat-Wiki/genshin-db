			},
			"dialogs": [
				{
					"id": 705320101,
					"content": "Hmm ... pakai kartu ini ... Eh? Masih ada kartu lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320102
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320102,
					"content": "Oh, halo Pengembara! Maaf, aku lagi sibuk mikirin Dek sampai tidak sadar ada kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320103
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320103,
					"content": "Guild memintaku jadi panitia Kejuaraan Raja Invokation. Aku bertugas mengurus ... itu, duel dengan aturan khusus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320104
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320104,
					"content": "Namanya \"Invokation Impromptu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320105,
						705320106
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320105,
					"content": "Bedanya sama duel biasa di mananya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				},
				{
					"id": 705320107,
					"content": "Tidak dong, jelas beda. Invokation Impromptu punya aturannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320108
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320108,
					"content": "Gampangnya begini, kamu tidak diperkenankan pakai Dek punya sendiri. Pilih 3 dari 8 Dek belum lengkap yang sudah disiapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320109
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320109,
					"content": "Di dalam Dek belum lengkap ini, ada kartu-kartu yang baru rilis. Dan tentang cara menggunakan kartunya semaksimal mungkin ... itu tergantung kemampuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320110
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320110,
					"content": "Aturan lainnya sama dengan duel biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320111
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320111,
					"content": "Kalau kamu bingung mau susun Dek seperti apa, kami siap bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320112
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320112,
					"content": "Tapi yah, bagus atau tidaknya kami tidak berani jamin, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320113
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320113,
					"content": "Intinya, aku sarankan kamu susun Dek sendiri sih. Soalnya kan mau dipakai buat melawan pemain lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320114
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320114,
					"content": "Kalau yakin dengan kemampuan sendiri, boleh coba kunjungi wilayah lain dan coba Invokation Impromptu di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320115
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320115,
					"content": "Tapi jangan jadi stres juga ya. Semua pemain Invokation Impromptu kalah atau menang tetap dapat hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320116
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320116,
					"content": "Kalau berminat, silakan dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320106,
					"content": "Kayaknya sama saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				}
			]
		}
	]
}