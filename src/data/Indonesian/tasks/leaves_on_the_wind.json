					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Bagus, kalau begitu kuserahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030303,
					"content": "Kamu bisa melihat elemen, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030304,
					"content": "Aku rasa kamu hanya perlu mengikuti jejak \"angin\" dan mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030305,
					"content": "Aku akan menunggumu di bawah pohon. Kalau kamu menemukan sesuatu, berikan saja kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
