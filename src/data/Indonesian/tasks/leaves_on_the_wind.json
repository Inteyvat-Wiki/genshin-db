			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "Aku rasa seseorang sepertimu lebih cocok melakukan penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030402,
					"content": "Kamu memiliki pengalaman bertualang yang banyak, dan juga stamina yang kuat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030403,
					"content": "Dan yang terpenting, kamu bisa mengendalikan elemen tanpa menggunakan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030404,
					"content": "Elemen... Apakah ada penelitian di benua ini yang bisa mengungkap rahasia mereka? Bagi seorang peneliti, kemampuan untuk menggunakan Vision atau kekurangan itu benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, aku mulai berbicara sendiri lagi... Maaf, jangan dianggap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
