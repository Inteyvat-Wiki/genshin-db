			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "Sayang sekali, aku tidak bisa menggunakan bahan ini juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Aku ingin menulis buku baru tentang sejarah Mondstadt yang berfokus pada \"angin\", dan aku sedang mencari inspirasi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030104,
					"content": "Jika kamu memikirkannya, tempat ini adalah tempat yang ideal — ada Patung The Seven yang mewakili Anemo, dan pohon yang lekat dengan legenda pahlawan Vennessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030105,
					"content": "Namun, aku tahu ini mungkin terdengar lucu — mencari dan mengumpulkan angin tanpa Vision, yang adalah kekuranganku, adalah suatu hal yang sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030106,
					"content": "Apa yang disebut pencarian inspirasi, juga hanya memandang kekosongan di sini. Sebagian besar materiku adalah rangkuman dari buku-buku lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030107,
					"content": "Itu adalah hidup seseorang tanpa Vision di benua ini — melakukan banyak hal, tetapi yang dicapai hanya sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030108,
					"content": "Seseorang tidak dapat menggunakan kekuatan elemen tanpa Vision... baik dalam hal penelitian atau pun kehidupan, tanpa itu mereka seperti orang asing yang hidup di dunia mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, mungkin di mata para dewa, pemilik Vision adalah karakter utama di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030110,
					"content": "Maaf, aku terlalu banyak bicara. Dan meskipun aku berkata seperti itu, aku tidak akan menyerah dengan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030111,
					"content": "Aku tidak memiliki Vision, tapi aku tidak akan kehilangan beasiswa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030112,
					"content": "Dan aku juga mendengar bahwa kamu bisa melihat kekuatan elemental tanpa Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030113,
					"content": "Kalau kamu bisa membantuku mengambil beberapa benda yang berisi Anemo, itu akan sangat membantu penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030114,
					"content": "Pengembara, bisakah kamu membantuku untuk memanjat pohon ini dan mencarinya sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
