			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030502,
					"content": "Aku menemukan daun-daun ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "... Dedaunan? Coba kulihat. Kamu bahkan meletakkannya ke dalam kotak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030504,
					"content": "Ketika kamu menggenggamnya di tanganmu, daun-daun ini akan membuatmu merasakan \"angin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030505,
					"content": "Aku merasa pohon ini benar-benar memiliki kekuatan ini. Andai saja aku memiliki Vision, maka aku tidak akan menghabiskan banyak waktu seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030506,
					"content": "Terima kasih, ini adalah bahan yang sangat berharga, aku akan menggunakannya sebaik mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030507,
					"content": "Tapi aku tetap tidak tahu cara menyelamatkan daun-daun ini. Sangat mungkin \"angin\" di dalamnya menghilang dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030508,
					"content": "Ini upah atas usahamu. Siapa tahu aku membutuhkan bantuanmu di masa depan untuk membantuku mengumpulkan bahan penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		}
	]
