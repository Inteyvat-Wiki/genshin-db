			"dialogs": [
				{
					"id": 60280301,
					"content": "Kamu tidak apa-apa? Lukamu masih sakit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280302,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "Aku sudah menyiapkan obat yang mungkin bisa membantu. Minum saja kalau perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280304,
					"content": "Terima kasih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "Kalau begitu, biar kuceritakan isi percakapan yang dengan Alice setelah kejadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280307,
					"content": "Si Dottore itu licik .... Dia mengalihkan perhatian Hexenzirkel dengan cara membuat kekacauan besar di perbatasan Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280308,
					"content": "Aku berasumsi bahwa ini pasti gangguan dari Abyss di luar dunia. Yang sebenarnya, memang cukup sering terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280309,
					"content": "Tapi setelah kamu berhasil melakukan kontak dengan hantu-hantu di Nod-Krai, aku mulai menduga bahwa gangguan ini mungkin juga berasal dari Teyvat sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280310,
					"content": "Tapi kita tidak bisa mengubah takdir mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280311,
					"content": "Ya, kalian memang tidak bisa mengubah akhir ceritanya, tapi berhasil membangun beberapa \"variabel\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280312,
					"content": "\"Variabel\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "Ya. Misalnya, mendengar sesuatu yang seharusnya tidak mungkin diketahui, atau memiliki ide yang seharusnya tidak mungkin terpikirkan ... Hal-hal seperti itu disebut \"variabel.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280314,
					"content": "Tentu saja, mengingat hampir tak terbatasnya kemungkinan yang terlibat di sini, biasanya yang seperti itu bukan masalah. Tapi artinya akan jadi lain ketika semuanya sengaja ditumpuk, untuk mengubah kejadiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280315,
					"content": "Melalui variabel-variabel inilah Dottore berhasil memenuhi syarat untuk menjalankan rencananya pada malam ini, saat kalian mengaktifkan portal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280316,
					"content": "Tapi kita belum bisa tahu pasti apa yang dia perbuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 60280317,
					"content": "Ya. Dan kita juga harus cari tahu dulu situasi Columbina sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280318,
					"content": "Yah, kira-kira begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280319,
					"content": "Sesuai dugaan, Dottore sudah benar-benar menghilang. Setidaknya ada satu hal yang menghibur, dia tidak bisa mengendalikan Columbina sesuai kemauannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280320,
					"content": "Aku rasa itu tidak begitu menghibur, mengingat alasannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280322,
					"content": "Untuk menggagalkan rencana \"The Doctor\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "Apa? Dia ... apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280325,
					"content": "Tunggu, kalian semua ... tidak lihat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "Kami cuma lihat si \"Dottore\" muncul, terus ngeluarin kekuatan aneh ... terus setelah itu, tahu-tahu Columbina sudah hilang dan kamu jatuh ke laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280327,
					"content": "(Begitu rupanya. \"The Doctor\" menghentikan waktu, dan hanya aku yang bisa bergerak bebas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "(Dari sudut pandang mereka, pertempuran kami dan tindakan Columbina terjadi dalam sekejap saja.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "(Itukah kekuatan tiga bulan? Tapi kenapa aku tidak terpengaruh? Apa karena aku seorang Descender?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "Jadi, Columbina sengaja membuka Gerbang Bulan, dan melarikan diri ke dunia misterius yang sama dengan Rerir dan Tholindis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280331,
					"content": "Sepertinya ini kabar buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280332,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280333,
					"content": "Jadi ini alasan kenapa Dottore tak kunjung muncul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "Dilihat dari sudut pandang itu, \"Penjajaran Tiga Bulan\" dan kemunculan Rerir ... Dottore mungkin telah mengatur semuanya dari balik layar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280336,
					"content": "Menurut Tante Alice, dia berusaha melampaui takdirnya dan menyelesaikan eksperimen yang hanya bisa dilakukan oleh dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280337,
					"content": "Sungguh orang yang tidak waras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280338,
					"content": "Sebentar, ke mana si Om Topi? Masa dia enggak mau dengar ini sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280339,
					"content": "Setelah kami bicara dengan Tante Alice, katanya dia dapat ide. Jadi dia pergi menyelidiki sendirian, sambil bawa Dodocommunication Device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280340,
					"content": "Ekspresi wajahnya ... menakutkan. Aku belum pernah lihat dia seperti itu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280341,
					"content": "(Mungkin marah dan frustasi karena si Dottore tetap selangkah lebih maju, padahal dia sudah berusaha mati-matian.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "(Dan jujur, aku ... juga merasakan hal yang sama.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "Aku sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "Om Topi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280345,
					"content": "Aku pergi ke tempat para hantu Hyperborea. Dan sudah ketemu jawabannya. Mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "Aku pertemukan mereka dengan Nicole pakai alat komunikasi, dan ternyata sejarah yang mereka ceritakan beda dengan yang di ingatan Nicole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "Loh, kok bisa? Kayaknya enggak mungkin deh Nicole yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280348,
					"content": "Karena para hantu itu adalah mereka yang ditipu. Mereka bercerita tentang \"penyelamat\" dalam sejarah mereka. Yang seharusnya tidak pernah ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "Si penyelamat ini berjanji untuk menciptakan bulan baru di langit palsu, bahkan berjanji untuk membawa kembali para Dewi Bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "Dengan bodohnya, mereka percayai dan memberitahukan semua yang ingin dia ketahui tentang bulan-bulan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "Sudah jelas ini perbuatan Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "Hmm. Nicole memang bilang ada yang aneh tentang sejarah yang dibahas para hantu di reruntuhan Hyperborea ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280353,
					"content": "Tapi harusnya kan si Dottore enggak bisa masuk ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280354,
					"content": "Memang tidak. Nicole bilang ini kondisi anomali yang dipicu oleh gangguan dalam hubungan sebab akibat antara hantu-hantu dari zaman yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "\"Variabel\" yang dipasang oleh Dottore cukup substansial hingga dapat menyentuh hantu-hantu yang bahkan tidak pernah dia temui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "Jadi ingatan mereka bukannya tidak jelas ... melainkan telah dimanipulasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280357,
					"content": "Itu persis kemungkinan yang coba dibuat oleh Dottore. Dia mengubah variabel-variabel ini menjadi pengetahuan dan merekayasa situasi agar semua pengetahuan itu jatuh ke tangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "Lalu, dia memanfaatkan pengetahuan itu pada Malam Doa Rembulan ... untuk benar-benar menciptakan \"bulan palsu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "Kok ... kok bisa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280360,
					"content": "Lebih tepatnya, dia memanfaatkan kelemahan dari cara kerja mantra tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "Mantra tersebut merasakan kuuvahki untuk mendeteksi lokasi bulan. Jadi, selama \"bulan palsu\"nya lebih menyerupai bulan dibandingkan dengan Bulan Embun yang ada di balik langit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "Gerbang itu akan membawa Columbina ke lokasi bulan palsu ... dengan kata lain, ke sebelah Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "Setelah berhasil mengendalikan Columbina, mantra teleportasinya tetap aktif, dan dia memanipulasinya untuk merebut kedua Sumsum Bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "Saat itu, keduanya menghilang tepat di depan mata ... Ketika kami meninggalkan reruntuhan, semuanya sudah terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280365,
					"content": "Saat itu, Dottore sudah berhasil mengumpulkan kekuatan tiga bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280366,
					"content": "Jadi ... kita bisa apa dong sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280367,
					"content": "Aku ingin tahu apa yang Yang Mulia pikirkan, sekarang setelah kekhawatiran yang aku sampaikan padanya benar-benar terjadi. Tapi kita tidak bisa diam saja menunggu keputusannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280368,
					"content": "Dan lagi, bukan Harbinger Fatui \"The Damselette\" yang menganggap kita sebagai temannya, melainkan Columbina Hyposelenia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280369,
					"content": "Kalau bahkan dalam situasi genting seperti ini, Yang Mulia tetap tidak mau mencabut aturan sesama Harbinger dilarang saling menyerang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280370,
					"content": "Maka aku akan mengikuti kata hati. Aku akan maju dan menyerang sebagai Peruere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280371,
					"content": "Arlecchino ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280372,
					"content": "Waktu kita tidak banyak, jadi biar aku yang duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280373,
					"content": "Waduh, sampai si Arlecchino jadi panas gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280374,
					"content": "(Dia pasti merasa bertanggung jawab ... karena aku juga sama.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280377,
					"content": "Baiklah, baiklah. Jangan melempem semua begitu, kasih aku waktu bicara sebentar, oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280378,
					"content": "Keadaannya buruk, aku tidak akan pura-pura. Sangat buruk, malah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280379,
					"content": "Dottore mengeksekusi trik-trik busuknya dan berhasil unggul dari kita ... untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280380,
					"content": "Yah, triknya sampai membuat para penyihir percaya kalau \"variabel\" yang dia buat berhasil memengaruhi takdir. Tapi aku tidak percaya semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280381,
					"content": "Banyak yang mengatakan bahwa takdir Teyvat sudah ditentukan, dan memang sepertinya begitu. Lalu, apa yang membuat Dottore begitu yakin kalau dia bisa jadi pengecualian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280382,
					"content": "Dan karena dia bisa menumpuk \"variabel\" ini, siapa bilang kita tidak bisa melakukan hal yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280383,
					"content": "Dari semua yang ada di sini, seharusnya kamu yang paling tidak patah semangat, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280384,
					"content": "Ini belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280385,
					"content": "Ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "Dan kamu tidak sendirian dalam hal ini. Semua orang di sini juga merasakannya, baik yang sudah berbicara maupun belum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280388,
					"content": "Tapi tidak seorang pun dari kita yang hanya akan duduk diam dan menunggu matahari terbit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280389,
					"content": "Begitulah seharusnya sikap seorang knight sejati. Jika dijatuhkan, kita bangkit lagi, dan terus berjuang. Jangan pernah lupa, Honorary Knight, sebab kamu juga sudah merupakan bagian dari Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280390,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "Varka benar! Ini belum selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280392,
					"content": "Lagian si Dottore itu sudah utang banyak sekali bogem dan tendangan dari kita! Kelakuannya dari dulu enggak ada yang bener, nyebelin semua! Habis ini, dia mesti bayar dobel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280393,
					"content": "Nah, gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280394,
					"content": "Bagaimana perasaan kalian semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280395,
					"content": "Aku akan menggunakan kuuvahki untuk mencari keberadaan Columbina. Aku menolak menyerah begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280396,
					"content": "Serahkan pengumpulan informasi padaku. Apa pun yang terjadi di wilayah Nod-Krai, ketika Curatorium of Secrets ingin tahu, kami pasti akan tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280397,
					"content": "Aku dan Aino akan melakukan semua yang kami bisa untuk mendukung. Kami akan coba merekayasa ulang tindakan Dottore dan mencari petunjuk dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60280398,
					"content": "Tante Alice dan Nicole sedang sibuk menangani keadaan darurat di perbatasan Teyvat, jadi mereka belum bisa ke sini lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280399,
					"content": "Tapi mereka berdua sangat marah. Mereka minta Albedo dan aku untuk bertindak sebagai perwakilan mereka untuk melawan Dottore. Dengan daya tempur maksimal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280401,
					"content": "Kalau begitu, sudah siap? Kita harus melakukan banyak penelitian, bahkan di tahap awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280402,
					"content": "Aku akan berusaha sebaik mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280403,
					"content": "Dan aku sudah sangat familier dengan cara kerja Dottore. Aku bisa coba prediksi langkahnya setelah ini, jadi aku akan bantu dalam penyelidikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "Bagus. Masing-masing sudah membagi tugasnya masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280405,
					"content": "Aku akan menghubungi Flins dan Illuga, minta mereka berbicara dengan Starshyna mereka. Tak ada salahnya juga mengajak para Lightkeeper bergabung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280406,
					"content": "Lalu, aku akan menginstruksikan para knight yang berada di Nod-Krai untuk membantu Lightkeeper dan organisasi lainnya memastikan keselamatan penduduk yang tinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280407,
						60280408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280407,
					"content": "Mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280409,
					"content": "Ya! Kasih paham si jahat itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280410,
					"content": "Baiklah. Semoga beruntung, semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280408,
					"content": "Kita harus siap menghadapi apa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280386,
					"content": "Aku... tidak bisa berhenti menyalahkan diriku sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280334,
					"content": "Dia mengulur waktu untuk melakukan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280323,
					"content": "Dia melompat ke dalam \"pantulan bulan.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280305,
					"content": "Sebaiknya kita langsung ke inti permasalahannya ....",
