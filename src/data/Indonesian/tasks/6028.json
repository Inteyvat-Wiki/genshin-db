			"dialogs": [
				{
					"id": 60280201,
					"content": "Ini ... di sini orang-orang Hyperborea dulu berkomunikasi dengan bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280202,
					"content": "Bulan Abadi, Bulan Embun, dan Bulan Pelangi... Ketika kekuatan dari ketiganya menyatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "Gerbang menuju bulan akan terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280204,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "Semua Sumsum Bulan-nya sudah di posisi. Tinggal langkah terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280206,
					"content": "Aku yakin Kota Nasha sekarang lebih ramai dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280207,
					"content": "Iya ... sayang kamu enggak bisa ikut ya. Tapi ya sudah, mau kapan lagi kalau enggak sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Tidak apa-apa. Aku sudah sangat puas dengan ini, barang bawaanku yang terakhir dan satu-satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280209,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280210,
					"content": "Aku sudah bisa merasakannya. Panggilan dari sang bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280211,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280212,
					"content": "Cahaya ini akan menuntunmu pulang, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280213,
					"content": "Setidaknya mulai sekarang, kita sudah punya alasan untuk memanjatkan doa ke bulan sejati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Ya, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280216,
					"content": "Main lagi ke sini kalau ada kesempatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ah ... pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280218,
					"content": "Tapi kalau memang tidak ada kesempatan ... ingatlah, kalau di planet ini kamu punya kami ... teman-teman yang akan selalu kangen sama \"Columbina\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Ya, aku pasti ingat. Terima kasih untuk semua bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280220,
					"content": "Dan ingatlah ... terang bulan senantiasa menghubungkan kita, siang dan malam, untuk selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 60280221,
					"content": "Kalau begitu ... sampai jumpa, teman-temanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
