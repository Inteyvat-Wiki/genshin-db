					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "Mungkin lebih tepatnya ... pakai bahan ini, benar-benar bisa racik jadi warna berkilau ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Harusnya tidak bisa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Tapi Sluasi kayaknya senang banget sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Tapi bagaimanapun, terima kasih kepada kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Sebagai bentuk terima kasih, silakan terima hadiah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "Per-Permata yang bersinar! Dan ada komponen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Hehe! Syukurlah kalau suka. Lain kali, kalau ada perhiasan yang diinginkan, langsung cari aku saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Bukan tidak mungkin juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Ya, soalnya cat yang Mamere pakai juga dari barang yang aneh banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
			]
