			"dialogs": [
				{
					"id": 740240315,
					"content": "Sluasi memeriksa bahannya dengan hati-hati sebelum menyerahkannya kepada kalian ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240301
					]
				},
				{
					"id": 740240301,
					"content": "Pokoknya, terima kasih atas bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "Tapi, Yang Terhormat, aku tidak boleh sembarangan mengambil benda milikmu. Jadi, aku cuma perlu tahu nama bahannya saja, habis itu aku bisa cari sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Cuma saja, warna seperti itu terlalu dalam tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "Warna matahari ... harusnya lebih cerah dari ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "Lebih cerah ... maksudnya lebih putih sedikit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Kalau begitu, dibandingkan dengan warna emas, memang warna matahari itu lebih dekat sama warna putih deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "Putih ... ya? Hmm ... Aku juga tidak tahu, bahan apa yang harus dipakai untuk bisa memunculkan warna yang lebih cerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "Langsung campur air saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Langsung campur air ... Aku dulu pernah coba, tapi hasilnya tidak terlalu bagus. Cat yang dibuat dengan cara ini, pasti akan kusam, tidak akan bisa silau seperti matahari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Jadi, kalau boleh, aku sih mau pakai bahan lain untuk dijadikan bahan tambahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Tapi, benda yang silau dan putih, harusnya kita sering lihat sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Kalau begitu, pakai rambut Paimon saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "Rambut enggak bisa dijadikan cat deh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "Eh enggak deh, kalaupun bisa, enggak boleh sembarangan cabut rambut Paimon ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
