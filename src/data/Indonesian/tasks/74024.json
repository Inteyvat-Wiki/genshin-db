				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Hei, kamu ngapain sendirian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "Wah! Jangan tiba-tiba ngomong dari belakang orang lain dong! Hampir saja bubuk ini jatuh semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "Bubuk? Eh? Apaan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "Ini permata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "Per-Permata? Kok bisa ada permata di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "Kenapa tidak ada permata di sini? Ini kan tempat untuk proses permata. Meski tidak ada nama khusus yang diberikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "Dulu pernah dipikirkan sih, apa langsung dikasih nama \"Studio Sluasi\" atau sejenisnya? Tapi kok sepertinya aneh kalau langsung pakai nama sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "Proses permata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Tempat untuk ... buat permata jadi berbagai jenis perhiasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "Tapi, akhir-akhir ini, aku harusnya tidak bisa terima pesanan baru lagi. Soalnya aku harus buat cat sepenuh waktu ... Meski tetap pakai permata sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "Buat cat dari permata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "Eh? Memangnya kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Umm ... Kayaknya sih sayang banget ya. Kalau permatanya enggak terpakai lagi, boleh langsung kasih Paimon saja sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "Tapi, mau buat cat untuk ngapain memangnya? Proses permata jadi perhiasan harusnya enggak butuh cat ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Dulu, ada seorang anak yang suka gambar tanya kepadaku. Bisa tidak buat permatanya jadi berkilau, biar warnanya silau sama seperti matahari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Terlebih lagi, dia juga sempat selamatkan adikku saat terjadi gempa kuat di desa beberapa waktu yang lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "Makanya sekarang aku ingin wujudkan keinginannya dan buat cat yang silaunya seperti matahari, sebagai bentuk terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "Jangan-jangan yang kamu bilang itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "Hei, anak yang suka gambar itu, jangan-jangan namanya Mamere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "Eh? Benar. Kalian kenal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "Kalian menceritakan kepada Sluasi hal-hal yang terjadi sebelumnya bersama Mamere ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#Ja-Jangan-jangan ... Kalian berdua ini Yang Terhormat {NICKNAME} dan Yang Terhormat Paimon yang selamatkan Puca bersama Mamere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "Yang-Yang Terhormat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "Benar, itu kami ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Terima kasih banyak untuk kalian berdua. Kalau bukan karena kalian, Puca pasti sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Kalau kalian tidak keberatan, silakan terima ini ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Permata yang indah ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#Seriusan boleh diterima nih, {NICKNAME}? Kayaknya mahal banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Tapi, tidak kusangka Mamere itu masih bisa inisiatif untuk minta tolong sama orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Bukan termasuk minta tolong juga sih. Soalnya, dia cuma tanya aku bisa dibuatkan atau tidak. Aku belum selesai jawab, dia sudah langsung pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "Kalau ini sih ... Memang tipe Mamere banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Oh ya, Yang Terhormat {NICKNAME}, Yang Terhormat Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "Kalau menurut kalian, benda yang warnanya mendekati matahari itu, apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "Meski aku sudah pernah coba mengamati bentuk matahari, tapi aku tidak terlalu yakin. Sebenarnya bahan apa yang harus kupakai baru bisa memunculkan warna matahari itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "Um, benda yang warnanya mendekati matahari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "Emas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Ya. Kemarin Canotila juga sudah pernah bilang, emas adalah air mata yang diteteskan matahari, atau sejenisnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "Tapi, kalau emas dijadikan cat ... Terlalu mewah kan ya? Harusnya ada benda biasa jadi penggantinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Pokoknya, kalau bahas soal benda yang mendekati warna matahari, harusnya kita pernah lihat deh, malah sering lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "Matahari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "Ternyata begitu, kalian memang luar biasa. Benda yang mendekati warna matahari, memang matahari itu sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "Tapi bagaimana caranya ya supaya matahari bisa dijadikan bubuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "Hei! Bercandanya jangan seserius itu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "Kalau begitu, pakai rambutku saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "Hmmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "Eh? Pakai rambut jadi cat? Mana boleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "\"Yang Terhormat\"-nya tidak perlu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
