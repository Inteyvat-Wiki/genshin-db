			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi memeriksa bahannya dengan hati-hati sebelum menyerahkannya kepada kalian ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Kalau begitu, warna ini, pasti warna putih yang kalian sebut-sebut ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Aku selalu merasa harus pakai warna kebalikan dari warna matahari ... Kalau menggunakan warna kebalikannya, bisa cocok tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "Warna kebalikannya ... maksudnya hitam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "Hitam ... benar. Harusnya hitam. Memang Yang Terhormat Paimon luar biasa. Warna matahari itu memang seharusnya warna hitam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "Kok ada yang aneh sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Oh ya, kenapa bisa terpikirkan warna hitam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Matahari kan warna emas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "Apa aku boleh minta bantuan kalian terakhir kalinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Tolong bawakan satu jenis benda berwarna hitam. Dengan begitu, aku sudah tahu harus pakai bahan apa untuk membuat \"warna yang berkilau seperti matahari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "Seriusan mau cari? Paimon benar-benar rasa benda ini enggak ada hubungannya sama matahari deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "#Tapi, kalau memang dia sudah minta tolong ... {NICKNAME}, cariin satu benda berwarna hitam kasih dia deh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Kalau matahari di malam hari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Di malam hari juga enggak jadi warna hitam tuh. Malah lebih tepatnya, mana ada matahari di malam hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Yang Terhormat Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "Jangan ikut-ikutan lah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
