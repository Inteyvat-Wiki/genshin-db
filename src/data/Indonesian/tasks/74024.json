					]
				},
				{
					"id": 740240701,
					"content": "Terima kasih banyak. Dengan begini, aku akan bisa buat cat dengan warna yang berkilau seperti matahari untuk dijadikan hadiah untuknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240702
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240702,
					"content": "Seriusan bisa buat ...?",
