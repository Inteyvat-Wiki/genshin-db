			"dialogs": [
				{
					"id": 750330601,
					"content": "Yah, kalah lagi. Padahal sudah banyak latihan, tapi masih kalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "Kan sudah kubilang dari dulu, jangan pikir soal menang mulu. Tapi nyalimu hebat juga, langsung maju gitu tanpa takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
					"content": "Kamu juga begitu pas kecil, tiap hari ngekorin aku, selalu ribut bilang mau jadi pawang Saurian terhebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330604,
					"content": "Jangan ngejek aku dong, kak....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Kalian semua anak yang baik dan pejuang yang hebat. Setiap pejuang akan menghadapi tantangan yang berbeda pada masanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330606,
					"content": "Tapi tidak apa-apa. Selama kalian jujur dengan diri sendiri, aku tetap akan bangga dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
