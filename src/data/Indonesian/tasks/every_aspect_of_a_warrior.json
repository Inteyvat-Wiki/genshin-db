			"dialogs": [
				{
					"id": 750330101,
					"content": "Untuk apa aku bertahan? Kenapa aku tidak boleh menyerah saja? Aku sudah tidak sanggup! Bantu aku, Kak Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Malu-maluin! Mau sampai kapan kamu jadi bocah, begitu ketemu rintangan langsung mau menyerah. Bisa-bisanya bilang kamu ini pejuang! Aku malu panggil kamu kakakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "Memangnya kamu sendiri tidak pernah bingung setengah mati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Pernah! Makanya aku datang biar Ayah dan Kak Manyoya bisa lihat hasil latihanku. Aku bukan pengecut sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, aku rasa kapten tolak surat pengunduran dirimu jadi kamu bisa pikir-pikir lagi. Jangan buru-buru ambil keputusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Tenangkan diri, baru putuskan. Yang paling penting itu kamu tidak menyesal nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Aku sudah pensiun, selanjutnya mau ngapain juga belum tahu, jadi aku tidak punya hak untuk kasih nasihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Wuah! Ternyata kalian bertiga saudara ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Di luar dugaan banget ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "Kalian?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "Maaf, penolongku. Rencana kaburku gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Sudah kuduga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Apa tidak ada cara untuk melepaskan diri dari penderitaan ini? Jadi pejuang itu capeknya minta ampun. Kenapa hidup ini sulit sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Masih belum selesai mikir tentang pasukan terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Maaf, Acomitl. Kalau berdasarkan pengalamanku, tidak ada yang mudah dalam hidup ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "Aku baru selesai perbaiki pelindung tangannya Matahga. Punyamu perlu diperbaiki juga, Manyoya? Hmm? Ada tamu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "Ah, mereka petualang yang kami temui saat latihan. Mereka bahkan sempat membantu Acomitl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "Salam kenal. Namaku Xueyoni, pelatih dan juga ayah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Pelatih Unggulan Bunga Bersayap"
				},
				{
					"id": 750330121,
					"content": "Kayaknya situasinya Acomitl enggak bagus. Kalau Om butuh bantuan, panggil kami saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Terima kasih, tapi Acomitl baik-baik saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Hah? Om mau biarin saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "Haha! Maksudku ... Begini deh. Kalian kan petualang, berarti kalian bagian dari Adventurers' Guild kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Itu organisasi yang sangat bagus. Kalian sebagai petualang pastinya ingin menjelajahi dunia, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Walaupun begitu, setiap petualang punya motivasinya sendiri. Beberapa melakukannya demi uang, yang lain untuk pengetahuan, ada juga yang melakukannya cuma karena bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "Mampu menyatukan semua orang ini di bawah satu nama adalah sesuatu yang benar-benar luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Ambil aku sebagai contoh. Aku ini pria tua yang sudah pensiun dari posisi penunggang Saurian di pasukan terbang, lalu kemudian jadi pelatih di suku ini. Tapi aku tidak bisa membayangkan apa jadinya kalau para pelatih dari keenam suku membangun sebuah asosiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Uh ... Apa hubungannya sama situasinya Acomitl ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "Cara Ayah menjelaskan memang begitu. Waktu dia masih di pasukan terbang, semua orang selalu mendengarkan nasihatnya dengan cermat, bahkan para Qucusaurus sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Sekarang Ayah sudah jadi pelatih di suku kami, jadi semua orang yang ingin jadi pejuang sering minta nasihatnya. Santai saja dan dengarkan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "Heh, itu sudah lama sekali, Manyoya. Tapi aku akan lanjut ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Sebagai pelatih, kami selalu berusaha mewujudkan sosok \"pejuang\" yang ideal. Itulah yang menginspirasi kami untuk merancang program latihan kami dengan hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "Kami semua ingin melihat sosok \"pejuang terhebat\", tapi tidak ada yang bisa mendefinisikan apa yang membuat seorang pejuang menjadi hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Itulah sebabnya kami para pelatih tidak bisa sepakat dalam prinsip dan regulasi apa pun, apalagi membentuk sebuah asosiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "\"Pejuang terhebat\" itu punya berbagai macam wajah dan kepribadian, tidak cuma satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "Kadang mereka tegas, tapi kadang bisa meragukan diri sendiri. Mereka juga bisa menua dan mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "Apa yang namanya pejuang tidak pernah lelah? Aku bisa tunjukkan ribuan gulungan yang membuktikan kalau keraguan diri dan rasa lelah itu dirasakan oleh semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Apa yang namanya pejuang harus punya tubuh besar? Aku tahu banyak sekali orang berbadan besar yang sifatnya keji. Orang-orang seperti itu juga tercatat dalam gulungan kain tenun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "Dan tentu saja, pejuang dapat menjadi lemah, begitulah hukum alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "Anak-anakku memanggilku sebagai seorang pejuang. Tapi lihat diriku, aku cuma pria tua yang sudah tidak sanggup terbang lagi, aku sudah tidak kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Seorang pejuang dengan wajah sempurna yang memenuhi semua standar membosankan, pejuang seperti itu tidak akan diakui sebagai pahlawan di Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga, aku bawa kalian ke sini karena kalian ingin jadi pahlawan Bunga Bersayap yang mampu melihat dunia dari ketinggian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Kekhawatiran dan ambisi kalian adalah hal yang sesaat dalam perjalanan panjang seorang pahlawan, bukan masalah yang perlu dipecahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Apa kamu bukan pejuang lagi kalau keluar dari pasukan terbang? Dan apa kamu otomatis jadi seorang pejuang kalau berhasil bergabung dalam pasukan terbang? Tentu saja tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "Punya ambisi itu bagus, punya keraguan dan merasa tersesat juga adalah sesuatu yang normal. Kamu adalah pejuang, dan seorang pejuang harus menghadapi berbagai ujian untuk bisa menjadi pahlawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Terimalah dirimu yang sekarang dan sadari apa yang perlu dikembangkan. Jangan biarkan ia yang mengendalikan dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "Inilah cara hidup Natlan, cara hidup seorang pahlawan. Mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Aku mengerti, Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Apa kamu masih ragu, Acomitl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Ceramah berkepanjangan bukanlah cara kerja keluarga kita. Pergilah terbang bersama kakak dan adikmu, seperti waktu kecil dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Biarkan pikiran dan tubuhmu yang memutuskan. Duduk di rumah seharian tidak akan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Aku mengerti, Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#Apa semua Pelatih Unggulan bicaranya abstrak begitu ya? Paimon kurang ngerti deh. Kalau {NICKNAME} gimana? Ngerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Ngerti dong. Intinya harus ujian terbang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "Petualang, aku sudah dengar tentangmu dari anak-anak. Kamu anak muda yang sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "Kamu berani bersaing dengan Manyoya, bantu Acomitl kecil ... bahkan dapat pengakuan dari Matahga. Kamu yang disebut seorang pejuang sejati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Aku ingin mengundangmu untuk terbang bersama anak-anak. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Boleh saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Haha, baiklah. Kabari saja kalau mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Anakku semuanya adalah penerbang papan atas di Bunga Bersayap. Aku yakin kalian akan senang terbang bersama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Aku pikirkan dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "Enggak nih. Ajaran keluarganya terlalu dalam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Angkat bahu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Padahal jelas banget loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
			"completionStepIds": [],
