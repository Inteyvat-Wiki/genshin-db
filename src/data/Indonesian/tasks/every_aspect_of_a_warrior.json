			"dialogs": [
				{
					"id": 750330401,
					"content": "Kamu jago terbang juga, anak muda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330402,
					"content": "Lihat caraku terbang tadi? Gimana, gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330403,
					"content": "Hebat sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "Terima kasih untuk pujiannya, tapi aku tahu aku masih jauh di bawahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330406,
					"content": "Acomitl ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330407,
					"content": "Kamu salah paham. Aku bukan frustrasi karena tidak bisa kejar yang lain. Aku tahu aku bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330408,
					"content": "Tapi karena kondisiku yang buruk, lama-lama aku jadi tidak percaya diri. Kalau terbang jadi tidak tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330409,
					"content": "#Teknik {NICKNAME} sangat beda. Posturnya lebih santai, kelihatan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330410,
					"content": "Ayah, aku tahu kamu dan Kakak mau aku buat keputusan sendiri dan tidak lari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330411,
					"content": "Tapi kalau aku bilang, kalau tubuhku, otakku, dan hatiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330412,
					"content": "Semuanya menolak untuk terus melangkah di jalan ini ... Apa kalian akan tetap mendukungku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330413,
					"content": "Tidak apa-apa. Selama itu keputusanmu dan kamu berani menanggung konsekuensinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330414,
					"content": "Matahga, kalau kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330415,
					"content": "Hei! Aku juga tidak bakalan langsung asal kritik kamu ya. Aku tahu Kakak orangnya gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330416,
					"content": "Kalau memang tidak tahan, lepaskan dengan tegas! Asal jujur dengan diri sendiri, kamu adalah seorang pejuang. Tidak ada yang berhak kritik kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330417,
					"content": "Kadang pekerjaan seorang Pelatih Unggulan lumayan gampang. Aku susun rencana latihan untuk para pejuang tanpa harus ikut serta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330418,
					"content": "Tapi aku juga pernah terbang bersama Saurian seharian, jadi aku tahu betul kehidupan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330419,
					"content": "Mengambil tindakan itu jauh lebih sulit dibandingkan menghakimi orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330420,
					"content": "Sebagai pelatih, aku sarankan kamu minta cuti untuk memulihkan diri secara fisik dan mental, bahkan kalau ada yang tidak senang dengan keputusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330421,
					"content": "Sebagai ayahmu, aku tahu kamu sudah tidak sanggup lagi, dan aku hargai keputusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330422,
					"content": "Keluar dari pasukan terbang bukanlah akhir dari segalanya. Pejuang Bunga Bersayap tidak harus membuktikan dirinya hanya melalui kemampuan terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330423,
					"content": "Terima kasih ... Aku sempat khawatir kalau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330424,
					"content": "Jangan berpikir terlalu jauh. Kami keluargamu, pasti akan selalu bantu kamu cari jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330425,
					"content": "Jadi pejuang itu susah ya! Paimon enggak nyangka bakal sesulit itu kalau mau jadi pasukan terbang Bunga Bersayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330426,
					"content": "Jadi petualang juga berat loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "Iya juga! Kalau kepikiran sama semua yang sudah kita hadapi, kita boleh bangga lah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330430,
					"content": "Jadi pejuang itu tidak mudah sama sekali, berubah dari pejuang menjadi pahlawan bahkan lebih sulit lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330431,
					"content": "Aku sudah bertemu dengan banyak pejuang, jadi aku tahu orang seperti apa yang punya kualitas seorang pahlawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330432,
					"content": "Anak muda, kamu sudah melalui banyak sekali cobaan. Aku bisa melihatnya dari matamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330433,
					"content": "Sudah tak terhitung lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "Sepertinya aku tidak salah menilai. Jalanmu berbeda dari kami, dan sepertinya masih sangat panjang. Izinkan aku membantumu, pahlawan masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330436,
					"content": "Kamu juga sudah membantu keluarga kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330437,
					"content": "Beri tahu aku saja kalau ingin menggunakan jalur latihannya. Kamu boleh terbang dari sini kapan pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330438,
					"content": "Makasih ilmunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "Jangan sungkan. Aku sudah tidak sabar melihatmu menjadi pahlawan yang menerangi langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330434,
					"content": "(Diam saja)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "Enggak semua orang bisa jadi pejuang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "Iya sih, masuk akal. Ya sudah deh, Paimon juga enggak ingin-ingin amat jadi pejuang. Harus latihan tiap hari loh, hih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
