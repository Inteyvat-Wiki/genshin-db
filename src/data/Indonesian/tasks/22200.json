						222000305
					]
				},
				{
					"id": 222000305,
					"content": "Baiklah, kalau Fisherman's Toast, biasanya di [Wanmin Restaurant] ada jual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000307,
					"content": "Baik, aku juga mendengar dari pebisnis Mondstadt kalau di restoran itu ada Calla Lily Seafood Soup, sepertinya lezat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000308,
					"content": "Bicara tentang makanan Mondstadt, sepertinya memasak Grilled Fish dan Sweet Madame cukup mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000309,
					"content": "*krucuk*... Ah, baru ngomong tentang makanan langsung lapar lagi, *krucuk*...",
