			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Halo, ada *krucuk*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Ah, lagi-lagi perutku mengeluarkan suara. Tadi aku mengatakan, ada hal apa yang bisa kubantu *krucuk*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Hah, kamu mengatakan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "Huh, setiap kali aku lapar selalu begini, krucuk-krucuk, dan suaranya keras sekali, sampai suaraku sendiri tidak terdengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Meskipun... *krucuk*... sudah memeriksakan diri ke Bubu Pharmacy, tapi kata dokter aku tidak sakit, hanya lapar - jadi tidak ada obat untuk menyembuhkan...*krucuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Dokter mengatakan aku hanya perlu makan kenyang, tapi aku... bahkan aku sudah makan lebih banyak dari orang lain *krucuk*, kalau makan lebih banyak lagi, dompetku bisa menangis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi mengatakan kepadaku, kalau saatnya makan tidak makan kenyang, bisa makan sedikit setelahnya, setidaknya tidak akan mengganggu pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "Tapi makan \"sedikit\" ini... aku sudah makan banyak sayur, tapi tidak tahu kenapa aku cepat kelaparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "Pengembara, kamu sering berkeliaran di alam liar, pasti tahu kan makanan apa yang paling bisa mengenyangkan perut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Kamu bisa membantuku memikirkan makanan yang lezat dan mengenyangkan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Kali ini kamu mau makan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Banyak yang ingin aku makan... aku pikir-pikir dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
