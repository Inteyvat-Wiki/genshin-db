			"dialogs": [
				{
					"id": 721520101,
					"content": "\"Dulu ini adalah tempat harta karun Rinzou, Si Bajak Laut Hebat, rekan-rekanku sudah membawa beberapa kotak terakhir ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Catatan Treasure Hoarder"
				},
				{
					"id": 721520102,
					"content": "\"Tapi semasa hidupnya Rinzou sangat licik, dan di pulau ini juga banyak tanda yang ditinggalkan olehnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Catatan Treasure Hoarder"
				},
				{
					"id": 721520103,
					"content": "\"Mungkin hanya tipuan saja, atau mungkin benar-benar ada harta karun. Aku hanya bisa tahu setelah memeriksanya sendiri ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Catatan Treasure Hoarder"
				},
				{
					"id": 721520104,
					"content": "\"Kita sudah menemukan jejaknya. Kita harus bergerak cepat, saatnya menemukan semua harta milik Rinzou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Catatan Treasure Hoarder"
				},
				{
					"id": 721520105,
					"content": "Duh, panjang sekali ... Paimon hanya baca tulisan \"harta karun\" saja. Sisanya malas baca ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Tunggu ... Harta karun!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "Kalau ada harta karun, ayo kita cepat berangkat! Jangan sampai keduluan para Treasure Hoarder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
