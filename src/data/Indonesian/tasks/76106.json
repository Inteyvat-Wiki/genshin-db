			"dialogs": [
				{
					"id": 761060201,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "Ini demi kebaikanmu juga. Jangan berkeliaran di Biro Desain, terutama jangan lantai duanya! Kalau terlalu banyak terpapar kuuvahki, kami bisa sakit kepala, atau parahnya, mual-mual sampai muntah. Aku sudah kasih tahu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
