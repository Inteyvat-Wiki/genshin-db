			"dialogs": [
				{
					"id": 761060401,
					"content": "Jadi cuma gini doang kemampuan Fatui yang katanya hebat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "Ck, memang anak muda zaman sekarang tidak tahu sopan santun sama yang lebih senior ... Sebentar! Kamu bukan anggota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Kamu kira semudah itu untuk menyusup ke sini? Sayang sekali! Ringkus dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
