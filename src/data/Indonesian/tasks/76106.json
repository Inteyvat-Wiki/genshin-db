					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Serius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Serius! Setiap orang yang bekerja di sana biasa dikasih satu botol Apple Cider ekstra. Pikirin deh, kalau memang tidak berbahaya bagi kesehatan, mana mungkin dikasih lebih seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Lagian aku sudah pernah lihat langsung di wilayahnya Bani Bulan Embun! Para penghulu mereka punya tanduk di kepala, menurutmu itu normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Gitu ya ... makasih sudah diingetin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Ngeri amat! Ki-Kita bakal berubah jadi monster dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "Ck, selalu saja mengirim orang baru buat urus yang bahaya-bahaya ... Kamu hati-hati ya, jangan terlalu lama di dalam sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
