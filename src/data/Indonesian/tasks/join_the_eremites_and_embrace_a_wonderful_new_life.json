			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "Mengkhawatirkan juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "Selamat siang, Sania! Kamu lagi beli apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Aku sudah bilang berkali-kali sebelumnya, Atiyah, Jabari tidak tertarik bergabung denganmu, aku juga tidak mau dia menjadi tentara bayaran. Aku tidak akan membantumu untuk membujuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Aduh sayang sekali ya. Dengan keahlian memasaknya, Jabari pasti bakal sukses kalau bareng kami, dan pendapatan keluarga kalian juga akan meningkat pesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Dan dia juga pernah bilang mau bekerja di luar, kan? Kalau dia memang mau, bagus kan jadinya kalau ada teman sepertiku yang bisa kasih rekomendasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Iya dia memang bilang gitu hari ini tapi besok pasti berubah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Pada akhirnya, dia tidak tega meninggalkanku sendirian di desa ini ... dan aku juga tidak tega melihatnya bekerja keras sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "Dan juga, itu pekerjaan yang berbahaya! Jadi jangan berharap lagi deh, walaupun Jabari mau, aku pasti akan menghentikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Ya sudah, kita jangan bahas lagi deh. Masih ada barang-barang yang harus kubeli, sana ganggu orang lain saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "Fiuh ... Baiklah, kalau begitu. Sepertinya kamu sudah bisa lihat kan bagaimana kerjaanku sehari-harinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Selanjutnya kita cari Fodil, dia ... dulu dia adalah orang kami, tapi dia keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Kalau aku bisa membujuknya untuk kembali, itu akan sangat baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fodil",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah, kenapa kamu datang lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Hehe, mental baja adalah salah satu kelebihan kami, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Kalau gitu kamu juga pasti tahu, berpegang teguh pada prinsip adalah cara kami mengerjakan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Kak Fodil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Aku sudah keluar dari Eremite, kamu tidak perlu memanggilku dengan panggilan seperti itu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "Ugh, baiklah, Fodil. Kamu tidak mau kembali buat lihat-lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "Aku tahu bahwa beberapa dari kita bisa sedikit ... ceroboh, tapi kebanyakan dari kita adalah warga negara yang taat hukum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Atiyah, aku sudah bilang, aku tidak akan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "Aku sudah mengonfirmasi sendiri semua hal yang kamu katakan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Mungkin tidak semua orang Eremite adalah kelompok yang melanggar hukum, dan tidak semua orang Eremite adalah orang yang suka menendang orang yang sudah jatuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Tapi ... kejahatan bagaimanapun akan tersebar, Atiyah. Begitu satu orang bersalah melanggar aturan, orang-orang di sekitarnya akan menerima akibatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Satu orang merugikan sekelompok orang. Kalau sekelompok orang terus-menerus melancarkan aksinya, semakin banyak orang yang akan dirugikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Atiyah, kamu pastinya lebih paham tentang hal ini daripada aku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "Dalam kondisi seperti ini ... kejahatan sangat mudah terjadi, Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Kamu mau menyuruhku untuk kembali, aku juga mau menyuruhmu untuk pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "Walaupun di matamu Eremite tidak tergolong perkumpulan yang jahat, tapi juga tidak bisa disebut terhormat ... orang tidak bisa selamanya hidup dalam wilayah yang abu-abu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "Ini cuma nasihat dariku. Kamu harus memutuskan semuanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Aku tahu, Kak Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Oke. Kalau kamu keluar dan membutuhkan pekerjaan baru, aku akan membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "Apa kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Hahaha, aku tidak bisa menang dari Kak Fodil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Selanjutnya ... haha, kita pulang istirahat dulu, tenggorokanku sakit karena terlalu banyak bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326706",
							"2"
						],
						"stepId": 7326706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Atiyah",
					"Karima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Kak Atiyah! Kamu masih mengajak orang terus buat bergabung sama Eremite ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ayten, kenapa kamu keluar, kamu sudah bilang ke ibumu belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Sudah! Ibu sedang bekerja, aku keluar untuk main sama Karima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Halo, Kak Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Omong-omong, Kak, apa Kakak sudah memikirkan hal yang waktu itu aku bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Aku terus berlatih dengan Karima ... dia sudah hampir kalah denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Ha! Kamu pikir begitu ya ... yang waktu itu tidak masuk hitungan! Waktu itu aku kan belum makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "Intinya, aku sudah latihan sesuai dengan rencana yang kakak buatkan waktu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "Jadi coba tes aku lagi! Coba lihat apa aku sekarang sudah cukup kuat buat bisa bergabung ke Eremite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "Ini yang kamu bilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Ehem, oke! Ayten, aku akan mengujimu lagi hari ini dengan kapasitasku sebagai anggota Eremite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Baiklah! Karima, kamu juga coba, kita berjuang bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Aku tidak mau gabung sama Eremite, aku cuma mau tinggal di desa dan melindungi semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Tapi ada baiknya juga kalau Kak Atiyah menguji kemampuanku. Maksudku, sebelumnya aku memang minta nasihat Kak Candace tentang cara latihan sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Eh?! Kapan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Hahaha, kalian berdua semangat sekali, bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Oke, Ayten, jangan cemberut lagi. Kalau ada kesempatan, mungkin aku akan membawamu untuk mendapatkan beberapa petunjuk dari Dehya, oke? Kedengarannya itu ide bagus, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Beneran? Enggak bohong?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "Anggota Eremite berpegang teguh pada janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "Tapi sebelum kita memulai tes, biarkan Pengembara ini menunjukkan standar yang kita harapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "Aku juga harus bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "Sebelumnya aku tidak punya kesempatan untuk melakukan demonstrasi. Karena aku tidak mungkin meninggalkan kedua anak ini di sini dan pergi untuk melakukan demonstrasi, itu terlalu bahaya ... jadi kali ini tolong ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "Ehem, Pengembara ini adalah seorang petualang yang hebat. Aku sudah bersusah payah untuk mengundangnya supaya bisa memeragakannya kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Perhatikan baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Baiklah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "Petualang ... maksudnya orang seperti yang ada di Adventurers' Guild ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "Tidak peduli itu tentara bayaran ataukah penjaga, semuanya suatu ketika pasti akan bertemu dengan situasi yang membuat \"kabur\" menjadi pilihan yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "Ketika itu terjadi, prinsip dasarnya adalah semakin cepat kita bisa lolos, semakin baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "Tolong ya, Pengembara. Kita latihan dulu ... emm ... cara kabur secepat kilat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "Kita mulai dari sini, tolong demonstrasikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Kamu belum pernah melakukan demonstrasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Dulu aku harus membagi perhatianku untuk mengurus dua anak, tidak mungkin memeragakan gerakan standar apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "Intinya, kuserahkan padamu ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "Orang yang mau gabung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
			"completionStepIds": [
				7326708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326708",
							"2"
						],
						"stepId": 7326708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Karima",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "Kakak larinya bagai kancil yang lepas dari kandang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "Bagus! Kecepatannya lumayan, larinya juga seimbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "Anak-anak, perhatikan dan pelajari dengan baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "Jangan memaksakan diri kalau bertemu dengan bahaya, sebaiknya mundur kalau harus mundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Terutama kamu, Ayten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Ya, aku paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Bagus! Langkah selanjutnya ... kita pergi ke luar desa. Akan kuperlihatkan pada kalian adegan \"pertarungan\"-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Asyik! Ayah baru saja membuatkan pedang kayu, aku membawanya. Karima, kamu bawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Aku punya panah kecil, walaupun ... ibu cuma memberiku sebuah busur tanpa anak panah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Hahaha! Tidak masalah, kalian punya pedang, anak panah, dan keberanian yang banyak, ini cukup untuk bisa memulai sebuah petualangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "Tapi, jangan pergi ke sembarang tempat saat berada di luar, harus selalu ada di sampingku dan Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Kamu beneran mau bawa mereka keluar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "Tenang saja, aku sudah cek tempat itu terlebih dahulu, cuma ada beberapa kalajengking yang sekarat dan sepertinya tidak akan menyerang kita, seharusnya baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "Dan juga, kalau ada apa-apa kan ada kita berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Kok kamu langsung asumsi aku pasti ikut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "Oh, ayolah, kita sudah sampai sini loh. Kamu tahu sendiri kan, jangan setengah-setengah dong! Aku pasti akan membayarmu sesuai dengan peraturan Guild juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Kalau kalian sudah siap, kita akan berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Wooow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "Ugh ... aku sedikit gugup nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Perasaan aku tidak pernah menyetujui apa-apa deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "Membawa kedua anak kecil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				}
			]
		},
		{
			"id": 7326710,
