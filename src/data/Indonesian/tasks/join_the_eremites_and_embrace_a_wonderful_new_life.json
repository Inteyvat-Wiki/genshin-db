				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "Kalajengkingnya besar banget ... Apa kita betulan harus mendekat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Aku jelas-jelas sudah serang mereka dengan panah, tapi mereka sama sekali tidak bereaksi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "Tapi ... kamu mengalahkan mereka dengan mudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Hasil dari latihan selama ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Padahal Kak Candace bilang aku sudah berkembang pesat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Jangan terlalu sedih, Karima. Kamu pasti bakal jadi kuat pada akhirnya — tapi kamu harus menjalani semuanya hari demi hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Kamu juga sama Ayten, selama terus berlatih, kamu pasti akan bisa bergabung dengan Eremite suatu hari nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Ugh, seandainya bisa belajar langsung dari Kak Dehya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "Kalau nanti ketemu sama Kak Candace lagi, aku mau memintanya buat melatihku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Kedua anak ini ... sangat rajin, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Dan akhirnya kamu masih belum mendapatkan orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "*uhuk* *uhuk* ... *uhuk* ... Sudah, jangan dibahas lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Kita bicarakan masalah pekerjaan nanti ... lagi pula, bujukanku bukannya tidak ada efeknya sama sekali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Setelah mendengar apa yang kukatakan, banyak pria dan wanita muda telah meninggalkan desa untuk melihat dunia luar ... walaupun mereka tidak benar-benar ingin gabung dengan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Lupakan dulu soal ini, aku akan bawa kedua anak ini pulang, orang tua mereka pasti khawatir karena sudah keluar lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "Imbalan ini untukmu, terima kasih sudah menemaniku, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*huff* Sekarang, bagaimana aku menjelaskan ini kepada yang lain ketika aku kembali nanti ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Oh ya, Kak Atiyah, kamu belum mengujiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Ah? Oh be-benar juga ... ayo kita pulang dulu, aku akan menguji kalian setelah pulang nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "Bagaimana dengan pekerjaanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Kalian masih kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
