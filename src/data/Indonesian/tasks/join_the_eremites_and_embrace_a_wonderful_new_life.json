				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "Bergabunglah dengan Eremite dan rangkul kehidupan baru yang indah! Ayo, teman, apa kamu mau dengar tentang Eremite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Uh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Oh, ayolah, dengarkan sebentar. Tempat kami nyaman loh! Kami orang bebas! Kami selalu bersatu! Dan kami juga ramah sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Dan kalau kamu gabung dengan kami, kamu bakal dapat kesempatan untuk menipu para penghuni pohon dan dapat uang dari dompet mereka. Peneliti Akademiya adalah orang kaya, dan mereka juga bukan orang susah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Aku sudah bergabung dengan Adventurers' Guild.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Hmm ... Adventurers' Guild ... itu ... itu juga tidak akan mengganggu waktumu! Siapa yang tidak punya pekerjaan paruh waktu di zaman sekarang, selain itu petualang dan tentara bayaran juga sepertinya tidak terlalu berbeda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Perbedaannya lumayan banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "Ugh, tapi makanan kami juga sangat enak, ada daging dan ikan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Dan kalau beruntung, bahkan bisa bicara dengan \"Flame-Mane\"! Aku ... *uhuk* ... *uhuk* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Minum air dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "Huff ... hmm .. maaf maaf, tadi aku bicara terlalu cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "Jarang-jarang ada yang mau mendengarkan aku, aku terlalu senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "Jadi, kamu tetap tidak mau mempertimbangkan untuk bergabung dengan Eremite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Sementara tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Baiklah, kalau kamu bilang gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Kamu selalu cari orang di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Benar, ini adalah pekerjaanku. Kami selalu kekurangan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "*huff* Seharusnya tidak apa-apa memberitahumu. Ada banyak orang di Eremite, tapi pekerjaan sebagai tentara bayaran sangat berbahaya. Mengawal orang masih tidak terlalu buruk. Tapi melelahkan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Tapi kalau ada pekerjaan yang berhubungan dengan peneliti, itu risikonya agak tinggi. Bisa kembali dengan selamat saja sudah untung sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Kebanyakan dari prajurit kami biasanya setelah selesai melakukan misi ini, setidaknya harus istirahat 10 hari sampai setengah bulan, itu asumsi kasarnya saja ... Jadi harus selalu ada orang yang menggantikan posisinya saat kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru adalah tempat yang sangat luas dengan banyak peneliti, jadi kami selalu dapat pekerjaan baru setiap hari. Kami pada dasarnya bekerja sepanjang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "Kalau tidak cari lebih banyak orang, kita tidak akan bisa bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Kalau gitu kamu sudah nemu orang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Maksudmu di desa ini? Haha ... tidak ada satu pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Ugh ... tidak bisa dibilang tidak dapat juga sih, hanya saja orang yang kompeten malah tidak bersedia, sedangkan orang yang bersedia malah yang tidak kompeten ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "Kalau kamu tidak percaya, ikuti aku saja ... mungkin setelah itu kamu bersedia bergabung denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "... Bercanda kok. Kamu sudah bilang tidak mau gabung, aku juga tidak akan memaksamu. Aku cuma ingin mencari orang untuk menemaniku jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Tidak masalah sih kalau menemanimu jalan-jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Hehe, terima kasih ya. Ayo cari Sania saja dulu, dia seharusnya kosong kalau di siang hari, kalau malam ... dia masih harus diskusi dengan Jabari tentang masalah-masalah penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "Masalah di Adventurers' Guild sudah cukup banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Cara membujukmu sudah seperti marketing unggulan ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "Aku sudah punya banyak misi harian yang harus dikerjakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
