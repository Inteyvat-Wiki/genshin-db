				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Bagus! Segini sudah cukup, terima kasih ya. Tanpa bantuanmu, aku pasti harus bertarung melawan monster-monster itu sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Kalau sampai begitu, aku tidak tahu kapan baru bisa ingat soal mengumpulkan Sakura Bloom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Oh ya, ini Chicken-Mushroom Skewer untukmu. Ini adalah masakan klasik para petualang yang diajarkan Lynn padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Aku akan bawakan Sakura Bloom ini ke Xudong. Tidak tahu makanan enak apa yang akan dia buat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
