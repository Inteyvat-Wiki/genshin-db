				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Uh... jelas-jelas ada di sekitar sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? Kenapa kamu di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "Eh? Pengembara! Hehe, tak kusangka bertemu denganmu di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Aku datang ke sini untuk mencari bahan, Xudong mau bereksperimen dengan masakan baru, Parvaneh juga bersamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong bilang, dia mau membuat sebuah hidangan penutup yang manis dan lembut, dipadukan dengan Tricolor Dango dari Inazuma, tapi butuh beberapa bahan khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Paman Munehisa pergi ke kota beli Lavender Melon, sedangkan aku datang ke sini cari Sakura Bloom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Aku sudah mengumpulkan beberapa, tapi masih belum cukup. Tadinya aku mau cari ke depan sana, tapi di sana monster semua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "Pengembara, kumohon, bisa tolong carikan aku 3 buah Sakura Bloom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Terima kasih, lo! Nanti kutraktir kamu makan yang enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Monster-monster itu seharusnya tidak ada apa-apanya buatmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Aduh, memang benar sih, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Kalau aku bertarung dengan monster-monster itu, aku pasti jadi lupa mengumpulkan bahan-bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Waktu di Mondstadt juga begitu. Setiap kali bertarung dengan monster, aku pasti lupa dengan misiku, aku cuma fokus mengalahkan monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Sampai monster itu benar-benar dikalahkan, aku baru ingat kalau ada misi yang belum diselesaikan... Karena itu, misiku jadi gagal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Kamu benar-benar benci monster ya...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Benci? Bukan itu alasan utamanya. Sebenarnya... sebenarnya menurutku melawan monster itu menyenangkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "Pernahkah kamu merasa sangat fokus sampai hanya ada pikiran untuk mengalahkan monster di kepalamu? Rasanya benar-benar memuaskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Ah, sudahlah nanti saja ngobrolnya. Jadi, soal mengumpulkan Sakura Bloom itu, kuserahkan padamu yah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Nanti kutraktir kamu makan enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
