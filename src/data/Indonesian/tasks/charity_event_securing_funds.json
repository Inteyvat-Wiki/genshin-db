			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Bernhard"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "Berhenti! Honorary Knight yang terhormat dan Paimon \"Pemandu Paling Hebat Seantero Teyvat\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180102,
					"content": "Aku mohon kalian berdua bersedia bantu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180103,
					"content": "Eh! Benar-benar ada yang panggil Paimon begitu? Berarti reputasi Paimon akhirnya sudah tersebar luas ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180140,
					"content": "Oh, tunggu ... apa kita pernah bertemu sebelumnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180104,
					"content": "Kita pernah bertemu di Aula Utama markas Knights of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "Benar, aku Bernhard, anggota divisi logistik di bawah Kapten Hertha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180106,
					"content": "Pada waktu biasanya, aku harusnya bangun hubungan baik denganmu dulu sebelum minta tolong ... Tapi waktunya sudah terlalu mepet, jadi aku tidak punya pilihan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180107,
					"content": "Tolong bantu aku selamatkan acara penjualan amal kali ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180108,
					"content": "Selamatkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "Acara penjualan amal ... Oh ya, Master Jean pernah bahas. Memangnya sekarang gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180110,
					"content": "Begini, Knights of Favonius mau buka toko selama festival ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180111,
					"content": "Jadi idenya, semua keuntungan penjualan akan dipakai untuk kegiatan amal, khususnya untuk membantu anak-anak dan orang tua agar bisa hidup lebih layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180112,
					"content": "Dan penanggung jawab tokonya dipilih dengan sistem undian, kebetulan ... aku yang terpilih. Karena aku tidak mau kacaukan semua ini, aku sudah banyak minta petunjuk dari orang lain, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180113,
					"content": "Pengalamanku selama ini sih di bagian gudang dan logistik. Sekarang aku tiba-tiba disuruh urus toko, bahkan mau jual apa saja, aku harus pikir seharian. Ini benar-benar di luar kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180114,
					"content": "Makanya aku mau minta bantuan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180115,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "Benar, benar. Enggak perlu sungkan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180118,
					"content": "Jadi kalau dari ceritamu tadi, acara penjualan amal ini dibuat untuk anak-anak dan orang tua di Mondstadt, berarti penting banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME} itu kan Honorary Knight, Paimon juga teman lama Knights of Favonius, jadi kalau bisa bantu sedikit, kami juga senang kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180120,
					"content": "Seperti kata Paimon, kami senang bisa bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "Terima kasih banyak! Kalau gitu aku akan langsung ke intinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180123,
					"content": "Pertama, kita perlu kumpulkan <color=#00E1FFFF>Fairbrew Jelly</color> sebelum acara dimulai, karena itu adalah mata uang dasar yang dibutuhkan untuk buka toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180124,
					"content": "Pedagang anggur di sekitar perlu banyak bahan dasar untuk buat anggur. Jual bahan dasarnya ke mereka, terus mereka akan bayar banyak Fairbrew Jelly kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180125,
					"content": "Selain itu, ada beberapa pengunjung internasional yang mau beli minuman festival dalam jumlah banyak selama Weinlesefest, mereka sedang cari agen yang bisa bantu mereka mengurus pesanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180126,
					"content": "Mempertimbangkan kerja sama jangka panjang, para pengunjung biasanya berani sekali keluar harga, jadi masih ada banyak ruang untuk negosiasi dengan pedagang anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180127,
					"content": "Perbedaan antara kedua harganya itu yang jadi komisi bagi kita, dan bisa diganti dengan Fairbrew Jelly dengan jumlah yang setara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180128,
					"content": "Jadi intinya, tugas kami itu berikan bahan untuk buat anggur ke pedagang anggur, terus bantu pelanggan untuk urus pesanan dan negosiasi harga, benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180129,
					"content": "Enggak sesulit yang Paimon bayangin deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180130,
					"content": "Kalau ini sih kami jagonya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "Oh ya? Untung saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180132,
					"content": "Permintaannya ada di sini — Tuan Shevirme dari Sumeru ingin membeli <color=#00E1FFFF>50 kerat Fruits of the Festival</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180133,
					"content": "Jenis minuman ini bisa dibeli di <color=#00E1FFFF>stan Angel's Share</color>. Nama penjaga tokonya seharusnya <color=#00E1FFFF>Georg</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180134,
					"content": "Dia orang baik, tapi bukan berarti dia bisa dibodohi. Tolong pertimbangkan harganya hati-hati dan buat kesepakatan terbaik dengan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180135,
					"content": "Aku akan lanjut bangun tokonya. Kalau kalian sudah siapkan Fairbrew Jelly yang cukup, datang saja ke sini, kami yang akan ambil alih selanjutnya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180136,
					"content": "Kalian tidak perlu khawatir soal suplai di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180137,
					"content": "Aku sudah hubungi pemasoknya, setelah dananya cukup, mereka akan kirim barangnya ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180138,
					"content": "Oke, waktunya kerja! Kami beresin dana, kamu beresin toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180139,
					"content": "Ini benar-benar bantuan yang besar! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180121,
					"content": "Apa yang perlu kami lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "Setiap orang kan punya kelebihan dan kekurangannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "Halo, Tuan Georg. Kami datang mewakili Tuan Shevirme, kami mau pesan 50 kerat Fruits of the Festival untuknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180202,
					"content": "Oh? Tuan Shevirme ya? Dia pelanggan tetapku, jumlah pesanannya setiap kali pasti tidak berubah banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705180203,
					"content": "Omong-omong, tahun ini kalian rencana bayar di harga berapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME}, Paimon, kalian di sini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180302,
					"content": "Oh! Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180303,
					"content": "Halo, Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "Terima kasih! Selamat Weinlesefest juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180306,
					"content": "Weinlesefest itu salah satu festival yang paling ramai di Mondstadt, aku senang bisa ketemu kalian di sini, semoga kalian juga suka Weinlesefest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180307,
					"content": "Omong-omong, tadi aku dengar dari Tuan Georg, kalian sedang kumpulkan Fairbrew Jelly ya, benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180308,
					"content": "Aku penasaran deh, kalian sedang bantu acara penjualan amal Knights of Favonius ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180309,
					"content": "Yup! Semua orang kan harus kontribusi sedikit, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180310,
					"content": "Sekarang tokonya sih belum buka. Kami harus kumpulkan dana lagi biar mereka bisa buka tokonya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180311,
					"content": "Meski enggak tahu masalah apa yang bakal kita hadapi setelah tokonya buka, tapi kita pasti bisa selesaikan semua masalahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180312,
					"content": "Keren! Hehe ... Kalian memang bisa diandalkan! Kalau ada bantuan kalian, aku yakin pasti bakal sukses besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180313,
					"content": "Terima kasih untuk semangatnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "Aku juga pernah bantu-bantu waktu ada acara amal kecil-kecilan untuk Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180315,
					"content": "Walaupun ... caraku bantu waktu itu, cuma bernyanyi di samping toko ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180316,
					"content": "Oh ya! Waktu itu aku juga bertemu sama penyair yang namanya Venti itu loh! Dia bahkan ajak aku untuk langsung nyanyi lagu tanpa persiapan dengannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180317,
					"content": "Musik yang dia mainkan elegan sekali! Awalnya aku tidak mau nyanyi dengan suara kuat, karena jadi mengganggu gaya yang ingin dicapainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180318,
					"content": "Untung dia bimbing aku dengan suara harmoninya. Setelah itu, kami langsung bisa dapat sinerginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180319,
					"content": "Akhirnya, semua penonton menikmati pertunjukannya, barang jualan kami juga laris manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180320,
					"content": "Rupanya Barbara pernah kerja sama dengan Si Pengamen ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180321,
					"content": "Aku jadi mau dengar deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "Hmm, sayang sekali waktu di tahun ini kurang cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180323,
					"content": "Church of Favonius juga mau adakan acara nyanyi puisi di tempat yang pemandangannya indah waktu festival. Jadi aku harus pergi latihan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180324,
					"content": "Kamu pergi saja, tidak apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "Yup, pekerjaan kita semua penting sih, semangat buat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180327,
					"content": "Terima kasih! Meski aku tidak bisa tinggal dan bernyanyi di sini, aku juga mau kontribusi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180328,
					"content": "Aku bisa ... aku bisa bantu promosi toko kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180329,
					"content": "Hmmm ... aku buat poster besar atau bagi brosur saja ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180330,
					"content": "Slogannya harus yang gampang diingat juga! Kalau ada tanda tangan dariku langsung, mungkin jadi lebih bagus ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180331,
					"content": "Umm, atau promosi lewat mulut saja ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180332,
					"content": "Wah, kalau Barbara yang bantu promosiin, toko kita pasti bakal jadi terkenal deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180333,
					"content": "Sepertinya kerjaannya banyak sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "Tidak masalah kok. Tidak bakal lama. Kalau kalian ngomong begitu, aku jadi malu, duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180336,
					"content": "#Kalau gitu aku harus pikirkan lagi dan harus banyak ngobrol sama orang yang pengalaman promosi juga! {NICKNAME}, Paimon, sampai bertemu lagi yah~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180337,
					"content": "Umm ... semua orang dari Knights of Favonius dan Church pasti bangga pada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180338,
					"content": "Yup! Semangat terus ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180339,
					"content": "#Paimon jadi makin termotivasi deh sekarang! {NICKNAME}, kita harus tunjukkan yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180334,
					"content": "Sebisanya saja. Kamu sudah sibuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "Serahkan saja acara amal ini pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "Selamat Weinlesefest!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
