			},
			"dialogs": [
				{
					"id": 705182601,
					"content": "Sama seperti biasa, aku akan suruh orang kirimkan barangnya langsung ke toko Tuan Shevirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182602
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705182602,
					"content": "Tenang saja, ingat simpan saja kuitansi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182603
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705182603,
					"content": "Oke, ayo kita terus kumpulkan dana kita! Tujuan kita itu kumpulkan Fairbrew Jelly yang cukup secepat mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182604,
					"content": "Kalau menurut Bernhard, berarti asal dananya bisa terkumpul, cara apa pun terserah kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182605,
					"content": "Habis pelanggan internasional pesan, kita kan bisa dapat komisi, jadi kita enggak perlu jual bahan pembuatan anggur ke pedagang anggur lagi, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182606,
					"content": "Tapi ... biar aman, mending kita lihat-lihat ke pedagang yang lain juga deh untuk jaga-jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
