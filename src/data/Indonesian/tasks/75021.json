						"pointId": 8299
					}
				]
			},
			"dialogs": [
				{
					"id": 750210701,
					"content": "Wow! Luar biasa! Kalian betulan nemu semua pecahan bintangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "Aku banyak nabung dari uang jajanku karena bantuin Mama Coco. Aku akan kasih semuanya kalau kalian mau bantu aku cari pecahan bintang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Pecahan bintang? Buat apaan? Terus ... ngapain bocah kecil kayak kamu sendirian di luar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "Semua orang memanggilku Orqo, jadi kamu juga boleh panggil aku gitu. Tapi sebetulnya itu cuma kode sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Aku di sini karena mau ambil pecahan bintang! Kalian lihat batu besar di bawah sana, kan? itu bintang yang jatuh dari langit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Kalau kita bisa kumpulin pecahannya dan kembalikan ke tempat asalnya, kita bisa dapat kekuatan yang hilang ... Ayo dong, bantuin aku, aku butuh banget pecahan-pecahan bintang itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Kok meragukan sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Tapi ... tetap bisa dianggap petunjuk, kan? Gimana kalau kita coba dulu terus lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Tapi ya iya sih ... pecahan bintang dan kekuatan super ... Kok kayak cerita di novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "Kalian enggak pernah dengar soal Kisah Qoyllor dan Ukuku? Ayahku cerita ribuan kali, aku sampai hafal mati ceritanya. Nanti biar kuceritain ke kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Tapi ayo kita turun dan lihat dulu deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Kamu dan Orqo tiba di sebelah \"bintang jatuh\" ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Ayo cepat kembalikan pecahannya ke bintangnya! Wow ... Kira-kira kekuatan gimana ya yang bakal keluar? Mungkin aku bisa terbang ke langit ... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Wow, sebegitu hebatnya ya? Oke, kalau gitu aku tidak bisa kasih ke kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Hei, dia cuma bocah! Santai dikit lah. Dan entah ini betulan atau enggak, gimana kalau kita coba lihat dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
