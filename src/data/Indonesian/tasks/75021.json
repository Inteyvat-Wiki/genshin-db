			"dialogs": [
				{
					"id": 750210101,
					"content": "Hei, lagi ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "WAH! Aduh hampir copot jantungku! Ngagetin banget sih, gimana kalau aku sampai jatuh? Gimana kamu mau tanggung jawabnya? Kekuatan tersembunyiku belum bangkit, aku sekarang cuma anak kecil yang enggak bisa apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ah! Maaf, Paimon enggak bermaksud buat ngagetin kamu! Tapi ... Kekuatan tersembunyi? Maksudnya kayak teknik ulti super hebat gitu apa gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Hei, disebut kekuatan TERSEMBUNYI ya karena ada alasannya. Karena masih tersembunyi, jadi ya aku juga enggak tahu dong, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Iya juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Jangan bahas itu dulu deh. Bisa bantu aku temukan pecahan bintang? Aku sudah nabung banyak dari uang jajanku, hasil dari bantuin Mama Coco, nih kamu boleh ambil semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Yah, karena kamu minta tolong, minimal kasih tahu nama dulu kek. Nama Paimon ya Paimon, terus ini {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Nama yang kupakai sekarang ini cuma kode. Tapi semua orang memanggilku Orqo. Nah, jadi sekarang kalian mau bantu soal pecahan bintangnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Tapi ... Pecahan bintang tuh apa sih? Kok kayaknya bukan barang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Itu pecahan yang berasal dari bintang jatuh! Kalau kamu bisa temukan terus kembalikan ke tempat asalnya, kamu bisa dapat kekuatan super yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Lihat! Bintang jatuhnya ada di bawah, pasti ada petunjuk buat cari pecahan bintangnya di bawah sana. Ayo, bantu aku Kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Oke, oke, kali ini kami bakal bantu kamu! Tapi pecahan bintang dan kekuatan yang hilang ... Kok kayak cerita-cerita novel sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Kalian enggak pernah dengar soal Kisah Qoyllor dan Ukuku? Ayahku cerita ribuan kali, aku sampai hafal mati ceritanya. Nanti biar kuceritain ke kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Tapi ayo kita turun dan lihat dulu deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Masih muda sudah gede omong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
