			"dialogs": [
				{
					"id": 750210301,
					"content": "Fyuh! Kalau sendirian sih aku pasti enggak sanggup deh, makasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Jadi ini bintang jatuhnya? Kalau dilihat dari dekat sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaaah! Kekuatan misterius mengalir dalam tubuhku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "EEHHH?! Yang benar?! Eh, tunggu, kan kita belum nemu pecahan bintangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Ngomong-ngomong soal pecahan, memang di sini ada petunjuknya? Kok Paimon enggak lihat apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Terus sekarang gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Kita harus mengandalkan kekuatan kita sendiri. <color=#00E1FFFF>Coba hajar batunya sekuat tenaga dengan kekuatan Tepetlisaurus</color>, nah mungkin kita bisa jadi tahu pecahannya ada di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Kekerasan dapat menyelesaikan sebagian besar masalah! Itu kata ayahku sih. Tapi kekuatanku kan belum muncul, dan aku juga enggak punya kekuatan Saurian ... Jadi aku mengandalkan Kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Itu di sana ada batu aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Aneh sih ... Tapi kok Paimon enggak ngerasa ada kekuatan misterius apa pun sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
