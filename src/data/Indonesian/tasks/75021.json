			"dialogs": [
				{
					"id": 750210501,
					"content": "Harusnya sudah semua, kan? Misinya lebih gampang dari yang Paimon kira! Tapi, memangnya kekuatan misterius gitu betulan ada? Paimon agak pesimis sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Paimon juga mau kekuatan super ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Ya iya lah! Keren banget kan kalau bisa nemu harta karun atau hajar monster sekali hantam pakai kekuatan super? Memangnya {NICKNAME} enggak mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Aku mau kekuatan lebih!!!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Ayo cepat kembalikan pecahannya ke bintangnya! Wow ... Kira-kira kekuatan gimana ya yang bakal keluar? Mungkin aku bisa terbang ke langit ... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Tidak usah deh, aku sudah cukup kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Eh? Tapi bukannya perjalanan untuk menjadi lebih kuat itu adalah perjalanan yang tidak akan pernah berakhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
