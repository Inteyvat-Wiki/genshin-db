			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, kamu ngerasa ada kekuatan gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Enggak tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Batu besar itu enggak berubah sedikitpun! Enggak ada cahaya misterius, gerak saja enggak apalagi kebuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Eh, jangan-jangan mantranya salah? Tapi menurut Paimon kayaknya benar deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Kita sering banget ya ketemu situasi begini kalau lagi jelajahin reruntuhan! Kalau kamu sebut kata sandi atau gerakannya salah, mekanismenya enggak bakal gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Aneh ... Kata orang-orang, kalau aku melakukan ini, nanti bakal keluar kekuatan super ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Terus orang yang beri tahu aku langsung menutup mata dan merintih kesakitan sehabis membacanya! Enggak cuma itu, sehabis itu, dia dapat \"mata super\" yang bisa menilai permata dengan akurat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Wow, keren amat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Eh? Kok meragukan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Oh! Akhirnya ketemu juga, dasar bocah bodoh! Kenapa kamu bisa sampai keluar sini? Ayahmu khawatir banget tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "Aku kan sudah bilang aku bakal pulang pas makan malam! Kok dia malah lapor ke Mama coco sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Masih berani membantah? Kalian dua bocah di sana, ayo ikut balik! Siapa yang tahu akan ada bahaya apa kalau kalian terus di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "Kamu membawa Orqo kembali ke atas dan menjelaskan situasinya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "*huff* Dia itu cuma bocah yang senang mimpi di siang bolong. Maaf ya kalian jadi harus terlibat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "Karena tidak ada orang yang mendisiplinkan dia, makanya dia jadi nakal begini. Ibunya sudah tidak ada, dan penglihatan ayahnya cukup buruk. Sebagai tetangga, aku berusaha membantu sebisanya, tapi kan energiku juga terbatas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Ohh, gitu ya! Paimon paham! Ya memang hal gituan enggak mungkin ada sih ... Bayangin coba, kamu kumpulin beberapa pecahan batu terus tahu-tahu jadi kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Aku enggak nakal kok, ini semua demi ayah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Jangan bodoh! Ini gara-gara kamu tidak mau dengar para tetua. Setidaknya kali ini kamu selamat dan aman sentosa, tapi apa kamu pernah berpikir gimana kalau suatu hari kamu betulan ketemu bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Hmph! Cukup. Jangan nakal lagi dan ikut aku sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "Oke ... Tapi ... Nih, buat Kakak. Aku kan sudah janji, jadi ambil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Tolong ambillah. Kami tidak mau dia jadi anak yang suka ingkar janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Yah, karena kamu bilang begitu ... Kami juga enggak bakal nolak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Iya, dan mungkin lain kali aku masih butuh bantuan kalian! Kali ini kita gagal, tapi bukan berarti lain kali bakal gagal juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Bocah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "Mama Coco? Ayo, ayahku sudah nungguin kan! Kakak, makasih ya, dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Kok gejalanya familier ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
