			"dialogs": [
				{
					"id": 790260101,
					"content": "Selamat datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260102,
					"content": "Selamat datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260104,
					"content": "#Kamu kan {NICKNAME} yang terkenal itu! Dan yang ini pasti sahabat kesayangannya ... Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260105,
					"content": "Wow! Kok kamu bisa tahu nama kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "Kalian tamu kehormatan di pulau ini, tentu saja aku tahu! Dan lagi pula, aku ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260107,
					"content": "Kamu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "Aku ini Ketua Twilight Theatre yang terkenal sampai pelosok dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260109,
					"content": "Gaya, bisa-bisanya mengaku diri sendiri terkenal sampai segitunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Pelosok sebelah mana ya? Kok kami belum pernah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "Tidak penting! Soalnya sekarang kalian sudah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260112,
					"content": "Setelah dipersiapkan sedemikian lama, sandiwara \"Kisah Sang Putri Pedang\" akan segera dipertunjukkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260113,
					"content": "Sandiwara ini ada lima babak, dan satu babaknya dibagi menjadi dua bagian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260114,
					"content": "Tamu terhormat, kalian datang tepat waktu! Sandiwaranya segera dimulai! Silakan duduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260115,
					"content": "Aku harus mengurus sesuatu di belakang panggung. Permisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Ketua Twilight Theater"
				},
				{
					"id": 790260116,
					"content": "Pertunjukan terbaik Twilight Theater segera dimulai! Duduk, dan saksikanlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ketua Twilight Theater"
				}
			]
		}
	]
}