			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, kami sudah balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#Kak {NICKNAME} dan Paimon! Kalian ke sini buat main sama Puca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Bukan sih. Waktu itu kamu bilang kami boleh tanya kamu soal tambang bijih mineral, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Yep! Batu-batu cantik yang di sini sudah aku kumpulkan semua. Kamu mau cari batu yang gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "Tentang batu yang kita temukan waktu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Kamu memberi tahu Puca tentang bijih aneh yang kalian jual ke pedagang permata ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Hah? Orang luar bilang itu permata yang berharga? Padahal aku pernah kasih kakakku lihat sebelumnya ... Manusia itu sulit dimengerti ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Tapi aku tahu banyak tempat yang ada batu seperti ini! Kalau mau aku tunjukin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca menandai lokasi bijih aneh di petamu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Luar biasa! Terima kasih, Puca! Oh ya, ini Mora yang dibayar Chesil di depan untuk kita. Hehe. Aku rasa ... bisa bagikan setengah untukmu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Oh, tidak perlu kok. Hidup di desa juga tidak perlu yang seperti ini ... Lagian, kalian sudah banyak bantu aku, ini tidak berarti apa-apa loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
