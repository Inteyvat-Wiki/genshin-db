			"dialogs": [
				{
					"id": 740580201,
					"content": "Woah, banyak sekali ... Ini sangat membantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Aku sudah kirim permata ini ke pengrajin, tapi masih belum dapat barang jadinya. Mungkin karena pengrajinnya tidak tahu banyak soal permata seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Tapi jangan khawatir! Aku percaya dengan penilaianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Aku berencana buat perhiasan dengan permata ini. Ini pasti akan jadi tren terbaru di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Saat kalian datang lagi nanti, harusnya bisa lihat barang jadinya! Nanti aku berikan beberapa sampel sebagai hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Atau mungkin ... kamu bisa melihatnya dipakai bangsawan-bangsawan sebelum kamu sampai ke sini, haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Baiklah, kalian boleh kembali kapan saja.",
					"roleType": "TALK_ROLE_NPC",
