			"dialogs": [
				{
					"id": 722761201,
					"content": "Oh kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761202
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761202,
					"content": "Halo, Ya ... Ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "Yabe! Namaku Yabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761204,
					"content": "*huff* Kamu bisa tidak sih ingat namaku. Jangan bilang kamu malah sudah lupa kenapa aku mengutusmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME} hanya bercanda. Kami sudah menemukan kebenaran dari Harta Karun Rahasia Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761206,
					"content": "Kamu memberi tahu Yabe apa yang terjadi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "Jadi, memang benar ada kamar rahasia tersembunyi oleh Sunfire Phantasm? Tapi lalu ada hal lain yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761208,
					"content": "Lalu, kamar itu dijaga oleh roh pendendam dan para hantu yang gentayangan. Duh, aku takut sekali deh. Untungnya aku tidak ikut sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761209,
					"content": "Apa kamu khawatir kami bakal terluka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "Aku takut kalau kamu bakal pukul aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761211,
					"content": "Bagaimanapun, aku puas dan sekaligus agak frustrasi. Tapi Terima kasih. Tak disangka meskipun teka-teki muncul, segala sesuatu tampaknya jadi jelas dan bisa ditebak kalau ada kekuatan elemen. Tapi gara-gara itu, jadi sedikit kurang seru ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761212,
					"content": "Teka-Teki Bunkoku akhirnya terpecahkan. Aku akan mengumumkan berita ini saat kembali nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
