					"nextDialogs": [
						722760504
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760504,
					"content": "Berdasarkan catatan tersebut, tablet batu lainnya terbagi menjadi tiga bagian dan disimpan di tiga tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760505
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760505,
					"content": "Kutebak kamu pasti punya peta ringkas dari Tsumi? Biar kutandai untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760506
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760506,
					"content": "Kenapa kamu enggak bilang dari tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760507
					]
				},
				{
					"id": 722760507,
					"content": "Yah, area ini penuh bahaya. Kalau ternyata kamar rahasia tidak pernah muncul, maka tidak perlu diselidiki lagi lebih jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760508
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760508,
					"content": "Aku bakal merasa tak enak kalau aku membiarkanmu pergi ke dalam kegelapan hanya untuk main-main saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760509
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760509,
					"content": "Oke, di sini tempat batu tablet itu disimpan.",
