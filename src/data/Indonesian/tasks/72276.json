			"dialogs": [
				{
					"id": 722761001,
					"content": "Ba ... Bagaimana mungkin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761002,
					"content": "Apa yang sebenarnya terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761003,
					"content": "Bagaimana mungkin aku menyerang temanku sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761004,
					"content": "Aku pasti dirasuki oleh salah satu roh yang mendendam yang dipanggil oleh Bunkoku. Roh itu mengendalikanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761005,
					"content": "Harta karun itu tidak seberapa dibanding pertemanan kami. A—Aku tidak akan pernah tergoda untuk menyerangnya hanya karena harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761006,
					"content": "Dia memercayaiku dan bahkan mengundangku ke sini untuk menyaksikan Harta Karun Rahasia Bunkoku ... Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761007,
					"content": "Aku tidak mungkin sampai hati melakukannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761008,
					"content": "Jadi kebenarannya tertutup oleh pecahan terakhir itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761009,
					"content": "Dia kelihatannya perlu waktu untuk sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761011,
					"content": "Ayo kita balik dan ceritain hal ini ke Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
