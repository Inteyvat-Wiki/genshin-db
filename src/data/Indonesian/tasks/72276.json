						722760802
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760802,
					"content": "Jadi di sini ada Bayangan Tokoyo, ya? Apa dia ... Bunkoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760803,
					"content": "Jangan samakan aku dengan pengkhianat hina itu! Namaku Koyanagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760804
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760804,
					"content": "Tapi karena kamu tahu nama Bunkoku, apa kamu mengikuti aku sampai ke sini dengan maksud jahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760805
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760805,
					"content": "Temanku saja sampai harus banyak membaca dan menganalisis secara cermat buat menemukan Harta Karun Rahasia Bunkoku. Aku tidak akan membiarkanmu merebutnya dariku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760806
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760806,
					"content": "Kamu salah paham. Kami cuma ... um ... turun ke sini secara kebetulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760807,
					"content": "Hmph, kalau begitu cepat pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760808,
					"content": "(Seseorang sudah ada di sini sebelum kita.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760809,
					"content": "(Apa kita keduluan mereka?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760810,
						722760812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760810,
					"content": "Masa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760811
					]
				},
				{
					"id": 722760811,
					"content": "Paimon juga mikir gitu. Kalau mereka sudah berhasil nemuin harta karunnya, Teka-Teki Bunkoku enggak mungkin masih jadi misteri sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760814,
					"content": "Kalian diam-diam sedang membicarakan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760815
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760815,
					"content": "Eng-Enggak apa-apa kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760816,
					"content": "(Yah sudahlah, yuk kita lanjut selidiki tempat ini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760812,
					"content": "Mungkin saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760813
					]
				},
				{
					"id": 722760813,
					"content": "Bukan gitu. Kalau mereka sudah berhasil menemukan harta karunnya, Teka-Teki Bunkoku pasti sudah terpecahkan dari dulu. Mana mungkin sampai sekarang masih jadi misteri.",
