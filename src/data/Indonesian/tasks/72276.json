			"dialogs": [
				{
					"id": 722760201,
					"content": "Maaf merepotkan tapi apa kamu bisa lihat-lihat? Tapi tolong jangan paksakan diri juga ya. Hal \"misterius\" biasanya juga \"bahaya.\"",
					"roleType": "TALK_ROLE_NPC",
