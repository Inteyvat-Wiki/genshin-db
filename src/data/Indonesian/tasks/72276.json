			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#Hei, kamu {NICKNAME}, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "Kamu ingat aku tidak, aku Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Halo, Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Halo, halo, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "Jadi kamu cukup jago, ya? Bisa mengalahkan Raiden Shogun lalu membersihkan kegelapan yang menyelimuti Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "Bagus! Kita punya petunjuk ke harta karun tersebut, tapi bisa bahaya loh. Apa kamu yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "Walaupun aku memang senang misteri, aku tidak mau menempatkan diri sendiri dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "Iya aku tertarik. Coba ceritakan lebih detail.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Aku menemukan ini saat berpatroli di sekitar Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "Walaupun kelihatannya itu tablet batu biasa, menurutku itu adalah kunci untuk menemukan Harta Karun Rahasia Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "Harta Karun Rahasia Bunkoku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "Tidak banyak hal dari Byakuyakoku yang selamat di dalam catatan sejarah Watatsumi, jadi aku tidak tahu banyak tentang harta karun tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "Ada sebuah versi yang bilang Bunkoku adalah Perdana Menteri kedua di sejarah Byakuyakoku. Dia membebani orang-orang dengan pajak yang berat bersama Sunchild lalu menyembunyikan harta karun yang dia kumpulkan di kamar rahasia di dalam Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "Pada akhirnya, dia menyembunyikan ruang rahasia dengan Sunfire Phantasm dan memanggil makhluk kotor dan roh penuh dendam dari Ley Line untuk menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "Bunkoku memiliki nama kuno yang unik, sesuatu seperti Tye-bla bla-Eus. Tapi tidak ada yang peduli untuk mencatat cerita pengkhianat hina seperti dia dengan detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Ayo kita kembali ke tablet batu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "Mungkin ini adalah kunci untuk membuka kamar harta karun Bunkoku. Aku cukup ahli dalam pembelajaran kaidan dan kasus-kasus misterius—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Ini bacanya ... um ... duh sudah di ujung lidah nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Jujur saja kalau memang tidak bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "Sebenarnya, aku menemukan tablet batu ini di ruang penyimpanan di Dainichi Mikoshi, dan di sebelahnya ada catatan yang menyebutkan aksara kuno tersebut dan terjemahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Sepertinya dokumen itu dicatat saat pergantian zaman beserta terjemahannya. Berdasarkan catatan tersebut, tablet batu itu berhubungan langsung dengan Teka-Teki Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "Di sini juga disebutkan total ada delapan tablet batu. Sejauh ini, kita baru nemu satu. Berdasarkan catatan ini, kamar rahasia tersebut lokasinya ada di sekitarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "Maaf merepotkan tapi apa kamu bisa lihat-lihat? Aku tidak peduli soal harta karunnya, sejujurnya sih aku sudah cukup puas kalau bisa lihat Teka-Teki Bunkoku sampai akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
		{
			"id": 7227602,
