			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760301,
					"content": "Hei, kamu dengar enggak barusan? Kayaknya ada suara aneh dari atas loh.",
					"roleType": "TALK_ROLE_NPC",
