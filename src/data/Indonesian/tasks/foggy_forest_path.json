					"content": "Setetes air jernih muncul di atas altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820902
					]
				},
				{
					"id": 740820902,
					"content": "Asyik! Kita sudah dapat kunci ketiganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820903,
					"content": "Kunci! Kunci! Kunci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820904
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820904,
					"content": "Tanpa jejak, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820905
					]
				},
				{
					"id": 740820905,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Kunci, kunci, kunci!",
