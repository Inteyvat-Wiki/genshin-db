			"dialogs": [
				{
					"id": 740821001,
					"content": "Asyik! Kita ketemu lagi kuncinya. Sekarang tinggal cari kunci terakhirnya terus beres deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821002,
					"content": "Kunci, Kunci, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821003,
					"content": "Wah. Pahsiv! Kamu tiba-tiba nongol dari mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821004,
					"content": "Tanpa jejak, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821005,
					"content": "Oke deh ... kamu beneran Melusine terunik yang pernah Paimon lihat ... Oh iya, seingat Paimon kebanyakan Melusine tinggal di Court of Fontaine atau Desa Merusea ... Kok kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821006,
					"content": "Court of Fontaine? Desa Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821007,
					"content": "Kamu kelihatannya bingung. Memangnya belum pernah dengar nama-nama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821008,
					"content": "Court of Fontaine, Melusine ... Desa Merusea, Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821009,
					"content": "Ah ... Erinnyes, Pahsiv, kampung halaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821010,
					"content": "Erinnyes, Pahsiv, melindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821011,
					"content": "Tunggu, kamu bilang ini kampung halamanmu? Kamu lagi lindungi kampung halamanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821013,
					"content": "Tapi kampung halaman Melusine itu di Desa Merusea, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Iya, aneh banget deh. Memangnya ada Melusine yang lahir di tempat lain? Tapi kayaknya enggak ada Melusine lain di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821015,
					"content": "Pahsiv, kamu tinggal sendirian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821016,
					"content": "Sendirian? Melusine. Tamu itu! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821017,
					"content": "Ta-Tamu itu? Masih ada tamu lain? Tamu yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821018,
					"content": "#Tamu itu! Paimon, Paimon, {NICKNAME}, {NICKNAME}, tamu itu, tamu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821019,
					"content": "Jadi tamu itu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Pahsiv ... jangan-jangan maksudmu tamu itu ya tamu itu, sama kayak Paimon ya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821022,
					"content": "Aha! Benar kan ternyata. Apa kata Paimon ... Paimon juga pintar banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821023,
					"content": "Aneh banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Keren banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Tamu itu, Pahsiv, pengetahuan, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821026,
					"content": "Hmm ... maksudmu tamu itu ngebantuin kamu belajar pengetahuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821027,
					"content": "Pahsiv! Sangat banyak. Bahasa, kebijaksanaan ... sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821028,
					"content": "Ugh, buat Paimon kok rasanya enggak gimana banyak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821029,
					"content": "Pahsiv, tamu itu, melindungi, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821030,
					"content": "Dia juga bantu kamu lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821031,
					"content": "Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821032,
					"content": "Atau kamu yang membantunya melindungi tempat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821034,
					"content": "Ternyata gitu ... Tamu itu sebenarnya siapa? Kenapa dia butuh bantuanmu buat lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821035,
					"content": "Lagian memang terjadi kejadian hal buruk di sini juga, kan? Tulisan yang ada di tablet batu yang kita lihat hancur, terus tadi juga ada lihat kotoran yang banyak juga ... Apa mungkin musuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821036,
					"content": "Paimon penasaran, Pahsiv! Tapi waktu, sangat sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821037,
					"content": "Kunci, kunci, kunci, alun-alun, barat. buagh, bugh, buagh, bugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821038,
					"content": "Kami usahakan secepatnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv melompat dua kali dengan gembira, lalu buru-buru pergi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Kayaknya waktu sudah beneran mepet deh. Untung dua kunci lainnya sudah dapat. Kunci yang ketiga nih terakhir, bisa, bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
