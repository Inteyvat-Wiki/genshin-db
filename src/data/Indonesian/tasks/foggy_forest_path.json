			"dialogs": [
				{
					"id": 740820701,
					"content": "Setetes air jernih muncul di atas altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Eh, tetesan air ini ... ini bukan harta karunnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "Tidak mirip harta karun sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "Paimon juga pikir begitu ... Masa segampang itu dapatnya ... Tapi terus ini apaan dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "Mungkin ini kunci yang menyegel si Raja Iblis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "Hah? Kita dalam bahaya dong? WOI! Cepat balikin sebelum telat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "Habis deh! Raja iblis sudah muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "Raja iblis? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "Ah, bikin Paimon kaget saja ... Rupanya Melusine ya. Kok kamu bisa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "Kunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "Hah ... kunci apaan? Tetesan air ini itu kunci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "Hmm ... Tetesan air ini Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "Haduh! Apa sih maksudnya? Tetesan air ini Melusine? Pusing deh kepala Paimon. Apa-apaan ini? Bukannya kamu Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "Uh ... kamu Pahsiv? Atau nama kamu Pahsiv? Eh, bentar. Enggak jadi deh, Paimon bakal makin bingung nih kayaknya kalau dijawab ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "Pokoknya Paimon panggil kamu Pahsiv. Oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME} ... gimana nih? Paimon sama sekali enggak ngerti deh dia sebenarnya mau ngomong apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "Kamu bisa mengerti ucapan kami, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "Tetesan air ini adalah kunci, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "Kamu bukan manusia, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "Ugh ... kayaknya enggak baik juga deh kalau kita ngomelin dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "Aku bukan manusia, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "Me-Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "Ah! Tunggu dulu! Kayaknya Paimon mulai nangkep. Pahsiv itu artinya \"iya\", Melusine itu artinya \"bukan\". Gitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "Jadi nama kamu bukan Pahsiv. Maaf ya, Paimon salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv ... suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "Kamu suka nama ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#Hehe, ya sudah gitu saja ya manggilnya. Nama Paimon ya ... Paimon, dia {NICKNAME}. Senang kenalan sama kamu, Pahsiv. Paimon belum pernah ketemu Melusine kayak kamu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Erinnyes ... Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "Erinnyes salah? Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "Erinnyes sedang gawat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Erinnyes, Melusine, sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv, Erinnyes, lindungi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "Jadi, sesuatu yang buruk terjadi pada Erinnyes, terus kamu mau melindunginya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon, {NICKNAME}, Erinnyes, buagh, bugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#Hah ... Kali ini ada lima kata ...? Eh ... kamu mau Paimon sama {NICKNAME} ngehajar Erinnyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "Maksudnya, kamu mau kami bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "OOH! Ternyata bantu ya, untunglah. Tapi kayaknya agak susah sih kalau mau kami bantu hajar Erinnyes sebesar itu....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "BUAGH! BUGH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "Ada imbalan enggak nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Im ... balan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#Haduh, {NICKNAME}, Pahsiv susah komunikasi gini, kayaknya dia enggak bakal nemuin orang lain yang bisa bantu. Kita saja, ya? Ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "Terus kita harus bantuin gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Kunci, kunci, kunci, jumlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "Terus? Kuncinya ada berapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "Kunci! Kunci! Kunci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "Tiga kunci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! Kunci, jalan kabut, selatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "Kunci, mata air, utara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "Kunci, dedalu, timur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "Oh, jadi gitu ya ... Kalau gitu, Paimon catat dulu ... total ada tiga kunci: jalan berkabut di selatan, mata air di utara, pohon dedalu di timur ... gitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "Kunci, kunci, kunci, alun-alun, barat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "Di alun-alun barat masih ada tiga kunci lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "Kumpulin tiga kunci lalu pergi ke alun-alun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#Capek deh, Pahsiv. Kamu jangan bikin Paimon jadi kelihatan beda jauh dong pintarnya sama {NICKNAME}! Kami tuh kurang lebih sama kok pintarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "Kembali lagi deh, intinya sekarang kan kita sudah punya satu kunci, kelihatannya tinggal cari dua lagi sisanya terus beres deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Erinnyes, Melusine ... Pahsiv, melindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "Tenang saja, kami mungkin enggak terlalu paham apa yang terjadi, tapi kami pasti bakal bantu kamu lindungi Erinnyes kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "Tapi Paimon jelasin sedikit deh, Pahsiv. Kalau kamu kebetulan lihat benda berwarna kuning keemasan dan bundar-bundar yang enggak diincar sama siapa pun, atau mungkin kotak yang kelihatannya mahal banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "Kalau bisa, kamu langsung kasih tahu kami ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv menyentuh kepalanya seperti kebingungan, kemudian melompat dua kali dengan gembira, lalu buru-buru pergi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Ah, langsung pergi saja dia. Kayaknya ini urusan yang mendesak banget deh. {NICKNAME}, yuk kita cari dua kunci lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "Terus kita harus bantuin gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Mungkin orang lain yang simpan di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "Hah? Mampus deh, berarti kita sudah maling barang orang dong? Aduh, maaf ... maaf ... kami balikin sekarang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "Habis deh. Pemiliknya sudah muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "Pemilik? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
		},
