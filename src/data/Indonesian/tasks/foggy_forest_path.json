			"dialogs": [
				{
					"id": 740820401,
					"content": "(Sebagian besar tulisannya sudah rusak, hanya bisa samar-samar terbaca ... \"embun jernih ... tiga ....\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Altar Misterius"
				},
				{
					"id": 740820402,
					"content": "Ah! Tulisannya sudah hancur semua! Pasti ada rahasia deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "Embun jernih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Embun jernih? Maksudnya apa tuh? Embun yang jernih? Tapi di sekitar sini sih semuanya air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Terus ada \"tiga\". Apa mungkin tiga tetes? Duh, pusing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Ayo cepat tanyakan ke inderamu yang paling bisa diandalkan waktu cari harta karun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Sudah ditanya dari tadi! Pokoknya ... pokoknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Pokoknya berhubungan sama \"tiga\" dan \"air\" deh! Kita harus cari di sekitar dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Tiga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Tiga itu maksudnya ada tiga benda kali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "Kalau \"embun jernih\"-nya? Maksudnya apa tuh? Embun yang jernih? Tapi di sekitar sini sih semuanya air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
