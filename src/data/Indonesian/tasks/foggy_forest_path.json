				]
			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(Sebagian besar tulisannya sudah rusak, hanya bisa samar-samar terbaca ... \"embun jernih ... dinyanyikan di Jalan Hutan Berkabut ....\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Tablet Batu yang Diukir"
				},
				{
					"id": 740820102,
					"content": "Duh! Banyak banget tulisannya yang rusak! Ini semua harusnya penjelasan pemandangan, kan? Parah yah kelakuan turis yang datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Kalau turis biasanya kan cuma corat-coret saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Hmm ... Benar juga sih. Contohnya, tulis \"{NICKNAME} dan Paimon pernah ke sini bareng\" atau sejenisnya ... Eh ... Tunggu dulu, kita kan kelakuannya enggak kayak gitu. Enggak mungkin sembarangan corat-coret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Kalau begitu, aneh deh. Kok tulisannya terhapus ya? Cuma tersisa satu ini saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Bahkan di atas kalimatnya juga banyak goresan! Tebakan Paimon sih mereka hapusnya enggak sampai bersih ya! Wah, Jalan Hutan Berkabut ini beruntung banget nih, selamat dari petaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Jalan Hutan Berkabut itu apaan sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hmm ... Apa mungkin jalan di dalam desa yang banyak kabutnya? Harusnya sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Jadi ingin ke sana deh ... Kok rasanya ada misteri yang tersembunyi ya, terus ujungnya ada harta karun yang berharga. Minimal sih di buku tulisnya kayak begitu ya. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "Kamu baca buku di kios mana memangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Kamu kira Paimon kerjaannya cuma makan saja? Paimon punya firasat nih, Jalan Hutan Berkabut ini pasti punya harta karun yang tersembunyi deh, makanya sengaja ditutup-tutupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}, sudah waktunya kita mulai petualangan cari harta karun! Ayo bawa temanmu yang terbaik dan yang punya indera paling bisa diandalkan waktu cari harta karun, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "Buku yang dibaca di perpustakaan yang mana tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
