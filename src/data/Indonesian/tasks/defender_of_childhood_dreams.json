					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Menyenangkan untukmu huh... kita semua ketakutan setengah mati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "Apa itu di sana... Wow, ruangan yang besar sekali! Apakah ini ruang tamu si Kecil Bermata Satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Mengesankan, bukan? Bagaimana kalau kita bermain petak umpet sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121006,
					"content": "Eh? Sekarang? Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Hehe... aku punya kejutan untukmu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121008,
					"content": "Kejutan! Ada kejutan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Jangan khawatir, kamu akan memiliki kesempatan untuk mencarinya nanti, tetapi sebelum itu kamu harus tutup mata, balik badan dan menghitung mundur dari angka 60 ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121010,
					"content": "Baiklah... 60 ya, lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
