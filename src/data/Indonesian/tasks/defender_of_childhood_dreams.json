					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "Oh ya? Kakak di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "Ada banyak orang tiba-tiba ingin membeli si Kecil Bermata Satu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "I—Iya, jadi dia buru-buru pergi dulu. Dia tidak sengaja meninggalkanmu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Oh... begitu, baguslah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "Tapi tetap saja, aku masih ingin bermain dengan kakak sedikit lebih lama lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "Ini adalah hadiah dari kakakmu.",
