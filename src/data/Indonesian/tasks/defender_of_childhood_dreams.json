			"dialogs": [
				{
					"id": 110121101,
					"content": "Hei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121102,
					"content": "Childe? Jadi kamu ada di sini selama ini. Kenapa kamu malah bersembunyi dan tidak mengucapkan selamat tinggal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Perpisahan adalah momen spesial. Jika dia menghabiskan saat-saat terakhirnya di Liyue melihatku lemah seperti ini... aku tidak ingin memberikannya kenangan yang buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121104,
					"content": "Tetap saja, sayang sekali aku tidak bisa mengucapkan selamat tinggal padanya secara langsung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121105,
					"content": "*huff* Seharusnya aku sendiri yang mengantarnya pulang. Meskipun ada bawahanku yang mengawalnya, aku masih merasa sedikit tidak tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121106,
					"content": "Ya ampun, tidakkah kamu merasa sudah cukup memanjakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha... entah kenapa aku merasa jauh lebih nyaman meninggalkan dia bersamamu, padahal belum lama ini, kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121108,
					"content": "Ah, hampir saja lupa. Ini imbalan untukmu. Terima kasih atas bantuanmu selama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121109,
					"content": "Aha, jadi kamu memang punya hati nurani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Satu hal lagi, jangan lupakan janji kita. Ayo kita tanding ulang kalau ada kesempatan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121111,
					"content": "Kali ini, kehormatanku sebagai Harbinger yang kupertaruhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121112,
					"content": "Aku menantikannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Kamu lebih baik istirahat! Jangan menangis pada kami kalau kamu kalah lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Hahaha, tidak peduli menang atau pun kalah, aku tetap akan mengundang kalian untuk bertamu ke rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121116,
					"content": "Aku akan mengenalkan saudaraku yang lain, Tonia dan Anthon. Mereka anak-anak yang hebat, dan aku sangat bangga dengan mereka berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121117,
					"content": "Kami akan menerima tawaran itu! Terutama karena kami sudah membuat janji kelingking kepada Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Hahaha, aku yakin dia pasti senang melihat kalian. Aku menanti-nantikan hari itu. Nah, sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121119,
					"content": "Sampai jumpa, teman. Sampai bertemu lagi di Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121113,
					"content": "Aku tidak akan kalah darimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
