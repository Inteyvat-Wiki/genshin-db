					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "Aku tidak tahu bahwa ternyata ada si Kecil Bermata Satu berukuran segini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "Lihat, bahkan ada namaku di atasnya! Ini si Kecil Bermata Satu milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "Kamu benar-benar menyukainya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "Tentu saja! Kakakku adalah kakak terbaik yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "Kamu sudah jalan-jalan di Liyue, ketemu dengan kakakmu, mengunjungi Institute of Toy Research, dan mendapatkan hadiah untuk dirimu sendiri... perjalanan yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Jadi apakah kamu sudah siap untuk kembali ke Snezhnaya sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Hehe... Jangan khawatir, aku tahu aku tidak bisa mendapatkan apa yang kuinginkan sepanjang waktu dan nantinya hanya akan mengganggu orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "Ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "Si Kecil Bermata Satu akan menemanimu sebagai gantinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "Kakakmu ada urusan, jadi dia pamit dulu.",
