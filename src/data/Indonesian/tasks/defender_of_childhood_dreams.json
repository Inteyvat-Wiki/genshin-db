					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Hahaha... \"Dinginnya es akan membunuh sang pengkhianat, dinginnya es akan membekukan lidah sang pembohong.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120228,
					"content": "Sajak anak-anak ini membawa kembali begitu banyak kenangan indah. Teucer yang mengajarimu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120229,
					"content": "Pergilah dengan tenang.",
