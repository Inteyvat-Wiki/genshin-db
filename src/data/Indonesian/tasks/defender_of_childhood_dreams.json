			"dialogs": [
				{
					"id": 110121001,
					"content": "*fuhh* Akhirnya ketemu juga, kamu tidak terluka kan, Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121002,
