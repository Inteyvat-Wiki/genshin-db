				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Ini dia - selamat datang di Liyue Institute of Toy Research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120102,
					"content": "Asyik sudah sampai! Aku sudah bisa mendengar suara mesin di dalamnya. Luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Tempat apa ini? Dan bagaimana kamu bisa mengetahuinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Dari pengetahuanku yang terbatas. Kurasa ini adalah salah satu fasilitas penelitian Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120105,
					"content": "Dottore adalah salah satu dari Fatui Harbinger. Dia suka mengutak-atik barang-barang kuno, ini adalah... hasrat pribadinya. Jadi, dia mengubah reruntuhan ini menjadi laboratorium penelitian Ruin Guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120106,
					"content": "Eh? Jadi Ruin Guard dibuat oleh orang-orang Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Tidak. Mereka memiliki hubungan yang lebih dekat ke Abyss, jadi mereka adalah musuh... kami hanya melakukan penelitian saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120108,
					"content": "Tentang Ruin Guard yang telah pindah ke luar daerah ini baru-baru ini... kutebak dia bosan bermain-main dengan mereka, dan telah kehilangan minat terhadap tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120109,
					"content": "Wow, Harbinger lain dengan kepribadian buruk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Pantas saja kamu berani membawa Teucer ke sini. Sepertinya kamu sudah membiasakan dia sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Sebenarnya... tidak sampai sejauh itu. Aku bahkan tidak ada bayangan dalamnya seperti apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120112,
					"content": "T—Tunggu... memangnya kamu tidak khawatir dengan keselamatan adikmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Bagaimana mungkin... Tapi tidak peduli apa bahayanya, aku akan melindunginya. Bukankah ini memang tugas yang harus dilakukan seorang kakak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120114,
					"content": "Bahkan Teucer mengerti itu, sekarang dia tahu apa yang dia perlu perjuangkan. Alasan yang sama telah tersimpan di hatiku selama bertahun-tahun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120115,
					"content": "Apa yang kalian bicarakan? Ayo, masuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Hahaha, baiklah. Ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Untungnya, kalian berdua menemukanku duluan... Sepertinya menggunakan Transformasi Foul Legacy di saat masih cedera lebih melelahkan dari yang kuduga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120202,
					"content": "Kalau tidak, akan sangat memalukan bagiku kalau Teucer melihatku seperti ini... haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120203,
					"content": "Kamu tidak takut aku akan menghabisimu sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha! Seingatku kamu juga punya saudara kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120205,
					"content": "Kurasa kamu tidak mungkin akan menghabisiku di depan saudaraku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120206,
					"content": "Tapi kami tidak pernah berpikir bahwa kamu akan bertindak sejauh ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Seperti yang kukatakan... aku tidak akan melewatkan kesempatan untuk melatih diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120209,
					"content": "Inilah alasannya kenapa aku, Tartaglia, selalu semakin kuat... hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120210,
					"content": "Dan lagi, mimpi masa kecil adalah hal yang paling rapuh. Bahkan jika dibiarkan begitu saja, mereka akan hancur berkeping-keping dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120211,
					"content": "Jadi, seseorang harus melindungi mereka, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120212,
					"content": "Kalau kamu menjanjikan sesuatu harus kamu tepati, kalau kamu membuat kesalahan harus minta maaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120213,
					"content": "Dan kalau kamu memberi seseorang mimpi, kamu harus menjaga mimpinya sampai akhir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120214,
					"content": "Seperti inilah seharusnya sebuah keluarga, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Aha... apakah ini mengingatkanmu pada sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120217,
					"content": "*uhuk* Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120218,
					"content": "Berhentilah sok hebat! Kamu harus segera ke dokter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Saran yang bagus, tapi sebelum itu... ada sesuatu yang ingin kuberikan pada Teucer. Tolong bantu aku berikan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120220,
					"content": "Eh, apakah ini... apakah ini mainan si Kecil Bermata Satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Ya. Aku telah memesannya dari seorang penempa beberapa waktu lalu. Tadinya mau kuberikan saat aku kembali ke Snezhnaya, tetapi sepertinya ini akan menjadi hadiah yang lebih baik untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120222,
					"content": "Wow... Paimon jadi berpikir keluarga Childe sangat beruntung memiliki dia, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Ah, aku juga ingin kamu menjelaskan kepergian mendadakku kepada Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120224,
					"content": "Kamu akan membantuku kan?",
					"roleType": "TALK_ROLE_NPC",
