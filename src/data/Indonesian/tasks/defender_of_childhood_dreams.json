			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "Kakak... sepertinya ada yang bilang kalau si Kecil Bermata Satu adalah mesin pembunuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120802,
					"content": "Masa? Konyol sekali mereka bisa bilang begitu... kamu juga jangan menirukannya, Teucer. Kamu masih terlalu muda untuk membicarakan topik kekerasan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120803,
					"content": "Ya, aku tahu mereka berbohong, si Kecil Bermata Satu ada di sini untuk mengalahkan orang jahat dan melindungi dunia. Dia adalah mainan favoritku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Ya. Dengan adanya si Kecil Bermata Satu, orang jahat tidak akan pernah bisa menangkapmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120805,
					"content": "Hehe, benar sekali! Oke, aku akan bermain dengan si Kecil Bermata Satu sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Hei, Teucer, tunggu sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120807,
					"content": "P—Pintunya tertutup! Akankah Teucer baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Ada cara lain di sana, ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
