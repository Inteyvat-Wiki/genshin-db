			"dialogs": [
				{
					"id": 760240601,
					"content": "Menurutku, para Bos Weasel Thief ingin meniru para raksasa, ingin menjadikan keluarga Moley sebagai anak buah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Namun, sama kayak para raksasa, mereka juga gagal. Lembah Moley sudah dibuat kacau sama Weasel Thief, dan sekarang keluarga Moley terpaksa sembunyi di dalam lubang, entah di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "Yah, jangan ngarep gimana juga sama tikus tanah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "Iya, mereka kan cuma Sniffer Mole ... dan Weasel Thief-nya punya senjata! Eh iya, kok bisa ya Weasel Thief sampai punya barang bahaya kayak gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "Sekarang Lembah Moley sudah balik jadi milik Kakek Moley dan keluarganya. Sesuai janjiku, ini upahnya. Makasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "Oh iya, ini juga untuk kalian. Kata Helka jangan cerita fiksi tidak boleh masuk ke bukunya, nanti jadi sulit bedain mana yang benar dan mana yang dongeng belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Aku sih tidak sependapat ya ... soalnya, di dalam cerita bohong juga pasti ada sedikit yang benarnya, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#Kak {NICKNAME}, Dek Paimon, sampai jumpa. Kalau Bos Weasel Thief macam-macam lagi, aku akan minta tolong kalian lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#{NICKNAME}, kita mulai punya nama nih di sini! Semoga hewan-hewan nakal itu enggak macam-macam lagi. Kamu juga, jaga diri baik-baik ya, Auni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "#Siap. Semoga perjalanan Kak {NICKNAME} dan Dek Paimon lancar selalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Ya salah manusianya lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Cuma Sniffer Mole doang ... dan kalau dipikir lagi, Weasel Thief bisa punya mesin bahaya gitu juga gara-gara manusia ... Yah, sudah sewajarnya manusia yang beresin kekacauan akibat kelakuan manusia lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
