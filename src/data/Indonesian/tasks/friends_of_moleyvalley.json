			"dialogs": [
				{
					"id": 760241501,
					"content": "Wah, itu keluarga Moley, ada kakek, ayah, ibu, Moley kecil dan Moley yang lebih kecil ... juga semua Moley lainnya, lengkap semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Oh, jadi yang kamu cari-cari tuh Sniffer Mole ya! Tapi kok kamu bisa bedain sih? Soalnya Paimon lihat bentuknya sama semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Sifatnya dong! Soalnya beda semua. Sering-sering saja gaul sama mereka, nanti juga tahu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Tapi ada satu sifat jelek yang mereka semua punya. Itu, kebiasaan ngemis sama orang. Haah, kasihan sih mereka. Gimana jadinya kalau kita semua punah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "Punah ...? Maksudnya, manusia punah? Tapi Sniffer Mole bisa bertahan? Ma-Masa bisa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Kak Linnea pernah bilang, hewan bisa punah karena berbagai macam alasan. Berarti manusia juga bisa punah dong, masa Dek Paimon tidak tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "Yah, harapannya umur kita jangan lebih pendek dari tikus tanah, itu saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Tapi itu juga enggak menjawab pertanyaan Auni ya. Hmm, kalau dipikir-pikir, situasi manusia emang lagi bahaya sih, banyak banget yang mengancam di luar sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Balik lagi ke pembahasan utama deh. Keluarga tikus tanah sudah ketemu, sekarang mau kita apain para Weasel Thief-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Kalau tidak ada yang tahu mesti diapain, kita serahkan saja ke orang-orang The Flagship ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Harta karun! Ah, lebih tepatnya ini sogokan kali ya? Sebodo ah, kalau dikasih ya jangan ditolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Lagian mereka kelihatannya menyesal tuh. Sudahlah {NICKNAME}, kali ini kita lepasin saja ... Eh, tapi Paimon ngomong gini bukan karena dikasih harta loh ya! Jangan salah sangka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Katanya serangga sudah ada jauh sebelum manusia ada ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Dan rasanya mereka akan masih tetap ada jauh setelah manusia punah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Manusia bakal kalah dari serangga ... uh, rasanya enggak rela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
