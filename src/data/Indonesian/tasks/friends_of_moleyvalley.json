			"dialogs": [
				{
					"id": 760240101,
					"content": "Hmph, sekarang kamu enggak bisa kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Ini pertama kalinya aku melihat Bos Weasel Thief dari dekat ... Dek Paimon, kamu juga harus panggil dia \"Bos\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "A-Apa ... Najis banget-banget, Paimon enggak sudi manggil Weasel Thief \"Bos\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Benar juga, anak nakal tidak bisa jadi bos. Tidak akan ada yang datang ke pemakamannya .... malah mungkin tidak bakal dimakamkan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Oh iya, aku pernah dengar dari Helka kalau ada kelompok orang tidak jelas yang suka makan daging aneh-aneh, termasuk daging Weasel Thief. Terus ada juga yang suka koleksi spesimen ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Kalau dipikir-pikir, kalau dijadiin spesimen atau dimakan, berarti tidak usah dimakamkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Auni ... kok bisa-bisanya sih ngomongin hal yang ngeri-ngeri gitu sambil pasang tampang datar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Yang ini kayaknya sangat ketakutan ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "\"Bos Weasel Thief\""
				},
				{
					"id": 760240136,
					"content": "Berhenti, jangan kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Eh? Kayaknya dia enggak kabur, tapi ... nungguin kita ke sana? Ya sudah, samperin yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
