			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Ngomong-ngomong, Paimon baru sadar kalau Weasel Thief selalu kabur ke arah bukit kecil di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Iya, itu barang yang dibawa sama para raksasa yang melatih Bos Weasel Thief. Dulu, Bos Weasel Thief suka pakai itu buat ngehajar si raksasa, sampai mereka jatuh berguling-guling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Kejadian yang sulit dibayangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Hmm, kita cek ke bukit itu deh. Tapi awas, siapa tahu ada Weasel Thief yang mengintai di sana. {NICKNAME}, hati-hati ... jangan sampai jadi kamu yang jatuh berguling-guling~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "Duh, coba aku ada di sana ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Kamu mau bantu? Bukan! Kamu cuma senang saja lihat keributan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
