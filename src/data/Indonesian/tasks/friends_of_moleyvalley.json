						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Mungkin karena mereka selalu hidup bersama manusia, perilaku mereka jadi mirip manusia. Weasel Thief juga kayak gitu, dan katanya Saurian di Natlan juga sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Tapi tidak tahu juga sih itu baik atau buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "Hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
