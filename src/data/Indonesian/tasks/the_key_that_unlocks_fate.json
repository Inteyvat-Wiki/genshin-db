			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Hei, ada Hilichurl ... dia ... lagi bobo? Kayaknya enggak ganas tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "kenapa dia sembunyi di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Ah, kenapa dibangunin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "Wah, dia kabur! Wih, kita sengeri itu ya di Natlan? Hilichurl saja enggak mau urusan sama kita loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Ada sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "Itu, yang nyala ya? Dijatuhin si Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Hmm, Paimon yakin si Hilichurl kira dapat harta karun atau apa lah. Mungkin tadinya mau diumpetin di mana gitu ... terus kita nongol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "Paimon lihat dulu! Hilichurl memang kurang pintar, yah mungkin barangnya juga enggak ada nilainya. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#Hmm, ada apa? Kok mukanya tiba-tiba serius gitu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "Ini bukannya kunci biasa doang? Hmm, modelnya kok lucu ya. Enggak kayak barang Natlan ... dari mana ya asalnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "Ruang Hibernasi ... pesawat luar angkasa? Ruang apaan tuh? Pesawat apa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "Tunggu ... Pesawat luar angkasa ITU?!? Kayak, yang kamu naikin buat ke Teyvat?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "#Kok bisa ... tiba-tiba muncul di sini? Yakin nih bukan punya kamu sendiri, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "Enggak, punyaku masih ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Sama persis loh bentuknya! Kalau yang ini bukan punya kamu, berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Kunci ini cuma ada dua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "Tuh kan ... fiuh, kunci pesawat luar angkasa katanya. Gila, benar ya kamu ini alien yang datang dari luar sana ... eh, bukan. Istilahnya Descender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "Nah, oke, kita sudah tahu asal usulnya. Tapi pertanyaannya ... kenapa bisa ada di sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "Kayaknya penjelasan paling gampang sih saudaramu kehilangan kuncinya di dekat sini, lalu Hilichurl tadi nemuin kuncinya dan dia bawa ke gua terdekat buat sembunyiin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "Berarti ... kembaran kamu! Baru-baru ini ada di sekitar sini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "Yang artinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "Wah, enggak sangka banget. Padahal kita cuma mau bantu Iansan patroli, tapi malah ketemu hal heboh begini sekaligus petunjuk tentang saudaramu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "Mau terus ikutin jalannya sampai nemu petunjuk lagi? Atau langsung kasih tahu Iansan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "Ah, kalian di sini. Terima kasih, ini lebih dari yang diharapkan, kalian rajin sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Oh, hei, Iansan. Kok kamu di sini? Kirain baru bakal ketemu kamu lagi di kampung suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "Kami baru mau cari kamu loh. Habis nemu sesuatu yang luarrr biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Oh, aku datang untuk kasih tahu kalau kalian tidak usah patroli lagi. Soalnya kompetisi dibatalin, jadi tim patroli yang biasa bisa balik kerja. Bentar lagi orang-orangnya sampai, langsung serah terima saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "Dibatalin? Kenapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "Abyss Order menyerang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "Hah?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "Secepat itu ya dugaan kita terbuktikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#(Sepertinya {M#Lumine}{F#Kak Aether} mulai bergerak.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "(Kali ini harus bisa bicara langsung sama dia. Harus.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "Aku sudah tahu soal Abyss Order, tapi baru kali ini lihat mereka bergerak serapi ini dan dengan skala sebesar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "Mereka seakan-akan ... sedang bersiap untuk perang dengan bangsa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "Satu organisasi kecil lawan bangsa perang? Sakit jiwa ya? Mana bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "Mereka itu suka bergerak diam-diam, sejauh yang kami tahu ya. Kali ini kenapa beda? Apa tujuannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Entahlah. Intinya mereka menyerang suku Berlimpah Jaya, tapi ya informasinya baru segitu doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "Pertahanan kami masih cukup aman, aku mau ke Stadion Api Keramat untuk cari Mavuika. Kalau ada informasi seperti ini, yang harus tahu pertama itu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#{NICKNAME}, mau ikut? Aku yakin orang-orang juga akan lebih tenang kalau tahu pahlawan Natlan ada bersama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "Aku juga perlu tahu apa yang terjadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "Oke, ayo ke sana bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "Aku juga bisa kasih informasi soal Abyss Order.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "Abyss Order juga ada. Mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "Satu punyaku, satunya lagi punya ... kembaranku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "Aku selalu bawa dan jaga dengan baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "Kunci untuk ke Ruang Hibernasi pesawat luar angkasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
			"completionStepIds": [
				801603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
