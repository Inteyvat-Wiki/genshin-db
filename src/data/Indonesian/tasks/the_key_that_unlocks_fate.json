					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mavuika"
				],
				"points": [
					{
						"sceneId": 1095,
						"position": [
							7.195,
							2.863,
							0.506
						],
						"pointId": 61
					},
					{
						"sceneId": 1095,
						"position": [
							22.663,
							1.691,
							3.103
						],
						"pointId": 72
					},
					{
						"sceneId": 1095,
						"position": [
							22.617,
							1.691,
							-1.591
						],
						"pointId": 74
					}
				]
			},
			"dialogs": [
				{
					"id": 80160301,
					"content": "Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160302,
					"content": "#Oh, kebetulan sekali Iansan. Aku baru mau minta orang panggil kamu ke sini. Dan {NICKNAME} juga ada ya, lebih bagus lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160303,
					"content": "Gimana keadaannya? Ada berita apa dari para kurir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160304,
					"content": "Abyss Order muncul di wilayah semua suku Natlan, dalam waktu yang bersamaan. Ini jelas serangan terencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160305,
					"content": "Jumlah mereka lebih banyak dari perkiraan. Organisasi itu berkembang pesat, tapi ini pertama kalinya kita bisa tahu pasti karena biasanya mereka selalu bergerak diam-diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160306,
					"content": "Berarti mereka mengerahkan segenap sumber daya untuk menyerang kita ... demi tujuan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160307,
					"content": "Itu yang aku ingin tahu. Sepanjang sejarah Natlan, bangsa ini bukan tempat Abyss Order aktif bergerak, dan kita sendiri belum pernah berseteru langsung dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160308,
					"content": "Apa mungkin tujuannya ... balas dendam? Karena kita baru-baru ini berhasil menang lawan Abyss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160309,
					"content": "Rasanya itu kemungkinan kecil sekali ... tapi yah, namanya juga Abyss Order. Kata Paimon mending jangan sembarangan eliminasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160310,
					"content": "Masih terlalu awal untuk menarik kesimpulan. Untuk sementara, kita amati saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160311,
					"content": "Kondisi di lapangan gimana? Korban jatuh ... cuma sedikit, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160312,
					"content": "Yah, misalkan seluruh kekuatan mereka kerahkan untuk menyerang kita pun, tidak semudah itu kalau mau menang. Para pejuang kita yang gagah berani baru saja selesai mati-matian berjuang melawan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160313,
					"content": "Iya, itu artinya, pasukan veteran kita jumlahnya sebanyak warga bangsa ini lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160314,
					"content": "Dibandingkan dengan Abyss yang sesungguhnya, bahaya Abyss Order jauh lebih kecil. Mereka tidak bisa terus-menerus mengirimkan bala bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160315,
					"content": "Tapi ini tetap perang, dan kita tidak boleh meremehkan lawan. Harus semaksimal mungkin agar jumlah korban bisa diminimalisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160316,
					"content": "#Semua suku sudah mulai menyusun pertahanan. {NICKNAME}, perang ini cukup Natlan sendiri saja yang maju. Kalau kamu tidak ingin terlibat, diam saja di Stadion sini sampai kekacauan mereda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160317,
					"content": "Tidak, ini ... justru sifatnya pribadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "Oh? Boleh tahu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160319,
					"content": "Pemimpin Abyss Oder saat ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "Yup, benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160322,
					"content": "Ah ... astaga. Itu alasan yang sifatnya ... memang sangat pribadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160323,
					"content": "Kalau boleh tanya, kira-kira kamu tahu tidak kenapa dia melakukan ini? Apa tujuannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160324,
					"content": "Aku sendiri ingin tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "Boleh dibilang hubungan mereka saat ini ... lagi enggak baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160326,
					"content": "#Sejak Paimon pertama ketemu {NICKNAME}, dia selalu berusaha mencari {M#adiknya}{F#kakaknya}, tapi justru saudaranya yang menghindari {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160327,
					"content": "Begitu ya ... hubungan kalian sedang tidak akur. Ah, masalah yang lazim muncul ketika menyangkut saudara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160328,
					"content": "Iya, lazim, mungkin ... tapi yang dipertaruhkan jadi gawat banget kalau saudara yang ributnya yang dua ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160329,
					"content": "Memang betul ... tapi yah, aku tidak terkejut sih mendengar ribut-ribut antara Pengembara dan kembarannya bisa berdampak besar ke seluruh dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160330,
					"content": "Nah, maaf, tapi aku harus pastikan dulu. Kamu ada di pihak Natlan, dan tidak tahu apa tujuan saudaramu sebenarnya. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160331,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "Haha, syukurlah. Waktu kamu pertama bilang \"saudara\" tadi, aku sudah takut posisi dan hubungan kita langsung jadi tidak enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160334,
					"content": "Menurut info yang kita pegang, Abyss Order memfokuskan serangan mereka ke Penguasa Angin Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160335,
					"content": "Kalau tidak ingin diam di sini, kamu sangat boleh membantu ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160336,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "Aku ikut. Sekarang ini Berlimpah Jaya masih aman, jadi sebaiknya kita bantu suku-suku lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160338,
					"content": "Terima kasih banyak, kalian. Kalau perlu apa pun, silakan langsung saja bilang ke aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160332,
					"content": "Mungkin aku bahkan lebih benci Abyss Order daripada kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "Adalah kembaranku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
