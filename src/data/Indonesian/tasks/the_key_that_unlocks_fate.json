			"dialogs": [
				{
					"id": 80161001,
					"content": "Dan jangan mikir kejauhan ya, kamu ini tetap pahlawan Natlan. Tidak ada ceritanya aku menyalahkanmu atas ulah saudaramu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80161002
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80161002,
					"content": "Tapi kalau misalnya kita berhasil menemukan kembaranmu ... boleh ya aku kasih dia salam olahraga? Supaya tidak mikir untuk bikin ulah aneh-aneh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
