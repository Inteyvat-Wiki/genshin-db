			"dialogs": [
				{
					"id": 80160401,
					"content": "Huff ... sudah mendingan. Gini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160402,
					"content": "Nenek Itztli memang hebat. Kalau tahu Nenek sudah turun, aku bisa pertimbangkan ulang soal bantuan dan dahulukan berangkat ke suku lain daripada ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160403,
					"content": "Ha! Yang harus bikin pertimbangan ulang tuh Abyss Order. Salah besar mereka datang ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160404,
					"content": "Berdasarkan pengalamanku, markas mereka ada di arah datangnya serangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160405,
					"content": "Gimana kalau kita manfaatkan kesempatan ini untuk melibas markasnya? Serangan kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160406,
					"content": "Ah, barusan ada pertempuran ya di sini? Perlu bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "Ah, para pejuang Penguasa Angin Malam sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "Perang melawan Abyss masih segar di dalam benak kami, jadi semua orang masih sigap dalam berkoordinasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160409,
					"content": "Yah, semangat tinggi dan semua orang sudah kumpul. Ayo kita sikat markasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
				801605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801605",
							"2"
						],
						"stepId": 801605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlali"
				],
				"points": [
					{
						"sceneId": 20265,
						"position": [
							-1758.462,
							181.021,
							9843.676
						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "Lihat, itu Citlali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "Wah, kok ada kalian? Datang sebagai bala bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160503,
					"content": "Gimana kondisinya? Mavuika yang suruh kami ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160504,
					"content": "Wah, parah nih kayaknya ... Citlali sampai keluar rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Parah? Enggak juga sih. Cuma menyebalkan saja. Banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160506,
					"content": "Katanya kami yang paling diserang dari semua suku yang ada di Natlan. Kenapa coba? Dikiranya kami lemah apa? Payah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160507,
					"content": "Semakin dipikirin, semakin kesal jadinya. Terus aku jadi enggak bisa konsentrasi baca novel ringan, dan ... yah, intinya gitu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160508,
					"content": "Oh, Nenek Itztli terpancing gara-gara itu rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "\"Abyss Order\", gitu kan cara mereka menyebut diri sendiri? Ck, sampah. Kayak gini nama dua dimensi enggak kreatif yang dipilih sama penulis bodoh karena enggak yakin tulisannya bisa meyakinkan pembaca soal siapa penjahat sebenarnya dalam cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160510,
					"content": "Eh, dia ngejekin selera kembaranmu tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Ternyata bukan aku doang ya yang mikir gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#Hah, gimana? Kamu barusan bilang ... KEMBARANNYA {NICKNAME} tuh anggota Abyss Order?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160514,
					"content": "(Waduh, aku ngejek gitu karena kesal doang sih. Gimana nih? Kelewatan ya?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160515,
					"content": "Ah, ngobrolnya dilanjut nanti lagi. Musuh datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160516,
					"content": "Bagus, aku lagi butuh pelampiasan! Dan mereka datang di saat yang tepat, barusan kan canggung banget. Untung, aku jadi enggak akan tahu gimana kelanjutan obrolan barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160517,
					"content": "Bagian terakhirnya enggak usah sekeras itu woi, Citlali. Ya sudah, SIKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "Kalau aku jadi dia, namanya sudah aku ganti dari dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
		{
			"id": 801607,
