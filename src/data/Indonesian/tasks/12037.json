			},
			"dialogs": [
				{
					"id": 120370201,
					"content": "Sudah lama sejak kita tiba di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370202,
					"content": "Sejak itu, banyak hal yang sudah terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370203,
					"content": "Dalam sekejap mata ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "Perjalanan kita ini bisa dibilang ada banyak kemajuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370206,
					"content": "Kita mau ke mana sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370207,
					"content": "Tunggu dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "Eh, kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370209,
					"content": "Awas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "Seseorang datang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "Ada banyak hal yang masih segar dalam ingatanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
