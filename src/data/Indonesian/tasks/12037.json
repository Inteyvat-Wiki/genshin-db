			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "Hm? Rupanya kamu tidak punya Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "Sepertinya aku salah orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "Minimal ya kamu pastiin dulu dong targetnya sudah benar kalau kamu mau nyerang orangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Tunggu dulu ... enggak peduli siapa yang kamu cari, menyerang orang tiba-tiba itu bahaya loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "Apakah kalian pernah bertemu dengan seseorang yang bernama Kaedehara Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Sama sepertimu, dia juga menggunakan pedang. Aku juga dengar kalau dia memiliki kekuatan Vision Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "Kenapa kamu mencarinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Tidak ada urusannya denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "Sudahlah, lupakan. Kelihatannya kamu juga tidak tahu apa-apa. Buang-buang waktu saja kalau diteruskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "Orang ini tuh ada masalah apa sih? Datang tiba-tiba, terus main sabet-sabet pedang saja ke muka kita ... sudahnya enggak ada minta maaf pula! Benar-benar enggak waras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Mana mau kita kasih tahu apa-apa soal Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Aku setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "Iya kan, Paimon rasa dia juga enggak bisa mengalahkan Kazuha dalam duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "Tapi buat jaga-jaga sih, bagusnya kita pergi dan cari Kazuha buat kasih tahu dia supaya hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "Sebenarnya aku punya sebuah firasat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "Oh? Firasat apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Dia mungkin punya hubungan khusus dengan Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Hubungan khusus? Maksudmu, mereka saling kenal gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "Tapi ini cuma perasaanku saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Yah, sepertinya begitu. Tapi kebanyakan orang waktu mulai bertarung kan gayanya hampir mirip semua, jadi kayaknya enggak bisa jadi patokan juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "Pokoknya kita harus cepat-cepat kasih tahu Kazuha, jangan sampai dia dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "Paimon dengar Crux Fleet lagi isi persediaan di Ritou, dia harusnya ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "Gaya bertarungnya sedikit mirip dengan Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Tumben Paimon pintar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "Hei, jangan jahat gitu dong. Paimon kan dari dulu memang sudah pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
