			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Oh? Ternyata kamu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Hai, semuanya. Kami baru saja membicarakan tentang penghapusan Dekrit Perburuan Vision, kebetulan kalian di sini, ayo kita dengarkan bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Kali ini kami mengundang Tuan Kaedehara Kazuha untuk menunjukkan niat baik Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Berkat kerja keras kalian, kita dapat mencapai situasi yang damai seperti sekarang. Aku jadi memiliki kesempatan untuk memperbaiki kesalahan yang pernah keluargaku perbuat, dan aku sangat berterima kasih untuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "Yang Mulia Shogun telah merencanakan berbagai cara untuk menghilangkan atau melunakkan konflik dari masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "Tri-Commission mengusulkan mengambil kesempatan ini untuk memulihkan reputasi Klan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Kamu pernah mendengar sedikit tentang Klan Kaedehara, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Pernah dengar sedikit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Singkatnya, dulu Inazuma memiliki sekelompok pandai besi kerajaan, dan mereka mewarisi teknik menempa pedang dari Yang Mulia Shogun dan mengembangkannya. Klan Kaedehara adalah bagian kelompok ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Tapi pada titik tertentu, beberapa pandai besi membelot dan pergi ke Snezhnaya. Klan Kaedehara dan Klan Kamisato disalahkan dan diminta bertanggung jawab atas pengawasan mereka yang lemah pada saat itu, lalu Inazuma memasuki masa kekacauan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Tapi setelah itu, kami menemukan fakta kalau para Fatui-lah yang berada di balik semua ini. Menyalahkan Klan Kaedehara dan Klan Kamisato atas masalah ini sungguh tidak pantas dan tidak adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Mengingat bahwa Tuan Kaedehara Kazuha sudah memberikan kontribusi besar untuk Inazuma, Yang Mulia Shogun merasa ia tidak hanya pantas diberi penghargaan, tapi juga kompensasi atas hukuman yang diterima klannya di masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Demi mencegah penganiayaan yang dilakukan oleh Fatui terhadap klan pandai besi, kami memilih untuk tidak mengumumkan hasil penyelidikan ini. Kami harap kalian bisa mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Aku merasa tersanjung dan senang bisa mendapat kesempatan untuk menerima niat baik dari Yang Mulia Shogun dan Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Tapi, apa aku bisa menyimpulkan kalau semua kebaikan kalian ini tidak datang dengan cuma-cuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Tenang saja, bisa kupastikan kalau semua ini adalah kompensasi untuk kesalahan kami di masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Setelah reputasi Klan Kaedehara pulih, mereka dapat melanjutkan kegiatan penempaan pedang kembali, dan kamu tidak perlu berkelana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Kamu bisa menjalani kehidupan yang aman dan makmur di Kota Inazuma dengan adanya berkat dari Yang Mulia Shogun dan dukungan Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Aku telah terbiasa berkelana di tengah angin dan hujan, kurasa aku tidak akan terbiasa dengan hari-hari tinggal di dalam rumah mewah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Namun para leluhurku selalu bangga atas nama Kaedehara dan keterampilan mereka dalam menempa, maka aku memiliki kewajiban untuk memperbaiki nama baik mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Aku merasakan masih ada keraguan dalam kata-katamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Kalau kamu mau menerimanya, kurasa banyak rumor buruk yang beredar tentangmu akan langsung menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Rumor buruk? Di perjalanan ke sini kami cuma dengar puji-pujian saja sih. Sampai kami kira ada Kaedehara Kazuha lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Di mata orang, Musou no Hitotachi adalah serangan maut yang tak terkalahkan. Mereka tidak bisa menerima kenyataan bahwa Tuan Kaedehara telah menangkis serangan Shogun tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Lalu, ada saksi yang melihatnya selain menggunakan elemen Anemo, dia juga menggunakan Electro. Akibatnya gosip tentang \"Kaedehara Kazuha yang memakai Delusion\" mulai tersebar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "Hah? Mana mungkin? Orang yang pakai Delusion kan bakal cepat tua, Kazuha kelihatannya masih baik-baik saja tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Kamu benar. Tapi masih banyak orang yang tidak memahami bagaimana mungkin seseorang bisa mengendalikan dua elemen sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Ini cuma salah satu dari banyak gosip yang serupa. Aku tidak suka jadi pusat diskusi orang-orang, tidak peduli apakah itu membawa kecurigaan atau ketenaran untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Tapi mungkin ... kalau Shogunate bersedia mendukungku, masalah ini bisa cepat selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "Itu dia alasan kenapa aku menyarankanmu untuk menerima tawaran kami. Kita berdua akan sama-sama diuntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Hmmm. Tolong berikan aku waktu untuk berpikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Pembahasan ini kita hentikan sementara. Omong-omong kalian berdua kenapa bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Ah, Paimon hampir lupa sesuatu yang paling penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Kamu dan Paimon menceritakan tentang penyerangan di alam liar pada Kazuha.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Kenapa ada orang berbahaya seperti itu yang mencariku ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Kamu punya saudara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Tidak ada. Aku jadi ikut bingung juga sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Seni bela diriku ini diajarkan oleh keluargaku sendiri, yang awalnya digunakan untuk menguji pedang. Kita melewati latihan yang sangat keras untuk memastikan setiap pedang diuji dengan gerakan yang sama, agar kualitas setiap pedang dapat dipastikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Seiring waktu, teknik-teknik ini membentuk seni pedang Kaedehara. Fokusnya adalah untuk menguji sebuah pedang, tapi memiliki gerakan pertarungan yang lengkap juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Teknik ini dan teknik bela diri yang dipakai samurai di medan perang sangat berbeda, makanya sulit dikatakan kalau kesamaannya hanya kebetulan belaka saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "Kalau gitu kamu harus lebih hati-hati! Jangan-jangan dia orang gila lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Iya, dia sangat agresif. Siapa pun yang dia incar bisa terluka, atau bahkan lebih parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Kalau begitu, aku akan segera menyuruh beberapa orang untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Iya, maaf sudah merepotkan. Aku juga penasaran dengan hal ini. Aku juga masih perlu waktu untuk memikirkan tawaran kalian tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "Aku akan menyelidiki penyerangan tersebut bersama mereka, kemudian baru kuberikan jawaban yang pasti kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Baiklah. Kalian semua berhati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Ayo kita cari dan lacak si penyerang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Mungkin itu saudara seperguruanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Aku sudah lupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
