			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Hei! Halo! Apa kamu tahu Kazuha ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Kalian juga datang buat cari Kazuha? Wah, sepertinya dia baru melakukan sesuatu yang hebat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "\"Juga\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Hahaha, kali ini kami naik perahu kecil buat isi persediaan. Begitu kami sampai pelabuhan, banyak orang dari Inazuma yang bergerombol dan menanyakan tentang Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Kalau gara-gara pertempuran di Pantai Nazuchi yang lalu, Kapten Beidou juga bertarung sengit di sana, tapi dia tidak sampai populer begitu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Kazuha biasanya juga selalu sendiri sih. Kadang dia juga tidak mendengarkan perkataan Kapten, tapi Kapten juga cuma ketawa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Oh? Jadi kamu belum tahu apa yang dia lakukan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "Aku pernah dengar sedikit sih, seperti menangkis \"Musou no Hitotachi\" Raiden Shogun atau apalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "Tapi memangnya sampai sehebat yang orang-orang bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Mungkin bisa dibandingkan dengan teknik Beidou untuk mengalahkan Haishan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "Oh ya? Wow, kalau kamu bilang gitu sih ya masuk akal jadinya. Hahaha, kalau gitu semua ketenarannya ini memang pantas untuknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Tadi dia dipanggil sama orang dari Tenryou Commission karena ada hal penting yang perlu dibahas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Tadinya kupikir mereka datang untuk menangkapnya. Tapi ternyata mereka ramah sekali padanya. Sepertinya mereka memang sangat hormat pada Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Terus kalau gitu yang barusan, hmm benar-benar enggak kebayang deh kok bisa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Mungkin Shogunate mau mencoba bersikap ramah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Terima kasih! Kalau gitu, kami pergi dulu ke Markas Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Ya, aku akan tetap di sini untuk menahan gerombolan orang-orang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Lagi pula sikap Raiden Shogun juga sudah berubah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
