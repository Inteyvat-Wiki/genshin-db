			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Apa kamu benar-benar tidak bisa membuatkan salinan bagian belakang kartu ini untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "Sangat mengesankan. Mungkin kita bisa membuat semacam kesepakatan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Aku paham. Mendapatkan kartu yang indah dan memainkan kartu yang kuat membutuhkan harga tertentu. Aku bisa mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "Sepertinya tidak sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "Hei! Kamu kan enggak tahu kenapa Cyno di sini! Dia mungkin ke sini buat—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "Tentu saja. Kamu memang teman baikku, kita benar-benar sepemikiran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Seriusan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "Ada pertemuan kecil para pemain TCG yang sedang berlangsung di Fontaine. Aku dengar para peserta mendapat tempat kartu eksklusif secara gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "Aku sedang tidak ada urusan penting di Akademiya, jadi aku datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Meskipun ada urusan penting pun, Paimon rasa pasti bakal kamu anggap enggak penting lagi demi acara ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "Kamu benar! Aku berhasil menyelesaikan hampir semua pekerjaanku setelah lembur hanya dua minggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos juga membantuku, jadi aku berjanji membawakan kartu keren untuk dia sebagai ucapan terima kasih. Dia sangat mahir soal urusan dokumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Kalau begitu, Mahamatra Agung, apa kamu mau mengambil kartu atau tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Tentu saja. Kamu bilang kartu ini akan memprediksi masa depanku, benar begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Secara teknis, tidak sepenuhnya benar. Tapi sepertinya tidak akan menimbulkan masalah besar kalau kamu mau memahaminya seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Ternyata begitu ... Apa ini seperti kalimat di \"Raja Duel\"? \"Pertaruhkan takdirmu pada kartu berikutnya yang kamu ambil\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "Dan sekarang giliranku mengambil kartu ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno menarik napas dalam-dalam, melakukan pose yang keren, lalu mengambil sebuah kartu ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Ah, kartu Kesederhanaan yang terbalik. Kartu yang cocok untuk sang \"Mahamatra Agung\" dari Akademiya Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "Kamu sudah tahu siapa Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice cerita tentang dia beberapa kali. Menurutnya lucu karena Akademiya yang kaku itu punya Mahamatra Agung dengan selera humor yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Tolong sampaikan terima kasihku atas pujiannya. Sekarang setelah aku menarik kartu, apa yang harus kulakukan selanjutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Karena ini adalah kartu Kesederhanaan terbalik, atau lebih tepatnya \"Kesenian\" yang terbalik, aku sarankan kamu untuk tidak melakukan apa pun untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "Kamu selalu bertindak gegabah dan hampir kehilangan pijakanmu di jembatan takdir yang sempit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "Apakah ini karena aku terlalu sering main kartu? Sethos dan Tighnari juga sudah bilang begitu, tapi aku sudah menyesuaikan jadwalku kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "... Aku bukan berbicara soal main kartu. Maksudku jam kerjamu. Pastinya Genius Invokation TCG bukan satu-satunya hal yang menyita perhatian penuh Mahamatra Agung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "Tapi tugasku ... bisa dibilang tidak terlalu fleksibel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "Kamu terbiasa menanggung tekanan dari jadwal yang ketat seperti ini sendirian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "Ada Matra yang lain. Kami saling berbagi beban ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "Tapi mereka semua mengandalkanmu? Tidak hanya para Matra, tetapi juga para peneliti dan rakyat Sumeru ... Begitu banyak orang yang menaruh kepercayaan mereka padamu, Mahamatra Agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "Mereka tidak pernah bilang padamu, bahkan mungkin mereka sendiri tidak menyadarinya ... Kenapa harus bilang, ketika mereka semua terpesona oleh kecerdikanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "Tapi kamu bisa merasakan tatapan mereka, yang menatapmu siang dan malam ... Oh, dan bayangan yang berjalan di sampingmu. Dia juga salah satu bebanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "Kamu terbiasa memimpin, memikul beban orang lain ... Aku rasa, mungkin ini alasan dari ketidakseimbanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "Aku punya banyak teman, dan Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "Jadi sepertinya kamu tidak berniat untuk istirahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "Tidak ada waktu untuk istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "Benar. Untuk seseorang sepertimu, jika pertempuran batinmu tidak ada habisnya, bahkan setelah mati pun tugasmu masih belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Ambillah kartu Lunar Arcana ini. Mungkin bisa menuntunmu pada alasan yang akan mengembalikan keseimbanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "Saat itu terjadi, pertarungan di dalam dirimu juga akan mencapai akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno tidak akan kalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Terima kasih, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "Dan terima kasih untukmu juga. Jangan khawatir, aku janji tidak akan berutang dulu pada siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "Hah? Kenapa tiba-tiba jadi ngomongin utang? Tunggu dulu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Wah, lagi-lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "... Apa hubungan semua ini dengan utang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930154,
					"content": "Karena baru saja aku mengambil kartu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930155,
					"content": "\"Lunas\" Arcana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930151,
					"content": "Dia dapat inspirasi baru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Barbeloth, jangan tanya—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Cyno paling kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "Sepertinya aku tidak mengerti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "Kamu datang sejauh ini hanya untuk bermain kartu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
