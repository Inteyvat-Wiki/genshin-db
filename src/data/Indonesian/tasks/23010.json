					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "Oh, aku bisa lihat kamu lelah dan tidak banyak waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100804,
					"content": "Kamu pasti punya urusan yang harus segera diselesaikan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100809,
					"content": "Daripada rusuh begitu, mending ikut aku makan enak. Tapi tunggu sebentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100810,
					"content": "Sibuk berlari ke sana kemari memang sudah kodrat hidup, tapi ... Sungai yang deras pun kadang menjadi aliran air yang tenang, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100811,
					"content": "Sesibuk apa pun, tetap harus istirahat, relaksasi sejenak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100812,
					"content": "Coba kupikir-pikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100813,
					"content": "Mending kita makan Shawarma Wrap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100814,
					"content": "Tidak usah bayar. Bawa Raw Meat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "Terserah mau cari dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Ingat, Raw Meat. Cuma cari daging, bukan cari perkara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100805,
					"content": "Tidak juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "Oh, baguslah kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100807,
					"content": "Kamu sangat terburu-buru. Aku kira kamu sedang ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100808,
					"content": "Ugh, walaupun aku tidak tahu apa yang mau kamu urus, tapi aku punya saran ....",
