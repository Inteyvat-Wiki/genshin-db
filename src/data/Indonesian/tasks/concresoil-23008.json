			"dialogs": [
				{
					"id": 230080101,
					"content": "Sebentar lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "Pengembara! Tunggu dulu, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Slime Condensate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "Masalahnya gini. Aku mencampur tanah yang kalian bawa dengan bermacam formula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "Setelah banyak gagalnya, akhirnya aku dapat rasio pencampuran yang pas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "Tanah Beton dengan rasio seperti ini akan kurang bisa dibentuk sebelum mengeras, tapi setelah itu akan menjadi kokoh dan tahan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "Aku rasa perlu sedikit lagi Slime Condensate dalam tanahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "Pengembara, boleh bantu cari tiga Slime Condensate lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "Kalau ada Slime Condensate, pasti bisa jadi tanah yang sesuai keinginan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "Perlu apa lagi kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
