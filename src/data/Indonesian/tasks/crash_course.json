				{
					"id": 3071101,
					"content": "Datang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "Sini. Kecium tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071103,
					"content": "Tidak ada bau apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "Ada yang terjadi di dalam <color=#00E1FFFF>kuil</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071106,
					"content": "Di dalam pasti ada Slime, Hilichurl, dan apa pun yang memberikan tambahan kekuatan pada Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071107,
					"content": "Asyik, di dalam pasti ramai sekali tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071108,
					"content": "Bahaya dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "Ramai sih ramai, tapi kalau bahaya ... kurasa tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071112,
					"content": "Sedih juga melihat Temple of the Wolf diganggu seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071113,
					"content": "#Ayo masuk, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071114,
					"content": "Sudah tidak ada lagi yang beribadah ke Four Winds, tapi angin kuno ini masih terus ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071115,
					"content": "Kita bersihkan kuil ini, untuk Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071110,
					"content": "Cuma gerombolan makhluk kacau pembuat onar biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Wuidih! Nyalimu boleh juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
