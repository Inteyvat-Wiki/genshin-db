			"dialogs": [
				{
					"id": 3071501,
					"content": "Bravo! Keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "Mengejutkan sekali. Kamu ternyata petarung yang sudah terlatih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "Pertempuranmu tadi sangat menakjubkan mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Jangan berlebihan ah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Ahaha, rendah hati sekali. Bahkan nilai-nilai kepribadian seorang Knight pun kamu sudah punya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Kisah tentang bagaimana kamu menyelamatkan Mondstadt dari kehancuran akan dikenang sepanjang masa oleh semua penduduk Kota Kebebasan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Kalau ada waktu, mainlah ke markas kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "Atau ke kedai anggur saja, kalau kamu lebih suka tempat seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
