			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "Sepertinya sekarang kekuatanku sudah cukup untuk membantu mengawal barang-barang keramat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Dengan begitu, akhirnya aku bisa beristirahat dengan tenang. Barang-barang tersebut harus dikirim, karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Karena apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Karena ... karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "O-oh. Kok dia kayak mesin yang mau rusak gitu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Mungkin ini barang-barang yang dia bilang maksud tadi ... Kelihatannya agak rusak sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
