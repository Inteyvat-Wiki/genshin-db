			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470301,
					"content": "A-ada sesuatu yang keluar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470302,
					"content": "Sepertinya ada bayangan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470303,
					"content": "Namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470304,
					"content": "Aberaku, sang pencipta Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470305,
					"content": "Ooh, Paimon tahu yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470306,
					"content": "Jadi yang dia bilang adalah—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470307,
					"content": "Dia yang membangun Helios, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470308,
					"content": "Kamu dengar dia tidak sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470311,
					"content": "Aberaku ... nama yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470312,
					"content": "Tunggu, kalau dia Aberaku, Helios itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470313,
					"content": "Ah, Helios! Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470314,
					"content": "Ciptaanku ... Helios! Saat sudah selesai, cahayanya menyebar sampai seluruh cakrawala, sehingga semua orang tidak akan diserang oleh naga dan binatang buas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470315,
					"content": "Bagaimana orang-orang memandangnya dengan terkagum-kagum pada saat itu! Bagaimana mereka menangis terharu, mengangkat tangan mereka dengan tangisan penuh sukacita, tidak mampu menahan emosi mereka yang begitu meluap-luap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470316,
					"content": "Tidak, tunggu. Ke-Kenapa aku di sini? Kenapa jiwaku malah tersesat di alam mimpi dan tidak bisa menemukan ketenangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470317,
					"content": "Paimon sudah mengerti belum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "Sudah dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470319,
					"content": "Jiwa ini kelihatannya ... tidak tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470320,
					"content": "Aku ingat sekarang! Jiwaku tidak penuh! Kalau jiwaku penuh kembali, aku bisa kembali damai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470321,
					"content": "Peranmu sangat penting di sini, jadi biar kukatakan padamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470322,
					"content": "Duh, sepertinya akan ada pekerjaan merepotkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470323,
					"content": "Sebagian dari tulangku seharusnya dikeramatkan di tempat ini, tapi sudah membusuk sejak lama sekali ... Tolonglah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470324,
					"content": "Ambillah benda-benda milikku yang telah dikeramatkan ini, bersamamu ... Tetapi jiwaku terperangkap oleh para monster yang berdiam di sini, dan mereka akan mengerubungi saat aku pergi dari benda tempat jiwaku beristirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470325,
					"content": "Hal ini sangat berbahaya. Beri tahu aku jika kamu telah siap, wahai Pengembara, lalu akan kita mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470309,
					"content": "Bukan, namanya Aberaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
