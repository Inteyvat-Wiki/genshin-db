			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "\"Ada yang tahu di mana mencari pendongeng? Emm, orang itu harus bisa menceritakan dongeng sama persis dengan aslinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951002,
					"content": "\"Aku dihantui oleh Jinni yang menakutkan. Dia mengancam akan membunuhku kalau aku tidak menceritakan cerita yang sama persis setiap hari. Sebulan sudah berlalu dan otakku terus berdengung, benar-benar menyiksaku ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951003,
					"content": "\"Pengalamanmu benar-benar aneh. Tapi aku dengar ada seorang pendongeng bernama Maddah di Kafe Puspa, siapa tahu dia bisa bantu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "\"Sudah banyak negara yang pernah kukunjungi dan melihat pertunjukan yang sudah tidak terhitung lagi jumlahnya. Tarian Nona Nilou adalah yang terbaik di Teyvat, aku tidak meragukannya. Tapi beberapa orang dari Akademiya tidak hanya gagal menghargainya, namun juga mencelanya. Benar-benar sebuah penghinaan terhadap seni!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951102,
					"content": "\"Berdasarkan pengalamanku di Mondstadt, kita harus mendirikan sebuah klub penggemar untuk Nona Nilou. Dengan begitu orang yang tidak tahu apa-apa tentang seni tidak lagi berani mencemoohnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951103,
					"content": "\"Klub penggemar ... Apakah itu bagian dari budaya Mondstadt? Tapi, pertunjukan yang sempurna adalah hasil dari usaha bersama dari semua anggotanya. Kalau perhatiannya hanya tertuju pada satu orang saja akan sulit dilakukan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951104,
					"content": "\"Lagi pula aku yakin kalau seni itu sendiri bisa menjadi pengikat dari seorang ke yang lainnya. Senang mengetahui Anda menyukai pertunjukan tari Nona Nilou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951105,
					"content": "\"Dilihat dari gaya tulisan tangan yang anggun ini, pastinya Anda adalah seorang wanita muda, bukan? Luar biasa rasanya bisa bertemu dengan orang yang membagikan minatku di pertunjukan tari ini. Kalau Nona ada waktu, apa boleh kita bertemu dan mengobrol bersama?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951106,
					"content": "\"Maaf, saya sangat sibuk. Kalau ada keperluan bisa dibicarakan dengan manajer saya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951107,
					"content": "\"Sepertinya pemuda ini ditolaknya. Pesan di halaman terakhir secara jelas ditulis oleh seorang lelaki kekar, mungkin saja dia adalah pengawal wanita kaya itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "\"Dijual botol Jinni ajaib. Masukkan satu Mora saja ke dalamnya dan permohonan apa pun akan dikabulkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951202,
					"content": "\"Botol ajaib, dijual! Satu Mora saja! Permohonan apa pun akan dikabulkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951203,
					"content": "\"Aku adalah Jinni. Cukup berikan aku satu Mora saja, dan aku akan memenuhi semua keinginanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951204,
					"content": "\"Citadel of Regzar sedang menginvestigasi kasus penipuan berantai yang terjadi baru-baru ini. Harap jangan panik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951205,
					"content": "\"Bagi para korban yang punya pertanyaan bisa berkonsultasi hanya dengan satu Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
