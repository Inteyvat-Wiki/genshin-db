			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "\"Dulu kudengar Diwan pernah membantu bicara orang awam seperti kami. Tapi sekarang dia cuma mematuhi apa yang Mahamata katakan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951602,
					"content": "\"Seperti Vizier, dia biasanya tidak pernah memegang omongannya. Dia cuma ada ketika Mahamata mencoba untuk mangkir dari tanggung jawabnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951603,
					"content": "Panduan Akademiya ke semua badan administratif didasarkan pada peninggalan Greater Lord Rukkhadevata. Harap jangan memfitnah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
