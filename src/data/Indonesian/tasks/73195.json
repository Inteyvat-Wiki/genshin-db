		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Pemberitahuan: Kami mencari ahli untuk menangani Rishboland Tiger ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950202,
					"content": "Pesan pemberitahuan itu dicoret dengan kuas. Di sampingnya ada kalimat miring, tulisan tangan yang kekanak-kanakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950203,
					"content": "\"Rishboland Raja hanya ingin bermain dengan orang-orang!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"Jika Anda menjumpai peri yang menari sesudah memakan shrooms, ini adalah reaksi normal dan tidak perlu dikhawatirkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950302,
					"content": "\"Tapi jika Anda menjumpai tanaman di sekitar mulai berbicara, harap segera minta bantuan dari Penjaga Hutan secepatnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Karena alasan yang tidak jelas, 'The Withering' sudah menunjukkan tanda-tanda akan meluas di dalam hutan, baik dari segi jumlah maupun ukuran.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950402,
					"content": "\"'The Withering' tidak hanya bisa menimbulkan tumbuhan layu, namun juga bisa mengancam nyawa hewan dan manusia. Oleh karenanya Pelindung Hutan sudah menandai area tersebut sebagai 'Zona yang Terkontaminasi'. Mohon jangan mendekat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950403,
					"content": "\"Jika Anda mendapati The Withering baru sepanjang perjalanan Anda di hutan, harap hubungi Petugas Penjaga Hutan terdekat supaya dapat ditangani secara profesional.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Matra baru-baru ini menemukan beberapa kasus perdagangan Kapsul Pengetahuan ilegal selama inspeksi di beberapa lokal Bazaar setempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950502,
					"content": "Perdagangan Kapsul Pengetahuan dilarang oleh Akademiya dan akan mendapatkan hukuman berat jika ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950503,
					"content": "Akademiya tidak bertanggung jawab atas konsekuensi yang ditimbulkan dari penggunaan Kapsul Pengetahuan ilegal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"Festival tahunan 'Sabzeruz' akan segera datang. Festival besar-besaran akan digelar di Grand Bazaar seperti tahun lalu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950602,
					"content": "\"Untuk memeriahkan suasana festival, nona kami sudah menyiapkan subsidi khusus untuk para peserta dagang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950603,
					"content": "\"Mari kita rayakan bersama hari lahirnya Lesser Lord Kusanali!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"Nona kami meninggalkan rumah belum lama ini dan sampai sekarang belum juga kembali. Jika Anda menemukan gadis berambut cokelat, mengenakan atasan berwarna ungu dan rok biru muda, mohon untuk menghubungi Klan Homayani. Kami sangat berterima kasih atas bantuan Anda!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950702,
					"content": "\"Kalau nona kami melihat pengumuman ini, tolong segera hubungi keluarga kami. Orang tuamu sangat mengkhawatirkanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"Dia kembali! Tuanku, Al-Ahmar sudah kembali!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950802,
					"content": "\"Hari kedatangannya kembali akan menjadi hari ganjaran bagi kalian yang kepalanya ditumbuhi daun itu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950803,
					"content": "Ini adalah berita palsu, kami sedang menginvestigasi sumbernya. Apa pun yang terjadi di Sumeru akan dipublikasi secara teratur melalui Akasha. Dianjurkan untuk tidak memercayai rumor apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"Temanku, apa kamu sedang dalam kesulitan? Yang maha kuasa Lord Sangemah Bay akan dengan tulus memberimu jawaban atas semua permasalahanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950902,
					"content": "\"Asalkan kamu bisa mengeluarkan sedikit Mora, semua masalahmu pasti bakal beres.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950903,
					"content": "\"Bergegaslah sebelum terlambat! Informasi kontak ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731950904,
					"content": "Papan Pengumuman ini dipasang oleh Tuan Vizier untuk mengatur perilaku jual beli pasar. Harap jangan menempel iklan apa pun di papan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
