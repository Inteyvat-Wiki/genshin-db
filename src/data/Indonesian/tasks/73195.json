			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Kalau kamu ketemu orang dengan tatapan kosong atau sedang menggumam sendiri di hutan, mereka adalah peneliti dari \"Kehidupan Satyavada\". Tolong jangan diganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951502,
					"content": "Kalau Anda merasa terganggu, harap laporkan ke Mahamata supaya dapat ditangani dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
