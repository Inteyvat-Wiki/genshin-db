			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"Sepertinya dulu ada prajurit bayaran yang lumayan baik, seingatku namanya 'Flame-Mane' atau apalah ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951402,
					"content": "\"Dulu aku selalu menyewanya untuk mengawalku tiap kali ada urusan bisnis di luar. Treasure Hoarder ataupun Millelith sekalipun tidak lagi terasa menakutkan selama ada dia. Berkat dia juga aku bisa mendapatkan rezeki yang besar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951403,
					"content": "\"Tapi akhir-akhir ini sepertinya dia tidak lagi menerima komisi, dan kudengar monster di perjalanan menuju Liyue bertambah banyak ... Kalau seperti ini terus aku cuma bisa menaruh uangku di Bursa Kalimi saja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951404,
					"content": "\"Yang kamu lakukan itu sepertinya bukan bisnis yang legal ... Tapi kalau yang kamu maksud itu adalah \"Flame-Mane\", aku dengar dia terima misi besar dari Klan Homayani. Jadi kamu perlu menunggunya agak lama deh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951405,
					"content": "\"Saran saja sih, kalau ada uang lebih baik kamu belikan 100 karpet saja dan jangan investasi di Bursa Kalimi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951406,
					"content": "\"Kamu benar! Harap kunjungi toko kami dan belilah 100 karpet. Biar kujelaskan lebih rinci tentang cara menggunakannya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
