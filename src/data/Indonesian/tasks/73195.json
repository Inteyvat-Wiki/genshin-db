			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "\"Setelah menjadi Pelindung Hutan, seluruh waktuku kuhabiskan di dalam hutan. Lama kelamaan aku jadi ingin bicara dengan Dusk Bird.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Papan Pemberitahuan"
				},
				{
					"id": 731951302,
					"content": "\"Seandainya saja aku bisa mengerti apa yang mereka bicarakan, pastinya aku tidak akan sebosan ini tiap harinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pemberitahuan"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
