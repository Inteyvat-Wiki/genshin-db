			"dialogs": [
				{
					"id": 120480101,
					"content": "Halo, permisi! Silakan daftar dulu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120480102,
					"content": "Ada apa ini? Kenapa tamunya banyak sekali? Kalau tahu begini pasti kutolak beberapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120480103,
					"content": "Wow, setelah masalah Emura Ichigensai itu beres, bisnisnya jadi ramai nih! Murasaki dan Shion juga sudah semakin sehat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480104,
					"content": "#Pagi, {NICKNAME} dan Paimon. Kalian mau buat janji juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480105,
					"content": "Mau dong! Kalau bisa buat hari ini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480106,
					"content": "Kalau begitu lebih baik kusiapkan VIP pass lagi karena kalian ini tamu paling penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480107,
					"content": "Hehehe, asyik! Kalau begitu Paimon si VIP mau mulai dengan makanan mewahnya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480108,
					"content": "Wah, wah. Bayangkan kalau kamu menuruti saranku untuk menjual sahammu waktu itu. Pasti rugi besar karena sekarang bisnisnya jadi ramai lagi. Kuharap kamu tidak marah padaku, teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480109,
					"content": "Kenapa aku harus marah? Saranmu tidak pernah kuanggap serius kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480110,
					"content": "Ah, kamu memang paling pandai bicara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480111,
					"content": "Serius deh, kenapa munculnya selalu harus tiba-tiba begitu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480112,
					"content": "Halo, bocah-bocah. Apa kalian suka pemandangan kemarin malam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480113,
					"content": "Kamu ... mengintip kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Mengintip? Pohon itu ada tepat di bawah Kuil Agung Narukami. Masa aku harus pindahkan kuilnya untuk menjaga privasi kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480115,
					"content": "Kenapa kamu datang ke sini, Nona Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480116,
					"content": "Heh, sebenarnya aku ingin jalan-jalan saja. Tapi kebetulan aku juga punya pesan dari Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480117,
					"content": "Pria yang diselamatkan oleh teman yumekui-baku kalian sudah keluar dari kondisi kritis. Tapi mentalnya kembali menjadi seperti anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480118,
					"content": "Kurasa begini juga ada baiknya ... terima kasih, Nona Guuji. Kemarin bisa berjalan lancar juga berkat bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480119,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480120,
					"content": "Bukan aku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Ayolah, Miko. Kamu selalu tidak pandai menjaga rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480122,
					"content": "Jujur saja aku memang merasa inferior di dekatmu dan merasa perlu membuktikan diriku. Bagaimana bisa tidak? Tapi mungkin karena inilah aku jadi termotivasi untuk mengembangkan bisnis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480123,
					"content": "Perasaan inferior ini menjagaku tidak tunduk pada ego, perasaan ingin membuktikan diriku membuatku bisa terus bertahan. Aku sudah menerima perasaan ini sebagai bagian dari diriku, kamu tidak perlu menganggapnya tabu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480124,
					"content": "#*huff* Kamu kan bisa bilang dari dulu ... Kasihan {NICKNAME} kan, jadi dia yang harus kusuruh-suruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480125,
					"content": "#Masuk akal, tapi jujur saja tanpa bantuan {NICKNAME}, posisimu juga jadi terancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480126,
					"content": "Emura Ichigensai berhasil mengumpulkan banyak pengikut. Jadi bisa bahaya kalau Guuji dari Kuil Agung Narukami mau melawannya terang-terangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480127,
					"content": "Para pengikut yang murka bisa merusak nama baik Kuil Agung Narukami ... lebih baik kalau Guuji tidak terlibat secara langsung. Keputusanmu sudah tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480128,
					"content": "Meskipun semua itu benar, tapi yang utama adalah aku tidak mau membuat kawan lamaku kesal. Kalau tidak, aku akan menggunakan cara yang lebih langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480129,
					"content": "Miko ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480130,
					"content": "Aku sering lupa kalau kamu jauh lebih cerdik daripada penampilanmu. Sepertinya aku tidak perlu khawatir membuatmu kesal ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480131,
					"content": "Bukannya aku tidak bisa kesal. Setiap orang punya masalah masing-masing, tapi semua itu ada obatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480132,
					"content": "Ini VIP pass barumu. Jaga baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
