				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Akhirnya selesai! untung aku masih ingat cara membuatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Sekarang langsung masuk dan memurnikan Tatarigami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Memang lebih cepat lebih baik, tapi ingat kita sedang berhadapan dengan Tatarigami. Tak boleh lengah sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Lagi pula, ada material yang terpaksa pakai substitusi karena kurang bahan, jadi sejauh mana alat ini bisa berfungsi aku juga tidak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Hmm... lebih tepatnya, \"Dalam keadaan tertentu, ada kemungkinan tidak dapat berfungsi sesuai perkiraan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Untuk penggunaan normal sih pasti baik-baik saja, tapi aku tidak yakin alatnya dapat bertahan jika terjadi sesuatu. Kalau terbentur, mungkin bisa ada yang lepas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Karena itu, sebelum alat baru ini beraksi, kita masih perlu persiapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Tolong kamu cari data di sekitar \"Mikage Furnace\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "Oke, biar kuurus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Kalau begitu tolong ya, kutunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "Hati-hati sekali ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Tentu saja harus. Aku sudah melangkahi banyak prosedur. Kalau Tuan Flois ada di sini, masih perlu waktu seminggu lagi kalau kita kerja sesuai prosedur beliau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "Pokoknya, kali ini pengecualian lah. Nah, sebagai perwakilan tim evaluasi... aku mengizinkan kita bertindak sesuai kebutuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
