			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Bagus, coba lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Kita beruntung, Mikage Furnace masih cukup stabil, dan tingkat saturasinya belum terlalu pekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Di tingkat segini, harusnya alatku kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Apa kita mau memurnikan semua energinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Kalau alat ini bisa begitu, sejak awal sudah kuajukan hak patennya. Alat ini paling hanya bisa menurunkan tingkat energi di area tertentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Namun, alasan Mikage Furnace mati dan prosedur restart otomatis gagal berfungsi adalah karena tingkat saturasi energi Tatarigami yang sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Asal kita bisa menemukan area dengan tingkat saturasi paling tinggi dan memurnikannya, prosedur restart akan berfungsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "Setelah prosedurnya jalan, Mikage Furnace akan kembali aktif, dan urusan setelahnya sudah bukan ranah kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Itu rencananya. Tapi sebelum kita jalan, aku masih perlu sedikit lagi persiapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
