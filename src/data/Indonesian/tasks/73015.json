				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "Kamu pasti Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "Wow! Ke-Ketahuan sama Nara! Gi-Gimana ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "Jangan lari! Arapandu yang kasih tahu kami kamu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "Ternyata Arapandu yang memberi tahu kalian. Berarti kalian pasti Nara yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Hmm? Jangan-jangan Aranakula bisa mudah saja dibohongi ya? Coba saja kalau Nara {NICKNAME} itu jahat, terus pakai saja nama Arapandu buat ngebohong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "Yah! Jadi Nara Emas, sedang membohongi Aranakula? Nara Emas, sebenarnya adalah Nara jahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "Kok Paimon jadi ngerasa bersalah gini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "Jangan dengarkan Paimon, aku adalah Nara baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#Baguslah, terima kasih Aramuhukunda, Nara Emas ternyata memang Nara yang baik. Meski Nara {NICKNAME} jauh lebih tinggi dari Aranakula, aku tidak takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Paimon ... Paimon juga kecil, Aranakula juga tidak takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "Paimon kecil, memang benar sih kecil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Jangan ngeremehin gitu WOI! Cih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Sudah, sudah ... ayo ngomong hal serius. Kami datang buat nyembuhin Varuna Contraption, di bagian \"Vana\" sini seharusnya ada \"cabang\" dan \"daun\" Varuna Contraption, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Arapandu minta kami buat datang lihat-lihat kondisi. Dan kalau kamu ada masalah, kami juga bakal bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "Ah! Banyak orang jahat di Vana ... Ada jalan yang aman, tetapi harus hati-hati. Dan banyak benih jahat di mana-mana, bahkan yang diciptakan oleh Nara Varuna ... Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME} tinggi dan besar, mungkin sekuat Arabalika ... Nara {NICKNAME} mungkin punya solusi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "#Nara {NICKNAME}, mungkin bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#Memang kami ke sini untuk bantu-bantu kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "Serahkan pada kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula punya permintaan lain, sebelum menyembuhkan Varuna Contraption ... ingin mencari kembali Kenangan Batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "\"Kenangan Batu\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Vana tidak akan lupa, Aranara tidak akan lupa, tapi kenangan yang ditinggalkan oleh Aranara bisa terlihat. Setelah orang jahat datang, benih yang jahat ada di mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Kayaknya Aranara kalau ngomong selalu ada teka-teki ya ... Paimon rasa kita bakal ngerti kalau sudah lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Ya pokoknya, sekarang kita pergi dulu deh bareng Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "Nara baik, Paimon baik! Kita jangan buat orang jahat jadi sadar, kita lewat jalan yang aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Eh? \"Orang jahat\" maksud Aranakula pasti Fungus, kan? Santai saja, enggak perlu takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#Hehe, dengar nih Aranakula ... Nara {NICKNAME} itu kuat loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "Bukan kuat biasa, tapi ya beneraaan kuaaat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "Kami juga sudah ngalahin banyak Fungus sama Arapandu! Bahkan Arapandu saja sudah mengakui kekuatan kami loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#Aku mengerti, Nara {NICKNAME} pasti sekuat Arabalika. Tapi Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "Paimon? Paimon kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "Dulu pernah begini ... Aranakula dikejar sama orang jahat, dan jadinya sembunyi ke dalam tanah, tapi ujung-ujungnya tetap tertangkap dan ditarik keluar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Waduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "Menetes sesuatu dari mulut besar orang jahat itu, basah, panas, dengan bau buah busuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Oh-ow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Kalau Arabalika datang terlambat, Aranakula pasti sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Setelah itu Arapandu mengomel lama, sampai matahari terbenam sampai matahari terbit, malah sampai benih yang ditanam juga sudah mulai bertunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "Mengomelnya terlalu lama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "Tapi apa hubungannya ini sama Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Iya, terus ini apa hubungannya sama Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aranakula lebih kuat dari Paimon, tapi hampir saja dimakan orang jahat. Pai ... Paimon yang begitu kecil ... ini terlalu berbahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#Ma-Masuk akal sih ... Eh tunggu! {NICKNAME} kuat banget dan pasti bakal jagain Paimon, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Iya dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Hehe, Paimon kan sobat baiknya {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "Tapi orang jahat sangat banyak, Aranakula tidak bisa mengalahkan mereka ... Hm ... Nara Emas memang kuat, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Aranakula tahu jalan yang aman, kita lewat jalan yang aman saja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "Eh? Aranakula, kamu takut ya sama Fungus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "*hiks* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Hehe! Oke Paimon paham sekarang. Tapi kamu pakai Paimon sebagai alasan itu enggak baik loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "#Kalau gitu, {NICKNAME}, kita ikuti Aranakula lewat jalan yang aman saja ya. Hati-hati jangan ganggu Fungus-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Tenang, aku jago soal begituan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Iya sih, rasanya kita sudah melakukan ini berkali-kali ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Hm! Kalau gitu Aranakula bawa Nara ke jalan yang aman ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "Paimon bisa kabur sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#Paimon enggak akan kabur terus ninggalin {NICKNAME}! Paimon enggak bakal gitu ... kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Paimon kecil sih, tapi energinya tidak habis-habis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Benar! Paimon itu sangat hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
