			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Ah! Terima kasih Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana mengingat semua yang terjadi setelah kedatangan Nara Varuna, pohon dan benih mengingat. Tapi tidak tahu, apakah Nara Varuna mengerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "Jadi itulah mengapa kami meninggalkan kenangan yang bisa dilihat, dengan ini, saat Nara Varuna kembali dia akan tahu, Vana tidak akan lupa, Aranara juga tidak akan lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Ternyata begitu ... \"Kenangan Batu\" itu kayak monumen. Oh ya, manusia juga kan suka membangun monumen, supaya enggak lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Karena Nara adalah makhluk yang pelupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "Dibandingkan hutan, Nara seperti bibit kecil, enggak akan tumbuh menjadi pohon tinggi, enggak akan punya lingkar tahun yang mengingat segalanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Aranara tidak akan meninggalkan Vana, Aranara akan selalu ada di Vana. Tapi Nara akan datang, juga akan pergi, seperti Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Ada banyak Aranara, seperti banyak pohon di Vana, banyak Aranara memiliki banyak nama, seperti pohon yang memiliki banyak cabang dan daun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "Nara Emas, mengingat banyak nama Aranara, dan juga ingat bahwa aku adalah Aranakula, sama seperti mengambil daun yang jatuh, tapi tahu dari pohon mana asalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "Buat Aranara, Nara Varuna juga sudah jadi Nara yang \"istimewa\"! Karena itu, mereka ngebangun satu monumen khusus buatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Meski enggak sama, kami pernah melihat patung dengan wajah yang spesifik seperti ini sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "Patung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Iya! Habis dengar cerita Nara Varuna, {NICKNAME} apa kamu enggak mau dia bentuknya seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Aranara punya musik, jadi mereka mungkin juga ahli dalam aspek lain! Mungkin mereka juga bisa mengukir patung yang terlihat hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Jika memang ada, aku juga mau lihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "Iya kan! Hehe, Nara Varuna, Nara Emas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Oh ya, sekarang kita bisa pergi buat sembuhin cabang dan daun Varuna Contraption!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Aranakula akan bawa Nara {NICKNAME} dan Paimon pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "Teknik seni Aranara sangat sederhana, jadi sulit dibayangkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#Hm ... Mungkin seni seperti ini masih terlalu cepat buat {NICKNAME}?",
