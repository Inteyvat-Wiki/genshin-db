				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, kami sudah kembali! Tapi setelah ini semuanya tergantung padamu sendiri loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Terima kasih Paimon, terima kasih Nara {NICKNAME}, Aranakula sudah tahu harus melakukan apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Oh! Kayaknya semuanya baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Semoga hutan bisa segera kembali normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Kalau Varuna Contraption sudah sembuh pasti normal lagi kok. Tapi Marana ... harus disingkirkan, demi Vana dan Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Persis seperti \"monumen\" yang dibuat untuk Nara Varuna, rusak karena tertutup benih jahat. Gara-gara Marana, \"Ashvattha's Concourse\" pun juga terkena imbasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "Dulu sekali sebelum kedatangan Nara Varuna ke Vanarana, Nara dan Aranara membangun kebun bersama. Tapi sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Selain anak-anak Desa Vimara yang masih bisa melihat, Aranara hanya sebuah dongeng bagi orang dewasa ... bekas tempat pembibitan juga terlantar gara-gara Marana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula ingin mengisi kebun itu dengan bunga, Nara telah melupakan Aranara, tapi tidak apa, karena Nara akan melihat bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, terima kasih, Aranakula tidak akan lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Sekarang, Aranakula akan kembali ke \"tempat istirahat\", Arapandu pasti bakal senang kalau dia tahu monumennya sekarang sudah bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Nara {NICKNAME} dan Paimon mau kembali bersama Aranakula ke \"tempat istirahat\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "Ada Nara Emas yang menemaniku, rasanya jadi aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Semoga Aramuhukunda melindungi Nara {NICKNAME} dan Paimon, hati-hati jangan sampai ditelan orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
