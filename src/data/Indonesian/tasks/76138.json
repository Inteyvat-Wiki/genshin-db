			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "Bos Nefer? Dan ... Tuan Zompaynco? Ada apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Tamu kita dari Natlan ini sepertinya ingin mengunjungi Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Tapi agar lebih santun, dia ingin ada orang yang memperkenalkan siapa dirinya ke kalian. Baiklah, Tuan Zompaynco, waktu dan tempat dipersilakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "Ha-halo, Nona Lyylikki! Senang bertemu dengan Anda. Uh ... ini ... sampel fosil yang kubawa dari Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Terima kasih, tapi ... Tuan Zompaynco, kita sudah saling kenal, tidak perlu sungkan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Eh? Sejak kapan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "Waktu aku bagi-bagi makanan, Anda selalu melihat dari pinggir, ya kan? Bolak-balik ke sana kemari, tapi tidak pernah ikut antre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Aku kira Anda juga ingin makan, tapi terlalu malu untuk minta. Makanya, aku selalu sisihkan satu porsi untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Tapi Anda belum pernah ambil sama sekali. Malahan, kalau misal hari ini Anda tidak datang, aku mungkin sudah minta tolong orang periksa keadaan, siapa tahu Anda perlu bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Ma-maaf, aku cuma tidak tahu ... harus gimana untuk menyapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Jadi, Nona Lyylikki ... apa mungkin aku boleh main ke tempatnya Bani Bulan Embun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Tentu saja. Kami juga bukan belum pernah menerima pengunjung dari luar. Tapi, boleh aku tanya untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Aku mau foto, cari info, dan kalau diperbolehkan ... tanya-tanya ke warga soal legenda setempat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Aku anggota Asosiasi Relik Saurian Natlan. Alangkah baiknya kalau bisa mengumpulkan informasi yang berhubungan dengan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Oh ... Jadi mau lihat-lihat buku di perpustakaan kami ya? Hmm, gimana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Nah, kalian berdua sudah kenal. Tugasku selesai, permisi dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Terima kasih banyak, Bos Nefer! Tapi ... aku tetap mau bayar. Anda sudah repot-repot mengantarkanku kemari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Kalau begitu terserah Anda, Tuan Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "Baiklah, aku pamit dulu. Silakan dilanjutkan mengobrolnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}