			"dialogs": [
				{
					"id": 761380101,
					"content": "Ah ... Bos Nefer! Wah, Anda datang di saat yang tepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Kamu sudah memutuskan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Eh? Me-memutuskan ...? A-Apa maksud Anda ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Aku tahu, kamu ingin mengunjungi Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Kamu ingin berkenalan dengan Lyylikki, agar kamu punya orang dalam di Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Anda ... sudah tahu? Padahal aku tidak pernah cerita ke siapa-siapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Tuan Zompaynco, kalau mau menyembunyikan rahasia, kita juga harus tahu cara menutupi fakta bahwa kita menyimpan rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Kalau tidak, tak peduli setinggi apa tembok penghalang yang kamu bangun di dalam hati, cepat atau lambat pasti akan timbul celah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "Aih, aku dari dulu memang paling tidak pandai menyembunyikan perasaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Baiklah, karena Anda sudah tahu, apa mungkin boleh bantu kenalkan aku dengan Nona Lyylikki? Aku orang luar, tidak enak kalau tiba-tiba mendekatinya, begitu kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Tenang saja. Orang-orang Bani Bulan Embun baik semua. Jangankan orang luar, yang bukan manusia pun tetap mereka sambut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Ah? Benarkah ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Tapi bagaimanapun juga, tidak sopan kalau aku tiba-tiba mendekatinya. Mohon bantuannya, Bos Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Baiklah. Mereka seharusnya sudah selesai membagikan makanan. Ini waktu yang tepat untuk ngobrol. Ayo jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "Ah ... kali ini tidak perlu bayar, aku cuma kebetulan lewat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Terima kasih, Bos Nefer! Aku beres-beres dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
