				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "Sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Hore! Ayo kita mulai bermain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020203,
					"content": "Kalau begitu, ayo kakak mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020204,
					"content": "Halo, aku mau merampok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Hah! Siang-siang bolong merampok? Semoga beruntung, para Millelith sedang mengawasi loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220020206,
					"content": "Little Lulu, cepatlah datang! Kita harus melarikan diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220020207,
					"content": "Halo, bajak laut. Kamu mau merampok apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020208,
					"content": "Hmm... Mungkin Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Tapi aku tidak punya banyak Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020213,
					"content": "Ayah pernah mengatakan bahwa barang yang dikirim para pedagang sangat berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020214,
					"content": "Begini saja. Bagaimana kalau kakak pergi carikan beberapa barang berharga untuk digunakan dalam permainan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020215,
					"content": "Dengan begitu kita akan mempunyai barang yang bisa kakak rampok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020216,
					"content": "Hmm... Kakak bisa mencari beberapa Lotus Head.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020217,
					"content": "Kami bertiga suka makan Lotus Head. Kalau kakak ingin jadi bajak laut jahat, hal terjahat adalah mencuri makanan kesukaan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020209,
					"content": "Aku datang merampokmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Walaupun ini hanya permainan, tapi kita tetap harus berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020211,
					"content": "Lihat? Para prajurit Millelith sedang melihat ke arah kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
