			"dialogs": [
				{
					"id": 220020301,
					"content": "Apakah kakak sudah menemukan Lotus Head?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Terima kasih, kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020304,
					"content": "Little Meng! Little Fei! Cepatlah kemari dan makan Lotus Head!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020305,
					"content": "Hei! Paimon rasa kami kan seharusnya merampokmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh benar juga. Baiklah, ambillah Mora dan barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020307,
					"content": "Kakak benar-benar hebat dalam memerankan bajak laut. Bisa-bisanya kakak merampok barang sebanyak ini dari anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020308,
					"content": "Paimon rasa anak ini sepertinya sedang mengejek kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Terima kasih atas bantuan kakak. Senang sekali bisa bermain bersama. Lain kali main lagi ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
		},
