					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Little Lulu, kenapa aku lagi-lagi menjadi kapten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220020102,
					"content": "Karena permainan terasa lebih seru saat kamu menjadi kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020103,
					"content": "Kalau Little Lulu merasa senang, maka... aku juga tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220020104,
					"content": "Apa yang sedang kalian lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Kakak, kami sedang bersiap-siap bermain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020106,
					"content": "Little Meng adalah kapten, Little Fei adalah pelayan, dan aku adalah pengusaha kaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020107,
					"content": "Sekarang kami membutuhkan seseorang untuk menjadi bajak laut yang bertugas merampok kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020108,
					"content": "Apakah kakak mau ikut main dan menjadi bajak laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Terima kasih, kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020113,
					"content": "Oke, kalau kakak sudah siap, beri tahu kami ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020111,
					"content": "Aku ingin menjadi orang baik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "Ini hanya permainan kok! Kakak jangan khawatir, aku tahu kakak orangnya baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
