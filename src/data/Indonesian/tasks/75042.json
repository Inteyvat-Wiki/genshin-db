			},
			"dialogs": [
				{
					"id": 750420101,
					"content": "Oh, halo. Apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420102,
					"content": "Oh, ada yang ingin kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420103,
					"content": "Tentang Berkah Sang Penguasa Api ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "Berkah Sang Penguasa Api ya ... Jadi ada yang bilang kalau ini semacam atavisme, karena semua orang setuju kalau kekuatan ini pasti berasal dari sumber yang lebih jauh dari generasi sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420105,
					"content": "Cuma ... Menurut Asosiasi Relik Saurian, semua Saurian yang punya tanda ini dikontrol sama kekuatan yang tidak bisa dikendalikan di dalam tubuh mereka saat tumbuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420106,
					"content": "Kekuatan ini mencabik-cabik tubuh mereka dan mengubahnya menjadi berbeda dari bangsa biasa ... Mereka jadi gila dan kehilangan akal sehat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420107,
					"content": "Contohnya, Holawaqa, tiran dari Qucusaurus ... Konon katanya dia dianugerahi Berkah Sang Penguasa Api ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420108,
					"content": "Soal \"bakal diurus\" sama suku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "Mereka akan kirim kembali ke Kerajaan Malam. Mungkin waktu dia masih hidup, tidak ada suku naga atau Kerajaan Malam yang bisa menerimanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420110,
					"content": "Begitu dia sudah meninggalkan dunia ini, dia pasti akan kembali ke pelukan malam. Bagi dia, meski ini kejam dan dingin, tapi dia akan bisa bertemu kembali dengan jiwa seluruh makhluk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420111,
					"content": "Maaf jika lancang, tapi mungkin itu juga salah satu bentuk kebaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420112,
					"content": "Ada petunjuk tentang token?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "Sedikit sih ... Tapi, aku masih harus cari orang untuk konfirmasi. Mungkin nanti kamu bisa cari aku di tempat Pacal, kepala suku Putra-Putri Gema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420114,
					"content": "Dia mungkin kelihatannya bakal agak ... berlebihan. Tapi kalau mau jujur, dia itu lebih bisa diandalkan. Lebih keras dari kristal yang paling keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420115,
					"content": "Tidak ada pertanyaan lagi. Dadah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "Silakan berkunjung kapan pun, kawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		}
	]
