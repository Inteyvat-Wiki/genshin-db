				"points": []
			},
			"dialogs": [
				{
					"id": 745040101,
					"content": "Bagaimana? Sudah tidak sabar mulai kerja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040102,
					"content": "Aku asal ngomong saja nih ya, sebenarnya menurutku proyek kita kali ini masa depannya suram. Kalau ada waktu luang seperti sekarang, mending kita main saja ke Lepaute Horlogerie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040103,
					"content": "Wah! Jadi ini suara hatimu? Jadi menurutmu gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745040104,
					"content": "Hushh, jangan keras-keras ngomongnya. Kalau sampai terdengar orang lain, nanti aku disangka mata-mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040105,
					"content": "Aduh, sudah deh jangan bahas ini lagi. Lagian aku kan juga cuma karyawan saja, mending kita bicara soal pekerjaan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040106,
					"content": "Biar kujelaskan dulu, pengumpulan data proyek kali ini dibagi menjadi dua bagian besar, aku pegang satu dan Arbon satunya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040107,
					"content": "Pengumpulan data yang aku lakukan bertujuan untuk menyimulasikan kemampuan bertempur dari Petarung Juara. Jadi aku perlu kamu untuk menyelesaikan beberapa proyek pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040108,
					"content": "Kami menemukan beberapa tempat berkumpulnya monster di alam liar, lalu memasang perangkat pencatat data di sekitarnya. Kalian tinggal pergi dan bereskan saja mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040109,
					"content": "Aku sudah menandai lokasinya di petamu. Untuk hal-hal lainnya, kalian bisa tinggal baca saja buku panduannya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040110,
					"content": "Bagaimana, apa masih ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040111,
					"content": "Tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "Kalau begitu, semoga pengumpulan datanya berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alberre"
				}
			]
		}
	]
}