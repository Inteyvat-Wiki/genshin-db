			"dialogs": [
				{
					"id": 755080101,
					"content": "Haaai~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080102,
					"content": "Tamu kehormatan sudah datang! Oke, pestanya bisa digas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080103,
					"content": "Mualani! Wah, ada Xilonen juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080104,
					"content": "Dan ... Mizuki?! Kamu datang dari Inazuma???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080105,
					"content": "Betul sekali. Teman-teman di Natlan ini sudah seperti keluarga. Warga Mata Air ibarat rumahku di tanah asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080106,
					"content": "Kalau mau bantu orang sini, ya jelas tidak boleh mengabaikan cabangku di Natlan dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080107,
					"content": "Etos kerja Nona Mizuki memang juara sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080108,
					"content": "Bikin reputasi kami sesama penyedia jasa jadi turun kalau dibandingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080109,
					"content": "Lah ... Xilonen juga langganan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "Belakangan ini aku sering mimpi aneh. Misalnya ... pelanggan minta waktu pengiriman pesanan dipercepat dari empat minggu jadi cuma seminggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080112,
					"content": "Atau tiba-tiba ada yang minta dibikinin aksesori bulat-bulat spesial, yang ada bau-bau bahayanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080113,
					"content": "Ini tahu sih, Slime dan Fungus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "Wah, langsung nyambung bestie. Jangan-jangan kamu menghantui mimpi Xilonen ya? Kamu yang pesan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080116,
					"content": "Lah, memangnya yang dua itu termasuk bahaya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080117,
					"content": "Intinya bukan cuma tenggat waktunya yang nyebelin. Bikin desain bulat sempurna itu repot, kalau diburu-buru hasilnya sudah pasti kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080118,
					"content": "Dan aku mimpi itu terus. Jadi ya sudah, semua pesanan di bengkel aku kelarin, lalu aku cari Nona Mizuki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080119,
					"content": "Dan langsung beres masalahnya! Pas tidur siang sehabis sesi, mimpinya lenyap! Bersih semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080120,
					"content": "Aku merasa terhormat bisa membantu Nona Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080121,
					"content": "Tapi aku rasa alasan mengapa mimpi aneh Nona Xilonen bisa hilang, bukan sepenuhnya karena terapiku ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080122,
					"content": "Singkatnya, sekarang semua orang senang dan cukup istirahat. Waktunya pestaaa~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080123,
					"content": "Pesta di atas air! Tradisi kampungku nih, seru banget loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080124,
					"content": "Pesta di atas air ya, wah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "Asyik! Pesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080127,
					"content": "Tapi ... eh, pestanya kayak gimana ya? Paimon cuma tahu kalau di acara gini pasti ada makan minum enaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080128,
					"content": "Orang Natlan sukanya kayak gimana sih kalau pesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080129,
					"content": "Meluncur di punggung Koholasaurus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "Kamu ... kamu serius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080133,
					"content": "Aha, ada satu lagi penikmat olahraga ekstrem di sini! Jujur ya, aku juga pertama-tama langsung kepikirannya itu semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080134,
					"content": "Tapi kata Amina ... *ehem* \"TIDAK SEMUA ORANG SUKA AKTIVITAS YANG MEMANCING ADRENALIN\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080135,
					"content": "\"Main voli pantai saja bisa bahaya ya. Seru-seruan, ya. Asyik, ya. Sampai itu bolanya kena ke kepala orang!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080136,
					"content": "\"Acara ini tuh buat senang-senang, bukan buat bikin orang trauma dan nambah kerjaannya Nona Mizuki!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080137,
					"content": "Yah, ada benarnya juga sih. Aku senang bisa bantu, tapi kalau bisa ya jangan sampai aku ada andil menciptakan trauma untuk pasien sendiri. Mending main aman saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080138,
					"content": "Hehe, makanya aku minta pendapatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080139,
					"content": "Jadi? Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080140,
					"content": "Tidak semua orang punya pengalaman dengan olahraga ekstrem, dan kami tidak mau orang jadi enggan atau bahkan takut ikut serta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080141,
					"content": "Waktu ngobrol tadi, aku kebetulan cerita tentang Festival Bunga Mikawa di Inazuma dan kegiatannya yang lebih santai. Nona Mualani tertarik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080142,
					"content": "Jadi kita mau bikin Akitsu Haneasobi dengan kearifan lokal khas Natlan! Hasilnya, \"Bola Irama\". Main santai, tapi seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080143,
					"content": "Mainan ala Inazuma ... tapi pakai bumbu Natlan! Boleh banget tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080144,
					"content": "Aku pernah lihat panggung jogetnya Putra-Putri Gema ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "Wah, padahal kamu belum dengar mereka main pakai volume tertinggi loh! Kepekaan kamu ke irama tinggi berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080147,
					"content": "Dan itu bagus sekali buat main \"Bola Irama\". Targetnya, kita hajar semua balok pakai bola, mengikuti irama musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080148,
					"content": "Enggak perlu jurus suhu, enggak ada risiko kecelakaan, cuma pakai insting saja. Semua bisa main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080149,
					"content": "#Tentunya, untuk peserta yang berbakat seperti {NICKNAME} ini, kita bisa kasih sedikit bumbu di musiknya, atau pakai irama yang lebih nge-beat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080150,
					"content": "Beda DJ, beda hasilnya, biarpun lagunya sama. Nah, permainan ini intinya irama, pesertanya bisa sekalian unjuk kreativitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080151,
					"content": "Siapa tahu kalau kamu yang main, lagu yang harusnya santai dan mendayu bisa jadi super goyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080152,
					"content": "Aku jadi penasaran. Banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080153,
					"content": "#Ya, ya, ya, terserah lah ... tapi kayaknya si {NICKNAME} bisa tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080154,
					"content": "Musik dan permainan? Panggil aku bos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "Nah, gitu dong! Asal kamu dan Paimon puas main, berarti target tercapai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080157,
					"content": "Oh, aku bisa sedia konsumsi buat yang nonton juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080158,
					"content": "Tapi ingat ya, jangan semangat berlebihan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080159,
					"content": "Aku yakin kamu tidak mau musik panggung joget terngiang-ngiang di kepala sampai besok pagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080160,
					"content": "Makasih loh! Ini kayaknya seru banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080161,
					"content": "Tapi misal DJ-nya Xilonen sih ... mau terngiang-ngiang sampai minggu depan juga kayaknya aman-aman saja tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080155,
					"content": "Aku ... aku usahakan ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080145,
					"content": "Iramanya, musiknya, kena banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080130,
					"content": "Terjun bebas dari punggung Qucusaurus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080131,
					"content": "Loncat dari tebing tanpa pakai tali, dikawal Yumkasaurus ... eh, aku sudah pernah deng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080125,
					"content": "Seru tuh kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080114,
					"content": "Maksudnya Specter dan Ball Octopus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080110,
					"content": "Atau kalian pernah kerja bareng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				}
			]
		}
	]
}