			"dialogs": [
				{
					"id": 240210101,
					"content": "Aduh ... kok kotaknya berat sekali ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "Ah, kita bertemu lagi, Peneliti Honoris Tingkat Lanjutan. Maaf, tapi se-sepertinya pinggangku cedera, sakit sekali kalau bergerak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Awalnya aku mau pindahkan kotak ini ke sana untuk kurapikan isinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Ta-Tapi tak kusangka kotaknya berat sekali, aku sampai tidak bisa berdiri tegak waktu mengangkatnya ... lalu semua bebannya kena ke pinggangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Sekarang rasanya ... encok sampai mau patah, aduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Mau kugendong sampai ke dokter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Tidak, tidak perlu ... aku pernah sakit pinggang juga dulu, aku cuma perlu istirahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Di dalamnya ada berapa banyak dokumen sih, sampai seberat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Pasti ada ... yah, pasti banyak sekali sih. Karena Institut Penelitian pernah menerapkan sistem kerja \"Semua Harus Dicatat\" selama cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Singkatnya, waktu itu semua hal yang ada di Institut Penelitian harus dicatat dalam bentuk tertulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Setelah menerapkan kebijakan ini, penggunaan kertas di Institut Penelitian langsung meningkat 5 kali lipat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "Dan karena dokumennya jadi ada banyak sekali, setiap kantor harus menyiapkan posisi \"pengelola dokumen\" untuk merapikan dan membagi dokumen-dokumennya ke berbagai jenis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Semuanya harus ditulis? Kayaknya repot banget yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Memang! Setelah itu kebijakannya dihentikan perlahan-lahan dan hanya diberlakukan hingga batas tertentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "Tapi tidak perlu bicarakan itu dulu ... Peneliti Honoris Tingkat Lanjutan, bisa tolong bantu aku bawakan kotak berkasnya? Pinggangku sakit, tapi aku tetap harus rapikan dokumen di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Kamu istirahat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Tenang saja, aku cuma butuh tanganku saja kok kalau merapikan dokumen, tidak butuh pakai pinggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Aku bisa panggil orang untuk membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
