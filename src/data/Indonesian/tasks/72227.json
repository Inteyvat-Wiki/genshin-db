					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "Kalian berdua keren sekali waktu bertarung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270102,
					"content": "Oh, ternyata kamu di sini, Ruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270103,
					"content": "Kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "Tenang saja, aku tidak apa-apa kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270106,
					"content": "Monster-monster itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "Aku juga tidak tahu mereka datang dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270109,
					"content": "Tapi sepertinya mereka bukan berasal dari sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270110,
					"content": "Iya. Dulu tidak ada monster seperti itu di pulau kami. Tidak ada manusia berbulu atau mesin raksasa juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270111,
					"content": "Dulu, di sini ada sejenis hewan yang namanya \"Wen Kamuy\". Mereka jinak sekali, dagingnya enak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270112,
					"content": "Belum pernah lihat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "Iya, aku juga berpikir begitu. Aku tidak tahu kapan, tapi sepertinya mereka semua hilang, yang muncul malah monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270114,
					"content": "Apa mungkin mereka datang dari luar lautan kabut ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270115,
					"content": "Di luar sana juga ada banyak Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "Kedengarannya berbahaya sekali, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270117,
					"content": "Lumayan, lumayan berbahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "Tapi bertualang juga sangat seru, loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270120,
					"content": "Aku juga mau pergi bertualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270121,
					"content": "Hehe, Paimon yakin kamu pasti jadi petualang hebat kalau sudah besar nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270122,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270123,
					"content": "Serahkan saja pohon tenggeran ini pada kita. Di sekitar sini banyak monster, bahaya kalau kamu berkeliaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270124,
					"content": "Serahkan saja pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "Tapi bertualangnya tetap seru kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "Kamu tidak luka, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
