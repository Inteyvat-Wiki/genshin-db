			},
			"dialogs": [
				{
					"id": 230121101,
					"content": "Aku sudah pernah ngobrol sama kucing sih, dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Si Neko ya? Tapi dia sih kucing yang bisa bahasa manusia! Beda sama bahasa kucing lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Begitulah. Tapi sebagai gantinya, tolong bantu aku cari kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Berarti kalian setuju? Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ehem. Sekarang tolong simak baik-baik, ini garis besar bahasa kucing yang sudah aku pelajari untuk waktu yang cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Ternyata cari kucing saja ada variasinya ya, di tiap kota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Betul juga ya! Eh, kita sudah cariin kucing orang di semua kota yang pernah kita datengin loh, sadar enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Yah, itu artinya semua orang suka kucing, atau ... setiap orang yang punya kucing punya masalah yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
