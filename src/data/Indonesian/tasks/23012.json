			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "Meong— *uhuk-uhuk* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120102,
					"content": "Sedang apa kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "Lagi cari kucing. Biasanya mereka menyahuti kalau dipanggil begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120104,
					"content": "Apa hari ini pelafalanku tidak betul ya? Aku sudah teriak-teriak dari tadi, tapi tidak ada satu pun yang menyahuti. Aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120105,
					"content": "Kenapa tidak coba panggil saja namanya satu-satu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "Iya, biasanya cari kucing kan gitu, panggil saja namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120107,
					"content": "Tapi kalau pakai bahasa manusia, memangnya kucing bisa mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120108,
					"content": "Eh, betul juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120113,
					"content": "Tapi sejauh ini sia-sia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120114,
					"content": "Pengembara, aku mau tanya sesuatu yang serius ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120115,
					"content": "Serahkan pada—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "Kalian mau belajar bahasa kucing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120118,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120120,
					"content": "Kamu mau ajarin kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120116,
					"content": "Imbalannya jangan sampai ku—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "Apa maksudnya \"pelafalanmu hari ini tidak betul\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Yah, suara \"meong\" itu nama mereka, dalam bahasa kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120111,
					"content": "Kalau kita panggil pakai bahasa manusia, kucing mana paham. Iya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120112,
					"content": "Eh, betul juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2301203,
