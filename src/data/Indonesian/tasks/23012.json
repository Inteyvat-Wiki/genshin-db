				"points": []
			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "Oh, kucingku kembali! Terima kasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Bahasa kucing kalian lumayan fasih berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Ini, terima ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Jarang ada orang yang bisa menguasai bahasa kucing secepat ini. Mungkin ke depannya aku akan perlu bantuan kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Meong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Pakai bahasa manusia WOI! Nona Sareh bukan kucing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Aku tahu kamu mau bilang \"jangan sungkan\", dari ekspresimu. Tapi lafal masih perlu perbaikan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Tidak apa. Asal kamu jangan menyerah belajar bahasa kucing. Kita maju sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
