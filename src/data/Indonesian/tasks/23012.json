			"dialogs": [
				{
					"id": 230121501,
					"content": "Kucing hitam putih yang main ke luar hari ini namanya \"Lale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121502
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121502,
					"content": "Kalau mau memanggilnya pakai bahasa kucing, bunyinya begini \"meong, meong meong meong, meooong——\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121503
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121503,
					"content": "Ingat ya, jangan salah nada. Turun dulu, baru naik. \"Meong\" yang terakhir pakai nada tinggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121504
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121504,
