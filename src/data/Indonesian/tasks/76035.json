				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Columbina ... tidak ada?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Kamu cari aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350103,
					"content": "WUAAAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Kamu mengagetkan saja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Setelah merasakan kehadiranmu, aku memutuskan untuk mendekat pelan-pelan dari belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350107,
					"content": "Kelamaan nganggur jadinya ya gini nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Oh ... begitukah? Waktu aku masih di Fatui juga tidak jauh beda ... tidak banyak yang bisa dikerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350109,
					"content": "Tsaritsa hanya menginginkan kekuatan Dewi Bulan. Aku belum pernah diutus untuk merebut Gnosis, atau diberi tugas lain semacamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350110,
					"content": "Biasanya kamu ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Jalan-jalan santai, melihat bulan, dan kadang bernyanyi. Tapi setelah dilarang Sandrone, aku jadi agak mengurangi bernyanyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350112,
					"content": "Hmm? Dia enggak suka suara kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Sebaliknya. Dia suka, bahkan sampai memuji. Tapi waktu itu aku baru bergabung ke Fatui, katanya yang lain jadi tegang kalau dengar aku bernyanyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350114,
					"content": "Karena bagi yang tidak paham, aku terlihat seperti ... sedang akan mengerahkan kekuatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350115,
					"content": "Ah, ngerti, ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ah, ada satu alasan lagi. Kalau malam dia biasa meneliti, jadi kalau aku nyanyi di siang hari, bisa mengganggu waktu tidurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350117,
					"content": "(Pasti itu alasan yang sebenarnya!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Jadi, aku bernyanyi di depan pintu kamar Sandrone setiap malam. Tapi tetap diusir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350119,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Gimana hubunganmu sama anggota yang lain? Dekat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "\"Dekat\"? Hmm ... waktu pertama ketemu, Arlecchino yang paling semangat \"mendekati\" aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350122,
					"content": "Dia sering diam-diam muncul dari belakang, seperti aku ke kalian tadi. Katanya mau \"mengujiku\", begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350123,
					"content": "Aku coba ikuti permainannya, tapi dia ... aku masih jauh pun sudah balik badan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350124,
					"content": "Begitu terus sampai suatu hari aku mencoba menggunakan kuuvahki. Akhirnya aku berhasil menakuti dia dengan tiba-tiba muncul dari belakang. Setelah itu, dia tidak pernah ajak aku main seperti itu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350125,
					"content": "(The Knave sih jelas enggak mikir cerita barusan itu \"permainan\" ya, astaga.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Siapa lagi ya ...? Ah, The Doctor sering minta bantuanku untuk penelitiannya terkait \"Dunia Terang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350127,
					"content": "Aku pernah sih menyanggupi, tapi selalu membosankan. \"Serang itu pakai kuuvahki, kendalikan ini pakai kuuvahki\" ... gitu-gitu saja permintaannya. Setelah beberapa kali, aku jadi malas ke tempatnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350128,
					"content": "Hari ini lagi senang hati ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Ya. Aku memang \"kabur dari rumah\", tapi bagaimana pun juga di sana memang ada kenangan manisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350131,
					"content": "Arlecchino dan Sandrone baik padaku. Lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350132,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350133,
					"content": "(Ekspresinya ... lagi ingat siapa ya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Ulurkan tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350135,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Aku ingat Rosalyne mengajariku ... cara mengungkapkan rasa terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350138,
					"content": "Terima kasih sudah mendengar ceritaku hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350139,
					"content": "Santai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Ini ... Perkenanan Dewi Bulan?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Sepertinya hari ini cukup dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760350142,
					"content": "Kok tahu-tahu sudahan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Sstt ... Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Iya ya? Kalau gitu mending jangan diganggu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Sepertinya dia teringat sesuatu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Soalnya kamu banyak cerita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Harus banget ya muncul dari belakang begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}