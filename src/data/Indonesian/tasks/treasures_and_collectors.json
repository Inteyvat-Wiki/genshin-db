					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090203,
					"content": "Nguuuk, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Meskipun bukan sesuatu yang kita gali, tapi karena kita nemu di sini ... mungkin ini barang berharga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
