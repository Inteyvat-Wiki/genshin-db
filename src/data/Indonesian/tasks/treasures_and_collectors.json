			"dialogs": [
				{
					"id": 750090101,
					"content": "Karcis masuk 300 Mora ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090102,
					"content": "Ada diskon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "Harga ini sudah ditetapkan oleh Asosiasi Relik Saurian, tidak bisa nego. Sejauh yang kutahu, ini sudah yang paling murah loh kalau mau masuk ke tempat penggalian begini, yah memang bukanya juga sudah sejak lama banget sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090106,
					"content": "Tapi terkadang memang suka ada orang yang seperti kalian yang mau mencoba peruntungan begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090107,
					"content": "Toh gimanapun juga, ratusan atau bahkan ribuan orang yang datang sebelum kalian tidak bisa menilai harga sebuah harta karun, hingga akhirnya mereka melewatkan relik berharga yang seolah terkesan biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090108,
					"content": "Banyak orang rela bayar 300 Mora buat kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090109,
					"content": "Jadi gimana, kamu lagi ngerasa hoki? Kamu yakin hari ini adalah hari di mana kamu bisa jadi tajir melintir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090110,
					"content": "Nguk, fuwaaa! FUWAWAWAAA!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Keberuntunganku tidak pernah mengecewakanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, mau coba peruntungan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Dia semangat tuh! Hehe, cuma 300 Mora, Paimon juga bisa bayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "Bisa dapat 3 kesempatan cuma dengan 300 Mora itu sudah untung besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "Semoga beruntung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090112,
					"content": "Aku tidak butuh hal macam itu, aku punya Saurian pembawa keberuntungan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "Kalau aku kalahkan kamu, jadi gratis ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "Hei, bukan gitu konsepnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
