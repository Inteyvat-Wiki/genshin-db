				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Menyenangkan sekali dapat beradu ilmu denganmu, Tuan Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Seperti inilah akhir kisah seorang pahlawan. Sangat disayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Berkelana seorang diri di tanah yang kau bela hingga berkorban nyawa ... apa dirimu sudah memperkirakan datangnya hari ini, semenjak pertama kali mengucap sumpah Lightkeeper?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Mungkin tidak ada keraguan sama sekali dalam benakmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Aku akan kembali lagi di lain kesempatan. Sampai jumpa, Tuan Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
