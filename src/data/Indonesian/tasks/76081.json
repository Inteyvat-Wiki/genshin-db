			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Maafkan saya, Tuan Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Jangan khawatir, setelah pengorbanan kalian, Pak Tua Nikita naik menjadi Starshyna yang baru, dan dia memimpin orang-orang yang kalian selamatkan untuk membangun kembali pasukan Lightkeeper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Dan sekarang, kekuatan kami sudah cukup untuk melindungi tanah suci ini dari ancaman Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Pengorbanan kalian tidak sia-sia, kisah dan tekad kalian tidak akan pernah dilupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Selamat tinggal, Tuan Sigurd. Saya akan sering datang berkunjung, semoga Anda beristirahat dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Caranya membinasakan monster ... tidak, sosok legendaris itu telah mengorbankan dirinya bagi kita, pada zaman dahulu kala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Apa mungkin dia kembali terbangun karena sesuatu? Hmm ... kalau ada waktu, pergilah ke pantai di sebelah timur laut Barrowmoss Barrens. Makamnya ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Aku pernah dengar dari Pak Tua tentang kisah Starshyna legendaris bernama Sigurd, yang dulu pernah berjuang bersama dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Cahaya pedangnya berwarna ungu, rambutnya berwarna emas ... persis seperti dalam legenda, jangan-jangan orang yang kutemui baru-baru ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Dia dimakamkan di pantai sebelah timur laut Barrowmoss Barrens. Jika ada waktu, mari kita pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}