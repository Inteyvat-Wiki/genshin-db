			"dialogs": [
				{
					"id": 760810101,
					"content": "Aku dengar Starshyna yang legendaris, Sigurd, menggunakan pedang panjang sebagai senjata. Kemahirannya membasmi monster nyaris tiada duanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Dia lenyap setelah pertempuran besar. Kubur kosong ini dibuat untuk memperingati kepahlawanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Pedang ungu dan rambut emas ... dia pasti petarung pengelana yang bermusuhan dengan Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Arwahnya belum tenang meski sudah dimakamkan. Seperti banyak arwah lain yang meraung dan meratap pilu sepanjang malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Ketika hidup dia menghunuskan pedang kepada Perburuan Liar. Setelah wafat pun keberaniannya masih tak tergoyahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "Tuan Sigurd, Anda sungguh layak menerima hormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Tetapi, dia bertarung dengan bermodalkan kebencian serta rasa tanggung jawab terhadap tugas. Keberadaan yang sungguh teramat kejam bagi sosok sehebat dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Apakah dirimu merindukan hari-hari penuh minuman dan nyanyian bersama para Lightkeeper, Tuan Sigurd? Apa alasanmu masih menggenggam pedang, selain daripada memuaskan dahagamu akan darah dan pembantaian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Jika demikian, tunjukkan dirimu. Seperti masa yang sudah berlalu, ketika dirimu masih ada bersama para Lightkeeper. Kita bertanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
