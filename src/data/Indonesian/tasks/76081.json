						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Tuan Sigurd, Anda adalah penyelamat saya. Jika bukan karena Anda yang memimpin para Lightkeeper ke selatan untuk melawan musuh saat itu, mungkin saya sudah lama kehilangan nyawa tanpa menyadarinya, dan tidak tahu di mana jasad saya akan terkubur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Tapi kenapa arwahmu tidak bisa beristirahat dengan tenang? Kenapa Anda masih terus berkelana dan bertempur tanpa henti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Setelah tercemar oleh kotoran Perburuan Liar, bahkan wujudmu pun terpecah-belah ... Sepertinya kamu tidak pernah benar-benar meninggalkan medan perang itu, bukan? Bagimu, perangnya masih belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "Dalam hal ini, mungkin aku sama seperti Anda. Kita baru bisa damai jika Perburuan Liar sudah sepenuhnya lenyap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "Sungguh suatu kehormatan bisa bertemu dengan Anda, Tuan Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Aku paham, bagi seorang Lightkeeper, cara terbaik untuk berkomunikasi adalah dengan beradu pedang dan bertukar kemampuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Kalau begitu, izinkan saya memperlihatkan keberanian seorang Lightkeeper generasi baru kepada Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
