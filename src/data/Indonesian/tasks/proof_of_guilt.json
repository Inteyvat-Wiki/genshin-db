			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#Bagaimana, {NICKNAME}? Apa semuanya lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "Aku juga tidak tahu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Terima kasih, selanjutnya kita tunggu kabar dari Sayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Setelah beberapa saat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "*huff* ... *huff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "Olahraga memang bisa membuat tubuh tambah tinggi, tapi rasanya olahraga kali ini berlebihan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "Pusing ... Semuanya ... Berputar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "Tidak! Ada hal penting yang harus kulakukan sebelum tidur ... Ah iya, ini dokumennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "Aku tidak tahu bentuk dokumen yang kalian mau itu seperti apa, jadi kuambil saja semua yang bisa dibawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Ini buat kalian ... Aku mau tidur lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Nona, ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170913,
					"content": "Dokumen yang disegel ini, aku rasa laporan yang akan Tenryou Commission serahkan ke Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "Selain itu, yang lainnya ini ... Surat korespondensi mereka dengan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Sepertinya dugaan Guuji Yae tepat. Perang yang ada di Inazuma saat ini adalah ulah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, kurasa bukti-bukti ini sudah cukup kuat. Selanjutnya, biar kupercayakan dokumen ini untuk kalian antarkan ke <color=#00E1FFFF>Guuji Yae</color>. Aku yakin dia sudah punya langkah selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Aku juga akan mengumpulkan orang untuk memancing para Fatui yang tersisa keluar dari persembunyian mereka di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Intinya, tolong jaga sikap kalau berurusan dengan Yang Mulia Shogun. Aku masih merinding kalau ingat waktu dia mengeluarkan pedangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170919,
					"content": "Kita hanya bisa percaya pada Guuji Yae. Dia memiliki hubungan yang erat dengan Shogun, mungkin dia punya suatu cara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Kalau Paimon enggak salah ingat, sepertinya sebentar lagi sudah mau waktunya kita ketemu sama Yae Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Kita beres-beres lalu siap-siap jalan ke <color=#00E1FFFF>Kuil Agung Narukami</color> yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "Setelah kembang apinya nyala, kami langsung kabur ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
