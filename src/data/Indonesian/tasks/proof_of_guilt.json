					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "Sebenarnya beberapa hari yang lalu, aku baru saja bikin barang baru yang sangat-sangat keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Tapi karena terlalu kuat, aku tidak ketemu tempat yang pas untuk mencobanya ... Kalian ambil saja, sekalian bantu aku lihat seperti apa hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "Ingat ya, setelah kalian sulut apinya, langsung lari. Jangan sampai baju kalian ikut terbakar, lalu jangan lupa tutup telinga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "Pa-Paimon kok tiba-tiba jadi takut sendiri sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Hahaha, tenang, kan cuma kembang api. Tidak akan kenapa-kenapa kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "Ya sudah, kami cobain dulu deh. Makasih ya, Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
