			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, ada apa ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Kalian sudah bertemu dengan para pemberontak? Bagaimana keadaan di medan perang? Apa aku sudah bisa keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Sepertinya belum ... Saat perjalanan ke sini, kami masih lihat ada banyak yang berpatroli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Jadi belum selesai juga ya ... Kalian jauh-jauh kemari, pasti ada sesuatu yang ingin dibicarakan dengan kami, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Biar aku minta seseorang untuk memanggil Nona Kamisato. Tunggu sebentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Kamu memberi tahu Ayaka dan Thoma tentang situasi saat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Begitu ya, ternyata kalian sudah alami banyak hal sejak perpisahan terakhir kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Aku sudah paham situasinya. Kamu memerlukan bukti pengkhianatan Tenryou Commission. Biar kupikirkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Kalau dipikir-pikir, memang dari dulu ada satu hal yang selalu menarik perhatianku. Pasukan Shogun dan para pemberontak sudah berperang sangat lama, tapi Shogun tidak pernah menanyakan soal itu sekali pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Aku hanya menganggap kalau Shogun hanya tidak memedulikan hal ini, tapi kalau dipikir lagi sekarang, mungkin semua <color=#00E1FFFF>laporan resmi yang diberikan Tenryou Commission</color> ke Shogun sudah bermasalah dari awalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "Tenryou Commission adalah pelaksana segala urusan militer. Jadi kalau mereka berniat menyembunyikan informasi dalam laporan mereka, kami tidak akan pernah bisa tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Sementara itu, Shogun akan salah menduga kalau Dekrit Perburuan Vision tidak berbahaya dan dia pun akan meneruskannya. Semua akan ketahuan kalau kita bisa melihat laporan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Tapi seingatku, hanya Kujou Takayuki yang berwewenang untuk mengakses laporan resmi semacam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Penjagaan dokumen itu juga sangat ketat. Biarpun dibantu Sayu, mau ambil dokumen itu diam-diam bukanlah hal mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Kalau saja kita punya cara untuk mengalihkan perhatian para penjaga dalam waktu yang cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "Kalau mau menarik perhatian sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "Kembang apinya Yoiminya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Memang ide yang khas Thoma sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Tapi idenya bagus juga. Tenryou Commission terletak di sebelah patung Omnipresent God. Kalau kita bisa nyalakan kembang api di sekitar patung itu, aku yakin Tenryou Commission tidak akan tinggal diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Saat itu, Sayu akan leluasa masuk ke Tenryou Commission dan mengambil dokumen, dan mungkin juga bukti-bukti lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Bagus! Aku merasa hari kebebasanku sudah dekat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Ah ... Rasanya sudah lama sekali ya sejak terakhir kali kita bisa duduk dan mengobrol bersama-sama seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "Rasanya belum terlalu lama juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Ya, kalau buatku sih rasanya sudah lama sekali. Sejak aku sampai di tempat ini, setiap hari aku merindukan kalian loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Dulu Teahouse ini adalah tempat rahasia kesukaanku, tapi kali ini, aku sudah tidak tahu berapa lama aku tidak melangkah keluar dari sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "Ahh sial! Aku ingin sekali berendam air panas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Thoma, kasihan banget kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Ayo kita berfokus pada masalah yang ada di hadapan kita. Semakin cepat Dekrit Perburuan Vision dicabut, semakin cepat Thoma menikmati kebebasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Tidak ada banyak waktu untuk bernostalgia pada reuni kita kali ini. Setelah semua ini usai, mari kita berkumpul lagi dan rayakan sama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Nanti kita harus main tantangan hot pot lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "Kamu masih mikirin hal itu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "Ada banyak penjaga yang patroli di sekitar Tenryou Commission. Kalian jangan sampai lengah, kita bertemu lagi di sini nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Nah {NICKNAME}, kalau gitu sekarang kita cari <color=#00E1FFFF>Yoimiya</color> di <color=#00E1FFFF>Hanamizaka</color> yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Rasanya tempo hari juga pernah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
