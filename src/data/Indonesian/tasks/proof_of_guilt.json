			"dialogs": [
				{
					"id": 20170701,
					"content": "Hmm ... sudah kuduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170702,
					"content": "Banyak sekali orangnya ... kalau sampai kepergok ... aku bisa ketangkap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Kita harus alihkan dulu perhatian mereka, kalau tidak, aku tidak akan bisa menyelinap masuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Kita harus percaya pada Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Setelah aku berhasil dapat dokumennya, kita kumpul di <color=#00E1FFFF>Komore Teahouse</color>, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Satu lagi ... kalau aku sampai tertangkap ... selamatkan aku ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "Apa ini benar-benar ide yang bagus ....?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Su-sudahlah, kita ke <color=#00E1FFFF>patung Omnipresent God</color> dulu saja! Hati-hati, jangan sampai kepergok patroli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
