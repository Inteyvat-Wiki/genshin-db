			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "AHH! Bo-boneka tanuki nya berubah jadi orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Apa ini, Paimon baru kali ini lihat yang begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Bukan tanuki ... Aku ini mujina... *hoam*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Capeeek ... kalau kurang tidur ... nanti susah tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Hmm, ini \"profesional\" yang kamu maksud tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Ck, dia sama sekali tidak kelihatan profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Hehe ... Dia ini anggota Shuumatsuban, ninja sejati loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Wowww, ada ninja! Jadi yang tadi itu teknik transformasi ninja yang legendaris itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Ah iya, \"Shuumatsuban\" itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Shuumatsuban adalah bagian dari Yashiro Commission, unit rahasia Kamisato Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Saat ini, Kamisato Ayato dan Yashiro Commission ada di posisi netral. Aku juga tak bisa memerintah Shuumatsuban sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Tapi kalau cuma minta bantuan anggota mereka yang paling malas sih, aku masih mampu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Ini tugas yang perlu bantuanmu. Pergilah ke kota dan cari bukti pengkhianatan Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Kalau aku sendiri yang terlihat di sana, kurang pas juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Kamu ngomongnya sih gampang, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Aku tidak tahu apa yang harus kucari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Eh? Kukira kamu sudah tahu. Baiklah kalau begitu, aku akan memanjakanmu dengan sedikit petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Bagi orang luar seperti kamu, memang sulit untuk memahami cara kerja Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Sejak Tri-Commission bersama-sama membantu Shogun, mereka jadi berhubungan erat satu sama lain. Yang paling mungkin sadar duluan ada ketidakberesan di Commission lain adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "Yashiro Commission!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Hehe ... kelihatannya kamu sudah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "Pasukan Shogun memang masih gencar untuk mencari kamu, tapi dengan bantuan ninja Shuumatsuban ini, kamu pasti bisa menemui teman-temanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Jangan lupa kalau jadwal kita padat ya. Bawa kembali buktinya tepat waktu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "Apa sebenarnya buktinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
