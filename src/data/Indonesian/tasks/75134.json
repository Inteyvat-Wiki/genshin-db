					"content": "Kalian memberi tahu Bona apa saja yang terjadi di bawah.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "Hah?! Pyrophosphorite baru lagi? Wah, kirain yang aku punya itu satu-satunya di dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
