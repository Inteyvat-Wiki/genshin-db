					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340406,
					"content": "Tunggu, apa yang punya aku palsu? Pantesan sudah bertahun-tahun juga enggak kerasa ada yang spesial dari batu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340407
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340407,
					"content": "Mustahil.",
					"roleType": "TALK_ROLE_PLAYER",
