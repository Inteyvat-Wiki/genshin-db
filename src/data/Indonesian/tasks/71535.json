				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Wah, bisa ya ketemu kamu di tempat kayak gini, {NICKNAME}. Ngincar keramaian Lantern Rite juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Kamu lagi buat Kartu Ucapan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Iya nih, buat Candace. Tapi aku kurang puas nih sama hasilnya. Sekarang mau bikin ulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace-nya enggak ikut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Ikut, tapi belum datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Dia awalnya nolak loh. Katanya mesti jagain desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Aku bilang SEMUA orang perlu istirahat, liburan, atau apa lah, seenggaknya pas akhir tahun. Kebetulan aku ada tugas mengawal rombongan ke Liyue, makanya tanya dia kenapa enggak sekalian ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Aku juga tawarin biar anak buahku yang gantiin dia jaga desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Tapi percuma. Dia baru berubah pikiran setelah warga desa bareng-bareng maksa dia liburan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Sudah setuju pun dia tetap mau beresin dulu semua urusan sebelum berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Tapi rombongannya kan enggak bakal nungguin ... makanya aku sampai duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Di sini segala ada, susah banget nyari oleh-oleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Aku awalnya beliin kalung, tapi terus dengar di Liyue ada tradisi bikin Kartu Ucapan pas Lantern Rite. Jadi aku ikutan coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Yah, tapi hasilnya ... begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#{NICKNAME}, kamu pasti lebih tahu doang soal ini. Bisa kasih petunjuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Gampang, sini lihat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
