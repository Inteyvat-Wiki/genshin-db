			"dialogs": [
				{
					"id": 715350401,
					"content": "Ooh? Kamu jago juga ya bikin kerajinan tangan. Cantik banget nih, makasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "Ini jadi kayak hadiah dari kamu, buat aku! Sekarang aku lagi enggak pegang apa-apa, tunggu ya. Nanti pas sudah di Sumeru aku kasih sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Sekarang tinggal bikin satu lagi buat Candace, buat nemenin kalungnya. Dia pasti suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Ah, iya juga ... orangnya di mana nih? Masa belum nyusul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
