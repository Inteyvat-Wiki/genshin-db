						710570304
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570304,
					"content": "Raut mukanya jelek sekali. Pasti menderita sekali di dalam sana. Syukurlah Paman masih hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570305,
					"content": "Hidup enak! Hidup dan makan daging jamur yang enak! Hehehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570306
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570306,
					"content": "Paman He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570307
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570307,
					"content": "Saat kami menemukannya, dia sudah begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570308,
					"content": "Pikirannya seperti kurang waras ... dia terus menerus bilang dia mau makan jamur aneh itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570309,
					"content": "Jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570310
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570310,
					"content": "Lingkungan di Chasm terlalu berbahaya bagi orang biasa, tumbuhan dan jamur yang tumbuh di sana pun mungkin berbahaya bagi manusia. Makanya Huishan Hall melarang para penambang memakan apa pun yang ada di bawah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570311
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570311,
					"content": "Tapi selama Paman He terjebak di dalam beberapa tahun ini, dia juga enggak punya pilihan lain kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570312
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570312,
					"content": "Dia jadi seperti ini, apa yang harus kukatakan kepada keluarganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570313,
						710570314
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570313,
					"content": "Bicara soal jamur ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				},
				{
					"id": 710570315,
					"content": "Oh ya, mungkin Khedive bisa bantu. Bagaimanapun dia kan pelajar dari Sumeru. Kurang lebih pasti pernah meneliti jamur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570316
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570316,
					"content": "Kalian tunggu di sini, aku akan panggil Khedive untuk memeriksa kondisi Paman He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570317
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570317,
					"content": "Daging jamur ... daging jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570318
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570318,
					"content": "*huff* Melihat kondisi Paman He yang kacau gini, Paimon enggak yakin kalau dia bisa sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570319,
					"content": "Kalau seperti ini terus, meskipun dia pulang, keluarganya juga pasti sedih kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570320,
					"content": "Kamu tidak bisa memaksaku untuk pergi saat sedang menulis laporan begini. Jinwu, meskipun kamu penanggung jawab keselamatan regu penjelajahan, tapi tetap tidak boleh ganggu penelitianku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570321
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570321,
					"content": "Oke kalau gitu akan kupertimbangkan sebuah proposal untuk mengurangi anggaran buatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570322
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570322,
					"content": "Masalah anggaran terserah padamu saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570323
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570323,
					"content": "Coba lihat keadaan orang ini dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570324
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570324,
					"content": "Telingaku gatal sekali ... hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570325
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570325,
					"content": "Hah? Siapa dia? Kenapa raut mukanya aneh sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570326
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570326,
					"content": "#{NICKNAME}, kamu yang menemukan dia ya? Kenapa sih kamu selalu ketemu sama hal yang ajaib begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570327
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570327,
					"content": "Kalau gitu ... bagaimana kondisinya saat kamu menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570328
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570328,
					"content": "Kamu menjelaskan seluruh kejadian tentang Paman He kepada Khedive ....\\nKhedive memeriksa Paman He dengan teliti.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570329
					]
				},
				{
					"id": 710570329,
					"content": "Dia baik-baik saja. Ini bukan masalah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570330
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570330,
					"content": "Lihat, dia kan selalu ngeluh telinganya gatal kan? Itu karena spora jamur masuk ke saluran telinganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570331
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570331,
					"content": "Walaupun fungus ... Ah, maksudku jamur jenis ini bisa buat orang kena gangguan jiwa kalau dimakan dalam jangka panjang, dia tidak berbahaya untuk tubuh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570332
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570332,
					"content": "Berarti dia bisa sembuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570333
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570333,
					"content": "Aku sudah membersihkan jamur dari tubuhnya, juga sudah kasih obat untuk gangguan syarafnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570334
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570334,
					"content": "Asal dia istirahat cukup, dia pasti bisa sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570335
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570335,
					"content": "Kalau begitu, uang buat obatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570336
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570336,
					"content": "Bahan obatnya sangat murah, hanya seharga makan sebulan di Xinyue Kiosk, murah saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570337
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570337,
					"content": "Ummm ... akan kupikirkan cara untuk mengumpulkan uangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570338
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570338,
					"content": "Sudahlah, ini tidak seberapa. Malah aku jadi bisa menambah satu kasus untuk laporanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570339
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570339,
					"content": "Saat aku menemukan jamur khusus di Chasm, aku sebenarnya ingin mempelajari efek konsumsi jamur jenis ini untuk jangka panjang .... Tapi aku enggak bisa menemukan asisten yang mau membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570340,
						710570342
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570340,
					"content": "Asisten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570341
					]
				},
				{
					"id": 710570341,
					"content": "Ya itu, orang yang bersedia makan jamurnya. Semuanya seperti tidak mau dekat-dekat dengan jamur ini. Meskipun orang-orang tahu jamur ini tidak berbahaya, tapi juga tidak berani buat makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570344,
					"content": "Tapi mengingat kondisi di Chasm beda dari tempat lain, mungkin gejala yang timbul itu ada kaitannya dengan lingkungan di sini. Sudah tidak apa-apa, asal taat makan obat dan istirahat yang cukup, dia pasti bisa sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570345
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570345,
					"content": "Baguslah ... Biar nanti aku yang antar Paman He ke atas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570346
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570346,
					"content": "Kalau dia sudah baikan, aku akan bawa dia pulang, sekalian kasih kabar ke teman-temannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570347
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570347,
					"content": "Paman He sudah termasuk veteran di pertambangan, dia juga sangat lincah dan sigap. Semua anak baru selalu dia urus dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570348
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570348,
					"content": "Setelah dia menghilang saat itu, semua orang merasa Rex Lapis tidak adil, kenapa orang sebaik dia malah bernasib begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570349
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570349,
					"content": "Sekarang dia sudah kembali. Semuanya pasti senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570342,
					"content": "Maksudmu \"subjek buat penelitianmu\", ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570343
					]
				},
				{
					"id": 710570343,
					"content": "Yah, bilang gitu tidak salah juga sih. Tapi jenis jamur ini dulu sudah pernah diteliti, dan hasilnya adalah efek jamur ini tidak akan menimbulkan kerusakan yang permanen, baik untuk fisik maupun psikis manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570314,
					"content": "Apa kamu kenal dengan seseorang yang cukup tahu soal jamur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				}
			]
		},
