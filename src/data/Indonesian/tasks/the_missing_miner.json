					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570424,
					"content": "Terima kasih banyak. Aku tidak tahu lagi bagaimana membalas jasamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570414,
