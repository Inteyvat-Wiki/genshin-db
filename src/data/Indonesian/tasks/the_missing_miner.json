			"dialogs": [
				{
					"id": 710570133,
					"content": "Tiba-tiba kamu mendengar suara bisikan dari belakang:\\n\"Hehe ... daging jamur ... hehe ....\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Kalian ... Hehehe, kenapa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570102,
					"content": "Wow! Raut wajah orang ini aneh banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Terus dia tiba-tiba muncul tanpa ada suara apa pun, aneh enggak sih kalau kata kamu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Jangan-jangan dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "A-Ah masa sih, enggak mungkin ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hehehe ... kenapa ... kalian ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570107,
					"content": "Apa makanan kalian sudah habis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570108,
					"content": "Apa kamu Paman He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "Eh ... Hah? Anak muda, kalian ngomong apa tadi? Aku tidak dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570110,
					"content": "Kami tanya kamu ini Paman He apa bukan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Oooh, iya, iya. Hehehe, benar itu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570112,
					"content": "Kalian .... Jangan-jangan kalian juga terperangkap di sini bersamaku tanpa ada perbekalan sama sekali? Duh ... kasihan sekali kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570113,
					"content": "Hehe, tapi tidak apa-apa. Aku punya makanan. Kalian pasti sudah lapar, kan? Hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570114,
					"content": "Iya sih memang Paimon lapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Daging jamur tidak boleh sembarangan dimakan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Ya! Ya! Ya! Kelihatannya pikirannya agak terganggu, raut mukanya juga ... aneh deh! Apa mungkin gara-gara dia makan daging jamur itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Daging jamur? Hehe, enak juga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570119,
					"content": "Ini, kalian mau cicipi tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570120,
					"content": "Hehehe .... gimana? Kalian suka? Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570121,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "Daging jamurnya hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570123,
					"content": "Ah sudahlah, ayo kita balik dulu ke kemah sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Aku tidak mau pergi! Daging jamurnya tidak ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570125,
					"content": "Tidak ada daging jamur, tidak ada tenaga untuk jalan. Aku tidak mau ke mana-mana .... Tidak ada daging jamur ... tidak ada makanan lain di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570126,
					"content": "Kalau ada daging jamur, aku bisa pergi ke mana pun juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570127,
					"content": "Kalau gitu, di mana kita bisa temukan daging jamur yang kamu maksud itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Daging jamur ... hehehe ... Aku tahu di mana, ayo kita cari. Habis kita makan baru ada tenaga buat kerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570129,
					"content": "Harusnya ada di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570130,
					"content": "#Apa boleh buat, {NICKNAME}. Kita bantu dia cari daging jamur dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Sepertinya tidak ada pilihan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Daging jamur ... hehe ... daging jamur yang tebal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570116,
					"content": "Jangan asal makan! Berbahaya loh!",
					"roleType": "TALK_ROLE_PLAYER",
