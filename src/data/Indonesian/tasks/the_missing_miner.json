					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "Tapi balik lagi ke topik. Sekarang Paman He harusnya sudah tidak ada masalah lagi kan buat ikut pulang sama kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Daging jamur ... hehe ... enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570214,
					"content": "Paman He! Yuk pulang sama-sama ke kemah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "Ha? \"Sama-Sama\"? Oke. Ayo kita makan daging jamur ini sama-sama. hehe ... setelah dijemur akan bisa tahan lama ... sampai bertahun-tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570216,
					"content": "Maksud Paimon kita pulang ke kemah sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "Rumah? Rumahku di mana ya hmm .... Tapi tak apa-apa deh ... Hehehe ... sekarang karena sudah makan daging jamur aneh, aku bisa pergi ke mana pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570218,
					"content": "Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
