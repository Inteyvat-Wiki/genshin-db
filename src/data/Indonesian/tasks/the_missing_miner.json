						710570417
					]
				},
				{
					"id": 710570417,
					"content": "Dia masih ada di kemah atas. Dia bilang dia masih mau mengatur bahan penelitiannya dulu buat dibawa ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570418,
					"content": "Jadi kalian harus tunggu dia dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570419
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570419,
					"content": "Paimon harap Paman He cepat sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
