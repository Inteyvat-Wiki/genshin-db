					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, kalau dimakan bisa jadi kuat loh! Kita coba juga yuk?",
