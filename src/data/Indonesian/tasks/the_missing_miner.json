				{
					"id": 710570204,
					"content": "Sejak makan daging jamur, pinggangku tidak sakit lagi, tanganku juga jadi bertenaga. Hehe ... aku merasa lebih muda belasan tahun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710570205,
					"content": "Daging jamur aneh lebih enak dari daging jamur biasa. Semakin besar dagingnya, semakin enak ... hehe ....",
