			"dialogs": [
				{
					"id": 790750101,
					"content": "Si Chauvigne mikir apa sih? Ngomong saja tidak mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "Tentang Chauvigne ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Halo! Maaf, tapi ... Chauvigne masih marah padaku, dia tidak mau ngomong sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "Tapi angin dan matahari tidak kena ke bawah sana! Kalau dia layu gimana? GIMANA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Umm ... ini urusannya sama pot kembang kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Yang tinggal diangkat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Aku sudah coba ya! Tapi selama Chauvigne masih ngambek, aku mendekat saja tidak bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "Dia betul-betul bete. Aku nyaris ditiup sampai terbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Hah? Ini gimana sih, ngambek bisa bikin orang ketiup sampai ngapung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Betenya cetar betul. Angin ribut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Mungkin alasan dia marah itu karena dulu aku tidak mau ikut dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "Tolonglah, tamu yang terhormat. Bisa bantu cek kondisi Chauvigne? Mungkin dia mau bicara kalau sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Santai, kami coba ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Iya, kami sudah berkelana ke berbagai tempat. Sudah ketemu banyak sekali orang. Kami pasti ... eh, MUNGKIN bisa bujuk dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "Bagus! Dia ada di gua bawah pulau. Jalannya ke sebelah sana, tolong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Aku ... harus bersih-bersih, supaya ada tempat buat Chauvigne mandi matahari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Iya, jadi susah kalau mau mendekat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
