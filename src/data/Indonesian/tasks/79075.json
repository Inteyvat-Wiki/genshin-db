			"dialogs": [
				{
					"id": 790750201,
					"content": "Aku ... harus bersih-bersih, supaya ada tempat buat Chauvigne mandi matahari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "Urusan Chauvigne aku serahkan ke tangan kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Kalau aku yang pergi, nanti disangkanya aku terlalu manja, ketergantungan sama dia ... bisa-bisa malah makin ngamuk dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
		{
