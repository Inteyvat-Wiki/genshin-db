			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! Kamu datang ... Mo-Mohon dengarkan, aku tidak pernah kesal sama kamu, tidak pernah ingin ninggalin kamu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Aku cuma takut kamu sudah tidak mau berteman lagi ... aku juga tahu banyak Perantau yang berubah, dan aku takut kamu juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Aku berdoa pada dewi, tapi tidak berhasil dapat hadiah yang bagus ... dewi tidak menjawab ....",
