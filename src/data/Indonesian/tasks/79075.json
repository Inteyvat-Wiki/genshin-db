					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Tidak! Panuelle, itu tidak mungkin terjadi! Aku ini selamanya temanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Maaf ya! Aku terlalu fokus sama pikiran sendiri sampai tidak dengar omonganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Aku kira ... kamu tidak ingin melihatku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Baiklah, salah pahamnya sudah kelar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Iya! Paimon sudah ngira kalian berdua ini keras kepala, dan marah besar sampai enggak mau ngertiin lawan bicaranya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Yah, memang ruwet sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "Terima kasih, tamu yang terhormat. Tanpa kamu, aku mungkin masih sedih di sana dan tidak mau keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Tapi sekarang aku sudah bisa bicara dari hati ke hati dengan Panuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Aku akan selalu dengarkan kamu, Chauvigne. Mau bicara soal merantau kek, atau pot kembang kek ... aku pasti dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Baiklah. Tamu yang terhormat, ini. Ambillah. Untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Semoga dewi memberkati, dan semoga kamu tidak akan pernah berselisih paham dengan temanmu. Semoga akan selalu ada orang yang bersedia mendengarkan curhatanmu.",
