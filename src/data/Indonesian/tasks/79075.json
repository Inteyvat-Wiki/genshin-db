					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Fiuh, anginnya reda juga akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Tolong dengarkan kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Baiklah. Aku mau dengar ... tapi sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "Lihat muka sendiri deh, di kaca! Aku yakin kalian penasaran banget: \"KENAPA BUNGA INI BISA NGOMONG?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Atau mungkin \"Kenapa kamu berubah jadi pot kembang?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "Memang orang lain biasa tanya gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Di luar sih iya. Setelah aku pulang ... tidak ada yang tanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "\"Di luar\" nih maksudnya dunia luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Katanya kamu jadi begini setelah merantau ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Ah, hebat juga infonya! Panuelle ya yang kasih tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "Betul. Aku jadi begini ketika merantau. Hehe, kalau pinjam istilahnya si Rozel ... ini \"perubahan\" yang aku pilih sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Paimon ngerti sih soal \"perubahan\" ... tapi kenapa berubahnya jadi pot kembang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "Apa karena kamu suka banget sama tanaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Bukan. Aku cuma ingin ... menemukan \"tempat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Aku ketemu banyak orang di luar sana. Ada koki, tukang bunga, dan guru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Hampir semuanya sudah menemukan \"tempat\" yang bikin mereka merasa betah. Dan itulah kenapa hidupnya bisa mapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "Sementara aku cuma bisa merantau. Aku tidak pernah memikirkan perlu \"tempat\" yang stabil untuk diri sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "\"Pot kembang\" ini \"tempatmu\" ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Betul. Kamu cepat pahamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "Pot kembang selalu punya \"tempat\", aku selalu merasa betah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Tapi ... setelah punya \"tempat\" dan punya pot yang bikin betah, kenapa aku masih ingin merantau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Pada akhirnya aku memang Perantau sih ya. Kalau tidak merantau, apa gunanya diri ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Aku tidak paham. Semakin banyak yang aku lihat di dunia luar, semakin aku tidak paham. Di antara \"tempat\" dan \"rantau\", mana yang lebih penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Semakin dipikirkan, semakin sakit kepala. Ketika bicara dengan Panuelle, aku selalu menghindari pertanyaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Aku takut menyesatkan dia. Kalau dia suka merantau, apa mungkin dia akan benci setelah melihat aku jadi begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "Dia selamanya temanku. Aku harus jujur, dan aku sudah menjawab semua pertanyaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Termasuk soal ... kenapa aku menjadi pot kembang. Supaya punya \"tempat\" yang bikin betah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Mungkin jawabannya bikin dia kesal ... Atau, dia tidak suka aku yang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Hubungan jadi renggang, tapi aku ini pot kembang. Tidak bisa naik ke atas sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Tapi ini yang terbaik. Aku yakin Panuelle juga tidak mau ketemu aku. Dia pasti marah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Oh ... jadi gini toh ceritanya! Kalian masing-masing pikir temannya lagi ngambek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "Dan enggak mau ketemu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Apa? Jadi maksudnya ... Panuelle tidak marah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "Kalian berdua mikirnya sama persis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Kalian pun memberi tahu apa yang Panuelle pikirkan ke Chauvigne ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Demi langit di atas langit! Mana mungkin aku mikir begitu! Aku tidak ingin dia kesal, bahkan dia cemberut sedikit pun hati ini sudah hancur berkeping-keping rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "Tamu yang terhormat! Tolong bawa aku ke atas! Aku harus segera ketemu dia, tidak bisa ditunda lagi barang semenit ... barang sedetik pun!",
