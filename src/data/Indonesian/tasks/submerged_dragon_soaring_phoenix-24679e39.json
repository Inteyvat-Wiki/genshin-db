			"dialogs": [
				{
					"id": 762100201,
					"content": "Menakjubkan! Aku sangat kagum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "Kalau begitu, aku masih punya satu permintaan. Apa Pendekar Muda pernah mendengar tentang <color=#00E1FFFF>Teknik Mendaki Awan</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Konon, master kuno dari Klan Guhua kami pernah naik dan jalan di atas langit di tengah cahaya ungu yang indah, seolah-olah sedang berjalan di atas tanah. Dengan ilmu rahasia legendaris ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Kedengarannya tidak masuk akal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Iya, kayaknya omong kosong deh ... tapi kalau kita bisa pakai Wind Glider, mungkin bisa lakukan hal yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "Oh? Kalau begitu, silakan Pendekar Muda lakukan demonstrasinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Kalau bisa pakai Wind Glider ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
