			"dialogs": [
				{
					"id": 762100101,
					"content": "Pendekar Muda, gerakan Anda memang sangat lincah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hehe, tentu saja! {NICKNAME} kan kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "Kalau begitu, gimana kalau Pendekar Muda bisa menunjukkan padaku esensi dari <color=#00E1FFFF>Teknik Melompat</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Menurut catatan di buku, master kuno dari Klan Guhua kami bisa melompati tembok dan menyeberangi kota seolah-olah sedang berjalan di tanah datar, inilah Teknik Melompat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Luar biasa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Hmm ... gimana kalau kita coba? Lagi pula {NICKNAME} biasanya suka cari harta karun di mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Terdengar seperti pencuri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "Hehe, coba Pendekar Muda bayangkan, kalau seorang pencuri bisa melompati tembok untuk menghindari hukuman, sedangkan kita yang menegakkan hukum tidak bisa melakukannya, bukankah itu sangat merugikan kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
