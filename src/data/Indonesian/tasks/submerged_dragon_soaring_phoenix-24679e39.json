			"dialogs": [
				{
					"id": 762100301,
					"content": "Lihatlah ini, \"Formasi Pohon Plum\" kami, kebanggaan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "Apakah Pendekar Muda bisa melangkah dan melompat di atas tiang-tiang selama batas waktunya, dan menunjukkan kemampuan Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Tidak masalah. Segampang membalikkan telapak tangan itu sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Tapi tangannya ada banyak ... uh, lupakan saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "Kalau begitu, silakan Pendekar Muda tunjukkan kemampuan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Sebenarnya Paimon, si pemimpin Klan Paimon pun bisa melakukannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Enggak mungkin! Mana mungkin ... eh? Kalau dipikir-pikir, kayaknya terbang enggak ngelanggar aturan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
