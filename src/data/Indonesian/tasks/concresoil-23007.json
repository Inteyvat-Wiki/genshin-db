			"dialogs": [
				{
					"id": 230070201,
					"content": "Aku punya beberapa ide sekarang. Untuk hari ini ... aku mau cari Tanah yang direndam dengan Slime Condensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "Aku sudah bertanya ke salah satu pengepul Slime. Pengembara, apa kamu bisa membantuku mengambilkan tanah liatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Kalau begitu tolong ya. Entah bisa mengalahkan Slime tidak jadi masalah, asalkan tanah liat di dekatnya bisa diambil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Lokasi pengepulan Slimenya sudah aku tandai di peta ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "Kamu sendiri tidak pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Aku juga mau pergi, tapi aku masih mau menyelesaikan dulu masalah barang-barangku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "Tenang saja, aku sudah menyiapkan imbalannya, jadi tolong aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Tolong pergi ke sini, tempatnya sudah kutandai di peta ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
