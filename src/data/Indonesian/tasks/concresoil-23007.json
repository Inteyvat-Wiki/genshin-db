				},
				{
					"id": 230070302,
					"content": "Whopperflower di sana bisa jadi pilihan. Tanah liat tempatnya tumbuh unik dan lain daripada yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070303,
					"content": "Tapi aku cuma tukang tembok, tidak mungkin aku bawa pot untuk menghancurkan Whopperflowernya.",
