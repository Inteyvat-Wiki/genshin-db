				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "Apakah ada bahan yang lebih baik lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "Bahan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Maaf, aku barusan ngomong sendiri lagi. Belakangan ini cuacanya susah diprediksi dan banyak sekali masalah di rumah. Aku sedang benar-benar sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "Bukannya kamu ini yang membuat porselen ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Betul, tapi aku juga tukang tembok. Semuanya berhubungan dengan tanah, jadi tidak banyak bedanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Apa kamu pernah dengar ini, \"Belajar sama dengan membangun rumah. Kalau mau bangunan yang tinggi, fondasinya juga harus baik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "\"Kalau kamu mau mengembangkan teori akademis, dasarnya juga harus diperkuat. Kalau dasarnya tidak kokoh, akan mudah digoyahkan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Tokoh-tokoh pintar selalu mengatakannya. Aku tidak terlalu paham, tapi aku rasa mereka menganggap membangun rumah sama pentingnya dengan belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "Ini cuma perumpamaan saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Bagaimanapun, begitu aku dengar fondasi rumah, yang muncul di pikiranku adalah bahan bangunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "Tanah itu bahan perekat dan penyokong bangunan. Kalau kekuatan dan kesesuaiannya bisa ditingkatkan, rumah akan semakin kokoh. Aku pun juga tidak bakal sesibuk ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "Seharusnya bukan begitu penjelasannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
		{
