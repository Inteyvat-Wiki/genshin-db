				{
					"id": 230070301,
					"content": "Aku punya beberapa ide sekarang. Untuk hari ini ... aku mau cari tanah yang sering bersentuhan dengan makhluk elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
