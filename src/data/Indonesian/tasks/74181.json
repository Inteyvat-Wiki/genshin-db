			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Kamu ngapain di sini? Nona Melo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Oh ternyata kalian. Kudengar suamiku yang tak berguna itu punya markas di sini, jadi aku datang buat lihat kondisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "Tapi, lihat nih apa yang kutemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "Dia benar-benar bawa fotonya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Hehe, Paman Rocher masih sayang istri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Kami sudah curiga sama kamu, cuma Paman Rocher saja yang bersikeras kalau kamu enggak mungkin bisa lakuin kejahatan itu. Kami enggak ngerti kenapa dia bisa percaya diri begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Bisa jadi kejantanannya ludes dipakai semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "Serius! Terus dia juga bilang ke kamu kalau liontinmu hilang karena dia judi? Sebenarnya dia bohong, tapi terlalu malu untuk bilang yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Oh, itu? Sebenarnya aku sudah tahu, tapi tidak pernah percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Suamiku banyak kekurangan. Penakut, pengecut, pemalu, tapi aku tahu dia orangnya sangat jujur. Dia bisa ditipu, tapi dia bukan penjudi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "Aku tidak tanya apa-apa, karena aku mau tunggu sampai dia akui sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Wah, baik banget ya. Sayangnya kita tidak tahu dia lagi di mana sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Ssst ... Lihat sebelah sana! Aku seratus persen yakin dia lagi sembunyi di dalam kotak itu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(Hah ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(Itu kebiasaan lamanya. Setiap kali kami bertengkar, dia pasti sembunyi di dalam lemari. Bisa-bisanya dia pikir aku tidak tahu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Kamu mau kami bawa dia ke sini?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Tidak usah repot-repot, kita lihat saja dia bisa sembunyi sampai kapan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "Oh iya, aku perlu bantuanmu untuk hal lain. Kalau kamu ketemu Curve dan Agen Talochard, tolong bilang ke mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "Aku sudah bersihkan beberapa ruangan, jadi mereka boleh datang kapan pun. Tentu saja, Rumah Lombroso juga terbuka untuk kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#Tapi ... {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Baiklah, kami mengerti, Nona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Oke ... kalau begitu kami cabut dulu. Paimon harap Paman Rocher bisa cepat-cepat akui semuanya. deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Terima kasih. Semoga kalian bisa menemukan jawaban dari semua pertanyaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
