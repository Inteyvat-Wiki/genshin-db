			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "Pasti ada yang salah dengan batu kuning kehijauan itu! Ada yang salah! Aku akan mati di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Um, kamu enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "Aku ... datang dari tempat jauh. Aku tidak kenapa-kenapa kok. Cuma aku harus meninggalkan kalian lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Ya sudah kalau tidak apa-apa. Dadah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Tidak! Tidak! Orang ini sama sekali enggak kelihatan tidak apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "Tidak, aku tidak masalah kok. Kalau memang bermasalah, semuanya juga sudah terlambat ... Ugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "Jadi kamu itu ada masalah atau tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon pusing deh. Bisa langsung ngomong intinya enggak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Kalau diperjelas lagi. Sejak aku di Zona Produksi ini, kepalaku sering sakit, kaki tanganku jadi dingin, kadang jantungku berdetak cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "Mati aku! Aku pasti mati! Kalian mengerti, kan? Mati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Pasti gara-gara batu kuning kehijauan itu. Dasar batu biadab! Kalian pasti tahu, kan? Laboratorium Pusat Institut Penelitian Fontaine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "Batu kuning kehijauan itu yang hancurkan semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Mending ke dokter deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "Aku ini dokter loh! Tunggu, aku sekarang bukan dokter lagi. Aku sudah tidak punya sertifikasi, aku sudah tidak bisa melakukan diagnosis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Tolong, carikan dokter beneran, yang punya sertifikasi, untuk tolong aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Eh ... Kayaknya dia gawat deh ... {NICKNAME}, kita cariin dokter deh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Mau istirahat dulu di klinik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "\"Meninggalkan kami lebih dulu\"? Aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "Kalau dilihat sih sama sekali enggak mirip baik-baik saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
