				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Kamu punya masalah? Atau orang lain? Kalau diliat dari muka kalian yang sehat, harusnya orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Memang benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Kamu menjelaskan kondisi Lechlade ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Dia lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Apa bisa disembuhkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Maksudnya, sakit kepalanya atau kegilaannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Eh? Maksudnya? Dia enggak sakit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Kalau dari hasil laboratoriumnya sih, kemungkinan besar tidak sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "Aku dengar dia pernah salah diagnosis waktu di luar, dia mengabaikan gejala awalnya dan buat pasien jadi ... *huff* Pokoknya, sejak saat itu, mungkin dia jadi sedikit paranoid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Sama orang lain begitu, sama diri sendiri juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "Kalau soal batu kuning kehijauannya bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Aku lihat selain dia, orang lain hidupnya juga biasa-biasa saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Meski begitu, aku tidak bisa biarkan dia begitu saja. Tolong berikan ini kepada dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Ini kan ... Pure Water? Yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Oh ... Jadi kalian sudah tahu soal ini ya? Tidak masalah, setidaknya tidak berbahaya bagi tubuh, masih bisa membangkitkan semangatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Memangnya dia tidak tahu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Setahu aku sih, dia tidak menyentuh minuman kayak begini. Dulu aku juga pernah kasih ke dia ... Aku bilang ini obat yang berguna untuk kesehatanmu. Setelah minum, memang dia jadi lebih bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Ya sudah, kita berikan ini kepada dia dulu. Kalau masih tidak sembuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Suruh dia datang saja ke klinik untuk berbaring. Bilang saja pesan dokter, dia pasti patuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Oke, yuk kita cari dia, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Tidak kasih Fonta saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Nah itu masalahnya. Semua orang di sini tahu rasa Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Tapi sepengetahuanku, dia tidak pernah minum Pure Water. Soalnya kan jarang ditemukan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Dulu aku juga pernah kasih ke dia ... Aku bilang ini obat yang berguna untuk kesehatanmu. Setelah minum, memang dia jadi lebih bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
