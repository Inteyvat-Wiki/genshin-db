					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "Lihat! Ada dua pahlawan lagi yang datang! Anda pasti datang untuk menantang \"Embusan Angin Utara\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Silakan, ayo ikut aku. Aku sudah tidak sabar ingin melihat Anda terbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Sabar, sabar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Terbang itu tidak perlu kesabaran, tamuku yang terhormat. Sama sekali tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Terbang dengan sabar hanya akan membuat perasaanmu terhadap angin makin lemah. Kita baru bisa menggali potensi terpendam kita saat dihadapkan dengan angin ganas tanpa persiapan apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Tupai-tupai terbang zaman sekarang terlalu pengecut! Mereka sama sekali lupa tentang ajaran yang tertulis dalam \"Angin Utara Pemberani\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Cuma berani berdiri di tempat aman saja dan memuji keberanian daun yang menari-nari bersama angin, tapi diri sendiri malah takut untuk langsung melompat ke dalam pelukan angin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Kalau begini terus, bagaimana mungkin kami bisa melindungi seluruh kerajaan bersama dengan Tuan Putri?!? Tidak masuk akal! Sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Benar-benar tupai terbang yang bersemangat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Sepertinya kamu memang suka sekali terbang ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Makanya, aku berhasil mencari jalur angin yang benar-benar kuat, dan memasang berbagai jenis alat di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Hanya pahlawan yang kemampuan terbangnya benar-benar hebat yang bisa melewati lintasan arus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "Kedua tamu yang terhormat, apa kalian punya keberanian ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Boleh deh, coba yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Baiklah. Silakan ikuti aku. Tempatnya tidak jauh dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Anu ... aku tiba-tiba kebelet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Kenapa? Masih mau persiapkan diri ya? Baiklah. Aku akan tunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Kalau kalian berdua mau menantang lintasan anginnya, silakan cari aku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Aku belum bilang apa-apa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}