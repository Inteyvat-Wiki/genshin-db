			"dialogs": [
				{
					"id": 741360901,
					"content": "Para bedebah Institut! Memang si Choiseul dan Raimondo bayar berapa sih ke kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Cuma kasih titel doang kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Ka-Kamu ... Ugh, lepaskan aku, Field Generator-ku sudah hampir selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Asalkan inti energi ini bisa disatukan Inti Kinetis Arkhium, maka ... aku akan menjadi insinyur energi kinetis terhebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "Padahal kamu jelas mengambil karya orang, tapi masih mengaku insinyur terhebat. Memalukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Akhirnya sekarang aku tahu kenapa sebelumnya, Edwin ... tidak pernah mengizinkanmu ikut dalam penelitian ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin tidak paham nilai sebenarnya dari benda ini! Kamu juga dari Institut, seharusnya kamu paham betul nilai dari benda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Bantu aku, kita bisa mengembangkannya bersama-sama dan aku yakin, tidak akan ada yang bisa lebih hebat daripada kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul ... Tidak akan ada yang bisa menandingi kita lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Sepertinya yang Raimondo katakan itu betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Hasil penelitian Edwin ... adalah milik Institut. Aku cuma datang untuk ambil itu saja. Sisanya ... aku sama sekali tidak tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Nona Fusilier ... panggilanmu ke Edwin jadi beda ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Dasar bodoh! Nona, kamu tidak tahu berapa banyak keuntungan yang bisa diberikan oleh Tuan Concini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Aku tidak bakal bisa dapat keuntungan sebanyak ini kalaupun aku kerja untuk Edwin selama 10.000 tahun! Edwin dan Institut cuma mau memanfaatkan kita ... Kita harus cari cara untuk diri kita sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Cukup, tidak perlu bicara lagi. Tutup mulutmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "Siapa kamu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Aku orang yang menjaga Pelabuhan Lumidouce ini, kalau kamu macam-macam, kamu bakal merasakan tinjuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, bantu aku untuk bawa dia balik bersama intinya. Kita harus segera kembali dan melaporkan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Pasti selama ini kamu merasa tak puas ya, Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Aku kerja sukarela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
