			"dialogs": [
				{
					"id": 741361101,
					"content": "#Nona Fusilier! {NICKNAME}, kalian sudah kembali! Masalahnya sudah selesai kan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Wadaw! Tuan Choiseul betulan pingsan tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Tidak kusangka, kamu balik lagi ke Institut, Choiseul. Aku kira di kehidupan ini kamu bakal berurusan terus sama cap terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Ini ... tidak mungkin! Astaga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, bagaimana perasaannya setelah lanjutkan perasaanku? Apa ada pekerjaan yang perlu dilaporkan kepadaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "Benar-benar pertemuan yang ajaib, Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ha! Lihat dong sekelilingmu, kamu cocoknya sih jadi tukang bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "Huh. Dia bersih-bersih juga tidak akan bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Terutama karena dia tidak membersihkan kamu tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Terima kasih karena telah membawa kedua orang ini, Peneliti Honoris Tingkat Lanjutan {NICKNAME}, dan juga Nona Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Kesialan dan kekacauan di Institut Penelitian Fontaine akan dihentikan pada hari ini juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha. Luar biasa. Institut Penelitian Fontaine akan tenggelam dalam keheningan yang tenang, dan tidak akan punya aliran inspirasi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Kamu sudah membuat seluruh aliran inspirasi di dalam Institut Penelitian Fontaine jadi luar biasa. Sudah waktunya untuk tenang sejenak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport. Kamu sama sekali tidak tahu soal penelitian. Kamu tidak bisa memimpin Institut Penelitian Energi Kinetik Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Tapi aku tahu bagaimana cara bekerja dengan benar dan normal di dalam Institut Penelitian Energi Kinetik Fontaine, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Demi kepentingan semua orang, yang harus kamu lakukan sekarang adalah tidak melakukan segala bentuk penelitian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Setelah beberapa saat, anggota Maison Gardiennage datang dan membawa pergi Nacker dan Edwin. Demi kebaikan mereka juga, mereka akhirnya bisa terbebas sepenuhnya dari Institut Penelitian Fontaine ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Akhirnya mimpi buruk ini berakhir juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Tuan Chaussivert dan Tuan Lemarcq, benar kan? Aku sudah pernah dengar tentang bantuan kalian terhadap proyek di Institut dari orang-orang. Hadiah yang setimpal sedang dipersiapkan. Silakan beristirahat sebentar dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha, aku benar-benar tidak menyangka, orang sepertiku bisa berhubungan dengan Institut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Jangan merendah begitu, Tuan! Anda adalah orang baik, ramah dan tulus. Di kemudian hari mungkin kami juga bakal minta bantuan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "Dan Anda ... Peneliti Honoris Tingkat Lanjutan, Anda telah banyak membantu Institut. Bagaimana caraku berterima kasih pada Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Pokoknya jangan sampai ada ledakan lagi deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Eh? Ngomong-ngomong Nona Fusilier bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "Biarkan dia tenang dulu. Sepertinya sosok Edwin Eastinghouse dalam bayangannya sudah hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin dan Nacker juga perlu menenangkan diri ... Semoga mereka bisa khilaf deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Apa mereka bakal selamanya jadi tahanan di Benteng Meropide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Mereka berdua itu berbahaya, kuharap mereka tidak akan pernah keluar dari penjara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Tapi dengan kondisi Institut Penelitian Fontaine saat ini ... *huff* Semoga aku tidak akan ketiban kerjaan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "Sekali lagi mewakili Institut Penelitian Fontaine, aku berterima kasih padamu, Peneliti Honoris Tingkat Lanjutan. Kalau masih ada pertanyaan lain ... silakan langsung saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Titelku bisa ditambah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Hmm, secara teorinya sih, titelmu itu sudah yang paling tinggi loh ... Tapi aku mungkin bisa ajukan titel khusus untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "Misalnya, Kepala Peneliti Honoris Tingkat Lanjutan? Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
