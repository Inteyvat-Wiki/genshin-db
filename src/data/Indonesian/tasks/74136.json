			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin ... Aku tahu! Kamu yang pancing mereka kan! Kamu iri padaku! Kamu takut penelitianku lebih bagus daripada punyamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Iya nih! Aku iri sekali sama dirimu yang polos dan tidak tahu apa-apa. Pantas dulu di Institut hidupmu nyaman sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Kalau Choiseul melihat ini, pasti dia bakal pingsan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Mending dia jangan bangun deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Kami bawa mereka kembali ke Institut, buat mereka mengaku. Aku di sini akan melanjutkan penelitianku ... Kamu tidak merusak perangkat penelitianku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Siapa yang mengizinkanmu untuk lanjut meneliti?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Mau apa kalian? Jangan-jangan aku bakal ditangkap buat balik ke Institut, nanti aku gimana melanjutkan penelitianku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Si bodoh Raimondo itu pasti buat Institut Penelitian jadi kacau balau, terus si idiot Choiseul itu ... Duh. Mikirnya saja buat aku sakit kepala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Kan kamu yang bikin Institut jadi kacau! Tanggung jawab dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Aku? Oke, jadi Institut melimpahkan semua tanggung jawab soal ledakan itu padaku, kan? Nih ya, waktu ledakan itu terjadi, aku tidak ada di Institut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Di Institut banyak orang-orang tidak kompeten, secangkir kopi saja bisa bikin perangkat penelitian rusak, tidak heran dong kalau bisa ada ledakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Terus kenapa kamu enggak jelasin ke mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Penjelasan? Aku tidak bakal jadi kambing hitam mereka! Masih ada penelitian yang harus aku kerjakan. Aku tidak boleh sia-siakan waktuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Jadi, kamu ada masalah sama Concini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Heh. Concini juga tidak beda jauh. Bahkan satu perangkat akurat saja tidak sanggup dibeli. Semuanya harus aku kerjakan sendiri. Untung dia bersedia keluar uang, jadi penelitianku masih lancar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Tapi tidak kusangka, Tuan Nacker yang tercinta datang dengan membawa prototipe yang bahkan tidak bisa berfungsi sepenuhnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Aku sudah modifikasi ya! Teknologi yang aku pakai pasti tidak mungkin bisa kamu kembangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Hahaha! Tuan Nacker, sekarang sudah tidak ada Concini yang bisa dicari perhatiannya. Jangan tipu dirimu sendiri lagi deh. Harga diri seorang peneliti, sedikit pun kamu tidak punya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Kamu ... Fitur yang masih belum sempurna itu gara-gara kamu tidak tahu cara perbaikinya! Aku tahu! Aku bisa selesaikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Oh begitu ya? Coba sekarang bawa sampah ini dan kembali ke Institut Penelitian untuk ngais-ngais. Masih ada hal penting yang harus aku lakukan. Yang namanya Fusi ... siapa itu, aku serahkan kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Mereka berdua malah sibuk debat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "Cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Jangan buang-buang waktuku lagi, aku masih banyak kerjaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Sudah cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Kamu adalah pelaku di balik ledakan Institut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "Nacker! Kamu ... kamu mencuri aset Institut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Dan menyebabkan Institut meledak lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Kalian sudah merusak kepentingan Institut Penelitian. Sebagai penyelidik khusus Institut Penelitian Fontaine, aku akan bawa kalian semua kembali ke jalur hukum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Oh ... Tolong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Aku dan Lemarcq akan menahan kedua orang ini. Sudah sibuk selama ini ... Institut harusnya beri kami sedikit imbalan, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Ingat tutup mulut yang rapat selama perjalanan. Kalau tidak, kamu akan temui ajalmu lebih cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Berhenti! Jangan bergerak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Aku saja sudah hampir pingsan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
