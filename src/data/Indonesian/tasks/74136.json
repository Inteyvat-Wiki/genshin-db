			"trigger": {
				"objectNames": [
					"Edwin Eastinghouse",
					"Lemarcq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Kalian ... tuh kan kembali lagi. Sudah kubilang. Biarpun bolak-balik lima kali juga pasti tidak bisa ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Sudahlah kalau gagal, duduk saja sini minum teh dulu. Kebetulan aku juga membeli lima cangkir teh ... dan beberapa mangkuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Tuan Edwin, Anda benar-benar menyukai angka lima ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Oh, lima adalah angka yang punya kekuatan ajaib. Kalau pemakaiannya tepat, ia bisa membuka gerbang inspirasi loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Sekalian kuberi tahu, gerbang inspirasi total punya lima kipas, minimal kamu harus memutar kenop gerbangnya lima kali ... lima! Paham? Lima kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Maaf, sekarang aku sungguh ingin menonjokmu lima kali. Tolong tutup erat mulutmu, bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
