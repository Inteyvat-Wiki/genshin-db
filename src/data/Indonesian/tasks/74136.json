			"dialogs": [
				{
					"id": 741360601,
					"content": "Tempat ini luas banget tapi di dalam enggak ada apa-apa, kita malah ngabisin waktu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "Tanaman di sini sepertinya sudah dibersihkan, bekas jejaknya masih baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "Buat nyari dia saja aku sampai harus melewati lumpur begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Aku akan pergi dan lihat sendiri. Kalian temani Nona peneliti ini, kalau situasinya gawat ... langsung bawa dia pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Tapi di sini tidak ada apa-apa. Ah sudahlah, toh situasinya tidak mungkin bakal jadi lebih buruk dari ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Ngik! Bip! Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Wow! Hati-hati di sana! Ada yang lagi datang mau menerjang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
