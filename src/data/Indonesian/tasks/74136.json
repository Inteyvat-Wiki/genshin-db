			"dialogs": [
				{
					"id": 741360401,
					"content": "Jadi ternyata dia selalu menyebut angka \"lima\" itu buat ngasih tahu kita cara memecahkan teka-teki ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Padahal dia kan bisa langsung kasih tahu kita, kenapa harus ribet gitu sh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Huh, siapa yang tahu dia ada niatan apa di baliknya ... Tapi kayaknya memang dia selalu pancing kita buat cari Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Peralatan selam ini ada di sebelah sana, kayaknya sengaja disiapin buat kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Sepertinya dia yang menemukan kita duluan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Tidak ada nilainya sama sekali ... Aku ... padahal sudah lama memikirkannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Si Fusilier ... mikirinnya lama banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Tapi ... {NICKNAME}, kamu ngerasa enggak sih kayak ada yang ngawasin kita? Paimon kok ngerasa kayak ada yang ngawasin kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "Aku akan pergi ke tempat yang pertama dan coba lanjut cari di dalam sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Ya sudah, yuk urusin si Nacker dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
