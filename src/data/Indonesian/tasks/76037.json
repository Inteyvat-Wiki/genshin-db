				{
					"id": 760370501,
					"content": "(Mengenai penyelundup ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "\"Target Berhadiah: New Iron and Salt Gang. Alasan Dicari: Diduga terlibat dalam penyelundupan skala besar dan perdagangan barang berbahaya yang dilarang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370503,
					"content": "\"Berdasarkan investigasi, kelompok ini memiliki Titik Kendali sementara di <color=#00E1FFFF>perkemahan di pantai utara kota</color>. Spina di Rosula akan memberikan imbalan besar kepada mereka yang membantu menghentikan kegiatan penyelundupan mereka.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Target Berhadiah"
				}
			]
		},
