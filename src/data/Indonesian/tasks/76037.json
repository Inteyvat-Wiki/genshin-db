					"nextDialogs": [
						760370602
					]
				},
				{
					"id": 760370602,
					"content": "\"Target Berhadiah: Mantan juru mudi kapal Atlas, dengan nama Hark si \"Rahang Retak\". Alasan Pencarian: Terlibat dalam beberapa kasus pembunuhan dengan metode yang kejam, keberadaan saat ini tidak diketahui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370603,
					"content": "\"Siapa pun yang dapat memberikan informasi tentangnya, setelah diverifikasi, akan mendapatkan imbalan besar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
