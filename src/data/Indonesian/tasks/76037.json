				{
					"id": 760370401,
					"content": "(Tentang Kairagi ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "\"Target Berhadiah: Gonpachi, orang Inazuma, berpakaian gaya Kairagi. Alasan Dicari: Menyerang pedagang keliling tanpa pandang bulu, beberapa orang telah tewas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370403,
					"content": "\"Target terakhir kali terlihat di sekitar <color=#00E1FFFF>Koridor Ketiadaan</color>. Asosiasi Dagang akan memberikan imbalan besar kepada siapa pun yang dapat mengalahkannya dan menyerahkan bukti kematiannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Target Berhadiah"
				}
			]
		},
		{
