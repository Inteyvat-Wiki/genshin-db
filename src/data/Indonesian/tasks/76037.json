			"dialogs": [
				{
					"id": 760370101,
					"content": "Informasi keempat target berhadiahnya ada di papan, kamu bisa tanya padaku, tapi jumlah hadiahnya tidak bisa ditawar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Serahkan bukti bahwa target berhadiahnya telah kamu kalahkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Tentang target berhadiahnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Saat ini ada empat target, tapi hanya tiga yang memiliki petunjuk. Hidimbi, seorang Peramal Sumeru yang dituduh melakukan penipuan dan kini diburu, sering terlihat di <color=#00E1FFFF>sekitar pelabuhan selatan</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Ada Kairagi Inazuma yang mengamuk dan telah membunuh banyak pedagang keliling yang melewati <color=#00E1FFFF>Koridor Ketiadaan</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Anggota geng yang menyelundupkan barang berbahaya bersembunyi di <color=#00E1FFFF>perkemahan di pantai sebelah utara kota</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Belum ada petunjuk tentang keberadaan Hark \"Rahang Retak\", bajak laut yang sangat kejam dan berbahaya itu. Mungkin dia sedang bersembunyi di suatu tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
