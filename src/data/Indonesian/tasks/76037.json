				"points": []
			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(Tentang Hidimbi ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Target Berhadiah: Hidimbi, seorang Peramal dari Sumeru, perempuan, usia tidak diketahui. Alasan Dicari: Diduga melakukan kutukan terhadap orang lain dan penipuan dalam jumlah besar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370303,
					"content": "\"Perempuan itu menipuku sebesar 18 juta Mora, katanya kalau memakai kalung yang dia dapatkan dengan susah payah dari Al-Ahmar sang dewa cinta, para gadis akan langsung jatuh cinta padaku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370304,
					"content": "\"Belakangan aku baru tahu, Al-Ahmar itu bahkan bukan dewa cinta, sudah mati ribuan tahun yang lalu, dan seumur hidupnya dia tidak pernah berhasil mendapatkan gadis yang dicintainya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Target Berhadiah"
				},
				{
					"id": 760370305,
					"content": "\"Dari sini bisa disimpulkan, kalung yang dia jual padaku memang asli, tapi itu kalung asli yang mengutukku agar tidak bisa jatuh cinta. Siapa pun yang bisa menemukan keberadaannya dan membantuku melepaskan kutukan ini akan kuberi imbalan yang besar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Target Berhadiah"
				}
			]
		},
		{
			"id": 7603704,
			"completionStepIds": [],
