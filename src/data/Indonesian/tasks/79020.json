			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "Coba Paimon lihat! Hmm ... ini kayaknya semacam peta harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Ah masa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "Heh! Paimon enggak pernah salah kalau bicara soal harta karun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Eh, kayaknya sih \"Ako Domeki dan kawan-kawannya\" yang ninggalin gambar ini. Kok kayaknya kita pernah dengar di mana gitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "Terus, lihat nih! \"Tempat harta karun disembunyikan ...\" Lihat kan?! Sudah pasti lah ini harta karun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Coba kita lanjut baca ... \"terbagi dalam empat bagian ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Intinya mereka bagi sesuatu jadi empat bagian, gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "Jadi harta karunnya ada empat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Emm ... Paimon juga ... kurang yakin sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Ah tapi apa pun itu, kan sudah jelas di sini ditulis sesuatu \"diletakkan di tengah-tengah batu karang dari empat pulau\". Itu maksudnya batu karang di empat pulau di Golden Apple Archipelago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "Tunggu, bukannya ini salah satu dari batu karang tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Hmm, jadi artinya ada empat petunjuk ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "Dan harusnya dekat batu karang di empat pulau, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "Hmm, maksudnya empat yang paling besar di kepulauan, gitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "Yuk kita coba lihat tiga pulau lainnya dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200108,
					"content": "Jadi maksudnya ada empat petunjuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
