			"dialogs": [
				{
					"id": 750910401,
					"content": "Mmm ... sabar, orang sabar disayang dewa. Kalau sudah sepi, aku kasih ini ke Batu Pusaka ... Hehe, terima kasih, terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910402
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910402,
					"content": "Batu Pusaka ... keluarkan batu yang lebih bagus ... hehe ... satu, dua ....",
