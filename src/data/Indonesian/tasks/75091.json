					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Wah, beneran bisa loh! Dan lebih bagus dari yang sebelumnya. Masih kayak sulap, padahal sudah dua kali lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "Hehe, hehe ... orang asing yang penuh kecurigaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Sudah melihat, maka tidak dapat lagi menyangkal. Batu Pusaka ini asli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Aah, dan berkat batu-batu dari kalian, dia semakin kuat ... semakin kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Akan jadi sekuat apa dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Nah, Paimon berhasil dibikin kepo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Dikasih \"makan\" batu, terus dia muntahin batu yang lebih bagus? Ini gimana sih cara kerjanya?! Gimana kalau kita bongkar? Pecahin batunya, lihat apa dalamnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "Be-Beraninya! Beraninya menyarankan seperti itu! Tidak boleh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Kalau kalian serius mau pecahkan ... langkahi dulu mayatku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Uhh, itu tadi cuma asbun, suer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Hmph, karena kalian yang membawa batu ... aku akan hiraukan omong kosong barusan ... sekali ini ... hanya sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "O-Oke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Terasa! Sangat terasa! Batu yang lebih bagus, berikan ke Batu Pusaka! Aku yakin hasilnya akan sangat luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "Orang asing, dulu ada pedagang asing yang cerita soal batu khusus dari padang pasir yang mengandung kekuatan luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Namanya ... Trishiraite. Ya. Bawakan ... aku ingin berikan ke Batu Pusaka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Aku yakin ... sangat yakin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Hmm ... gimana menurut kamu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Yuk cobain!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Paimon sudah resmi kepo sih sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Trishiraite ... satu saja, satu saja cukup ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
