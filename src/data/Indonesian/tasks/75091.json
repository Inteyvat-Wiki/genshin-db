			"dialogs": [
				{
					"id": 750910301,
					"content": "Wah, beneran ada yang keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Batu Pusaka, hip-hip ... sebentar, itu sih kamu yang simpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "Heh, hehe. Mana mungkin aku bodoh begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Batu Pusaka menjadi semakin semangat setelah dapat batu dari kalian. Dengar ... dengar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Suara berdenyut, seperti aliran magma di perut bumi ... Ah ... detak jantung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Aku tahu masih perlu kasih batu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Uhh ... Paimon enggak dengar apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}, bisa dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "Batu. Batu doang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Ya kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "Hehe, orang asing ... tamu-tamu terhormat yang datang dari tempat jauh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Tolong ... bawakan batu lagi. Lebih bagus, lebih banyak, lebih berharga ... Batu Pusaka tidak akan mengecewakan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "Aku tahu ... aku bisa merasakan kalau ini baik untuknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Ini kenapa rasanya kayak kita makin kemakan sama dia ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}, menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Kalau kita bisa dapat gantinya yang lebih bagus lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Ya cobain dulu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910320,
					"content": "Hehe bagus! Kali ini, cari batu yang lebih baik dari yang sebelumnya, dan berikan padaku ... dengan batu yang lebih bagus, Batu Pusaka ini akan semakin kuat ... semakin kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910311,
					"content": "Tidak dengar? Teriakannya? WUUUUAAAAAAARRHH~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "ENGGAK! Mau nakut-nakutin lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
