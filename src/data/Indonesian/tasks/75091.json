			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Satu, dua ... tiga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Hmm, hmm ... satu, dua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Paimon, ada orang aneh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "Ah, yang aneh bukannya kalian ya, orang asing? Ho ... hoho ... ini bukan tempat yang umum didatangi orang asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "Memangnya ini tempat apa? Terlarang? Keramat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "Bukan, cuma tempat yang kebetulan aku temukan ... tempat harta terkubur. Hmm, sini kalian. Kedengaran? Batu yang di depan ini ... namanya \"Batu Pusaka\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Suara berdengungnya naik turun, seperti ... suara embusan napas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "Batu hidupnya keras ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Cuma bernapas. Keras apanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Batu ... bisa napas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Bisa, dan bukan cuma itu. Kalau kamu tempel kuping ke sana, nanti kedengaran ada detaknya ... suara batu yang bergesekan dengan batu lain ... di balik permukaannya yang kasar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Hehe ... hoho ... suara indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Dan, dan ... kalau dikasih makan batu kecil, dia akan berikan ... batu bersinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Aaah, luar biasa sekali. Lihat, batu permata! Satu ... dua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Oh, jadi itu yang lagi kamu kerjain tadi. Menghitung batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Ya, dan aku yakin setelah melahap semua batu ini, Batu Pusaka sekarang sudah jadi jauh lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "Ini ... mukjizat! Batu Pusaka ... pusakaku yang berharga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Mencu ... rigakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "He, hehe ... orang asing memang tidak akan percaya. Tidak ada yang akan percaya ... sebelum mencoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Aku sendiri baru tahu setelah menaruh bijih bumi di ujung Batu Pusaka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "Cobalah ... coba! Yang melihat akan percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Tapi dia sudah makan semua batu di sekitar sini. Harus kasih yang baru ... tapi tidak bisa cari sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Lah, kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Karena harus ada yang diam di sini menjagai Batu Pusaka! Ba-Bayangkan, gimana kalau dia sembunyi ke bawah tanah ketika aku tak ada ... harus gimana?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Aku sudah jaga di sini lama sekali ... batu yang aku punya, sudah dia lahap semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "Pe-Pergi! Cari batu dan bijih, lalu aku beri kalian bukti! Aku ka-kasih ke Batu Pusaka di depan mata kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Hmm, jurus klasik tukang tipu masih dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Gimana {NICKNAME}? Mau iseng coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Yah, cuma batu sih enggak rugi juga ya",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Hehe, baiklah! Cari batu, bawa ke sini, aku kasih makan Batu Pusaka ... dan kalian akan dapat gantinya yang lebih bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Masa sih? Ini jurus tipu-tipu terbaru ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Aku juga mahir bernapas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Ya, lalu apa spesialnya itu?! Ini kita ngomongin apa sih!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
