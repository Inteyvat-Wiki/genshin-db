				"points": []
			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "\"Jika kamu membaca pesan ini, aku harap kamu adalah orang yang kunantikan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270102,
					"content": "\"Ini surat yang keberapa? Sampai seberapa jauh surat ini akan mengapung dan akan terdampar di pantai mana kah surat ini?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270103,
					"content": "\"Jika kita bertemu lagi, ceritakan padaku tentang gunung di pelabuhan, salju di utara, atau tentang bunga dandelion dan anggur, bagaimana menurutmu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270104,
					"content": "\"Aku akan selalu menunggu balasan darimu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botol Terdampar"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
