			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "\"Jika kamu membaca pesan ini, aku harap kamu adalah orang yang kunantikan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270202,
					"content": "\"Kami pernah berpikir bahwa peperangan hanyalah cerita yang ada di dalam dongeng. Tapi sekarang, masing-masing dari kita semua gemetar ketakutan di bawah amukan Yang Mulia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270203,
					"content": "\"Pantai yang sering kami kunjungi itu sudah ditutup, tapi aku menemukan cara untuk mengirimkan surat ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270204,
					"content": "\"Jangan khawatir atau menyalahkan dirimu sendiri. mengenai ini. Ini masalah sepele bagi seseorang yang pernah bertualang denganmu sepertiku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Botol Terdampar"
				},
				{
					"id": 701270205,
					"content": "\"Aku menunggu balasanmu, meskipun hanya sepatah kata saja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botol Terdampar"
				}
			]
		}
	]
