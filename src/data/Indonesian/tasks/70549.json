							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "Caramel Blaze-mu sudah siap. Silakan dinikmati ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "Benar-benar sesuai namanya. Warnanya membuatku teringat dengan api membara, dan rasanya ... benar-benar nendang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490203,
					"content": "Ehem ... Lumayan nendang sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490204,
					"content": "Kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "Tidak masalah, aku cuma perlu waktu untuk sesuaikan diri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490207,
					"content": "Kalau tidak salah, terakhir kali aku minum anggur itu di kegiatan cicip anggur, Navia undang aku tahun lalu. Aku cuma cicip sedikit Sassica Wine saja, itu sama sekali tidak sebanding dengan minuman racikanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490208,
					"content": "Jadi kamu sama sekali tidak minum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "Kalau dari segi logika sih, alkohol bisa buat pusing dan tidak baik untuk pekerjaanmu, jadi sebaiknya dihindari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490211,
					"content": "Tapi waktu Nona Furina melihatku di pelabuhan, dia bilang kalau Mondstadt itu adalah \"bangsa anggur dan puisi\". Toh aku sudah di sini, jadi aku rasa perlu coba kuliner lokal sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490212,
					"content": "Masuk akal sih, sayang kalau tidak dicoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "Sebenarnya, berdasarkan informasiku, Kapten Pasukan Gerilya, yang akan berduel denganku ... punya selera yang lumayan soal anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490215,
					"content": "Laporan pertempurannya yang terbuka untuk umum benar-benar menakjubkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490216,
					"content": "Malah sebenarnya, Kapten Eula, yang sudah berduel denganku tadi ... punya selera yang luar biasa soal anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490217,
					"content": "Dia bahkan kasih aku sebotol ekstrak buah Romaritime Flower yang sudah tidak diproduksi di Fontaine dan cuma bisa ditemukan di bangsa lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490218,
					"content": "Selain rasa hormat dengan kemampuannya, aku merasa perlu memperluas wawasanku tentang anggur Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490219,
					"content": "Aku akan pikirkan baik-baik dulu sebelum buatkan minum yang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "Aku benar-benar menghargai semua kerja kerasmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490222,
					"content": "Sudah lihat-lihat ke Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "Sudah sih sedikit. Aku jalan-jalan singkat di sekitar waktu hari pertama tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490224,
					"content": "Navia sudah meneliti tempat ini kok. Banyak pemandangan dan ilustrasi di Sandiwara Meja yang terinspirasi dari pemandangan Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490225,
					"content": "Tapi, cara dia mendeskripsikan atmosfer cipta dunianya sedikit berbeda dengan Mondstadt yang asli. Kesan paling dalam setelah aku tiba di sini ya aura pedang dan perisainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490226,
					"content": "Pedang dan perisai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "Mungkin karena aku kebanyakan kunjungi tukang tempa dan tempat latihan saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490229,
					"content": "Akhir-akhir ini, senjata dan zirah yang diproduksi di Mondstadt sudah diciptakan dari proses pemanasan yang berbeda total dari yang ada di Fontaine, dengan kandungan karbon yang lebih tinggi pada lapisan permukaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490230,
					"content": "Ini memang mengurangi tingkat kekerasannya secara keseluruhan, tapi ketahanan terhadap benturannya jadi meningkat pesat. Senjata baru ini mengeluarkan bau kayak kopi yang sudah terlalu lama diseduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490231,
					"content": "Aku ... tidak pernah sadar sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "Mungkin karena baunya memberikan aura positif pada kesan pertama. Lihat ya, penempaan logam khas Fontaine sering dilapisi dengan bahan pelindung yang mengandung Marcotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490234,
					"content": "Seiring berjalannya waktu, bau samar-samar itu jadi terlalu manis ... Dan entah kenapa, gigiku jadi ngilu. Aku tidak bisa bayangkan bau pedang dan perisai Mondstadt akan membuatku merasa seperti itu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490235,
					"content": "Wow, aku belajar hal baru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "Tentu saja, semua ada solusinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490238,
					"content": "Waktu kamu ke Fontaine, ada zat pelindung yang bisa aku rekomendasikan, senetral air, tanpa bau berlebihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490239,
					"content": "Kalau kamu tidak suka dibombardir dengan kemanisan berlebihan juga, zat pelindung ini harusnya cocok untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490240,
					"content": "Kamu biasanya minum apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "Hmm ... waktu lagi kerja, aku biasa minum kopi, tapi kalau sambil makan, aku lebih suka yang ringan, kayak jus Bulle Fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490242,
					"content": "Aku kan makan banyak daging, jadi keasaman jus yang ringan bisa menyeimbangkan rasa berminyaknya. Seiring waktu, aku jadi terbiasa dengan rasa asam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490243,
					"content": "Setelah adu pedang kemarin, knight dari Knights of Favonius mentraktir aku makan kuliner tradisional Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490244,
					"content": "Aku makan delapan menu daging yang berbeda, semua rasanya enak! Porsinya besar, dan semuanya pakai potongan kualitas tertinggi. Semuanya dimasak dengan kesempurnaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490245,
					"content": "Tentu saja masih ada yang bisa ditingkatkan lagi. Waktu disuguhkan ke turis, Sticky Honey Roast dan Pile 'Em Up mungkin bisa lebih enak kalau sausnya lebih ringan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490246,
					"content": "Kamu ditraktir makan enak dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "Aku sudah mencicipi semua hidangan dagingnya. Kurasa aku sudah mengonsumsi kalori yang cukup untuk tiga hari bekerja keras, jadi aku harus menolak semua undangan makan selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490249,
					"content": "Jujur, masih terasa berminyak. Bersihkan pakai apa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490250,
					"content": "Itu hadiah dari para knight?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "Memang sih, ada knight dengan nama samaran Hazelnut 3 dan Hazelnut 5 berikan lencana ini kepadaku. Pengerjaannya halus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490252,
					"content": "Mereka bilang kalau desainnya baru saja difinalisasi, dan cuma ditunjukkan kepada tamu penting saja. Mereka juga bilang ada buatkan satu untukmu juga, tapi masih belum selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490253,
					"content": "Hazelnut ...? Belum pernah dengar deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "Iya sih. Ini sama saja kayak aku tidak mungkin ingat nama setiap juru tulis di Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490256,
					"content": "Tapi aku yakin kamu pasti bisa kenal mereka seiring berjalannya waktu. Mereka jelas veteran senior, dan meski mereka kerja di balik meja, mereka tetap pakai zirah lengkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490257,
					"content": "Setelah mengurusi masalahku, mereka pergi ke Tavern untuk kumpul-kumpul, katanya sih mau melanjutkan \"duel\" tadi malam untuk melihat siapa yang paling jago minum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490258,
					"content": "Minum bergentong-gentong anggur malam sebelumnya dan bisa kerja dengan pikiran jernih besoknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490259,
					"content": "Yah, begitulah Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "Jadi maksudmu, orang Mondstadt memang terlihat bebas, tapi sebenarnya mereka tahu betul sampai mana batas mereka kalau soal minum-minum ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490262,
					"content": "Oh ya, Nona Emilie juga datang tadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "Eh? Berarti komisinya sudah selesai? Cepat juga kerjanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490264,
					"content": "Begitu aku balik ke Fontaine, aku akan kasih tahu Sigewinne kalau aku akan segera beli parfum terbarunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490265,
					"content": "Oh? Kamu kenal baik sama dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "Enggak juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490267,
					"content": "Waktu berangkat ke Mondstadt, kami ada di kapal yang sama. Jadinya ya mengobrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490268,
					"content": "Soalnya aku sering dengar Sigewinne puji karyanya. Jadi setelah perjalanan dengannya kali ini, harus kuakui ... Dia itu memang orang yang langka dan beradab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490269,
					"content": "Beradab?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "Dia itu lembut dan tenang, tapi tetap masih jaga jarak dengan orang lain. Mungkin karena pekerjaannya ya. Aku merasa cara ini cocok, jadi orang bisa menjaga ketenangan dalam hati untuk waktu yang lama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490272,
					"content": "Kayaknya ... kamu mau aku aturkan reuni kecil-kecilan dengannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "Terima kasih, Sebenarnya tidak perlu repot-repot kok. Pekerjaan kami jarang berhubungan, dan lingkaran sosial kita juga tidak ada yang ketemu kayak diagram Venn, begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490275,
					"content": "Biarkan semuanya mengalir saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490276,
					"content": "Emilie suka minum teh, kalau kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "Jangan-jangan kamu sudah pikirkan teori-teori untuk menyambut kami nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490278,
					"content": "Berdasarkan pengalamanku dengan alkohol sebelumnya, aku rasa toleransiku mirip dengan Emilie. Paling-paling minuman buah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490279,
					"content": "Kalau tiba waktunya, aku rasa kamu racikkan saja minuman yang sama untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490280,
					"content": "Aku rasa aku punya ide mau racikkan minuman apa yang cocok untukmu. Tunggu sebentar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "Oke, aku akan pastikan aku sudah siap mental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490282,
					"content": "Meskipun masih agak kuat, aku akan berusaha menghabiskannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490273,
					"content": "Jadi lain kali aku ke Fontaine, kita nongkrong bareng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "Cara deskripsi yang \"beradab\" sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "Orang Mondstadt itu memang sudah terbiasa minum setelah kerja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "Organisasi Knights of Favonius besarnya enggak main-main sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "Jadi sudah makan semua menu daging khas Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "Aku tidak pernah sadar proses pembuatan pedang serumit itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "Perbandingannya unik juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "Kenapa tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "Aku perlu geser sedikit resepnya, kamu dijamin puas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "Selama dalam batasmu, tidak masalah kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "Jangan dipaksakan kalau begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "Mau sedikit air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
		{
			"id": 7054903,
			"completionStepIds": [
				7054910
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7054910",
