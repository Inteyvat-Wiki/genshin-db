						],
						"stepId": 7054910,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clorinde"
				],
				"points": [
					{
						"sceneId": 51204,
						"position": [
							2192.178,
							230.089,
