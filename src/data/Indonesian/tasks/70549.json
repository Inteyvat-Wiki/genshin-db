					{
						"sceneId": 51204,
						"position": [
							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "Oke, kreasi baru ini bernama ... \"Leisuretime Lightning\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "Koktail yang dibuat khusus untuk Petarung Juara — selamat menikmati!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "Fiuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490304,
					"content": "Hmm? Kamu tambahkan minuman beraroma buah? Rasanya luar biasa ... Ini cocok sekali untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490305,
					"content": "Rasa asin samar-samar terpadu sempurna dengan rasa asam dari buah dan rasa manis karamel. Setiap tegukannya terasa seimbang di ambang kesempurnaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490306,
					"content": "Warna anggurnya juga sesuai sekali dengan namanya, dan citra petirnya juga bertolak belakang dengan sifat berapi-api dari Caramel Blaze ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490307,
					"content": "Terus \"waktu santainya\" dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490308,
					"content": "Kamu merasa Mondstadt itu tempat yang santai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "Begitu ya ... Ini pas sekali dengan kesan yang diberikan minuman ini sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490311,
					"content": "Aroma dan rasa uniknya akan selalu ada di ingatanku tentang Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490312,
					"content": "Syukurlah kalau kamu suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "Kalau ada kesempatan, menurutmu kamu mungkin tidak jadi bartender di tempat lain? Kayak di kafe atau mungkin Hotel Debord?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490315,
					"content": "Eh? Kok tiba-tiba tanya begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "Kebanyakan demi Navia dan Nona Furina sih, jelas. tapi sebenarnya aku juga mau coba-coba mahakaryamu yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490317,
					"content": "Tentu saja, aku mau semua orang coba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "Oke. Aku tidak akan paksa kamu. Terima kasih untuk keramahanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490320,
					"content": "Terima kasih, entah aku sedang menghadapi Kapten Pasukan Gerilya atau sedang diskusi strategi sama Knights of Favonius, aku pasti dalam kondisi terbaikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490321
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490321,
					"content": "Saat ini, aku berada dalam kondisi primaku, baik itu merangkum poin-poin penting dari duelku dengan Nona Eula atau bertukar taktik pertempuran sistematis dengan para knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490318,
					"content": "Kalau sekarang sih belum pasti ya, tapi suatu hari nanti, siapa tahu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490313,
					"content": "Kepuasanmu adalah daya juangku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490309,
					"content": "Soalnya wisata itu kan harus bersantai-santai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				}
			]
		}
	]
}