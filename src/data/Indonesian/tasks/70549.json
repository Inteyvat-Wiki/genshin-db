				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "Kecurigaanku terkonfirmasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490102,
					"content": "Waktu aku lagi patroli, aku yakin merasakan aura yang familier, makanya aku mampir. Ternyata ada kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490103,
					"content": "Halo Clorinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "Kalau Nona Charlotte melihatmu seperti ini, sepertinya dia akan tak habis-habisnya memfotomu dan menulis laporan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490106,
					"content": "#\"Bisnis Sampingan Rahasia Pendekar Pedang {NICKNAME}: Koktail Eksklusif dari Petualang Luar Biasa Teyvat\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490107,
					"content": "Kamu akan jadi berita utama di setiap surat kabar besar, dan akan ada kerumunan turis dari Fontaine yang berbondong-bondong datang ke stan minumanmu, sehingga jalanan Mondstadt menjadi macet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490108,
					"content": "Tidak usah terlalu berlebihan begitu deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "Untung saja aku tadi tolak permintaan Nona Charlotte untuk temani aku ke sini, kejadian tadi seharusnya tidak terjadi. Ayo kita rayakan ketenangan ini bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490111,
					"content": "Oh ya, aku mau Caramel Blaze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490112,
					"content": "Kok ekspresinya gitu? Kayak ada banyak pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490113,
					"content": "Aku racikkan minumanmu dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "Tenang dan seperti mudah ... Aku kaget tahu bahwa kamu juga sangat ahli dalam hal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490114,
					"content": "Kita boleh ngobrol sambil minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "Kalau sampai benar begitu, aku izin sungkem dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "Silakan duduk, pelanggan kehormatanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
