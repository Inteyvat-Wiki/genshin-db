			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Enggak sangka bisa ketemu kalian di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Aku belum pernah ke tempat yang cuacanya kayak gini sebelumnya. Dingiiin! Tapi wow, pengalamannya seru banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Ini pertama kalinya aku main lempar-lemparan bola salju, bikin boneka salju .... Oh, dan komiknya juga ternyata seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "Komik Kisah Pertarungan Soulblazer ini populer banget di Inazuma, tapi aku tidak sangka ternyata pembacanya sebanyak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Tadi aku ngobrol seru sama beberapa penggemar dari Natlan. Aku jadi dapat inspirasi, lalu ... aku jadi bikin stand karakter deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "... Maaf, biar aku jelaskan dari awal. Kamu pernah dengar soal Kisah Pertarungan Soulblazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Kamu berdiskusi tentang Soulblazer dengan Yoimiya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Yang benar?! Teman-temanmu juga suka komik ini? Pas banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Kalau begitu, aku kasih kamu stand karakter Fietena ini. Heh, dia pasti bakal cocok dipasang di Legiun Pemuja Soulblazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
