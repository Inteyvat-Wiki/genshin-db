					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Bukankah kita sudah pernah bertemu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "Temanku, ini adalah tanda yang diberikan takdir pada orang-orang luar biasa. Pertemuan pertama kita terasa seperti perjumpaan kembali setelah sekian lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Melihat penutup mata serigalaku ini, kamu pasti sadar seberapa luar biasanya aku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
