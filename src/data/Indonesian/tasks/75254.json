			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Oh? Kamu bertanya tentang mataku? Hehe, yah, ada tiga hal yang harus dilatih dengan baik oleh setiap laki-laki dalam hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Pertama: Tubuh yang sudah lapuk harus menanggung setidaknya satu bekas luka. Kalau tidak, bagaimana caranya tahu terdapat cobaan dan kesengsaraan apa yang sudah dihadapinya, dan kalau begitu, hidupnya pun akan menjadi kurang bermakna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Kedua: Bekas luka harus ditutupi dengan pakaian atau aksesori, tapi hanya sebagian. Kalau tidak, bagaimana caranya tahu bahwa laki-laki ini istimewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Dan yang ketiga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Tunggu, aku tidak menanyakan soal matamu sama sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Benar! Yang ketiga adalah ... kalau orang lain tidak memperhatikan, seorang laki-laki harus mencari cara dan mengambil inisiatif untuk membicarakannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
