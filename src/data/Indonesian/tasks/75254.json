					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "Kamu belum bertanya mataku kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
