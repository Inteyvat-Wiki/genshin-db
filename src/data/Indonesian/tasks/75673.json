			"dialogs": [
				{
					"id": 756730101,
					"content": "Sepertinya Asha pewarna sudah puas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Kita berhasil membantu Asha yang luar biasa itu menyelesaikan tantangan spesial lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Hore! Sukses ngumpulin semua catnya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Asha ini langsung dapat inspirasi ya, sudah enggak sabar mau melukis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Ilham itu kan bisa datang dan pergi kapan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ah, dia juga tinggalkan banyak harta yang sudah dikumpulkan dia sendiri ... semuanya harus dijadikan imbalan buat {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Siapa tahu, kalau kita datang lagi nanti, kita bisa lihat karya terbaru Asha Pewarna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Asha biasa saja sudah bisa semprotin warna yang keren banget, gimana kalau Asha spesial kayak gini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Wah, Paimon mulai enggak sabar nih. Siapa tahu mereka bisa bikin warna yang ... susah digambarin pake kata-kata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Mungkin warna Phlogiston, bulan, atau warna dari kedalaman langit berbintang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Yup! Dalam petualangan, setiap kali bertemu sama makhluk yang lagi hadapi kesulitan, kita harus bantu mereka sebisa mungkin dengan tulus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Yup! Mungkin saja kita bisa dapat imbalan yang enggak terduga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Aku juga setuju sama Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ah, tapi ... kalau cuma harapin balas budi aja, kurang tepat sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Meski tanpa imbalan apa pun, waktu melihat masalahnya selesai, dan teman-teman yang tadinya bingung jadi senang, terus kondisinya berubah ke arah yang lebih baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "Aku suka perasaan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "Rasanya memuaskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Jadi mumpung ilhamnya datang, langsung sikat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
