				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Halo, ada apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "I-itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Tentang perabot pernis ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Kamu mau kasih perabot pernis buat dewa? Terus kamu ingin bikin sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Kumohon, Kak Nanatsuki! Aku ada permohonan yang harus bisa terkabulkan! Aku ... Aku janji enggak akan bilang sama siapa-siapa soal formulanya kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Masalahnya bukan itu. Kalau ingin bikin perabot pernis kualitas tinggi, selain cat yang bagus, kamu juga perlu latihan lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Bukan cuma butuh waktu, tapi juga butuh ... uang. Aku sendiri sudah generasi keempat pembuat perabot pernis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Aku bahkan pernah ke Sumeru untuk belajar soal pernis. Jadi, tidak mungkin kamu bisa jadi mahir bikin perabot pernis dalam semalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "O-Oh ya? Tapi aku sudah enggak tahu mau kasih apa lagi yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Kurasa, yang terpenting ketika memberi bukanlah nilai barangnya, tapi niatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Asal kamu tulus dan sungguh-sungguh memberikan barang kesukaanmu, dewa pasti akan menjawab permintaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Tulus dan sungguh-sungguh ... Berikan barang yang aku suka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Hmm, aku paham nih, tapi mungkin ... tidak juga. Terima kasih ya, Kak Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "Kak, ayo kita ke kuil lagi. Aku masih perlu pendapat kakak, soal harus kasih apa buat dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
