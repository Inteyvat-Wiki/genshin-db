						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Benarkah? Oke! Kebetulan aku bawa Tricolor Dango buatan mama yang belum sempat dimakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
