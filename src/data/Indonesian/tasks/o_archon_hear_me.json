			"dialogs": [
				{
					"id": 220270301,
					"content": "Uh, Kak Nanatsuki bilangnya begitu, tapi aku tetap enggak tahu harus kasih apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Kalau soal apa yang paling kusuka, aku doyan banget makan Tricolor Dango ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Tapi apa boleh kasih Tricolor Dango? Aku pernah kasih permen konpeito terus enggak dijawab apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Aku juga pernah dengar ada orang yang bikin kantong wangi yang isinya kelopak bunga. Mungkin yang kayak gitu lebih bagus ya, daripada Dango ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "Kak, menurutmu aku kasih apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
