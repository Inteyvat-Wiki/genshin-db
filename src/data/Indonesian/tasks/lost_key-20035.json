			"dialogs": [
				{
					"id": 200350101,
					"content": "Ah, Pengembara, kamu datang di saat yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350102,
					"content": "Kemarin malam, aku sedang dalam perjalanan ke Mondstadt untuk mengirim barang-barang ini. Tiba-tiba beberapa bola yang bersinar menarik perhatianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350103,
					"content": "Aku minum terlalu banyak, lalu... aku pun terpikat untuk melihatnya. Waktu kudekati, ternyata mereka sekelompok Slime. Mereka kemudian menyerangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350104,
					"content": "Aku takut sekali, aku lari lalu tersesat. Butuh waktu lama sekali sampai aku menemukan gerobakku. Lalu pagi ini aku baru sadar kalau <color=#00E1FFFF>kunci</color> milikku hilang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350105,
					"content": "Dapatkah kamu membantuku mencarinya? Aku rasa kunci itu ada di sekitar sini... Pasti di dekat sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350106,
						200350108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350106,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200350107
					]
				},
				{
					"id": 200350107,
					"content": "Bagus sekali! Area ini sungguh luas. Aku tidak tahu harus memulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350108,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200350109
					]
				},
				{
					"id": 200350109,
					"content": "Area ini sangat luas sekali. Aku tidak tahu harus mulai mencari dari mana. Tolonglah, aku hanya bisa mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
