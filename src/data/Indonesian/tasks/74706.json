			"dialogs": [
				{
					"id": 747060101,
					"content": "... Lalu yang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747060102,
					"content": "Aku masih merasa ada yang kurang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina? Furina? Kalian lagi ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Sutradara Furina dan aku yang ... pilih peran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747060105,
					"content": "Bisa dibilang begitu juga! Tapi, \"aktor\" yang kita cari ... kebetulan ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "Ikan bisa akting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Zaman sekarang aktor hewan itu sudah banyak kok. Kita lagi cari ikan yang karakternya cocok buat ambil video sekunder ... penting buat menonjolkan suasana filmnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Tapi sepertinya kami sudah lihat semua ikan di sini, tidak ada yang cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Mau coba minta bantuan {NICKNAME} dan Paimon? Mereka jago menyelesaikan masalah rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747060110,
					"content": "Paimon senang kalian bisa percaya sama kami ... tapi kalau mau pilih ikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Mungkin kita bisa cari ikan lebih banyak lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Ide bagus! Kan memang kalian yang punya pengalaman mengelola akuarium ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Jadi maksudnya, kita harus lihat-lihat ikan yang berpotensi jago akting setiap kali kita menyelam sekarang? Kayaknya gampang sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Oke deh! Kalau begitu, nanti kukasih tahu ya kita cari ikan yang kayak gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "Berarti, kalian itu termasuk \"pencari bakat\" dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 747060117,
					"content": "Sejak bergaul sama Furina, kamu benar-benar belajar banyak kata baru ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Mungkin kita bisa coba lihat ... di bawah air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
