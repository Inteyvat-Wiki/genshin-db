			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "Halo, Manis. Senang sekali bisa ketemu kamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060102,
					"content": "Rasanya aneh juga bisa bertemu kalian di tempat seperti ini. Tapi seperti kata Lisa, senang berjumpa dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060103,
					"content": "Hei, apa maksudnya \"tempat seperti ini\"? Kedai kan tempat yang cocok sekali buat santai dan istirahat sejenak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060104,
					"content": "*huff* Kalian tahu tidak betapa susahnya membujuk Master Jean untuk meninggalkan kursinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060105,
					"content": "Kami baru juga duduk di sini beberapa menit, dan mukanya sudah risau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060106,
					"content": "Huh, Lisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060107,
					"content": "Yah, Knights of Favonius kan memangnya banyak urusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "Iya! Ini kita lagi ngomongin Master Jean loh! Wajar dong kalau tugasnya bejibun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060109,
					"content": "Tapi kan kata orang juga \"mumpung sudah di sini\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060110,
					"content": "Minta dia bikin minuman saja buat kalian berdua! Pasti enak loh. Mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060111,
					"content": "Anggap saja salah satu cara bersantai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "Kalau mau ngomong jujur, cuma Jean satu-satunya orang yang kukenal, yang perlu diajari caranya \"bersantai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060113,
					"content": "Manis, bikinin aku Love Poem porsi sedang yah. Sedikit manis ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060114,
					"content": "Dan kamu Jean ... Mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060115,
					"content": "Aku ... kopi saja. Porsi sedang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060116,
					"content": "Master Jean minum kopi setiap hari, kan? Yakin enggak mau coba yang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060117,
					"content": "Terima kasih, tapi aku butuh sesuatu untuk membuatku tetap terjaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060118,
					"content": "Oke, tunggu sebentar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 7050602,
