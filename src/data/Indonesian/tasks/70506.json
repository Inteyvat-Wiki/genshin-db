			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "Mmm ... manisnya pas. Nikmat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060202,
					"content": "Kopinya pekat dan kental, pahitnya juga pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060203,
					"content": "Yang penting kalian berdua puas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "Sebenarnya aku paham maksud Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060205,
					"content": "Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060206,
					"content": "Aku memang instrospeksi diri baru-baru ini. Masih banyak ruang untuk belajar mengatasi kelemahanku dan meningkatkan kinerja serta kemampuan manajemenku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060207,
					"content": "Aku khawatir tekanan yang kurasakan bahkan mulai bisa kamu rasakan pengaruhnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060208,
					"content": "Kurasa kamu masih belum paham deh maksudnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "Lah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060210,
					"content": "Hehe, tuh kan? Manis ngerti, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060211,
					"content": "Kamu kerja terlalu keras, makanya aku ajak kamu keluar minum. Aku cuma ingin kamu senang-senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060212,
					"content": "Tapi bahkan sudah di dalam kedai pun kamu masih saja mikirin soal kerjaan. Itu kan yang bikin orang jadi prihatin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060213,
					"content": "Kalau kamu stres terus, lama-lama kamu bisa tumbang loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060214,
					"content": "Yup, betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#Oh ... {NICKNAME} juga setuju sama Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060216,
					"content": "Hmm, jadi intinya ... tantangan terbesarku itu belajar bagaimana caranya bersantai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060217,
					"content": "Biar aku kutip ungkapan Liyue deh: \"Semuanya harus seimbang\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "Betul betul betul! Kerja sekeras-kerasnya, main sekuat-kuatnya, tidur sepuas-puasnya, harus lengkap semua! Kalian berdua mungkin perlu lebih banyak istirahat dari yang kalian pikir loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060219,
					"content": "Omonganmu barusan ... agak aneh, tapi ada hikmahnya juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "Hihihi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060221,
					"content": "Baiklah, a-aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060222,
					"content": "Terima kasih ya, semuanya. Sekarang aku jadi tahu kalau tempat ini bagus untuk mengistirahatkan baik tubuh maupun pikiran. Jadi ini ya kenapa kamu dan Kaeya suka sekali ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060223,
					"content": "Iya dan tidak. Tergantung siapa yang jadi bartendernya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060224,
					"content": "Dan tentunya, hari ini Jean tidak akan berubah pikiran kalau bukan karena kamu, Manis. Kamu memang pintar ngomong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060225,
					"content": "Ah, tidak kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "Hehe, kalau gitu sampai ketemu lagi ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060228,
					"content": "Akan kupertimbangkan untuk datang kemari dan bersantai sejenak kalau ada kesempatan di lain waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060229,
					"content": "Bagus! Hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060226,
					"content": "Senang bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}