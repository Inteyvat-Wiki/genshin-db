			"dialogs": [
				{
					"id": 413370601,
					"content": "Kalian di sini... untuk menerbangkan lentera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "Tidak ada orang lain selain dari anggota Klan Guhua yang tahu tempat ini, sedangkan wajahmu sepertinya cukup asing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "Aku di sini mewakili seseorang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "Masih ada orang lain dari Klan Guhua yang mengingat tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Aku tidak melihat siapa-siapa saat aku tiba, dan harus kuakui itu membuatku cukup sedih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Aku merasa senang masih ada orang dari Klan Guhua yang mengingat tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "Apakah dulu Klan Guhua menerbangkan lentera di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Ya. Pada saat itu, guru membawa kami ke sini setelah lentera selesai dibuat. Guru berjalan di depan kami, dan kami pun mengikutinya sambil membawa lentera di tangan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Pada saat itu... Lentera Xiao disambung menjadi satu bagian dan terlihat begitu indah dari puncak maupun kaki gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "Tapi sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "...Ayo nyalakan apinya dulu. Kita bisa berbicara tentang masa lalu sambil berjalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
							"2"
						],
						"stepId": 4133713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "Aku masih ingat dulu pada saat kami menerbangkan lentera, ada seorang senior yang begitu bersemangat ingin bertanding denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370702,
					"content": "Aku belum menjawab ketika seorang wanita junior yang kupercaya diam-diam menuangkan air ke tanah tempatnya berdiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370703,
					"content": "Tanahnya basah dan licin. Kakak bahkan belum mengeluarkan pedangnya dan baru saja melangkah, tapi dia sudah jatuh terjerembab. Aku yang tidak bisa menahan tawa jadi terjatuh juga karena tidak hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370704,
					"content": "Saat itu kakak tidak marah dan malah tertawa sambil menunjukku. Yang kemudian diikuti gelak tawa semua orang di sekitar sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370705,
					"content": "Aku tidak tahu kakak sekarang berada di mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133708,
			"completionStepIds": [
				4133714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133714",
							"2"
						],
						"stepId": 4133714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "Aku juga pernah melihat adanya secercah harapan. Seorang anak muda yang baru saja bergabung dengan Klan Guhua. Parasnya tampan, penuh sopan santuh, dan benar-benar berbakat. Sepertinya dialah yang akan membangkitkan kembali tradisi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "Tapi sulit sekali untuk melacak jejaknya, dan tidak ada yang pernah melihatnya dalam waktu yang lama... *huff* sepertinya aku tidak bisa menaruh harapan padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "Jadi, lebih baik aku pergi dan tidak mengharapkan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133715",
							"2"
						],
						"stepId": 4133715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "Ketika aku meninggalkan klan Guhua, hanya sedikit murid yang tersisa di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "Guruku tidak menyalahkanku, dia hanya berkata agar aku menjalankan hidupku dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370903,
					"content": "Tapi, aku tidak merasa aku menjalani hidup yang baik sekarang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370904,
					"content": "atau aku hanya bisa menjalaninya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370905,
					"content": "Aku mendengar orang mengatakan bahwa ada seseorang dari Klan Guhua bernama Sun Yu ingin menghidupkan kembali Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370906,
					"content": "Kalau aku memiliki keberanian sepertinya... alangkah baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370907,
					"content": "Maaf, aku terlalu banyak bicara. Tidak mudah bisa menghirup udara segar seperti ini, membuatku ingin bercerita tentang banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370908,
					"content": "Kamu terlihat sedih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "A-aku tidak apa-apa. Hanya saja setiap festival tahunan, aku merasa sedikit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370910,
					"content": "Ah sudahlah, sudah hampir waktunya. Selamat Hari Lantern Rite! Dan tolong berikan pesanku kepada orang yang memintamu menerbangkan lentera, katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370911,
					"content": "Katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370912,
					"content": "Katakan... Zhiruo mengucapkan Selamat Hari Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Selamat Hari Lantern Rite juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "Ya, terima kasih. Hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133710,
