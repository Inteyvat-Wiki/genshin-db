			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "Jika aku menerbangkan lentera di sekitar sini, Adeptus pasti melihatnya kan? Tapi dengan bahan-bahan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "Ah, maaf, juniorku dan aku sedang memikirkan masalah mengenai penerbangan Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "Masalahnya sekarang ini kita tidak punya cukup bahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "Kalau temanku di sini bersedia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "Lagi-lagi Klan Guhua, Klan Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370207,
					"content": "Tidak mudah mengadakan Lantern Rite, begitu juga dengan harapan akan Klan Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370208,
					"content": "Que'er, kita adalah Klan Guhua, sudah menjadi tanggung jawab kita untuk menghidupkan kembali Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Apa yang dikatakan kakak benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370210,
					"content": "Kalau kamu bersedia, maukah kamu membantuku mencari bahan-bahan Lentera Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "*uhuk* Coba kuhitung sebentar. Sekarang sepertinya masih kurang setangkai bunga Qingxin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "Yang sebelumnya, karena kita membutuhkan waktu yang terlalu lama untuk memetiknya, sehingga sekarang sudah menjadi kering dan tidak berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "Qingxin juga bisa digunakan untuk Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Hehe, ini adalah metode unik yang kutemukan saat aku bermain dengan adik-adikku di Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Menerbangkan Lentera Xiao yang membawa aroma harum dari bunga — ternyata menyenangkan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Aku akan menunggumu di sini. Kemarilah kalau kamu sudah menemukan bahannya, maaf merepotkanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Sepertinya ada yang ingin Que'er katakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Tidak, tidak ada, aku ikut saja apa kata kakak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370215,
					"content": "Hei, Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
