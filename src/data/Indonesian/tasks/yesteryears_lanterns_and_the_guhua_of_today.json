			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Terima kasih! Sekarang kita pasti bisa membuat Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "Sudah selesai, Que'er. Ayo tuliskan harapan kita di lentera ini, tolong kamu tuliskan ya, karena tulisan tanganmu bagus sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Baiklah, baiklah, akan kutuliskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370404,
					"content": "Que'er... apakah... kamu tidak senang? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "Ah tidak kok, aku tidak marah sama sekali. Aku malah senang bisa membantu menerbangkan lentera ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370406,
					"content": "*uhuk* Kalian mau pergi ke mana dengan lentera itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Ah benar, kita sudah harus siap-siap untuk menerbangkan lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Oke, kamu bisa pergi jika kamu mau. Tapi aku tidak akan bergabung denganmu. Mendaki terlalu melelahkan untukku, aku tidak punya tenaga untuk melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370410,
					"content": "Ini... bukannya kita baru saja istirahat di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Kepalaku agak sakit, entah karena mungkin terkena angin dari gunung atau bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370412,
					"content": "Ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "A-aku... akan membantu kalian menerbangkan lentera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Ini... hmm, maaf merepotkanmu. Awalnya aku sudah bersiap-siap pergi ke sebuah tempat khusus untuk menerbangkan Lentera Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Dulu waktu di Klan Glua... Guru selalu membawa kami ke sana untuk menerbangkan lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "Sayang sekali gerbang utama biara sudah rusak. Tempat itu juga sudah lama tidak digunakan Klan Guhua sebagai tempat untuk menerbangkan lentera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "Kalau kamu bersedia membantu, tolong bantu aku pergi ke sana dan terbangkan Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "Aku akan menandai lokasinya di peta, dan menjaga Que'er di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "Sini aku bantu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "*uhuk-uhuk* Sudah waktunya kalian menerbangkan lentera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
