			},
			"dialogs": [
				{
					"id": 413371001,
					"content": "Ah, kamu sudah kembali. Kamu sudah menerbangkan Lentera Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371002
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371002,
					"content": "Tentang apa yang terjadi saat menerbangkan lentera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "Jadi begitu. Zhiruo ya... aku ingat dia. Dia telah merawatku sejak lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371004,
					"content": "Ternyata dia masih ingat akan Klan Guhua. Aku sangat senang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371005,
					"content": "Tentang Little Que'er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "Ah, iya, sakit kepala Little Que'er sudah semakin membaik. Mungkin dia baru mau flu, aku akan menyiapkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371007,
					"content": "Kakak, tentang Zhiruo yang barusan kamu bicarakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371008,
					"content": "Apakah dia salah satu bagian dari Klan Guhua? Apakah dia cantik? Apakah kamu mengenalnya dengan baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371009,
					"content": "Oh, aku tidak begitu mengenalnya sih... tapi Zhiruo cukup ahli dalam menyembuhkan luka. Jadi tiap ada yang terluka akan selalu langsung menghampirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Hahaha, setelah kupikir-pikir, sepertinya ada banyak yang menyukainya di Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "Terus, bagaimana denganmu, Kakak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371012,
					"content": "Oh, uh... aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "Kakak, hubunganmu dengan Kakak Senior Zhiruo ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371014,
					"content": "Um... kami tidak begitu akrab. Ya, hanya sekadar satu klan saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "Kalau begitu, bagaimana hubungan antara kamu dan aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371016,
					"content": "Hahaha, ini pasti sebuah ikatan persekutuan yang ditakdirkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371017,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371018,
					"content": "Que'er? Ka-kamu kenapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
