				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "Sepertinya aku terlalu banyak mempertanyakan diri sendiri. Aku akan bangkit, dan jadi ketua yang lebih bisa diandalkan. Demi kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180902,
					"content": "Kalau diingat lagi, aku jadi malu sendiri ... hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180903,
					"content": "Tentang hadiah dari warga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "Pasti ada hal yang cuma biasa saja bagi sebagian orang, tapi amat sangat luar biasa bagi sebagian orang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180905,
					"content": "Bagiku, hal itu foto keluarga. Aku selalu iri lihat orang lain punya foto keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180906,
					"content": "Aku tidak mengira akan pernah punya foto keluarga, dan tentunya tidak dengan cara seperti ini. Ternyata nasibku lumayan ya, enggak sial-sial amat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180907,
					"content": "Tentang Clementine ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "Mama ... \"hanya\" ingin aku hidup bahagia itu ternyata susah juga ya. Sama susahnya dengan memenuhi ekspektasi Papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180909,
					"content": "Orang tuaku sifatnya beda jauh, tapi mereka saling menghormati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180910,
					"content": "Proyek Aquabus itu mendatangkan manfaat buat semua warga Fontaine. Salah dan sempit sekali kalau cuma menghitungnya dari sudut pandang satu kelompok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180911,
					"content": "Mungkin itulah kenapa dia tidak menengahi atau pun melawan proyek itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180912,
					"content": "Tentang pertanyaan \"Kamu ... benar-benar menganggapku partner?\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "Eh, eh, EH! Jangan ditanyain balik ah! Jangan diungkit malah! Malu, sumpah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180914,
					"content": "Lupain saja, lupain pokoknya! Ah, eh, tapi jangan dilupain juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180915,
					"content": "Baiklah, ini rahasia kita berdua ya! Jangan pernah diungkit lagi, plis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
	]
}