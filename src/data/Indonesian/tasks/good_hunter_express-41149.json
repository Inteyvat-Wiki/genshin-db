			"dialogs": [
				{
					"id": 411490301,
					"content": "Kudengar ada pesanan khusus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "Benar sekali, kebetulan sekali kamu datang, Pengembara! Tadi Wallit memesan Tea Break Pancake dari sini. Jangan khawatir, dia sudah membayar lunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490303,
					"content": "Lalu dia juga ingin kita mengantarkannya ke suatu tempat di bagian selatan Brightcrown Canyon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490304,
					"content": "Tapi entah kenapa, belakangan ini ada banyak sekali pesanan pesan-antar. Sampai-sampai kami hampir kekurangan tenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490305,
					"content": "Kalau kamu bersedia, tolong bantu aku mengantarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
