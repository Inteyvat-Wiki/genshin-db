			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Umm, proyeksinya ternyata pas banget di tengah-tengah panggung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "Mereka berdua lagi apa sih? Yang satu kayak lagi ngomong, yang satunya kayak lagi duduk di tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "Paimon tahu, ini pasti adegan dongeng sebelum tidur! Jadi dia di dalam proyeksi ini pasti lagi cerita buat orang yang duduk di tanah itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "Apa Fatui juga suka dongeng sebelum tidur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "Siapa tahu kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Tuan Persikov meminta kita untuk melakukan tes penerimaan sinyal. Sepertinya kita berempat harus pergi ... Chevka pasti marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Ayolah, Yakov, perintah tetaplah perintah, Chevka tidak akan menyalahkanmu karena hal itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "Hmmm, kalau kamu takut begitu, aku akan pergi denganmu dan bicara dengan Chevka, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Huh, ternyata bukan lagi cerita ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "Paimon selalu ngerasa obrolan ini kurang lengkap, beneran enggak ngerti apa-apa deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
