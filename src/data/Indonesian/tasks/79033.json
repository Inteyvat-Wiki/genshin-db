				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Keongnya ternyata bisa mengapung dari sumur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Keongnya kan sudah kena pengaruh alam fantasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Hebat juga ya. Ooh, {NICKNAME}, lihat tuh ada yang ngebungkukin badan ... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#Jangan bergerak, {NICKNAME}, di belakangmu ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "Apa?! Ada yang menakutkan?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "Oh, itu cuma proyeksi dari keong! Tapi tiba-tiba muncul di belakang, ngagetin deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Alat penguji sinyal dua set ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "Huh, kukira dia bakal dijatuhi hukuman berat karena dipanggil sendirian, ternyata cuma dikasih tugas yang sedikit lebih merepotkan saja. Untunglah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Hah! Kamu harusnya lihat tadi, dia takut sekali kena omelan kamu. Rasanya sudah nyaris seperti seorang adik yang takut kena murka kakaknya. Hmm ... apa mungkin dia cuma takut kita kecewa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "Kita ini cuma rekan satu tim, tapi ... kadang rasanya sudah seperti keluarga sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Keluarga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Hmm ... Kok rasanya Paimon dengar sesuatu yang tak seharusnya Paimon dengar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "Kalau mau jujur, kok rasanya para Fatui ini ... enggak \"jahat-jahat amat\" ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "Jangan sengaja bikin kaget aku dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Mungkin ada udara di dalam cangkangnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
