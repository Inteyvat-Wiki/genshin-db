				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Eh, dua orang itu kelihatannya lagi rebahan di atas tanah ya ... apa mereka lagi ngelihatin bintang-bintang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "Sejujurnya sih, proyeksi ini kelihatannya agak aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Yakov, apa yang komandan katakan padamu sampai kamu jadi murung begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Gara-gara ombak besar, aku tersandung waktu mengangkut mesin. Untungnya aku sigap, jadi mesinnya tidak kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "Tapi komandan tetap ngomel dan memerintahkan kami untuk melakukan tes penerimaan sinyal. Duh, pekerjaan yang berat sekali, betul kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Oh ayolah, jangan khawatir begitu. Kita kan sudah melakukan hal ini ratusan kali sebelumnya. Semangat! Ayo makan dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "Mereka menunjuk ke arah yang tinggi banget, mereka mau makan apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Apa mungkin keongnya ... bengkok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}