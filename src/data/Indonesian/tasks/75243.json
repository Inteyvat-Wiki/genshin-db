			"dialogs": [
				{
					"id": 752430101,
					"content": "Aduh! Untung saja kamu usir para Fatui itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "Entah datang dari mana mereka semua itu. Bahkan tidak mengancamku dulu, langsung masukkan tangan ke tasku! Mereka itu maling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "Untung kamu sempat menghentikan mereka! Kalau tidak, aku pasti rugi besar hari ini ... Tolong terima imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Oh ya, hampir saja kelupaan. Tempat ini adalah Taman Alpaca Warna-Warni. Di sini kami khusus memamerkan Alpaca yang jinak untuk para tamu. Kami juga jual mainan yang lucu-lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Tapi orang-orang itu membuat semua karyawan dan pelangganku kabur. Aku harus urus dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "Kalau kamu mau lihat Taman Alpaca, besok datang lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
