				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} mengambil salah satu gambar itu dan meletakkannya di bagian punggungnya yang empuk, di bawah sisik perisainya yang keras.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#Ngomong-ngomong, kenapa {REALNAME[ID(2)|SHOWHOST(true)]} tiba-tiba mau foto ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
