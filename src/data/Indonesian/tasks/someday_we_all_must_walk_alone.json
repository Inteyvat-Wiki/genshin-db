				},
				{
					"id": 751770130,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} kenapa? Kok kayak enggak enak badan? Terus ... kayak enggak senang gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
