					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, kamu dapat Kamera dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770103,
					"content": "Kamu ... wah, nyopet ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770104,
					"content": "NGUK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "Fuwaaa ... nguk! Nguk, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "Kok kayaknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "Wah! Ini bukannya Bola Api Daging Berlemak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770110,
					"content": "Waktu di Putra-Putri Gema, ada orang yang ingin jadi sutradara, tapi terus Kamera-nya kebalik ... kamu dapat dari sana ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770111,
					"content": "Nguk! Mm ... Fuwaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "Mau foto sama kami? Hehe, Paimon ngerti kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770113,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "Benar juga, kita sudah bertualang bersama begitu lama, tapi belum pernah foto bareng. Kutukannya juga sudah hilang, sekarang dia bisa tumbuh sehat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770115,
					"content": "#Tepetlisaurus tuh berapa lama sih baru gedenya ... kalau si {REALNAME[ID(2)|SHOWHOST(true)]} tiba-tiba jadi gede besok, kita bakal kangen nih sama wujud bayinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770116,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "Sudah, mending foto dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770119,
					"content": "Paimon sudah setelin ya, pasti bener nih! Dan yang jelas enggak terbalik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770120,
					"content": "Oke, kita serempak bilang \"bakso\" di hitungan ke satu, dua ... tiga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770121,
					"content": "\"BAKSO!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
