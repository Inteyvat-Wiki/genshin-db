			"dialogs": [
				{
					"id": 411270401,
					"content": "Apa isi kotaknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Kamu tidak perlu tahu itu. Hanya beberapa... peralatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "Hei! Jangan melihatku dengan mata curiga begitu! Aku kan bukan orang jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "Tapi kamu kan orang Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Fatui, Fatui... Memangnya semua orang Fatui itu jahat? Dari mana kamu tahu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270406,
					"content": "Baiklah, cepatlah pergi mencarinya. <color=#00E1FFFF>Kembalilah kepadaku kalau kamu gagal menemukannya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270407,
					"content": "Aku sedang berusaha mengingat-ingat, siapa tahu ada yang bisa membantu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
