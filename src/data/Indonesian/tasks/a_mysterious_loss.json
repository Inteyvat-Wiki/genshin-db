					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "Apa yang terjadi saat kamu berlari pulang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "Saat aku berlari pulang? Aku tidak ingat jelasnya sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270503,
					"content": "Oh, aku ingat! Saat aku kembali dari <color=#00E1FFFF>tempat di dekat Thousand Winds Temple</color>, aku bertemu dengan segerombol Electro Slime raksasa. Aku diserang beberapa kali oleh mereka dan kotakku terjatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270504,
					"content": "Aku berhasil mengambil kembali kotak milikku. Tapi karena aku terlalu terburu-buru kabur... kotak itu terjatuh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270505,
					"content": "Oh tapi kotak itu sudah menyentuh Electro Slime, seharusnya ada <color=#00E1FFFF>jejak elemental</color> di sekeliling kotak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270506,
					"content": "Singkatnya, coba kamu cari jejak elemen Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
					],
