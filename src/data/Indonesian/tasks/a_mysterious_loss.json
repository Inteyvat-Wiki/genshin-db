			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Habislah aku. Kali ini benar-benar gawat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270102,
					"content": "Ada apa denganmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Aduh, aku sudah bosan sekali berdiam diri di sini, apalagi dengan tatapan-tatapan para suster itu. Aku hanya ingin keluar sebentar menyegarkan diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270104,
					"content": "Tapi aku baru saja melangkah keluar kota, tadinya ingin berjalan-jalan di sekitar Thousand Winds Temple. Tiba-tiba dari langit berjatuhan batu-batu meteorit itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270105,
					"content": "Tanpa pikir panjang, aku langsung berlari pulang. Saat aku sampai rumah... aku baru sadar kalau aku menjatuhkan sebuah kotak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270106,
					"content": "Di luar sana sedang kacau sekali, aku juga tidak berani keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270107,
					"content": "Apalagi... apalagi aku adalah anggota Fatui. Kalau aku sampai salah langkah, bisa-bisa aku dicurigai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270108,
					"content": "Sudah cukup basa-basinya. Apakah kamu bisa membantuku mencari benda itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270109,
					"content": "Transaksi kita selama ini selalu memuaskan bukan? Kali ini aku juga tidak akan merugikanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270110,
					"content": "Jangan mengatakan hal mencurigakan begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "Kenapa... kenapa mencurigakan? Bukankah aku hanya sedang bercerita kepadamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270112,
					"content": "Sudahlah, kamu hanya perlu mengatakan mau membantuku atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
