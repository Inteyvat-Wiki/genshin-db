			"dialogs": [
				{
					"id": 411270201,
					"content": "Kenapa? Apakah kamu ada urusan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270202,
					"content": "Sulit sekali mencari tanpa petunjuk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Oh iya, baiklah. Coba kuingat-ingat dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270204,
					"content": "Aku benar-benar sudah lupa, tap sepertinya tidak ada hal penting kok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270205,
					"content": "Aku ingin menanyakan sesuatu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Silakan, apa yang ingin kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
