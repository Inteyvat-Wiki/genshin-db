			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "Apa yang kamu lakukan di luar sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Ayolah, kenapa mukamu curiga begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "Aku benar-benar hanya ingin keluar untuk mencari angin! Saat meteorit itu berjatuhan, aku langsung bergegas pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Baiklah, cepatlah pergi mencarinya. <color=#00E1FFFF>Kembalilah kepadaku kalau kamu gagal menemukannya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "Aku sedang berusaha mengingat-ingat, siapa tahu ada yang bisa membantu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
