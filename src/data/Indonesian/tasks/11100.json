			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Hei, {NICKNAME}... Apa Paimon sedang berhalusinasi saja atau memang ada yang aneh dengan para Hilichurl di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Mereka mengeluarkan aura jahat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Benar, Paimon juga berpikir demikian. Kita sudah sering melihat banyak Hilichurl sebelumnya, dan meskipun mereka adalah monster jahat... tapi yang ini terlihat berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Ah, Wangshu Inn kan ada di dekat sini! Tamu-tamu di sana berada dalam bahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Sekarang karena kita sudah melihatnya, kalau kita tidak melakukan sesuatu, Paimon akan merasa sangat bersalah... Ayo kita bereskan, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Mereka terlihat sangat gelisah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Oh, benar juga! Mungkin ada hubungannya dengan... energi hitam yang terpancar dari patung tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
