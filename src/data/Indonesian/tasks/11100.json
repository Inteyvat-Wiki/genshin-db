			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pria Beriman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Pernahkan kamu melihat Lord Starsnatcher beraksi? Kekuatannya benar-benar luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000402,
					"content": "Aku percaya sekarang, akhirnya ada secercah harapan untuk ayahku yang sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000403,
					"content": "Tentang Lord Starsnatcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Melihat dia mengeluarkan kemampuannya adalah bukti yang kamu butuhkan. Benar-benar tidak diragukan lagi dia adalah Adeptus sejati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000405,
					"content": "Belum lama ini, aku meminta obat darinya untuk membantu ayahku yang sedang sakit. Perbedaannya dengan resep Bubu Pharmacy bagaikan siang dan malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000406,
					"content": "Setelah direbus dan siap disajikan, obatnya mengeluarkan kabut yang sangat halus — benar-benar terlihat seperti ilmu Adeptus yang begitu menakjubkan! Hm... Bisa juga karena ada Mist Flower di dalamnya sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000407,
					"content": "Obat Adeptus adalah obat yang paling manjur. Ayahku pasti akan segera sembuh, aku yakin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Pria Beriman"
				},
				{
					"id": 111000408,
					"content": "Tentu saja, ada harga yang harus dibayar ketika meminta bantuan dari Adeptus seperti Lord Starsnatcher. Beberapa barang antik koleksiku akhirnya kurelakan. Tapi tentu saja nyawa ayahku lebih penting daripada itu, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pria Beriman"
				}
			]
		},
		{
			"id": 1110005,
