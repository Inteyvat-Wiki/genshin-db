			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Halo! Kami adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Tolong, tidak perlu berterima kasih kepadaku. Membersihkan kejahatan dari dunia adalah tugas para Adeptus. Jangan terlalu dipikirkan... Tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001003,
					"content": "Tunggu dulu, siapa kalian? Kukira kalian adalah pengikutku, tetapi jika dilihat-lihat, sepertinya kita belum pernah bertemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001004,
					"content": "Kami hanyalah pengembara yang sedang lewat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Aku Paimon! Dan ini adalah temanku, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Oh. Kalau begitu aku juga akan memperkenalkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001010,
					"content": "Ehem... Yang sedang berdiri di depanmu ini adalah Adeptus, Dewa Celestial, atau lebih di kenal dengan \"Starsnatcher.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001011,
					"content": "Seseorang yang turun dari gunung untuk membasmi kejahatan dari dunia, di mana takdir menentukan kita untuk bertemu di sini. Sekarang... Beri tahu padaku apa keinginanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001012,
					"content": "Keinginan? Paimon kira Adeptus di Liyue hanya hebat dalam bertarung... Kamu juga bisa mengabulkan keinginan orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Hehe... Ada beberapa perbedaan tingkat Adeptus. Bukankah bintang lebih tinggi dari gunung, awan dan bulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001014,
					"content": "Namun, seorang Adeptus tidak pantas untuk menyombongkan kekuatannya. Mungkin kalian berdua dapat berbicara dahulu dengan pengikutku sebelum menentukan pilihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111001007,
					"content": "Kita juga sedang mengikuti jejak Adeptus",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Aku Paimon! Dan ini adalah temanku, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Kalau begitu kebetulan sekali, kita ingin pergi ke tempat yang sama. Sebelumnya, biar aku memperkenalkan diri dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				}
			]
		},
