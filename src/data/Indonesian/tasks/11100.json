			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedagang Beriman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "Selama ada Lord Starsnatcher, Millelith tidak lagi perlu berjaga-jaga, benar bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Pedagang Beriman"
				},
				{
					"id": 111000602,
					"content": "Tentang Lord Starsnatcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Aku seorang pedagang, baru-baru ini aku mempunyai beberapa barang berharga untuk dikirim. Jadi, aku bertanya pada Lord Starsnatcher jika dia bersedia menemaniku dalam perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Pedagang Beriman"
				},
				{
					"id": 111000604,
					"content": "Ketika dia mengangkat jimatnya, monster-monster itu pun pergi, dan kami tidak mendapatkan sedikit pun gangguan selama perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Pedagang Beriman"
				},
				{
					"id": 111000605,
					"content": "Meski biayanya memang tidak murah... Tapi bagaimana pun, meminta layanan dari para dewa adalah masalah yang cukup penting - lihat saja Rite of Descension! Jadi aku sih bisa menerimanya, tapi aku ragu bahwa sebagian besar orang dari luar Liyue akan bersedia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pedagang Beriman"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Starsnatcher, Celestial Lord"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Bagaimana? Para pengikut mungkin terlalu berlebihan dalam berkata-kata, namun semua itu dari lubuk hati mereka yang terdalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000802,
					"content": "Sepertinya hanya imajinasi mereka saja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Hahaha, tentu saja, dulu ada seorang Adeptus yang sangat dihormati, dialah Xue Wuliang. Orang-orang memanggilnya \"Liangzi\". Dia berkata begini:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000804,
					"content": "\"Semua benda di dunia ini berhubungan satu sama lain. Apa yang disebut manusia sebagai imajinasi hanyalah hubungan antara roh dan benda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000805,
					"content": "Maksudnya adalah harapan mereka sedang berada di jalur yang benar untuk direalisasikan, apa kalian mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000806,
					"content": "Paimon tidak mengerti, tapi pastinya harapan mereka dapat dikabulkan, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Benar sekali, teman kecil ini sangat pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000808,
					"content": "Oke... Emm... kami juga punya satu pertanyaan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Ya? Coba ungkapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000810,
					"content": "Kenapa kamu memakai topeng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Aku menjelajahi dunia untuk melakukan kebajikan dan mengusir roh jahat. Aku sengaja tidak menunjukkan wajahku untuk menghindari terjadinya hal-hal yang tidak diinginkan di dunia fana ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000815,
					"content": "Oh, Paimon mengerti sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Jadi, apa harapan kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000817,
					"content": "Aku ingin mengetahui keberadaan saudaraku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Hmm... Pasti ada cerita yang menyedihkan di balik semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000824,
					"content": "Baiklah, harapan ini bukanlah hal yang mustahil untuk diwujudkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000825,
					"content": "Tapi pertama-tama, aku harus melihat dulu bukti dari... imanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000826,
					"content": "...Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Cara kerja Adeptus tidak dapat dipahami hanya dari kata-kata saja. Seseorang harus mencari... kebenaran mendalam yang ada dalam diri mereka... Bila kalian tidak mengerti maksud dalam perkataanku, maka maaf, aku tidak bisa membantu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000828,
					"content": "Bagaimana ini? Paimon tidak mengerti apa yang dia katakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Sepertinya kita harus melakukan sesuatu untuknya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Oh iya! Para pengikut tadi sempat mengatakan bahwa kita harus membayar harga jika ingin meminta bantuan Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Tapi Paimon tidak punya Mora, dan kita berdua juga tidak mempunyai benda berharga apa pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Bahkan kamu juga tidak mempunyai Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Seharusnya tidak ada yang akan menjual Vision.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Eh, bagaimana kalau kita membuatkan makanan untuknya? Tidak ada orang yang bisa menolak godaan makanan enak, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Di mata Paimon, memang seharusnya begitu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Ya, makanan enak! Cara ini pasti berhasil! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Bagaimana kalau kita segera berangkat ke Wanwen Bookhouse? Kita lihat apakah ada resep baru yang populer belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Makanan enak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Iya, sayang sekali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Sepertinya kita harus memberinya Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Aku ingin mendapatkan kekuatan yang bisa menyaingi para dewa.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "Dengan kekuatan, banyak masalah bisa terselesaikan. Namun ada yang membuatku penasaran, apa ada hal yang membuatmu bertikai dengan dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000821,
					"content": "Aku ingin kaya mendadak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Hei, hei! Kamu sudah tidak peduli dengan {M#adik}{F#kakak}mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "Yah, itulah manusia. Kamu sepertinya bukan orang Liyue, tapi tubuhmu memancarkan aroma busuk tembaga Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111000811,
					"content": "Bisakah kamu melepas topengnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Hei! Ini sepertinya tidak sopan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Hehehe, memang membuatku sedikit tidak nyaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				}
			]
		},
