			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanita Beriman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Akhirnya, hidup dengan tujuan dan harapan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Wanita Beriman"
				},
				{
					"id": 111000502,
					"content": "Tentang Lord Starsnatcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Oh! Jadi kamu pengikut Lord Starsnatcher juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Wanita Beriman"
				},
				{
					"id": 111000504,
					"content": "Setelah tunanganku pergi, aku menangis setiap hari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Wanita Beriman"
				},
				{
					"id": 111000505,
					"content": "Tapi ketika aku meminta bantuan pada Lord Starsnatcher. Atas sarannya, aku mulai membakar lukisan tunanganku dan membuang abunya ke laut pada saat matahari terbit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Wanita Beriman"
				},
				{
					"id": 111000506,
					"content": "Aku tidak dapat menjelaskannya... tapi itu benar-benar berguna! Di lubuk hatiku yang terdalam aku tahu bahwa dia akan kembali. Ini bukan semacam trik untuk berpikir positif... Aku yakin sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Wanita Beriman"
				},
				{
					"id": 111000507,
					"content": "Aku sangat bahagia ketika aku memberikan mahar pernikahanku kepada Lord Starsnatcher. Lagi pula, jika bukan karenanya, aku tidak mungkin dapat mendapatkan kembali tunanganku, dan kalau demikian, bukankah mahar pernikahanku juga jadi tidak ada artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wanita Beriman"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
