			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Sepertinya para Hilichurl yang kelihatan lebih kejam ini juga lebih kuat dari Hilichurl biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Hei, sepertinya ada beberapa orang yang berkumpul di sana... apa yang sedang mereka lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Wow... apa kamu lihat orang bertopeng itu? Di-dia membuat para Hilichurl itu ketakutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "Jangan-jangan dia seorang Adeptus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Maksudmu Adeptus seperti Xiao? Benar juga ya... Topeng orang itu juga mirip dengan topeng milik Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Kalau diperhatikan, sepertinya ilmu yang dia gunakan lebih mirip dengan ilmu Adeptus daripada milik Xiao. Ayo coba kita sapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Kelihatannya seperti ilmu seorang Adeptus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
