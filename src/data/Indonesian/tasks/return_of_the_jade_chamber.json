			"dialogs": [
				{
					"id": 718130201,
					"content": "Halo, kamu ingin membeli buku apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Aku mau buku berjudul Tambang Mutiara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "Tambang Mutiara? Buku itu sudah tidak ada... Apa kamu membutuhkannya segera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Tentang pembangunan Jade Chamber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Hah? Jade Chamber akan dibangun ulang? Kalau begitu memang dibutuhkan persiapan yang baik, aku ingat-ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Bagaimana jika kamu bertanya pada Qingzhou, dia menjual banyak buku, mungkin saja kamu bisa menemukan buku Tambang Mutiara di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Aku ingat Qingzhou sering berada di Wangshu Inn, kamu bisa pergi ke sana untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
