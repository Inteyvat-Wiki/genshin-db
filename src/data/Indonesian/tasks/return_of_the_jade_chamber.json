			"dialogs": [
				{
					"id": 718130601,
					"content": "Hm? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130602,
					"content": "Kami ingin membuat beberapa perabotan bambu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Perabotan bambu? Aku bisa membuatnya, tapi ini pesanan siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130604,
					"content": "Ini pesanan Baiwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Oh, ternyata pesanan dari Yuhai Pavilion. Baiklah, aku akan membuatnya secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130606,
					"content": "Tetapi belakangan ini, saat mengambil bahan di hutan bambu, tidak tahu kenapa banyak boar bermunculan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130607,
					"content": "Walaupun tidak berefek besar, tapi aku harus mengitari mereka dulu agar bisa mengambil bahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130608,
					"content": "Kalau kalian bisa membantuku mengusir boar-boar itu, aku bisa mengambil bahan dan segera membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130609,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Kalau begitu, aku tunggu kalian di sini. Kabari aku setelah kalian mengusir boar-boar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Lu"
				}
			]
		},
