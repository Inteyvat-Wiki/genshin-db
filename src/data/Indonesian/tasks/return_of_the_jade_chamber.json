			},
			"dialogs": [
				{
					"id": 718130801,
					"content": "Halo, ada keperluan apa lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "Tentang bahan-bahan yang perlu dipersiapkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Ini adalah buku... Tambang Mutiara. Dari mana kalian mendapatkan buku ini? Aku tidak bisa menemukannya meski sudah mencari ke seluruh Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Buku ini ditulis tangan oleh Qingzhou untukku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Penyair itu? Sepertinya cerita-cerita tentang dirinya itu ada benarnya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Terima kasih sudah membantuku menyiapkan barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Tentang pembangunan Jade Chamber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Memang pembangunan Jade Chamber sudah direncanakan, tapi masih banyak hal yang harus dipersiapkan. Kita tidak bisa langsung membangunnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Selain itu, masalah terbesar adalah bahan-bahannya. Sampai sekarang aku belum menemukan solusinya. Benar-benar mengkhawatirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Ya sudahlah, tidak perlu membahasnya. Sekali lagi terima kasih atas bantuan kalian dan terimalah hadiah ini. Aku akan lanjut bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
