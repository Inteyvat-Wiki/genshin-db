			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "Apa kamu sudah mengusir boar-boar itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Bagus sekali. Aku akan segera mengambil bahan di hutan. Setelah selesai, aku akan mengantarnya langsung ke Yuhai Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130704,
					"content": "Pesanannya cukup banyak, seharusnya aku bisa untung besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Lu"
				}
			]
		},
