					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Benar-benar sulit untuk menulisnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Tentang \"Tambang Mutiara\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "Tambang Mutiara? Oh, aku ingat buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Dulu saat aku harus menulis puisi tentang pedagang, aku pergi ke banyak tempat untuk mencari buku itu, lalu aku sampai di sebuah toko yang menjual buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Aku juga tidak begitu memahami isi dari buku itu, tapi di dalamnya ada banyak hal yang membantuku untuk menulis puisiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Biar kuingat-ingat dulu apa nama puisi itu. Tunggu sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Apa kamu masih ingat di mana kamu menemukan buku itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Kalian membutuhkan buku itu? Aku tidak ingat di mana aku mendapatkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Tapi kalau kalian benar-benar membutuhkannya, aku bisa menulis tangan isi buku itu pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Menulis tangan isi buku itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "*huff* Isi buku itu sama sekali tidak banyak, tidaklah sulit untuk mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Ditambah lagi, pemilik buku itu juga tidak mengizinkanku untuk meminjamnya dan membawa buku itu pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Tapi demi menulis puisi... aku menulis ulang isi buku itu, karena isinya tidak banyak, jadi kurang lebih aku bisa mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Inikah yang namanya kehebatan seorang penyair...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Tidak perlu memujiku seperti itu. Tapi karena aku sudah bersedia menuliskan buku itu untukmu, kamu juga harus membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Aku sedikit tidak enak membicarakannya, aku terus-menerus mencari inspirasi sampai lupa untuk makan, aku jadi sedikit lapar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Bawakan Triple-Layered Consommé padaku, aku akan menuliskan buku Tambang Mutiara untukmu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Saat kalian kembali, aku pasti sudah menyelesaikan menulis buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Apa kamu mengingat seluruh isinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
