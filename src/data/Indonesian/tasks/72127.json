				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Terima kasih, segini sudah cukup. Sebentar lagi aku keringkan bunga-bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Ah iya, aku punya hadiah untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Bunga kering ini untukmu. Meskipun agak layu, tapi... bunga ini sangat berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Bunga inilah yang tumbuh pertama di lautan bunga yang kamu lihat sekarang. Dia tumbuh dari benih yang kamu berikan padaku, karena itu dia kukembalikan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Meskipun bukan sesuatu yang mahal, tapi tetap saja... aku sangat berterima kasih padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "Semuanya akan kembali ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Ya! Aku harus menanam lebih banyak bunga. Agar lautan bunga ini jadi semakin indah saat mereka kembali nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "Apa yang spesial dari bunga ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Tentu ada, makanya aku memberikannya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		}
