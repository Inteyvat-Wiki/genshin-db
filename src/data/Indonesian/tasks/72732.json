					"Pain-Grocer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Geng Arataki! Aku datang untuk melawan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320102,
					"content": "Apa lagi ini? Grandmaster Hanakado, dia kirim bocah lain lagi buat melawan aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "Waduh, apa dia kehabisan orang? Ini sih kita dilempar sisa-sisa namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "Bukan kamu yang mau aku lawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320105,
					"content": "Tong kosong nyaring bunyinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320106,
					"content": "Si pirang inilah. Dia terlihat seperti orang yang kuat, aku rasa dialah pemimpin Geng Arataki yang sesungguhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320107,
					"content": "#Hahaha! Nah, ini baru namanya \"mata yang bisa melihat kualitas orang\"! Paimon suka, ayo puji lagi si {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "Woi, WOI! Ngomongin apa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "Sahabatku ini memang sakti, tapi dia cuma pihak luar yang bantu. Ingat baik-baik, pemimpin Geng Arataki itu, tak lain tak bukan, dan hanya satu-satunya, ya Tuan Besar Arataki Itto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "Berarti sekarang aku \"Tangan Kanan Raja Oni yang Masih Magang\", gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "Eh, ide bagus tuh! Geng Arataki memang bukan yang paling kuat, tapi ke mana-mana dipanggil \"bos\" kan keren juga rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "Kalau kamu setuju, Paimon mau jadi \"Paimon-nya Geng Arataki Selama Tiga Hari Doang\", atau, \"Pemimpin Sementara Geng Arataki\" saja deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "WOI WOI WOI! Jangan mau dibikin sesat sama lawan! Dia cuma mau ... ngadu domba, iya, betul! Intinya dia mau bikin kita ribut sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "Tunggu sampai Tuan Besar ini berhasil menggulung bosnya! Nanti kita suruh dia jilat ludahnya sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "Ge'er amat sih. Peduli apa aku sama urusan internal Geng Arataki? Aku cuma mau adu kumbang lawan orang jago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320117,
					"content": "Coba kita lihat sejago apa si pirang ini main adu kumbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320111,
					"content": "Mau dong jadi bos. Beberapa hari saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}