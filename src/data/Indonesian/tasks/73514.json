				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "Hampir saja ... Bahkan Wenut pun berencana membuat rencana kita amburadul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140102,
					"content": "Tuh kan! Coba saja kalau modul pengapiannya tidak dicopot, Wenut itu sudah pasti berhasil kita bunuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140103,
					"content": "Dan sekarang gara-gara Wenut-nya sudah kabur, minimal kita butuh 1 hari lagi sampai dia lengah seperti tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140104,
					"content": "Jangan bilang besok kamu masih mau berdebat ini itu denganku sampai kita gagal lagi membunuh Wenut-nya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140105,
					"content": "Eh, tapi kan masalah parameternya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140106,
					"content": "Semuanya sudah kuuji. Meskipun kecepatan pengisian dayanya sedikit lebih rendah dari nilai yang terhitung, tapi itu tidak memengaruhi penggunaan. Faktor keselamatannya pun tetap aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140107,
					"content": "Shriya, aku paham kalau kamu ingin mempertimbangkan dan menganalisis segala sesuatunya dulu sebelum bertindak. Tapi kan kamu pun tahu kalau segala sesuatunya tidak selalu berjalan sesuai dengan apa yang direncanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140108,
					"content": "Ingin memastikan semuanya berjalan sempurna, tapi ternyata kehilangan momen dan kesempatan ... rasanya akan sama-sama menyesakkan bagaikan sidang tesis tengah semester yang tertunda ... semakin diingat-diingat, terasa lebih menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140109,
					"content": "*huff* Baiklah. Ini, modul perapian milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140110,
					"content": "Oke! Akhirnya besok Meriam Wenutslayer ini bisa unjuk gigi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140111,
					"content": "Aku ingin membawa semuanya ke Desa Aaru untuk disetel. Kita harus siap betul karena ini penampilan perdana Meriam Wenutslayer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140112,
					"content": "Tapi kenapa bisa ada penyimpangan pada parameter lingkungannya ya? Apa yang membuat Wenut itu tiba-tiba berulah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140113,
					"content": "#Ini tidak bisa dibiarkan ... {M#Tuan}{F#Nona} petualang, apa kamu bisa kembali lagi ke sini besok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140114,
					"content": "Pada saatnya nanti, kita hadapi Wenut-nya secara langsung. Mudah-mudahan kita bisa mendapatkan beberapa petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				}
			]
		}
	]
}