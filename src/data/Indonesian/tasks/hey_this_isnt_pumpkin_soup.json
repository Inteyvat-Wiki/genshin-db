			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#{NICKNAME}! Bagaimana? Kamu baik-baik saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390702,
					"content": "Eh ... Maaf, maaf ... Aku tidak tahu kalau ramuan ini akan bisa memancing perhatian makhluk aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390703,
					"content": "Karena ramuannya buat aku hangat, makanya begini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Eh! Begitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Wah! Benar juga ya! Karena makhluk air mengira sesuatu yang hangat itu pasti adalah cahaya matahari, makanya mereka jadi tertarik. Berarti ramuannya sukses ya! Terima kasih! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390706,
					"content": "Wow! Meski Paimon merasa bukan begitu sih kejadian yang sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Makhluk air? Memangnya bukan Pyro Slime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Begitu ya ... Hmm ... Mungkin efek ilusi. Baiklah! Aku akan catat! Setidaknya bukan tidak berguna sama sekali kan. Cuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390709,
					"content": "Cuma saja efeknya gawat banget itu! Kalau hari ini anggap kepiting besar yang kelihatan kayak Pyro Slime. Kalau besok-besok ketemu monster yang lebih bahaya gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Eh ... Aku sudah merepotkan kalian banyak sekali. Tapi masih ada satu ramuan lagi ... Anu ... Kalian masih bersedia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390721,
					"content": "Asal tidak ada racunnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Kalau ada racunnya pun, baru bisa tahu setelah dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Oh! Terima kasih banyak! Yang selanjutnya ini adalah \"Ramuan Kebenaran\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390726,
					"content": "Eh? Tunggu dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "Yang pertama itu Ramuan Super Hebat, yang kedua Ramuan Anget-Anget, terus yang ketiga ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "Ramuan Kebenaran. Ya. Ramuan yang bisa membuat orang melihat kebenaran. Memangnya kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390729,
					"content": "Eh? Tidak sih ... Cuma Paimon rasa, nama yang satu ini kalau dibandingkan dengan yang lain, kayak berbeda tiga ratus enam puluh derajat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Kalau begitu, berarti tidak berubah dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Hah ...? Em ... Paimon enggak punya tangan sebanyak itu buat ngitung! Tapi kamu ngerti lah maksud Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Hehe. Karena dua ramuan yang sebelumnya namanya diberikan langsung oleh Ahli Ramuan. Kalau yang ini, aku yang kasih nama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390734,
					"content": "Aku tidak jago-jago amat soal ngasih nama, jadi tidak sebagus nama yang dia bikin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390735,
					"content": "Masa sih? Paimon malah ngerasa kebalikannya ... Tapi kamu harus percaya diri dong! Malahan yang ini namanya lebih mirip nama ramuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Ya. Terima kasih ... Yang ini berbeda dengan dua ramuan yang sebelumnya. Mungkin akan sedikit bahaya ... Jadi, datanglah ke tempat kerjaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390737,
					"content": "Ya. Kalau di dalam lautan sih, seharusnya bisa menetralkan efek ramuannya. Di tempat kerja juga ada peralatan untuk menetralkan efek bahayanya. Jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390738,
					"content": "Wow ... Kayaknya yang kali ini enggak main-main deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Ayo kita mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Oke, ikuti aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390731,
					"content": "Harusnya seratus delapan puluh derajat kali ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Toh sudah sampai tahap ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Benar sih. Cuma sampai di tengah jalan sih itu sayang banget ya. Eh, meski Paimon sedikit khawatir sih sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Tidak apa-apa. Pyro Slime itu kan lemah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#Hei! Bukan begitu! Jelas-jelas kan {NICKNAME} yang kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Eh. Tapi, tunggu dulu ... Kamu tadi bilang ... Pyro Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390713,
					"content": "Iya, kan! Jelas-jelas tadi kita lihat ada banyak banget kepitingnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Kepiting? Hmm .. Wajar sih kalau ada kepiting di pantai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Tapi tadi kamu itu enggak wajar sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Tapi sensasi terbakarnya benar-benar nyata. Bahkan ada gelombang panas juga dari arah mereka ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Begitu ya ... Hmm ... Mungkin efek halusinasi. Baiklah! aku catat! Setidaknya bukan tidak berguna sama sekali kan. Cuma .... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390718,
					"content": "Tapi untung kamu tidak apa-apa ya! Tapi ... aku merasa bersalah ... Maaf, ramuannya gagal lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390719,
					"content": "#Enggak masalah sih ... Pokoknya, yah. Tidak bau saja sudah cukup! Tapi sebenarnya ini juga sudah setengah berhasil, kan! Lihat nih, {NICKNAME} masih hidup dan aktif setelah minum kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
