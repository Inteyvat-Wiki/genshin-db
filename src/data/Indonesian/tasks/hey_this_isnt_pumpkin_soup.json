				]
			},
			"dialogs": [
				{
					"id": 740390101,
					"content": "Hmm ... campuran cairan Tidalga, jeroan yang dihancurkan dari Lumitoile, terus sedikit ... Tunggu, \"sedikit\" itu maksudnya segimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390102,
					"content": "Hmm? Ini lagi masak sup apa sih ...? Ugh! Baunya aneh banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Apa? Aneh? Tidak dong ... Jelas-jelas aku racik supnya pakai resep yang dikasih Carabosse, baunya harusnya biasa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390104,
					"content": "Baunya kayak kamu pakai katak mati untuk fermentasi ikan kakap yang sudah mati tiga tahun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Ugh, kamu harus banget ya ngomong gitu? Sekarang Paimon jadi kebayang nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "Po-Pokoknya, kamu ini lagi ngapain? Emm ... Butuh kami bantu enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "Ini ramuan! Aku lagi racik ramuan ... ramuan yang bakal bantu banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390110,
					"content": "Oh. Jadi kamu ... Ahli Ramuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Masih belum sih! Aku cuma asisten Ahli Ramuan, namanya Carabosse. Namaku Verenata, aku masih harus belajar banyak darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390112,
					"content": "Hehe, bisa jadi asisten peracik yang hebat juga sudah termasuk hebat loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Hehe ... Eh ... Ti-Tidak juga ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390114,
					"content": "Hmm ... Masih banyak hal yang tidak kuketahui. Aku cuma berusaha sekuat tenaga membantunya untuk membuat ramuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390115,
					"content": "Lalu ... U-Um, aku sudah kasih tahu kamu namaku, tapi aku masih belum tahu namamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390116,
					"content": "#Nama Paimon ya Paimon, kalau dia {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "Paimon, nama yang bagus sekali. Sama seperti ubur-ubur kecil berwarna putih yang berisik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}, juga nama yang sedikit aneh tapi namamu seolah berwarna emas berkilauan. Dan orangnya baik sekali, senang bisa berkenalan dengan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390119,
					"content": "Lalu, tadi kamu kan nanya kalau aku butuh bantuan atau tidak, yah aku perlu sih ... Tapi aku tidak tahu apa kalian bersedia membantu atau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390120,
					"content": "Ngomong saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Ya. Perlu kami bantu apa, langsung ngomong saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Aku mau kalian mencicipi ... ramuan yang baru diracik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390123,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "Aku tahu ramuan ini bau dan tidak enak ... tapi akan bisa bantu banyak orang untuk sembuhkan banyak penyakit. Efektif sekali loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390125,
					"content": "Tapi kami tidak bisa sakit, dan tidak suka minum yang aneh-aneh. Jadi seiring berjalannya waktu, orang-orang berhenti membantu mencicipi ramuanku — dan buatku itu masalah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390126,
					"content": "Eh? Kamu sendiri bilang ini benda aneh. Kan berbahaya banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Tidak masalah. Kami tidak akan bisa diracuni. Tapi ... Umm ... Teorinya, kalian juga tidak akan bisa keracunan. Teorinya sih begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390128,
					"content": "Kalau mau coba ramuan obat ... Hmm ... Total ada tiga jenis. Yang satu bisa bantu orang lebih jago dalam bertempur! Yang satu lagi bisa bikin orang tetap hangat. Dan yang terakhir, um ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390129,
					"content": "Duh gimana ya ngomongnya, tapi Carabosse bilang ini bisa membantu orang memahami kebenaran. Itu yang dia bilang sih ... Walaupun aku masih tidak paham apa artinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390130,
					"content": "Kok kedengarannya bahaya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "Tidak kok. Tidak bahaya ... Kalian bersedia bantu tidak? Kalau bersedia bantu, kita berangkat sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390106,
					"content": "Kalau hati kalian tenang, akan ada sedikit semerbak wangi Sweet Flower ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Hei, itu juga aneh dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
