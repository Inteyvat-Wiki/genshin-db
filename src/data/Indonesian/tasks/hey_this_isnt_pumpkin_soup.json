					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "#Jadi tadi {NICKNAME} itu bisa wush-wush langsung kalahkan monsternya, apa itu karena efek Ramuan Super Hebat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Benar banget! Ramuan Super Hebat buat aku jadi hebat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Jago marketing ya bos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Wah. Terima kasih banyak! Jadi memang karena efek ramuannya ya. Yah itu baru yang namanya resep Ahli Ramuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Ya. Baiklah, percobaan \"Ramuan Super Hebat\" sampai di sini saja! Selanjutnya, kita mulai coba ... yang ini! \"Ramuan Anget-Anget\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "Eh? Nama ini kamu yang pikirin sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Bukan dong. Aku tidak bisa kasih nama. Makanya akhirnya minta tolong orang lain untuk kasih nama yang agak mendingan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "Ya jangan bilang begitu juga. Untuk nama ramuan, harusnya langsung tahu fungsinya begitu lihat namanya, kan. Itu baru nama yang bagus, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Baru pertama kali dengar yang seperti itu ... Tapi benar juga. Ahli Ramuan harusnya gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#*uhuk* Ya sudah, pokoknya {NICKNAME}, sudah siap cicipi ramuan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Oke. Ayo kita mulai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Wow ... Ini kayaknya juga baunya enggak sedap banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Ini Ramuan Anget-Anget. Teorinya sih, kamu jadi tidak takut dingin dan tubuhmu jadi hangat! Um ... Secara teori sih begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "Kamu mengambil ramuan itu dari tangan Verenata. Aromanya seperti kulit tua yang sudah berjamur dan penuh dengan debu.\\nKamu ragu sebentar, tapi akhirnya meminumnya sampai habis. Obatnya tidak susah diminum. Dengan sedikit wangi kayu manis dan rasa pedas dari jahe ... Membuat kamu teringat pada tungku yang berbunyi pada saat hari-hari hujan.\\nSelain itu, tubuhmu juga tidak ada reaksi lain.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Lalu, sesuai petunjuk Verenata, kalian berdua beristirahat sejenak.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Tidak ada rasa apa-apa sih. Paling rasanya manis saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Eh? Ta-Tapi ... Jelas-jelas baunya enggak enak gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Eh? Begitu ya ... Salah di mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "Jangan kecewa juga dong. Soalnya, tidak susah diminum, terus tidak beracun. Ini kan sudah termasuk hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
