				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Terima kasih! Ayo kita cicipi yang pertama dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}, jangan minum kebanyakan ya! Kalau ada yang enggak beres langsung muntahin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Tenang Paimon. Aku tidak bakal kenapa-napa kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Heh ... Paimon kan khawatir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "Aku sudah siap, berikan ramuannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Ini namanya \"Ramuan Super Hebat\". Teorinya sih kamu bisa jadi hebat sekali! Teorinya sih gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "Kamu menerima ramuan itu dari tangan Verenata dan meminumnya.\\nMeski aromanya kuat dan menusuk hidung, tapi yang anehnya, tekstur obatnya sedikit manis dan lengket, sama sekali tidak sulit diminum.\\nSelain itu, tubuhmu juga tidak ada reaksi lainnya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Lalu, sesuai petunjuk Verenata, kalian berdua menunggu waktu Breacher Primus menjadi aktif.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
