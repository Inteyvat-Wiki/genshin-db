			"dialogs": [
				{
					"id": 221110201,
					"content": "Ada surat untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110202,
					"content": "Selamat datang di Adventurers' Guild cabang Liyue. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110203,
					"content": "Surat ini untukmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "Surat? Untukku? Oh, kamu petualang dari Mondstadt ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110205,
					"content": "Eh? Ini... Dandelion? Kenapa ada Dandelion terselip di dalam amplop?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110206,
					"content": "Petualang, apa kamu ingin menggunakan Dandelion ini sebagai bukti bahwa kamu datang dari Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110207,
					"content": "Sebenarnya kamu tidak perlu menyelipkan Dandelion ini. Informasi yang tertulis di dalam surat ini sudah cukup untuk membuktikan identitas dan asal-usul kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110208,
					"content": "Bukan aku yang menyelipkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Tapi ini bukan masalah besar, tidak perlu terlalu dipikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110214,
					"content": "Surat dari Adventurers' Guild Mondstadt ini mengatakan bahwa kamu adalah seorang petualang yang berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110215,
					"content": "Kalau isi surat ini benar, aku yakin kamu sudah siap untuk menerima misi dari Adventurers' Guild Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110216,
					"content": "Dunia petualangan baru sedang menanti kedatanganmu. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110210,
					"content": "Ini pasti ulah Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Katheryne? Oh, yang kamu maksud pasti Katheryne dari Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110212,
					"content": "Kenapa dia menyelipkan Dandelion ke dalam surat? Aneh sekali... Dandelion tidak ada gunanya sama sekali untuk petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110213,
					"content": "Tapi ini bukan masalah besar, tidak perlu terlalu dipikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
