			"dialogs": [
				{
					"id": 221110101,
					"content": "Ada misi baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "Halo, Petualang. Kisah petualanganmu sudah terdengar di seluruh penjuru Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "Lanjutkan usahamu dan kamu pasti akan menjadi salah satu dari petualang terhebat di zaman ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "Apa terjadi sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Kalau kamu ingin menjadi seorang petualang yang hebat, ada saatnya kamu harus pergi bertualang di tempat yang belum kamu ketahui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "Kini kamu sudah memiliki pengalaman bertualang yang cukup banyak. Sudah waktunya kamu menjelajahi tempat yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Ambil surat ini dan berikan kepada Katheryne di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "... Ada yang namanya Katheryne juga di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Ya, kamu akan menemukannya dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Dengan surat ini, Katheryne dari Liyue akan menjadi seperti aku, membantumu memenuhi semua kebutuhan dalam petualangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "Kalau kamu kembali ke Mondstadt, tentu saja aku akan kembali melayanimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "Oh ya, tolong jangan sembarangan membuka surat ini, agar tidak ada sesuatu yang terjatuh dari amplop dan menyebabkan masalah di kemudian hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "Petualang! Pergilah menuju bintang dan kedalaman dunia! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "Apakah aku harus memanggilmu \"Katheryne dari Mondstadt\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "Kamu bisa memilih panggilan yang kamu suka dalam petualanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "Tapi aku hanya tahu tentang Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Karena sampai saat ini kamu hanya bertualang di area Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "Semua akan berubah. Kamu akan dapat menjelajahi dunia luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2211102,
