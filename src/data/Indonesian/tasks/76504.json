			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Halo {NICKNAME}, Paimon. Kalian sudah makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? Kenapa kamu juga sampai ke atap? Apa kamu sedang ... mengamati bentuk awan dan menghitung peluang hujan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Aku sedang melakukan ... misi yang tidak terencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Rencana awalnya adalah untuk membeli \"roda gigi presisi\" dan \"sekrup heksagonal spesial\" yang ada di daftar Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Tapi dalam perjalanan kembali ke workshop, aku mengalami ... insiden intersepsi yang tidak terduga. Seekor elang merebut sekrup spesial itu dengan kecepatan tinggi dari tanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Jadi, kamu berlari ke atas atap untuk mencari elang itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Benar. Berdasarkan kebiasaan makhluk ini, atap rumah bisa jadi tempat singgah sementara. Aku sedang melakukan pemindaian visual dan pendeteksi suara untuk mencari target.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Tapi, sampai sekarang, aku belum menemukan jejaknya. Spekulasi awal adalah target sudah kabur dari jangkauan pelacakanku, atau sudah memindahkan \"buruannya\" ke sarang yang lebih tersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Rencana cadangan sudah diaktifkan. Pergi lagi ke pemasok yang ditentukan dan beli sekrup dengan model yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "Kembali ke topik. Kalian muncul di tempat tinggi, apa juga sedang ... melacak hewan kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Oh, enggak kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Benar, kami tadinya mau cari tempat yang kelihatan luas buat ambil foto pemandangan kota, merekam kesibukan dan kehidupan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Enggak disangka ketemu Ineffa yang lagi \"mengejar pencuri\" di sini! Ini juga termasuk \"insiden yang di luar jalur\", kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Mumpung ada kesempatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Boleh. Silakan tunjukkan posisi berdiri, arah tubuh, dan ekspresi wajah yang disarankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "#Menurutku, kemungkinan aku naik ke atap, bertemu dengan kalian di sini, lalu {NICKNAME} ingin memotretku, semua hal ini mungkin lebih rendah dari burung elang datang mengembalikan sekrup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Tolong rekam momen \"kejutan\" yang langka ini dengan akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Boleh foto-foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Aku sedang mencari model untuk foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
