			"dialogs": [
				{
					"id": 765040701,
					"content": "#Halo, {NICKNAME}, Paimon. Kalian sudah makan? Ada rencana apa hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Aku mengerti. Jalan-jalan dan merekam apa yang kamu lihat dengan kameramu adalah cara yang bagus untuk bersantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Tapi aku tidak melihat ada kamera di badanmu. Mungkin kamu lupa membawanya saat pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
