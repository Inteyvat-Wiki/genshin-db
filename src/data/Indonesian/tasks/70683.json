			"dialogs": [
				{
					"id": 706830701,
					"content": "Terima kasih atas bantuanmu, Honorary Knight dan Asisten Putihnya. Kalian memang pantas disebut pahlawan Mondstadt. Simulasi perangmu luar biasa sekali, layak dianalisis dan dipelajari lebih mendalam berulang kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830702,
						706830704
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830702,
					"content": "Hehe, siapa dulu dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830703
					]
				},
				{
					"id": 706830703,
					"content": "#Hehe, {NICKNAME} memang jagoannya basmi monster! Berarti kami sudah lumayan ngebantu Knights of Favonius ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830705,
					"content": "Betul, simulasi perang ini berjalan dengan sangat lancar. Kami dari Skuad Ketujuh dan para knight belajar banyak dari menganalisis hasil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830706
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830706,
					"content": "Dengan begini harusnya upaya kami meningkatkan keamanan di area sekitar Mondstadt bisa lebih lancar. Harapannya sekarang kami bisa lebih tanggap dalam menghadapi Slime yang mendadak serang para lansia, atau Hilichurl yang jarah karavan pedagang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830707
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830707,
					"content": "Iya nih, Paimon merasa sering banget ada kejadian begitu ... Berarti mulai sekarang enggak bakalan gitu lagi dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830708,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830709
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830709,
					"content": "I-iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830710,
					"content": "Pastinya butuh waktu, tapi kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830711
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830711,
					"content": "Phonia! Phonia! Dengar deh! Oh, ada Honorary Knight dan Asisten Putihnya! Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830712
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830712,
					"content": "Ada apa lagi kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830713
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830713,
					"content": "Ih, mukanya langsung asam gitu. Padahal aku cuma mau kasih laporan simulasi perang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830714
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830714,
					"content": "Hmph! Intinya, waktu aku \"menyimulasi perang tanpa suara\" seperti yang kamu minta, aku dapat sesuatu yang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830715
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830715,
					"content": "Sesuatu yang luar biasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830716,
					"content": "Betul! Walaupun ini cuma simulasi, tapi kalau kita gandakan kekuatan ledaknya sepuluh kali lipat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830717
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830717,
					"content": "Berarti kepala panah peledak miniatur yang kita kembangkan bisa tumbangin Ruin Guard dalam sekali tembak dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830718
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830718,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830719,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830720
					]
				},
				{
					"id": 706830720,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830721
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830721,
					"content": "Aku boleh tanya dulu? Kenapa harus sepuluh kali lipat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830722
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830722,
					"content": "Biar hasil simulasinya lebih bagus dong! Kalau di dunia nyata sih mungkin tidak memungkinkan, ya. Tapi data seperti ini menarik, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830723
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830723,
					"content": "Yang penting kita kerja terus untuk capai target! Siapa tahu bisa dapat hasil begitu nantinya! Bisa buat ledakan indah yang sepersepuluhnya Jumpy Dumpty ... Ahhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830724
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830724,
					"content": "Kalau gitu kenapa tidak langsung kamu gandakan jadi seratus kali lipat saja? Sekalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830725
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830725,
					"content": "Hah? Betul juga! Kalau kita gandakan daya ledaknya seratus kali lipat, berarti ... kita bisa berantas monster apa pun! Memang tidak salah tanya ke Phonia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830726
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830726,
					"content": "Apalagi kalau kita gabungkan sama Inti Taktis Raja Spikey Fish! Segerombolan Ruin Grader pun bisa rata semua dalam sekali tembak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830727
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830727,
					"content": "Oh? Jangan setengah-setengah kalau begitu. Kita gandakan saja sepuluh juta kali lipat, biar Katedral Favonius-nya ikutan rata seperti Institut Penelitian Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830728
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830728,
					"content": "Setelahnya begitu kamu diikat di katedral, akhirnya aku bisa putus hubungan darimu dan cari orang normal yang mau sewa rumahku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830729
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830729,
					"content": "Ahhhh, aku cuma bercanda kok! Bercanda, suer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830730
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830730,
					"content": "Iya sama. Lagian aku komandanmu sekarang. Kalau kamu diikat di depan publik, nantinya aku juga dicap tidak becus. Terus aku juga belum ketemu orang yang mau sewa rumahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830731
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830731,
					"content": "Oh, jadi bercandanya karena kamu belum ketemu penyewa ya ... Eh, enggak lucu ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830732,
					"content": "Intinyaaa, terima kasih atas bantuan kalian. Dan Ematol, begitu kita balik nanti, kamu harus refleksi diri. Berani-beraninya gonta-ganti parameter simulasi seenaknya. Jangan coba-coba membantah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830704,
					"content": "Senang bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830705
					]
				}
			]
		}
	]
}