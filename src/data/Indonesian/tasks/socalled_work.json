			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Aku adalah \"cooper\", aku tidak jago dan tidak punya talenta khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140702,
					"content": "Apa itu cooper?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Oh, itu adalah sebuah sebutan, aku adalah seseorang yang memperbaiki tong, dan sekarang masih butuh satu papan kayu untuk menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140704,
					"content": "Tapi, papan kayu yang aku punya kualitasnya kurang bagus, sedikit kependekan. Kalau aku menggunakannya untuk membuat tong kayu, maka akan mengurangi kapasitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140705,
					"content": "Tapi, kalau aku mencari papan kayu yang baru, tidak tahu kapan tong itu akan selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140706,
					"content": "Dan batas waktu untuk menyelesaikan tong itu sudah dekat, aku hanya bisa memilih dari dua pilihan yang sama-sama tidak menguntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140707,
					"content": "Tidak tahu ada berapa banyak orang yang pekerjaannya sepertiku, dan mengalami dilema yang sama denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140708,
					"content": "Pekerjaan Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "Pekerjaannya? Oh, dia pernah meminta tolong padamu untuk menghitung jumlah kapal, kan? Aku tahu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140710,
					"content": "Jangan terlalu kaget, selama pekerjaannya bagus, aku tidak akan mempermasalahkan bagaimana dia melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140711,
					"content": "Selain itu, hadiah yang dia berikan padamu adalah miliknya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140712,
					"content": "Tapi, dia langsung melaporkan data tanpa memeriksanya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140713,
					"content": "Sikapnya yang tidak bertanggung jawab itulah yang membuatku marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				}
			]
		},
