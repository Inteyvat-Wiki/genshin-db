			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nervous An"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "Huh, benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140202,
					"content": "Tentang masalah Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Ya? Kamu bertanya tentang masalah Linling ya, dia... bagaimana mengatakannya ya, sepertinya dia kurang cocok dengan pekerjaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140204,
					"content": "Alasannya adalah... data yang dia laporkan salahnya terlalu berlebihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140205,
					"content": "Hanya ada data satu atau dua hari yang benar dalam seminggu ini, bahkan dilihat sekilas saja masih lebih akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140206,
					"content": "Cara bekerjanya seperti itu, bagaimana aku bisa tenang memberikan pekerjaan padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140207,
					"content": "Hanya soal menghitung jumlah kapal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Kamu tidak boleh menambahkan kata \"hanya\" dalam melakukan pekerjaan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140209,
					"content": "Ada satu buah papan kayu saja yang lebih pendek pada tong, akan membuat kualitas tong menjadi menurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140210,
					"content": "Sama halnya dengan pekerjaan, menganggap remeh satu hal, akan membuat seluruh pekerjaan hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140211,
					"content": "Sekarang ambil contoh jumlah kapal. Misalkan jumlah kapal yang dihitung tidak benar, maka tindakan yang dilakukan untuk dermaga juga tidak akan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140212,
					"content": "Tindakan yang tidak benar, pasti akan memberikan dampak yang buruk. Meskipun ada orang yang akan memperbaikinya, tapi waktu yang terbuang sudah tidak bisa kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140213,
					"content": "Apakah kalian mengerti sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140214,
					"content": "Aku, aku mengerti sekarang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "... Tapi, sekarang masih kekurangan orang di dermaga, kalau memecat... sepertinya tidak akan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140216,
					"content": "Bagaimana mengatakannya... \"sebuah papan lebih pendek\" masih lebih baik daripada \"papan yang hilang\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140217,
					"content": "Orang yang bertugas memeriksa barang untuk sementara tidak bisa datang. Tolong kamu kembali dan beri tahu Linling untuk bantu-bantu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140218,
					"content": "Kalau dia tidak menimbulkan masalah besar dalam pekerjaan ini, tunggu orang yang bertugas memeriksa barang kembali, dia bisa melanjutkan pekerjaannya menghitung kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140224,
					"content": "Ya... Bisa dibilang ini adalah sebuah \"tes\" kan, anggap memberinya satu kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140225,
					"content": "Berikan daftar barang ini kepada Linling, biarkan dia memeriksa barang dengan menyesuaikan yang ada di daftar ini. Setelah memeriksa satu item, kasih tanda di belakangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140226,
					"content": "Ada lagi, tolong beri tahu Linling untuk fokus bekerja. Tidak akan ada kesempatan kedua kalau dia sampai tidak bekerja dengan baik di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140219,
					"content": "Aku akan menjelaskannya kepada Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Kalian kembali mau mengatakan apa? Memecatnya? Tidak, sementara ini tidak akan dipecat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140221,
					"content": "Sekarang di dermaga sedang kekurangan orang, bagaimana mengatakannya ya... \"Sebuah papan lebih pendek\" masih lebih baik daripada \"papan yang hilang\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140222,
					"content": "Orang yang bertugas memeriksa barang untuk sementara tidak bisa datang. Tolong kamu kembali dan beri tahu Linling untuk bantu-bantu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140223,
					"content": "Kalau dia tidak menimbulkan masalah besar dalam pekerjaan ini, tunggu orang yang bertugas memeriksa barang kembali, dia bisa melanjutkan pekerjaannya menghitung kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Nervous An"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "Hmm... apa yang harus aku lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "Nervous An mengatakan akan memberimu satu kesempatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Benarkah?! Bagus, untung saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Eh? Memeriksa barang? Gawat, aku belum pernah mengerjakannya sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Kalau pekerjaan ini sampai ada kesalahan lagi, aku pasti celaka. Tidak bisa, aku harus bersiap-siap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Aku akan pergi mencari standar memeriksa barang sebelumnya... dan juga format standar yang ditulis sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Bisakah membantuku mengonfirmasi jumlah barang? Sesuaikan dulu dengan daftarnya, lihat jumlahnya benar atau tidak sudah cukup, aku akan memeriksanya lebih detail nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Kalau begitu tolong ya! Aku di sini akan menyiapkan pemeriksaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Kali ini tidak boleh sampai ada kesalahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "Kuserahkan kepada kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Tidak, kali ini tidak boleh. Memeriksa barang jauh lebih rumit daripada menghitung kapal, aku harus melakukannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Jadi, tolong kalian konfirmasi dulu jumlah barangnya, aku akan memeriksanya lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
