				{
					"id": 221140801,
					"content": "Memeriksa barang jauh lebih rumit daripada menghitung jumlah kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140802
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140802,
					"content": "Kali ini harus hati-hati, aku tidak boleh membuat kesalahan sama sekali...",
