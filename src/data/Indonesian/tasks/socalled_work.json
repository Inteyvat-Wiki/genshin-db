			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Apakah kalian sudah konfirmasi jumlahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Ya, sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Bagus, aku juga sudah hampir selesai, aku akan ke sana nanti dan memeriksanya sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Benar juga! Ini untukmu, anggap saja sebagai tanda terima kasih, terimalah. Nanti aku akan memeriksa barangnya, kali ini tidak boleh sampai ada kesalahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Kamu tidak menulis puisi kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Tentu saja tidak! Aku juga tahu mana prioritasnya, sekarang bukan saatnya menulis puisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "Hmm... Ke depannya tidak boleh lagi menulis puisi, harus lebih rajin dan fokus bekerja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Pekerjaan lebih penting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Aku tahu, tapi... seharian dari pagi sampai malam melakukan hal yang sama, diulang terus dari tahun ke tahun... lama-lama bosan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "Selain itu, pekerjaan kecil seperti ini tidak ada artinya, tidak ada orang yang akan peduli, dan tanpa sadar membuat kesalahan kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "Ah, meskipun Nervous An selalu mengatakan \"setiap pekerjaan itu penting\", \"setiap pekerjaan itu menentukan hasil akhir\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Tapi, kalau memang benar seperti itu, lalu kenapa orang-orang masih memilih-milih pekerjaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Tanggung jawab pekerjaan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Aku juga hanya sesekali meminta bantuanmu, sebagian besar juga aku yang melakukannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Tanggung jawab pekerjaan... Aku juga tahu. Tapi semakin aku sibuk, semakin aku ingin bermalas-malasan, makanya meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Kalau aku tidak ada kerjaan, aku ingin melakukan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Ah, kamu juga tidak pernah bekerja, percuma aku mengatakannya kamu juga tidak akan mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Kenapa begitu ingin menulis puisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Kenapa tiba-tiba menanyakan hal itu? Aku sedang berpikir... menurutmu, apa alasan orang bekerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Menurutku, kalau \"bekerja dan terus bekerja\", itu adalah hal yang membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Bagaimana mengatakannya, setiap orang pasti punya mimpi, kan? Mimpi yang sama sekali berbeda dengan pekerjaan sehari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "Kalau seperti itu, saat kamu lelah dan hampir tidak bisa bertahan lagi, setidaknya kamu bisa bersantai sejenak di dalam \"mimpi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Tapi, ini juga hanya pemikiranku, aku tidak tahu bagaimana pemikiran para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Bagaimanapun, mereka seakan dilahirkan untuk mimpi mereka. Aku rasa aku membutuhkan pekerjaan sehari-hari untuk membatasi diri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Tapi, hahaha... pesan dariku: \"mimpi\" hanyalah sekadar \"mimpi. Saat kamu bekerja, harus tetap serius dan realistis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
