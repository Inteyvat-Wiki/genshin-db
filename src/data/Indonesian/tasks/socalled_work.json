				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Sudah berakhir, ini semua sudah berakhir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "Nervous An mengatakan, aku mungkin kurang cocok dengan pekerjaan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Bukankah itu maksudnya dia mau memecatku? Bagaimana ini... jelas-jelas setiap hari aku bekerja dengan rajin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Hah? Kenapa tiba-tiba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Itu... aku dulu pernah meminta tolong padamu... untuk menghitung jumlah kapal kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Karena aku percaya pada kemampuanmu, jadi aku tidak menghitungnya lagi dan langsung menulisnya di laporan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Dan ternyata, ada banyak data yang salah... Nervous An pun marah besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Bolehkah kamu menjelaskannya kepada Nervous An? Aku, aku akan bekerja rajin lagi ke depannya! Dan sebisa mungkin aku tidak meminta tolong padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Tapi aku sendiri tidak berani bertanya padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Hitungan kapal sebelumnya salah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Iya, bukankah sebelumnya aku ada meminta tolong padamu untuk menghitung jumlah kapal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Karena aku percaya dengan kemampuanmu... jadi aku tidak menghitungnya lagi dan langsung melaporkannya, ternyata ada banyak data statistik yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Tapi aku juga jarang meminta tolong padamu, dan aku juga sering menghitungnya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Dua data tergabung, aku sampai tidak tahu mana yang salah, dan membuat Nervous An marah besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Tolong jelaskan ke Nervous An ya! Aku, aku pasti akan rajin bekerja ke depannya! Dan sebisa mungkin aku tidak meminta tolong padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Tapi aku sendiri tidak berani bertanya padanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211402,
			"completionStepIds": [
				2211402
