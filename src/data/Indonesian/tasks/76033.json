			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arwah yang Terobsesi Makanan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Mm. Potongan dagingnya pas, gorengnya juga sempurna. Lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330302,
					"content": "Tapi ingat, saat bikin daging goreng, kita harus pikirkan juga pinggirannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330303,
					"content": "Makan daging terlalu banyak bisa bikin perut begah. Makanya, kita kasih buah. Supaya tidak enek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330304,
					"content": "Di pulau ini, kita yang bertanggung jawab atas nutrisi makanan semua orang, jaga keseimbangan antara sayur dan daging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330305,
					"content": "Kalau daging gorengnya tidak dilengkapi sayur, tidak boleh dihidangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330306,
					"content": "Kamu masih butuh latihan! Lain kali balik lagi ya untuk buat Lakkaberry Madame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				}
			]
		},
