			"dialogs": [
				{
					"id": 760330401,
					"content": "Bumbunya meresap ke ayam, pinggirannya juga banyak. Hmm, sengaja ya, supaya aku tidak bisa komentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330402,
					"content": "Ha. Sudahlah, toh aku juga bukan sengaja mau cari-cari kesalahan anak baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330403,
					"content": "Aku cuma koki. Kerjanya masak, sebaik yang aku bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330404,
					"content": "Misalkan Perburuan Liar datang kemari pun, aku sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330405,
					"content": "Sayangnya aku ... tidak sempat mengantarkan makanan yang ... sudah jadi ... makanannya ... tumpah ... tumpah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				}
			]
		}
