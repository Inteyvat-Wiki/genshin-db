				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "Anak baru, masak apa sih? Kacau benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330102,
					"content": "Makanan ini untuk ransum para Ratnik di pulau. Masaknya harus sesuai selera mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330103,
					"content": "Ini tidak bisa. Pertama, pengaturan apinya jelek. Kedua, ini tidak cocok dengan standar makanan kita. Ganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330104,
					"content": "Kamu masih perlu banyak latihan. Mulai dari yang gampang dulu deh, Nod-Krai Hot Dog. Balik lagi kalau sudah bisa bikin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
