			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arwah yang Terobsesi Makanan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Hmm, sosisnya mantap. Pas sekali matangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330202,
					"content": "Kamu sudah bisa jadi wakil koki kepala kalau kerja di luar. Bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330203,
					"content": "Tapi kita masak untuk Ratnik. Jadi yang diperhatikan bukan mewahnya, tapi porsinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330204,
					"content": "Buat rotinya lebih tebal. Sekarang lagi kekurangan sayur, jadi boleh tambahkan daging lain selain sosis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				},
				{
					"id": 760330205,
					"content": "Kamu masih butuh latihan! Lain kali balik lagi ya untuk buat Berries and Fried Meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah yang Terobsesi Makanan"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
