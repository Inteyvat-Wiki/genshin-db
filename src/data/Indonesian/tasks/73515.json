			"dialogs": [
				{
					"id": 735150101,
					"content": "Kamu sudah datang, Petualang. Kami sedang merencanakan akan melakukan instalasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Kalau semuanya lancar, kita pasti akan berhasil memberikan pelajaran pada monster itu hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Selama proses pengisian daya formal, bisa jadi ada monster-monster yang menginterupsi proses tersebut. Kalau sudah begitu, harap perhatikan kemajuan pengisian daya dan daya tahan perangkatnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "Terima kasih banyak, petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Ah, aku punya ide bagus! Selama ini kan kamu sudah banyak membantu urusan Meriam Wenutslayer, jadi hak istimewa percobaan perdananya ... buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Memang kamu enggak mau jadi yang pertama mencobanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Bisa melihat meriamnya menembak tanah saja sudah bikin aku bahagia! Apalagi melihat ada orang yang menyalakan apinya sampai cahaya gemilangnya menyelubungi langit ... Ah! Tidak perlu dibayangkan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Kamu hanya perlu melindungi perangkat pengisi dayanya dari monster dan menunggu sampai energinya terisi penuh. Berfokuslah saat titik lemah Wenut sedang terbuka, kemudian lakukanlah tembakan tanpa ampun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Sisanya biarkan modul pengapian dan perbaikan otomatisnya saja yang bekerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Kedengarannya hebat ya, {NICKNAME}, Paimon juga mau ikutan nonton dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Oke, aku mulai ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Oke, sepakat ya! Biar kuberi tahu cara pakainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Aku tidak tahu cara mengoperasikannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Santai! Aku mendesainnya secara sempurna sesuai dengan prinsip praktis bagi para penggunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
