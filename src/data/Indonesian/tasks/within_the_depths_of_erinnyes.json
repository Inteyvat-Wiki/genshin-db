						740851709
					]
				},
				{
					"id": 740851709,
					"content": "Hmm ... Melusine yang satu itu misterius banget ya. Padahal Paimon enggak mikirin soal imbalannya, tapi rasanya aneh dia hilang begitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851710,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "Seperti ... Seperti kalau makanan kesukaanmu tiba-tiba bilang \"lebih baik putus saja sudah hubungan kita\". Seaneh itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851712,
					"content": "Duh sedih banget rasanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "Pokoknya rasanya gitu deh! Atau jangan-jangan si Pahsiv terluka? Tadi dia kayaknya capek banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851715,
					"content": "Kita coba cari sekeliling dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "Iya! Paimon juga rasa sebaiknya kita cari dia, takutnya dia lagi bahaya atau gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851717,
					"content": "Tunggu dulu. Ini kenapa dah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851718,
					"content": "Kalian sedang bersiap-siap untuk mencari Pahsiv. Tiba-tiba, air mulai muncul dari dalam gua, dan kalian tersapu oleh arusnya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "Aku sih lebih bingung kalau makanan bisa ngomong.",
