			"dialogs": [
				{
					"id": 740850201,
					"content": "Kunci, patung, kunci, patung, kunci, patung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850202,
					"content": "Uhm ... maksudmu kuncinya dimasukkan ke dalam patung? Cocok sih, tiga kunci buat tiga patung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850203,
					"content": "Kita coba yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850204,
					"content": "Apa yang bakal terjadi sesudah kuncinya dimasukkan ke patung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Pintu buka, pintu buka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850206,
					"content": "Pintu? Di mana? Apa yang ada di balik pintu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850207,
					"content": "Akar, Erinnyes, sangat dalam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850208,
					"content": "Pintu menuju ke Erinnyes?! Pahsiv, ka-kamu ... luas juga pengetahuannya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850209,
					"content": "Pahsiv, lindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850210,
					"content": "Apa lagi nih yang harus kami tahu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850212,
					"content": "Ada intel, ada informasi. Semakin banyak, semakin baik. Tahu lebih banyak, jadi lebih yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850213,
					"content": "In-formasi? In-formasi ... Pahsiv! Informasi, sangat banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850214,
					"content": "Bagus dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850215,
					"content": "Erinnyes, informasi, sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850216,
					"content": "Iya ... banyak informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850217,
					"content": "Informasi, jalur air, sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850218,
					"content": "Iya ... banyak jalur air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850219,
					"content": "Jalur air, tamu itu, sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850220,
					"content": "Hmm ... Hmm?! Banyak tamu itu?! Tunggu, Paimon bingung ... Dari mana datangnya bisa banyak tamu gitu? Tamu itunya bisa pakai jurus bayangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850221,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850222,
					"content": "Jalur air, tamu itu, cicipi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850223,
					"content": "Kejahatan, tamu itu, terasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850224,
					"content": "Mencicipi kejahatan di jalur air? Rasa aneh macam apa ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850225,
					"content": "Apa tamu itu bisa merasakan informasi di jalur air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850227,
					"content": "Pohon dedalu, kumpulkan. Jalan kabut, selesaikan. Mata air, kirimkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850228,
					"content": "Akar, jalur air, pusat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850229,
					"content": "Erinnyes adalah pusat informasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "Maksudmu seluruh Erinnyes adalah sistem informasi dari tamu itu? Dia bisa merasakan sesuatu yang buruk pakai cara ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850231,
					"content": "#Paimon pintar! {NICKNAME} pintar! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850232,
					"content": "Astaga, sebenarnya siapa sih tamu yang namanya tamu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850233,
					"content": "Fontaine, tamu itu, melindungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850234,
					"content": "Tapi, tamu itu, sangat sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850235,
					"content": "Si ungu, diam-diam pergi ke akar. Si ungu, diam-diam bikin rusak akar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850236,
					"content": "Pahsiv, intip. Pahsiv, diam-diam hancurkan tablet batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850237,
					"content": "Ah, jadi kamu yang ngehapus tulisan di tablet batu itu! Kamu mau menghentikannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850238,
					"content": "Pahsiv! Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850239,
					"content": "Si ungu, masih mengarah ke akar. Si ungu, sangat kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850240,
					"content": "Apa dia menemukan jalan yang lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850242,
					"content": "Kayaknya bukan sosok yang gampang dihadapi ... Kalau akar hancur, sistem informasi bakal gagal, dan kepekaan si tamu itu pasti akan terpengaruh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850243,
					"content": "Pahsiv, tanggung jawab! Pahsiv, lindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, buagh, bugh. Paimon, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850245,
					"content": "#{NICKNAME}, kayaknya kita sudah enggak bisa nunggu lagi nih! Sekarang kita harus hajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850246,
					"content": "Pahsiv! Ayo kita buka pintu sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
					]
				},
				{
					"id": 740850247,
					"content": "Mantap, ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
