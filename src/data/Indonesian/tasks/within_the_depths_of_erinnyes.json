			"dialogs": [
				{
					"id": 740851401,
					"content": "Akhirnya bersih juga kotorannya. Ternyata Pahsiv punya kemampuan ajaib semacam ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
