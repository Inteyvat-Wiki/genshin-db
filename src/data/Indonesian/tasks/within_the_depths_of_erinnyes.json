					"nextDialogs": [
						740851005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851005,
					"content": "Paimon sudah ngerti. Pantas saja akarnya itu kayak sudah layu, rupanya karena akarnya sudah jadi kayak begini!",
