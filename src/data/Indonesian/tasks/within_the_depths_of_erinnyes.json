			"dialogs": [
				{
					"id": 740851701,
					"content": "#Fiuh, akhirnya beres juga. Kayaknya kita enggak sengaja nemu sarang Rifthound. {NICKNAME}, kamu enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
