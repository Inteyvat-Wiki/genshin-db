						740851703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851702,
					"content": "Mau seharian juga masih kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "Hehe, Paimon percaya deh. Kayaknya akarnya sudah pulih. Seharusnya sekarang masalah di sini juga beres, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851705,
					"content": "Tapi yang tadi itu apa ya? Kenapa ada Vishap yang datang bantuin? Terus si Pahsiv juga hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851706,
					"content": "Hei—! Pahsiv! Kamu di mana? Kedengaran enggak?",
