			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos. Bisa bicara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Sudah ada keputusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Nanti dulu. Kebetulan aku pernah mempelajari ilmu pengobatan, dan ingin tahu apakah boleh bila aku ingin memeriksa kakekmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Terserah, tapi jangan kira kami tidak punya dokter sendiri di sini. Aku kira kamu tidak akan bisa mendiagnosis sesuatu yang kami juga belum tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Ya, kita lihat saja dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Ikut aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Jangan berisik ya, nanti kakek terganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari mengeluarkan peralatannya dan melakukan pemeriksaan medis dasar terhadap Bamoun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Kita bicara di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun sekarang koma, dan hasil prognosisnya mengkhawatirkan. Aku kira dokter kalian juga menyimpulkan hal yang sama ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Dia sepertinya pernah terluka parah sewaktu muda, dan kondisinya berangsur memburuk seiring berjalannya waktu akibat beban kerja yang terlalu berat. Lalu ditambah lagi efek penuaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Mohon maaf, tapi berdasarkan pengalamanku menangani pasien dengan kondisi serupa, aku terpaksa mengatakan kalau waktunya sudah tidak lama lagi. Paling sisa beberapa hari saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "Ya, aku sudah tahu dari dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Kamu pewarisnya, betul? Kamu sangat menghormatinya. Tapi kamu juga punya pandangan sendiri, yang berbeda darinya. Kamu lebih peduli pada hal-hal di luar ranahnya, dan bisa lebih pragmatis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Jadi beri tahu aku bagaimana caranya menyelesaikan ini menurut pendapatmu. Ayo cari jalan agar urusan ini bisa kelar selagi Bamoun masih bernapas ... aku tahu itu penting sekali bagimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Iya. Jangan buang-buang waktu. Kamu tahu sendiri lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "Kalian berdua sedang berada dalam kondisi yang sama, yaitu memiliki pandangan yang jauh berbeda dari kedua sosok yang membesarkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "Betul. Dan situasi ini sebenarnya ulah mereka, tapi akhirnya malah kalian yang kebagian jatah memutuskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "Kamu benar. Kami melihat masalah ini dengan sudut pandang yang sangat berbeda dari pendahulu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Aku menerima tawaranmu, Cyno. Semua ini bermula dari Hermanubis, jadi, mari kita selesaikan dengan ritual yang dia ciptakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Dalam legenda, ketika Hermanubis pertama tiba di Tulaytullah, dia bertanding dengan penduduk kota. Dia dan kedua rekannya membuktikan diri selama berhari-hari, hingga akhirnya berhasil mendapat dukungan dari banyak orang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Para pendukung itulah yang di kemudian hari menjadi anggota-anggota pertama Temple of Silence. Pertandingan yang dilakukan para pendiri pun diabadikan sebagai Ritual Duel, memperingati saat ketika segalanya bermula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Pas sekali ya. Aku bersedia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "Kamu yang sesama wadah roh Hermanubis juga punya ikatan yang sangat mendalam dengan Temple of Silence. Aku akan mengizinkanmu mengikuti ritual ini bersama dengan rekan pilihanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Tiga lawan tiga. Adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Tapi aku punya persyaratan tambahan. Pihak penantang harus memenangkan semua pertandingan, dan yang jadi taruhan adalah pecahan \"Ba\" milikku dan milikmu, Cyno. Pemenang akan memperoleh keduanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Membiarkan Cyrus pergi membawa satu pecahan \"Ba\" adalah kesalahan. Kakek jatuh kasihan padanya. Masalah ini sudah menjadi persoalan utama yang wajib dibereskan jika Temple of Silence ingin melangkah maju. Tidak bisa kompromi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Dan tidak perlu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Kalau aku menang, Temple of Silence harus melepaskan Cyrus dan mengakhiri perselisihan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Kalau kamu menang, kekuatanku jadi milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Baiklah. Kita akan berhadapan di aula upacara besok jam delapan malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
