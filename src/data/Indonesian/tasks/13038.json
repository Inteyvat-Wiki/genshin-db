			},
			"dialogs": [
				{
					"id": 130380301,
					"content": "Hari ini kita berkumpul untuk mengadakan Ritual Duel. Hermanubis sang Sage segala Sage sedang melihat kita, kiranya kuasa dan hadiratnya ada di tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "Upacara ini adalah kudus, dan hadirin tidak diperkenankan untuk menyela. Saksikanlah duel yang berlangsung dengan sikap takut dan hormat dalam setiap prosesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Perwakilan Temple of Silence: para pembela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Kakek sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "*uhuk* Ritual Duel ... sudah lama sekali. Aku cukup terkejut dengan keputusan ini, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Kakek jangan khawatir, aku tahu apa yang kulakukan. Serahkan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Perwakilan Akademiya: para penantang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Bersiap. Pertarungan ini adalah perjuangan agar suara kita didengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Para pertarung, silakan bersiap di posisi masing-masing dan putuskan urutan pertandingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Kami tidak memperdebatkan alasan para penantang datang kemari, juga tidak mempertanyakan nasib apa yang akan menimpa pihak yang kalah. Kekuatan Hermanubis dipertaruhkan di tempat ini, bertarunglah hingga satu pihak keluar sebagai pemenang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Aku duluan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "Wah? Yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Yakin. Biar yang lain semangat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Setuju. {NICKNAME} sangat kuat, kalau dia yang turun duluan, lawan pasti terintimidasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Oke, setelahnya kamu yang maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Sudah diputuskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Kami juga sudah. Ayo mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
