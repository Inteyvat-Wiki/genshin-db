					}
				]
			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Yah, setelah yang tadi sih aku rasa sudah tidak bisa mundur ya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Tidak ada kata mundur. Aku sudah memantapkan pilihan sejak saat profesor kabur ke padang pasir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Kamu harus menang. Kekuatan ini masih diperlukan ... baik bagi Mahamatra Agung, maupun dirimu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "Iya! Lagian, kekuatan itu kan sudah nempel sama kamu sedari kecil, artinya dia juga suka kan sama kamu? Kamu nih pemiliknya yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "Untuk Mahamatra Agung ... dan untuk diriku sendiri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Ya, kalau mau bilang sih ... aku sudah berjuang mati-matian untuk menjinakkan kekuatan ini dan menguasainya. Tidak semua orang bisa, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Betul banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Jangan mikirin yang lain-lain dulu. Fokus menang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Ya. {NICKNAME} dan aku tidak akan kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "Aku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Padang pasir ini pernah menjadi rumah peradaban kuno dan besar, yang karena satu lain hal akhirnya memisahkan diri dari peradaban di hutan. Seperti yang Dehya pernah bilang, prasangka membuat hubungan jadi renggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Tapi pasti ada faktor pribadi juga. Aku ada firasat Bamoun punya kepentingan lain di luar ini, dan aku yakin bahwa Sethos bukan orang jahat. Dia cuma melakukan apa yang dia anggap baik dan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "Besok adalah hari penentuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Kami bantu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
