				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "Kalian berkumpul kembali di waktu yang sudah ditentukan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Aku sudah pikirkan. Aku yakin Profesor Cyrus berangkat ke padang pasir dengan sadar bahwa dia hampir pasti tidak akan pernah kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "Orangnya sangat keras kepala kalau menyangkut sesuatu yang dia anggap penting. Kita buang waktu kalau mau bujuk dia untuk kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Aku sependapat. Pak Naphis juga bilang gitu, begitu Cyrus sudah memutuskan, dia tidak akan dengar pendapat orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Mhm. Pertama itu. Lalu aku kepikiran beberapa hal lain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Kalian sudah tahu tentang Temple of Silence, jadi kurasa tidak usah ditambahkan apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Ingatanku akan tempat ini amat sangat kabur. Mungkin pengaruh dari pecahan \"Ba\" yang ada di dalam ya? Kalau iya, ini menjelaskan kenapa waktu kecil dulu aku sering sekali sakit kepala dan demam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Tapi aku samar-samar ingat perasaan ketika itu, dan kadang ada bayangan-bayangan yang muncul dalam benak. Aku tidak terlalu ingat jelas sih, hanya sepotong-sepotong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "Aku masih kecil, dan cuma tahu bahwa ada suatu kehendak yang teramat kuat bersemayam di dalam diriku. Kalau dilihat lagi sekarang, mungkin itu cara Hermanubis menyemangatiku, meski kami tidak bisa berkomunikasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Kekuatan yang tinggal di dalam diri ini adalah batu penjuru kepercayaan mereka. Jadi, kalau memang kehendak dan kekuatan Hermanubis itu nyata adanya, dan mereka ini adalah hamba-hambanya yang paling setia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Kamu mau turuti saja kemauan mereka, gitu? Masa sih tidak ada cara lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Jangan gegabah, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Tidak, aku bukan ingin menyerahkan kekuatan ini karena aku membutuhkannya untuk melindungi Sumeru. Namun Temple of Silence berhak memutuskan, karena mereka adalah salah satu dari tujuh pilar Raja Deshret ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Maka dari itu, aku akan menantang mereka untuk memperebutkan hak kepemilikan kekuatan ini, dengan jujur dan adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Hmm, aku jadi ingat omongan Alhaitham sebelum kita berangkat. Katanya Temple of Silence didirikan oleh para ningrat dan kaum kelas atas pada zamannya. Umumnya organisasi dengan latar belakang seperti itu sangat menjunjung tinggi kehormatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh juga pernah menyimpulkan hal yang sama setelah memperhatikan suku-suku padang pasir ketika dia bekerja di sini. Banyak dari mereka yang punya aturan sendiri, dan sering bicara mengenai pantangan mencemari ikatan kesukuan mereka atau melanggar perintah nenek moyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Mungkin kita bisa pakai sifat itu. Kita tawarkan sesuatu ke pihak mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Wah, keadaan bisa langsung berbalik nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Sepertinya gagasan kita sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Kita kembalikan bolanya ke lapangan mereka selagi bisa, dan kasih tawaran yang tidak bisa ditolak. Kita menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Boleh sih, aku suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Baiklah. Aku sudah tahu gimana cara membuka dialognya. Ayo kita cari si Sethos, bilang saja kalau aku paham satu dua hal mengenai pengobatan, dan bersedia untuk memeriksa kondisi kakeknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Pasti ada jalan lain!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
