			"dialogs": [
				{
					"id": 752440302,
					"content": "Betul sekali! Terima kasih banyak! Aku jauh lebih tenang kalau ada topi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "Sebenarnya topi ini adalah helm keselamatan yang kubuat khusus. Helm ini bahkan bisa menahan peluru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "Kamu kebanyakan mikir, ini cuma memancing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "Kamu pasti belum tahu ya, dulu ada orang yang memancing di tepi pantai. Dia ditembak oleh panah atau senjata dari jauh, sampai salah satu matanya buta. Benar-benar berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "Katanya ada bandit Nod-Krai yang bertikai di sana ... Tapi siapa yang tahu? Nah, karena sudah pernah ada kasusnya, jadi kita harus lebih hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
