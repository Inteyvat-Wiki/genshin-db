				{
					"id": 752440402,
					"content": "Masih mikirin para berandalan? Buat apa. Kalau misal ketemu di jalan pun, sebut saja namaku. Mereka tidak bakal berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "Tapi jangan tanya kenapa. Kita berdua ditakdirkan bertemu, kamu bahkan membantu mencarikan topiku. Anggap saja pengganti terima kasih.",
					"roleType": "TALK_ROLE_NPC",
