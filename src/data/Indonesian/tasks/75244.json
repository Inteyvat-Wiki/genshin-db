			"dialogs": [
				{
					"id": 752440101,
					"content": "Oh, hai, apa kamu ke sini untuk memancing juga? Nah, kamu perlu pakai topi yang kuat kalau mau tahu lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "Kenapa harus pakai topi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Tahu alasannya? Karena topi yang kuat akan membuatmu tetap aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Tapi kamu juga tidak pakai topi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "Inilah alasanku berbicara denganmu ... Jadi sebenarnya, topiku tertiup angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Kalau kamu tidak keberatan, apa kamu bisa membantuku mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "Kenapa tidak mencarinya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Kalau aku mau ambil topinya, aku harus taruh jorannya dulu. Kalau aku ambil jorannya, aku tidak bisa ambil topinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "Tolonglah, tolong bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
