					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "Kamu kelihatan lebih senang dibanding terakhir kali kita bertemu. Sepertinya latihannya lancar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020102,
					"content": "Hmm, aku sudah belajar banyak dari mengerjakan tugas-tugas ini. Sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020103,
					"content": "Apa aku layak memegang gelar Bloomguard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020104,
					"content": "Belum ... Masih ada latihan terakhir yang harus kuselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020105,
					"content": "Hanya sampai semua tugas diselesaikan dan aku mendapatkan pengakuanmu barulah \"Twin-Horned Chaplet\" bisa benar-benar menjadi milikku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020106,
					"content": "Oh? Ternyata benar. Masa-masa kamu di usia yang suka melawan otoritas sudah lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020107,
					"content": "Te-Tetua, kamu masih ingat itu? Kumohon lupakan saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020108,
					"content": "Haha. Tapi bagaimanapun, baguslah kalau kamu semangat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}, Paimon, awasilah Sorush sampai akhir apakah dia benar-benar layak mendapatkan Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020110,
					"content": "Aku akan menunggumu di garis akhir. Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
