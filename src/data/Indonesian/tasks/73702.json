			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "Lubang Tunigi ... ini pusat segala bencana. Walaupun tempatnya kelihatan tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020602,
					"content": "Tidak sulit memikirkan dulunya bagaimana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "Kristal di sini gede banget ... Lebih gede dari Wenut malahan! Enggak kebayang kalau Sorush yang harus beresin masalah di sini ke depannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020604,
					"content": "Bukankah ini tanggung jawab terpenting seorang Bloomguard? Lagi pula, Sorush sendiri juga menginginkan tugas ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020605,
					"content": "Katanya sih begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020606,
					"content": "Kamu tidak percaya? Hmph, aku tidak sangka Si Pucat Terbang begitu meremehkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020607,
					"content": "Widih, lihat tuh si Sorush mulai lupa daratan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020608,
					"content": "Bagus, atau jelek? Tidak yakin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "Hmph. Bagaimana kalian masih bisa meragukan keahlianku setelah semua yang kita lalui bersama? Kepercayaan diriku itu bukan omongan belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020610,
					"content": "Hmm. Sekadar informasi, aku sudah belajar dari kesalahanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020611,
					"content": "Dulunya aku lebih mementingkan reputasi daripada tindakan. Tapi aku sudah tahu sekarang kalau ini pada akhirnya adalah sesuatu yang tidak berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020612,
					"content": "Seperti Simurgh yang menjadi burung dewa dengan pengorbanannya, demikian pula aku akan menjadi Bloomguard melalui perbuatanku dan mendengar namaku dinyanyikan atas semua jasaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020613,
					"content": "Selain itu, aku sudah menyelesaikan semua pelatihan yang diberikan Tetua. Sekarang aku sudah layak menyandang gelar Bloomguard dan membawa Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020614,
					"content": "Tentu saja. Aku tidak keberatan dengan keputusan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020615,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020616,
					"content": "Kenapa? Kamu pikir aku keberatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020617,
					"content": "Bukan ... Aku cuma ... tidak menyangka Tetua setuju begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020618,
					"content": "Kukira setidaknya akan ada kata-kata pedas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "Ah, aku tidak sejahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020620,
					"content": "Mengenai tanggung jawab seorang Bloomguard ... Sebenarnya aku tidak dapat informasi apa-apa dari Chaplet ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020621,
					"content": "Apa karena aku masih kurang layak menyandang gelar Bloomguard? Apa pelatihanku belum cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020622,
					"content": "Ini ... Meski gelar Bloomguard bisa diwariskan, tanggung jawabnya selalu berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020623,
					"content": "Begitukah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020624,
					"content": "Singkatnya, tidak ada aturan khusus mengenai apa yang harus dilakukan ataupun standar penilaian. Biasanya keputusan akhir ada di tangan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020625,
					"content": "Hah? Jadi maksudmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020626,
					"content": "Aku tidak akan mengambil Twin-Horned Chaplet darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020627,
					"content": "Sekarang kamu tidak perlu khawatir kepalamu jadi dingin, deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "Bukan itu poinnya!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020633,
					"content": "Aku tahu! Ini pasti salah satu ujiannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020634,
					"content": "Sorush kayaknya dapat pencerahan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020635,
					"content": "Si Pucat Terbang ini pelupa sekali. Kan baru saja kubilang tadi! Untuk melewati pelatihan ini, selain kompetensi dan pengamatan yang tajam, yang paling penting adalah menyadari kesalahan yang dilakukan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020636,
					"content": "Bahkan kalau hasilnya sudah ditentukan, kalau aku kesampingkan semua yang sudah kupelajari selama latihan ini, bukannya itu berarti aku mengulang kesalahanku lagi? Aku yakin ini pasti ujian terakhir dari Tetua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020637,
					"content": "Bagi Bloomguard yang layak, ini adalah tugas yang mudah. Ini adalah bukti kepercayaan penuh Tetua padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020638,
					"content": "Aku tidak menyangka kamu bisa menebaknya. Khvarena memilih dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020639,
					"content": "#Tapi perubahanmu ... Kurasa juga berkat {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020640,
					"content": "Tentu saja! Yasnapati-ku dan Si Pucat Terbang adalah orang-orang yang berbakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020641,
					"content": "Walaupun aku mau bilang kalau aku cukup kuat sendiri ... tapi aku percaya dengan bantuan mereka, memadamkan Tanda Apaosha akan jadi jauh lebih gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020642,
					"content": "Bisa diandalkan sekali, ya. Jangan lupa kalau Mihir dan Rashnu juga bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020643,
					"content": "Jangan khawatir, Tetua! Serahkan padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020644,
					"content": "Paimon curiga ini rencana besar Zurvan ... Tapi lihat Sorush senang begini, Paimon juga enggak bisa komplain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020629,
					"content": "Tidak mau atau tidak bisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "Keputusan Khvarena itu final, seperti yang dibilang Zurvan. Berarti Zurvan juga enggak bisa ubah seenaknya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020631,
					"content": "Oh, ho ho ... Kamu yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020632,
					"content": "Widih ... Kok seram ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				}
			]
		},
