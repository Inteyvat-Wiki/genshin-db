				{
					"id": 737020702,
					"content": "Wah! Paimon enggak nyangka Sorush benar-benar bisa padamkan Tanda Apaosha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020703,
					"content": "Memadamkan Tanda Apaosha adalah tugas seorang Bloomguard. Sorush hanya melaksanakan tanggung jawabnya saja",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020704,
					"content": "Ini semua berkat bantuan Mihir dan Rashnu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "Betul. Kontribusi kita juga enggak kalah banyaknya, loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020706,
					"content": "Ah, sebut Yasnapati dan si Pucat Terbang, kesampingkan saja lakon utamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020707,
					"content": "Widih, lihat tuh si Sorush mulai lupa daratan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020708,
					"content": "Hmph. Bagaimana kalian masih bisa meragukan keahlianku setelah semua yang kita lalui bersama? Kepercayaan diriku itu bukan omongan belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020709,
					"content": "Hmm. Sekadar informasi, aku sudah belajar dari kesalahanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020710,
					"content": "Dulunya aku lebih mementingkan reputasi daripada tindakan. Tapi aku sudah tahu sekarang kalau ini pada akhirnya adalah sesuatu yang tidak berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020711,
					"content": "Seperti Simurgh yang menjadi burung dewa dengan pengorbanannya, demikian pula aku akan menjadi Bloomguard melalui perbuatanku dan mendengar namaku dinyanyikan atas semua jasaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020712,
					"content": "Selain itu, aku sudah menyelesaikan semua pelatihan yang diberikan Tetua. Sekarang aku sudah layak menyandang gelar Bloomguard dan membawa Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020713,
					"content": "Tentu saja. Aku tidak keberatan dengan keputusan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020714,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020715,
					"content": "Kenapa? Kamu pikir aku keberatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020716,
					"content": "Bukan ... Aku cuma ... tidak menyangka Tetua setuju begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020717,
					"content": "Kukira setidaknya akan ada kata-kata pedas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "Ah, aku tidak sejahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020719,
					"content": "Mengenai tanggung jawab seorang Bloomguard ... Sebenarnya aku tidak dapat informasi apa-apa dari Chaplet ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020720,
					"content": "Apa karena aku masih kurang layak menyandang gelar Bloomguard? Apa pelatihanku belum cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020721,
					"content": "Ini ... Meski gelar Bloomguard bisa diwariskan, tanggung jawabnya selalu berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020722,
					"content": "Begitukah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020723,
					"content": "Singkatnya, tidak ada aturan khusus mengenai apa yang harus dilakukan ataupun standar penilaian. Biasanya keputusan akhir ada di tangan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020724,
					"content": "Hah? Jadi maksudmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020725,
					"content": "Aku tidak akan mengambil Twin-Horned Chaplet darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020726,
					"content": "Sekarang kamu tidak perlu khawatir kepalamu jadi dingin, deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "Bukan itu poinnya!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020732,
					"content": "Aku tahu! Ini pasti salah satu ujiannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020733,
					"content": "Sorush kayaknya dapat pencerahan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020734,
					"content": "Si Pucat Terbang ini pelupa sekali. Kan baru saja kubilang tadi! Untuk melewati pelatihan ini, selain kompetensi dan pengamatan yang tajam, yang paling penting adalah menyadari kesalahan yang dilakukan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020735,
					"content": "Bahkan kalau hasilnya sudah ditentukan, kalau aku kesampingkan semua yang sudah kupelajari selama latihan ini, bukannya itu berarti aku mengulang kesalahanku lagi? Aku yakin ini pasti ujian terakhir dari Tetua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020736,
					"content": "Bagi Bloomguard yang layak, ini adalah tugas yang mudah. Ini adalah bukti kepercayaan penuh Tetua padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020737,
					"content": "Aku tidak menyangka kamu bisa menebaknya. Khvarena memilih dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020738,
					"content": "#Tapi perubahanmu ... Kurasa juga berkat {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020739,
					"content": "Tentu saja! Yasnapati-ku dan Si Pucat Terbang adalah orang-orang yang berbakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020740,
					"content": "Walaupun aku mau bilang kalau aku cukup kuat sendiri ... Aku tahu aku cuma bisa memadamkan Tanda Apaosha berkat bantuan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020741,
					"content": "Aku tidak menyangka Sorush bisa jadi begitu bertanggung jawab dalam waktu sesingkat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020742,
					"content": "Tentu saja! Selama itu adalah tanggung jawabku, Tetua bisa serahkan padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020743,
					"content": "Paimon curiga ini rencana besar Zurvan ... Tapi lihat Sorush senang begini, Paimon juga enggak bisa komplain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020728,
					"content": "Tidak mau atau tidak bisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "Keputusan Khvarena itu final, seperti yang dibilang Zurvan. Berarti Zurvan juga enggak bisa ubah seenaknya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020730,
					"content": "Oh, ho ho ... Kamu yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020731,
					"content": "Widih ... Kok seram ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}