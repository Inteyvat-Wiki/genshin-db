			"dialogs": [
				{
					"id": 741660401,
					"content": "Ini Kantin Bersama, dan tiap orang boleh mengambil 1 makanan gratis tiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660402,
					"content": "Masalahnya, makanan yang akan kamu dapat semua tergantung pada nasib.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660403,
					"content": "Hmm, gitu doang? Ini sih semua orang juga waktu hari pertama langsung diajarin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Tenang, tenang, aku punya informasi rahasia juga. Katanya ada kode rahasia yang bisa kamu katakan pada Bran waktu ambil makanan gratis, nanti kamu bakal dapat makanan misterius legendaris!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660405,
					"content": "Oh, masa? Kode apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Sayangnya, aku tidak tahu. Soal kodenya, kutunggu hari di mana kamu berhasil menemukan kodenya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660407,
					"content": "Loh itu kan harusnya kata-kata Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Tidak perlu khawatir soal detail remeh begitu! Pemberhentian berikutnya adalah Teater Tri-Coupon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orang Aneh"
				}
			]
		},
