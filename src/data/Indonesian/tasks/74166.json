						741660602
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660602,
					"content": "Tempat ini enggak ada gosip aneh-aneh, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "Tidak ada sih. Tapi aku benci sama tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660604,
					"content": "Oh? Kenapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660606,
					"content": "Karena ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Karena aku tidak mau kerja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660608,
					"content": "Aku di sini karena tidak mau kerja, jadi aku curi sepotong roti dan aku makan sendiri karena aku lapar, terus aku dinyatakan bersalah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660609,
					"content": "Jadi kenapa di Benteng Meropide juga masih harus kerja sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660610,
					"content": "\"Kerja sebentar saja pasti aku pingsan!\" Itu moto hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660611,
					"content": "Duh! Ada di sini saja sudah cukup bikin dia jadi orang aneh, yuk kita pergi deh, langsung ke tempat berikutnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
