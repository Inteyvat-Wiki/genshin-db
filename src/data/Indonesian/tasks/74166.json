			"dialogs": [
				{
					"id": 741660301,
					"content": "Gimana? Sudah ada keputusannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660302,
					"content": "Kan kamu sendiri yang bilang bakal gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Iya, tentu, bakal \"gratis\" kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660304,
					"content": "Oke yuk, sekarang akan kuperkenalkan isi dari Benteng Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orang Aneh"
				}
			]
		},
