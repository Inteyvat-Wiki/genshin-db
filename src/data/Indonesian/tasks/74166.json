			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "Permisi, anak muda di sebelah sana, iya, kamu! Kamu yang di sana, coba ke sini sebentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660202,
					"content": "Hah? Kamu ngomong sama kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "Oh, teman, begitu lihat aku langsung tahu kalau kamu orang baru di sini. Kamu pasti masih belum familier sama Benteng Meropide, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660204,
					"content": "Kalian beruntung bertemu aku hari ini! Aku satu-satunya orang paling baik di benteng ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660205,
					"content": "Hari ini, izinkan aku memperkenalkan kalian dengan Benteng ini. Tentu saja, \"gratis\" kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660206,
					"content": "Eh sebenarnya, aku sudah cukup familier sama tempat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Oh, jangan bilang gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660208,
					"content": "Mungkin kamu merasa sudah familier, tapi di bawah bimbinganku, aku yakin kamu akan menemukan hal-hal baru yang tidak kamu tahu sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660209,
					"content": "Oh memangnya ada yang namanya makan siang gratis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Iya dong! Seperti yang kubilang tadi, aku ini orang paling baik di Benteng ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660211,
					"content": "Heh, orang ini aneh banget. Baru ketemu sudah sok kenal sok dekat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Haha, teman, jangan dipikirkan! Gimana kalau, kalian berdua diskusi dulu sendiri, dan aku akan tunggu di sini untuk mendengar keputusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660213,
					"content": "Nanti saat kamu sudah memutuskan, cari saja aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orang Aneh"
				}
			]
		},
