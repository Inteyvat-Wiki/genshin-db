			"dialogs": [
				{
					"id": 741660501,
					"content": "Ini lokasi Teater Tri-Coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660502,
					"content": "Hah? Jadi cuma itu doang pendahuluannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Memang kamu tidak paham? Kalau ada teater, ada drama! Ada drama, ada adegan romantis! Ada adegan romantis, ada cinta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660504,
					"content": "Katanya selama kamu datang ke sini dan menonton pertunjukan mereka tiap hari, kamu akan menemukan cinta sejatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660505,
					"content": "Yakin ada gosip kayak gitu? Kalau gitu harusnya semua orang kumpul di sini dong tiap hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Iya benar kok, tapi kalau mau jadi kenyataan, kamu tidak boleh jadi tahanan atau penjaga Benteng Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660507,
					"content": "Jadi seorang pun tidak akan pernah bisa bertemu cinta sejatinya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Mungkin itu masalah utamanya. Ya sudah lah, yuk kita lanjut dulu ke pemberhentian kita berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orang Aneh"
				}
			]
		},
