			"dialogs": [
				{
					"id": 741660701,
					"content": "Oke, teman-teman sekalian! Kita akhirnya tiba di tempat favoritku: Ring Pankration! Tempat ini favorit kita semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660702,
					"content": "Tempat ini ... memang semenarik itu? Kok beda sih sama yang Paimon dengar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Iya dong, tapi kamu tidak usah dengar gosip yang beredar. Itu cuma buat menipu orang lain saja. Ayo sini, aku punya surat persetujuan di sini, asalkan kamu mau tanda tangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660704,
					"content": "Hei! Kamu lagi-lagi begitu ya! Menipu orang buat tanda tangan kontrak untuk kompetisi, ya kan? Kamu tidak bisa kabur kali ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Penjaga"
				},
				{
					"id": 741660705,
					"content": "Kalian berdua cukup beruntung karena aku langsung sadar sebelum kalian berdua tanda tangan formulir itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Penjaga"
				},
				{
					"id": 741660706,
					"content": "Pokoknya, jangan pedulikan penipu ini. Dia dan orang-orang di organisasi yang ada di belakangnya sudah biasa menipu orang ke kompetisi berbahaya, dan mereka dapat untung dari situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Penjaga"
				},
				{
					"id": 741660707,
					"content": "Jangan ngarang deh! Aku tidak pernah menipu siapa pun! Mereka semua temanku, dan mereka tanda tangan sukarela setelah aku rekomendasikan itu ke mereka, sebagai teman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Orang Aneh"
				},
				{
					"id": 741660708,
					"content": "Iya deh iya. Aku yakin aku punya tempat yang lebih baik untuk kamu bicara omong kosong begitu. Ayo sini ikut aku sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Penjaga"
				},
				{
					"id": 741660709,
					"content": "Orang aneh itu dibawa oleh penjaga ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741660710
					]
				},
				{
					"id": 741660710,
					"content": "Fyuh ... jadi memang tidak ada yang namanya makan siang gratis ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
