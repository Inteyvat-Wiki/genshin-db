					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Aku ingat sebelumnya, aku memesan salinan buku \"Kitab Keseimbangan\" kepada Wanwen Bookhouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Paman Tian"
				},
				{
					"id": 718050504,
					"content": "Benar, ini adalah buku yang aku minta, dan akhirnya dikirimkan. Hehe, aku pikir ada terlalu banyak tamu, dan Jifang lupa tentang buku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Paman Tian"
				},
				{
					"id": 718050505,
					"content": "Jika sudah dikirimkan baguslah, kemasannya bagus sekali, Jifang pasti memikirkannya dengan baik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Paman Tian"
				},
				{
					"id": 718050506,
					"content": "Terima kasih banyak anak muda, akan kuterima buku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paman Tian"
				}
			]
