					"content": "Anak muda, ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050402,
					"content": "Ini adalah buku yang diberikan Jifang padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Ini adalah buku \"Penyamaran Rex (IV)\"? Aku ingat, sudah lama sekali aku memesan buku ini. Kenapa lama sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050404,
					"content": "Coba kulihat... Hah? Ini adalah edisi pertama, tidak heran baru sekarang dikirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050405,
					"content": "Kupikir karena terlalu banyak tamu, Jifang telah melupakan buku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050406,
					"content": "Buku ini akan kuterima, terima kasih banyak, anak muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gentry De'an"
				}
			]
		},
