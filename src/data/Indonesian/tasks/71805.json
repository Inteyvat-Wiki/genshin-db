						718050603
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050603,
					"content": "Aku sudah mengirimkan semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Terima kasih banyak, Wanwen Boohouse dapat berdiri hingga sekarang, itu semua berkat dukungan dari para pelanggan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "Apalagi pelanggan lama ini juga orang yang sangat menyukai buku. Mereka seharusnya sangat senang jika bisa mendapatkan buku yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "Pengembara, terima kasih telah membantuku, ini imbalan untuk terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050607,
					"content": "Jika di masa mendatang ingin membeli buku, kamu bisa mencariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
