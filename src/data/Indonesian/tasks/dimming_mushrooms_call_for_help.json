			"dialogs": [
				{
					"id": 710610401,
					"content": "#Terpujilah {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Meskipun tidak nyaman, tapi biarkan Xamaran bicara terus terang, seperti ungkapan milik para kaki dua: \"Menolong orang harus sampai tuntas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Mau minta tolong apa lagi nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Memangnya pepatah manusia berlaku buat jamur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "Kamu memang layak disebut Yang Bijaksana dari antara kaki dua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "Baik jamur maupun orang sama-sama menerima berkat dari tanah ini. Semua makhluk saling bahu-membahu, itulah yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Tolong jangan menolak dan terimalah Berkah Kebijaksanaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Kamu menerima Berkah Kebijaksanaan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Wah, apaan lagi ini, kelihatannya mencurigakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Di sini masih ada hawa jahat. Xamaran bisa merasakannya, tapi tidak tahu dari mana sumbernya. Ikuti jalur air dan kalian akan menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}, pakailah Berkah Kebijaksanaan untuk menghadapi sumber kejahatan, dan kaum Xamaran akan mengurus sisanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "Memang benar, kita tidak boleh mengabaikan sumber hawa jahatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "Kenapa bukan kamu saja sih yang urus sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME} jauh lebih kocak daripada Paimon. Xamaran tidak punya kaki, {NICKNAME} punya. Tugas makhluk berkaki harus dilakukan oleh makhluk berkaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Xamaran masih punya tugas yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Tugas yang lebih penting?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#Terlalu banyak energi sudah dihabiskan kali ini, tapi Xamaran senang sekali bisa mengobrol dengan {NICKNAME} dan Paimon. Xamaran harus istirahat dan memulihkan kekuatan untuk melawan hawa jahat, untuk dapat menaungi kaumnya dan berjaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#Semoga {NICKNAME} dan Paimon aman sentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "Hei, Jamur Besar Kepala! WOI, BANGUN!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, kayaknya si Jamur Besar Kepala beneran tidur. Ya sudah, kita berangkat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ugh, dari mana datangnya lumpur hitam ini? Apa ini \"hawa jahat\" yang si Jamur Besar Kepala bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
