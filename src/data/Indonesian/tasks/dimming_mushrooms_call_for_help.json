				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610201,
					"content": "Kamu membagi energi Adjuvant untuk Xamaran",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Waw, si Jamur Besar Kepala jadi nyala! Waduh, namanya mesti Paimon tambahin \"botak cemerlang\" gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#Terpujilah {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#Berkat {NICKNAME} dan Paimon, Xamaran bisa mendapatkan kembali cahaya kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Tapi jangan lengah, Xamaran yakin kalau sumber hawa jahat belum musnah, dan bisa datang mengusik kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Huh, jadi bagusnya kita gimana dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ugh, dari mana datangnya lumpur hitam ini? Apa ini \"hawa jahat\" yang si Jamur Besar Kepala bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
