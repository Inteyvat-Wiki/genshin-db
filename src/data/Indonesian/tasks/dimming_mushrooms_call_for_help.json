						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Terpujilah {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Lama tidak ada yang menyahuti panggilan Xamaran. Jangankan yang berkaki banyak dan berkaki empat, yang berkaki dua pun seperti tuli terhadap teriakan minta tolong Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Hanya orang yang benar-benar bijaksana yang akan menjawab. Paimon bijaksana, {NICKNAME} juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "Yang terbaik di antara yang berkaki dua layak mendapatkan ucapan terima kasih dari Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Hmm, Paimon si Bijaksana ini jelas enggak boleh diremehkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Gampang saja kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Xamaran yakin pada waktunya nanti, {NICKNAME} dan Paimon bisa menjadi keberadaan yang setara dengan Xamaran dan kaumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Tunggu, apa maksudmu, Jamur Besar Kepala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "Yang berkaki banyak tidak sebaik yang berkaki empat, yang berkaki empat tidak sebaik yang berkaki dua, dan yang berkaki dua tidak sebaik yang tidak berkaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#Meskipun {NICKNAME} dan Paimon terlahir dengan kekurangan, tapi asalkan ada kemauan, usaha untuk mengubah takdir pasti tidak akan mengkhianati hasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Jamur botak cemerlang ini benar-benar besar kepala ya! Paimon jadi kepikiran, kamu enak enggak ya kalau dimasak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Jadikan Chicken-Mushroom Skewer saja, kelihatannya menarik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Dasar kau jamur beracun, baru kenal eh, sudah bisa nipu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Nafsu makan Paimon besar. Hari ini makan jamur, besok makan jamur, ratusan hari ke depan juga makan jamur, tahu-tahu nanti dalamnya Paimon sudah bukan Paimon lagi, tapi jamur semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Astaga, {NICKNAME}, si Jamur Besar Kepala ini ngomongnya ngeri juga yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Ah, Paimon kurang mengerti humor rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "Heh, omongan tadi belah mananya yang lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran sudah terbebas dari hawa jahat, tapi kaumnya masih menderita. Xamaran yang kini terlalu lemah untuk melindungi mereka yang lemah seperti zaman dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Xamaran mohon kepada {NICKNAME}, berbelas kasihlah dan selamatkan mereka yang lemah, yang tidak mampu menyelamatkan dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Jadi, masih ada jamur-jamur kecil yang sakit di luar sana? {NICKNAME}, mau tolongin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Yah, sudah sejauh ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Ya boleh, sekalian lewat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Ya sudah ayo cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ugh, dari mana datangnya lumpur hitam ini? Apa ini \"hawa jahat\" yang si Jamur Besar Kepala bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
