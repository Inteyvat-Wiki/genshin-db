			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Sepertinya ini tidak ada gunanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Permisi, apakah kamu melihat sebuah kotak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Kotak? Ya, aku menemukan sebuah kotak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "Aku sudah membukanya, dan isinya berkas-berkas tagihan, sepertinya seseorang sedang melakukan bisnis yang sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Aku ingin tahu berapa banyak uang yang rela dikeluarkan oleh pemilik kotak ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "...Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Jangan panik, aku hanya bercanda denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "Nilai barang yang tertulis di tagihan-tagihan tersebut tidaklah kecil, tapi aku juga tidak tahu siapa bos besar di Liyue pemilik bisnis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "Aku sama sekali bukan orang jahat, aku tahu ini sangat berharga, dan tidak ada alasan untukku mempersulitnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Tapi, apa kamu tidak mempertimbangkan untuk memberikanku sedikit imbalan setelah aku bersusah payah menjaga barang ini dengan baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Bagaimana kalau kita barter saja? Ini adalah cara paling umum dalam menyelesaikan masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Berikan aku 3 Noctilucous Jade, dan aku akan memberikan semua tagihan ini padamu. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Lagi pula, 3 Noctilucous Jade tidak sebanding dengan barang yang ada di dalam tagihan-tagihan tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Kalau begitu, cepat kamu pergi mencarikannya. Setelah kamu mendapatkannya, kita akan barter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "... Sebenarnya transaksi apa yang tertulis di sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Kamu tidak tahu? Jadi kamu ke sini untuk membantu pekerjaan orang lain... Yah, itu tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Biarkan aku memberimu saran, sebaiknya kamu tidak bertanya terlalu banyak tentang transaksi besar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "Segera dapatkan Noctilucous Jade itu dan aku akan memberimu tagihannya. Lalu kamu bisa mengembalikannya ke orang yang meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Semuanya akan berjalan sesuai rencana, tanpa ada masalah sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
