			},
			"dialogs": [
				{
					"id": 210240901,
					"content": "Apakah kamu sudah menemukan tagihan-tagihannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Aku sudah menemukannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Terima kasih, aku benar-benar berterima kasih padamu! Aku lega tidak ada masalah yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Kalau semua tagihan ini hilang, aku tidak bisa membayangkan akan semarah apa bos nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Kamu pasti ingin bertanya \"sebenarnya tagihan apa ini\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Maaf, tapi aku benar-benar tidak bisa memberi tahumu, ini rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Ini adalah sedikit imbalan untukmu, ambilllah. Tunggu dulu, kotak ini sudah dibuka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "... Orang yang menemukan kotak ini sudah membukanya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Gawat, gawat, gawat! Aku harus segera memberi tahu bos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Oh, jangan khawatir, aku tidak akan mencurigaimu. Lagi pula tentang perbuatanmu, aku sudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Ehem. Aku akan mencari cara menghubungi bos, kamu bisa pergi dan mengurus urusanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
