				{
					"id": 4610513,
					"content": "Hmm, begini... kami datang untuk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610502
					]
				},
				{
					"id": 4610502,
					"content": "Tidak, kami hanya ingin bertanya, di manakah Arcadia Ruins berada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610503,
					"content": "... Arcadia Ruins? Ternyata, masih ada saja tempat yang aku belum pernah dengar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610504,
					"content": "Bahkan Tuan Stanley saja tidak tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610505,
					"content": "Sudahlah, lupakan tentang Arcadia... Yang kamu harus tahu adalah kisahku waktu aku bertualang di Ashen Sea dan Geyser Realm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610506,
					"content": "Kami tidak punya waktu untuk mendengar ceritamu. Tolong pikirkan lagi, kami membutuhkan petunjuk tersebut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610507,
					"content": "Ashen Sea... adalah tempat yang dikuasai kematian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610508,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610509,
					"content": "Sesudah kita menemukan <color=#00E1FFFF>harta karun</color> tersebut di Arcadia, Paimon yakin kisah \"Harta Terpendam Arcadia\" ini pasti akan jauh lebih seru dari ceritamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610510,
					"content": "(Oke, dan dia sekarang yang mengatakannya sendiri...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
					"id": 4610511,
					"content": "Kisah? Harta... terpendam?",
					"roleType": "TALK_ROLE_NPC",
