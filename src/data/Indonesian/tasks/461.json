						4610602
					]
				},
				{
					"id": 4610602,
					"content": "Hai juga! Apa kamu tahu informasi tentang Arcadia Ruins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610603,
					"content": "Arcadia... sepertinya aku pertama kali dengar. Maaf, aku baru bergabung di sini, jadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610604,
					"content": "Begitu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610605,
					"content": "Tapi kamu bisa coba untuk memasang permintaan misi, siapa tahu ada pengembara berpengalaman lainnya yang bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610606,
					"content": "Tidak tidak tidak, tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610607,
					"content": "Kalau begitu, bisa-bisa mereka dulu yang mendapatkan harta karunnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
