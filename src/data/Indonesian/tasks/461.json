						4610802
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610802,
					"content": "Uhm... kami sudah mencari info di Adventurers' Guild, dan hasilnya... nihil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610803,
					"content": "Haha, tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610804
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610804,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610805,
					"content": "Tidak apa-apa, maksudku, harta yang mudah ditemukan, tentunya bukan harta yang berharga, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610806,
					"content": "Oh, dan aku baru mendapatkan petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610807,
					"content": "Aku mengirim seseorang ke pusat perdagangan intel rahasia... Sepertinya dia berhasil menemukan seseorang yang tahu tentang Arcadia Ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610808,
					"content": "Benarkah?! Di mana orang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610809,
					"content": "Tenang, tenang. Sesuai peraturan perdagangan intel, mereka akan mengirim seseorang untuk bertemu dengan kita, untuk menjaga kerahasiaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610810,
					"content": "Orang itu, akan bertemu dengan kita di Whispering Woods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610811,
					"content": "Kalau begitu, tunggu apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610812,
					"content": "Tapi, sebaiknya Kaeya tidak menemui orang itu secara langsung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "Benar! Kamu membaca pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610814,
					"content": "Bagaimanapun, aku seorang Knight... dan tidak seharusnya membeli intel dari tempat seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610816,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610817,
					"content": "Tentunya... tidak ada yang perlu kalian khawatirkan dengan biayanya. Itu urusan kami para Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610818,
					"content": "Hehe, baiklah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610815,
					"content": "Biar kami yang pergi menemuinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
			]
