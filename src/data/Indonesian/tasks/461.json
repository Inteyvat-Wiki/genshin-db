			"dialogs": [
				{
					"id": 4610404,
					"content": "Huh, kita bukan datang untuk hal sesepele itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610405,
					"content": "Kami datang untuk mencari pedang terkuat, yang bisa membunuh seekor hydra berambut perak, dan siluman berkepala delapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610407,
					"content": "Hydra berkepala delapan, dan siluman berambut perak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "Kamu sudah membocorkan terlalu banyak informasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "Pedang yang paling, paling kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610408,
					"content": "Ah, pokoknya begitu! Pokoknya, pedangnya kuat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610409,
					"content": "Yang penting Paimon tidak memberi tahukan mereka di mana lokasi harta karun itu berada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610411,
					"content": "Ah tidak apa-apa, asal mereka tidak tahu di mana lokasi harta itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610413,
					"content": "(Oke, dan dia sekarang yang mengatakannya sendiri...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "Tuan Cyrus, apa kamu tahu di manakah \"Arcadia Ruins\" itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610414,
					"content": "Arcadia Ruins... aku tidak pernah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610415,
					"content": "Tapi terima kasih sudah berbagi informasi. Kalau kalian menemukannya, jangan lupa untuk menunjukkannya kepadaku .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610416,
					"content": "Eh? Berbagi... informasi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
