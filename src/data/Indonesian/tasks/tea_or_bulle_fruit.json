			"dialogs": [
				{
					"id": 761870301,
					"content": "Atas nama Nona Mamere, aku menerima undanganmu dengan penuh rasa terima kasih, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mmhmm, makanan ini enak sekali. Terima kasih, Sandrone. Kemampuan masakmu memang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870303,
					"content": "Senang deh dengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870304,
					"content": "Tapi Prototipe 4ACV07, kayaknya ini pertama kalinya kita bertemu ya? Kok kamu bisa kenal aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870305,
					"content": "Wah, ini pertama kalinya aku dengar ada yang manggil Seymour kayak gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870306,
					"content": "Benar. Meskipun aku sudah familier dengan kelembutan dan auramu, aku belum pernah melihatmu secara langsung sebelumnya, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Aku bisa mengenalimu karena penampilanmu sesuai dengan pemilikku, Nona Mary-Ann Guillotin, dia sudah terekam permanen dalam unit memoriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Nona Mary-Ann sudah bercerita tentangmu padaku. Karena penampilanmu sama dengan pemilikku, penalaran logis yang diperlukan untuk mengenalimu cukup sederhana, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, bahkan karya awal Alain sudah begitu mengesankan. Meskipun sepertinya kamu sudah mengalami peningkatan ... Jadi kurasa aku panggil kamu Seymour saja sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870310,
					"content": "Apakah kamu bingung saat melihatku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870311,
					"content": "Negatif. Perintah utamaku adalah untuk menemani dan melindungi Nona menggantikan Alain Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Dengan demikian, pengetahuanku tentang Nona Mary-Ann sudah lengkap. Berdasarkan analisis logis ruang vektor dimensi terbatas, kamu dan Nona Mary-Ann sangatlah berbeda, Nona Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Seperti perbedaan antara daun teh Lembah Chenyu dan Bulle Fruit dari Beryl Region.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Jadi Sandrone itu teh atau Bulle Fruit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870315,
					"content": "Sedang mencari ... Data tidak mencukupi. Tidak dapat menjawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*huff* ... Syukurlah Alain sudah menyempurnakan desain modul bahasanya waktu ciptakan aku.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
