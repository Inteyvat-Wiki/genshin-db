						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Reruntuhan itu mulai dekat. Ayo kita mulai penyelidikan dari sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Ada bangunan berarti dulunya ... ada orang. Kalau ada orang, pasti ada tulisan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "Dan kalau ada tulisan dan kertas, maka pasti ada petunjuk-petunjuk yang tidak bisa dibaca.",
