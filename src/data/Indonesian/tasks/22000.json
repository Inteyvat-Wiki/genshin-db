				"points": []
			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "Bagaimana cara kita bermain hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000102,
					"content": "Huh, kalau tidak ada yang mau menjadi bajak laut, kita tidak akan bisa bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000103,
					"content": "Tapi tidak ada yang bersedia menjadi bajak laut. Apa yang harus kita lakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000104,
					"content": "Kalian sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Kami ingin memainkan sebuah permainan, tapi tidak ada yang mau menjadi bajak laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000106,
					"content": "Karena tidak ada yang mau menjadi bajak laut yang bertugas merampok, kami tidak bisa memulai permainannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000107,
					"content": "Oh iya, bagaimana kalau kakak berpura-pura jadi bajak laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000108,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Hore! Baiklah, ayo kita bersiap-siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000115,
					"content": "Kalau sudah siap, bergabunglah kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000110,
					"content": "Aku tidak begitu mengerti permainan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Mudah dimengerti, kok! Bajak laut adalah orang jahat yang tidak taat aturan dan merebut barang milik orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000112,
					"content": "Tapi aku juga belum melihat bajak laut yang asli. Aku hanya mendengar tentangnya dari kakak Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000113,
					"content": "Tapi menurutku bajak laut mudah diperankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000114,
					"content": "Hehe, aku yakin kakak bisa melakukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
