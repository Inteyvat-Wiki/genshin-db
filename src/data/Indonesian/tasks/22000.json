			"dialogs": [
				{
					"id": 220000501,
					"content": "Sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000502,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Cepatlah. Ini adalah kesempatan untuk memperlihatkan kebaikan hati kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000504,
					"content": "Hei, apa bersih-bersih bisa langsung mengubahmu menjadi orang baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000505,
					"content": "Orang baik adalah orang yang bersedia melakukan hal baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000506,
					"content": "Kedengarannya mudah sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000507,
					"content": "Melakukan hal baik, adalah orang baik. Melakukan hal buruk, adalah orang jahat. Semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000508,
					"content": "Huh, kalau memang semudah itu, mengapa masih ada begitu banyak orang jahat di dunia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000509,
					"content": "Karena segala sesuatu di dunia lebih mudah diucapkan daripada dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000510,
					"content": "Melakukan hal-hal buruk masih lebih mudah daripada melakukan hal-hal baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000511,
					"content": "Kakak Beidou yang mengajarimu hal ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000512,
					"content": "Tidak, aku membacanya dari buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
