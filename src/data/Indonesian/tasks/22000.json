			"dialogs": [
				{
					"id": 220000301,
					"content": "Sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Hore! Terima kasih, ini untukmu. Senang sekali bermain bersamamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000304,
					"content": "Dan ingat — jangan berhenti menjadi orang baik ya, biasakan dalam hidupmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000305,
					"content": "Hei, kapan giliranku menjadi kapten kapal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000306,
					"content": "Lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000307,
					"content": "Huh, kamu juga mengatakan seperti itu sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Fei"
				}
			]
		},
