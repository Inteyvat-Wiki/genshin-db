			"dialogs": [
				{
					"id": 220000201,
					"content": "Sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Ayo kita mulai permainannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000203,
					"content": "Mulai dari mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000204,
					"content": "Anu, aku mau merampok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Aduh! Bajak laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220000206,
					"content": "Jangan cemas, Little Lulu! Aku akan melindungimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000207,
					"content": "Kamu pasti bajak laut. Kenapa kamu merampok kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000208,
					"content": "Karena aku adalah bajak laut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Ada bajak laut yang jahat dan ada juga yang baik hati. Tidak semua bajak laut harus merampok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000211,
					"content": "Kakak Beidou juga mengatakan kalau dirinya adalah bajak laut. Tapi dia adalah bajak laut yang baik hati. Dia sering memberiku makanan enak. Semua orang menyukainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000212,
					"content": "Kenapa kakak harus menjadi bajak laut yang jahat? Kenapa tidak menjadi bajak laut yang baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000213,
					"content": "Jelas-jelas tadi kamu bilang bajak laut adalah orang yang tidak taat aturan dan merebut barang milik orang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Baiklah, ini salahku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Bagus sekali! Bersedia berubah adalah langkah pertama menjadi orang yang lebih baik. Itulah apa yang kakak Beidou katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000217,
					"content": "Langkah berikutnya adalah membersihkan tempat ini. Selama kakak melakukan hal yang baik, maka kakak bisa menjadi orang baik, atau bahkan bajak laut yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000215,
					"content": "Aku ingin menjadi orang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Bajak laut memang harus merampok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
