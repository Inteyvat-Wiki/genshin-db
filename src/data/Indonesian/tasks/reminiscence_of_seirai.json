					"Furuya Noboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Hmm, benar-benar membuat pusing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Apa kamu tahu sesuatu tentang gambar ini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Bentuk lahan di gambar ini terlihat seperti suatu tempat di Pulau Seirai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Kamu tahu dari mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "Dulu Adventurer's Guild sudah pernah membuka beberapa ekspedisi ke Pulau Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Para petualang yang menerima misi itu akan membawa pulang beberapa informasi tentang pulau tersebut dalam bentuk laporan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Sayangnya, kami tidak bisa mengirim ekspedisi dalam skala besar karena kekurangan orang, jadi kita hanya bisa mengirimkan beberapa petualang saja untuk menjelajahinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Sepertinya aku hanya bisa membantu menganalisa peta ini sampai sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "Tapi aku tahu seseorang yang lebih tahu tentang Pulau Seirai daripada aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "Namanya Oda Tarou. Setahuku leluhurnya dulu tinggal di Pulau Seirai sebelum pindah ke sini karena beberapa alasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Omong-omong soal itu, beberapa waktu ini dia datang ke Adventurers' Guild untuk merekrut petualang yang mau menemaninya pergi ke Pulau Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Kamu bisa tanya tentang peta ini padanya. Kalau beruntung, mungkin dia tahu sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
