			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "Kamu sudah kembali. Bagaimana? Kamu berhasil memotretnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Bagus sekali. Tolong beri aku lihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ahaha! Aku sama sekali tidak mengenali tempat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "Sepertinya ketiga tempat itu sudah berubah banyak sejak keluarga kami pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Entah Nona Fujiwara Toshiko tahu tempat ini atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Haha, tapi kurasa dia juga susah mengenalinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "Dia juga dari Pulau Seirai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "Lebih tepatnya, sama sepertiku... leluhurnya pernah tinggal di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630411,
					"content": "Sebenarnya, ada banyak penduduk Inazuma yang leluhurnya berasal dari pulau itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630412,
					"content": "Kenapa kalian semua pindah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "Aku juga tidak terlalu ingat... sudah lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630414,
					"content": "Mungkin karena badai di sana terlalu parah, atau demi menghalangi penyelundupan atau menyeberang perbatasan dengan ilegal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630415,
					"content": "Apa pun alasannya, Shogunate sudah mengatur agar semua penduduk pulau itu pindah ke Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630416,
					"content": "Yah, lain kali saja kita bicarakan ini. Ini untukmu, tanda terima kasih karena sudah membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630417,
					"content": "*huff* Ah, aku ingin sekali pergi ke Pulau Seirai sendiri kapan-kapan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630418,
					"content": "Tapi aku masih harus mengurus usahaku ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				}
