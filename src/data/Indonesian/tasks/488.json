			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa? Apa kamu di sini untuk laporan pajak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Ah, hai Cutie. Iya benar. Aku dengar Jean jatuh sakit jadi aku pikir aku ingin membantunya untuk mengerjakan beberapa tugas laporannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Oh, baguslah kalau begitu. Sepertinya urusan kita di sini sudah selesai, kalau begitu kami pergi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Ah, tunggu sebentar, sebenarnya Charles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Biarkan aku bicara, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Baru saja aku menerima pesanan yang penting, sayangnya persediaan di toko tidak cukup dan pengirimannya datang terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Jika tidak keberatan, bisakah kalian pergi dan <color=#00E1FFFF>periksa kondisi persediaan anggur itu</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Memang apa yang mendesak dari pesanan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*huff* Apa boleh buat. Pesanan itu benar-benar baru saja datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Ya~ begitulah, seperti yang dikatakan oleh Charles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Baiklah, aku pergi untuk memeriksanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Baiklah, tapi lain kali jangan lupa traktir aku minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Haha, aku yakin jika lain kali Tuan Diluc di sini, dia pasti akan mentraktirmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "Baiklah, boleh juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
