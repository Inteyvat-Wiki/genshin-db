			"dialogs": [
				{
					"id": 4880101,
					"content": "Jadi barang-barang itu ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "Kamu datang ke sini untuk menolongku? Aku sudah menunggu kedatangan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Aku sudah lama bekerja di Dawn Winery, dan ini pertama kalinya aku dirampok oleh para Hilichurl...*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Jika kalian datang terlambat, aku benar-benar tidak tahu harus bagaimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Tenang saja, {NICKNAME} ini ahlinya membasmi Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Baiklah. Kalau begitu, tolong antarkan <color=#00E1FFFF>kargo balon udara</color> ini sampai ke tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Berhati-hatilah dengan benda itu. Jangan sampai gegabah memukul para Hilichurl, kamu harus <color=#00E1FFFF>memastikan barangnya baik-baik saja</color>, karena aku tidak punya Mora untuk menggantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "Baiklah itu saja, aku akan menunggumu di depan sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
