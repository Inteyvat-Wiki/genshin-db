					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Penjaga Raksasa"
				},
				{
					"id": 790640303,
					"content": "Penjaga raksasa memungut dan melemparmu keluar.\\nTidak ada yang bisa melawan.",
