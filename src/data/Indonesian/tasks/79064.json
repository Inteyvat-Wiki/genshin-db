			"dialogs": [
				{
					"id": 790640301,
					"content": "Halo semua, aku sudah kembali. Aku datang bersama sang Bangsawan dan pengikutnya, dengan tujuan mencari tahu awal mula klan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
