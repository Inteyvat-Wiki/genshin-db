			"dialogs": [
				{
					"id": 790640601,
					"content": "Ada orang mencurigakan! Aku tidak tahu pelanggaranmu apa, tapi kami sedang siaga darurat. Mengakulah, menyerahlah ke pihak berwajib!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Penjaga Raksasa"
				},
				{
					"id": 790640602,
					"content": "Semua orang bubar. Kamu mendengar suara Cappet yang teriak \"bertahan hidup masing-masing\"!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Kita coba lagi.",
