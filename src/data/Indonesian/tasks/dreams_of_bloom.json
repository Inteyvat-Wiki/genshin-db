					"Sakuya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "Halo! Mau coba tanam bunga sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580102,
					"content": "Bunga apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "Oh, kamu tertarik? Kalau ada yang tidak mengerti, biar kujelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580104,
					"content": "Namaku Sakuya. Aku seorang tukang kebun, yang menjalankan usaha bunga ini sebagai sampingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580105,
					"content": "Ahaha, biarpun aku sebut ini \"usaha\", tapi sebenarnya aku cuma mengirim bunga untuk orang-orang, dan membuatkan ikebana untuk toko-toko ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580106,
					"content": "Ikebana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "Oh, kamu tidak tahu? Ikebana adalah sebuah kesenian yang cukup penting di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580108,
					"content": "Sederhananya, Ikebana adalah seni memotong bunga dan menatanya jadi sebuah karangan bunga yang cantik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580109,
					"content": "Jelasnya, kamu harus lebih paham dan mampu memilih bagian yang kurang baik dari sebuah tanaman, lalu gunting dan buang bagian itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580110,
					"content": "Lalu, cara kamu menatanya harus sesuai dengan lingkungan, bahkan sampai ke sudut dan arah kemiringan bunganya harus diperhatikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580111,
					"content": "Rincian ini harus dipertimbangkan sampai benar-benar matang, dan memang terkadang bisa merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580112,
					"content": "Orang yang suka ikebana macam aku saja merasa kalau kerjaan ini melelahkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580113,
					"content": "Aku dulu punya toko di kota, tapi jalanan di sana terlalu ramai dan berisik, aku jadi sulit konsentrasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580114,
					"content": "Jadi aku tutup tokonya. Sekarang, aku langsung saja terima tamu di sebelah kebun bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580115,
					"content": "Yah, memang lebih tenang sih, tapi usahaku juga jadi lebih sepi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580116,
					"content": "Nah, aku sudah membuat skema promosi untuk tokoku, \"Sakuya's Flowers\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580117,
					"content": "Rencana ini kunamakan ... \"Mekar Dalam Mimpi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580118,
					"content": "Bagaimana rencanamu sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "Intinya, pelanggan dipersilakan untuk menanam bunga mereka sendiri, lalu membuat karangan bunga khusus yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580120,
					"content": "Kalau kamu berminat, bilang saja. Menanam bunga dan ikebana, keduanya sangat menarik loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakuya"
				}
			]
		}
	]
}