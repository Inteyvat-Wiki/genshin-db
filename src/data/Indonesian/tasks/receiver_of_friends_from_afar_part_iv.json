			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "Terserah ya? Astaga ... Ini mimpi buruk para koki nih. Tanpa tahu bagaimana selera para pelanggan, kamu jadi harus menebak-nebak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Tapi sekarang kan kamu sudah kerja di dapur cukup lama, aku percaya kamu pasti bisa dapat solusinya. Ayo, tunjukkan kemampuanmu pada mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490403,
					"content": "(Biar kupikir dulu ... mereka suka makan apa ya? Kira-kira saat ini mereka lagi mau makan apa ya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
