					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "Mmm, enak banget! Bumbunya pas, dan bahkan nasinya saja ada rasanya loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Masakan panas-panas yang baru selesai dimasak memang paling enak ... jadi kangen deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "Hehe, kamu membuat \"perbekalan militer terbaik di Favonius\" jadi tidak ada apa-apanya begini ... Oke, Pengembara, jadi apa nama hidangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Ini namanya ... hm ... Paimon rasa kita boleh sebut \"Anything Goes\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "Duh tolongin dong, Paimon juga enggak tahu gimana jelasin hidangan ini! Enggak ada namanya, pokoknya cuma bahan-bahan dasar, terus dimasak, selesai deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "Bahan-bahan dasar, terus dimasak begitu saja? Oh ya? Padahal saya yakin banget kalian pakai bahan mahal di dalamnya, atau ada teknik masak khusus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Ini memang bukan hidangan yang termewah sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Tapi ini yang paling kalian butuhkan saat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Bukan hidangan termewah, tapi yang mereka butuhkan saat ini ...? Paimon jadi bingung, gimana sih maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Kalian kan sudah melakukan perjalanan cukup lama ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Terus kalian cuma makan perbekalan militer ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Jadi maksudmu ... kami merasa ini nikmat banget karena lapar banget? Hmm, pasti ada alasan lainnya deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "Mungkin aroma dari hidangan hangat yang baru dimasak berhasil mengalahkan bekal militer dingin yang siap saji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ah, seperti perasaan mencium aroma roti yang baru dipanggang di pagi hari? Iya, itu masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Iya ... Seolah kita ada di Good Hunter ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Eh? Tapi kan Good Hunter ada di Mondstadt ... Lalu apa gunanya coba masakan Liyue kalau enggak ada bedanya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Oh, aku bukan bicara soal rasa. Maksudnya perasaan ... nyaman, paham kan? Seolah seperti kembali ke rumah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Nyaman ... kembali ke rumah ... Yah, Yanxiao memang bilang dia ingin membuat para pelanggan seolah berada di rumah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Rasa enak atau tidak itu memang subjektif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Semua orang punya seleranya masing-masing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Tapi seorang koki harus bisa memenuhi semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Harus bisa memposisikan diri sebagai tamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "Dan dalam hidangan ini juga ada niatan si koki untuk menoreh senyum di bibir pelanggannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Jadi dengan kata lain ... bahan rahasianya adalah ... \"hati\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Walaupun terdengar klise, kuakui memang makanan ini pakai hati sih. Bagus ... Hm, camkan kata-kataku ya, aku pasti akan mengingat resep ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Oke, tapi memang kamu bisa punya resep tanpa nama? Jadi nama hidangan ini apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "Aku belum kepikiran sampai sana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "Kamu punya ide apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "Hmm ... Gimana kalau \"Right at Home\"?",
					"roleType": "TALK_ROLE_NPC",
