				},
				{
					"id": 401499402,
					"content": "Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "Ah, maaf. Aku tadi ngelamun jadi tidak lihat kamu datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Sedang memikirkan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Iya ... Hidangan yang kamu masak tadi — mengingatkanku pada hidangan yang dulu kakek suka buatkan untukku. Padahal kupikir aku sudah lupa rasanya, tapi sekarang aku jadi ingat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Dulu dia suka membuat hidangan Liyue. Dan aku terus melakukan latihan Outrider dengannya sampai malam, lalu aku akan menunggu di meja makan dengan sabar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "Aku akan duduk di sana, dengan aroma harum yang berasal dari dapur, menunggu kakek membawa hidangan lezat untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Terkadang Eula juga ikut kami makan malam, dan walaupun dia selalu mengeluhkan sesuatu, tapi aku yakin dia menikmati sekali hidangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Ah ... mungkin dia juga ingat soal itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "Itu kan katamu, bukan kataku. Jangan tanya dia soal itu — dia pasti bakal ngoceh lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "Dan mungkin itu sebabnya dia menyarankan kita ke sini buat makan malam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
