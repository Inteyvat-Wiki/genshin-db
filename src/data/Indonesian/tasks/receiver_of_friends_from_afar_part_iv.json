							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "Waktu cepat sekali berlalu. Luka bakarku sudah hampir sembuh, jadi harusnya besok aku sudah bisa urus dapur lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Kamu benar-benar sudah berusaha keras beberapa hari ini, {NICKNAME}. Ini hari terakhir — semoga saja hari ini bisa berlalu tanpa ada kendala apa pun lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Ugh, kok Paimon ngerasa habis kamu bilang gitu pasti bakal ada kejadian aneh lagi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "Satu hari berlalu tanpa ada kendala apa pun ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "Fyuh, akhirnya malam tiba juga! Ternyata hari ini benaran mulus ya. Apa mungkin karena kita sudah jago ngurus yang aneh-aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Banyak juga yang sudah kita lalui sejak hari pertama ya? Waktu itu, kita bahkan susah buat ingat siapa pesan apa ... Tapi sekarang sih gampang banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Jangan sombong dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Iya, tapi memang siapa yang mau datang malam-malam begini? Oh ... sekarang kalau Paimon ingat-ingat lagi, Lyney dan adik-adiknya datang sekitaran jam segini waktu hari pertama, ya kan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? Senang bertemu kalian berdua di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? Ada Eula sama Mika juga! Kalian di sini mau makan malam? Kok telat banget?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Kami baru selesai menyelesaikan misi mengawal pedagang karavan. Rencananya sih cukup makan bekal saja malam ini lalu lanjut ke Stone Gate ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Tapi Kapten Eula bilang sudah lama kita tidak makan hidangan khas Liyue. Jadi kami pikir mungkin bisa mampir ke penginapan sekalian lihat apa kita masih bisa pesan sesuatu atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Ooh, jadi ini Eula yang traktir ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "Ehem! Kita sudah makan bekal terus selama perjalanan kita, jadi kurasa ini waktunya kita makan yang cukup baik sekarang ini. Apa kamu ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Yah, selamat datang di Wangshu Inn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Pertanyaan bagus, pesan apa ya ... Hmm? Tunggu, kenapa kamu yang tanya pesanan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME} jadi koki sementara di sini! Kamu datang tepat waktu — kamu pelanggan terakhir yang bakal menikmati masakan dia sebelum koki aslinya kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Wow, yang benar? Wah, untung Eula menyarankan kita ke sini! Aku tidak boleh melewatkan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Jadi, pesan apa nih kita? Hmm ... aku sudah tidak terlalu paham soal hidangan Liyue. Mika, Eula, kalian lagi mau makan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "Apa saja boleh! Saya cuma ingin mencicipi masakan dari Honorary Knight. Saya yakin ini akan jadi pembelajaran yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "Kurasa yang ringan-ringan saja. Karena sehabis makan kita masih harus melanjutkan perjalanan. Apa pun hidangannya, terserah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Loh, bukannya kamu yang menyarankan buat datang ke sini? Huh, ini sih sudah kayak nanya sama tembok ... Ya sudah, Amber, terserah kamu saja deh. Kamu sebut saja mau apa, nanti kita masakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Hah? Aduh ... aku juga tidak tahu mau pesan apa. Terserah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Mau pesan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "Hari ini masih belum selesai loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
