			"dialogs": [
				{
					"id": 401490301,
					"content": "#Oke, {NICKNAME}! Terima kasih banyak atas kerja kerasnya beberapa hari belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "Jangan sungkan ... jadi aku tetap dibayar, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Hahaha, kamu langsung ke intinya ya? Ini, ambillah. Aku ada tambahkan sedikit juga — anggap saja bonus. Kerja keras pasti akan selalu dihargai di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Hore! Seolah semua rasa lelah dan stres kita langsung hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Aku beruntung sih kamu cuma gantikan aku buat beberapa hari saja. Dengan perkembanganmu itu, mungkin cuma butuh beberapa minggu saja sampai bisa menggantikanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Aku menantikan masakanmu loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, oke! Lain kali bawalah teman-temanmu ke sini dan akan kutunjukkan kemampuan Smiley Yanxiao yang sebenarnya dengan kedua tangan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Bagus! Tapi ... supaya aman, kamu masaknya harus hati-hati juga! Jangan sampai terbakar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
