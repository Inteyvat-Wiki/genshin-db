			"dialogs": [
				{
					"id": 747110101,
					"content": "Aha! Semuanya berjalan lancar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Aku yakin penelitian kita untuk menemukan obatnya sudah memasuki tahap akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Selain mencari beberapa ikan-ikan lagi untuk melengkapi daftarnya, aku juga punya permintaan lain yang lebih spesifik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Aku butuh kamu untuk mencari beberapa mekanisme bawah air penting di perairan yang terdampak dan mengambil data yang direkam oleh sensor mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Lalu menganalisis datanya untuk menemukan pola yang relevan ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Betul sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Kita juga harus mengimbau para pemilik kapal dan penyelam untuk memastikan kalau mereka sudah belajar dari kesalahannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Benar, belum lagi para nelayan dan turis. Pokoknya siapa pun yang naik perahu di permukaan air, dan siapa pun yang menyelam di bawahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Semua orang yang berinteraksi dengan perairan kita harus berhati-hati. Mereka tidak boleh sembarangan membuang sampah dan merusak habitat laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Kalau tidak, pasti ikan yang super agresif bakal datang dan gulingkan perahu mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Supaya kita bisa mencegah kejadian serupa di masa depan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
