					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "Setelah menemukan \"Head Mushroom\", menyelesaikan latihan masak, dan mengenali Nara yang kuat dan dapat diandalkan, aku benar-benar sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas, dan Araphala pasti akan berterima kasih kepadamu juga. Nara {NICKNAME}, kamu benar-benar Nara yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Berterima kasih padaku? Untuk apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Tentu saja karena dengan membantuku, mereka jadi punya kesempatan untuk mencicipi \"Head Mushroom\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
		{
			"id": 7302005,
