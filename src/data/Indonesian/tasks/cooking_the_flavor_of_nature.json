			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "*hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "Ah, Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "*uhuk*. Aku malu membiarkan Nara melihatku dalam kondisi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "Nara yang baik, aku Arachatora. Kalau kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Namaku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Nama Paimon ya Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Nara {NICKNAME} dan Paimon ya, salam kenal. Terima kasih ya. Kalau tidak bertemu kalian di sini, aku pasti perlu waktu lebih lama lagi baru bisa sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "Perlu lebih lama itu berapa lama ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "Ini memalukan, dulu aku juga pernah seperti ini karena salah makan jamur. Aku sembuh setelah Nilotpala Lotus di air mekar dan tutup, dua kali lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Mekar dan tutup ... Itu butuh waktu 2 hari kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "Ah, dua hari. Ternyata begitu, rupanya namanya \"hari\". Nara memang menarik. Dua hari termasuk cepat atau lambat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Hmm ... {NICKNAME}, gimana menurutmu? Cepat atau lambat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Lambat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Iya sih. Enggak bisa bayangin Arachatora \"aduh, aduh, aduh\" dua hari penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "Oh ya? Ternyata itu termasuk lama ya, hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Tapi, kalau kamu Arachatora, berarti kamu saudara kandung Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "Bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "Eh? Tapi ... kamu kakak Arapacati, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Eh, kok tahu? Arapacati itu \"adik perempuanku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "Gimana sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Mungkin Aranara punya konsep yang berbeda ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "Intinya, begini deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Memberi tahu Arachatora tentang apa yang terjadi sejauh ini.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Festival Utsava akan diadakan sebentar lagi ... Apa yang harus kulakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Aku belum menyiapkan \"bahan masak\", aku harus membuktikan ke Arasaka, Arapas dan Araphala tentang kehebatan hidangan jamur di Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "Kalau gitu, Aras ... spa ... ara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas, dan Araphala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Ah ah! Nama Aranara susah banget diingat! Arachatora, mana saudaramu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "Kita sudah menemukan jalan masing-masing waktu latihan, sama seperti air yang mengalir menjadi dua cabang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "Artinya sudah pisah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "Kami \"latihan masak\" supaya bisa membuat \"kelezatan yang hakiki\", tapi ternyata mereka tidak mengakui kehebatan hidangan jamur. Padahal \"Head Mushroom\" itu tidak ada tandingannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Intinya, kami sepakat untuk membuat hidangan masing-masing untuk ditandingkan setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Oh! Paimon sih ngerti seratus persen tentang kelezatan makanan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "Jadi, di mana \"Head Mushroom\" itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "Akhir-akhir ini \"Marana\" menyebar dengan sangat cepat. Bahkan habitat \"Head Mushroom\" sudah direbut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "Ah, Withering ... semoga Rana baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "Aku takut jamur di sana sudah dirusak oleh cakar yang bisa melayukannya. Kalian berdua juga pasti tahu kalau area \"Marana\" sangat, amat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Tanpa \"Head Mushroom\", kita tidak akan bisa mencoba jamur aneh yang belum pernah dimakan Aranara mana pun sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "Terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "Terus seperti yang kita lihat sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Tapi omong-omong, kita dulu pernah berurusan dengan Withering ... atau yang disebut \"Marana\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "Gampang sih kalau itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Luar biasa. Kalian bisa menandingi kekuatan \"Marana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Tapi ini jadi masuk akal. Kalau Nara {NICKNAME} memang bisa pakai kekuatan Lesser Lord Kusanali untuk menyembuhkanku, kalau mau menghilangkan pengaruh \"Marana\" harusnya tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Kalau begitu, aku mau minta tolong Nara {NICKNAME} menemaniku ke tempat \"Head Mushroom\" tumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#Ini kesempatan cicip hidangan jamur yang tiada duanya! {NICKNAME}, ayo bantu saudara-saudara ini supaya mereka bisa berkumpul kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "Ya. Kan memang sudah berjanji sama Arapacati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Ok. Lokasinya ada di gua di depan sana. Ayo ikut aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Halah, ngomong saja kalau kamu mau makan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "Mumpung ada kesempatan, apa salahnya sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "Wah kita hampir kehilangan nyawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "\"Aduh, aduh, aduh\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Harusnya termasuk cepat deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "*huff* ... Ya memang, ternyata kita sudah lama kenal ya. Tapi rasanya kayak baru kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "Oh ya? Kalau begitu aku bisa tenang. Ternyata hilang di hutan dua hari tidak termasuk lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "Bukan itu maksudnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "Tergantung sih waktunya untuk apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Hmm, memang sih. Kalau \"aduh, aduh, aduh\" dua hari, itu termasuk lama. Tapi kalau itu durasi Forest Boar bisa tumbuh besar, berarti termasuk cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "Oh ya? Ternyata itu termasuk lama ya, hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "Waktu itu sifatnya subjektif dan kadang-kadang tidak punya arti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Ya. Nara {NICKNAME}, kamu paham konsep perhutanan ya. Hutan tidak perlu \"hari\" untuk bisa bertahan hidup, bertumbuh atau kembali ke asalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Apaan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Ahhh! \"Head Mushroom\" yang aku pikirkan siang dan malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "\"Head Mushroom\", kalau jamur itu kehilangan aroma harumnya, apa masih bisa disebut \"Head Mushroom\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Hehe, jamur. Aromanya memang lumayan wangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "Ya sudah, pokoknya, ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "Aku beruntung bisa bertemu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "Ini \"Head Mushroom\" yang sudah matang, aromanya lebih lembut dari yang waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "Sepertinya walaupun habitatmu dikuasai Marana, kamu tetap bisa tumbuh dengan baik, hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Emmm ... jadi aku ... boleh coba \"Head Mushroom\" itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Tentu. Karena Nara sudah membantuku, sudah seharusnya aku menyajikan hidangan jamur ini kepada kalian, ini adalah tujuan dari \"latihan masak\" yang aku jalankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "Asyik! Head Mushroom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora langsung memasak ....\\nAroma jamur yang lezat tercium dari dalam panci.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Lalu Arachatora menghidangkannya padamu dan Paimon.\\n... Sesuai ekspektasi, atau memang sesuai yang dibayangkan ya ... tidak ada rasa sama sekali.\\nTapi bagaimanapun, hidangan ini penuh dengan semangat hidup yang kuat, teksturnya terlalu keras sehingga sulit dikunyah.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "Sudah selesai. Latihan memasakku sudah sempurna. Bagaimana? Bagi Nara, aku percaya pasti ini adalah kelezatan terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "*nyam nyam* ... *gluk* ... Hm ... Gimana bilangnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "(Mengunyah dengan sekuat tenaga)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(Menelan dengan kuat)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "Masih bisa dimakan, kalau memang niat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Ya ... sebenarnya jamurnya sangat harum, tapi rasa dan teksturnya kurang cocok untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "Kenapa bisa begitu, sebelumnya aku pernah buat untuk Nara, dia jelas-jelas bilang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "Sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "Sebelumnya aku pernah membuatkan hidangan jamur untuk Nara. Dan karena rasanya enak, dia telan dengan sekuat tenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Seharusnya tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Oh. mungkin sama seperti Aranara yang berbeda akan tumbuh daun yang berbeda juga. Rasa jamur juga mungkin tidak cocok untuk semua Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Benar, omong-omong soal daun ... Bukannya kalian Aranara takut api? Tapi kok kalian kelihatannya punya banyak daun ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Tentu saja api menakutkan, kadang api bisa bakar hutan sampai habis, bahkan bisa mengubah seluruh hutan di gunung menjadi gurun gersang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Tapi, bagaimanapun juga ini untuk \"latihan masak\", menahan rasa takut akan api dan mengendalikan besar kecilnya api juga termasuk bagian dari latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Saatnya untuk kembali, Arapacati sedang menunggu kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Ya. Aku akan kembali ke Vanarana sebentar lagi. Kalau tidak nanti adikku akan khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "Mengenai lainnya ... Arasaka, Arapas, Araphala masing-masing berada di <color=#00E1FFFF>dekat Desa Gandharva</color>, <color=#00E1FFFF>Apam Woods</color>, dan <color=#00E1FFFF>Gunung Devantaka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Terima kasih. Nara {NICKNAME} Emas yang secerah matahari, Paimon juga sedikit luar biasa. Misi adik perempuanku akan kuserahkan pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "Kok waktu giliran Paimon cuma jadi \"sedikit luar biasa\" ya?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "Yah, jangan ambil hati ... Pokoknya, kalian telah banyak membantuku, aku tidak tahu bagaimana cara membalas kebaikan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "Ya, aku memutuskan untuk mengajarkan kalian berdua resep kelezatan yang hakiki. Mungkin suatu hari nanti, ketika sudah dewasa, kalian akan bisa memahami rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, resep ini, biar Paimon sesuaikan dulu ya ... harusnya ada cara untuk dibuat jadi hidangan asli yang enak!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "Setidaknya tidak beracun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "Aku masih terlalu muda untuk makan yang seperti ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
