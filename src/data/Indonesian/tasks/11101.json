			"dialogs": [
				{
					"id": 111010701,
					"content": "Aku tidak mengerti... Bagaimana mungkin Simbol Seribu Izin tidak bekerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111010702,
					"content": "Apa aura jahat yang mengelilingi Hilichurl-Hilichurl ini bertambah kuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111010703,
					"content": "Simbol Seribu Izin... Kedengarannya tidak asing yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Simbol itu memungkinkan kita masuk dan keluar dari Jueyun Karst sesuka hati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Oh, itu adalah benda peninggalan Adeptus, jadi kekuatan mereka pasti masih tersisa di dalamnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "Pantas saja dia bisa mengusir semua monster itu barusan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "A-apa yang kalian berdua bicarakan? Aku hanya kurang istirahat... kekuatanku belum sepenuhnya... mengalir keluar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111010709,
					"content": "Kalau ada kesempatan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111010710,
					"content": "Ada sekelompok Hilichurl jahat di sana. Bagaimana kalau kami serahkan mereka semua kepadamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Aku... aku tiba-tiba merasa tidak enak badan. Pasti aku terlalu banyak memakai kekuatan Adeptusku. Kalau tidak, aku pasti akan mengusir mereka semua sekaligus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Starsnatcher, Celestial Lord"
				},
				{
					"id": 111010712,
					"content": "Ugh, ternyata kamu memang cuma membual saja. Kami memang sudah curiga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "Ayo kita pergi, sepertinya harus kita yang menyelesaikannya. Gunakan Elemental Sight untuk memburu jejak mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "Ternyata dia menggunakan itu untuk mengusir iblis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
