						111011202
					]
				},
				{
					"id": 111011202,
					"content": "Buku itu menceritakan tentang yaksha yang berjuang melawan kebencian para dewa selama ribuan tahun, namun pada akhirnya tetap terikat oleh karma.",
					"roleType": "TALK_ROLE_NPC",
