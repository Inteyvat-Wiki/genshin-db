				{
					"id": 111011402,
					"content": "Yap, Paimon rasa kita sudah menyimpulkan semua poin pentingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011403,
					"content": "Jadi kembali ke permasalahan kita. Jawaban yang kita butuhkan adalah satu, dari mana Hilichurl dengan aura jahat itu muncul, dan dua, apa hubungannya Starsnatcher dengan para yaksha. Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011404,
					"content": "Kalau begitu, ayo kita selidiki semua itu! Kita tepis kabut misteri yang menggantung di Jueyun Karst, dan biarkan kebenaran bersinar terang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011405,
						111011406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011405,
					"content": "Jadi kita mau memulai permainan detektif lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011407
					]
				},
				{
					"id": 111011407,
					"content": "Hehehe! Yah, Paimon sebenarnya berharap dia benar-benar Adeptus. Teknik pengusiran setannya terlihat nyata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011408,
					"content": "Tapi kalau kita berharap terlalu berlebihan, nanti akan lebih kecewa. Jadi lebih baik melakukan investigasi dulu, supaya lebih yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011409,
					"content": "Yuk, kita kembali ke Wangshu Inn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011406,
