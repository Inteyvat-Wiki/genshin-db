			"dialogs": [
				{
					"id": 740510301,
					"content": "Bagus sekali. Kameranya tidak rusak, dan filmnya juga tidak rusak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510328,
					"content": "Astaga, kupikir kita harus rekam lagi semuanya dari awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510302,
					"content": "Kenapa kamu syuting di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Sepertinya kalian juga bukan dari Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Ya, tapi ... Yah, ceritanya panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510304,
					"content": "Yang singkat saja, ya. Kami bertiga datang dari Desa Qiaoying di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510305,
					"content": "Kebanyakan orang yang tinggal di sana buka usaha teh, tapi kami ... tidak tertarik sama sekali sama teh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510306,
					"content": "Jadi kami ganti profesi dan mulai rekam film dokumenter untuk bantu promosikan toko-toko teh di desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510307,
					"content": "Sebenarnya sih karena sudah terlalu banyak orang yang buka usaha teh, kami tidak sanggup bersaing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Pekerja di toko kami juga keluar satu per satu untuk kerja di tempat lain, jadi kalau mau tetap buka usaha teh, nantinya kami yang bangkrut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Kalian berdua ... jangan menyedihkan begini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510310,
					"content": "Kami dapat banyak Mora untuk rekam dokumenter teh di desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510311,
					"content": "Tapi akhir-akhir ini beberapa orang dari desa juga mulai rekam film promosi mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Bahkan ada pertunjukan opera di beberapa film mereka, pokoknya heboh lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "Makanya kami datang ke Fontaine! Untuk cari pendapat ahli film!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510314,
					"content": "Jadi kalian ke Fontaine untuk belajar tentang perfilman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Iya, kami ketemu \"ahli film\" bernama Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510316,
					"content": "Dia benar-benar jago pakai pencahayaan untuk ... apa namanya itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Naratif\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Oh iya! Pakai pencahayaan untuk \"menceritakan kisah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510319,
					"content": "Di bawah bimbingan Tuan Geisert, kami pasti bisa buat film terbaik di seluruh Desa Qiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510320,
					"content": "Bos, bulan lalu kamu bilang kita bakal buat film terbaik di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Dalam berbisnis, ekspektasi harus diubah sesuai dengan realita ... Memangnya kamu tahu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510322,
					"content": "Singkatnya, terima kasih untuk bantuanmu, Pengembara. Ini ambil Mora-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng! Cepat beresin ini! Kita harus menyelesaikan perekaman sampelnya terus memperlihatkannya ke Tuan Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510324,
					"content": "Perhatikan pencahayaannya! Kamera-nya harus diarahkan ke sumber cahaya, seperti itu. Supaya bisa dapat ... cahaya dengan kualitas tingkat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510325,
					"content": "Kalian sudah membaca bukunya, kan? Cahayanya harus ada tekstur, paham tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 740510326,
					"content": "Bos, walaupun kita sudah baca semua buku Tuan Geisert ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Tapi kalau pakai Kamera ini sih, sesusah apa pun kita berusaha, kayaknya kualitas cahayanya juga tidak bakal bagus sampai gimana deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
