			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "Bagaimana? Apa kamu mendapat kabar tentang ayahku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230502,
					"content": "Tentang penemuan gua di puncak gunung...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "Ayah... Tidak, ayah adalah petualang yang tangguh, hal kecil seperti itu, dia pasti dapat menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230504,
					"content": "Ayah dalam catatannya juga menuliskan bahwa dia telah menemukan cara untuk turun dari gunung... Dia pasti sudah turun dengan selamat... Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230505,
					"content": "Dia seharusnya sudah kembali dengan selamat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "Benar... Dia pasti sudah kembali dengan selamat, dan sedang beristirahat sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230507,
					"content": "Atau mungkin... Dia sedang membangun kemah baru di tempat bagian lain dari puncak gunung untuk beristirahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230508,
					"content": "Entah bagaimana pun, saat ayah sudah selesai beristirahat... Dia pasti akan datang mencariku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230509,
					"content": "Aku akan tetap menunggunya di sini, terima kasih karena telah membantuku. Terimalah, ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230511,
					"content": "Aku tidak menemukan apa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "Benarkah? Tapi paman dari Knights of Favonius mengatakan bahwa ayah memang sudah naik ke gunung salju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230513,
					"content": "Apa mungkin dia salah lihat? Atau mungkin... Ayah pergi ke tempat lain untuk mendirikan kemah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230514,
					"content": "Baiklah, aku akan tetap menunggunya di sini... ayah pasti akan sangat cemas kalau sampai dia tidak menemukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230515,
					"content": "Terima kasih telah membantuku. Terimalah, ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230516,
					"content": "Ayah... Di mana sebenarnya ayah berada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				}
			]
		},
