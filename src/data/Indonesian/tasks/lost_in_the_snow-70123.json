			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "Sejauh ini semuanya berjalan dengan baik, cuacanya cukup baik, persediaan juga cukup, dan aman dari monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				},
				{
					"id": 701230202,
					"content": "Ada lagi, dalam tasku aku menemukan buku \"Putri Babi Hutan (VI)\", pasti Joel diam-diam memasukkannya ke dalam tasku, dasar anak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				},
				{
					"id": 701230203,
					"content": "Buku ini isinya tentang perjalanan Putri Babi Hutan yang pemberani mendaki gunung salju bersama teman-temannya... Nah, aku juga sedang mendaki gunung, dan sejauh ini semuanya baik-baik saja. Buku ini pembawa keberuntungan ya. Terima kasih, Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				},
				{
					"id": 701230204,
					"content": "Singkatnya, aku akan bersiap-siap menuju perkemahan selanjutnya untuk melengkapi keperluanku dan mencatat kemajuanku, setelah itu aku akan menuruni gunung. Joel masih berada di kota menungguku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "Tidak terjadi apa-apa selama perjalanan ini, cuacanya pun sangat baik, sepertinya keberuntunganku sudah membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				},
				{
					"id": 701230302,
					"content": "Mungkin aku bisa mencoba untuk naik puncak gunung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				},
				{
					"id": 701230303,
					"content": "Akan kucoba dulu, kalau muncul masalah, aku akan segera turun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurnal yang Tertulis Rapi"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "Badai salju datang dengan begitu cepat, aku hanya memikirkan untuk melarikan diri ke dalam gua, sehingga persediaannya juga hampir semuanya terbuang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230402,
					"content": "Tapi aku tidak tahu kenapa... Batu di atas pintu masuk ke dalam gua tiba-tiba pecah dan berjatuhan menutupi pintu gua, aku benar-benar sial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230403,
					"content": "Tapi aku rasa... masih ada jalan lain. Di seberang gua ada tebing, tapi di bawahnya ada salju yang sangat tebal, kalau aku bisa mendakinya sedikit, lalu melompat ke bawah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230404,
					"content": "Persediaanku sudah tidak memadai, aku harus bergerak cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230405,
					"content": "Aku telah berjanji pada Joel untuk menemaninya melihat salju, aku tidak dapat mengingkarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230406,
					"content": "Jika ada yang melihat buku ini, tolong bantu aku untuk menaruh makanan di mangkuk makanan itu untuk para rubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				},
				{
					"id": 701230407,
					"content": "Ketika aku terjebak di sini, kumpulan rubah itu selalu menemaniku, kalau ada kesempatan, aku sangat ingin kembali untuk melihat keadaan mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurnal yang Tertulis Berantakan"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
