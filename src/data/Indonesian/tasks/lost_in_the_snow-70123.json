						701230102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "Oh... halo. A... aku tidak menemukan di mana ayahku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230104,
					"content": "Ayahku bilang dia akan menjemputku untuk pergi melihat gunung salju, tapi sampai di hari yang dia janjikan, dia belum datang juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230105,
					"content": "Dugaanku, dia pasti menemukan peta harta karun rahasia yang sangat berharga, jadi belum bisa menjemputku. Pasti begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230106,
					"content": "Jadi aku pergi sendirian ke Dragonspine. Karena dia tidak datang mencariku, maka aku memutuskan untuk pergi mencarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230107,
					"content": "Tapi aku masih juga tidak menemukan ayahku di sini. Paman dari Knights of Favonius bilang dia pergi ke arah puncak gunung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230108,
					"content": "Sebenarnya aku ingin pergi sendiri mencari ayahku, tapi paman knight tidak membiarkanku pergi, jadi aku hanya bisa tinggal di sini sambil menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230109,
					"content": "Tapi... Tapi dia tidak pernah kembali, aku sangat mengkhawatirkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230110,
					"content": "Kalau kamu mau pergi ke gunung, bisakah kamu membantuku mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230111,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "Kamu mau membantuku? Syukurlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230114,
					"content": "Coba aku ingat-ingat... paman Knights of Favonius mengatakan, ayah pernah bilang kalau dia harus pergi ke atas <color=#00E1FFFF>Snow-Covered Path</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230115,
					"content": "Kemudian pergi melihat-lihat ke <color=#00E1FFFF>Outskirts of the Entombed City</color>, dan terakhir dia ingin mencoba <color=#00E1FFFF>mendaki puncak gunung</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230116,
					"content": "Tolong cari ayahku di tempat-tempat ini, mungkin saja ayahku masih ada di sekitar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230117,
					"content": "Dia berjanji padaku untuk melihat salju bersama-sama, dan dia harus menepatinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230112,
					"content": "Di mana aku harus mencarinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		}
	]
}