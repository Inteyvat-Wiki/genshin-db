			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Hu-hmm ... Anginnya kencang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780402,
					"content": "Kita enggak bisa tembus tembok angin ini! Harus ambil jalan memutar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Kichiboushi, pokoknya ikuti kami ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
