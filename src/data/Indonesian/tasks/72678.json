			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "Akhirnya sampai juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "Pemandangan dari sini jauh lebih bagus dari di bawah tadi. Lihat — kita tadi dari sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Paimon suka tempat tinggi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780504,
					"content": "Jarak pandang dari tempat tinggi lebih luas, meluncur juga jadi lebih gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Storm-Storm tidur di sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780508,
					"content": "Iya, dia sudah tidur lamaaa sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Biarpun {NICKNAME} pernah berantem sama Stormterror, tapi dia bukan naga jahat kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "Karena dia kena masalah, lalu terluka, lalu ditipu lagi sama orang jahat, akhirnya dia pikir Archon Anemo sudah enggak mau dia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Hmm ... terus bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780512,
					"content": "#Terus ... {NICKNAME}, kamu masih ingat enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "Sewaktu bertarung, kita berhasil memurnikan racun di darahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Tapi, tempat kami bertarung tiba-tiba runtuh. Kami, dan juga Archon Anemo, awalnya sudah pikir bakalan jatuh ke tempat yang dalam banget, dan gelap banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "#Hmm! Seram ... Terus, Paimon dan {NICKNAME} gimana? Terbang keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780516,
					"content": "Dvalin yang tolong kami. Dia tebang bawa kami keluar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Dva ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780518,
					"content": "Itu nama aslinya Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#Stormterror punya nama asli, sama kayak Kichiboushi, Paimon, dan {NICKNAME}. Namanya Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "Awalnya, Dvalin terluka, lalu ditipu sama orang jahat. Dia jadi marah besar, lalu dia bikin kacau di kota Mondstadt. Semua orang mengira dia naga jahat, jadi mereka kasih dia nama \"Stormterror\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Setelah itu, kami mengalahkan si orang jahat, lalu bersama Archon Anemo memurnikan racun di darahnya. Akhirnya dia tahu kalau Archon Anemo enggak membuangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Oh! Storm-Storm jadi baik lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780524,
					"content": "Betul itu! Jadi kenapa Paimon ajak Kichiboushi latihan di sini hari ini? Soalnya mau cerita tentang Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Kalau sudah besar nanti, Kichiboushi juga mengalami yang namanya salah paham, terluka, dan sakit hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Tapi, tetap tidak boleh jadi jahat ya! Soalnya, \"Arah angin bisa berubah ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Suatu hari nanti, ia akan bertiup ke masa depan yang lebih cerah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780529,
					"content": "Ngomong kayak gitu ke Kichiboushi, memangnya dia paham?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Paham, tapi tidak paham juga. Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780531,
					"content": "#Tapi Kichiboushi tahu kalau itu penting. Omongan Paimon dan {NICKNAME}, tak mungkin lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780532,
					"content": "Ya! Bagus, Paimon enggak percuma deh buang waktu cerita sepanjang tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "Tapi apa pun itu, Kichiboushi pokoknya tidak boleh terlalu nakal atau jahil ya — nanti kamu bisa disegel orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "Latihan Kichiboushi pun sudah sampai ke penghujung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Mmmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780537,
					"content": "Jangan sedih gitu! Kamu harus kembali sambil tersenyum, atau nanti Ioroi bakal sedih juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "Baiklah, sekarang kita mau menyelesaikan tugas akhir seorang pemandu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Yaitu, pulangkan Kichiboushi dengan selamat ke sisi Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Ayo jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780541,
					"content": "Kichiboushi, ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Misi dari Ioroi pun akhirnya selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Stormterror yang tolong kami. Dia terbang bawa kami keluar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "Kamu tahu kan tentang \"Si bodoh dan si asap\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "Ini bukan tentang itu! Jarak pandang dari tempat tinggi lebih luas, terus udaranya juga bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
