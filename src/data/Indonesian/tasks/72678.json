			"dialogs": [
				{
					"id": 726780301,
					"content": "Hmm, bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780302,
					"content": "Kichiboushi, kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Kota ini gersang, rasanya agak sedih. Tidak tahu kenapa. Aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780304,
					"content": "Aku juga merasa begitu kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Habis ini, kita lanjut ke tengah \"kota\" ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "Kichiboushi, aneh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
