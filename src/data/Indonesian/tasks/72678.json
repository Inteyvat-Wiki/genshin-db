		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Ioroi, kami kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Oh, sudah kembali ya! Kichiboushi, bagaimana hasil latihannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Keprak-keprok, pung-pung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790104,
					"content": "Ha-he-ho-ho, bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Yah, kok sekarang jadi enggak ngerti lagi omongannya Kichiboushi sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "Kami ada banyak sekali foto, nih Ioroi, lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Kamu memperlihatkan semua foto Kichiboushi selama perjalanan ini ke Ioroi.\\nKamu juga menceritakan tentang petualangan kalian.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "Dengan demikian, kami sudah menyelesaikan permintaan Ioroi untuk \"membawa Kichiboushi latihan ke delapan tempat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "Aku memang tidak salah pilih orang. Bagus, bagus sekali. Jika kalian adalah tanuki, kalian pasti ada bakat untuk jadi bake-danuki yang menggetarkan dunia. Mungkin bisa mencapai setengah dari kehebatanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Gitu doang apa hebatnya coba ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Tugasnya sudah beres, kami pergi dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Hu-hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790113,
					"content": "Oh, jangan gitu dong. Oke deh Kichiboushi, Paimon ajari Kichiboushi satu hal lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Waktu berpisah dengan teman, berpisahlah dengan senyuman! Dengan begitu, nanti waktu ketemu lagi pasti jadi lebih gembira rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "Eh? Baiklah, baiklah. Serahkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi bilang, \"Oke, Rambut Putih\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Eh? Jangan-jangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kichiboushi kok jadi tidak bisa ngomong lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Waktunya sudah berlalu sekian lama, makanan bake-danuki sudah habis efeknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "Huh, kalau saja aku tidak disegel di dalam batu ini, kalau cuma ingin buat kalian mengerti bahasa para bake-danuki sih, perkara kecil saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "Eh? Oke, biar kusampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "\"Kichiboushi harus giat berlatih.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "\"Supaya bisa jadi bake-danuki sehebat Ioroi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "Hmm? Hahaha! Dasar, besar juga nyalimu, bocah. Aku jadi ingat waktu aku seusiamu dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "\"Supaya Rambut Putih dan Rambut Kuning, tidak perlu makan masakan bake-danuki, sudah bisa ngomong sama Kichiboushi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "Ya! Paimon tunggu ya Kichiboushi! Kita bakal latihan lagi sama kamu lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Semangat ya, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Jangan sampai disegel orang ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Hmm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790132,
					"content": "Yah, sudahlah. Aku tidak akan membicarakan hal ini lagi, karena kalian sudah mau membawa Kichiboushi berlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Betul juga. Dulu ada orang yang bernama Utamarou, yang pernah melukis para tanuki yang disegel di Chinju Forest. Masih ada sisa beberapa lembar gambar buatan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Kalian ambil saja, jadi kalian bisa melihatnya setiap kali mau mengingat ras tanuki yang keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "*huff* Andai kalian juga tanuki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "Kalau iya kami pasti sudah lama disegel di dalam batu, ya kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hah, betul juga sih. Kalau sudah tidak ada urusan, pergilah. Aku mau melanjutkan ajari Kichiboushi ilmu sihir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "Kenapa kami kembali lagi tidak mengerti omongannya Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}