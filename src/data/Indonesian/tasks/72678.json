			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Kota besar, tapi ... rasanya gersang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780102,
					"content": "Dulu kami pernah ke sini sebelumnya bersama teman-teman, terus berantem lawan Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Maksudnya naga yang punya badan besar, bisa terbang, gigi tajam, seram itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780104,
					"content": "Enggak seseram itu juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Kichoboushi masih ingat waktu kita lihat patung Archon Anemo di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Patung Archon Anemo ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780108,
					"content": "Itu loh, patung batu yang tinggi banget itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Hmm! Ingat. Tangan Archon Anemo besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780110,
					"content": "Stormterror itu sahabatnya Archon Anemo! Dulunya, Archon Anemo juga berasal dari kota ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780112,
					"content": "Tapi, Storm-Storm kan besar, kok dia bisa masuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780113,
					"content": "Pertanyaan ini rasanya familier ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Ah, kalau itu sih Paimon tahu! Soalnya dia enggak usah jalan kayak kita, dia ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Kichiboushi tahu. Storm-Storm terbang, dia tidak usah jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780117,
					"content": "Se-Sebal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Hmm? Paimon, kenapa tidak senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780119,
					"content": "Ah, nanti saja deh ngomongnya. Kita foto dulu! Kichiboushi, jangan gerak ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780114,
					"content": "Yang benar itu \"Stormterror\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "Tapi dia keren kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
