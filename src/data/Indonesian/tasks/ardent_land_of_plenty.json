			"dialogs": [
				{
					"id": 150180301,
					"content": "Halo! Um ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "Kalian tersesat? Butuh bantuanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "Enggak nyasar juga sih ... Kami lagi mau menuju ke suku Berlimpah Jaya. Ini jalannya sudah benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Oh iya! Itu suku aku juga. Kalau mau, aku bisa bawa kalian ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#Yes! {NICKNAME} kita dapat pemandu lokal lagi nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "Loh bukannya harusnya itu tugasmu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Pemandu ya ... kedengarannya oke juga! Hehe, kalau gitu mulai sekarang aku jadi pemandu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Ada banyak pemandangan unik di sepanjang jalan. Aku bisa kenalin ke kalian. Hampir semua orang yang baru datang ke sini pasti langsung kaget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Wah, oke juga tuh! Eh tapi ... Kami enggak ganggu kamu atau apa gitu kan? Soalnya kamu langsung rela bantuin kami gini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Tidak masalah kok! Aku di sini juga lagi latihan tadi, tapi hari ini sudah selesai jadi memang searah juga mau pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Terus aku juga bisa jelasin ke kalian tentang suku ini. Jadi belajar banyak hal baru juga, seru kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "Selama kalian senang, aku juga senang. Kata Paman Acatl memang harus gitu kalau menjamu tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "Oh ... oke deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Dia ramah dan antusias banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Iya, kita beruntung nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Iya! Paimon suka nih sama orang kayak gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "Sudah siap? Yuk berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Eh, tunggu! Kami masih belum tahu namamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Oh iya! Namaku Varesa. Senang bertemu kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
