					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Kalian ... Paimon dan {NICKNAME}! Aduh aku sudah tunggu-tunggu kedatangan kalian loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Wow! Kamu kenal kami? Heh, jadi kami sudah seterkenal itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Tapi... memang ada yang bilang ya kalau kita bakal ke Berlimpah Jaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Kamu tidak tahu? Bu Iansan bilang dia undang kalian ke suku kami. Jadi aku langsung tunggu kalian di sini sambil latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "Kalian benar-benar datang ke sini ... Hehe, duh senang banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "Eh yah ini biasa saja kan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "Kalian adalah pahlawan yang melawan Abyss! Perbuatan kalian sudah tersebar sampai ke pelosok Natlan! Aku sudah dengar banyak cerita tentang \"Tuma{RUBY#[S]Harapan}ini\" sampai-sampai sudah hafal di luar kepala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Aku sudah tidak sabar mau ketemu kalian sejak Bu Pelatih bilang kalian mau mampir. Oh ya, namaku Varesa, entah deh apa Bu Iansan pernah sebut namaku atau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Oh iya, kayaknya familiar deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Waktu Abyss nyerang, kami tanya Iansan dia perlu balik ke Berlimpah Jaya buat bantuin enggak, terus dia bilang Varesa sudah bereskan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Jadi kamu sendiri juga pejuang hebat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Ah tidak kok. Itu semua berkat Paman Acatl! Aku cuma beresin beberapa monster saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Kalau ingat soal itu, aku jadi merinding lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Tapi semua sudah berakhir. Berlimpah Jaya sekarang sudah cukup tenang. Perbaikannya juga sudah selesai, dan sekarang cuma lagi bantu-bantu suku lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hehe, ayo! Kubawa kalian ke kemah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Oke! Ayo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "Kamu sendiri juga pahlawan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
