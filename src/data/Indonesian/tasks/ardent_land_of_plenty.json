			"dialogs": [
				{
					"id": 150180101,
					"content": "Heh ... kok ada papan luncur kayu begitu ya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "Oh, ini alat latihan suku kami! Aku sering pakai kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "Alat latihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Iya! Susah sih jelasinnya ... Nih kukasih lihat deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "Mendarat dengan sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Wow, kamu langsung lompatin gitu aja? Hebat amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Ah bukan apa-apa kok! Kalau latihan, semua orang juga pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "Oh! Kamu bahkan tidak perlu latihan, tapi bisa langsung ke seberang. Itu jauh lebih hebat dari aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "Yah, Paimon bisa terbang sih, tapi ... yang kamu bilang ada benarnya sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
