			"dialogs": [
				{
					"id": 150180801,
					"content": "Kita sampai. Selamat datang di Berlimpah Jaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Wow, tempat ini bagus banget! Bentuk panggungnya kayak kepala banteng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hehe, itu Arena Resonansi! Itu tempat kami mengadakan turnamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Makasih sudah bawa kami ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Sama-sama, bukan apa-apa kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Duh aku pengin banget bawa kalian keliling, tapi aku harus pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Oh, kamu keingat hal penting? Tadi kamu memang panik banget waktu para Hilichurl itu datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Semoga kami enggak ganggu kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Oh enggak sama sekali kok! Kita tepat waktu malah! Cuma ada hal penting yang harus kulakukan dulu ... Hal terpenting sehabis latihan — makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Rasa lapar akan membuatmu lelah, pusing, dan pikiranmu akan kacau. Efek perut kosong itu ... ngeri banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Aku benar-benar minta maaf, tapi aku harus makan ... yang kayak kemarin! Kalian juga makan dulu deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Nanti kita ketemuan di arena ya! Dadah, sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Dia langsung pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Gimana ngomongnya ya ... Dia memang santai banget, tapi terus bisa tiba-tiba serius menerjang ke arah bahaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "Itu namanya semangat masa muda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "Semangat masa muda? Eh kok tiba-tiba kesannya kita sudah tua ... Paimon rasa sih kita masih muda ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Ya sudah yuk kita lihat-lihat sekitar dulu? Nanti baru ke arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "Pemandangan dari atas sana pasti bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
