			"dialogs": [
				{
					"id": 760470101,
					"content": "Emm ... Aku sudah perhatikan kalian dari tadi, dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooh. Maksudnya nguntit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Ah, ti-tidak, bukan begitu ... Aku cuma sering lihat-lihat buku di sini, dan kebetulan lihat kalian berdua tertarik ikut investasinya. Aku ... tidak menyarankannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Ya, emang benar sih kami belum untung gede ... Tapi kenapa kamu enggak sarankan sama sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Karena aku curiga ... kita tidak mungkin untung besar. Bosnya masih punya banyak utang yang belum dibayar, jadi dia tidak mungkin mau ambil risiko rugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Temanku juga pernah jadi korban penipuan serupa, jadi sebaiknya kalian berdua berhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Wah, jangan-jangan beneran penipuan? {NICKNAME}, kita harus cari orangnya dan bongkar semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
