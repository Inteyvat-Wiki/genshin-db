				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "Wah, wah, ternyata pelanggan setia kami! Mau investasi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Aku dengar kabar burung kalau ... kupon investasimu ini investasi bodong ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Oh ya? Yakin kamu enggak cuma lagi kesal gara-gara rugi terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Coba pikir deh, mana ada bisnis yang cuma untung terus tanpa keluar modal? Kalau ada yang menang, pasti ada yang kalah. Dulu waktu aku masih di Kota Sumeru tuh ... *uhuk* maksudku ... Aku memang lagi sial akhir-akhir ini, tapi siapa tahu, kan? Nasib bisa berubah kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "\"Harapan\" cuma bisa dicapai mereka yang pantang menyerah. Investasi itu harus dilakukan terus-menerus baru bisa untung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Oke deh, nanti aku balik lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Hah, serius? Kamu nerima saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Tuh gawat, kan! Kami ... Betul, kami ini {NICKNAME} dan Paimon! Teman kami di Kota Nasha tuh ada banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "\"Teman\" ... Apa maksudnya- Sebentar, maksudnya \"teman\" yang itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "Hah? Eh, iya! Betul! \"Teman\" yang itu! Dan ada banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Apa?! Ke-Kenapa enggak bilang tadi?! Aku ... aahhh ... Gini deh. Maaf ya, beneran. Aku enggak akan ganggu kalian lagi. Nih, ambil saja semuanya. Tolong pergi, dan jangan datang beli kupon investasiku lagi ... aku juga tidak mau jual ke kalian lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Kamu pikir aku gampang dibodohin, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
