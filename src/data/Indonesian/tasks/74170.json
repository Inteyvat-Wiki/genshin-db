			"dialogs": [
				{
					"id": 741700213,
					"content": "Jadi Kuisel tuh siapa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Aku juga tidak tahu. Tidak ada nama itu di Institut Penelitian Fontaine ... Mungkin lebih baik kalau memang tidak ada ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Seperti yang dia bilang, Kuisel itu cuma karakter saja. Semakin beda sama dirinya sendiri, semakin bagus, karena jadi kecil kemungkinan ada yang sadar itu dia. Tebakanku sih begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "Ck, tapi dia sudah banyak berubah selama bertahun-tahun ini. Aku sampai pangling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
