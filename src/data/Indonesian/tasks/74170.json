					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Oh, kalian sudah balik. Yah, aku juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Setelah laporanku diterima Institut, aku diminta mempelajari kecocokan area untuk dijadikan tempat pelatihan dan pengembangan, sambil terus melanjutkan pekerjaan menangkap kembali ubur-ubur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "Rasanya sudah tidak asing lagi. Aku ingat pernah ada masa ketika petugas administrasi sangat ingin melatih semua orang agar bisa menyelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Aku pikir sih itu sia-sia, tapi ya namanya kerja, namanya tugas ... Tempat ini juga agak aneh ... unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "Makanya, aku simpan replika suarnya di sini. Tenang, cuma tiruan saja kok. dijamin aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Target latihan sekarang adalah <color=#00E1FFFF>mengambil semua suar di dalam bangunan dalam batas waktu</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Mau coba? Ada hadiah partisipasi nih ... kalian kan termasuk membantu penelitian nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
