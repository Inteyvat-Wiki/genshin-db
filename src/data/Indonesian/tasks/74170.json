					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Kamu berhasil! Ujian ini tidak mustahil diselesaikan ya, aku bisa ajukan ke Institut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Sayangnya aku belum selesai cek aset. Jadi harus balik lagi deh nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "Tapi terima kasih atas bantuannya! Ini hadiahnya, hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
