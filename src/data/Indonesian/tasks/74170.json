					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "Bingung ya? Kayaknya dia ... memodifikasi alatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Jadi lebih mirip reruntuhan kuno yang disukai turis ... tapi lebih baik jangan bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "Barusan itu cuma opini pribadi ya, bukan mewakilkan pandangan Institut Penelitian Fontaine.",
