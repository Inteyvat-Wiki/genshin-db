					"id": 741700210,
					"content": "Nanti dulu deh ujiannya. Si Coutrot apa kabar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Ditendang dari Institut Penelitian Fontaine belum cukup buat bikin dia sadar. Dasar kepala batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Tapi tidak ada lagi yang dukung dia, santai. Dia sudah tidak bisa bikin gara-gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
