			"dialogs": [
				{
					"id": 760600301,
					"content": "Oke, ini deh. Gimana, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Yep, dia hepi banget tuh! Hehe, kira-kira kayak gimana ya hasilnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Wah, sudah beres lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus kayak yang sedih ya. Apa karena gambarnya? Lihat yuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Oke, Columbina ... jalan di bawah terang bulan sambil ngelihat ke langit malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Ah ... aku sedang melihat ke bulan sejati di balik langit palsu. Dulu aku memang sering melakukan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600310,
					"content": "Dulu? Oh, iya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Columbina terkurung di taman ini ... padahal, Nod-Krai adalah tanah kelahirannya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Ya, aku sering melihat ke langit sambil berandai-andai ... ada apa sebenarnya di Bulan Embun yang sejati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600313,
					"content": "Mungkin seperti di sini, penuh binatang kecil dan kehidupan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600314,
					"content": "Atau mungkin ... hampa. Tidak ada apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600315,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Kan bisa bawa teman juga dari sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ha ... pemikiran yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600318,
					"content": "Tapi ... karena bulan ada di balik langit palsu, sepertinya lebih baik tidak bawa siapa-siapa kalau mau \"bertualang\" ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600322,
					"content": "(Satu \"rumah\" tidak mengizinkan dia bebas bergerak ... dan satunya lagi, \"rumah\" yang dia tidak tahu apa-apa tentangnya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Maalaus dan yang lain bakal kangen terus sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Dan aku juga akan kangen mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600327,
					"content": "Tapi pada akhirnya, perjalanan itu memang hanya untuk diriku seorang ... begitu pula jawaban yang menantiku di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600328,
					"content": "Siapa tahu jawaban itu ... ternyata sesuatu yang sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600329,
					"content": "O-Oke, kalau gitu ... kami yang nengokin kamu ke sana! Bareng Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Ya. Mungkin \"pameran seni\"-nya bisa diadakan di bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600331,
					"content": "Ide bagus tuh! Pasti bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600333,
					"content": "Pasti bisa ya ... aku harap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600319,
					"content": "Eh, siapa tahu bulan juga punya makhluk imutnya sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Mm, semoga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600321,
					"content": "Dan kalau memang ada, aku harap ... makhluk-makhluk di sana mau menyambut kedatangan \"dewi\" mereka yang tiba-tiba dan tidak diperkirakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
