			"dialogs": [
				{
					"id": 760600101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Wah, itu bukannya si Maalaus? Dia habis nyari inspirasi lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Iya. Tapi anak-anak jadi seperti ini semenjak dia kembali ... seperti tenggelam dalam benaknya masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600104,
					"content": "Hmm, mungkin kali ini temanya dalam banget ... itu loh, kayak seniman yang tiba-tiba dapat pencerahan tentang \"hukum yang mendasari jalannya dunia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Maalaus sudah kasih kita banyak sekali gambar. Saking banyaknya, kayaknya sudah bisa dibikin pameran deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hehe, Paimon sudah enggak sabar ingin promosiin pelukis kecil kita sampai jadi terkenal! Tapi dengan seizin Columbina, tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hm? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600108,
					"content": "Yah, soalnya yang digambarnya kan kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh, itu sih bukan masalah. Dan idenya sepertinya menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Maalaus sudah mutusin tuh mau gambar apa! Ayo, kita lihat hasilnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Kali ini ... kasih warna yang dalam dan tenang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
