			"dialogs": [
				{
					"id": 3710101,
					"content": "Ada satu hal yang enggak kamu kasih tahu ke mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710102,
					"content": "Naga dan kristal itu bukan satu-satunya hal yang kita jumpai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710103,
					"content": "Aku mau melakukan investigasi sendiri dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "Jadi kamu juga ingat laki-laki berpakaian hijau itu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710106,
					"content": "Orang itu kelihatan sama seperti laki-laki di bawah sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710107,
					"content": "Warna hijaunya sama persis, benar-benar sebuah kebetulan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "Coba deh lihat! Iya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710109,
					"content": "Tapi ... tunggu sebentar ... Itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710110,
					"content": "Itu sih memang dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710111,
					"content": "Ya ... sepertinya memang dia sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "Apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710104,
					"content": "Kurasa orang itu bukan orang jahat.",
					"roleType": "TALK_ROLE_PLAYER",
