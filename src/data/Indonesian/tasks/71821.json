			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flash-Fist Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "Sungguh tidak adil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210202,
					"content": "Apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Aku... ah, biar kumulai dari awal. Guruku baru saja mengembangkan teknik menendang yg baru, kuat sekali loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210204,
					"content": "Tapi dia bilang aku masih belum siap, dan dia bilang aku masih harus berlatih dasar-dasarnya terlebih dahulu. Dia bahkan tidak mau mengajariku teknik baru itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210205,
					"content": "Aku berencana untuk memanfaatkan Lantern Rite dan memberinya Lentera Xiao agar dia tidak terlalu keras padaku. Mungkin jika suasana hatinya berubah, hatinya akan tergerak lalu dia akan setuju untuk mengajariku gerakan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210206,
					"content": "Tapi aku tidak bisa menemukan Plaustrite di mana pun, jadi saat aku menemukan ada Lentera Xiao tersangkut di situ, aku ingin mengambil Plaustrite yang ada di dalamnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210207,
					"content": "Lalu kamu melihat apa yang terjadi selanjutnya... Eh, sudahlah aku tidak layak mendapatkan Lentera Xiao itu. Kamu bisa memilikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Flash-Fist Ling"
				},
				{
					"id": 718210208,
					"content": "Bertemu dengan para monster itu membuatku sadar bahwa dasar ilmu bela diriku masih kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flash-Fist Ling"
				}
			]
		},
		{
			"id": 7182103,
			"completionStepIds": [
				7182110
			],
