			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "Bagaimana, apa kamu sudah mengecek lokasi yang kutandai untukmu? Apa ada Lentera Xiao yang kamu ambil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210302,
					"content": "Ada tiga Lentera Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Terima kasih banyak. Akan sangat merepotkan sekali untuk mengumpulkan semua Lentera Xiao di tempat-tempat tersebut. Apalagi, pergi ke sana saja sudah cukup melelahkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210304,
					"content": "Dengan bantuanmu, aku bisa bersantai sejenak. Jadi tolong terimalah ini, kamu layak mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
