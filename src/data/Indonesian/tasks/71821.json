			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "Mengapa harus aku yang mengerjakan hal semacam ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "Pengembara, apa kamu tahu kalau Lentera Xiao tidak menghilang begitu saja setelah diterbangkan ke udara dalam acara Lantern Rite? Lentera-lentera itu harus kita bersihkan sendiri dengan tangan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Di satu sisi, lentera itu melambung dengan indahnya di udara. Tapi di sisi lain, benda-benda itu juga menyebabkan banyak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "Kalau kualitas pembuatan dari pembungkus lentera itu buruk, lentera itu bisa saja rusak di tengah jalan saat di udara. Akibatnya, lentera itu hanya akan menyisakan Plaustrite yang beterbangan ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Sebagian Lentera Xiao juga tertiup angin dan berakhir terjebak di suatu sudut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "Jadi kesimpulannya, satu — menyebabkan masalah keamanan, dua — berpotensi mengotori kota. Karena hal ini, Bagian Urusan Sipil biasanya mendelegasikan seseorang yang bertanggung jawab untuk membersihkan Lentera-Lentera Xiao tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "Baiklah, sepertinya tahun ini giliranku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Tapi jumlah Lentera Xiao yang diterbangkan saat festival benar-benar banyak sekali... Jika aku harus mengambil kembali mereka semua sendirian pada hari setelah festival berakhir, wah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Jadi satu-satunya cara yang layak adalah dengan melepaskan lentera yang rusak dan salah tempat secara bertahap, saat orang-orang mulai menerbangkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Walau demikian, aku sepertinya tidak bisa mengumpulkan mereka semua sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "Pengembara, jika kamu bersedia membantuku, tolong bantu aku untuk melihat apakah ada Lentera Xiao yang perlu didaur ulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "Aku sudah menandai lokasinya di peta untukmu. Terima kasih atas bantuanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
			"completionStepIds": [
				7182108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
