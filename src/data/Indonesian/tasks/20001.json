			"dialogs": [
				{
					"id": 200011001,
					"content": "Terima kasih banyak, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Aku ke sini untuk memetik buah dan menjualnya di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "Tak disangka perjalananku terhambat karena penghalang jalan, kemudian para biang onar itu pun muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Baiklah aku akan kembali ke Mondstadt sekarang. Jangan lupa kunjungi tokoku jika kamu pergi ke Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Terimalah ini sebagai tanda terima kasih dariku. Segar sekali, bukan? Itulah kenapa Beatrice selalu membeli buah dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
