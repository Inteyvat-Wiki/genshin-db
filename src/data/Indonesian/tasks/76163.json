			"dialogs": [
				{
					"id": 761630101,
					"content": "Sonnet. Kalau dipikir lagi, beberapa tahun terakhir ini, kamu makin sering tinggalkan pekerjaan dan bermain dengan manusia diam-diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "Me-Memangnya kenapa? Pekerjaan kan bisa diserahkan ke para Utusan Rembulan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Karena tuan baru yang Kakak sukai mau mengirim bawahannya untuk menanggung beban pekerjaan kita, aku terpaksa menerimanya dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Lagian, Kak Canon juga kayaknya ikut bahagia tuh! Dia bahkan ikutan festival manusia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "... Itu bagian dari tugasku. Penghulu Utama mereka memanggil namaku, tentu aku harus menjawab panggilannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Hmm? Menyamar jadi gadis manusia biasa dan menari di depan patung dirimu sendiri juga termasuk pekerjaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "... Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "... Bukan berarti kalian harus saling panggil nama ... Sudahlah. Utusan Rembulan yang baru itu juga tidak keberatan membantu pekerjaan Sonnet ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Namanya Zibai. Tolong ingat nama orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "Kalau Zibai tidak keberatan, aku juga tidak bakal ngomel lagi. Tapi, Sonnet, sebagai Kehendak Bulan, dasar sihir untuk menjaga keberlangsungan dunia tidak boleh dilupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Bersiaplah. Aku akan berikan soal dasar tentang verifikasi isomer. Kamu tidak boleh turun ke bawah sebelum semua soalnya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Heh, kejam sekali. Seperti penjahat di novel orang-orang permukaan yang mau menangkap putri yang melarikan diri kembali ke bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "Iya tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "... Kan bulannya kamu sendiri, jangan bilang begitu dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}