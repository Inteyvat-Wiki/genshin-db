					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "*fuhh* Terima kasih banyak, tadi benar-benar hampir celaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "Makanya, cepat berlindung ke Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "Maaf, tapi aku masih belum bisa kembali. Meteorit yang jatuh dari langit ini... benar-benar fenomena alam yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "Dengan fenomena seperti ini, tidak heran kalau akan muncul badai lagi di laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "Aku harus tinggal di sini, karena kalau benar-benar ada badai yang akan terjadi, aku harus segera memperingatkan penduduk kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "Terima kasih banyak telah repot-repot datang ke sini. Aku akan lebih berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
				4112007
