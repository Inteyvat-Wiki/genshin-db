				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "Kamu sudah kembali, apakah semua orang sudah kamu peringatkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200702,
					"content": "Sudah, tetapi mereka tidak mau kembali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "Masih tidak mau kembali? Sebenarnya ada urusan sepenting apa sih, sampai tidak mau kembali saat kondisi bahaya seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200704,
					"content": "Benar-benar orang Mondstadt yang bebas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Ha, hahaha, benar juga. Memang orang-orang Mondstadt selalu hidup dengan bebas, tidak ada yang lebih bebas dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200706,
					"content": "Tapi justru di saat seperti ini, aku berharap mereka dapat membatasi kebebasan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200707,
					"content": "*huff* Sepertinya Knights of Favonius juga tidak sempat mengurusi hal-hal ini. Sudahlah, biar kupikirkan solusi lain, terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200708,
					"content": "Aku berharap semua orang akan baik-baik saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
