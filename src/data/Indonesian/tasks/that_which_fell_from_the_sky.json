			"dialogs": [
				{
					"id": 411200801,
					"content": "WAH! Kamu... oh, kamu bukan monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200802,
					"content": "Pergilah ke Mondstadt untuk berlindung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "Aku... Aku tahu! Aku juga sebenarnya sedang berusaha memperingatkan orang untuk pergi mengungsi ke Mondstadt, tapi aku sepertinya jalan terlalu jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200804,
					"content": "Apa yang kamu lakukan di sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "Aku... sedang istirahat, masa tidak boleh? Tidak perlu memedulikanku, cepat kembali ke kota Mondstadt dan berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200806,
					"content": "Tadi meteorit berjatuhan, sekarang monster berdatangan... Orang-orang yang masih berani berkeliaran di luar pasti ada yang salah dengan otaknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200807,
					"content": "Masih ada orang yang berkeliaran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "Awalnya aku ingin mencari suster Vind untuk memperingatkannya... Maksudku, suster yang selalu berada di sekitar Stormbearer Point itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200809,
					"content": "Aku sudah pergi ke Stormbearer Point tapi tetap tidak menemukan suster Vind, lalu aku coba berkeliling lagi untuk mencarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200810,
					"content": "Memang aku sedang sial, aku bertemu dengan segerombolan monster ganas. Aku akhirnya berhasil kabur dengan susah payah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200811,
					"content": "Setelah berputar-putar sekian lama, ternyata aku malah kembali lagi ke Stormbearer Point, dan masih tidak menemukan suster Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200812,
					"content": "Ah, semoga saja suster Vind sudah kembali ke Mondstadt dengan aman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200813,
					"content": "Baiklah, aku akan kembali ke kota Mondstadt. Kalian juga jangan berlama-lama di sini, situasi sekarang sangat kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				}
			]
		},
