			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "Sekarang bukan saatnya untuk meneliti, kita harus segera mencari tempat berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Sudah berapa kali kubilang, aku tidak akan melewatkan kesempatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200303,
					"content": "Pergilah ke Mondstadt untuk berlindung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "Kenapa kamu kembali lagi? Ini bukan saatnya kabur. Batu-batu meteorit yang berjatuhan ini adalah kesempatan emas kita untuk masuk lebih dalam ke Thousand Winds Temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200305,
					"content": "Masuk lebih dalam ke Thousand Winds Temple?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Kata Patchi, kalau meteorit itu jatuh menghantam Thousand Winds Temple, mungkin jalan menuju ke altar bagian dalam akan terbuka... atau mungkin membuka jalan ke suatu tempat. Dengan begitu kita bisa masuk menjelajahinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Tapi sepertinya itu hanya imajinasinya saja... Kalau batu meteorit itu benar-benar jatuh ke sini, kita berdua tidak akan sempat melarikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Lebih baik kita berlindung dulu. Kalau ternyata benar ada meteorit yang jatuh dan membuka jalan baru di Thousand Winds Temple, bukankah kita hanya perlu kembali ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "Bagaimana kalau ada orang lain yang mendahului kita? Kalau kamu mau pergi, pergi saja sendiri, aku akan tinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200310,
					"content": "Kamu... Ah, sudahlah. Pengembara, maaf tapi sepertinya kami masih akan tinggal di sini terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Jangan khawatir, kalau ada bahaya yang mengancam... Ak, aku akan mengatasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Oh iya, beberapa waktu yang lalu ada seseorang bernama Schuster yang melewati tempat ini. Dia kelihatan sangat ketakutan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Setelah dia meminta air kepadaku, dia segera bergegas lari ke kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Tapi... dia malah berlari ke arah Stormbearer Point, bukan ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Aku takut dia sampai lupa arah karena terlalu takut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Pengembara, tolong kamu pergi mencarinya terlebih dahulu di daerah Stormbearer Point. Dia pasti akan celaka kalau bertemu dengan monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Aku akan tinggal di sini dulu dan menemani Patchi. Kami pasti akan baik-baik saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
