			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "Aku berharap semua orang akan baik-baik saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Apa yang kamu khawatirkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "Hai pengembara. Kamu juga pasti sudah melihat batu meteorit yang berjatuhan itu, kan？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "Meskipun kota Mondstadt sangat beruntung karena tidak kejatuhan meteorit sama sekali, tetapi keadaan di luar kota pasti sudah sangat kacau. Aku sangat mengkhawatirkan orang-orang yang berkeliaran di luar sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "Pengembara, apakah aku boleh meminta bantuanmu untuk memperingatkan orang-orang di luar sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "Kalau mereka mau, silakan minta mereka untuk berlindung di kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "Kamu bisa bertanya kepada Lynn untuk mengetahui siapa saja yang masih ada di luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Kemudian, cobalah untuk membujuknya berlindung di kota Mondstadt juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "Sekarang bukan waktu yang tepat untuk mencoba \"menantang kekuatan alam\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Mengapa kota Mondstadt aman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Mungkin karena faktor keberuntungan. Tapi kelihatannya, kota Mondstadt memang cukup aman untuk saat-saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "Setidaknya... masih lebih aman daripada di alam liar sana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
