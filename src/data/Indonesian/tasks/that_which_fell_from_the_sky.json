			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "\"Menantang kekuatan alam\" ya... kedengarannya cukup menarik buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Tolong berlindung di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Berlindung? Ah, kamu tidak perlu mencemaskanku. Aku selalu berwaspada. Percayalah, aku akan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "Kamu sendiri kenapa masih berkeliaran di luar sini? Ayo cepat kembali ke Mondstadt. Jangan sampai kamu tertimpa batu meteorit itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Tentang orang-orang di luar sana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "Orang-orang yang masih ada di luar sana? Masih cukup banyak jumlahnya, kenapa kamu bertanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Ingin menyuruh mereka berlindung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Oh, ternyata begitu... Sepertinya aku melihat tugas ini di papan pengumuman Adventurers' Guild, aku juga sudah memperingatkan banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Orang-orang yang masih berada di dekat kota Mondstadt seharusnya sudah masuk ke dalam kota untuk berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "Tetapi karena kita kekurangan orang, sepertinya di luar sana masih ada banyak petualang yang masih belum diperingatkan. Bantuanmu akan sangat berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Biar kuingat-ingat, orang-orang yang masih berkeliaran di luar ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "Ah, aku ingat! Patchi dan Doolan masih ada di daerah Thousand Winds Temple sana. Aku sudah memperingatkannya tapi mereka bersikeras melanjutkan penelitian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "Masih ada suster Vind, dia dulu sering pergi ke Stormbearer Point. Adventurers' Guild sudah mengutusku untuk mencari dia beberapa kali, tetapi aku masih belum menemukan dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "Sepertinya itu saja, tolong beri tahu mereka untuk segera berlindung di dalam kota Mondstadt ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "Kalau aku, aku akan menyiapkan makanan dan kebutuhan sehari-hari. Setelah itu aku akan berkeliling lagi di sekitar kota, aku berharap bisa mengajak lebih banyak orang untuk masuk ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Aku hanya berharap mereka tidak pergi ke tempat yang terlalu jauh. Kalau mereka ada di pelosok, perjalanan pulang ke sini juga akan semakin sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "Suster Grace sangat khawatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Oh, ternyata suster Grace... Sebenarnya tugas ini juga sudah ditempel di papan pengumuman Adventurers' Guild, aku juga sudah memperingatkan banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Orang-orang yang masih berada di dekat kota Mondstadt seharusnya sudah masuk ke dalam kota untuk berlindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "Tetapi karena kita kekurangan orang, sepertinya di luar sana masih ada banyak petualang yang masih belum diperingatkan. Bantuanmu akan sangat berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
