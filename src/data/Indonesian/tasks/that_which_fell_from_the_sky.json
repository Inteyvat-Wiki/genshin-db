			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "Ah? Ternyata Pengembara, apa yang sedang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "Sebenarnya kamu ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Maaf jadi merepotkanmu mencari, aku harus bergerak ke sana kemari untuk meneliti permukaan laut... Jadi ada masalah apa kamu mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Cepat pergi ke Mondstadt untuk berlindung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "Berlindung? Oh, maksudmu berlindung dari meteorit-meteorit itu ya. Aku tahu, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200406,
					"content": "Ha, hati-hati! Ada monster! Di sekelilingmu ada monster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4112006,
