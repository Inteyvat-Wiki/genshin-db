			"dialogs": [
				{
					"id": 207432001,
					"content": "Apakah kamu sudah membersihkan jalanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Bagus sekali, sekarang bisnis kilang anggur bisa berjalan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Sejujurnya, aku seharusnya melaporkan masalah ini kepada Tuan Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Tapi lagi-lagi dia menghilang. Aku sudah bertanya ke mana-mana, tapi tidak ada yang tahu dia di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde mengatakan \"Tuan Diluc pergi untuk mengurus masalah pribadi\", tetapi dia menolak untuk mengatakan apa-apa lagi. Dia bahkan tidak terlihat khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*huff* Ya sudahlah. Aku akan berbicara baik-baik dengannya begitu dia kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
