			"dialogs": [
				{
					"id": 207431001,
					"content": "Kalau bisnis anggur tetap tutup untuk waktu yang lama, bagaimana aku menghadapi Tuan Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431002,
					"content": "Pengembara, bisakah kamu membantuku berbicara kepada Tuan Diluc kalau kamu bertemu dengannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431003,
					"content": "Dari dulu dia tidak begitu peduli dengan bisnis kilang anggur, seharusnya bukan masalah baginya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		},
