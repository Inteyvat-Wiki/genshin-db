				},
				{
					"id": 733420204,
					"content": "Tanda Apaosha memang sudah hilang, tapi Bunga Sunyata masih belum pulih dari pencemaran, dan masih sangat rapuh ....",
					"roleType": "TALK_ROLE_NPC",
