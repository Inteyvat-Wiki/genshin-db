			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Cepatlah pergi, sebelum tukang makan gratisan itu kelaparan hingga terjadi hal buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Kenapa kamu harus memasak untuknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Kalau kamu mau tahu, itu semua karena dia kesepian. Di pelabuhan Liyue ini, dia hanya mengenalku seorang. Dan dia hanya berani meminta makan denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030404,
					"content": "Apa alasannya? Aku sendiri yang rela memberinya makan. Sudah puas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Ditambah lagi, kalau aku tidak memberinya makan, dia mungkin akan berbuat bodoh lagi di Dihua Marsh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030406,
					"content": "Kenapa kamu masih di sini? Berhenti berlama-lama dan cepat ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
