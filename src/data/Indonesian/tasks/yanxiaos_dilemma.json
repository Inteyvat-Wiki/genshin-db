			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Huh, bisa-bisanya dia tidak tahu malu, terus makan dan minum gratis selama ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Aku? Aku sedang memasak untuk seseorang yang makan gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030104,
					"content": "Luar biasa sekali. Dia menghabiskan waktu dengan melakukan apa saja yang dia mau, dan bahkan tidak menawarkan bantuan di penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Setiap hari kerjaannya hanya pergi memancing, tapi hasil tangkapannya hanyalah ikan-ikan kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Kalau tidak ada aku, dia pasti sudah mati kelaparan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Sudahlah, percuma membicarakan dia lagi. Dia tidak akan bisa mendengarnya. Kalaupun bisa mendengarnya, dia akan berpura-pura tidak mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Kalau kamu ada waktu, bantulah aku mengambil beberapa bahan makanan. Bahan makanannya sudah tidak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Tidak usah banyak-banyak. Aku hanya perlu satu <color=#00E1FFFF>Jueyun Chili</color> dan satu <color=#00E1FFFF>Lotus Head</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Segera bawakan ke sini setelah kamu menemukannya ya. Aku ingin segera memasaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Ada banyak bahan makanan di sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Bahan-bahan makanan tersebut dibeli dengan uang dari bosku. Apa kamu pikir dia akan membayar bosku uang makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Bahan-bahan makanan ini dibayar dengan uangku sendiri... Huh, dia berutang banyak denganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Sudahlah, cepat pergi dan cepat kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
