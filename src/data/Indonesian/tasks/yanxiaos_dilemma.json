			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Tunggu sebentar di sini. Aku akan membawakanmu makanan setelah selesai memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Ekspresi apa itu? Aku tidak mungkin membiarkanmu bekerja tanpa bayaran. Apa yang harus kamu dapatkan akan aku berikan, jangan cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Baiklah, kamu berikan makanan ini kepada tukang makan gratisan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Namanya <color=#00E1FFFF>Jiangxue</color>. Dia selalu memancing di tepi sungai. Kamu akan mengenalinya dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200304,
