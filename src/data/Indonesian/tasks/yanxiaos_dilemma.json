			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "Apa kamu sudah mengantar makanannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Sudah, dia bilang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Huh, tukang makan gratisan itu pasti lagi-lagi ucapkan terima kasih, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Telingaku sudah kebal mendengar ucapan terima kasihnya bertahun-tahun ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030605,
					"content": "Lebih baik dia bekerja menghasilkan uang daripada menghabiskan waktu untuk mengucapkan terima kasih dan memancing ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030606,
					"content": "*ckckck* Untuk apa aku mengatakan hal ini kepadamu. Ini adalah imbalanmu. Sekarang kamu bisa kembali ke kesibukanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
