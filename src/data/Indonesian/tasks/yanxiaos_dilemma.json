			"dialogs": [
				{
					"id": 220030701,
					"content": "Loh, kenapa kamu masih di sini? Lebih baik kamu segera kembali sebelum koki yang tidak sabaran itu menggila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "Kenapa dia memasak untukmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Kami... berteman. Kami sudah saling kenal cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Uh, aku pernah pergi sekali ke Dihua Marsh. Aku telah melakukan hal buruk yang sepatutnya aku kerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "Di seluruh Liyue, hanya penginapan itu yang mau menampungku. Koki itu memberiku makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Aku tidak akan melanjutkan ceritanya. Ceritanya cukup panjang, kamu lebih baik menggunakan waktumu untuk hal yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "Kamu lebih baik segera kembali ke sana. Koki itu bukan tipe orang yang sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
