				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "Eh? Kamu mencari aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030502,
					"content": "Ini dari Yanxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "Aku baru saja bertanya-tanya dari mana aroma lezat ini berasal. Kemampuan memasak koki satu ini benar-benar bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030504,
					"content": "Terima kasih telah membawakan makanan ini. Saat kamu kembali ke sana, tolong bantu aku ucapkan terima kasih kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
