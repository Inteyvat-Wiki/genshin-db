			"dialogs": [
				{
					"id": 220030201,
					"content": "Apa kamu sudah menemukan sayurannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030202,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "Kamu sebaiknya cepat mencarinya. Kalau tidak dia bisa kelaparan hingga terjadi hal buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
