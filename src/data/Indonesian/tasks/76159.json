					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "Sudah mau pergi? Hei, Barbie! Kamu masih punya banyak barang yang belum kami berikan ke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "... aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "Apakah kami datang ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Tidak, waktu kalian tiba sesuai dengan \"ramalan\" Barbie. Tapi kukira kalian akan datang lebih telat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Tapi, sebelum kita ke topik utama, gimana kalau kalian makan dulu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "A-Apa Barbeloth juga meramal kalau kita datang sambil kelaparan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "Tidak, tidak. Hanya saja pendengaranku lebih bagus, jadinya bisa dengar suara perut Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*krucuk krucuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#E-Eh! Perut Paimon bunyi buat mewakili perut {NICKNAME}! Kita semua udah laper banget sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "Siapa sangka steak-nya sudah habis di sana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Tenang saja, aku tidak akan membiarkan tamu yang datang jauh-jauh kelaparan. Ayo, aku sudah menyiapkan banyak kue dan biskuit untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Kamu dan Paimon dengan senang hati makan kue dan biskuit, juga menenggak banyak teh. Tapi anehnya, tidak peduli seberapa banyak kalian makan dan minum, teko tehnya selalu setengah penuh, dan di piring selalu ada sepotong kue dan biskuit yang baru ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Pa-Paimon sudah enggak kuat makan lagi, kenapa makanannya enggak habis-habis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "Apa pesta teh para penyihir juga seperti ini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Iya dong! Pesta teh kan harus ada banyak makanan penutup dan teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Tentu saja, makan terlalu banyak itu tidak menunjukkan keanggunan penyihir. Jadi biasanya, teko hanya terisi setengah penuh, dan di piring hanya ada sepotong biskuit atau kue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Paimon enggak mau makan lagi, sudah kenyang banget .... Kita langsung lanjut ke topik utama saja yuk? *sendawa* Ups, sori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Oh, kalian ke sini untuk menyerahkan \"tugas\" yang diramalkan oleh Barbie, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Kamu kan sudah tahu semuanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Tidak, tadi aku dan Barbie bahas hal lain. Dia bilang karena adanya perubahan besar di bulan, menyebabkan ramalan airnya menyimpang, jadi dia harus kembali berlatih untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Jadi, selama masa pelatihannya, akulah yang akan menggantikan dia untuk mengawasi \"tugas\" kalian, dan sekalian membantunya menulis \"tugas\" baru di kamus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Eh? Kamu bisa minta orang lain buat gantiin tanggung jawab hal seperti ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Nicole memang hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Aku sama sekali tidak ingin melakukannya! Tapi sebelum Barbie dan Alice memberitahuku, mereka sudah memasukkan \"tugas spesial\"-ku ke dalam kamus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Meski aku ingin menghapusnya dan terus mengamati dunia dengan santai ... Alice masih harus menjaga perbatasan Teyvat, sementara Barbie harus melatih ramalan air-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia tidak bisa kembali, apalagi Rhinedottir ... semua penyihir punya tugas masing-masing. Jadi, untuk sementara ini, aku yang akan mengawasi \"tugas\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Ternyata Hexenzirkel sesibuk itu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Iya, aku bahkan tidak tahu sudah berapa lama kalian tidak mengadakan pesta teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "Tapi intinya, setelah aku menyelesaikan \"tugas\" khusus itu, ceritaku juga akan dimasukkan ke dalam kamus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Setelah itu, aku bisa mengamati dan membimbing semua orang .... Jadi, {NICKNAME}, Paimon, ceritakan \"tugas\" kalian padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Oh iya, karena ini tidak termasuk sebagai ramalan, melainkan cerita yang dibuat oleh Barbie dan Alice sepuluh menit yang lalu, kurasa kalian tidak akan bisa menemukan informasi yang berguna dari kamus itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Eh, benar juga, Nicole! Kami ada lihat sebentar sebelum ke sini, tapi instruksinya pendek banget. Cuma ada dua kalimat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole akan melakukan tugasnya.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Baiklah, kalimat di awal seharusnya ditulis oleh Barbie, tapi aku yakin kalimat terakhir pasti ditulis oleh Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Ya sudah kalau begitu, ayo kita mulai \"tugas\" kali ini. Biar aku pikir-pikir, mau ke mana dulu ya....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Tunggu, kamu sudah tahu maksud mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Eh? Oh, tadi Barbara sudah kasih tahu semua yang harus kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "Yang dimaksud dengan \"memenuhi tanggung jawab\" adalah aku harus pergi ke lokasi tugasnya untuk melihat situasinya dan melakukannya \"tugas lapangan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Tunggu! Emangnya boleh begitu? Sama sekali enggak ada kesan \"ramalan\" lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Tidak. Tentu saja, semua yang diucapkan Barbara kepadaku itu kuanggap sebagai \"ramalan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "\"Tugas\" ini ditulis oleh Barbie. Dia hanya membalikkan halaman sampai akhir, dan memberitahuku akhir ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Itu sih langsung kena spoiler dong jatuhnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Aduh, ramalan dan spoiler itu tidak ada bedanya, kan? Ayo, ikuti aku, kita pergi dulu ke ... harusnya tidak apa-apa kalau kita ke sini dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Eh? Sekarang? Tunggu dulu, kita mau ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "Dalam sekejap mata, kalian tiba di tepi tebing ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "Berarti perjalananku sia-sia saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "Tidak sia-sia kok! Kamu yang harus menyampaikan tugasnya secara langsung, dan \"formalitas\" ini sangat penting. Kalau tidak ada bagian ini, tentu saja tugas itu sendiri mungkin tidak bisa terwujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Sudah, sudah, ayo, ikuti aku, kita pergi dulu ke ... harusnya tidak apa-apa kalau kita ke sini dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Aku tidak mengerti arti kalimatnya sama sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"Dia tidak akan membiarkanmu bekerja dengan sia-sia!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Itu saja yang ditulis di buku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Kalau dihitung-hitung, jumlah kalian banyak juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "Kamu bahkan bisa melakukan hal semacam ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Jangan-jangan tadi Nona Barbeloth juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "Lain kali aku harus bawa Varesa ke sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "Maksudmu gadis dari \"Berlimpah Jaya\" Natlan itu ya? Alice memang pernah bilang, dia adalah gadis kecil yang sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Kalau dia datang, kita harus meletakkan tiga ... eh, tujuh piring di depannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "Kita sudah makan salad banyak, tapi kayak angin saja yang masuk ke perut ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Dia juga bisa meramal rasa lapar ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "... di waktu yang salah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
