						761590604
					]
				},
				{
					"id": 761590604,
					"content": "Pantas saja Alice tiba-tiba mencariku untuk mengambil kuncinya. Dia bilang mau buat satu ruang minum teh .... Aku sudah bilang kalau aku sudah punya ....",
					"roleType": "TALK_ROLE_NPC",
