				{
					"id": 761590608,
					"content": "Kalian pasti pernah mengikuti Seelie, kan? Hanya saat Seelie kembali ke Seelie Court, \"panduan\" itu baru berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590609
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590609,
					"content": "Jadi, untuk mengakhiri \"tugas\" ini dengan jelas, Barbie dan Alice membangun Seelie Court di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590610
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590610,
					"content": "Hanya dengan cara ini, aku bisa memasukkan ceritaku ke dalam cerita semua orang tanpa mengganggu \"tugas\" lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590611
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590611,
					"content": "Tapi Nicole kan bukan Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590612
					]
				},
				{
					"id": 761590612,
					"content": "Ah ... em. Yah, bisa dibilang mirip sih. Karena dulunya kita semua kan malaikat. Tapi bukan itu intinya, yang penting adalah makna simbolisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590613
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590613,
					"content": "Sama seperti menulis novel, asalkan garis besarnya sudah benar, pasti akan ada cara untuk memoles detail-detail ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590614
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590614,
					"content": "Pokoknya, asalkan aku bisa duduk di atasnya, tugas ini seharusnya sudah selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590615,
					"content": "Tapi ngomong-ngomong, ceritanya hanya bisa ditulis seperti ini untuk sementara ... andai saja ada Anya, mungkin aku bisa memikirkan cerita yang lebih singkat dan cerdik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590616,
						761590617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590616,
					"content": "Oh begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590618,
					"content": "Hei, tentu saja bagian ini juga harus ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590619,
					"content": "Itu peti hartanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590620,
					"content": "Itu peti hartanya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590621
					]
				},
				{
					"id": 761590621,
					"content": "P-Paimon tiba-tiba merasa \"tugas\" ini sangat masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590622,
						761590623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590622,
					"content": "Jadi ini yang dimaksud memoles detail-detail ceritanya ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590624,
					"content": "Benar! Sepertinya kerja kerasku tidak sia-sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590625,
					"content": "*uhuk* Sepertinya ceritaku sudah dimasukkan ke dalam kamus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590626
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590626,
					"content": "Kalau begitu, misi kali ini sampai di sini saja. \"Tugas\" kalian ke depannya juga akan dipimpin oleh seorang pembimbing resmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590627,
					"content": "Emm ... tugas-tugas berikutnya juga bakal dapat peti harta lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590628
					]
				},
				{
					"id": 761590628,
					"content": "Oh, itu tergantung tugas yang dibuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590629,
					"content": "Kalau bisa, aku juga ingin mengubur peti harta karun di pertengahan misi dan menempatkan berbagai petunjuk di sepanjang jalan. Lalu melihat semua orang menggali peti harta karun di sepanjang jalan ... itu membuatku senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590630
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590630,
					"content": "Tapi Barbie terus mengawasiku. *huff* Sepertinya aku tidak ada kesempatan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590623,
					"content": "Ternyata garis besarnya memang penting!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590617,
					"content": "Kukira ini berakhir kalau peti hartanya sudah muncul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590606,
					"content": "Tapi kenapa dia kasih kamu Seelie Court?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590607
					]
				},
				{
					"id": 761590603,
					"content": "Ada Seelie Court yang besar sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590604
					]
				}
			]
		},
