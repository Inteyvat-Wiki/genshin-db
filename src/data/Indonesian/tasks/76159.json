				]
			},
			"dialogs": [
				{
					"id": 761590201,
					"content": "Dalam sekejap mata, kalian tiba di tepi tebing ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590202
					]
				},
				{
					"id": 761590202,
					"content": "Oke, kita sudah sampai. Lokasi Seelie Court ini lumayan juga. Lihat di seberang sana, itu tempat mulai tugasmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590203,
						761590204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590203,
					"content": "Seelie Court?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				},
				{
					"id": 761590205,
					"content": "Benar, aku hanya meminjam Seelie Court untuk sementara waktu agar bisa bergerak cepat. Benda ini terhubung dengan Ley Line, dan biasanya tidak ada orang yang menggunakannya, jadi sangat berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590206,
					"content": "Ditambah lagi, aku dan para Seelie dulunya adalah malaikat, bisa dibilang mantan rekan kerja. Mereka tidak akan marah kok kalau aku meminjamnya sesekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590207,
					"content": "Sepertinya tidak ada orang lain di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590208
					]
				},
				{
					"id": 761590208,
					"content": "Masih belum waktunya. Dalam waktu singkat, seorang penyair akan menyanyikan lagu pujian, memanggil kembali seribu angin yang berkeliaran di masa lampau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590209,
					"content": "Jangan-jangan tugas ini buat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590210
					]
				},
				{
					"id": 761590210,
					"content": "Jangan terburu-buru. Dalam waktu dekat, kamu akan menjadi melodi dalam lagu pujian itu, seribu angin akan menyelimuti tubuhmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590211,
					"content": "Tapi sebelum itu, mari kita biarkan nyanyian itu tertidur dengan tenang .... Ayo, kita pergi ke tempat berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590212,
						761590213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590212,
					"content": "Tempat ini kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590214,
					"content": "Iya, aku membacanya dari kamus. Dilihat dari hasilnya, kamu dan Lord Barbatos memainkan lagu yang bagus. Satu-satunya kekurangannya adalah ... tidak ada satu pun nada yang terdengar oleh Barbie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590215,
					"content": "Waktu Alice dengar soal ini, topinya hampir jatuh karena ketawa. Ehem! Ayo kita ke lokasi berikutnya! Ke lokasi berikutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590213,
					"content": "Aku pernah bermain musik bersama Venti di pulau yang jauh di sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590204,
					"content": "Jangan-jangan kamu pinjam ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				}
			]
		},
