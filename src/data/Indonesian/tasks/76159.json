			"dialogs": [
				{
					"id": 761590301,
					"content": "Ini Wolvendom? Sepertinya tidak ada tempat yang cocok untuk mengerjakan tugas di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "Ini adalah Seelie Court terdekat. Tidak masalah, tempat mulainya juga sudah tidak jauh kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "Wah! Sejak kapan serigala-serigala itu datang? Ah ... kami enggak bermaksud jahat kok, kami juga kenal Razor ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Kawanan Serigala"
				},
				{
					"id": 761590305,
					"content": "Serigala-serigalanya sudah pergi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "Apakah anak itu masih belum datang? Mungkin kita datang terlalu cepat lagi. Namun, selama dia bersekutu dengan \"lupical\", anak itu selalu menang tidak peduli siapa musuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Kawanan Serigala"
				},
				{
					"id": 761590309,
					"content": "Kenapa mereka balik lagi? Apa mereka dengar kita? Kalau Razor ada di sini, dia pasti ngerti apa yang dikatakan serigalanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Iya, tapi selain itu, dia masih harus tahu lebih banyak lagi selain bahasa serigala saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Tempat ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "Iya, Razor sudah menang dalam pertempuran sengit yang harus dia hadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "Kurasa selama dia bersekutu dengan \"lupical\", anak itu akan selalu menang tidak peduli siapa musuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Kawanan Serigala"
				},
				{
					"id": 761590316,
					"content": "Para lupical-nya juga pasti berpikir seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Oke! Tempat ini juga sudah selesai diperiksa. Aku lelah sekali, ayo kita pulang dan istirahat dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Wah! Sejak kapan pintunya muncul?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "Kenapa ada tempelan kertas di atasnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "Sepertinya ditulis Alice. Coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "\"Terima kasih atas kerja kerasmu sebagai pembimbing. Ayo pulang dan minum teh hangat!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "\"Catatan: Ada kejutan di dalam pintu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "Pulang? Tunggu sebentar, kenapa pintunya kelihatan familier? Jangan-jangan pintu itu terhubung ke—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole mendorong pintu dan membawa kalian masuk. Kemudian, kalian menyadari bahwa kalian berada di dalam sebuah ruangan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Gaya tulisan ini kok rasanya familier ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Aku pernah bertarung dengan Razor di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "Jangan-jangan tugas ini buat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
