			"dialogs": [
				{
					"id": 750970201,
					"content": "Iya, aneh. Jadi kamu enggak dapat kekuatan elemental dari Patung the Seven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "Ih! Patungnya kenapa sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "Mungkin sudah terlalu lama enggak dirawat. Maklum, patung tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Tapi waktu kamu pegang, dia kan masih NYALA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "WOI! Ayo dong, Patung the Seven ... gimana sih, masa enggak jalan? Kerja yang benar lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "Paimon enggak tahu lagi ... gelap. Entah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "Mungkin Natlan-nya saja yang agak lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Hmm, memang sih Natlan nih dekat dan terus-terusan kena kontaminasi Abyss ... apa mungkin karena itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
