			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hah? Ini perasaan Paimon saja atau memang Patung the Seven di Natlan agak aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Bukannya harusnya ... lebih intens gitu waktu pertama dipegang? Kayak ada suara \"swishhh\" gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Eh, menurutku sih normal ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Memang agak aneh sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hmm, gimana ya Paimon ngomongnya ... sebelumnya tiap kali kamu sentuh Patung the Seven itu kayak ada hubungan yang kuat gitu sama patungnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Kali ini, rasanya kaya mencet tombol doang. Cuma nyala saja gitu. Sudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Benar, benar! Sebelumnya, waktu kamu sentuh patungnya, pasti ada kekuatan elementalnya. Tapi kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Kerasa enggak kekuatan Pyro-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Kamu mencari kekuatan itu di dalam tubuhmu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Hmm ... enggak ada sama sekali ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Kok jadi makin aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(Tidak ada perasaan membara seperti yang kamu bayangkan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "Sebenarnya suara \"swishhh\" itu aku yang bikin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Oh! Jadi kali ini kamu lupa bikin suara \"swishhh\" gitu ya? Ya sudah, lain kali jangan lupa lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "Kamu pikir Paimon bakal percaya?! Kalau gitu sih tiap kamu sentuh Patung The Seven mending bikin suara sendiri yang beda-beda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
