			"dialogs": [
				{
					"id": 750970301,
					"content": "Hehe, gitu dong! Hubungan sama Patung The Seven-nya stabil lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "Berarti masalah sebelumnya itu gara-gara ada si jahat di Kerajaan Malam, ya? Susah juga jadi Patung The Seven ya ... Kerja bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "Ya walaupun kekuatan buat resonansi sama elemen Pyro bukan kamu yang kasih juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "Iya, dapatnya pas bertarung bareng Archon Pyro ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "#Iya, Paimon tadinya takut banget loh ... Tapi ternyata {NICKNAME} jauh lebih kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "Pokoknya kita sudah basmi semua monster Abyss-nya deh, patungnya juga sudah balik normal lagi sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
