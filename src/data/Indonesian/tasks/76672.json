			"dialogs": [
				{
					"id": 766720101,
					"content": "Misi selesai! Sekarang kamp ini terlihat seperti kamp baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720102,
					"content": "Ya. Renovasi benteng juga sudah selesai. Baik monster atau musuh dengan niat jahat, siapa pun yang menyerang pasti akan sulit menembus pertahanan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720103
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720103,
					"content": "Mercusuar ini punya persediaan bahan bakar untuk setengah bulan, artinya kita bisa bertahan sampai bantuan datang kalau ada serangan besar-besaran dari Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720104,
					"content": "Sudah memikirkan sejauh itu, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720105
					]
				},
				{
					"id": 766720105,
					"content": "Haha, aku cuma ... merasa lebih baik selalu siap kalau ada hal buruk terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720106,
					"content": "Tapi gimana pun, sekarang kamu bisa istirahat. Sudah beres semua, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720107,
					"content": "Benar, makanya aku mau pulang dulu. Soalnya sudah lama tidak bertemu Pak Tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720108,
					"content": "Pulang? Oh benar juga ya. Kamu udah lama di sini, Paimon sampai lupa kalau kamu itu dari Piramida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720109,
					"content": "Bagaimana kalau kalian ikut? Kalau tidak keberatan, aku ingin mengundang kalian ke tempatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720110
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720110,
					"content": "Kami sudah mengatur gerobak makanan di sini sesuai saranmu, Paimon, tapi tetap saja masak di rumah lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720111
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720111,
					"content": "Oh, jadi kamu mau masak yang enak-enak nih? Hehe, kalau begitu Paimon terima deh, tawaranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667202,
