				]
			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "Lakkaberry Krumkake, Smoked Fish Steak, Berries and Fried Meat, dan Nightwatch Soup ... Hehe, banyak banget makanannya. Ukuran Paimon juga nyaris kebanyakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720203,
					"content": "Hmm ... aku masak sesuai porsi pasukan saat makan malam. Jadi ... ya, mungkin agak kebanyakan untuk bertiga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720204,
					"content": "Tapi jangan khawatir, pelan-pelan saja. Aku sebentar lagi harus ke tempat Pak Tua, kamu silakan saja di sini dulu sampai gelap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720205,
					"content": "Tidak sangka kamu pintar masak begini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "Yah, dulu aku sering masak untuk semua orang sebelum dapat posisi sekarang. Cuma belakangan ini memang tidak ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720209,
					"content": "Penduduk Piramida datang dari berbagai penjuru dunia, jadi selera makanan mereka juga beragam. Karena itu, penting untuk belajar berbagai jenis masakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720210,
					"content": "Tapi karena aku tidak tahu selera kamu, jadi aku masak sedikit dari semuanya. Kalau ada yang kamu suka, bilang saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720211,
					"content": "Kalau Paimon suka, aku juga suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "Maksdmu apaan? Dengar ya, Paimon udah ngincar Berries and Fried Meat itu, jangan coba-coba loh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720213,
					"content": "Haha, kalian tidak perlu berebut. Aku bisa buat lagi kok. Tidak baik kalau rekan tim sampai kelaparan, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720216,
					"content": "Orang bisa bilang apa saja, tapi ekspresi wajahnya saat menikmati makanan yang mereka suka tidak akan bohong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720217,
					"content": "Bagiku, tidak ada yang lebih membahagiakan daripada melihat mereka tersenyum dengan gembira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720218,
					"content": "Aku akan lakukan apa pun untuk tetap buat mereka tersenyum, baik itu tugasku sebagai Lightkeeper atau tukang masak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720219,
					"content": "Mungkin bagimu ini terdengar sepele, aku tahu, tapi ini benar-benar harapanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720220,
					"content": "Hei, jangan merendahkan diri gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "Benar banget! Enggak mungkin orang-orang di sekitarmu enggak berterima kasih atas apa yang kamu lakuin. Mereka malah pasti akan marah kalau dengar kamu rendahin diri begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720223,
					"content": "Selain itu, mereka juga harus antri di belakang kami berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720224,
					"content": "Hehe, terima kasih. Baiklah, aku tidak akan bicara hal lain selain tentang makan malam. Silakan makan, selamat menikmati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720221,
					"content": "Kinerjamu sudah top banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "Kalau kamu yang masak, aku pasti suka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "Heh, tidak perlu memuji begitu. Malah justru bikin aku makin ingin cari masakan yang paling kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720206,
					"content": "Tenang, serahin ke Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "Tentu dong! Haram hukumnya sia-siain hasil usaha orang lain! Tapi Paimon enggak nyangka loh, Illuga pintar masak seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}