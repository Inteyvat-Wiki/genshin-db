			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(Waktu aku lewat tembok sinar itu, rasanya sekujur tubuh ini membeku.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Perlindungan Patih Malam tidak sampai ke sini. Dingin dan gelapnya mencekik, mengerikan, hanya terdengar ratapan dan pilu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Sudah berapa lama jiwa-jiwa yang ada di sini disiksa begini? Dan masih berapa lama lagi sampai semuanya ... berakhir?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Ah? Ada orang ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Tanah air kita tinggal kenangan, tapi api peperangan masih membara hingga hari ini. Sudah lama berlalu sejak tetes darah penghabisan kita jatuh ke tanah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220706,
					"content": "Bertahanlah, prajurit-prajuritku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220707,
					"content": "(Kenapa ada The Captain? Ngomong apa dia?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Akan tiba harinya, ketika aku membawa kalian semua ke tanah yang dijanjikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Captain\""
				}
			]
		},
