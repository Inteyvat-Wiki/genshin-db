			"dialogs": [
				{
					"id": 50220801,
					"content": "#Pagi, {NICKNAME}! Semalam mimpi buruk ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "Paimon dengar loh kamu gelisah banget pas tidur tadi. Mungkin kamu deg-degan karena mau terjun ke pertempuran terakhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(Mimpi? Ya ... memang agak samar sih.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Semuanya buram. Mau diingat-ingat malah jadi sakit kepala ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "#Sudah, jangan dipikirin deh, {NICKNAME}! Hari ini kita mau ketemu Mavuika kan!",
