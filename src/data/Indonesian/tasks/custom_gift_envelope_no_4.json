			"dialogs": [
				{
					"id": 715360101,
					"content": "#Selamat Hari Lantern Rite, {NICKNAME}. Aku sudah dengar tentang kamu yang bantu Dehya bikin Kartu Ucapan. Cantik sekali hasilnya, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Urusan di desa sudah beres semua ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Sudah, berkat Dehya dan yang lain juga. Jadi tenang karena tetap ada yang jaga desa selagi aku tak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Manfaatin waktu ini buat santai sejenak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Siap. Dehya bilang besok-besok dia mau pergi ke Desa Qiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Katanya pemandangan di sana bagus, terus tehnya juga terkenal. Oleh-oleh buat orang di kampung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Aku juga mau mengikuti tradisi di sini dan bikin Kartu Ucapan buat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Tapi Dehya bikin jadwal kami padat sekali, entah bisa ada waktu atau tidak untuk Kartu Ucapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "Dehya bilang kamu pandai membuat Kartu Ucapan. Boleh ajari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Tentu saja boleh, sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
