			"dialogs": [
				{
					"id": 715360301,
					"content": "#Jadi begitu ya caranya ... Kartu Ucapan ini bagus sekali, terima kasih {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
