				},
				{
					"id": 715360302,
					"content": "Sekarang tinggal bikin beberapa lagi untuk teman oleh-oleh. Pasti orang-orang di desa suka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
