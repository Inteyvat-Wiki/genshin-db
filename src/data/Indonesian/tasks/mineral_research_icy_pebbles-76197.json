			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Dialog Bersuara",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Waktu aku masih berlayar di lautan, aku pernah mendengar panggilan entah dari mana. Orang lain bergeming, tapi aku sendiri langsung terpesona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Itu pasti suara dari dunia lain, aku juga pernah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Pada akhirnya, aku baru sadar kalau panggilan itu berisi impian yang tak pernah mencapai tepi laut. Atau bisa dibilang, kumpulan penyesalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Om harus bawa Icy Pebble deh. Lihat lubangnya di tengah, kamu bakal bisa lihat siapa yang panggil Om.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Tapi waktu itu, aku masih bocah muda dengan darah mendidih. Aku bahkan menganggap bahaya sebagai peluang. Jadi aku langsung menghampirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Mereka bilang lubang di tengah Icy Pebble itu pintu menuju dunia lain, tapi cara masuknya gimana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Setelahnya ... badai laut yang kuat merenggut semua kekayaanku, kehormatanku, dan keluargaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Petualangan yang tergerak oleh ambisi dan keingingan tak akan pernah berakhir baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, nyangkut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Sini biar aku bantu keluarkan. Lain kali jangan begini lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Kak Linnea! Kok sempat balik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Aku lagi kumpulkan Icy Pebble di sekitar sini. Kebetulan lihat kalian lagi ngobrol, jadi aku sempatkan buat menyapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Oh, kalau Kakak Linnea sih, jangan-jangan dia beneran bisa pakai Icy Pebble untuk buka pintu menuju dunia lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Mana bisa aku. Aku kan sudah pernah bilang, itu cuma legenda rakyat, tidak ada bukti kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Ugh ... kayaknya tidak bisa deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "Oh, rupanya kamu lagi dengarin ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ehem, tidak. Aku sudah bukan diriku yang dulu lagi. Sekarang aku sudah puas dengan hidupku, tidak ada lagi yang kuinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Begitu ya, sayang sekali. Kalau begitu, aku bantu Kak Linnea untuk kumpulkan Icy Pebble dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Oke, terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Berkat bantuan Auni, semua bahan berhasil terkumpul dengan cepat ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Terima kasih, tapi semuanya sudah kukumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Oke, kalau begitu aku akan ke Lembah Moley cari Kakek Moley dan lainnya. Dadah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
