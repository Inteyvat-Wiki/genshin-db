			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Ternyata masih perlu dijaga dengan baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "Kamu ... Oh, kelihatannya kamu Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Aku Yasmin, pelajar Amurta, aku di sini untuk menyelidiki Pohon Suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Usia Pohon Suci ini lebih lama daripada seluruh pilaf yang digabung dan ditangkap dengan tangan di Pelabuhan Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Pada saat yang sama Pohon Suci ini pun menopang Akademiya. Bisa dikatakan ia sama pentingnya dengan sayuran yang menjadi dasar dari Tandoori Roast Chicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "Perumpamaan macam apa ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Tapi kalau dia bermasalah, maka Sumeru akan menghadapi bencana besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Misalnya, bencana hama tanaman, belalang yang bentuknya lebih besar dari atap rumah akan keluar dari dalam pohon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Atau cabang pohonnya akan tumbuh tidak beraturan, akar-akarnya akan tumbuh keluar dari tanah seperti ombak besar dan menghancurkan semua rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Atau Pohon Suci ini akan menjadi layu dengan cepat, dan tumbang menghancurkan setengah kota Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "Se-Seharusnya enggak akan sampai begitu, kali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Oh, tentu saja, hingga saat ini, kondisinya sangat normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Tapi kalau dipikir-pikir, saat kamu pergi ke hutan untuk mengambil jamur, monster Fungus yang akan menyerangmu juga tidak akan memberimu aba-aba dulu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "Aku terus meneliti dan mengamati kondisi pohon besar ini untuk bersiap-siap andai terjadi sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Tapi seperti yang kamu lihat, meski pemikiranku selincah Dusk Bird, tapi stamina tubuhku lemah seperti Starshroom ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "Oleh karena itu, Pengembara, bisakah kamu membantuku untuk mencatat kondisi akar dari Pohon Suci ini di beberapa titik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Biasanya aku meminta petualang untuk menemaniku pergi, tapi mereka sedang sibuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Cara kalian para pelajar berbicara memang seperti ini ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Eh? Maksudmu perumpamaan -perumpamaan itu? Maafkan aku, cara bicaraku memang seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Banyak orang di Akademiya juga mengatakan hal yang serupa kepadaku, tapi aku tidak bisa langsung mengubahnya begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Kalau begitu tolong ya, aku tunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Paimon harusnya paham perumpamaan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Wow benar-benar pohon yang hebat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
