			"dialogs": [
				{
					"id": 230271101,
					"content": "Kamu sudah kembali, bagaimana dengan akar Pohon Suci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Menjelaskan kondisi akar kepada Yasmin ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "Oh, kalau di sana ada banyak tumbuhan yang tumbuh, berarti tanah di sana subur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "Akar Pohon Suci pasti bisa tumbuh dengan baik, harusnya untuk sementara waktu ini tidak akan muncul masalah yang serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "Masalah yang harus dikhawatirkan ... yaitu air di sekitarnya tidak terlalu bernutrisi, dan malah akan tumbuh banyak Fungus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "Oh, ini imbalan kalian, terima kasih atas bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "Harus minta Ladep dan Pharez untuk memantau konsentrasi elemen di sekitarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
