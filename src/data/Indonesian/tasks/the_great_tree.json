			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "Pengembara, kebetulan sekali. Kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270202,
					"content": "Apa kamu masih meneliti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Ya, Ladep dan Pharez bilang perlu mengumpulkan lebih banyak data, aku hanya bisa melanjutkan pekerjaanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270204,
					"content": "Tapi, tidak tahu bagaimana kondisi akar-akar tersebut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270205,
					"content": "Pengembara, kalau kamu sedang senggang, tolong bantu aku rekam kondisi akar-akar tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
