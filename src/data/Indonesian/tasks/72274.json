			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fatui Skirmisher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Agh. Tak disangka rencana kita bakal bocor. Sial sekali kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740202,
					"content": "Iya! Terus, aku dengar Master dipanggil buat kembali ke Snezhnaya, tapi operasi di Pulau Watatsumi masih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740203,
					"content": "Menurutmu apakah Master terlalu banyak bertindak sendiri? Dia bahkan tidak melaporkan soal operasi ini ke Lady Arlecchino, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740204,
					"content": "Iya. Ini semua idenya sendiri. Aduh aku jadi punya perasaan buruk soal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740205,
					"content": "Jadi menurutmu jika kita gagal, Master bakal menyalahkan kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Skirmisher"
				}
			]
		}
	]
