			"trigger": {
				"objectNames": [
					"Paimon",
					"Fatui Skirmisher",
					"Ronin: Anbu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Tempat ini sepertinya banyak rahasianya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Shh! Dengar. Ada orang yang lagi ngobrol di sebelah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "Hah. Tak disangka wanita itu benar-benar tak mau buka mulut. Aku tidak dapat petunjuk apa pun darinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740102,
					"content": "Jangan khawatir, Tuan. Interogasi adalah spesialisasi kami. Istirahat saja dulu. Kami akan urus hal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740103,
					"content": "Kita tidak punya banyak waktu. Master ingin tahu seberapa banyak dia tahu rencana kita, dan dia ingin tahu sekarang juga — atau kita bakal kena masalah juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740104,
					"content": "Aduh. Dia benar-benar deh ... sesuatu banget. Memang wanita itu melakukan apa sih sampai Master marah begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740105,
					"content": "Orang bernama Lyudochka itu adalah bagian penting dari rencana terakhir Master. Tapi wanita dari Shuumatsuban itu malah menangkapnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740106,
					"content": "Sayangnya, apinya belum menyebar saat kita masuk. Master yang bermata elang langsung mengenali Lyudochka dari bajunya, dan dia sadar kalau rencana kita sepertinya terancam gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740107,
					"content": "Seburuk-buruknya keadaan kita masih ada yang patut disyukuri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740108,
					"content": "Tapi kita tidak tahu seberapa banyak rencana kita yang diketahui wanita ini, atau apakah dia sudah memberi tahu orang lain di Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740109,
					"content": "Sepertinya Momoyo dikurung di sel bawah tanah. Kita harus menyelamatkan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7227402,
