						230420903
					]
				},
				{
					"id": 230420903,
					"content": "Tidak apa-apa, prosesnya barusan masih tidak sengaja salah. \"Parfum\"-nya jadi terbuang sia-sia deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420904
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420904,
					"content": "Sudahlah. Kamu berhasil mendapatkan bahan-bahannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420905
					],
					"speakerTitle": "Nermin"
