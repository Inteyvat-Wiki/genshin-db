			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "Selamat datang! Mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Tentang \"barang\" Nermin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Oh, yang itu ya ... sudah siap kok. Ini semua bahan-bahan parfum berkualitas, harganya juga tidak terlalu mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Nermin mau pakai semua ini untuk buat parfum, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "Duh, semangat itu boleh, tapi dia harus perhatikan kondisi badan sendiri juga lah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
