			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "Baguslah. Bahan yang dulu cuma tersisa sedikit. Kalau ditambah dengan yang kamu bawa kali ini, aku masih bisa coba buat beberapa kali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420502,
					"content": "Huff ... aku harus banyak baca catatanku lagi. Kali ini pasti berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420503,
					"content": "Oh ya, aku masih harus petik kelopak bunga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420504,
					"content": "Nermin mulai membuat parfum ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "Selesai! Aromanya lumayan ... dan juga tidak lengket ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420506,
					"content": "Harusnya ini termasuk berhasil, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420507,
					"content": "Kayaknya sih berhasil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "Ya! Aku sengaja membeli satu botol, biarkan aku masukkan parfum terlebih dahulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420510,
					"content": "Pengembara, ayo kita berikan parfum ini pada Raef, mudah-mudahan dia suka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420508,
					"content": "Setidaknya tidak gagal lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
