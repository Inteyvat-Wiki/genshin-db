					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Kalau begini, aku bisa kasih kejutan untuk Raef ... hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Kejutan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "Wahhhh! Kamu buat kaget saja, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "Aku kan datang dari depanmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Aku sedang melamun, makanya aku tidak sadar kamu datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "Pengembara, aku mau tanya deh sama kamu. Apa kamu pernah dengar yang namanya \"parfum\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Nenek Jawahir beri tahu aku kalau dia sering buat \"parfum\" sendiri sewaktu dia muda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "Aroma mereka bukan cuma bisa menutupi bau keringat pada badan, tapi ada beberapa parfum spesial yang bahkan bisa punya efek menyegarkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef kan selalu berjaga di depan desa, setiap hari, dia pasti kepanasan sampai seluruh badannya penuh keringat. Waktu dia pulang, dia selalu bilang dia sakit kepala gara-gara berjemur matahari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "Jadi, aku pikir, aku mau buatkan Parfum Mint untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Nenek Jawahir sudah tuliskan cara membuat parfumnya untukku, dia juga sudah bantu aku beli banyak bahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Tapi tidak kusangka, pembuatan parfum itu rumit sekali ... Cuma mengurus bahan-bahannya tanpa ketahuan saja sudah memakan banyak waktu. Belum lagi sudah berapa kali aku gagal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Kalau begini terus, Raef bakal tahu dong kalau aku lagi buat parfum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "Jadi, Pengembara ... Apa kamu bisa bantu aku siapkan beberapa bahannya? Harus diam-diam ya, jangan sampai ketahuan Raef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Ya kasih tahu dia saja, memangnya kenapa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Mana boleh! Ini kan kejutan yang sudah aku siapkan lama sekali, mana boleh kasih tahu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Bahan yang mau aku minta kumpulkan juga tidak banyak kok. Pertama-tama, cari saja Tuan Azalai dan ambil barang yang sudah kupesan. Terus, bantu aku ambil seember air, itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Ingat ya! Harus sembunyi-sembunyi! Jangan sampai ketahuan Raef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "Duh, ya sudah deh ... serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Kalau begitu, mohon bantuannya ya. Tenang, aku pasti akan siapkan imbalan yang sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
