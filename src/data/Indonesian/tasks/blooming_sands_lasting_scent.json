			"dialogs": [
				{
					"id": 230420801,
					"content": "Pengembara, kamu sedang apa? Mondar-mandir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Oh iya, akhir-akhir ini kamu sempat membantu Nermin mengerjakan sesuatu? Atau ... apa kamu pernah dengar berita tentangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "Rasanya akhir-akhir ini dia sibuk terus, tapi entah apa yang dia kerjakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420804,
					"content": "Dia ... dia sedang sibuk menanam bunga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "Oh ya? Tapi aku tidak melihat ada banyak bunga pot di rumahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420806,
					"content": "Dia ... dia sedang sibuk masak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "Hah? Jangan-jangan Hilmi dan lainnya memintanya untuk membuat \"Minty Bean Soup\" lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420808,
					"content": "Dasar anak-anak itu ... kalau ada waktu, akan kuurus mereka nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
