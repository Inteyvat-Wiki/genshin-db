				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "Nermin, Pengembara ... ada apa datang ke sini? Ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Bunga potnya bermasalah? Aku masih bertugas, nanti kalau sudah selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermin mau memberikan sesuatu untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Botol \"Parfum\" ini untukmu! Ini wangi Mint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "Awalnya aku mau buat wangi \"Zaytun Peach\", tapi tidak tahu kenapa parfumnya akan menjadi lengket setelah aku menambahkan Zaytun Peach ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "Te-Terima kasih, tapi untuk apa \"parfum\" ini? Mengusir serangga? Atau untuk menandai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Untuk menyegarkan dan menutupi bau keringat di badanmu, apa kamu tidak pusing menghirup bau keringat yang sangat kuat setiap hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Aku sudah biasa sih, justru kalau tidak tercium malah tidak terbiasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Ya sudah \"parfum\" ini tidak jadi untukmu, kamu kan tidak perlu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "Ugh, jangan! Aku hanya bercanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Cepat, cepat berikan \"parfum\"-nya padaku, aku sudah mulai pusing sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Ini ... oleskan saja di lenganmu, Nenek Jawahir bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "Aromanya harum, memang menyegarkan. Waktu dipakai terasa dingin juga, lumayan nyaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Hmm, ini adalah resep rahasia Nenek Jawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "Aku bisa membuat \"parfum\" yang berkualitas seperti ini berkat bantuan Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Aku tidak membantu banyak kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Maaf karena sudah banyak merepotkanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Ini untukmu, anggap saja sebagai imbalan. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "\"Parfum\" ini lumayan juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Eh ... Ne-Nermin, kok di bagian yang kupakaikan parfum jadi muncul banyak ruam ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
