				"points": []
			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "Kenapa kali ini bisa ada di Mondstadt ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740102,
					"content": "Honglang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "Pengembara! Kebetulan sekali bisa ketemu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740105,
					"content": "Situasi kali ini ... lihat pintu di sebelahku deh. Kamu pasti langsung paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740106,
					"content": "Domain aneh lagi ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "Betul sekali. Berkat bantuanmu di Domain sebelumnya, kami bisa dapat banyak data penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740109,
					"content": "Tapi sudah, segitu saja. Tidak ada info penting lain yang bisa didapat dari luar Domain tersebut. Bukan karena usaha Guild yang kurang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740110,
					"content": "Lalu waktu kami sedang bersiap mengirim lebih banyak orang, Domain itu tiba-tiba hilang. Padahal kami sudah kumpulkan orang-orang dari Guild cabang yang lain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740111,
					"content": "Dan Domain itu tidak ada kabar sejak saat itu. Dan barulah tiba-tiba saja Domain ini muncul di Mondstadt. Aku bisa datang tepat waktu karena dapat informasi dari rekan kami di Guild Mondstadt sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740112,
					"content": "Kalian sudah masuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "Tentunya. Mana mungkin hadiah seperti ini dibiarkan begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740114,
					"content": "Aturan di dalam Domain tidak beda jauh dengan yang dulu. Tetap bisa menciptakan sesuatu mengikuti desain orang yang masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740115,
					"content": "Tapi semakin jauh dijelajahi, kami mendapati kalau Domain ini sekarang bisa menciptakan \"musuh\" tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740116,
					"content": "Kami diserang, dan rasa sakit yang timbul BUKANLAH imajinasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740117,
					"content": "Gimana ya menjelaskannya ... Sama persis dengan pertempuran sungguhan, dan banyak petualang lain yang merasa ini teramat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740118,
					"content": "Tapi beberapa dari mereka menciptakan musuh yang terlampau kuat sampai tidak bisa dikalahkan sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740119,
					"content": "Eh, yang itu jangan dibahaslah. Kalau berkenan, mau ikut kami jelajahi Domain ini sekali lagi, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740120,
					"content": "Boleh, boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "Hahaha, bagus! Kalau ada kamu, semuanya pasti lancar jaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740122,
					"content": "Bahaya enggak ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "Kalau buat kamu sih, aman. Asal hati-hati saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740124,
					"content": "Kalau kamu ikut masuk Domain, aku yakin semuanya bakalan lancar jaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740107,
					"content": "Kayak yang dulu itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}