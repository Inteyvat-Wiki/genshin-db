						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "Oh ... Jadi Paman Cyrus belum menemukan ayahku, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
