					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Saat aku sudah menyelesaikan masalah yang sedang kuurus sekarang, aku akan pergi ke Dragonspine untuk memeriksa kondisi Joel dan memberitahunya tentang berita ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "Jadi tolong bantu aku untuk mengatakan padanya bahwa aku akan segera mengunjunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "Sepertinya akan sedikit makan waktu untuk menyelesaikan pekerjaanku ini. Ayo jangan membuatnya menunggu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "Apa kita benar-benar akan menemukan orang itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "Yah, tentu saja, tidak ada jaminannya sih. Aku hanya bisa bilang kita sudah melakukan yang terbaik.",
