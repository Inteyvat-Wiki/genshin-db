			"dialogs": [
				{
					"id": 708020201,
					"content": "Di area ini, hmm ... Apa kamu yakin, Pallad、",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Aku benar-benar yakin, Tuan Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020203,
					"content": "Apa kalian sedang mendiskusikan ayah Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "Ah, ternyata si Pengembara! Biar kutebak, pasti Joel yang mengutusmu ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Anak itu hampir setiap hari meminta orang untuk menanyakan kabar ayahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Tapi kali ini ... Kita punya berita baik untuknya, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Sebelumnya, kami sudah mengorganisir beberapa pelatihan spesial di Dragonspine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Mungkin lebih baik biar aku saja yang jelaskan sisanya, Tuan Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020209,
					"content": "Jadi, saat sedang melakukan latihan, aku terpisah dari jalur yang seharusnya karena ada badai es yang sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020210,
					"content": "Saat aku akan kembali ke jalurku, aku melihat bayangan yang samar-samar di tebing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020211,
					"content": "Kukira dia pasti petualang yang tersesat sepertiku, jadi aku berteriak kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020212,
					"content": "Sayangnya, sebelum orang itu sempat melihatku ... Teriakanku malah mengundang beberapa monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020213,
					"content": "Yah aku tidak tahu sih kalau kamu bagaimana, tapi aku tidak begitu percaya diri kalau aku bisa mengalahkan mereka dalam kondisi begitu, jadi aku buru-buru kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020214,
					"content": "Saat aku kembali, aku ceritakan hal itu pada Tuan Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020215,
					"content": "Jadi orang yang kamu lihat itu adalah ayah Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Kami juga tak begitu yakin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Bagaimanapun juga, setidaknya sekarang kita tahu bahwa ada *seseorang* yang terjebak di Dragonspine. Karenanya, aku merencanakan misi penyelamatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Entah orang itu adalah ayah Joel atau bukan ... Hanya takdir yang tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Bagaimanapun juga, aku sudah menggunakan seluruh kemampuanku untuk mengutus pencarian ke Dragonspine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Aku juga akan bersiap-siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020222,
					"content": "Aku akan ikut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Benarkah? Bagus! Kalau begitu ayo kita pergi bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020223,
					"content": "Aku akan membereskan para monster itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Bisa saja orang itu juga adalah petualang lain yang tersesat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
