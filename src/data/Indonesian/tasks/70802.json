			"dialogs": [
				{
					"id": 708020101,
					"content": "Apa aku benar-benar akan menemukan Ayah kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Ada kabar berita tentang ayahmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "Oh, ternyata kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Pallad bilang padaku kalau Paman Cyrus mungkin punya beberapa berita mengenai ayahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "Dia tidak yakin sih, tapi menurut Pallad, petunjuk terakhir sepertinya cukup menjanjikan, jadi mereka mungkin bisa menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "Aku ingin sekali pergi ke atas Dragonspine bersama mereka, tapi Paman Cyrus bilang aku sebaiknya tetap tinggal di kemah, dan mereka akan memberitahuku kalau ada berita terbaru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "Apa kamu bisa membantuku mencari Paman Cyrus dan bertanya padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Aku ... Aku takut kalau beritanya ... ternyata berita buruk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "Bagaimanapun juga ... tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Kenapa kamu tidak pergi sendiri saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
