					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "...Tidak boleh dibiarkan. Aku harus pergi dan menolongnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Guk, guk! Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Tenanglah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Tapi kamu kan Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Iya! Suka tidak suka kamu kan mewakili seluruh Yashiro Commission. Jadi kalau kamu pergi dan berbuat begitu, itu sih sama seperti kamu memproklamirkan kalau kamu dan Raiden Shogun sekarang sudah jadi musuh, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "Dan dengan melakukannya di publik begitu, kamu mungkin melibatkan banyak orang lain dari Yashiro Commission juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Tidak ada pilihan lain... Kita harus bergerak cepat — upacaranya akan segera dimulai. Aku tidak akan meninggalkan Thoma seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Dia temanku! Kalau memikirkan bahwa tidak berapa lama ini kita... makan hotpot bersama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Dia temanku juga. Aku akan menyelamatkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Kalau kamu sudah bilang begitu. Jangan buang waktu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "...Baiklah, aku akan... menunggu kepulanganmu di sini. Kembalilah dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Jangan khawatir, Ayaka. Nyawa teman kita sedang di ujung tanduk — kita pasti tidak akan gagal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
