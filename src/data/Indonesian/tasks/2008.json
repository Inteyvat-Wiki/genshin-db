				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "Aneh sekali... Biasanya tidak pernah sesunyi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080302,
					"content": "Guk, guk... guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080303,
					"content": "Thoma berbicara menggunakan perutnya lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080304,
					"content": "Thoma... Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080305,
					"content": "Guk! Guk! ...Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080306,
					"content": "Hei, kamu sudah boleh keluar... Paimon sudah bisa melihatmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080307,
					"content": "Huh, tidak ada balasan... Ugh, jadi dia di mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080308,
					"content": "Guk, guk, guk! Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080309,
					"content": "Heh? Kenapa Taroumaru gelisah sekali hari ini? Biasanya dia tenang sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080310,
					"content": "Halo, apa kalian berdua melihat Thoma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080311,
					"content": "Tidak, kami kira dia sedang bersamamu! Kenapa... jangan-jangan terjadi sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080312,
					"content": "Berarti yang kutakutkan benar-benar terjadi... Di perjalanan ke sini, aku mendengar kabar kalau Thoma ditangkap oleh Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080313,
					"content": "Aku meragukan kebenarannya, jadi aku datang ke sini. Nyatanya dia tidak ada di sini seperti janji kita, sepertinya kabar itu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080314,
					"content": "Raiden Shogun sedang mengadakan Upacara Perburuan Vision di Patung Omnipresent God hari ini, untuk memperingati Vision ke-100 yang berhasil dirampas di bawah dekritnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080315,
					"content": "Dan pemilik Vision ke-100 itu adalah... orang yang Vision-nya akan dirampas, sepertinya... adalah Thoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080316,
					"content": "Tunggu dulu... Jadi upacara yang kata Thoma sedang sibuk dipersiapkan oleh Tenryou Commission... adalah Upacara Perburuan Vision ini? Dan sasaran mereka adalah Thoma?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080317,
					"content": "...Sepertinya begitu. Shogun dan Tenryou Commission menganggap upacara ini sebagai sebuah titik pencapaian. Dengan Vision ke-100 ini, mereka ingin mengumumkan keberhasilan Dekrit Perburuan Vision hingga saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "...Tidak boleh dibiarkan. Aku harus pergi dan menolongnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Guk, guk! Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Tenanglah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Tapi kamu kan Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Iya! Suka tidak suka kamu kan mewakili seluruh Yashiro Commission. Jadi kalau kamu pergi dan berbuat begitu, itu sih sama seperti kamu memproklamirkan kalau kamu dan Raiden Shogun sekarang sudah jadi musuh, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "Dan dengan melakukannya di publik begitu, kamu mungkin melibatkan banyak orang lain dari Yashiro Commission juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Tidak ada pilihan lain... Kita harus bergerak cepat — upacaranya akan segera dimulai. Aku tidak akan meninggalkan Thoma seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Dia temanku! Kalau memikirkan bahwa tidak berapa lama ini kita... makan hotpot bersama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Dia temanku juga. Aku akan menyelamatkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Kalau kamu sudah bilang begitu. Jangan buang waktu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "...Baiklah, aku akan... menunggu kepulanganmu di sini. Kembalilah dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Jangan khawatir, Ayaka. Nyawa teman kita sedang di ujung tanduk — kita pasti tidak akan gagal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
