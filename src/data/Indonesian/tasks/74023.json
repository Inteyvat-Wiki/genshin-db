			"dialogs": [
				{
					"id": 740230301,
					"content": "#Halo Kak {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
						740230304
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230302,
					"content": "Kamu sudah berhasil rekrut orang baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230303
					]
				},
				{
					"id": 740230303,
					"content": "Aku ketemu beberapa anggota yang mau gabung, tapi masih harus disaring lagi untuk pastikan mereka memenuhi kualifikasi. Ini kan demi masa depan Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230304,
					"content": "Tidak perlu cepat-cepat pulang hari ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230305
					]
				},
				{
					"id": 740230305,
					"content": "PR-nya sudah kuselesaiin, jadi kupikir aku jalan-jalan sebentar sebelum pulang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Salsa"
				}
			]
		}
	]
