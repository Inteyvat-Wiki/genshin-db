			"dialogs": [
				{
					"id": 740230201,
					"content": "Hmm ... Paimon enggak tahan lihatin benda itu ... Paimon jadi keingat benda jelek yang waktu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230202,
					"content": "<color=#00E1FFFF>Kenapa ada Monumen Hydro yang dikubur di bawah tanah?</color> Paimon enggak ngerti ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230203,
					"content": "#{NICKNAME}, kita geserin yuk? Seperti yang diajarin Salsa!",
