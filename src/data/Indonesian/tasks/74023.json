			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa",
					"Ubu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "Fiuh, sekarang kelihatan jauh lebih oke. Salsa pasti bangga sama kita setelah lihat ini kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230102,
					"content": "Rampok! Ada perampok di siang bolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230103,
					"content": "Hah?! Rampok? Mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230104,
					"content": "Siapa lagi? Ya kalian lah! Sudah hancurin mahakaryaku, peti hartaku pun kalian ambil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230105,
					"content": "Ternyata benar ini kerjaan anggota Adventurers' Guild ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "Kerjaanku? Seharusnya aku yang tanya kalian lagi ngapain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230109,
					"content": "Jadi benda jelek ini \"mahakarya\"-mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230110,
					"content": "Sembarang! Apa maksudmu \"benda jelek\"? Kalian tidak pernah dengar seni instalasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230111,
					"content": "Kelihatannya pendidikan seni di Fontaine masih tertinggal jauh ... Oh, tapi sepertinya kalian bukan dari Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230112,
					"content": "#Karena kami memang bukan dari Fontaine. Nama Paimon ya Paimon, dan dia {NICKNAME}. Kami juga anggota Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230113,
					"content": "Kami adalah anggota organisasi jahat .... *hiks*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "Iya, tapi kami enggak perlu pakai seragam, jadi kami bukan orang jahat berbaju hijau! Asik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230117,
					"content": "Namaku Ubu, seorang petualang dan seniman instalasi. Lihatin kalian ngelantur begini, aku tebak kalian sering lakuin yang tidak jelas ... Aku relakan saja untuk kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230118,
					"content": "Eh? Sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230119,
					"content": "Apa? Aku perlu perbaiki karya ini, kalau kalian mau berterima kasih, yang cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230120,
					"content": "Aku tidak punya satu pun ucapan terima kasih, tapi ada banyak sekali yang mau kumaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230121,
					"content": "Salsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230122,
					"content": "Tidak apa-apa, Paimon, Kamu tidak usah takut kalau ada aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230123,
					"content": "Orang jahat berbaju hijau, kami sudah hancurkan semua jebakanmu! Berhenti merusak Fontaine kami yang indah dengan jebakan jahatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230124,
					"content": "Merusak? Bentar, \"hancurkan semua\"? ... Kamu hancurkan semua karya seniku?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230125,
					"content": "Umm, sebenarnya sih bukan hancurin ya ... Kami cuma geser sana sini biar cocok sama pemandangannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230126,
					"content": "Kalian ...! Memangnya bocah kecil dan orang awam tahu apa tentang seni! Seni instalasiku ... Kalian ubah karyaku jadi barang biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230127,
					"content": "Tapi memangnya itu seni? Paimon enggak tahu banyak sih, tapi apa kamu bisa sebut barang yang enggak kelihatan cocok sama pemandangan, seni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230128,
					"content": "Tentu saja. Cuma seniman yang bisa memutuskan apa itu seni. Karya yang dibuat oleh seniman ya wajar disebut karya seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230129,
					"content": "Siapa senimannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230130,
					"content": "Itu aku, Ubu, sang seniman seni instalasi yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230131,
					"content": "Kalau begitu, sebagai pendiri \"Aliansi Seniman untuk Menggulingkan Organisasi Jahat dan Melindungi Masa Depan Fontaine\", aku menyatakan benda ini bukan seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230132,
					"content": "\"Menggulingkan Organisasi-\" ... Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230133,
					"content": "Menggulingkan Organisasi Jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "Organisasi ini maksudnya Adventurers' Guild yang merusak pemandangan dengan ... um ... seni instalasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230136,
					"content": "Lagi ngaco ya, aku tidak pernah dengar aliansi macam itu. Oi bocah, kamu punya hak apa bilang karyaku bukan seni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230137,
					"content": "Aku pelukis, jadi aku juga seniman. Tentu saja punya hak bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230138,
					"content": "Hah? Lihat ya bocah, jadi seniman itu bukan main-main. Kamu tidak bisa ngaku jadi seniman karena ingin. Kamu harus kerja keras biar bisa diakui orang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230139,
					"content": "Jadi kamu ada hak apa manggil diri sendiri seniman? Karyamu, seni instalasi yang kamu bilang itu ... Jebakan jahat itu? Memangnya ada yang tepuk tangan pas lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230140,
					"content": "Itu karena terlalu banyak orang awam yang tidak ngerti keindahan karyaku. Seni yang sesungguhnya biasanya sulit dimengerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230141,
					"content": "Kamu harus mulai dari karya seni yang bisa dimengerti orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "Iya! Kalau enggak ada yang ngerti berarti seninya sudah terlalu dewa atau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230145,
					"content": "Tidak mungkin! Karyaku sempurna! Tidak ada yang salah! Kalian cuma tidak ngerti, orang-orang tidak ngerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230146,
					"content": "Sialan! Aku tidak akan menyerah! Lihat saja nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230147,
					"content": "Ubu lari terbata-bata ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "Keras kepala sekali! Tapi aku juga tidak akan menyerah! Masa depan seni Fontaine bergantung padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230149,
					"content": "Kita semua punya tujuan yang patut diperjuangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "Ini bagus kan? Harusnya sih iya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230143,
					"content": "Intinya, tidak ada yang ngerti sama sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "Kedengaran seperti karya gagal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230135,
					"content": "Intinya kita harus kalahkan kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "Halo, teman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "Paimon rasa enggak benar ah manggil teman kalau enggak tahu nama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230107,
					"content": "Bentar! Dia orang jahat berbaju hijau itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "Hah, perampok ini suka ngelantur ya! Hari apa ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				}
			]
		},
