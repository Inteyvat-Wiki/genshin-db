			"dialogs": [
				{
					"id": 751030801,
					"content": "WUAH, banyak banget ikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "Kak Pirang, jangan gerak! Itu umpan buat burung Flowcurrent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Wah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Iya! Aku dan Iwai lagi nungguin burungnya balik ke tepian. Memang lagi nganggur juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Wroo, wrooooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Iya, iya, Iwai. Anak baik harus bisa sabar! Jangan rusuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Ungg ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Intinya, kami tadinya datang ke sini buat main. Soalnya enggak ada lagi yang suka turun ke sini selain Paman Rongo ... ini markas rahasia kami! Semacam itulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Tapi beneran enggak nyangka hari ini bakal keduluan burung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Itulah kenapa aku sedia banyak ikan! Burung Flowcurrent tuh doyan banget ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Tapi kayaknya mereka enggak minat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Apa kita kejauhan gitu ya? Jadi bau ikannya enggak kecium. Duh, coba kalau mereka mau agak dekat ke tepian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Kalau Paman Rongo ada di sini, dia pasti bilang <color=#00E1FFFF>\"Hantam saja semua ke tepian!\"</color>. Tapi sayangnya aku dan Iwai enggak kuat kalau harus kayak gitu ... bisa-bisa malah kami yang kena hantam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hmm, gimana kalau kita yang turun, {NICKNAME}? Kalau bisa dihantam sampai ke tepian, siapa tahu mereka jadi sadar ada ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Ah, berarti \"Paimon\" tuh masih sepupuan sama burung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Bulat-bulat dan doyan ikan ... iya juga ya, mirip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "Hah? NGACO! Sudah, bahas yang betul saja! Mana, kamu belum berhasil mancing satu pun burung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
