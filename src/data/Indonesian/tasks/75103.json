			"dialogs": [
				{
					"id": 751030101,
					"content": "Wah, ikannya banyak amat! Kalian semua ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "Hmm? Oh, halo Kakak Pirang dan ... adiknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iwai dan aku lagi nungguin burung Flowcurrent balik ke tepian. Enggak ada kerjaan juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Kembali ke tepian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Wroo, wrooooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Iya, iya, Iwai. Anak baik harus bisa sabar! Jangan rusuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Ungg ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Intinya, kami tadinya datang ke sini buat main. Tapi enggak ada yang turun ke sini selain Paman Rongo ... ini markas rahasia kami! Semacam itulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Tapi beneran enggak nyangka hari ini bakal keduluan burung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Itulah kenapa aku sedia banyak ikan! Burung Flowcurrent tuh doyan banget ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Tapi kayaknya mereka enggak minat ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Apa kita kejauhan gitu ya? Jadi bau ikannya enggak kecium. Duh, coba kalau mereka mau agak dekat ke tepian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Kalau Paman Rongo ada di sini, dia pasti bilang <color=#00E1FFFF>\"Hantam saja semua ke tepian!\"</color>. Tapi sayangnya aku dan Iwai enggak kuat kalau harus kayak gitu ... bisa-bisa malah kami yang kena hantam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hmm, gimana kalau kita yang turun, {NICKNAME}? Kalau bisa dihantam sampai ke tepian, siapa tahu mereka jadi sadar ada ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Ah, berarti \"Paimon\" tuh masih sepupuan sama burung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Bulat-bulat dan doyan ikan ... iya juga ya, mirip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "Hah? NGACO! Sudah, bahas yang betul saja! Mana, kamu belum berhasil mancing satu pun burung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
