			"dialogs": [
				{
					"id": 700650101,
					"content": "Selalu ada orang yang menolak mendengarkan. Aku sudah bilang sekarang bukan waktunya mendaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Sabar dulu, Pak Mann. Kita bicarakan ini baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Tadi kami sempat ngobrol-ngobrol di Night Brew.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Begitu dengar aku mau naik ke Puncak Windrest, dia langsung menyeretku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Huffman, ada apa lagi nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Jadi gini, intinya Pak Mann berusaha mencegah orang naik ke Puncak Windrest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Kenalan dulu, ini Lipphart, dia petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "Yang kualami sangat menakutkan. Kalian yakin mau dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Toh aku memang tidak bisa ke mana-mana, jadi silakan saja. Anggap ini kelanjutan dari sesi minum dan membual tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Ada bahaya besar apa sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "Sanatorium itu berhantu! Serius! Aku lihat dengan mata kepala sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Wuah! Hantu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Kejadiannya tadi malam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
