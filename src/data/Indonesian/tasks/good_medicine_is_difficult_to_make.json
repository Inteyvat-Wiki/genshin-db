						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Masih ingat Maruf? Dokter Desa Aaru yang dulu pernah minta tolong kamu ambil resep ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Dia bikin obat, mencobanya, lalu muntah-muntah selama berhari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Katanya resep asli yang aku kasih tidak efektif, jadi dia \"perbaiki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Apa coba yang dia masukkan sampai jadi separah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "Duh, dia pasti berbuat sesuatu yang lain selain mengubah cara merebus dan jumlah bahan yang masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Dan ini bukan pertama kali. Maruf, kapan kamu belajarnya?",
