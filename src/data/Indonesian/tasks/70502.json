			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "Halo! Kamu si Traveler yang terkenal itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "Betul sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "Woi, jangan lupa sama PAIMON yang sama terkenalnya ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "Hehe, tentu saja. Yah, kebetulan kedai kami Angel's Share sedang mengadakan acara Jika Aku Menjadi Bartender. Mungkin kamu tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "Intinya, kamu boleh pakai semua bahan-bahan kami buat bikin koktail atau minuman apa pun yang kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "Asalkan kamu tidak buang-buang bahan, kamu bebas isi ulang minuman buatanmu sepuasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "Bebas isi ulang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "Terus, kamu juga akan dapat hadiah kalau tamu-tamu yang hadir puas dengan minumanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "WAH! Ada hadiah segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Daaan Paimon pun tergiur sudah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Di mana daftarnya??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "Yah, nama acaranya memang \"sekolah\" sih, tapi tidak wajib mengisi kehadiran juga kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "Lalu tidak usah langsung memutuskan begitu. Kalian boleh coba dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "Jadi gimana? Mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "Ah, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
