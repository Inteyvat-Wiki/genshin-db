					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Mmm, kamu cepat belajar ya. Ini enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "Paimon setuju! Ini maknyus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "Tapi yang barusan itu cuma latihan saja. Ketika bekerja, tamu-tamu kami sering punya permintaan khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Ada yang suka minuman yang sangat pekat, ada yang suka asam, mereka punya kesukaannya masing-masing. Menyesuaikan jumlah bahan pelengkap yang kamu pakai itu kuncinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "Paimon mau Caramel Pinecone, tambah gula ya, gelasnya yang paling besar. Tolong ya, makasih loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "Nah, kurang lebihnya sudah cukup jelas kan. Tapi untuk jadi bartender sejati, selain jago bikin minuman, kalian juga harus pintar ngobrol sama pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "Aku siap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Baiklah, kalau begitu kalian boleh pakai tempatku ini. Kalau ada pertanyaan, panggil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Fiuh ... kelasnya selesai. Eh sebentar! Mana Caramel Pinecone Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "Jadi kamu betulan mau ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "Aku suka banget ngobrol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
