			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Hai, aku kenal kalian. Mau minum apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Halo Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Halo Charles! Hari ini kami mau ikutan jadi bartender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Bartender? Oh, kalian sudah ngobrol sama Luka yah? Dia memang pintar promosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, kamu memang jagoan dalam mengurus pekerjaan-pekerjaan sulit. Tapi bikin koktail itu lain lagi ceritanya, kamu harus teliti dan punya sedikit bakat untuk mencampur minuman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Segala hal mulai dari perbandingan jumlah bahan dan teknik mencampurnya akan berpengaruh pada hasil akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "Jangan khawatir, dia koki yang hebat. Masak sama bikin koktail kan mirip-mirip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Baiklah kalau kamu bilang begitu. Oh iya, satu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "Di acara kami yang sebelumnya, ada murid yang sengaja mencampur tiga jenis alkohol keras. Hasilnya, satu gelas saja cukup untuk buat tamu kami tumbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "Berhubung pernah ada peristiwa seperti itu, kami putuskan untuk tidak lagi menyediakan alkohol untuk pemula. Mohon maklum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Bagus, berarti sudah jelas ya. Kamu akan belajar teknik dan cara-cara yang kamu perlukan sambil jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
