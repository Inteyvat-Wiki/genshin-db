			"dialogs": [
				{
					"id": 705310101,
					"content": "Permisi, apa Anda juga kemari untuk mengikuti Kejuaraan Raja Invokation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Kalau boleh minta waktunya sebentar, aku ingin menjelaskan tentang sebuah kegiatan yang diadakan Adventurers' Guild. Namanya \"Perjalanan Menakjubkan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Eh ... bolehlah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Terima kasih! Aku jelaskan dulu tentang dasar-dasarnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "Sederhananya, Adventurers' Guild sudah menentukan berbagai Titik Pemandangan di sekitar Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Temukan Titik Pemandangan ini dan cap Catatan Pelancong milik Anda di setiap lokasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Tantangannya dianggap selesai kalau Anda sudah menemukan setiap Titik Pemandangan dan dapat semua capnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Acaranya Adventurers' Guild banget ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hehe ... Kami memikirkan semua lokasi Titik Pemandangan yang ada dengan sangat saksama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Tapi ... ada beberapa yang lokasinya agak terpencil, dan mungkin saja ada monsternya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Untungnya, urusan begitu sih mudah saja kalau buat orang berpengalaman seperti Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "Nah, sampai situ dulu. Ini buku Catatan Pelancong-nya, silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Oke, silakan saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}