				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Kalian kok bisa sampai sini? Di sini tidak ada jalur kereta, tempatnya juga tinggi sekali tepat di pinggiran Veluriyam Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Jarang ada orang yang kemari, bahkan Idyia. Heh, kurasa dia juga tidak tahu ada tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Kalau di sini tidak apa-apa, kamu lagi ngapain dong, Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Aku cuma keluar buat santai dulu ... eh? Jangan menatapku dengan tatapan \"kamu lari dari rumah setelah bertengkar lagi sama Ferdinand kan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Benar kok, tidak bertengkar. Aku cuma keluar buat jalan-jalan saja. Yah, buat kesenangan pribadi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Kurasa kamu sekarang sudah tahu kalau \"Kereta Gedak-Geduk\" itu adalah ideku. Saat itu kupikir, bagus juga kalau ada benda yang bisa dengan mudah mencapai tempat tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Karena itu aku ... Jeroney terpikir tentang Kereta Gedak-Geduk dan jalur-jalurnya, semua ini karena aku suka langit dan ketinggian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Kedengarannya bodoh, kan? Aku ingat orang Inazuma juga punya pepatah \"hanya orang bodoh dan asap yang suka tempat tinggi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "Bisa terpikir membuat Kereta Gedak-Geduk saja sudah hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Tapi ini cuma ada di Veluriyam Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "... Lupakan, jangan bahas ini deh. Alasanku kemari sebenarnya buat mengamati langit berbintang di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Meski langit berbintang di Veluriyam Mirage seharusnya hanya pantulan dari langit berbintang di luar botol, itu sudah cukup indah bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Setiap malam ... asalkan bisa melihat langit berbintang ini, hatiku merasa tenang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Yang suka langit berbintang itu ... Jeroney kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Asalkan melihat langit berbintang seperti itu, tidak peduli siapa pun akan suka. Sayang sekali, andai saja di siang hari juga bisa melihat bintang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Lebih bagus lagi kalau bisa melihat tanpa perlu mendaki ke sini setiap hari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Tunggu! Itu mungkin banget loh! Paimon punya ide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Hah? Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Tinggal ambil foto saja kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "... Fo-foto? Kedengarannya sebuah alat yang canggih sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Iya, mendingan kita ambil foto langit berbintang buat Jeroney!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Kamu benar-benar bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Tentu saja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Tapi, enggak tahu deh di mana bisa memotret langit berbintang yang cantik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Di sini! Di malam hari, aku bisa melihat langit berbintang yang paling indah dari platform itu. Itulah kenapa aku datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Begitu ya? Oke! Tunggu saja foto dari kami, Jeroney!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Kurasa ini seru sekali kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
