			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney! Kami sudah balik~ Lihat deh foto ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "... Wow, betulan kelihatan sama seperti yang kulihat langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Kamu benar-benar mau kasih foto ini buat aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Iya, kan memang diambil buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Haha, terima kasih ... terima kasih yah, tidak disangka aku masih bisa melihat teknologi sehebat ini. Dengan teknologi seperti ini, mungkin bukan mimpi lagi untuk bisa melihat Kereta Gedak-Geduk di luar Veluriyam Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Sungguh langit berbintang yang indah. Andai saja saat itu sudah ada teknologi seperti ini, dengan begini ... dia juga bisa melihat langit berbintang ini kapan pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
