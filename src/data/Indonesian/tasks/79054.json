			"dialogs": [
				{
					"id": 790540401,
					"content": "Foto ya ... Tidak disangka sekarang ada benda ajaib seperti ini. Kalau begini juga bisa dengan mudah merekam pemandangan sepanjang perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Ada apa, {NICKNAME}? Apa kamu sudah mengambil fotonya? Aku sangat menantikan bintang-bintang yang akan kamu foto!",
