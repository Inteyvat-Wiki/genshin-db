				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "Tamu terhormat, mohon tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Terlepas dari detailnya, aku ingin meminta bantuan. Beberapa hari yang lalu, Dermawan Yu Huangyi dari Liyue mengirimkan sebuah barang langka, tapi sampai sekarang barang itu belum tiba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Aku curiga barang tersebut sudah diambil oleh penjaga wilayah ini. Kalau kamu melihat \"harta karun\" dari Dermawan Yu Huangyi, bisakah kamu membawanya kembali untukku? Tenang saja, kamu akan menerima imbalan yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Kami sudah kembali! Coba lihat, apa ini \"harta karun\" yang kamu bilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Ah! Terima kasih banyak, terima kasih atas bantuan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Kalau begitu, aku akan langsung membuka segelnya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "I-Ini ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Wah! Apa benda ini sudah mau meledak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Dermawan Yu Huangyi tidak akan menyakiti aku ... apa mungkin penjaga itu merebutnya dan mengubahnya menjadi bom?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Benar-benar memalukan, aku tidak tahu cara membongkar \"bom\" .... Kita tidak punya pilihan lain! Buang saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Jangan khawatir! Aku masih ingat ada seorang bangsawan dari Hyperborea yang pernah memberi tahu cara melempar \"bom\" yang suci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"Kamu harus menghitung sampai tiga, tidak boleh lebih, tidak boleh kurang. Empat adalah angka terlarang, dua tidak termasuk, dan lima sudah terlalu telat. Begitu hitungan mencapai angka tiga ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Sudah cukup jelasinnya, cepat lempar! Sudah mau meledak tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
