			"dialogs": [
				{
					"id": 110020701,
					"content": "Rasanya ada sesuatu yang kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020702,
					"content": "Apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "Ya, rasanya kurang \"boom shaka-laka\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020705,
					"content": "Iya juga, sepertinya memang kurang \"boom shaka-laka\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020706,
					"content": "\"Boom shaka-laka\"?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020709,
					"content": "Walau cara memasak Brook sangat tradisional, tapi kemampuan memasaknya tidak perlu diragukan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020710,
					"content": "Dia pasti akan menggunakan bahan-bahan makanan terbaiknya. Kalau ingin menang dari dia, aku harus membuat masakan yang menakjubkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020711,
					"content": "Misalnya seperti salad Sea-Serpent, tumis Qingxin, atau tumis jamur liar dengan cairan Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020712,
					"content": "Ca-cairan Slime dengan jamur?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020713,
					"content": "Hahaha, aku tahu kedengarannya aneh, tapi rasanya luar biasa enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020714,
					"content": "Lain kali aku akan membuatkannya untuk kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020715,
					"content": "Wah, aku sudah tidak sabar ingin mencobanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "Hehehe, rasanya dijamin tidak akan mengecewakan. Hanya saja penampilannya sedikit menjijikkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020719,
					"content": "Ya sudah. Aku baru saja ingat ada tempat yang belum pernah kukunjungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020720,
					"content": "Instingku mengatakan kalau ada barang bagus di sana. Ayo kita ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020717,
					"content": "Eh, tidak jadi deh kalau begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "Hah? Jelas-jelas enak sekali loh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020707,
					"content": "Paimon, kamu mengerti maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "Bahan-bahannya kurang mengesankan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
		}
	]
