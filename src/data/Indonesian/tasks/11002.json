			"dialogs": [
				{
					"id": 110020201,
					"content": "Seharusnya ada di sekitar sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020202,
					"content": "Apa kamu sudah memutuskan bahan yang mau dicari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "Tentu saja belum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Kalau begitu kenapa kamu begitu yakin bisa menang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "Memang gayaku begini. Kalau semuanya sudah diputuskan sebelum memasak, maka masakanku tidak akan ada rasa kejutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Hal ini sama juga dengan saat mencari bahan masakan. Kalau aku sudah tahu dari awal bahan apa yang perlu dicari, maka tidak akan ada rasa kejutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Cara kerja seperti ini apa tidak terlalu berisiko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Tenang saja, semua menu andalan di Wanmin Restaurant juga kudapat dengan cara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Kita lihat sekeliling dulu, aku akan memanggilmu kalau aku melihat bahan masakan yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100207,
