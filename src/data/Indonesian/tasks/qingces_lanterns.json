					"nextDialogs": [
						413312009
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312009,
					"content": "Eh tunggu, sepertinya kita harus menuliskan permohonan kita pada lentera... Jadi, kita tidak cukup hanya dengan memikirkannya saja.",
					"roleType": "TALK_ROLE_NPC",
