			"dialogs": [
				{
					"id": 413310301,
					"content": "Sepertinya kita masih memerlukan beberapa bahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 413310302,
					"content": "Biar kubantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "Eh? Oh, kamu bersedia membantu? Kamu datang tepat waktu! Aku dari tadi khawatir bahwa aku tidak akan bisa mendapatkan semua bahan-bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 413310304,
					"content": "Biar kulihat... baiklah, tolong bantu aku untuk mendapatkan tiga Raw Meat dan tiga Fowl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 413310305,
					"content": "Sementara itu, aku akan memikirkan cara untuk mendapatkan bahan-bahan lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Bai"
				}
			]
		},
