			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nenek Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413313701,
					"content": "Dengan kebersamaan kita sekarang di tempat ini, atmosfer dari festival ini sudah semakin terasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313702
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313702,
					"content": "Hehe, kalau begitu ayo kita terbangkan Lentera Xiao ini bersama-sama sekarang, sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313703
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313703,
					"content": "Kuharap semua orang sehat dan sejahtera senantiasa di tahun yang akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313704,
					"content": "Dan semoga impian para muda-mudi yang sedang berjuang dengan hidupnya dapat segera terwujud juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313705,
					"content": "Baiklah, Nenek Ruoxin... ayo kita segera santap makanannya sebelum dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "Nona Bai"
				},
				{
					"id": 413313706,
					"content": "Wow! Makanannya terlihat sangat enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 413313707,
					"content": "Nenek, kami pamit berangkat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Dasar kalian, anak-anak! Iya sudah, cepat kalian berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313709,
					"content": "Kamu tidak ikut pergi dengan mereka, Nenek Ruoxin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Aku? Santai saja, aku tidak buru-buru. Selain itu, aku masih ingin melihat-lihat Lentera Xiao ini beberapa saat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Oh iya, ini kuberikan untukmu, terimalah. Ini adalah tanda terima kasihku karena kamu sudah banyak membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Terima kasih, Nenek Ruoxin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "Sama-sama. Kamu masih terlihat muda, aku paham berjuang di luar bukanlah sebuah hal yang mudah, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Kalau tidak, mengapa kamu tidak tinggal di sini saja dulu untuk beberapa waktu supaya kita bisa sama-sama menikmati kemeriahan perayaan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Bukankah momen ini adalah saat yang baik untukmu melepaskan diri dari penatnya aktivitas sepanjang tahun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
		},
