					"Nenek Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "*huff* Lantern Rite sudah tiba lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Apa kamu memikirkan sesuatu, Nenek Ruoxin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "Pada saat Festival Lantern Rite berlangsung, semua harus meriah dan bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Tapi di Desa Qingce, para orang tua terlalu tua dan yang masih muda terlalu kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310205,
					"content": "Para pemuda yang pergi ke kota-kota besar ada yang sudah menjadi terlalu sibuk sehingga tidak punya waktu untuk pulang dan merayakan festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Atau mereka berada di tempat yang terlalu jauh sehingga tidak akan sempat untuk pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Lantern Rite adalah festival yang meriah, ini adalah waktu di mana semua orang harus berkumpul bersama untuk merayakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Aku paham itu tidak mudah bagi mereka tapi... *huff* bagaimana dengan acara festivalnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ah, sudahlah, tidak ada gunanya mengeluh begini. Sudah tidak mungkin merayakannya dalam kondisi begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Oh benar juga, jika kamu bersedia bisakah kamu membantu Nona Bai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Dia bilang dia ingin menyiapkan sebuah meja dengan banyak hidangan untuk semua orang dan menyiapkan semua itu pastinya membutuhkan banyak persiapan. Takutnya dia tidak bisa menyelesaikannya sendirian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Oh, terima kasih. Kamu baik sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Jangan khawatir, aku akan membantunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
