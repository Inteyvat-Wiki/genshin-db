			"dialogs": [
				{
					"id": 413311001,
					"content": "Ah, kamu sudah kembali. Kamu sudah bekerja keras, masih banyak yang harus dilakukan untuk menyiapkan festivalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413311002,
					"content": "Ini memang sudah seharusnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "Terima kasih, kamu baik sekali. Aku juga sudah berusaha untuk membuat beberapa Lentera Xiao untuk orang-orang di Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413311004,
					"content": "Jika kamu mau, kamu bisa menemuiku di dekat gerbang nanti malam. Kami akan menerbangkan Lentera Xiao dan merayakan festival bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413311005,
					"content": "Tapi siapa yang tahu ke mana semua anak-anak itu pergi sekarang... Ah, kakiku yang tua ini tidak mungkin bisa pergi untuk menemukan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Apa kamu bisa membantuku menemukan anak-anak itu? Aku yakin mereka pasti akan senang menerbangkan Lentera-Lentera Xiao tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 413311007,
					"content": "Dan pastikan kamu katakan pada orang-orang yang kamu temui di jalan untuk segera kembali ke desa... semakin meriah, semakin bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
