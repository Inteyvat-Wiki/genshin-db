						761200303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200303,
					"content": "Dia juga kayaknya senang— Wah, langsung ke kanvas tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200304,
					"content": "Hmm, kalau Paimon pikir-pikir lagi, lukisan-lukisan Maalaus ini kayak cerita soal kamu dari lahir sampai sekarang ya, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "Dan cerita itu belum berakhir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Yup! Lagi pula Paimon ingin lihat lebih banyak karya dari pelukis agung kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Oh, udah beres? Cepat seperti biasa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Coba Paimon lihat ... Oh! Ini cakep banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Paimon enggak tahu kalau Teyvat bisa terlihat seindah ini dari bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
					"content": "Hah ... sekarang aku paham kenapa Maalaus bilang kalau aku sudah berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200312,
					"content": "Hmm? Kenapa gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200313,
					"content": "Saat melihat lukisan ini, aku jadi ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200314,
					"content": "Saat aku duduk di bulan, memandangi Teyvat, aku berpikir tentang bagaimana selama ini aku selalu mencari \"rumah\" untuk diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200315,
					"content": "Tapi sekarang, aku tiba-tiba punya dua rumah, keduanya tempat yang begitu indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200316,
					"content": "Saat itu aku sadar kalau \"rumah\" itu mungkin ada di tempat apa pun yang menyimpan hal-hal dan orang-orang yang kamu sayangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200317,
					"content": "Pemikiran yang indah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "Terima kasih. Aku pikir setelah ini, aku mau lebih sering membawa kuuhenki ke bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200319,
					"content": "Kalian juga boleh datang ke \"rumah lainku\" kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
