			"dialogs": [
				{
					"id": 761200101,
					"content": "... Ini untukmu. Dengan begini bagianku sudah selesai, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200102,
					"content": "Eh, ini kanvas gambar. Tunggu, berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. Kalian datang tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Wah, ternyata Maalaus, Sang Pelukis Agung! Lama tak jumpa ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Jadi, apanya yang \"tepat waktu\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Aku baru saja ajak Maalaus ke bulan sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200108,
					"content": "Paimon iri banget sama caramu bilang itu ... santai banget, kayak cuma mau ngunjungin taman sebelah aja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Tapi, emangnya kamu ke sana ngapain sih? Cari inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Baru benar setengahnya. Kami juga pilih lokasi untuk \"pameran.\" Kamu ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200111,
					"content": "Paimon tahu kok! Pameran Dewi Bulan Maalaus! Jangan lupa ajak kami kalau sudah waktunya, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Ya, tentu saja. Selain itu, sepertinya Maalaus bisa merasakan perubahan kecil di sekitarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200113,
					"content": "Dia bilang aku sudah banyak berubah sejak kembali dari bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200114,
					"content": "Karena itu dia minta aku bawa dia ke sana, untuk lihat apa ada yang istimewa di tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200115,
					"content": "Heh! Seniman sejati memang hebat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Jadi, hal istimewa ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Aku juga tidak yakin. Aku sudah ajak Maalaus ke banyak tempat, tapi tidak ada yang bisa buat dia puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200118,
					"content": "Sampai aku bawa dia dekat ke pesawatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200119,
					"content": "Pesawat luar angkasa kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Tapi setelah aku ajak dia lebih dekat, ternyata dia tidak tertarik dengan pesawatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200122,
					"content": "Eh? Maksudnya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "~!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Huh, dia terbang ngitarin kamu, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. Dulu dia juga begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200126,
					"content": "Aku rasa dia sebenarnya tertarik melihat bagaimana reaksiku saat lihat pesawat luar angkasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200127,
					"content": "Gimana ... reaksimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Ya. Aku jadi ingat saat aku dan {NICKNAME} pergi ke sana bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200129,
					"content": "Kami duduk di atas kapal, memandang Teyvat. Dia tahu tentang kebenaran masa lalu, dan aku menemukan \"rumah\"-ku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200130,
					"content": "Hanya dengan memikirkannya saja sudah membuat hatiku damai ... atau mungkin tepatnya, bahagia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200131,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Ya, kamu benar. Ini semua perasaan yang tidak pernah aku rasakan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200133,
					"content": "Jadi, aku cerita ke Maalaus tentang kisah kami, termasuk apa yang terjadi setelah kami sampai di bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200134,
					"content": "Setelah itu dia terlihat sangat senang, seolah sudah menemukan inspirasi yang dia cari selama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200135,
					"content": "Ah. Jadi sekarang saatnya sang seniman agung nunjukin keahliannya, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Heh, dulu kamu enggak ajak Paimon ke sana, jadi Paimon juga penasaran apa yang akan dilukis Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "Lalu kita akan pakai apa untuk cat kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Kali ini pakai sesuatu yang istimewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200139,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus bilang dia mau cat yang eksklusif hanya punya kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200141,
					"content": "Eh ... maksudnya apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Aku rasa dia bicara tentang hal-hal yang akan mengingatkanmu pada perjalanan ini, apa yang kamu dapat dari perjalanan ini, dan kebahagiaan yang kamu rasakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200143,
					"content": "Tidak usah khawatir. Maalaus cuma ingin lihat dan rasain benda-benda seperti itu. Dia tidak akan pakai sesuatu yang berharga seperti cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200144,
					"content": "Kamu kasih apa ke dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Tanah dari bulan, dan kartu yang kamu kasih ke aku saat Malam Doa Rembulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761200146,
					"content": "#Oh, jadi intinya, harus sesuatu yang bisa wakilin petualangan ini, kan? Oke. {NICKNAME}, kamu yang pilih aja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Hmm, itu memang cukup istimewa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
