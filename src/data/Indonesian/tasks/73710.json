			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~ ♪♪~ ♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737100102,
					"content": "♫♫~ ♫~ ♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Pyro Sukacita"
				},
				{
					"id": 737100103,
					"content": "Haniyyah, Souka, kami sudah balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100104,
					"content": "Aku bisa mendengar suara langkah kaki \"Topi Gendang\" dan \"Pyro Sukacita\" dari kejauhan. Sepertinya kali ini kalian main dengan sangat puas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100105,
					"content": "Sejauh itu pun kamu bisa tahu kalau mereka lagi senang? Aku sampai sekarang bahkan belum bisa membaca emosi dari langkah kaki teman-teman Fungus kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100106,
					"content": "Sepertinya aku masih harus banyak belajar ... harus belajar terus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100107,
					"content": "Hehe, perjalanan kali ini terasa beda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100108,
					"content": "Main sama teman-teman Fungus kita lalu balik ke area sekitar \"Taman Fungus Kecil\", itu rasanya kayak pulang ke rumah dan makan setelah main seharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100109,
					"content": "Gimana kalau kita foto bersama sekarang? Paimon baca banyak banget jurnal perjalanan terkenal di The Steambird itu susun foto-foto dari perjalanan sesuai urutan waktunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100110,
					"content": "Aku jadi teringat setelah \"Bintang Kejora\" mengungkitnya, selama ini aku meluangkan waktu untuk merawat teman Fungus kesayangan aku, tapi tidak banyak mengambil foto bersama mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100111,
					"content": "Mmhmm! Kalian berdua benar-benar paham cara mengakhiri petualangan yang sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Pyro Sukacita"
				},
				{
					"id": 737100114,
					"content": "Oke, kalau gitu kita pakai Kamera Topi Gendang, pasang di tripod, dan ambil foto dengan pengatur waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100115,
					"content": "Nanti setelah Haniyyah dan Souka udah enggak terlalu sibuk lagi, kita semua bisa keluar main lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100147,
					"content": "Asyik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100116,
					"content": "Ngomong-ngomong, Topi Gendang memang pandai ambil foto ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100117,
					"content": "Paimon udah pilih beberapa foto bagus dan gabungkan dengan foto grup kita. Haniyyah dan Souka juga bisa lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100118,
					"content": "Ternyata kamu sudah memikirkan semuanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "Oh, Haniyyah dan Souka, Paimon bawa beberapa suvenir untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100121,
					"content": "Ini dia! Makaron yang belum sempat kalian coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100122,
					"content": "Aww! Aku cuma asal sebut, kamu ingat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100123,
					"content": "\"Bintang Kejora\" ... aku sangat terharu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100124,
					"content": "Agar aku tidak merepotkanmu lagi, aku harus memperbaiki kebiasaanku dan membuat rencana yang matang sebelum bepergian ... dan tidak bisa hanya di atas kertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100125,
					"content": "Kadang apa yang kita bilang saat obrolan santai itu adalah hal yang sebenarnya kita mau lho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100126,
					"content": "Kapan kamu beli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Waktu lagi foto-foto di Court of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100129,
					"content": "Waktu kamu lagi nikmati pemandangan bersama Topi Gendang, Paimon minta bantuan seorang penjual koran dan kasih sedikit upah sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100130,
					"content": "Tenang saja, Paimon juga belikan untuk kamu kok! Mana mungkin Paimon lupain kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100131,
					"content": "Paimon bahkan minta penjual koran untuk langsung pilih rasa favorit kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100132,
					"content": "Tapi kan kita udah coba hampir semua makanan di Court of Fontaine, kayaknya enggak ada yang baru deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100133,
					"content": "Apa pun yang dipilih Paimon pasti enak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "Serius? Hehe ... kalau gitu Paimon bakal sering-sering belikan kamu camilan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100136,
					"content": "Sayangnya kita enggak siapkan camilan untuk teman Fungus ... Paimon mau peluk teman Fungus sambil makan sepuasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100137,
					"content": "Tidak perlu khawatir, aku sudah mempelajari makanan kesukaan Fungus melalui penelitian \"Ciri Khas Spesies Fungus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100138,
					"content": "Tujuan aku adalah menemukan bahan makanan yang cocok untuk manusia dan Fungus, jadi teman-teman kita tidak perlu mengonsumsi berbagai rasa Marvelous Jelly sepanjang tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100139,
					"content": "Suatu hari nanti, aku pasti akan menemukan bahan yang cocok, dan merancang hidangan lezat yang bisa kita nikmati bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100140,
					"content": "Nanti biar aku yang jadi koki utamanya! Aku tidak mau Haniyyah membakar panci kesebelas kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100141,
					"content": "Jadi, hari di mana kita duduk dan makan sama teman Fungus enggak lama lagi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100142,
					"content": "Kalau begitu, kami akan menunggu kabar baik kamu, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "Kalau begitu, sering-sering mampir ke Taman Fungus Kecil ya! Kami dan teman-teman Fungus akan selalu menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100145,
					"content": "Siapa tahu kejutannya datang lebih cepat dari yang dibayangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737100143,
					"content": "Kami menantikan hidangan Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "Yang Paimon belikan untukku, pasti beda dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "Aku bahkan tidak menyadarinya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "Paimon perhatian banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}