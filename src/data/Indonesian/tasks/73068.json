			"dialogs": [
				{
					"id": 730680201,
					"content": "#Nara {NICKNAME} dan Paimon? Aranakula sedang pergi ke Alam Ashavan bersama Arapandu, lebih baik sekarang makan jamurnya dulu.",
					"roleType": "TALK_ROLE_NPC",
