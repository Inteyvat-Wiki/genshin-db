				{
					"id": 730680440,
					"content": "Di luar mimpi, ada dua belas kebun yang mengondensasi Vasmrti. Kalau ada mereka, kebun Vanarana akan penuh dengan Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680441
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680441,
					"content": "#Festival Utsava perlu banyak Viparyas dan Vanarana sudah punya banyak. Namun, kalau ada lebih banyak Viparyas yang senang, Aranara akan senang, Nara {NICKNAME} dan Paimon juga akan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680442
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680442,
					"content": "Kalau gitu, kami juga akan bantu ngumpulin Vasmrti deh! Tapi, gimana cara ngumpulinnya? Arakara barusan bilang itu kebun yang ada di luar mimpi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680443,
					"content": "Nara Emas, masih perlu mengitari tanah kebun. Cukup sekali saja, kalau terlalu banyak tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680444
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680444,
					"content": "Cukup pergi sekali saja ... terus Vasmrti akan berbuah, seperti embun di daun yang terkena sinar matahari sehabis hujan semalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680445
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680445,
					"content": "Aduh, jadi bingung nih malah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680446,
					"content": "Namun, sesuai dengan pengalaman berurusan dengan Aranara sebelumnya ... Ketika kita menemukan kebun yang ada di luar mimpi, seharusnya kita bisa langsung tahu apa yang Aranakula katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680447,
					"content": "Sesudahnya, kalau kebunnya sudah ketemu, kita lihat-lihat, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}