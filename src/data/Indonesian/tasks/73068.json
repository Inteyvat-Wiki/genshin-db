					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680401,
					"content": "Itu Aranakula! Dia kembali ke Vanarana dengan selamat. Eh itu ada ... satu Aranara yang enggak dikenal juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680402,
					"content": "#Nara {NICKNAME} dan Paimon! Varuna Contraption sudah diperbaiki, Aranakula bisa fokus menjaga kebun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680403
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680403,
					"content": "Ini Arakara. Aranakula dan Arakara bersama menjaga kebun Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680404
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680404,
					"content": "Ini kebun yang selalu Aranakula bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680405,
					"content": "Iya, tanah di sini sebenarnya cocok untuk ditanami tanaman. Bisa menanam Viparyas yang senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680406
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680406,
					"content": "Memangnya ada Viparyas yang enggak senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680407,
					"content": "Bukannya enggak senang, hanya saja enggak terlalu senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680408
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680408,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680409,
					"content": "Seperti, ada tanah yang cocok untuk tumbuh, juga enggak kekurangan air hujan dan cahaya matahari. Juga enggak menemui kendala ketika proses tumbuh ... sepertinya enggak ada yang enggak menyenangkan, tapi juga enggak ada yang begitu senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680410
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680410,
					"content": "Oh ... rasanya sih biasa-biasa saja. Eh? Kalau gitu, di sini enggak sama kayak di tempat lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680411,
					"content": "Tanah Vanarana semuanya bagus, tapi di sini lebih bagus. Lagi pula, ada yang lebih penting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680412
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680412,
					"content": "Arakara dan Aranakula akan menjaga mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680413
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680413,
					"content": "Menjaga ... persisnya pakai cara apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680414,
					"content": "Akan memainkan musik untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680415
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680415,
					"content": "Juga akan memuji mereka cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680416
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680416,
					"content": "Apa ini bedanya Viparyas liar dan peliharaan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680417
					]
				},
				{
					"id": 730680417,
					"content": "Masuk akal juga sih ... kalau setiap hari bisa dinyanyiin lagu yang merdu, terus dipuji cantik juga, pastinya bakal senang sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680418,
					"content": "#Benar, sama kayak Paimon dulu. Sebelum dipancing sama {NICKNAME}, Paimon juga enggak jelas antara hidup senang-senang saja atau biasa-biasa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680419,
					"content": "#Terus sesudah pergi-pergian sama {NICKNAME}, walaupun kadang-kadang ketemu masalah, tapi kalau pas senang ya rasa senangnya jadi kayak berlipat ganda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680420,
					"content": "Paimon benar, Arakara ingin menggunakan Viparyas yang senang untuk dijadikan lampu yang cantik buat Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680421
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680421,
					"content": "Hehe, karena Aranakula sudah datang, ayo kita mulai saja! Benih Viparyas ... eh, memang Viparyas juga punya biji?",
					"roleType": "TALK_ROLE_NPC",
