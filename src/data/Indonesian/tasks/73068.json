					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "Aranakula! Dia kembali ke Vanarana dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680302,
					"content": "#Nara {NICKNAME} dan Paimon! Varuna Contraption sudah diperbaiki, Aranakula bisa fokus menjaga kebun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680303,
					"content": "Ini kebun yang selalu Aranakula bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680304,
					"content": "Iya, ini adalah kebun yang diurus oleh Aranakula dan Arakara. Tanah di sini sebenarnya cocok untuk pertumbuhan Viparyas yang senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680305,
					"content": "Memangnya ada Viparyas yang enggak senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680306,
					"content": "Bukannya enggak senang, hanya saja enggak terlalu senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680307,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680308,
					"content": "Seperti, ada tanah yang cocok untuk tumbuh, juga enggak kekurangan air hujan dan cahaya matahari. Juga enggak menemui kendala ketika proses tumbuh ... sepertinya enggak ada yang enggak menyenangkan, tapi juga enggak ada yang begitu senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680309,
					"content": "Oh ... rasanya sih biasa-biasa saja. Eh? Kalau gitu, di sini enggak sama kayak di tempat lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680310,
					"content": "Tanah Vanarana semuanya bagus, tapi di sini lebih bagus. Lagi pula, ada yang lebih penting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680311,
					"content": "Arakara dan Aranakula akan menjaga mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680312,
					"content": "Menjaga ... persisnya pakai cara apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680313,
					"content": "Akan memainkan musik untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680314,
					"content": "Juga akan memuji mereka cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680315,
					"content": "Apa ini bedanya Viparyas liar dan peliharaan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "Masuk akal juga sih ... kalau setiap hari bisa dinyanyiin lagu yang merdu, terus dipuji cantik juga, pastinya bakal senang sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680317,
					"content": "#Benar, sama kayak Paimon dulu. Sebelum dipancing sama {NICKNAME}, Paimon juga enggak jelas antara hidup senang-senang saja atau biasa-biasa saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680318,
					"content": "#Terus sesudah pergi-pergian sama {NICKNAME}, walaupun kadang-kadang ketemu masalah, tapi kalau pas senang ya rasa senangnya jadi kayak berlipat ganda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680319,
					"content": "Paimon benar, Arakara ingin menggunakan Viparyas yang senang untuk dijadikan lampu yang cantik buat Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680320,
					"content": "Hehe, karena Aranakula sudah datang, ayo kita mulai saja! Benih Viparyas ... eh, memang Viparyas juga punya biji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680321,
					"content": "Viparyas, adalah mimpi bumi, adalah yang diingat bumi di dalam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680322,
					"content": "Biji itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680323,
					"content": "Viparyas enggak punya biji ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680324,
					"content": "Eh? Tapi gimana caranya menanam di kebun kalau enggak ada bibit ... Ah! Jangan-jangan Aranakula punya Ararakalari yang bisa numbuhin Viparyas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680325,
					"content": "Eh bukan, bukan ... kalau ingin menumbuhkan Viparyas di kebun, perlu Vasmrti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680326,
					"content": "Vas ... Vas apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680327,
					"content": "\"Vasmrti\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "Vana akan mengingat semua. Maka itu karena ada Vasmrti, bumi akan mengingatnya lagi di dalam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680329,
					"content": "Kebun juga akan melahirkan Viparyas yang senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680330,
					"content": "#Huh ... jadi, \"Vasmrti\" ini cuma bisa didapatkan Aranara? Jadi Paimon dan {NICKNAME} enggak punya kesempatan buat numbuhin Viparyas di kebun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680331,
					"content": "#Nara Emas pernah membantu Aranakula dan Aranara yang lainnya, Nara jadi teman Aranara. Jadi, Aranakula dan Nara {NICKNAME} bersama-sama merawat Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680332,
					"content": "#Membuat Vasmrti tenggelam di dalam tanah, maka akan melahirkan Viparyas. Nara {NICKNAME}, coba saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680333,
					"content": "Kalau menurut perkataan Aranakula Vasmrti tenggelam dalam tanah.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "Cuma gitu? Kayaknya sama-sama saja sama menanam biji tanaman lain! Tanam bijinya ke tanah, terus tunggu deh sambil mulai bertunas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680335,
					"content": "Vasmrti bukan biji. Itu seperti Paimon yang bukannya kucing terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680336,
					"content": "Huh ... o-oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680337,
					"content": "Omong-omong, masih ada banyak tempat kosong nih di kebun. Satu, dua, tiga ... ada dua belas bidang yang bisa dipakai buat menanam Viparyas. Aranakula masih punya Vasmrti-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680338,
					"content": "Dulu ada, tapi sekarang sudah tidak ada sisanya, harus mengumpulkan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680339,
					"content": "Di luar mimpi, ada dua belas kebun yang mengondensasi Vasmrti. Kalau ada mereka, kebun Vanarana akan penuh dengan Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680340,
					"content": "#Festival Utsava perlu banyak Viparyas dan Vanarana sudah punya banyak. Namun, kalau ada lebih banyak Viparyas yang senang, Aranara akan senang, Nara {NICKNAME} dan Paimon juga akan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680341,
					"content": "Kalau gitu, kami juga akan bantu ngumpulin Vasmrti deh! Tapi, gimana cara ngumpulinnya? Arakara barusan bilang itu kebun yang ada di luar mimpi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680342,
					"content": "Nara Emas, masih perlu mengitari tanah kebun. Cukup sekali saja, kalau terlalu banyak tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680343,
					"content": "Cukup pergi sekali saja ... terus Vasmrti akan berbuah, seperti embun di daun yang terkena sinar matahari sehabis hujan semalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680344,
					"content": "Aduh, jadi bingung nih malah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680345,
					"content": "Namun, sesuai dengan pengalaman berurusan dengan Aranara sebelumnya ... Ketika kita menemukan kebun yang ada di luar mimpi, seharusnya kita bisa langsung tahu apa yang Aranakula katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680346,
					"content": "Sesudahnya, kalau kebunnya sudah ketemu, kita lihat-lihat, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306804,
			"completionStepIds": [
				7306804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
