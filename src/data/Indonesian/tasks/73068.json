			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "Halo! Tanah di sini kelihatannya beda dari tempat lainnya, apa ada kegunaan khususnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680102,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680103,
					"content": "Eh? Dia kok enggak ada responnya sih? Apa dia tidak dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680104,
					"content": "Ha—lo—!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "Uh? Na—Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680108,
					"content": "Ko—Kok bisa? Kenapa bisa ada Nara di Vanarana? Mau menangkap dan memanggangku? Arakara tidak seenak jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680109,
					"content": "Enggak bakalan lah kita ngelakuin yang seseram itu! Kita kan terkenal sebagai \"teman Aranara yang gembira\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680110,
					"content": "Belum ada orang yang pernah berkata seperti itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Aduh, ya enggak ada yang ngomong sih, tapi kan semuanya juga pasti mikir kayak gitu. Jadi enggak usah ditanya lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680114,
					"content": "#Omong-omong, namaku Paimon. Dan yang emas ini adalah {NICKNAME}, dia ini Nara yang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680115,
					"content": "Kamu Arakara, kan? Kok sendirian saja di sini, sedang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680116,
					"content": "Kenapa Paimon bertanya itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680117,
					"content": "Eh ... Paimon kan penasaran! Refleks saja kaya mau loncat pas lihat kupu-kupu, atau mau langsung tangkap kalau lihat kadal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680118,
					"content": "Apa Paimon adalah kucing yang bisa terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680119,
					"content": "BUKAN!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680120,
					"content": "Umm ... Kalau itu rahasia buat Aranara dan enggak enak diomongin juga enggak apa-apa. Kami juga enggak mau ngerusak suasana, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680121,
					"content": "Aku masih sangat penasaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Teorinya sih begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680123,
					"content": "\"Rahasia?\" Arakara tidak punya \"rahasia\". Arakara tidak melakukan apa-apa, Arakara sedang menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680124,
					"content": "Menunggu? Maksudmu Aranara yang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680125,
					"content": "Aranakula sedang pergi ke Alam Ashavan bersama Arapandu, tidak tahu kapan kembali. Varuna Contraption sedang tidak beres, ini bukan waktunya mengurusi kebun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680126,
					"content": "#Nara {NICKNAME} suka bercocok tanam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680127,
					"content": "Bercocok tanam sangat merepotkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Hanya merepotkan kalau ditanam di tanahnya Valuka, tapi kalau di tanahnya Vana tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680131,
					"content": "Kenapa enggak ada yang nanya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680132,
					"content": "Paimon kalau enggak menangkap kupu-kupu ya menangkap kadal, sepertinya enggak suka bercocok tanam. Percuma saja bertanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680133,
					"content": "Walaupun mau menyangkal ... tapi Paimon lebih mentingin hasilnya ketimbang proses sih! Jadi, mau menanam apa di kebun ini? Makanan enak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680134,
					"content": "Rasanya enak, tapi juga memiliki kegunaan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680135,
					"content": "Namun sekarang Paimon lapar, enggak mau makan di kebun, maunya makan jamur. Jamur di Vana sangat banyak, lebih baik coba makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680136,
					"content": "Intinya, Aranakula masih belum pulang, kita enggak bisa mulai apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680137,
					"content": "#Oke, sepertinya kita harus nungguin Aranakula pulang... kita pergi saja dulu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680129,
					"content": "Aku paling suka bercocok tanam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "Bagus, Arakara juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680112,
					"content": "Paimon benar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680106,
					"content": "Mari makan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "Jamurnya enak! ... Nara? Enak? Ah tidak, Nara tidak bisa makan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
