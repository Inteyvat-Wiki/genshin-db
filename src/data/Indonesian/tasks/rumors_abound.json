			"dialogs": [
				{
					"id": 120211101,
					"content": "Sepertinya sedikit berbeda dengan taktik yang kita buat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Tapi tidak apa-apa. Pertempuran sangat kompleks dan situasinya mudah berubah-ubah. Kita tidak perlu bersikap kaku dan bersikeras mengikuti rencana awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Hehehe ... Sepertinya sekali pertempuran dimulai, rencananya langsung terlupakan total ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211104,
					"content": "Tapi hasil akhirnya cukup memuaskan, sebuah bukti bahwa kamu dapat beradaptasi sesuai suasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211105,
					"content": "Tapi tak disangka para Fatui itu menggunakan kemah Hilichurl sebagai kedok untuk diam-diam tinggal lama di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211106,
					"content": "Apa tujuan mereka sebenarnya? Jangan-jangan seperti yang para prajurit katakan, mereka sudah bersekutu dengan Tenryou Commission ....",
					"roleType": "TALK_ROLE_NPC",
