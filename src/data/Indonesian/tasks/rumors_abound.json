			"dialogs": [
				{
					"id": 120211001,
					"content": "#Kerja bagus, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211002
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211002,
					"content": "Hehehe, semuanya berkat taktik jeniusmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211003,
					"content": "Bahkan keberhasilan dari taktik terbaik pun tetap memerlukan kemampuan pelaksananya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211004,
					"content": "Untuk memenangkan pertempuran, kita memerlukan upaya dari semua orang. Kemenangan bukan hanya milik satu orang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211005,
					"content": "Paimon jadi ingat, kontribusi Paimon kan besar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211006,
					"content": "Aku tidak merasa kamu begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "Hei! Paimon bantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211008,
					"content": "Tapi tak disangka para Fatui itu menggunakan kemah Hilichurl sebagai kedok untuk diam-diam tinggal lama di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211009,
					"content": "Apa tujuan mereka sebenarnya? Jangan-jangan seperti yang para prajurit katakan, mereka sudah bersekutu dengan Tenryou Commission ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211010,
					"content": "Kita selidiki kemah ini dulu. Kalau pedagang itu tidak berbohong, barang-barangnya seharusnya ada di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211011,
					"content": "Baik! Saatnya kita memeriksa sekeliling sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
