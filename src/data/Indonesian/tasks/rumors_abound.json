			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Pasti ini kemah Fatui yang dibicarakan pedagang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210102,
					"content": "Dilihat dari bentuknya, sepertinya itu bekas kemah Hilichurl. Entah kenapa para Fatui mengambil alih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210103,
					"content": "Uhh ... Penjagaannya ketat juga ya, bagaimana cara kita masuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210104,
					"content": "Yang pasti bukan dengan cara paksa. Tapi ini bukan masalah besar. Medan di sini menguntungkan bagi kita, dan sampai sekarang mereka masih belum tahu posisi kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210105,
					"content": "Semua musuh kita terlihat, tapi kita tidak terlihat. Secara strategi, posisi kita lebih menguntungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210106,
					"content": "Dan apa yang ada di pikiran sang ahli strategi kita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Kurasa kita punya tiga pilihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210108,
					"content": "Pertama: Serang rajanya dan langsung sekakmat. Saat ini kekuatan Fatui sedang cukup lemah di Inazuma. Mereka hanyalah sisa-sisa pasukan yang tersebar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210109,
					"content": "Kalau kita bisa menyerang dari tempat tinggi dan langsung membereskan pemimpin mereka, pasukan lainnya pasti akan ragu untuk melawan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210110,
					"content": "#Pilihan kedua: Langsung serang titik kelemahan mereka. Contohnya, lihat di sana, {NICKNAME}. Gudang penyimpanan gentong mesiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210111,
					"content": "Kalau kita bisa meledakkan gentong-gentong mesiu tanpa ketahuan, itu akan mengakibatkan pukulan yang sangat besar untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210112,
					"content": "Mereka akan langsung lengah. Semangat dan kekuatan tempur mereka akan berkurang drastis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210113,
					"content": "Pilihan ketiga: Manfaatkan medan pertempuran. Kita berada di dekat laut, jadi udara di sini sangat lembap. Aku bisa mengumpulkan uap airnya, lalu tinggal kamu tambahkan setruman listrik. Dengan begini kita bisa melumpuhkan mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210114,
					"content": "Wow, ahli strategi kita memang hebat! Tapi banyak sekali ya pilihannya ... bagusnya kita pilih yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210115,
					"content": "Hmm ... Semua tergantung penilaianmu tentang kemampuan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210116,
					"content": "Serangan dadakan dari tempat tinggi adalah cara paling cepat, tapi cara itu membutuhkan kemampuan tempur yang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210117,
					"content": "Dengan ledakan, kita bisa mengurangi jumlah musuh dan mempersingkat waktu pertarungan. Tapi kita harus bergerak dengan sangat hati-hati dan tidak boleh ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210118,
					"content": "#Kalau mau memanfaatkan medan, kita harus siap bertarung untuk waktu yang cukup lama. Jadi apa pilihanmu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210119,
					"content": "Serangan dadakan dari udara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "Haha ... Ini dia kapten Swordfish II yang kukenal, sangat percaya diri dengan kemampuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210121,
					"content": "Baiklah, sudah diputuskan. Ayo kita bertarung bersama. Aku bukan seorang petarung, tapi aku masih bisa memberikan dukungan berguna. Yang pasti aku tidak akan menyuruhmu bertarung sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210122,
					"content": "Kita harus mengalahkan mereka secepat mungkin dan mengambil kembali barang pedagang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210123,
					"content": "Taktik gentong mesiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Haha, sepertinya pemikiran strategimu mirip denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210125,
					"content": "Itu juga taktik pilihanku. Taktik itu lebih tidak berbahaya untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210126,
					"content": "Ayo kita bekerja sama untuk memberikan mereka kejutan hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210127,
					"content": "Ayo kita beri mereka sedikit \"kejutan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "Baiklah. Kita tarik perhatian mereka keluar dulu, agar kemahnya tidak rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210129,
					"content": "Aku belum begitu sering bertarung bersamamu sebelumnya, semoga aku bisa mengikuti gerakanmu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210130,
					"content": "Tapi tenang saja. Aku bukan seorang petarung, tapi aku tidak asing dengan medan pertempuran kok. Pertarungan seperti ini harusnya tidak akan jadi masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210131,
					"content": "Oke. Ayo kita bereskan kemahnya dan cari tahu apa rencana mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
