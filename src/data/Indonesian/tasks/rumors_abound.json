			"dialogs": [
				{
					"id": 120210301,
					"content": "Kokomi~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210302,
					"content": "Kokomi, kita menemukan barang milik pedagang itu. Lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Hmm, ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Oh, tidak kok. Aku hanya melamun saja sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Coba kulihat ... Ya, benar ini barang-barang yang dicuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Makanan, obat-obatan, alat bertani ... Barang-barang penting untuk pemulihan setelah perang. Sepertinya mereka berencana menyimpannya sampai bisa dijual dengan harga tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "Tapi Tenryou Commission tidak mungkin kekurangan barang-barang seperti ini. Sedikit tidak masuk akal kalau mereka akan memberikannya kembali ke Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "Kemungkinan besar dia hanya seorang pedagang oportunis, tidak selicik yang dibayangkan Matsuda dan Uchimura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Uhh ... tapi juga bukan orang baik kan? Kenapa dia bisa tega menstok barang-barang yang diperlukan orang-orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "Tidak mungkin kita kembalikan barangnya dan biarkan dia pergi begitu saja kan? Rasanya kurang tepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "Jangan khawatir, aku sudah memikirkan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "Di dalam Dekrit Sementara Pasca Perang, aku sudah membatasi harga barang sehari-hari. Jadi semua barang ini akan sampai ke tangan penduduk dengan harga yang masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Kalau saja dia menyempatkan waktu membaca dekrit itu, dia pasti tidak perlu mengalami masalah seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Kamu sudah memikirkan segalanya ya, Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Jangan berlebihan, aku juga harap bisa begitu. Lihat saja kerja sama antara Tenryou Commission dan Fatui ini, aku sama sekali tidak menduganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "Energiku yang sudah mau habis juga tidak membantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "Eh ...? Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Tidak apa-apa. Ayo kita bawa barang ini kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "Sebentar lagi Pesta Kemenangan akan dimulai. Sebelum dimulai, segala persiapannya harus segera diselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "Hore! Kita peroleh kedamaian, lalu kita ikut pesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "Kamu sedang memikirkan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naruse",
					"Matsuda",
					"Sangonomiya Kokomi",
					"Uchimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "Barang-barangku! Kalian berhasil dapatkan semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "Terima kasih, Yang Mulia Sangonomiya! Dan terima kasih, Kapten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "Lihat? Aku sudah bilang kan kalau aku tidak bersalah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "Hmph ... Siapa yang bakal tahu? Mungkin saja kamu sejak awal sudah merencanakannya dengan para Fatui ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "Dari informasi yang kami dapatkan dari perkemahan Fatui, dia dan para Fatui memang tidak berhubungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Kalau itu benar terjadi, mengetahui bagaimana ciri khas para Fatui, seharusnya mereka sudah meninggalkan beberapa bukti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Tidak ada tapi-tapian. Karena barang-barang sudah ditemukan kembali, berdasarkan janji yang dibuat sebelumnya, kita harus mengembalikan nama baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Kami terlalu terbawa suasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "Huh! Sudah kubilang, kan? Dasar prajurit-prajurit tak punya otak. Bukannya kerja yang benar malah cari gara-gara. Sekarang sudah sadar kan siapa yang salah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "Tuan, kurasa kamu terlalu cepat menyimpulkan. Kamu mungkin tidak bersalah atas tuduhan sebelumnya, tetapi menimbun bahan-bahan kebutuhan adalah aksi kriminal yang dilarang dalam Dekrit terbaru. Kamu harus menanggung hukuman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Kamu telah mengakui bahwa kamu adalah pemilik barang-barang ini, jadi kami berkewajiban untuk menanggapi dengan tindakan yang tepat. Selain mewajibkanmu menjual barang-barang ini dengan tarif wajar, akan ada denda juga sebesar—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "Tunggu, tunggu! Yang Mulia ... Anda sebenarnya sedang di pihak siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "Aku tidak ada di pihak siapa pun. Sebagai Pemimpin Suci di Pulau Watatsumi, aku menuruti prinsip imbalan dan hukuman yang jelas dan konsisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Sama seperti jasa yang harus diakui, kesalahan juga harus ditindak hukum. Kamu mungkin terbukti tidak bersalah atas tuduhan yang lebih serius, namun ini tidak berarti kamu bisa terbebas dari konsekuensi atas kesalahanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "Aku ... Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "Jangan hanya berdiri saja — bawa dia pergi! Dia harus bayar denda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Yang Mulia Sangonomiya, meskipun dia mengaku bahwa barang-barang itu miliknya, tapi saya merasa ada yang tidak beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Semua barang dengan simbol Tenryou Commission ini mungkin punya dia, tapi barang lainnya pasti bukan. Khususnya yang ini — jelas-jelas untuk digunakan kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Hmm ... Seharusnya para Fatui hanya merampok lalu menggabungkan barang rampasannya menjadi satu. Tinggalkan perlengkapan kuil itu padaku. Sisanya kutinggalkan pada kalian untuk dilacak pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "Aku tahu permintaanku terlalu banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "Tidak, Yang Mulia. Kami akan membereskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Tapi Yang Mulia ... Meski kali ini tidak berhasil mendapatkan buktinya, tapi orang-orang kami melihat sendiri Tenryou Commission berhubungan dengan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Mengenai Pembicaraan Damai ... Kuharap Anda dapat memikirkannya matang-matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Aku mengerti kekhawatiranmu. Aku akan memikirkannya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, aku akan membawa barang-barang kuil ke Kuil Sangonomiya. Maukah kamu ikut bersamaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "Asal kamu tahu, kuil pertama di Pulau Watatsumi sebenarnya tidak terletak di Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Kuil itu terletak di dekat Patung The Seven. Saat itu orang-orang di pulau ini mengakui keberadaan Shogun, namun tidak memujanya seperti Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210806,
					"content": "Tapi setelah Shogun mengalahkan dewa pelindung kami, kuil itu pun ditinggalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210807,
					"content": "Sejak itu hubungan Pulau Watatsumi dan Shogunate menjadi renggang. Ketidakpercayaan kedua wilayah itu pun semakin mengakar seiring dengan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "Aku sebenarnya ingin membahas masalah ini pada Pembicaraan Damai nanti. Masalah dendam pada akhirnya harus dilepaskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Apa yang membawa Anda datang ke sini di tengah kesibukan, Yang Mulia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Ya ampun, raut wajah Anda bahkan lebih buruk dari yang lalu-lalu. Anda harus menjaga diri baik-baik. Semua nasib kami bergantung pada Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Hmm, tenang saja. Aku baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Saya mohon, dengarkan saran saya, Yang Mulia. Setelah menghadapi Pasukan Shogun begitu lama, perdamaian bukanlah sesuatu yang bisa dinyatakan begitu mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Kalau kita berdamai dengan mereka, bukankah dewa yang pernah melindungi kita jadi mati dengan sia-sia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Ayolah, itu adalah sejarah pada zaman dulu. Lagi pula, pertempuran baru saja berakhir. Kita harus bersyukur bisa berdamai sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Aku tahu, aku tahu. Hanya saja ... *huff* Kita harus tetap tegas di negosiasi ini. Kita tidak boleh terlalu cepat menyetujuinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Aku memahami kekhawatiranmu. Aku akan mempertimbangkannya baik-baik dan menanganinya dengan tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Bagus sekali ... Kami semua mengandalkan Anda, Yang Mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "Yang Mulia? Wah, sungguh sebuah kehormatan dapat bertemu dengan Anda di tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "Apa Anda tahu — putri saya baru saja mendaftar dalam pemilihan miko tahun ini. Kalau dia bisa masuk Sangonomiya, saya pasti akan sangat bangga kepadanya! Anda adalah pemimpin yang baik hati dan ramah. Dia pasti akan diajarkan dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "*Huff* Saya selalu memberi tahu putri saya bahwa jika dia mendapat kesempatan untuk belajar dari Yang Mulia secara langsung, dia harus memanfaatkannya sebaik mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Maksudku, lihat saja Yang Mulia. Masih sangat muda, tapi sangat dewasa dan cerdas. Putri saya selalu menganggap Anda sebagai panutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Ya, kalau dia ke Sangonomiya, aku akan menjaganya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "Ah, Yang Mulia! Akhirnya saya bisa bertemu denganmu. Seperti yang Anda ketahui, industri pertanian tahun ini mengalami pukulan yang cukup besar. Izinkan saya untuk melaporkan situasi terbarunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "Yang Mulia, bukankah orang ini Kapten Swordfish II? Dia sekarang akan terus tinggal di Pulau Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Yang Mulia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "*huff* Tolong tenang dulu, semuanya. Aku akan mendengar semuanya satu-satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Untuk masalah yang lebih panjang, kuharap kamu dapat menuliskannya sebagai laporan dan mengirimnya ke kuil. Aku akan merespon satu-satu saat ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#Apa kamu baik-baik saja, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Hehe ... Kamu sudah terbiasa menangani situasi semacam ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Yang Mulia, ternyata Anda di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "Ada yang ingin saya laporkan. Kami sedang menunggu pengiriman peralatan upacara, saya khawatir peralatannya dirampok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Oh, kami sudah menemukannya — tidak usah khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "Benarkah? Hebat sekali! Anda tidak pernah berhenti membuat kami takjub, Yang Mulia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Saya memilah-milah semua petisi yang diterima beberapa waktu ini dan sudah meletakkannya di meja Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Dan lagi sesuai dengan jadwal, Anda hari ini masih ada pertemuan tentang pengembangan industri tekstil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "Pertemuannya hari ini? ... Sekarang juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Ya, kedua gadis itu telah tiba dan sedang menunggu Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Baiklah ... *huff* {NICKNAME}, awalnya aku ingin membawamu berkeliling pulau, tapi sepertinya rencana itu harus dilakukan lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Kita bertemu di pintu masuk Kuil Sangonomiya besok. Setelah itu kita pergi mempersiapkan Pesta Kemenangan bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "Hore! Pesta Kemenangan! Paimon mau perjelas saja, ada banyak makanan enak kan di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Hahaha... Pasti banyak. Akan ada banyak makanan khas Pulau Watatsumi yang aku yakin, kamu pasti suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "Hore! Sampai jumpa besok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "Ini seperti sedang menguji kesabaranku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "*huff* Aku juga. Rasanya benar-benar merepotkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
