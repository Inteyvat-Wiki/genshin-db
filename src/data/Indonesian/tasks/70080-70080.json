				{
					"id": 700800101,
					"content": "Berdiri di garis antara hidup dan mati, aku sangat merindukan rasa bir. Bahkan tuanku dan Raja Deshret saja tidak sepenting itu kalau dibandingkan.",
					"roleType": "TALK_ROLE_NPC",
