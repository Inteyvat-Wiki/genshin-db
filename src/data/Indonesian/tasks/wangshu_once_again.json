					"Tuan Bohuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Terima kasih banyak! *huff* Aku benar-benar ceroboh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201902,
					"content": "Apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Aku datang ke sini untuk mencari bahan-bahan. Kupikir akan sangat bagus jika aku membuat beberapa tulisan kaligrafi dan memberikannya kepada temanku sebagai hadiah perayaan Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201904,
					"content": "Tapi aku memerlukan beberapa botol tinta spesial untuk menulisnya. Seharusnya sih tidak terlalu sulit, cukup mencari beberapa bahan saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201905,
					"content": "Tidak kusangka malah ketemu monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201906,
					"content": "Bagaimana dengan permintaan Wang'ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Pergi ke Desa Qingce untuk menuliskan beberapa tulisan kaligrafi untuk penduduk desa... Tidak masalah! Serahkan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201908,
					"content": "Desa Qingce... Oh, desa yang ada banyak orang tua itu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201909,
					"content": "Begini saja. Bagaimana kalau kamu membantuku mencari Cor Lapis dan bunga Qingxin? Aku membutuhkannya untuk membuat tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201910,
					"content": "Kamu membuat tinta... dari bahan-bahan itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Hahaha, kamu tidak salah, tapi tidak sepenuhnya benar. Bubuk Cor Lapis yang dilarutkan dalam tinta bisa membuat hurufnya menjadi bersinar dengan warna emas. Benar-benar indah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201912,
					"content": "Sari bunga Qingxin dapat menambah aroma bunga pada tinta. Kalau tintanya sendiri memang sudah bagus, kedua aroma itu akan berpadu satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201913,
					"content": "Wo-wow, detail sekali ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Ah, itu tidak seberapa dibandingkan dengan orang-orang yang bahkan sampai rela membuat tintanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201916,
					"content": "Kali ini kita buat sederhana saja. Cukup kumpulkan bahan-bahannya dan berikan padaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201917,
					"content": "Aduh... aku perlu beristirahat sejenak. Serangan monster tadi membuatku lemas sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuan Bohuan"
				},
				{
					"id": 718201914,
					"content": "Terdengar merepotkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
