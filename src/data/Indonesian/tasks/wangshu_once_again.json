				{
					"id": 718202101,
					"content": "Bagaimana, apa kamu sudah menemukan Tuan Bohuan? Apa dia setuju dengan rencanaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202102,
					"content": "Dia bilang akan pergi denganmu, tapi dia perlu waktu untuk ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Bagus, aku juga sudah bertemu Qingzhou tadi, sepertinya dia sedang sedikit gundah. Dia pergi keluar untuk berjalan-jalan, katanya ingin mencari inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202104,
					"content": "Terima kasih banyak. Aku akan menunggu Tuan Bohuan di sini dan memberi tahu rinciannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202105,
					"content": "Lalu aku masih harus menyelesaikan semua urusan yang belum selesai di Pelabuhan Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202106,
					"content": "Sepertinya perjalanan bolak balikku dari Wangshu Inn dan Pelabuhan Liyue masih akan berlanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202107,
					"content": "Kami akan pergi ke Desa Qingce segera setelah aku selesai dengan semua hal ini. Jika kamu ingin bergabung dengan kami, kita bisa bertemu di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202108,
					"content": "Eh, andai saja aku bisa menyelesaikan urusanku lebih cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
