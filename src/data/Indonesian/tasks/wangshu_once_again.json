			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Setiap Lantern Rite adalah cerita klasik yang sama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "Kami sedang sedikit kewalahan. Banyak karyawan kami yang pulang untuk merayakan Lantern Rite bersama keluarganya. Sulit sekali mengurus penginapan dalam kondisi seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Melayani para tamu, menghiasi penginapan, dan membuat persiapan untuk perayaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "Lalu kami juga harus melakukan pekerjaan sehari-hari kami... Yanxiao juga tidak akan sempat mengurus semuanya sendirian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "Pengembara, jika kamu tidak keberatan, bisakah kamu membantunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Aku yakin dia akan sangat berterima kasih. Kamu bisa menemukan Yanxiao di dapur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "Aku masih belum selesai dengan pekerjaanku di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Siapa itu?! Hanya karyawan yang boleh masuk ke... Oh, ternyata kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200302,
					"content": "Apa kamu membutuhkan sesuatu? Jika kamu ingin memesan makanan, mungkin akan sedikit lama... Aku sedang sibuk sekali sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200303,
					"content": "Aku datang membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "Kamu datang untuk membantu? Oh... terima kasih sekali. Kebetulan ada banyak hal yang harus kukerjakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200306,
					"content": "Bisakah kamu pergi ke bawah dan mengambil beberapa bahan makanan yang baru saja tiba? Aku benar-benar membutuhkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200307,
					"content": "Lalu selagi kamu pergi ke bawah, tolong sekalian bawa lentera-Lentera Xiao itu dan gantung di pohon yang berada di pintu masuk penginapan... Pemilik penginapan sudah lama memintaku untuk menggantungnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200304,
					"content": "Apa kamu perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Bagaimana? Apa sudah selesai semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Semua sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Terima kasih banyak, aku berutang budi padamu. Aku harus segera menyelesaikan semua pesanan ini. Jangan sampai ada tamu kelaparan yang protes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Oh, kamu sudah kembali. Jadi Yanxiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Seharusnya sekarang sudah tidak ada masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Oh bagus, bagus. Terima kasih atas bantuanmu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Di sini juga tidak ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201605,
					"content": "Eh? Wang'ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "Pengembara? Kebetulan sekali! Aku tidak menyangka kamu akan berada di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201608,
					"content": "Bisa dibilang aku memang mengantarkan Lentera Xiao... Apa kamu tahu Desa Qingce? Lokasinya cukup jauh dari kota. Lalu sebagian besar orang di sana adalah orang tua atau anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201609,
					"content": "Jadi setiap tahun saat Lantern Rite tiba, Bagian Urusan Sipil akan mengutus satu orang perwakilan untuk mengantarkan kebutuhan sehari-hari saat festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201610,
					"content": "Pengiriman bagian pertama sudah selesai dikirim, tapi aku ingin memastikan saja kalau desa itu juga bisa menikmati suasana Festival Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201611,
					"content": "Karena itu aku meminta penyair Qingzhou untuk menyiapkan beberapa teka-teki lentera dan pergi ke Desa Qingce untuk menghibur anak-anak di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Penyair ternama seperti dia seharusnya bisa melakukannya, aku juga meminta tolong Tuan Bohuan. Dia adalah seorang penulis kaligrafi yang hebat. Jadi akan sangat bagus sekali jika dia bisa menolong para orang tua di sana untuk menuliskan harapan mereka pada Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201615,
					"content": "Tapi, sampai sekarang aku masih tidak bisa menemukan Tuan Bohuan di mana pun. Ada yang memberitahuku kalau dia pergi mengumpulkan bahan-bahan di Dihua Marsh, jadi aku datang ke sini untuk mencarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201616,
					"content": "Kamu bisa tanya pada pemilik penginapan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Tuan Bohuan? Coba kuingat-ingat... Belum lama ini, dia datang ke penginapan ini. Dia bilang akan mengumpulkan beberapa bahan-bahan di sekitar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Tapi aku tidak tahu apakah dia sudah pergi lagi atau belum. Ada banyak sekali monster di daerah itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Oh, begitu... Tapi aku sudah berjanji untuk bertemu dengan Qingzhou di Wangshu Inn sini. Seharusnya dia sampai sebentar lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201621,
					"content": "Pengembara, apa kamu bisa membantuku mencari Tuan Bohuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201622,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Kalau begitu tolong ya, aku akan menunggu Qingzhou di sini. Masih banyak hal yang harus kita bicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201624,
					"content": "Uh... Jadwalku benar-benar sibuk sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201617,
					"content": "Bos, kamu tahu Tuan Bohuan ada di mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Eh? Bukannya dia sudah janji dengan Vermeer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Apa kamu ke sini untuk mengantarkan Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
