					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Maaf, aku tahu kamu lapar tapi bisakah membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Nona Orlean dari Springvale memesan <color=#00E1FFFF>Sticky Honey Roast</color>, tapi aku dengar Slime di sekitar Springvale akhir-akhir ini sering membuat masalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Aku tidak berani pergi sendiri... Bisakah kamu membantuku mengirim pesanan ini kepada <color=#00E1FFFF>Orlean di Springvale</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Baiklah, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Setelah kamu pulang, akan ada banyak makanan lezat untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Aku mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Aku sungguh lapar, aku datang untuk makan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
