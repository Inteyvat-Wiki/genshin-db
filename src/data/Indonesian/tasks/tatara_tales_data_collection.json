					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Aku serahkan padamu ya. Cepat kembali, dan jangan sampai ketahuan oleh Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Kamu tahu dari mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Sensor Beacon ini disertai buku panduan penggunaan yang rinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Di dalamnya ada rekomendasi durasi pengumpulan data untuk setiap situasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Untuk \"energi tak diketahui\" seperti Tatarigami, aku langsung pakai durasi paling lama. Nah, urusan mengambil kembali Beacon-nya kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
