			"dialogs": [
				{
					"id": 721170101,
					"content": "Pengembara, pas sekali. Datanya sudah hampir lengkap, waktunya mengumpulkan kembali Sensor Beacon-nya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
