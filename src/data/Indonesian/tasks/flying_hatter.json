			"dialogs": [
				{
					"id": 790720101,
					"content": "#Ah, suatu kehormatan. Anda adalah {NICKNAME}, dan yang bersama Anda pastilah Nona Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hehe, betul. Itu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "Sebeken itu ya kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Semua kabar menyebar di, dari, dan ke seluruh Constellation Metropole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Kalian datang di waktu yang tepat. Kebetulan aku sedang memberikan sentuhan akhir untuk permainan \"Topi Terbang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Sayangnya aku tidak sehebat sang pengrajin topi legendaris yang memberikan topi cantik untuk semua orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Tapi aku percaya permainan \"Topi Terbang\" bisa memberikan kesenangan bagi mereka yang memainkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Aku sudah merancang tiga jenis permainan ... jangan khawatir, aturannya sederhana kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Anda akan paham setelah main satu kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "Aku mau coba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Baiklah, silakan ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Aku lagi sibuk nih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Oh, tidak apa. Silakan mampir lagi bila ada waktu, aku akan menunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
