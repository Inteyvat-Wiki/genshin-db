			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, {M#Tuan}{F#Nona} Pemilik Jinni yang terhormat. Selamat datang, saya senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Wah, budak padang pasir lagi. {M#Tuan}{F#Nona} ... Duh, sudahlah. Terserah {M#Tuan}{F#Nona}. Saya ikut saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Firasat Anda bagus sekali ... Saya benar-benar mengharapkan kedatangan Anda, sama seperti saya mengharapkan hadirnya sinar rembulan dan tetesan hujan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Banyak omong, pasti ada maunya. Langsung saja bilang ke intinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "#Baiklah, {M#Tuan}{F#Nona} Jinni ... saya ingin memohon satu hal kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Haha, bukan masalah apa sih. Elang Pemburu saya, Tadhla ... mungkin dia sedang dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "Duh ... Kalau saja kaki saya masih kuat, saya pasti tidak perlu merepotkan Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Oke Paimon paham, jadi kita harus nolongin dia, terus kamu bakal ngasih kami banyak Mora. Terus kami bisa makan enak yang banyak! Gitu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Ya. Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Kalau memang gitu, serahkan saja sama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Paimon jadi pintar ya kalau urusan-urusan gini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "Oh, ya sudah lah kalau begitu. Biarkan si unyil rakus ini bisa makan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Terima kasih sekali. Kalau begitu, misi ini saya serahkan kepada Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Ah ... lokasi terakhir keberadaannya ada di sini. Biar saya tandai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "Orang yang nanti kalian cari, namanya Tadhla, perempuan ini tinggi, kulitnya sawo matang, rambutnya panjang berwarna cerah, dan dia membawa busur ... Informasi ini seharusnya sudah cukup lengkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Bagaimana? Sudah bisa ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Ya, cewek kan, orangnya tinggi, kulitnya sawo matang, rambut panjang warnanya cerah, bawa busur! Hehei! Ingatan Paimon mantap, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "Ya. Semoga angin gurun menuntun Anda untuk melewati padang pasir agar terhindar dari seluruh mara bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Oke, kami berangkat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
