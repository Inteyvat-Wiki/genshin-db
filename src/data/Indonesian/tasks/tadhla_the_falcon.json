				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Sttt ... Coba lihat, ada orang di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "#Oh. {M#Tuan}{F#Nona} ... Orang-orang ini, \"Fatolol\" yang sering kalian sebut-sebut, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "Yang benar itu Fatui ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Bedanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Kecilin suaramu! Kalau sampai terciduk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Tidak masalah, mereka tidak bisa dengar saya ngomong kok. Tidak percaya? Coba lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Woi! Gendut! Saya di sini! Sudah waktunya makan! Makaaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Eh? Kamu dengar suara itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Fatui Skirmisher No. 1"
				},
				{
					"id": 732790409,
					"content": "Tidak. Memangnya ada suara apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Fatui Skirmisher No. 2"
				},
				{
					"id": 732790410,
					"content": "Huh, perasaan aku dengar ada seseorang bilang sekarang sudah waktunya makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Fatui Skirmisher No. 1"
				},
				{
					"id": 732790411,
					"content": "Tuh! Lihat, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Liloupar bisa nakal juga ya. Heheh, Paimon jadi gemas deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Coba lihat, di sana! Yang mereka tahan itu Tadhla bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Ya, Paimon ingat dia ... Tinggi, kulitnya sawo matang, rambut panjang warna cerah ... Harusnya dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "#Ingatanmu lumayan juga ya, unyil. Ayo kita sikat mereka, {M#Tuan}{F#Nona}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Siap, {NICKNAME}, sikat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
