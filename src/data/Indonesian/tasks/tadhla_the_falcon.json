			"dialogs": [
				{
					"id": 732790201,
					"content": "Bagaimana? Sudah ketemu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "Ah, masih butuh waktu, ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790203,
					"content": "Kalau begitu, tolong selamatkan Tadhla secepat mungkin. Waktu terus berjalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
