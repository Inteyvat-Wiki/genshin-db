			"dialogs": [
				{
					"id": 3740701,
					"content": "Jadi ... \"Holy Lyre der Himmel\" ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740702,
					"content": "Salah satu harta Mondstadt yang paling berharga. Ini adalah lira yang biasanya dimainkan oleh Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740703,
					"content": "Dengan lira itu, mungkin aku bisa membantu Dvalin mewujudkan kembali sifat lembutnya dari mimpi buruk yang dialaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740704,
					"content": "Apa bisa dipakai buat menghentikan Stormterror supaya enggak menimbulkan ancaman dan bahaya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740705,
					"content": "Tentu saja, karena aku adalah penyair terbaik di dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740706,
					"content": "Tiada lagu yang tak bisa kumainkan, baik lagu masa lalu, masa sekarang, atau pun masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740707,
					"content": "Lihat tatapan mataku, bukankah terlihat seperti tatapan yang sangat meyakinkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740708,
					"content": "Sepertinya malah mencurigakan deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Hahaha, kata-kata seperti itu tidak mempan pada penyair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740712,
					"content": "Oke, sekarang gimana caranya kita buat dapetin Holy Lyre itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740713,
					"content": "Kudengar mereka menaruhnya di suatu altar yang terletak jauh di dalam Katedral, di sebuah tempat yang aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740714,
					"content": "Aku akan mencari tahu, kalau mau, kamu boleh ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740709,
					"content": "Baiklah, sekali-sekali percaya tidak ada salahnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "Warna matamu, sama seperti warna langit di kampung halamanku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
		},
