			"dialogs": [
				{
					"id": 3740401,
					"content": "Barbatos memberkatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740402,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "Ah, kamu! Anggota baru Knights of Favonius, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740406,
					"content": "Ada keperluan apa datang kemari? Apakah ada tugas dari Grand Master?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740411,
					"content": "Betul, Knights of Favonius berniat meminjam Holy Lyre der Himmel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Iyakah ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740413,
					"content": "Bukannya aku mencurigaimu. Tetapi belum lama ini seorang penyair yang mencurigakan juga datang ingin meminjamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740414,
					"content": "Dia membual yang tidak-tidak, bahkan dia menyebut dirinya sendiri Barbatos. Pasti dia merencanakan sesuatu yang buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740415,
					"content": "Kini Holy Lyre tidak diizinkan untuk digunakan selain di hari Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740416,
					"content": "Untuk meminjamnya, kamu memerlukan surat persetujuan bertanda tangan dari Grand Master, Seneschal, dan Perwakilan Masyarakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740417,
					"content": "Jadi, bisakah aku memeriksa dokumen dari Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740418,
					"content": "Grand Master sepertinya tidak memberitahuku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "Aku perlu surat persetujuan bertanda tangan. Tanpa itu, tidak banyak yang bisa kubantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740423,
					"content": "Kalau tidak ada keperluan lain, maaf aku harus berpamitan, ada kesibukan yang harus kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740419,
					"content": "Maaf, aku lupa membawanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Semua suratnya dimakan Paimon saat perjalanan kami ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Aku adalah Honorary Knight dari Knights of Favonius, namaku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Ah, aku tahu! Waktu itu kamu menyelamatkan Mondstadt bersama dengan Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gettlinde"
				}
			]
		},
