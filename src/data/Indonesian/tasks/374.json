			"dialogs": [
				{
					"id": 3740301,
					"content": "Eh? Suster itu sudah tidak menghiraukanku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Tapi, setidaknya aku berhasil mengetahui yang ingin kuketahui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Dia sama sekali tidak menyangkal kalau Holy Lyre ada di suatu tempat di dalam Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#Kalau begitu, {NICKNAME}, karena kamu anggota Knights of Favonius yang sedang naik daun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Bagaimana kalau, kamu yang coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
