			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Serahkan padaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Hai, Suster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Semoga Barbatos memberkatimu, penyair muda. Apa yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740204,
					"content": "Sebenarnya, aku tahu rahasia yang bisa menyelamatkan Mondstadt dari kesulitannya saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "Syukurlah, akhirnya Barbatos menjawab doa kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740206,
					"content": "Tapi seharusnya kamu melapor ke Knights of Favonius. Kalau boleh tahu, kenapa kamu justru datang mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740207,
					"content": "Hahaha, suster, tentu saja itu karena kamu bisa membantuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "Aku ingin meminjam ... Holy Lyre. Dengan itu, aku bisa menolong Stormterror——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Silakan pergi dari tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740210,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Meskipun naga itu sangat kuat dan ganas, asalkan Grand Master turun tangan, tidak ada yang bisa menandingi para Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740212,
					"content": "Tapi itu tidak bisa dibiarkan terjadi. Kalau pakai cara itu, bukankah Stormterror mungkin akan terbunuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "Monster itu mengkhianati angin. Bahkan Dewa Anemo pun tidak akan mengampuninya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740214,
					"content": "Uh wow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "Tapi ... kumohon~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "Maaf, aku tidak bisa membantumu, penyair kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740217,
					"content": "(Aneh ... kenapa aku merasa sangat bersalah menolak anak ini ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740218,
					"content": "Kalau begitu ... sepertinya aku tidak punya pilihan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "Aku tidak bisa menutupi siapa diriku lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Wahai anakku, bergembiralah! Lihat, <color=#00E1FFFF>God of Anemo, Barbatos</color> telah turun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Terkejut? Pasti kamu ingin meneteskan air mata dan bersorak-sorai bahagia? Bagaimana rasanya bisa bertemu dengan dewa yang kamu puja dan layani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Kalau tidak ada keperluan lain, aku harus kembali untuk membereskan arsip Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740223,
					"content": "Tunggu——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
