				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine bertanya tentang menunya pada penjaga penginapan, lalu memesan beberapa hidangan mahal yang terkenal ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "Kudengar masakan Liyue banyak fokus di tampilan, harum, terus rasanya juga! Benar-benar beda banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "Lihatnya saja sudah langsung bikin ngiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Kalian semua menikmati hidangan lezat di Wangshu Inn ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Duh, yang ini enak, yang itu juga enak ... Sampai tidak kuat deh makannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Kenyang banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "Capeknya langsung hilang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Terima kasih atas semuanya! Kalau bukan karena dirimu, mungkin aku tidak akan bisa sampai di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Salah satu staf bilang kalau aku terus ikuti jalan ini, aku akan tiba di <color=#00E1FFFF>Pelabuhan Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Aku berencana untuk istirahat dulu di sini beberapa hari lalu tanya-tanya orang sekitar di mana aku bisa menemukan guru yang bagus, lalu baru aku putuskan mau ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Walaupun aku senang bertualang bersamamu, tapi aku tidak boleh merepotkanmu terus menerus begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "Kalau aku mau jadi kuat, semua itu tergantung dari usahaku sendiri juga. Aku mau jadi petualang hebat yang bisa diandalkan sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "Hehe, walaupun waktu kita cukup singkat, tapi aku senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "Kuharap kita masih bisa ketemu lagi lain kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Kuharap kamu menemukan apa yang kamu cari!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Iya! Kamu juga, semoga perjalananmu menyenangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine melambaikan tangannya dan mengucapkan selamat tinggal.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Karena kita sudah keburu di sini gimana kalau sekalian lihat-lihat sekitar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Mungkin bakal ada petualangan baru nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine bilang <color=#00E1FFFF>Pelabuhan Liyue</color> ada di depan, ayo kita coba lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
