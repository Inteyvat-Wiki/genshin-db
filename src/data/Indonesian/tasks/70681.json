			"dialogs": [
				{
					"id": 706813101,
					"content": "Fiuh ... nyaris saja ... Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813102
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813102,
					"content": "Namaku Gesine. Seperti yang kamu lihat, aku ini petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813103
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813103,
					"content": "Seseorang degan kemampuan sekaliber kalian sih pasti bukan orang biasa ya! Kamu kesatria? Atau mungkin pahlawan yang sedang mengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813104,
						706813105
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813104,
					"content": "Aku cuma petualang yang kebetulan lewat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813109
					]
				},
				{
					"id": 706813109,
					"content": "#Nama Paimon ya Paimon, terus dia ini {NICKNAME}, kita ini kebetulan anggota Adventurers' Guild juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813110,
					"content": "Ah jadi kalian ini petualang senior ya! Kalian bisa membereskan monster kuat itu dengan mudahnya ... ternyata memang, di atas langit masih ada langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813111
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813111,
					"content": "Sedangkan aku ... masih dalam pelatihan, aku ingat apa saja yang harus kulakukan, tapi begitu di lapangan, tubuhku langsung kaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813112
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813112,
					"content": "Apa aku memang harus latihan 3 sampai 5 tahun lagi seperti yang guruku bilang? Tapi malu banget kalau aku harus kembali dengan tangan kosong begini .... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813113
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813113,
					"content": "Aww, yah itu sih mungkin karena kami lebih pengalaman! Kami juga perlu waktu lama dan ngelewatin banyak pertempuran sengit sebelum bisa sekuat sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813114,
						706813118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813114,
					"content": "Pertama, kamu harus tenang dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813115
					]
				},
				{
					"id": 706813115,
					"content": "Iya! Para pemula biasanya langsung panik kalau pas harus berantem, makanya jadi langsung gugup terus malah enggak bisa gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813116,
					"content": "Walau musuh terlihat kuat, kamu tetap harus tenang. Amati dulu terus cari titik lemahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813117,
					"content": "Terus tinggal kamu hajar, dzig, bak bik buk, DUAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813120,
					"content": "Oh begitu ... Yang senior memang beda ya! Sepertinya aku memang masih harus mengasah kemampuanku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813121
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813121,
					"content": "Kamu juga lagi dalam perjalanan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813122
					]
				},
				{
					"id": 706813122,
					"content": "Iya ... Aku berencana pergi ke <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813123
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813123,
					"content": "Kamu pernah dengar seni bela diri Liyue? Kudengar orang bisa lompat dari atap ke atap terus lari di tembok, lalu melatih tubuh supaya jadi keras sampai tidak bisa dilukai oleh senjata apa pun, lalu mereka bisa membelah besi seperti keju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813124
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813124,
					"content": "Kalau aku bisa menemukan guru yang bisa mengajarkanku beberapa kemampuan, aku yakin petualanganku pun pasti bisa jadi lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813125
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813125,
					"content": "Tapi sejujurnya ya, walau aku sudah cukup lama jadi anggota Adventurers' Guild, ini pertama kalinya aku bertualang jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813126
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813126,
					"content": "*huff* Baru saja aku meninggalkan kota, eh langsung dihadang sama monster. Apa aku benar-benar bisa sampai di Liyue dengan selamat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813127,
						706813128
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813127,
					"content": "Kami sudah pernah ke Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813129,
					"content": "Wow! Ada senior hebat yang mau antar aku ... Perjalananku ada harapan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813130
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813130,
					"content": "Tapi, kamu pasti sibuk, kalau menghabiskan waktu buat jaga aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813131,
						706813132
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813131,
					"content": "Membela kebenaran itu sudah jadi rutinitas harianku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813133,
					"content": "Kalau begitu, terima kasih banyak ya! Oh ya, aku juga sudah pelajari petanya baik-baik, jadi aku akan berusaha supaya tidak jadi beban buatmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813132,
					"content": "Membantu pahlawan muda juga bagian dari tugasku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813128,
					"content": "Yuk sini, kami bisa antar kamu ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813118,
					"content": "Penting juga buat menilai situasinya dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813119
					]
				},
				{
					"id": 706813119,
					"content": "Iya! Kalau misal kamu tahu musuh kamu kuat banget, bagusnya langsung kabur saja dulu. Jangan coba-coba jadi pahlawan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813105,
					"content": "Aku lebih memilih tidak membocorkan identitasku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813106
					]
				},
				{
					"id": 706813106,
					"content": "Aku paham! Kamu pasti sedang menjalankan misi rahasia jadi harus diam-diam ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813107
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813107,
					"content": "Iya, kurang lebih gitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813108
					]
				},
				{
					"id": 706813108,
					"content": "Oke, cukup sandiwara misteriusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813109
					],
					"speakerTitle": "Paimon"
				}
			]
