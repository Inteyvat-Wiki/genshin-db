			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gesine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "Aku pasti akan simpan baik-baik foto ini, kan jarang-jarang bisa foto bareng petualang veteran sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Ah! Begitu sekarang bisa bersantai baru terasa deh laparnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Kalau dipikir-pikir, perut Paimon juga mulai keroncongan nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Yuk cari tempat istirahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Yuk coba lihat-lihat dan cari tempat makan di daerah sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Kayaknya di sekitar sini tidak ada restoran yang oke ... Karena kalian sudah bantu aku, aku jadi kurang enak kalau kita cuma makan di tempat biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "Ngomong-ngomong soal makanan, bangunan yang di atas batu besar itu <color=#00E1FFFF>Wangshu Inn</color> yang terkenal itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "Aku dengar dari pedagang Liyue yang berbisnis di Mondstadt kalau makanan mereka itu enak-enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Biar kutraktir kalian sebagai tanda terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Asik! Makanan enak gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, nyalain apinya dan mulai masak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Hei! Kok kamu nyuruh-nyuruh Paimon gitu sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "Lagian kan kamu tahu sendiri masakan Paimon kayak gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
