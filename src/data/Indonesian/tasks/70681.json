			"dialogs": [
				{
					"id": 706810401,
					"content": "Maaf! Bisa tolong tunggu sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Kamu kelupaan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "Tidak. Tapi kalau menurut petanya, kalau kita pergi lebih jauh lagi, artinya kita akan meninggalkan Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "Dan entah kapan aku akan kembali lagi ... Saat guruku melihat pesanku, mungkin dia bakal marah besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Tadi kamu bilang soal gurumu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Iya ... Waktu dia pertama kali jadi petualang, dia langsung ketemu Mitachurl di alam liar. Dan waktu bertempur, dia lengah, terus langsung dihantam oleh Mitachurl itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Dia beruntung karena ada kesatria lewat dan menolongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Dia begitu malu, akhirnya dia memutuskan untuk melatih dulu kemampuannya sampai dia keluar lagi. Dan sekarang dia sudah latihan selama sepuluh tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Dia selalu bilang dasar itu penting, tapi aku tidak bisa latihan sama boneka kayu terus-terusan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Jadi aku pergi tanpa berpamitan dengannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Kembalilah saat kamu sudah lebih kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Iya! Aku juga berpikir demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Ah, aku tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine mengeluarkan beberapa Dandelion Seed dari tasnya, meletakkannya di atas telapak tangannya. Dan mengucapkan beberapa patah kata sebelum akhirnya melepaskan Dandelion Seed tersebut terbang bersama angin ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Menurut tradisi kami, Dandelion terbang membawa harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Aku hanya berharap semoga perjalananku bisa lancar sentosa, lalu aku bisa menggapai tujuanku, dan guruku bisa memahamiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Aku yakin Archon Anemo telah mendengar permohonanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "Iya! Yuk pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Lakukanlah sesuatu yang bisa dibanggakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Dia petualang juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
