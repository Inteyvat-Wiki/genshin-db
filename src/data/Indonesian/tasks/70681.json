				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Di depan sana itu <color=#00E1FFFF>Dihua Marsh</color>, kan? Cantik banget! Pemandangan seperti itu tidak akan bisa dilihat di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Sudah kuduga bertualang memang keputusan yang tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Oh, iya! Kan tidak tiap hari kita lihat pemandangan begini, ayo kita foto bareng buat kenang-kenangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
