			"trigger": {
				"objectNames": [
					"Quiauhquetzal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Kalian berhenti di rak buku yang tinggi di samping ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "Di sini sudah aman. Ada apa, teman emasku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "Tidak ada sih, hanya penasaran saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Di sini, rak kayu sangat tinggi, pemandangannya luas, tempat yang bagus untuk bersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "Di Cal{RUBY#[D]Suku}pul kami, tinggal di permukaan tanah adalah hal yang berbahaya. Bahkan jika para Peng{RUBY#[S]Pemimpin Tertinggi}uasa di atas sana memutuskan untuk tidak membunuh kami secara tiba-tiba, para perampok dari Calp{RUBY#[D]Suku}ulli lain juga akan datang untuk merampok kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Hanya dengan bertengger di tebing dan di kanopi hutan seperti kukuk hijau, kita bisa melarikan diri dan bertahan hidup sebelum bencana datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Selain itu, Vindia bilang dia ingin melihatku terbang. Karena dia ingin ber{RUBY#[D]Menulis}nyanyi dan menunggangi burung raksasa di kisah petualangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "Apa dia benar-benar tidak menipumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "Tidak kok. Vindia adalah orang yang sangat baik, sama seperti Penguasa Persimpangan. Mereka berdua baik dan lemah lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "Tapi kalian hebat sekali bisa terbang sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "Ini untuk kalian, bukti pertemanan kita. Aku harus memikirkan cara untuk terbang lebih tinggi tanpa tertangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Meskipun di sini tidak ada peng{RUBY#[S]Pemimpin Tertinggi}uasa mulia, tapi juga tidak ada penakluk yang senang menguliti. Tempat ini aman, tapi ... aku sudah terbiasa mencari jalan keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "Aku khawatir kamu terjebak di atas dan tidak bisa turun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Terima kasih. Tenang saja, aku tidak terjebak kok. Aku aman kalau di tempat tinggi, tidak akan dibunuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}