			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Fairweather Frolic-mu sudah jadi. Silakan, coba dulu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Wow, jadi Fairweather Frolic itu warnanya begini ya ... Langit ungu ... Maksudnya malam yang cerah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Mungkin ini menggambarkan langit senja yang cerah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Coba Klee cicipi dulu ... Baru nanti Kakak pikirin lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Ah, selesai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Asyik. Manis DAN asem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Kalau Klee minum ini waktu makan ikan panggang, Klee pasti bisa nambah dua, tiga, empat, bahkan ... lima ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "Tapi satu gelas saja tidak cukup. Klee mau coba ... minuman yang rasanya mirip kue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Siap, bagaimana kalau \"Cake in a Cup\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "Hmm ... Klee enggak ngerti mau pilih minuman apa. Kak Honorary Knight bantuin Klee milih saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "Permen yang kamu bawa kelihatannya istimewa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Begini? Hehe ... Mama pernah ajarin aku cara buatnya di tempat alkimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Pakai gula ... terus tambahin gula lagi. Terus, terus, bunga yang dari teman Mama di Fontaine, madu bintang dari Tante Barbie, terus terakhir, selai ajaib dari Tante Tavia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Taruh semuanya di meja alkimia, dan doakan bentuk yang kamu mau, terus ikuti komat-kamit Mama, terus ... simsalabim! Permen berbentuk Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "Prosesnya luar biasa juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "Klee bisa kasih Dodoco Candy juga kalau Kak Honorary Knight mau! Kalau suka banget, Klee bahkan bisa ngajarin kamu mantranya Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "Jadi, nantinya Kakak bisa bikin permennya sendiri kapan pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Terima kasih sudah mau berbagi resep yang luar biasa, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Hehe, kalau mandek, tanya saja sama Klee. Kalau soal permen ajaib, Klee jagonya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Ada rencana lain buat hari ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Ada dong! Mama kasih Klee buku ajaib baru-baru ini. Dia bilang Klee harus baca satu bab setiap malam supaya bisa belajar hal yang berguna, terus tidur awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "Buku itu ajarin Klee cara buat \"bahan pembakar\". Jadi nan Jumpy Dumpty bisa \"DUARRR\" dan melambung lebih tinggi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "Em ... Yakin belajar gituan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Enggak susah sama sekali kok! Malahan mirip sekali kayak buat bom! Kita cuma perlu hati-hati waktu motong, anggap saja meraut pensil yang tiba-tiba bisa DUARRR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "Waktu tidur juga penting sekali buat Klee. Mama duduk di samping dan ceritain berbagai macam cerita yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Mama punya lampu yang terbuat dari permata, waktu dinyalakan, \"bling bling\", tiba-tiba langit-langitnya jadi terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Langit-langitnya bisa nunjukin ceritanya juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Iya!!! Kalau ada yang terjadi di ceritanya, lampunya nunjukin gambar yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "Kadang-kadang, Mama ketiduran sebelum ceritanya selesai, jadi Klee harus pakaikan selimut dulu buat Mama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "Kalau nanti Klee sudah jago cara pakai lampunya, Klee bisa nyeritain dongeng buat Kak Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "Baik, yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Hehe, Klee sudah hapal banyak cerita luar biasa, jadi bisa bawa kebahagiaan buat semua orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Rencana makan apa lagi hari ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Ya! Waktu sampai rumah, Klee bakal makan kacang asin sambil baca buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Klee biasanya makan kue sih setelah makan malam, tapi Master Jean bilang itu terlalu manis. Enggak bagus makan manis-manis sebelum bobo. Soalnya nanti kamu jadi gendut dan sakit gigi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "Jadi Mama dapat saran dari Tante Barbie, Katanya kalau banyak makan kacang, otak jadi lebih gampang ingat! Makanya sekarang aku disuruh nyemil kacang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Kacang enggak terlalu berasa sih, kayak lagi mengunyah daun ... Tapi kalau ditambah sedikit garam, tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "Boleh juga tuh resepnya, bergizi dan sehat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Tapi pasti ada makanan lain yang manis dan menyehatkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Oh ya, Klee masih mau makan yang manis lagi sih. Contohnya kue, mungkin krimnya dikurangi, dan tambahin buah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Oh ya! Teman mama yang sering pakai kacamata kasih Bulle Fruit Fontaine satu tas besar! Semuanya bulat-bulat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Klee makan banyak loh. Rasanya manis, dan Master Jean bilang enggak apa-apa, soalnya \"buah manis berbeda dengan gula yang manis!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Jadi kalau Klee wajib makan kacang, mungkin bisa direndam di jus buah dulu kali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Ngomong-ngomong soal makanan, apa Klee makan tiga kali sehari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Sehari tiga kali? Hehe, Klee makannya sih lima kali sehari, kadang tujuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Serius?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Soalnya bertualang itu kan capek, kalau sekali makan banyak, Klee susah lari ... Jadi mending makan dikit-dikit tapi sering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Biasanya Albedo yang siapin makanan Klee sih, kotak makan Klee selalu disusun bagus sekali, kayak lukisan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Yah, Albedo emang gitu sih orangnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Kalau Albedo lagi sibuk di Dragonspine, Klee pergi makan sama Knights of Favonius yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "Kemah Kaeya biasa yang paling rapi, kalau Amber biasa berkemah di hutan-hutan, jadi seru! Oh! masakan Tante Hertha juga enak-enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "Waktu mama balik, bakal ada lebih banyak makanan lagi. Pernah sekali dia ambil beberapa jenis ikan dan dijadikan petak puding, namanya Rainbow Fish Jelly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Duh, sumpah jadi ngiler ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "Chococo Crunchy Slices-nya juga enak banget! Itu kreasi terbaru Mama, dibuat dari cokelat sama kue! Rasanya agak pahit dikit, tapi renyah, wanginya menggiurkan, dan rasa manisnya di akhir itu enak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Setiap kali makan itu, rasanya penuh energi ... Lain kali, Klee bawain ya biar Kak Honorary Knight bisa nyobain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Baiklah, kurasa aku tahu cara menyempurnakan minuman itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Aku racikkan minuman lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Oh ya? Cepat banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Klee enggak sabar buat nyobain ramuan lezat Kakak yang selanjutnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Makanan enak dari petualang hebat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Jadi ngiler deh dengarnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "Aku akan tunggu Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "Anu ... Kok kayaknya susah ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "Aku akan belajar keras supaya bisa begitu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Sungguh camilan yang luar biasa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Oke! Klee bersiap untuk minuman super enak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Klee, pilih rasa apa saja boleh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "Warnanya enggak terlalu pas nih ... Gimana kalau aku ubah sedikit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
