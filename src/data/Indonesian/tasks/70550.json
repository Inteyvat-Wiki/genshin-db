			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "Hah? Ka-Kak Honorary Knight?! Yey, ternyata benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "Hai, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Haha, Kak Eula bilang sama Klee kalau Tante Hertha sudah dapat orang hebat yang mau bantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "Karena lihat ada Kak Honorary Knight di sini, Klee yakin di sini pasti jadi stan minuman terbaik di seluruh Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "Terima kasih, Klee. Itu memang target akhir kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "Me-Memangnya sekarang masih belum yang terbaik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "Yah ... dari semua stan minuman yang pernah Klee kunjungi, punya Kak Honorary Knight sih yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "Dan ... minuman apa pun yang dibuat sama Kak Honorary Knight, pasti buat Klee bakal selalu enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "Klee, kami harap kali ini lebih jujur saja dalam menilai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Oh ... Oh! Kamu mau aku jadi kasar? Tapi ... Tapi Klee enggak pernah bisa kasar sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Hmm ... Aku pikirkan dulu ya ... Oke! Aku akan pura-pura jadi Albedo saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Setiap kali Albedo periksa kerjaan Timaeus, mukanya jadi super serius, dan Klee bisa dengar setiap kata yang dia bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Luar biasa, berarti bisa jadi guruku dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Hehe ... Siap-siap sama pesanan luar biasa Klee ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "Klee bakal ngebom ikan sama Mama. Tapi jangan kasih tahu Master Jean ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Klee dan Mama sudah mengebom banyaaak banget ikan hari ini. Jangan kasih tahu Master Jean ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "Akhir-akhir ini, Klee senangnya kayak dibom karena bisa main sama mama seharian. Seru sekali! Bahkan dikurung pun enggak masalah lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Jadi, Klee mau pesan Fairweather Frolic. Cuaca yang cerah dan rasa berjemur di bawah matahari pasti bisa buat Klee menggebu-gebu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Siap, Nona Klee. Dibuat sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Hihihi, kira-kira rasanya kayak apa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Laksanakan, Guru Besar Alkimia Klee. Akan segera kukerjakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Luar biasa! Berarti kamu bisa jadi Guru Besar Alkimia Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Kali ini kamu boleh kritik aku sepuasnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "Terima kasih, Klee. Aku sedang berusaha keras untuk jadi yang terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Halo, Pelanggan Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
