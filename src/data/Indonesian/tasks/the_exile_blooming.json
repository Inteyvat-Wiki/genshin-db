			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Kalau bukan karena kalian, aku mungkin tidak bisa lihat mawar-mawar itu tumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "Kalau sudah tahu dari awal, aku sudah pasti akan bawa buku daripada benih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "Oh, kamu bukan orang lokal sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Kamu kaget? Kalau begitu artinya bisa dibilang aku bisa beradaptasi dengan baik di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "Waktu pertama kali datang, aku tidak terbiasa dengan cara berpakaian, makanan, dan kebiasaan sehari-hari di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "Tapi lama kelamaan aku jadi biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "Tapi itu cuma di permukaan saja. Bukan berarti hati ini bisa terima kondisi begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "Mawar yang bisa bermekaran di Kota Sumeru, tetap saja susah mekar di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Apa kamu seorang Peneliti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Aku ... pernah disebut peneliti, tapi sekarang sudah tidak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "Aku mengatakan sesuatu di luar batasanku, dan mempelajari sesuatu yang seharusnya tidak aku pelajari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "Itu melanggar apa yang Akademiya anggap tabu, jadi aku tidak mau lagi jadi Peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "Maksudmu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "Rasa ingin tahu adalah motivasiku dalam mencari kebijaksanaan, tapi juga jadi sumber dosaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "Aku baru menyadarinya sesudah aku diusir sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "Untuk alasan keamanan, sebaiknya aku tidak menceritakannya secara detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Ehem, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "Aku kira petualang itu datang dan perginya selalu terburu-buru. Sekali dimintai tolong bisa jadi kamu tidak akan kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "Tapi tidak kusangka, aku masih bisa mengobrol banyak denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "Sejujurnya, aku jarang bicara dengan orang lokal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Apa kamu besok bisa datang untuk bantu memberinya pupuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "Oke, aku akan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Kenapa kamu mau tanam mawar Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Kamu mungkin tidak terlalu memahaminya. Kegunaan tanaman ini banyak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "Bisa dimakan, dijadikan obat, dijadikan suvenir, dan punya nilai ekonomis yang tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "Itu semua cuma kegunaan yang biasa ditemui di kehidupan sehari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "Bunga, daun, dan batang mawar Sumeru tidak selalu seperti apa yang kita temui sekarang. Dulu punya bentuk yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "Aku pikir perubahan kondisi geografis memicu perubahan karakteristik mawar Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "Dilihat dari proses evolusi bentuknya, kita juga bisa tahu informasi riwayat geografisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "Ini bukan hal yang mudah dijelaskan. Mungkin bisa menyalahi aturan kalau menjelaskannya kepada petualang yang lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "Pergilah ke Akademiya kalau kamu tertarik dengan evolusi tanaman. Di sana infonya lebih lengkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "Jadi kamu melakukan ini untuk penelitianmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Aku bukan peneliti lagi, sudah tidak lagi memenuhi syarat dan kualifikasi untuk meneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "Kamu mau dengar alasannya ya ... *huff* kamu penasaran sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "Dulu aku menanam banyak mawar Sumeru di rumah lamaku. Semuanya terlihat cantik waktu bermekaran. Setiap hari aku bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "Kalau bisa, aku mau bisa melihat mereka setiap hari seperti dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "... Itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "Aku paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
