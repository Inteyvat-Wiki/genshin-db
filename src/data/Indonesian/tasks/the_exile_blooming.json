				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "Kamu tidak punya Vision, tapi malah bisa memakai kekuatan Dendro. Kamu pasti bukan petualang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "Konon memang ada sekelompok orang yang bisa menggerakkan kekuatan elemen tanpa bantuan Vision. Tapi rumor yang beredar tentangnya tidak terlalu bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "Tapi aku percaya kalau kamu orang baik. Jangan coba-coba menyimpang ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}