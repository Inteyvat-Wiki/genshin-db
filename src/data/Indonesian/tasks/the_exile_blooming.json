			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Terima kasih sekali lagi ya. Aku benar-benar sangat senang kalau mawar Sumeru-nya bisa tumbuh di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "Sewaktu Sabbah bicara dengan kalian, serumpun daun baru mulai muncul ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Daunnya terbuka, memperlihatkan kuncup bunga.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Tunasnya merekah pelan-pelan. Sumeru Rose yang ditanam Sabbah akhirnya mekar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Dia memetik setangkai dan memberikannya kepadamu dan Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Jangan begitu ... Kan dari awal juga kamu enggak banyak nanamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "Tidak apa-apa. Kalau saja bukan karena bantuan kalian, mawar Sumeru-nya tidak akan mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "Cuma bantuan kecil saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Sebidang taman mawar sudah tentu sangat megah, tapi setangkai mawar punya keindahannya sendiri. Aku sangat tertarik pada mawar waktu masih jadi peneliti dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "Apa? Kamu peneliti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Oh iya, aku belum kasih tahu Paimon. Aku dulunya bukan tinggal di Desa Aaru, tapi \"pindah\" dari Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "Tuh kan kata Paimon juga apa, gaya bicara Nona Sabbah anggun banget, kayak peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Kamu tanam ini karena masih mau menelitinya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "Tidak seperti itu juga sih. Ketertarikan peneliti pada objek penelitiannya bukan karena hanya agar bisa melakukan penelitian saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "Aku melakukan ini karena mencintai dunia ini dan ingin memahami siklus hidup tumbuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "Ambil saja contoh diriku. Dulu aku punya topik penelitian yang judulnya \"Pengaruh Perubahan Lingkungan Geografis Terhadap Morfologi Spesies Mawar Sumeru\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Coba kamu pikirkan, kalau arah perubahan lingkungan geografis Sumeru sekarang berbeda total, bagaimana agar mawar-mawar ini bisa adaptasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Apakah akan berubah jadi tanaman rambat? Kalau benar begitu, tembok Akademiya mungkin sudah dipenuhi mawar rambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Ataukah akan berubah jadi rumpun bunga? Sekali mekar akan ada banyak sekali bunganya, keren kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Mungkin saja akan ada jenis spesies yang baru, yang berwarna-warni ... putih, merah, emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Pastinya sekarang sudah sedikit orang yang menemukan spesies baru. Jadi lupakan saja budidaya spesies baru seperti yang dilakukan peneliti zaman dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "Yang mau kukatakan adalah: setiap tangkai mawar punya banyak sekali kemungkinan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Menyelidiki segala kemungkinan itu sangat menyenangkan. Aku dulu bahkan asyik mengoleksi banyak sekali spesimen tiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Kalau kuingat-ingat lagi, benar-benar waktu yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "Singkatnya, ambil saja. Aku tidak merasa kehilangan, malahan bisa berbagi kebahagiaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "Kalau kamu masih merasa canggung, ke depannya sering-seringlah saja mengunjungiku sambil membawa Sumeru Rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "Aku nyaman bicara dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "Tidak peduli apa yang kubicarakan, kalian tidak akan menganggapku sedang membual dan menyela pembicaraanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "Aku mau beri kalian sedikit oleh-oleh. Walaupun sekarang kurang berguna untukku, tapi mungkin saja kalian menyukainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "Kita akan sering-sering kemari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Iya, sering-seringlah kemari dan kunjungi aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Tidak usah dimasukkan ke hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
