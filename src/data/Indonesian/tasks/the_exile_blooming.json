			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Kalian sudah datang, benar-benar tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "Aku membuat beberapa Butter Chicken. Kamu bisa makan bersama kami kalau lapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Butter Chicken! OKEEE, Paimon mau yang porsi besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Paimon, etikamu di mana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Oke, maaf ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "Tidak apa-apa, jangan sungkan-sungkan. Suka makan itu wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "Akan kuhangatkan dan kubungkus buat kalian. Anggap saja ini tanda terima kasihku karena kalian sudah membantuku dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "Nona Sabbah memang yang terbaik! Mawar yang kamu tanam pasti akan tumbuh dengan baik, seperti yang kamu harapkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Haha, akan terus kujaga kelembapan tanah di waktu-waktu ini. Kondisi bibit tanamannya juga masih bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "Aku cuma khawatir kalau mereka lambat tumbuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Biasanya kalau kondisi benihnya bagus akan cepat berkecambah. Tapi sampai sekarang ini tidak ada pergerakan apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "Aku tidak tahu apakah karena tanahnya tidak cukup subur. Kalau kondisinya masih saja seperti ini, aku akan tambah pupuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Tambahkan sekali lagi pupuknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Kalau begitu tolong aku lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "Tidak masalah, serahkan saja pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Kita coba pakai kekuatan Dendro lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Maaf, Paimon memang begitu anaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
