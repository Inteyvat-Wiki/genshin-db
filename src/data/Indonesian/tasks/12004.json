			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "Hmm, dari sini kita pergi ke mana ya...? Rencananya gimana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040102,
					"content": "Pengembara, Paimon. Tunggu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040103,
					"content": "Eh? Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040104,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "Sesuatu telah terjadi, dan aku ingin meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040106,
					"content": "Tapi tolong jangan khawatir. Ini bukan permintaan dari Yashiro Commission atau Klan Kamisato. Ini permintaan dariku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040107,
					"content": "Dari dirimu sendiri? Maksudmu... personal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040108,
					"content": "Benar. Ini menyangkut ibuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040109,
					"content": "Mungkin ini terlalu tiba-tiba... tapi di mataku, kamulah satu-satunya orang yang bisa kupercaya dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040110,
					"content": "Bisa tolong ceritakan lebih detail?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "Beberapa hari lalu, aku sedang memilah beberapa barang lama peninggalan keluarga lalu aku menemukan sebuah buku catatan milik ibuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040112,
					"content": "Dia menulis banyak hal, sebagian besar hal-hal kecil. Tapi yang menarik perhatianku adalah sebuah nama — nama yang belum pernah kudengar sebelumnya, dan dia sering menyebutkannya... sehingga sulit bagiku untuk mengabaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040113,
					"content": "Mungkin sahabat ibumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040114,
					"content": "Kamu benar-benar belum pernah dengar namanya? Sekali pun juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "Tidak pernah. Dan walaupun ayah ibuku meninggal beberapa tahun lalu, aku dan kakakku cukup akrab dengan sebagian besar kenalan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040116,
					"content": "Jadi... aku penasaran sekali tentang orang misterius ini, aku ingin sekali bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040117,
					"content": "Berdasarkan buku catatan, namanya \"Tsubaki\". Sepertinya orang ini penting sekali bagi ibuku. Seseorang dengan banyak kepribadian yang suka bersenang-senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040118,
					"content": "Paimon rasa itu nama perempuan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040119,
					"content": "Aku setuju... Dan aku ingin bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040120,
					"content": "Jadi, kamu mau kita melakukan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040121,
					"content": "Apa kamu mau kita menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040122,
					"content": "Tidak, tidak, alamatnya ada di buku catatan — kita bisa langsung pergi ke sana. Aku ingin kamu membantuku mempersiapkan hadiah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040123,
					"content": "...Tolong jangan sampai apa yang kukatakan padamu tadi terdengar orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040124,
					"content": "Tindakan yang tepat adalah dengan melibatkan kakakku dan mengunjunginya bersama, tetapi dia sangat sibuk, dan... aku tidak ingin melibatkan orang Inazuma untuk masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040125,
					"content": "Jadi kamu meminta tolong padaku, orang asing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "Tepat sekali. Karena hal itu, dan juga karena kamu baik hati, punya sopan santun dan peduli terhadap orang lain... juga terpercaya. Aku tidak akan merasa nyaman dengan orang lain dalam situasi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040127,
					"content": "Serahkan saja pada kami! Kami sudah pernah menyiapkan hadiah untuk berkunjung sebelumnya, jadi kami harusnya bisa bantu. Mengenai bayarannya... cukup traktir kami makan enak saja kami sudah senang kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040128,
					"content": "Bagus sekali — malahan, aku juga berharap untuk memakai kesempatan ini agar bisa membawamu berkeliling. Itu juga jika kalian tidak keberatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040129,
					"content": "#Tidak, kami tidak keberatan kok! Ya kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040130,
					"content": "Boleh saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "Terima kasih banyak! Kalau begitu, kita berangkat sekarang? Pertama ayo ke Ogura Textiles & Kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040132,
					"content": "Oke! Setuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}