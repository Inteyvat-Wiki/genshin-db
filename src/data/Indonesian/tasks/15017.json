			"dialogs": [
				{
					"id": 150170201,
					"content": "Sampai. Rumahnya cukup keren, kan? Sebentar ya, aku ketuk dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "Tlazolli! Orangnya sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "Tlazolli! Ada di rumah kan? Buka dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Aneh ... pintu dikunci, tapi biasanya jam-jam segini dia ada di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Nechca? Nechca, kamu dengar? Ini Cheven. Boleh tolong bukain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Tidak ada jawaban ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Tapi aneh, aku sudah bicara sama Tlazolli soal ini ... apa dia bawa Nechca pergi berobat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Eh, apa itu di sana? Kok mirip sarang Tepetlisaurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Betul. Tlazolli punya rekan Tepetlisaurus. Kalau tidak salah, namanya ... Iengu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Waktu dia masih jadi pengrajin, dia biasa minta Iengu bantu-bantu urusan gali-menggali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Tapi semenjak Nechca sakit, Tlazolli tidak pernah suruh dia pergi menggali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Tunggu sebentar ... tempat ini berantakan sekali! Iengu juga tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Wah, lihat kotak-kotak ini! Hancur semua. Pasti ada terjadi sesuatu nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Kita lihat dari dekat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Nona Cheven diam di sini dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh ... baik! Aku cari tempat sembunyi deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Benar-benar deh, apa bibir Imix tuh sebegitu diberkatinya sama Wayob? Setiap kali dia bilang ke aku untuk tidak ke tempat bahaya, selalu saja jadinya malah ketemu bahaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Mau didobrak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Apa mungkin mereka kenapa-kenapa? Atau penyakit Nechca ... aduh, jangan, jangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Jangan mikir kejauhan dulu. Terakhir kali aku ke sini mereka masih baik-baik saja. Nechca lagi bobo nyenyak di kamarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
