			"dialogs": [
				{
					"id": 150170101,
					"content": "Oh, kalian cepat sekali datangnya. Sudah tidak sabar ingin hadiah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Kami senang kok bisa ketemu sama Tlazolli dan Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Iya! Nechca sakit, dan Bu Tlazolli harus rela berhenti dari kerjaan yang dia suka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Sekarang kondisinya membaik, tapi enggak ada salahnya kan bantu semangatin mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, aku sudah titip pesan ke Tlazolli kalau kita mau mampir. Dia pasti lagi siap-siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Ayo berangkat. Imix, boleh jaga toko sebentar? Aku sebentar juga balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Iya, kira-kira apa ya hadiahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Paimon juga penasaran ... tapi kita sekalian mau nengok Nechca juga kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Setelah sakit parah gitu, entah gimana keadaannya sekarang. Terus Bu Tlazolli juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Dia pasti sedih karena harus berhenti dari kerjaan yang dia suka ... Kami mau semangatin dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
