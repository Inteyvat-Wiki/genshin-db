			"dialogs": [
				{
					"id": 150170401,
					"content": "Oh, ada Tepetlisaurus tuh di atas sana. Tapi entah punyanya Bu Tlazolli atau bukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Setidaknya dia tidak dalam bahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Hmm ... ini kita ngapain sih. Kita kan ke sini nyari Bu Tlazolli. Dan dia enggak kelihatan tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#Heeei! {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "Nona Cheven teriak tuh! Ada apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Di sebelahnya ada orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Kalian turun dulu, cepat! Tlazolli ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "Hah? Kita barusan naik, dan tahu-tahu Bu Tlazolli sudah balik? Kok kebetulan banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Intinya kita turun dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Hmm? Kenapa Tepetlisaurus ini ikut ... WOI, WOI, jangan lari! NANTI NABRAK KITA WOOOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Kalian pun turun gunung bersama Tepetlisaurus itu ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, sini ... kamu nakal lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Saurian pintar. Lapar ya? Maaf ... nanti aku bikinin yang enak deh buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Oke, sana main dulu. Nanti aku nyusul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "Wuaa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "Maaf ya, kalian berdua. Aku tadi lagi nunggu di rumah, lalu Nechca ... dia kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "Waktu ketemu, dia bilang dia cuma keluar cari bunga cantik untuk dihadiahkan ke tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Dia pergi memetik bunga, lalu tersesat. Untungnya sudah ketemu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Dia baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Iya, Nona Cheven cerita kalau dia baru sembuh dari sakit parah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Badannya masih lemah. Karena keluar terlalu lama, dia jadi masuk angin. Demam juga, tapi tidak tinggi. Dia sudah makan obat dan sekarang sudah tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Tidak parah kok. Istirahat semalam juga pasti sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Tapi artinya dia tidak bisa ketemu kalian hari ini. Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Oh, santai saja! Nona Cheven sudah cerita kok kalau Nechca tadinya sakit parah, dan pemulihannya juga enggak gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Kami memang datang buat nengokin dia sih, tapi santai saja. Yang penting anaknya sehat dulu deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Apa sekarang sakit parahnya sudah sembuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "Yah, sekarang dia sudah bisa ngobrol denganku. Sudah bisa menjalani keseharian seperti biasa juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "Itu sudah perkembangan yang sangat bagus. Aku juga sudah sangat bersyukur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "Eh, kenapa malah jadi murung gitu? Ayo, semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Makasih loh dia usaha mau menyambut kami pakai bunga. Ngomong-ngomong, Tlazolli. Soal yang tempo hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "Oh, hadiah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "Iya! Kayak gimana sih hadiahnya? Kasih tahu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Ah, namanya \"Ukiran Permata Bara\". Dia ditempa dari bijih paling murni yang kebal erosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Tekniknya juga sebetulnya berakar dari cara pembuatan Marga Kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Jadi ini ibaratnya Marga Kuno yang lebih sederhana, gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Eh, jangan bilang gitu! Berabe kalau kedengaran sama Wayob. Aku cuma pakai tekniknya untuk mengolah bijih jadi batu permata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Waktu pertama kali bikin ini, aku tidak tahu apa gunanya selain cantik dan kebal erosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Tapi Cheven punya ide. Jadikan batu permata ini \"perhiasan\" yang unik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "Ukiran Permata Bara ciptaan seorang pengrajin Marga Kuno. Nama yang diukirkan ke atasnya tidak akan pudar sampai selamanya-lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Keren kan? Bisa laku keras tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Yah, keterangannya sih memang bikin benda ini kerasa super spesial banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Otak bisnisnya jalan juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Haha, Ukiran Permata Bara-nya Tlazolli memang betulan spesial kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Berita yang beredar mulut ke mulut itu tidak bisa diandalkan. Semakin tersebar luas, semakin banyak pula bagian yang terlupakan, atau jelek-jeleknya malah jadi salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Tapi kata-kata yang diukirkan ke atas batu permata ini akan bertahan sampai seterusnya! Jelas dan tidak bisa diubah-ubah seenaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "Hadiah yang bagus kan? Mau dikasih buat teman oke, pacar oke, atau buat saudara-saudara juga oke banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Sengaja ya? Biar aku beli juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#Iya loh, Paimon enggak sadar sudah ngerogoh kocek nih! {NICKNAME}, beli satu yuk? Tulisin nama kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "Terus setelah kembaranmu ketemu, kita tambahin nama dia juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "Jadi nama-nama kita bakal nempel terus, sampai selama-lamanya! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Si Paimon sudah kemakan nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "Sudah, jangan jadi sungkan gitu. Kalian menolongku dan menyelamatkan kado ulang tahunnya Nechca. Ini sih kecil saja dibanding jasa kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, aku kan sudah bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "Eh, kenapa gantian Tlazolli yang jadi sungkan? Ini hadiah bagus, beneran! Aku tahu usaha kamu segimana waktu bikin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "#Terima kasih Cheven, terima kasih {NICKNAME}. Barangnya akan segera aku buat. Kalau sudah selesai, nanti kalian bisa tulis nama sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Saat itu Nechca juga pasti sudah sehat. Dia pasti senang kalau ditengok sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Barang bagus jangan disimpan sendiri saja, ya kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "Eh, yakin nih? Ini kayaknya harganya enggak murah loh ... kamu yakin duitnya cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Sebentar ... ini bukan akal-akalan Nona Cheven buat bikin kami keluar duit, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "Bisa iya, bisa tidak. Soalnya kalian kelihatan kayak banyak duitnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#Waduh, waduh. Bahaya! {NICKNAME}, hati-hati sama dia! Nanti tahu-tahu Mora kita ludes semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Haha! Silakan, kalian diskusi sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "Wuaa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "Wah? Tepetlisaurus itu datang lagi! TOLONG, seseorang halangin dia! Paimon enggak mau diseruduk lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Hei! Tenang, tenang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Tlazolli, aku juga mau minta tolong. Boleh perbaiki Ukiran Permata Bara punyaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Waktu diserang tadi, batunya jatuh tak sengaja. Tali dan jepitnya patah, makanya tidak dipakai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Aku sudah coba perbaiki, tapi tidak betul-betul. Boleh tolongin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Bisa, bisa. Kasih aku saja, nanti tahu-tahu sudah seperti baru lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "Terima kasih Cheven, untuk ... sengaja repot-repot dan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Sudah, itu bukan apa-apa kok. Kami cuma ingin supaya Nechca cepat sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "Kamu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Iengu, jangan nakal! Nanti ada makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "#Setelah Ukiran Permata Bara-nya selesai, Cheven akan menghubungimu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Mungkin waktunya bisa dibarengin sama ulang tahun Nechca. Sekalian pesta lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "Hehe, berarti bakal ada makanan enak! Asyik, kami pasti datang, dengan perut kosong tentunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Sampai ketemu lagi ya, Tlazolli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Sampai jumpa. Kalian juga sehat-sehat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "Nechca pasti senang kalau bisa ketemu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Semoga Nechca cepat sembuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Beli hadiahnya agak banyakan deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Duh, kayaknya bernilai banget ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Kamu bisa banget ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "Iya kan! Barang bagus nih. Beli satu, tulisin nama kita. Terus setelah kembaranmu ketemu, kita tambahin nama dia juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Pantas bisa punya toko sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "Waktunya kasih hadiah ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Yah, dia sudah bisa kabur keluar kan? Berarti sudah sehat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Iya, dan dia larinya cepat betul kalau aku suruh makan sayur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Bisa ke kolong kursi, ke kolong meja ... ke mana-mana lah. Aku tidak bisa tangkap dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Makanya aku bersyukur sekali ... melihat kondisi dia yang seperti sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Iya. Kebetulan banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "Sudahlah, intinya kita turun dulu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "Sepertinya dia naik ke sana sendiri ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
		{
			"id": 1501706,
			"completionStepIds": [],
