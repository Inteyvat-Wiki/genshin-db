				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "Senior, sudah setengah hari, tapi monsternya masih banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870102,
					"content": "Apa kami perlu panggil bala bantuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870103,
					"content": "Jangan panik, percaya saja pada meriam dan rekan-rekan kita yang tidak pakai seragam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870104,
					"content": "Lagian, ada petualang yang punya penciuman tajam dan petugas yang pasti datang kalau misal benar-benar darurat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870105,
					"content": "Darurat apa nih? Siaga berapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "Datang kan ... Purwa-Kapten dan asisten kecilnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870108,
					"content": "Halo, kalian berdua. Izin menjelaskan situasinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870109,
					"content": "Gimana kalau kamu napas dulu? Aku saja yang lapor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870110,
					"content": "Hai! Mau coba pakai meriam? Kesempatan seperti ini jarang ada, apalagi sejak armada kami dihancurkan. Ini seperti kembali ke zaman ratusan tahun lalu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870111,
					"content": "Bikin monster jadi perkedel pakai amunisi meriam super istimewa ... kegiatan sempurna buat relaksasi! Terus dikasih hadiah pula sama Garde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870112,
					"content": "Bikin monster jadi perkedel pakai meriam ... kami banget enggak tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "Kayaknya simpel saja ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "Purwa-Kapten, aku paham betul perasaanmu. Tapi situasi ini sebenarnya cukup genting, biar aku jelaskan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870116,
					"content": "Baru-baru ini, ada sekelompok pekerja yang tak sengaja menemukan reruntuhan di area sini. Monster-monster yang bersarang di dalamnya jadi terganggu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870117,
					"content": "Supaya monsternya tidak berhamburan keluar dan bikin onar, Garde langsung menetapkan zona pengurungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870118,
					"content": "\"Zona pengurungan\" yang dimaksud adalah, untuk saat ini ... cuma dua orang ditambah satu petugas Melusine yang kebetulan sedang berlibur di sini ... dan tentu saja meriam istimewa kami ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870119,
					"content": "Wah, itu enggak bahaya apa? Duh, semoga Melusine-nya enggak kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Tenang, meriam yang di pintu masuk reruntuhan bisa dikendalikan dari jauh. Dia bisa mengawasi monster tanpa harus mendekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870121,
					"content": "Dia sangat bisa diandalkan, tapi operasinya sudah berjalan cukup lama dan dia pasti lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870122,
					"content": "Apa Purwa-Kapten bersedia turun tangan? Kalau situasinya dibiarkan begini terus, aku harus panggil bala bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870123,
					"content": "Chenee, kamu ngomong apa sih? Masa tidak tahu Purwa-Kapten kita ini sejago apa? Kalau dia yang pegang kendali, sebentar juga meriamku bakal bikin semua monster yang muncul jadi perkedel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870124,
					"content": "Oke, cukup penjelasannya. Aku mau coba ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "Menjauh dari bahaya? IIIH, bukan kami banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Keren! Terima kasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870128,
					"content": "Setelah uji coba terakhir, aku membuat sedikit penyesuaian ke meriamnya. Semoga jadi lebih mudah dikendalikan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870129,
					"content": "Ck, kalau saja kita bisa bikin meriamnya membidik dan menembak otomatis ... keren enggak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870130,
					"content": "Ide bagus! Habis ini aku coba pasang modul identifikasi sasaran dari Gardemek! Harusnya bisa bikin meriamnya kerja otomatis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870131,
					"content": "Solusi cerdas! Kamu jenius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870125,
					"content": "Aku bantu! Genting atau tidak, selalu bantu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Tapi kenapa monsternya harus dijadiin perkedel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "Pas banget enggak waktunya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
