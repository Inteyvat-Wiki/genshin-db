				]
			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Hmm, aku pernah mencium aroma seperti ini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520402,
					"content": "Oh ya? Di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "Kamar Sandrone. Dia punya minuman yang baunya mirip seperti ini. Aku tertarik sekali, dan waktu dia sadar ... dia sengaja tidak habiskan minumannya, cuma dipegang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520404,
					"content": "Nyaris seperti ... dia menunggu aku bertanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520405,
					"content": "Jadi ... kamu nanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520407,
					"content": "Nanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "\"Kenapa minum itu? Bukannya kamu harusnya minum oli mesin ya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520409,
					"content": "Terus ... dijawab apa sama dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520411,
					"content": "Jawabannya ... sangat tidak enak didengar. Lebih baik kalian tidak usah tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520412,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520413,
					"content": "Baru seteguk sudah langsung malas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Maaf, soalnya rasanya pahit sekali ... tidak enak. Pantas saja Sandrone selalu menekuk mukanya setiap kali minum ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520415,
					"content": "Kata Paimon sih alasannya bukan cuma itu doang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
