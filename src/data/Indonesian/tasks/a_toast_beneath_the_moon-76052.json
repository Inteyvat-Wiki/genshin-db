				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520102,
					"content": "Columbina, kamu kenapa? Lagi enggak enak badan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Oh, halo kalian. Aku baik-baik saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520104,
					"content": "(Dia keingat bulan lagi ya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520107,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520108,
					"content": "Santai, cerita saja! Urusan sepele pun kalau sudah dikeluarin pasti rasanya lega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Aku ... ingin coba minuman dari kedai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520110,
					"content": "Wa ... LAH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520112,
					"content": "Maaf, Paimon agak kaget tadi. Kamu belum pernah bilang kepingin sesuatu sih, jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "Terus kamu ... ingin minum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Kenapa? Kamu kira kalau dia mulai kepingin sesuatu, maunya pasti yang wah gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Sejujurnya iya. Kayak ... \"ambilkan bulan\" atau apa gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Tapi ya masuk akal juga sih sebenarnya. Columbina sekarang kan lagi enggak bebas ke mana-mana, jadi kalau dia sembarangan muncul di kedai, ya ... mending sekalian saja pergi ke bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Bukan cuma sekarang sih. Waktu aku masih sama Fatui pun, saat belum ada perintah penangkapan ... semua orang sangat menjaga jarak setiap kali aku keluar jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520118,
					"content": "(Harbinger Fatui Nomor-3 ... ya iyalah, gelar itu saja sudah cukup buat bikin orang enggak kenal minggat begitu lihat dia.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Sebentar, ini ... kayaknya enggak sesulit yang dibayangin Paimon deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Kedai sih enggak usah diharapin lah ya, tapi kalau minuman ... bisa banget! Kita punya {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520122,
					"content": "Tapi jangan terlalu ngarep juga, nanti jatuhnya sakit. Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Suka rasa yang kayak gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Rasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520125,
					"content": "Aku tidak punya pengalaman pesan minuman, jadi ... tidak tahu harus mulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520126,
					"content": "Mungkin jangan yang terlalu ... berat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520127,
					"content": "\"Berat\" di sini maksudnya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Berat seperti ... jaket Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520129,
					"content": "Waduh, jawabannya malah bikin makin bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Oke, ringan dan halus ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Oke, serahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520131,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
