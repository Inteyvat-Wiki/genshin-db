				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520202,
					"content": "Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Aku jadi ingat ... waktu dulu masih tinggal sama Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520204,
					"content": "Mereka suka bikin minuman dari daun mint, rempah, dan buah beri kering yang diseduh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520205,
					"content": "Setiap kali lewat rumah jemaat di sana, selalu ada wangi herbal seperti itu yang menyeruak keluar dari jendela ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520206,
					"content": "Pernah cobain rasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Belum pernah. Padahal ingin sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520208,
					"content": "Kenapa belum pernah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Waktu \"dewi\" datang mengetuk pintu rumahmu dan berkata \"boleh aku coba minumannya?\" ... Tidak ada seorang pun berani menyajikan \"minuman rakyat\" yang biasa mereka konsumsi sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520210,
					"content": "Ah ... iya juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Jadi kalau aku minta begitu, yang akan mereka berikan lebih seperti \"sesajian\" yang khusus disiapkan untuk dewata, lengkap dengan kemasan dan hiasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520212,
					"content": "Bukan berarti yang begitu tidak enak ya. Cuma ... yah, jadi tidak ada kesan \"rumahan\" dan \"merakyat\"-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520213,
					"content": "Hehe, sekarang kan ada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520215,
					"content": "Rasanya enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520216,
					"content": "Tapi ... aku kurang paham kenapa harus ditambahkan susu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520217,
					"content": "Ah, soalnya racikan ini asalnya dari Mondstadt. Di sana, orang-orangnya suka nambahin susu, krim, dan gula ke teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "Aneh ... tapi bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520219,
					"content": "Fiuh, untung kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Mm ... makasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520221,
					"content": "Terang bulan bukan satu-satunya wahana untuk melihat ke masa lalu. Bahkan sesuatu yang sederhana seperti aroma minuman pun dapat membangkitkan kenangan yang telah lama terlupa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
