			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "Apa kamu sudah menemukan sinyal pandu milikku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Coba kulihat, benar, ini adalah sinyal pandu milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Dalam keadaan seperti ini... barang-barang itu pasti sudah dilempar oleh para monster-monster itu, untung saja tidak rusak semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "*huff* Tapi sepertinya sinyal pandu ini untuk sementara tidak dapat digunakan... biarlah, jika tidak dapat mengukur secara lengkap ya sudah kalau begitu ukur sedikit saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Aku masih memiliki beberapa sinyal pandu di sini, bisakah kamu membawanya dan meletakkannya di atas gunung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "Di mana aku harus menaruhnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "Kamu bersedia membantuku ya! Terima kasih, aku akan menandai lokasinya di peta untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "Baiklah, sudah kutandai lokasinya, taruh saja sinyal pandu di dekat situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Pastikan untuk menaruhnya di tempat yang tinggi. Semakin tinggi lokasinya, maka surveinya akan semakin akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "Bisa pergi sendiri, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Aku tidak berani untuk pergi... Bahkan tim ekspedisi pendakian pun dihajar sampai seperti itu oleh para monster, mana mungkin aku berani pergi sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "Lagi pula aku tidak dapat menemukan tim ekspedisi lain yang akan naik ke gunung, jika aku menundanya, tidak tahu sampai kapan akan menundanya terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "Sehingga aku hanya dapat meminta bantuanmu, sebelumnya kamu dapat mengambil kembali sinyal pandu dengan sangat baik, jadi kamu pasti sanggup melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Jadi untuk masalah ini maaf untuk merepotkanmu. Aku pasti akan menyiapkan bayaran yang memuaskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Ngomong-ngomong, aku akan menandai di peta lokasi di mana kamu harus menempatkan sinyal pandu itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
