					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Sara dan Charles membutuhkan kita juga. Ayo kita temui Jean dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "Oh, kamu ingin menemui Jean, kebetulan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Loh, bukannya kamu lagi mencari kucing?",
