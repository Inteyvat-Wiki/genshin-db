			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "Hei anak-anak, memang kalian pikir ini toko buah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "Wah, kasar sekali, padahal kita di sini untuk membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "Membantu? Oh, iya, kalian yang katanya petualang baru yang senang membantu itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Yah, bisa dibilang begitu sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Baiklah kalau begitu katakan pada Jean bahwa aku membutuhkan laporan pajak untuk kuartal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Sudah waktunya Elzer menghitungnya lagi... Lagi pula, pajak alkohol di Mondstadt termasuk tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
					"content": "Apa kamu benar-benar membutuhkan Jean untuk hal semacam ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "Dan entah bagaimana Dawn Winery masih sangat kaya raya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "Itu semua berkat model bisnis Tuan Diluc yang sangat sukses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860310,
					"content": "Lalu mengapa laporannya ada pada Jean? Apa Jean juga sekarang mengurus pembukuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860311,
					"content": "Iya, Grand Master Jean sendiri yang mengurus semua pembukuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860312,
					"content": "Bagaimanapun juga, industri anggur di Mondstadt adalah sumber utama penghasilan. Jean bekerja keras agar tidak ada satu pun hal kecil yang terlewatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860313,
					"content": "Wah... Paimon tidak tahu bahwa pekerjaan Jean lebih berat dari yang terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860314,
					"content": "Sang Grand Master benar-benar bekerja keras agar hidup kita lebih sejahtera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
