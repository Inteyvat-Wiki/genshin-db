						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Kamu pengamen, tapi pandai nyari tempat bagus ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, baguslah kalau suka. Beberapa cerita tidak cocok didengar burung, cuma bintang-bintang di langit yang bisa mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Mau ngedongeng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha, cerita ini dimulai dari \"Waktu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Dahulu kala, \"Wak{RUBY#[D]Istaroth}tu\" menuliskan kisah akan dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Dia memperlakukan semua makhluk hidup dengan setara, namun bagi dirinya, mereka semua sama-sama tak berarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Laksana gulungan kuno, dia mengukir dalam ingatannya setiap insan, setiap peristiwa, setiap pertemuan, dan setiap perpisahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "Kala itu, sewaktu aku masih berwujud peri Anemo, aku pernah bertemu \"Waktu\" di Thousand Winds Temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Dia mendengarkan permohonanku dan memberikan sebagian kekuatan serta kuasanya padaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Benih yang dibawa angin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "Sepertinya kamu sudah pernah mendengar cerita \"Sang Waktu dan Angin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Menarik sekali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Melalui ingatan yang terukir dalam upacara, puisi, reruntuhan, dan buku-buku kuno, makhluk yang dianggapnya tak berarti sudah bertemu dengannya ... lagi dan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Jadi ini yang mau kamu ceritain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Hmm ... lebih cocok dibilang ini pendahuluannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "Kontaminasi di Mare Jivari berkaitan erat dengan waktu. Dengan kata lain, ia adalah malapetaka yang selalu ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "Berbeda dengan \"Waktu\", aku selalu menyimpan banyak harapan di dalam hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Lima ratus tahun yang lalu, demi mencegah penyebaran kontaminasi Mare Jivari ke luar Tenochtzitoc ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "Aku mengembuskan keluar dari garis waktu dan mengubahnya menjadi \"Negeri Tanpa Angin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Jadi itu kebenaran di balik hilangnya Mare Jivari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Aduh, sepertinya aku membuatmu bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Kalau kamu ingin tahu bagaimana Mare Jivari hilang dari Tenochtzitoc dua atau tiga puluh tahun lalu, sebaiknya tanya ke yang lebih paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "Mare Jivari menyimpan terlalu banyak kisah yang bukan miliknya ... Aku hanya salah satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "Dan keputusan yang kuambil lima ratus tahun lalu ada harganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Alhasil beberapa roh tidak bisa kembali ke Mondstadt ... sementara yang lain menetap di tanah ini, lalu bersatu dengan Monetoo dan berubah menjadi Asha yang kita kenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Jadi, alasan kamu datang ke Tenochtzitoc ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Betul. Aku datang untuk bekerja sama dengan Archon Pyro saat ini, Mavuika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Maksudnya waktu kita nyalakan lilinnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Benar. Api itu kode kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Mavuika harus membuka celah antara ruang itu dan Mare Jivari asli agar aku bisa menyelinap masuk. Cuma itu satu-satunya cara untuk mengembalikan semua roh yang ingin pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Kalau soal cara mengembalikan ingatan ... Hehe, kamu tahu sendiri kalau aku sudah pernah melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika juga cerita kamu mau bantu ngenalin kita ... Tapi aku malah keburu duluan, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "Aku senang dia orangnya suka anggur enak dan kebebasan seperti aku. Kami langsung nyambung, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Kamu sih hebat ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Aku capek berhari-hari ... Saking capeknya, tadi aku hampir ketiduran lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Masa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Tapi aku kepikiran Aphimead dan Dandelion Wine yang belum keminum. Jadi langsung bangun lagi, deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450740,
