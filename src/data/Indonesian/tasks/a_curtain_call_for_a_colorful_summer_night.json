			"dialogs": [
				{
					"id": 150450401,
					"content": "#Pagi, {NICKNAME}, Paimon! Hari ini ada aku sama pelampungku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Pagi, Mualani! Kok kamu bisa masih segar sih? Padahal semalam kamu yang paling heboh, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "Itu kan kemarin! Aku cukup tidur malam, energiku sudah penuh lagi deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Nih, ambil ya. Itu hadiahmu karena sudah melengkapi albumnya. Aku sekalian ambil punyamu biar tidak usah ambil sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Aduh, Mualani emang paling baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Hehe, seorang pemandu yang baik harus bisa melihat ke depan dan selalu bantu-bantu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Malas kembali ke kenyataan sih, tapi liburan kita udah mau selesai ya .... Lagi pula kalau aku tidak cepat-cepat pulang, nanti anjingku di rumah bisa tidak kenalin aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Aku sudah tanya ke yang lain juga, masing-masing juga harus pulang mengurus sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Ada yang kangen keluarga, ada yang kangen sama Dandelion Wine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Bahkan Chasca pun kangen rumah. Dia enggak bilang sih, tapi waktu malam-malam dia bertengger di pohon sambil melihat ke arah suku Bunga Bersayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Aku mengerti kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Tapi musim panasnya belum berakhir kok! Jadi ... ayo kita pakai sisa waktunya buat melakukan sesuatu yang berkesan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Misalnya ... foto bareng lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Gimana kalau di sini? Setelah lama tinggal di sini, Paimon jadi kayak punya hubungan khusus sama tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Ide bagus! Kalau begitu kalian hias dulu temboknya, aku panggil yang lainnya ya. Nanti kita ketemu di alun-alun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
