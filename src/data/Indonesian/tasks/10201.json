			"dialogs": [
				{
					"id": 102010401,
					"content": "Huh, kamu mengikutiku ya. Tampaknya kamu cukup bernyali, aku kagum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010402,
					"content": "Tapi, sepertinya langkahmu cukup sampai di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010403,
					"content": "Memang kamu mau apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Hahahahahaha!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010405,
					"content": "Oh, gosip di kalangan manusia telah memberi kami informasi yang dibutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010406,
					"content": "Kami sudah tahu bahwa gadis kecil berbaju merah mempunyai harta terkuat di seluruh Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010407,
					"content": "Sekarang harta karun itu di tanganku, kalian tidak bisa berbuat apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010408,
					"content": "Akan kugunakan harta ini untuk menumpas kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010409,
					"content": "Tidak bisa! Ja-jangan menyentuhnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Hah, melihatmu panik seperti itu, akhirnya kamu sadar juga situasimu saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010411,
					"content": "Biar kulihat, oh... simbol api, Mwahahahaha....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010412,
					"content": "*bum!*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010501,
					"content": "Ahhh!",
					"roleType": "TALK_ROLE_NPC",
