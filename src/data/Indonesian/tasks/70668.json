			"dialogs": [
				{
					"id": 706680201,
					"content": "Meong! (Kamu benar-benar hebat! Selamat, kamu sudah menyelesaikan Ujian Tantangan Ascension! Kamu sekarang adalah Pemain Master!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680202,
					"content": "Meong. (Menjadi Pemain Master berarti ... teknik bermainmu sudah melebihi orang-orang yang mempelajari permainan ini. Mereka yang tidak berusaha keras tidak akan pernah bisa mencapai level ini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680203,
					"content": "(Tentu saja, mereka tidak mengerti kenapa kita menghabiskan banyak waktu untuk permainan yang menurut mereka cuma permainan santai saja ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680205,
					"content": "(Kalau pemain yang kamu undang sudah tahu kamu pemain resmi, mereka pasti akan lebih serius mainnya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680206,
					"content": "(Atau bahkan ada pemain yang hanya izinkan kamu menantang mereka kalau kamu sudah menjadi Pemain Master ... Ada pemain aneh seperti ini di Tavern juga ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Prince"
				},
				{
