					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Berhenti, siapa kalian?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Solemn Raven"
				},
				{
					"id": 400720202,
					"content": "Kalian tidak terlihat berasal dari Immernachtreich? Mengakulah! Apa tujuan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Severe Raven"
				},
				{
					"id": 400720203,
					"content": "Tempat ini bahkan ada penjaganya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Jangan panik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "Eh? Kamu mau apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Kami adalah pengikut pribadi Nona Fischl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "Kami adalah orang-orang yang datang melewati lautan bintang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "Bagaimana kalian membuktikan bahwa kalian adalah pengikut Yang Mulia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Solemn Raven"
				},
				{
					"id": 400720209,
					"content": "Heh, pertanyaan tidak masuk akal itu hanya semakin menunjukkan kalau kalian tidak tahu apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "\"Semoga pendudukku dibebaskan dari belenggu aturan lama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "I-Itu kata sandi Immernachtreich! Mereka memang adalah bawahan Yang Mulia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Severe Raven"
				},
				{
					"id": 400720212,
					"content": "A-Astaga. Kami tidak tahu, mohon ampuni kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Solemn Raven"
				},
				{
					"id": 400720213,
					"content": "Sudah tahu, tapi masih enggak mau mundur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Baik, kami akan segera pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Solemn Raven"
				},
				{
					"id": 400720215,
					"content": "Mereka sudah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "Ini adalah jilid kedua \"Kidung Kerajaan Suci\". Semuanya sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "Berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
