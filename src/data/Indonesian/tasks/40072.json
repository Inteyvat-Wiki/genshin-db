				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Ah, syukurlah ... Eh? Kalian lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721002,
					"content": "Harusnya kami yang bilang begitu. Kenapa kamu ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
