			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "Kita kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Sepertinya baru saja kita melihat wujud asli naga jahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "*huff* Aku mengerti sekali rasanya. Selalu saja ada orang yang menganggap hobi kita itu hanya buang-buang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "Eh? Kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Aku Arnold, lengkapnya Arnold yang Suka Ditanya Tentang Jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Maksudku, kamu kenapa balik lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Oh, kupikir kalian pasti mau mencari \"Kidung Kerajaan Suci\" jilid tiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Tebakanmu benar sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Nonaku yang tercantik, kamu tidak perlu melakukan apa pun. Kecantikan Anda, adalah pujian terbesar bagiku. Aku akan memberikan jawaban yang kalian cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "Buku jilid ketiga, terletak di lantai teratas kota kerajaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "Apa ada penjaganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Oh, tentu saja. Tidak ada bangsa yang akan membiarkan buku terpentingnya terekspos cuaca luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Dengan kata lain, akan ada Night Raven penjaga di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Menjaga buku suci ini merupakan kehormatan tertinggi bagi penduduk. Tapi tak apa, aku yakin Nona hanya ingin membaca buku tersebut tanpa ada niat jahat lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Wajah Anda sangat menawan dan bijaksana. Teman-teman Anda juga bagaikan pahlawan, kalian pasti dapat mengerti cerita dalam buku suci kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "Semua pencapaian Yang Mulia didokumentasikan oleh Tuan Oz, yang kemudian menjadi harta karun di Immernachtreich. Aku selalu mendoakan kebahagiaan Yang Mulia setiap kali aku membaca buku-buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Mohon maaf telah membiarkan kalian melihat rupaku yang memalukan. Benar saja, dengan kekuatanku sekarang, terlalu dini untuk memerankan seorang Night Raven Knight ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721802,
					"content": "Memerankan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "Aku malu mengakuinya. Aku bukan seorang knight, tapi hanya aktor pemula yang menemukan pekerjaan baru untuk memerankan seorang knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721804,
					"content": "Kayaknya itu bukan sesuatu yang bisa dibanggakan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "Tidak, kalian tidak mengerti. Seni teater adalah budaya yang penting di Immernachtreich. Pertunjukan yang bagus adalah persembahan terbesar untuk Yang Mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721806,
					"content": "Oh, maksudnya, ini adalah budaya kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "Benar! Karena itu, aku sangat senang bisa memerankan seorang knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721808,
					"content": "Lalu kenapa Nona Fischl sangat menyukai seni teater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Nona Fischl pernah berkata, \"Rayakan aku dengan mementaskan drama di hutan belantara. Bersujudlah padaku dan bawakan aku mimpi indah sebagai imbalan atas kemegahan kegelapan abadi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721810,
					"content": "Kurasa, pasti karena Yang Mulia mengerti seni yang sejati dan dapat memahami perasaan terdalam di hati manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721811,
					"content": "Jiwa drama terletak pada kohesi dan sublimasi emosi. Siapa pun yang mengerti seni teater pasti memiliki hati yang sensitif dan penuh kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721812,
					"content": "Ternyata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Terima kasih atas jawabanmu, Tuan Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "Oh! Anda ... Anda bersedia memanggilku seorang knight, terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721815,
					"content": "Kalau begitu, aku akan pergi ke medan perang dengan membawa kehormatan ini. Sampai jumpa, semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721816,
					"content": "Semoga kita enggak ketemu lagi, hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "Oh ya. Ingat kata sandi untuk membuka gerbangnya. \"Dengarkan perintahku, kepakkan sayap dan terbanglah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		}
	]
}