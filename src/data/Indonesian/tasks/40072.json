					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "\"Namun, Immernachtreich terus dihantui oleh mimpi buruk tanpa akhir. Naga jahat Tasraque masuk ke dalam tanah untuk melintasi dasar laut, hingga sampai ke puncak kota kerajaan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Narator"
				},
				{
					"id": 400720402,
					"content": "Eh? Naga? Kukira yang berubah hanya cuaca saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Naga ... Mungkin hanya perumpamaan saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "Benarkah ...? Naga jahat Tasraque, musuh bebuyutannya itu, terbuat dari segala hal yang melawan dan menentang fantasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
