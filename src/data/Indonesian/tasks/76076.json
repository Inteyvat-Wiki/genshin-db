			"dialogs": [
				{
					"id": 760761101,
					"content": "Halo, temanku yang baik. Senang sekali dapat berjumpa lagi di pemakaman ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Kamu menjelaskan tentang \"Lentera Sumpah\" dan kata-kata tidak jelas yang terukir di lentera itu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "\"Angin telah terbangun, daun-daun berguguran\" ... ini sumpah yang diucapkan anggota Lightkeeper ketika baru bergabung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "Masing-masing Lightkeeper selalu membawa lentera sendiri, dan hanya akan menitipkannya pada rekan lain bila tak ada pilihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Setiap lampu tanpa pemilik adalah pertanda kesialan. Aku turut berduka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Tapi mereka sudah mengetahui takdir ini tidak dapat dihindari dari sejak mengucapkan sumpah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "Kalau masih ada yang bisa kita lakukan, mungkin hanya memperingati sumpah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "\"Membawa lentera yang menyala dengan harapan tanpa akhir\" ... adalah keinginan terbesar mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
