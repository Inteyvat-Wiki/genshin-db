			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Kakak sudah mendapatkan Vision dan dia seharusnya membasmi semua iblis di dunia, tapi dia malah bertanya padaku, apakah iblis terlahir jahat? Iblis-iblis menciptakan malapetaka di dunia dan membahayakan orang yang tidak bersalah. Bukankah ini sangat buruk? Aku rasa kakakku benar-benar bodoh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710100202,
					"content": "Sudahlah, meskipun tanpa Vision, aku sendirian juga bisa membasmi iblis",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
		{
