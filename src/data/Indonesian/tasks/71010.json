			"dialogs": [
				{
					"id": 710100101,
					"content": "Sejak kecil aku dan kakakku berlatih bela diri, untuk melawan penjahat dan mempertahankan diri. Tapi tanpa bantuan Vision, menyelamatkan dunia tidaklah mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710100102,
					"content": "Aku dan kakakku berlatih di sini, untuk mendapatkan Vision dan membangun monumen di sini sebagai bukti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
