			"dialogs": [
				{
					"id": 710100301,
					"content": "Iblis adalah sebuah bahaya. Aku sudah berlatih bela diri begitu lama, membasmi iblis dan melindungi dunia adalah tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710100302,
					"content": "Di dalam hatiku, yang aku ingin lakukan terhadap iblis-iblis itu hanya membasminya!",
