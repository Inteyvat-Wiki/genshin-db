			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "Tulisan tangan di botol ini ... sepertinya tulisan anak kecil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "Little Meng? Siapa sebenarnya anak ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "Eh? Botol ini kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "Pengembara? Dari nada bicaramu, sepertinya kamu kenal dengan penulis surat ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "Bisa dibilang begitu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Ternyata begitu. Anak kecil ini banyak sekali pikirannya ya. Bagaimana cara menjadi dewasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "Kurasa dia bisa menyelesaikan masalah ini dengan pergi bertualang ke luar satu kali dan membuka wawasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "Omong-omong, Little Meng sendiri pernah bilang sih kalau dia mau pergi ke bagian luar Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "Tapi kita kan sudah pernah ajak dia, kenapa dia tidak mau ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "Hahaha, mungkin ini sedikit sifat \"keras kepala\" yang dimilikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "Karena dia rasa ini adalah masalahnya sendiri, tentu saja dia mau menyelesaikannya sendiri dan tidak bergantung pada bantuan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "Tapi kalau dia hanya mengapungkan sebuah botol, masalahnya juga tidak akan selesai kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "Makanya, di saat seperti ini harus ada bantuan dari orang dewasa yang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "Pengembara, ayo kita sama-sama tulis surat untuk anak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "Kita gunakan surat ini untuk memberi tahu, ada betapa banyak hal menarik yang menunggunya di dunia luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "Tapi ... hehe, aku juga belum pernah pergi ke banyak tempat. Jadi tugasmu adalah menulis hal-hal menarik yang ada di berbagai tempat ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "Tentang reruntuhan menara yang dikelilingi angin badai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Pelan-pelan ... pelan-pelan. Aku belum selesai mencatat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "Ah, bagian ini ... bagaimana ya menulisnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "Oke! Selesai! Tidak terasa sudah menulis sebanyak ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "Hahaha, mendengarmu bercerita tentang semua ini, aku juga jadi ingin pergi berkeliling ke luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "Berkelana di luar sana lumayan seru kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "Ah, tapi di usiaku yang sekarang ini, masih banyak urusan yang harus kukerjakan. Mengembara ke sana kemari bukan sesuatu yang bisa kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "Suratnya sudah kumasukkan ke dalam botol, cepat kamu taruh di sungai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "Tentang kepulauan yang dikelilingi badai petir ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Tentang sebuah pulau yang dibelah oleh Archon Electro ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "Seorang anak kecil dari Pelabuhan Liyue ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
