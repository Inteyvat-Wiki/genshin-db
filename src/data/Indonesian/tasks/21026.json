				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Bagaimana? Apa kamu sudah meletakkan botolnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Memangnya Little Meng akan menemukannya ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Hmmm. Sepertinya sulit ya. Kemungkinan besar tidak akan ditemukan olehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "Kalau begitu ya tidak ada gunanya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Aduh, tenang dulu dong. Kan sudah kubilang akan ada orang dewasa yang bisa diandalkan yang akan menolongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Kalian tahu tentang tempat bernama Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Aku punya beberapa sahabat yang berbisnis. Mereka sedang mempersiapkan bisnis jual beli Mushroom dan sedang bersiap-siap pergi ke sana untuk survei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Hahaha, kalian juga tahu. Bilangnya sih \"survei\", tapi sebenarnya mereka ke sana sekalian untuk main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Karena anak bernama Little Meng itu ingin pergi ke luar, aku bisa membantunya menghubungi mereka, siapa tahu teman-temanku bisa menampung orang tambahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Kalian tidak perlu khawatir tentang hal ini, biar kuurus semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Surat ini sudah kusalin untuk keperluan lainnya. Lalu botol itu, biarkan saja dia mengapung, kurasa tidak ada yang akan mengambilnya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Terima kasih ya sudah mau membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Bukankah normal kalau orang dewasa ingin membantu mewujudkan mimpi anak-anak? Serahkan saja padaku, tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Oh ya, akan kusuruh teman-temanku itu berpakaian rapi sedikit, supaya tidak ada orang lain yang terheran-heran melihatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Kenapa kamu mau membantu Little Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
