			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "Ya ampun, sepertinya Hertha sudah kembali melakukan tugasnya, dan Glenfidia juga sedang pergi ke suatu tempat ... Apa si manis kita ini yang sepenuhnya mengurus stan minuman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "Siap, laksanakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "Wah, wah. Jadi sekarang aku bisa pesan tanpa harus khawatir bakal dapat salah satu dari \"minuman khusus\" Divisi Logistik ... Tipe minuman yang buat kamu bangun semalaman, tanpa ada pilihan lain selain bekerja semalaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "Kerja semalaman ... Bukannya itu cuma masa lalu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "Benar sekali! Sekarang aku hanya seorang pustakawan yang santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "Kalau saja sedikit orang yang terlambat mengembalikan buku, dan aku tidak harus mendatangi mereka satu per satu untuk mengambilnya kembali ... aku pasti sudah datang lebih awal untuk mengobrol denganmu — dan tentu saja mencoba kreasi lezatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "Jadi, hari ini mau minum apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "Coba kupikirkan ... Hmm, aku tidak punya minuman favorit sih. Kasih aku minuman yang menyegarkan saja, biar jadi semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "Lebih bagus lagi kalau bisa buat aku mengantuk nanti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(Ada banyak resep minuman klasik di sini ... Pilih satu dari sini ah ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Karena Lisa mau merasa segar kembali, \"Snow-Kissed Dawn\" sepertinya pilihan yang tepat ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "Lagi mau rasa apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "Lisa seharusnya enggak terlalu sibuk sekarang, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "Honorary Mixologist siap melayani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
