			"dialogs": [
				{
					"id": 705480301,
					"content": "Selesai! Sebuah kreasi baru, dibuat khusus untukmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "Ini akan membantumu cepat tidur dan menjamin tidurmu nyenyak. Namanya \"Slumbering Rose\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "Mulai dari pilihan warna gelas, semuanya benar-benar dipertimbangkan dengan matang. Kamu benar-benar mengubahnya jadi minuman yang berbeda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480304,
					"content": "Kalau dari luarnya saja sih, ini cocok denganku. Kalau rasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480305,
					"content": "Hmm ... sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480306,
					"content": "Ini kayak ... menyantap makanan penutup nikmat sebelum jalan-jalan di tepi Danau Cider, angin sepoi-sepoi seperti membelai kulitmu. Begitu menenangkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480307,
					"content": "Aku tidak merasa capek lagi, tapi aku juga tidak terlalu bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480308,
					"content": "*hoam* Kok aku jadi ngantuk ya ... Sebagai minuman sebelum tidur, ini cocok sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480309,
					"content": "Bahkan bisa dibilang luar biasa, aku rasa aku perlu tulis artikel untuk memuji kehebatan \"Slumbering Rose\" ini. Aku akan pakai kesempatan ini untuk menganugerahkan gelar \"Bartender Jenius\" untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480310,
					"content": "Tidak usah repot-repot begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "Oh ya, ngomong soal jalan-jalan di tepi danau, lain kali kalau cuaca cerah, hangat, dan mataharinya tidak terlalu terik, jalan bareng yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480313,
					"content": "Asal ada si manis yang temani aku jalan, pasti jadi lebih santai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480314,
					"content": "Yah, waktu kita balik, kamu bisa buatkan aku segelas Slumbering Rose lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480315,
					"content": "Pasti dikabarin. Oke juga tuh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480317,
