					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "Aku akan buatkan versi yang lebih enak lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "Seperti yang diharapkan, manis, pikiran cemerlangmu semakin tajam. Hanya perlu beberapa petunjuk lembut untuk menyalakan percikan inspirasi yang istimewa itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480237,
					"content": "Wajar saja kalau seleramu berubah-ubah.",
