							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "Ini Snow-Kissed Dawn untukmu, semoga suka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "Enak sekali, manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480203,
					"content": "Asamnya sedang, manisnya tidak buat enek, hangat di mulut, sensasi segar setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480204,
					"content": "Tapi, sepertinya aku jadi lebih semangat dari biasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480205,
					"content": "Mungkin kamu sudah berhasil mengungkap rahasia Glenfidia dan meracik minuman yang lebih efektif untuk menggodaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480206,
					"content": "Apa perlu diganti lagi ramuannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "Tidak masalah, tidak buru-buru kok. Matamu bersinar dengan penuh semangat, sepertinya ada banyak pertanyaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480209,
					"content": "Yuk ngobrol dulu sebentar. Santai saja ... Ilhamnya nanti datang sendiri kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480210,
					"content": "Sudah kumpulkan buku apa hari ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "*huff* Aku cerita deh, hari ini sebenarnya unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480212,
					"content": "Ada koki yang baru lulus pelatihan di Fontaine, akhir-akhir dia dapat posisi baru di Goth Grand Hotel. Dia pinjam buku kami yang paling berharga \"Ringkasan Makanan Penutup Ribuan Tahun Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480213,
					"content": "Ternyata, dia ingin pakai teknik membuat makanan penutup untuk meningkatkan rasa makanan gurih. Seperti ingin mengurangi rasa berminyaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480214,
					"content": "Makanan penutup berdaging ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "Memang benar. Dan dilihat dari hasilnya, mungkin dia terlalu banyak taruh saus karamel. Potongan daging yang harusnya harum jadi terlalu manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480217,
					"content": "Saus karamel itu bahan yang luar biasa loh. Kalau ditaruh di minuman, aku selalu terpukau dengan rasanya. Kadang aku bahkan tambahkan sesendok untuk teh siangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480218,
					"content": "Kalau begitu, meningkatkan rasa makanan bukan melulu soal kreatif sana dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480219,
					"content": "Oh ya, apa kamu lagi bawa catatan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "Oh ini? Ini saksi kerjaan sampingan hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480221,
					"content": "Gerombolan besar tim ekspedisi akan kembali ke Mondstadt dalam waktu dekat. Mereka suka pergi selama itu, jadi mungkin selera mereka sudah berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480222,
					"content": "Jean minta aku kunjungi sebagian keluarga mereka untuk cari tahu apa bahan-bahan baru yang bisa memuaskan selera knight yang mungkin sudah berubah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480223,
					"content": "Rencana yang detail sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "Yah, soalnya mereka sudah korbankan darah, keringat, dan waktu mereka untuk melindungi Mondstadt. Mereka pantas dihargai dan diperhatikan sebagai balasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480226,
					"content": "Berdasarkan data yang kukumpulkan, bahan yang paling laku itu Cacahuatl dari Natlan. Sepertinya mereka mulai suka kakao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480227,
					"content": "Dalam suratnya, banyak yang menulis kalau mereka mengandalkan kakao supaya bisa bersemangat. Aku sudah pernah coba kakao panas, dan jujur saja, efeknya sama seperti kopi untuk meningkatkan fokus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480228,
					"content": "Sudah keluar kota akhir-akhir ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "Maksudmu aku sekalian keluar kota diam-diam, kan? Hehe, sudah terciduk ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480230,
					"content": "Berkat investigasiku tentang minuman yang jarang di Mondstadt, aku mampir ke Dawn Winery dan ngobrol sebentar dengan Kepala Pelayan Adelinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480231,
					"content": "Waktu pulang, aku ketemu Ematol yang sedang patroli. Dia bertemu monster dan tidak tahu cara menghadapinya, jadi dia minta bantuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480232,
					"content": "Aku temani dia untuk jalan memutar ke Wolvendom untuk kasih pelajaran ke serigala ... Sudah lama sekali sejak aku olahraga kayak begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480233,
					"content": "Jadi, lagi suka bahan apa akhir-akhir ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "\"Akhir-akhir ini\"? Hati-hati dengan kata-katamu, manis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480235,
					"content": "Apa mungkin kamu juga berpikir kalau seleraku sudah berubah sejak kita terakhir bertemu? Atau ... kamu cuma lupa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480236,
					"content": "Yah, karena kamu sering bertualang dan banyak membaca ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "Patut dipuji, jawaban tanpa cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480239,
					"content": "Waktu aku masih jadi pelajar, mungkin aku akan tertarik sama bahan baru dan menarik yang kubaca. Aku akan terus memperluas wawasanku dan keluar dari zona nyaman. Tapi sekarang aku sudah nyaman dalam rutinitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480240,
					"content": "Meminjam kata-kata dari ahli hukum di Liyue, hidupku itu sudah mau mencapai tahap \"hidup tenang dan nyaman di masa keemasan\". Aku sudah tidak mudah berubah karena petualangan dan keseruan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480241,
					"content": "Kamu pasti ingat, beberapa tahun lalu waktu kita bertualang bersama, kamu bantu aku cari bahan kimia yang rasanya manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
