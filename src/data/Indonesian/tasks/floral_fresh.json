			"dialogs": [
				{
					"id": 200690401,
					"content": "Bagaimana bunganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690402,
					"content": "Maaf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690403
					]
				},
				{
					"id": 200690403,
					"content": "Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690404,
					"content": "Aku tidak sengaja merusak kotak dan bunganya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690405
					]
				},
				{
					"id": 200690405,
					"content": "Ru-rusak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690406,
					"content": "Uh... itu adalah bunga yang aku pilih secara khusus. Bunga yang bagus tidak mudah ditemukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690407,
					"content": "Apa Dragonspine itu benar-benar berbahaya? Sampai-sampai petualang seperti dirimu tidak bisa menaruh sekotak bunga di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690408,
					"content": "Namun, terima kasih telah membantuku untuk tugas ini, ini untukmu, terimalah, aku akan lanjut merawat bunga di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690409,
					"content": "Ah, atau... mungkin aku akan mencoba lagi cara yang digunakan oleh Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
