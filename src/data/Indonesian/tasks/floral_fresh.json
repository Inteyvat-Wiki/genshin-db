			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Bunga-bunga ini menjadi layu, sayang sekali ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Karena orang-orang sering datang ke toko hanya untuk membeli setangkai bunga saja sebagai hadiah, jadi aku harus memotong beberapa bunga setiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Tapi bunga yang telah dipotong tidak akan bertahan lama, jika mereka tidak terjual pada hari itu juga, mereka akan segera layu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Aku sudah pernah mencoba banyak cara agar bunga-bunga tersebut tetap segar, tapi bunga-bunga itu tetap layu pada akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Apa ada cara untuk memelihara bunga agar kesegarannya bisa bertahan lebih lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Menggunakan cara pengawetan bahan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Aku mendengar bahwa Sara dari \"Good Hunter\" akan meletakkan bahan makanan yang tidak terpakai di tempat yang dingin atau dibekukan dengan es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Aku telah mencoba cara ini sebelumnya. Tapi entah kenapa, warna dan bentuk bunganya akan menjadi sangat aneh jika disimpan langsung di dalam es batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Tidak bisa dibilang layu... tapi juga tidak bisa dibilang mekar, singkatnya seperti tidak enak dilihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Aku bertanya pada banyak orang, lalu Tuan Sayid... kamu tahu dia kan? Dia seorang pelajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Ketika dia datang untuk membeli bunga, dia mengatakan bahwa dia pernah melihat metode \"mengawetkan bunga\" di sebuah buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Sepertinya dia bilang... gunakan sebuah wadah untuk menampung bunga, lalu letakkan wadah itu di dekat es batu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Dia juga bilang bahwa jika ingin bereksperimen, lingkungan bersuhu rendah di Dragonspine sangat cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Tapi kudengar bahwa Dragonspine sangat berbahaya, dan aku tidak bisa menemukan petualang yang bisa membantuku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "Pengembara, maukah kamu membantuku mengubur ketiga kotak bunga ini di Dragonspine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Terima kasih karena mau membantuku, coba kupikirkan... kudengar Dragonspine sangat besar dan memiliki banyak area yang berbeda, jadi hasilnya juga bisa berbeda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Nah, lebih baik kita bandingkan efeknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Tolong bantu aku untuk mengubur bunga-bunga ini di <color=#00E1FFFF>sebelah Patung The Seven</color>, <color=#00E1FFFF>di sebelah air</color>, dan... <color=#00E1FFFF>pintu masuk gua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Di mana aku harus menguburnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Alangkah baiknya bila semua bisa terjual pada hari yang sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Tentu saja itu adalah yang terbaik, tetapi setiap hari akan selalu ada satu atau dua bunga yang tidak dibeli siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Meski hanya ada satu atau dua bunga, aku tidak ingin mereka layu seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
