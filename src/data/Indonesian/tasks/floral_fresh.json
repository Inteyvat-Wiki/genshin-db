					"content": "Tolong bantu aku untuk mengubur bunga-bunga ini di <color=#00E1FFFF>sebelah Patung The Seven</color>, dan... <color=#00E1FFFF>pintu masuk gua di gunung bersalju</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690325,
					"content": "Kemudian <color=#00E1FFFF>temukan air di pegunungan salju</color>... Bisa danau atau kolam, lalu kamu dapat meletakkan sekotak bunga di tepi air tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Tolong kali ini berhati-hatilah dan jangan sampai merusaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690321,
					"content": "Di mana aku harus menguburnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "Alangkah baiknya bila semua bisa terjual pada hari yang sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "Tentu saja itu adalah yang terbaik, tetapi setiap hari akan selalu ada satu atau dua bunga yang tidak dibeli siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690313,
					"content": "Meski hanya ada satu atau dua bunga, aku tidak ingin mereka layu seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "Flora"
				}
			]
		},
