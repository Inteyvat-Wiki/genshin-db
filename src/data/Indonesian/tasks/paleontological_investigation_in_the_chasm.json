				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Wah, fotonya bagus-bagus ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "Pengeluaran untuk regu penjelajahan terbayar dengan foto-foto ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Lihat, ini adalah bentuk tulang makhluk laut purba, jelas sekali ya strukturnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Ini membuktikan kalau sebelum Chasm terbentuk, tempat ini adalah lautan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Sayang sekali. Kalau saja fosil ini ada di Sumeru, pasti bisa langsung dibawa ke Akademiya untuk diteliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "Waktu berurusan dengan Bagian Urusan Sipil lagi aku akan membayar lebih untuk menyewa penjaga. Harus ada yang mengawasi biar fosil ini tidak dirusak para penambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Tapi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Foto-fotonya ... cukup sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Seperti yang kubilang sebelumnya, pasti ada hal yang membuat fosil ini bisa terbentuk sebagus dan serapi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Yaitu, organismenya harus terkubur dengan sangat cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "Fosil-fosil di Chasm ini pada dasarnya hanya muncul di ketinggian tertentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "Di ketinggian tertentu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Ah, kalau dari segi ilmu geologi sih, jarak segitu saja bisa diabaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Ini berarti fosil ini terbentuk dalam waktu yang sangat singkat, dan dalam lingkup area yang sempit. Ini berarti ada perubahan ekologi yang besar dan terjadi dalam waktu singkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Misalnya diakibatkan oleh sebuah goncangan yang sangat besar, atau sejenisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Hmmm, sebenarnya apa yang terjadi di Chasm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "Jarak ketinggiannya kok jauh banget?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Kamu mau bilang fotonya tak cukup, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
