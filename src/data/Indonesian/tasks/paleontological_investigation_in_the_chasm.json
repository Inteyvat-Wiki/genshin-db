				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Tentang batu yang aneh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Jadi kamu berhasil ambil foto batu aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Coba kasih aku lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Ini dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Ah, foto ini! Jelas sekali ya — Memang Kamera model terbaru dari Fontaine bagus sekali seperti yang dibicarakan orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Waktu itu aku pernah beli alat yang masih tahap percobaan, hasilnya buram sekali, bahkan perlu digotong dua orang. Akhirnya ditinggal sampai berdebu deh di Akademiya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Berdebu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Iya, belinya pakai uang makanku lagi. Yah, sepertinya sudah saatnya beli Kamera baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Topiknya jadi melenceng. Oke coba kulihat dulu batu ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Ah, ini sebuah fosil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Fosil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Iya, lalu di dalamnya ada banyak organisme laut ... menarik. Ada pepatah Liyue yang mengatakan \"Hutan besar dan ladang luas, semua termakan habis oleh lautan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "Di Chasm ini bisa muncul fosil, tandanya organisme-organisme ini terkubur ke dalam tanah dengan sangat cepat. Kalau tidak, struktur tulangnya tidak mungkin selengkap ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "Selain itu, kudengar sekitar sini juga sering gempa. Masuk akal, karena aktivitas geologis juga salah satu faktor penting dalam pembentukan fosil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Ini bisa sangat membantu penelitian kumpulan organisme kuno di sekitar sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Tapi mungkin tidak cukup kalau hanya ada satu foto saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Kalau kamu menemukan fosil seperti ini lagi, tolong foto dan berikan padaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Kamu perlu berapa lembar foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Hmm ... kalau mau dimasukkan ke laporan kira-kira butuh 4-5 lembar. Kalau begitu 5 lembar deh, tolong fotokan 5 lembar bentuk batu yang begini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Pasti kuberikan imbalan yang setimpal kok, ini penemuan besar loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Mubazir juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
