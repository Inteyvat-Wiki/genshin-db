			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Waduh, ternyata balai reyot kayak gini juga bisa ada rahasianya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Enggak nyangka sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Kata Paimon sih ya, si Huang the Third juga enggak tahu soal tempat ini ... jangan-jangan ini beneran \"Ruangan Pusaka Guhua\" yang legendaris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#Selain itu ... lihat tuh, {NICKNAME}. Ada yang nyala di sebelah sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Pusaka! Harta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Pokoknya kita cek dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Wah ... mekanisme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "\"Jangan menilai sesuatu dari luarnya saja\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"Langit tidak setia, yang mencari dan mendapatinya teramat langka. Takdir tak tentu arahnya, yang bangkit tanpa pernah terjatuh teramat jarang ... Barang siapa menghadapkan matanya ke arah langit tidak akan kelihatan ketika mencapai akhir perjalanannya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Prasasti Terukir"
				},
				{
					"id": 711090502,
					"content": "\"Tulisan ini dibuat hanya untuk satu pertanyaan. Ketika mencapai titik akhir, apa yang harus dilakukan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Prasasti Terukir"
				},
				{
					"id": 711090503,
					"content": "(Sentuh tablet batu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Pergi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
