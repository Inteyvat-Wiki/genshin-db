			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wen the Fourth",
					"Huang the Third"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "Aih ... sejarah ribuan tahun yang gilang gemilang ternyata tidak dapat mencegah penjaga gerbang Klan Guhua mencurangi orang demi bertahan hidup ... Apa kata dunia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092502,
					"content": "Tolonglah ... Bukannya aku sudah berusaha dengan sangat keras agar adik seperguruanku yang baik tidak mati kelaparan saat menjaga pintu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092503,
					"content": "Jangan melihat aku seperti itu. Kamu biasanya selalu stress ... tapi senang kan melihat kemampuan anak muda tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092504,
					"content": "Si bodoh yang tadi itu? Yang boleh masuk dan lihat-lihat karena masak nasi dan dendeng asin untukmu? Kenapa aku harus senang ya? Kalau ini terjadi beberapa tahun lalu, sudah kuhajar habis kau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092505,
					"content": "Heh! Beberapa tahun lalu juga ilmumu masih di bawah aku ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092506,
					"content": "Sudahlah. Dengar ... kita ini sudah tua, sudah tinggal sedikit juga. Apa rencanamu kalau kita berhenti menguji orang yang mungkin ditakdirkan untuk menjadi murid klan? Bawa semua kitab jurus ke liang kubur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092508,
					"content": "Ah, lupakanlah. Tidak ada faedahnya membahas hal menyedihkan begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092509,
					"content": "Oh, mau coba makanan buatan mereka? Hehe, Wanmin Restaurant juga kalah loh! Nih, cobalah barang segigit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang the Third"
				}
			]
		}
	]
}