				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Eh? Pedang ini ada tulisannya loh ... Paimon baca dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"Bernyanyilah bersama pedang, tebas sang naga dan minumlah darahnya. Cahaya dewata laksana kilat, ombak yang ganas menghancurkan gunung ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Prasasti Pendekar Kuno"
				},
				{
					"id": 711090603,
					"content": "\"Di bawah gunung Tianheng aku membantai harimau, di tengah lautan awan aku menusuk binatang bersisik. Membawa jasa ini aku kembali, 'tuk hidup di dalam kemakmuran ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Prasasti Pendekar Kuno"
				},
				{
					"id": 711090604,
					"content": "Itu di sebelah kayak ada tablet batu ... Eh, tulisannya kok agak beda ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"Awalnya aku ingin meninggalkan makanan lezat di sini, tapi sebentar juga pasti busuk. Aku tulis resepnya saja, silakan masak sendiri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Ukiran Kuno"
				},
				{
					"id": 711090606,
					"content": "\"Tidak ada yang lain selain pedang dan pemandangan ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Ukiran Kuno"
				},
				{
					"id": 711090607,
					"content": "\"Berjalan sampai ke ujung tanduk, seperti apa? Aku sudah tahu langkahnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Ukiran Kuno"
				},
				{
					"id": 711090608,
					"content": "\"Tidak mengambil ... harta pusaka, hanya menyisakan ... satu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Ukiran Berantakan"
				},
				{
					"id": 711090609,
					"content": "\"Agar aku tetap bersikap kesatria di saat terakhir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Ukiran Berantakan"
				},
				{
					"id": 711090610,
					"content": "Wuah, hurufnya kayak cakar ayam ... Paimon enggak bisa baca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Mungkin maksudnya dia enggak ambil apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "Huuu ... dari tadi belum nemu satu pun harta ... kok kayaknya ini penantian yang sia-sia ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "Ya memang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Tapi Paimon enggak nyangka bisa lihat pemandangan kayak gini loh ... yah lumayan lah, sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Sudah jangan sedih. Nanti aku masak enak buat kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "Eh? Beneran nih? Awas loh kalau bohong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Aku juga enggak paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
