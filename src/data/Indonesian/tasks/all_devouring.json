			},
			"dialogs": [
				{
					"id": 150360601,
					"content": "Ternyata ada banyak Mora di dalam tas Skirk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360602,
					"content": "Apa dia punya pekerjaan atau semacamnya? Eh tunggu sebentar. Kalau ingat kejadian di Restoran Wanmin, kayaknya itu mustahil deh. Kebayang enggak? Kira-kira kayak gini nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360603,
					"content": "\"Aku mau ambil gaji sekarang, Bos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360604,
					"content": "\"Oke! Tunggu ... kamu siapa? Memangnya kita kenal?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360605,
					"content": "Heh, mana ada kerjaan yang bertahan kalau semua orang lupa sama kamu. Jadi, dia ngerjain apa ya sampai bisa dapat Mora sebanyak ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360606,
					"content": "Mengambil beberapa harta karun yang terkubur, mengurus beberapa monster pembuat onar ... Tidak ada yang haram kok. Uangnya aman dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360607,
					"content": "Lah! Kamu dengar semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360608,
					"content": "Suara ... nyaring seperti suaramu sulit untuk terlewatkan. Wajar sih kalau sampai terdengar dari puncak gunung terdekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360609,
					"content": "Terus, apa secara kebetulan kamu dengar lelucon Paimon barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360610,
					"content": "Maksudmu waktu kamu memanggilku \"Lavender Melon Beku\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360611,
					"content": "Kurasa sih kedengaran ya, heh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "Enggak, enggak. Maaf, Paimon asal ngomong kok tadi. Sama sekali bukan itu maksudnya! Yang barusan itu ... kayak Paimon! Ya, dia memang jago. Selalu niruin Paimon dan ngasih julukan-julukan aneh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360614,
					"content": "#Oke, oke. Sebenarnya Paimon awalnya enggak terlalu suka sama kamu — tapi sekarang sih beda! Kamu sudah banyak ngebantuin {NICKNAME}, jadi ... kita sekarang sudah jadi teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360615,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360616,
					"content": "Di sini hanya ada satu tempat tidur. Kalian istirahatlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360617,
					"content": "Tunggu, terus kamu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360618,
					"content": "Aku tidak lelah dan tidak butuh istirahat. Aku mau berlatih pedang untuk memulihkan tenaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360619,
					"content": "Tapi, bahumu gimana! Hei! Jangan main pergi saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360620,
					"content": "Ah, terserahlah. Biarin sajalah dia. Paling akhir-akhirnya juga bakal balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360621,
					"content": "Ayo tidur, Pengembara! Tempat tidur yang nyaman itu sudah manggil-manggil Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360622,
					"content": "(Skirk orangnya keras kepala. Mau disuruh santai pun, kurasa dia tidak akan menurut.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "(Paimon benar. Skirk bakal berhenti dan istirahat waktu dia lelah ... Mudah-mudahan saja. Sebaiknya aku tidur saja.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "*huff* ... *huff* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360625,
					"content": "(Skirk ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "(Tentu saja dia berlatih keras seperti sedang tidak terluka. Huh, sepertinya ada yang aneh sama dia ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "Fiuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360628,
					"content": "Diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360629,
					"content": "(Dia ngomong sama siapa ya? Padahal di sekeliling enggak ada orang. Atau jangan-jangan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "Apa kamu ingat berapa banyak dari kami yang mati dalam api itu? Berapa banyak tubuh yang membusuk di tanah hangus itu? Tapi, kamu sendiri tetap hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "Orang yang Sedang Panik"
				},
				{
					"id": 150360631,
					"content": "Jangan alihkan pandanganmu dari pedang, kamu belum boleh istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "Orang yang Sedang Panik"
				},
				{
					"id": 150360632,
					"content": "Larilah, Skirk. Hanya kematian yang menanti kita di sini. Teruslah berlari, dan jangan pernah menoleh ke belakang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "Suara Laki-Laki yang Ceria"
				},
				{
					"id": 150360633,
					"content": "(Oh ya! Dalam mimpi yang kusaksikan itu, Skirk sedang berlatih sendirian, tapi ada suara-suara yang berbicara padanya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "(Salah satu dari mereka bilang api ... Aku penasaran apa yang terjadi. Coba saja aku bisa keluar dan bertanya padanya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "Ahhh, tidur lebih awal memang terbaik! Tempat tidurnya nyaman banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360636,
					"content": "Tunggu, Skirk? Kamu duduk di sini semalaman? Tempat tidur ini bisa kamu pakai kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360637,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360638,
					"content": "Kekuatanmu sudah pulih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "Sekitar 60 atau 70 persen, mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360640,
					"content": "Wah, Paimon kira itu bakal memakan waktu minimal beberapa hari! Tapi ternyata cepat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360641,
					"content": "Tidak ... Masih kurang cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360642,
					"content": "Itu masih 20 persen lebih sedikit dari sebelumnya. Cara latihan dan intensitas yang sama. Tidak ada yang terasa berbeda, tapi entah bagaimana, hasilnya tidak memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360643,
					"content": "Mungkin karena duri yang menusukmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "Tidak, kurasa masalahnya ada padaku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360645,
					"content": "Aku perlu bermeditasi selama dua hari ke depan. Introspeksi yang mendalam bisa membantuku menemukan masalahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360646,
					"content": "Wah, kedengarannya menegangkan! Kami akan menjagamu sementara itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360647,
					"content": "Terima kasih. Sampai jumpa dua hari lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360612,
					"content": "Kemampuan bisik-bisikmu harus diasah, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
		{
			"id": 1503650,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1503609",
