					}
				]
			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "Fiuh ... Seharusnya kita aman di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360502,
					"content": "Aku sudah tidak merasakan lagi keberadaannya. Mustahil dia mengikuti kita keluar dari ruang Abyss itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360503,
					"content": "Orang lemah sepertinya akan sadar kalau kekuatanku tidak mudah dikendalikan. Dia tidak akan meninggalkan tempat itu sampai dia berhasil mencernanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360504,
					"content": "All-Devouring Narwhal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "Kelihatannya kamu sangat terkejut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360507,
					"content": "Kurasa itu wajar ... Kamu baru melihat sebagian kecil dari apa yang paus itu bisa lakukan. Mulutnya yang menganga dapat menelan planet seutuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360508,
					"content": "Ia disebut All-Devouring Narwhal karena suatu alasan — \"melahap\" adalah keahliannya. Ia dapat mengambil tenaga dari apa pun, baik yang hidup maupun yang mati, selama ia berhasil melakukan kontak fisik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360509,
					"content": "Ya, waktu kita ngelawan benda itu, Neuvillette bilang kalau benda itu punya \"insting melahap\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360510,
					"content": "Teman nagamu mengenali sifat kemampuannya dan menggunakan kekuatan Hydro untuk melindungimu. Hal itu berhasil karena ia masih kenyang, jadi ia agak kurang agresif dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360511,
					"content": "Ceritanya akan berbeda kalau makanannya habis. Saat itulah sifat rakusnya yang sebenarnya akan muncul. Ia akan melahap apa pun di planet ini, itulah alasanku melemparkannya ke ruang hampa itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360512,
					"content": "Tapi aku tidak menyangka bisa ada orang yang tersisa di planet ini yang sanggup menggunakan kekuatannya. Bagiku, itu artinya dia pasti sudah bertemu paus itu sedari dulu — artinya, dia pasti sudah mengenal guruku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360513,
					"content": "Dia memang bereaksi terhadap istilah \"The Foul\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "Tepat sekali, buku itu memberikanku informasi tentang semua yang perlu kuketahui. Ya karena itulah kubilang kita berdua mendapatkan apa yang kita inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360515,
					"content": "Berarti kerja sama kita sudah berakhir. Sekarang setelah kamu pulih kembali, kamu bisa kembali melanjutkan lagi perjalananmu. Sementara itu, aku akan menangani sendiri sisa situasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360516,
					"content": "Enggak, kami enggak bisa pergi ninggalin kamu! Gara-gara kami, sesuatu punya kamu jadi dicuri! Kami harus bantuin kamu rebut benda itu kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360517,
					"content": "Ini bukan pertama kalinya aku merasakan kegagalan atau kehilangan kekuatan. Saat terjatuh, bangkitlah lagi dan jadilah lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360518,
					"content": "Tapi ... gimana kalau monster itu nemuin kamu sebelum kamu pulih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360519,
					"content": "Lagian, gimana kamu mau pulang? Kamu enggak bisa langsung buka pintu Abyss lagi. Tanpa kekuatan penuhmu, mustahil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360520,
					"content": "Jadi, kita barengan dulu saja sementara ini enggak apa-apa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360521,
					"content": "Ini bukan karena \"rasa kasihan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360524,
					"content": "Cukup adil. Kalau begitu, ambil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360525,
					"content": "Ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360526,
					"content": "Sekantong Mora. Tidak ada yang gratis di dunia ini — aku paham itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360527,
					"content": "Kuserahkan perencanaannya padamu. Cepat putuskan ke mana kita harus pergi. Kita tidak boleh berlama-lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360522,
					"content": "Kamu bilang aku tidak mau berutang padamu. Okelah, aku masih berutang padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "Dengan kekuatannya, bahkan kekuatanmu pun bisa diambilnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
