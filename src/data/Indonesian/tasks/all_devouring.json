				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Kayaknya buntu nih. Apa ini tempat sembunyi malingnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Duh, kabutnya tebal banget, enggak kelihatan apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "Seharusnya ini adalah tempat kamu diserang, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "Bagian jiwamu yang hilang juga harusnya ada di sekitar sini. Apa kamu bisa merasakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Kalau aku tutup mata dan fokus pada cahaya yang muncul dari lukaku waktu itu ... aku bisa merasakan sesuatu, ada di dekat sini. Tapi aku tidak tahu lokasi pastinya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Tidak begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Hmmm, sepertinya lawan kita sudah menutupi jejaknya. Jika tidak, harusnya kamu bisa merasakannya dengan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Tunggu, lihat itu! Durinya muncul lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Tetap tenang. Kita maju pelan-pelan agar kita bisa mempelajari apa yang sebenarnya kita hadapi. Kalau kita terlalu gegabah, bisa jadi kita yang dijebak olehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Lawan kita mengambil bagian dari jiwamu untuk sesuatu ... mungkin dia menggunakannya sebagai senjata untuk menyerang. Kalau kita pandai melangkah, harusnya bisa kita telusuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Tapi, aku tahu ada di dekat sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
