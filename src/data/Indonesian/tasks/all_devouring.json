			"dialogs": [
				{
					"id": 150360101,
					"content": "Tunggu ... tempat ini dekat Chasm, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "Benar. Dari sini, kita bisa masuk ke tempat yang ada di dalam mimpimu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "Sekarang kamu sudah pernah masuk ke dalam ruang Abyss, tapi ini masih wilayah orang lain. Kita harus tetap hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "Tenang saja! Paimon ini paling jago sembunyi di belakang orang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Eh, tapi ... itu berarti kamu yang harus hati-hati, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Baiklah. Ingat-ingat latihanmu, ini saatnya kamu mempraktikkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Ayo kita beri pelajaran pada maling itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
