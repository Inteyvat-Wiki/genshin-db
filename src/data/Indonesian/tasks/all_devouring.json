			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#{NICKNAME}, Skirk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360302,
					"content": "Barusan itu kenapa ya? Bahu Skirk kayak—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360303,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360304,
					"content": "Di Guili Plains, kamu bertanya kenapa lawanmu ini mengincarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360305,
					"content": "Sekarang jawabannya sudah jelas. Bukan hanya karena kekuatanmu yang luar biasa, tapi juga karena kamu punya kemampuan untuk \"memurnikan\" kekuatan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360306,
					"content": "Terlepas dari definisi \"memurnikan\", faktanya adalah dengan kekuatan ini dia berhasil melakukan yang harusnya mustahil:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360307,
					"content": "Yaitu menembus pertahananku dan mengambil kekuatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360308,
					"content": "Jadi kamu adalah target sebenarnya?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "Tidak, dia tidak mungkin tahu aku akan datang ke wilayahnya. Dia hanya mencuri pecahan jiwamu karena dia tahu nilai kekuatannya. Aku tidak yakin dia mengira itu akan berguna secepat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360311,
					"content": "Sebut saja \"takdir\" kalau kamu mau. Kuyakin itulah istilah yang mereka gunakan di dunia ini untuk kejadian kebetulan yang tidak terduga seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360312,
					"content": "Bagaimanapun juga, itu menguntungkan kita. Begitu aku menyadari untuk apa dia menggunakan kekuatan itu, itu memberiku kesempatan untuk mendapatkan kembali apa yang telah hilang darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360313,
					"content": "Tapi, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Aku akan mengatasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360315,
					"content": "Nah, sudah puas makannya? Bagus. Saatnya menjawab beberapa pertanyaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360316,
					"content": "Kenapa kamu bisa punya kekuatan \"All-Devouring Narwhal\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360317,
					"content": "All-Devouring Narwhal?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360318,
					"content": "Ohhh! Pantas saja Paimon merasa pernah lihat duri itu! Bentuknya kayak tanduk Narwhal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360319,
					"content": "Aku sangat tidak yakin kalau kamu memperoleh kekuatan itu dengan kekuatanmu sendiri. Iya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360320,
					"content": "Kamu kewalahan sampai harus menjelajahi daratan untuk mencari sisa-sisa dewa dan sisa-sisa kekuatan yang bisa ditemukan. Dari situ saja sudah terbukti kalau kamu tidak akan mampu mengalahkan makhluk seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360321,
					"content": "Artinya hanya tersisa satu kemungkinan. Kamu kenal guruku, Surtalogi \"The Foul\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360322,
					"content": "\"The Foul\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360323,
					"content": "Siapa yang berani menyebutnya \"foul\"? Surtalogi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360324,
					"content": "Surta ... logi ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360325,
					"content": "Kamu kenapa, kekuatannya membuatmu kewalahan? Kamu kesulitan berbicara hal-hal yang sederhana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360326,
					"content": "Tunggu sebentar lagi. Aku masih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360327,
					"content": "Lihat! Dia datang lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360328,
					"content": "Mereka yang terobsesi dengan kekuasaan akan membiarkan kekuasaan itu melahap mereka sebelum menyerah mengejarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360329,
					"content": "Kita harus bagaimana sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "Tetap tenang dan gunakan akal sehat untuk memutuskan tindakan terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360331,
					"content": "(Skirk tertusuk salah satu durinya saat mengambil pecahan jiwaku, dan saat itu terjadi, sebagian kekuatannya jadi tercuri.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(Pelakunya bersembunyi di suatu tempat di balik kabut. Aku cukup paham akan pola serangannya dari pertarungan barusan. Kalau kita mengejarnya, peluang menang kita tinggi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Tapi, napas Skirk lebih lemah dari biasanya. Kalau kita menyerang sekarang, aku tidak bisa jamin keselamatan dirinya maupun Paimon. Ini keputusan yang sulit untuk diambil, tapi ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Menurutku, kita harus keluar dulu dari sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "Keputusan yang bijak. Kemenangan akhir tidak selalu datang setelah satu pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360336,
					"content": "Kamu sudah mendapatkan kembali pecahan jiwamu, jadi kita berdua mendapatkan apa yang kita cari. Biarkan musuh bernapas selagi bisa, karena mereka tidak akan bernapas lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360337,
					"content": "Bawa kita keluar dari sini, Pengembara. Kali ini harus kamu yang memimpin jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360309,
					"content": "Dari awal dia sudah mengincarmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
