						],
						"stepId": 1503609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365001,
					"content": "Dia pasti tahu sesuatu tentang Guru, aku yakin itu ... Lain kali, aku harus siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "Bagaimana bahumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "Tidak apa-apa. Hanya luka kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Tentu saja aku butuh waktu untuk memulihkan kekuatan, tapi aku sudah terbiasa beradaptasi dengan hal semacam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Pakaianmu terlihat berbeda ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "Oh, ini? Ini disebut \"Starcrystal Suit\". Kekuatan Abyss langka di Teyvat, jadi memakai ini membantuku mengaksesnya dengan lebih bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Ia menyimpan Kekuatan Abyss terkonsentrasi yang dapat kugunakan saat bepergian. Saat energinya habis, ia kembali ke bentuk aslinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Ayo pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Ah, sudah menemukan tempat beristirahat? Baiklah, tunjukkan jalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
		{
			"id": 1503651,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1503609",
							"2"
						],
						"stepId": 1503609,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1503606",
							"2"
						],
						"stepId": 1503606,
						"stateName": "QUEST_STATE_UNFINISHED"
