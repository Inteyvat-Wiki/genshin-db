				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baizhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "Kamu kelihatannya jauh lebih baik, Pengembara. Seharusnya aku bisa menganggap kesehatanmu sudah pulih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Hmm, kasusmu memang rumit. Sepertinya masih terlalu cepat untuk merayakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "Tepat sekali, Changsheng. Kurasa kita perlu mengamatinya lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "Pasien kami belakangan ini tidak banyak, jadi ada beberapa kamar kosong. Silakan tinggal beberapa hari lagi kalau perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "Asyik, makasih loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
