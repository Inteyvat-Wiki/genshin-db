					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Hmm ... Paimon lagi mikir di sini ada harta karun apa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Ada banyak buku di dalam lemari, bacalah. Kelihatannya itu adalah dokumen rumah sakit seperti kartu catatan medis dan catatan akuntansi.\\nKamu menutup lemari dengan kecewa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Huh, Paimon kira ada harta karun spesial apa gitu ... Masih mendingan peti kayu yang biasa kita temukan sewaktu bertualang dong! Seenggaknya ada Cabbage dan Fowl di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Eh? Apa ini? Sepertinya jatuh dari dalam sana tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Biar Paimon lihat ... siapa tahu ada petunjuk harta karunnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Wah, serem banget sih \"Eleazar\"-nya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Apa yang tertulis di dokumen satunya lagi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Hmm ... Paimon enggak ngerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Aku juga tidak paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Paimon cuma ngerti \"Suara dewa menuntunku\" ... Masa sih di sini bisa ada suara aneh yang nuntun orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Mungkin itu adalah \"aliran air bawah tanah atau aktivitas biologis\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Iya! Siapa tahu memang ada reruntuhan di bawah tanah! Ayo kita periksa kalau sampai terdengar ada suara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Mungkin memang lebih baik enggak usah paham deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Loh, kamu ngerti? Paimon cuma ngerti \"Suara dewa menuntunku\" ... Masa sih di sini bisa ada suara aneh yang nuntun orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
