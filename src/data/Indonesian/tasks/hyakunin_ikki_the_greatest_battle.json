			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "Oh, halo orang asing! Apa kamu tertarik untuk bertarung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "Aku sudah melakukannya ribuan kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "Bagus sekali! Sepertinya aku memilih orang yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "Jadi begini: akhir-akhir ini, beberapa orang diam-diam menyelenggarakan Hyakunin Ikki lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "Maksudmu Hyakunin Isshu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "Bukan, bukan, seperti yang kubilang \"Hyakunin Ikki\". Lagian apa itu \"Hyakunin Isshu\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "Dulunya praktik ini beredar di kalangan Tengu-Kin, yang meniru tengu. Pada dasarnya, mereka akan melakukan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "Ketika situasinya memburuk, ketika mereka merasa sedih, ketika ada sesuatu yang layak dirayakan, atau jika mereka bosan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "Mereka pasti akan langsung bertarung untuk merayakannya, atau sekadar untuk menyingkirkan nasib buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "Kedengarannya cuma bertarung terus setiap saat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "...Ya bisa dibilang begitu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "Apa pun itu, ayo kita ke tempat lain dulu untuk mendiskusikan masalah ini. Terlalu banyak orang di sini untuk membicarakan hal sepenting itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "Aku siap mendengarkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "Apa kamu punya komisi untukku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "Hmm, aku tidak akan menyebut ini sebagai komisi sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "Oke kita sudah sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "Kamu bisa masuk ke Hyakunin Ikki Dojo dengan melangkah melalui... pintu yang mencurigakan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "Ooh, seru juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Walaupun Tengu-Kin sudah lama dilarang karena melanggar ketertiban umum dan moral, beberapa masih mengadakan turnamen gratis untuk semua Hyakunin Ikki dari waktu ke waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "Monster, petualang, dan para prajurit yang haus akan pertarungan akan tertarik untuk datang ke sini dan berpartisipasi di dalam pertarungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "Silakan bawa teman dan rekanmu! Lagi pula, arti \"Hyakunin\" pada \"Hyakunin Ikki\" adalah lebih banyak, lebih seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "Kamu terlihat seperti petualang yang andal. Jadi pasti punya banyak teman yang bersedia bergabung denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "Apa kamu tidak ikut partisipasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "Oh, tentu saja aku juga berpartisipasi — sebagai penonton, dan menyorakimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "Sebenarnya, tujuanku ke sini adalah untuk menulis novel pertarungan yang paling luar biasa dan aku pasti akan memenangkan hadiah pertama di kontes \"Novel Ini Luar Biasa!\" yang diselenggarakan oleh Yae Publishing House...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "Dan firasatku mengatakan bahwa kamu akan menjadi bintang yang paling bersinar di arena ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "Aku akan melakukan yang terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "Bagus! Sebenarnya aku juga sudah memikirkan judul novelnya, \"Hyakunin Ikki: Pertarungan Terbesar\". Kalau kamu suatu hari melihat bukuku di Yae Publishing House, cari bagian di mana sang pendatang asing berambut pirang itu muncul untuk pertama kalinya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "Aku menantikan hasilmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "Oh, ya memang mencurigakan sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}