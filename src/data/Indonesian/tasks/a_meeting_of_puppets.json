				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Kita masing-masing punya jalan sendiri. Tidak perlu dibahas lebih lanjut lagi. Ngomong-ngomong, teh ini lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Om Topi"
				},
				{
					"id": 733560202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560204,
					"content": "Baiklah, sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Om Topi"
				},
				{
					"id": 733560203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
