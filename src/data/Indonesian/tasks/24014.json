					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Terima kasih banyak. Aku akan lanjutkan ini setelah baju selamku diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Semoga semua ikannya bisa tumbuh besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "Tenang, aku sudah siapkan segala jenis ikan untuk segala macam perairan dan lingkungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Bibit ikan yang barusan itu memang khusus untuk daerah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Nanti tambah lagi sedikit, lalu petualang yang sudah kami sewa akan mengusir Mekafish di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Aku percaya bibit ikannya bisa tumbuh besar dan memulihkan kondisi ekologi daerah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Kalau perairan sini sudah kembali sehat, aku akan tulis laporan. Akan kubongkar semua yang sudah dilakukan Institut Penelitian Fontaine terhadap alam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Tunggu saja, Damestier. Jangan harap kamu bisa menghentikanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
