			"dialogs": [
				{
					"id": 240140101,
					"content": "Ikannya semakin sedikit. Apa Mekafish berulah lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Bibitnya harus dilepas ke perairan yang lebih dalam ... Ck, kenapa baju selamnya harus rusak sekarang sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Hai, lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Halo, salam kenal. Namaku Linorea, wartawan yang khusus meliput isu-isu lingkungan. Aku ... lagi melepas bibit ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Wartawan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Iya, wartawan biasa kok. Tapi bukan yang suka meliput berita gosip atau hal-hal membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Masalah yang aku liput itu serius, sedang terjadi, dan mengancam hajat hidup orang banyak di Court of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "Itulah kenapa aku melepas bibit ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "Pernah dengar tentang \"Mekafish\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Belum sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Sejenis ikan khas Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Tujuannya supaya ...?",
					"roleType": "TALK_ROLE_PLAYER",
