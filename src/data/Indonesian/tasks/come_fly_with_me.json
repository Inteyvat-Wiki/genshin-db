							9760.959
						],
						"pointId": 8682
					}
				]
			},
			"dialogs": [
				{
					"id": 750700701,
					"content": "Haha! Aku sudah tahu kita bakal ketemu lagi! Waktunya juga pas banget — kalian akan melihat maha karyaku yang kedua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Hmm ... yah bukan yang kedua juga sih. Aku kan punya banyak karya yang bagus-bagus juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "Intinya kalian beruntung banget deh soalnya bakal menyaksikan diriku yang akan memotret sebuah fotografi yang dinamis untuk pertama kalinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Lagi pula, dulu-dulu aku cuma mengambil foto para korban di TKP ... Eh, jangan bahas itu deh ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Jadi, apa kali ini kamu butuh bantuan lagi, Tuan Magnifico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "Ngu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "Hmm ... tidak sih. Tapi bagus juga kalau kalian bisa bantu! Sini, biar kujelaskan dulu situasinya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Jadi gini ceritanya, aku perlu ambil foto Qucusaurus yang lagi terjun ke arah permukaan air dari air terjun ini. Kita harus ambil momen yang paling mendebarkannya, saat-saat dia mau menyelam ke air itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "Aku sudah sembunyikan makanan yang bisa memancing Qucusaurus di dalam danau yang ada di bawah air terjun. Tapi ... *huff* masih belum dapat sudut yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Hmm? Tunggu dulu. Apaan tuh kok kayak ada lingkaran besar di atas permukaan air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Oh itu sih jangan terlalu dipikirin, walaupun aku sendiri juga tidak tahu sih itu apaan ... Itu kayaknya cuma sampah yang kuambil dari suku di sekitar buat dipakai jadi target.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "*huff* Sampai saat ini, semua foto yang kuambil biasa saja deh, lama-lama kesal juga. Aku bisa saja sih nunggu, tapi kan mumpung kalian ada di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "Mungkin kalian bisa ... ngajarin mereka dulu gitu? Ajarin gimana cara terjun ke air yang anggun? Toh kalian kan penjinak Saurian yang paling sohor seantero Natlan, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "Beneran oke? Bagus! Aku bakal kasih sinyal dari sini. Jadi selama kalian bisa terjun ke lokasi target di airnya waktu aku hitung di \"satu\", segitu saja sudah oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "Yah dicoba dulu saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Haha, bagus! Ayo kita langsung coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "Tapi tidak jamin sukses ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "Tidak masalah. Kalau gagal, ya cuma rugi waktu. Terus kita ini kan petualang — tidak ada satu pun waktu yang terbuang sia-sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
