			"dialogs": [
				{
					"id": 750701401,
					"content": "Gah, kita harus mulai lagi! ... Hm, tolong coba lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "*huff* Ini bukan soal \"keberatan atau tidaknya\". Tapi kagok juga mumpung sudah di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Ya sudah deh, ayo lanjutin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Rehat dulu deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Boleh. Toh lompat dari tebing tuh juga bukan masalah sepele loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Ah ... Iya sih. Aku sampai tidak mempertimbangkan hal itu. Oke deh, bilang saja kalau sudah siap ya. Kutunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
