			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha! Sempurna! Nih, salinannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Wow, ini bagus BANGET!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Nih imbalannya. Ini kedua ... Tidak, ketiga kalinya kalian membantuku. Kalau bukan karena kalian ... Kayaknya aku tidak bakal selesai deh ngambil foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "Tujuanku berikutnya ... ke sini. Sudah kutandai di petamu. Sama seperti sebelumnya, aku harap kita masih bisa kerja sama lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah! Sudah waktunya. Aku harus pergi. Sampai jumpa lagi dan semoga sukses ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico langsung beres-beres dan lompat ke atas balon udara panasnya.\\nSeiring balon tersebut hilang dari pandanganmu, gema dari gelak tawanya pun kian menjauh ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
