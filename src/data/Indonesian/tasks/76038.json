					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Apa <color=#FFCC33FF>Lauma</color> tertarik dengan permen-permen gulali?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Nona Hunajatta, boleh tolong buatkan beberapa untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Boleh, Nona Lauma. Apa anak-anak suka yang kamu bawa pulang kemarin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Hehe, tentu saja. Ada yang sampai menunggu camilannya hampir meleleh dulu, baru rela makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Begitu ya ... Kalau begitu lain kali aku akan bawa peralatanku dan datang ke tempat kalian. Biar bisa langsung buat di depan anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ah, ide bagus. Anak-anak pasti senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, pembahasannya jadi melenceng nih. Aku buat dulu permen gulalinya. Nanti aku minta orang antarkan setelah jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Tapi sebelum itu ... Hehe, aku punya ide bagus~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Tunggu sebentar, Nona Lauma. Aku akan buatkan sesuatu yang spesial untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
