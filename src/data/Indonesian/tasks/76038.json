					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760381109,
					"content": "(Mungkin <color=#FFCC33FF>Linnea</color> tertarik sama permen gulali ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Oh halo, Nona Linnea! Ke sini untuk beli permen gulali buat Lumi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Ya, Lumi sangat suka permen gulali buatanmu, sampai enggak tega memakannya. Setiap kali dia dapat satu, dia cuma menjilat sedikit lalu kasih kepadaku untuk disimpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Tapi, karena permen gulali terbuat dari gula ... lama-lama juga bakal meleleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Jadi aku harus merepotkanmu, Nona Hunajatta, untuk membuatkan satu lagi untuk Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Tidak masalah! Tunggu sebentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Lumi benar-benar menggemaskan deh. Aku ingin mengelusnya! Tapi rasanya agak enggak sopan kalau melakukan itu. Sudahlah ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Ini dia, Nona Linnea. Sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Terima kasih! Lumi, permen gulalimu sudah jadi nih, kamu mau ... Wah, dia sudah tertidur saja. Nanti deh baru aku kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
	]
