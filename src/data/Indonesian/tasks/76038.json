			"dialogs": [
				{
					"id": 760380701,
					"content": "(Apa <color=#FFCC33FF>Jahoda</color> tertarik dengan permen gulali ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "Bos, yang gede satu dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Ini bukan pertama kalinya kamu ke sini, Jahoda. Kamu juga tahu ukuran Permen Gulali kita sudah tetap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Ayolah, hari ini aku lagi senang banget! Ayo cepat, cepat, bikin yang sedikit lebih besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Hari yang bagus ya? Kayaknya misimu lancar nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Hehehe, tentu saja. Cuma misi mengawal biasa aja. Gampang banget, udah beres semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Klienku enggak luka sama sekali, barangnya juga enggak ada lecet sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Oke, aku udah selesai ngomong. Cepat, buatkan porsi yang lebih banyak, mau aku bawa pulang buat dimakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Oke deh. Tunggu sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
