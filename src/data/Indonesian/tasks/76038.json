			"dialogs": [
				{
					"id": 760380508,
					"content": "(Apa <color=#FFCC33FF>Aino</color> tertarik dengan permen gulali ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Halo bos! Beli permen gulali satu dong~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Oh, Nona Aino! Lama tidak jumpa~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Hehe, aku mampir ke kota buat bantu ngebenerin ini-itu. Sekalian deh main ke sini makan permen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Ineffa juga lagi enggak di sini, jadi ... boleh ya bikinin lebih? Terus mau ekstra manis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Boleh, boleh ... Tapi jangan lupa sikat gigi setelah makan, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Iya, iya, tahu. Aku selalu sikat gigi setelah makan permen kok! Lihat nih, gigiku kece badai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380507,
					"content": "Haha ... Kalau begitu tunggu sebentar, ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
