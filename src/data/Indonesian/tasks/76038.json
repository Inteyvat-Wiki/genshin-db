			"dialogs": [
				{
					"id": 760380409,
					"content": "(Apa <color=#FFCC33FF>Flins</color> tertarik dengan permen gulali ....?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Nona Hunajatta, boleh tolong buatkan permen gulali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Oh, tentu. Kamu ... Tuan Flins, Ratnik dari satuan Lightkeeper, benar kan? Aku pernah melihatmu di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Benar sekali. Kadang aku berkunjung untuk berbelanja persediaan. Senang sekali rasanya dapat diingat oleh Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Kebetulan hari ini aku lewat dan melihat langsung kepiawaian Anda dalam menciptakan rupa-rupa Permen Gulali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "Setelah mempertimbangkannya, aku memutuskan untuk memesan satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Oh, tidak perlu sungkan begitu. Aku jadi malu~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Tunggu sebentar ya, aku buatkan sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hmm ... mungkin aku siapkan yang lebih spesial untuk Ratnik kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
