			"dialogs": [
				{
					"id": 760380601,
					"content": "(Apa <color=#FFCC33FF>Ineffa</color> tertarik dengan permen gulali ....?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Permisi, boleh tolong buatkan satu permen gulali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Boleh. Untuk Nona Aino, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Bukan. Aino memintaku datang dan beli permen gulali yang indah untuk diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Menurutnya, ini adalah latihan \"kegiatan sosial\" agar proses belanja bisa lebih efisien di masa mendatang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Oh, begitu~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Tapi aku tidak mengerti, karena aku tidak memerlukan asupan gula sebanyak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Aku menduga Aino akan memakannya diam-diam nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380610,
					"content": "Nona Hunajatta, bisakah Anda membuat ukuran yang lebih kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380611,
					"content": "Aino suka sekali permen, tapi aku merasa sebaiknya dia kurangi sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380612,
					"content": "Bisa, bisa ... Coba ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
