			"dialogs": [
				{
					"id": 760380901,
					"content": "(<color=#FFCC33FF>Columbina</color> bakal suka enggak ya sama permen gulali ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Permen gulali ... rasanya aku pernah mencobanya. Bisa buatkan satu untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380903,
					"content": "Oke! Tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380904
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380904,
					"content": "(Hmm ... Sepertinya waktu itu aku pernah melihat gadis itu di kota ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380905
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380905,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380906
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380906,
					"content": "(Wah! Dia terlihat sangat bersemangat ... Ah, pikir, pikir! Gaya apa yang paling cocok untuknya?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380907,
					"content": "(Ikuti kata hatimu ... percaya pada instingmu ... Oke, oke! Aku pasti bisa!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Umm ... selesai. Coba lihat — suka tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "Wah bagus nih. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380910,
					"content": "Hehe, syukur deh kalau kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Ya, instingku benar — gaya santai dan lembut ini sangat cocok untuk anak yang santai dan lembut sepertinya!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mmm, rasanya enak juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380913,
					"content": "Boleh minta dua lagi, tidak? Aku mau bawa pulang untuk dicoba oleh kuuhenki juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380914,
					"content": "Untuk ... kuuhenki juga? Yah, aku bisa saja, tapi bahan-bahannya tidak cukup ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Kalau begitu besok aku akan kembali dan mengajak mereka bersamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760380916,
					"content": "Tidak masalah ... sampai ketemu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
