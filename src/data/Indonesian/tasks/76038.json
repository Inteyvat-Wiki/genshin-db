			"dialogs": [
				{
					"id": 760381001,
					"content": "(<color=#FFCC33FF>Illuga</color> bakal suka enggak ya sama permen gulali ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Baiklah, mumpung aku sudah di sini ... tolong satu permen gulali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Oh! Bisa tolong buat yang agak kecil? Takutnya nanti ada urusan mendadak, terus jadi tidak bisa kutelan sekaligus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Santai! Tenang saja — ukuran besar kecil tetap nikmat dan memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Tapi kalian para Ratnik memang sibuk sekali ... bahkan membuat permen gulali saja mungkin tidak akan selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Um ... Ahaha ... Yah, bukan hanya karena tugas saja. Kadang juga gara-gara aku ketemu dengan orang yang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Ya siapa yang tidak tahu — permen gulali yang sudah dimakan setengah itu sulit disimpan. Kalau sudah begitu hanya bisa dibungkus pakai kain dan memasukkannya ke dalam saku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Tapi waktu urusan selesai dan permen gulalinya dikeluarkan lagi, semuanya sudah meleleh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Aku paham ... Biar kupikir dulu. Permen gulali yang kecil ... hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Aku paham! Aku bisa buat permen gulali yang kecil dengan berbagai rasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Taruh rasa ini di bawah ... lalu yang ini di atasnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "Eng-ing-eng! Ini dia, permen gulali mini dengan rasa campur sari! Apa ini sudah sesuai dengan preferensimu, pelanggan yang terhormat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, mantap! Terima kasih, Nona Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Oh, tidak perlu sungkan. Mungkin aku tidak bisa membantu pekerjaan kalian para Lightkeeper ... tapi urusan permen gulali, mau buat berapa pun aku ladeni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "Itu memang tugas kami. Kamu terlalu baik, Nona Hunajatta ... Aku pamit dulu, masih ada pekerjaan yang menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Oke, hati-hati! Dan kalau mau permen gulali lagi, langsung datang saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
