			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Hmm, hasil yang lumayan untuk sebuah hidangan yang lezat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "Hasil hipotesis yang kunantikan telah gagal. Sepertinya masalah makanan di duniamu juga sama dengan dunia kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "Apakah mungkin... hukum alam dunia ini telah membatasi kemampuan unikmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Kami tidak tahu cara menyalurkan kekuatan elemental ke dalam makanan. Memasak ini juga sedikit lebih rumit daripada sekadar menambahkan bumbu dan rempah-rempah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Tidak apa-apa, setidaknya semua makanan enak ini habis, tidak perlu kecewa begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Ini porsi yang kujanjikan untukmu, selamat menikmati! Kalau kamu mau, aku bisa membungkusnya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Wah, terima kasih! Senang deh kamu masih ingat sama hal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Kamu akan menjadi favorit baru Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "Karena aku bisa melihat bahwa dia adalah teman baikmu, Paimon terus mengawasimu dan mengkhawatirkan keselamatanmu selama eksperimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Yah, sebenarnya Paimon juga tidak bisa banyak membantu kalau sampai terjadi apa-apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Hei! Padahal barusan kamu sudah baik sama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Tapi kamu punya resep makanan enak, jadi Paimon maafkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "Kamu benar, kita adalah sahabat yang sangat baik! Tapi kamu juga punya teman kan? Murid juga ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "...hemmm, benar juga, aku bisa terbilang cukup beruntung. Tapi sudah cukup bicaranya, ayo kita lanjutkan ke eksperimen selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Karena bahan-bahan alkimia yang sangat banyak jenisnya, menyimpannya dengan rapi dan benar menjadi tantangan tersendiri. Beberapa waktu lalu, aku baru saja salah menaruh beberapa jenis bahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Meskipun aku sudah berhasil merapikan sebagian besar, tetapi ada 2 tabung yang masih belum kutemukan: esktrak elemen Anemo Crystalfly dan bubuk Electro Hypostasis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Baru saja Paimon mulai makan, sekarang sudah harus mencari barang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Yah, sebenarnya tidak apa-apa kalau tidak ditemukan, karena aku memang berencana untuk membuatnya lagi. Tetapi akan sangat membantu kalau berhasil ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Hal-hal seperti ini akan jadi masalah sepele kalau kamu memiliki kekuatan super seperti penglihatan dalam gelap, atau pendeteksi getaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Sepertinya aku menjatuhkan bahan-bahan itu di pojokan tempat yang kalian kunjungi tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Apa boleh buat... kita coba cari saja dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Bahan-bahan tersebut sepertinya memiliki kekuatan elemental.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Benar juga! Coba gunakan Elemental Sight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Jarang-jarang ada yang sebaik ini terhadap Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
