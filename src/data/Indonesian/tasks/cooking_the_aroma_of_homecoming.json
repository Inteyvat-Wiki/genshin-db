			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Wah, lagi masak apa nih? Wangi banget. Aromanya saja sudah buat Paimon ngiler ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210102,
					"content": "Kelihatannya seperti sejenis sup, hmm ... tapi entah sup apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210103,
					"content": "#Hei, {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210104,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "Orang yang masak sup ini lagi enggak di sini. Sup ini kan wangi banget, kita cicip dulu yuk diam-diam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210106,
					"content": "Ayuk deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210112,
					"content": "Isinya rupanya lebih sedikit daripada kelihatannya.\\nIsinya hilang begitu saja.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Wahhh ... Hm? Supnya memang wangi sih, tapi kok enggak ada rasanya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210114,
					"content": "Ya Aramuhukunda! Apa yang sedang kalian lakukan, Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210115,
					"content": "Ar-Aranara? Kamu muncul dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210116,
					"content": "Dari bawah tanah! Sudah cukup, kenapa kalian minum sup yang kubuat? Aku Arapas sudah buat sup ini dengan susah payah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210117,
					"content": "Maaf ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210119,
					"content": "Huh, mencuri sup yang kubuat. Maaf saja tidak cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210123,
					"content": "Apa kalian tahu betapa sulitnya membuat sup di sini? Sebentar hujan. Sebentar panas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210124,
					"content": "Aku susah payah membuatnya, waktu aku keluar memetik Harra Fruit Segar, kalian malah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210125,
					"content": "Soalnya aromanya wangi banget sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210126,
					"content": "Terus ngapain kamu masak sup di sini kalau memang harus susah payah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210127,
					"content": "Hmph, bahan terpenting dalam memasak kan harus dikumpulkan setiap hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210128,
					"content": "Jadi itu kebanggaanmu sebagai seorang koki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "Air! Air! Air yang memengaruhi aroma sup, jadi tentu saja harus menggunakan air yang terbaik untuk supnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210131,
					"content": "Di sepanjang perjalanan, aku sudah mengambil air dari berbagai tempat di Apam Woods untuk membuat sup. Setelah mengumpulkan sampel air sebanyak daun yang berguguran, akhirnya aku dapat air yang terbaik, \"Sumber Air Kehidupan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210132,
					"content": "Itu satu-satunya sumber air yang cocok untuk \"kelezatan yang hakiki\" di Festival Utsava! Aku yakin kalian pasti tidak mengerti meskipun sudah kujelaskan ... Hanya Nara sebelumnya yang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210133,
					"content": "Oh ya, omong-omong, sebenarnya Arapacati yang mengirim kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210134,
					"content": "Kamu menceritakan apa yang terjadi kepada Arapas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "Ah, rupanya Nara teman adikku! Dan Festival Utsava juga akan segera diadakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210136,
					"content": "Tapi tidak masalah, aku sudah menemukan \"Sumber Air Kehidupan\", \"kelezatan yang hakiki\" yang kubuat juga sudah selesai. Semuanya di dalam panci ini ... Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210137,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210138,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Eh-hehe. Jangan bersedih, setidaknya supnya wangi banget kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210140,
					"content": "Ah, \"Sumber Air Kehidupan\" milikku! Airnya berasal dari \"Apshvaana\". Setelah menunggu airnya meninggalkan sumbernya, aku baru berhasil mengambil satu panci saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210141,
					"content": "Tidak! Kalian harus mengembalikan satu panci \"Sumber Air Kehidupan\" kepadaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210142,
					"content": "\"Apshvaana\" ...? Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210143,
					"content": "Huh? Nara tidak mengerti hutan sama sekali. Mereka tinggal di dalam air, punya empat kaki, satu ekor, dan bisa gigit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210144,
					"content": "... Anjing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210145,
					"content": "Memangnya anjing bisa hidup di air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "Oh, iya juga sih. Terus \"Apshvaana\" itu apaan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210148,
					"content": "Jangan bahas itu lagi! Bawakan kembali airku! Dan harus \"Sumber Air Kehidupan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210149,
					"content": "#Oke oke ... {NICKNAME}, apa boleh buat. Ayo berangkat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210150,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Harus \"Sumber Air Kehidupan\", aku tidak mau yang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210151,
					"content": "Ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "Anjing dari mana? Anjing Oceanid?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "Apa itu komitmenmu agar tidak melupakan impianmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "Itu, itu semua karena Paimon rakus ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#Hei! {NICKNAME}, kamu khianati Paimon ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210122,
					"content": "Aku tidak peduli siapa yang minum, yang jelas supku habis sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210108,
					"content": "Rakus juga ada batasnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Paimon penasaran banget sih. Ummm ... satu cicipan saja! Janji, satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210110,
					"content": "Kalau jadi sakit perut bagaimana ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "Huh, jangan remehkan Paimon ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
