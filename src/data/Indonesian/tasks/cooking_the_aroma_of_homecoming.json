			"dialogs": [
				{
					"id": 730210301,
					"content": "Supku ... Huhu ... Kenapa jadi begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210302,
					"content": "(Ayo pergi diam-diam ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "Hmm ... ini air dari sumber sungai. \"Sumber Air Kehidupan\" yang dingin dan jernih seperti cahaya bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Andai saja Arachatora, Arasaka, dan Araphala tumbuh dengan meminum air ini, mereka pasti tidak akan bodoh begini. Hanya Arapacati, adik perempuanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "*uhuk* Jadi selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Ya? Oh ya, selanjutnya, kalian harus buatkan satu panci sup untukku sebagai gantinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Di bawah bimbingan Arapas, kamu menambahkan buah-buah dan sayuran ke dalam air, lalu mulai memasak.\\nAroma yang sedap perlahan mulai mengepul dari dalam panci.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Setelah selesai, kalian bersama-sama mencicipi \"sup\" yang baru dimasak itu.\\nSudah sesuai ekspektasi. Ada aroma dari bahan-bahannya, tapi tanpa bumbu apa pun, rasanya terlalu hambar. Tidak ada rasa sama sekali.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Hmmm! \"Kelezatan yang hakiki\" memang harusnya punya aroma seperti ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Hmmm ... Gimana menurutmu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "Bisa menghilangkan dahaga seperti layaknya semangkuk sup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Paimon rasa bakal lebih enak lagi kalau tambah garam dan merica sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Semuanya jadi lebih enak kalau ditambah garam dan merica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "Oh Aramuhukunda! Kalian mau menambahkan garam? Ide yang mengerikan sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Tanah tempat garam berada tidak memiliki kehidupan. Dan Aranara dipaksa untuk kembali jadi benih. Dan sekarang, Nara mau menambahkan garam?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "Sup memang harus hambar! Nara seperti kalian bahkan tidak paham hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "Nara yang dulu itu menceritakan satu kisah kepada kami setelah dia meminum semangkuk sup:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "\"Kami para Nara, setelah anak-anak Nara pulang ke rumah, mereka akan langsung mencium aroma supnya. Jadi, supnya cuma perlu beraroma wangi saja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "Lalu, dia memuji sup buatan Arapas sangat enak dan harum. Aku akan selalu mengingatnya. Makanya aku tidak akan percaya denganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "Tapi kalau cuma wangi saja tidak cukup sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "Hmph! Tapi karena kalian adalah Nara dari Festival Utsava kali ini, kalian pasti sudah diakui Araja, Arapacati, dan yang lainnya. Kalau begitu, aku terpaksa mencoba untuk memasak sup dengan rasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Kalau begitu akan kucari air yang lebih bagus lagi untuk membuat sup, rasanya pasti akan lebih enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210423,
					"content": "Kurasa tidak ada hubungannya dengan air.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "Benarkah? Tapi \"latihan masak\" ini sudah selesai dengan sempurna. Baiklah, kita tunggu saja sampai Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210425,
