					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250308
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250308,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250309,
					"content": "Tapi tidak usah dipikirkan. Misalkan aku bisa masuk pun, aku tidak akan ikut kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250310
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250310,
					"content": "Aku tidak seperti kepala suku yang berani menentang tradisi. Tugas ini dikhususkan bagi dia yang ditunjuk oleh Tetua Iktomisaurus. Bisa bahaya kalau aku melibatkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250311
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250311,
					"content": "Oke deh kalau gitu. Kami usahakan biar ini cepat beres ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
