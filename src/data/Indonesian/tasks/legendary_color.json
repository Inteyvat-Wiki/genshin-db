			"dialogs": [
				{
					"id": 150250101,
					"content": "Kalian yang ditunjuk oleh Tetua Tlapo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Betul. Kalau kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Namaku Toltec. Aku ditugaskan untuk memandu kalian hari ini. Pembawa pesan kepala suku sudah memberi tahu situasinya, silakan ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
