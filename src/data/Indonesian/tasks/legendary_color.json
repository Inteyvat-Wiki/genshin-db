			"dialogs": [
				{
					"id": 150251201,
					"content": "Ingat terakhir kita ke sini? Kita lihat banyak banget karya seni di gua. Mahakarya leluhur mereka tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251202,
					"content": "Mungkin bahan yang dipakai buat bikin pewarna juga sama kayak yang kita pakai, ya kan? Siapa tahu kita bisa bikin mahakarya sendiri juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251203,
					"content": "Ya sudah, ayo langsung mulai.",
