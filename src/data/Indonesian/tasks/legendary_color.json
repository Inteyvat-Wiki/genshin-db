			"dialogs": [
				{
					"id": 150251801,
					"content": "Nenek moyang suku ini beneran bikin karya seni yang super keren ya. Tapi kayaknya ceritanya bukan cuma sampai situ deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Apa mungkin masih ada karya-karya lainnya di dalam? Aneh ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "Mau dicek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Oh, enggak usah. Paimon cuma kepo. Toltec nungguin kita balik, dan kita masih ada tugas. Keluar dulu yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251807,
					"content": "Kita balik ke tempat Toltec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251805,
					"content": "Mungkin ya. Tapi kita masih ada tugas, mending fokus dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251806
					]
				},
				{
					"id": 150251806,
					"content": "Iya sih. Masih ada lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				}
			]
