			"dialogs": [
				{
					"id": 150251001,
					"content": "Lihat pemandangan ini. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251002,
					"content": "Cantik pakai banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Nah, coba lihat lebih jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251004,
					"content": "Wuah ... grafitinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Selama bertahun-tahun sejak suku ini terbentuk, warna-warna itu senantiasa bersama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251006,
					"content": "Betul bahwa aku ingin mengembuskan napas hidup baru ke suku kuno ini via perubahan dan reformasi. Tapi aku pun paham bahwa ada beberapa hal yang sifatnya mendasar, dan tidak boleh dibuang begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251007,
					"content": "Dan yang paling utama dari semua hal itu adalah cara kami mencatat sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251008,
					"content": "Masuk akal sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Sejak awal mulanya, suku ini selalu ingin memberi warna pada sejarah. Dan aku pun yakin bahwa hal ini adalah salah satu bagian dari warisan kebudayaan yang tidak boleh dilepaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251010,
					"content": "Jadi bagaimana pun juga, aku harus mendapatkan cara untuk melanjutkan produksi kitab gulungan tenun tradisional kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251011,
					"content": "Kamu benar sih. Paimon minta maaf, sudah ngomong yang enggak pantas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Tidak apa-apa kok. Aku senang kalian bisa memahami sudut pandangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150251013,
					"content": "Pokoknya kami bantu sampai tuntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Baiklah, semoga ketika berjumpa lagi nanti tradisi ini sudah berhasil dibangkitkan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				}
			]
