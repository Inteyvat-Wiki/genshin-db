			},
			"dialogs": [
				{
					"id": 150250801,
					"content": "Kami sudah balik! Bahan buat pewarnanya juga sudah dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250802,
					"content": "Berarti kamu bisa tembus segelnya ya. Tetua Iktomisaurus enggak salah pilih orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250803
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250803,
					"content": "Sudah larut. Ikuti aku, kita pulang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
