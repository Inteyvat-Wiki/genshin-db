			"dialogs": [
				{
					"id": 150251501,
					"content": "Jadi pewarnanya ada di dalam gua ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "Aku cuma bisa antar sampai sini. Hanya yang ditunjuk sajalah yang bisa melanjutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "Ceritanya panjang sih. Katanya ada buah yang tumbuh di dalam gua ini, yang sarinya bisa dibikin jadi obat pewarna kualitas tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Bertahun-tahun lalu, leluhur kami berupaya menciptakan karya seni grafiti yang sangat ambisius. Mereka memilih gua ini untuk menuangkan kreativitas, mungkin karena bahan pewarnanya tumbuh di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Tapi mereka tidak ingin siapa pun melihat karyanya sebelum selesai. Maka dari itu, mereka menyegel pintunya supaya tidak sembarang orang bisa masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Untuk melewati segel, kita harus menguasai ilmu melihat warna. Atau semacam itulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251508,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
