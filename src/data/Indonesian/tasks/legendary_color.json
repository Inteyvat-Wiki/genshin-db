				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#{NICKNAME}, kita bukannya sudah pernah ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "Iya, tapi ingat. Kita sudah dipilih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Yang anehnya, leluhur kami tidak membuka segelnya bahkan setelah grafiti selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Karena sudah disegel, yang pernah masuk ke dalam cuma Shaman Agung Huitzilin. Itu sudah dua ratus tahun silam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Menurutnya, gambar ini menceritakan kisah seorang pahlawan bernama Kuntur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "Maaf, bahaya kalau diteruskan. Aku penikmat seni grafiti, jadi kalau membahas ini bisa makan waktu berjam-jam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Yakin enggak mau ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Tidak usah. Aku pernah coba masuk, tapi segelnya menghalangi jalanku. Aku bahkan minta rekan Iktomisaurus-ku untuk membukanya, tapi gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Mungkin ini sengaja dipasang leluhur kami sebagai ujian. Kalau tidak bisa masuk, berarti tidak layak melihat hasil karya mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Tapi tidak usah dipikirkan. Misalkan aku bisa masuk pun, aku tidak akan ikut kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Aku tidak seperti kepala suku yang berani menentang tradisi. Tugas ini dikhususkan bagi dia yang ditunjuk oleh Tetua Iktomisaurus. Bisa bahaya kalau aku melibatkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Oke deh kalau gitu. Kami usahakan biar ini cepat beres ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
