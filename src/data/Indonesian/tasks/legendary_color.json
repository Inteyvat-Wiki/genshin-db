			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": [
					{
						"sceneId": 1200,
						"position": [
							409.031,
							104.539,
							380.959
						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Lihat, ini kitab gulungan yang ditenun oleh leluhur kami. Kita akan membuat yang seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250702,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "Orang yang di gambar itu Shaman Agung Huitzilin. Beliau hidup dua ratus tahun yang lalu, dan juga ditunjuk oleh Tetua Iktomisaurus seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250704,
					"content": "Beliau sangat mahir memanipulasi warna, dan tentunya berhasil menyelesaikan tugasnya dengan gemilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250705,
					"content": "Kitab gulungan ini mencatat semua perbuatannya, dan kemungkinan ditenun oleh tangannya sendiri. Kualitasnya sangat tinggi bahkan meski dibandingkan dengan gulungan lain yang sejenis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250706,
					"content": "Sayangnya semenjak beliau wafat, semua orang yang ditunjuk Tetua Iktomisaurus setelahnya selalu mengandalkan \"tuntunan roh suci\" untuk menunaikan tugas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250707,
					"content": "Tapi sekarang, kamu akan menghidupkan lagi tradisi lama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "#Boleh juga caramu menyebutnya, {NICKNAME}. Namun agak keliru, karena bukan cuma \"aku\" yang kerja, melainkan \"kita\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250709,
					"content": "Ooh! Paimon jadi semangat nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Bawa sampelnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250711,
					"content": "Seorang asisten mengeluarkan sampel untuk uji coba pewarnaan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "#Nah, seperti yang aku sudah jelaskan, proses pewarnaan ini agak rumit. Tapi aku yakin {NICKNAME} pasti bisa, cukup ikuti saja arahan dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250713,
					"content": "Baiklah. Ayo mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Polanya sudah digambar di kain sampel, jadi cukup warnai saja setiap bagiannya dengan benar. Tapi tunggu sampai pewarnanya meresap seluruhnya agar tidak luntur sebelum melanjutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250715,
					"content": "(Warnai kain sesuai arahan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Bagus. Warnanya sudah menyatu ke kain, dan polanya juga cukup jelas. Berikutnya, habiskan semua pewarna agar warna yang khas dan beda dari yang lain itu muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250717,
					"content": "Oke, terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Habiskan obat pewarnanya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Um ... berhasil enggak nih? Paimon enggak bisa lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "Warnanya tidak muncul ... ini gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250721,
					"content": "Salah aku ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "Bukan, teknikmu sudah sempurna. Semuanya sudah sesuai instruksi. Aku sendiri yang kerjakan pun hasilnya tidak akan beda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250723,
					"content": "Terus salah di mananya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Mungkin teknik menenunnya, atau mungkin pewarna khusus harus diaplikasikan dengan cara khusus juga ... Intinya, aku gagal mengungkap misteri ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250725,
					"content": "Maaf ... padahal Paimon ingin bantu lebih dari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "Aku yang harusnya minta maaf karena sudah bikin kalian kerja keras tanpa hasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250727,
					"content": "Sesuai janji, usahamu akan diberi ganjaran setimpal. Tapi mohon jangan menyerah menunaikan tugas. Aku juga akan terus menyelidiki perihal ini dan mengabari kalian bila ada perkembangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250728,
					"content": "Tenang, kami sih pantang menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Tapi Paimon mau nanya dulu ... proses mencatat sejarah ke kitab gulungan tenun tuh kan ribet ya. Kenapa enggak ditulis saja sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "Kan katanya kamu juga mau perubahan dan reformasi. Kenapa enggak mulai dari sini saja? Kalau ditulis kan semua orang jadi bisa lebih gampang aksesnya, terus catatannya juga bisa lebih detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "Sepertinya kamu salah paham terhadap falsafah yang aku anut, dan itu wajar. Aku bisa jawab pertanyaan barusan, tapi ayo ikut dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Kepala Suku \"Penguasa Angin Malam\""
				},
				{
					"id": 150250732,
					"content": "Oh ... ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
