				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Bluey, Bluey! Cerita yang waktu itu belum kamu kasih tahu akhirannya loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270902,
					"content": "Ya, aku ingat. Tapi aku berubah pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "\"Berubah pikiran\"? Maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270904,
					"content": "Akhir ceritanya ... biar kamu bayangkan sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "Heeee?! Kenapa ih, Bluey curang! Kan sudah janji kalau aku cerita, kamu mau cerita juga! Kenapa malah jadi aku doang yang cerita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270906,
					"content": "Aku cuma binatang. Tidak punya akal budi untuk memikirkan akhir yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "Akhir yang ada di benakku adalah buruk. Ceritanya jelek sekali, yang dengar dijamin tidak senang. Jadi akhirnya terserah kamu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "CURANG! Licik pokoknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270909,
					"content": "Aku tidak menyangkal. Sebagai gantinya, aku akan bawa kamu melihat pemandangan tersembunyi di Mt. Lingmeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "Jangan pasang muka kusut begitu. Aku beri izin khusus untuk ... duduk di punggungku selama lima menit. Sepuluh menit lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "Ka-Kalau gitu ... oke, sepakat ya! Aku pikirin dulu akhir ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "Ha? Itu Lingyuan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271002,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271003,
					"content": "Maaf, kamu lagi berburu ya? Kami ganggu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271004,
					"content": "Tidak. Aku tidak berburu. Kalian tidak mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271005,
					"content": "Lah ... terus kamu ngapain? Bengong? Ngelamunin makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271006,
					"content": "Aku tidak sedang memikirkan kamu. Tapi aku memang sedang berpikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271007,
					"content": "Memikirkan ... EH, TUNGGU DULU! Itu kalimat pertama maksudnya apa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271008,
					"content": "#Aku sedang memikirkan pertanyaan {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271009,
					"content": "\"Kalau tindakan manusia adalah bagian dari hukum alam, kamu menganggap manusia itu apa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271010,
					"content": "Sudah lama berselang semenjak aku terakhir kali berhubungan dengan manusia di pemukiman ini. Tidak semenjak Fujin dan ular itu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271011,
					"content": "Eh, si Mao juga orang WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271012,
					"content": "#Mao adalah manusia, dia bagian dari pemukiman, tapi bukan manusia yang membentuk pemukiman. Kamu dan {NICKNAME} \"membentuk\" pasangan teman seperjalanan, tapi kamu bukan \"bagian\" dari {NICKNAME}. Itu bedanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271013,
					"content": "Jadi maksudnya, si Mao tidak kamu anggap sebagai bagian dari masyarakat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "Belum seluruhnya. Kebanyakan manusia muda juga sama, seperti itu hingga tiba saatnya masyarakat menyerap mereka menjadi bagian, seperti alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271017,
					"content": "Aku sudah lama tidak berhubungan dengan manusia yang membentuk pemukiman. Apa karena benci? Atau takut? Atau keduanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271018,
					"content": "Karena mereka menduduki alam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "Tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271021,
					"content": "Atau mungkin \"kami\" dan \"mereka\" sebenarnya tidak berbeda. Entahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271022,
					"content": "Manusia muda berjalan di sisiku, dan kaumku yang masih belia pun berjalan dengan manusia karena penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271023,
					"content": "Ah? \"Kaumku yang masih belia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271024,
					"content": "Anak itu bertemu dengan manusia fana di pegunungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271025,
					"content": "Jadi aku belum bisa menjawab. Masih harus lanjut mengamati manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271026,
					"content": "Ada banyak yang aku tidak pahami, tapi akan kucoba untuk mengerti. Sampai tiba harinya aku bisa menjawab pertanyaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271019,
					"content": "Karena Fujin mengorbankan diri demi mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271015,
					"content": "Masa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271016
					]
				},
				{
					"id": 711271016,
					"content": "Eh, jangan gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
