						],
						"pointId": 311600084
					}
				]
			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#Eh? {NICKNAME} dan Paimon, lalu ada Lingyuan juga ... kenapa kalian semua datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "Wow, itu suara si Fujin! Asalnya dari ... bawah sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "Aku mengkhawatirkanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "Iya! Kita semua khawatir sama kesehatanmu jadi langsung datang ke sini tanpa bilang-bilang dulu. Tapi waktu itu kan kamu juga gitu, jadi Paimon anggap impas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "Eh? Ah! Maaf! Sepertinya aku lupa membuka pintu masuknya sewaktu kembali untuk beristirahat ...! Maaf ya, kalian datang untuk menemuiku, tapi malah jadi buat kalian repot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Oh, enggak repot kok! Tapi kenapa kamu sembunyi di ... uh, genangan air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Hmmm, bagaimana menjelaskannya ...? Karena aku belum bisa kembali ke wujud yang kuinginkan, aku jadi agak ... malu kalau kalian selalu melihatku dalam wujud ikan Karper saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Kamu sadar kami sudah sering lihat kamu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahaha, tapi sebelum ini aku bisa berubah jadi manusia kapan pun, jadi awalnya kupikir lebih mudah bergerak kalau berubah jadi wujud Karper. Tapi sekarang seluruh tubuhku jadi basah dan licin begini, rasanya agak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Wah, kamu ini keras kepala juga ya ... sudahlah, yang penting kamu baik-baik saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "Tapi Lingyuan bilang sebenarnya kekuatan Adeptus-mu tidak terpakai, cuma tersebar saja ke pegunungan, hutan, dan sungai di Lembah Chenyu ... karena itu kamu jadi lemah begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "Jadi kalau kita bisa kumpulkan kekuatan Adeptus yang tersebar itu kayak waktu cari ikan Karper Emas di Lembah Yaodie, berarti kamu bakal pulih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Teorinya sih ya, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Iya, kan? Iya, kan? Jadi kalau ketemu Karper yang mirip, kami langsung bawa sini deh biar kamu bisa pulih lebih cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "Ti-Tidak usah repot-repot begitu! Kekuatanku belum sampai selemah itu kok, harusnya cukup kalau aku istirahat saja di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "Enggak repot sama sekali kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "Pokoknya kami ingat dulu, siapa tahu ketemu di jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Kalau begitu terima kasih banyak. Tapi aku tidak ingin merepotkan kalian lagi. Kalian sudah banyak sekali membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "Kalau kalian berdua menemukan Kekuatan Adeptus dalam perjalanan, mohon pindahkan kekuatannya ke giok ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Keseimbangan air dan tanah sudah pulih, tapi jika kita bisa menambah kekuatan Rainjade, maka ke depannya kita akan diberkahi cuaca yang baik dan tahun-tahun yang makmur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "Terus kamu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Astaga! Aku kan sudah bilang, aku cuma perlu istirahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}, Paimon, terima kasih banyak. Aku senang sekali kalian mau datang berkunjung. Ini pertama kalinya ada yang main ke sini semenjak Herblord pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "Terima kasih juga, Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "Aku tidak melakukan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Oke, cukup! Anggap saja terima kasihnya karena kamu sudah bawa {NICKNAME} dan Paimon ke sini! Ampun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#Terakhir ... terima kasih sekali lagi untuk {NICKNAME} dan Paimon yang sudah banyak sekali membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "Terus buat apa ngumpet-ngumpet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan mengkhawatirkanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "Aku tidak ... aku cuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "Iya! Tuh, Lingyuan khawatir banget sampai enggak bisa ngomong. Jadi kita langsung datang ke sini tanpa bilang-bilang dulu. Tapi waktu itu kan kamu juga gitu, jadi Paimon anggap impas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
