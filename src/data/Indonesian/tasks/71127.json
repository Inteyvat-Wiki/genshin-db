	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "Eh, ini tuh rumahnya kamu kan, Fujin? Kok agak beda ya sama rumah Adeptus lainnya .... Gimana bilangnya ya ... lebih ... realistis gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "Enggak ada mekanisme aneh-aneh atau jembatan transparan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "Ah, maafkan aku. Sebelumnya aku terlalu malu sampai tidak sempat menjelaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "Aku tidak bisa menciptakan alam dan ruang seperti para Adeptus dari selatan. \"Carp's Rest\" ini tidak bisa dibilang sebuah \"kediaman\" ... mungkin lebih pas disebut gua saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Gua, alam, sama aja ah! Pokoknya yang diam di dalamnya Adeptus, betul kan? Tapi kita juga enggak tahu kapan kamu bisa balik lagi ke wujud manusia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "Semua kekuatan yang dia kumpulkan sudah tersebar ke seluruh dataran ini. Seharusnya dia tidak akan bisa kembali ke wujud manusia dalam waktu dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "Aku juga sama kalau kekuatanku habis. Setelah Master meninggal, aku tidak bisa kembali ke wujud manusiaku selama salju turun, meleleh, sampai turun lagi hingga tak terhitung berapa kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Hooo, ternyata begitu ya ... eh?! Tunggu, Lingyuan juga bisa berubah jadi manusia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "Tentu saja! Masih ada banyak hal yang tidak kalian ketahui! Bahkan waktu di Mt. Yaojun, penampilan Lingyuan itu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin. Tidak perlu membicarakan hal itu, tidak ada hubungannya dengan topik saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Eh? Jadi soal makan kue kebanyakan waktu kamu jadi manusia dan pergi ke Festival Kuil, lalu merengek ke Herblord minta dikasih teh penurun berat badan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "Atau kejadian waktu kamu tidak sengaja minum arak persembahan, lalu mengumpulkan semua babi hutan dan bertanya: \"Siapa yang lebih cantik, aku atau Herblord?\" .... Ah! Tapi aku tidak perlu cerita soal itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "FUJIN!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "Wow! Setelah dengar itu Paimon jadi semakin penasaran sama wujud manusia Lingyuan deh! Apa bakal warna biru juga kayak sekarang? Atau ... mungkin lebih putih sedikit ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "Aku juga jadi penasaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "Aku tidak paham kenapa kalian bisa penasaran. Kalian sendiri kan manusia? Kalau penasaran, ya tinggal cari cermin lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Hehe. Pokoknya, terima kasih ya {NICKNAME} dan Paimon. Tak kusangka hari ketika aku bisa bicara dengan orang lain seperti ini akhirnya datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "E-Ehem ... karena diriku sedang berada dalam suasana hati yang cukup baik, maka diriku bersedia memberkati kalian berdua dalam perjalanan kalian. Semoga semuanya berjalan lancar dan makmur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "Maaf, jadi terbawa suasana. Tadi aku mau coba bersikap seperti Adeptus, jadi ya ... aku coba gaya bicara barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "Oke, pokoknya! Aku akan tetap di sini dan mendoakan agar perjalanan kalian selalu lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan, bisa tidak berubah jadi manusia? Sebentar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "Aku menolak. Tubuh manusia terlalu lemah. Tidak memiliki taring untuk menggigit dan mengoyak mangsa, tidak ada cakar untuk memburu musuh. Aku tidak akan melakukannya kecuali atas perintah dari Fujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "Eh? Ya-Yang benar? Ka-Kalau begitu, lebih baik kita juga hormati keinginan Lingyuan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "Aku tidak ingin apa-apa. Beri tahu saja padaku kalau kamu ingin sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
