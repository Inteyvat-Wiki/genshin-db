					"nextDialogs": [
						711271204
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271204,
					"content": "Misalkan kamu atau si ular minta aku menjelma jadi manusia lagi ... aku menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271205
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271205,
					"content": "Hehe, aku belum pernah minta kayak gitu, kan?",
