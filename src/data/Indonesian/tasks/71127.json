					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME} dan Paimon, kalian datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "Eh? Lingyuan? Kenapa kamu ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "Karena aku tidak bisa masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "Enggak bisa masuk? Maksudnya ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "Ke dalam Carp's Rest, tempat Fujin beristirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "Carp's Rest ... Oh! Maksudnya ke tempat yang kita dibawa Fujin tempo hari ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "Tempat itu adalah kediaman yang disegel oleh kekuatan Adeptus-nya. Karena aku tidak punya kekuatan Adeptus-nya, jadi aku tidak bisa masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "Eh? Tapi kamu tidak bilang apa-apa waktu dia kembali beristirahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "Tidak terpikirkan olehku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "Perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "Kekuatan Adeptus yang kamu miliki cukup untuk membuka gerbang Carp's Rest. Singkat kata, ya, aku butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Eh? Tunggu dulu, jadi kamu terus ada di sini menunggu kami datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "Aku tidak sedang menunggu kalian, aku sedang mencari cara untuk masuk ke dalam Carp's Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "Lah, terus apa bedanya .... Uh, kami juga khawatir sama kondisi si Fujin sih, jadi gimana kalau kita samperin dia sama-sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "Baiklah, terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "Sudah telat nih, Bluey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Iya, kok bisa-bisanya kamu lupa hal sepenting itu!? Ampun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "Karena aku hanya seekor binatang buas yang bodoh. Aku memikirkan banyak hal, tapi juga melupakan banyak hal. Salahku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "Kekuatan Adeptus yang kamu miliki cukup untuk membuka gerbang Carp's Rest. Singkat kata, aku butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
