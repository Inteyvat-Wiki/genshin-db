			"dialogs": [
				{
					"id": 711271301,
					"content": "Kak Fujin! Selamat karena sudah kembali ... ke wujud asal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271302
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271302,
					"content": "Bluey sudah cerita semua! Katanya Kakak doyan sekali teh, terus sengaja minta Kakek Lu bikinin kue teh super enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271303
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271303,
					"content": "Iya, aku sudah kembali, utuh dan penuh! Mao, makasih ya sudah mau bikin kue teh. Aku senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711271304,
					"content": "#Kak {NICKNAME} juga dapat! Kak Paimon juga. Aku juga! Kita makan bareng, rayain kembalinya Kak Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271305,
						711271307
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271305,
					"content": "(Ambil kue.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271306
					]
				},
				{
					"id": 711271306,
					"content": "Makasih ya Mao! Duh, banyak sisa nih, Paimon ambil dua ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
