			"dialogs": [
				{
					"id": 760540301,
					"content": "Seperti ... ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540302,
					"content": "Hmm, pikirkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540303,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540304,
					"content": "Bulan ... bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540305,
					"content": "Kalau di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540306,
					"content": "Aku menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540307,
					"content": "Ketiga bulan sudah sejajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540308,
					"content": "Hmm, ini langkah terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540309,
					"content": "Mm ... bulan terbit dan terbenam, tanpa henti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540310,
					"content": "Bulan-bulan kita menolak dibayangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540311,
					"content": "Kita ... seri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540312,
					"content": "Ah, kamu memikirkan penempatannya sampai matang sebelum memutuskan. Silakan, toh waktu kita sama-sama banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540313,
					"content": "Kamu lupa cara mengangkat bulan ke langit malam? Perlu dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540314,
					"content": "Kamu tidak suka? Aku rasa permainan ini ... sangat menghibur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540315,
					"content": "Mm? Kenapa melihat kemari? Pandanganmu sangat menohok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540316,
					"content": "Kamu melihat ... jawaban \"bulan\" di wajahku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540317,
					"content": "Papannya di sebelah sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540318,
					"content": "Hmm, bulan-bulanmu sudah sejajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540319,
					"content": "Langit malam sudah kamu kuasai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540320,
					"content": "Ah, aku ... sepertinya keliru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540321,
					"content": "Kalian sangat menikmati waktu bermain bersama Columbina ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Tiga bulan berderet dalam satu garis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210203,
					"content": "Hmm? Masih kepikiran soal pertandingan terakhir itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Oh, tidak. Hanya saja ... kalau dipikir lagi, permainan tadi memberi perasaan yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210205,
					"content": "Oh, ya. Sekarang kamu udah punya kekuatan tiga bulan, udah jadi lebih dari sekedar penguasa langit malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Ya. Dan aku juga berpikir ... nasib dunia ini mungkin akan berbeda jika ketiga Dewi Bulan tidak terpecah belah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210207,
					"content": "Mereka itu seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "Yang pertama kulihat adalah Sonnet, Dewi Bulan Pelangi. Dia lebih ceria dari yang kubayangkan, seperti adik perempuan yang suka bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210209,
					"content": "Aria, Dewi Bulan Abadi, yang paling dewasa di antara ketiganya. Dia pemimpin alami, dan paling lembut pada yang lain. Ah, mirip seperti Lauma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210210,
					"content": "Kalau soal Canon, Dewi Bulan Embun ... dia sepertinya bijak dan berpandangan jauh. Dan dia yang memberikan bulannya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210211,
					"content": "Mereka semua sepertinya adalah dewi yang baik hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Ya. Meski mereka berbeda, mereka mencintai Teyvat, dan cinta tempat ini seperti rumah mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210213,
					"content": "Saat aku cerita ke mereka tentang masa depan, mereka semua terlihat lega, senang karena dunia ini masih punya masa depan yang begitu indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210214,
					"content": "Itu juga alasan mereka kasih aku kekuatan untuk \"pulang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210215,
					"content": "Huh ... Paimon pengen banget ketemu mereka, dan kasih mereka \"terima kasih\" yang benar-benar tulus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Aku juga sangat ingin begitu. Tapi sepertinya hal itu tidak mungkin lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210217,
					"content": "Untungnya, dunia ini terus berputar, dan manusia yang mereka lindungi masih bertahan hidup, serta terus menurunkan kisah mereka sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210218,
					"content": "Betul banget! Asal kita hidup dengan baik dan enggak biarin para penjahat hancurin dunia — itu udah terima kasih terbaik yang bisa kita berikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Kamu jadi jago ngomong ya, Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Kalau begitu, setiap hari adalah hari untuk berterima kasih bagimu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Tentu dong! Kamu bisa yakin Paimon selalu berusaha hidup sebaik mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Kamu juga, Columbina! Jangan lupa makan dan tidur yang cukup tiap hari, dan kalau mau main bareng, langsung datang aja ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210224,
					"content": "Aku rasa mulai sekarang, aku akan teringat ketiga dewi yang lembut itu setiap kali aku main Catur Bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
