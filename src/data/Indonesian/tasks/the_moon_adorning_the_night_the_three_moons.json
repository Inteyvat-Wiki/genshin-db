			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210102,
					"content": "Hei Columbina! Sepertinya kamu lagi senang ya hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Hah ... ayo naik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210104,
					"content": "Mau main Catur Bulan lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Ya. Sudah lama sekali, dan aku agak rindu main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210106,
					"content": "Aturannya masih sama seperti dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Atau, kamu bisa pindahin beberapa bidak dalam satu giliran karena kamu itu sekarang Tiga Dewi Bulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Kalau begitu namanya curang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761210109,
					"content": "Hehe, iya, Paimon tahu kok! Paimon bercanda doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "Kalau begitu, kita mulai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
		{
