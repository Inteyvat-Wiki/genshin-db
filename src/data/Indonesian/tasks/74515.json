			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745150101,
					"content": "#Eh? {NICKNAME} dan Paimon? Kalian tepat waktu! Kebetulan aku lagi mau mengajukan misi ke Adventurers' Guild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150102,
					"content": "#Wah, ada misi! Asyik, malam makan enak nih, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150103,
					"content": "EHEM! Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150104
					]
				},
				{
					"id": 745150104,
					"content": "Oh, eh, iya, iya. Petualang kondang seperti kami punya standar sendiri untuk jasa kami ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150105,
					"content": "Tenang! Asalkan kalian bisa mengurus modul eksperimennya seperti dulu, imbalannya tidak akan mengecewakan. Aku jamin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150106,
					"content": "Du-Dulu? Kita udah pernah ketemu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150107,
					"content": "Ck, lagi-lagi begini. Lupa terus sama aku ... Hosseini, peneliti dari Sumeru itu! Kita sudah sering kerja sama loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150108,
					"content": "Ma-Maaf, kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150109,
					"content": "\"Cakram Pengetahuan\" ... sudah ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150110,
						745150111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150110,
					"content": "AH! Si Orang Cakram!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150113
					]
				},
				{
					"id": 745150113,
					"content": "Oh ... KAMU! Iya, yang di The Chasm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150114,
					"content": "Kamu jauh lebih ceria dibanding waktu itu ... pantas saja kami enggak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150115,
					"content": "Hehe, oh ya? Yah, aku memang lagi senang sih. Sudah lama enggak beruntung kayak gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150116,
					"content": "Hmm, kenapa gitu? Cerita dong, cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150117,
					"content": "Yah, panjang sih ceritanya. Setelah terakhir kali kita ketemu, aku balik ke Akademiya lalu bikin proposal Cakram Pengetahuan buatan berdasarkan data yang berhasil kita kumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150118,
					"content": "Pembimbingku semangat banget begitu lihat proposalnya. Terjemahan: dia langsung memberikan \"pujian tertinggi\", dan setelahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150119,
					"content": "Setelahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150120,
					"content": "Dia mengusirku dari Sumeru. Aku disuruh kerja serabutan di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150121
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150121,
					"content": "LAH? Tadi katanya dipuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150122,
					"content": "Oh, iya, \"dipuji\". Karena berani mengirimkan novel fantasi sebagai proposal proyek ilmiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150123
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150123,
					"content": "Errr, dilihat dari sisi mana pun itu sih bukan dipuji ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745150124,
					"content": "Ya, aku lumayan lama loh sedihnya. Ditolak tuh sakit banget rasanya. Tapi aku beruntung bisa ketemu investor dan partner baik hati di sini yang berminat dengan proyekku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150125
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150125,
					"content": "Dengan bantuan mereka, aku berhasil menggabungkan penelitian yang dulu dengan teknologi Fontaine untuk menciptakan Cakram Pengetahuan buatan, kuberi nama \"Cakram Hosseini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150126
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150126,
					"content": "Asalkan bisa lulus tahap uji coba sesuai hitungan, jangankan ujian Dewa Kebijaksanaan ... mungkin aku bisa langsung diangkat jadi Sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150127
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150127,
					"content": "Ah, jadi intinya kamu sekarang masih belum lulus ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150128
					]
				},
				{
					"id": 745150128,
					"content": "EHEM! Tolong jangan bahas soal itu dulu deh. Ini cuma kemunduran selangkah sebelum meroket maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150129
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150129,
					"content": "Yang paling penting sekarang adalah membuktikan kinerja Cakram-ku. Itulah kenapa aku perlu sukarelawan untuk mengujinya di dalam Domain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150130
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150130,
					"content": "#Nah, {NICKNAME}, apa kamu bersedia menguji Cakram Hosseini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150131,
						745150133
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150131,
					"content": "Intinya aku harus berantem lagi kan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150132
					]
				},
				{
					"id": 745150132,
					"content": "Iya, betul. Aku percaya sepenuhnya pada kemampuanmu, tapi Cakram ini belum benar-benar sesuai dengan rancangannya, jadi tolong hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150133,
					"content": "Oke. Serahkan saja padaku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150134
					]
				},
				{
					"id": 745150134,
					"content": "#Nah, {NICKNAME}, aku percaya sepenuhnya pada kemampuanmu, tapi Cakram ini belum benar-benar sesuai dengan rancangannya, jadi tolong hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 745150111,
					"content": "Maaf, masih tidak ingat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150112
					]
				},
				{
					"id": 745150112,
					"content": "Si \"Orang Cakram\"! Masa lupa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150113
					],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}