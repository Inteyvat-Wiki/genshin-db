						761170604
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170604,
					"content": "Beristirahatlah dengan tenang, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170605
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170605,
					"content": "Satu hal yang pasti ... \"nasib\" yang menimpamu, tidak akan menimpaku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170606
					],
					"speakerTitle": "Jahoda"
				},
				{
