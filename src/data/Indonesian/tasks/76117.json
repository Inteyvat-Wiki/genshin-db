						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*hosh hosh* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Siapa? Aku tidak punya uang, tidak punya apa-apa ... kalau mau bunuh, silakan, langsung saja. Yang cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "Ihanti, aku mau pulangin barang-barangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "Jahoda ...? Aku bisa dengar suaramu, tapi mataku sudah tidak bisa lihat jelas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Iya, ini aku, Ihanti. Aku berdiri di depanmu. Kenapa enggak cari aku sih? Kondisimu parah banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Anjing liar yang kelaparan pun tidak akan pernah menjejakkan kaki di jalanan kota orang kaya ... karena telah ditendang dan diinjak-injak berkali-kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Aku bukan orang seperti itu, dan Nef— BOS NEFER juga bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Karena itulah aku makin tidak mau cari kalian. Kalau sampai orang tahu kalian tipe yang suka membantu, nanti setiap hari ada yang datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Orang gila mana yang berani kayak gitu ke bosku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Tapi kamu selalu di luar sana, diam-diam berbuat kebaikan. Dan setiap kali pula kamu ditusuk dari belakang sama yang sudah dikasih hati malah minta jantung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Eh, gini-gini aku juga sudah belajar banyak dari Bos Nef. Sekali kena kayak gitu sudah cukup, tidak ada dua kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "Kamu ... memang tidak bisa kalau tidak menolong orang-orang di sekitarmu ya, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "Itu urusanku seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Heh ... mungkin itulah kenapa bos sangat menghargai kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Mungkin itulah kenapa aku masih bisa hidup sampai hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha ... *uhuk* Kamu benar, Jahoda. Kamu benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "Intinya, kalau ada yang bisa aku lakuin buat kamu, Ihanti, ngomong sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Masih sama seperti dulu ... hmm, gimana kalau ini ternyata cuma tipu-tipu? Atau, aku sekarang sedang menjebakmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Kamu tidak akan. Karena kita ... sudah kenal lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "Dan itu saja cukup untuk membuatmu percaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Astaga, ngaca dulu lah kau ini. Gimana caranya kamu mau bikin aku susah, coba?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Ha! Akhirnya bicara fakta. Yah, menolong ular berbisa yang sudah nyaris tidak bisa mangap memang cukup aman, benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Kalau begitu tolong aku satu hal ... gulung lukisan di dalam tas itu dan masukkan ke dalam kantongku. Aku tidak kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "Aku melukisnya bersama dengan istri dan putriku dulu. Hanya itu saja satu-satunya yang masih aku pedulikan di seluruh dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Selain itu, sudah tidak ada lagi yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Heh, kamu yang dulu bisa ketawa sampai keselek kalau dengar omongan barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Hah ... gimana nasibnya semua harta yang dulunya begitu berarti bagiku, bahkan di atas segalanya? Tidak satu pun bisa menyelamatkan. Tidak istriku, tidak hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Tapi mungkin memang begitulah nasib seorang pencuri. Semua yang didapatkan dengan cara mencuri pada akhirnya akan dicuri kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Liontin yang aku berikan sebagai jaminan misi adalah satu-satunya kepunyaanku yang tersisa ... Hah, bahkan sebenarnya itu pun tidak bisa dibilang \"milikku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Itu perhiasan pertama yang kamu curi. Dan ceritanya sudah aku dengar lusinan kali, dari mulai caranya, sampai gimana muka si orang kaya itu waktu sadar dirinya kemalingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Begitulah. Itu milikmu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "Siapa pemilik aslinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "Orang Snezhnaya bernama Holomov. Dia tadinya tinggal di Nod-Krai, tapi mungkin sekarang sudah pulang ke Snezhnaya. Jangan bilang kamu mau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Aku sudah bukan maling. Dan aku enggak mau jadi penadah barang curian. Liontin ini akan dikembalikan ke tangan pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha ... hahahaha ... Jahoda, kamu ... memang lain dari yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Bos benar ...orang sepertimu ... tidak bakat *UHUK* jadi pencuri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*uhuk UHUK UHUEK*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Sudah, jangan ngomong terus. Aku mau panggil dokter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Lupakan. Biarkan aku mati seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Tapi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, sudah lupa aturan bos ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "\"Barangsiapa lelah, hendaknya ia beristirahat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Kamu tahu maksudnya, kan? Jadi tolong, biarkan saja aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Aku senang pada akhirnya kamu yang datang menolong, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Maaf aku tidak punya apa-apa untuk diberikan padamu. Tapi kalau mau, ambil saja boneka ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Tunggu, aku kan bilang boneka itu harus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Tenang, ini buatanku sendiri. Yang kamu buat sudah tidak ada semua. Aku bakar habis, sesuai permintaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Lumayan, kan? Padahal yang bikinnya sudah hampir buta loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Ambillah, Jahoda. Anggap saja hadiah terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Aku akan balik lagi ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Pergilah. Selamat tinggal, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ihanti"
				}
			]
		},
