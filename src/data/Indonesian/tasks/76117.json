			"dialogs": [
				{
					"id": 761170101,
					"content": "Mm-hmm, sepertinya Anda berhasil menyelesaikan misinya tanpa kendala. Terima kasih, Nona Jahoda, ini bayarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "Tuh, aman banget, ya kan? Aku sudah bilang. Bayarannya juga oke ... hehe, ada lagi enggak kerjaan yang kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Sebentar, aku cek dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Eh, itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Hei, Katheryne ... liontin itu buat apa? Ngajuin misi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Betul sekali, mata Nona Jahoda jeli juga. Tuan Ihanti menaruhnya di sana sebagai jaminan untuk pengajuan misi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "Kalau gitu aku ambil misinya. Mana, minta berkasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Boleh, tapi ... bayarannya tidak begitu bagus, dan jaminannya juga harganya tidak dihargai terlalu tinggi. Aku tidak yakin Nona Jahoda bersedia mengambil misi seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "Santai, aku mau kerjain kok. Anggap saja ini ... amal. Sekali-sekali bagus juga kan cari pahala, jangan cari duit terus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha ... baiklah. Mohon tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Ngambil misi lagi ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Yah, kerjaan yang lain juga memangnya lagi sepi. Masa iya aku cuma nemenin si Ashru main seharian? Gawat kalau Nef— BOS NEF murka, dipecat lagi deh aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Hmm, berhubung kalian sudah di sini ... {NICKNAME} dan Paimon kan bisa diandelin banget ya orangnya. Mau ikut ngerjain ini enggak? Hasilnya bagi dua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "Misi? Tanya si bestie deh, kalau ginian dia ahlinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Misi biasa saja yang sepele banget. Percaya deh, si Ihanti itu penakut banget, mustahil ngajuin misi yang aneh-aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Nona Jahoda, silakan. Ini berkas misi Tuan Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Oke, kita lihat si penakut itu minta apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "Ck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Kenapa \"ck\"? Aduh, jangan bilang misinya super-duper sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Oh, bukan kok. Cuma enggak nyangka saja orang yang enggak tega nginjek semut bisa ngajuin misi yang urusannya sama hidup dan mati gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "Hi-Hidup dan mati?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "Kamu? Hahaha, iya, iya ... paling teladan, paling baik, paling taat aturan. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Santai, aku bercanda kok. Misinya cuma minta kita rebut sesuatu dari gerombolan bandit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Yang namanya bandit, hidupnya untuk duit, duit itu hidupnya. Berarti kalo urusannya sama duit, sama saja hidup dan mati kan jatuhnya? Haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Ayo, sini. Aku bisa sih urus mereka sendirian. Kalian mungkin cuma bakal kebagian nonton doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Ehem, aku ini petualang yang taat hukum ya, tolong diingat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Oke deh, aku ikut. Misi apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Sibuk seperti biasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
