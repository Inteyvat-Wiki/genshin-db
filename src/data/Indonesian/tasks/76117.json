			"dialogs": [
				{
					"id": 761170201,
					"content": "Cih, pecundang. Miskinnya sudah kelas melarat, masa sih barangnya enggak ada yang berharga sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Yo, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Siapa yang ... Wah, wah, wah, si Jahoda rupanya! Mau apa kau kemari, cebol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Santai, bukan urusan gede kok. Katanya kamu ngambil sesuatu dari seseorang bernama Ihanti berapa hari kemarin. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Nih, aku ambil. Tukar sama barangnya. Hari ini aku lagi murah hati, jadi anggap saja ini duit tebusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Oho, ada angin apa? Kok tumbenan kamu jadi beradab gini. Ah, seperti ini ya nasib orang yang diawasi terus sama Nefer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Kalau aku tidak bersedia transaksi, kamu mau gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Kaleva, yang benar lah. Sekali-sekali boleh dong kelakuan kamu dan geng bodohmu dinormalin dikit, apa ruginya coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Halah, yang benar saja. Masa iya kamu jauh-jauh ke sini cuma buat transaksi sama maling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Atau kamu kira aku beneran mau serahin barangnya kayak gitu doang? Semudah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Waduh, negosiasinya langsung buyar dari awal nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*huff* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Salahku juga ya, Kaleva. Ngapain juga aku niru-niru cara Bos Nef urusan sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Memang runding sama gerombolan idiot macam kalin itu paling benar pakai bogem mentah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Sini, {NICKNAME}. Kita bikin orang-orang bego ini jadi perkedel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Ngeremehin kami ya? Anak-anak, kumpul! Kita kasih si cebol ini pelajaran, biar dia tahu tata krama! SIKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
