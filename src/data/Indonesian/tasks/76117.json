						"pointId": 14264
					},
					{
						"sceneId": 3,
						"position": [
							2098.119,
							200.186,
							9563.697
						],
						"pointId": 14265
					}
				]
			},
			"dialogs": [
				{
					"id": 761170301,
					"content": "Oke, OKE! Ampun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Makanya, kalau sudah ditawarin yang enak tuh terima saja! Kan enggak usah kalian terkapar semua kayak gini. Nih, ambil duitnya. Ke dokter sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Hmph, gini caranya ngasihanin orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Jangan banyak mulut, terima saja tuh duit. Mau dibuang ke kali kek, mau bayar preman buat cegat aku di gang kek, masa bodoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Satu hal ya, babak belur tuh sudah sakit, apalagi kalau masih harus ditambah kelaparan. Jangan memperburuk keadaan, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "Sampah punya si cacat itu ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "Cuma uang receh, lukisan jelek, dan boneka ringsek. Duitnya sudah habis semua, tapi sampahnya belum sempat dibuang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Oke, pertanyaan terakhir. Barusan kamu nyebut Ihanti \"si cacat\". Itu apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Belah mananya yang kurang jelas? Si payah itu sekarang sudah parah sekali kondisinya. Nyaris enggak kelihatan masih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Pas ketemu dia tempo hari, dia cuma tiduran di sana, kaku kayak papan. Aku sempat kira dia sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "Intinya, aku pikir dia sudah enggak perlu lagi kantong ini. Makanya aku \"amankan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Kasih tahu di mana kamu terakhir lihat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Terakhir lihat dia? Di ... situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Oke. {NICKNAME}, Paimon, ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Aku mau kembaliin ini langsung ke orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
