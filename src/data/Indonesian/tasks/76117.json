					}
				]
			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "Ah, misi selesai. Mohon tunggu sebentar untuk pembayarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "Nona Jahoda baik-baik saja? Anda terlihat agak pucat ... ada masalah ketika menjalankan misi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "Tidak kok, aku baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Baiklah kalau begitu. Sebentar ya, biar aku ambilkan dulu bayarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Jahoda, kamu benar enggak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Paimon tahu kita sudah setuju enggak bakal manggil dokter, tapi ... si Ihanti itu kondisinya sudah parah banget, mungkin sebaiknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "Tidak. Aku sudah bilang akan taat aturan. Taat berarti taat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Jadi ... kalian sudah kenal lama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Kami mantan \"rekan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Dia boleh saja pengecut, tapi kalau urusan cari duit, dia itu jagonya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Waktu semua orang lain bikin skema tipu-tipu murahan atau jadi rampok kelas teri, dia sudah main dengan jurus yang super canggih, sampai orang bisa dengan sukarela kasihin uangnya ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Waktu kami masih \"kerja\" bareng, dia ngajarin aku banyak sekali kiat-kiat bersilat lidah sama orang. Dan dia selalu traktir aku makan enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "Kamu melihat dia sebagai teman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Teman? Hah, jelas tidak. Cuma orang sinting yang mikir bisa \"berteman\" sama siapa pun di tempat terkutuk itu. Hubungan kami cuma ... sebatas saling kenal, dengan baik. Itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "Dia pun hanya baik padaku karena ingin pamer. Bawa-bawa anak buah ke mana-mana itu kan kesannya keren, kayak orang penting gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Tapi memang dia baik sih sama aku. Dan sekarang ini aku jatuhnya balas budi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Baiklah ... ini bayarannya, Nona Jahoda. Terima kasih atas bantuannya untuk Adventurers' Guild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#Ini bagianmu, {NICKNAME}. Makasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Nah, aku sudah harus balik ke Curatorium. Kalau Bos perlu sesuatu dan aku enggak ada, matilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(Aku sudah janji enggak bakal panggil dokter. Tapi kalau beliin obat tahan sakit boleh dong?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Aku minta tolong Bos deh. Pasti dia ada koneksi. Sejelek-jeleknya, gajiku bulan ini hangus ... atau dipotong setengah ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Iya, gitu saja deh. Besok kasihin obatnya ke Ihanti ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
