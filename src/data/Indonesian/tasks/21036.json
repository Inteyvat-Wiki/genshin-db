			"dialogs": [
				{
					"id": 210360401,
					"content": "Waduh, susah juga ya ternyata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Maaf, aku terlihat konyol sekali tadi. Sepertinya masih belum banyak perkembangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "Masih banyak yang harus dipelajari. Pengembara, terima kasih. Ini imbalan untukmu, mohon diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Kamu mau pergi dari Liyue pakai cara apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Hmm ... Rencananya sih ikut perahu pedagang itu, jadi lewat jalur air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "Untuk perhentian pertama ... Aku ingin ke Fontaine. Tinggal di sana selama beberapa waktu sambil buat rencana lagi untuk setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "Aduh, aku juga tidak tahu Que'er bakal mau tidak ikut denganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
