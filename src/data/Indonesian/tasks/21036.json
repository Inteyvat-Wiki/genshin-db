				},
				{
					"id": 210360702,
					"content": "Maaf, aku konyol sekali tadi. Aku tidak sangka akan gugup dan tegang saat bertarung sungguhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
