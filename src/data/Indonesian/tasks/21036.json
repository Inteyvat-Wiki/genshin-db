			"dialogs": [
				{
					"id": 210360501,
					"content": "*huff* *huff* Kenapa kamu bisa cepat sekali larinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360502,
					"content": "Kamunya saja yang lelet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "Aku ... kalah ... telak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360506,
					"content": "Terima kasih sudah memberikan contoh untukku, Pengembara. Ini buat kamu, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360507,
					"content": "Tentang Que'er ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "Que'er ... Aduh, dia masih mengabaikanku. Aku harus gimana lagi biar dia luluh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360509,
					"content": "Aih ... Kenapa masalahnya jadi runyam begini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360510,
					"content": "Tentang petualang itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "Oh, dia? Aku bertemu dengannya di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360512,
					"content": "Dia bilang kalau dia sudah mengambil misi ke Chasm. Waktu dengar aku mau ke Chasm, dia langsung ajak aku ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360513,
					"content": "Tapi sebagai gantinya ... Aku harus membantunya menyelesaikan misi. Kebanyakan cuma disuruh cari barang saja sih, tidak ada yang sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360514,
					"content": "Tapi dia ... bawel sekali, aku tidak kuat menghadapi orang seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360504,
					"content": "Kamu masih harus banyak latihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "Be-Benar sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				}
			]
