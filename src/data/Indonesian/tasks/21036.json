			"dialogs": [
				{
					"id": 210360301,
					"content": "Melintasi alam liar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Bagus sekali, petualang itu juga sudah bantu buatkan rute latihan ... Ah, aku bisa latihan di sini juga semuanya berkat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Dia bilang aku cuma harus sampai di tujuan secepat mungkin ... Tapi, aku selalu kurang cepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Jadi, tolong contohkan bagaimana caranya melintasi alam liar dengan cepat. Aku akan berusaha mengikutimu dari belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Mohon bantuannya. Yuk, kita ke tempat latihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Awas ketinggalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "Uhh ... A-Aku akan berusaha. Tapi, kecepatan kakiku masih ada batasnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
