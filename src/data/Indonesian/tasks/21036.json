			"dialogs": [
				{
					"id": 210360201,
					"content": "Lawan musuh yuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Baik! Aku sudah lama ingin coba jurus pedang yang kupelajari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Aku khawatir kamu tidak bisa membaca gerakanku dengan jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "I-Ilmu bela dirimu setinggi itu ya? Hahaha, kalau begitu, mohon gerakannya diperlambat, sedikit saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Di dekat sini ada tempat berkumpul para monster. Ayo, kita ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
