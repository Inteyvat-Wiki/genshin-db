			"dialogs": [
				{
					"id": 210360101,
					"content": "Pengembara, kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Masih latihan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Iya. Tapi ... latihannya lumayan berat. Aku tidak tahu apa karena aku lemah atau cara latihannya yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Sudahlah, jangan dibahas. Jurus yang kamu gunakan saat kita bertarung bersama terakhir kali sangat menginspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "Pengembara, hari ini tolong temani aku latihan lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "Latihannya masih sama seperti yang lalu, \"bertempur melawan musuh\" atau \"melintasi alam liar\". Kamu mau yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Que'er masih cuekin kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "EHEM, Que'er bilang belakangan ini dia ada urusan di kota dan masih belum pulang sampai sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Aku sudah beberapa kali pergi cari dia. Tapi dia malah minta Zhiruo mengusirku. Sampai sekarang masih belum mau ketemu denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "Aduh, harus dibujuk pakai cara apa lagi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
