					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360602,
					"content": "Masih latihan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "Iya. Tapi ... latihannya lumayan berat. Aku tidak tahu apa karena aku lemah atau cara latihannya yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360608,
					"content": "Sudahlah, jangan dibahas. Jurus yang kamu gunakan saat kita bertarung bersama terakhir kali sangat menginspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360609,
					"content": "Pengembara, hari ini tolong temani aku latihan lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360610,
					"content": "Kamu sudah pernah latihan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "Untungnya aku tidak sengaja ketemu seorang petualang yang baik hati. Dia pakai \"untuk menyelesaikan misi bersama-sama\" sebagai alasan untuk membawaku masuk sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360614,
					"content": "Lalu dia juga bantu aku bikin rencana latihan, kasih masukan ... Sebagai gantinya, aku harus bantu dia bereskan segala macam misi dari Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360615,
					"content": "Ah, langsung ke intinya dulu deh, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360616,
					"content": "Begini, aku sekarang punya rencana latihan. Latihan bertempur melawan musuh dan latihan melintasi alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360617,
					"content": "Pengembara, kalau sekarang kamu ada waktu tidak untuk temani aku latihan? Mau pilih yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360611,
					"content": "Hebat juga bisa latihan di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "Ah, aku jadi malu. Kudengar area ini berbahaya dan banyak monsternya, jadi rasanya cocok dijadikan tempat latihan. Tapi ternyata, mau masuk saja tidak segampang itu urusannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360604,
					"content": "Que'er masih cuekin kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "EHEM, Que'er bilang belakangan ini dia ada urusan di kota dan masih belum pulang sampai sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360606,
					"content": "Aku sudah beberapa kali pergi cari dia. Tapi dia malah minta Zhiruo mengusirku. Sampai sekarang masih belum mau ketemu denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360607,
					"content": "Aduh, harus dibujuk pakai cara apa lagi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
