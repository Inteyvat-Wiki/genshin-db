			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "Ternyata kalian. Aku masih ingat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020202,
					"content": "Aku sedang membersihkan makhluk-makhluk yang ternodai aura jahat. Sepertinya aku telah menimbulkan masalah untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020203,
					"content": "(Huh. Dia biasanya tidak sesopan ini, apa yang sebenarnya terjadi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020204,
					"content": "Tapi kamu kan sedang melakukan pengusiran setan, kenapa kamu mengatakan bahwa kamu telah menimbulkan masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020205,
					"content": "Itu karena perubahan yang terjadi pada monster ini berasal dariku. Atau lebih tepatnya, dari karma yang telah kudapatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020206,
					"content": "Perubahan, karma... Jangan-jangan...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020207,
					"content": "Seperti yang buku itu tuliskan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Ya, Paimon ingat, Xiao mempunyai julukan \"Vigilant Yaksha\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020210,
					"content": "Jadi... Itu artinya... Aww...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020211,
					"content": "Oh, Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020212,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020213,
					"content": "Kami sudah membaca kisahmu di buku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "Oh, maksudmu buku literatur yang dibuat oleh orang-orang ratusan tahun lalu itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020216,
					"content": "Tidak ada yang kekal di dunia ini, dan semua makhluk mengalami penderitaan. Kami para yaksha tidak memerlukan rasa simpati dan air mata dari siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020217,
					"content": "Rekan-rekanku yang telah meninggal akan merasa malu bila membaca isi buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020218,
					"content": "Oh, uh... Paimon minta maaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020219,
					"content": "Tidak masalah. Aku akan membersihkan gua yang diselimuti aura pekat iblis, jadi kita lebih baik berpisah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020220,
					"content": "Tu, tunggu! Bawalah kami bersamamu! Kami akan membantumu, Paimon janji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020221,
					"content": "Tidak perlu! Aku sudah terbiasa bertarung sendirian. Ditambah lagi, perubahan monster-monster itu adalah tanggung jawabku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020222,
					"content": "Kalau begitu... Oh! Anggap saja ini sebagai permintaan maaf dari Paimon karena telah bersikap tidak sopan tadi! ...Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020223,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020224,
					"content": "... Ikutlah denganku",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020214,
					"content": "Kami baru saja membaca buku berjudul Yaksha: Adeptus Pelindung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "Xiao adalah yaksha terakhir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
