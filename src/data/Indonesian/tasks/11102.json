			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "Tempat ini membuat Paimon merinding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020402,
					"content": "Aku akan menggunakan ritual yang dikenal sebagai Bane of All Evil untuk melepaskan tempat ini dari karmanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020403,
					"content": "Tetaplah tenang dalam segala situasi, dan jangan membiarkan dirimu terpengaruhi oleh pikiran jahat iblis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "Untunglah kita datang ke sini. beberapa makhluk telah jatuh dalam pengaruh iblis. Seandainya saja kita terlambat, tentu saja hal ini akan menjadi lebih rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020602,
					"content": "Sekarang. \"Starnatcher\" yang kamu bicarakan ini. Sebenarnya apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020603,
					"content": "Ohh, biar Paimon beri tahu kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020604,
					"content": "Adeptus yang mengabulkan permintaan... Tak kusangka orang-orang begitu mudah tertipu oleh kebohongan seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020605,
					"content": "Sebagai seorang Adeptus, apa kamu memiliki kemampuan untuk mengabulkan permintaan, Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020606,
					"content": "Orang-orang di Liyue dulunya tidak pernah meminta apa-apa dari kami para Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020607,
					"content": "Ribuan tahun lalu, para leluhur Liyue tidak meminta apa-apa selain kekuatan untuk melindungi tanah yang mereka sebut rumah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020608,
					"content": "Ehh... sejujurnya, seorang Adeptus yang bisa mengabulkan permintaan orang-orang mungkin lebih menarik di mata mereka sekarang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020609,
					"content": "Tidak peduli betapa lemahnya orang-orang saat ini, itu bukan urusanku. Aku hanya mengikuti keputusan yang sudah dibuat oleh Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020610,
					"content": "Ups... Sepertinya Paimon salah bicara lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020611,
					"content": "Oh, satu hal lagi! Adeptus palsu itu mempunyai Simbol Seribu Izin. Itulah yang dia gunakan untuk mengusir para iblis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020612,
					"content": "Benarkah? betapa bodohnya. Mengusir tanpa melenyapkannya, tidak heran kalau mereka akan berkumpul di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020613,
					"content": "Jika ini terus berlanjut, segala sesuatunya mungkin bahkan akan menjadi di luar kendaliku... Kita harus segera mengambil Simbol Seribu Izin itu darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020614,
					"content": "Hah. Apa kita hanya akan mengambilnya saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "Tepat seperti yang Paimon pikirkan! Paimon setuju, kita harus memberikan pelajaran kepada penipu itu karena telah mencoba untuk menipu kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020617,
					"content": "Dan dengan adanya Xiao di sini, tidak mungkin Starsnatcher akan berani mengaku-ngaku kalau dirinya adalah seorang Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020618,
					"content": "Aku hanya membunuh iblis, dan aku tidak membunuh manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020619,
					"content": "...Memang siapa yang bilang akan membunuh dia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020620,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020621,
					"content": "Akan sangat baik bagi Liyue kalau kita dapat meyakinkannya untuk menghentikan perbuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020622,
					"content": "Aku mempunyai sebuah kemampuan bernama Dream Trawler. Digunakan untuk memisahkan jiwa dari raga, sehingga dapat melatih diri di luar raga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020623,
					"content": "Tapi bisa juga digunakan untuk memanggil roh orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020624,
					"content": "Wah, itu baru kekuatan Adeptus yang sebenarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020625,
					"content": "Seperti mimpi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "Aku butuh melakukan sebuah ritual untuk menggunakan ilmu ini. Tolong bantu aku cari... pembakar dupa, tujuh lampu, dan sesuatu yang dapat menurunkan temperatur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020628,
					"content": "Menurunkan temperatur... Oh, Mist Flower juga bisa digunakan kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020629,
					"content": "Tapi pembakar dupa dan tujuh lampu... Hmm... Sepertinya itu bukan benda-benda yang bisa kita temukan begitu saja di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020630,
					"content": "Apakah kamu tahu dua patung yaksha di sebelah jalan pedagang di bagian selatan Mt. Tianheng?",
