			"dialogs": [
				{
					"id": 401450101,
					"content": "Setelah beberapa waktu, toko jadi ramai ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*huff* Kita kebanjiran pelanggan nih. Kerja enggak berhenti-berhenti, Paimon mulai puyeng ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Bisnis kita laku keras ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Kita dapat banyak pesanan. Paimon enggak yakin kita berdua bisa ngeberesin semuanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Mungkin kita harus sewa orang buat bantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Hai manis, lagi istirahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Aku tadi baru lihat data penjualan, sepertinya kalian berdua bakat bisnis ya. Ramuannya laku keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Oh, Lisa! Waktunya pas banget! Kami lagi ngomongin soal sewa orang buat bantuin toko nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Oh? Pesanannya numpuk banget ya? Terus kalian kesulitan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Iya, kita kebanjiran pesanan! Paimon enggak sangka kita bakal dibanjiri pelanggan gini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Yah, jujur aku sih tidak heran dengan kesuksesan ini. Toh aku memang sudah antisipasi bakal gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "Jadi di saat kalian berdua sibuk dengan tokonya, aku diskusi dengan Freda supaya bisa menangani bisnis ini dengan lebih efisien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Setelah mengamati kondisi bisnis kalian, aku melihat masih banyak yang bisa kita tingkatkan dari segi meracik, budi daya, dan aspek penjualan bisnis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Tunggu, jadi kamu diam-diam mengawasi dari belakang layar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon pikir kamu betulan cuma malas-malasan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Hei, aku ini juga cukup bisa diandalkan loh di saat-saat kritis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Jadi gimana kita mengaplikasikan peningkatan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Yah, jadi setelah diskusi dengan Freda, kami sudah punya rencana sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Coba kamu cari Freda buat tahu detailnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "Toko kita jadi cukup tenar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
