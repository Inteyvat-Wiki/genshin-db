					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740101,
					"content": "Batu Kuno ... *huff* Sekian tahun aku kerja di Chasm, aku bahkan belum lihat satu pun. Huishan Hall mikir apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Harusnya mereka coba kerjakan sendiri, biar tahu apa yang namanya tidak mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "Muning~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Oh, kalian. Kenapa masih keluyuran di atas Chasm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "Eh, jangan salah paham. Aku bukan malas lihat kalian kok, aku cuma ... bingung. Kalian bukannya masih ada banyak urusan penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "Apa sih! Kami lihat kamu cemberut, jadi baik-baik mau nengok! Malah bawel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "*huff* Pernah dengar tentang Batu Kuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "Itu sejenis batu langka — sangat langka sampai mungkin tidak ada di dalam tambang. Sekian tahun aku berada di Chasm, aku baru lihat dua atau tiga biji saja. Batu itu benar-benar cantik dan indah di luar bayangan kita semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "Katanya kalau bisa lihat dalamnya Batu Kuno yang paling bagus, ada berkas cahaya setipis rambut, dan warna batunya mirip dengan cakrawala laut di sore hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "Batu ginian maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "Ah. Hebat, kamu ternyata punya! Dan kualitasnya juga bukan main-main, salah satu yang paling bagus yang pernah aku lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#{NICKNAME}, mau tidak jual ke aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "Jelas tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "Iya! Ini hadiah dari seorang teman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Lagian, Paimon ragu kamu punya duit sebanyak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Yah, ada pembeli yang berminat sih. Uang bukan masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "Pembeli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Iya. Ada orang kuat di Huishan Hall yang berminat meneliti Batu Kuno. Mereka minta aku cari sampel di Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Tapi aku kan sibuk sama pekerjaan tidak pen— Maksudku, aku tidak ada waktu karena sibuk kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#Kita buat kesepakatan deh, {NICKNAME}. Kalau kamu dapat Batu Kuno, kasih ke aku. Hadiah dari Huishan Hall-nya boleh buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "Kualitasnya tidak usah sama dengan yang kamu punya sekarang. Yang penting itu asli Batu Kuno saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "Hadiah dari Huishan Hall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Biasanya, aku akan menangani pekerjaan seperti ini sendiri, tapi belakangan aku sibuk sekali dengan berbagai urusan di Chasm, jadi tolong bantu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "*huff* Aku tidak tahu mereka butuh berapa. Bagaimana kalau kamu cari tiga biji dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "Iya, iya, sudah tahu, enggak usah diulang-ulang terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Tidak usah halu kau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "Kena masalah apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
