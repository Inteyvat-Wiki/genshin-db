					"speakerTitle": "Muning"
				},
				{
					"id": 710740212,
					"content": "Jadi maksudnya kamu butuh batu yang warnanya cantik, gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740213,
					"content": "Tidak segampang itu. Batunya tidak boleh asal batu saja, tapi harus batu yang \"itu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740214,
					"content": "#Lalu ... Gini deh, mau bantu aku cari batu yang sesuai deskripsi tadi tidak, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740215,
					"content": "Cari dan bawa ke sini, aku beli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740216,
					"content": "Lah? Paimon enggak yakin kamu punya duit sebanyak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740217
					],
