					"id": 710740301,
					"content": "Sudah dapat belum Batu Kuno-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740302
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740302,
					"content": "Sudah, nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107404,
			"completionStepIds": [
				7107403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107403",
							"2"
						],
						"stepId": 7107403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "Ini benar Batu Kuno. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "Sepertinya keputusanku minta tolong padamu sudah benar. Kalau aku minta tolong ke Adventurers' Guild pasti bakal lebih lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "Hmm ... siapa yang tahu. Mungkin juga Adventurers' Guild bakal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "Kasih misinya ke kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "Mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "Petualang ... Hmm, dulu aku sempat iri sama mereka yang bisa bertualang ke gunung tinggi dan reruntuhan gelap. Seakan-akan tidak ada tempat yang bisa buat mereka gentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "Aku sih malah sebaliknya — aku sudah bekerja di sini bertahun-tahun tapi tidak pernah mengunjungi Cinnabar Cliff yang ada di puncak Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "Hah? Sekali pun belum pernah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "Yah, Cinnabar Cliff itu kan tempat yang sohor untuk para pelancong. Orang lokal sih jarang ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "Mungkin karena jaraknya dekat, aku jadi pikir bisa ke sana kapan saja kalau senggang. Sayangnya, \"senggang\" itu cuma wacana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "Kita pergi sekarang yuk! Mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "Kadang perlu juga bertindak seenaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "Tidak usah lah, terima kasih. Aku masih ada kerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "Dan lagi, berkeliaran dan berkelana itu kan lebih cocok buat para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "Petualang selalu berkelana ke tempat berbahaya. Aku pasti bakal luka berat kalau ikut-ikutan, dan kurasa itu lebih baik dihindari saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "Masuk akal sih. Parah juga kalau sampai luka-luka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "Kalau aku cedera, nanti tidak ada yang mengawasi regu penjelajahan di bawah sana dan tidak ada yang urus keselamatan para penambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "Kalau sampai kejadian, bisa jadi petaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "Oh kamu takutnya ke arah sana ... Paimon kira kamu cuma takut luka terus sakit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "Tebing teramat tinggi di dekat Chasm, gua-gua tidak berujung ... dan sisa-sisa medan tempur kuno peninggalan Rex Lapis, semuanya penuh marabahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "Aku sih tidak berminat sama sekali buat bertualang ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "Ini, hadiah untuk tiga Batu Kuno tadi. Huishan Hall mau lebih banyak, jadi kalau kamu dapat lagi, kasih ke aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "Tentunya bakal ada imbalan menanti. Pokoknya bawa sini saja kalau kamu dapat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
