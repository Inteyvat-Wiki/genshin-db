			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740801,
					"content": "Sekarang total ada sembilan, sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740802,
					"content": "Kalian bisa kasih apa yang Huishan Hall mau dengan sangat cepat! Pantas mereka begitu memuji kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740803,
					"content": "Gampang, cuma membalikkan telapak kaki doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740804,
					"content": "\"Telapak tangan\". Dih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "Bukan! Maksud Paimon ... ini gampang, cuma kayak jalan kaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740806,
					"content": "Wuih, Paimon akhirnya bisa berkelit. Mesti dirayain nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "Haha, omongan Paimon tidak salah kok. Semua orang menyaksikan bagaimana kamu melawan monster laut. Jelas urusan seperti ini mudah saja buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740808,
					"content": "Memang mudah sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "Kerja di Bagian Urusan Sipil, katanya. Tetap saja disuruh yang aneh-aneh macam \"cari Batu Kuno di Chasm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740811,
					"content": "Oh iya, tadi kan kamu bilang kamu sering debat sama Ayahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740812,
					"content": "Terus gimana ceritanya kamu jadi kerja ke Bagian Urusan Sipil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740813,
					"content": "Kan aku sudah cerita kalau utangku banyak? Waktu itu tidak ada yang bantu, dan aku juga tidak mau pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740814,
					"content": "Akhirnya, ada penagih utang yang cari Ayahku ke Shenglu Hall. Aku sudah kira dia bakal patahkan kakiku setelah dengar tentang semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740815,
					"content": "Tapi kakimu masih utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740816,
					"content": "Iya ... Malu sih memang, tapi dia malah melunasi semua utangku lalu ketemu denganku, yang sudah macam anjing kampung menggembel di jalanan. Dia bilang begini \"Sekarang aku yang pegang semua surat utangmu. Dan kamu harus BAYAR\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740817,
					"content": "Dengan demikian dia berhasil paksa aku kerja ... buat cicil utang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740818,
					"content": "Jadi sekarang kamu terlilit utang ... sama Ayah sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740819,
					"content": "Yah, begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740820,
					"content": "Dulu, aku tidur saja tidak bisa. Dikejar-kejar pasukan penagih utang ... aku bersumpah mau hidup dengan benar kalau diberi kesempatan kedua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740821,
					"content": "Aku sama sekali tidak sangka kalau kesempatan itu datangnya dari Ayah, yang sampai saat itu selalu beda pendapat denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740822,
					"content": "Dia tidak berdebat seperti biasanya. Kami malah bicara dari hati ke hati, dan aku ingat sempat bertanya \"kenapa tidak dari dulu sih begini?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740823,
					"content": "Tapi, seandainya dia terbuka untuk diajak bicara, mungkin akunya yang tidak terbuka untuk mendengarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740824,
					"content": "Kedengarannya Ayahmu masih sayang sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740825,
					"content": "Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740826,
					"content": "Jadi kerjaan ini harus kutuntaskan, apa pun yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740827,
					"content": "Baik soal insiden di Chasm, maupun soal permintaan Batu Kuno-nya Huishan Hall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740828,
					"content": "Heh, yang kerja keras itu aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "Bisa dapat orang buat menuntaskan pekerjaan kan sama saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740830,
					"content": "Yah, intinya terima kasih karena membantu melancarkan pekerjaan ini, bahkan bisa sampai tuntas lebih cepat dari perkiraan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740831,
					"content": "Nah, gitu dong. Paimon suka dengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740809,
					"content": "Tidak juga, tantangannya beda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
}