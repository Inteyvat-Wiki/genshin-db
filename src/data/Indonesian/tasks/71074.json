					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740502
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740502,
					"content": "Sudah, nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107406,
			"completionStepIds": [
				7107405
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Tiga lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "Aku dengan resmi menerima Batu Kuno sumbangan \"dua orang warga sipil yang bersemangat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "Tak kusangka kalian bisa temukan batunya secepat ini, dan kualitasnya juga lebih bagus dari yang sebelum-sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "Aku jadi ingat sama punyaku dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "Kamu punya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "Terus kenapa kamu suruh kami cari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "\"Dulu\" ya, tolong. Aku PERNAH punya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "Ayahku dulu pernah urus kiriman batu ke Shenglu Hall. Ada sisa pecahan kecil Batu Kuno yang kualitasnya kurang, jadi dia kasih ke aku buat mainan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "Waktu itu aku setiap hari debat sama Ayah. Aku pengangguran, sehari-hari buang waktu di Yanshang Teahouse sampai banyak utang dan putus asa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Kurang bagus tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Yah, semua juga pernah muda dan bodoh kan? Lanjut. Kemudian, waktu aku sedang putus asa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Ada yang lihat Batu Kuno punyaku dan kasih harga yang bagus. Aku senang sekali, batu itu bisa jadi uang, yang bisa kupakai buat membereskan masalah. Cukup adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Tapi suatu hari, Ayah tanya: \"Muning, mana batu yang dulu ayah kasih ke kamu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "Dan aku cuma jawab: \"Batu doang. Sudah entah di mana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Aku memang bilang begitu, tapi aku jadi kepikiran ... Gimana jadinya kalau waktu itu aku tidak jual batunya, dan bisa kasih lihat Ayah waktu dia tanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "Sudahlah. Percuma saja dipikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "Setidaknya si \"anak yang hilang\" sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "Benar ... Tapi perjalanan untuk membayar semua utangku masih panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Baiklah. Tolong bawa lagi ke sini kalau kalian dapat batu lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "Memangnya belum cukup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Hmm ... tiga lagi deh. Tiga lagi cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Batu Kuno itu barang langka. Kalau Huishan Hall mau lebih banyak, aku ragu di Chasm ini masih ada lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "Memangnya perlu berapa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Lah, kasihin punya kamu sendiri dulu dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
