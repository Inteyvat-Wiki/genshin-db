				]
			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "Onikabuto adalah teman! Seperti anjing dan kucing adalah teman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "\"Bunga Cantik Tapi Mencekam\""
				},
				{
					"id": 716663002,
					"content": "Anak kecil lagi? Duh, tempo hari bukannya sudah pernah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Eh, Grandmaster Hanakado juga anak kecil woi. Anak-anak yang dulu itu juga ada yang jago banget mainnya. Adu kumbang enggak kenal umur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Meskipun, eh ... Bunga Cantik Tapi Mencekam belum pernah main adu kumbang sebelumnya, tapi Onikabuto pilihannya punya hawa-hawa pendekar sakti mandraguna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716663005,
					"content": "Aku bingung maksudnya apa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "\"Bunga Cantik Tapi Mencekam\""
				},
				{
					"id": 716663006,
					"content": "Onikabuto-ku itu hadiah dari Papa. Dapat dari temannya waktu pergi ke luar kota dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "\"Bunga Cantik Tapi Mencekam\""
				},
				{
					"id": 716663007,
					"content": "WOW, bapakmu kok kayaknya ahli banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Oke. Kita utus Lavender Melon Pembelah Langit dan Bumi untuk yang satu ini. Biar enggak dituduh melakukan penindasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Heh. Kamu ngomongnya kayak Paimon itu yang paling lemah saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Tapi memang paling benar Paimon dulu yang maju sih ... soalnya kalian berdua bisa sinting dan membahayakan orang lain kalau sudah enggak mau kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Nona kecil jangan tegang yah! Kita main ini, tujuannya buat seru-seruan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
