			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Walah-lah ... Paimon nyaris keok tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "AKU yang nyaris jantungan! Gila, si kecil itu sadis juga. Aku juga belum tentu kuat lama tuh lawan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Kok bisa-bisanya kamu sejago ini, padahal enggak punya guru? Apa jangan-jangan semua orang di Liyue itu bakat jadi pendekar???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "Oh, gini toh caranya main Onikabuto bareng-bareng. Sip deh, paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "\"Bunga Cantik Tapi Mencekam\""
				},
				{
					"id": 716663105,
					"content": "Mau main lagi enggak nih? Aku juga ingin nonton kalian main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "\"Bunga Cantik Tapi Mencekam\""
				},
				{
					"id": 716663106,
					"content": "Si Bunga Cantik Tapi Mencekam ini bakat loh main ... beneran mencekam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Bapak Gembala, coba kalau kamu bakat kayak dia ya! Pasti sekarang sudah paham cara komunikasi sama makhluk bercangkang, apalagi habis dengerin si Guoba ngobrol sama si Badai Sukma Pulau Kristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Hahahaha ... ha. MAUNYA sih gitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
