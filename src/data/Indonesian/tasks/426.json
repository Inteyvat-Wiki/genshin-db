			"dialogs": [
				{
					"id": 4260101,
					"content": "Kita duduk istirahat sebentar yuk, apa rencanamu sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "Kurasa ini waktunya mengerjakan quest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "Quest, mudah saja! Tekan tanda seru di pojok kiri atas layar untuk melihat semua quest yang kamu pernah terima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "Beberapa quest cukup sulit, kalau levelmu belum cukup tinggi, kamu mungkin tidak akan bisa menyelesaikannya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "Ada lagi yang mau kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "Aku ingin berkeliling dan lihat-lihat di sekitar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Beberapa daerah lebih berbahaya dari daerah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "Sebaiknya kamu berlatih di tempat yang cocok dengan kekuatanmu, agar kamu bisa terus bertambah kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Elfie dari Adventurers' Guild mengetahui segala tentang daratan Teyvat seperti telapak tangannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "Dia tinggal di pusat perdagangan Mondstadt, tidak jauh dari gerbang kota. Kamu bisa diskusi dengannya daerah mana yang cocok denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "Aku rasa aku kurang kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "Um, kamu pastinya memerlukan senjata dan artefak langka untuk bertambah kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "Kudengar biasanya bisa ditemukan di dalam dungeon, tapi dungeon berbahaya. Kalau mau pergi, harus hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "Tapi kalau kamu takut, kamu juga bisa langsung beli di toko di pusat perdagangan Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "Selain itu, senjata dan artefak dapat diuraikan~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "Tapi untuk detilnya, kamu harus coba otak-atik sendiri nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "Oh ya, levelmu juga sangat penting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260118,
					"content": "Tidak ada apa-apa, yuk pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "Oke~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
