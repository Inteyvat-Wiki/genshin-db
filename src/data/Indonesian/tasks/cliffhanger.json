			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Teh Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015201,
					"content": "Pendekar muda itu benar-benar hebat kungfunya. Dia tidak sempat mengayunkan pedang dan melangkah mundur dengan tetap menggenggam gagang pedangnya. Walaupun terhuyung mundur dua langkah, dia masih sempat melempar tiga senjata rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015202
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015202,
					"content": "Musuh di hadapannya yang pedangnya terlempar jatuh kemudian bangun dan mengeluarkan sebilah pedang dari pinggangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015203
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015203,
					"content": "Melihat sang pendekar melangkah mundur, senyuman licik terulas di wajah musuh itu. Dia terus menyerang sang pendekar sampai tersudut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015204
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015204,
					"content": "Terdengar suara pedang yang saling beradu dan pendekar muda yang sudah kelelahan terus melangkah mundur. Tiba-tiba pedangnya terdorong ke samping, lalu sebuah kepalan tinju lantas menghantam dadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015205
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015205,
					"content": "Pendekar muda tersebut mundur beberapa langkah dan pedangnya pun terlontar jatuh. Senyuman puas tersungging di bibir musuh, dia mengangkat pedangnya tinggi-tinggi dan berniat menghabisi nyawa sang pendekar muda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015206
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015206,
					"content": "Saat itu juga sang pendekar mendongakkan kepalanya sambil tertawa, \"Bagus, bagus. Inilah alasan kekalahanmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Teh Liu Su"
				}
			]
		},
