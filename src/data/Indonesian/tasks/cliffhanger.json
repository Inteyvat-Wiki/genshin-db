				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Teh Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Oh, kamu masih di sini! Hahaha. Bagaimana menurutmu, ceritaku tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010402,
					"content": "Lalu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "\"Amarah Haishan\" dan \"Suara Hujan Pedang\" adalah dua karya yang sangat panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010404,
					"content": "Aku tidak mau menghabiskan waktu berjam-jam untuk menceritakan sisa ceritanya untukmu. Kalau kamu tertarik, datang saja ke sesi berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010407,
					"content": "Terima kasih atas bantuanmu. Ambillah ini, aku tunggu kedatanganmu di sesi berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010405,
					"content": "Aku pikir kamu akan mengatakan, \"Semuanya akan terungkap di chapter selanjutnya...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "Hahaha... Kamu harus sering datang kalau kamu ingin mendengar chapter seterusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Master Teh Liu Su"
				}
			]
		},
