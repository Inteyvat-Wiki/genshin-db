				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Teh Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Gawat, aku bicara sampai mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Ah, halo! Kamu datang untuk mendengar cerita, atau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010104,
					"content": "Aku? Aku adalah seorang pendongeng. Aku melakukannya untuk menghasilkan sedikit uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010105,
					"content": "Masalahnya adalah, cerita yang kubaca terlalu banyak dan rumit. Saking banyaknya, aku sampai lupa dan bingung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010106,
					"content": "Beberapa hari yang lalu, ada sekelompok pelanggan yang berteriak ingin mendengar cerita \"Amarah Haishan\" dari Crux Fleet, sedangkan kelompok lainnya terus berteriak ingin mendengar cerita \"Suara Hujan Pedang\" dari Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010107,
					"content": "Aku harus mencari nafkah, bukan? Jadi aku memilih bagian yang paling kuingat dari setiap cerita untuk memuaskan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010108,
					"content": "Tidak disangka mereka menyukainya lalu memintaku meneruskan ceritanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010109,
					"content": "Karena dua buku ini sudah pernah kuceritakan bertahun-tahun yang lalu, aku menghabiskan banyak waktu untuk mencarinya kembali. Aku sudah membaca ulang untuk mengingatnya lagi, dan sekarang sudah siap untuk meneruskan ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010110,
					"content": "Tapi aku lupa harus meneruskan cerita dari mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010111,
					"content": "Apa kamu bisa membantuku bertanya kepada orang-orang di luar, apakah mereka masih ingat aku bercerita sampai mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010112,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Kamu benar-benar penyelamat hidupku. Kalau aku yang bertanya, karirku sebagai pendongeng akan berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010118,
					"content": "Aku sudah memikirkannya dengan baik. Ada tiga orang yang bisa kamu tanyai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010119,
					"content": "Yang pertama adalah <color=#00E1FFFF>Gentry Maocai</color>. Dia tidak pernah ketinggalan ceritaku. Yang kedua adalah <color=#00E1FFFF>Fan Er'ye</color>, pemilik kedai teh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010120,
					"content": "Yang ketiga adalah Nona <color=#00E1FFFF>Jiangzhou</color>. Aku melihatnya berhenti sebentar kemudian mendengar cerita, namun tak berapa lama kemudian dia pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010114,
					"content": "Kenapa kamu tidak memulai ceritanya dari awal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Aku juga berkeinginan serupa, ditambah lagi aku bisa mendapat penghasilan dua kali lipat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010116,
					"content": "Tapi aku merasa Fan Er'ye tidak akan membiarkanku melakukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010117,
					"content": "Apakah kamu bisa membantuku bertanya kepada orang-orang? Beri tahu aku jawaban mereka agar aku tahu dari mana harus melanjutkan ceritanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Master Teh Liu Su"
				}
			]
		},
		{
			"id": 2230102,
