	"talks": [
		{
			"id": 2230101,
			"completionStepIds": [
				2230101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
