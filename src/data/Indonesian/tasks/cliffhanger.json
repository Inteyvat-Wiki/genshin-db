			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Teh Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015101,
					"content": "Pendekar muda Klan Guhua tersebut mengayunkan pedangnya secepat angin, seperti tetesan hujan yang menjatuhi danau. Kilatan pedangnya membuat setiap orang terkagum-kagum, namun juga bergidik ngeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015102
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015102,
					"content": "Dalam sekali tebasan, pedang musuh terpental jatuh ke tanah. Namun tentu saja musuh tidak rela dikalahkan begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015103
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015103,
					"content": "Sebelum pendekar muda tersebut sempat bersiap, musuh memanfaatkan kesempatan dan melempar senjata rahasia dari tangannya. Dengan sekali ayunan tangan, tiga kilatan senjata rahasia terbang menuju kepala anak muda tersebut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015104
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223015104,
					"content": "Apa yang membuat musuh itu bertindak begitu kejam? Lebih penting lagi, apa yang akan terjadi pada anak muda itu? Dan bagaimana nasib Klan Guhua selanjutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Teh Liu Su"
				}
			]
		},
		{
			"id": 2230152,
			"completionStepIds": [
				2230152
			],
			"beginWay": "TALK_BEGIN_MANUAL",
