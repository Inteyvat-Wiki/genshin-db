					"Master Teh Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "Kamu kembali juga. Terima kasih atas kerja kerasmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010202,
					"content": "Semakin banyak buku yang kuceritakan, semakin banyak hal yang akan kulupakan. Aku juga tidak bisa berbuat apa-apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Master Teh Liu Su"
				},
				{
					"id": 223010203,
					"content": "Jadi apa kamu sudah menanyakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Teh Liu Su"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
