						223011103
					]
				},
				{
					"id": 223011103,
					"content": "Si tua Liu? Ceritanya sangat menarik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011104
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011104,
					"content": "Aku pernah mendengar ceritanya sekali. Saat itu ia menceritakan tentang <color=#00E1FFFF>Amarah Haishan</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011105
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011105,
					"content": "Dia memulai cerita dengan Crux Fleet yang tetap menempuh perjalanan di tengah badai besar, di mana angin menderu kencang dengan ombak besar serta petir yang menggelegar.",
