				{
					"id": 223011707,
					"content": "Aku terlalu telat, saat aku tiba di sana, bagian awal sudah selesai di ceritakan. Ceritanya sepertinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011708,
					"content": "Sepertinya di akhir cerita dia menceritakan tokoh utama yang awalnya hampir menang, namun tiba-tiba diserang dan hampir kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011709,
					"content": "Saat itu aku dipanggil untuk kembali bekerja dan tidak tahu kelanjutannya lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangzhou"
				}
			]
