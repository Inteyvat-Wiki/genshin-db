			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#{NICKNAME} dan Paimon? Ada apa? Ada misi super seru yang perlu bantuan mekanik jenius ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Hehe, kita saling kenal, aku kasih diskon 20% deh! Tapi kalian harus kasih aku camilan ... Ssst, jangan bilang-bilang ke Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Kalian datang ke tempat yang tepat. Bengkel Aino isinya semua berkilau, keren, dan mengkilap! Enggak ada lagi yang lebih bagus dari di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Tapi hati-hati ya, jangan sampai kesandung atau injak komponen apa gitu pas lagi jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Robot yang ini ... lucu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Hehe, iya dong. Namanya \"Knuckle Duckle\", awalnya aku rancang dia buat ngerapiin sampah dan besi rongsokan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Tapi terus aku bikinnya terlalu kuat, dan terlalu gesit pula. Jadi ya, daripada mubazir, kenapa enggak sekalian dikasih pertahanan yang super kuat juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Jadi, kalau misal ada orang enggak jelas berani masuk ke bengkel ini, JLEGER! Bakal dibikin ringsek dalam sekejap sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Ide Aino masih saja liar kayak biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Mumpung ada kesempatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "A-aku? Barengan si Knuckle Duckle? Biasanya orang-orang cuma minat sama penemuanku, jarang ada yang mau foto-foto ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Tapi kalau kalian memang mau mengabadikan keseharian si mekanik jenius dan robotnya yang paling keren sejagat raya pakai Kamera ... ya silakan, silakan saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Tapi ... aku jarang banget foto, jadi enggak tahu juga mesti pose kayak apa. Duh, gimana kalau fotonya jelek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Biasa saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Oke deh, kalau gitu aku serahkan padamu ya! Ingat, si Knuckle Duckle juga harus sama kerennya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Kan yang motretnya aku, jadi itu sih urusanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Boleh foto-foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Dia juga \"anak buah\"-nya Aino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
