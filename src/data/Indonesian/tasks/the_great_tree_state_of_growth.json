			"dialogs": [
				{
					"id": 230290401,
					"content": "Bagaimana? Keseluruhan Pohon Suci sudah kalian rekam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290402,
					"content": "Sudah dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "Oke, coba kulihat dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290404,
					"content": "Hebat ... Sudut bidiknya sangat bagus, rekamannya juga jelas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290405,
					"content": "Ini imbalan untukmu. Terima kasih atas bantuannya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290406,
					"content": "Batangnya tidak masalah ... kontur ranting di sekitarnya juga tidak berubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290407,
					"content": "Sisanya tinggal tunggu Ladep dan Pharez selesai mengumpulkan datanya, lalu kami bisa lanjut ke subjek berikutnya ....",
