			"dialogs": [
				{
					"id": 230290101,
					"content": "Sudah waktunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Apa kamu masih meneliti akar Pohon Suci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "Pengembara, kamu selalu datang di saat yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Terima kasih atas bantuanmu sebelumnya, kondisi Pohon Suci baik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Sesudah kudiskusikan dengan Ladep, kondisi baik seperti ini bisa berlangsung lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Akhirnya kami bisa mengerjakan persiapan skripsi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Lihat, \"Kamera\" yang kupinjam dari Pharez ini. Akan kugunakan benda ini untuk merekam kondisi Pohon Suci itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "Pengembara, tolong bantu aku merekam keseluruhan Pohon Suci di tempat lain. Lokasinya sudah aku tandai di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Kenapa kamu tidak pergi sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Emm, di sana ... di sana ... tempatnya terlalu tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Aku ketakutan setiap kali berada di ketinggian .... Selalu ada perasaan aku ... atau skripsiku hilang tertiup angin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "Biasanya Pharez yang merekamnya di sana, tapi hari ini kelihatannya dia ada urusan lain. Jadi aku cuma bisa minta pertolonganmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
