					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Sekarang setelah kupikir lagi... apa kamu kenal dengan Sisi? Dia sering berdiam di sekitar pelabuhan, menunggu seorang pelaut bernama Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160802,
					"content": "Dia sepertinya selalu setia menunggu pemuda itu... pastinya ada kisah di antara mereka berdua, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160803,
					"content": "Tolong bantu aku untuk memeriksanya, jika kamu menemukan cerita yang menarik, kembalilah dan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
