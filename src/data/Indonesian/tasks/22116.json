			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi, ka-kamu sudah pulang, aku baru saja belajar memasak hidangan baru ini, ayo kembali bersamaku, akan kumasakkan untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Sisi, aku baru saja pulang, aku sungguh letih, aku hanya ingin istirahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Oh, benar, kamu pasti letih, sebaiknya beristirahat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Kalau begitu... setelah kamu beristirahat, kita berbincang ya? Kita juga bisa menetapkan tanggal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Ya, baiklah, aku ingat, aku hanya masih belum memikirkannya. Bukannya aku tidak bertanggung jawab, tapi aku tidak mau mengecewakanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "*huff* Aku ini seorang pelaut, Sisi, kamu berhak mendapatkan yang lebih baik dariku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Chaoxi, kamu jangan berkata begitu, aku mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
