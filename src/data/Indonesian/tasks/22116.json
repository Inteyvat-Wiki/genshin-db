				"points": []
			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "Aku benar-benar tidak tahu harus mulai dari mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160102,
					"content": "Kamu sedang melakukan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Oh, ternyata kamu. Aku sedang menulis novel baru, tapi bagaimanapun aku mencobanya, rasanya seperti ada yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160104,
					"content": "Aku sudah berpikir lama, tapi tidak ada ide sedikit pun, jika terus begini kapan aku bisa mulai menulis dengan benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160105,
					"content": "Ah betul juga, aku tahu kamu seorang pengembara. Menurutmu, apa yang paling dibutuhkan agar sebuah novel bisa sukses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
