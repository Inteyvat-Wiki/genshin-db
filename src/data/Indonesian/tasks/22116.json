			"dialogs": [
				{
					"id": 221161801,
					"content": "Bagaimana? Apa sudah ada hasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161802,
					"content": "Aku sudah mencatat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Wah, tapi mereka hanyalah anak-anak yang masih polos. Mungkin harus tunggu sampai mereka dewasa baru ada rasa \"romansa\" di antara mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161804,
					"content": "Tapi aku simpan dulu saja. Ini juga bisa dibilang sebuah plot cerita. Walaupun tidak bisa dijadikan cerita romansa, tapi masih bisa dijadikan referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161805,
					"content": "Oh ya, ini imbalan untukmu. Terima kasih telah membantuku mencari bahan cerita. Aku akan memikirkan baik-baik bagaimana cara menulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
