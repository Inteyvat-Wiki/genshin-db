					"content": "Bagaimana? Apa sudah ada hasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161302
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161302,
					"content": "Aku sudah mencatat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "Bagus, coba kulihat, hmm... Zhihua dan Qiming! Sudah kuduga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161304,
					"content": "Hmm... bagus, bagus, ini bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161305,
					"content": "Benarkah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "Ka-kamu tidak bisa melihatnya? Kamu tidak merasakannya? Perhatikan baik-baik, apakah pemahaman yang diam-diam ini sulit di pandangan orang luar sepertimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161307,
					"content": "Ini bagus, kurasa aku sudah mulai bisa membuat plot ceritanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221161308,
					"content": "Oh iya, terimalah hadiah ini, terima kasih atas bantuanmu. Sekarang aku harus memikirkan bagaimana menulisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
