			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Pertempuran berdarah yang dahsyat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Pertempuran... pertempuran ya. Hm... sedikit masuk akal, setidaknya ini menarik perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160303,
					"content": "Tapi, aku hampir tidak dapat menemukan inspirasi tentang topik itu di Desa Qingce... tidak ada pertempuran apa pun di sini, apalagi yang dahsyat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160304,
					"content": "Sepertinya aku harus mencari banyak bahan. Oh benar juga! Kudengar... ada banyak petualangan di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160305,
					"content": "Karena banyak harta karun di luar sana, mereka pergi untuk mencarinya, bertemu dengan monster dan bertarung melawan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160306,
					"content": "Aku tahu sebuah tempat dengan banyak monster, monster di sana juga bukan monster biasa... mereka cukup hebat. Baiklah, ayo kita pergi ke sana dan menunggu petualang muncul, lalu menyaksikan pertempurannya secara langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160307,
					"content": "Lalu, hehe, aku akan mendapatkan bahan yang kubutuhkan. Baiklah, tempat ini agak jauh... ayo cepat kita pergi, cepatlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
