				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "Terakhir kali aku pergi ke kota, aku melihat seorang pemuda berbicara kepada seorang gadis yang sepertinya adalah seorang peramal. Tapi aku tidak mendengar secara detail pada waktu itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160702,
					"content": "Lalu belakangan aku mengetahui bahwa nama dari pemuda itu adalah Zhihua dan nama peramal itu adalah Qiming, kamu bisa membantuku menanyakan mereka, jika kamu menemukan cerita yang menarik, kembalilah dan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
