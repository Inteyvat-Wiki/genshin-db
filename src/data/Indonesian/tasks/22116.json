					]
				},
				{
					"id": 221161703,
					"content": "Bagus sekali, coba kulihat... Hmm, ada yang tidak beres dengan Chaoxi, bagaimanapun juga, ada yang salah dengan kedua orang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
