			"dialogs": [
				{
					"id": 221160901,
					"content": "Apa kamu masih ingat ketiga anak kecil yang sering bermain di pelabuhan? Meng, Lulu, Fei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160902
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160902,
					"content": "Walaupun mereka anak-anak, tapi di antara mereka pasti ada yang mempunyai banyak kisah untuk diceritakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160903,
					"content": "Tolong bantu aku memeriksanya, jika kamu menemukan cerita yang menarik, kembalilah dan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
