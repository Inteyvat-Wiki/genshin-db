			"dialogs": [
				{
					"id": 221161001,
					"content": "Halo, Qiming, hari ini aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Hari ini tidak baik untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161003,
					"content": "Ah? Tapi aku belum berkata apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161004,
					"content": "Tidak perlu bicara apa-apa, aku sudah tahu kamu ingin bicara apa, hari ini tidak baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161005,
					"content": "Ah lalu kapan hari baiknya, ataukah kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161006,
					"content": "Oh, jangan khawatir. Harinya akan tiba. Hari itu akan menjadi hari yang sangat baik nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161007,
					"content": "Itu sama saja dengan tidak ada artinya sama sekali! Qiming, tolong dengarkan aku sebentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161008,
					"content": "Baiklah, selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161009,
					"content": "Aku belum mengatakan apa-apa! Lalu, bahkan sekarang ini tidak ada antrian sama sekali?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
