			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Hei... ini hebat sekali, sekarang aku bisa bilang bahwa aku sudah pernah mengalami pertempuran yang dahsyat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160502,
					"content": "Kupikir kamu hanya ingin melihat dari jauh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Iya sih, awalnya memang begitu, tapi petualang yang kutunggu-tunggu tidak muncul juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160504,
					"content": "Lalu aku menyadari bahwa para monster itu mulai bergerak, jika mereka semua pergi, ini akan menjadi perjalanan yang sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160505,
					"content": "Lalu aku... melempar batu ke arah mereka, bukankah di novel selalu seperti itu, melempar batu atau semacamnya untuk menarik perhatian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160506,
					"content": "Si-siapa yang tahu bahwa batunya akan mengenai kepala salah satu dari mereka? Lalu... ya sisanya kamu tahu sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160507,
					"content": "Ah, sudahlah, semua sudah terjadi. Walaupun aku sedikit terluka, tapi aku mendapatkan bahan yang kuinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160508,
					"content": "Sekarang aku merasa ide-ide mengalir padaku! Oh iya, ini untukmu, terima kasih karena telah membantuku, ambil ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221160509,
					"content": "Kurasa aku bisa langsung menulis sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
