			"dialogs": [
				{
					"id": 221161201,
					"content": "Lulu, sekarang giliran Fei untuk menjadi kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 221161202,
					"content": "Benar, aku sudah mengatakannya berkali-kali, kenapa aku harus selalu jadi pelayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 221161203,
					"content": "Tapi kupikir akan lebih menyenangkan bagi kita semua ketika Meng jadi kaptennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 221161204,
					"content": "Lulu, kamu jangan bilang begitu, kurasa Fei juga bermain dengan baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 221161205,
					"content": "Betul sekali, kamu sebagai kapten, aku pedagang kaya raya, Fei bisa menjadi pelayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 221161206,
					"content": "Kali ini, pasti akan menjadi permainan yang paling menyenangkan, betul kan Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu, kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 221161208,
					"content": "Jika Lulu berkata begitu, ba-baiklah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 221161209,
					"content": "Fei, kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 221161210,
					"content": "Tidak apa-apa! Tidak masalah, asalkan Lulu senang tidak apa-apa, ayo kita main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 221161211,
					"content": "Hanya main sebagai kapten saja, aku tidak begitu peduli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 221161212,
					"content": "Kalian, ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
