			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "Hai, dari penampilanmu ... kamu pasti Pengembara, kan? Elegan sekali ya sampai bisa berkunjung ke tempat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "Atau kamu juga pemancing yang tertarik dengan perairan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "Pilihan bagus! Tempat ini memang tempat terbaik untuk memancing di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "Tapi sepertinya enggak ada orang yang memancing di sini? Kok kamu yakin banget?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "Tentu saja karena aku melihat hal yang tidak mereka lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "Aku kan ahli memancing, jadi aku punya standar dalam memilih tempat pemancingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "Be ... benarkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Tapi ikanmu sepertinya enggak banyak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "Kalau begitu, aku akan perlihatkan \"Pemandangan Kail Tiada Duanya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "Pemandangan Kail ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Berikan bahan khusus padaku, lalu aku akan buat umpan sendiri, dan aku akan pancing \"ikan\" yang belum pernah kalian lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Kok kedengarannya agak meragukan? Apa umpan buatanmu memang sehebat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "Tidak ada salahnya dicoba, kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "Bagus, aku senang berteman dengan orang sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "Umpan buatanku selain berbahan dasar Sunsettia dan Wheat, ada bahan hebat lainnya lagi loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "Tiada Duanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
