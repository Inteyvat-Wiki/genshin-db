					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "Sesuai dengan perasaanku, hari ini ... Zaytun Peach saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "Walaupun sering ditemukan, tapi cuma tidak banyak orang yang membuatnya jadi bahan umpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
