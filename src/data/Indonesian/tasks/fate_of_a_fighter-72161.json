				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "*hmph* memalukan sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Jelas-jelas kami sudah menolongmu, kamu malah bikin kami malu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Dia sedang membicarakan dirinya sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "Tidak disangka, aku diselamatkan oleh orang asing, orang lain pasti akan kembali merendahkanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Hmm... ngomong-ngomong, Tuan Samurai, kamu baik-baik saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "Sepertinya dia baik-baik saja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "Aku berutang budi pada kalian, orang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "Oh ya, pukulanmu tadi lumayan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#Namaku {NICKNAME}, senang bisa kenal denganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "Jangan terlalu meremehkanku, pendatang asing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "...Inaba Tousaburou Kyuuzou, panggil saja aku Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "Siapa orang-orang itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Bajak laut, banyak dari mereka memiliki benteng di Pantai Nazuchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "Pencuri yang kabur, penambang dan nelayan yang kehilangan bisnis utama mereka, buron yang lari dari \"Dekrit Perburuan Vision\" atau pemberontak dari kedua pihak perang, kadang berkumpul menjadi bandit... upaya sia-sia untuk melarikan diri dari Yang Mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "\"Perantau\" atau \"Kairagi\", mereka tetap saja sekelompok pelanggar hukum... kami sudah mengejar mereka beberapa waktu, sampai pemberontak menghancurkan kota-kota di pulau itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "Pengungsi dari Tatarasuna dan penambangan melarikan diri satu per satu, beberapa melarikan diri ke sini, menambah kekuatan para bajak laut, dan mereka jadi semakin liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "Kelompok bajak laut baru saja datang dari perkemahan di selatan, mereka mengincar muatan di kapal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Sayang sekali ya aku berhasil menggagalkan rencana mereka, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "Ini bukan kapalmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Kapal ini? Awalnya ini kapal pemberontak Sangonomiya. Aku juga tidak begitu tahu... saat aku datang ke sini, sudah tidak ada seorang pun di kapal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "Lalu aku tinggal di sini, bertahan hidup seperti kumang pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Sudah lama aku tidak banyak bicara begini, melelahkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "Omong-omong, jika kamu bersedia membantuku... Setelah aku pulih dari cedera, aku akan membalas utang budiku padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "Perkemahan bajak laut di sekitar yang kusebutkan tadi, tolong bantu aku membereskan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "Dengan begitu, para bajak laut ini tidak akan terus menggangguku seperti segerombolan anjing liar. Mungkin kamu juga bisa membereskan kemah bajak laut lainnya agar tidak menyerang kapal yang sudah rusak ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "Kalau begitu biarkan aku melihat kemampuanmu lagi, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Mudah sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Hmph, sepertinya kamu suka omong besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "Oh ya, orang asing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "Jangan sombong dulu. Salah langkah sedikit saja kakimu bisa patah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Aku akan kembali secepatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Kenapa kamu bisa terkepung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Sepertinya harga dirinya terluka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Ini keangkuhan unik seorang samurai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
