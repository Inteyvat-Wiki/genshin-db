			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "Orang asing, bagaimana kabarmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Maaf, di sini bukan tempat bagus untuk menjamu tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "Tapi... aku sangat senang kamu datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Kamu terlihat jauh lebih baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Terima kasih. Lagi-lagi, aku berutang budi padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Haha, sayang sekali aku masih bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "Bukannya ini hal baik. Apa yang disayangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Apa rencanamu selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Aku belum tahu apa yang harus dilakukan selanjutnya, tapi mungkin aku tidak akan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Meskipun Kujou Masahito tidak jelek juga sih, orang tuanya memanggil agar menangkap para pemberontak dan menghukum mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Jangan sampai aku harus berhadapan dengan pedangnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Mungkin aku akan melepas zirah ini, hidup sendiri seperti ini juga baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Hari yang damai sekalipun tak bisa membuatku menipu diri sendiri, bayang-bayang kenangan selalu mengingatkanku bahwa aku tetaplah seorang prajurit yang terluka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "Ah... Pokoknya, siapa sih yang tahu masa depan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Tapi, aku tidak pernah mempertanyakan semua keputusan Yang Mulia, jadi jika aku pergi, tidak akan ada penyesalan bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Uhh... Omongannya tiba-tiba jadi berat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ah, ngomong-ngomong... Sudah waktunya bagiku untuk menemui teman seperjuanganku, yang masih bersamaku di pulau ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Tradisi Inazuma adalah memperlihatkan \"Dendrobium\", bunga yang mempesona... Simbol nasib para prajurit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Sekalian jika kamu bertemu kawan seperjuanganku selama perjalanan, silakan mampir dan berkenalan dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Kamu tidak berpikir untuk kembali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
