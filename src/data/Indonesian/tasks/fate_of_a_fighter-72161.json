					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Haha, omong kosong saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Habisi dulu mereka, baru kamu bisa bicara begitu padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
