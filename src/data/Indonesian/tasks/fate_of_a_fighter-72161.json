			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Akan memakan waktu lama untuk menumbuk obat tanaman herbal menjadi seperti pasta, kamu boleh pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
