			"dialogs": [
				{
					"id": 721610301,
					"content": "Kamu sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610302,
					"content": "Sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Wow... tiba-tiba hawanya jadi aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "Maaf telah meminta orang asing sepertimu melakukan pekerjaan kotor semacam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610306,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "Ramuannya sudah habis digunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610310,
					"content": "Obat oles yang dulu kugunakan sudah hampir habis, tapi cederaku masih belum hilang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610311,
					"content": "Tapi... tidak perlu khawatir, aku bisa menahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610312,
					"content": "Urus saja urusanmu sendiri, pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610313,
					"content": "Seperti anak-anak saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610315,
					"content": "Kamu bilang apa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610316,
					"content": "Paimon bilang kamu, seperti anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Jelas situasinya sangat buruk, kamu hampir menangis loh, tapi masih pura-pura kuat... Itu kan enggak jujur namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Cuma anak-anak yang begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "Dan Tuan Kyuuzou, kamu jangan lupa——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "Kamu berutang budi pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Hmph... Apa boleh buat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610323,
					"content": "Kalau begitu tolong bantu aku mencari Naku Weed. Naku Weed bisa ditemukan di mana saja di pulau ini. Kalau bisa yang daunnya tebal, sarinya lebih mudah diperas dan dioleskan ke luka untuk mengurangi peradangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610324,
					"content": "Baiklah. Biarkan aku tidur sebentar, jangan ganggu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610321,
					"content": "Kami datang untuk menolong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Apakah cederamu sudah membaik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Seharusnya sementara waktu bisa tenang deh sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
