					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611302,
					"content": "Kalau kamu turis, kamu datang ke tempat yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611303,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "Apa, kamu orang Shogunate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611305,
					"content": "Bukan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "Kalau begitu jangan ikut campur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611307,
					"content": "Bedebah ini, sungguh menyebalkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "Aku dari Shogunate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "Hmm, dasar orang asing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611310,
					"content": "Menjilat Komisaris sambil mengharapkan sisa-sisa makanan seperti anjing, tapi bersikap sangat angkuh di hadapan para samurai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611311,
					"content": "Mencari tahu ke sana kemari, berbuat jahat di mana-mana... Sekarang datang ke perahu rusak ini, entah apa maumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611312,
					"content": "Sayang sekali, aku hanya seorang prajurit yang terluka, tidak punya apa-apa untuk menjamumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611313,
					"content": "Jadi sebaiknya silakan kamu pergi meninggalkan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611314,
					"content": "Orang ini enggak bisa diajak bicara baik-baik ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Hei! Kalian berisik sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611316,
					"content": "Aku mau beri tahu kalian sebelum pergi: Jangan tinggal terlalu lama di Pulau Yashiori, pulau ini sudah dikutuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611317,
					"content": "Kutukan..?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "Kamu tidak dengar? Pulau ini sudah dikutuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611319,
					"content": "Perang yang stagnan, hasrat para petinggi, keputusasaan orang-orang kecil, kebencian pada korban yang tidak bersalah, bau potion yang memenuhi ruangan ketika para orang tua meninggal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611320,
					"content": "Intinya adalah kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611321,
					"content": "Tinggalkan tempat ini sebelum kamu dihancurkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Hmm... Paimon tidak mengerti sama sekali, orang ini aneh banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
