					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "Kenapa kamu muncul lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611402,
					"content": "Bukannya sudah kubilang... ah, sudahlah. Terserah kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "Jangan mengacaukan barangku, persediaan di kapal sudah cukup buatmu. Pergilah kalau sudah puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "Apa kamu perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "Tidak perlu. Apa kamu tidak lihat kalau aku baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "Tapi cederamu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "Luka ini urusanku, bukan kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "Hei, kami ini nanya baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Aku juga menjawab dengan baik: Jangan ganggu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "Aku bisa membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "Bagaimana cara membantuku, menyerahkanku ke Shogunate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "Haha, jangan bodoh kamu... aku bisa dianggap memberontak. Tuan Kujo tidak berbelas kasihan pada pemberontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "Jika kamu sungguh ingin membantuku, tinggalkan aku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611414,
					"content": "Wah, orang ini keras kepala banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
