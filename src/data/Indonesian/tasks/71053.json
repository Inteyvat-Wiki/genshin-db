			"dialogs": [
				{
					"id": 710501401,
					"content": "Ayo kita bicara serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Selama beberapa hari ini kamu sudah sangat membantu, aku tidak tahu bagaimana cara berterima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Mengingat kolaborasi kita yang begitu luar biasa, rasanya tidak cukup kalau cuma memberimu uang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Yah, kalau kamu memang maksa sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Jangan bercanda! Masa aku sekurang ajar itu sih cuma kasih kamu uang saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Itu seperti menghinamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Nih, ambil surat ini. Kalau suatu hari kamu ada di Sumeru dan perlu pertolongan, atau kebetulan kena masalah, Bawa saja surat itu ke Klan Purbiruni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Kami pasti bakal bantu kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "\"Hubungan antar manusia lebih mahal daripada emas dan harta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501410,
					"content": "Ah aku jadi teringat dengan pepatah Sumeru itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		}
