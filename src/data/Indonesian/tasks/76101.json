						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}, bukannya Nikita itu kakek yang kasih kita misi buat nyari Lentera Sumbu Perak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
