					"content": "Bukannya dia bilang dia hanya Ratnik biasa ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ah, dasar Pak Tua ... memang suka sekali iseng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Kita bahas nanti saja. Sekarang, kita lapor situasinya dulu.",
					"roleType": "TALK_ROLE_NPC",
