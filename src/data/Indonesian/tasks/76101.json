			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hehe, kami sudah datang nih! Wah, ramai banget ya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Selama ini, kalian semua sudah bekerja keras. Sekarang akhirnya kita punya waktu untuk berkumpul bersama setelah keadaan sudah tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Kamu juga sudah bekerja keras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "Aku hanya menjalankan tugasku. Lagi pula, kalau tidak ada bantuan dari kalian, kurasa hasilnya mungkin berbeda. Mungkin tetap menang perang, tapi korbannya pasti lebih banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Ayolah, kami kan anggota timmu! Jangan bicara kayak sama orang asing begitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Iya, kamu benar. Ah, sepertinya Pak Tua sudah mau mulai bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "Para pejuang, saudara-saudari sekalian, kita berkumpul bersama hari ini bukan untuk perayaan semata. Tapi juga untuk memperingati kemenangan yang kita raih dengan penuh perjuangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Jangan lupa kepada mereka yang sudah berkorban demi kemenangan ini, mereka yang sudah menepati sumpah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Selama perang, tim penyelidik \"Nightmare Orioles\" yang dipimpin oleh Illuga, mengemban tanggung jawab yang paling berat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#Terutama {NICKNAME} dan Paimon, yang membantu tanpa ragu di saat-saat sulit ini, dan memainkan peran yang sangat penting dalam rencananya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "Mereka tidak takut berkorban, berani menghadapi tantangan, dan membuka jalan menuju kemenangan untuk kita yang sedang dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "Upaya mereka, dan semua orang yang berjuang demi masa depan, akan selamanya terukir dalam sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Ya, kita telah menang! Kemenangan yang dibayar dengan pengorbanan ... kita boleh menangis, berduka ... tapi kita tidak boleh patah semangat karenanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "Karena \"masa depan\" yang kita perjuangkan akan segera tiba. Demi meneruskan api semangat mereka yang berkorban, demi menerangi jalan menuju masa depan, kita harus terus maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Khusus hari ini, mari kita bersulang untuk kemenangan, untuk pejuang berani yang tidak akan pernah dilupakan, dan juga untuk masa depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
