					{
						"sceneId": 3,
						"position": [
							5610.782,
							375.311,
							9961.593
						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "Pintu menuju langit iblis sudah terbuka. Kalian kira kuuvahki lemah ini bisa mengalahkanku?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011302,
					"content": "Tapi ... kenapa aku masih terjebak di sini? Ah, aku mengerti ... Gilingan Sampo itu menolakku lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011303,
					"content": "Lihat siapa yang datang! Seorang tamu yang langka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011304,
					"content": "... Siapa di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011305,
					"content": "Ini ... ah, ternyata kamu, Relya. Syukurlah, aku tahu kamu pasti masih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011306,
					"content": "Sekarang, kekuatan Gilingan Sampo sudah menjadi milikku! Kamu yang mengalir darahnya penerus kudus pasti bisa melakukannya. Lagi pula, kamu adalah murid yang paling kukagumi, berbeda dengan tiga yang tak berguna itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011307,
					"content": "Hah, dia benar-benar kira aku nih Relya ... Ironis banget, pikiran pertapa gila yang dulunya pandai berbicara dan licik kini menjadi begitu kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011308,
					"content": "Jangan ragu, Relya. Kamu lupa impian kita? Kamu tidak mau mendapatkan kembali status dan identitas yang seharusnya menjadi milikmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011309,
					"content": "Bayangkan saja, sebuah utopia bagi mereka yang dikucilkan dan dihina. Tempat di mana para peri bangsawan itu akan tunduk di hadapanmu. Dan di istana Bintang Pucat ini, hanya akulah satu-satunya sesama manusia yang bisa mewujudkan visimu itu.,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011310,
					"content": "Kini, hanya sisa selangkah lagi, aku bisa menaiki tangga menuju bintang-bintang ... saat Utopia tiba, hanya orang-orang terpilih seperti kamu dan aku yang akan bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011311,
					"content": "Saat itulah, semua kekotoran akan hilang, bukankah itu dunia yang kamu inginkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011312,
					"content": "Tidak, itu bukan dunia yang dia inginkan ... di saat seperti ini, kamu masih mencoba trik konyol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011313,
					"content": "Kamu memanfaatkannya dari awal, semua kebohongan itu cuma untuk mendapatkan Gilingan Sampo, \"Utopia\" yang kamu bicarakan itu hanya milikmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011314,
					"content": "Bahkan dia kehilangan jabatannya sampai menjadi pencuri juga karena jebakan yang kamu buat bersama Adipati Agung Alvis, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011315,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "\"Sang Profesor\""
				},
				{
					"id": 761011316,
					"content": "Kamu memang salah mengenal orang, tapi aku yang mewarisi identitasnya juga tidak akan menolak nama Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011317,
					"content": "Dengan nama Reed Miller, Rauthvangi, pertapa gila, \"Profesor\" dan iblis abadi ... biarkan aku yang mengakhiri cerita ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011318,
					"content": "Kita berhasil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011319,
					"content": "Akhirnya kita berhasil mengubur iblis abadi itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011320,
					"content": "\"Kalau ular abadi itu bangkit dua kali, ia harus dikalahkan tiga kali ... Hingga terkubur sepenuhnya oleh para pahlawan dari dunia di bawah rembulan ....\"\\nBersama Ratnik yang gagah dan pemberani, akhirnya kalian mengalahkan \"Profesor\" ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "Sampai beberapa hari setelahnya, kamu tinggal di Kota Piramida ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
