			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "Pak Tua, kami sudah balik nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Syukurlah kalian sudah kembali. Bagaimana keadaan di Tebing Kipumaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Kamu menjelaskan situasinya secara singkat ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Sudah kuduga ... dari sini bisa lihat Pilar Embla sudah sepenuhnya dikendalikan oleh Abyss ... oleh iblis abadi yang dijuluki \"Profesor\" itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Tapi sekarang sepertinya mereka belum ada gerakan. Mungkin karena Nona Alia sedang berusaha keras melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Kesempatan yang dia perjuangkan ... tidak boleh disia-siakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Untunglah ada bantuan Flins dan lainnya, persiapannya sudah hampir selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Dengan Spiralblade yang kalian bawa kembali, \"Panah Terpikeraunas\"-nya akhirnya sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Eh ... \"Panah Terpikeraunas\" itu apa? Apa sehebat Lentera Sumbu Perak dan Spiralblade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, lebih hebat lagi bahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Lima ratus tahun yang lalu, kekuatan Penempa Obor tidak cukup, jadi hanya bisa menyegel iblis abadi itu di bawah Tebing Kipumaki. Tapi, Penempa Obor dan Pelantun Rembulan pertama tidak mudah menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Untuk mengakhiri iblis abadi itu suatu hari nanti, mereka ciptakan busur dan anak panah ini dengan teknologi kuno. Sejak itu, kami para Lightkeeper terus menjaganya hingga hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Kini saatnya panah dan busur ini menyelesaikan misinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Whoa ... ternyata sehebat itu ya, Paimon jadi penasaran ... bentuknya kayak gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Haha, kalian sudah pernah lihat kok. Lebih tepatnya, kita sedang berada di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "Ja-jangan bilang kita bakal diluncurin dari sini ... enggak mungkin, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Aula anggur gandum ini dibangun di sekitar Panah Terpikeraunas, dan Spiralblade yang kalian bawa adalah bagian mata panah yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Pasang Spiralblade-nya di sini, lalu Panah Terpikeraunas-nya akan siap ditembakkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Tapi ini bukannya tungku api?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Iya memang, tapi sekaligus mesin khusus yang mengubah Spiralblade-nya jadi mata anak panah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Sebelum \"Telur Bencana\" itu menetas ... kita harus hancurkan sepenuhnya dengan \"busur\" ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Iblis abadi itu pasti akan memberontak selama persiapan tembak. Tapi berapa pun musuh yang muncul, kami pasti akan menghalaunya untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Kami serahkan tugas penembakan Panah Terpikeraunas-nya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "Aku juga ditembakkan bersama anak panahnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Jadi {NICKNAME} itu senjata rahasia kita ... kalian pasti lagi bercanda kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
