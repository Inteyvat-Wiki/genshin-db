			},
			"dialogs": [
				{
					"id": 411230901,
					"content": "Bagaimana situasinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230902,
					"content": "Springvale sudah aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "Baguslah kalau begitu... aku masih belum bisa mendapatkan bala bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230904,
					"content": "Terima kasih banyak ya, kamu sangat membantu sekali. Terima lah ini sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
