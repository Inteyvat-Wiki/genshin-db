			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timid Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "Ah? Kenapa kamu datang lagi, apa yang kamu lakukan dari tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230802,
					"content": "Mengalahkan semua monster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "Mengalahkan semua... monster? Kamu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230804,
					"content": "Kamu bisa cek sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Eh... aku sih tidak berani pergi sendiri, bagaimana kalau aku diserang oleh mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230806,
					"content": "Ya sudahlah, aku percaya saja padamu. Aku harus segera melaporkan ini kepada para Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230807,
					"content": "Kalau kamu benar-benar sudah membasmi semua monster itu, para Knights of Favonius pasti ada cara untuk memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		},
