			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "Halo, Pengembara. Di situasi sekarang ini, sebisa mungkin jangan keluar dari kota ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Kamu juga pasti sudah melihat meteorit-meteorit yang berjatuhan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "Entah kenapa meteorit-meteorit ini sepertinya menjadi lebih banyak belakangan ini. Keadaan di luar sana menjadi semakin berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "Urusan di dalam kota semakin lama semakin banyak, Knights of Favonius pun sudah kewalahan. Apalagi kita menemukan jejak Treasure Hoarder di sekitar kota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Orang-orang itu... rela melakukan apa saja demi uang. Aku hanya takut mereka akan memanfaatkan kesempatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "Kalau boleh, apakah kamu mau membantuku mengusir para Treasure Hoarder itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "Sebenarnya ini adalah tugas Knights of Favonius, tetapi sekarang kami benar-benar kekurangan orang. Hanya kamu yang bisa kumintai tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Tolong bantuanmu ya! Aku minta maaf karena harus merepotkanmu saat situasi sedang kacau begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "Treasure Hoarder tidak takut meteorit ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Heh, mereka tidak takut apa pun asalkan mereka bisa mendapatkan uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "Tolong bantuanmu ya! Aku minta maaf karena harus merepotkanmu saat situasi sedang kacau begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
