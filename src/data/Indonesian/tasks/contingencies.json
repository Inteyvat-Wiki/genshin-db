			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "Aaaah! Jangan, jangan mendekat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230402,
					"content": "Eh? Kamu bukan monster... Si, siapa kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230403,
					"content": "Tentang monster di sekitar sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "Monster di sekitar sini? Bukankah sudah sangat jelas? Aku pun baru saja berhasil kabur dari monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230405,
					"content": "Di sana, ada monster-monster yang sedang bergerombol di sana. Nampaknya mereka akan segera menyerang ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230406,
					"content": "Untung saja lariku cepat, kalau tidak bisa-bisa aku sudah dimakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230407,
					"content": "Di mana gerombolan monster itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Dekat sekali, tepat di samping desa. Kamu hanya perlu jalan beberapa langkah saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230409,
					"content": "Lebih baik kamu pergi berlindung dulu, aku akan beristirahat dulu sejenak. Setelah ini aku akan segera pergi ke desa untuk memperingatkan para warga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
