				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Apakah kamu sudah berhasil mengusir para Treasure Hoarder itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230302,
					"content": "Sudah kuusir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "Bagus, kamu sangat membantu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230304,
					"content": "Kalau Treasure Hoarder itu sudah diberi pelajaran, seharusnya mereka sudah tidak berani macam-macam lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230305,
					"content": "Kalau sudah tidak ada apa-apa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Ah, mohon tunggu sebentar... Sebenarnya aku masih membutuhkan bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230307,
					"content": "Sejujurnya, Knights of Favonius menerima banyak sekali laporan tentang monster yang abnormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230308,
					"content": "Laporan-laporan ini menyebutkan kalau para monster juga terkena dampak dari meteorit. Mereka menjadi lebih ganas sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230309,
					"content": "Pertahanan kota Mondstadt masih cukup kuat, tidak perlu khawatir. Yang kucemaskan adalah ada sebuah meteorit yang jatuh tepat di dekat Springvale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230310,
					"content": "Di area Springvale memang ada banyak pemburu, dan kita juga sudah mengirim banyak Knight ke sana. Tetapi medan di sana membuat tempat itu sulit untuk dijaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230311,
					"content": "Seandainya ada monster yang berhasil menyelinap masuk ke kota... akan bahaya sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230312,
					"content": "Apakah kamu bisa membantuku untuk memeriksa monster-monster yang ada di sekitar Springvale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230313,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Kalau begitu mohon bantuanmu ya. Aku akan sesegera mungkin mengirim bala bantuan ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230315,
					"content": "Bagaimana kondisi Springvale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Sejujurnya sih... tidak terlalu bagus. Kita sudah sangat sibuk mengatasi masalah yang diakibatkan batu-batu meteorit itu, ditambah lagi kita harus menghadang monster dan para Treasure Hoarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230317,
					"content": "Terlalu melelahkan kalau harus melakukan semua hal itu secara bersamaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230318,
					"content": "Kalau begitu mohon bantuanmu untuk hal ini. Aku akan sesegera mungkin mengirim bala bantuan ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
