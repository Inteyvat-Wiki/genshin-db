			"dialogs": [
				{
					"id": 110240301,
					"content": "Aku ingin tinggal di sini untuk sementara. Di waktu mendatang, kesempatan untuk mengenang seperti ini akan semakin berkurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Dewa Garam cukup menyedihkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Di Perang Archon, cara menilai yang baik dan buruk berbeda dengan cara penilaian yang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Tentu saja aku yang sekarang... Aku berharap dia bisa hidup di tempat yang suasananya lebih hangat dan tidak sekeras zaman dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Bukankah benda peninggalan tersebut akan meningkatkan kekuatan Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Walaupun bejana garam dan penggaris garam masih kuat, mereka tidak berarti apa-apa bagi Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Jika suatu hari tiba saat di mana dia bangkit dan kekuatannya pulih... Aku pastikan dia akan mengalami kekalahan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Apa yang akan kamu lakukan sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Pertanyaan yang bagus. Aku yang dulu mungkin akan memberimu jawaban yang spesifik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Tapi sekarang... Ya, aku akan melanjutkan peranku sebagai konsultan di Wangsheng Funeral Parlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Tetapi jika menurutmu perjalanan ini menyenangkan, bagaimana kalau kamu menemaniku lagi untuk merekam sejarah Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}