			"dialogs": [
				{
					"id": 766530501,
					"content": "Hmm ... Penelitian ini masih mau dilanjutkan tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "Apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Robot Intel Sat-Set #1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Masih belum paham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Lebih tepatnya, ini adalah tempat uji coba Robot Intel Sat-Set #1 — robot penyelinap desain terbaru dari Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Belum lama ini, dia membeli robot pembersih terbengkalai dari pasar gelap, dan setelah memodifikasinya, berhasil menciptakan Robot Intel Sat-Set #1 yang sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Platform ini mensimulasikan berbagai lingkungan musuh yang berbahaya, dapat digunakan untuk menguji kemampuan menyelinap Robot Intel Sat-Set #1.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Kenapa Aino mendesain robot penyelinap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Setelah Krum-clank 70% Sweet dicuri, Aino membulatkan tekadnya. \"Mau musuhnya sekuat apa juga, teman kita harus ditolong!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Dia kemudian dengan cepat menyelesaikan desain Robot Intel Sat-Set #1, lalu memulai penelitian dan pengembangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "Seperti yang diharapkan, setelah penelitian dan pengembangan selesai, pasti akan dapat dengan mudah menyelinap ke Biro Desain Eksperimental Kuuvahki yang dijaga ketat dan menyelamatkan rekannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Kedengarannya luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Tapi Aino segera menyadari bahwa butuh waktu lama untuk menyempurnakan rencananya, dan dia lalu mengurungkan niatnya. Dia merasa akan lebih cepat jika dia menumbangkan seluruh Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Sudah kuputuskan! Aku harus menenangkan diri dan menghadapinya perlahan, jadi aku akan terus mendorong pengembangan Robot Intel Sat-Set #1, pasti akan bisa membantu menyelamatkan teman-temanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "#Kalau begitu, mungkin {NICKNAME} dan Paimon juga bisa membantu pengujian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Menurut hasil statistik yang dikumpulkan, jika ada data yang diberikan oleh penguji lain sebagai referensi, kecepatan pengembangan Aino dapat meningkat minimal 30%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Menarik juga, Paimon ikut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Aku juga ikut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Kalau begitu, aku mewakili Aino mengucapkan terima kasih kepada kalian. Aku akan membuka akses untuk kalian, bisa langsung menggunakan platform ini jika ingin melakukan pengujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}