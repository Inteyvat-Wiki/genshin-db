			"dialogs": [
				{
					"id": 750530101,
					"content": "Ah, halo orang luar. Matamu bagus ... mau coba \"Mata Tertuju ke Hadiah Berbulu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530102,
					"content": "Latih penglihatan, dan dapatkan hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530103,
					"content": "Singkat, padat, jelas. Terlalu singkat sih, nyaris kayak belum ngomong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530104,
					"content": "Aturan detailnya nanti, kalau kalian minat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530105,
					"content": "Oke, coba deh apa aturannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Tiga Qucusaurus akan terbang mengangkasa. Perhatikan Qucusaurus yang di tengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530107,
					"content": "Waktu mereka balik lagi, <color=#00E1FFFF>kenali mana yang awalnya dari posisi tengah</color>. Beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530108,
					"content": "Ehh, jadi mereka ganti posisi pas terbang, terus kita harus cari tahu mana yang awalnya dari tengah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530109,
					"content": "Tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530110,
					"content": "Ha, pantas saja tantangan ini bisa buat latihan mata ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530111,
					"content": "Mau yang gampang dulu? Buat uji coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530112,
					"content": "Kalau aman, kita lanjut ke yang betulannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530113,
					"content": "Hadiahnya boleh diambil kalau sudah sukses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530114,
					"content": "Masih ada urusan, nanti lagi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "Baiklah, toh aku di sini terus kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530116,
					"content": "Ya cobain deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "Kalau sudah siap, langsung mainkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		},
