				},
				{
					"id": 750530303,
					"content": "Tentang \"Mata Tertuju ke Hadiah Berbulu\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "Diwariskan turun-temurun di suku, sejak zaman dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530305,
					"content": "Penglihatan yang tajam sangat penting untuk suku Bunga Bersayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530306,
					"content": "Aku penanggung jawab generasi sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530307,
					"content": "Kenapa kamu ngomongnya pelan sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "Dulu pernah cedera. Jatuh dari tempat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530309,
					"content": "Tenggorokan dan dada kena. Tidak bisa ngomong selancar dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530310,
					"content": "Tapi ... tidak separah itu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530311,
					"content": "Tenang, tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "Semoga beruntung. Sampai jumpa.",
