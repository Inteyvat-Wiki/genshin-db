			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Tadi itu adalah jiwa Halfdan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Lebih dari satu jenis kekuatan aneh ada di sini. Melihat sebuah jiwa bukanlah pemandangan yang aneh dalam situasi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Tapi, kalau kalian masih ingin terus menyelidiki ke dalam, kalian harus hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "Ya, kami akan hati-hati. Oh, tapi ... apa ini artinya Dain tidak ikut dengan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Perangkat barusan telah membuatku terluka parah, aku perlu sedikit waktu untuk memulihkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Oh gitu ... Yah sebenarnya Paimon sudah tahu dari awal, kamu terus memaksakan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "Dain, kamu harus istirahat ... Ooh, kamu bisa pergi liburan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "\"Liburan\"? Kata itu tidak ada dalam kamus hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Aku masih ada banyak urusan penting yang harus kuurus. \"Roda Takdir\" masih terus berputar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Aku curiga perangkat ini ada hubungannya dengan rencana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Aku juga akan terus mengawasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "Terima kasih atas pengertianmu, bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "Aku hanya berharap lain kali kita bertemu lagi, kamu tahu harus berdiri di pihak siapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Duuhhh! Dia sepertinya masih enggak suka ya, di akhir kalimat masih nyindir gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Yah, sayang banget sih kita tidak ketemu sama {F#kakakmu}{M#adikmu} lagi, tapi setidaknya kita jadi tahu banyak informasi berguna, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Asalkan kita terus melanjutkan jalan kita, kalian pasti bakal ketemu lagi, lalu semuanya akan kembali normal, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "Oh, Paimon hampir lupa — alasan kita sebenarnya ke sini kan buat selidiki apa yang terjadi sama para Hilichurl itu, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "Kita kayaknya sudah lihat cukup banyak dan sudah boleh lapor ke penambang itu. Tapi ... Paimon bingung harus gimana jelasinnya? Ini terlalu ribet buat dijelasin ke orang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Ah sudahlah, nanti juga kita bakal ketemu caranya — asal jangan lupa ambil komisi kita saja begitu ini selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Kita ngobrol lagi lain waktu. Setelah kamu pulih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
