			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "Gimana nih? Abyss Lector sudah hilang, tapi perangkat masih belum berhenti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Terus Halfdan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Biar aku yang menggantikannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "Tidak boleh! Selama perangkat masih aktif, kami yang menerima kutukan tidak dapat mengeluarkan kemampuan kami yang asli. Hanya kamu yang bisa melawan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Kalau kamu menghargai pengorbanannya, jangan buang waktu di sini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Apa kamu lihat semua sinar cahaya dan portal itu? Mereka pasti telah memasang perangkat energi lain di tempat lain. Cepat temukan yang lainnya! Cepatlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "Jadi kita harus ... lewati portal Abyss itu? Hei, tunggu Paimon dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "Aku tidak akan merasakan pengaruh dari efek pemurnian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
