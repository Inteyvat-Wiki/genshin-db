				"points": []
			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Awalnya kupikir dia akan hilang jadi debu dalam sekejap ... Aku tidak menyangka jiwa Halfdan ternyata sekuat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Minggir! Jangan ganggu kami lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Abyss Lector"
				},
				{
					"id": 80070103,
					"content": "Bukannya kamu punya hal lain yang lebih besar untuk dikhawatirkan? Ayo, ini adalah kesempatan besarmu untuk menyingkirkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "Dainsleif!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Abyss Lector"
				},
				{
					"id": 80070105,
					"content": "Habisi dia! Lalu matikan perangkat itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
