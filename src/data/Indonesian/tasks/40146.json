			"dialogs": [
				{
					"id": 401460101,
					"content": "Halo! Namaku Atefeh. Aku pedagang keliling dari Sumeru. Senang bertemu dengan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Wow, kamu datang jauh juga! Kayaknya berita soal toko kami sudah sampai seluruh pelosok Teyvat nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "Semua berkat kamu, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Paimon ini jenius dagang. Paimon bahkan bisa jual air ke ikan, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Haha, aku setuju! Belakangan ini memang banyak pedagang yang ngomongin soal ramuan alkimia yang kalian jual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Tapi kebanyakan orang masih belum mau ambil risiko buat barang langka begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Kalau kamu tanya aku sih, kalau ada kesempatan begini ya harus disambut dong. Begitu caranya kalau mau dapat Mora banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Meskipun orang-orang masih belum banyak tahu soal ramuan alkimia sekarang ini, tapi dengan sedikit upaya dan dengan metode penjualan yang tepat, kita bisa untung banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Kalau nanti sudah makin tenar, harganya bisa naik sampai 10 kali lipat ... Hehe, dengan untung sebanyak itu, bisa istirahat sepanjang tahun tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "SEPULUH KALI LIPAT! Seriusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Hehe, selama permintaannya banyak, orang pasti mau bayar. Bisa dibilang ini perjanjian antara pedagang dan pembeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Dengar kamu cerita kayak gitu, Paimon jadi ingat sama satu pedagang yang terobsesi banget sama Mora ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Tunggu, kamu bilang kamu dari Sumeru? Mungkin kamu kenal sama dia. Pernah dengar nama Dori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Maksudmu Lord Sangemah Bay? Salah satu pedagang paling terkenal di seantero Sumeru? Dori yang itu? Kamu kenal dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "Dia temanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Wow! Lord Sangemah Bay adalah salah satu idolaku. Insting bisnisnya dan dedikasinya pada Mora itu selalu jadi inspirasiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Bahkan aku cukup beruntung bisa mengunjungi Palace of Alcazarzaray satu kali. Benar-benar luar biasa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Suatu hari aku mau jadi seperti dia — punya Mora sampai tak terhitung jumlahnya, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Ehh ... dia mulai ngehalu tuh ... Perlu Paimon sadarkan atau gimana nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Semoga berhasil ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "Oke jadi ayo kita diskusi dulu soal cara menghasilkan Mora bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "Idenya cukup simpel sih. Kamu yang bikin ramuannya, terus kasih ke aku, aku yang bantuin jual ke seantero Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Kalau kamu oke, nanti kita bisa ngobrol lebih detail soal ramuan yang mau dijual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "Periksa kebutuhan ramuan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Berdasarkan insting pasarku, ramuan-ramuan ini yang sekarang lagi banyak peminatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Kita bicara lagi nanti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Hmm, oke. Tapi jangan terlalu lama ya. Kalau bicara soal Mora, kamu harus langsung hantam di saat momen yang tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Oke ayo balik ke bisnis kita dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "*uhuk* Kamu benar. Sepertinya aku sudah melenceng dari topik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Kami bertemu beberapa kali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Semua kerja keras kita akhirnya terbayar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
