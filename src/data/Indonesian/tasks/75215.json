			"dialogs": [
				{
					"id": 752150301,
					"content": "Tidak sulit kok merekrut orang baru, masalahnya adalah setelah latihan sebentar, kebanyakan orang bakal cari alasan untuk berlibur atau tidak datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "Aku sudah pikirkan banyak cara untuk meningkatkan semangat mereka, tantangan balok besar ini salah satu caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Akhirnya, ada orang yang terus-terusan menabrak balok besar untuk meningkatkan skor mereka. Akhirnya mereka jadi babak belur. Orang yang izin dan cuti malah jadi makin banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
