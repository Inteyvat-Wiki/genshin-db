				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Bagaimana? Ingin ikut kamp pelatihan kekuatan ini juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150102,
					"content": "Kalian boleh pakai semua peralatannya. Tapi kalau dari ukuran otot badanmu yang kecil ini, pesanku hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150103,
					"content": "Aku tiap hari olahraga loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Serius? Sebelum membual, mending coba hajar balok di sampingmu dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150106,
					"content": "<color=#00E1FFFF>Serang</color> atau <color=#00E1FFFF>tabrak</color> balok besarnya untuk mendapatkan skor yang berbeda berdasarkan kekuatanmu. Mari kita lihat seberapa kuat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150104,
					"content": "Aku bisa buat Hilichurl terbang dengan sekali tinju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
