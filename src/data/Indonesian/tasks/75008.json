				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manqu, kami sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Fiuh, lama juga ya. Jujur, makin lama ditunggu, aku jadi makin gelisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "Memang ideku sih dari awal, tapi kalau kalian masuk reruntuhan terus tidak keluar lagi ... Aku pasti merasa bersalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Tapi, maaf kalau lancang, apa kalian ketemu token yang ditinggalkan Sage Pencuri Api dalam reruntuhannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "Ya, tapi ribet banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Aku tahu kalian pasti bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Lihat nih, ternyata bendanya piringan begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "Ah ... \"Cakram Emas Ultimatum\"?! Yang dari legenda? Beneran ada??? Luar biasa sekali, aku harus sertakan ini dalam penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Jadi ini namanya \"Cakram Emas Ultimatum\" toh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "Be-Betul. Maaf, aku terlalu semangat. Katanya benda ini dulu dipakai oleh Sage Pencuri Api sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "Aku tadi sempat kepikiran mau simpan jadikan semacam pusaka keluarga ... Tapi sesaat saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#Eh enggak boleh! Kita perlu buat selamatkan {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Iya, iya tahu kok ... Tapi aku tidak tahu soal lokasi token satunya lagi. Petunjuknya sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Hah? Maaf {NICKNAME}, barusan kamu bilang \"Ochkanatlan\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(Jelaskan yang kamu lihat saat menyentuh tablet batu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Wah, siapa sangka bakal di Ochkanatlan ... Itu adalah reruntuhan kota kuno yang terletak di sebidang perairan sempit, di sebelah utara suku Bunga Bersayap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "Kalau memang di sana, aku minta maaf, tapi aku tidak bisa bantu. Itu tempat terlarang sukuku, dan juga untuk Asosiasi Relik Saurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Katanya beberapa tahun lalu anggota Asosiasi Relik Saurian dapat misi untuk menyelidiki tempat itu. Tapi setelah ke sana, tidak ada kabar lagi dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "Sejak itu, pihak Asosiasi sudah tidak mau terlibat lagi dengan apa pun yang berhubungan dengan Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "Enggak apa-apa, kamu sudah bantu banyak kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Kalau begitu aku harus berterima kasih lagi kepada kalian. Sungguh, bisa melihat Cakram Emas Ultimatum dengan mataku sendiri benar-benar berarti bagiku. Omong-omong, aku balik dulu ya, mau cepat-cepat catat semua ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#Terima kasih lagi, {NICKNAME} dan Paimon. Semoga perjalanan kalian lancar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#Dan {REALNAME[ID(2)|SHOWHOST(true)]} juga, semoga kamu berhasil lepas dari tanda Berkah Sang Penguasa Api.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "Dadah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Iya ... di penghujung perjalanan, tempat semua jiwa beristirahat, kita akan bertemu lagi, aku yakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "Iya dong, gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
