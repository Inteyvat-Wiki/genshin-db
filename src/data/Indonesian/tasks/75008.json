					"speakerTitle": "Manqu"
				},
				{
					"id": 750080215,
					"content": "#Eh enggak boleh! Kita perlu buat selamatkan {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080216
					],
					"speakerTitle": "Paimon"
				},
				{
