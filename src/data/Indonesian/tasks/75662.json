				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "Ada kurir yang info kalau petugas penghubung persiapan kami berhasil ketemu seorang penguji kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620102,
					"content": "Ternyata kamu ya. Jadi lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620103,
					"content": "Ck, mereka bahkan cari kamu? Hei, Kinich, benar ya kata mereka, orang aneh itu sukanya yang sama-sama aneh. Orang gila tugas ini enggak tahu cara bilang enggak mau juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620104,
					"content": "Oh lihat nih, aku baru dapat tugas baru, \"tutup mulut si naga berisik\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620105,
					"content": "Oh, itu aku yang minta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "Kalian ... Kalian akur sekali ya, ngeroyok Yang Mulia Raja Naga ini ... Lihat saja nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620109,
					"content": "#Kita balik ke topik, {NICKNAME}. Kami perlu bantuanmu untuk menguji ujian ini. Tingkat kesulitannya tidak akan bikin kamu kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620110,
					"content": "Tingkat kesulitan? Mananya yang sulit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620111,
					"content": "Terus bagimu gimana yang sulit? Pilih pasangan bodoh secara acak terus terjun payung sambil tutup mata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620112,
					"content": "Dan mungkin kamu mau buat cuma ada sepuluh persen peluang dapat rekan Yumkasaurus, sisanya dapat antara Avatar of Lava atau Geo Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620113,
					"content": "Kalau begitu sih sudah antara hidup dan mati ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "Hah, kalian sudah lama kenal pelayanku, masih belum tahu kegiatan favorit Tirai Daun?! Saranku sudah yang paling benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620115,
					"content": "Gimana kalau kamu coba duluan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620120,
					"content": "Ikut tantangan remeh seperti ini adalah penghinaan terhadap martabat Yang Mulia Raja Naga! Terserah kalian mau ngapain! Jangan tarik-tarik aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620121,
					"content": "Pokoknya Irade kasih aku harga yang lumayan. Semoga kamu bisa nikmati tantangannya dan dapat imbalan yang memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620122,
					"content": "Aku sudah enggak sabar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "Semoga semuanya lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620123,
					"content": "Serahkan padaku, Kinich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "Ooh, boleh tuh, ide bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "Tuh kan! Dengar enggak?! Dia punya selera bagus, beda denganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620118,
					"content": "Tapi aku ingin lihat Ajaw coba dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "Aku setuju. Nah Ajaw, kamu kan jauh lebih gesit daripada orang biasanya. Dan bahkan kalau monster-nya bisa pukul kamu pun, aku yakin kamu tidak akan langsung jatuh tersungkur, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620107,
					"content": "Santai, urusan yang itu bisa belakangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "Hmph! Kamu pikir kata-kata manis bisa ngerayu Yang Mulia Raja Naga ini ya? Bisa bikin aku utang budi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ajaw"
				}
			]
		}
	]
}