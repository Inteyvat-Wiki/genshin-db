			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "Pengembara, kebetulan sekali, aku sedang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Akar Pohon Suci bermasalah lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Pohon Suci sekarang sih baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "Dan yang harus kulakukan adalah menjaganya tetap begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "Intinya yang harus kulakukan adalah menebarkan ramuan obat ini ke sekitar akar Pohon Suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Tapi dengan begitu banyak ramuan obat, aku tak sanggup memindahkannya sendiri, Ladep dan Pharez tidak bisa membantu karena banyak kerjaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "Jadi, aku ingin meminta bantuanmu untuk memindahkan ramuan obat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep dan Pharez? Mereka itu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Mereka adalah pelajar sepertiku, tapi Ladep dari Spantamad, dan Pharez dari Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "Kami memiliki topik pelajaran yang sama, meskipun pemikiran kami berbeda tapi kami sedang bekerja sama sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "Ramuan obat ini adalah hasil dari kerja sama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "Oke. Ini aku yang bawa, lalu sisanya tolong bawakan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Berhati-hatilah saat memindahkannya, Ladep bilang, untuk mencegah orang-orang ceroboh dan meminum ramuan obat ini, dia sengaja membuat ramuan obatnya jadi bau sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Kalau ramuan obat ini nempel di baju, baunya bakal susah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Kalau begitu, yuk berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
