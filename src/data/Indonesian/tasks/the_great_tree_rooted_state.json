			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin? Sedang apa di sini? Aduh ... mau tebar obat lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Akar yang itu kelihatannya baik-baik saja kok. Tidak perlu kasih obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Tapi kita tetap harus rawat baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Kalau menunggu masalah muncul dulu lalu memikirkan solusinya, itu sama seperti waktu membuat Fish Roll, kamu baru sadar ikannya belum matang setelah makanannya digulung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "Antara buat baru atau harus membuka gulungannya lagi, keduanya sama-sama merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Kamu memang susah dikasih tahu ya ... aku sudah pernah bilang, kan? Ramuan itu bau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "Aku tinggal tidak jauh dari sini, dan tidak mau tidur sama bau-bau aneh. Oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Jangan khawatir, aku sudah menyuruh Ladep mengubah komposisi ramuannya, jadi baunya tidak akan menyengat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Ya sudah, terserah. Pokoknya dilarang tebar obat di dekat halamanku. Baunya minta ampun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "Iya, iya. Pengembara, boleh tolong ambilkan obat yang di kotak sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "Kamu menebarkan ramuannya bersama Yasmin ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Ramuan ini baunya menyengat banget deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "Sepertinya kamu tidak terganggu sama sekali ya, Yasmin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Kalau yang kamu omongkan itu tentang baunya, aku sudah mencium banyak bau yang lebih tidak enak daripada ramuan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Oke seharusnya cukup. Aku juga sudah mencatat banyak data. Dengan begini Pharez pasti akan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "Ini untukmu, Pengembara. Terima kasih atas bantuanmu selama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "Aku juga tidak tahu pekerjaan Ladep dan Pharez sudah sampai di mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
