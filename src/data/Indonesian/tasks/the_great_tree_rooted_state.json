			"dialogs": [
				{
					"id": 230280501,
					"content": "Kak Yasmin! Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "A—Aku tidak bisa bernapas, cepat tinggalkan tempat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "Apa ini? *uhuk-uhuk* Bau apaan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "Sepertinya Ladep menyelesaikannya dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "Di sini sudah beres ditebarkan, ayo kita lanjut titik selanjutnya. Ada di dekat sini kok, tidak jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
