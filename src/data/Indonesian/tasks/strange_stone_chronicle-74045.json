						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Walaupun ada banyak batu berkilau yang indah di pertambangan dekat sini, mereka tidak seindah permata asli ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
