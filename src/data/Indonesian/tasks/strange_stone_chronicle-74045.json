			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, kami sudah balik nih! Kami sudah temukan token-mu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Kamu memberikan token-nya ke Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Ohh iya, yang ini betul! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Kami juga menemukan benda lain waktu nyari token-mu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "Ini bijih yang tidak pernah kita lihat sebelumnya. Tadinya kami rasa ini berharga jadi kami bawa balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Kalau Paimon enggak salah ingat, kamu sering ambil batu-batu indah di sekitar area ini, kan? Apa kamu pernah lihat batu seperti ini sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Coba kulihat ya ... Iya bagus sekali! Tapi ini tidak berharga sama sekali ... Ini cuma batu biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "Yah memang benar kamu tidak akan menemukan yang seperti ini di tempat lain, tapi kalau di sekitar sana sih banyak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Aw, jadi ini cuma batu biasa! Paimon pikir ini berharga sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Kayaknya enggak bisa dipakai buat yang lain. Ya sudah kita buang saja yuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Tapi kalau bijih ini enggak bisa ditemukan di tempat lain ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Oh, jadi maksudmu kita bisa cuan dong kalau kita bawa keluar terus jual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Iya juga! Orang-orang kan normalnya enggak akan pergi nambang ke desa Melusine, jadi mereka enggak pernah lihat yang begini ... Ide bagus, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Ayo, kita bawa batu ini ke Court of Fontaine dan kasih lihat ke pedagang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Kalau masih ada hal lain yang kamu mau tahu, cari aku kapan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Walaupun aku tidak punya pabrik permata seperti kakakku, dan tidak tahu banyak soal menilai dan pemrosesan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Aku lebih suka kumpulkan berbagai batu unik dibandingkan dengan permata berharga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Kurasa kamu bisa bilang aku tahu banyak soal tambang bijih sekitar sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Hehe, oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Kalau memang cuma ada di wilayah ini saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
