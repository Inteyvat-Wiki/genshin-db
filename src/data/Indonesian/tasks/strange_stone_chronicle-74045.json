					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Kalau aku pandai cari permata asli, mungkin aku bisa buka pabrik permata sendiri seperti Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
