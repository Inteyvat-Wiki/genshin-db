			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, kenapa kamu ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Harusnya tidak ada monster di sekitar sini, tapi siapa tahu bahaya apa yang akan muncul ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Yah pokoknya, kamu jangan lari-lari sendirian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Ih aku tidak lari-lari, Paimon dan {NICKNAME} ... aku sedang cari token-ku kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Hah? Token kamu hilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Iya ... harusnya ada di sekitar tempat dimana aku biasa ambil batu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Hmm, mungkin ketinggalan waktu kamu terjebak di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*hiks* Iya, mungkin kamu benar ... Aku terlalu takut buat mikirin hal lain waktu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Aduh kalau kepikir soal itu jadi takut deh, token-ku itu penting banget ... harus ketemu sampai dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Hmm ... Paimon rasa bakal terlalu bahaya kalau Puca ke sana sendirian. Kalau begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, gimana kalau kita balik dulu ke tempat itu dan bantu Puca cari token-nya? Puca, kamu tunggu saja di rumah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "Serahkan pada kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Terima kasih, {NICKNAME} dan Paimon! Aku bakal jadi anak baik dan tunggu di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "Aku memang sudah lama mau menjelajahi tempat itu sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
