				"points": []
			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "Aduh, aneh sekali. Kamera yang satu ini kenapa ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010102,
					"content": "Kameranya kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "Sepertinya rusak... Pokoknya dia tidak bisa bekerja dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010104,
					"content": "Jadi waktu itu aku memesan beberapa Kamera dari Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010105,
					"content": "Orang yang menjualnya kepadaku bilang bahwa Kamera terbaru ini menggunakan teknologi paling canggih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010106,
					"content": "Dia bilang hasil potretannya bisa memiliki warna dan efek yang spesial. Jadi langsung saja kubeli satu untuk mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010107,
					"content": "Ternyata setelah kucoba, Kamera ini tidak bisa mencetak gambar yang normal. Entah aku yang tidak mengerti caranya atau Kamera ini memang rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010108,
					"content": "Jangan-jangan aku saja yang tidak tahu cara menggunakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010109,
					"content": "Oh iya, kalian mengerti cara menggunakan Kamera ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010110,
					"content": "Lumayan mengerti sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "Wah pas sekali, kalau begitu bisakah kalian menolongku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010114,
					"content": "Dari penampilan kalian, kalian ini pengembara kan? Kalian pasti sudah pernah pergi ke banyak tempat dan punya banyak pengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010115,
					"content": "Aku ingin meminta tolong kalian menggunakan Kamera ini untuk memotret beberapa benda dengan \"warna\" yang mencolok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010116,
					"content": "Setelah kalian berhasil memotretnya, bawa saja hasil fotonya kepadaku. Aku ingin tahu sebenarnya Kamera ini masalahnya di mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010117,
					"content": "Kalau benar-benar tidak bisa digunakan, aku akan membawa foto-foto itu ke penjual itu. Dia pasti tidak bisa mengelak kalau aku membawa barang bukti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010118,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010120,
					"content": "Apa maksudmu \"benda dengan warna yang mencolok\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Oh, itu loh... Benda dengan warna yang sangat kontras. Contohnya warna merah Jueyun Chili, atau warna biru Mist Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010122,
					"content": "Setelah kalian selesai memotretnya, tolong bawakan hasil foto nya kepadaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010112,
					"content": "Belum pernah memakainya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Oh, tidak apa-apa, cara menggunakannya cukup mudah kok... Bisakah kamu membantuku melakukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				}
			]
		}
	]
}