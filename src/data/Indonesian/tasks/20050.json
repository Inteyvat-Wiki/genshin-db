			"dialogs": [
				{
					"id": 200500201,
					"content": "Bagaimana? Sudah ketemu caranya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500202,
					"content": "Masih belum terpikirkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500203
					]
				},
				{
					"id": 200500203,
					"content": "Hm...Aku pernah bertemu beberapa petualang sebelumnya, mereka semua sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500204,
					"content": "Mereka bertarung dengan hebat melawan para monster, tapi mereka kebingungan saat harus menghadapi boneka kayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500205,
					"content": "Selain itu mereka menggunakan beberapa cara untuk memperkuat boneka kayu itu, seolah takut jika boneka-boneka kayu itu hancur dengan mudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500206,
					"content": "Jika mereka begitu menginginkan tantangan, mengapa tidak langsung saja pergi ke alam liar untuk menemukan monster yang kuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
