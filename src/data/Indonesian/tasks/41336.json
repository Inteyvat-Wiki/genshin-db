			"dialogs": [
				{
					"id": 413360501,
					"content": "Ah, halo Linling. Ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Manajer Xiao"
				},
				{
					"id": 413360502,
					"content": "Ingat terakhir kali kamu memintaku memikirkan beberapa bait untuk dituliskan di Lentera Xiao? Aku dan Pengembara ini baru saja selesai menyiapkan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Lihat, kami bahkan telah menuliskannya di Lentera Xiao untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Terima kasih banyak, coba kulihat dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Manajer Xiao"
				},
				{
					"id": 413360505,
					"content": "\"Kaum muda yang datang dihadapkan dengan tatapan tajamnya yang menakutkan\"... \"Seiring bertiupnya angin, dia pun tertidur lelap di pegunungan bagaikan seekor beruang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Manajer Xiao"
				},
				{
					"id": 413360506,
					"content": "\"Sedamai Gunung Tidur\"... Hehe, lumayan bagus juga. Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Manajer Xiao"
				},
				{
					"id": 413360507,
					"content": "Sama-sama, Manajer Xiao. Aku masih punya alternatif lain yang kutulis sendiri juga. Biar kubacakan ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "Oke, kurasa saatnya kita pergi sekarang! Kita masih harus ke orang selanjutnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
