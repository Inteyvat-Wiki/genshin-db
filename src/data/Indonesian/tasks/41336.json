					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Hmm, kurasa aku harus pergi mencari lebih banyak inspirasi lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Sekarang ini aku sedang membantu seseorang untuk memikirkan sesuatu yang cocok untuk ditulis di Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "Kamu tahu kan bagaimana orang-orang menerbangkan Lentera Xiao selama Festival Lantern Rite? Mereka juga akan menuliskan sesuatu di lenteranya, seperti harapan, atau berkah, dll...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "Biar sesuai dengan suasana festival yang meriah, beberapa orang mungkin ingin menuliskan harapan dan berkah seperti... umm... bagaimana mengatakannya ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "Seperti menunjukkan beberapa bakat sastranya dalam bentuk bait kata... kamu paham kan yang kumaksud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Bibo, Manajer Xiao, dan Degui semua pada memintaku memikirkan cara menyusun bait harapannya dan menuliskannya di Lentera Xiao untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Tapi mana bisa aku terinspirasi untuk menulis sesuatu yang menarik dengan hanya terkurung di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Jadi kupikir aku siapkan Lentera Xiao dulu saja, terus pergi mengamati orang-orang yang telah meminta bantuanku. Dengan cara ini, aku bisa lebih mudah menyesuaikan harapan setiap orang dengan kebutuhan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Tapi bagaimana aku bisa membuat Lentera Xiao itu ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "Oh ya? Kalau begitu, tolong buatkan aku tiga Lentera Xiao ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Setelah lenteranya siap, aku akan menemui klien kami untuk mendapatkan inspirasi tentang cara menuliskan harapannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Hehe, aku sudah ada beberapa ide, mereka hanya butuh sedikit.. kreativitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "Aku cukup ahli dalam membuat Lentera Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
