				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "Manajer Xiao ada di sana. Kita perhatikan dari sini saja dan amati apa yang dia lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360402,
					"content": "Hmm, coba kupikir... aku cukup mengenal Manajer Xiao dengan baik, seharusnya sih tidak akan butuh waktu lama untuk menuliskan harapannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360403,
					"content": "Aku akan membacakannya untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360404,
					"content": "\"Pria tua dengan raut wajah keriput bertemperamen buruk\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360405,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "\"Tapi di balik semua itu terdapat hati yang hangat dan perhatian\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360408,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "Oh, aku bahkan sudah memikirkan judulnya juga... \"Sungguh Orang yang Baik\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360411,
					"content": "Bagaimana? Cocok kan? Meskipun Manajer Xiao terlihat galak, dia sebenarnya orang yang baik kok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360412,
					"content": "Apakah kamu sudah memikirkan alternatif lainnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "Tidak, cuma satu ini saja... Sepertinya aku juga tidak bisa memikirkan bagaimana melanjutkan baitnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360414,
					"content": "Apakah kamu ingin mencobanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360415,
					"content": "Kalimat pertama adalah \"Kaum muda yang datang, dihadapkan dengan tatapan tajamnya yang menakutkan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360416,
					"content": "\"Seiring bertiupnya angin, dia pun tertidur lelap di pegunungan bagaikan seekor beruang\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Hmm, lumayan... boleh deh. Sekarang kita perlu memikirkan judulnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360418,
					"content": "Umm... \"Sedamai Gunung Tidur\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "Oh! Tak kusangka kamu memiliki bakat sastra seperti itu. Kalimat-kalimat ini sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360420,
					"content": "Tunggulah sebentar sementara kutulis ini di Lentera Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360421,
					"content": "Oke, sudah selesai. Ayo kita serahkan lentera ini kepada Manajer Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360409,
					"content": "Kurasa kamu tidak perlu membacakannya lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "Ka-kamu bercanda kan?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
