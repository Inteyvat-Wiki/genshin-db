						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*huff* Ah, rasa sebuah masakan ternyata dipengaruhi oleh banyak variabel, banyak sekali yang harus diperhitungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Mesin Angka harus disempurnakan lagi kalau ingin bikin perhitungan lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "Semoga bisa dapat inspirasi di perpustakaan Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "Buat apa bikin mesin kayak gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Pertanyaan bagus. Aku jawab, tapi aku mau tanya sesuatu dulu sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Apa menurutmu Mesin Angka ini punya \"pikiran\" sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Benar, silakan dipikirkan dulu jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "Kita diskusikan lagi di lain waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "Sekarang aku harus merapikan data lagi. Lutong, ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981519,
					"content": "Siap, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "Ah, Pengembara. Tolong terima ini. Tuan Garcia memang begitu, mohon maklum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "Kalian mau ke Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Ya, Tuan Garcia ingin ke Akademiya untuk mengumpulkan materi, dan aku sudah dibayar untuk ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "Sampai jumpa, Pengembara. Alangkah baiknya kalau kita bisa bertemu lagi Sumeru ... Dan Tuan Garcia juga akan senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "\"Pikiran\"? Mesin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "Um, boleh menjauh sedikit dari wajahku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
}