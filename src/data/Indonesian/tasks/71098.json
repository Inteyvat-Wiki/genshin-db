				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Aku benar-benar tidak habis pikir. Buat Radish Veggie Soup itu sesusah apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980302,
					"content": "Tanya terus, tanya terus! Mana aku tahu berapa banyak setiap bumbu dan bahan di masakanku!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980303,
					"content": "Kamu kan tinggal masukkan sesukanya dan pakai saja perasaanmu? Mana ada koki yang repot-repot soal begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
