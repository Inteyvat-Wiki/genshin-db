					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Tuan, perlu diingat terhitung hari ini, kita sudah makan Radish Veggie Soup selama enam hari berturut-turut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Meskipun kita sedang mengalami krisis keuangan, tapi masalah perut kita juga tidak boleh diabaikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Kamu benar! Benar sekali, Lutong yang baik, kamu memang selalu peka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Kita mungkin tidak dapat secara akurat menilai rasa hidangan dikarenakan masalah pencernaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Kita harus mencari seorang saksi! Lutong, kita perlu pihak ketiga sebagai saksinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Terima kasih atas pujiannya, Tuan. Tapi sebenarnya maksud saya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Permisi, tapi kalian sedang apa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "Ah ... Ha! Saksinya langsung datang sendiri, bagus! Bahkan ada lebih dari satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "Eh? A-apa? Saksi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Maksudnya kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Benar, benar! Katakan padaku, kamu pernah makan Radish Veggie Soup? Tahu rasanya? Tahu cara masaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Tuan, saya rasa di saat seperti ini kita harus menjelaskan dulu situasinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Tahu dong! Si {NICKNAME} bisa loh bikinnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, kita harus dengar dulu konteks masalahnya....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Baiklah. Kujelaskan dulu misinya, semoga kalian mau ambil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Namaku Lutong, dan ini adalah bosku, Tuan Garcia dari Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Tuan Garcia sedang meneliti ... Ehm ... sesuatu yang dia sebut \"Mesin Angka\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Intinya, sebuah alat yang dapat ... membantu orang menghitung berbagai angka, benar begitu Tuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Benar sebenar-benarnya, Lutong yang baik, fungsi dari Mesin Angka memang sesederhana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Benar, sederhana ... harus buat yang sederhana. Konverter itu terlalu rumit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Tapi, apa hubungannya ini dengan Radish Veggie Soup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Bagian ini biar Tuan Garcia yang menjelaskan, Tuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Tapi bagaimana cara menyederhanakannya ... Oh! Ya, tidak masalah, biar kujelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Hmmm ... Biar kita mulai dari hal yang paling sederhana, kalian tahu apa itu \"Formula\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Hmm ... Enggak sih ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Aku juga tidak begitu mengerti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Baiklah ... tidak masalah, kalian bisa menganggap formula itu sebagai ... Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "Sebuah ... sebuah rumus yang dapat menunjukkan hubungan antar berbagai jumlah angka, dan memiliki cara kerja yang umum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Eh? Apa? ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Kedengarannya hebat sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Sederhananya, dengan bantuan Mesin Angka, kami ingin mencoba menulis rumus untuk resep Radish Veggie Soup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Tuan Garcia percaya, selama dapat menemukan formula yang tepat, kami bisa menuliskan resep Radish Veggie Soup menjadi sebuah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "Sebuah prosedur yang umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "Sebuah prosedur yang orang bodoh pun bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Hanya dengan mengikuti prosedur ini, siapa pun akan bisa masak Radish Veggie Soup yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Kedengarannya bagus sih ... Tapi kenapa kamu enggak langsung minta seseorang ajari kamu cara bikin supnya secara langsung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Sayangnya, cara itu ... sangat bergantung pada bakat seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Orang sepertiku dan Tuan Garcia yang tidak punya bakat memasak，tak peduli seberapa keras koki mengajari kami, kami tidak akan bisa mempelajari esensinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Aku yakin, Tuan Smiley Yanxiao di penginapan ini tahu betul tentang hal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Jadi, kamu perlu bantuan kami untuk menghitung \"formula\" ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Tentu saja tidak, aku tidak akan menyulitkanmu dengan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Lebih tepatnya, kami mau kalian menjadi \"saksi pihak ketiga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Sederhananya, cicipilah Radish Veggie Soup buatan Tuan Garcia yang telah dibuat sesuai formulanya, dan berikan pendapat anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "Berarti kami ke sini cuma buat nyobain makanan saja kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Rangkumanmu simpel juga ya, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Ah, enggak apa-apa kan! Paimon juga belum pernah coba Radish Veggie Soup yang dibuat pakai formula-formula itu. Ayo kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Baiklah. Kalau begitu kita sepakat, Tuan Smiley Yanxiao yang baik hati sudah mau meminjamkan dapurnya, ayo kita ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Tuan Garcia? Apa Anda mendengarkan? Eksperimen kita masih menggunakan langkah yang sama seperti sebelumnya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Uh? Oh! Maaf, aku sedang melamun lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Terlalu banyak parameter acak yang ada di kepalaku ... Tapi yah, kita ikuti saja proses tiga langkah seepertinya sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Jadi, kamu mau kami mengajarimu masak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Hm ... tidak bisa dibilang begitu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Tentang resep Radish Veggie Soup ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
