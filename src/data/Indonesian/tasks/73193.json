			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "Kamu bisa pakai kekuatan Dendro? Apa kamu punya Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Sudah lama sekali aku tidak bertemu dengan orang seperti ini. Duh aku jadi ingin nostalgia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Seharusnya sekarang udah oke kan, Nona Sabbah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Iya, kalau kekuatan Dendro-nya langsung digunakan, tunasnya pasti langsung muncul dengan cepat. Kita tunggu saja sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "Beberapa tunas muda yang halus perlahan keluar dari dalam tanah.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Sesudah keluar daunnya, tunas muda berhenti tumbuh.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Tunasnya keluar! Sudah Paimon duga kamu bisa melakukan segalanya, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Ternyata memang hasilnya instan sekali ya. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "Sayang, bunganya belum mekar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Ah, itu normal kok. Kalian tidak boleh terburu-buru dalam prosesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Tumbuhan pasti mengalami tahap pertumbuhan. Kamu bisa menumbuhkan tunas mereka saja sudah hebat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Beri mawar-mawar itu sedikit waktu lagi. Biarkan mereka terus menyerap nutrisi supaya berbunga lagi. Ini juga baik untuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Lagi pula hari ini aku sudah sangat berterima kasih. Tidak enak rasanya kalau aku merepotkan kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Aku senang kalau kalian bisa datang dan melihat mereka waktu kalian senggang nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}