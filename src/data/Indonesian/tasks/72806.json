				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Hm... Tulisannya bagus juga, hurufnya unik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Jadi, begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Eh? Ternyata kamu, {NICKNAME}, lama tidak berjumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "Kamu terdengar bersemangat sekali, bagus, bagus... Ada urusan apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "Sebenarnya, kami mau menanyakan tentang seseorang. Kamu kan suka membaca, mungkin saja kamu tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "Seseorang? Jangan-jangan kalian mencari penulis itu? Uh, katakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "Tentang Zhenyu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "Zhenyu? Dari mana kamu tahu nama itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "Tertulis di buku \"Legenda Pedang\" ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Kami sedang mencari Zhenyu. \"Yae Publishing House\" di Inazuma meminta kami mengirimkan surat kepada penulis ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Apa kamu tahu siapa sebenarnya Zhenyu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Hm... Zhenyu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "Aku malu, sebenarnya... itu nama samaranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Kamu tidak pernah bilang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Hal ini... juga tidak penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "Saat di Liyue, editor yang bertanggung jawab mengatakan, \"Latarnya terlalu biasa, tapi plotnya tidak terduga, tidak akan ada yang suka\", lalu menolak naskah buku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "Aku tidak bisa menerima perkataannya, huh... Jadi aku diam-diam mencetak dan menaruhnya di \"Wanwen Bookhouse\", siapa tahu ada yang suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "Ternyata, tidak ada yang baca, jadi aku menyerah. Tidak disangka, buku ini begitu disukai banyak orang di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Bagaimanapun, ada yang mau membaca bukuku saja sudah bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "Surat ini akan kubaca baik-baik, terima kasih Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
