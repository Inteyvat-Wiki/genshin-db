			"dialogs": [
				{
					"id": 728060501,
					"content": "Ah, akhirnya kamu kembali! Bagaimana? Apa kalian bertemu kedua penulis tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Suratnya sudah kusampaikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "Syukurlah! Terima kasih Pengembara, lalu kedua penulis bilang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Mereka bilang akan baca baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Baguslah. Ah... sayang sekali kedua penulis berada jauh di Liyue... Aku tidak bisa sering berkunjung ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Naskah buku \"Legenda Pedang\" juga tidak diserahkan oleh Master Zhenyu sendiri, tapi dibawa oleh pedagang ke Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Kemudian, seorang editor di \"Yae Publishing House\" kami membacanya dan merasa buku ini ada nilainya. Dia pun bersiap-siap menuju Liyue untuk meminta Zhenyu menulis secara formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Tidak disangka... Keadaan Inazuma berubah drastis, kami tidak dapat mengirim orang ke Liyue dan surat yang dikirim pun tidak pernah dibalas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Jadi kami mencetak buku ini sendiri, mencatat royalti Zhenyu, yang akan kami berikan setelah bisa menghubunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Tapi, sudah selama ini, \"Legenda Pedang\" tetap laris, royalti juga semakin banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*huff* Zhenyu kali ini harus hadir di kompetisi, royalti ini tidak bisa ditumpuk terus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
