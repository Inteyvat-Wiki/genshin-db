			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "Oh? Pengembara, kenapa kamu datang kemari hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060202,
					"content": "Tentang surat dan hadiah \"Yae Publishing House\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Surat dari Yae Publishing House? Apa mereka minta aku buat nama pena lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060204,
					"content": "Aku sudah kasih tahu mereka ribuan kali kalau aku mau pakai nama asliku saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060205,
					"content": "Ah sudahlah, mana suratnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060206,
					"content": "Jadi juri untuk... sayembara penulisan novel. Hmm, kurasa aku tidak akan sempat, tapi lebih baik ucapkan terima kasih dulu kepada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060207,
					"content": "Eh? Kenapa masih banyak begini, ini... kritik dan saran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060208,
					"content": "Uh, akan kubaca baik-baik, terima kasih, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
