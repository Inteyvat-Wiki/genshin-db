			"dialogs": [
				{
					"id": 705100401,
					"content": "Wah, bisnis kedai ini lagi naik nih belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100402,
					"content": "Beberapa tamu datang untuk minum, tapi sebagian besar ingin ketemu kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100403,
					"content": "Wah ... Masih belum percaya loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100404,
					"content": "Acara Jika Aku Menjadi Bartender belum pernah sesukses ini sebelumnya. Kali ini kami dapat untung dan dapat reputasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100405,
					"content": "Intinya, kerjamu bagus sekali, kawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100406,
					"content": "Eh, baru juga lewat berapa hari, kita sudah jadi teman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100407,
					"content": "Yah, bisa dibilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "Apa kalian bersedia tinggal dan kerja di sini terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100410,
					"content": "Duh, maaf. Bebas tambah minuman sepuasnya memang menggoda banget, tapi Paimon sudah janji mau terus ikut berkelana sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100411,
					"content": "Baiklah, aku tidak akan memaksa. Charles juga sudah kasih tahu aku sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100412,
					"content": "Yah, silakan datang lagi ke Angel's Share kalau kalian senggang. Jangan lupa bawa teman ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100413,
					"content": "Pasti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "Sampai jumpa, dan selamat jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100408,
					"content": "Begitu juga sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
