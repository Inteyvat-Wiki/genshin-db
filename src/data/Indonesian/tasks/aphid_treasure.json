			"dialogs": [
				{
					"id": 755050301,
					"content": "Fiuh, beres. Si nakal ini gede badannya, tapi gampang nangkepnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050302,
					"content": "Enggak bahaya sama sekali, cuma ya itu, kaburnya lumayan cepat. Untungnya kita bawa jaring, dan si buah beri yang bisa bikin lumpuh tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050303,
					"content": "Hehe, jangan lupa serangga ini keracunannya sama Abyss. Abyss tuh bisa menarik monster, waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050304
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050304,
					"content": "Iya, tahu! Dan karena di sini ada buah beri yang entah gimana caranya bisa ada di sini ... Aneh lah, Paimon sih bakal jauh-jauh ya kalau ada musuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050305,
					"content": "#Dua musuh berdekatan kayak gini sama sekali enggak alami, {NICKNAME}! Jangan lengah, Paimon yakin ada yang ngaco di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050306,
					"content": "Kamu kayaknya ahli banget ya soal hal-hal ngaco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050307
					]
				},
				{
					"id": 755050307,
					"content": "Hehe, kan belajarnya dari kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050308,
					"content": "Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050309
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050309,
					"content": "Pokoknya, terima kasih karena sudah temani aku. Kita sudah bersihkan area ini, jadi ayo rehat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050310
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050310,
					"content": "Toh aku masih butuh bantuanmu juga untuk beberapa hari ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		}
