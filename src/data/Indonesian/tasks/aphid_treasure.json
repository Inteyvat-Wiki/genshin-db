				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "Hai, Xilonen! Enggak nyangka loh bisa ketemu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050102,
					"content": "Halo Paimon dan Pengembara~ Lah, kenapa gitu? Ini kan rumahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050103,
					"content": "Ya bukan, kirain kamu bakal cari pohon gede di mana gitu buat rebahan beberapa hari gitu. Kan kita habis beresin masalah gede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050104,
					"content": "Haha, maunya sih gitu, tapi semua orang lagi sibuk kerja membangun dan memperbaiki yang rusak kemarin. Ya tidak benar lah kalau aku malah rebahan di saat-saat begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050105,
					"content": "Terus kamu mau kontribusi di sini gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "Sini, aku kasih lihat sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050107,
					"content": "WAH! Cantiknyaaa~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050108,
					"content": "Kayaknya mahal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "Bukan cuma mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050112,
					"content": "Ini Mutiara Madu Phlogiston dengan pola aneh yang belakangan ini lagi ramai di pasaran. Biasanya sih yang ginian tuh hasil produksi Phlogiston Aphid, bukan barang langka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050113,
					"content": "Tapi yang polanya aneh gini tuh termasuk langka. Harganya juga tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050114,
					"content": "Paimon ngerti banget pemahamannya! Kita semua suka dong kalau tiba-tiba nemu peti harta yang corak gambarnya keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050115,
					"content": "Hehe, tahu enggak? Aku beli beberapa buat koleksi, terus tiba-tiba saja pot kembang di rumah, yang ada di dekat rak, langsung layu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050116,
					"content": "Awalnya sih enggak kepikiran apa-apa, lagian memang aku awam banget soal berkebun. Tapi terus aku dengar Kachina bilang beberapa orang jatuh sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050117,
					"content": "Hampir semuanya pelanggan toko Cheven. Ya, bahkan Cheven-nya pun ikutan sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050118,
					"content": "Hah? Apa jangan-jangan ... itu semua ada hubungannya sama batu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050119,
					"content": "Aku juga curiganya gitu, makanya aku pecahin deh satu ... dan tebak apa yang ada di dalamnya? Kekuatan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050120,
					"content": "Tidak pekat, tidak padat, dan tertahan sama cangkang luar mutiaranya. Nyaris tidak terdeteksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050121,
					"content": "Terus korbannya? Pada masih hidup, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "Tenang, kekuatan tingkat rendah begitu akibatnya cuma nyeri-nyeri sedikit saja. Palingan juga cuma kerasa capek atau ngantuk terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050123,
					"content": "Dan tidak ada pengaruhnya ke orang yang jaga kesehatan badan, contohnya aku dan Kachina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050124,
					"content": "Fiuh ... kirain ini situasi yang ngeri-ngeri sedap lagi, tahu-tahu cuma level \"S\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050125,
					"content": "Level \"S\"? Maksudnya gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050126,
					"content": "Maksud si Paimon tuh level \"Slime\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "Hehe, bestie Paimon memang enggak pernah gagal deh, sumpah. Ini cuma masalah buat orang biasa, persis kayak cuma orang biasa doang yang takut sama Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050128,
					"content": "Heh, kalian punya bahasa sendiri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050129,
					"content": "Namanya juga bestie. Tapi serius loh, kami sendiri kenal banyak orang yang takut banget sama Slime, jadi ya bukan berarti karena masalahnya sepele, lantas boleh dibiarin gitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050130,
					"content": "Betul. Aku sudah jelaskan situasinya ke pak kepala dan sudah minta tolong dia musnahkan semua Mutiara Madu aneh di pasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050131,
					"content": "Yang kayak gini harus dibasmi sampai ke akar-akarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "Aku juga sependapat. Makanya, karena Mutiara Madu Phlogiston itu hasil produksi Phlogiston Aphid, sumbernya ya sudah jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050133,
					"content": "Aku mau minta bantuan Kinich, soalnya dia yang lebih jago kalau soal penyelidikan. Kemarin katanya dia sudah nemu Aphid yang kena kontaminasi Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050134,
					"content": "Ada jejaknya juga di sekitaran kampung suku Tirai Daun dan Warga Mata Air. Tenang, Kinich juga sudah kabari Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050135,
					"content": "Tapi orang-orang sana kan tidak berapa antusias sama batu akik, jadi ya masalahnya enggak gimana juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050136,
					"content": "Hmm, masih banyak masalah yang berakar dari Abyss ya, ternyata. Sabar, harus sabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050137,
					"content": "Terus gimana penanggulangannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "Tangkap, lalu murnikan. Kalau baru segini, kontaminasinya juga belum parah. Enggak perlu sampai mengadakan pembasmian Aphid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050139,
					"content": "Kinich sudah tandai tempat serangga itu berkumpul, dan ini aku lagi menuju ke titik yang paling dekat dari kampung suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050140,
					"content": "Kalian mau ikut? Nangkepin serangga kan seru juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050141,
					"content": "Aku tadinya mau ajak Kachina juga, tapi sayang dia lagi sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050142,
					"content": "Ini ngajak maksudnya biar kamu bebas nyantai ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "Ha, tolong dong. Memangnya aku tega ya nonton kalian kerja berat sambil duduk nyantai di atas pohon?! Enggaklah, kita kerja bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050144,
					"content": "Bercanda. Ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "Asyik! Ada kamu pasti seru nih, kalo sendirian kan bosan banget. Ayo, gas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050146,
					"content": "Gas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "Asyik! Ada kamu pasti seru nih, kalo sendirian kan bosan banget. Ayo, gas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050148,
					"content": "Enggak mau ah, enggak seru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "Yah, berarti aku harus bosan sendirian doang ... yakin nih enggak mau ikut? Ada imbalannya loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050150,
					"content": "Oooh, imbalan! Apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050151,
					"content": "Yang kelap-kelip bling-bling gitu. Cantik banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050152,
					"content": "#Mora! PASTI MORA! {NICKNAME}, gas, buru! Ada duitnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050153,
					"content": "Oke deh, anggap yang tadi cuma bercanda. Gas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "Haha, ayo gas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050155,
					"content": "Baiklah, demi Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "Haha, ayo gas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050110,
					"content": "Kayaknya ada yang aneh ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "Haha, kamu tahu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				}
			]
		},
