			"dialogs": [
				{
					"id": 755050201,
					"content": "Ini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050202
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050202,
					"content": "Kalian lihat? Itu Aphid yang terkontaminasi Abyss. Ukurannya jauh lebih besar dari yang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050203,
					"content": "Wuih, gede amat! Bahaya enggak nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050204,
					"content": "Tenang, sifatnya tidak berubah walaupun sudah terkontaminasi Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050205,
					"content": "Tapi aku sudah siapkan jaring penangkap khusus ukuran jumbo buat jaga-jaga. Nih, pegang. Sebentar lagi bakal kelihatan gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050206,
					"content": "Oh iya! Kinich juga bilang kalau ada buah beri khusus yang tumbuh di dekat Abyssal Aphid berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050207,
					"content": "Buah itu mengandung racun yang bisa melumpuhkan Aphid, jadi kalau kita lumuri jaringnya pakai itu, Aphid-nya juga tidak akan banyak berontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050208,
					"content": "Hah? Kenapa Aphid mau dekat-dekat sama buah yang bisa lumpuhin mereka? Kok aneh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050209,
					"content": "Aku juga merasa begitu. Baru pertama kalinya dengar ada hewan yang mau hidup di dekat sesuatu yang membahayakan dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050210,
					"content": "Enggak wajar banget itu! Eh ... apa mungkin ada yang sengaja bikin mereka keracunan Abyss?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050211,
					"content": "Paimon belakangan ini jadi lebih pintar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "Heh! Bahkan pemandu paling bodoh pun bisa belajar ya! Apalagi Paimon yang sudah pintar dari sananya!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050213,
					"content": "Masalahnya kami juga sudah cari berulang-kali, tapi tidak ketemu tanda-tanda campur tangan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050214,
					"content": "Jadi kita anggap saja sebagai perilaku alami Aphid yang tidak pernah diketahui sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050215,
					"content": "Terserah deh, tapi intinya kita harus tangkap dulu dong! Bibit penyakit jangan dibiarin berkeliaran bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050216,
					"content": "Pasukan Pembasmi Hama, maju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
