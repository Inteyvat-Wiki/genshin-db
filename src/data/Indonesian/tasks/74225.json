			"dialogs": [
				{
					"id": 742250201,
					"content": "Terima kasih, penolongku. Oh Raja Dewa, akhirnya aku terselamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "Kamu pasti prajurit legiun yang jaga kota ini ya? Atau orang baik hati yang kebetulan lewat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Pokoknya, aku perkenalkan diriku dulu. Namaku Faustus, aku Mercatores Exquisiti yang diperintahkan langsung oleh Raja Dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Aku ke sini untuk antar bumbu dari bangsa selatan ... Tapi tidak kusangka Vishap keji itu malah mengepungku begitu aku sampai di tepian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Vishap? Mana Vishap-nya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "Eh? Kamu sama sekali tidak melihat Vishap yang kamu kalahkan tadi? Benar-benar pemberani yang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Tapi yah, silakan terima ini. Aku tidak basa-basi lagi karena harus cepat balik ke kota. Mungkin suatu hari nanti kita bisa bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
