			"dialogs": [
				{
					"id": 250360101,
					"content": "Pertanyaannya terlalu gampang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Oh. Maaf sekali. Tadi aku sedang berpikir, sampai tidak menyadari kehadiran Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Salam, namaku Keita dari suku Penguasa Angin Malam. Aku sedang magang di sini, bagian manajemen dokumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "Tadi kamu lagi mikirin apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah, cuma beberapa pertanyaan terkait masa lalu, masa kini, dan masa depan Natlan. Tidak penting untuk didiskusikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "Anda sepertinya pengembara. Aku bisa merasakan kalau Anda pandai membina hubungan, dan juga punya wawasan luas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Kalau bersedia, silakan coba menjawab pertanyaan yang sudah aku siapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "Jawabannya bisa dicari dari pengembaraan Anda selama ini. Dulu, sekarang, dan nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
