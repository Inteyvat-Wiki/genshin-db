			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Oke, sudah beres semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460102,
					"content": "Ayo semangat, Jala! Kamu harus tangkap semuanya dalam beberapa hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460103,
					"content": "Ta-Tangkap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Eh?! Ada pemburu liar di Fontaine? Dagang hewan lagi cuan banget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460106,
					"content": "Enggak, enggak boleh! Kita harus bawa ke Maison Gardiennage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460107,
					"content": "Eh, ternyata kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460108,
					"content": "Boleh nih, aku juga baru dari Maison Gardiennage. Mau aku yang bawa jalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460110,
					"content": "Bagus. Aku suka orang terus terang sepertimu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Sebentar, ada yang aneh nih ... Kamu enggak takut ditangkap sama sekali. Berarti antara kamu udah jago banget, atau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460114,
					"content": "Tenang, aku berdiri di pihak yang benar kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460115,
					"content": "Lebih tepatnya, Maison Gardiennage tarik aku sebagai konsultan perlindungan alam khusus ... seorang \"Pemburu Tanpa Belenggu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460116,
					"content": "Yang kutangkap ini spesies ikan invasif yang masuk ke perairan Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460117,
					"content": "Spesies ikan ... invasif?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460118,
					"content": "Kok kayaknya pernah dengar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "Iya! Paimon juga merasa pernah dengar yang begituan di Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460122,
					"content": "Yang lalu tidak perlu dibahas lagi, yang penting itu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460123,
					"content": "Spesies invasif ini sengaja dilepaskan oleh para pedagang yang punya kepercayaan aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460124,
					"content": "Beberapa ikan sifatnya sangat agresif, beberapa berkembang biak dengan sangat cepat, dan lainnya makan pakan khusus. Intinya mereka jadi masalah untuk ekosistem perairan setempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460125,
					"content": "Kalau ikan-ikan ini sampai menempati habitat makhluk setempat dan mengganggu ekosistemnya, kualitas air Fontaine bisa terpengaruh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460126,
					"content": "Dampaknya untuk kesehatan orang Fontaine baru akan terasa di masa depan. Bahkan rasa minuman macam Fonta bisa tiba-tiba diganti, dan itu bahaya sekali buat perekonomian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460127,
					"content": "Fonta tidak akan jatuh! Tidak hari ini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "Justru karena beginilah masalahnya kedengaran lebih parah! Masa kita diam saja sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460130,
					"content": "Kalau urusan mancing sih, kami nih orang lama ya. Mau dibantuin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460131,
					"content": "Ya! Dari tadi aku sudah nunggu kata-kata ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460132,
					"content": "Aku sudah bikin area penangkapan buat mancing semua spesies ikan asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460133,
					"content": "Nah, Honorary Knight dan Asisten Putih-nya! Giliran kalian maju. Aku dukung dari belakang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460134,
					"content": "Ini perasaan Paimon saja ... atau dia benar-benar paham banget sama posisi kita ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460128,
					"content": "Aku tidak begitu suka minum Fonta sih, tapi aku mengerti seberapa penting ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "Apa ya itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "Paimon lupa-lupa ingat, tapi kayaknya pernah dengar yang begituan di Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460112,
					"content": "Atau ... ada salah paham?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "Iya nih, dia enggak takut ditangkap sama sekali. Berarti antara kamu udah jago banget, atau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460104,
					"content": "Ka-Kamu pemburu liar ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}