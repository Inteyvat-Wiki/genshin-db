			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "Yelan, Paimon sampai tegang banget woi! Masa langsung maju gitu sih ... Gimana kalau ketahuan? Apa enggak takut mereka panik terus nyerang kamu gitu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Masalahnya bukan \"kalau\", Paimon. Aku yakin mereka langsung sadar, tapi terpaksa pura-pura demi keselamatan diri mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "Nah, si Pendana Gelap ini sudah di ujung tanduk. Kejadian di kapal tadi adalah usahanya untuk mengurangi kerugian dan cari aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Semua yang bisa dilacak harus dimusnahkan. Caranya? Tenggelamkan kapal. Barang-barang yang tadinya mau dilelang langsung dikirim ke dasar laut, lalu ... si Scamface dijadikan kambing hitamnya biar dia yang dicurigai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "Dia tidak mau barangnya sampai ke lelang, tapi kita dan Maison Gardiennage sudah memastikan sebaliknya. Nah, sekarang dia tidak punya pilihan selain terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Si Pendana Gelap bisa saja batal mengirim orangnya ke lelang, dan membiarkan barang-barangnya dibeli orang lain. Tapi ingat, harganya sudah dimahalkan sedemikian rupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "Cuma tinggal tunggu waktu sampai ada pembeli yang sadar nilainya terlalu tinggi, lalu melapor ke pihak berwenang. Sebagai penjual, Corder bisa dikenakan pasal perdata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "Nah, kalau sudah begitu si Pendana Gelap terpaksa memikirkan skema pencucian uang baru lagi. Jelek-jeleknya, dia kehilangan satu lagi agen yang bisa diandalkan di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "Kalau dia memutuskan untuk meneruskan skema lelangnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Tepat. Barang bukti masih utuh, tinggal biarkan si pembeli di lelang nanti menuntun kita makin mendekat ke si Pendana Gelap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "Oke, eh ... ah ... jadi ... artinya gimana? Boleh, boleh diulang ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Jangan tegang, aku yakin {NICKNAME} bisa jelaskan dengan bahasa yang lebih ramah-Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "Nah, ini sudah babak terakhir ya. Kita harus bisa memanfaatkan lelang ini sebaik mungkin, jadi ... harus siap semuanya kalau ingin beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "Bu Edler sudah pasang informan di lokasi. Surat undangan lelang ini untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "Kita ketemu lagi di Hotel Debord dua hari dari sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "Kita yang diuntungkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
