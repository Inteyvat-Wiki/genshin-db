			"dialogs": [
				{
					"id": 402010101,
					"content": "Bagus, kalian tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Gimana perkembangannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Sehari setelah kita masuk ke gudang penyimpanan mereka, dua anak buah si Pendana Gelap, Corder dan Doddamani, mulai memindahkan barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Kalian lihat kapal itu? Itu adalah kapal yang dipakai Doddamani untuk memindahkan barang. Beroperasi dengan kedok kapal penumpang sekaligus tongkang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Wah, gede juga kapalnya! Paimon bisa lihat barang-barangnya numpuk di dermaga. Dan kayaknya banyak juga orang yang nebeng sampai ke Pelabuhan Lumidouce ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "Gimana kalau barang itu bukan barang aslinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Dua langkah ke depan ya, aku suka. Kamu cepat belajarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Kalau Corder dan Doddamani curiga kegiatan mereka masuk pengawasan aparat, maka ada kemungkinan barang-barang yang kita lihat di sini isinya lain semua. Cuma umpan untuk menyesatkan pihak yang membuntuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Kita harus lebih waspada. Beberapa anggota mereka yang ditangkap membocorkan bahwa ada Treasure Hoarder veteran yang dijuluki \"Scamface\" terlibat dengan si Pendana Gelap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "Si Scamface itu berhasil kabur dari penjara dan sangat mahir menyembunyikan diri. Dari penyelidikan sebelumnya, sudah jelas bahwa dialah yang selama ini mengawasi mercusuar Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Aku akan mengitari area sini untuk memancing Scamface keluar, sementara kalian mengecek barangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Ingat, jangan mencolok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Paham. Aku akan hati-hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Ya! Dan Paimon akan berusaha sebisa mungkin untuk ... terbang lebih dekat ke tanah! Enggak bakal lebih tinggi dari bahunya {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Tenang, biar aku yang urus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Enggak periksa dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Ada pergerakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
