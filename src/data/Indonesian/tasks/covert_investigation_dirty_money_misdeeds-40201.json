			"dialogs": [
				{
					"id": 402010501,
					"content": "Oke, enggak ada yang palsu. Mereka was-was nih, ingin semua barangnya langsung sampai di Fontaine sekali jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Tapi kamu lihat tanda aneh di beberapa barangnya kan? Kira-kira apa ya artinya ... tanya Yelan yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Kalian menemui Yelan dan memberitahukan hasil penyelidikannya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010504
					]
				},
				{
					"id": 402010504,
					"content": "Kerja bagus. Soal lelangnya, Bu Edler juga berhasil mendapatkan info berguna. Kita bisa pastikan kalau target mereka ada di lelang yang akan diadakan di Hotel Debord dua hari dari sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010505
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010505,
					"content": "Tanda yang kalian lihat itu dibubuhkan menggunakan cat khusus. Hampir tidak bisa terdeteksi kalau tidak pakai alat khusus juga, seperti Alat Pengamatan dan Penggambaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010506
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010506,
					"content": "Sepertinya ini lambang Treasure Hoarder. Setiap anggota kelas berat di organisasi itu punya lambang sendiri, anggaplah seperti tanda tangan. Dan kalau mempertimbangkan yang sudah kita ketahui sampai sejauh ini, aku yakin ini kerjaan si Scamface.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010507,
						402010508
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010507,
					"content": "Kenapa si Scamface menandai barang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				},
				{
					"id": 402010509,
					"content": "Dari data yang kita lihat di arsip syahbandar, barang yang ditandai adalah ... pupuk Sumeru, kembang api produksi lokal, sabun, dan parfum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010510
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010510,
					"content": "Enggak ada yang aneh ... cuma hasil pertanian dan barang kebutuhan sehari-hari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010511,
					"content": "Pupuk, sabun, parfum ... ada yang tidak beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010512
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010512,
					"content": "Riskan, tapi aku mau selidiki kapalnya. Sekalian numpang ke Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010513,
						402010514
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010513,
					"content": "Kita sudah sejauh ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010515,
					"content": "Iya, kita kawal sampai kelar! Paimon penasaran ini mau diapain lagi sebenarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010516,
					"content": "Karena kalian sudah membuktikan diri sejauh ini, aku rasa silakan saja. Tapi aku kasih tahu dulu, setelah naik kapal itu kita pasti akan berhadapan sama si Corder dan Doddamani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010517
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010517,
					"content": "Jadi pastikan kalian sudah siap. Penyelidikan kali ini bisa beda dari yang sebelum-sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010514,
					"content": "Ikut dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010508,
					"content": "Scamface ini mau kasih peringatan? Atau apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				}
			]
		},
