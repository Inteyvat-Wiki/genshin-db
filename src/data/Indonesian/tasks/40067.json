			"trigger": {
				"objectNames": [
					"Dodocommunicator"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "Setiap kali aku bersamamu, aku akan melakukan ramalan, membaca, mengunci target, lalu menyelesaikan masalahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "Kamu dikelilingi oleh berbagai teman, rahasia, dan takdir di sekelilingmu, sungguh luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "Oh ya, masalah Leonard kan juga kita selesaikan bersama denganmu dan Fischl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Apa ini berarti hal baik untuk seorang astrolog?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "Yah kurang lebih. Semoga saja kali ini kita bisa menyelesaikan masalahnya bersama secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "Waktu kamu bilang \"bersama\", maksudmu kalian berdua atau kita bertiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Heh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "Oke, oke, jadi kita bertiga, itu sudah pasti! Kadang-kadang, Paimon menyuguhkan perspektif berguna yang sangat membantu untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Oh ya? Paimon mulai suka sama kamu deh, Mona jenius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "Terima kasih atas pujiannya! Aku memang selalu dikenal sebagai astrolog yang pintar dan menawan, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Yah, semuanya tentang kamu hebat kok, kecuali ... Ketawamu, tolong deh jangan mirip Fischl ... tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Ehem! Maaf ... aku memang sedikit banyak terpengaruh olehnya, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#Aku akan mengamati bintang-bintang. Tetap hubungi aku ya, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
