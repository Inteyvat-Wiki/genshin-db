			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Kazuha! Ketemu juga akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Waktunya pas sekali, aku baru saja selesai memikirkan tentang hidupku, dan aku pikir, aku sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "Apa pendapatmu tentang bonsai keluarga Kaedehara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Punya sejarahnya tersendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Dan bonsai ini adalah saksi dari penyesalan masa lalu keluargaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Tapi tidak masalah, perpisahan juga pertemuan. Kalau tidak di sini, pasti ada di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Aku suka dengan alam fantasi ini, seperti adegan film saja, setiap detik yang berlalu membuat tempat ini menjadi semakin menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Kata orang, astrolog tahu semuanya. Aku senang kamu suka dengan alam fantasi ini ... dengan aku sebagai salah satu pemerannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "Hei, bagaimana perasaanmu ... sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "Mein Fräulein menanyakan kebahagiaanmu saat ini, Tuan Kazuha. Dia berharap hatimu tidak terlalu sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Kita semua pasti punya kenangan yang enggak membahagiakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, benar juga. Terima kasih atas perhatian kalian semua. Tapi ini semua sudah jadi masa lalu bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "Waktu aku lihat bonsai ini, aku pikir, mungkin ... aku ditinggalkan sendirian di sini karena aku ditakdirkan untuk bertemu dengan kalian pada akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Kehidupan memang tidak sempurna, tapi setidaknya kamu sudah berusaha sebisamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
