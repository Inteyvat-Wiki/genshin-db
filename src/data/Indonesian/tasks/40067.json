				"objectNames": [
					"Dengarkan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "Hei kawan! Kamu baik-baik saja! Apakah mau naik dan bersembunyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Dengarkan"
				},
				{
					"id": 400671002,
					"content": "Bajak laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Dengarkan"
				},
				{
					"id": 400671003,
					"content": "Hah, benar, bajak laut! Katakan saja, mau ikut tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dengarkan"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
