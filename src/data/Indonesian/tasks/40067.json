				},
				{
					"id": 400671405,
					"content": "Dodoco ... Dodoco ... Dodoco ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "Dodocommunicator"
				},
				{
					"id": 400671406,
					"content": "Enggak dijawab ... Aneh, kenapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671407,
					"content": "Aneh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "Jangan-jangan, Venti hilang lagi? Atau dia enggak bawa bom saat pertunjukan? Atau mungkin dia mabuk dan tertidur di tengah jalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Hmm ... coba kita hubungi lagi besok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "Pengembara, Paimon, kalian di sini rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "Mona! Kamu sudah ngobrol sama Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Haha ... Dia sedikit murung aku rasa ... Mungkin berhubungan dengan alam fantasi yang kita lihat hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl yang merencanakan semua perjalanan ini, tapi aku punya firasat, dia sepertinya tidak mau melihat alam fantasinya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "Kenapa? Bukannya dia harusnya rindu hal-hal ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "... Entahlah, aku tidak yakin, tapi aku akan terus mengawasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671416,
					"content": "Aku hanya mau memberi tahu sesuatu kepada kalian. Baru saja aku melakukan ramalan di pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671417,
					"content": "Air ramalan masih tetap keruh, tapi aku samar-samar bisa merasakan sebuah kekuatan. Aku tidak tahu lokasi pastinya, tapi aku tahu kekuatan ini sedang berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671418,
					"content": "Bagaimana kamu rasakan kalau dilihat saja enggak bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671419,
					"content": "Sulit dijelaskan ... Ah! Mirip seperti kita sedang di sebuah ruangan, ada dinding yang retak, kita tidak tahu di mana retakannya, tapi kita bisa merasakan ada angin yang berembus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671420,
					"content": "Bukan cuma itu, ruangannya juga semakin dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671421,
					"content": "Oh! Oke! Jadi sekarang kamu mau cari tahu di mana retakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671422,
					"content": "Bisa dibilang begitu. Aku harus melihat retakan dinding sebelum memutuskan langkah berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671403,
					"content": "Yuk kita coba panggil dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
