					"Dodocommunicator"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "... Aku tidak pernah menyangka aku harus menghadapi masalah luar biasa seperti ini di tempat dengan pemandangan yang indah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "Bagaimana rasanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Lumayan. Tapi kalau kamu bisa bantu aku, mungkin perasaanku akan lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "Jadi apa yang perlu kita lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Umm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Hmmm ... tidak ada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "Tunggu. Kamu meremehkan kami?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "Tidak, aku baru sadar, meski kamu tidak banyak bicara, tapi kamu sudah melakukan banyak hal untuk kami dan sudah menyelesaikan banyak kasus juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "Kamu adalah teman yang dibutuhkan semua orang, aku tenang kalau kamu ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Meski kadang harapan bisa jadi tekanan, tapi seorang astrolog harus mengasah kemampuan pengamatan mereka dan dapat melihat kebaikan pada orang lain juga merupakan hal bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "Jadi kamu cuma mau puji kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "Itu semua cuma fakta, bukan pujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Oh, jadi kamu menolak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "Untuk mengakui kalau kamu baru puji kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Jangan tertawa dong. Kan aku sudah bilang kalau itu cuma penilaian objektif saja, bukan pujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#Aku akan mengamati bintang-bintang. Tetap hubungi aku ya, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
