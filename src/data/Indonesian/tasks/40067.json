				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "*hoam* Perjalanan hari ini jauh juga ya, Paimon jadi ngantuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671302,
					"content": "Kayaknya semuanya sudah capek ya. Ayo istirahat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671303,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671304,
					"content": "Hm? Ada apa, wajahmu terlihat kurang cerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671305,
					"content": "Tidak apa. Aku hanya sedikit lelah, mungkin karena perjalanan hari ini terlalu melelahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671306,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671307,
					"content": "Mein Fräulein, Anda baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671308,
					"content": "Oz, jangan cerewet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671309,
					"content": "Baik, Mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671310,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671311,
					"content": "Aku akan coba cari makanan. Kalau sudah capek, duduk saja, atau kalian juga boleh ikut denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671312,
					"content": "Aku ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671313,
					"content": "Aku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671314,
					"content": "Kalau semua orang bersemangat, kita juga ikutan yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671315,
					"content": "Kalau begitu aku dan Paimon juga akan membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "Wah! Hei, terima kasih sekali untuk antusiasnya, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671317,
					"content": "Aku rasa Fischl sepertinya kurang sehat. Mona, kamu kan dekat dengannya, mungkin kamu bisa coba ngobrol dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671318,
					"content": "Kamu juga sudah sadar ya! Aku baru mau ungkit ini waktu nanti sedang siap-siap memasak. Tentu, serahkan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671319,
					"content": "Baiklah, ayo kita siapkan makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671320,
					"content": "Mona mengedipkan matanya ke kami dan pergi menemani Fischl. Yang lainnya mencari bahan makanan untuk dimasak ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "Hmmm, harusnya sudah cukup. Nanti kita panggang saja. Lain kali kalau ada lewat ke lokasi kemah yang tidak ada orangnya, coba cari panci ya! Aku bisa masak yang lain kalau ada panci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671322,
					"content": "Wah, idenya bagus banget! Mungkin Xinyan bukan koki beneran, tapi kamu benar-benar tahu cara buat pelanggan senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671323,
					"content": "Duh, Paimon! Tidak masalah kok, aku cuma melakukan yang aku bisa saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671324,
					"content": "Kamu tidak tahu? Semua orang di Alcor bahkan menganggap Xinyan teman yang bisa dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671325,
					"content": "Kamu juga bisa diandalkan kok, Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671326,
					"content": "Haha, bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671327,
					"content": "Hm ... kalau begitu, ada yang ingin kusampaikan sebagai teman yang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671328,
					"content": "Dari penuturan kalian tadi, bisa disimpulkan kalau alam fantasi tadi dibuat berdasarkan pengalaman hidupku sampai saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671329,
					"content": "Dan seperti mimpi bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671330,
					"content": "Mungkin itu memang mimpimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "Kazuha, bukannya kamu ... selalu ingin membuat bonsai milikmu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671332,
					"content": "Benarkah ... Jadi semua itu berarti keinginanku terkabulkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671333,
					"content": "Apa mungkin kalian juga akan menghadapi situasi yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671334,
					"content": "Ya, aku rasa begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "Aku juga setuju. Tapi entah alam fantasi siapa yang akan muncul selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671336,
					"content": "Hahah! Andai aku bisa punya mimpi seperti ini juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671337,
					"content": "Kamu benar-benar mau yang seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671338,
					"content": "Mungkin punyaku nanti akan berhubungan dengan musik. Hehe, itu kesempatan yang bagus untuk menunjukkan bakatku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671339,
					"content": "Jadi maksudmu, kamu mau konser?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671340,
					"content": "Kenapa tidak?!? Aku rasa tidak ada musisi yang menghargai dirinya sendiri yang bisa diam saja di pulau ini. Coba lihat pulau indah ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671341,
					"content": "Optimis dan percaya diri sekali! Xinyan keren deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671342,
					"content": "#Oh ya! {NICKNAME}, Paimon lihat ada buah-buah yang tumbuh di tepi tebing, temani Paimon untuk ambil yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671343,
					"content": "(Apa lagi nih rencananya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "Maaf, aku mau bantu Paimon dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
