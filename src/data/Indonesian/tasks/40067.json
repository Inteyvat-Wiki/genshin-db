				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Jadi, Kazuha sudah lakukan yang Kazuha mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Ya, bisa dibilang gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "Kalian telah melihat masa laluku, juga mengucapkan selamat tinggal padanya. Saat itulah kisah-kisah itu menjadi sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "Hal terpenting dalam hidup seseorang adalah hubungannya dengan orang lain, bukan menyalahkan diri sendiri. Mereka yang terhenti di masa lalu, tidak akan memiliki masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "Jadi tolong kalian percaya, aku telah sampai di sini, juga akan terus melangkah. Mohon bantuan dari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
