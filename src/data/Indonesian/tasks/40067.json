			"dialogs": [
				{
					"id": 400671401,
					"content": "Jadi, hari ini rumah aneh itu ya, huh ... Dan ... bonsai ajaib? Duh, banyak sekali hal aneh hari ini. Menurutmu, kita perlu kasih tahu Venti enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "Sudah kuduga pasti Paimon bakal tanya ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "Dodoco ... Dodoco ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
