				},
				{
					"id": 400670402,
					"content": "Kenapa ... kamu mau membantuku? Aku seorang buronan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "Tentu karena Yashiro ... *uhuk* Ada yang membayarku untuk membawamu keluar dari Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Dengarkan"
				},
				{
					"id": 400670404,
					"content": "Tapi setelah ini, kamu harus berusaha sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dengarkan"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
