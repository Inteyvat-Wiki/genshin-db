			"dialogs": [
				{
					"id": 400670301,
					"content": "Apa yang terjadi di sini? Semuanya hancur berantakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670302,
					"content": "Demikian seperti yang tertulis, bahwa kejatuhan sebuah klan akan semakin mengenaskan apabila kedudukannya semula bergelimang kemuliaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400670303,
					"content": "Dan tidak ada seorang pun di sini. Aku rasa ini sudah tidak ada jalan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670304,
					"content": "Ayo pergi.",
					"roleType": "TALK_ROLE_NPC",
