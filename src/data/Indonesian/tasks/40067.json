			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "Seharusnya ada tanaman mati di dalam bonsai itu. Tapi kita tidak menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "... Saat kalian tidak di sini, aku banyak memikirkan tentang hal itu. Sekarang aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Ini adalah alam fantasiku, bonsai yang kosong melambangkan suasana hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Ketika hatimu \"bersih\", maka segala yang ada di kolong langit pun \"bersih\"; Ketika hatimu \"kosong\", maka segala yang ada di kolong langit pun \"kosong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "Bersih dan kosong adalah suasana hatiku sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Meski, aku tidak akan mengatakan kalau aku tidak menyesal, tapi tidak menanggung beban kan berarti \"kosong\" juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "Itu sebabnya bonsai ini muncul dalam fantasiku dan memberikan kesempatan untuk mewujudkan harapanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Tidak disangka dalam lubuk hati terdalam, aku juga ingin membuat bonsai milikku sendiri ... untuk melanjutkkan tradisi Klan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
