		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "\"Belajar teknik Menembus Sinar. Tidak sengaja menghancurkan orang-orangan jeraminya ... tidak punya uang dan barang. ... Aku punya rencana bagus, aku anyam sendiri saja dari jerami ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080302,
					"content": "\"Mengumpulkan jerami.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080303,
					"content": "\"Menganyam jerami. Lelah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080304,
					"content": "\"Belajar teknik Menembus Sinar. Tidak sengaja menghancurkan orang-orangan jeraminya ... Lebih baik belajar teknik pedang dulu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080305,
					"content": "Lanjut membaca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "\"Menganggur. Selagi duduk di depan halaman sambil mengamati hujan, aku merasa sedikit lapar ... Tiba-tiba aku dapat inspirasi saat memikirkan yang kulihat kemarin. Kalau pakai pedangku ... (tidak terbaca) kunamakan 'Membelah Hujan', nanti kucoba lagi di lain hari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080308,
					"content": "\"Belajar teknik Membelah Hujan, tapi tidak sengaja terjatuh. Untungnya tidak terluka parah ... Aku punya rencana bagus, lebih baik gali lubang dan buat kolam di bawah pilar, supaya tidak jatuh dan terluka lagi, sekaligus bisa memelihara ikan untuk dijadikan makanan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080309,
					"content": "\"Bertemu dengan nelayan, ada belasan ikan di pasar ... Aku coba memasaknya, ikannya berdaging dan lezat, tiada duanya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080310,
					"content": "(Lebih dari sepuluh halaman selanjutnya berisi beragam cara mengolah ikan, yang dicatat dengan sangat detail. Beberapa bahkan dilengkapi ilustrasi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080311,
					"content": "\"Tidak sengaja terjatuh saat belajar teknik Membelah Hujan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080312,
					"content": "\"Sukses.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080313,
					"content": "Lanjut membaca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "\"Menggunakan tombak dan pedang seperti menggunakan (tulisan tidak jelas, di sebelahnya ada catatan dari Master ketiga: layaknya membalikkan telapak tangan) ... di mana ia berhenti, di situlah arti kebijaksanaan ... Bagaimana cara memberikannya? Bagaimana cara memberitahunya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080316,
					"content": "\"Renovasi perpustakaannya. Desain ... di dalam ... dan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080317,
					"content": "\"Gunakan <color=#00E1FFFF>mata</color> untuk melihatnya, gabungkan <color=#00E1FFFF>gulungan kebijaksanaan dari seluruh penjuru</color> dengan <color=#00E1FFFF>bilik di seluruh penjuru</color>, lalu kamu bisa ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080318,
					"content": "(Halaman selanjutnya dicoret-coret, tidak bisa dibaca. Di sampingnya ada catatan dari Master ketiga: Ini nasihat bagi generasi selanjutnya untuk membaca dengan menyeluruh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080319,
					"content": "Lanjut membaca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "\"Sembuh dari luka. Anak Bai itu memasak domba dan ikan karper untukku. Dagingnya empuk, enak, dan tidak amis. Aku pun menanyakan cara memasaknya ... aku akan turunkan caranya dan ... menulisnya di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080322,
					"content": "(Halaman selanjutnya mencatat berbagai cara memasak daging domba dengan sangat detail.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Catatan Guhua\""
				},
				{
					"id": 711080320,
					"content": "Sudah cukup lah. Kacau gini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "Sudah cukup. Proses latihannya sama sekali tidak dicatat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "Cukup omong kosongnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
