			"dialogs": [
				{
					"id": 150470101,
					"content": "Kalian sudah datang! Staf-nya ada urusan, tapi aku mengerti cara mainnya, kok ... Eh maksudnya cara selesaikan uji cobanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Mantap, ajarin kami dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Sederhananya, satu orang naik perahu, yang satunya lagi kirim sinyal ke staf Saurian. Kita harus kerja sama bawa perahunya sampai ke tujuan dengan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Aku lumayan percaya diri, soalnya kalau bicara soal kerja sama, {NICKNAME} dan aku kan sudah klop banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Oh ya? Hati-hati loh, yang paling percaya diri biasanya yang duluan kebalik perahunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Hush, Paimon, jangan ngomong sembarangan begitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Oke, oke ... Kalau begitu, Paimon doakan ... perahunya enggak oleng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Hehe, jelas dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "Aku mau coba naik perahunya! Soalnya sudah terbiasa sama tantangan selancar, jadi asyik juga kalau coba yang beda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "Aku juga bosan naik Waverider terus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Tuh kan, kita klop banget! Terbukti deh kita punya ikatan khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Aku sudah enggak sabar pompa baju renang pelampungku dan langsung loncat ke perahu!",
