			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "Halo, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Tentang barang pemberian di kuil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "Oh ... Kuil ya, aku juga pernah ke sana kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Hehe, aku ingin dewa memberkati aku, supaya ketika dewasa nanti aku bisa melihat dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Yah, doa memang sudah dipanjatkan, tapi aku tetap harus kerja keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "Papa mama bilang, kalau mau keliling dunia, aku harus punya uang banyak dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Asal dewa memberkati, semuanya pasti berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "Aduh, tidak bisa bilang seperti itu. Lagi pula jika aku benar-benar pergi berkelana ke luar, apa Archon kami masih bisa melindungiku di luar sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "Papa mama pernah bilang kalau memberi pada dewa itu tujuannya supaya hati ini tenang. Kalau ingin keinginan tercapai, ya tetap harus kerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "Aku enggak pintar ngejelasin sih. Kalau masih penasaran, tanya Kak Nanatsuki aja. Dia ngerti banget loh soal beginian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "Uhh ... Ya sudah. Kak, kita ke Kak Nanatsuki lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "Shouta? Kenapa mukamu begitu? Kamu ditindas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Kak Nanatsuki tahu kan soal orang-orang yang memberi ke kuil supaya diberkati sama dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "\"Kalau kita memberi dengan sungguh-sungguh, dan menyenangkan hati para dewa, maka segala yang kau inginkan, akan diberikan padamu\" ... begitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "Ha? Kenapa tiba-tiba tanya ini? Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "Begini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Shouta ... Kamu begitu semangat ingin memberi ke kuil karena alasan ini toh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "Iya, aku sudah memberi dengan sepenuh hati! Tapi semua yang aku kasih ke kuil selalu dicuri orang ... Aku takut dewa marah dan enggak mau menjagai aku lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "Aduh, anak ini ... Tenanglah, dewa tidak akan marah cuma karena hal sepele begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "A-Asli? Syukurlah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "Tapi dewa juga tidak akan sengaja turun tangan hanya karena sedikit pemberian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "Orang memberi dan memohon berkat bukan karena ingin doa mereka dikabulkan. Mereka ingin supaya hati mereka mantap dan keyakinan mereka tumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "Keyakinan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "\"Doa telah dipanjatkan di hadapan para dewa, baiklah kita semua berusaha agar keinginan kita dapat tercapai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "\"Dengan perlindungan dan berkat para dewa, apa saja yang diusahakan pasti berhasil!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "Keyakinan itu telah tumbuh, dan orang-orang mau melakukan yang terbaik untuk mewujudkan keinginan mereka. Itulah kenapa orang-orang memberi ke kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "Karena ... semuanya tetap hasil usaha dan kerja keras. Berdoa saja tanpa berusaha itu sia-sia. Misalkan dewa mau menolong pun, mungkin dewa akan bingung tolongnya harus bagaimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "Ta-Tapi! Dewa pernah langsung tolong aku waktu aku memberi ke kuil tempo hari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Terus ada lagi kasus kebakaran, om yang ingin jadi lebih kuat, manga yang aku ingin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Masih bahas dewa ini anak ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Yah ... benar juga. Dewa yang satu ini punya cara sendiri untuk mengabulkan permintaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Tapi, tapi ... Ujian tetap ada, si jahat tukang tindas juga. Dia masih saja bawel, \"ayo bikin pr\", \"jangan lupa belajar\", gitu terus setiap hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Eh? \"Si jahat tukang tindas\", siapa namanya? Kapan dia muncul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Namanya ... Dia ... Eh, siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Kalau enggak salah, dia masuk sekolah barengan sama aku ... Eh, kayaknya lebih awal deh ... Atau lebih telat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Aneh ... Kok bisa lupa sih? Aku cuma ingat dia selalu bawel suruh aku belajar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Ah, berarti dewa menjawab doamu, dan sedang membantu kamu mengalahkan rasa tidak sukamu terhadap ujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "Ma-Maksudnya, si tukang tindas itu dikirim sama dewa? Biar aku rajin belajar???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "TIDAAAK! Aku enggak mau belajar, enggak mau ujian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "WAAA! Itu dia! Di sana! Dia datang dari ujung jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "Mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "Kakak, masa enggak kelihatan sih? Dia datang bawa setumpuk kertas ujian! HUAAA!! Aku enggak mau ujiaaaaaan!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Wah, dewanya sungguh berdedikasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "Dewa yang satu ini memang punya cara sendiri ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Yah, dengan bimbingan dewa, anak itu seharusnya bisa lulus ujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Dan sepertinya, dewa juga sudah tidak kuat dengar anak itu merengek terus di depan kuil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "Eh, kenapa tiba-tiba jadi banyak daun ya? Padahal tadi tidak ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "Tidak seperti \"campur tangan dewa\" yang kubayangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "Enggak ada siapa-siapa ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(Masih saja keras kepala.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}