			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Treasure Hoarder Sarkastik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "Maling jahat! Dewa enggak jawab aku karena barangnya diambil sama kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "Barang? Oh, maksudnya yang ada di kuil itu ya? Astaga, yang begituan kamu kasih juga kami tidak mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Treasure Hoarder Sarkastik"
				},
				{
					"id": 728030203,
					"content": "Lagi pula, justru aneh kalau dewa mau jawab doamu setelah dikasih sampah jelek begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Treasure Hoarder Sarkastik"
				},
				{
					"id": 728030204,
					"content": "Kamu ... jangan asal bunyi! Enak saja bilang pemberianku sampah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "Sudah, aku tidak ada waktu buat main-main sama kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Treasure Hoarder Sarkastik"
				},
				{
					"id": 728030207,
					"content": "Pemberianku buat dewa ... bukan sampah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "Boleh kasih tahu kami apa doamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Boleh ... Lagian sudah begini juga jadinya, doaku mana mungkin dijawab ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "Sebenarnya kedua permintaanku bukan yang aneh-aneh. Yang pertama, aku enggak mau ikut ujian lagi! Kalau enggak ada ujian, aku enggak bakal dimarahi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "Lalu yang satunya ... supaya si jahat di sekolah berhenti menindasku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "Aku juga tidak suka ujian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "Iya kan! Ujian sungguh menyiksa ... tapi si jahat itu lebih menyiksa daripada ujian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Dia sering lihat aku berdoa di kuil. Terus dia kayaknya dengar aku mohon biar enggak usah ikut ujian lagi, eh dia langsung pergi ke guru lalu tanya hasil ujianku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "Sejak itu, dia terus saja bilang kalau aku lebih baik perhatikan saja pelajaran di kelas daripada berdoa di kuil. Dia juga bilang kalau aku merengek melulu, dewa juga bisa ngambek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Terus katanya, aku ... payah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "Memang tidak bagus kalau terlalu mengandalkan dewa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Tapi kan orang dewasa, kalau lagi susah, sering kasih pemberian kuil juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Memanjatkan doa itu boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "Uhh ... Aku jadi bingung. Bukannya orang-orang kasih pemberian ke kuil itu buat minta tolong sama dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Kita tanya orang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "Ya sudah ... toh sekarang keinginanku juga tidak akan terkabul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "Tapi masalah yang dihadapi harus diselesaikan sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "Si jahat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Teman sekelas. Di-Dia beneran jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280304,
