			},
			"dialogs": [
				{
					"id": 756640101,
					"content": "#{NICKNAME} dan Paimon! Akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640102
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640102,
					"content": "Selamat datang di arena utama Ujian Bunga Mekar. Kepala suku bilang kalian mau daftar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640103
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640103,
					"content": "Ya! Tapi kami masih kurang paham, ujiannya tuh kayak gimana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756640104,
					"content": "Kalau begitu, aku akan jelaskan peraturannya secara singkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640105
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640105,
					"content": "Ujian Bunga Mekar terbagi menjadi dua, yaitu \"Pertempuran Penyerangan\" dan \"Pertempuran Pertahanan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640106
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640106,
					"content": "Pertempuran Pertahanan lebih sederhana, cukup hentikan serangan musuh. Nah, menyerang lebih rumit. Ketika pertahanan suku sudah berhasil ditembus, kalian harus membunyikan terompet dan melancarkan serangan balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640107
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640107,
					"content": "Untuk membuat kompetisi lebih menarik, kami menambahkan alat ritual khusus. Pihak penyerang bisa mengisi tenaganya untuk menghancurkan penghalang pihak bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640108
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640108,
					"content": "Dan meski ini tetap sebuah kompetisi, kita semua tidak mau ada kekerasan atau keributan yang tidak perlu ya. Yang rusak harus diperbaiki, dan kalau ada monster, tolong sekalian dibasmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640109
					],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640109,
					"content": "#Wah, Paimon pusing. {NICKNAME}, kamu sudah paham semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640110,
						756640111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756640110,
					"content": "Kurang lebih lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				},
				{
					"id": 756640112,
					"content": "Santai, kalau ada pertanyaan, silakan balik lagi. Kompetisinya tidak rumit, nanti kalau sudah coba sendiri juga pasti langsung paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ballo"
				},
				{
					"id": 756640111,
					"content": "Uhh, ya singkat padat sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				}
			]
		}
	]
}