			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "Akhirnya tumbang. Tapi Paimon tidak melihatmu menggerakkan satu jari pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Siapa sebenarnya kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Seorang pemancing ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Tidak masuk akal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Kamu benar, kedengarannya tidak masuk akal. Tapi di dunia ini memang terdapat banyak hal yang tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Contohnya seperti koki di penginapan itu. Dia dulunya seorang petarung yang suka melayangkan pedang. Sekarang dia mencintai dunia masak. Wajahnya kelihatan sadis, tapi hatinya sebenarnya baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "Contohnya pemilik Wangshu Inn itu. Dia mengaku dirinya adalah orang Mondstadt, tapi tidak ada orang di Mondstadt yang mengenalinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Dan... kamu juga. Kamu tidak mempunyai Vision tetapi bisa menggunakan kekuatan elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Beberapa orang memang terlihat tidak masuk akal, tapi mereka tidak menakutkan. Jangan cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Ini tanda ucapan terima kasihku untukmu. Simpanlah baik-baik. Aku mau lanjut memancing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}