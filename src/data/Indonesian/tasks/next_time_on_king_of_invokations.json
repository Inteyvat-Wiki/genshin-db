					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "Pasti masih hebatan kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "Okelah kalau begitu. Ini, kamu pakai Dek serangan cepat ini.",
