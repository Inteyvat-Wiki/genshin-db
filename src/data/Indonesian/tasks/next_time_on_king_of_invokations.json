						230350604
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350604,
					"content": "Bukankah tadi kamu janji main Genius Invokation TCG denganku sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350605,
					"content": "Eh?! Aku, aku kurang pandai main, uh ... Pengembara! Kamu pastinya lebih pandai main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350606,
						230350607
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350606,
					"content": "Aku belum pernah main.",
