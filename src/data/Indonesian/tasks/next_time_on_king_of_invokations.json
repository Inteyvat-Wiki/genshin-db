			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "Hmmm, kombinasi kartu ini bagus juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Tapi, beberapa kartu ini terlalu lemah untuk menghadapi kecepatan serangan yang cepat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Cyno, kamu lagi ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? Aku tidak sangka akan ketemu kamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Aku sedang mencoba menyusun sebuah Dek kartu Genius Invokation TCG yang berisikan kartu serangan pelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Dalam pandanganku, pemain yang menggunakan set kartu ini akan memiliki banyak sumber daya dan bermacam kartu yang kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "Tapi jujur saja, tidak mudah untuk menyusun Dek seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Sekarang ini pemain di Genius Invokation TCG lebih suka menggunakan Dek berisikan kartu serangan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "Di awal permainan, mereka menyerang dengan memainkan beberapa kartu sekaligus. Dengan begitu mereka bisa mengalahkan lawan dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Tapi aku kurang cocok dengan taktik ini. Aku lebih suka mengumpulkan sumber daya di setiap kesempatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "Selalu sigap di setiap kesempatan, mempertebal keunggulan, dan mengamankan kemenangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Ya! Betul seperti itu! Bagus, bagus sekali! Kamu cocok menjadi protagonis di novelku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Maaf! Uh ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Ini adalah Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "Pengarang novel \"Sang Raja Invokation\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Halo, Mahamatra Agung. Kurasa kamu belum pernah mendengar tentangku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "Novelmu sangat bagus, aku sudah pernah membacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Sungguh sebuah kehormatan kamu menyukainya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "Aku sangat terkesan dengan protagonis di dalam novel itu. Setiap kali dia terjebak di situasi sulit, dia selalu bisa mendapatkan kartu yang tidak ada di Dek-nya dengan cara apa pun, dan berhasil menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Aku mengerti ini bergantung pada alur ceritanya, tapi menurutku cara menang seperti ini menyimpang dari dasar permainan Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "Ah, mengenai ini ... Sebenarnya aku juga sering main Genius Invokation TCG, tapi aku tidak pandai memainkannya ... Dan lagi, kalau aku menulis novel pertarungan kartu tanpa sedikit memberikan bumbu-bumbu cerita, kisahnya tidak akan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
					"content": "Ah, begitu ya? Kebetulan aku baru selesai menyusun dua Dek kartu, bagaimana kalau kita main Genius Invokation TCG sebentar? Siapa tahu kamu bisa mendapatkan inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350423,
					"content": "(Sekarang mereka mau main kartu ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Orang ini cuma mau main kartu saja ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "Eh? Main ... denganmu? Aku mau sih, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350426,
					"content": "Biar aku jelaskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "Tentang permintaan Fukumoto ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Pengembara menjelaskan permintaan Fukumoto ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "Kamu mau aku menjadi model untuk ilustrasi \"Sang Raja Invokation\"? Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350430,
					"content": "Bagus! Pengembara, cepat bantu aku ambil foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
