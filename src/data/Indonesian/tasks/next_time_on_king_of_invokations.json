				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Sshhh ... Itu Tuan Cyno, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Kalau dilihat dari pakaian, rambut, dan warna rambutnya ... Memang cocok jadi protagonis terbaik dalam novel game kartu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Enggak masuk akal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Aduh, kamu percaya saja pada instingku kalau soal pasar novel. Tapi, sekarang bukan waktunya membahas hal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "Pengembara, kumohon bantu aku meminta Tuan Cyno jadi modelku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "Aku masih kenal banyak protagonis loh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Beneran? Bagus kalau gitu, aku sedang mempersiapkan novel \"Sang Raja Invokation\" bagian tiga. Aku tidak akan menulisnya berdasarkan cara bermain Genius Invokation TCG lagi kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "Aku memutuskan untuk membuat cara bertarung yang baru. Contohnya ... semua kartu ditangguhkan di atas medan bermain. Pemain harus terus bertarung sambil mengumpulkan kartu, di saat yang sama, juga harus menghentikan lawan mengumpulkan kartu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Hahaha! Memikirkannya saja sudah terasa menarik! Tapi, sekarang bukan waktunya omongin ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
