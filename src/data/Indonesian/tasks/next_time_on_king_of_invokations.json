					"nextDialogs": [
						230350609
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350609,
					"content": "Dan aku pakai Dek serangan pelan ini, aku mau lihat apa aku bisa menang melawanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350610,
					"content": "Aku akan melakukan yang terbaik, Tuan Cyno ....",
