			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "*huff* Rasanya ingin pulang ke Inazuma ... Kenapa aku bisa ketemu masalah seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "Pengembara? Aduh, jangan ungkit novel deh. Aku rasa orang-orang yang mengerjakan Genius Invokation TCG itu tidak akan bertahan lama lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "Menurut seorang pelajar yang memiliki hubungan baik denganku, mereka menemui bermacam masalah saat mengerjakan Genius Invokation TCG ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Contohnya, suatu hari seorang pelajar dari Haravatat tiba-tiba menanyakan suatu pertanyaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Dia bilang kalau deskripsi efek kartunya terlalu panjang. Mungkin saja bisa membuat orang yang tidak biasa membaca teks yang panjang, mengurungkan niatnya untuk memainkan Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "Para pelajar sudah biasa membaca teks yang panjang, jadi hal ini bukanlah masalah bagi mereka. Tapi, mungkin saja ada pemain yang tidak suka membaca teks yang panjang dan karenanya tidak memainkan Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "Jadi dia menyarankan untuk mempersingkat teks di sebagian kartu sampai setengahnya supaya pemain lebih praktis membacanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "Sa-Sampai harus gitu memang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Aku rasa sebenarnya ini bukan masalah ... Tapi, para pelajar sedang serius meneliti masalah ini. Lagi pula, hal ini berkaitan dengan pengalaman bermain pemain, dan mereka tidak ingin ada masalah sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Sudahlah, jangan bicarakan hal ini dulu ... Masalah yang lebih besar saat ini adalah, mereka sebelumnya berjanji untuk membantuku mencari model dan terjadi masalah juga dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Bukannya aku pernah memberi tahu kamu kalau ada seorang pelajar bilang mereka akan membantuku menghubungi Tuan Tighnari dan Tuan Cyno, dan meminta keduanya menjadi model?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Tapi, sekarang mereka begitu sibuk, aku rasa aku tidak bisa mengandalkan mereka untuk saat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "Terus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Meski pelajar yang menerimaku tidak dapat membantuku dalam hal ini, tapi dia memberiku sebuah ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "Dia bilang Tuan Cyno kadang-kadang pergi ke Kafe Puspa untuk main kartu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Kalau aku mau ... bisa untung-untungan sih pergi ke kafe itu dulu. Atau, menunggu mereka ada waktu kosong baru membantuku menghubunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "Kalau gitu, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "Aduh, novelku sudah selesai kutulis kalau tunggu mereka ada waktu kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Jadi, aku akan berusaha sendiri saja dan lihat apa aku bisa menemukan Tuan Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Tapi, misal aku beruntung dan bertemu dengan Tuan Cyno. Bagaimana aku akan memperkenalkan diri kepada Tuan Cyno? Aduh, bikin pusing saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Aku bisa bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Asli?! Mantap! Tapi, kok kamu bisa ... Ah sudahlah, aku tidak akan menanyakan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "Jangan buang waktu lagi, ayo kita segera ke Kafe Puspa. Aku harap bisa bertemu dengan Tuan Cyno ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "Aku akrab dengan Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Gimana cara menghubungi mereka ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Kepanjangan gitu memangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Apakah penulisan novelmu enggak lancar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
