				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "Salam, pendekar dari tanah asing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270102,
					"content": "Kita ketemu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "Betul, kita jumpa lagi! Sosokmu masih tetap gagah dan keren seperti dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270106,
					"content": "Ehem, intinya kali ini ada sekelompok orang yang diam-diam mengadakan Hyakunin Ikki, lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270107,
					"content": "Hyakunin Ikki itu apa yah, aku lupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "Hyakunin Ikki itu festival yang tadinya diadakan oleh para pengikut Tengu, untuk memperingati sesuatu atau untuk menyelesaikan perkara lewat pertarungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270109,
					"content": "Selama festival, baik pendekar petarung atau monster sekali pun akan melupakan latar belakang, jati diri, dan prasangka, demi pertarungan buas untuk semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270110,
					"content": "Pendekar yang berhasil mengalahkan semua lawannya akan mendapatkan harta yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270111,
					"content": "Yah, tapi semenjak para pengikut Tengu diberangus, aku tidak tahu siapa yang menyelenggarakan acara ini dan tidak tahu juga berasal dari mana hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270115,
					"content": "Tempat ini terlalu ramai, tidak baik membicarakan hal ini. Tolong ikut denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270116,
					"content": "Kayabuki Ikkei membawamu ke sebuah pulau kecil di luar Kota Inazuma ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "La ... gi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "Betul sekali. Mungkin kehebatanmu di arena mengundang lebih banyak orang ikut serta. Jujur ya, bahkan penontonnya saja kelihatan kayak ingin ikutan masuk ke arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270114,
					"content": "Dan aku sama sekali tidak sangka kalau Hyakunin Ikki berikutnya akan diadakan secepat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270104,
					"content": "Kamu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "Ah? Lupa ya sama aku? Maaf, mungkin aku terlalu fokus menulis tentang pertarunganmu di Hyakunin Ikki terakhir, sampai kurang keras teriak kasih semangatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
