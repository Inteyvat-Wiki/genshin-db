				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270201,
					"content": "Sudah sampai, ini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270202,
					"content": "Seperti biasa: Masuk ke gerbang aneh ini, dan kamu akan tiba di arena Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270203,
					"content": "Mencurigakan, seperti biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "Dan aku tetap akan membukukan kehebatanmu dan bersorak sorai dari bangku penonton, seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270208,
					"content": "Oke, buruan mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "Nah, semoga hari ini bisa lihat ilmu pedangmu yang keren itu sekali lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270209,
					"content": "Dih, repot seperti biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "Hyakunin Ikki, gimana aturannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "Aturannya sih kurang lebih sama. Monster, petualang, dan pendekar dari seantero Teyvat akan memuaskan hasrat pertarungan mereka di arena ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270206,
					"content": "Dan tentunya, peserta diperbolehkan membawa teman dan rekan sebanyak-banyaknya. \"Hyakunin\" itu artinya \"ratusan orang\". Semakin banyak, semakin seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		}
	]
}