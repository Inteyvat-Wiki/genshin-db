					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "Benar-benar hebat! Terima kasih atas bantuan kalian. Oh iya, ini hadiah yang kujanjikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540702,
					"content": "Asik, Mora! Eh? Kapan kamu ganti baju ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540723,
					"content": "Saat kamu mulai bertempur ... Ah, ya memang tak penting sih. Tapi kami memang harus ganti baju, kalau tidak nanti kalian bakal hajar kami lagi saat sibuk di tengah pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540703,
					"content": "Millelith akan selalu mengingat jasamu. Ah, sesuai kesepakatan kita, coba lihat-lihat apa ada yang kamu butuhkan dari sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540704,
					"content": "Oh, maksudku selain barang-barang rampasan yang mau kita sita ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540705,
					"content": "Selamat ya, misinya sukses besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "Haha, tentu saja. Semua ini berkat bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540709,
					"content": "Ah, jadi maksudku ... yang penting kamu tidak macam-macam seperti para maling ini, kami juga pasti tidak akan datang cari kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540710,
					"content": "Huh, jangan samakan kami sama mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540711,
					"content": "Haha, iya, kamu benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540712,
					"content": "*huff* Oke kembali lagi ke topik utama ... Mau jahat atau baik, orang yang bisa mengendalikan elemen sepertimu tetap harus diwaspadai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540713,
					"content": "Tugas yang biasanya butuh berbulan-bulan pasti bisa diselesaikan dengan cepat oleh kalian ... tapi kalau dibuat untuk kejahatan, pasti juga akan mengerikan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540714,
					"content": "Jadi menurutku, tidak punya Vision juga bukan hal buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540715,
					"content": "Aku pernah melihat orang yang mengorbankan hidupnya demi kekuatan, tapi pada akhirnya hanya jadi alat dan boneka orang lain. Apakah hidup begitu layak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540716,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "Sebagian besar orang di dunia ini tidak memiliki Vision, dan yang bisa memahami dan melindungi mereka semua ... juga orang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540718,
					"content": "Sebagai orang biasa sepertiku, suatu kehormatan untuk bisa bertanggung jawab dan melindungi orang-orang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540719,
					"content": "Kalau tiba suatu hari di mana tidak ada lagi Vision dan Adeptus pelindung Liyue juga sudah tiada ... Kurasa aku tetap akan melanjutkan tanggung jawabku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540720,
					"content": "Ah, maaf ... tanpa sadar aku jadi terus bicara sendiri. Aku ngoceh terlalu lama ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540721,
					"content": "Oke, kami masih harus memeriksa dan mencatat barang rampasan ini, sudah dulu ya mengobrolnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540722,
					"content": "Aku mewakili semuanya mengucapkan terima kasih sekali lagi. Semoga perjalananmu lancar selalu. Selama Millelith tetap tak gentar, keadilan akan tetap berdiri tegak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540707,
					"content": "Berarti ... kita tidak jadi masuk penjara, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "Tentu saja, kalian kan sudah bantu Millelith. Mana berani kami memenjarakan seorang pahlawan yang membantu memecahkan kasus penyelundupan besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				}
			]
		},
