	"talks": [
		{
			"id": 7105401,
			"completionStepIds": [
				7105402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
