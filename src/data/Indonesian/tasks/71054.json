			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "Stop, stop! Biar kami jelaskan dulu!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540102,
					"content": "Kalian ini Treasure Hoarder, kan? Menyerah saja baik-baik, tidak ada yang perlu dijelaskan segala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540103,
					"content": "#Aku Yanbo, Sersan Millelith untuk yurisdiksi area Chasm. Sebuah kehormatan bisa bertemu denganmu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540104,
					"content": "Dan ... makhluk terbang yang sangat terkenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540105,
					"content": "Hei, hei, hei! Sebut Paimon pake nama dong! Ingat baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540106,
					"content": "Haha, maafkan ketidaksopananku. Aku benar-benar minta maaf, tapi sepertinya ada sedikit salah paham di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540107,
					"content": "Jadi ... kalian bukan Treasure Hoarder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "Tentu saja bukan, malah sebaliknya kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540112,
					"content": "*Uhuk* Yah kamu tidak salah sih karena tempat ini tadinya memang sarang Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540113,
					"content": "Setelah para pekerja pergi, Treasure Hoarder langsung memanfaatkan kesempatan dalam kesempitan. Awalnya mereka hanya menyelundupkan bijih besi dan Glazed Sand Crystal sambil kejar-kejaran dengan anggota patroli kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540114,
					"content": "Belakangan ini mereka semakin menjadi-jadi. Mereka memakai gudang tua bekas para pekerja untuk membuat perhiasan murahan lalu menjualnya! *huff* Hatiku hancur setiap kali mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540115,
					"content": "Kenapa memangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "Perhiasan murah seperti itu hanya bisa menipu turis yang pertama kali datang ke Liyue, atau orang yang kurang pintar. Lalu mereka pasti masuk ke pasar dengan harga murah, mungkin mau mencoba bersaing dengan beberapa merek besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540117,
					"content": "Tapi kan mereka dari awal tidak punya merek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540118,
					"content": "Haha, kamu benar. Mengambil semua benda ini buat ambil keuntungan, benar-benar rendahan sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540119,
					"content": "Jadi datanglah kami ke sini, membereskan Treasure Hoarder yang ada di sini, menyamar jadi seperti mereka untuk memancing mereka datang ... Yah, itu sudah kejadian yang cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540120,
					"content": "Sekarang kami dapat informasi kalau ketua mereka bekerja sama dengan Fatui. Mereka dicurigai memperdagangkan barang berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540121,
					"content": "Tentang kerja sama Fatui dan Treasure Hoarder ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "Meskipun kita sudah pernah mengalahkan mereka, tapi masih ada sisa-sisa dari mereka di alam liar Liyue ... Mereka ini sangat profesional dan tangguh, tidak boleh diremehkan. Kita harus serius menghadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540123,
					"content": "Kalau Treasure Hoarder sampai bekerja sama dengan mereka untuk melawan kita ... bisa menimbulkan risiko keamanan yang besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540126,
					"content": "Pokoknya kami sudah menyiapkan semuanya, hanya kurang satu hal. Kita hanya tinggal menyapu bersih mereka semua, lalu kita bisa tahu apa tujuan mereka sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540127,
					"content": "Lalu tidak disangka kalau kami datang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540128,
					"content": "*huff* Kami tahu kalian memang hebat, tapi tak disangka 'sekuat' ini ... Kalian bahkan sudah mengalahkan lebih dari setengah pasukanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540129,
					"content": "Tentu saja ada alasan lain kenapa kami tinggal di sini ... Batu Kunci Formasi Tujuh Bintang ada di sini. Kami tidak boleh membiarkannya jatuh ke tangan penjahat macam Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540130,
					"content": "Ah, maaf ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "Hahaha, tidak apa! Bukan salah kalian kok, salah kami ... Kami sudah dapat perintah untuk tidak menghalangimu, tapi tak kusangka kalian datang secepat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540134,
					"content": "Wah, orang ini cukup santai ya. Kalau begitu kami sudah boleh pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540135,
					"content": "Aku tidak menyalahkan kalian, tapi bukan berarti kalian bisa lepas dari hukum Liyue. Hehe, maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540136,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540137,
					"content": "Lain kali bicara dulu sampai selesai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "Hmmm, coba kulihat ya. Memprovokasi pertengkaran, mengganggu Millelith menegakkan hukum, mencoba merusak Formasi Tujuh-Bintang, oh ... dan merusak tempat kejadian penyelidikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540140,
					"content": "Walaupun Millelith bisa memberi pertimbangan khusus ... Ah selamat, kamu akan ada di Liyue sekitar 5 sampai 10 tahun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540141,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540142,
					"content": "Aku bisa sewa pengacara kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "Uh, iya kami minta daftar pengacara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540146,
					"content": "*Uhuk* Tapi! Tunggu aku selesai bicara dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540147,
					"content": "Tapi, warga yang taat atau pendatang asing yang dapat membantu pasukan Millelith juga berhak untuk mendapatkan imbalan atau hadiah ... ini juga hukum Liyue yang sah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540148,
					"content": "Jadi, kedua pahlawanku, pertarungan tadi tidak sia-sia kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540149,
					"content": "Memangnya kita bisa dapat apa kalau bantu kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "Barang curian tidak bisa dipindah-pindah begitu saja, tapi kalau kalian mau bantu ... barang-barang selama penangkapan, seperti \"harta rahasia Treasure Hoarder\" itu kalian yang urus saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540151,
					"content": "Selain itu aku dan rekan-rekanku sudah mengumpulkan beberapa Mora, semoga kalian mau terima walau tidak banyak. Lagi pula, jenis \"bantuan\" tak terduga ini tidak termasuk dalam anggaran kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540152,
					"content": "Uh, jadi kita tidak perlu masuk penjara, dan dapat harta karun. Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540153,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540154,
					"content": "Oke! Apa boleh buat, kita terima! Silakan tunjukkan jalannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540155,
					"content": "Tu-Tunggu dulu ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "Baiklah, kalau begitu kalian berdua tidak perlu malu-malu. Aku akan pergi ke tempat berkumpul untuk bersiap-siap dulu. Kalian segera menyusul ya, agar tidak kami tinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540158,
					"content": "Oke! Yuk ikuti mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540159,
					"content": "He-Hei ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "Cepat dong, kita ini kan mau bantu Millelith! Lagi pula ada banyak Mora kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540156,
					"content": "Aku belum ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "Kalau tahu begini, tadi kuhajar lebih keras lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "Huh, kami kan cuma menyerang orang yang menyebalkan! Lagian kalian sendiri kan yang pakai baju Treasure Hoarder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540138,
					"content": "Pasti sengaja ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "Tapi kita benar-benar menyerang orang yang salah kali ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "Yah, tapi aku tidak menyalahkan kok. Kami yang salah duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540124,
					"content": "Tentang barang berbahaya itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "Informanku bilang kalau Fatui membeli suatu barang dari Treasure Hoarder dengan Mora dan perlengkapan perang dalam jumlah banyak. Tapi dia hanya menemukan makanan dan perlengkapan sehari-hari, sepertinya hanya pengalihan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540109,
					"content": "Kalian ... pasukan Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "Haha, maaf tidak menjelaskan terlebih dahulu ... Malah kami kira kalian yang mau datang merusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540111,
					"content": "Yah ... tidak salah juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105402,
