				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "Kalian sudah datang, sudah kuduga kalian pasti mau bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540202,
					"content": "Para penyelundup dari Treasure Hoarder itu sepertinya bertemu dengan Fatui di sebuah kemah besar di arah timur. Di perjalanan ke kemah itu, mereka juga mendirikan tiga kemah kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540203,
					"content": "Berdasarkan informasi yang diterima dari informan, <color=#00E1FFFF>tempat memasak</color> ada di tenggara, <color=#00E1FFFF>tempat penyimpanan senjata</color> letaknya agak lebih jauh ke timur, dan di arah timur laut ada <color=#00E1FFFF>kemah alkimia</color>. Jika kita bisa melakukan serangan dadakan di ketiga tempat ini, kita harusnya bisa memotong jalur suplai mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540204,
					"content": "Karena insiden Jade Chamber kemarin ini, tentara Millelith yang berpatroli di sini tidak banyak. Mereka jadi bisa berbuat seenaknya, ini waktu yang tepat untuk kita serbu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540205,
					"content": "Tapi karena kesalahpahaman tadi ... pasukanku sekarang hanya bisa menyerbu satu kemah saja. Tapi kalau kamu butuh, aku pasti akan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
