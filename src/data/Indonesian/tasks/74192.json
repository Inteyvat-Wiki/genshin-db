				},
				{
					"id": 741920402,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "Eh? Akhirnya kamu kembali! Aku sudah khawatir sekali. Aku sudah tidak tahu lagi deh harus gimana kalau kamu tidak balik lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "Setelah kamu masuk ke dalam, aku menunggu di luar lama sekali. Aku bahkan mencoba minta bantuan dari Melusine lain, tapi tidak ada yang tahu harus gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(Sepertinya aku sudah tinggal cukup lama di sini.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Ah, aku harus pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#Apa? {NICKNAME}, kamu mau ke mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "Jangan khawatir. Aku akan kembali setelah aku menemukanmu, Canotila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Tunggu aku sebentar lagi, oke?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Aku tahu bicara begini padamu tidak akan merubah banyak hal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Tapi, tolong percayalah padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920412,
