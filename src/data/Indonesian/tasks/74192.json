			"dialogs": [
				{
					"id": 741920101,
					"content": "Aku melihat: Api di takhta telah padam, dan abu yang terbakar kini sudah menjadi pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Bunga mekar seiring dengan langkah kakimu, membawa perubahan pada masa depan yang tidak akan pernah padam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Hah? Oh {M#Tuan}{F#Nona} {NICKNAME}! Kenapa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Ah, benar juga! Kupu-kupu emas sudah kembali. Aku harus pergi dan melihatnya! Dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
