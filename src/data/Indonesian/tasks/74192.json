			"dialogs": [
				{
					"id": 741920301,
					"content": "Karena ingatan bisa dibuat menjadi buku, kalau kita balikan logikanya, isi dari buku juga bisa ditulis menjadi ingatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, kamu toh, {M#Tuan}{F#Nona} {NICKNAME} yang aneh. Kenapa? Kamu ada perlu apa denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Kamu ngomong apa sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hmm, bagaimanapun, membuat \"ingatan\" jadi buku itu adalah sesuatu yang sangat luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Si pembuat buku ini pasti menganggap suasana hati dalam ing{RUBY#[D]khayalan}atan sebagai sesuatu yang sangat berharga, makanya bisa membuat buku seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Tapi buku seperti ini sulit sekali dipahami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "Dan aku juga tidak yakin bakal ada efek apa kepada para pembacanya. Ini benar-benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
