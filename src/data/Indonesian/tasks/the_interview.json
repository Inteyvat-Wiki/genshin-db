			"dialogs": [
				{
					"id": 140030101,
					"content": "Maaf Nona Charlotte, aku dan adikku agak sibuk hari ini. Wawancaranya terpaksa kami tolak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Ayo dong, Lyney! Aku cuma minta waktumu sebentar saja! Kumohon berbaik hatilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Eh? Ada apa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Aku begadang demi nulis artikel Phantom Weasel, soalnya mau naik cetak pagi ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Tapi begitu fajar tiba, aku terima kabar kalau tunangan Cesar, Jemma, mengaku ke Garde dan menyerahkan diri sebagai Phantom Weasel yang asli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "Cepat amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Ehem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Telat, Kak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Hahaha! \"Cepat amat\"? Kayaknya aku ketinggalan berita nih ya, tolong ceritakan dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Ha?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Aha! Insting wartawanku memang tidak pernah sesat ... kalian menyembunyikan sesuatu! Urusan Jemma menyerahkan diri itu pasti ada hubungannya dengan pertunjukan Lyney tadi malam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Mungkin hati nuraninya tergerak setelah melihat trik melarikan diri dari ketinggian, karena teringat waktu yang dia habiskan bersama Cesar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Eh, begitukah ... Sebentar, tidak deh. Pasti ada yang lain kalau cuma gitu doang bisa tergerak, kenapa mesti tunggu sepuluh tahun segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Soal itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(Semangat wartawan Charlotte panas membara nih. Kita alihkan perhatiannya deh ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Ah iya, aku ingat! Kemarin sehabis pertunjukan, kalian dan Jemma tidak ada dimana-mana ... apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Pertanyaan! Ke mana kalian semua setelah pertunjukan selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "Ah, kami ada di kuburan. Lyney main trik sulap spesial, khusus buat kami doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "Sebenarnya, karena kamu ngomong gitu, Paimon jadi ingat. Sekarang Lyney mulai pakai Rainbow Rose loh di sulapnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "EHEM.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "Kenapa aku ingatnya sekali pun belum pernah dapat Rainbow Rose dari kakak. Mereka lebih penting dari aku, gitu ya Kak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "Bukan gitu, aku ... ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "Sebentar, kenapa kayak gitu responnya? Paimon salah ngomong lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#Kok jadi gini sih suasananya ... {NICKNAME}, gimana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*huff* Sepertinya wawancara ini tidak bisa ya. Tidak apa, masih ada lain kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Maaf karena sudah memaksa, tapi kalau ada berita besar menunggu, aku pasti semangat! Kabar tentang Jemma sudah menyebar, dan aku akan terus selidiki sampai tahu ke dalam-dalamnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Dan tampaknya, dia bilang ke Garde kalau \"permintaan terakhirnya adalah bertemu dengan Lorenzo untuk terakhir kali\". Bau-bau hubungan yang kusut nih, aku penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Baiklah kalau begitu, kalian lanjut saja pembicaraannya. Aku tidak ganggu lagi, dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Lynette, sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Tenang, aku tidak marah kok. Cuma mengalihkan perhatian dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Oh gitu toh? Fiuh, Paimon sudah takut duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Aku juga nyaris ketipu loh. Tapi untungnya berhasil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "Tolong jaga Rainbow Rose itu baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Aku akan ikut sedih kalau sampai hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}