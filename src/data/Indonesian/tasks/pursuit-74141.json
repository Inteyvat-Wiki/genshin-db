			},
			"dialogs": [
				{
					"id": 741410101,
					"content": "(Isi di halaman buku masih berupa gambar, aksara, bahasa kuno, dan struktur diagram yang tidak bisa dimengerti. Tapi setelah memfokuskan diri, sepertinya isinya pelan-pelan jadi bisa dimengerti.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 741410102,
					"content": "Kayaknya Canotila enggak di sini deh. Mungkin dia ke tempat misterius itu lagi! Mau mulai \"meditasi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Dari kata-katanya waktu itu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "Aku agak cemas. Coba aku cek deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Hmm ... Paimon juga cemas ... Kita pergi bareng deh! Canotila benar-benar bikin orang khawatir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, kamu tunggu di luar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Dunia \"Kitab Kebenaran\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Mungkin lebih bahaya dari yang kita bayangkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "Jadi aku tidak mau bahayakan Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "Tapi ... kita kan selalu bertualang bareng selama ini? Kalau kita barengan, enggak ada hal yang enggak bisa kita lewati, dan enggak ada musuh yang enggak bisa kita kalahin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "Bahaya yang ada di dalam dunia itu mungkin bukan sesuatu yang bisa kita atasi dengan bertarung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "Ya sudah! Huh, kamu jauh lebih pintar dari Paimon, jadi Paimon percaya sama kamu. Tapi kamu jangan tinggalin Paimon, ya! Paimon bakal terus tunggu kamu balik ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Bisa jadi ada sisi lain yang tidak kita ketahui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
