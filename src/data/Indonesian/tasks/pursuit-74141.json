						],
						"pointId": 6835
					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "Oh ya? Gampang deh kalau begitu. Siapa namamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}, tidak sangka bisa ketemu kamu di sini. Paimon di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Tunggu, kamu bukan monster yang nyamar jadi orang yang aku kenal buat ngerjain aku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Kita baru ketemu belum lama ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "Oh ya? Aku merasa sudah lama sekali sejak kita terakhir berpisah. Mungkin karena aku sudah tua, jadi yang bisa diingat juga makin sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "Kamu beneran bukan monster, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Kamu masih ingat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Tentang taman bunga raksasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Aku ingat, aku ingat. Ternyata benar-benar kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Maaf ya. Aku menemui banyak hal yang luar biasa di sini, dan juga banyak pertempuran yang tidak bisa dimenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Tapi akhirnya ada perubahan juga di sini. Cahaya keemasan sudah muncul dan bunga matahari pun bermekaran. Bahkan alam semesta yang dibayangkan para leluhur pun bisa berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Mungkin semuanya akan jadi lebih baik. Mungkin aku akhirnya akan mengerti dan bisa melepaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Ikuti aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Hahaha, sepertinya memang benar kamu. Aku ingat sekarang ... Kamu belum berubah dari dulu, selalu suka ikut campur urusan orang lain, karena kamu orangnya jujur dan baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "Tapi kamu tidak usah khawatirkan aku. Aku tidak perlu bantuan. Kamu kan sudah pernah lihat kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "Selain itu, mungkin aku tahu lebih banyak tentang situasi di sini daripada kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "Hilichurl, tolong beri tahu dia untuk cepat pergi dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Ada yang ingin kamu katakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "Kamu mengerti kata-kataku? Kalau begitu coba jawab pertanyaanku ... Apakah aku di matamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Anjing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Hmm. Mungkin masih ada harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "Tinggalkan tempat ini, anak muda. Ini demi kebaikanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Aku setuju. {NICKNAME}, tempatmu adalah dunia yang lebih cerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "Aku masih punya pertanyaan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Jangan dipertanyakan lagi. Selamat tinggal, dan jangan datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "Tentang murid dan ikan kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
