						741411102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411102,
					"content": "Berapa lama aku pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Hmm, cuma sebentar sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411104,
					"content": "Kalau bagimu memang cuma sebentar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411106,
					"content": "Tidak apa-apa. Kurasa memang benar di dalam sana berbahaya sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Ngomong-ngomong, Canotila kok belum balik? Dia enggak jadi penjaga di Court of Fontaine, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "Kita coba lagi lain kali. Aku agak pusing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Oh, oke deh. Kita cari makan yuk? Gara-gara khawatirin kamu, perut Paimon jadi keroncongan sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Bukannya tadi kamu bilang cuma sekejap saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Khawatirin kamu itu capek, tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
