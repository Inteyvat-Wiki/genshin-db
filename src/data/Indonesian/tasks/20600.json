			"dialogs": [
				{
					"id": 206000601,
					"content": "Apakah kamu sudah mendapatkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Coba kulihat. Yah... ini bolehlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Sekarang, aku akan memberi tahu sesuatu tentang Fatui padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Fatui berasal dari Zapolyarny Palace. Kami mematuhi kehendak dari Yang Mulia Tsaritsa, dan menjalankan perintahnya ke seluruh bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Sebelas orang terkuat di antara kami diberi gelar Harbinger oleh Yang Mulia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Dibandingkan dengan orang tanpa nama sepertiku, Eleven Harbinger adalah sosok yang benar-benar hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "Kalau kamu bergabung dengan Fatui dan membuktikan kekuatanmu, mungkin kamu bisa menjadi yang terpilih di antara mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "Kalau seperti itu, namamu akan semakin melambung ke atas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "Aku? Tidak mudah untuk dipilih, aku hanya melakukan pekerjaan kecil untuk Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Tapi kalau kamu menyuruhku untuk memilih... aku lebih memilih bekerja di bawah Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
