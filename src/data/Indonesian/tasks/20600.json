					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "Di sini, Pengembara. Aku sudah memperhatikanmu cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000102,
					"content": "Apa yang kamu inginkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "Kenapa nadamu seperti itu? Ada hal bagus yang ingin aku beri tahukan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000104,
					"content": "Apakah kamu tertarik untuk bergabung dengan Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000105,
					"content": "Huh, kita tidak tertarik! Ya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "Aku akan memikirkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "Hei! Apa maksudmu kamu akan memikirkannya? Harusnya langsung kita tolak dong!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "Kamu memang pandai. Kalau ingin melakukan hal yang hebat, bergabung dengan kami, Fatui adalah satu-satunya pilihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000111,
					"content": "Sekarang... sepertinya kamu ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000109,
					"content": "Tapi ini adalah Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "Memang kenapa dengan Mondstadt? Kami, Fatui merekrut orang dari berbagai tempat dan terbuka, Knights of Favonius sama sekali tidak bisa ikut campur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
