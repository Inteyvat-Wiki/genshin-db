			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "Jelaskan padaku tentang Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "Benar-benar tidak pakai basa-basi. Hmm, ceritanya cukup panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000203,
					"content": "Tapi, kamu masih belum menjadi anggota Fatui, aku juga tidak bisa memberi tahumu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000204,
					"content": "Aku dengar ada banyak Hilichurl di sekitar Mondstadt, bahkan ada beberapa yang berkelompok menjadi satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000205,
					"content": "Ayo buat kesepakatan. Pergilah ke luar, kembalilah dengan membawa trofi dari Mitachurl untukku, dan aku akan memberi tahumu sedikit cerita. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000206,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "Sangat terus terang, aku suka itu. Tidak sangka ada orang sepertimu di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000208,
					"content": "Kalau begitu, cepat pergilah. Aku akan menunggumu di sini. Ingat untuk cepat kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000209,
					"content": "Hanya itu saja yang kamu butuhkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "Apa? Terlalu mudah? Iya itu saja, atau kamu pikir bisa membawa sesuatu yang lebih berharga dari monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000211,
					"content": "Cepat pergi dan kembalilah. Aku akan menunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000212,
					"content": "*huff* Kalau kamu terlalu lama, aku mungkin akan tertidur karena tiupan angin sepoi-sepoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
