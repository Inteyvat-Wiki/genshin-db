				{
					"id": 206001002,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Oh, yang ini lumayan. Kamu sudah cukup jago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Kamu ingin mendengar tentang Yang Mulia Tsaritsa, kan? Aku pikir-pikir dulu mulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Kalau kamu mau ringkasan yang sederhana, Yang Mulia Tsaritsa adalah dewa kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Ini bukan hanya perumpamaan, tapi sebuah kenyataan. Tsaritsa adalah Archon Cryo, salah satu dari The Seven yang memegang kekuasaan di atas dunia fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Tapi bagi kami orang \"Fatui\", Yang Mulia memiliki status di atas dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Mengenai alasannya... aku ragu kamu akan mengerti walaupun aku menjelaskannya. Atau bisa kukatakan, kamu tidak bisa mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Kalau kamu ingin mengerti, bergabunglah dengan kami. Setelah itu, kamu akan mengerti keagungan Yang Mulia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "... Huh, dan itu adalah semua cerita yang bisa kukatakan sampai saat ini. Suster itu melihatku dengan tatapan sinis lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
