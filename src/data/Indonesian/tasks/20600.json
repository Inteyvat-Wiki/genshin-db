			"dialogs": [
				{
					"id": 206000501,
					"content": "Jangan lupa, yang harus kamu ambil adalah trofi Mitachurl. Segeralah kembali setelah kamu mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "Apa itu sebenarnya? Itu adalah tanduk. Pergilah dan berikan padaku setelah kamu mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
