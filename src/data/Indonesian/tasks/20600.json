					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "Jadi, kalau tentang Delusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Hei! Aku bilang, kamu benar-benar bodoh, atau hanya pura-pura saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "Kamu bahkan bukan anggota resmi Fatui. Kamu pikir bisa seenaknya bertanya \"apa itu Delusion?\" seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Apakah kamu pikir aku akan langsung memberi tahumu? Aku tidak seperti dua Knights of Favonius yang menjaga gerbang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Tetap saja, Delusion adalah harta berharga kita— tidak ada salahnya menjelaskan kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "Begini saja, kamu coba keliling sekali lagi. Apakah kamu sudah menemukan Treasure Hoarder di area sekitar kota Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "Meskipun mereka sekarang hanya segerombol maling kecil, suatu hari mereka akan berhasil menemukan harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "Kamu coba pergi sekali lagi dan bantu aku mengambil sebuah barang dari Treasure Hoarder. Kalau kamu berhasil, aku akan menceritakan apa yang aku tahu tentang Delusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Aku suka semangatmu! Kalau begitu cepatlah kamu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Apakah kamu kekurangan uang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Kekurangan uang? Hahaha, kamu kira kita ini Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "Coba kamu pikir baik-baik, harta karun apa yang bisa Treasure Hoarder dapatkan di kota Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "Tapi... hehe, kalau dipikir-pikir sepertinya mereka tidak akan menemukan harta yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
