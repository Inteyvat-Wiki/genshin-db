			"dialogs": [
				{
					"id": 206000401,
					"content": "Sekarang, tentang Tsaritsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "Ada apa, kamu ingin bertanya tentang Tsaritsa kepadaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "Jangan bilang kamu ingin bergabung ke Fatui karena Tsaritsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "Bukannya aku bermaksud merendahkanmu, tetapi coba kamu pikir-pikir lagi keputusanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Tetapi, aku tetap tidak bisa memberi tahu apa pun tentang Tsaritsa kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Kamu coba pergi dan ambil sesuatu yang berharga dari Ruin Guard, aku tiba-tiba ingin mencari mainan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Kalau begitu cepatlah kamu pergi, aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "Kenapa kamu membutuhkan benda itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Eh? Tidak boleh seseorang mengumpulkan harta? Atau kamu rakyat Mondstadt yang takut dengan Ruin Guard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Untuk kami orang Fatui, kami hampir tidak perlu melakukan apa pun untuk menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Meski begitu... *huff* angin sepoi-sepoi ini benar-benar membuatku ingin tidur, jadi hal kecil seperti ini kuserahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
