			},
			"dialogs": [
				{
					"id": 411111801,
					"content": "Sepertinya semua sudah dibereskan. Menurutmu, apakah ini akan membantu para penduduk desa Springvale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111802,
					"content": "Pertanyaannya adalah, apakah batu-batu meteroit yang memiliki energi elemental merupakan penyebab utama bencana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111803
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111803,
					"content": "Sesungguhnya, kataku, meteorit ini pasti sumber utama mimpi buruk yang menyerang rakyatku! Aku bersumpah atas kedaulatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111804
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111804,
					"content": "Bagaimana kalau kita mengecek para penduduk desa secara langsung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111805
					]
				},
				{
					"id": 411111805,
					"content": "Iya, ayo kita lakukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
