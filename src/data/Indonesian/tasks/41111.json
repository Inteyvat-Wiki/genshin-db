			},
			"dialogs": [
				{
					"id": 411111601,
					"content": "Salam, namaku Edna. Aku datang untuk merawat pasien yang sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111602
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111602,
					"content": "Sebutkan namamu, pengikut fanatik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111603
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111603,
					"content": "Maaf, yang dimaksud mein Fräulein bukan kamu... Pria yang tergeletak di sini, apa dia sudah mengatakan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111604,
					"content": "Aku yakin dia mengatakan sesuatu tentang harus kembali bekerja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111605
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111605,
					"content": "Anggur... Anggur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111606
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111606,
					"content": "Jadi pekerjaan dia berkaitan dengan anggur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111607
					]
				},
				{
					"id": 411111607,
					"content": "Dia kelihatannya tidur sangat lelap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111608
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111608,
					"content": "Dia tidak tidur seperti biasa... Pria ini... Dia dikutuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111609
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111609,
					"content": "Apa kamu bisa membangunkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111610,
					"content": "Aku telah mencoba membangunkannya. Dia terbangun, namun dengan cepat tertidur kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111611,
					"content": "Apakah dia memberi tahumu sesuatu saat dia bangun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111612,
					"content": "Dia berkata bahwa dia bermimpi terdampar di puncak gunung, dan di sana sangat dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111613,
					"content": "Hmm... Gunung? Dingin? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111614,
					"content": "Mungkinkah ini kutukan dingin dari monster gunung... Apakah kota kecil yang dijaga oleh peri mata air telah menjadi tanah yang diincar oleh iblis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111615,
					"content": "Ini adalah kondisi yang sangat serius. Tapi jangan khawatir, biarkan aku yang menghapus kutukannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111616,
					"content": "Maaf mengganggu, apa kalian punya waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111617,
					"content": "Oh, hai Tuan Draff! Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111618,
					"content": "Anu... Su-sulit untuk mengatakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111619,
					"content": "Salah satu dari <color=#00E1FFFF>meteorit</color> menghantam <color=#00E1FFFF>bukit di belakang desa kami</color>. <color=#00E1FFFF>Allan</color> memberi tahu semua orang bahwa dia akan melihatnya sendiri... Tapi tentu saja, dia kabur begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111620,
					"content": "Kalian juga tahu bahwa meteorit-meteorit itu sangat berbahaya. Aku takut sesuatu telah terjadi padanya... Bisakah kalian ikut denganku untuk mencarinya dan menjemputnya pulang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111621,
					"content": "Tunggu... Jadi... Batu-batu besar terjatuh dari angkasa, dan yang dia lakukan justru melihat keramaian?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111622,
					"content": "Benar sekali! Sekali kita menemukan bedebah itu kembali, dia akan mendapat omelan sepanjang hidupnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111623,
					"content": "Paimon setuju! Ayo kita temukan bajingan itu dan seret dia pulang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111117,
			"completionStepIds": [
				4111117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111117",
							"2"
						],
						"stepId": 4111117,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "*fuhh* Aku pikir aku akan mati di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111702,
					"content": "Dasar bodoh! Apa yang kamu pikirkan, berkeliaran sendiri di saat seperti ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111703,
					"content": "A-Aku minta maaf! Aku tidak akan pernah melakukannya lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111704,
					"content": "Aku minta maaf atas apa yang telah dilakukan Allan. Aku pasti akan memberinya pelajaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111705,
					"content": "Lain kali jangan bertindak bodoh lagi! Berpikirlah sebelum bertindak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111706,
					"content": "Batu meteoritnya ada di sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Coba Paimon lihat... Loh? Putri, <color=#00E1FFFF>Vision</color>mu sepertinya <color=#00E1FFFF>berkelap-kelip</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111708,
					"content": "Oh? Mungkinkah kutukan dingin tersebut sudah merasakan kekuatan Edelstein der Dunkelheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111709,
					"content": "Mungkin saja...? Persisnya pada hal apa Visionmu akan bereaksi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111710,
					"content": "Teka-teki dunia yang terdalam... bisikan rahasia bintang-bintang... kutukan tak suci dari tulang iblis... dan—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111711,
					"content": "Apaaa?? Kenapa kamu harus berbicara seperti itu sepanjang waktu? Paimon tidak mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111712,
					"content": "Maaf, mein Fräulein tidak terbiasa dengan bahasa manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111713,
					"content": "Oh, jadi itu pekerjaanmu? Membantu menerjemahkan ucapannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111714,
					"content": "Sepertinya kamu salah paham. Aku bukanlah penerjemah, aku hanya membantu mewakili mein Fräulein menyampaikan kemauannya. Aku rasa <color=#00E1FFFF>Vision</color>nya bereaksi terhadap <color=#00E1FFFF>energi elemental</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111715,
					"content": "Ya, terima kasih Oz. Orang-orang yang dibutakan oleh kefanaan dunia tidak akan pernah bisa sepertimu, bisa memahami ucapanku dengan cepat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111716,
					"content": "Jadi ada energi elemental di dalam batu meteorit? Dan Visionmu bereaksi terhadap itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111717,
					"content": "Apa kamu bisa melacak energi tersebut dengan Vision?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "Paimon pikir... sepertinya bisa? Tidak ada salahnya mencoba! Mari kita cari <color=#00E1FFFF>kepingan batu</color> dengan menggunakan <color=#00E1FFFF>Vision</color> Fischl. Bila dibersihkan, area tersebut akan menjadi lebih aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111718,
					"content": "Apakah sumber energi tersebut akan memberi respon yang sama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
