			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "Hai, Pengembara. Kebetulan kamu datang di saat yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110102,
					"content": "Eh? Apakah telah terjadi sesuatu yang buruk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110103,
					"content": "Ya. Telah terjadi suatu peristiwa besar yang butuh bantuan dari para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110104,
					"content": "Ada misi yang sangat mendesak untuk dipercayakan kepadamu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110105,
					"content": "Wow... Kedengarannya cukup serius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110106,
					"content": "Sejujurnya, ini pertama kalinya kami menemukan hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110107,
					"content": "Saat ini Adventurers' Guild sedang kekurangan orang. Kami mengandalkan anggota yang ada di seluruh negeri untuk bersatu dan mendukung upaya pertolongan pada saat-saat sulit seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110108,
					"content": "Tentu termasuk aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "Tunggu sebentar, keselamatan harus didahulukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110111,
					"content": "Katheryne! Pengikut Immernachtreich, apakah telingaku mengelabuiku ataukah kamu memang menyerukan nama suci-ku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110112,
					"content": "Ah, datang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110113,
					"content": "Senang bertemu denganmu lagi, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110114,
					"content": "Ah! Barusan gagaknya berbicara ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110115,
					"content": "Haha, senang bertemu denganmu juga, temanku... Tentunya kamu sudah pernah melihat fenomena yang jauh lebih aneh dari diriku sebelumnya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110116,
					"content": "Subjek setiaku, melihat wajahmu yang dipenuhi dengan kecemasan, pasti orang-orang berdosa sekali lagi mencoba mengganggu kedamaian dan ketenangan Mondstadt tercinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110117,
					"content": "Pengembara, perkenalkan ini adalah Fischl, anggota senior dari Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110118,
					"content": "Fischl, Oz, ini adalah Pengembara yang pernah kuceritakan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110119,
					"content": "Oh? Jadi kamu Pengembara itu? Hmm... sorot mata yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110120,
					"content": "Honorary Knight dari Knights of Favonius dan partner perjalanannya, Paimon, suatu kehormatan bertemu dengan kalian berdua. Kami telah mendengar banyak hal tentang kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110121,
					"content": "Pengembara, apakah kamu juga ingin melawan kristal kegelapan dan malapetaka yang tak terbatas ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110122,
					"content": "Hah? Melawan kristal kegelapan... dan malapetaka? Apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110123,
					"content": "Katheryne, apakah ini masih hal yang sama dengan yang kamu bicarakan tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "Maksud mein Fräulein adalah tentang <color=#00E1FFFF>serangan meteorit</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110126,
					"content": "Sejauh ini Adventurers' Guild belum dapat memastikan penyebab dan efek samping dari hujan meteorit ini. Oleh karena itu, kami merekomendasikan agar para petualang bepergian secara berpasangan untuk alasan keselamatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110127,
					"content": "Pengembara, Fischl, kuharap kalian bisa menjaga satu sama lain dalam perjalanan dan berhati-hatilah setiap saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110128,
					"content": "Berhubung ini adalah permintaan dari pengikutku yang saleh, Katheryne, maka aku akan mengabulkan permohonan yang kamu panjatkan sepenuh hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110129,
					"content": "Bersukacitalah! Kamu harus bangga dapat bergabung dengan Prinzessin der Verurteilung dalam misi agungnya, walau hanya untuk sementara waktu, sukacitanya kekal untuk selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110130,
					"content": "Nona muda ini adalah majikanku, Tuan Putri Fischl. Dia berasal dari dunia luar yang dikenal sebagai Immernachtreich. Aku adalah pengikut setianya mein Fräulein, namaku Oz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110131,
					"content": "Wow... Kedengarannya sangat mengesankan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110132,
					"content": "#Namaku Paimon, aku dan {NICKNAME} adalah pengembara. Senang bekerja sama denganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110133,
					"content": "Apakah barusan kamu mengatakan... \"dunia luar\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "Pada waktunya, kamu akan mengetahuinya... Semakin banyak waktu yang kamu habiskan dengan Nona Fischl, kamu akan mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110136,
					"content": "Oh, jadi kamu buta akan kemuliaan Immernachtreich, alam malam yang abadi... apalah yang bisa diharapkan dari seorang pengembara rendahan sepertimu... Karena itu bukan penistaan, tapi ketidaktahuan, maka aku akan mengampunimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110137,
					"content": "Mengampuni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110138,
					"content": "Maksud Mein Fräulein adalah \"Halo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110139,
					"content": "Mereka adalah kombinasi teraneh yang pernah Paimon temui... Gadis itu kedengarannya cukup aneh, tapi setiap kali burung peliharaannya yang bicara, rasanya jadi semakin aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110140,
					"content": "Kalian berdua pasti punya banyak pertanyaan, mari kita lanjutkan dalam perjalanan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110141,
					"content": "Ngomong-ngomong apanya yang bepergian secara berpasangan? Ini jelas-jelas jadi berempat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110134,
					"content": "\"Immernachtreich...?\" Ini pertama kalinya aku mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "Terima kasih atas infonya! Lebih baik aku segera bergabung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "Saat ini kita ada di Springvale. Kata Katheryne, di sini adalah lokasi yang paling dekat dengan kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110502,
					"content": "Situasinya terlihat lebih buruk dari yang diharapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110503,
					"content": "Begitu banyak orang yang telah tertidur lelap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "Bunyikan lonceng, bunyikan terompet, hari penghakiman sudah ada di depan kita! Bersukacitalah, semua yang berseru meminta keselamatan, karena Prinzessin der Verurteilung telah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110505,
					"content": "Tuan putri ini kelihatannya antusias sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111106,
			"completionStepIds": [
				4111106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111106",
							"2"
						],
						"stepId": 4111106,
						"stateName": "QUEST_STATE_UNFINISHED"
