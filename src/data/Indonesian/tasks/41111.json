				"objectNames": [
					"Edna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111401,
					"content": "Edna, kami telah menyingkirkan batu meteorit di atas bukit di belakang desa. Bagaimana keadaan korbannya sekarang? Apa ada perubahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111402,
					"content": "Terima kasih! Berkat usaha kalian, dua korban sudah sadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111403
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111403,
					"content": "Ugh, aku ngantuk... *hoam*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111404
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111404,
					"content": "Bagus sekali, caranya berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111405,
					"content": "Kalau kamu bisa membereskan <color=#00E1FFFF>batu meteorit</color> di sekitarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111406
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111406,
					"content": "Semua orang akan terbangun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "Ini adalah berita yang menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111408,
					"content": "Khukhu, tentu saja menyenangkan. Bila aku sendiri yang terlibat, tentu saja hasilnya akan menggembirakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111409,
					"content": "Hei, Tuan yang baru saja tersadar, apa yang kamu mimpikan tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111410,
					"content": "Yang aku ingat hanyalah aku kedinginan... Aku terus menyusuri jalanan <color=#00E1FFFF>gunung</color>... Seperti berada di tengah-tengah es dan salju...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111411,
					"content": "Jadi... Hanya mendaki gunung? Tidak ada tujuan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111412,
					"content": "Ah, aku benar-benar tidak tahu... Dalam mimpiku, rasanya seperti... Aku tidak memiliki kendali penuh atas tindakanku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111413
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111413,
					"content": "Ternyata memang kutukan, seperti yang kukira! Oh, sungguh negara menyedihkan yang terkutuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111414
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111414,
					"content": "(Kutukan? Benarkah?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "Tidak peduli bagaimanapun masalahnya, yang kita tahu adalah, membereskan potongan batu meteorit itu dapat membantu. Jadi, ayo kita bekerja keras untuk membereskannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
