			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joyce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110601,
					"content": "Wahai manusia fana, di saat-saat kelam ini, Tuan Putri akan melupakan tata krama yang biasa dan sampaikanlah semua masalah yang ada di depan mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110602,
					"content": "Permisi? Siapa kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110603,
					"content": "Permisi, Tuan. Kami harap Anda dapat memberikan sedikit informasi tentang korban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110604,
					"content": "Tunggu, tunggu! Biar Paimon jelaskan... Kami berasal dari Adventurers' Guild. Mereka mengutus kami untuk menyelidiki kondisi setelah hujan meteor terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110605,
					"content": "Oh, baiklah. Kemarin malam orang itu menyentuh batu meteorit dan dia langsung jatuh pingsan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110606,
					"content": "Jadi bagaimanapun kamu menjalankan penyelidikan, aku ingatkan kamu, tolong jangan menyentuh batu meteorit itu dengan tangan kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110607,
					"content": "Omong kosong. Bagaimana mungkin aku yang dilindungi Edelstein der Dunkelheit dapat terluka karena kristal hitam itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110608,
					"content": "Mein Fräulein, putri yang bijaksana akan mendengar saran dari rakyatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110609,
					"content": "Begitukah... Baiklah, sepertinya aku harus mendengarkan sarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110610,
					"content": "#{NICKNAME}, kamu juga! Petualang yang bijaksana akan menerima saran bagus dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110611,
					"content": "Baiklah, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "Hehehe, Paimon belum pernah berbicara seperti itu. Paimon harus terbiasa mengatakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110613,
					"content": "Berani-beraninya kamu meniru caraku berbicara? Huh, orang biasa tidak mungkin bisa memahami ribuan ratapan dunia yang sekarat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110614,
					"content": "Mungkin lebih baik kamu tetap dalam ketidaktahuan yang penuh kebahagiaan, karena beban yang ditanggung oleh Prinzessin der Verurteilung pasti akan terlalu berat untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110615,
					"content": "Tolong pimpin jalannya, oh putri yang cantik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4111114,
