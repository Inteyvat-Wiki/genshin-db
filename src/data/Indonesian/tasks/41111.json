			"dialogs": [
				{
					"id": 411111501,
					"content": "Lihat, ada korban lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111502,
					"content": "Oh Knight, tragedi apa yang telah menimpa orang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111503
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111503,
					"content": "Hmm... Dia, dia tidur sepanjang hari dan tidak kunjung bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111504,
						411111506
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111504,
					"content": "Apa dia menyentuh batu meteorit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111505
					]
				},
				{
					"id": 411111505,
					"content": "Iya, dan dia langsung tertidur. Dia juga berbicara dalam tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111508,
					"content": "Aku tidak bisa lagi... Aku mau istirahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111509
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111509,
					"content": "A-apa yang terjadi? Kenapa dia berkata seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111510,
					"content": "Mimpi kelam itu seperti seekor binatang buas yang membawa buah apel terlarang. Matanya yang gelap akan membuat yang lemah jatuh ke dalam jurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111511
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111511,
					"content": "Maksudmu... Ada sesuatu yang memikatnya dalam mimpinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111512,
					"content": "Meskipun tidak ada buktinya, namun intuisi mein Fräulein tidak pernah salah sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111513
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111513,
					"content": "Hmm... Ayo kita lanjutkan penyelidikannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111506,
					"content": "Apakah dia ada gejala lain selain tertidur lelap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111507
					]
				},
				{
					"id": 411111507,
					"content": "Sejauh ini tidak ada. Namun dia terkadang akan berbicara dalam tidurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				}
			]
		},
