			"dialogs": [
				{
					"id": 250260501,
					"content": "Hmph, silakan coba kalau masih berani macam-macam sama Yumkasaurus kecilku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Kayaknya ini ada kesalahpahaman deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Jangan dengarkan omong kosong! Aku lihat mereka mengikat sayap si Yumkasaurus! Pakai mata kepala sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Kalau tempo hari aku tidak datang, entah apa yang bakal terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Terima kasih banyak untuk bantuannya. Ini, ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Sayang mereka cepat sekali kaburnya. Kalau tertangkap, kita bisa cegah mereka bikin onar lagi untuk seterusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
