						250260402
					]
				},
				{
					"id": 250260402,
					"content": "Mau ikut? Makasih! Dan kamu pasti bisa bantu banyak, aku bisa lihat kamu ini petualang kawakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Dan aku akan berikan imbalan sesuai aturan Guild. Ayo, kita hajar para keparat sialan.",
