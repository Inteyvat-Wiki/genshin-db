			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Mending kamu fokus ke Yumkasaurus deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hmm, iya juga. Anak itu sudah ketakutan banget. Baiklah, ayo kita tenangkan dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "Ayo ikut. Kelihatannya kamu ini petualang berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "Kalau kita berdua, rampok-rampok sialan itu mana berani macam-macam. Dan tenang saja perihal imbalan, aku tahu aturan Guild, dan aku pasti patuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "Si kecil itu doyan banget makan jamur Candlecap ... dan kalau tidak salah, ada banyak di bawah pohon situ. Coba ambil beberapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "Aku mau mengumpulkan jamur Candlecap di sebelah sana. Kalau kamu sudah beres, kita ketemu di tebing dekat stadion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "Biasanya si kecil istirahat di sana. Siapa tahu dia ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
