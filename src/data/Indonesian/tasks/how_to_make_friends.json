					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Yumkasaurus kecil yang malang ... Cukup sudah. Para keparat itu harus dikasih pelajaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Lari sana! LARI TERUS! Tapi jangan harap bisa sembunyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "Kamu ... petualang dari luar? Salam. Tapi mohon maaf, aku tidak bisa menyambut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Para Treasure Hoarder bedebah ingin menangkap Yumkasaurus kecil itu lagi. Untungnya ada aku yang mengusir mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Tapi si kecilnya jadi ketakutan. Dipanggil pakai cara apa pun tidak mau mendekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Tapi tidak apa. Aku sudah tahu mereka sembunyi di mana, dan mau kasih mereka pelajaran! Aku mau ikat mereka di pohon dan CAMBUK semua pakai BATANG POHON!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "Dan yah, harus cari makanan enak juga buat si Yumkasaurus yang malang ... kasihan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
