			"dialogs": [
				{
					"id": 250260601,
					"content": "Sst. Lihat. Dia menunggu kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260602,
					"content": "Aum? Aum ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Yumkasaurus Kecil yang Penakut"
				},
				{
					"id": 250260603,
					"content": "Ayo anak baik, sini. Kami tidak akan melukaimu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260604,
					"content": "Aum? Grrr ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260605
					],
					"speakerTitle": "Yumkasaurus Kecil yang Penakut"
				},
				{
					"id": 250260605,
					"content": "Aku Tlamot. Masih ingat? Aku yang kasih kamu camilan-camilan enak tempo hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
