				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Di sini sih biasanya ... tapi hari ini kayaknya dia belum ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Dia pasti sembunyi karena takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "Mau cari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "Jangan. Biarkan dia tenang dulu saja. Tinggalkan jamurnya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Kamu sudah pengalaman ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Pengalaman ngurusin dia? Jelas lah. Aku sudah lama kenal sih, jadi tahu dia lebih sensitif. Lihat orang tak dikenal saja bisa takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Dia baru mau datang ke aku setelah dikasih makan untuk waktu yang cukup lama ... tapi aku curiga kali ini dia tidak akan keluar, karena ulah penjahat-penjahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "Kita biarkan dia sendiri dulu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Terima kasih. Ini, ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Sayang kita enggak ketemu dia ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Tenang, dia selalu ingat siapa saja yang baik sama dia. Kalau waktunya sudah tiba, dia pasti bakal datang untuk menemui kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Aku ingin banget lihat Yumkasaurus kecil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
