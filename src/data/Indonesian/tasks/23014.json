			"dialogs": [
				{
					"id": 230145001,
					"content": "Kita harus memikirkan cara mendapatkan uang, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Saya dengar ada sebuah teater di kota Sumeru dan membutuhkan pekerjaan berhitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Dan Anda juga pasti tahu kalau para aktor itu, penghasilannya banyak tapi tidak tahu cara mengelola keuangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Ini kesempatan kita, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Kamu punya bakat yang hebat dalam hal keuangan dan bisnis, Lutong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Coba aku pikir-pikir dulu, sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
