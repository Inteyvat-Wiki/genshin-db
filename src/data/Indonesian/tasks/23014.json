					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Tuan, kali ini saya menyarankan dengan tulus hati, pikirkanlah dulu cara membayarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Segerombolan penjual itu seperti perampok saja! Kenapa harga lencana saja mahal sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Mungkin mereka melihat matamu berbinar-binar sewaktu melihat lencana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Apa yang mau kamu lakukan dengan lencana-lencana itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "Pengembara! Anda datangnya selalu tepat waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Berkat bantuan Anda kemarin, pelumas yang bisa digunakan sudah berhasil kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Tapi tidak lama lagi akan ada masalah lainnya. Sewaktu aku membuat bagian tertentu, aku sadar kalau ... bahan yang dipakai untuk membuatnya terlalu keras, jadinya bagian lainnya malah jadi gampang rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Apalagi, kalau bagian yang terlalu keras itu tersenggol sedikit saja, akan timbul retakan dengan berbagai ukuran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Jadi, aku mulai mencari bahan yang bisa memberikan kekerasan dan fleksibilitas sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Sesudah meneliti tanpa henti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "Dan setelah mengganggu Tuan Ahangar terus-menerus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Kukira aku bisa menemukan material yang kucari di lencana Treasure Hoarder itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Tapi ... para pedagang itu merampokku seperti Treasure Hoarder ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Inilah saatku beraksi lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Terima kasih sekali! Aku sampai berniat untuk mengukirkan nama Anda di bantalan utama \"mesin hitung\" ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Aku akan membantumu mencarinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
