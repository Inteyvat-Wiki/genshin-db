			"dialogs": [
				{
					"id": 230145501,
					"content": "Uhh ... Lutong, tolong sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Tuan, lebih baik Anda kembali dan beristirahatlah dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "Pengembara, kebetulan sekali! Tolong, saya butuh bantuan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "Kenapa lagi dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Singkat kata ... Tuan Garcia terlalu banyak minum kopi dan terlalu kurang tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Untungnya kopi sih, bukan alkohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, hmm ... Ki——kita masih perlu beberapa lencana ... Se-Seperti yang dibawa oleh Treasure Hoarder itu loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "Pengembara! Halo. Maaf, barusan tidak lihat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Bisa bantu carikan lencana seperti itu? Tidak usah banyak-banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Kamu istirahat lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Tidak apa, aku baik-baik saja. Semuanya aman terkendali, cuma tanganku saja kadang tidak mau nurut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "Baiklah, tolong ya bawakan aku beberapa lencana. Pasti ada imbalannya kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Kalau sudah ada, langsung kasih aku saja. Aku mau periksa, kali ini tahanannya harus sempurna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Apa iya minum kopi bisa sampai sebegitunya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Bukan kopinya. Tuan Garcia tidak mau tidur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
