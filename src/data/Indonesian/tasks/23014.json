				{
					"id": 230140301,
					"content": "Terima kasih banyak, Pengembara. Lencananya sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140302,
					"content": "Aku harus membuat ulang roda giginya dulu ... Emm, bukan, mungkin aku pelajari masalah bantalannya dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140303,
					"content": "Ini imbalan Anda, Pengembara. Silakan diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Kalau dilihat dari kondisi sekarang, sepertinya kita bisa bekerja sama jangka panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
