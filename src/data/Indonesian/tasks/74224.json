			"dialogs": [
				{
					"id": 742240901,
					"content": "Hmm ... Tidak salah lagi, ini partitur \"Pelancong Kelana\". Betulan ketemu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "Pasti susah ya carinya! Aku tidak salah percaya orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hehe. Terima kasih! Tapi tetap deh, Kak Tailleferre. Kamu mau apain partiturnya? Adain pertunjukan di Opera Epiclese dan raup banyak Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hmm ... Cuan sih memang penting ya, tapi aku tidak rencana menyimpannya untuk sendiri kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Seni kuno ini adalah harta bersama umat manusia. Makanya, aku akan memublikasikan \"Pelancong Kelana\" ini ke kalangan publik begitu penelitianku sudah beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Soalnya, mengisi kekurangan satu halaman seni sejarah yang hilang, bukannya merupakan hal yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Semangat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Ya sudah, aku balik dulu deh supaya bisa teliti partiturnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ini imbalan buat kalian. Semoga kita bisa ketemu lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Jangan lupa kontribusiku!",
					"roleType": "TALK_ROLE_PLAYER",
