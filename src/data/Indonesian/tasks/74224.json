	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Eh? Kak Tailleferre ya?!? Kita ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "Ah! Kalian berdua ya! Petualang dan asistennya. Aduh, aku lupa nama kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Nama Paimon ya Paimon. Kalau dia {NICKNAME}. Yang kemarin itu, terima kasih loh, akhirnya kami bisa pakai Keong Harpa buat mainin partitur kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Eh? Kok kamu bisa ke Petrichor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "Harusnya aku yang tanya kalian dong. Aku sih ke sini gara-gara dengar rumor. Tapi kalian sih petualang ya, jadi tidak heran kalau selalu lebih cepat satu langkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Rumor? Rumor apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Kalian belum dengar? Rumor yang menggemparkan seluruh Petrichor belakangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Tentang kami menyelamatkan dunia ini ... secara kebetulan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Eh? Ngomong yang mana sih itu! Itu loh, penemuan kembali Kastil Pudar kalau maksudku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Catatan terakhir tempat itu sudah ratusan tahun yang lalu! Jadi aku pikir kalian datang ke sini untuk itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Oh ... itu juga kayaknya memang ada hubungannya sama kami sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Oh ya, jadi kalian sudah tahu? Kastil Pudar itu pernah jadi milik Boethius, kan? Musisi yang paling terkenal dalam sejarah Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Entah itu opera yang dia ciptakan, atau partitur Remuria yang dia rapikan, semuanya punya tempat khusus dalam sejarah musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Kalau memang benar dia pernah tinggal di sana, pasti akan ada banyak sumber daya. Ini benar-benar literatur yang sangat penting untuk Asosiasi Musisi kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Makanya begitu dengar kabar ini, aku langsung ke sini. Sebelum petualang yang lain mendahului, mudah-mudahan aku yang dapat duluan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Tapi kalian tetap selangkah lebih maju ya ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Gimana? Kita harus kasih tahu dia? Kalau Boethius itu orang jahat, dan gunakan musik itu untuk buat hal jahat ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Kalau habis tahu kebenarannya, dia jadi sedih, gimana?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "\"Simfoni\" itu tidak bisa dipakai untuk buat jahat lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Eh? Kalian berdua lagi ngomong apa sih? Jangan-jangan kalian sudah menemukan partitur kuno itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Anu ... emm ... KALAU ya, ini kalau. Kalau Boethius itu rupanya orang yang super jahat di masa lalu, apa kalian tetap mau simpan partitur musiknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Hmm ... Meski aku tidak jelas maksud jahatmu seperti apa, tapi selain musik, sepertinya Boethius tidak tinggalkan apa-apa lagi di dalam sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "Dari opera romantisnya \"Pelancong Kelana\", sebenarnya bisa terlihat kalau dia sama sekali tidak pernah menyerah untuk membangkitkan Remuria, bahkan sampai sebelum dia meninggal. Makanya dia menganggap Fontaine sebagai musuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Menurut ahli sejarah, perang kekacauan saat awal pembangunan Fontaine juga berhubungan dengannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Tapi pencapaiannya dalam musik itu sudah hal yang berbeda. Mungkin ada kesalahan sejarah dalam musiknya, tapi nilai seninya tidak bisa disangkal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Dan menurutku, ini ya bagian dari sejarah bahwa seni yang murni saja bisa dipakai untuk melakukan kejahatan. Sebagai musisi, kita harus selalu ingat poin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Ya, tapi aku yakin kamu tidak mungkin berbuat jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, aku sih cuma peneliti. Harapanku cuma bisa dengar partitur kuno itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Oh ya, karena kita kebetulan ketemu di sini, boleh bantu aku tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Anggap saja kalian balas jasa untuk yang waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Lah, terakhir kali kamu bilang enggak usah dibayar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Hehe, ya sudah, anggap \"bantu\" saja kalau gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Nah jadi, seperti yang tadi kubilang. Aku di sini untuk cari partitur opera terkenal yang telah hilang, \"Pelancong Kelana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "Berdasarkan catatan yang ditinggalkan orang yang bernama Ruggiero ratusan tahun yang lalu, harusnya partiturnya ada di suatu tempat di Kastil Pudar ini. Bisa bantu aku carikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "Soalnya penjelajahan reruntuhan gini kan kamu lebih jago dari aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#Yah, karena dia sudah minta tolong, kita bantu saja deh? {NICKNAME}? Soalnya kan partiturnya sudah tidak punya \"kekuatan itu\" lagi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Ya sudah. Aku anggap kalian setuju ya! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Tolong ya! Sebelum kalian kembali, aku akan tunggu di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Wah, kalau gratisan sih agak susah ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Tidak masalah, aku akan bayar kok. Asosiasi Musisi itu bukan organisasi yang bokek ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Sudah kuduga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Teori yang luar biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Haha, itu cuma pendapatku pribadiku saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Sulit menjelaskan semua ini sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "Tentang Hipnosis Akbar di Petrichor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
