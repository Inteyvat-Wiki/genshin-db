			"dialogs": [
				{
					"id": 111240101,
					"content": "Monumen ini dibuat oleh Mountain Shaper. Disebutkan bahwa Azhdaha adalah seekor naga yang mengerikan, monumen tersebut juga berguna sebagai tanpa peringatan untuk generasi berikutnya agar jangan mendekati tempat ini... dari segelnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "Sayang sekali... batas antara baik dan jahat sangatlah tipis. Andai saja kebaikan dan kejahatan di dalam dirinya dapat disimpulkan dengan satu kalimat saja... ah, sudahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Menatap Zhongli yang berdiri di bawah pohon tanpa berbicara...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Di tengah keheningan, hanya suara angin sepoi-sepoi yang terdengar. Waktu seakan berubah menjadi sungai yang tak terlihat, mengalir pergi begitu saja...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Saat-saat singkat, seribu tahun di dunia fana. Bebatuan dapat merasakannya, begitu pula dengan bumi dan para dewa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
