			"dialogs": [
				{
					"id": 140340201,
					"content": "Dan demikianlah monster tersebut ditaklukkan, dan sang penyihir dikalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340202,
					"content": "Ibu kota kembali damai, dan mereka yang dicuci otak oleh si penyihir jahat juga telah tersadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340203,
					"content": "Beberapa mengingat nama-nama pahlawan yang menyelamatkan bangsa mereka, tapi ada juga yang melanjutkan hidup mereka tanpa mengetahui apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340204,
					"content": "Inilah kisah Marechaussee Hunter. Mereka memburu bayangan dalam gelap, dan membasmi semua yang menjadi ancaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340205,
					"content": "Mereka akan selalu melindungi kota dan seluruh isinya, bahkan bila sejarah atau pun orang-orang yang mereka selamatkan melupakan keberadaan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340206,
					"content": "Fiuh ... Seharusnya ini sudah bagian akhir skripnya, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Iya. Kalian dapat salah satu akhir yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "Secara keseluruhan, ini skrip yang bagus. Awalnya aku pikir ini cuma cerita petualangan, tapi semakin didalami, aku jadi semakin terkesan sama nilai produksi dan alur ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Terutama pertarungan akhirnya! Efeknya terasa nyata sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Oh iya, hehe ... sangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Ah ... Poin yang bagus. Aku tidak menyangka senjata yang kita pilih dari ruang harta bisa punya efek seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Iya, aku hampir kaget setengah mati waktu senjataku bersinar! Aku perhatikan lagi setelah kita keluar, tapi sepertinya sekarang tidak bisa nyala lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Oh iya, ini semua kan cuma alat peraga, jadi harus dikembalikan! Aku tinggal di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Apa kamu senang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Tentu saja. Kasih tahu aku kalau ada skrip seperti ini lagi, ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Kalau begitu aku balik dulu. Aku mau renungkan kembali semua peristiwa yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Setelah Tuan Florian bangun, tolong sampaikan salamku. Dia pasti capek minta ampun, bisa-bisanya langsung pingsan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Iya, ada banyak yang harus dia urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Oke deh, kalau begitu sampai jumpa lain kali! Dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "Oke, aku boleh tanya sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Rasanya sudah boleh deh. Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Jadi yang tadi itu sebenarnya apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "Ah, kamu sudah sadar dari awal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahahaha ... Tadi waktu kamu suruh tutup mata di dalam gua ... justru lebih aneh kalau kami enggak sadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Aku penasaran banget dari tadi! Tampangmu seperti bilang \"semuanya baik-baik saja\", dan Furina seperti benar-benar percaya semua ini sudah direncanakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Dan tidak satu pun dari kita yang ingin menghancurkan fantasi ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Hah? Kalian ngomongin apaan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Apa maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "Hah, masa sih kamu enggak ... AH, ini salahku! Maaf ya! Partner, sini, aku tutupin telingamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Ehem ... kayaknya sekarang sudah telat deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Hah? Sebentar, maksudmu ... semua yang terjadi tadi bukan bagian dari skripnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Mungkin lebih tepat kalau dibilang dari awal juga tidak ada yang namanya skrip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "HAAAHHH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "Berisik ... kepalaku sakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Woi! Bangun kau! Jelasin ini ada apa sebenarnya!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Ahhhhh! Tolong berhenti goyang-goyang! Kepalaku ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian menjelaskan kisah sebenarnya kepada semua orang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "Paimon enggak salah dengar kan? Kalian ngarang bagian terakhirnya di tempat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Bohong itu tidak baik, tapi Florian jago banget ngedongengnya. Oh, terus improvisasinya Clorinde juga mantap banget loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Iya! Kayak nonton pesulap yang bikin improvisasi luar biasa di atas panggung karena lupa bawa alatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Kalau Paimon tahu ada yang enggak beres sama kamar harta karunnya, mungkin sudah langsung terbang terbirit-birit deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Situasinya masih terkendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Rasanya aku tidak pernah dengar kata situasi \"tidak terkendali\" dari mulutmu. Aku yakin situasi yang menurutmu remeh bakal bikin orang biasa takut setengah mati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Berarti mungkin aku sudah terbiasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Uh ... Kayaknya kamu sudah ketemu banyak situasi tidak terduga ya ... Enggak heran kenapa kamu jago banget ngarang di tempat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Sedangkan buat Florian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "Aku tidak akan membela diri. Aku akan menyerahkan diri ke Garde, mengakui semua kesalahanku, dan menerima hukumannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Kalau menurutku sih, kamu sudah cukup menderita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Walaupun awalnya kamu dibutakan oleh ketenaran dan kekayaan, tapi tindakanmu selama pertarungan akhir membuktikan kalau dirimu adalah Marechaussee Hunter sejati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Kamu akan lebih berguna di kota atas daripada di bawah. Tugasmu sebagai Marechaussee Hunter lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Tentu saja, kamu masih perlu kembalikan kunci dan minta maaf ke dua Hunter yang kamu rugikan. Siap-siap terima persyaratan apa pun yang mereka berikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "Iya, tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Selain itu ... Aku rasa kamu sudah membuktikan kehormatanmu dalam duel kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "...! Baiklah, aku akan ikuti perkataanmu. aku ... aku akan kembalikan dua kuncinya sekarang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Terima kasih banyak, kalian semua. Aku akan melakukan yang terbaik untuk tidak menyia-nyiakan kesempatan kedua yang kalian berikan. Aku bersumpah atas nama dan kehormatanku sebagai seorang Marechaussee Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Sampai kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Aku juga ... cuma pura-pura ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Hah, berarti Paimon sampai sekarang enggak ... AH, ini salahku! Maaf ya! Sini Paimon, aku tutupin telingamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
