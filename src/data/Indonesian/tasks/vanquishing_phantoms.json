						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "Ngomong-ngomong soal Marechaussee Hunter ... \"harta\" di guanya mau kita apakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Tinggalkan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Yakin? Kamu enggak mau orang zaman sekarang ingat siapa mereka dan memberi penghormatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Tidak. Setiap nama yang ada pada tablet itu membuat keputusan yang sama. Semua Hunter tahu jalan apa yang mereka pilih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Bahkan aku sendiri pun hanya ingin diingat sebagai Petarung Juara, dan bukan sebagai Marechaussee Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "Benar-benar kebalikan dari jalan seorang pesulap. Tapi, aku mengagumi keputusanmu, Nona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Hah? Sebentar, Paimon baru kepikiran. Kalau semua yang kita lihat itu tidak pakai efek khusus apa-apa, terus kenapa senjatanya bisa nyala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Itu karena Marechaussee Hunter masa lalu sering \"mengisi\" senjata mereka dengan mantra untuk menekan monster. Ketika ada monster mendekat, senjatanya akan menyala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Ooh, pantesan tadi bisa ngaruh ke orang itu. Kirain itu beneran gara-gara kita pakai kemampuan \"panggil\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Aku yakin panggilannya juga membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Oh? Maksudnya bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Devorator ini sepertinya berasal dari zaman yang sama dengan para Hunter yang kita lihat dalam ruangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Nama-nama yang kamu lafalkan semuanya milik para Hunter paling berani, yang pernah menaklukkan monster yang tak terhitung jumlahnya. Itulah kenapa si Devorator bergidik ketika kamu menyebutkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Namanya ternyata memang punya kekuatan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, waktu kamu sedang melakukan \"Pemanggilan\", kamu bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Hah? Ah-Ahahaha! Aku, weh, itu, ya biar cocok saja sama karakter yang aku mainkan! Ya bagus lah kalau kedengaran, tapi jangan suruh ulang! Malu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "Sudah, sudah. Gitu amat, kayak ke siapa saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Uhh ... Sudah jangan diungkit lagi! Aku jalan duluan, nyusulnya jangan terlalu lama ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Ah ... dia kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Kalau begitu aku juga balik dulu. Hari ini dapat kisah yang luar biasa, rasanya bisa makan waktu semalaman kalau mau cerita ke saudara-saudaraku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Iya, sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340325,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME} ... Menurutmu apa arti dari perjalananmu jika namamu dilupakan orang lain, dan tindakanmu tidak dipuji oleh mereka yang kamu tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340327,
					"content": "(....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Perjalanan itu sendiri sudah sangat berarti, juga dunia yang telah kita bangun bersama. Ada nilai dalam waktu yang aku habiskan bersama teman dan rekan, dan ada pencapaiannya juga. Tidak masalah meski orang lain tidak ada yang ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "Jawaban yang bagus. Aku akan selalu mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340330,
					"content": "Kalau menurut Clorinde sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "Aku? Hah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340332,
					"content": "\"Sang Marechaussee Hunter tidak menjawab pertanyaan itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340333,
					"content": "\"Mungkin jawabannya ada di balik tudung kekelaman, sumpah sunyi yang bergema di malam hari. Jalan yang diambilnya tidak perlu penjelasan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		}
	]
