			"dialogs": [
				{
					"id": 140340101,
					"content": "Akhirnya kamu sampai di gere{RUBY#[D]Bawah Tanah}ja yang dibilang Florian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340102,
					"content": "Ketika mendekat, kamu bisa merasakan aura yang tidak menyenangkan, seperti ada musuh yang berdiri di sampingmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Aneh sekali ... Aku betulan jadi merasa tidak enak di sini. Kok mereka bisa bikin sampe begini sih?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Sekarang ... saatnya untuk pertarungan terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Diperankan oleh Clorinde"
				},
				{
					"id": 140340105,
					"content": "Berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Marechaussee Hunter"
				},
				{
					"id": 140340106,
					"content": "Florian, tunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Apa apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Kamu tunggu di luar saja. Kamu sudah pernah kerasukan Devorator, jadi lebih mudah baginya untuk sekali lagi masuk ke dalam pikiranmu dan mengendalikan tubuhmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Rasanya kamu lebih baik jangan mendekat lebih dari ini. Kalau dia berhasil merasuk lagi, mungkin bahkan wujudmu saat ini juga akan berubah sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "Justru itulah kenapa aku harus maju ... dan berdiri di barisan paling depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! Maksudmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Ya, aku memang ingin dia merasuk sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "Itu berisiko sekali. Skenario terburuknya, mungkin aku harus membunuhmu. Apa kamu sadar ini bahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Aku paham. Tapi dengan cara ini, kalian akan punya target yang jelas dan kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Devorator tidak akan bisa menolak tubuh yang sudah pernah dikendalikannya. Kalau begini, kamu juga tidak perlu khawatir teman-temanmu dikendalikan olehnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Nona Clorinde adalah seorang Marechaussee Hunter yang kuat dan lurus, beda denganku. Monster ini lepas karena kesalahanku, jadi sudah semestinya aku yang bertanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Ini adalah ... sesuatu yang harus kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Anggap saja ini duel untuk membela kehormatanku. Jangan menahan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "Aku ... mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Sebagai Petarung Juara, aku menerima permintaan duel ini dan memberikan penghormatan yang paling tulus kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Baiklah, waktunya berburu. Biarlah si Devorator sekali lagi takut dan gentar kepada pedang Marechaussee Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
