			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "Sampai di sini saja aku mengantarmu. Silakan kamu pergi sendiri ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131102,
					"content": "Tunggu sebentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "Ada apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131105,
					"content": "Jelas-jelas kamu adalah salah satu pahlawan dari festival ini... Kenapa kamu tidak mau terlibat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131106,
					"content": "Aku... tidak suka kerumunan orang banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131107,
					"content": "Tidak peduli pada dunia, begitu damai dan gembira... Mereka benar-benar berbeda denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131108,
					"content": "Sudah terlalu lama aku menghabiskan waktu untuk membunuh, dan aku terbiasa dengan beban penderitaan. Bertemu dengan orang-orang yang bahagia hanya akan membuatku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131109,
					"content": "...Hanya itu saja yang bisa kukatakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131110,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131111,
					"content": "Apa kamu yakin tidak ingin pergi bersama kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Apakah kamu benar-benar suka dengan hiburan seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131113,
					"content": "Bagaimana menurutmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "Hei! Ini festival resmi, bukan hanya hiburan semata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131115,
					"content": "...Resmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131116,
					"content": "Sudah cukup. Lihatlah lenteramu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131117,
					"content": "Tapi waspadalah. Tetap berhati-hati terhadap ancaman apa pun. Kalau kamu berada dalam masalah... sebut saja namaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131118,
					"content": "Apa kamu yakin bisa menyelamatkan dan tiba tepat waktu di kota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "Di mana pun. Kapan pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131120,
					"content": "Entah kamu atau penduduk Liyue. Aku mendengar semuanya menangis minta tolong, memohon perdamaian, dan berharap keinginannya terbawa oleh lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131104,
					"content": "(...Sudahlah, kita bisa melihatnya dari sini.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
