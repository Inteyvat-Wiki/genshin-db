			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Sepertinya kamu dan Xiao menyelesaikan sebuah misi lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Kabarnya langsung tersebar dengan cepat, bahkan sampai ke sini loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "Namun, Lantern Rite ini pun akan segera berakhir dan dia lagi-lagi tidak ingin melihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "*huff*... Setelah bertahun-tahun dan aku masih belum pernah melihatnya hadir pada Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "Dapat dikatakan, sepertinya malah lebih mudah membawa festival itu padanya daripada sebaliknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Membawa festival padanya... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Ide bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Yeay! kalau Xiao tidak mau pergi ke Lantern Rite, maka kita bawakan saja Lantern Rite kepadanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "...Eh? Kamu pasti tahu kalau aku hanya bercanda... Bagaimana caranya membawakan Lantern Rite padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "Ketika kami berada di kota untuk melihat perayaan, kami belajar bagaimana membuat Lentera Xiao. Kami bahkan menemukan tempat makan yang menyajikan hidangan lokal ..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "Banyak sekali makanan enak, banyak Lentera Xiao, dan juga... apa lagi ya... Oh iya, banyak pahlawan dari masa lampau, yang adalah temannya Xiao waktu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "Bukannya itu adalah hati dan jiwa dari Lantern Rite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "Kamu benar, tapi di mana sebaiknya kita menggelar kios kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Kalau begitu, coba kupikirkan... kita butuh tempat yang cukup besar untuk mendirikan kios. Hmm... sepertinya ada satu ruangan yang cukup di <color=#00E1FFFF>lantai dasar penginapan</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Bagaimana kalau kita pergi ke bawah untuk memilih tempat bersama-sama? Sepertinya aku sudah tahu kios seperti apa yang kalian inginkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Oh... seharusnya ada beberapa tipe untuk dijadikan referensi, coba kupikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
