				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "Ada perlu apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130802,
					"content": "Kami ingin kamu ikut bersama kami ke Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "...Sudah kubilang aku tidak suka keramaian. Jangan buat aku mengatakannya lagi, pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130804,
					"content": "Aku tidak bilang kamu harus pergi ke Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "...Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130806,
					"content": "Kamu tidak ingin pergi ke festival, jadi kami yang membawakan festival itu untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "Kamu \"membawakan festival untukku\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130808,
					"content": "Oke, jadi ada banyak makanan enak di lantai bawah penginapan, lalu ada banyak Lentera Xiao, dan tidak ada seorang pun di sekitar sana jadi kamu tidak usah khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130809,
					"content": "Lalu ada Almond Tofu dan Grilled Tiger Fish juga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Ayo cepat sebelum makanannya jadi dingin. Ayo turun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Ta-da! miniatur Festival Lantern Rite pribadi milikmu! Menggoda selera sekali kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130902,
					"content": "Jadi ini maksudmu dengan membawakan festival padaku... apa perilaku aneh menusia memang tidak ada akhirnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130903,
					"content": "Apa ada tujuan lain di balik semua ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130904,
					"content": "Dengan begini kamu bisa ikut serta di dalam Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "...Oh ya? Motif manusia memang sulit untuk dipahami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130907,
					"content": "Tidak perlu dipahami, makan saja! Ayo cepat, makanlah sebelum dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130908,
					"content": "Hehe, baiklah, Paimon akan fokus untuk makan saja sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130909,
					"content": "Baiklah setelah kita selesai dengan bagian terpenting dari festival, sekarang kita bisa pergi untuk melihat Lentera Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130910,
					"content": "Ayo ikutlah dengan kami, Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "Kalian pergi saja. Tidak ada yang bisa dilihat di sana untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130912,
					"content": "Kalau begitu, temani kami sampai sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Benar, Lentera Mingxiao mungkin tidak menarik untukmu, tapi... tidak ada salahnya kan berjalan-jalan bersama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130915,
					"content": "Jalan dari sini ke Pelabuhan Liyue sangat panjang dan penuh mara bahaya... Kami perlu seseorang untuk menjamin keselamatan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130916,
					"content": "Tidak ada yang bilang kamu harus ikut masuk ke kota... Kamu bisa mengantar kami sampai pinggiran di luar kota saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130918,
					"content": "...Hmm",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130919,
					"content": "Baiklah, aku akan menerima permintaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130920,
					"content": "Bagus! Oke, waktunya berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130913,
					"content": "Oh Vigilant Yaksha, tolong antarkan kami dengan selamat sampai ke kota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Semua orang sebaiknya ikut serta di dalam Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
