			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Tempat ini boleh juga... cukup terpencil, sangat cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "Baiklah kalau begitu, barusan aku juga sudah memikirkan kios seperti apa yang cocok untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "Kalian tunggu sebentar, hmm, sebaiknya dimulai dari mana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "Sudah selesai, kurang lebih seperti ini, coba kalian lihat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "Bagus sekali! Kamu memiliki bakat terpendam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "Ah, aku hanya bisa sedikit, aku pernah mempelajarinya dulu dan sudah hampir melupakan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Kiosnya sudah jadi, aku juga sudah memasang Lentera Xiao di atasnya, cukup bagus kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "Kamu juga bisa membuat Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Eh, rata-rata setiap orang seusiaku di Liyue bisa membuat Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Tapi, ngomong-ngomong soal festival, akan terasa kurang tanpa mengadakan pesta. Apa ada makanan yang kalian inginkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "Aku mau makan... Almond Tofu! Dulu kami pernah mentraktir Xiao makan Almond Tofu juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "Aku mau makan Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Jadi kalian mau makan Almond Tofu dan Grilled Tiger Fish kan? Tidak masalah, aku akan menyuruh Yanxiao menyiapkannya untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "Kebetulan seluruh bahan makanannya sudah tersedia di dapur, mereka pasti bisa menyiapkan makanan yang kalian minta dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "Kalau begitu, kalian naiklah dan panggil orang-orang di atas untuk turun, saat kalian turun, aku yakin makanannya pasti sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
