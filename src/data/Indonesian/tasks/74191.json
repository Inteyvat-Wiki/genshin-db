			"dialogs": [
				{
					"id": 741910201,
					"content": "Imperator, Imperator, apakah Anda baik-baik saja? Anda bermimpi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Ugh, berisik sekali. Ada apa ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Orang-orang telah berkumpul di aula utama. Mereka ingin menghadap Imperator.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Akhir-akhir ini, melodi Phobos sudah terganggu berkali-kali. Jadi banyak sekali yang mempertanyakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Aku terpaksa bertindak seperti ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Hamba percaya kepada segala yang engkau putuskan. Namun hamba pula mendengar apa yang terjadi baru-baru ini ... ada masalah dengan Phobos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "Phobos dirancang agar manusia bisa mencapai kebahagiaan sejati. Dan tentunya itu dapat terjadi dengan bantuan kekuatan perhitungan Scylla yang tak terbatas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Tapi aku mendengar suara ratapan dari lagunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Apa mungkin ada yang mengubah partitur Phobos? Tidak, selain diriku dan para Harmost lain, tak ada lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Apa si peramal menyembunyikan sesuatu dari kita? Mustahil. Bukankah dia sendiri yang mengorbankan diri demi ini? Bahkan nubuatnya telah dibuktikan oleh Ratu Segala Perairan. Tentunya tak ada lagi kepentingan pribadi yang diutamakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "Mungkin justru karena dia tidak punya kepentingan pribadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Di zaman sekarang, semua orang mengandalkan Phobos untuk mengambil keputusan. Jika ada yang salah, warga takut semuanya akan jatuh ke dalam kekacauan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "Aku harus pergi ke tempat mereka yang setia pada kepercayaan buta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Engkau ingin memisahkan melodi hamba dari Simfoni Agung untuk berjaga-jaga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "Tidak, tidak. Masih terlalu awal. Hamba khawatir jiwa hamba tidak akan bisa menanggung takdir sebesar itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Aku percaya kepadamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "Hamba mengerti. Dan hamba akan patuh. Biar kehendakmulah yang jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Ouranopolis, kota masa depan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "Setelah ████ pergi, kamu melewati sebuah koridor emas. Suara orang berdebat semakin terdengar jelas.\\nSuasana menjadi sedikit lebih tenang ketika kamu mencapai podium tengah di aula utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "Kami menunggu perintahmu, ya Sebastos agung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Akhir-akhir ini, banyak yang tidak bisa mendengarkan melodi Phobos. Orang-orang takut dan resah, gentar dan kebingungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Rencana kita berjalan lancar. Para kaum barbar yang meringkuk di bayangan telah dihabisi satu per satu, air yang tercemar telah dibersihkan oleh Ichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Bukankah Imperator sendiri yang menginginkan gencatan senjata tanpa syarat dan tanpa alasan? Mengapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "Semua sejalan dengan kehendakku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Sebastos agung, kiranya hamba tidak berani melawan! Namun hamba percaya bahwa engkau melembutkan hati dan memberi pengasihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Keharmonisan dan cinta kasih telah kita hadirkan di bangsa ini. Gerbang Remuria terbuka bagi siapa pun yang ingin bergabung dengan kemuliaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "Namun mereka? Menara kita diruntuhkannya, para musisi dibantainya seperti ternak! Jiwa-jiwa yang tercemar dan nista tidak layak menerima keselamatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Biarlah tanah ini disucikan oleh darah mereka, dan aturan serta peradaban berdiri di atas kehancurannya! Sesungguhnya inilah kasih sejati yang pantas diterima gerombolan buas dan biadab itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Bukan itu yang aku inginkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Bukankah seharusnya tidak ada bayangan satu pun di bawah sinar sang surya? Bukankah itulah kehendak Anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Izinkan hamba berkata mewakili semua orang di Remuria ... bahwa inilah yang kami inginkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Sebastos agung, hamba menunggu perintah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Biarlah kita dikenal dengan nama baru ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Namun mulai hari ini, kamu bukan lagi \"bagian dari kita\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Untuk itu, aku harus berikan kehendak bebas kepadamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}