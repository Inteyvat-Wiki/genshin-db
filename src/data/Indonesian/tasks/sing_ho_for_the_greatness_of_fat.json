			"dialogs": [
				{
					"id": 751650901,
					"content": "Illimani, sepertinya kamu tambah gemuk lagi, selamat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650902,
					"content": "Haha, terima kasih, Suriqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650903,
					"content": "Kabar baik, aku berhasil membujuk orang yang ingin diet untuk tidak diet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650904,
					"content": "Wah, hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650905,
					"content": "Ah, halo. Apa kabar? Makan enak? Kenyang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650906,
					"content": "Makan enak terus nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "Bagus, harus banyak makan, gemukan baru benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650910,
					"content": "Illimani, aku kasih tahu ya, rekor orang ini sangat hebat, hampir sama dengan rekorku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650911,
					"content": "Dia juga pernah main di sini. Hasilnya lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650912,
					"content": "Kamu hebat juga, nyaris ngalahin kami berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650913,
					"content": "Kalau dia agak gemukan, kayaknya kita bakal kalah deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650914,
					"content": "Hmm, bisa jadi. Aku lihat sih kamu terlalu kerempeng, masih banyak peluang buat menggendutkan badan. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650915,
					"content": "Aku mengakui kehebatanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650916,
					"content": "Aku juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650917,
					"content": "Tapi ingat, makan tetap harus lebih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650918,
					"content": "Jangan pernah diet-diet. Jangan bikin kami kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650908,
					"content": "Makannya bikin muak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "Wah, pelanggaran. Makan tuh harus enak, penting tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Suriqui"
				}
			]
