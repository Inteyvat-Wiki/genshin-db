		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "Ah, orang lewat yang pemberani. Kamu jauh-jauh kemari, ke tanah Teteocan, tentunya untuk mencari kekuatan, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Atau kamu sudah pernah ketemu para pejuang Berlimpah Jaya. Hmph, semuanya maniak otot, sebadan penuh otot semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "Tapi penampilanmu ... ya, sepertinya kamu masih belum jadi fanatik yang kerjanya cuma angkat beban setiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Itu tipu-tipu semua! Waspadalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Kamu benci olahraga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Tidak juga sih, tapi tidak masuk akal kalau menganggap kekuatan seorang pejuang cuma berasal dari otot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Aku kasih tahu ya, para pahlawan di zaman kuno mana ada yang badannya cuma terdiri dari tulang sama otot doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Lingkungan hidup mereka jauh lebih keras. Mereka lebih mikir kelangsungan hidup dan bertahan di medan perang. Pasti badannya punya cadangan lemak yang mumpuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Kesimpulannya, bentuk badan mereka tidak bakal jauh dari badanku ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Badan agak gemuk model gini tuh bentuk tubuhnya para pahlawan masa lalu, kuat iya, lincah juga iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Tapi orang-orang suku tidak ada yang paham konsepnya. Ck, bodoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "Mukamu kayak tidak percaya gitu. Baiklah, gini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Coba ikut tantangan mecahin pot! Awalnya aku bikin ini buat latihan, boleh-boleh saja dimainkan sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Kalau sudah coba, pasti paham badan gede itu sekuat apa di medan pertempuran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Kamu benci otot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
