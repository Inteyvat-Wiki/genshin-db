				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Hehe, bagus, tapi masih belum sebanding denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Aku mempertahankan bentuk tubuh yang sedikit gemuk, tapi tidak pernah lupa latihan. Dari segi kelincahan dan kekuatan, aku tidak bisa dibandingkan dengan orang-orang bodoh yang terobsesi sama bentuk badan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Jangan ngejar badan ototan melulu, mulailah menghargai lemak dan daging yang nempel di badan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
