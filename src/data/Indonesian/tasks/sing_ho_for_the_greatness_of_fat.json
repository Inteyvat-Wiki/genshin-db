			"dialogs": [
				{
					"id": 751650301,
					"content": "Bentar, siap-siap dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "Kalau sudah siap, balik lagi sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Hai, pemberani yang kebetulan lewat ... ya, kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "Itu badan kurus sekali ... selama ini makan apa? Sudah benar belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Tapi ... makanannya disikat semua sama pemanduku, si Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Apa pun alasannya, ingat aturan nomor wahid: makan harus enak, harus benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Sudah sampai ke Teteocan, berarti sudah lihat para pejuang suku Berlimpah Jaya dong yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Aku kasih tahu ya, jangan pernah percaya sama orang yang kotbah panjang lebar soal pentingnya membesarkan otot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Lemak adalah berkat Archon yang sangat berharga bagi umat manusia. Masuk akal tidak, berhenti makan enak dan kehilangan lemak di badan cuma demi bisa pamer otot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "Tidak masuk akal, bahkan bodoh bukan main. Babi hutan saja bisa kasihan kalau tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Kalau mau bicara soal penampilan, orang-orang baru suka badan penuh otot dalam beberapa dasawarsa terakhir saja. Serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Kakekku bilang orang di zamannya lebih suka bentuk badan berisi, yang gemuk-gemuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Jadi ingat, berhati-hatilah bila tidak ingin disesatkan! Jangan dengarkan bisikan setan yang bilang \"TURUNKAN BERAT BADAN\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Tapi kalau suatu hari kamu memilih untuk menurunkan berat badan demi kekuatan seperti kerabat-kerabatku di Berlimpah Jaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Ingatlah akan hal ini: pejuang gemuk juga bisa gerak lincah. Tapi kalau bicara kekuatan, anak-anak tipis kerempeng itu bukan tandingan kami yang besar-besar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Kalau perlu bukti, lihat saja pot-pot di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Badan segede gini tapi bisa <color=#00E1FFFF>lari cepat, tanpa kena satu pot pun</color>. Gampang. Rasanya yang punya badan kecil juga belum tentu bisa selincah itu, betul tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Oh, mau ketawa dia ... tidak percaya juga tidak apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Coba saja selesaikan latihan di sini dengan cepat, tapi ingat <color=#00E1FFFF>satu pot pun tidak boleh pecah</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Gimana, kira-kira bisa tidak kalahin rekorku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Wah, mau traktir makan ini ceritanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Bukan itu sih maksudnya ... tapi kalau memang selapar itu, aku bawa bekal dendeng panggang sih. Oke, urusan makan kesampingkan dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
