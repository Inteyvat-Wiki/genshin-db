			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? Dan ... Tuan Zompaynco? Ada apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Aku ... ehm ... itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Dia mau main ke Bani Bulan Embun, tapi malu, makanya mau minta tolong kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Iya! Iya, benar seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "Ha-halo, Nona Lyylikki! Senang bertemu dengan Anda. Uh ... ini ... sampel fosil yang kubawa dari Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Terima kasih, tapi ... Tuan Zompaynco, kita sudah saling kenal, tidak perlu sungkan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Eh? Sejak kapan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "Waktu aku bagi-bagi makanan, Anda selalu melihat dari pinggir, ya kan? Bolak-balik ke sana kemari, tapi tidak pernah ikut antre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Aku kira Anda juga ingin makan, tapi terlalu malu untuk minta. Makanya, aku selalu sisihkan satu porsi untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Tapi Anda belum pernah ambil sama sekali. Malahan, kalau misal hari ini Anda tidak datang, aku mungkin sudah minta tolong orang periksa keadaan, siapa tahu Anda perlu bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Ma-maaf, aku cuma tidak tahu ... harus gimana untuk menyapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Jadi, Nona Lyylikki ... apa mungkin aku boleh main ke tempatnya Bani Bulan Embun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Tentu saja. Kami juga bukan belum pernah menerima pengunjung dari luar. Tapi, boleh aku tanya untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Aku mau foto, cari info, dan kalau diperbolehkan ... tanya-tanya ke warga soal legenda setempat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Aku anggota Asosiasi Relik Saurian Natlan. Alangkah baiknya kalau bisa mengumpulkan informasi yang berhubungan dengan penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Oh ... Jadi mau lihat-lihat buku di perpustakaan kami ya? Hmm, gimana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Kalian sepertinya asyik ngobrol, jadi misi ini sudah selesai ya ... aku juga harus kembali melapor ke bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Terima kasih, Nona Jahoda! Tapi ... aku tetap mau bayar. Kamu sudah repot-repot mengantarkanku kemari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "Saat kembali nanti, tolong sampaikan juga rasa terima kasihku pada Bos Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Iya iya, kalau begitu aku pergi dulu ya, semoga kalian berdua bisa mengobrol dengan seru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
