			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Ah ... Jahoda? Kamu kok di sini? Um ... apa Bos Nefer sedang ada waktu luang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Sudah kuduga dia mau ketemu Bos Nef ... Hehe, masalah kecil begini bisa kuurus sendiri.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "Tidak perlu repot-repot, aku cuma disuruh bos untuk bantuin kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Eh? A-apa katamu, jangan-jangan Bos Nefer sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Kamu selama ini ingin mengunjungi Bani Bulan Embun, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Jadi, kamu mau PDKT dengan Lyylikki dulu, lalu minta dia bawa kamu ke Bani Bulan Embun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "Eh?! Bos Nefer sudah tahu? Padahal aku enggak pernah cerita ke siapa-siapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(Ini saatnya aku bilang kata-kata keren itu! Bos Nef bilang apa ya waktu itu ... hmm ... oh!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Hehe, Tuan Zompaynco, kalau mau menyembunyikan rahasia, kita juga harus tahu cara menutupi fakta bahwa kita menyimpan rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Kalau tidak, tak peduli setinggi apa tembok penghalang yang kamu bangun di dalam hati, cepat atau lambat pasti akan timbul celah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "Aih, aku dari dulu memang paling tidak pandai menyembunyikan perasaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(Akhirnya diucapkan juga! Latihan selama ini tidak sia-sia, hehehehehe ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Baiklah, karena Anda sudah tahu, apa mungkin boleh bantu kenalkan aku dengan Nona Lyylikki? Aku orang luar, tidak enak kalau tiba-tiba mendekatinya, begitu kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Tenang saja, Lyylikki orangnya baik kok. Jangankan tamu dari luar, bahkan yang bukan manusia pun dia akan sambut dengan lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Ah? Benarkah ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Tapi bagaimanapun juga, tidak sopan kalau tiba-tiba mengganggu dia ... eh, kalau kamu kenal dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Pastinya dong! Mereka seharusnya sudah selesai membagikan makanan, ayo kita pergi sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "Oh ya ... kata bos, kali ini tidak perlu bayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Terima kasih! Aku beres-beres dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}