				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "Kenapa, Kak? Masih ada yang mau ditanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141402,
					"content": "Tentang kepiting itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "Bentukannya seram, tapi hatinya baik. Harusnya dia sudah balik normal lagi setelah batunya lepas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141404,
					"content": "Tapi sekarang biar dia introspeksi dulu deh. Mau dimanfaatkan kek, dimanipulasi kek, tetap saja dia sudah salah dan menyakiti kepiting-kepiting kecilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141405,
					"content": "Sama kayak gubernur jahat lawannya Reed Miller yang dicuci otak sama cermin. Alasan tidak bisa dijadikan pembenaran, tapi tindakan bisa menebus kesalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141406,
					"content": "Tentang batu aneh itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Hehe, itu ba{RUBY#[D]Batu Twardowska}tu bertuah yang konon bisa mengendalikan hasrat hati manusia ... yah, kata Kak Hidimbi sih gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141408,
					"content": "Uhm, po-pokoknya mirip sama yang di wilayah Bani Bulan Embun deh, sama-sama jatuh dari langit. Karena sudah terbang jauh, dia sudah bukan ancaman lagi sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141409,
					"content": "Tentang Geng Keong ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "Hm? Kakak penasaran sama Geng Keong? Mau tanya apa? Silakan, toh kita sudah jadi teman sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141411,
					"content": "Kami ini semacam ... organisasi berisi orang-orang sepaham dan sepantaran yang saling berkoordinasi dan saling membantu satu sama lain. Yah, Kakak sudah ketuaan sih kalau mau gabung, maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141412,
					"content": "Tapi kalau perlu bantuan apa pun di sekitar Kota Nasha, dan aku kebetulan lagi ada di sana, jangan sungkan ya Kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141413,
					"content": "Tentang orang aneh sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "Oh, maksudnya si penghulu yang rambutnya ungu itu ya. Dia belum berbuat macam-macam, artinya belum jadi musuh. Tapi mending jaga jarak saja sih kalau bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141415,
					"content": "Penasaran bisa bikin celaka. Kak Katya bilang jangan dekat-dekat sama orang-orang aneh di Bani Bulan Embun. Pencuri hebat macam aku saja pernah nyaris ketangkap, nyaris dijadiin tumbal buat Dewi Bulan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141416,
					"content": "Dijadiin tumbal?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "Iya, pokoknya ngeri lah mereka tuh. Katanya sih mereka punya kebiasaan nyedot darah orang, terus ... Iih, merinding deh bahasnya. Sudah ah, pokoknya gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141418,
					"content": "Untungnya yang nangkap aku dulu itu cuma cewek polos yang masih kecil. Dia mau lepasin aku setelah dikasih cerita ... duh, coba kalau kejadiannya enggak kayak gitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141419,
					"content": "A-Aku bukan takut loh ya. Pencuri ulung mana kenal yang namanya takut! Intinya, Kakak juga sebaiknya jauh-jauh deh dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141420,
					"content": "Oh iya, aku sudah janji mau kasih tahu sumber informasinya, benar kan? Hampir saja lupa. Aku tahu tentang Bani Bulan Embun dari ceritanya Kak Hidimbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141421,
					"content": "Kalau mau ketemu dia ... ke Kota Nasha deh. Tanya-tanya saja di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141422,
					"content": "Dia ... bakalan libur panjang dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "Eh, Kakak sudah ketemu sama Kak Hidimbi? Kayaknya ini pertama kali deh aku dengar dia mau liburan ... ya sudahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141424,
					"content": "Kayaknya tidak meyakinkan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Tenang, dia orangnya meyakinkan banget kok! Percaya deh sama Maite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141426,
					"content": "Dadah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "Oke, hati-hati di jalan, sobat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
