				{
					"id": 760820405,
					"content": "Iya, pokoknya ngeri lah mereka tuh. Katanya sih mereka punya kebiasaan nyedot darah orang, terus ... Iih, merinding deh bahasnya. Sudah ah, pokoknya gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820406
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820406,
					"content": "Untungnya yang nangkap aku dulu itu cuma cewek polos yang masih kecil. Dia mau lepasin aku setelah dikasih cerita ... duh, coba kalau kejadiannya enggak kayak gitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820407
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820407,
					"content": "A-Aku bukan takut loh ya. Pencuri ulung mana kenal yang namanya takut! Intinya, Kakak juga sebaiknya jauh-jauh deh dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820408,
					"content": "Oh iya, aku sudah janji mau kasih tahu sumber informasinya, benar kan? Hampir saja lupa. Aku tahu tentang Bani Bulan Embun dari ceritanya Kak Hidimbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820409
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820409,
					"content": "Kalau mau ketemu dia ... ke Kota Nasha deh. Tanya-tanya saja di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
