			"dialogs": [
				{
					"id": 200720301,
					"content": "Bagaimana dengan bunga yang sebelumnya dikubur di Dragonspine itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720302,
					"content": "Dan lagi kali ini semuanya ada di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720303
					]
				},
				{
					"id": 200720303,
					"content": "Apa kamu sudah mendapatkan kembali semua bunganya? Bagus sekali, ayo cepat perlihatkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720304,
					"content": "Hehe, kelihatannya bagus, hm... sepertinya cara ini memang bisa dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720305,
					"content": "Namun, Dragonspine terlalu jauh dari Mondstadt. Aku tidak bisa terus-terusan merepotkanmu begini. Aku harus menemukan cara lain di masa depan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720306,
					"content": "Ah tapi, terima kasih atas bantuanmu. Ini hadiah terima kasih dariku, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
