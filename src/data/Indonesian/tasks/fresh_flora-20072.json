			},
			"dialogs": [
				{
					"id": 200720201,
					"content": "Bagaimana bunganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720202,
					"content": "Maaf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720204,
					"content": "Aku tidak sengaja merusak kotak dan bunganya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "Ru-rusak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720206,
					"content": "Uh... itu adalah bunga yang aku pilih secara khusus. Bunga yang bagus tidak mudah ditemukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720207,
					"content": "Apa Dragonspine itu benar-benar berbahaya? Sampai-sampai petualang seperti dirimu tidak bisa menaruh sekotak bunga di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720208,
					"content": "Namun, terima kasih telah membantuku untuk tugas ini, ini untukmu, terimalah, aku akan lanjut merawat bunga di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720209,
					"content": "Ah, atau... mungkin aku akan mencoba lagi cara yang digunakan oleh Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
