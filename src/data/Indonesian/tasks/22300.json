		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Hahaha. Ada batu mineral dari tambang! Kamu sepertinya mengerti sedikit tentang \"Geo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Selain dilebur, bagi para leluhur Liyue, batu-batu mineral ini memiliki fungsi yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Saat leluhur tiba di sini, mereka mulai membuka lahan untuk bertani. Mereka menumpuk batu untuk membuat tungku, lalu memukuli batu-batu untuk menyalakan api.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Dengan adanya api mereka bisa memasak. Dengan adanya makanan, mereka pun bisa mempunyai tenaga untuk bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "\"Batu-batu\" yang dipakai adalah anugerah dari Archon Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Oleh karena itulah, dalam beberapa catatan sejarah, Archon Geo memiliki sebutan lain, yaitu \"Dewa Perapian\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Pemilik restoran atau kedai baru biasanya akan bakar dupa untuk Archon Geo, dan memanjatkan doa agar api dalam tungku mereka terus menyala, dan usaha mereka akan terus ramai dan makmur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Lain kali saat kamu mengunjungi salah satu restoran di Pelabuhan Liyue, jangan lupa ucapkan doa dalam hati kepada Archon Geo ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
