			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "...Hanya itu saja permintaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Aku sedang menyembah Lord Geo. Huh, kamu bukan orang lokal, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Di sini adalah Yiyan Temple. Penduduk Liyue biasanya ke sini untuk berdoa dan meminta berkat Lord Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Tempat tinggalku sangat jauh dan aku tidak bisa sering datang berdoa. Jadi setiap kali ke sini, aku akan menghabiskan lebih banyak waktu sebagai gantinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "Aku telah membaca banyak catatan bersejarah yang menulis tentang Lord Geo. Semakin banyak yang kubaca, semakin terpesona aku dengan kebesaran Lord Geo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "Perjalanan yang kutempuh dan dupa yang kuberikan tidak sebanding dengan apa yang telah Lord Geo berikan untuk Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "Kamu mungkin tidak tahu banyak tentang Lord Geo. Aku bisa menceritakannya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Tapi mendengar cerita saja tidak akan membuatmu terkesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Hmm... Aku punya ide. Kumpulkan beberapa benda <color=#00E1FFFF>di sekitar pelabuhan Liyue</color> agar bisa kugunakan sebagai alat peraga dalam cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Bagus sekali. Jangan berlama-lama ya, aku akan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Benda apa yang harus kucari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Semua hal yang berhubungan dengan <color=#00E1FFFF>pelabuhan Liyue</color> atau <color=#00E1FFFF>Archon Geo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Tapi aku tidak tahu semua ceritanya dan tidak semuanya patut diceritakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Kita lihat saja nanti, setelah kamu menemukan benda-benda tersebut. Cepatlah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
