			"dialogs": [
				{
					"id": 223008001,
					"content": "Astaga, sudah berapa lama aku mengobrol denganmu? Waktu berlalu dengan sangat cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "Bagaimana? Apa kamu sudah lebih mengenal Archon Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "Aku merasa sedikit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Tentu saja, itu hanya sebagian kecil pengetahuan mengenai Archon Geo. Kunjungi aku saja lain kali jika kamu mau mendengar lebih banyak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "Hah? Kamu bahkan mencatat semua ucapanku... Kelihatannya kamu benar-benar menikmati ceritaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Aku punya ide. Bagaimana kalau kamu tinggalkan saja catatan ini padaku, lalu aku akan melengkapi lagi cerita selanjutnya di waktu luangku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Saat ceritanya sudah lebih lengkap nanti, aku akan dengan senang hati mengembalikan catatan ini kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Tapi cerita mengenai Rex Lapis bukanlah cerita yang singkat, mungkin aku butuh waktu yang tidak sebentar untuk menuliskan itu semua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Ini kuberikan untukmu. Terima kasih sudah menjadi pendengar yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
