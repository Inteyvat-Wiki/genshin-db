			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Menarik sekali... Kamu dapat ini dari mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Aku pernah dengar kalau benda ini hanya bisa ditemukan di Yujing Terrace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Benda ini sangat cocok untuk dijadikan bahan dalam cerita Archon Geo. Pilihan yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Tapi \"Glaze Lily\" ini juga merupakan fondasi dasar pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Tidak mengerti? Coba pikir baik-baik, apa ciri khas \"Glaze Lily\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Ya, \"Glaze Lily\" sangat berharga. Kamu bisa menjualnya dengan harga bagus dan menghasilkan banyak Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Sedangkan nama \"Mora\" ini diambil dari nama lain Archon Geo yang disebut sebagai \"Morax\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Jadi bagi penduduk Liyue, Archon Geo adalah Dewa Kemakmuran. Hampir setiap pedagang di Liyue, baik yang besar maupun yang kecil pasti akan menyembah Archon Geo terlebih dahulu sebelum memulai bisnisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Karena Archon Geo adalah orang terkaya di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Bahkan di antara para dewa The Seven, aku yakin Archon Geo adalah dewa terkaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
