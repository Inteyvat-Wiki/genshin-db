				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Oh, kamu petik ini di tepi kota? Kamu pasti sudah berusaha keras untuk mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Seperti yang kamu lihat, pelabuhan Liyue sangat luas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Kota sebesar apa pun, pasti membutuhkan batu bata yang kecil untuk membangunnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Waktu leluhur kami baru tiba di tanah ini, masih belum ada yang namanya \"pelabuhan Liyue\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Bulir-bulir keringat dan kerja keras merekalah yang sedikit demi sedikit membangun kota ini hingga sebesar sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Kamu juga tahu bahwa di sekeliling pelabuhan Liyue penuh dengan bebatuan yang tidak merata. Membuka lahan bukanlah hal yang mudah, namun tanaman-tanaman tumbuh dengan kuat di atasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Tanaman-tanaman yang tumbuh kuat itu sangat membantu leluhur kami. Mereka pun merasa bahwa hal ini adalah berkah yang diberikan oleh Archon Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Cerita tentang perjuangan leluhur diceritakan dari mulut ke mulut oleh para penduduk Liyue. Bahkan sampai saat ini banyak sekali petualang Liyue yang terinspirasi oleh cerita tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Selain berniat meneruskan semangat dan perjuangan leluhur untuk membuka lahan, mereka juga menyebut Archon Geo sebagai \"Pemisah Daratan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Para petualang Liyue menuntut diri mereka untuk menjadi sekuat batu, yang memiliki tekad kuat dan tidak mudah menyerah dalam menghadapi setiap tantangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
