				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Ah, pencinta makanan? Makanan di Pelabuhan Liyue memang enak. Kalau ada kesempatan, kamu harus mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Hubungannya dengan Archon Geo? Hahaha. Apa kamu pernah memperhatikan papan nama restoran-restoran di Pelabuhan Liyue? Papan-papan tersebut mengiklankan sejarah panjang restoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Kalau kamu pergi mencari bukti, para pemilik restoran akan segera menceritakan masa di mana Archon Geo mengunjungi restoran mereka. Mereka akan menceritakan masakan apa yang pernah dipesan oleh Archon Geo, dan sup apa yang pernah menjadi kesukaannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Kita tidak perlu membahas benar atau tidaknya kisah-kisah tersebut. Tapi dari sana terdapat kenyataan yang tidak bisa disangkal, Archon Geo telah berada di Pelabuhan Liyue untuk waktu yang sangat lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Beberapa sejarawan Liyue mengklaim bahwa Archon Geo adalah \"orang tertua yang pernah hidup\", beliau juga disebut sebagai \"Dewa Sejarah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "Tetapi aku yakin tidak ada satu pun yang tahu berapa lama beliau telah hidup di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
