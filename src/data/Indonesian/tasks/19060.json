					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "Bagaimanapun juga Takatsukasa bukan orang biasa, Ryuuji terlalu polos untuk menjadi pembantunya, tapi dia bisa menjadi pengikut yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Dan Takatsukasa juga punya anak setelahnya, cuma sayang dia meninggal sebelum anaknya lahir. Dia bahkan tidak tahu seperti apa wajah anaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
