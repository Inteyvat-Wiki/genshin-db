			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "Pengembara, menyelidiki kasus itu bikin sakit kepala, 'kan? Kalian ikuti saja sesuai arahanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Tentang Ketua Sango ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Aduh! kamu bilang Klan Takatsukasa menyewa seorang detektif yang hebat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Dia sering datang ke Kantor Polisi, minta kami menyelidiki ulang Kasus Ryuuji. Tapi Detektif Heizou selalu menolaknya. Tapi aku tidak sangka dia sampai tulis surat aduan segala. Dia benar-benar hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Kalau alasan senior Heizou menolaknya mungkin karena takut menempatkan Ketua Sangonomiya dalam bahaya, bagaimanapun ini adalah kasus besar, kamu akan tenggelam di dalamnya kalau tidak hati-hati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango memang menjalankan kantor detektif, tapi dia juga cuma manusia biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Memangnya hubungan mereka sebaik itu",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Eh ... tidak juga. Mereka selalu berdebat setiap kali ketemu. Tapi mungkin senior Heizou masih menganggap dia teman lama. Dulu mereka pernah kerja bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "Kadang dia minta aku serahkan kasus yang lebih santai ke kantor detektif. Mungkin maksudnya buat kasih mereka mendapatkan penghasilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
