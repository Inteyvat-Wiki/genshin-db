			"dialogs": [
				{
					"id": 190602901,
					"content": "Pengembara, aku yakin kamu pasti bisa mencari tahu kebenarannya, pasti ini ulah Shikanoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
