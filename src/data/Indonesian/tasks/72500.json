				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Gawat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Bos ditangkap lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Tadi Tenryou Commission tempel pemberitahuan di papan pesan, isinya kurang lebih mau menghentikan festival kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "Tiba-tiba sekali. Mungkin bos sebar brosur juga ke Tenshukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "Dia juga bilang kalau bahkan Yang Mulia Shogun saja bakal menyesal kalau tidak ikutan Festival Drum Arataki yang Paling Hebat dan Paling Keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Eh? Kalau gitu sih menurutku bos tidak salah. Aku juga merasa Yang Mulia Shogun pasti ingin hadir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Iya, setuju kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Ah, siapa juga yang peduli sama pendapat kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Intinya bos terciduk sama Okuzumeshuu yang sedang bertugas. Dia langsung dibawa ke Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "Terus sekarang gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Kak Shinobu sudah lagi urus sih, harusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Bos dikenai pasal \"membuat kericuhan di kawasan militer\" oleh para Okuzumeshuu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Lalu Nona Kujou Sara mengganti tuduhannya jadi \"mengganggu ketertiban umum\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Ya-ya-ya-ya-ya, dasar Tengu Klan Kujou sialan! Berani-beraninya menjatuhkan tuduhan kayak gitu sama bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "Bodoh! Dia mengganti tuduhannya jadi cuma pelanggaran ringan! Yang begituan biasanya bakal dilepas setelah dikasih peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "Ya sudah, kita tunggu bos bebas dulu, baru pikirin soal festivalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "Pengembara, tenang saja, semua pasti beres kalau ada Kak Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Kamu sudah sangat mendukung jalannya festival ini. Bos pasti ingin berterima kasih langsung sama kamu begitu dia bebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "Semoga perjalananmu lancar jaya, seperti festival kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "Semakin lancar, semakin jaya! YES!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}