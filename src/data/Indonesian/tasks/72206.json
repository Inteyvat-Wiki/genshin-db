				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "Hei! HEI! Kan aku sudah peringatkan kalian? Apa kalian tuli, atau penglihatan kalian kurang??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Wah, ada hantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "WAH! HANTU? Mana? MANA?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "AAAAAH! PERGI! ENYAH! Demi namaku, Abe, tinggalkan tempat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "A-Apa? Astaga! Aku belum pernah ketemu arwah sejahat ini seumur hidup! Ke-Kenapa kamu masih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Ah, aku datang dari luar pulau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Arwah gentayangan dari balik Lautan Kabut? A-Aku tidak takut! Tunggu saja! Great Thunderbird akan menyucikanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Thunderbird-mu telah lama tiada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Kamu bilang apa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Semua orang sudah pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Apa ... maksudmu? Jangan menakut-nakuti aku begitu! Astaga, aku sampai merinding ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Tapi, semakin lama penduduk pulau ini juga semakin sedikit. Kina juga bilang kalau semuanya sudah naik perahu ... *haah* Ke mana perginya anak itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Ah, iya. Arwah dari luar pulau, apa kamu tidak mau pergi juga? Naik perahu perak di tepi laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "Aku tidak lihat ada perahu di sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Hah ... Orang luar memang tak bisa lihat perahu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Tapi, terima kasih sudah beri tahu aku untuk naik perahu, arwah gentayangan. Hanya ... Hanya saja, aku sudah hidup di sini begitu lama, dan masih banyak yang aku belum pernah lihat, dan belum pernah lakukan ... Aku belum boleh pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "Apa yang kamu perlukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Hah? Aku tidak perlu apa-apa sih. Aku cuma ingin lihat sesuatu yang baru saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Waktu kecil dulu, aku bertaruh dengan Una. Aku bilang ada banyak jenis jamur di luar pulau ini, tapi dia tidak percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Belakangan, suaminya pergi ke laut, menuju tempat tinggal orang luar. Dia tidak pernah kembali, dan katanya arwahnya gentayangan di tempat asing ... Kasihan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Una hidup sendirian saja sejak saat itu. Setiap kali aku teringat akan hal itu, aku ... *haah*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Jangan khawatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Aku bahkan sampai memohon-mohon kepada tetua agung, tahu? Setidaknya, beri dia tempat tinggal ... Oh, iya! Jamurnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "*ehem* Aku sebentar lagi harus naik perahu, dan aku juga tidak punya penyesalan apa-apa ... Aku cuma belum pernah lihat apa yang ada di luar pulau ini. Yang bikin khawatir itu sebenarnya jamur-jamur yang kurawat setiap hari ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Tolong bawakan sedikit jamur dari balik Lautan Kabut. Aku ingin lihat bagaimana bentuknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "Tolonglah, arwah dari luar pulau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "Tentang jamurnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Perahu itu bukan untukku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Sudah waktunya pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "Lautan Kabut itu cerita masa lalu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Dor! Aku hantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
