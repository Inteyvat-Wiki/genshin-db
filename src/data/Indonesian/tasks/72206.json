					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Hei! Aku ada di sebelah sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Anak muda zaman sekarang ya ... Benar-benar tidak sopan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "Ma—Maaf!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Huh! Begitu baru bagus. Soal jamur-jamurnya, anggap saja itu hadiah ... Tapi jangan sentuh yang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Apa jamur ini punya kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Bukan urusanmu! Pokoknya tidak boleh main petik sembarangan. Cepat, pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
