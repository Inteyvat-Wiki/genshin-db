			"dialogs": [
				{
					"id": 722060501,
					"content": "Ooh! Haha! Bentuknya aneh sekali! Apa mereka punya jiwa juga? Apa mereka punya ingatan orang-orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "Dan yang mirip sayap lembut ini ... jamurnya bisa terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Ah, penasaran memang tidak ada habisnya! Juru perahu sampai emosi. Maaf ya, kurasa aku harus pergi. Ya, aku harus ....",
					"roleType": "TALK_ROLE_NPC",
