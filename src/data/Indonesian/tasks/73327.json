			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?! A-Apa itu benar kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "Terus ada Paimon juga! Enggak sangka bisa ketemu kalian di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht!! Beneran kamu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Woi, kecilin suaranya! Nanti ikannya kabur semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Bipbip——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Eh? Kamu lagi mancing? Mana jorannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Bip ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Benben, jangan asal bunyi ya! Sudahlah ... {NICKNAME}, bahas hal lain saja yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "Mana jorannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "Kamu ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "Jorannya ... rusak. Bukan salahku loh, jorannya saja yang payah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "Haaa, aku tidak sangka kalau mancing itu sebeda ini dari berburu. Kenapa susah amat sih! Aku enggak cukup sabar buat duduk berjam-jam menunggu ikannya gigit umpan. Terus aku pikir, \"kenapa tidak masuk air dan langsung tangkap saja ikannya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "Akhirnya tetep saja enggak dapet apa-apa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "Enak saja! Dapat dong, gede banget malah. Lebih panjang dari kamu ... Hmm, total panjangnya sama kayak kamu ditambah setengah si Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Bipbip! Bipbip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "Ikannya sudah dibakar, dan sekarang sudah ada di perut. Kamu enggak kebagian, wekk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "Bipbip ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "Benben juga kebagian! Cuma kamu doang yang enggak dapat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Paimon enggak percaya, weeekk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "Hahahaha! Ya sudah, kamu sendiri yang rugi kalau enggak percaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "Gimana kabarmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Hmm? Baik-baik saja kok, tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "Ini bukan pertama kalinya aku jalan sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Bipbip! Bipbip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Hahaha, iya, iya, ada kamu kok. Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "Setelah kejadian Tanit, orang padang pasir tidak mau lagi kasih aku makan dan tempat berteduh ... Lalu aku juga sudah bukan anggota suku yang mana pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Kak Ruks Shah dari Corps of Thirty sempat menawari kerja di kota, tapi ... Aku tidak betah di sana. Jadi keingat ibu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "Akhirnya aku meninggalkan kota, mungkin sekalian saja berkelana ke tempat asing buat nambah wawasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "Terus aku nebeng kapal dagang, dan akhirnya ... sampai di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "Lalu ... yah, belum ada cerita baru lagi sih, haha! Untungnya kerja bodyguard itu selalu kepake di penjuru dunia yang mana pun! Apa lagi di tempat yang ramai lalu lintas dagangnya kayak di sini, setiap jam, setiap hari, ada saja yang lewat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Hehe, begitulah. Aku menikmati hidup yang sekarang, tidak terikat dan bebas berkelana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "Aku dan Benben jadi mirip sama kamu dan Paimon, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "EITSSS, Benben enggak ada setengahnya Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Bipbip!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Hahaha, jangan berantem ... {NICKNAME}, sampai sini dulu ya ngobrolnya. Tadinya aku mau ajak kalian makan bareng, tapi kerja jadi penjaga itu banyak aturannya ... cih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "EHEM! Sudah cukup ah ngeluh-ngeluhnya. Sini, aku kasih seribu peluk dan doa supaya perjalanan kamu lancar terus ke depannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{M#Jangan lupa, pasti akan ada satu hari kita bertemu lagi!}{F#Jangan lupa sama omonganku di Tanit. Kalau suatu hari kamu lelah dan ingin mengambil napas sejenak ... kita akan bertemu lagi.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "Enggak nyangka bisa ketemu di sini ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Iya ... A-Aku juga tidak sangka bisa ketemu kalian. Senang sekali rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Hehe, kami enggak ganggu kamu manci— NANGKEP ikan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Bawel ah, enggak usah dikoreksi segala, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
