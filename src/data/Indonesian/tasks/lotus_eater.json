						722391902
					]
				},
				{
					"id": 722391902,
					"content": "Namun cahaya sejati tersembunyi ... di hati kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "Aku hampir lupa. Sudah lama sekali sejak terakhir kali aku mendengar kalimat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Katakan padaku, siapa yang mengutusmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Master Spartacus?! Master yang mengutusmu ke sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Di mana dia? Aku hanya tahu kalau dia ditangkap saat pemberontakan oleh antek-antek Sunchild. Lalu kami kehilangan kontak dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Dia dikurung di altar Serpent's Heart, dan kayaknya sih dia tidak bisa keluar. Jadi dia mengutus kami untuk mencari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Sunchild sialan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Instruksi apa yang dikatakan Master padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Dia menitipkan pesan pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "\"Jangan pernah menyerah, anak-anak. Harapan Byakuyakoku ada pada kalian.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
