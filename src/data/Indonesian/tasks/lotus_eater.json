			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "Kamu ... Siapa kamu? Kamu terdengar tak asing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "Eh? Kamu sudah lupa lagi sama kami? Wah, kamu ternyata lebih parah dari dugaan Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Terima kasih. Apa kita memang saling kenal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "Kita barusan ketemu loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "Ah, iya, aku ingat. Di tempat ini, setiap jiwa akan dicatat. Ingatanku sepertinya sudah menurun drastis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "Maafkan aku, aku ... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "Jadi, apa kamu berhasil menemukan sesuatu yang berguna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "Apa namamu Supada no Hiko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko ... Benar ... Iya, betul! Aku adalah pimpinan pemberontak, Spartacus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Ooh, jadi keduanya memang namamu, ya? Memang sesuai untuk seorang pemimpin, kamu bahkan punya dua nama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Terima kasih karena sudah mengembalikan namaku. Sepertinya aku jadi ingat beberapa hal lain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "\"Kegelapan datang di balik matahari, namun cahaya sejati tersembunyi di hati kita.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "Apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "Itu kode rahasia kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Sekarang karena aku sudah ingat lagi namaku, ingatanku juga jadi kembali. Itu adalah kode kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Sekarang biar kukatakan padamu di mana anak-anakku sembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "Apa kamu punya pesan yang ingin disampaikan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Coba kupikir dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Katakan ini pada mereka: jangan pernah menyerah, karena harapan Byakuyakoku ada pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "Apa kamu mau aku bawa mereka ke sini untuk melihatmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "Tidak. Jangan pernah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Satu-satunya keuntungan kami adalah musuh berada dalam terang sementara kami ada di dalam gelap. Hati dari rakyat Byakuyakoku ada bersama kami, jadi jangan mengungkapkan diri kita dengan gampang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Lagi pula, aku juga tidak ingat nama mereka satu per satu. Yah, aku bahkan lupa namaku sendiri kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "Jadi ya, katakan saja pada mereka untuk jangan pernah menyerah, harapan Byakuyakoku ada pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "Kalau mereka sudah tidak ada di sana lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "Tidak. Itu tidak akan pernah terjadi. Selama pemimpin korup yang mengontrol Sunchild masih ada, maka mereka pun akan tetap ada di sana. Para pemberontak akan terus bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Berikan wejanganku pada mereka: jangan pernah menyerah, karena harapan Byakuyakoku ada pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "Itu saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "Apa namamu Supada si Bandit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Oh, ayolah! Sudah jelas Supada no Hiko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390305,
					"content": "Kami sedang mencari identitasmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
		},
