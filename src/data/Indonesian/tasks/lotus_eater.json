					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Setelah Master ditangkap, tulang punggung pemberontak luluh lantak dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Hanya mereka, para murid yang mengikutinya berhasil kabur karena mereka jauh dari tempat kejadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Setelahnya, mereka yang beruntung kabur ke tempat persembunyian yang sudah kami siapkan sebelumnya, berharap bisa mengumpulkan kekuatan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Kami punya seorang ahli strategi hebat, pelajar profesional, penyihir luar biasa, dan dokter yang hebat di pihak kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Wow, sepertinya boleh juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "Kami juga berpikir gitu tadinya. Hanya masalah waktu saja sampai kami bisa menyusun gerakan kami lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Tapi semua ini butuh dana ... dan kami tidak punya dana sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Dan akhirnya, beberapa orang memberi ide agar kami menjual Dragonbone Orb ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Dragonbone Orb itu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Itu sejenis buah yang dihasilkan oleh Dragonbone Flower dalam keadaan tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Aroma bunga itu dapat menenangkan pikiran, mengusir kecemasan, dan menghilangkan kekhawatiran. Karena itu harganya pun jadi sangat mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "Memangnya benar-benar semagis itu ya? Kamu yakin ini bukan tipuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Aku sebetulnya berharap kalau semua itu bohong ... Diriku yang naif telah gagal melihat bahaya yang ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "Aku tidak tahu dari mana asalnya, tapi aku tahu formula itu menghasilkan banyak uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Semuanya berjalan mulus sekali ... Tapi, kami mendapati bahwa ada rekan-rekan kami yang mulai menghindari konflik, dan menolak maju ke medan perang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "Orang-orang seperti itu semakin hari semakin bertambah jumlahnya, sampai akhirnya mereka diminta untuk meninggalkan satuan kami. Aku pun tidak bisa menghentikan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Kenapa bisa begitu? Apa karena saking untungnya jualan Dragonbone Orb, orang-orang jadi malas berjuang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Maksudmu godaan harta kekayaan? Tidak, aku ... aku tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Yang aku tahu adalah, ketika orang-orang yang tertindas mulai merasa puas dengan hidup mereka, mereka akan berhenti melawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Itulah titik awal kejatuhan kami, dan sekali dimulai, tidak bisa dihentikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Kadang aku berpikir, apa jangan-jangan formula ini memang sengaja dibocorkan oleh para penguasa jahanam itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "Kadang aku berpikir, apa jangan-jangan berita tentang laris manisnya benda itu, semua cuma tipuan para penguasa jahanam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*huff* Andai saja Master di sini. Aku yakin dia pasti bisa mengendalikan situasi. Malah mungkin langsung mengatasinya sedari awal, sehingga masalah ini jadi tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Maaf, Master. Kami gagal menjadi harapan semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Aku turut menyesal mendengarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Mana boleh aku menghadapinya seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "Tapi, terima kasih karena sudah memberi kabar tentang dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Aku tidak punya apa pun yang bisa kuberikan sebagai imbalan untukmu. Tapi kalau boleh, biar kubukakan rahasia Dragonbone Orb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Syarat khusus untuk menciptakan mereka adalah harus menggunakan air dari Tokoyo Reisen, yaitu air Lethe, untuk menyirami Dragonbone Flower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Mau dijual atau kamu simpan, terserah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Tapi waspadalah. Jagalah tekad hati kalian untuk terus melangkah maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Mau bertemu dengan Mastermu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Ada dua baris teks di nisan ini. Baris pertama ditulis dengan aksara Byakuyakoku dan tidak bisa dibaca.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Sebuah Tablet Batu Kuno"
				},
				{
					"id": 722392402,
					"content": "(Baris kedua ditulis dengan aksara umum, isinya sebagai berikut:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Sebuah Tablet Batu Kuno"
				},
				{
					"id": 722392403,
					"content": "\"Di sini terbaring Spartacus the Righteous, juga dikenal sebagai Supada no Hiko. Berikut tertulis daftar kesalahan-kesalahan semasa hidupnya. Bacalah, dan jangan sampai melupakan sejarah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Sebuah Tablet Batu Kuno"
				},
				{
					"id": 722392404,
					"content": "\"Supada no Hiko, penjahat terkenal, aktor intelektual di balik kejahatan-kejahatan besar, dan akar kerusuhan. Atas nama Tokoyo Ookami, biarlah pandangannya ditutup, dan semoga jiwanya remuk. Jatuhkanlah dia ke penjara yang paling dalam, untuk saat ini sampai selama-lamanya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebuah Tablet Batu Kuno"
				}
			]
		}
	]
}