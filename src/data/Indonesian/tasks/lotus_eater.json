			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Jangan pernah menyerah, Nak. Harapan akan selalu ada untukmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390102,
					"content": "Anak-anak? Apa kalian sudah berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390103,
					"content": "Tidak ... Aku bisa merasakannya. Kalian masih belum ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, sepertinya orang ini memang sudah buta deh dari sebelum jadi bayangan begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390105,
					"content": "Siapa pun dirimu, kumohon, bisakah kamu menolongku? Tolong temukan anak-anakku! Aku harus memberi tahu sesuatu kepada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390106,
					"content": "Ehh, pertama-tama, kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Aku ... namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390108,
					"content": "Aku ... sudah lupa namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390109,
					"content": "Aku hanya ingat ... Aku berdiri di hadapan Byakuyakoku, dan aku bertarung demi sebuah harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390110,
					"content": "Sampai hari ini, aku masih anggota pemberontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390111,
					"content": "Tapi kamu berontak dari apa di Byakuyakoku ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390112,
					"content": "Tentu saja para bangsawan kotor di atas kuil itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390113,
					"content": "Mereka mengaku telah mendapatkan wahyu ilahi dan mengibarkan bendera para dewa, tetapi mereka hanya berusaha memuaskan keinginan mereka sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390114,
					"content": "Mereka seolah-olah menjaga Sunchild. Tapi faktanya, mereka sebenarnya adalah penguasa bangsa — cacing parasit yang mengisap darah dan daging rakyatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390115,
					"content": "Mereka. Harus. Dihancurkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390116,
					"content": "Kamu bisa ingat semua ini, tapi malah tidak ingat nama sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390117,
					"content": "Metode mereka itu benar-benar jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390118,
					"content": "Aku ditangkap setelah gagal waktu terakhir kali, dipenjara dan disiksa di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390119,
					"content": "Penjara ini benar-benar sesuatu yang jahat. Bahkan sekarang saja, aku bisa merasakan jiwaku terpenjara, dan tempat ini juga melucuti barang-barang berharga dariku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390120,
					"content": "Wahai jiwa yang baik hati, kumohon padamu! Selagi aku masih ingat, tolong temukan anak-anakku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390121,
					"content": "Katakan pada mereka untuk tidak pernah menyerah, demi harapan untuk hidup di antara mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390122,
					"content": "Anak-anakmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "Ada sebuah kelompok yang terdiri dari anak-anak muda brilian yang setia mengikutiku. Mereka adalah murid-muridku, dan sisa dari pasukan kami. Aku menganggap mereka bagaikan anakku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390124,
					"content": "Orang-orang licik di atas sana menggunakan segala cara supaya aku buka mulut dan menyerahkan anak-anak itu, tapi aku tidak melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390125,
					"content": "Karena aku tahu ada harapan untuk mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390126,
					"content": "Sekarang ini mungkin mereka semua sudah pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390127,
					"content": "Tidak, tidak mungkin! Mereka semua anak-anak baik. Mereka pasti akan mempertahankan prinsip kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390128,
					"content": "Aku belum menyerah ... dan aku percaya mereka juga tidak akan menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390129,
					"content": "Bagaimana kami bisa menemukannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Aku ingat. Ya, aku ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390131,
					"content": "Biar kuberi tahu padamu tempat mereka sembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390132,
					"content": "Tapi kalau kita berhasil juga, gimana cara menjelaskan diri kami ke mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390133,
					"content": "\"Kami datang ke sini karena ada anggota pemberontak yang lupa namanya menyuruh kami?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390134,
					"content": "Tidak, tidak bisa begitu. Aku sudah mengajari mereka dengan baik. Kamu harus membuktikan dirimu dulu, baru mereka mau mengakuimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390135,
					"content": "Tapi aku bahkan lupa namaku sendiri ... Sialan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390136,
					"content": "#Kok orang ini kayaknya kriminal pada zaman dulu di Byakuyakoku ya, {NICKNAME} — itu loh yang biasa ada di buku-buku sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390137,
					"content": "Paimon yakin harusnya gampang buat cari catatan sejarah tentang dia. Mungkin kita bisa cari di sekitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390138,
					"content": "Kalau saja sejarah mencatat namaku. Semoga saja sejarah itu ditulis oleh orang-orang yang mewarisi tekad kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				}
			]
		},
