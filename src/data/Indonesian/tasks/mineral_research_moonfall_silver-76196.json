			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota? Ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Waktunya pas sekali, Linnea! Aku baru saja jelaskan keajaiban Moonfall Silver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Oh, Moonfall Silver, Moonfall Silver ... Apa ada permata yang lebih sempurna dari dirimu di dunia di bawah rembulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Lihatlah, bentuknya yang sempurna, teksturnya yang mulus dan bulat. Dan warna putihnya digabungkan dengan keharmonisan elemen yang tak ada duanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Di mataku, hanya bulan yang terlelap di langit yang bisa menandingi keindahanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Umm ... Ya, Moonfall Silver itu memang bijih yang indah, aku juga sudah kumpulkan sebagian untuk dijadikan sampel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Tuh kan! Kamu pasti mengerti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Tapi tetap, yang paling mengerti Moonfall Silver itu cuma aku sendiri. Meski kamu itu konsultan Adventurers' Guild, aku tidak akan pernah berikan posisi nomor satu ini kepadamu dengan mudah, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Oh, dan karena kamu yang biasanya ngajarin para petualang, aku akan kasih tes kecil-kecilan hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Di sini ada tiga Moonfall Silver. Sayangnya, ada dua yang cacat sedikit. Tapi yang ketiga adalah koleksi pribadiku, Moonfall Silver paling cantik di antara seluruh Moonfall Silver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Apa kamu bisa membedakan mana yang paling sempurna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Kalau menurutku sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Yang di kiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Hmm? Lumi lagi ngapain tuh?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Yang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Haha, berarti kadang kamu bisa salah juga ya, Linnea. Yang satu ini sebenarnya punya cacat yang kecil sekali di bagian yang paling tidak mencolok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Oke, oke, aku menyerah. Tapi lain kali, aku tidak akan kalah semudah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Oke, aku selalu siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnea akhirnya mengikuti acara apresiasi Moonfall Silver yang diadakan Dorota dan sangat menikmati waktunya di sana ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Wow, tidak kusangka semuanya antusias sekali. Sayangnya momen indah seperti ini selalu berlalu begitu saja ... Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Biar kubantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Asyik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Aku pikir-pikir lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Yang di tengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Lumi kayaknya suka yang ini.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Yang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, kamu bisa merasakannya juga ya? Daya pikat menarik dari sesuatu yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
