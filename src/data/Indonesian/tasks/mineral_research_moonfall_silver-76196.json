			"dialogs": [
				{
					"id": 761960301,
					"content": "Wah, tidak ada yang ketinggalan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Hmm, tidak sih, semuanya aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Aku tadi lihat kamu pakai Moonfall Silver untuk buat pola unik di tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Yah. Perlu usaha sih, tapi aku rasa ini akan menarik minat semua orang sama Moonfall Silver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Oh ya, sepertinya aku pernah dengar ada cerita rakyat Natlan yang seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "Tentang gadis yang awalnya tinggal di atas bintang. Waktu terjatuh ke bumi, dia meninggalkan jejak besar di atas tanah waktu mau kembali ke langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "Pada akhirnya, ayahnya—sang matahari di atas langit—melihat permintaannya dan membawanya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Mungkin dia bisa lihat pola yang kamu gambar dan jadi fans Moonfall Silver juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha, kalau memang begitu, berarti aku bisa jadi duta besar Moonfall Silver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Tapi dibandingkan dengan itu, aku lebih khawatir soal diperhatikan burung di langit sih. Kamu tahu, kan. Burung gagak itu kan suka benda yang berkilau juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Benar, dan selain gagak, kita juga harus hati-hati sama Sniffer Mole dan Weasel Thief di tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "Lumi juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, benar! Lumi juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Oh ya, terima kasih ya bantuanmu tadi. Meski hanya sebagian kecil dari koleksiku, tapi ini kuberikan untukmu, anggap saja hadiah untuk Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Hehe, hari ini beruntung sekali ya, Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
