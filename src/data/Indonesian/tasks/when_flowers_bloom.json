				},
				{
					"id": 230240702,
					"content": "Ini semua berkat bantuanmu, ini mawar paling bagus yang pernah kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "Dokter di \"Bimarstan\" pasti akan kagum juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "Waktunya tidak lama lagi, aku akan segera mengirimkan mawar ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Tunggu ... ada suara apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Ada yang bergerak di ladang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Wah! Itu kan Whopperflower! Kok bisa ada di sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Gawat! Ladangnya! Dia mau merusak ladangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "Aku akan mengurusnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Eh ... eh? Kok Whopperflower-nya kabur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "Kenapa ... kenapa bisa begini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Salah satu mawar dan tanaman obat terpenting kami ... malah berubah jadi monster dan kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "Bukan \"berubah\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Maksudmu ... pertumbuhan mawar ini lambat karena ulah Whopperflower?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Jadi?! Pupuk yang tidak berefek sama sekali itu ... dan siraman air sebanyak dua kali lipatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "Jadi dari awal, yang kita rawat itu Whopperflower?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Sial ... bagaimana caranya dia bisa sampai menyelusup di antara bunga-bunga? Dan kami pun tidak ada yang sadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "Kami juga kadang bisa tertipu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "Eh, kali ini benar-benar gawat, kebun obat di sekitar juga sudah rusak semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "Kita harus menjelaskan kejadiannya ke dokter di \"Bimarstan\", terus kita juga harus langsung menanam mawar yang baru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
