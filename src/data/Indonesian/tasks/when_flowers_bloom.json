					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Fuhh, akhirnya mawar ini bisa dikirimkan ke \"Bimarstan\" tepat waktu.",
