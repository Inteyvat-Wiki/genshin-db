					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "Aduh ... mungkin mawar ini malu untuk mekar di depan kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "Tapi, kalau menurut siklus pertumbuhan mawarnya, paling telat besok pasti akan mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "Pengembara, ke sini lagi besok ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
