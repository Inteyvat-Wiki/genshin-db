			"dialogs": [
				{
					"id": 230240201,
					"content": "Ayo sini, kalian lihat lebih dekat lagi, jadi semuanya bisa terlihat lebih jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240202
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240202,
					"content": "Kamu mengamati mawar yang belum mekar dengan saksama bersama dengan kedua petani obat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Kayaknya enggak ada apa-apa deh ....",
