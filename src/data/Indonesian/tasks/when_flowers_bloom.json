			"dialogs": [
				{
					"id": 230240101,
					"content": "Akhirnya kalian datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "Waktunya pas sekali, semuanya sudah lengkap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "Apa yang membuatmu senang sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Jangan-jangan, mawar yang dulu sudah mau mekar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "Benar, hahaha! Ini berkat bantuanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "Walaupun mawar ini belum mekar, tapi kalau dilihat dari bentuknya, bisa diketahui kalau dia punya daya hidup yang kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "Pengembara, kalau kamu tertarik, kamu juga bisa melihatnya dari jarak dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "Hahaha, siapa tahu tunasnya akan mekar di depanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "Kalau begitu akan kuperhatikan baik-baik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "Be-Beneran? Mekarnya bisa dalam waktu sesingkat itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "Hehe, Paimon juga jadi ikutan semangat nih ngeliatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
