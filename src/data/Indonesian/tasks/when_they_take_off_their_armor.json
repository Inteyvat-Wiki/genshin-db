			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040202,
					"content": "Kenapa? Rosaria tidak suka minumannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040203,
					"content": "Aku bisa bikin satu lagi buat kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Tidak, minuman buatanmu oke kok. Aku cuma jarang minum teh saja. Rasa teh selalu membuatku ingat ... suatu hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040205,
					"content": "Ah, aku tebak pasti kamu kepikiran gereja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040206,
					"content": "Betul. Aku pernah absen di suatu acara gereja, lalu Suster Barbara menyisihkan sedikit teh dan camilan manis untukku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040207,
					"content": "Camilannya sudah apek, jadi dia membuangnya waktu aku tidak lihat. Tapi teh waktu itu rasanya persis dengan yang kamu buat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040208,
					"content": "Wah, jarang sekali bisa lihat kamu begini, Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040209,
					"content": "Tampaknya Mondstadt dapat pecinta teh baru nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040210,
					"content": "Heh, aku lebih suka minuman keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040211,
					"content": "Kalau Kaeya gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Tergantung. Kalau aku sebutkan kurang di mananya, kamu mau tidak buatkan aku satu lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040213,
					"content": "Ahaha, bercanda kok. Mana mungkin aku begitu sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040214,
					"content": "Ampun ya, Kaeya memang susah banget ditebak. Rosaria kok bisa tahan sih minum bareng orang kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040215,
					"content": "Hmm? Aku sih tidak peduli dia lagi mikirin apa, kami cuma ngomongin soal minumannya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040216,
					"content": "Lagi pula, Kaeya cuma berminat pada orang atau benda yang buat dia penasaran. Baik itu kamu, bartender di sini, atau siapa pun itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040217,
					"content": "Woi! Masa kamu tega sekali buka rahasia teman minummu ini, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040218,
					"content": "Menurutmu aku sudah bicara terlalu banyak? Sadar diri lah, bukan apa-apa yang barusan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040219,
					"content": "Bah, aku hidup dikelilingi orang suci sepanjang waktu. Aku lebih suka suasana santai di kedai begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040220,
					"content": "Ooh, jadi sudah waktunya gosip tentang orang-orang yang terlalu serius nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040221,
					"content": "Kalau soal itu, aku tahu siapa yang pantas masuk \"Tiga Besar Orang PALING SERIUS di Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040222,
					"content": "Dan lagi ... saking seriusnya, mereka tidak bakal bergeming biarpun aku langsung ngomong begitu di depan muka mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040223,
					"content": "Memangnya betulan ada peringkatnya? Buat orang-orang kayak gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040224,
					"content": "Tentu saja ada. Tak perlu pikir panjang, langsung ada daftar orang-orang paling doyan minum, paling doyan kerja, paling parah masaknya, bahkan masih ada juga ... yang punya paling banyak rahasia kelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040225,
					"content": "Keterlaluan, kalau kata Paimon sih orang Mondstadt kurang kerjaan banget namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040226,
					"content": "Memangnya ada sebanyak itu ya, pengangguran di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040227,
					"content": "Bukan begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "Wahhh ... terus kalau Paimon apa dong? Ada enggak daftar yang peringkat Paimon sama tingginya sama dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040230,
					"content": "Ada dong, tentu. Gimana kalau \"Bartender Terbaik\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040231,
					"content": "Be-Beneran nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040232,
					"content": "#Asyik, {NICKNAME}! Nama kita bakal dikenang nih, di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040233,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040234,
					"content": "Hmm, harus kuakui kalau suasana di sini jadi boleh juga karena ada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040235,
					"content": "Iya kan? Lihat tampang mereka saja aku sudah ingin senyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040236,
					"content": "Suasana kedai yang hangat dan terbuka itu sangat menjual. Kurasa kalian berdua layak dijuluki Bartender Terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040237,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040238,
					"content": "Tidak, bukan apa-apa. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040239,
					"content": "Ya, aku juga harus pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040240,
					"content": "Teh barusan enak sekali. Aku akan coba buat sendiri kapan-kapan ... kalau aku bisa bangun pagi, tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040241,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040242,
					"content": "Silakan datang kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "Kurasa aku juga tahu siapa saja yang dia maksud ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}