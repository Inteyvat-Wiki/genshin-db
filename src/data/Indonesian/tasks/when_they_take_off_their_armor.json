			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "Waduh. Tidak kusangka hari ini kalian berdua yang jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040102,
					"content": "Kalau begitu, aku mau minum Death After Noon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040103,
					"content": "Kaeya memang jagonya bikin orang susah, belum-belum sudah pesan begituan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040104,
					"content": "Ayolah, aku cuma ingin tahu saja gimana reaksinya. Dan aku juga tidak menyangka hari ini bisa ketemu dengan Suster Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040105,
					"content": "Mengingat banyaknya pelanggan yang sering minta yang aneh-aneh di sini, kurasa ada baiknya kalau kubantu Pengembara kita ini tambah pengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040106,
					"content": "Tuh, mulai deh dia nyerocos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040107,
					"content": "Jangan salah sangka dulu, aku cuma mau menolong loh! Kalian harusnya terima kasih sama aku. Nah, gimana kalau kita mulai dari yang gampang dulu. Moonlit Alley misalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040108,
					"content": "Ekstra besar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040109,
					"content": "Minumanku terserah kalian. Teh saja boleh, dan jangan terlalu besar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040110,
					"content": "Oke, tunggu sebentar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Silakan, santai saja. Menunggu sambil berharap itu ada sensasinya sendiri loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
