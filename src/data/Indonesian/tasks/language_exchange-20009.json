			"dialogs": [
				{
					"id": 200090101,
					"content": "Pengembara, tolong! Di sini, tolong aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090102,
					"content": "Jangan mengagetkan para Hilichurl di sana, kenapa sih kamu selalu berlari sembarangan ke perkemahan Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090103,
					"content": "Sudahlah, itu tidak penting, sudah lama aku mempelajari bahasa Hilichurl, tapi aku lebih senang belajar langsung secara lisan daripada tulisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090104,
					"content": "Akhirnya aku menemukan perkemahan Hilichurl... Aku tidak bisa melewatkan kesempatan emas ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090105,
					"content": "Jadi, Pengembara, bisakah kamu pergi bersamaku ke perkemahan Hilichurl dan mencari satu Hilichurl untuk latihan bahasa denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
