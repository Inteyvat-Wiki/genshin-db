			"dialogs": [
				{
					"id": 740760101,
					"content": "Terakhir, ini tempat yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760102,
					"content": "Untungnya pintu masuknya masih tertutup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "Sepertinya Jakob belum memecahkan teka-teki di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Atau mungkin dia sudah menemukan jawabannya, tapi tidak bisa mengirimkan jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "Coba Paimon ingat-ingat, jawaban sebelumnya adalah \"bayangan\", \"kehidupan\", dan \"cinta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Lalu berdasarkan aturan sebelumnya, modul logikaku menebak bahwa tulisan di batunya berbunyi:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "\"Tak pernah terpisahkan\" ... \"Terlahir dalam sekejap, selalu bertentangan, menemanimu dalam istirahat abadi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Lalu kalimat terakhirnya adalah \"satu tetesan awal\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, kalian tahu enggak teka-teki dari jawaban ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
