						],
						"pointId": 7020
					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Aku punya sedikit pemikiran tentang kalimat \"satu tetesan awal\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "Terdengar seperti hujan pertama setelah dunia diciptakan. Tampaknya Fontaine zaman dulu dan Asosiasi Narzissenkreuz sangat menyukai perumpamaan seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Yah, kalau gitu sih gimana kita mau dapat jawabannya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Jadi satu tetes air ini sudah menyatu ke dalam keseluruhan air. Setiap tetes air adalah satu tetesan awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "Layaknya dewa semula yang menyebarkan potensi agungnya. Di dalam tubuh kita setiap orang juga mengandung komponen yang suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Tapi kalau jawabannya segampang itu, orang di depan itu juga pasti bisa ngasih jawabannya dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "Benar juga. Sepertinya aku yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Meskipun bukan jawaban yang benar, tapi masih tetap jawaban yang baik. Rasanya, pembuat teka-teki itu orang yang tidak paham akan romansa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "Dan dia juga sebaliknya ngetawain kamu orang yang enggak paham sama faktor keamanan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Aku tidak bisa menjawabnya. Ada seribu dua ratus informasi mengenai hasil pencarian satu tetesan awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "\"Legenda mengatakan bahwa tetes anggur pertama di dunia terjadi saat Archon Anemo ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Sudahlah, jangan dilanjutkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "Hmm ... aku punya sesuatu yang bisa dibagikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Legenda mengatakan bahwa Oceanid adalah tetesan air mata pertama dari Archon Hydro sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "Tetesan air mata pertama di dunia adalah air mata pertama yang Oceanid ciptakan setelah ia memahami manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "Bukannya seharusnya air mata paling awal di dunia asalnya dari bayi manusia pertama yang menangis ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Air mata hewan sebenarnya mengeluarkan garam. Dan di masa-masa yang damai dulu, manusia bahkan tersenyum saat bernapas pertama kalinya ketika dilahirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "Ya begitulah yang legenda katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Sebenarnya menurutku tangisan bayi dan hewan yang mengeluarkan garam bisa dianggap sebagai perilaku non-emosional yang serupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Bayi menangis karena adanya rangsangan dari luar dan untuk mengisi paru-parunya sesegera mungkin dengan udara. Begitu yang tertulis dalam buku pelajaran Amurta di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Jadi jawabannya ... Oceanid nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Kalau gitu kayaknya pesaing kita memang enggak bisa ngasih jawaban yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Ya kita lakukan yang terbaik sajalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Tapi Paimon rasa arah ini sudah benar loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "Kalau menurut pemahamanku tentang Asosiasi Narzissenkreuz, sepertinya hal ini masuk akal juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "\"Permaisuri Merah\" yang entah bermimpi di mana, selamanya adalah \"orang di dalam mimpi\" yang lain di mulut lain di hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Omongan kamu malah lebih bikin bingung daripada teka-teki deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Memangnya apa hubungannya? Kita sekarang ada di saat-saat terakhir. Mau bagaimanapun, jawabannya akan terungkap pada akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Kalau begitu, kuserahkan padamu, Ann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Baiklah, akan kucoba. Kalau aku gagal, kalian boleh segera cari jawaban lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Kebuka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Kita harus dapat bagian terakhir ini. Kalau gagal, Pedang Agung bakal jatuh ke tangan Asosiasi Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Tapi Paimon rasa arah ini sudah benar loh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "Pilihan yang lebih baik daripada nyari anggurnya Archon Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Ayo dicoba, kita pergi ke Mondstadt ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Kalau kasih solusi tuh yang rasional dikit dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
