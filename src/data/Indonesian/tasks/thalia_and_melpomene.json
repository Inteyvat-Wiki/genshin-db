				},
				{
					"id": 740760203,
					"content": "Ya. Tapi pintu masuk di sini masih tertutup, berarti kita masih punya kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760204
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760204,
					"content": "Sepertinya pesaing kita belum memecahkan teka-teki di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760205,
					"content": "Tulisan di batu yang ada di tempat ini berbunyi: \"Tak pernah terpisahkan\" ... \"Terlahir dalam sekejap, selalu bertentangan, menemanimu dalam istirahat abadi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760206,
					"content": "Lalu kalimat terakhirnya adalah \"satu tetesan awal\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760207,
					"content": "Seharusnya ada teka-teki seperti ini di beberapa tempat sebelumnya. Kalian masih ingat teka-tekinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760208,
					"content": "\"Bayangan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "\"Kehidupan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "\"Cinta\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "Hmm, jawabannya jadi makin abstrak nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760212,
					"content": "Caterpillar, Seymour, kalian tahu enggak jawaban dari teka-teki ini?",
					"roleType": "TALK_ROLE_NPC",
