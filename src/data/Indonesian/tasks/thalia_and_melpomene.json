			"dialogs": [
				{
					"id": 740760201,
					"content": "Terakhir, ini tempat yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760202
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760202,
					"content": "Enggak ada hasil apa-apa yang didapat dari penjelajahan sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760203
					],
