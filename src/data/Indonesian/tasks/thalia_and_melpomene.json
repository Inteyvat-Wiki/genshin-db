			"dialogs": [
				{
					"id": 740760501,
					"content": "Yang di depan itu, pecahan \"Kepribadian\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Materi di depan ini tidak dapat dianalisis dari kepadatannya. Sepertinya beratnya ... nol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "Sepertinya kita sudah mengambil bagian yang terakhir. Minimal sekarang kita bisa melakukan mediasi dengan lawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Kalau mau mikir positif sih, paling enggak kita masih bisa menghentikan aksinya Asosiasi Narzissenkreuz buat nempa Pedang Agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Bukan begitu, Paimon. Tujuan akhir kita itu mau menempa Pedang Agung, dan pakai Pedang Agung untuk gagalkan rencana mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Tentu saja, Ann. Aku tidak melupakan makna pedang ini bagimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "Pedang Agung yang bisa memotong tekad, bagimu merupakan kunci untuk memecahkan teka-tekinya. Sebenarnya ini sama pentingnya bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "Cuma, sekarang kita punya hal yang lebih penting dan genting. Kita harus menjawab teka-teki soal diri sendiri, apa kamu bisa terima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#Kalau begitu, {NICKNAME}, tolong terima \"Kepribadian\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		}
	]
