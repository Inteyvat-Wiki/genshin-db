			"dialogs": [
				{
					"id": 740760301,
					"content": "Terakhir, ini tempat yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760302
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760302,
					"content": "Enggak ada hasil apa-apa yang didapat dari penjelajahan sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760303,
					"content": "Ya. Tapi pintu masuk di sini masih tertutup, berarti kita masih punya kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760304
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760304,
					"content": "Sepertinya pesaing kita belum memecahkan teka-teki di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760305
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760305,
					"content": "Tapi sebenarnya siapa sih yang nyuri ini dari kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760306,
					"content": "Dengan asumsi bahwa selama ratusan tahun Asosiasi Narzissenkreuz gagal bangkit kembali dan justru terbungkam membisu, sepertinya pengetahuan milikku masih bisa dibilang bermakna. Kemudian kalau digabungkan dengan situasi sebelumnya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760307
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760307,
					"content": "Bisa jadi itu Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760308
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760308,
					"content": "Orang jahat yang menindas Seymour itu? Buat apa dia menginginkan barang-barang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760309
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760309,
					"content": "Barangkali tujuannya sama dengan kita, yaitu mencari material untuk menempa Pedang Agung Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760310
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760310,
					"content": "Asosiasi Narzissenkreuz telah menciptakan kembali empat jenis material kosong yang dibutuhkan di dunia materi ini berdasarkan filosofi misterius dari Kerajaan Bawah Tanah dan Fontaine Kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760311
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760311,
					"content": "Aku tidak bisa memahaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760312,
					"content": "Hal-hal misterius seperti itu memang hanya bisa dirasakan, mungkin lebih sulit dipahami daripada kekuatan elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760313
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760313,
					"content": "Beberapa puluh tahun lalu, aku pernah menginput materi pelajaran tingkat pengantar hingga menengah dari Darshan Spantamad di Akademiya. Ternyata kekuatan elemen juga tidak seajaib itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760314,
					"content": "Apa iya? Tapi bagaimanapun juga, intinya ini adalah perpaduan antara teknologi kuno Fontaine dengan teknologi kuno Kerajaan Bawah Tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760315
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760315,
					"content": "Di dunia ini muncul empat jenis materi, yaitu Ingatan, Harapan, Jiwa, dan Kepribadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760316
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760316,
					"content": "Demi mencegah ambiguitas, lebih baik kita sebut dengan pecahan \"Ingatan\", pecahan \"Harapan\", pecahan \"Jiwa\", dan pecahan \"Kepribadian\" saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760317
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760317,
					"content": "Terus kok barang-barang ini bisa dipakai buat menempa Pedang Agung sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760318,
					"content": "Di dalam filosofi misterius Asosiasi Narzissenkreuz, kuil adalah mikrokosmos dari alam semesta, para anggotanya adalah perwakilan dari para dewanya, dan minyak suci adalah kemauan yang kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760319
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760319,
					"content": "Pedang Agung adalah \"Rasionalitas\" yang menghancurkan segalanya. Pedang ini harus dilahirkan dari kehendak manusia yang utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760320
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760320,
					"content": "Sungguh misterius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760321
					]
				},
				{
					"id": 740760321,
					"content": "Huh, ya begitulah yang namanya filosofi misterius — diri dilekatkan pada apa pun yang terlihat cukup mirip, lalu saat hal semacam ini menjadi ajaib, pada akhirnya fiksi menjelma menjadi kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760322
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760322,
					"content": "Bagaimanapun juga, lawan kita belum berhasil memecahkan teka-tekinya. Atau mungkin dia sudah menemukan jawabannya, tapi tidak bisa mengirimkan jawabannya. Kalau lawan kita Jakob, kemungkinan kondisinya adalah yang kedua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760323
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760323,
					"content": "Tulisan di batu yang ada di tempat ini berbunyi: \"Tak pernah terpisahkan\" ... \"Terlahir dalam sekejap, selalu bertentangan, menemanimu dalam istirahat abadi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760324
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760324,
					"content": "Lalu kalimat terakhirnya adalah \"satu tetesan awal\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760325,
					"content": "Seharusnya ada teka-teki seperti ini di beberapa tempat sebelumnya. Kalian masih ingat teka-tekinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760326
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760326,
					"content": "\"Bayangan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760327
					]
				},
				{
					"id": 740760327,
					"content": "\"Kehidupan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760328
					]
				},
				{
					"id": 740760328,
					"content": "\"Cinta\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760329
					]
				},
				{
					"id": 740760329,
					"content": "Hmm, jawabannya jadi makin abstrak nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760330,
					"content": "Caterpillar, Seymour, kalian tahu enggak jawaban dari teka-teki ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7407604,
			"completionStepIds": [
				7407602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
