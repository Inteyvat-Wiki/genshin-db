			"dialogs": [
				{
					"id": 750280101,
					"content": "Ugh, kamu ... lebih tangguh dari tampilanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Tikus"
				},
				{
					"id": 750280102,
					"content": "Aduh, memangnya kita nyinggung siapa sih? Siapa yang kirim orang buat hajar kita coba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Burung Hantu"
				},
				{
					"id": 750280103,
					"content": "Ampun, Kakak! Apa kami tidak sengaja menyinggungmu? Kumohon ... Tolong beri tahu kami. Kami janji tidak akan berbuat begitu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Burung Hantu"
				},
				{
					"id": 750280104,
					"content": "Hei, kampret! Baru segitu saja kamu sudah terkencing-kencing melawan si pengacau ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Tikus"
				},
				{
					"id": 750280105,
					"content": "Kenapa? Memangnya ambisimu itu bisa bikin kita kenyang? Cukup! Aku sudah lihat semuanya. Kita ini hidup bagaikan rampok dan preman. Tidak ada keren-kerennya hidup dari menjual Saurian begitu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Burung Hantu"
				},
				{
					"id": 750280106,
					"content": "Daripada kita dirampok sama preman yang lebih kuat, kenapa kita tidak gabung saja dengan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Burung Hantu"
				},
				{
					"id": 750280107,
					"content": "Bukannya aku mau nyombong ya, Kak. Tapi aku pasti bakal lebih berguna daripada mereka berdua ini. Cukup sebut saja apa yang kamu butuhkan. Pasti akan aku laksanakan sebaik mungkin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Burung Hantu"
				},
				{
					"id": 750280108,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Kebetulan aku memang lagi butuh anak buah sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Kamu serius?! ENGGAK! Paimon nolak mentah-mentah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Lagian, kita kan orang baiknya dan kalian ini orang jahatnya! Masa kami gabung sama kalian sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Iya, aku ini jujur, baik hati, dan senang menabung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Ehem! Intinya, entah kamu punya rencana apa sama para Saurian ini, tapi mending kamu berhenti sekarang, atau ... emm ... si {NICKNAME} bakal kasih kamu pelajaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Kedua pedagang gelap Saurian itu pun pergi dengan kesal ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon penasaran sama kondisi si Qucusaurus itu. Kita cek yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Ya masih bisa nego sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Hei, kamu itu bakal bawa pengaruh buruk buat {REALNAME[ID(2)|SHOWHOST(true)]}! Jangan khawatir, kami tidak mungkin gabung sama para rampok ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Nguuuk, nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Makasih ya, tapi aku lagi enggak butuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
