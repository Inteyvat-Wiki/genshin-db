			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Hujan api hidup ... tunggu, maksudnya kayak yang di legenda itu? Gunung berapi berevolusi dan menyebar seperti makhluk hidup, mengubah semua yang ada di sekelilingnya jadi gunung berapi? Gila, gila! Bencana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Kayaknya ... gunung berapi enggak kayak gitu deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Ya, ya. Tanpa lahar, tidak ada gunung berapi. Magma tidak bisa keluar di sembarang tempat, soalnya kalau bisa ... wuih, tempat ini sudah jadi zona siaga satu dari kapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Tapi ... gimana kalau ternyata legendanya benar? Duh, kenapa sih Kamera otomatisnya tidak benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Tunggu! Gimana kalau Kamera-nya macet dan tidak bisa bekerja? Kacau balau! Tidak boleh, harus diperiksa sendiri ... biar yakin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Waaah, maaf ganggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Oke, dadah ... eh, ini jangan-jangan ada sesuatu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
