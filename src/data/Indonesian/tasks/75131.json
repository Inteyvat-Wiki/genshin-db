			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Ternyata hujan api hidup itu maksudnya Flowfire Bird yang berjatuhan dari langit? Ah, pantas saja ruang lingkupnya lebih besar dari erupsi biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Waduh, gimana kalau ada yang nabrak genteng rumahku nanti? Tidak, tidak, harus dipikirin mitigasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Yah, kejadian langka juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Iya, betul, burungnya cuma naik ke sana kalau ada letusan. Rumahku jauh dari gunung berapi. Aman, aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "Tapi-tapi-tapi, gimana kalau misalnya suatu hari nanti ada letusan super masif? Itu sih di mana juga tidak aman dong jatuhnya ... aduh ... harus ada rencana ... buat jaga-jaga, buat jaga-jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Waaah, maaf ganggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Santai, kamu tidak ganggu kok. Mungkin ... mulai dari genteng dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
