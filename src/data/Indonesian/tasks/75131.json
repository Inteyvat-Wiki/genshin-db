				{
					"id": 751310301,
					"content": "Hujan ... api ... hidup? Ini apa maksudnya? Apinya bakal mengincar ke atas kepala kita, kayak hidup gitu? Kenapa gunung berapi di Natlan ngeri banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "#Paimon kepo lagi nih, {NICKNAME}, jujur. Mau lihat ke depan?",
					"roleType": "TALK_ROLE_NPC",
