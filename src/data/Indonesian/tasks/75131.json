			"dialogs": [
				{
					"id": 751310401,
					"content": "Hmm ... api yang gerak kayak hidup, bayangan seram, Kamera yang bisa motret sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Firasat Paimon bilang ada misteri yang mencengangkan di balik ini semua! Dan kayaknya ada harta karunnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Paimon nemu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Jujurnya ... nihil! Tapi kayaknya pemilik Kamera ini sengaja taruh sini buat motret pas permukaan tanahnya goyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Jadi kita benerin saja Kamera-nya, terus tunggu tanahnya goyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hehe, petunjuk harta bakal muncul pas gempa! Kayak bayangan tadi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
