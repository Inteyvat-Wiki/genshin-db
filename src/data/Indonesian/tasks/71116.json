			"dialogs": [
				{
					"id": 711160601,
					"content": "Pahlawanku! Terima kasih, aku berutang budi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160602,
					"content": "Jangan sungkan! Di mana ada kesepakatan, di situ ada kontrak. Dan isinya harus dipatuhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Hehe, pahlawan kecil yang satu ini paham betul rupanya! Tapi sepertinya kalian sudah tahu duluan soal urusan ini. Dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160604,
					"content": "Iron Dou'er. Katanya kalian lagi nego sama orang Fontaine di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Negoin apa sih, memangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Ilegal ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "Begitu rupanya. Baiklah, budi baik ini akan segera aku balas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160608,
					"content": "Anak-anak! Ikat dan lempar mereka ke laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160609,
					"content": "Jangan lupa kasih batu supaya tidak ngambang. Mereka ini penyelamat Geng Garam Besi, kasihan kalau matinya terlalu menderita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160610,
					"content": "HAH?! Kamu ... mau APA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Pahlawan kecil, aku pikir kalian sudah paham. Di Liyue, kontrak adalah nomor satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160612,
					"content": "Dan yang mengganggu transaksi antara dua pihak yang berada di luar ranah hukum harus dibungkam. Tentunya kalian tahu tentang \"kontrak\" tidak tertulis yang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160613,
					"content": "Kontrak apaan kayak gitu! Air susu dibalas air tuba, itu baru namanya melanggar kontrak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Aduh, tolong jangan dibikin lebih susah. Kalau aku sendiri yang turun tangan, kalian bakal amat sangat menderita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160615,
					"content": "Kamu tahu tidak aku ini siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Cukup omong kosongnya! Iron Dou'er, Iron Chuan'er, tunggu apa lagi? Sikat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160618,
					"content": "Bos Iron Ming ... jahat. Kejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160619,
					"content": "Tidak sia-sia waktu dan tenaga yang kami habiskan. Kami tidak akan biarkan orang sepertimu mencemari Liyue lebih jauh dari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160626,
					"content": "Bawa semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160620,
					"content": "A-Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160621,
					"content": "Keparat rendahan! Iron Ming, buka matamu lebar-lebar! Aku tanya sekali lagi, SIAPA KAMI?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160622,
					"content": "MI-MILLELITH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160623,
					"content": "Wah? Wah ... WAH?! Ini, ini apalagi, kok tiba-tiba ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Aku pikir kalian cuma pendatang baru, ternyata aparat berbaju preman ya ... sial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160625,
					"content": "Tapi jangan kira aku bakal langsung menyerah! MAJU!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160616,
					"content": "MAMI! Atuuut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
