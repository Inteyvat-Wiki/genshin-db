				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Kawan, aku tidak akan pernah melupakan kebaikan ini! Kalau butuh sesuatu, panggil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160203,
					"content": "Wah, ternyata dia tahu aturan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "Terus terang akhir-akhir ini keuanganku lagi sulit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Butuh Mora? Haha, bisa, bisa ... tapi ada sedikit masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160206,
					"content": "Duit kami dibawa pergi semua sama si bos. Kami lagi bangkrut, miskin, kere, melarat, prihatin, dan sengsara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160210,
					"content": "Bos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Bos Geng Garam Besi, yang lagi di bawah tebing sana, lagi nego dengan orang-orang Fontaine. Kami disuruh jaga markas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160212,
					"content": "Tapi tadi kalian ada lihat juga kan? Kodok-kodok Fontaine menyusup masuk sini selagi bos keluar, terus main tusuk pantat. Sialan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160213,
					"content": "Hiii, pantatnya ditusuk ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Hiii!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Heh! Dikiranya bercanda?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160216,
					"content": "Karena rencana mereka sudah bocor dan mukanya sudah kelihatan, si bos juga pasti bakal kena tusuk. Kawan, mau duit kan? Bantuin sampai beres, duit tak jadi soal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160217,
					"content": "Asal bos aman, aku bawa kalian makan minum enak sampai puas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160218,
					"content": "Dia lagi di mana? Aku samperin deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Di pantai bawah tebing sana tuh. Nanti juga kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160220,
					"content": "Kalian duluan ya, kawan. Aku nyusul kalau di sini sudah kelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160207,
					"content": "Cuma melakukan tugasku dalam menegakkan keadilan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Mulia! Bajik! Kesatria! Oke, aku kasih tahu rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160209,
					"content": "Si bos ... kayaknya lagi susah. Dan perlu bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Iron Dou'er"
				}
			]
		},
