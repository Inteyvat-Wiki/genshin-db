			"dialogs": [
				{
					"id": 711160401,
					"content": "Bos Johnnie, kita ini teman. Aku tahu kamu lagi ada masalah akhir-akhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160402,
					"content": "Padahal kamu bisa langsung bilang ke aku, tapi masalahnya sampai sebesar ini sekarang ... Aku sakit hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160403,
					"content": "Teman, tahu kan bisnis di tempat kami lagi susah. Spina di Rosula lagi naik daun, dan saudara-saudaraku yang lain semua lagi susah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Tapi tentunya burung-burung kecil di markas mesti dikasih makan dong. Masa remah saja tidak dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Bisnis antara kita kan lancar-lancar saja, masih masuk akal lah. Tapi kalau kamu bisa kasih lebih ... aku tidak pernah lupa yang namanya balas budi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Kalau tidak ... haha, lautan segini luas, Iron Ming. Cari teman baru saja sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "Ini sudah tawaran terakhir, Bos Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160408,
					"content": "Kenapa, ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "ORANG FONTAINE! Apa maumu? Duit segitu bisa buat apa?! Jangan banyak omong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160410,
					"content": "DIAM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160411,
					"content": "Bos Johnnie, keluarga Don Pesci bayar aku lima puluh delapan ribu per kotak, De Niro bayar tujuh puluh ribu per kotak. Aku tidak perlu ingatkan seberapa berkuasa mereka di Pelabuhan Lumidouce, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160412,
					"content": "Tapi buat bos, seratus ribu sudah dapat tiga kotak, aku bahkan kasih bonus jasa kirim khusus ... Buat apa susah-susah gitu coba? Persahabatan, bos. Per-sa-ha-bat-an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160413,
					"content": "Tapi aku tidak usah ungkit-ungkit lagi lah ... Bos Johnnie mungkin khilaf, atau lupa, atau tidak kepikiran saja! Kita ngobrol lagi, sambil minum. Oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160414,
					"content": "Hehe, tidak usah. Aku tahu kalian orang Liyue menjunjung tinggi kontrak. Kontrak harus adil untuk kedua belah pihak, pertemanan tidak dihitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Hehe, Bos Johnnie paham betul rupanya ... Anggotaku boleh belajar satu dua hal darimu, ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160416,
					"content": "Hanya saja ... kalau memang paham artinya, ya tolong hormati kontraknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160417,
					"content": "Tentunya, tentunya! Ucapan Anda sangat masuk akal, dan kita semua tentunya sangat menghormati kepatuhan orang-orang Liyue terhadap kontrak. Tinggal bagaimana caranya menunjukkan niat baikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker ... kita bayar lebih. Satu Mora per barang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Tuan Johnnie sangat murah hati. Orang-orang baik dari Liyue ini sudah banting tulang buat kita, tentunya wajar kalau kita kasih mereka ekstra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "KODOK-KODOK FONTAINE! APA MAKSUDNYA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160421,
					"content": "Ayolah, teman, masa kamu tidak bisa merasakan niat baik dan ketulusanku sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Bos Johnnie, ini artinya kamu mau ingkar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160423,
					"content": "Ingkar? Apanya? Walker, menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Tuan Johnnie, menurutku masih banyak ikan lain di laut. Udang kecil pun tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Walker, jangan bikin malu. Masa kamu hina teman-teman Liyue kita seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Toh kita memang sebentar lagi akan mengambil alih daerah kekuasaan mereka. Tunjukkan rasa terima kasihmu sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Maaf, Tuan Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "BRENGSEK, tidak tahu diri! Berani-beraninya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160429,
					"content": "Wah, wah, tenang dulu, tidak perlu pakai caci maki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Eh? Siapa lagi ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Hehe, menarik. Anak-anak di Liyue bernyali besar rupanya. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "Bocah ingusan, mau apa? Nih, Mora. Ambil dan pulang sana ke rumah Mami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "HEH! Itu mulut enggak pernah sekolah ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "Siapa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160435,
					"content": "Kami ke sini demi makan enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Hahaha! Jadi kalian bala bantuannya Tuan Iron Ming ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Ternyata kita punya ide yang sama ya, Tuan Iron Ming? Yah kami juga datang dengan persiapan. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Semuanya, maju! Sudah waktunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160441,
					"content": "Waduh, gimana ini? Sepertinya jumlah kami lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Aku minta maaf, Tuan Iron Ming. Sebelum pertemuan ini, aku sudah atur agar orang-orang yang jaga kemahmu dibereskan lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Sekarang giliranmu. Tenang, bisnis kalian aman di tanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "Bos Johnnie ... Mau caplok Geng Garam Besi, kau kira semudah itu, HA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160445,
					"content": "Ah, banyak cakap. Tapi mampu apa? Anak-anak, sikat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Kami datang buat suruh beberapa orang pulang ke rumah Maminya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
