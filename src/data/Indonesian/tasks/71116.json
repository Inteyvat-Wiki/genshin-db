			"dialogs": [
				{
					"id": 711160801,
					"content": "Perjalanan kali ini menang banyak nih! Sasaran kami berhasil ditangkap, lalu bisa beruntung ketemu Pengembara terkenal juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160802,
					"content": "Kalian kenal kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "Tentu saja. Aku punya saudara yang tinggal di pelabuhan, dan sudah dengar juga semua berita tentang kalian. Tadi aku langsung tahu kok kalian ini siapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160804,
					"content": "Tapi waktu itu terlalu banyak orang, aku tidak mau mereka curiga. Makanya tadi aku pura-pura, maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160805,
					"content": "Jadi kami tadi bukan ikut campur transaksi ilegal, tapi ... malah ikutan menangkap penyelundupnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Haha, betul. Kami sudah lama mengincar geng mereka, tapi baru sekarang bisa menyusup ke dalam. Kebetulan dapat bantuan tak terduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160807,
					"content": "Setelah sebulan menyusup, akhirnya hari ini datang kesempatan untuk meringkus Geng Garam Besi sekaligus ikan besar Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160808,
					"content": "Tapi orang-orang Fontaine itu nyaris membantai kami semua. Untung ada Pengembara, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160809,
					"content": "Tapi sepertinya janji makan enaknya terpaksa diundur dulu. Mohon terima sedikit Mora ini sebagai gantinya. Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160810,
					"content": "Dan tolong jangan ditolak. Membantu orang lain itu harus dihargai, inilah kontrak tak tertulis yang isinya harus selalu kita hormati. Kalau tidak begitu, nanti makin sedikit orang yang rela membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160811,
					"content": "Baiklah, kami masih harus urus sisanya. Silakan kalau kalian ingin duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160812,
					"content": "Semoga perjalanan kalian lancar selalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Chuan'er"
				}
			]
