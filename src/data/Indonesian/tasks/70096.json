			"dialogs": [
				{
					"id": 700960101,
					"content": "Kalau orang terkuat sih ...  pasti kapten kami! Dia bisa menahan Abyss dengan kekuatan fisiknya sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960102
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960102,
					"content": "Itu pernyataan khas orang yang tidak pernah menghadapi musuh kuat dan tidak paham soal pertempuran! Kamu pikir semua yang kuat cuma berdiri dan pukul boneka kayu? Lagi pula, kalau bicara soal kekuatan, Grand Master kita juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960103
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960103,
					"content": "Cukup. Aku panggil  kalian berdua ke sini bukan untuk debat yang tidak penting kayak begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960104
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960104,
					"content": "Lohen? Terus ada kalian berdua? Kombinasinya langka banget nih ... biasanya kalian kan bukan di Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960105,
					"content": "Hah ... aku dengar di Nod-Krai ada dua \"ahli ilmu tempur\", jadi aku ingin mengundang mereka untuk menyusun sebuah \"Arsip Musuh Tangguh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960106
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960106,
					"content": "Siapa sangka, baru ngobrol sebentar saja, mereka sudah \"bertempur\". Sepertinya ... aku harus cari cara supaya kalian lebih profesional lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960107
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960107,
					"content": "Uh ... a-aku ... aku akan langsung mengarang! Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960108
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960108,
					"content": "Kap-Kapten Lohen! Aku juga tidak mau begini, tapi definisi \"musuh tangguh\" itu terlalu samar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960109
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960109,
					"content": "Jangankan monster biasa, bahkan di antara para Archon pun, perbedaannya jauh sekali. Kalau tidak ada standar yang jelas, kita tidak bakal bisa dapatkan hasil diskusi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960110
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960110,
					"content": "Kalau bahas soal \"kuat\" ... Standar dan tolak ukur di mata semua orang harusnya \"naga\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960111
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960111,
					"content": "...\"Naga\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960112
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960112,
					"content": "Serius nih? Kok rasanya perbedaan antar naga itu kayaknya sama besarnya dengan perbedaan antar Archon ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960113,
						700960114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960113,
					"content": "Kenapa kamu mau buat \"Arsip Musuh Tangguh\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				},
				{
					"id": 700960115,
					"content": "Yah ... setelah introspeksi diri beberapa waktu lalu, aku rasa cara terbaik untuk terus menjadi lebih kuat adalah dengan menantang para musuh kuat dari berbagai negara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960116
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960116,
					"content": "(Tidak ada bedanya sama sebelum introspeksi diri deh ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960117
					]
				},
				{
					"id": 700960117,
					"content": "Tapi saat aku bersiap berangkat pagi ini ... ada makhluk aneh yang berbicara denganku pakai kata-kata yang tidak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960118
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960118,
					"content": "\"Wahai manusia yang tersesat, kamu akan menghadapi keagungan naga tiga kali, dan setelahnya, kamu akan memahami arti kekuatan sejati.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 700960119,
					"content": "(Deskripsi ini ... kayaknya pasti Barbeloth deh.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960120
					]
				},
				{
					"id": 700960120,
					"content": "Aku sendiri tidak terlalu percaya sama ramalan, tapi dengan arah sekarang ... hmph, rasanya kok semua hal kayak dikontrol sama orang lain. Sungguh menyebalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960121
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960121,
					"content": "\"Naga\" ya ... kalau bicara soal naga di Mondstadt, pasti yang dimaksud \"Dvalin\" atau \"Ursa the Drake\", dan legenda di Dragonspine ... masih ada tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960122
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960122,
					"content": "Hehe, kamu tidak tahu, kan! Berdasarkan informasi rahasia yang kudapatkan di Nod-Krai, ada seekor naga kuno yang kuat diam-diam tiba di Dermaga Dornman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960123
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960123,
					"content": "Masa sih? Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960124,
					"content": "Heh, entahlah, temui saja langsung, supaya jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960114,
					"content": "Kayaknya kamu lumayan perhatiin soal \"naga\" ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				}
			]
		},
		{
			"id": 7009602,
