			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "\"Kapten\" tidak hanya punya kekuatan luar biasa, tapi juga pernah menciptakan obat khusus untuk melawan Abyss! Kamu tidak, tahu kan? Masih saja bersikeras bilang aku peneliti palsu yang tidak punya pengalaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Tapi apa kamu tahu kecepatan luar biasa Grand Master kami? Dia pernah berlari dari Nod-Krai ke Mondstadt mengikuti Ley Line hanya dalam sekejap mata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
