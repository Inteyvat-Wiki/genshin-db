						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "Orang yang mencari kekuatan, mengikuti petunjuk takdir, dan akhirnya tiba di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "Ternyata Durin ... Paimon kok enggak kaget sama sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Tapi kok nadanya agak berbeda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Pemimpin Tertinggi, ciptaan penyihir, peninggalan malaikat ... masing-masing memiliki kekuatan yang berbeda, tapi semuanya disebut dengan nama \"naga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "Hanya karena \"naga\" adalah simbol kekuatan yang besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Jadi \"bertarung melawan naga\" menjadi bukti kekuatan? Aku jadi bisa memahami Grand Master saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Meskipun sepertinya kamu masih ingin mengatakan sesuatu, tapi untuk selanjutnya, mari kita berkomunikasi dengan senjata saja. Lebih mudah dimengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "Tunggu! Ma-manusia muda, ujian yang kamu cari tidak ada di sini, pergilah ke Stormterror's Lair dan hadapi ramalan terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Ngomongnya cepet banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Kamu enggak apa-apa, Durin? Paimon kok ngerasa kamu agak aneh ya hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Hah ... harusnya semua sudah diucapkan ya ... meskipun banyak yang terlewati!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Um, Albedo minta aku untuk membantunya melakukan eksperimen, jadi aku pulang dulu. Maaf ya, semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Langsung pergi begitu saja ...? Sayang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Hm? Ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Eh ... jadi sebenarnya Durin datang untuk apa? Selain kalimat terakhir \"pergi ke Stormterror's Lair\", kayaknya enggak ada informasi berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Aku punya firasat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Menarik, sekarang aku jadi penasaran, dan ingin menyaksikan sendiri, bagaimana \"ramalan\" ini akan terwujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "Dia datang untuk memenuhi jumlah naga jadi \"tiga\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Seperti aktor yang terburu-buru turun panggung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
