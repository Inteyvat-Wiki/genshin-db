			"dialogs": [
				{
					"id": 700960401,
					"content": "Gerakannya mulus sekali, sama sekali tidak terlihat seperti mesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Serangan Tuan Lohen juga sangat akurat seperti mesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Asyik! Komponen baru! Kita bisa bawa pulang dan buat modul baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "Oh? Kalau begitu, sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa! Cari lebih banyak lagi! Semakin banyak sampelnya, semakin bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Baik. Maaf, kita bicara lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Setelah penjelajahan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz ... zzz ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Eh kok ketiduran ... karena capek main di Dermaga Dornman tadi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "Aino sering seperti ini, energinya cepat terisi, juga cepat habis. Mohon maaf, Tuan Lohen, saat ini aku tidak bisa bergerak. Aku perlu menunggu hingga Aino tertidur lebih lelap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "Sudahlah, aku sudah melihat kekuatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "Semoga data pertempuranku bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Oh iya, orang yang memberitahu kami informasi tentang mekanisme khusus itu juga ada bilang soal \"Dragonspine\". Mungkin kalian bisa sana untuk cek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
		{
			"id": 7009605,
