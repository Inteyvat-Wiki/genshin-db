				]
			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "Bagus ... Berdasarkan ramalan Barbeloth, manusia yang membutuhkan bimbingan itu akan segera datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Dialog pembukaan ... sudah diingat. Efek kemunculan ... sudah dikonfirmasi. Mm, kali ini pasti tidak akan ada yang salah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "Kalian bilang ... kenapa ramalan terakhir itu minta Lohen datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Sudah datang sekarang? Apa jangan-jangan Durin belum selesai ngomong? Waduh ... harus pelan-pelan nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "Apa jangan-jangan terakhir kali \"menghadapi kekuatan naga\" ... itu maksudnya Dvalin? Tapi dia enggak ada di sini hari ini kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Kalau dipikir-pikir, aku sudah pernah melihatnya sebelumnya. Waktu aku baru kembali dari Nod-Krai, dia ada di samping kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Iya benar, waktu kita antar surat buat Varka ke Wolvendom kan! Kalau begitu, \"ramalan\" kamu sebenernya udah selesai dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Setidaknya \"tiga kali berhadapan dengan naga\", kalau dihitung dari awal sampai akhir, mungkin sudah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Tapi apa kamu sudah \"memahami makna kekuatan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Hmm, mungkin inilah alasan \"ramalan\" membimbingku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Tempat ini dulunya merupakan wilayah Dewa Badai sebelum disebut \"Stormterror's Lair\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Dewa yang kuat, yang dapat menciptakan badai untuk melindungi segalanya, namun tidak dapat menghalangi keinginan untuk meraih kebebasan di dalam dinding angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "God of the North Wind yang pernah bersaing dengannya untuk memperebutkan takhta dewa, justru menemukan jawaban yang selama ini dicari setelah melepaskan kekuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Eh? Anak ini ... sepertinya tidak terlalu keras kepala seperti yang Varka katakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "\"Cermin Senja Pagi\", \"Durin\" ... mereka juga pernah terjebak dalam kebingungan dan kegalauan, namun yang membuat mereka menjadi kuat, bukan hanya kekuatan semata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Mhm ... pemahamanmu tidak buruk ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Dan juga malaikat masa lalu, \"Ursa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Masuk akal sih ... tapi memangnya itu kalimat yang kamu bilang, Lohen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Pertama Durin ... lalu Lohen ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "\"Malaikat yang memilih kekuatan, namun masih mendambakan kedekatan dengan manusia, bahkan jatuh menjadi monster yang menyedihkan ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "\"Wahai manusia yang telah menyaksikan semua ini, apakah kamuu masih terobsesi dengan kekuatan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "Hei, itu dialog bagianku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Wuuuah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Ah, aku ... kebablasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Senang bertemu denganmu, Nona Nicole. Aku sudah membaca naskahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "Haah ... yang dipungut dari Durin, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Oh? Jangan-jangan ini juga ramalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Ini cuma tebakanku saja. Kalau hal ini bisa diramalkan juga, tadi aku tidak akan ... uhuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "Pokoknya, naskahnya ditulis dengan bagus. Lumayan menghibur kalau dibaca sebagai dongeng. Tapi aku tidak suka dikasih nasihat ... bahkan oleh \"malaikat\" sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "Aku akan menganggap kamu sedang membicarakan mantan rekanku yang memilih kekuatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Karena kamu sudah menemukan naskahnya, berarti kamu juga sudah melihat semua yang ingin aku katakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Ya, aku akan mencatat semua dialog ini sebagai saran yang berharga. Kalau tidak ada hal lain, aku akan kembali melanjutkan Arsip Musuh Tangguh-ku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Dia enggak bilang bakal dengerin sarannya sih ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Tapi hari ini aku memang belajar banyak. Hmm... mungkin aku jadi sedikit lebih kuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Terima kasih, semuanya ... Tolong sampaikan salamku pada karyawan di belakang layar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "*huff* Benar-benar manusia tangguh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Jadi ... situasinya sebenarnya bagaimana? Apa yang terjadi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Kalian kan sudah selesaikan masalah Dottore dan \"racun warisan\" yang ditinggalkan Ursa di Mondstadt? Kudengar Lohen juga sudah banyak menderita waktu itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Karena itu bencana yang ditinggalkan oleh \"malaikat\" di masa lalu, tentu saja harus mengandalkan \"malaikat\" yang sekarang untuk mengatasinya ... Meskipun sedikit berbeda dari yang kubayangkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Takdir umat manusia ke depannya semakin tidak dapat diprediksi. Bimbingan malaikat terhadap umat manusia juga bukan lagi satu-satunya jalan menuju masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Tapi kemungkinan tak terbatas ini ... mungkin justru itulah yang menjadi kekuatan manusia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Tetap harus melanjutkan pengisian Arsip ya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Kok pada bacain naskah sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
