					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960702,
					"content": "Semuanya sulit di awal ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "Lagian, hasilnya juga enggak jelek-jelek amat kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Apa yang pertama kali kamu pelajari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Um ... itu \"PR Penyihir\"-ku, nanti aku jelaskan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
