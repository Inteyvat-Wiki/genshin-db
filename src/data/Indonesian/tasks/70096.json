				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa, Ineffa! Lihat kincir angin itu! Cepet catat strukturnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Siap. Sedang bersiap untuk mengambil foto kincir angin. Apakah kali ini Aino ingin foto bersama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Eh? {NICKNAME}? Paimon, sama Lohen juga! Hai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Informasi tadi soal si \"naga kuno yang kuat\" dari Nod-Krai ... Paimon tahu deh siapa orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Sedang meringkas situasi ... Jadi, Tuan Lohen ingin aku latihan bertarung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "Terlepas dari semuanya, memang benar. Waktu di ekspedisi, aku tidak sangka, ternyata latar belakangmu rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Tapi itu sudah tidak penting. Dari dulu aku sudah penasaran dengan kemampuanmu. Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hehe! Ineffa! Maju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Maaf, berdasarkan jadwal hari ini, kami masih harus mengumpulkan komponen khusus Mondstadt. Berdasarkan evaluasi, bertarung denganmu mungkin akan memengaruhi tindakan selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Iya ya ... aku hampir lupa soal ini. Padahal aku ke sini karena dengar ada robot gede yang keren banget di Mondstadt ... eh, tanpa sadar malah main-main terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Oke, aku ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen ... nyerah begitu saja?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Asalkan aku membantumu membereskan Ruin Guard itu, kamu bisa meluangkan waktumu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
