					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "Apa nih, dia cuma banyak omong doang. Ngejago lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131602,
					"content": "Parah. Kita harus buru-buru ke Dragonspine, terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Paimon, apa yang kita ubah di alam fantasi tidak akan merubah masa lalu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "Ah, iya ... Seluruh Golden Apple Archipelago sudah kena pengaruh mesin itu, dan Wolfgang cuma ada di sini karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "Makanya Paimon jadi beranggapan kalau si Wolfgang berhasil selamat dari kamar rahasia. Tapi sebetulnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "TAPI! Tapi si Wolfgang ini nyebelin deh ... Segitu banyak kita sudah nolongin dia, eh dianya malah mikir enggak apa-apa kalau orang lain masuk ke lubang yang sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "Dia asli enggak sayang nyawa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Setiap orang punya impian yang dikejar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Iya, iya, Paimon ngerti kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Tapi Paimon sih ngarepnya mereka bisa berakhir bahagia, bisa pulang ke Mondstadt, bisa jadi petualang jagoan, terus bisa ke restoran, jahilin kucing dan makan Sweet Madame sampai enek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "Kenapa sih susah banget dapat akhir yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "Dan justru karena orang seperti itu ada ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Wolfgang tidak pernah sampai ke Dragonspine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
			"completionStepIds": [
				7901318
			],
