			"dialogs": [
				{
					"id": 790132401,
					"content": "Dia berhasil kabur loh! Tapi ... astaga, dia malah muji-muji diri sendiri! Teliti apanya, pesan dari kita kan ditulisnya di tempat yang sangat mencolok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132410,
					"content": "Satu lagi ... sebenarnya nih orang bawa buku catatan berapa banyak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132402,
					"content": "Haiyah, sudah bisa keluar dari situ bukannya pulang, dia malah masih berani lanjut bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132403,
						790132404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132403,
					"content": "Soalnya dia merasa bisa cari solusi sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				},
				{
					"id": 790132405,
					"content": "Iya sih. Kamar yang tadinya bikin dia kejebak seumur hidup, sekarang sudah jadi salah satu bahaya yang berhasil dia atasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132406,
					"content": "Tapi, reruntuhan di puncak gunung yang dia sebut enggak kelihatan loh di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132407,
					"content": "Ya sudah lama berlalu juga kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132408
					]
				},
				{
					"id": 790132408,
					"content": "Masa sudah longsor ke laut sih? Paimon kayaknya lihat bangunan yang mirip-mirip deh di laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132409,
					"content": "Kita cek saja lah kalau senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132404,
					"content": "Dan dia memang berhasil kabur kan, akhirnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				}
			]
		},
