					"nextDialogs": [
						790132603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132603,
					"content": "Memang kedengarannya semakin hari semakin belagu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132604
					]
				},
				{
					"id": 790132604,
					"content": "Reruntuhan di puncak gunung itu harusnya sebelahan sama yang dulu ambruk ke laut.",
					"roleType": "TALK_ROLE_NPC",
