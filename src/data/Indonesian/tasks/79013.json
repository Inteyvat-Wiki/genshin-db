						790132502,
						790132503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132502,
					"content": "Kejebak lagi ya dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				},
				{
					"id": 790132504,
					"content": "Belajar itu baru bisa kalau sudah kena batunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132505,
					"content": "#Bangunan di dasar laut ... Harusnya sih ada di pulau dalam kolam itu ya. {NICKNAME}, pastiin ke sana yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132503,
					"content": "Nih orang kapan belajarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				}
			]
		},
