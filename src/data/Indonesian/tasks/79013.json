			},
			"dialogs": [
				{
					"id": 790132901,
					"content": "(Goresan yang kelihatannya sudah berumur. Isinya ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132902,
					"content": "\"Anginnya besar, tidak bisa tulis catatan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132910,
					"content": "\"Keajaiban terjadi! Di atas ini ada Sweet Madame yang masih hangat!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132903,
					"content": "\"Lupakan dulu soal siapa yang tulis pesan, tapi mereka tahu bahwa aku memang rindu rasanya Sweet Madame. Aneh memang, tapi aku bersyukur sekali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132904,
					"content": "\"Terima kasih untuk siapa pun yang menulis pesan ini. Sweet Madame buatan kalian adalah yang paling nikmat yang pernah kumakan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132905,
					"content": "\"Terima kasih. Aku sudah tahu kalau Dragonspine itu tempat bahaya, tapi aku masih tetap ingin ke sana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132906,
					"content": "\"Kalau aku harus menemui ajal di sana, setidaknya aku masih bisa tinggalkan pesan yang isinya 'banyak jebakan di sini'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132907,
					"content": "\"Dan kalau ada yang baca tulisan itu lalu berhasil melewati bahaya, dan sampai ke titik yang lebih jauh dariku ... Aku lebih bahagia daripada ketika aku bisa makan Sweet Madame sepuasnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132908,
					"content": "\"Terima kasih ya, wahai kamu yang meninggalkan pesan. Justru bahaya Dragonspine-lah yang menarik petualang untuk pergi ke sana.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790132909,
					"content": "\"Dengan hormat, Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goresan"
				}
			]
		},
