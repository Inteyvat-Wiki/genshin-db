			},
			"dialogs": [
				{
					"id": 790131201,
					"content": "Di sini cukup mencolok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Pesan"
				},
				{
					"id": 790131202,
					"content": "Semoga Wolfgang bisa lihat ini ya, jangan sampai dia kejebak ke dalam kamar rahasia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Pesan"
				},
				{
					"id": 790131203,
					"content": "Kita cek lagi deh. Siapa tahu isi catatannya berubah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pesan"
				}
			]
		},
