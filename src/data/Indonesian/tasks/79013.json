				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Baru mau tanya kenapa enggak ada catatan. Eh, ternyata pesannya dia ukir di tiang ... Dia berhasil sampai sini dengan selamat rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Tapi dia kok pede amat sih. Kalau bukan karena kita tolongin, dia pasti masih kejebak di kamar rahasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "Terus gayanya, mau ke Dragonspine. Dijamin dia bakalan jadi daging beku di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "Daging beku, waduh, Paimon kelewatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "Ma-Maksud Paimon, dia ke Dragonspine itu cari penyakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "Kita harus kasih tahu dia! Jangan ke Dragonspine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Ya sudah, kita tulis pesan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "Iya, Paimon juga kepikiran kayak gitu. Oya, kali ini kita tinggalin Sweet Madame lagi saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "Mungkin kalau dia makan Sweet Madame, dia jadi kangen hangatnya rumah di Mondstadt, terus enggak jadi deh ke Dragonspine-nya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "Sweet Madame-nya keburu basi lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Ih ... Yang penting kan niatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Dia mau mencobai alam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Betul! Dragonspine dinginnya minta ampun, Hilichurl-nya banyak, terus ada si itu ... Great Snowboar King!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
