				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(Goresan yang kelihatannya sudah berumur. Isinya ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131802,
					"content": "\"Anginnya besar, tidak bisa tulis catatan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131803,
					"content": "\"Pemandangan matahari terbenam di sini indah. Aku senang bisa ada di sini setelah menghadapi bahaya dan kesusahan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131804,
					"content": "\"Apakah kelak ada orang lain yang akan kemari dan menikmati pemandangan yang sama denganku?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131805,
					"content": "\"Aku berhasil melewati bahaya di tempat ini. Berikutnya, ayo ke Dragonspine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131806,
					"content": "\"Di sini indah, tapi sayang tidak ada Sweet Madame.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Goresan"
				},
				{
					"id": 790131807,
					"content": "\"Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goresan"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
