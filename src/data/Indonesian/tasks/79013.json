				{
					"id": 790133501,
					"content": "Kali ini juga sama. Belum ada pesan dari si Wolfgang, artinya dia belum sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133502,
					"content": "Kita tulis pesan juga, kasih tahu cara keluar dari kamar rahasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133503,
						790133504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133503,
					"content": "Tapi yang kali ini, caranya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				},
				{
					"id": 790133505,
					"content": "Iya ya. Kalau si Wolfgang enggak bisa pakai kekuatan elemen ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133506,
					"content": "Tahu caranya juga percuma. Duh, harus gimana ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133507,
						790133508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133507,
					"content": "Kita cegah dia masuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133509,
					"content": "Iya! Gitu saja, cukup kasih tahu dia di depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133510,
					"content": "Dia enggak bakalan masuk dan enggak bakalan kejebak di dalam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133511,
					"content": "Ayo buru, tulis pesan buat dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133508,
					"content": "Tulis pesannya di pintu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133504,
					"content": "Kalau tidak pakai kekuatan elemen ....",
