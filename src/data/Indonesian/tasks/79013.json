			"dialogs": [
				{
					"id": 790131101,
					"content": "Pintunya kebuka! Ngerepotin gila itu mekanismenya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}, si Wolfgang kayaknya belom nulis apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131103,
					"content": "Artinya dia belum pernah ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "Berarti anggap kita udah bukain kamar rahasianya duluan. Artinya dia enggak bakal kejebak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131105,
					"content": "Kalau mekanismenya tipe yang bisa terpicu berkali-kali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Harus gimana dong ... Oke, kita tinggalin pesan saja buat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131108,
					"content": "Kita bikin ukiran buat kasih tahu dia soal mekanismenya. Taruh di tempat yang mencolok ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131106,
					"content": "Berarti bakal percuma saja kalaupun sekarang diberesin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
			"id": 7901312,
