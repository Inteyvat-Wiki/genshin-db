			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, aku ketangkap lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Itu, aku pasti kangen sih, tapi ... Aku datang ke sini untuk perpisahan. Paman emas bilang kami harus pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Tapi tidak usah khawatirkan aku! Di tempat tujuanku nanti, akan ada banyak teman main! Aku inginnya sih kamu bisa ikut, tapi paman emas bilang belum waktunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Tidak apa-apa kok! Betulan! Aku tunggu saja kamu di sana ... dan kalau aku sudah bosan menunggu, aku akan berubah jadi titik-titik cahaya dan masuk ke dalam mimpi kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Hati-hati di jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Pasti! Main sama kamu seru sekali, makasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Aku tidak sendirian lagi, senangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonno"
				}
			]
