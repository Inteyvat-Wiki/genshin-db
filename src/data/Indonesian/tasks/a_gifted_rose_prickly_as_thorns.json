			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Kalian dua bocah kecil, apa yang kalian lakukan? Mau ngoceh soal aku \"menanam batu\" juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Aku baik-baik saja, tidak butuh gangguan dari orang desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Waduh, jangan belum apa-apa sudah ngajak berantem gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Jangan salah ya, kita bukan orang Desa Aaru, kita juga enggak niat ketawain kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "Kami cuma orang lewat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Orang lewat? Hm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "Biasanya cuma ada beberapa kenalan lama yang mampir ke sini. Ada satu yang menyuruhku sudahi saja pembibitan ini dan kembali ke desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "Ada juga beberapa bocah nakal, selalu datang ke sini untuk buat kekacauan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "Aku baru pertama kali ini lihat ada orang yang berpenampilan seperti kalian ini. Kalian ini sedang apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "Aku pengembara yang sedang cari saudaraku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Ya, kami sudah melakukan perjalanan jauh dan melalui banyak petualangan bersama cuma demi hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} orangnya penuh dengan kebajikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "Mengganggu orang tua atau apalah, enggak bakal kami lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Jadi kakek enggak usah khawatir, kami bukan orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "*ehem* Aku agak malu untuk minta maaf ke dua bocah ini. Tapi aku minta maaf, aku harusnya jangan langsung berasumsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Anak-anak, aku Affan, meminta maaf pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "Kalian ini masih muda tapi sudah bisa menghidupi diri sendiri. Hebat betul, lebih hebat dariku sewaktu masih muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "Kalian tadi bilang kalau aku punya masalah yang tidak bisa kuselesaikan juga bisa minta tolong ke kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Eh? Kakek mau memberi misi kepada kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Ada masalah apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Aku awalnya punya dua tempat pembibitan. Satu di sini, dan satu lagi di sisi barat desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Yah, mungkin karena aku yang semakin tua sih, tapi jujur aku memang semakin sulit untuk merawat keduanya sekaligus. Beberapa hari ini aku tidak sempat memeriksanya, lalu yang satu itu hancur gara-gara beberapa benda hitam yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "Bahaya sekali! Sekalinya masuk, kupikir aku tidak akan bisa keluar lagi. Aku trauma dan tidak berani lagi pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "Harapan terbesarku sekarang adalah memulihkan tempat pembibitan itu, biar nanti bisa kutanami bunga lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Kelihatannya enggak ribet. Gimana {NICKNAME}, mau terima misi ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Tempat pembibitannya yang di sebelah barat desa. Jangan sampai kalian tersasar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Masalah kecil, kakek tenang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "Aku petualang yang menjelajahi dunia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Iya loh, kami sudah mendaki gunung, melewati lembah, melihat sungai mengalir indah ke samudra, bersama-sama bertualang cuma demi sampai ke Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "Jadi kami bisa disebut ... em ... petualang berwawasan luas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "Dengar-dengar di sini ada orang yang sedang menanam bunga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Iya betul, yang aku tanam itu bunga, bukan macam batu busuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Tadi kukira ... Ah, sudahlah, tadi aku mau ngomong apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Eh, kalian berdua sudah kembali. Bagaimana kondisi lahan pembibitan di sana? Apa bisa diselamatkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "Masalahnya sudah dibereskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Menjelaskan soal Withering pada Affan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "Ternyata seperti itu ya. Benar kan yang kakek bilang, banyak benda hitam aneh yang tiba-tiba muncul dari tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Baiklah, aku bisa menanam benihnya dengan tenang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Kalau tiga benih ini bertunas, berbunga, dan mengeluarkan benih baru lagi, kita bisa menanamnya di lahan sana. Banyak bunga yang akan bermekaran di sana nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "Eh? Ini ... batu yang bentuknya aneh itu, kan? Apa bisa berbunga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Kakek Affan dari mana belinya? Jangan sampai kena tipu orang loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Kalian memang bocah yang baik. Tenang, benih bunga ini tidak bisa dibeli pakai Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Ketiganya .... Maksudku, seorang temanku memberiku tiga benih berharga ini. Jadi tentu saja berbeda dengan benih biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "Semakin Paimon dengar, kok malah jadi makin aneh. Kakek Affan, sebenarnya ini benih apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Hehe, yang kutanam ini adalah harapan dari temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Jawaban yang aneh. Benda seperti ini apa bisa ditanam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Bocah kecil, kamu juga tidak akan mengerti biarpun kakek ceritakan. Datang saja lagi nanti kalau ada kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Mungkin sekarang kosong, tapi suatu hari ketiga benih ini pasti akan bertunas dan mekar di tempat pembibitan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "Kalau nanti tanamannya semakin besar, bunganya juga akan semakin banyak, haha. Pastinya nanti akan sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "Baiklah, karena kalian sudah membantu, imbalan yang sudah kujanjikan pasti kuberikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Ambillah, tidak banyak yang bisa kuberikan kepada kalian. Semuanya ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Fiuh, selesai juga misinya. Sudah seharian kita terus berlarian, perut Paimon agak lapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "Sudah jelas yang lari itu aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Paimon kan juga terus menemanimu ngobrol. Ngobrol itu juga butuh tenaga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "#{NICKNAME}, kamu jangan pelit-pelit dong. Kita ambil saja imbalannya terus kita beli makanan buat kita sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Cepat kita hitung ada berapa, terus kita bisa beli berapa porsi makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040424,
					"content": "Biar kulihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Ah, kebanyakan makanan nih bukan Mora ... kayak Shawarma, Tahchin, terus sayur-sayuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "Ini banyak banget deh. Apa kita sudah ambil jatah makan Kakek Affan sehari ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "Kakek Affan tinggal sendiri di luar desa, pastinya enggak gampang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Kalau Mora ya sudahlah. Tapi kalau dia beri kita makanan, emm ... rasanya jadi enggak enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040429,
					"content": "Apa lagi sudah jelas benda yang dia tanam itu mirip batu, tapi malah dibilang ... harapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040430,
					"content": "Apa menurutmu dia berkhayal gara-gara saking lamanya tinggal sendirian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040431,
					"content": "Semakin memikirkannya membuatku makin gelisah saja. Kalau ada waktu kita tengok dia yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
