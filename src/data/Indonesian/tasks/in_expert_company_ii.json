					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140202,
					"content": "Jangan khawatir, Bos. Kotaknya tertutup rapat kok, airnya tidak akan rembes masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
