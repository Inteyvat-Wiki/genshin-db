			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, kenalkan dulu, ini masternya pembuat film, Tuan Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140602,
					"content": "#Tuan Geisert, dia {NICKNAME}, petualang yang sangat berpengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140603,
					"content": "#Kalau Anda lain kali butuh pemeran untuk film aksi, {NICKNAME} pasti pilihan yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140604,
					"content": "Hehe. Nona Qiu sudah terlalu memuji, aku sama sekali bukan master kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Aku hanya orang yang kebetulan paham dengan proses pencahayaan waktu membuat film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Ah, Anda terlalu rendah hati. Pencahayaan dalam pembuatan film Anda jelas-jelas berkualitas tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140607,
					"content": "Pencahayaan dalam pembuatan film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Yup. Dalam teori pencahayaanku, fungsi pencahayaan itu sama dengan penggunaan emosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Tapi ... Bagaimana ya. Sekarang dalam dunia perfilman di Fontaine, yang seperti teoriku ini masih belum terlalu digubris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "Kebanyakan sutradara sih pilihnya langsung pakai gerakan atau pemandangan untuk mengekspresikan ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Aku pernah membuat beberapa film yang menceritakan kisah dengan teknik pencahayaan, tapi sepertinya tidak ada yang tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Tapi sekarang, akhirnya ada sutradara yang menganggap teknik pencahayaanku ini bernilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Sutradara? Aku? Hahaha. Anda jangan bercanda lagi deh. Aku cuma penjual teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140616,
					"content": "Siapa yang bilang penjual teh tidak bisa jadi sutradara? Aku dulu malah bekas reporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Reporter ... Kalau begitu, Anda pasti hebat sekali dalam menulis berita, yang di koran-koran itu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140618,
					"content": "Harusnya sih. Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Heh. Pas sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah! Tidak apa-apa kok, tidak apa-apa. Kan masih banyak kesempatan untuk kerja sama di masa depan, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140621,
					"content": "Semua orang mulai duduk ditemani suara tawa Nona Qiu yang heboh.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Setelah selesai makan, Nona Qiu kemudian memasak seporsi makanan tambahan. Setelah dibungkus, dia memasukkannya ke dalam tasmu ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "Apa pencahayaan sepenting itu dalam pembuatan film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Oh tentu saja. Dalam teori pencahayaanku, pencahayaan itu salah satu cara untuk mengekspresikan emosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
