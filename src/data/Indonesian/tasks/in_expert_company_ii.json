			"dialogs": [
				{
					"id": 741140401,
					"content": "Pancinya ini benar-benar ajaib deh .. Hmm ... Tapi cara pakainya seharusnya sama seperti yang di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140402,
					"content": "Bos, sayurnya sudah kebeli, tapi Marcotte di toko itu kayaknya sudah habis diborong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "Aku juga tidak bisa langsung temukan toko lain yang jual ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#Itu ... Cuma kurang satu itu saja sekarang. Anu, {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140405,
					"content": "Aku akan carikan deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Terima kasih ya. Tenang saja. Aku tahu soal peraturan petualang kok, aku pasti akan tambahkan imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140406,
					"content": "Nanti imbalannya ditambah ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
