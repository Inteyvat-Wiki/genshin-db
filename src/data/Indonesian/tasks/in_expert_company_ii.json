			"dialogs": [
				{
					"id": 741140301,
					"content": "#Aha! Kamu memang yang terbaik, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140302,
					"content": "Kalau bukan karena kamu, semua yang di dalam kotak ini hilang sudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140303,
					"content": "Kami harus balik ke kota dan berikan film ini ke Tuan Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140304,
					"content": "#Terus ... Ayo kita makan bareng. {NICKNAME}, kamu boleh ikut kalau tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140305,
					"content": "Aku bayar imbalanmu setelah kita selesai makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140306,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Bagus! Sepakat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, bawa film di kotak ini ke Tuan Geisert nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, kamu ... beli sayur dulu deh di dekat sini. Aku akhir-akhir ini sedang teliti soal Poisson Seafood Soup. Hari ini kebetulan mau masakkan untuk Tuan Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140311,
					"content": "Bos, kita kan sudah mau ke restoran juga, kenapa bos masih mau turun tangan sendiri sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Lebih gampang sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140313,
					"content": "Ahem! Baiklah kalau begitu. Ayo jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, kamu ikut denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140307,
					"content": "Kebetulan aku lagi lapar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
