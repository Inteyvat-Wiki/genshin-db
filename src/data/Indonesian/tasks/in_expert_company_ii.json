			"dialogs": [
				{
					"id": 741140101,
					"content": "Tidak masalah. Kotaknya tahan air, kita cuma perlu nyelam dan ambil saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140102,
					"content": "Bos, tapi kita semua tidak tahu cara menyelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Aku bisa berenang, tapi menyelam sudah beda topik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Apa ... Apa komisi yang kita pasang di Adventurers' Guild masih dipajang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140105,
					"content": "Bos, bukannya waktu itu kamu yang bilang mau cepat-cepat cabut komisinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Kita sudah cabut kemarin, mereka juga bilang bisa balikin uang muka pasang komisinya hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Uh ... Kalau mau pasang lagi berarti kita harus bayar biaya administrasi tambahan dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140108,
					"content": "Filmnya sudah selesai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Petualang ... {NICKNAME}! Pas sekali kamu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140111,
					"content": "Kamu bisa menyelam? Atau ... mungkin bantu cari penyelam yang punya waktu luang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140112,
					"content": "Kalian mau ... syuting di bawah air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Kami tidak sehebat itu, dan tidak sanggup beli peralatan tahan air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "Hanya saja kotak penyimpanan film kami jatuh ke dalam air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Baiklah, cukup bicaranya! {NICKNAME}, tolong bantu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140116,
					"content": "Jangan khawatir soal imbalannya, aku akan bayar duluan seperti waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nona Qiu"
				},
				{
					"id": 741140109,
					"content": "Kalian lagi ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
