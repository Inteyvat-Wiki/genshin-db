			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Pengunjung sekalian, Turnamen Balapan Easybreeze akan segera dimulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Siapa pun yang berhasil mengalahkan juara bertahan tiga hari berturut-turut, Manusia Nanas Angin Membara, akan memenangkan hadiah kejutan spesial! Bagi yang belum mendaftar, ini kesempatan terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hmph, tidak ada lagi yang berani melawan Manusia Nanas Angin Membara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*huff* Manusia Nanas Angin Membara terlalu kuat. Dia sudah menang hadiah selama tiga hari berturut-turut. Semua kalah lawan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Awrhhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Eh? Kamu mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hmph, sekarang Saurian saja boleh tanding? Oke, kirim saja semua! Biar kalian tahu apa itu KECEPATAN SEJATI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Turnamen yang luar biasa, beda dari biasanya! Apa rekan Saurian bisa menundukkan Manusia Nanas Angin Membara sang juara bertahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
