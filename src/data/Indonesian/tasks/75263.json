			"dialogs": [
				{
					"id": 752630201,
					"content": "Aku juga mau daftar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "Tak disangka! Penantang yang pemberani muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Oh? Dasar bocah terlalu percaya diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Sungguh banyak kejutan hari ini ... Siapakah juara di akhir? Mari kita saksikan bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Para staf sudah menyiapkan arena, dan para penonton pun berdatangan ... Kalian berdiri di garis mulai ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
