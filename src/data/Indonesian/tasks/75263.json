			"dialogs": [
				{
					"id": 752630501,
					"content": "Pertandingan berakhir! Pertandingan berakhir! Hasil yang mengejutkan sudah muncul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#Aku umumkan, pemenang di pertandingan kali ini adalah ... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "Wah! Dia kuat sekali! Tak disangka dia berhasil mengalahkan \"Datang Tak Dijemput\" dan \"Pulang Tak Diantar\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "Gerakannya seperti kilat berwarna emas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Hei, ada kilat perak, kan? Kalian enggak lihat kilat perak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Aku kalah telak ... Sepertinya aku tidak akan bisa mencapai kecepatan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "\"Manusia Nanas Angin Membara\""
				},
				{
					"id": 752630507,
					"content": "Jangan menyerah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Aku ... akan menjadikanmu sebagai panutanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "\"Manusia Nanas Angin Membara\""
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Terimalah hadiah yang sudah kami siapkan untuk juara kali ini. Kamu pantas mendapatkannya!",
