			"dialogs": [
				{
					"id": 752630301,
					"content": "Luar biasa! Benar-benar ada orang yang mengalahkan \"Manusia Nanas Angin Membara\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "Pemenang hari ini berhasil meraih juara dengan langkah secepat angin! Mari kita ucapkan selamat kepadanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "Aku kalah?! Tidak mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "\"Manusia Nanas Angin Membara\""
				},
				{
					"id": 752630304,
					"content": "Dia hebat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Tapi ... Para penonton lama harusnya tahu, \"Manusia Nanas Angin Membara\" bukanlah peserta terkuat yang pernah muncul di arena ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Sebelum \"Manusia Nanas Angin Membara\", masih dua peserta lokal mengerikan yang pernah menguasai arena ini. Mereka juga hadir hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Mari kita sambut ... \"Datang Tak Dijemput\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "daaan ... \"Pulang Tak Diantar\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "Penantang, kedua orang ini adalah lawan yang menakutkan. Dengan kemampuanmu barusan, mengalahkan mereka nyaris mustahil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "Sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "Siap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
