					"speakerTitle": "Venti"
				},
				{
					"id": 3790402,
					"content": "Pancaran sinar muda ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790403,
					"content": "Kamu lagi muji diri sendiri ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790404,
					"content": "...Aku lagi bicara soal Holy Lyre ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790405,
					"content": "#Berkat {NICKNAME} yang sudah memurnikan kristalnya, Holy Lyre tidak akan kehilangan kekuatannya terus menerus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790406,
					"content": "Tapi tetap masih jauh dari kekuatan penuhnya. Kalau saja kita punya lebih banyak tetes air mata Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790407,
					"content": "Kita akan bantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "Tapi gimana caranya kita kumpulkan lebih banyak lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790411,
					"content": "Bisa dibilang sekarang saja Dvalin sedang menangis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790412,
					"content": "Menderita seorang diri di tempat terpencil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790413,
					"content": "Dvalin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790414,
					"content": "Kasihan sekali dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790415,
					"content": "Ini bukan sesuatu yang bisa diatasi sendirian oleh Honorary Knight. Aku akan mengutus para Knight untuk membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790416,
					"content": "#Setelah mendapatkan Kristal Air Mata, biarkan {NICKNAME} memurnikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790417,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "Para pahlawan saling bantu dan pergi bertualang bersama ... Benar-benar mendebarkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790419,
					"content": "Biar aku nyanyikan sebuah lagu untuk kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790420,
					"content": "Jadi itu saja yang bakal kamu lakukan? Cuma nyanyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790421,
					"content": "Tapi kalau aku tidak nyanyi, aku bukan lagi seorang penyair dong, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790422,
					"content": "Hmph. Dasar sombong ... Kamu berhak dapat nama panggilan yang jelek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790423,
					"content": "Oh, Paimon tahu! Mulai sekarang, kamu akan dipanggil sebagai si <color=#00E1FFFF>Pengamen</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790409,
					"content": "Benar, gimana caranya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "Bagaimana cara membuat Dvalin menangis? Pukuli dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
