				{
					"id": 710061001,
					"content": "Ternyata... ternyata begini! Kedua batu ini benar-benar adalah mata kedua patung ini! Hanya dengan memasukkan batunya, matanya akan bersinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
					],
