			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Apakah kamu sudah menemukan lukisan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Aku lupa di mana tempat aku meletakkannya, tapi setiap kali aku melukis biasanya aku letakkan barang-barangku di bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Terkadang kalau aku jalan terlalu cepat, barang-barangku bisa ada yang jatuh. Terima kasih padamu, kalau tidak ketemu, aku harus membelinya lagi di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Kamu masih mau melukis di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Tidak perlu membahasnya lagi. Orang-orang mengatakan bahwa mata kedua patung ini bisa bercahaya, dan bisa melihat ke tempat yang sangat jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Patung raksasa dengan mata bercahaya, berdiri di samping tebing... Ini adalah lukisan yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Tapi kenyataannya saat aku sampai ke sini, aku tidak melihat mata patung itu bersinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Aku kira itu karena aku sudah melewatkan kesempatan, atau sudutnya yang salah, itulah kenapa aku terus melukis di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Tapi... bagaimanapun aku melukisnya, aku tidak menemukan petunjuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "Satu-satunya yang kutemukan adalah benda dari bawah Luhua Pool ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Meskipun aku tidak tahu apa itu, semakin batu ini dilihat, aku semakin merasa bentuknya seperti mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Tapi kalau itu benar-benar adalah mata, mungkin masih ada batu yang lain, bagaimanapun manusia itu memiliki dua mata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "Ah, tapi ini juga hanya pemikiranku saja, kamu jangan terlalu memikirkannya. Sebongkah batu ini juga tidak ada gunanya buatku, ini untukmu saja, anggap saja sebagai imbalan karena membantuku mencari cat dan kuasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Hmm, mata yang bisa mengeluarkan cahaya... Sebenarnya apa rahasia di balik Luhua Pool ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
