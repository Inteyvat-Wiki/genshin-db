			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Ah, bagaimana bisa melukis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "Kamu... Oh, pengembara. Begini, aku selalu mengumpulkan bahan di Luhua Pool, melukisnya, lalu membawanya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Tapi aku selalu tidak bisa mendapatkan sudut pandang yang tepat, jadi aku selalu tidak puas dengan lukisan-lukisan yang sudah jadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Dan karena aku begitu fokus dengan lukisanku, sampai-sampai sebagian besar kuas dan catku hilang entah ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Aku rasa barang-barang itu jatuh di tempat aku melukis sebelumnya, bisakah kamu membantuku mencari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "Kamu melukis di mana saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Ehem, sebenarnya... aku sendiri juga tidak jelas, karena setiap kali aku terlalu fokus, dan tidak memperhatikan sekitarku, posisi tepatnya aku tidak ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Tapi, minggu ini aku hanya melukis dua gambar, sehingga kemungkinannya hanya ada di dua tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Dua lukisan ini untukmu, seharusnya cat dan kuasku yang hilang ada di <color=#00E1FFFF>tempat yang kulukis</color> di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Setelah kamu menemukannya, bawalah kepadaku, aku masih akan berada di sini untuk melihat-lihat... Pasti ada sudut pandang yang lebih baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Tapi, cari ke mana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Setiap kali aku terlalu fokus melukis, dan tidak memperhatikan sekitarku, posisi tepatnya aku tidak ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Tapi minggu ini aku hanya melukis dua gambar, sehingga kemungkinannya hanya ada di dua tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
