						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Batu itu? Kenapa tiba-tiba kamu tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "Aku menemukannya di <color=#00E1FFFF>dalam Luhua Pool</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Kenapa, apakah kamu juga ingin pergi ke <color=#00E1FFFF>Luhua Pool</color> dan mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Kalau begitu kamu harus mencarinya dengan teliti, ada begitu banyak barang di dalam Luhua Pool, tidak tahu siapa yang membuangnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
