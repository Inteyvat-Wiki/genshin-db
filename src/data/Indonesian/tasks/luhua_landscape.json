			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Apakah kamu sudah menemukan lukisan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Aku lupa di mana tempat aku meletakkannya, tapi setiap kali aku melukis biasanya aku letakkan barang-barangku di bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Terkadang kalau aku jalan terlalu cepat, barang-barangku bisa ada yang jatuh. Terima kasih padamu, kalau tidak ketemu, aku harus membelinya lagi di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Kamu masih mau melukis di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Tidak perlu membahasnya lagi. Orang-orang mengatakan bahwa mata kedua patung ini bisa bercahaya, dan bisa melihat ke tempat yang sangat jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Patung raksasa dengan mata bercahaya, berdiri di samping tebing... Ini adalah lukisan yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Tapi kenyataannya saat aku sampai ke sini, aku tidak melihat mata patung itu bersinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Aku kira itu karena aku sudah melewatkan kesempatan, atau sudutnya yang salah, itulah kenapa aku terus melukis di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Tapi... bagaimanapun aku melukisnya, aku tidak menemukan petunjuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "Satu-satunya yang kutemukan adalah benda dari bawah Luhua Pool ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Ah, aku juga menemukan satu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Eh? Coba kulihat... Wah, ini benar-benar sama persis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Aneh, ada kata-kata yang terukir di belakangnya, kalau digabungkan akan menjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "\"Rumah batu menyelimuti pondok kayu, tekanlah di bagian mata sebelum memasukkannya.\"... Tekan? Maksudnya apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Sebongkah batu ini juga tidak ada gunanya buatku, ini untukmu saja, anggap saja sebagai imbalan karena membantuku mencari cat dan kuasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "Oh iya, apakah kamu tidak merasa dua batu ini seperti mata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Kalau benar ini adalah mata, kata terakhir \"tekan\", mungkin ada hubungannya dengan dua batu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Hahaha, ini hanya omong kosong, jangan terlalu memedulikan. Aku akan lanjut melukis, terima kasih karena sudah membantuku mencari cat dan kuasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
