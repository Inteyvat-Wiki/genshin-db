					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "Oh tidak, sudah tidak ada waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Sialan! {NICKNAME}, ayo sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham, kamu tunggu ya! Kami akan datang menolongmu!",
