					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rana",
					"Paimon",
					"Iotham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Maaf ... {NICKNAME}, Paimon, aku mau istirahat dulu. Iotham, tunggu kakak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "Rana, kamu beneran enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Kami akan mencari bantuan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "Tidak apa-apa ... Aku cuma, butuh istirahat saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "Maaf, Kak Rana ... Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "Kamu ini ... Sudah kubilang aku tidak apa-apa! Aku cuma sangat kesal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "Sudah jelas kamu berjanji sama kakak ... tidak akan pergi ke hutan. Nanti kalau Kak Rana sudah cukup istirahatnya, kamu akan kuberi pelajaran karena tidak menurut ... dasar anak bandel ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "Huhu ... aku cuma dengar dari Kak Alphonso kalau jamur di sini besar-besar! Aku mau ambil jamurnya untuk kakak makan, biar tambah semangat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Bodoh ... Kamu tidak perlu melakukan itu. Memikirkan kalian saja sudah bisa memberi Kak Rana semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "Tapi ya, hahaha ... Jamur di sini memang besar-besar sih ... Kalau dibuat kari pasti enak sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Apa Alphonso yang menyuruhmu datang ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "Bukan ... Kak Alphonso juga bilang, jangan sembarangan main di luar. Tapi Iotham cuma mau Kak Rana makan yang enak ... jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonso tidak mungkin melakukan itu, dia kan kakak Iotham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Iya juga ... Tapi Iotham kok bisa sampai terjebak di Withering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Sewaktu aku di hutan, aku merasa ada orang yang mengikutiku ... Aku ketakutan, aku pikir itu \"Jelmaan Marana\" ... Jadi aku terus berlari ... Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "Sampai akhirnya, aku berlari masuk ke Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
