			"dialogs": [
				{
					"id": 730030301,
					"content": "Fiuh ... akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Kak Rana ... huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham ... kamu kan anak laki-laki, jangan menangis dong. Lihat ... kalau kakak bisa menceritakan perasaan selama berada di dalam zona Withering ... pada ... peneliti dari Akademiya. Mereka akan bisa membereskan The Withering itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#Dan kamu lihat kan ... kakak sedang bertempur? Oh bukan, Kak {NICKNAME} bertempur? Seharusnya kamu berterima kasih padanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Sudah, cukup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, mendingan kamu istirahat deh sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ha ... haha ... tidak apa-apa kok. Aku cuma sedikit pusing ... dan capek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Kak Rana, maaf ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Loh kok ngomong gini sih? Kamu kan macan kecilku. Sudah, jangan menangis lagi! Kamu tidak apa-apa, kan? Iotham, apa ada yang sakit? Apa kamu pusing, lemas, atau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Aku sih enggak kenapa-apa, tapi kan Kak Rana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Aku tidak apa-apa ... Kak Rana sungguh tidak apa-apa. Aku ini kan Pelindung Hutan yang tangguh! Ayo kita pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Aku akan mencari bantuan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
