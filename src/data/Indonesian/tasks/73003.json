				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "Itu ... Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Ah ... iya, Zona Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "\"Jelmaan Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Iya. Dialah makhluk yang melakukan kejahatan untuk Marana di dunia ... Wujudnya hitam dan tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana ... Nama yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Hmm, Kenapa aku bisa tahu kalau Marana itu Withering ...? Sial, jadi pusing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, benda hijau tadi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "Itu \"Ararakalari\" ... yang bisa melindungi orang dan tahan dari korosi Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Makin banyak saja hal-hal yang membuatku pusing ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Ini adalah ... sejenis \"sihir\" hutan, juga sejenis \"musik\" ... Inilah Ara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "Apaan tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Jangan mikirin itu, Rana ... kamu perlunya istirahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Aduh barusan aku keingetan, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Maaf, Kak Rana, maafin ya ... Aku janji enggak akan pergi sembarangan lagi, janji bakal diam saja di rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Hmm, kakak tahu. Kamu harus pintar, sehat, tahu mana yang baik dan yang buruk ... Seperti, tahu jamur apa yang boleh dimakan, dan yang tidak boleh dimakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "Aku tahu ... Aku mengerti ... Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Tahu bahwa \"Marana\" tidak baik, lalu ... hutan itu baik ... Menjadi kuat, orang yang benar, membantu yang butuh bantuan ... Seperti {NICKNAME} dan Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "Lalu, jangan lupa ... hutan akan selalu mengingat segalanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Wah, kacau, kata Paimon kondisi Rana semakin memburuk nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Ayo kita cari pertolongan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Eh? Hmm ... Tidak apa, tidak apa ... Aku hanya perlu istirahat sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, tolong ... Bantu aku mengantarkan Iotham pulang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Baik, ayo kita jalan, Iotham. Rana, jangan ke mana-mana loh! Kami sebentar balik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, tunggu kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
