			"dialogs": [
				{
					"id": 730030701,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030702
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030702,
					"content": "Hei, Rana! Kamu bisa dengar suara Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030703,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030704
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030704,
					"content": "Kenapa sih ini ...? Apa ini yang dulu pernah Iotham dan Rana omongin? Itu loh apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030705,
					"content": "\"Ararakalari\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Nah, itu dia! Benar! Kalau enggak salah mereka ngomong itu bisa buat nahan korosi Marana atau apalah itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Iya. Nara pintar. Ararakalari bisa menahan Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "Waaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030712,
					"content": "Waaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030713,
					"content": "Bukannya kita pernah lihat ini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "*fiuh* Ngagetin saja! Paimon kira kamu sayuran yang bisa ngomong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030716,
					"content": "Aku bukan sayuran, tapi Arana. Arana adalah teman, Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030717,
					"content": "\"Aranara\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "Eh? Kamu bilang Aranara? Kalau Paimon lihat lebih teliti lagi, Paimon jadi makin yakin kalau dulu pernah ngelihat kamu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030719,
					"content": "\"Arana\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "Dulu rasanya pernah dengar nama ini waktu bercerita untuk Iotham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Iya. Nara Iotham adalah temannya Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Aranara adalah anak hutan dan tinggal sama pohon. Tidak sepertimu, Nara {NICKNAME}. Kamu seperti anak dandelion, kerjaannya selalu berkelana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#Kok kamu bisa tahu namanya {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "Bagaimana Arana tahu itu tidak penting. Tapi Arana ingin membantu Narana, itu yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030730,
					"content": "Narana ... aduh lidahku hampir keserimpet ngomongnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "Jadi kamu mau bantuin Rana? Terus kamu butuh bantuan apa dari kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030733,
					"content": "Terima kasih, kalian semua Nara yang baik. Dia adalah sahabat yang sangat penting buat Arana. Jadi, Arana akan melindunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030734,
					"content": "#Tapi itu saja tidak cukup. Kita butuh Bija untuk menyembuhkan Narana. Nara {NICKNAME} harus pergi ke Vanarana dan minta tolong orang-orang untuk mendapatkan Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030735,
					"content": "Bija ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Narana terkena korosi Marana, sangat parah. Akar pohon terkena gigitan kutu busuk. Pohonnya akan mati mengering, buahnya akan membusuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030738,
					"content": "Hidup Nara seperti pohon, dan kutu busuk itu seperti Marana. Cuma Bija saja yang bisa memulihkan Narana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030739,
					"content": "Uh ... Jadi, kami harus pergi ke tempat yang namanya \"Vanarana\" dan bawa balik \"Bija\"-nya, kan? Terus kita baru bisa nyembuhin Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030740,
					"content": "Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030741,
					"content": "Terus kondisi Rana sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "Jangan khawatir. Arana tetap di sini, melawan korosi Marana. Jadi, tidak akan memburuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030743,
					"content": "Tapi kalau tidak ada \"Bija\", ya tidak bisa pulih-pulih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030745,
					"content": "Ikuti \"jalur hutannya\", susuri tempat datangnya air, lalu sampailah di \"Vanarana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030746,
					"content": "Lalu bernyanyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030747,
					"content": "Lah kok nyanyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(Ada melodi yang mengalun di benakku ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Ini namanya \"Irama dari Mimpi yang Besar\". Nyanyikanlah supaya bisa masuk ke \"Vanarana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030752,
					"content": "Masuk ke mimpi dan dunia kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030748,
					"content": "Nyanyi bisa menarik perhatian Whopperflower loh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Nara {NICKNAME} benar-benar lucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030744,
					"content": "Aku mengerti. Bagaimana cara ke sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "Apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "Apa yang perlu kulakukan untukmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "\"Arana\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Dulu rasanya pernah dengar nama ini waktu bercerita untuk Iotham ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Iya. Nara Iotham adalah temannya Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
					"content": "\"Aranara\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "Eh? Kamu bilang Aranara? Kalau Paimon lihat lebih teliti lagi, Paimon jadi makin yakin kalau dulu pernah ngelihat kamu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "Sayuran ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "Apa tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Kayaknya mereka lagi ngomongin sesuatu yang bisa nahan Marana deh ... Namanya aneh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "Namanya Ararakalari dan dia bisa melawan Marana. Itu bukan nama yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
			"id": 7300308,
			"completionStepIds": [
				7300314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
