				{
					"id": 730030603,
					"content": "Rana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030604
					]
				},
				{
					"id": 730030604,
					"content": "Kok enggak ada jawaban sih ... Sial, ada apa ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030605,
					"content": "Hmm? Jejak ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030607,
					"content": "Lebih baik ikuti saja, siapa tahu itu petujuk dari Rana buat kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030606,
					"content": "Jejak apa ini sebenarnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030607
					]
				}
			]
		},
