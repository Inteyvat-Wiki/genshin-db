			"dialogs": [
				{
					"id": 750190301,
					"content": "Sepertinya aku tidak boleh protes ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Manqu, lihat aku. Apa kamu tidak dengar yang dibilang Titu? Selama 500 tahun ini, tidak ada seorang pun yang berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Walaupun kamu menemukan jalan masuknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Terus gimana? Dengar baik-baik ya — tidak ada manusia maupun rekan Saurian yang pergi ke sana bisa berhasil kembali dengan selamat. Tidak ada satu pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Maaf kalau aku lancang, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Oh itu dia si Om dari Asosiasi Relik. Terus di sebelahnya ... itu si kepala suku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Oi! Om Relik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, ternyata kalian, {NICKNAME} ... Paimon, dan {REALNAME[ID(2)|SHOWHOST(true)]} juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Eh, Tepetlisaurus dengan syal merah di ekornya! Kelihatannya dia semangat sekali! Oke, ayo sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Wah kamu hebat juga! Jadi kamu {REALNAME[ID(2)|SHOWHOST(true)]}? Kalau begitu kalian berdua ini orang yang dipilih olehnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME} dan Paimon, kalian berdua belakangan ini tenar banget loh di kota. Manqu terus-terusan bicara tentang kalian, dan Titu juga ada menyebut kalian waktu dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "Tindakan kalian belakangan ini bisa dibilang \"legendaris\", dan kalian juga sejauh ini sudah jadi teman bagi Putra-Putri Gema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Jangan sungkan gitu ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Haha, anak muda yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "Dan sekali lagi, Manqu, kita tidak bisa mendorong tamu-tamu kita ini ke lahar gunung berapi cuma untuk membuktikan hipotesis kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "Setidaknya itu bukan \"caraku\" memperlakukan tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "Ini ngomongin apa sih? Ada bahaya dan lahar gunung berapi segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Maaf. Biar kujelaskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Masih ingat pembicaraan kita sebelumnya? Untuk menghapus tanda Berkah Sang Penguasa Api, kalian perlu bawa dua jimat ke gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "Salah satu jimatnya ada di reruntuhan di lahan Putra-Putri Gema ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "Tapi untuk masuk sana jelas ada syaratnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Berdasarkan adat istiadat ... Yang baru saja kuketahui dari gulungan kuno ini, dan memang sudah lama sekali sejak ada orang yang mau mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Kalau kamu mau bawa rekan Saurian-mu ke gunung berapi untuk dibersihkan dari Berkah Sang Penguasa Api, kamu harus diakui dulu oleh kepala sukunya Saurian tersebut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#Dan karena {REALNAME[ID(2)|SHOWHOST(true)]} adalah Tepetlisaurus, jadi artinya kepala suku dari Putra-Putri Gema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Bukannya itu kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Iya sih. Tapi jujur saja, aku tidak tahu kalau aturan ini berlaku untuk orang luar apa tidak, namun tetap saja, {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Selama ratusan tahun, sudah banyak orang-orang yang ingin membebaskan rekan Saurian mereka dari garis keturunan yang soal ini, sejujurnya kurasa ini bukan berkah tapi kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Tapi tidak ada seorang pun yang berhasil ... makanya perlahan adat itu pun terlupakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Jadi tingkat keberhasilannya 0% banget?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Iya, ini perjalanan berbahaya. Bahkan katanya ujian buat ngambil jimatnya itu bukan cuma untuk pejuangnya saja, tapi juga untuk Saurian-nya juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Kamu bukan dari suku kami, tapi aku tidak mau kamu mati sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Jadi tolonglah, {NICKNAME}, kusarankan agar kamu mundur saja dan tinggalkan {REALNAME[ID(2)|SHOWHOST(true)]} di sini bersama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Setidaknya, aku bisa menjamin bahwa dia akan dirawat dengan baik sampai pada masanya dia harus memasuki Kerajaan Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Tapi ... kalau gitu artinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#Seperti yang kubilang, {REALNAME[ID(2)|SHOWHOST(true)]} tidak akan bisa tumbuh besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "Kayaknya bukan itu yang dia mau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Aku tetap mau coba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Walaupun kamu tahu itu berbahaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Mhm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "Dan bagaimana denganmu, Nak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Hahaha! Semangat juang yang pantang menyerah, semangat yang begitu menyala. Hatimu membara bagaikan Phlogiston!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Baiklah. Kalau begitu kuizinkan kalian pergi napak tilas ke gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Oke! Ayo kita ambil jimat pertama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "Oh, belum. Kamu masih belum memenuhi syaratnya, sekarang kamu harus mengikuti ujian kesaksian dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Menurut adat istiadat kuno, pejuang dan Saurian-nya harus sama-sama mendapatkan bulu dari quetzal hijau di kedalaman hutan, dan memberikan sepotong kulit hewan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "Dan bersama-sama, kalian harus bisa memenangkan 50 pertarungan untuk suku kami, dan memberikan 96 permata berkualitas tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Eh, kok rasanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Duh, Manqu, kamu ngoceh apa sih. Tradisi dari mana tuh? Dari zaman batu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "Tujuan dari semua formalitas itu untuk memperkuat hubungan antara manusia dan Saurian, dan mengasah kemampuan mereka — aku sudah muak dengan itu semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#Dan sejauh yang kulihat, {NICKNAME} dan {REALNAME[ID(2)|SHOWHOST(true)]} tidak butuh pembuktian macam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Sederhananya, {NICKNAME}, kita pakai cara sederhana saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Lawan aku, dan buktikan kekuatanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "AYO MAJU!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Hah? Di sini? Oh, maksudnya di atas panggung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Tentu saja bukan, haha, panggung ini tidak bisa dipakai sembarangan ... Duel kita nanti di belakang gunung sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Ayo kita ke sana — kita bisa duel sepuasnya di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Bisa tidak kamu kasih diskon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
