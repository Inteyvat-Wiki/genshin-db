						],
						"pointId": 8923
					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Hehe, bagus! Kita menang! Hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Hah ... Hoo. Sepertinya pejuang terhebat di suku kami saja belum tentu bisa mengalahkanmu ... Itu tadi memang kemenangan yang gemilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Gimana menurutmu? Sepertinya kita masih harus banyak latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Fuwaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Memang tadi itu duel yang luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Bicaramu manis sekali, Manqu, tapi apa cuma segitu saja? Kamu mau coba duel juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Tidak, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Huh. Dasar orang yang membosankan. Ah, tadi itu duel yang bagus deh! {NICKNAME} ... kamu memang benar-benar tidak bisa diremehkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Aku tadi cuma pemanasan loh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Hahaha! Sombong sekali kamu! Tapi aku tetap mengagumimu. Yang kuat memang boleh agak sombong dikit! Kalau tidak, ngapain susah-susah jadi orang kuat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, sepertinya kamu memang dirawat dengan baik ya, {REALNAME[ID(2)|SHOWHOST(true)]} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Iya dong! {REALNAME[ID(2)|SHOWHOST(true)]} itu rekan kepercayaan kami tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Aku senang mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Sesuai janji, ini tanda pengakuan dari kepala suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Dan untuk nama resminya — Manqu, giliranmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Jimat Waxaklahun Ubah Kan ... Sage Pencuri Api.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Aku jelas tidak bisa hafal nama sepanjang itu, tapi aku ingat sejak Naga Pyro meninggal, dan setelah Archon Pyro pertama dibangkitkan dari bara api ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "Sage dan Archon masing-masing membawa sebuah jimat dari gunung berapi, dan siapa pun yang bisa mengambil keduanya maka diperbolehkan masuk ke dalam api penyucian di dalam gunung berapi dan membersihkan semua kutukan dan kotoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Tapi si Sage ini sudah hidup berapa lama sih, Manqu? Kok rasanya dari zaman dulu banget sampai zaman Ochkanatlan semua ada kisah dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "Bahkan ada legenda tentang dia di Paku Bayangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Hmm, dia orang pertama yang memakai Phlogiston ... dan entah nasib seperti apa yang menimpa si tokoh legendaris tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Beberapa mengatakan bahwa tubuh dan jiwanya berubah jadi Phlogiston, menyatu dengan angin, tanah, dan bunga-bunga di Natlan, memberinya kekuatan untuk mendengar semua doa dipanjatkan kepadanya dari berbagai suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Beberapa mengatakan bahwa di setiap era ada orang yang menjadi keturunan dari sang Sage, bahkan sampai hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Tapi — mohon maaf karena harus bicara lancang: ini kebanyakan cuma spekulasi para penutur cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha, hati-hati dengan ucapanmu tadi. Titu bakal marah kalau dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Oke. Kewajibanku di sini sudah selesai dan— oh, tunggu, menurut tradisi masih ada 1 hal lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Yakni untuk memberikan berkah kepada pejuang pemberani dan rekan-rekannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Fuwa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Ooh, jadi itu juga ritual yang kalian lakukan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Heh, ini cuma dukungan moril saja. Jangan terlalu berharap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Kalau gitu, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Aku di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Semoga sayap kalian membawa kalian terbang melewati pegunungan bagaikan sayap burung tertangguh.\\nDan biarlah ombak terganas sekalipun pecah saat berhadapan dengan kalian yang bagaikan karang terkokoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Semoga kalian tidak pernah takut akan tantangan, karena bahwasanya dunia ini dipenuhi oleh marabahaya.\\nDan biarlah kalian tidak pernah melupakan satu sama lain, karena sesungguhnya takdir akan selalu membawa perpisahan yang tak terelakkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "Semoga kalian bisa mencapai tujuan dan mendapatkan apa yang didambakan ... Dan yang terpenting, semoga kalian bisa kembali dengan selamat, aman, dan sentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Pasti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Eh? Tunggu, kok Paimon enggak diberkati juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha! Buat Paimon ... Semoga kamu selalu bisa makan dan minum yang enak, tidur nyenyak, dan tumbuh dengan sehat walafiat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Boleh juga tuh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Ya sudah Paimon terima saja berkat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Oke, jadi ujian kesaksian sudah berakhir. Tapi sebelum pergi, biar kuingatkan lagi: berhati-hatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Oke, Pacal. Dadah! Dadah juga, Uchu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Sampai jumpa, semoga semuanya lancar-lancar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Memangnya Paimon bisa tumbuh dengan sehat walafiat ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Pasti bisa dong! Kamu lihat saja nanti, Paimon bakal tumbuh sebesar gunung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Kamu sendiri juga cukup oke kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Hahaha, tidak perlu menghibur kok. Kalau aku masih muda, siapa tahu hasilnya bisa beda? Ah, andai saja aku bertemu denganmu waktu masih muda dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
