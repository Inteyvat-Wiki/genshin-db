					"Manqu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "Sekali lagi maaf kalau aku lancang ... Walaupun aku tahu kekuatanmu tapi ... berhati-hatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Meskipun dia tidak punya Marga Kuno, tapi Pacal tidak bisa dianggap remeh ... sampai sekarang saja dia masih rutin latihan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "Kalau kamu sudah siap, kita bisa mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
		{
			"id": 7501907,
