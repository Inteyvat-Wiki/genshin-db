			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Hei Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "Pengembara! Ah — maaf. Dalam situasi apa pun juga aku harus memanggilmu \"Honorary Knight\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "Sepertinya kamu sudah dengar? Kamu adalah Windblume Star tahun ini. Kamu akan memberikan bunga Windblume kepada Archon Anemo, Barbatos, mewakili seluruh rakyat Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "Namun... Akan ada sedikit sesuatu yang berbeda kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "Yap yap! Dengan adanya kami dan si Pengamen ini di sini, Festival Windblume tahun ini pasti akan lebih meriah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "Benar sekali. Terima kasih karena sudah tinggal di Mondstadt, dan kuharap kamu akan terus menikmati kehidupan di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "Upacara Windblume akan dimulai. Windblume Star, apa kamu sudah memilih Windblume milikmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "Jadi kami tinggal pilih satu jenis bunga lalu kasih ke Archon Anemo, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Benar. Tolong pikirkan baik-baik. Ingat, kamu mewakili seluruh rakyat Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, bunga seperti apa yang kamu suka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "Eh? ...Licik sekali, ingin main curang dan langsung bertanya padaku, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "Uhuk, uhuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "Hei! Kalian berdua jangan main rahasia-rahasia di sini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "Haha, ketahuan deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "Jangan khawatir tentangku, pilih saja sesuatu yang kamu suka. Aku percaya pada seleramu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "Jadi, Honorary Knight, apa pilihanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Dandelion",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Aha! Jadi kamu melemparkan pilihanmu pada salah satu favorit orang-orang ya! Windblume memang harus dibuat dari Dandelion sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "Mewakili rakyat Mondstadt, silakan berikan bunga Windblume pilihanmu ke patung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Windwheel Aster",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Aha! Jadi kamu melemparkan pilihanmu pada salah satu favorit orang-orang ya! Windblume memang harus dibuat dari Windwheel Aster sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Cecilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Oh! Ide yang sama seperti Beatrice, Cecilia sebagai Windblume. Cukup cantik, dengan beberapa pendukung yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Small Lamp Grass",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Oh! Sama seperti Nimrod, Small Lamp Grass sebagai Windblume. Bunga yang menerangi kegelapan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Sweet Flower",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Oh! Sama seperti Sucrose, Sweet Flower sebagai Windblume. Bunga yang sudah ada dari zaman dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Wolfhook",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Oh! Ini sama seperti Razor, Wolfhook untuk Windblume. Tajam tapi cukup menggelikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
