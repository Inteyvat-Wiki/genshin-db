				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "Terima kasih, Windblume Star, atas pemberian bunga Windblume yang tulus kepada Archon Anemo, Barbatos. Semoga angin selalu melindungi Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Pilihan bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "Kamu menyukainya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Hehe, coba tebak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "Ih, dasar! Berhentilah membuat orang menebak-nebak terus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "Ahahahaha! Baiklah, baiklah, akan kuberi tahu. Tapi tidak di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "Bukan ide bagus karena banyak orang di plaza sini. Sepertinya kita harus ganti suasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "Kita harus pergi ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "Aku ingin kamu pergi denganku ke Stormterror's Lair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
