			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah... sungguh pemandangan yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "Aku juga merasa begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "Ya kan? Aku suka tempat ini. Terkadang, saat aku tidak mengerjakan apa pun, aku datang ke sini hanya untuk duduk dan memandangi pemandangan sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "Maksudmu duduk dan bermalas-malasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Hahaha, ketahuan deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "Indah sekali... andai saja ada beberapa botol sider di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "Jadi, Pengembara. Festival Windblume di Mondstadt. Apa kamu menyukainya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "Benar-benar penuh cinta dan meriah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Namun, masih ada hal yang ingin kamu tanyakan, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Aku tahu pertanyaanmu. Sebenarnya apa itu Windblume? Dan apa arti Windblume dan Festival Windblume bagi Barbatos, sang Archon Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Seperti yang kamu lihat, setiap rakyat Mondstadt membuat pilihannya sendiri. Dari jutaan bunga di luar sana, beberapa memilih Dandelion, beberapa memilih Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "Hm... memang sepertinya \"Windblume\" mempunyai arti unik bagi setiap orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Benar, dan memang sudah seperti itu dari dulu. Tidak ada satu jawaban yang benar, dan Windblume juga tidak benar-benar ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Jadi Windblume... tidak benar-benar ada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "Kata Windblume berasal dari zaman Mondstadt Tua. Windblume merupakan sebuah kode rahasia yang digunakan orang-orang untuk tetap berkomunikasi dan merencakan pemberontakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "Pada saat itu, orang-orang sering berkata bahwa semakin kuat angin bertiup, semakin kokoh pula akar Windblume tumbuh, dan semakin indah juga bunga mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Jika kamu mau pendapatku, Windblume itu tidak ada. Tapi mereka juga selalu ada di sekitar kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Mereka adalah semangat yang berjuang untuk kebebasan, keberanian untuk mengikuti angin ke mana pun juga dia membawamu... Semua yang indah dan patut diberkati... semua bisa menjadi Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "Kamu tidak bisa melihatnya, tapi kamu bisa merasakannya di mana-mana... sama seperti angin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Haha, kata-kata yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Jadi, apa itu Windblume? Sesuatu yang tidak akan didefinisikan oleh sang Archon Anemo, Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Bunga berkah, bunga penghormatan, bunga cinta. Setiap individu memiliki Windblume mereka sendiri, dan setiap individu memiliki hak untuk mendefinisikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Sepertinya tidak mengherankan bahwa jenis bunga yang diberikan oleh Kota Kebebasan kepada dewa mereka sendiri merupakan ekspresi kebebasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "Aku suka rasa kebebasan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Aku tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "Keinginan bersama orang-orang lah yang membawa mereka ke satu jalan yang sama. Dan tentunya, angin kebebasanlah yang mempersatukan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "Ia datang dari akhir perjalanan, dari ujung dunia, dari kedalaman hati kita. Tidak ada habisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "\"Siapa gerangan yang membelai wajahmu yang berlumuran darah dan penuh tekad.\\nDengan aliran kecil yang mengalir lembut.\\nDengan batu besar yang berdiri tegap.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "\"Siapa gerangan yang memeluk hatimu yang letih namun mulia.\\nDalam mimpi yang lelap.\\nDi langit yang luas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "\"Temanku tersayang.\\nAku menuntun tanganmu.\\nKe malam di mana lentera bersinar terang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "\"Untuk menceritakan kisah kebebasan dan mimpi.\\nKisah di mana festival ini dimulai.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "Sungguh menyenangkan bisa bersama dengan semua orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "Suasananya cukup enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
