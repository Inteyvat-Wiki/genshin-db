			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#Halo, {NICKNAME} bagaimana kabarmu belakangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360202,
					"content": "Baik, kamu sendiri gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "Terima kasih atas perhatianmu, aku juga baik-baik saja. Maaf karena sebelumnya sudah merepotkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360206,
					"content": "Zhiqiong, kamu jangan keluyuran gitu dong! Nanti kamu sendiri loh yang bakal repot kayak waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360207,
					"content": "Baiklah, aku tidak akan keliaran lagi. Berkat upaya darimu, kini Chasm sudah jauh lebih aman. Kondisi geologisnya juga sudah jauh lebih stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360208,
					"content": "Tapi Kak Jinwu dan Khedive masih harus meneliti ... apanya ya, tentang kristal misterius itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360209,
					"content": "Kurasa Khedive menyebutnya sebagai panjang gelombang? Kurasa itu cuma semacam sebutan aneh dari Sumeru. Apa pun masalahnya, kita harus menaruh beberapa suar untuk mendapatkan datanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360210,
					"content": "Kak Jinwu akhirnya punya waktu untuk membuat suar-suar tersebut. Aku hanya perlu menaruhnya di beberapa titik tertentu untuk mengumpulkan data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360211,
					"content": "Setelah beberapa saat nanti suar itu bakal kita ambil lagi, lalu datanya kita berikan pada Khedive untuk dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360212,
					"content": "Sebelumnya karena area tersebut tidak aman, kami cuma bisa membaca datanya dari kemah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360213,
					"content": "Namun sekarang akses telah dibuka olehmu, kita bisa dapat data yang lebih akurat dengan menggunakan suar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360214,
					"content": "*huff* Setidaknya masih ada hal yang bisa dilakukan daripada diam saja. Oh ya, kalau sedang senggang, mau ikut denganku tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360215,
					"content": "Baiklah, ayo pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "Oke deh, kita berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360217,
					"content": "Jadiii nanti kami dapat imbalan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "Kamu terus terang banget ya! Yah walaupun Paimon juga mau tahu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360219,
					"content": "Hahaha, kali ini kita cuma pergi terus balik lagi kok, tapi kurasa Kak Jinwu bakal kasih sesuatu buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360204,
					"content": "Sudahlah, yang penting kamu masih hidup. Gimana kabarmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "Aku baik-baik saja sih tapi juga tidak begitu baik. Semua kejayaan dari penjelajahan ini jadi diambil dirimu deh, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "Kali ini aku benar-benar berterima kasih padamu! Terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360302,
					"content": "Iya, sama-sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "Hmm ... belakangan ini tampaknya anomali geologis di Chasm tidak berubah, berarti aku harus buat sedikit modifikasi di petaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360304,
					"content": "Terima kasih ya, berkatmu pekerjaan kami jadi jauh lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360305,
					"content": "Ah, baiklah aku tidak akan menyita waktumu. Silakan kalau mau istirahat atau melanjutkan petualangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360306,
					"content": "Hmm ... masih cukup lama sampai kita harus mengambil kembali suarnya, semoga nanti kita bisa bareng lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
