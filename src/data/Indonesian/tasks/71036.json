							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "Maaf, ada perlu apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411202,
					"content": "Tentang peta ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "Peta? Bukan apa-apa juga sih. Sebelum gabung ke Adventurers' Guild, aku tadinya kerja sebagai kartografer pertambangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411204,
					"content": "Tentu saja, kartografer yang kumaksud bukan yang duduk di kantor menggambar peta. Hehe, kerjaanku ini jauh sekali dari situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411234,
					"content": "Dulu aku pernah terima misi untuk survei lokasi di Desa Qiaoying. Aku sudah capek naik turun bukit, tapi akhirnya proyek pembangunan di sana dibatalkan. Cuma perlu satu kata dari pihak mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411205,
					"content": "Kartografer kantoran bisa suruh orang survei lokasi, mengumpulkan data buat peta mereka, lalu baru mereka mulai gambar ... Kalau aku sih tidak bisa begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411206,
					"content": "Jadi ... karena aku juga seorang pekerja tambang, aku sudah terbiasa kerja di terowongan bawah tanah yang berbahaya. Tuntutan pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411207,
					"content": "Lagian ... setelah terjadi perubahan, bagian bawah Chasm jadi tidak stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411208,
					"content": "Eh ... tidak stabil? Bahaya enggak tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411209,
					"content": "Iya, struktur geologis tempat ini berubah, perlahan tapi pasti. Terowongan yang ada hari ini mungkin sudah jadi dinding batu bulan depan. Seakan-akan ... aduh, gimana ya ngomongnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411210,
					"content": "Seakan-akan Chasm punya kehendak dan berubah bentuk sesuka hatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411211,
					"content": "Wah ... ngeri juga yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411212,
					"content": "Tentang profesimu sebagai petualang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "Haha, baru begini mana boleh disebut profesi! Jangan sungkan begitu, aku ini cuma pemula ... mana bisa dibandingkan denganmu yang sudah senior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411214,
					"content": "Aku memang sudah pernah menyelesaikan beberapa misi di Adventurers' Guild, tapi aku masih kurang pengalaman. Aku juga belum pernah bertualang sendirian, dan belum punya ceritaku sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411215,
					"content": "Jadi aku pikir, mungkin aku bisa meninggalkan jejak di Chasm ini, supaya generasi berikutnya tahu bahwa aku pernah ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411216,
					"content": "Seperti yang Alice sang petualang hebat pernah bilang, Chasm ini mungkin akan jadi \"Sungai Rubicon\"-ku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411217,
					"content": "\"Rubicon\"? Bahasa Hilichurl ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "Paimon belum pernah dengar tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411219,
					"content": "Yah ... aku juga tidak terlalu paham sih. Alice itu kan petualang hebat yang pernah berkunjung ke berbagai dunia. Mungkin itu salah satunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411220,
					"content": "\"Rubicon\" yah? Hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "Heh, memangnya kamu tahu itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411222,
					"content": "Haha, intinya, terima kasih untuk dukungannya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411223,
					"content": "Tentang Clitopho ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "Dia ya ... Heh, aku tidak percaya sama orang macam dia. Di tambang ini, sudah berapa lama kita berurusan dengan para Treasure Hoarder? Masa masih belum paham niat busuk mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411225,
					"content": "Orang-orang ini ya ... Kuharap kamu tidak dengar omongan mereka, apanya yang \"memulai lembaran baru\", apanya yang \"membersihkan nama\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411226,
					"content": "Kalau kamu dengarkan omongan mereka, artinya tangan mereka sudah masuk ke dalam kantongmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411227,
					"content": "Kalau kamu percaya, takutnya Rex Lapis pun tidak akan bisa melindungi dompetmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411228,
					"content": "Huh, aku bukannya berprasangka buruk sama mereka ... Aku cuma ingatkan saja supaya kamu waspada. Treasure Hoarder tidak bisa dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411229,
					"content": "Kamu terlalu negatif ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "Mungkin iya ... Karena kamu senior dan sudah banyak pengalaman, kamu jadi lebih toleransi sama para Treasure Hoarder. Tapi aku, aku akan terus perhatikan gerak-gerik mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411231,
					"content": "Kecuali dia bisa buktikan kalau dia tidak ada hubungan apa-apa sama para bandit sialan \"mantan\" rekannya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411232,
					"content": "Sampai jumpa.",
