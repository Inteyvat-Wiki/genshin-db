					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "Abyss Order ... musuh umat manusia. Bahkan para intelijen pun tidak bisa mendapatkan banyak informasi tentang mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Tapi biarpun sulit, aku akhirnya berhasil mendapatkan beberapa petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Wah! Secepat itu? Tuan Diluc memang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Tapi, Tuan Dewa Anemo Barbatos, kenapa kamu memerlukan bantuan dari manusia biasa ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Haha, bagaimana aku menjelaskannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Sebenarnya, yang biasa dimaksud orang \"The Seven\" adalah \"The Seven Archon\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Dunia Teyvat dibagi menjadi tujuh bagian, dan setiap Archon bertanggung jawab untuk memerintah salah satu dari ketujuh bagian itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Hanya dengan menjalankan kewajiban ini kita bisa menjaga kekuatan dewata kita. Tapi aku tidak suka \"memerintah\" Mondstadt ... dan kurasa Mondstadt juga tidak suka diperintah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "\"Pergi dan dirikanlah kota yang bebas dan tanpa kekangan\". Kami tidak pernah lupa harapan Barbatos untuk Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Jean, kamu menghayati sekali ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Tapi, sepertinya ada yang terlalu bebas dan menjadi terlalu malas untuk peduli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Ahh ... Bagaimanapun juga ... Aku sudah lama tidak kembali ke Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Tidak diragukan lagi, sekarang akulah Archon terlemah di antara The Seven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "Terus kamu terdengar bangga dengan itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Aww, kamu bisa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Oh, dewa yang sungguh rendah hati ... Tapi apa itu anugerah atau justru kutukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Pembicaraan kita sudah cukup melenceng. Ayo kembali ke topik semula: musuh umat manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "<color=#00E1FFFF>Abyss Mage</color> yang terlacak berada di sekitar <color=#00E1FFFF>winery</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Pokoknya kutekankan lagi ya, ini penting dan kita tidak boleh membiarkannya lolos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "Ayo kejar mereka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Karena itu kamu jadi dewa Kota Kebebasan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
