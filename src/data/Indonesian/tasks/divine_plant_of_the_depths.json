			"dialogs": [
				{
					"id": 721500201,
					"content": "Ah, kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500202,
					"content": "Kami sudah dapat barang yang diminta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "Air jernih dari Kolam Suci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500204,
					"content": "Aku benar-benar berterima kasih pada kalian. Sekarang, biar kusiramkan air ini pada Spiritherb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500205,
					"content": "Waktu itu kita bicara sampai mana ya... Oh iya, masih ada satu langkah lagi agar Spiritherb bisa bersinar lebih terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500206,
					"content": "Batang dan daun Spiritherb hanya bisa merenggang bebas di lingkungan yang penuh dengan elemen Hydro yang sama seperti di dasar laut. Setelah itu baru bisa memancarkan cahaya dari sebuah \"harapan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500207,
					"content": "Singkatnya, ada sebuah gua di utara dari sini, komposisi Hydro di sana sangat mirip dengan elemen yang kukatakan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500208,
					"content": "Area gua yang berbeda memiliki tingkat konsentrasi yang berbeda... Konsentrasi elemen Hydro yang paling ideal adalah yang paling jernih dan transparan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500209,
					"content": "Tapi kalau airnya sampai jadi keruh... misalnya karena diganggu monster, nantinya akan jadi susah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500210,
					"content": "*huff* Aku sudah tua, jadi tidak bisa menjelaskannya dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500211,
					"content": "Nanti kalian akan tahu kalau melihatnya sendiri, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500212,
					"content": "Gua itu berkaitan erat dengan rahasia nenek moyang kami. Sayangnya karena perang belakangan ini, tidak banyak anak muda yang bisa pergi ke sana dan mengambil air untuk Spiritherb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500213,
					"content": "*huff* Bicara soal anak muda, semoga mereka semua bisa kembali dengan selamat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500214,
					"content": "Oh ya, kalau kalian pergi ke sana untuk mengambil air, anak muda, kalian harus hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500215,
					"content": "Jangan khawatir, Nek, kami akan baik-baik saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500216,
					"content": "Kita akan hati-hati kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "Baguslah kalau begitu, baguslah... terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
