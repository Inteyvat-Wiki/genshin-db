					"nextDialogs": [
						721500306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500306,
					"content": "Melihat dari cahaya Spiritherb... sepertinya tahun mendatang akan jadi tahun yang damai dan makmur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500307,
					"content": "Hmm, lihat dari mananya sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500308,
					"content": "Cahaya Spiritherb bergantung pada kelembapan air dan \"harapan\" para penduduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500309,
					"content": "Cahaya ini adalah wujud dari harapan semua orang. Semakin bagus harapannya, cahayanya juga akan semakin cerah dan masa depan juga jadi penuh dengan harapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500310,
					"content": "Tapi... semua orang pasti mengharapkan hari esok yang lebih baik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500311,
					"content": "Selama setiap orang memiliki keinginan untuk membuat hidupnya sekarang menjadi lebih baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500312,
					"content": "Mungkin kalau dibandingkan, rasa malu dari perang bukanlah apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500313,
					"content": "Jadi... sebenarnya tidak ada hubungannya dengan keakuratan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500314,
					"content": "Tentu saja, itu cuma kebijaksanaan kami para orang tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500315,
					"content": "\"Harapan\" mendorong dan memotivasi orang untuk bertindak. Sebaliknya, hasil dari tindakan itu akan membuktikan \"harapan\" seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500316,
					"content": "Selama kita menjaga kedamaian hidup kita, selama kita menjaga harapan hidup kita dari hari-hari yang suram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500317,
					"content": "Maka ramalan \"Spiritherb\" akan selalu akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500318,
					"content": "Ini seperti penjelasan asal-asalan untuk sebuah takhayul...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "Hehe. Ah, anak muda, suatu hari nanti kamu akan mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500321,
					"content": "Selagi aku masih ingat, efek \"harapan\" dalam air ini harusnya bisa bertahan cukup lama. Kalau kalian berdua mau, kalian bisa mencariku kapan saja untuk minta ramalan lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500319,
					"content": "Tapi masuk akal juga sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
