			"dialogs": [
				{
					"id": 200600501,
					"content": "Oh, hai! Apa yang kamu pegang itu adalah sweet flower? Meskipun ini terlalu tiba-tiba, tapi bisakah aku membelinya darimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Batuk ayahku cukup parah, aku meminta Jilliana untuk membuatkan obat batuk, tapi dia kehabisan bahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Aku juga sedang dalam perjalanan untuk mendapatkan obat itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Oh, begitukah? Baiklah kalau begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Maaf karena menahanmu di sini. Ayo pergilah, Julliana pasti ada di Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Sweet flower seharusnya mudah dicari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Eh? Ah... aku mengerti, tapi aku masih harus menjaga gerbang. Aku tidak bisa meninggalkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Bahkan untuk sekadar bertanya pada Jilliana saja, aku hanya bisa memanfaatkan waktu makan siangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Baiklah, sepertinya kamu juga ingin mendapatkan obat itu. Kalau begitu pergilah, aku tidak akan menahanmu lagi. Jika kamu pergi sekarang, seharusnya Jilliana masih ada di Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
