				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Hai, tamu yang terhormat, apa kamu kenal dengan anakku, Guy? Uhuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Ah tidak apa-apa, hanya flu biasa saja tapi belum juga membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "Aku mengunjungi para suster di <color=#00E1FFFF>Katedral</color> namun mereka tidak bisa menyembuhkannya, jadi mereka hanya memberiku beberapa resep obat untuk meredakan gejalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "Uhuk, aku sudah tua, jadi tidak bisa jalan terlalu jauh. Biasanya aku meminta bantuan Moco dan Hillie untuk membantuku menyiapkan obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Tapi mereka hari ini sibuk... Uhuk... Tapi aku sudah meminta tolong pada <color=#00E1FFFF>Jilliana</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Selama mempunyai bahan-bahannya, dia bisa menyiapkan obatnya. Dia membutuhkan <color=#00E1FFFF>tiga Sweet Flower</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "Baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "Uhuk... te-terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Bawalah 3 Sweet Flower ini kepada Suster Jilliana di Katedral, dia akan menyiapkan obatnya. <color=#00E1FFFF>Tolong jangan katakan apa pun kepada Guy.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Aku dengar gereja mempunyai hubungan erat dengan Knights of Favonius. Sekarang dia telah bergabung dengan Knights of Favonius, dia harus lebih berhati-hati dalam berbicara dan bertingkah laku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Aku tidak ingin dia bertindak seenaknya hanya karena orang tua sepertiku, itu akan merusak reputasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Ah maaf, kamu jadi mendengar ocehanku. Sekarang pergilah, hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Kamu bisa meminta tolong pada anakmu, Guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "Ah, dia sedang sibuk melawan para monster, kami tidak mau mengganggunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
