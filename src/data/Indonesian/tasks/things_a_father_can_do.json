				{
					"id": 200600701,
					"content": "Tunner benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600702,
					"content": "Aku datang untuk mengambil obat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "Oh? Ternyata bukan Moco dan Hillie yang datang, mengapa hari ini yang datang adalah kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600704,
					"content": "Oh bahan-bahannya sudah siap, biar kulihat dulu...",
