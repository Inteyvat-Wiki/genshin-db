			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "Obatnya sudah siap. Tapi obat ini hanya meredakan gejalanya saja, tidak membuatnya sembuh. Jika dia benar-benar ingin sembuh, dia harus tetap minum obat dan banyak istirahat yang cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Aku sudah mengatakan padanya ratusan kali, tapi dia tidak mau dengar. Tidak peduli siapa pun yang mengatakan padanya, dia hanya berkata dia baik-baik saja dan akan sembuh dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "Baiklah, cepatlah bawakan obat ini kepada Tunner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "Tak masalah, aku hanya menjalankan tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Terima kasih banyak, maaf merepotkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "Ah, tak apa. *huff* Andai saja ada seseorang yang bisa merawat Tunner, sehingga dia tidak harus minum obat secara terus-menerus.",
					"roleType": "TALK_ROLE_NPC",
