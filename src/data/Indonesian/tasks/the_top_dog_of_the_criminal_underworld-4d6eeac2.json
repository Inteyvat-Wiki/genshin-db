			"dialogs": [
				{
					"id": 402260101,
					"content": "The Flagship ... Kayaknya peserta ini mau nyari tempat nginap dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "Partner! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Navia! Sudah lama enggak ketemu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "Kutebak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Benar sekali. Tentu saja mewakili Spina di Rosula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "Bos besar dunia kriminal bawah tanah ... Yep, masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "Bos besar dunia kriminal bawah tanah ... Yep, masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Haha, itu julukan baruku? Aku tidak keberatan sih, keren juga kedengarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "Untung banget kami nemuin kamu! Sekarang kita lagi ngerjain misi buat bantuin pendaftaran peserta. Tau lah, verifikasi barang, hal-hal kayak gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Oh, begitu. Kalau begitu, ayo duduk. Aku pesan banyak makanan. Clorinde dan Chevreuse pergi untuk membongkar beberapa barang, tapi seharusnya mereka cepat kembali ... Nah tuh kan, baru saja diomongin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Kami lagi diomongin nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde! Chevreuse! Kalian juga ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai adalah tempat yang kacau dan berbahaya. Mengingat pentingnya Spina di Rosula bagi Fontaine, kita tentu tidak mau bosnya kena masalah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "Aku memang suka bepergian dengan teman, ayolah ... Memangnya aku selemah itu! Mana mungkin lah aku kenapa-napa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "Dengan sikap lengahmu itu, siapa tahu kalau sampai terjadi apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Oke deh. Tulis saja Petarung Juara kita ini sebagai ... pengawalku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Bos geng dan pengawalnya ... Baiklah. Kamu juga mau didaftarin, Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "Tidak perlu. Aku ke sini untuk urusan resmi. Banyak kasus kami belakangan ini yang berkaitan dengan Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "Naaah, berarti Paimon enggak usah ikut campur ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "Oh, satu lagi! Apa yang bakal Spina di Rosula jualin di pameran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "Ini! Ini salah satu penemuan terbaru dari Institut Penelitian Fontaine. Ini adalah sistem relai yang memungkinkan penggunanya untuk melepaskan energi pneuma dan ousia dalam pertempuran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "Jadi, ini ... senjata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Tentu saja! Di pasar tanpa pengawasan hukum seperti ini, senjata pasti jadi salah satu primadona jualan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Mungkin iya sih ... Tapi, di depan Chevreuse ngerasa bangga gara-gara ngelawan hukum rasanya agak enggak enak nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "Aku santai sih. Aku sudah cukup banyak membaca tentang \"wilayah tak berhukum\" di novel-novel kriminal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "Sebagai detektif, aku tahu bahwa aku harus mengesampingkan aturan untuk sementara jika ingin menyelesaikan sesuatu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "Kalau begitu, aku kerja dulu ya. Ada anggota patroli yang menungguku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Sudah siap ke lokasi? Ikuti kami ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "Baiklah, ayo kita berangkat! Aku juga mau belanja sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "... Kamu ke sini untuk pamerannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
