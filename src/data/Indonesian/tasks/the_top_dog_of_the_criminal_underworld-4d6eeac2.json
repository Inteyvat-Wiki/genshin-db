			"dialogs": [
				{
					"id": 402260201,
					"content": "Kalian mengantar Navia dan Clorinde menuju tempat acara.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Wah, lebih besar dari yang kuduga. Tapi ... semoga lebih banyak orang yang datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "Nanti bakal lebih ramai kalau acaranya sudah mulai. Dan kayaknya Jahoda butuh banyak bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Oke, sekarang sih aku dan Clorinde sudah siap. Pastikan kalian mampir ke stan kami kalau sempat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
