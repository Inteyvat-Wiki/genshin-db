				"points": []
			},
			"dialogs": [
				{
					"id": 745030101,
					"content": "Hai kalian, akhirnya kita ketemu lagi. Padahal kita belum lama pisah, tapi aku sudah rindu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030102,
					"content": "Bisa saja kamu kalau ngomong, manis banget~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030103,
					"content": "Sedih deh malah disindir begitu. Ya sudahlah, kulanjutkan pekerjaanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030104,
					"content": "Biar kujelaskan dulu, pengumpulan data proyek kali ini dibagi menjadi dua bagian besar, aku pegang satu dan Alberre satunya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030105,
					"content": "Pengumpulan data yang kulakukan bertujuan untuk menyimulasikan kepekaan dari Petarung Juara. Jadi aku perlu kamu untuk menyelesaikan beberapa proyek simulasi meluncur dalam air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030106,
					"content": "Jadi semua Petarung Juara harus latihan di dalam air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030107,
					"content": "Siapa yang tahu? Ya pokoknya aku sendiri bahkan bos pun tidak kenal sama Petarung Juara. Tapi menurut bos, cara itu lebih keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030108,
					"content": "Awalnya dia mau pasang 10 jenis mekanisme penyedot air supaya bisa memercikan air. Tapi sesudahnya dia angkat tangan karena biayanya terlalu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030109,
					"content": "Keren banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "Ya kan Fontaine bangsa air. Jadi kalau mau ekspor barang-barang ke luar, bagusnya sih yang bisa mewakili kearifan lokal Fontaine juga dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030112,
					"content": "Intinya, kami sudah menyiapkan sebuah buku panduan untuk hal-hal yang perlu diperhatikan. Nanti kalian bisa membacanya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030113,
					"content": "Bagaimana? Sudah tidak sabar buat mencobanya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030114,
					"content": "Aku siap-siap dulu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "Tidak masalah. Perangkat pengumpul datanya sudah dipasang di sana, kalian tidak perlu cemas, fokus saja menyelesaikan tantangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030110,
					"content": "Keren sih kalau buat anak-anak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}