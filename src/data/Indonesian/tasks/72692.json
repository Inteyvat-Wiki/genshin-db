				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#{M#Tuan}{F#Nona}, kebetulan sekali. Tuan Lenne dan aku sedang membuat puisi baru lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Perlu aku bantu cari inspirasi lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, betul sekali. Di bawah bimbingan Tuan Ootomo, aku menulis satu lagi puisi dengan gaya Inazuma. Tapi aku memang masih termasuk amatiran sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "Tema puisinya adalah \"persahabatan\", seperti kami yang hanya bisa menyesali mengapa tidak dipertemukan lebih awal. Aku ingin ada baris-baris tentang para hewan yang mengarungi bentang alam bersama kawanan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Karena ini adalah puisi Inazuma, maka harus turut menyertakan <color=#00E1FFFF>hewan-hewan asli sini</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "Yah, kami memang sudah sering lihat binatang khas Inazuma sih, darat maupun udara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Semuanya ada di alam liar. Cari yuk, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "Kawan, terima kasih banyak! Tolong fotokan <color=#00E1FFFF>4</color> jenis hewan yang hanya ada di Inazuma yah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
