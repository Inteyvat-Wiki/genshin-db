					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Mana lihat ... Wah, bagus! Aku sudah tahu mau tulis apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "Aku sudah buat lebih dari satu versi bait berdasarkan foto yang kalian bawa. Mau pilih lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
