				{
					"id": 726920501,
					"content": "Kawan, baik dirimu maupun Tuan Ootomo begitu menyukai kalimat ini. Baiklah, kita gunakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "Puisi Tuan Lenne dan foto yang kalian bawa saling mendukung. Jujur, puisinya semakin terasa menyentuh ketika dibaca sambil melihat foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "#Jujur lagi, aku juga sedang menulis satu puisi yang mungkin memerlukan bantuanmu, {M#Tuan}{F#Nona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "Perlu foto juga, Tuan Ootomo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Hahaha, kita diskusikan besok lagi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
