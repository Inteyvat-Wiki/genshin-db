			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Kuil ini makin hari makin bobrok saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "Oke, jawab jujur ya, kenapa kamu tiba-tiba kepikiran buat betulin kuil ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "*uhuk* Panjang ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Waktu aku pura-pura jadi Adeptus dulu, aku rajin cari informasi yang berguna biar aktingku lebih meyakinkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "Lalu aku bersumpah untuk berbuat kebaikan setelah diberi pelajaran sama Adeptus tadi, ingat kan? Jadi waktu aku kembali, aku sudah mau menghancurkan semua catatan yang aku punya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Tapi aku tiba-tiba dapat ide ... Daripada menghancurkannya, kenapa tidak aku bagikan saja pengetahuan yang aku punya ke orang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "Dengan begitu, aku akan bisa membantu orang agar tidak mudah dibodohi atau kena tipu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "Aku tidak menyangka bahwa buku panduan yang kutulis berhasil membantu banyak orang. Bahkan Bagian Urusan Sipil saja bilang buku itu sangat berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Mereka bahkan ikut menambahkan beberapa cara mencegah penipuan ke dalam buku itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "Dan mereka memberiku bayaran yang cukup besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Setelah buku panduan itu, aku berencana untuk menulis buku tentang sang Vigilant Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Tujuanku adalah memperkenalkan kisah sang Vigilant Yaksha kepada orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "Dengan demikian, aku akhirnya akan bisa memanfaatkan semua pengetahuanku tentang cerita rakyat untuk kebaikan orang banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "Kuil Pervases ini kutemukan saat cari bahan untuk buku keduaku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Di sini tertulis bahwa kuil ini dibangun untuk mengenang jasa-jasa sang Yaksha, Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Tapi aku tidak sangka kalau kuilnya sudah bobrok parah begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Aku lalu pulang dan memikirkannya, dan akhirnya memutuskan untuk membiayai perbaikan kuil ini pakai uangku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Bagaimanapun juga, aku dituntun kembali ke jalur yang benar oleh Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "Kurasa memperbaiki kuil ini bisa dianggap sebagai penebusan dosa-dosaku di masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Eh ... cerita barusan kedengarannya jujur sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#Menurutmu bagaimana, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Kurasa dia agak tulus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "Apa maksudmu \"agak\"? Aku MEMANG lakukan ini dengan tulus! Tulus seratus persen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "*huff* Tidak apa-apa, kamu bebas berpendapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Kalau tidak percaya, balik lagi nanti waktu perbaikan kuilnya dimulai. Kamu akan tahu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Yah, dulu kan kamu tukang tipu ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Tapi sekarang bukan! Aku sudah jadi warga yang taat hukum dan hidup benar sekarang! Aku kan sudah bersumpah di hadapan Adeptus tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
