			"dialogs": [
				{
					"id": 710350301,
					"content": "Terima kasih, Adeptus yang mulia! Terima kasih pahlawan besar! Sungguh suatu kebetulan! Kita bisa bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350302,
					"content": "Kamu tahu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "Mana mungkin aku lupa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350304,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "Aku Wang Ping'an! Kalian sudah lupa sama aku ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350306,
					"content": "Oh, \"Starsnatcher\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "Hah? Apa? \"Starsnatcher\"? Apa itu? Kamu ... mau buat aku terbunuh ya? Adeptus-nya masih ada di sini loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350310,
					"content": "Aku sedang siap-siap, mau memberikan seserahan di kuil Yaksha Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350311,
					"content": "Tapi tak lama setelah sampai di pegunungan, aku langsung diincar para Treasure Hoarder ... Terima kasih sudah menyelamatkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350312,
					"content": "Tunggu. Kamu mau ngapain di kuil Pervases?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "Mau buat macam-macam sama patungnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "Bukan, bukan! Mana mungkin begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350315,
					"content": "Terus kamu mau apa sebetulnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Aku ... ingin memperbaiki kuilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350317,
					"content": "Aku ke sini untuk lihat situasi kuilnya dengan jelas, biar aku tahu harus beli material apa saja buat renovasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350318,
					"content": "Tapi aku malah diincar para Treasure Hoarder di tengah jalan, dan akhirnya harus kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350319,
					"content": "Aku terus lari, sampai akhirnya tidak tahu lari ke mana. Setelah itu, kamu juga tahu kelanjutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350320,
					"content": "Kita lanjut bicara di kuil saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Benar, tempat ini kurang sesuai untuk mengobrol. Ayo masuk kuil dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350322,
					"content": "Kita bicara di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350323,
					"content": "Pergilah. Aku masih ada urusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "Eh? Sudah mau pergi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "Daaan dia pun pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Ya, ya, aku ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Ah, bagus, bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
