			"dialogs": [
				{
					"id": 710350101,
					"content": "Mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 710350102,
					"content": "Minta tiga porsi Grilled Tiger Fish. Dibungkus yah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Siap! Tunggu sebentar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 710350104,
					"content": "Tiga porsi? Satu buat kamu, satu buat Paimon, terus satu lagi buat siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Kita kasih satu porsi buat Pervases.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Maksudmu yang kasih kita Lampu Tujuh Bintang dan pembakar dupa? Pervases yang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Benar juga, dia memang pernah bilang kalau dia kangen makan Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Tapi, bukannya dia sudah mangkat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Yah, setidaknya kan bisa tengok tempatnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Ya sudah, boleh juga tuh. Yuk ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Waktu kita ketemu Pervases tempo hari, kuilnya kan sudah bobrok banget tuh, terus banyak Treasure Hoarder di mana-mana lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Semoga patungnya enggak dirusak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Tiga porsi Grilled Tiger Fish, sudah selesai! Silakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 710350115,
					"content": "#Mmm, wangiii! {NICKNAME}, yuk jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
