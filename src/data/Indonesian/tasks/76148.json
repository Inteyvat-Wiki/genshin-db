			"dialogs": [
				{
					"id": 761480701,
					"content": "Kita kembali lagi ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "Berdasarkan umur manusia, terakhir kali aku datang ke sini itu sudah be-be-be-beberapa generasi yang lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Sepertinya kita semua dilempar balik ke dalam Apathic Interval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "Jadi gimana caranya kita keluar dari sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Cara biasanya adalah dengan bermeditasi, mengendalikan pikiran, lalu membuang semua keinginan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Mempertahankan kondisi di mana pikiran kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Kedengarannya cukup sederhana, tapi ini semua bergantung pada sifat dan kekuatan keinginan mereka sendiri, biasanya memakan waktu bertahun-tahun bahkan sampai ratusan tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Orang yang memikul takdir dunia sepertimu, mungkin kamu tidak bisa melepaskan keinginanmu begitu saja. Lagi pula, itu juga tidak seharusnya dibuang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Jadi, kita harus bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Ayo kita cari Zeitlind dulu, dan pikirkan caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Kamu memungut apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Tunggu, Dex juga ikut ditarik masuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "Kalau begitu, berarti ada cara untuk membalikkan situasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Dex juga Watcher, ya kan. Berarti ada kemungkinan kita bisa manfaatkan kekuatan yang ada di serpihan-serpihan ini untuk membuka paksa jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Serpihannya mesti diberi nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Aku pernah dengar tentang peti-peti yang berlebihan ini. Sengaja ditata oleh salah satu saudari pemimpin kuil ini .... Peti Maranasati, kalau tidak salah itu namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Kalau gitu kita sebut saja pecahannya Serpihan Mantra Maut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
