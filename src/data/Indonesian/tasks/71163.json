			"dialogs": [
				{
					"id": 711630201,
					"content": "Zibai enggak ada ... padahal dia loh yang ngundang kita ke sini! Ke mana larinya tuh cewek satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Eh! Payung ini kayaknya kenal deh ... Kita pernah lihat di mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Mungkin punya Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Kayaknya benar ... Tapi kenapa dia tinggalin payungnya di depan pintu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "Memang dia kan suka lupa-lupa ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Terus kita ngapain nih? Kalau dibiarin, Paimon takut dia bisa tiba-tiba lupa cara pakai sumpit pas lagi makan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "Mending cari deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "Tunggu dulu ... Aku rasa ini bukan payung ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Kalau bukan payung, terus apa dong? Hmm ... mana, coba lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "WOAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
