			"dialogs": [
				{
					"id": 711630301,
					"content": "Kenapa lagi ini? Kenapa kita jadi ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Bagaimana mainannya? Bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "Zibai, kamu di sini ya! Ini payung apa payung sih? Tiba-tiba \"wuuush\" gitu dan tahu-tahu kami sudah ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "Sepertinya bukan cuma aku yang sering lupa. Apa kalian sudah lupa pernah mengendarai ini bersamaku dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Sudah ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Oh! Si kereta bulan ya! Pantas kayak pernah lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, itu cuma replika yang dibuat dari apa yang kuingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "#Dan semua ini berkat keping giok rusak yang {NICKNAME} kembalikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "Oooh, jadi ini toh mainan kecil yang kamu bilang mau bikinin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Tepat sekali. Kereta kecil dari keping giok ini bisa mengantar kalian ke mana pun dengan cepat, yang pastinya akan membantu melancarkan perjalanan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "Silakan, ambil ini, kedua pemanduku yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Wah, keren banget ini! Paimon kira kamu cuma asbun doang pas mau bikinin \"mainan kecil\", ternyata beneran loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Awalnya aku mengira perlu waktu lebih banyak untuk membuatnya, soalnya keping giok itu sudah rusak. Energi spiritual di dalamnya sudah lenyap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Tapi untungnya, ini Lembah Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Heh? Memangnya kenapa kalau Lembah Chenyu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Apa kamu tahu di mana kita berada di Lembah Chenyu sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Uhm ... Dermaga Yilong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Hehe, masih banyak yang perlu kamu pelajari dari tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "Tanah di bawah kaki kita sebenarnya adalah salah satu persimpangan penting di jalur Ley Line Liyue. Ada total delapan titik seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "Kehidupan, Kematian, Ketenangan, Terselubung, Inisiasi, Kawasan, Ketakutan, dan Kesakitan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Kamu ternyata lebih kenal tempat ini dari yang aku kira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Oh! Paimon ingat! Ini kita lagi bahas si delapan gerbang, ya kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Benar. Tempat kita berdiri sekarang adalah salah satu gerbang yang paling baik, Gerbang Kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "Gerbang Kehidupan melambangkan pertumbuhan, kemakmuran, dan pemulihan. Inilah alasan aku bisa mengisi ulang energi spiritual keping giok dengan cepat dan membuat keretanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Wah, keren banget! Lembah Chenyu memang ajaib ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "Benar ... Kalian akan hidup damai dan sejahtera jika tinggal di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "\"Kalian\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Bukan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Baiklah, semua yang kuingin lakukan telah terlaksana. Silakan, lanjutkan saja kesibukan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "Aku berencana jalan-jalan sampai puncak gunung. Kita akan berpisah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Terima kasih, Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "Jangan berterima kasih. Kamulah yang membangunkanku dari tidur yang teramat panjang. Aku yang sepatutnya berterima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "Sebenarnya yang paling gede jasanya ya si Zhongli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Dan aku pun sudah menyampaikan ini padanya, persis seperti barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "Dia bilang kamu sedang dalam perjalanan yang sangat panjang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "Apa tujuanmu berikutnya adalah tanah berselimut salju yang jauh di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Betul, kami memang mau ke Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya ... Hmm, meski aku tidak tahu apa pun tentang tempat itu, perjalanan melewati es dan salju memiliki bahayanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "Kalau perlu bantuan, cari saja aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Pasti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Jaga diri baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zibai"
				}
			]
		}
	]
