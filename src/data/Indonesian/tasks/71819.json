					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190502,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "Pengembara? Haha, tidak apa-apa. Aku hanya memikirkan bagaimana caranya memanjat pohon ini dan mengambil Lentera Xiao itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190504,
					"content": "Sulit sekali untuk melakukannya saat sedang memakai baju zirah lengkap begini... Aku terus-terusan terjatuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190505,
					"content": "Eh... kamu mau membantuku? Mengambil Lentera Xiao itu seharusnya tidak sulit untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190506,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Baiklah, terima kasih banyak. Ayo cepat ambil lalu kita kembali sehingga gadis kecil itu bisa ceria lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
