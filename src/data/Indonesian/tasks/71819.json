			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Bagaimana, apa kamu sudah mendapatkan Lentera Xiao-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Biar kulihat... betul, ini lenteranya. Terima kasih banyak, akan kubawakan lenteranya pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "Kuharap mereka masih menunggu di tempat itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "Tentang hadiah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "Oh ini pasti dari Bagian Urusan Sipil. Baiklah, akan kuterima. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "Apa ini juga termasuk kewajibanmu sebagai prajurit Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Maksudmu mengambil Lentera Xiao yang terbang itu? Hahahaha, tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Tidak menjadi masalah apakah aku harus mencari Lentera Xiao, mengejar orang jahat, atau membunuh monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "Kewajiban seorang prajurit Millelith adalah menolong mereka yang membutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Baiklah, sekali lagi terima kasih banyak. Aku harus segera kembali dan memberikan lentera ini kepada gadis kecil itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "Lalu masih ada tugas lain yang harus kuselesaikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
