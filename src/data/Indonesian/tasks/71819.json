			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "Ah... begitu banyak hal yang harus dilakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Tidak apa-apa, aku hanya sedang mengatakan bahwa begitu banyak hal yang harus diurus pada saat Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190104,
					"content": "Hanya saja... Semakin aku memikirkannya, semakin banyak masalah yang harus diurus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190105,
					"content": "Walaupun teman-teman kerjaku juga sudah mengambil beberapa porsi pekerjaan, tahun ini adalah giliranku untuk mengkoordinasikan pengiriman Lentera Xiao. Jika aku tidak segerap bersiap-siap, sepertinya tidak akan keburu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190106,
					"content": "Mengirimkan Lentera Xiao ke siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Ah benar juga... Saat aku bilang \"pengiriman Lentera Xiao\", maksudku bukan hanya mengirimkan lenteranya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190109,
					"content": "Singkatnya... seolah aku memainkan peran sebagai duta dari Lantern Rite, menyampaikan harapan baik, dan menciptakan suasana festival yang meriah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190110,
					"content": "Bahkan dengan kebanyakan orang yang tidak bekerja untuk festival, termasuk beberapa pemilik toko dan pkerja mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190111,
					"content": "Masih saja ada pekerja yang tidak bisa beristirahat, contohnya para penjaga yang menjaga ketertiban selama festival berlangsung, seperti para Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190112,
					"content": "Bagian Urusan Sipil juga biasanya mengirimkan hadiah kepada mereka untuk menghargai kerja keras mereka selama Lantern Rite berlangsung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190113,
					"content": "Aku akan mengunjungi Millelith yang bertanggung jawab untuk menjaga keamanan kota kami dan memberi mereka letera Xiao sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190114,
					"content": "Bagaimana pun juga... kita kekurangan pekerja dan kami masih belum mengirimkan hadiah-hadiah itu kepada semua prajurit yang ada di daftar kami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190115,
					"content": "Bisakah kamu membantuku dan mengirimkan hadiah-hadiah ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190116,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Benarkah? Bagus sekali! Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190118,
					"content": "Mau dikirim untuk siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Biar kulihat... Prajurit Millelith mana ya yang belum dikirimi hadiah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190120,
					"content": "Xiangming... Hongyi... dan Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190121,
					"content": "Aku akan menandai lokasi mereka untukmu. Terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190107,
					"content": "Memangnya kamu harus mengirimnya ke berapa orang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
