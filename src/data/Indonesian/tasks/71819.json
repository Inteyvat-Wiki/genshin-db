			"dialogs": [
				{
					"id": 718190301,
					"content": "Apa yang terjadi dengan sumur ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Kiriman hadiah Lantern Rite untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Oh, ini pasti dari Bagian Urusan Sipil. Terima kasih banyak, akan kuterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Namun, aku masih harus tetap bertugas di sini sebentar, jangan sampai ada warga yang datang untuk mengambil air selama festival berlangsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "*huff* Entah ada apa dengan sumur ini... Tapi bagaimana pun juga, air di sumur ini tidak bisa diminum untuk sekarang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
