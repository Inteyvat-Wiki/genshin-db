			"dialogs": [
				{
					"id": 718190401,
					"content": "*hiks* A-aku belum selesai menuliskan harapanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Kamu harus jadi anak baik, Little Xian. Paman Millelith yang baik hati itu akan mengambilnya untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "Tentang Cai Le...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Oh, apa kamu mencari prajurit Millelith yang baik hati itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Barusan Little Xian sedang menuliskan harapannya pada Lentera Xiao tapi tiba-tiba dia melepaskan genggamannya sehingga lentera itu terbang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "Lalu prajurit Millelith itu bilang dia melihatnya tergantung di pohon, jadi dia pergi untuk mengambil lentera itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "Memang apa yang spesial dari Lentera Xiao itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Aku juga sudah bilang padanya bahwa kita bisa buat yang baru, tapi dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Eh... tidak... tidak mau. Kakakku sudah bersusah payah membuatkan lentera itu untukku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Little Xian, paman yang baik hati itu pasti akan membawakannya kembali untuk kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "Ah maaf, jika kamu memang benar-benar ada perlu dengan prajurit Millelith itu, kamu bisa menemukannya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190408,
					"content": "Apa tidak bisa buat yang baru saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
