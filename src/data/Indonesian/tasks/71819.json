				"objectNames": [
					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "Oh kamu sudah kembali! Bagaimana kiriman hadiahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190702,
					"content": "Semua orang sudah mendapatkan hadiahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "Terima kasih banyak, jika bukan karena dirimu, aku pasti tidak akan bisa mengirimkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190704,
					"content": "Apa mereka harus terus berjaga selama festival berlangsung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Yah... Bagian Urusan Sipil pasti akan mengatur jadwal mereka lagi nanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190706,
					"content": "Tapi Liyue besar sekali. Jadi banyak sekali tempat dan lokasi yang harus diawasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190707,
					"content": "Kami kekurangan orang. Walaupun mereka bergiliran, tetap saja beberapa dari mereka harus bertugas walaupun sedang festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190708,
					"content": "Selain itu, mengingat betapa megahnya Festival Lantern Rite setiap tahunnya, beberapa bagian kota membutuhkan sumber daya tambahan. Tidak peduli bagaimana kami mendistribusikan orang-orang kami, tetap saja tidak pernah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190709,
					"content": "Wah, berat sekali ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Ah, itu memang pekerjaan kami... Kami akan terus berusaha untuk menjamin semua orang dapat menikmati Lantern Rite ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190712,
					"content": "Aku jadi teringat kalau ada banyak orang yang memerlukan bantuan selama Lantern Rite. Kalau kamu bersedia, kamu bisa membantu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190713,
					"content": "Semakin banyak orang yang berpartisipasi dalam Lantern Rite, maka suasananya juga akan semakin meriah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190714,
					"content": "Kami mengirim Lentera Xiao karena kami ingin semua orang bisa menerbangkan Lentera Xiao dan membuat permohonan mereka sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190715,
					"content": "Terlebih lagi... kami juga ingin agar Lantern Rite dapat tersebar luas. Akan sangat bagus sekali jika semua orang bisa merasakan suasana Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190716,
					"content": "Karena Lantern Rite diperuntukkan untuk semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190717,
					"content": "Baiklah, masih ada yang harus kukerjakan. Kuharap kamu menikmati Lantern Rite ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190710,
					"content": "Kedengarannya berat juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
