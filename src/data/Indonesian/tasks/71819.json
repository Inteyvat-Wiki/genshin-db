			"dialogs": [
				{
					"id": 718190201,
					"content": "Hmm? Ada perlu apa? Aku sedang bertugas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Kiriman hadiah Lantern Rite untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Tenang sedikit! Aku masih bekerja sekarang ini, hadiah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "Oh, ini dari Bagian Urusan Sipil? Baiklah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Tahun berikutnya, Lantern Rite berikutnya. Dan aku juga ingin pulang ke rumah lebih awal tahun ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Tapi melihat situasi sekarang ini, aku masih belum bisa bersantai-santai... sepertinya kali ini pun aku akan terlambat untuk pulang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Terima kasih karena sudah repot-repot datang ke sini. Ini ambillah, terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*huff* Kapan orang itu akan pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
