				},
				{
					"id": 401020402,
					"content": "(Tok tok tok.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "Enggak ada jawaban. Enggak ada orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020404,
					"content": "(Tok tok tok.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "HELLO~ Alhaitham~ Ada orang di rumah? Kami perlu bantuanmu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020406,
					"content": "Oh. Kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020407,
					"content": "Kaveh! Sudah pulang rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020408,
					"content": "Masuk sini. Aku bukain pintunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 4010205,
			"completionStepIds": [
				4010205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
