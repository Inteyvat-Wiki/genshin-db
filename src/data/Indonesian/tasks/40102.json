							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "Halo kalian, sudah lama ya. Ada yang mau dilaporkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020202,
					"content": "Kalian memberi tahu Aarav soal cerita Dehya dan Candace.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "Ada yang berniat menculik Sachin? Astaga ... Yah, tapi tidak mengejutkan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020204,
					"content": "Extravaganza ini semakin populer, nama dia sebagai sponsornya juga semakin naik. Sekarang semua orang tahunya dia itu kaya raya tajir melintir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020205,
					"content": "Yah, sekarang kan dia sudah resmi jadi sasaran tembak tuh. Apa enggak lebih baik kalian kirim orang buat jagain dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020206,
					"content": "Sejujurnya kami juga sudah memikirkannya. Tapi, Sachin itu tipe yang lebih suka kerja lapangan, dan jarang sekali balik ke kota. Dia tidak bisa dihubungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020207,
					"content": "Petunjuk yang kami punya cuma kalimat ini: \"Setiap kali ada kejuaraan antar Darshan, aku akan melihat dari dekat untuk memilih siapa yang layak jadi pewarisku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020208,
					"content": "Kalau dia masih memegang teguh perkataan itu, berarti sekarang ini dia seharusnya ada di suatu tempat di kota ini. Kurasa para Eremite juga tahu tentang itu dan sengaja datang ke sini untuk coba-coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020209,
					"content": "Tapi artinya mereka juga enggak tahu si Sachin itu ada di mana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020210,
					"content": "Harusnya sih tidak. Mahamatra Cyno masih cuti, jadi urusan ini biar aku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020211,
					"content": "Tenang. Dua orang penculik bisa apa sih di Kota Sumeru? Aku punya cara buat mengasapi mereka biar keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020212,
					"content": "Dan sekalian, berhubung kalian juga tertarik sama Sachin, kenapa tidak coba cari tahu juga dia ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020213,
					"content": "Semakin cepat kita tahu, semakin cepat pula kita bisa bertindak. Yah, minta tolong semua Matra atau Corps of Thirty buat menjaga satu orang itu bisa saja, tapi kan percuma kalau tidak ada yang tahu orang yang bersangkutannya ada di mana. Bisa apa coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020214,
					"content": "Masuk akal sih. Ikutan nyari boleh lah, tapi mulai dari mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020215,
					"content": "Apa Matra ada pegang info soal Sachin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "Sayangnya tidak ada. Riwayat kriminalnya bersih, dan dia juga tidak pernah melanggar protokol Akademiya. Kami tidak punya banyak data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020217,
					"content": "Kudengar Tuan Alhaitham sudah mundur dari jabatan Grand Sage Sementara dan sudah kembali jadi Panitera. Mungkin bisa coba tanya dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020218,
					"content": "Ide bagus. Oke, kami cari dia di area utama Extravaganza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
