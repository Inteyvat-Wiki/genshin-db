			},
			"dialogs": [
				{
					"id": 401020301,
					"content": "Fiuh ... Nilou, apa kamu tahu si Alhaitham ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020302,
					"content": "Pak Alhaitham? Ada perlu apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020303,
					"content": "Kami lagi nyari orang. Terus perlu bantuan dia buat lihat arsip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020304,
					"content": "Oh, gitu ... Maaf, aku tidak tahu di ada di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020305,
					"content": "Dia selalu jadi yang paling pertama pergi setelah kompetisi selesai. Terus enggak pernah pamit sama bilang mau ke mana juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020306,
					"content": "Baiklah. Yah, dia memang gitu sih orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020307,
					"content": "Coba aku bantu pikir ... Jujur, dia enggak kelihatan kayak berminat gimana gitu sama Extravaganza ini. Dia pasti malas diam di sini lebih lama dari yang diperlukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020308,
					"content": "Dia memandang tugas komentator tamu sebagai kerjaan ekstra yang terpaksa dilakukan. Apa kalian tahu dia biasa ke mana sehabis pulang kerja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020309,
					"content": "Tempat minum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "Uhh ... Acaranya masih sisa satu babak lagi loh. Apa iya dia tipe yang bisa minum padahal masih ada kerjaan yang tersisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020311,
					"content": "Ah! Paimon tahu. Dia langsung pulang ke rumah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020314,
					"content": "Paimon ingat rumahnya di mana, enggak jauh tuh. Kita cek ke sana saja yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020312,
					"content": "Langsung pulang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "Betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
