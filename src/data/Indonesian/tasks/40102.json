					}
				]
			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "Aduh, banyak sekali informasinya. Kepala Paimon sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020502,
					"content": "Singkatnya, Sachin menyerahkan urusan hartanya ke Akademiya dan pergi entah ke mana buat meneliti, gitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020503,
					"content": "Dia bahkan bilang kalau bukan cuma hadiah, tapi semua hartanya akan dikasihin ke kontestan yang dia suka. Kebayang enggak tuh duitnya sebanyak apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020504,
					"content": "Apa? Serius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020505,
					"content": "Harta Sachin itu ... enggak bakalan habis seumur hidupku loh. Wah, kalau aku terpilih, semua utang bakal langsung lunas, bisa beli rumah, dan masih ada sisa buat dihamburin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020506,
					"content": "Aku bisa bangun satu lagi Istana Alcazarzaray ... tapi lebih besar sepuluh kali lipat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020507,
					"content": "Terus proyek di Pelabuhan Ormos ... renovasi jembatan. Kalau mau serius, biaya bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020508,
					"content": "WOI, WOI! Balik dulu ke Teyvat sini! Jangan kejauhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020509,
					"content": "Iya, iya. Pertama, aku harus fokus lomba biar menang dan bisa cabut dari tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020510,
					"content": "Ha? Apaan nih, ada kertas nongol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020511,
					"content": "Ini tulisan si Alhaitham? Kayaknya dia corat-coret ide sembari mikir ya. Coba lihat ... ada dua kalimat yang dilingkari:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020512,
					"content": "\"Sachin, hidup atau mati? Entah\" ... terus ada \"Mahkota Kebijaksanaan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020513,
					"content": "Sisanya enggak kebaca. Ini bahasa apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020514,
					"content": "Mana lihat ... Eh? Aku tahu aksara ini. Sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020515,
					"content": "\"Idealisme tinggi tidak melindungimu dari nihilisme, tapi keputusan kecil mungkin bisa\". Kurang lebih gitu, tapi aku enggak jamin terjemahan barusan benar 100% ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020516,
					"content": "Hmm? Ada tulisan kecil di bawahnya ... Hah? Apa maksudnya ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020517,
					"content": "Wow, kamu bisa baca itu? Keren juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020518,
					"content": "Kami pernah satu kelompok waktu masih sama-sama siswa dulu. Judul tugasnya \"Menjabarkan Huruf Kuno dan Falsafah Arsitektur Pada Reruntuhan Peradaban Raja Deshret\". Waktu itu aku ikutan belajar baca aksara ini sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020519,
					"content": "Oh, menarik tuh! Jadi ... apa kamu tahu apa maksud Alhaitham nulis ginian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020520,
					"content": "Siapa yang tahu? Cara kerja otak dia itu misteri dunia dan akhirat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020521,
					"content": "Iya sih, memang. Ya sudah, berarti segini doang info yang kita dapat dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020522,
					"content": "Semoga Aarav ada kemajuan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "Iya, dia harus bisa tangkap dua penjahat itu. Tapi untuk sekarang ... Duh, kita jalan-jalan saja dulu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4010206,
			"completionStepIds": [
				4010206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010206",
							"2"
						],
						"stepId": 4010206,
						"stateName": "QUEST_STATE_UNFINISHED"
