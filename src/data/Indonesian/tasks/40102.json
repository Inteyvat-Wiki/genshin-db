				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020601,
					"content": "Kami enggak dengar apa-apa waktu ngetok tadi! Kirain enggak ada orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020602,
					"content": "Yah, aku harus hati-hati. Kalau ada orang Akademiya ke sini nyari si Alhaitham, terus aku main buka pintu seenaknya, bahaya. Ketahuan deh aku tinggal di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020603
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020603,
					"content": "Kamu ... cemas banget ya soal itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020604,
					"content": "Terus ... gimana kalau beneran ada yang nyari dia waktu ada kamu di rumah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020605,
					"content": "Yah enggak apa, tinggal diam di kamar saja. Dan lagian, siapa juga yang mau sengaja ke sini nyari orang itu? Kurang kerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020606,
					"content": "Baiklah, baiklah. Jadi, kamu tahu dia ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020607,
					"content": "Ya tidak lah. Siapa yang tahu apa kerjaannya pas ada senggang? Dia enggak diam di rumah saja aku sudah senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020608,
					"content": "Kalian berantem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "Berantem? Bukan, dia cuma enggak tahu cara ngomong sopan, itu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020610,
					"content": "Aku cerita sama dia soal babak kedua tadi. Aku menang undian, ingat kan? Itu namanya karma baik, aku lagi beruntung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020611,
					"content": "Tapi tahu tidak ... Orang itu bilang apa begitu aku beres ngomong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020641,
					"content": "\"Kamu selalu menekankan bahwa kamu itu seniorku di sekolah, tapi caramu menyelesaikan masalah sama sekali tidak mencerminkan seorang senior. Hal ini membuat kita patut bertanya, apakah senioritas itu memang layak diperhitungkan atau tidak.\" Apa coba maksudnya \"mencerminkan seorang senior\"? Memangnya itu gelar? Aku harus sekolah dulu, gitu??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020642,
					"content": "Masih ada lagi:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020612,
					"content": "\"Saranku ya, kamu sebaiknya introspeksi diri, kenapa sampai setiap babak harus mengandalkan keberuntungan. Jujur, aku sama sekali tidak paham bagaimana kamu bisa hidup sampai umur segini tanpa bisa melihat hambatan sebesar gajah yang ada di depan mata\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020613,
					"content": "Hahaha, itu ... Alhaitham banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020614,
					"content": "Aku sudah enggak tahan, setiap kali buka mulut, dia selalu ngomong yang model gitu! Dan aku selalu kesal dibuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020615,
					"content": "Dan untungnya dia juga tidak suka sama aku. Jadi, cara terbaik ya segera pindah dari tempat ini. Aku lagi beres-beres barangku, dan dia harus belajar urus barangnya sendiri mulai saat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020616,
					"content": "Lihat tidak lukisan yang digantung sempurna di tembok sana? Itu punyaku! Ha, kalau selama ini hidup dia masih ada sedikit nilai seninya, mulai hari ini enggak ada lagi! NOL.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020617,
					"content": "Sebentar, kamu mau pindah sekarang? Tapi lombanya masih belum beres loh. Memangnya sudah ada duit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020618,
					"content": "Jelas belum lah! Aku cuma beresin barang dulu, biar nanti enggak usah repot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020619,
					"content": "Aku sudah tahu mau pindah ke mana. Begitu hadiahnya dapat, aku mau langsung beli, langsung pindah. Butuh tiga hari lah buat pindahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020620,
					"content": "Aku tahu harus apa sekarang supaya bisa berhasil. Babak tiga terserah mau kayak apa, aku pasti menang! Lihat saja nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020621,
					"content": "Baiklah, kami dukung deh. Tapi ... yakin kamu bakal baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020622,
					"content": "Hmm? Apanya yang baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020623,
					"content": "Layla bilang dia ada firasat kamu bakal terlibat konflik internal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020624,
					"content": "Maksudnya ... apa? Jangan bilang kalian juga merasa aku cacat karakter, gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020625,
					"content": "Bukan kayak gitu juga! Tapi pikirin lagi deh. Kamu bilangnya pengen menang, tapi berani nolak poin dari Faruzan, padahal dia sudah nawarin loh. Terus kamu juga malah sibuk nolongin rubah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020626,
					"content": "Sebentar, yang kayak gitu di mana coba salahnya? Aku kan sudah cerita kenapanya ... Nanti rasa bersalahnya menghantui terus! Konfliknya di sebelah mana coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020627,
					"content": "Kenapa harus merasa bersalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020629,
					"content": "Aduh, kalau ditanya tiba-tiba gitu sih ... Kenapa ya? Pertanyaan bagus. Anggap saja itu sudah karakterku lah. Terus kalau dibiarin, nanti bisa disalahin kalau ada hal buruk terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020630,
					"content": "Tapi mikir kayak gitu setiap hari apa enggak capek ya hidup? Terus nolongin rubah itu kan ada risikonya ... Misalnya, pingsan di tengah gurun pasir. Coba dipikir lagi, layak enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020631,
					"content": "Aduh, rumit deh pokoknya ... Kita bahas lain kali saja. Sekarang, kalian perlu apa dari si Alhaitham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020632,
					"content": "Kami perlu bantuan dia buat menyelidiki Sachin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "Sachin? Ha, dia memang ada bahas sedikit sih baru-baru ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020634,
					"content": "Aku ingat dia pulang bawa dokumen hari itu. Dia baca, mikir sambil ngomong sendiri, sambil corat-coret juga. Dia suruh aku baca juga, tapi belum sih. Sebentar ya, aku ambilin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020635,
					"content": "Nih, yang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020636,
					"content": "Eh ... Kamu yakin dia enggak bakal ngambek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020637,
					"content": "Ngambek kenapa? Karena kita seenaknya? Cih, dia juga suka seenaknya minum bir punyaku. Gantian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020638,
					"content": "Lagian, dia juga ada suruh aku baca catatan ini. Waktu itu sih aku pikir ngapain, enggak ada faedahnya, jadi dia cuma simpan catatan itu di pinggir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020639,
					"content": "Kalau dia enggak simpan itu dokumen, artinya dia enggak masalah kalau ada yang baca. Tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020640,
					"content": "Ya sudah deh kalau gitu. Coba lihat dia ada info apa soal si Sachin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
