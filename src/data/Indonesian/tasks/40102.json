			"dialogs": [
				{
					"id": 401025001,
					"content": "Aku kaget ada yang berani macam-macam pas lagi Extravaganza. Memang godaan harta Sachin itu kuat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025002,
					"content": "Kalau tiba-tiba kejatuhan duit segitu banyak, kamu mau ngapain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025003,
					"content": "Tidak tahu. Tidak pernah terpikirkan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401025004,
					"content": "Ya sudah, pikirin sekarang. Yang pertama muncul di otak kamu saja, apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025005,
					"content": "Hmm ... Beli makanan, cari sumber air ... Mungkin yang seperti itu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
