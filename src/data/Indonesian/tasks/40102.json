			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}, kayaknya kamu dari awal ada mikirin sesuatu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020102,
					"content": "(Si rambut putih yang kita lihat sebelum lombanya dimulai ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}, Paimon! Akhirnya ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020105,
					"content": "\"Akhirnya\"? Waduh, apa yang terjadi nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020106,
					"content": "Apa kalian merasa ada yang aneh dengan Extravaganza Akademiya tahun ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020107,
					"content": "Waktu aku sama Candace lagi di kafe tadi, kami ada mergokin tentara bayaran lagi mangkal. Masalahnya, mereka nyamar jadi turis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020108,
					"content": "Tidak ada penyamaran apa pun yang bisa menutupi bau darah. Penampilannya saja sudah bikin curiga, aku yakin mereka kerja kotor, penculikan atau pembunuh bayaran malah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020109,
					"content": "Kami lumayan lama menguping. Target mereka adalah seseorang bernama Sachin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020110,
					"content": "Sachin? Itu bukannya orang yang disebut Kareena pas waktu upacara pembukaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020111,
					"content": "Katanya dia sponsor kompetisi, hadiah-hadiah dan Mahkota Kebijaksanaan itu semua dari dia. Tapi orangnya belum pernah nongol sama sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020112,
					"content": "Kedengarannya dia kaya raya. Nah, benang merahnya mulai kelihatan nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020113,
					"content": "Belakangan ini Eremite lagi susah cari duit. Banyak kelompok yang kerja \"privat\" ke orang kaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020114,
					"content": "Menurut kabar, satu kerjaan bisa cukup buat hidup selama setahun. Dan kerjaan kayak gini pasti jadi duit, mereka bisa nyantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020115,
					"content": "Acara Extravaganza kali ini berhasil menarik banyak turis ke Sumeru. Mereka memanfaatkan kesempatan untuk menyusup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020116,
					"content": "Dehya dan aku mau langsung menangkap mereka. Tapi keduanya tidak lengah, dan segera cari alasan untuk pergi dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020117,
					"content": "Aku sudah mau ikat mereka, tapi pasti bikin heboh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020118,
					"content": "Aturannya siapa sih yang harusnya ngurus beginian? Matra? Atau Corps of Thirty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020119,
					"content": "Hmm. Kalau ada Cyno, dia pasti turun tangan. Apa kita laporkan saja gitu ya ke Matra di Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020120,
					"content": "Kalian berdua, makasih loh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020121,
					"content": "Santai. Kami juga sadarnya karena kebetulan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020122,
					"content": "Iya, santai saja. Reputasi Eremite bakal semakin turun kalau para keparat itu berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020123,
					"content": "Ini Kota Sumeru. AKu dan Candace tidak bebas gerak di sini, jadi maaf terpaksa merepotkan kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020124,
					"content": "Kalau perlu apa-apa, kami di kafe ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020125,
					"content": "Kamu lagi mikirin sesuatu ya. Extravaganza ini kah? Soalnya Paimon juga sudah mulai curiga ada sesuatu di balik ini semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020126,
					"content": "Duh, mikir gini doang sih enggak ada gunanya. Kita lapor Matra saja lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020103,
					"content": "(Percakapan rahasia yang kita enggak sengaja dengar setelah babak pertama beres.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
