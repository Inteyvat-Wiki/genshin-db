					"nextDialogs": [
						223040302
					]
				},
				{
					"id": 223040302,
					"content": "Baik, aku akan menandainya sekarang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040303,
					"content": "Selamat jalan, jangan lupa bawa pulang harta karunnya kalau kamu menemukannya. Kita akan membaginya secara rata sesuai perjanjian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
