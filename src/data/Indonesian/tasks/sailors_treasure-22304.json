				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040201,
					"content": "Halo, teman! Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040202,
					"content": "Aku mau mengambil peta harta karun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040203
					]
				},
				{
					"id": 223040203,
					"content": "Peta harta karun? Oh, maksudmu peta yang digadaikan Zhangshun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040204,
					"content": "*cih* Kamu benar-benar ingin mencari harta karunnya? Aku tidak menganggap serius akan peta-peta ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040205,
					"content": "Sekali lihat saja aku sudah tahu kalau kamu adalah petualang sejati. Matamu langsung berbinar-binar saat mendengar kata \"harta karun\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040206,
					"content": "Lagi pula aku tidak akan menggunakan peta-peta ini sama sekali, lebih baik aku serahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040207,
					"content": "Tapi kalau kamu menemukan harta karun, kita harus membaginya secara rata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040208,
					"content": "Aku sudah menyimpan peta ini cukup lama, sudah seharusnya aku mendapat sedikit biaya penyimpanan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
