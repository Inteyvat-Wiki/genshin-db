				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "Halo, Pengembara. Kamu datang di waktu yang pas. Kami punya sebuah misi yang aku yakin sebaiknya dikerjakan olehmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620102,
					"content": "Apa misinya berbahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Komisi ini melibatkan Domain yang misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620105,
					"content": "Meskipun Guild sudah melakukan penyelidikan ekstensif ke dalam Domain itu, kami belum mendapatkan hasil yang berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620106,
					"content": "Honglang, seseorang yang bertanggung jawab atas penyelidikan ini bilang kalau dia butuhkan bantuan seorang petualang yang sangat terampil beradaptasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620107,
					"content": "Dan kamulah orang pertama yang muncul di benakku, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620108,
					"content": "Domain apakah sebenarnya ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "Honglang ada di depan pintu Domain. Kalau kamu mau bantu, kamu bisa tanya dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620110,
					"content": "Kami mengandalkanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620103,
					"content": "Apa misinya susah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "Apa yang terjadi dengan Domain ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620202,
					"content": "Halo, tentang misinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "Eh? Kamu ... Oh, jadi kamu petualang yang Katheryne bilang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620204,
					"content": "Aku pernah mendengar kalau kamu fleksibel, berpengalaman luas, dan salah satu petualang yang kawakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620205,
					"content": "Yup, betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "Mantap! Hatiku lega kalau kamu bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620208,
					"content": "Tapi sebelumnya, apa kamu bisa ceritakan padaku tentang Domain ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Ah, iya, benar juga. Maaf ya. Biar kuperkenalkan terlebih dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620210,
					"content": "Jadi, ini yang sebenarnya terjadi: beberapa waktu lalu, satu tim petualang menemukan pintu besar yang aneh ini di alam liar ... Ya seperti yang sekarang sedang kamu lihat tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620211,
					"content": "Begitu mereka melewati gerbang ini, tim itu masuk ke dalam Domain yang tidak dikenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620212,
					"content": "Berdasarkan laporan dari tim petualang pertama, Domain ini cuma sekadar \"ruang kosong\" saat mereka baru masuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620213,
					"content": "Sebentar. Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "Misalkan seperti ini ... Kalau mau diukur secara akurat, Domain ini adalah sebuah area yang \"panjang dan lebarnya sama-sama sekitar 52 langkah, sementara tingginya tidak diketahui\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620216,
					"content": "Dalam 52 langkah ini bagaimanapun juga, area ini hanyalah area yang berlantaikan ubin batu biasa, tapi semua area di luarnya dipenuhi dengan asap abu-abu yang pekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620217,
					"content": "Selain itu, saat seseorang mencoba menyeberangi perbatasan ke area di luar 52 langkah pertama juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620218,
					"content": "Mereka akan berubah arah dan mulai berjalan ke arah yang berlawanan secara misterius, atau tiba-tiba menghilang lalu muncul di belakang orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620219,
					"content": "Pokoknya merupakan hal yang mustahil untuk melewati area 52 langkah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620220,
					"content": "Apakah mereka sudah mencoba menggunakan alat lain untuk menjelajahi tempat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Tentu saja mereka pernah. Tapi benda yang dilempar itu akan kembali ke tempat asalnya, bahkan cahaya obor tidak bisa menembus lebih jauh dari area 52 langkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620222,
					"content": "Jadi, kamu perlu bantuan kami buat menyelidiki tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620223,
					"content": "Betul. Tapi ... kamu bukan hanya perlu melakukan \"eksplorasi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620224,
					"content": "Aku tidak bisa menjelaskannya secara rinci di sini. Ayo kita lanjutkan di dalam saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620214,
					"content": "Sebuah ruangan ... yang kosong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "Ya ucapanmu memang benar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
