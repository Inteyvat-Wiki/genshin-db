					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "Tempat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620302,
					"content": "Kamu yakin ini tempat yang sama dengan \"ruang kosong\" yang kamu bilang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620303,
					"content": "Kelihatannya ini cuma sebuah Domain yang biasa saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "Betul! Bukannya ini cuma sebuah tempat reruntuhan biasa ya? Yah kayak yang sering kami kunjungi setiap saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620306,
					"content": "Iya ini Domain yang harus kita selidiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620307,
					"content": "Dan alasan kenapa jadi begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620308,
					"content": "Karena belum lama ini, Domain ini berubah bentuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620309,
					"content": "Lah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620310,
					"content": "Domain ini \"berubah bentuk\"? Menjadi seperti ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Benar. Domain ini berubah bentuk sesuai keinginan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620312,
					"content": "Menurut pemimpin tim petualangan saat itu, mereka mulai kehilangan kesabaran dengan tempat ini setelah menjelajahinya selama beberapa waktu tanpa hasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620313,
					"content": "Dan dalam kondisi yang seperti itu, salah satu anggotanya mulai menggerutu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620314,
					"content": "\"Kalau ini Domain biasa, kita pasti sudah selidiki dari lama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620315,
					"content": "Karena lapar dan lelah, anggota tim lainnya menyatakan setuju atas pandangan anggota tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620316,
					"content": "Dan ketika semakin banyak orang yang mulai setuju, tim tersebut tiba-tiba mendapati diri mereka berada di dalam \"Domain yang biasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620317,
					"content": "\"Domain biasa\" ini mengandung mekanisme, jalan, harta karun ... bahkan obor yang masih nyala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620318,
					"content": "Tim petualangan menilai diri mereka sendiri tidak mampu menghadapi situasi seperti itu, karena itu mereka segera melaporkan kembali ke Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620319,
					"content": "Sebagai tanggapannya, kami secara langsung mengirimkan orang untuk melakukan penyelidikan lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620320,
					"content": "Namun, yang kita tahu adalah Domain ini bisa berubah berdasarkan keinginan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620321,
					"content": "Kalau sedang ada banyak orang yang masuk ke dalam Domain sekaligus, maka Domain-nya akan bereaksi terhadap orang yang punya pemikiran terkuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620322,
					"content": "Wow! Apa ini artinya kalau Domain ini juga bisa menciptakan, ya sebut saja ... Pelabuhan Liyue seluruhnya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620323,
					"content": "Kami sudah pernah mencoba hal ini sih, tapi tidak berhasil. Mungkin keinginan kami untuk menciptakan Pelabuhan Liyue tidak cukup kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620324,
					"content": "Apa pun itu, kami sedang mengumpulkan petualang untuk memasuki Domain ini dan itulah yang menyebabkan berbagai perubahan pada Domain ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620325,
					"content": "Kami harap kami dapat mengetahui beberapa aturan dan prinsip di balik perubahan yang dialami oleh Domain ini, dan dengan demikian bisa mendapatkan jawabannya dari situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620326,
					"content": "Kalau begitu, apa yang sekarang harus kulakukan dengan tempat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Oke, kamu lihat mekanisme di sana? Itu adalah \"pemicu\" yang kami taruh. Sebenarnya ini adalah sebuah ide yang terpikirkan oleh salah satu petualang kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620329,
					"content": "Sederhananya, keinginannya adalah untuk \"bisa merubah Domain ini hanya jika kita menyentuh mekanismenya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620330,
					"content": "Domain ini menjawab harapan orang-orang, tapi untuk menjamin bahwa mekanismenya tetap ada, kita harus terus mengundangnya secara berkala ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620331,
					"content": "Wow, ternyata bisa ada cara seperti ini ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "Kalau bukan karena segala kemungkinan ini, Domain ini sepertinya akan terus berubah setiap saat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620333,
					"content": "Tapi kalau kamu lihat dari sudut berbeda, Domain ini cocok buat latihan para petualang. Bayangkan deh, cukup andalkan kekuatan pikiran sekali saja lalu mekanisme dan berbagai topografi dapat langsung muncul di depan mata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620334,
					"content": "Ya sudah, daripada hanya mendengarkan penjelasanku ... kenapa tidak bersiap-siap untuk mencobanya sendiri saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620335,
					"content": "Apa kamu lihat \"Adventure Coin\" berwarna emas di sana? Itu juga merupakan sesuatu yang kami ciptakan menggunakan kekuatan keinginan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620336,
					"content": "Coba kamu ambil koin itu ya, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620327,
					"content": "Apa ada cara khusus untuk melakukan semua ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "Kelihatannya tempat ini tampak tidak asing ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
