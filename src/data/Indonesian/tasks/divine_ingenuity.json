					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "Kalau begitu, aku mengandalkanmu. Gunakan semua imajinasi dan tekadmu untuk merubah Domain ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620403,
					"content": "Aku harap kita bisa segera paham aturan di balik perubahan Domain ini.",
					"roleType": "TALK_ROLE_NPC",
