			"dialogs": [
				{
					"id": 760840201,
					"content": "Coba yang biasa dinyanyiin sama Columbina deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "Coba yang biasa dinyanyiin sama Columbina deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Lagu apa nih bagusnya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Coba yang tenang, yang lembut ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Bagus sekali. Kamu benar-benar sudah hafal laguku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490605,
					"content": "Hehe, soalnya kamu nyanyinya merdu banget. Setiap dengar suara kamu, kami juga suka diam nyimak dulu gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hmm, para Kuuhenki juga kelihatannya terpesona dengan pertunjukan barusan. Mungkin mereka sudah belajar sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490607,
					"content": "Mungkin ke depannya, aku akan minta tolong lagi perihal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490608,
					"content": "Ulurkan tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490609,
					"content": "Hah? Jangan, buat apa?! Kami sukarela kok ngajarinnya, enggak usah bayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Bayar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490611,
					"content": "Aku cuma berpikir ... kalau terang bulan yang lembut sangat cocok sekali untuk mengiringi lagu yang begitu merdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490701,
					"content": "Lagu ceria boleh lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, sudah selesai? Padahal aku masih mau dengar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490703,
					"content": "Seperti yang aku pernah cerita, hanya lagu pengantar tidur ini saja yang aku ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490704,
					"content": "Maknanya masih belum tahu, tapi setelah mendengar kamu tadi, rasanya jawaban yang menungguku di bulan sana ... pasti sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490705,
					"content": "Sini tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490706,
					"content": "Ampun ih, enggak usah kasih apa-apa juga kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, bukan seperti itu maksudnya ... aku hanya ingin menghiasi lagumu dengan terang bulan yang lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
