			"dialogs": [
				{
					"id": 760540301,
					"content": "Seperti ... ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540302,
					"content": "Hmm, pikirkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540303,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540304,
					"content": "Bulan ... bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540305,
					"content": "Kalau di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540306,
					"content": "Aku menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540307,
					"content": "Ketiga bulan sudah sejajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540308,
					"content": "Hmm, ini langkah terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540309,
					"content": "Mm ... bulan terbit dan terbenam, tanpa henti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540310,
					"content": "Bulan-bulan kita menolak dibayangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540311,
					"content": "Kita ... seri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540312,
					"content": "Ah, kamu memikirkan penempatannya sampai matang sebelum memutuskan. Silakan, toh waktu kita sama-sama banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540313,
					"content": "Kamu lupa cara mengangkat bulan ke langit malam? Perlu dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540314,
					"content": "Kamu tidak suka? Aku rasa permainan ini ... sangat menghibur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540315,
					"content": "Mm? Kenapa melihat kemari? Pandanganmu sangat menohok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540316,
					"content": "Kamu melihat ... jawaban \"bulan\" di wajahku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540317,
					"content": "Papannya di sebelah sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540318,
					"content": "Hmm, bulan-bulanmu sudah sejajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540319,
					"content": "Langit malam sudah kamu kuasai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540320,
					"content": "Ah, aku ... sepertinya keliru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540321,
					"content": "Kalian sangat menikmati waktu bermain bersama Columbina ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Terima kasih banyak. Aku senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540323,
					"content": "Kalau berkenan, silakan ... datang dan main lagi denganku, kapan-kapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760540324,
					"content": "Ini, bukti perjanjian di antara kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
