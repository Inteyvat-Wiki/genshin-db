			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, kalian sudah datang? Para Kuuhenki sedang bermain lira lagi. Bisa tolong mainkan lagu untuk mereka seperti waktu itu?",
					"roleType": "TALK_ROLE_NPC",
