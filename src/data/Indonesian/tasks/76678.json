			"dialogs": [
				{
					"id": 760830401,
					"content": "Pergilah, teman-temanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830402
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830402,
					"content": "Coba tebak ini gambar apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830403,
						760830407,
						760830412
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830403,
					"content": "Bulan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830404
					]
				},
				{
					"id": 760830404,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830405
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830405,
					"content": "Huh, itu sih terlalu gampang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "Kayaknya teka-teki kali ini terlalu mudah untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830407,
					"content": "Belut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Eh, kenapa pinggang belut ini aneh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "Pengetahuan kalian berdua luas sekali ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830410,
					"content": "Jawaban yang benar adalah \"bulan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830411,
					"content": "Kembalilah ke sini. Kerja yang bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830412,
					"content": "Lengkungan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "Siapa pun juga tahu kalau ini lengkungan! Masa jawabannya segampang itu sih?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Kamu tidak salah, tapi sepertinya bukan itu maksud kuuhenki-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830415
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830415,
					"content": "Jawaban yang benar adalah \"bulan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830416
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
