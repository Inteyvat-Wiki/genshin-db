					"nextDialogs": [
						760830505
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830505,
					"content": "Gimana caramu bisa tebak itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830506,
					"content": "Oh, jadi itu namanya. Apa dia bisa angkat pembuatnya dan bawa ke mana-mana pakai tangannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830507,
					"content": "Kayaknya kamu ketuker antara Aino sama mantan teman kerjamu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830508,
					"content": "Weasel Thief yang kebanyakan makan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Apa Weasel Thief yang lagi kekenyangan gini masih bisa nyolong barang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830510,
					"content": "Atau mungkin dia udah enggak perlu nyuri lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830511
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830511,
					"content": "Jawaban yang benar adalah \"bebek mekanik besar di sebelah bengkel Aino\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830512,
					"content": "Kembalilah. Terima kasih, kerja bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760830513,
					"content": "Sebuah botol kaca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Wah, kuuhenki sampai belajar bentuk alat laboratorium demi permainan ini? Mereka benar-benar serius nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830515,
					"content": "Sudah hampir benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830516
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
