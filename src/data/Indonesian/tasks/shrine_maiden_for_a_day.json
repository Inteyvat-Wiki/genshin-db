					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Tapi dia selalu menolak diantar. Katanya dia sudah hafal jalanan ini karena sering sekali lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Untungnya di sepanjang jalan ini ada miko yang jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Semoga Archon Electro memberkati mereka, semoga nenek dan cucunya selamat dalam perjalanan ....",
