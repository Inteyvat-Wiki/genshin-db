				{
					"id": 750876301,
					"content": "Selamat datang di Sekolah Penerbangan Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876302,
						750876303
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876302,
					"content": "Ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876304
					]
				},
				{
					"id": 750876304,
					"content": "Semua murid diberikan bimbingan dan dukungan. Sekarang semuanya sudah banyak berubah, kalau dulu sih mana ada murid dimanja kayak sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876305
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876305,
					"content": "Tapi ada sih sekali, waktu pelatih masih kecil ... ngomongnya keras, dan muridnya juga galak betul ... yah, jangan dibahas lah. Sejarah kelam itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876306
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876306,
					"content": "Yah, sejak saat itu aturan pelatihan sekolah penerbangan juga sudah diubah. Siapa juga sih yang tega nempeleng orang senyum, dan siapa yang enggak suka dapat pujian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876303,
					"content": "Aku duluan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876307
					]
				},
				{
					"id": 750876307,
					"content": "Semoga harimu menyenangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
