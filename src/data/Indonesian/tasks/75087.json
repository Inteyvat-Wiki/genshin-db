					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Yah, bisa kena saja sudah keren sih. Eh, kok malah Paimon ya, yang capek? Beneran ini baru satu ronde? Apaan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
