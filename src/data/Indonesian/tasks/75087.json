				},
				{
					"id": 750870567,
					"content": "#Oh, {REALNAME[ID(2)|SHOWHOST(true)]} dan Oberon kayaknya punya akal tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Biskuit? Saurus Crackers? Dari mana ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Grrr! Chiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Astaga, dari lipatan di bawah sayap? Hebat ya kamu ... hebat. Pantas si Taruka jadi galak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
