			"dialogs": [
				{
					"id": 750870701,
					"content": "WAH? Taruka? Kok sudah balik duluan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#Kak {NICKNAME}! Untunglah ... aku sudah kasih tahu Kakak dan yang lain duduk perkaranya. Dan si Lamizana itu memang sebodoh itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Gwoawww ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Iya, lebih bodoh dari kau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Gwoawww ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Sudah, sudah, dia sedih karena kepisah dari kamu sekian lama hei. Oh, tadi dia kompak banget loh sama si {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Masih bisa ditingkatkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "HEH, mereka ini masih bocah loh! Ah, Taruka. Kamu latih dia yang benar, rawat dia yang baik. Paimon yakin gedenya hebat nih Qucusaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Chiiiiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Oh iya, kamu gimana ceritanya bisa pulang sendiri? Ada yang nolongin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Aku kabur sendiri sih. Tadinya mau bawa Oberon juga, tapi dia malah asyik makan biskuit, enggak mau gerak. Aku kesal, jadi ya sudah. Sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Hah? Segampang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Setelah mempelajari pola gerakan penjaga Saurian, aku dapat celah untuk kabur. Lancar jaya semua setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Wah ... kamu lebih bisa diandalkan dari semua orang lain di sana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Kenapa lama sekali? Aku ... baru mau bikin perhitungan sama si pembohong itu ... dan ma-mau minta maaf juga tentunya ... aku memutuskan seenaknya, dan nyaris menuduh orang tak bersalah sebagai pelaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Telat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Iya, munculnya setelah semua beres. Gantian nyatut jasa orang saja hebat kau!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Aku tidak ada argumen pembelaan sih, jadi kompensasinya akan dibayarkan, atau terserah kalian mau minta apa. Aku tidak pelit, dan silakan kalau mau pukul juga! Biar puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Aku laki-laki. Laki-laki sejati tidak boleh kabur dari tanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. Pukul dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "AH! Waduh-duh ... belum dipukul saja sudah nyeri rasanya! Tolong, kasihanilah ... jangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Lah, tadi katanya laki-laki sejati? Baru gitu doang sudah langsung \"ahh, aduh\". Ck, payah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Lupakan, kami bukan lintah darat yang suka hitungan pahit. Iya kan, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Terima kasih sudah sudi memberi ampun. Pintu sekolah penerbangan ... yah, di sana tidak ada pintu sih, tapi intinya, kalian selalu disambut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Karena kalian dan {REALNAME[ID(2)|SHOWHOST(true)]} begitu dekat, aku ingin tanya rahasianya dong! Gimana caranya bisa akur sama Saurian kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hehe, gampang. Nanti kami pasti balik lagi kalau ada kesempatan.",
					"roleType": "TALK_ROLE_NPC",
