					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "Jadi dalangnya si Quilla, sesuai dugaan ya. Yah, alasannya aneh banget sih, tapi ... ck, si Paran kasihan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
