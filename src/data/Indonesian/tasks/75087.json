					"id": 750870581,
					"content": "#Iya kan, {REALNAME[ID(2)|SHOWHOST(true)]}? Ayo, Oberon pulang dulu ke sekolah penerbangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
