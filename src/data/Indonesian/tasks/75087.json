					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Banyak hal di dunia yang tidak mempan dikasih kalimat \"yang penting berani\". Bah, omong kosong doang. Yang penting itu KEN-DA-LI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "SERANG!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Mantap habis! {REALNAME[ID(2)|SHOWHOST(true)]} berhasil menghindari serangan! Namanya juga jurus Tepetlisaurus, bahkan penguasa langit juga enggak bisa ngalahin!",
