					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. Siap-siap, SIKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
