						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bertahan dari serangan ganas lawan! Dia berhasil selamat!",
