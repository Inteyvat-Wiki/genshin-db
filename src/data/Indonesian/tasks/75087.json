					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} enggak mau bertahan! Percuma, mending serang saja mumpung ada kesempatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
