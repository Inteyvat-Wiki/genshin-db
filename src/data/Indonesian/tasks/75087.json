						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon kelihatan lemas. Dia khawatir sama Taruka atau ngantuk karena kebanyakan makan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ... melindungi kita, dan mencoba menghibur dia juga?",
