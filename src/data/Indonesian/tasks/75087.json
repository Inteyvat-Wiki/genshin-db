			"dialogs": [
				{
					"id": 750870501,
					"content": "Karena kalian bisa sampai ke sini, artinya aku juga sudah tidak usah pura-pura jadi pedagang baik lagi. Aku sudah capek juga urusan sama orang bodoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Keterlaluan! Kamu nuduh orang lain, padahal kamunya sendiri yang JAHAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Loh, namanya juga penjahat. Masa enggak boleh berbuat jahat? Lagian, si trio bodoh jadi curiga sama kalian ... itu bukannya bukti kalau aku ini hebat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, tapi tenang dulu. Aku masih banyak stok kalau mau bikin yang jahat-jahat. Kalian tidak akan bisa lolos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
