					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Seriusan ... mau lawan yang badannya berapa kali lebih gede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
