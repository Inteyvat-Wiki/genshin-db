			},
			"dialogs": [
				{
					"id": 710590301,
					"content": "Akhirnya pulang juga. Aku masih punya sisa Fire-Water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590302,
					"content": "Haha ... Aku bukannya mengundangmu minum teh. Tapi kalau kalian terluka, Fire-Water bisa membersihkan luka loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590303,
					"content": "Bagaimana? Kalian menemukan sesuatu tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590304,
					"content": "Kami menemukan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
