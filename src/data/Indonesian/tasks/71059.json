			"dialogs": [
				{
					"id": 710590401,
					"content": "Kalian sudah kembali. Bagaimana? Nemu sesuatu tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "Kalau memang tidak ada ya sudah tidak apa-apa. Istirahatlah dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Tidak usah khawatirkan aku .... Lagi pula aku memang sudah berencana untuk melewati masa tua di sini. Mungkin aku akan meminta bantuanmu untuk mengurus masalah aplikasi uang pesangonku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Waduh, kamu santai banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Huh! Kalau tidak ada penemuan baru, aku bakal santai-santai di sini sampai tua saja deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Eh ... Apa ini lambang yang ditinggalin sama orang Fatui itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590601,
					"content": "Uh .... Enggak ada satu orang pun di sini. Aduh gimana nih kita harus ngomong apa sama Katya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Haduh, apa boleh buat deh. Paimon rasa kita balik dulu saja yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Ini kan ... sebuah lambang, buku harian operasi dan ... catatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Tolong katakan, di mana Kolya sekarang? Apa dia masih hidup ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "Kami tidak berhasil mencarinya, tapi dia mungkin masih hidup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Kolya tidak mungkin meninggalkanku sendirian di sini. Aku yakin sekali, dia tidak mungkin kabur begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Barang-barang ini kalian dapat dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "Sebuah gua di arah tenggara. Biar kutandai lokasinya untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "Itu tempat ngeri banget deh, di dalamnya banyak monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "Te-Terima kasih ... Maaf ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "A-Aku harap Kolya memang gugur dalam menjalankan tugas. Aku lebih rela percaya kenyataan yang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, tolong jangan sampai membuat malu Yang Mulia Ratu. Jangan sampai membuatku malu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Uhuk ... Aku tidak apa-apa. Ma-Maafkan aku karena tiba-tiba jadi sentimental begini. Aku baru sadar aku belum berterima kasih pada kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Oh ya, ini Fire-Water ... Oh, kalian tidak minum anggur ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "Aku masih punya Mora ... dan masih ada ... beberapa material yang dulu kukumpulkan, pokoknya semua sudah tidak berguna lagi. Ambil saja semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "Apa rencanamu selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "Rencana selanjutnya? Terima kasih atas perhatianmu, tapi aku mungkin tidak memerlukan bantuanmu untuk \"berbuat jahat\" lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Hem .... Mungkin aku akan terus mencari Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "Sebelum pasukan berangkat, dia menulis surat untukku. Aku masih menyimpannya. Bagiku, ini adalah bukti terakhir kalau dia masih hidup. Aku akan menyimpannya selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "Kalau dia masih hidup .... Sebagai anggota Fatui dari Yang Mulia Tsaritsa, aku akan menangkap pengkhianat itu dan membunuhnya, aku pasti mencarinya sampai ke mana pun juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "Tapi kalau dia sudah gugur ... Sebagai kakaknya, aku juga akan menyambut takdir yang harus dihadapi oleh setiap Fatui, dan aku harus bangga padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "Setiap kalimat \"kalau bukan kita, siapa lagi yang bisa\" yang keluar dari mulut kami ... itu bukan sekadar omong kosong belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "Gimana kalau kamu jadi berbuat jahat dan aku harus menghentikanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "Selalu ada kejadian dimana kamu tidak punya pilihan lagi dan mau tak mau harus melakukan sesuatu, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "Ya sudah lah .... Kalian terlalu serius. Anak kecil yang masih belum boleh minum arak, biasanya malah sering tenggelam dalam kekhawatiran sendiri, yang aneh dan tidak penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "Nanti baru kita bahas lagi deh. Kalau memang sudah tidak ada pilihan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "Tapi sekarang, aku sudah mau istirahat .... Kamu mau istirahat juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "Hanya ada kasur jerami. Enggak nyaman banget! Kamu jelas-jelas mau usir kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Hahahaha! Itu sih masalah kalian sendiri ... kasian deh kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "Oh ya, terima kasih ya atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Apa kamu harus tetap memegang teguh sudut pandang Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Iya. Memang ada masalah dengan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "Konsep pemikiran, sudut pandang, semua ini adalah hal yang sangat membosankan! Pfft ... Di balik topengku ini bukan cuma ada konsep pemikiran Fatui saja tapi yang pasti aku juga masih takut sama peluru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Apa kamu butuh bantuanku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Dia mungkin sudah kabur lewat jalur rahasia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"Setelah berhasil memasuki ruangan rahasia yang gelap ini, monster mekanik raksasa masih berkeliaran di luar. Sepertinya dia sedang menungguku keluar dengan sabar, sama seperti predator yang sangat kejam yang menunggu mangsanya dengan bengis ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Catatan Kopral Nikolay"
				},
				{
					"id": 710591402,
					"content": "\"Kaki kiriku terluka parah, aku membungkusnya dengan daun-daunan. Sakit sekali rasanya, ada bengkak juga. Mungkin infeksi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Catatan Kopral Nikolay"
				},
				{
					"id": 710591403,
					"content": "\"Masih ada jalan keluar lain dari gua sempit ini. Tapi aku tidak yakin ke mana arahnya. Jalan keluarnya kelihatan rapuh. Kalau tidak ada fondasi yang kuat, saat ada kekuatan yang kuat dari luar, jalan keluarnya akan sangat mungkin bisa roboh ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Catatan Kopral Nikolay"
				},
				{
					"id": 710591404,
					"content": "\"Aku sudah ketahuan. Ada yang datang. Seorang ... ahli pedang ... berbalut zirah hitam pekat?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Catatan Kopral Nikolay"
				},
				{
					"id": 710591405,
					"content": "\"Dia, tunggu ... dia bukan manusia ...? Sepertinya pagar besi yang kokoh pun tidak akan bisa menghentikannya, aku sudah tahu saat melihat ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Catatan Kopral Nikolay"
				},
				{
					"id": 710591406,
					"content": "\"Maafkan aku, Katya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan Kopral Nikolay"
				}
			]
		}
	]
}