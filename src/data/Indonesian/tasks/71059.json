			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"Sial! Balalaika punya Katya rusak. Aku berlari terlalu cepat dan entah bagaimana tak sengaja merusaknya. Aku harus memperbaikinya sebelum dimarahi olehnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590202,
					"content": "\"Jadi begini cara leluhur kita menghadapi ancaman bencana lima ratus tahun yang lalu? Kapten bilang, semua duka perang yang kita hadapi ini tidak ada apa-apanya kalau dibandingkan dengan kesulitan yang dihadapi leluhur kita ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590203,
					"content": "(Di tengahnya ada banyak halaman yang ternoda oleh benda hitam. Setelah dibersihkan, semua tinta tulisan jadi ikut tak terbaca.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590204,
					"content": "\"Tidak boleh tinggal lebih lama lagi di sini. Dia bisa mencari jejak keberadaanku melalui lumpur hitam ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590205,
					"content": "\"Selanjutnya aku harus bergerak melawan arah dan memancing mereka agar bisa jauh dari regu utama ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590206,
					"content": "\"Ada lubang di sebelah reruntuhan benteng di arah tenggara, mungkin aku bisa ambil jalan itu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				},
				{
					"id": 710590207,
					"content": "\"Doakan aku sukses. Kalau bukan kita, siapa lagi yang bisa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sobekan Buku Harian Kopral Nikolay"
				}
			]
		},
