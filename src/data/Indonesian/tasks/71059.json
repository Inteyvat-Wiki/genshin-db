			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "Aku sudah mau istirahat, luka lamaku kumat lagi .... Maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580602,
					"content": "Kalau ada pertanyaan lagi ... carilah aku besok-besok. Kebetulan aku juga mau minta tolong kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "Kalian sudah datang! Silakan duduk dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590102,
					"content": "Maaf, kemarin aku terkesan seperti mengusir kalian, juga tidak menjelaskan bantuan apa yang kuminta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590103,
					"content": "Tidak apa-apa. Bilang saja sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "Tenang saja, aku tidak akan menyuruh kalian berbuat hal jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590108,
					"content": "Kalau begitu, langsung ngomong saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "Jadi begini, aku sudah lama terpisah dari Kolya-ku ... Nikolay, dia anggota timku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590114,
					"content": "Jadi aku ingin meminta bantuan kalian untuk mencari jejaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590115,
					"content": "Kalau dia masih hidup, tolong bawa dia pulang ke sini. Kalau dia sudah tiada ... tolong kasih tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590116,
					"content": "Maaf sekali kalau harus minta tolong hal begini kepadamu .... Tapi aku mohon kalian bisa mempertimbangkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590117,
					"content": "Begitu ya .... Paimon kira kamu pasti bakal suruh kita buat hal-hal jahat deh. Misalnya menyabotase kerjaan Millelith atau sejenisnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590118,
					"content": "Millelith? Kenapa? Memusuhi mereka tidak akan memberi untung apa pun bagi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590119,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "Aku jadi ikutan bingung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590121,
					"content": "Tunggu dulu. Aku mengerti. Jadi kami sudah ribut besar dengan warga Liyue di permukaan sana? Kalau begitu ini alasan kenapa perbekalan kami terputus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590122,
					"content": "Agh .... Sebenarnya apa sih yang sudah terjadi di atas sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590123,
					"content": "Ceritanya panjang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Hmph .... Kita akan bahas itu lain kali. Perang memang seperti ini .... Kawan jadi lawan dalam sekejap, inilah kenyataan yang dihadapi para Fatui sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590126,
					"content": "Tapi sekarang ... setidaknya untuk sekarang, aku hanya peduli terhadap keselamatan Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590127,
					"content": "Dalam perjalanan saat kami mundur, dia dan timnya terpisah. Lalu, saat kami kembali untuk mencarinya, jadinya aku yang terpisah dengan orang lain. Duh ... benar-benar memalukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590128,
					"content": "Terus soal lokasi sebelum dia hilang ... Sudah kutandai ya di petamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590129,
					"content": "Saat itu, kami dikejar musuh. Dia mencoba memancing mereka pergi lalu malah terpisah dari kami ... Dia adalah prajurit hebat, dan aku tahu dia tidak mungkin mati semudah itu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590130,
					"content": "Semoga dia meninggalkan jejak di sana. Semoga saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590124,
					"content": "Kalian yang memulai semua ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Kamu juga tidak bakal biarkan kita ikut campur rencana Fatui kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "Benar! Kalau hal baik yang kami lakukan adalah hal jahat bagi kalian, kamu enggak boleh menghalangi kami dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590111,
					"content": "Hal baik ... hal buruk ... menghalangi kalian ...? Ngomong apa sih kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590112,
					"content": "Duh kalian ribet amat sih. Biarkan aku selesai bicara dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590104,
					"content": "Tidak apa-apa. Kami kan belum menjanjikan apa-apa juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "Benar, kalian kan Fatui. Kalau suruh kami buat hal jahat, pasti kami bakal tolak mentah-mentah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590106,
					"content": "Hmmm ... kata-katamu masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
