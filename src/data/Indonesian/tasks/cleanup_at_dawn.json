			"dialogs": [
				{
					"id": 708240101,
					"content": "Bersih-bersihnya serius sedikit! Ini adalah kesan pertama tamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Maaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Kami akan lebih serius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Ah, selamat datang, Pengembara. Badainya sudah berlalu, tapi kita masih perlu membersihkan kekacauan yang dibuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Aku sedang mengurus pembersihannya, tapi anak-anak ini benar-benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Maaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Kami akan lebih serius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Ya ya, kamu sudah bilang tadi. Sekarang bagaimana kalau kalian bersih-bersih daripada berdiri di sini meminta maaf kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Anak-anak ini... kerjanya berantakan. Dengan kecepatan ini, tidak tahu kapan selesainya. Setelah itu masih ada bagian dalam yang harus dibersihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
