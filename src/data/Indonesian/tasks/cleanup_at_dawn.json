					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Apakah kamu tahu cara menyapu? Lupakan pertanyaanku, kita butuh semua orang yang tersedia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Ikuti aku masuk, ada banyak yang harus dibereskan di dalam.",
					"roleType": "TALK_ROLE_NPC",
