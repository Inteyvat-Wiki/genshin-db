			"dialogs": [
				{
					"id": 710480201,
					"content": "Kalian sudah kembali. Adventurers' Guild menyambut kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480202,
					"content": "Tentang Chasm ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "Kamu mau tanya ada apa di sana? Eh, entah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480204,
					"content": "Ada yang bilang para pekerja tambang berhasil menggali \"Batu Permohonan\", tapi yang didapatkan adalah kebalikan dari yang diminta. Ada juga yang bilang mereka menemukan ekor raja naga ... Semuanya cuma cerita berbumbu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480205,
					"content": "Sudah, tidak usah tanya soal Chasm sama aku. Aku juga tidak terlalu jelas di sana ada apa. Kalian cari saja si Muning. Bagian Urusan Sipil sudah tetapkan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480206,
					"content": "Tentang misi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "Ehem, jalanan ini penuh dengan orang yang mengandalkan nafkah mereka dari hasil Chasm. Aku yakin kalian bisa tanya sendiri sama mereka, tapi aku harus mengurus Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480208,
					"content": "Tentang Muning ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "Ah, dia. Kurasa dia dipindahkan ke Chasm karena Bagian Urusan Sipil sengaja ingin mendisiplinkan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480210,
					"content": "Orang dengan latar belakang macam dia mudah takabur. Seorang pelayan masyarakat mana boleh punya sikap seperti itu ... Chasm cocok untuknya, biar dia lebih dewasa dan bijaksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480211,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "Ya. Ah, iya ... Ad astra abyssosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
