					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin berlatih sangat keras dan hanya ini yang bisa kulakukan untuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Jika aku masih seorang petualang, aku pasti bisa mendapatkannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Dan dengan kondisi Mondstadt's Adventurers' Guild yang sekarang, kebanyakan rekan-rekanku juga sudah tidak bertualang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "Tidak banyak yang bisa dilakukan sekarang. Knights of Favonius benar-benar berpengaruh sekarang, semua anak muda ingin bergabung dengan mereka. Sehingga mereka tidak ingin beretualang di alam liar yang berbahaya seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "Tidak banyak orang yang bersedia melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
