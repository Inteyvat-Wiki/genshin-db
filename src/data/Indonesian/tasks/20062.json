			"dialogs": [
				{
					"id": 200620301,
					"content": "Apa kamu sudah menemukan boneka kayunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Sudah ketemu, tapi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Wah... sepertinya kamu memukulnya terlalu keras. Aku tidak mengerti bagaimana kamu bisa menghancurkan boneka kayu yang kokoh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Tapi sepertinya memang sulit untuk menahan diri saat berada dalam pertarungan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Meski aku tidak bisa memberikannya langsung pada Ellin. Tapi ini adalah kayu yang bagus, aku akan segera memprosesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Aku akan merakitnya, lihat, tidak buruk kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Ini semua berkat kamu, terima kasih banyak. Ini imbalan yang kujanjikan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Meski aku bukan lagi seorang petualang tapi kode etik petualang tidak boleh dilanggar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
