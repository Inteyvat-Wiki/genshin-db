			"dialogs": [
				{
					"id": 200620501,
					"content": "Hmm, apa ya cara terbaik untuk latihan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Ah, aku sedang latihan untuk ujian pemilihan Knights of Favonius. Tapi ini sulit, tidak ada seorang pun yang bisa membimbingku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Ayahku terus menawarkan diri untuk menjadi mentorku, katanya dulu dia seorang petualang, tapi aku tidak percaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "Ayahku yang seperti itu, bagaimana mungkin dia bisa membantuku dalam ujian pemilihan Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "Dia juga bilang bahwa dia akan menyiapkan beberapa alat untuk membantuku latihan, sebenarnya apa yang dia siapkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
