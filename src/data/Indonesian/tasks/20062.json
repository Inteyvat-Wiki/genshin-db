			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Ah... Putriku, Ellin, bertekad untuk bergabung dengan Knights of Favonius, dan sekarang dia sedang berlatih untuk ujian pemilihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "Hah... aku benar-benar ingin melatihnya, tapi dia tidak percaya bahwa dulu aku adalah mantan petualang. Dia ingin berlatih sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Dan aku tidak bisa melakukan apa pun untuk membuktikannya... Saat kamu sudah punya anak dan istri, kamu sudah tidak bisa lagi pergi untuk mengambil risiko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Daripada pergi bertualang, sekarang tanggung jawabku yang terpenting adalah merawat keluargaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Tapi aku masih memiliki jiwa petualang, dan aku masih bisa melakukan beberapa hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Sewaktu aku masih menjadi petualang, aku banyak memperhatikan boneka kayu yang dipakai oleh para Hilichurl untuk latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Mereka terlihat kokoh, aku yakin mereka cocok jika digunakan oleh Ellin untuk latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Bisakah kamu membantuku dan membawakan beberapa boneka kayu Hilichurl? Tentunya aku juga akan memberikan imbalan atas bantuanmu, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Bagus! Aku suka orang yang bersemangat, aku juga dulu seperti itu saat baru bergabung dengan Guild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Ah aku bercanda, baiklah sekarang pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Hanya Hilichurl, kamu sendiri juga bisa melakukannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Ah tidak tidak, petualang juga punya batasan. Setiap petualang hanya bisa menghadapi satu petualangan pada satu waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Dan petualangan dari \"kehidupan pernikahan\" adalah yang terpenting, tidak peduli siapa pun dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Jadi tolonglah, kuserahkan para Hilichurl itu padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
