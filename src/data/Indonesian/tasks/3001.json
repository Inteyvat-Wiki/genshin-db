					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010617,
					"content": "Kamu dan Paimon lanjut membersihkan patung.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "Kayak kubis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "Iya! Kecil, bulat, mirip kubis, tapi ... bisa gerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
