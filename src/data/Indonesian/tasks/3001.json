			"dialogs": [
				{
					"id": 30011101,
					"content": "Ah, Pengembara, kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011102,
					"content": "Iya, kami sudah kembali. Maaf, apa kamu barusan lihat Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011103,
					"content": "Oh, Collei? Iya aku lihat dia tadi sudah kembali ke kamarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011104,
					"content": "Oh, gitu ya ... Ya sudah, besok saja kita ngobrol sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
