				{
					"id": 30015101,
					"content": "Aku kurang mahir memanjat, jadi urusan bersihkan patung kuserahkan padamu yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30015102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30015102,
					"content": "Aku mau periksa fasilitas yang ada di depan. Oh iya, kalau sudah beres, mau kan ngobrol-ngobrol dulu sama aku?",
