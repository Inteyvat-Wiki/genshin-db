			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Oke, sekarang coba lihat tangan kananmu ... Hmmm, ya lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "Tapi tetap ingat untuk berhati-hati ya, mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Iya, tahu kok. Omong-omong, Guru, aku belum dapat rute patroli untuk hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Collei, rute patroli hari ini sangat panjang, jadi kamu tidak perlu ikut dulu. Selain itu, kita mungkin akan bertemu ... yah, kamu mengerti kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "Tapi aku juga punya Vision! Masa aku tidak bisa berguna untuk semuanya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Jangan bicara begitu, Collei. Kamu tidak perlu memikirkan hal ini dulu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Ah, kalian sudah datang. Sudah merasa lebih enak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Apa ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Kami kan bakal tinggal di sini buat beberapa hari. Jadi kami pikir enggak ada salahnya kan bantu-bantu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Haha, sepertinya kalian bukan tipe orang yang bisa bersantai lama-lama ya? Kalau begitu, mungkin Collei bisa membawa kalian patroli ke bagian selatan Desa Gandharva hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "Dan kalau kalian merasa siap, pekerjaan membersihkan Patung The Seven kuserahkan pada kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Guru Tighnari, kami sudah siap berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Oke, sebentar! Baiklah, kami mau berangkat ke hutan. Sisanya biar Collei yang jelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Oke, serahkan padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei, kita mau ngapain saja hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Barusan Tighnari bilang kita harus bersihin patung? Uh ... kok itu kayaknya bukan tugas Penjaga Hutan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Ah, sebenarnya tanggung jawab Penjaga Hutan itu lumayan bervariasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Kami menangani berbagai hal, seperti misalnya periksa keadaan jalan, merawat fasilitas hutan, menjaga supaya tidak terjadi kebakaran, lalu bantu-bantu pengembara dan warga sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "Kalau guru biasanya urus area yang lebih berbahaya di hutan hujan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Hari ini kita bisa periksa lampu jalan, sekalian menuju ke Patung The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Patung The Seven ada di atas batu besar sana. Aku yakin kalian sudah lihat waktu dalam perjalanan kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "Lokasi patungnya lumayan tinggi, kan? Tidak apa-apa kalau kalian tidak kuat naik, aku yakin guru tidak akan marah kalau kalian tidak bersihkan patungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "Tenang, kami ini ahlinya panjat tebing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Wah? Baiklah kalau begitu kuserahkan padamu ya. Di atas sana kurang tempat berpijak, jadi hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, Paimon ikut ke atas ya, bantu bersihin area yang susah dijangkau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Oh iya. Collei, apa kamu tahu sesuatu soal Archon Dendro? Dia itu kayak apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Eh, tergantung ya. Maksudmu itu Greater Lord Rukkhadevata atau Lesser Lord Kusanali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Hah? Greater Lord Rukkhadevata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Apa itu nama Archon Dendro sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Betul. Greater Lord Rukkhadevata adalah Archon Dendro pertama di Sumeru. Dia yang menciptakan hutan hujan dan Tembok Samiel yang mengelilingi gurun pasir. Dia yang menyediakan jalan bagi kehidupan yang damai sejahtera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Bagi orang Sumeru, dia tidak hanya lambang kebijaksanaan, tapi juga kedaulatan dan welas asih. Sayangnya dia menghilang ketika bencana besar terjadi ratusan tahun yang lampau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Persis seperti yang menimpa Raiden Makoto ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "Menurut yang dibilang Guru padaku, para Sage lalu menemukan Archon Dendro yang terlahir kembali dan membawanya kembali ke Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Untuk merayakan kembalinya dewa mereka yang hilang, para Sage memanggilnya dengan sebutan \"Lesser Lord Kusanali\" dan menempatkannya di Sanctuary of Surasthana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Oke, terus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Terus, mm ... Aku juga sejujurnya kurang tahu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Hah? Kok bisa? Bukannya kamu orang Sumeru, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Iya, aku orang Sumeru. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "Apa kamu kurang leluasa bahas soal ini dengan orang asing? Kalau begitu enggak apa, kami paham kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "Bukan, bukan begitu. Aku bukannya menyembunyikan sesuatu sama kalian. Lagi pula, kalian berdua bukan orang asing di mataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Jadi ... eh ... Ka-Kalian kenal sama Amber, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Tunggu, Amber? Maksudmu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Amber si Outrider dari Knights of Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Iya, betul! Dulu aku pernah tinggal di Mondstadt untuk beberapa saat, dan waktu itu dia sudah banyak sekali bantu aku. Boleh dibilang dia yang membimbing aku jadi aku yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Amber memang hebat! Dia menjalani hidup dengan riang, sambil tetap berpegang teguh pada prinsip keadilan yang dia percaya. Dia selalu siap bertindak, dan selalu berusaha memahami orang lain. Dia bagaikan percikan api yang membakar nyala hati setiap orang di sekelilingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Kalau kalian tanya aku, dia itu contoh paripurna seorang Outrider sejati. Setiap orang yang datang ke Mondstadt pertama-tama bakal ketemu dia dulu. Lalu kemudian mereka juga terpesona oleh daya tarik dan semangatnya, sampai jadi jatuh cinta pada Mondstadt, lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Eh, hehe ... Maaf ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Eh, selama ini Paimon sih tahunya kerja Outrider beda banget sama yang kamu ceritain barusan. Tapi satu hal yang sudah pasti ... kamu sukaaaaa banget sama Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Eh, hehe, ma—maaf ... Aku jadi ngoceh sendiri. Aku pasti kedengaran aneh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Hehe, enggak apa-apa, Collei. Paimon malah ngerasa makin dekat sama kamu setelah tahu kamu temannya Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "Terus kamu kok bisa tahu kalau kami juga kenal sama Amber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Eh, soalnya setelah aku pulang ke Sumeru, aku masih tetap jaga hubungan sama Amber lewat surat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "Dia cerita kalau Mondstadt diserang sama naga yang menyeramkan, tapi kotanya selamat berkat pertolongan seorang pengembara misterius berambut pirang dan kawannya yang melayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "Jadi waktu lihat kalian tempo hari, aku langsung tahu kalianlah yang Amber maksud. Tapi setelah semua yang kalian alami hari itu, kurasa kurang baik kalau aku bahas soal ini kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Ah, jadi begitu toh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Iya! Jadi kalian paham kan, aku percaya sepenuhnya sama kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Aku ingin cerita lebih banyak soal Archon Dendro, tapi aku juga sempat lama tinggal di luar Sumeru, dan aku jarang baca buku ... maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "Santaaai, kamu sudah bantu banyak kok. Kami belum pernah dengar soal Greater Lord Rukkhadevata atau Sanctuary of Surasthana sebelum kamu cerita tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Oh, aku senang kalau memang bisa berguna. Satu pertanyaan dari aku ... kenapa kalian ingin tahu lebih banyak soal Archon Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Kamu menceritakan tujuan perjalananmu pada Collei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Oh jadi itu alasannya kalian ada di sini. Terima kasih karena sudah mau cerita padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "Santai saja, kita kan sudah jadi teman, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon betul tuh, kan kita sekarang teman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Hehe! Oke, kalau gitu kita lanjut bersihin patung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "Terima kasih! Selagi kalian bersih-bersih, aku mau cek tenda di hutan. Nanti kita kumpul lagi di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "Wow, enggak disangka ya, Collei ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "Amber, orang Mondstadt yang hobi banget meluncur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Apa ini ada hubungannya dengan Khaenri'ah ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Yang ginian sih receh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
