					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010615,
					"content": "Paimon sampai kaget! Apa pun itu, pokoknya kita harus cari tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010616,
					"content": "Eh, tapi mungkin mending lanjutin dulu bersih-bersihnya. Paimon bagian atas, kamu bawah.",
