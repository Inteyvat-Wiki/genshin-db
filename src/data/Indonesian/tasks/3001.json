					"nextDialogs": [
						30011004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011004,
					"content": "Aku bawa makanan ringan praktis yang biasa dimakan oleh Penjaga Hutan. Namanya Pita Pocket. Semoga kalian doyan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "Collei"
