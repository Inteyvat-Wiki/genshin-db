			"dialogs": [
				{
					"id": 721570101,
					"content": "Huh? Di mana Batu Pelindungnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570102,
					"content": "Ckck, sepertinya ini tidak semudah yang kita pikirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570103,
					"content": "Ayo kita cari di sekitar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "Yah, sepertinya itu satu-satunya pilihan kita. Ayo kita lihat apa yang mungkin bisa kita temukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570105,
					"content": "Tapi tempat ini luas sekali! Kita harus cari berapa lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570106,
					"content": "Kurasa kita hanya bisa mengandalkan keberuntungan saja. Ayo kita mulai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570107,
					"content": "Jangankan untuk \"menyegel\" Batu Pelindung itu, bahkan \"ke mana kita harus mencarinya\" saja sepertinya sudah jadi masalah buat kita, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570108,
					"content": "Semoga kita dapat menemukan beberapa petunjuk di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570109,
					"content": "Ayolah, Taisuke. Jangan buang-buang waktu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570110,
					"content": "Ba-baik, Nona Etsuko. Kurasa ini satu-satunya pilihan kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
