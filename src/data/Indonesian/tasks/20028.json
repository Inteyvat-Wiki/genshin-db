			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#Te-terima kasih banyak, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280102,
					"content": "Meskipun aku seorang pemburu... Tapi aku juga kesulitan menghadapi para Slime ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280103,
					"content": "Karena ulah mereka, perburuan kali ini pun aku tidak membawa apa-apa untuk dibawa pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280104,
					"content": "Aku harap pemburu lain tidak semalang diriku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280105,
					"content": "Oh ya bicara soal ini, dapatkah kamu pergi memeriksa sekeliling kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280106,
					"content": "Aku tidak tahu apakah aku berhalusinasi atau tidak, tapi aku merasa di sekitar sini... para Slime sepertinya semakin banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280107,
					"content": "Tolong pergilah dan periksa. Jika kamu menemukan Slime, langsung disingkirkan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280108,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Terima kasih banyak, aku juga akan kembali dan melaporkan hal ini kepada Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280111,
					"content": "Aku harap dia tidak terlalu mabuk sehingga tidak mendengar apa yang kukatakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280109,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Tapi satu-satunya orang yang dapat menyelesaikan masalah ini hanya kamu seorang. Tolonglah, ini demi Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		}
	]
