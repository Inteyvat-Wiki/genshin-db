			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ken",
					"Tadao",
					"Paimon",
					"Gou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Ugh, habis deh semua Mora-nya... Padahal kita sudah susah payah mencurinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "Ayolah bos, pikirkan sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Ehem... boleh juga, Nak ... Ka-kamu mau bergabung dengan Treasure Hoarder? Kita butuh orang sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Lupakan saja. Beri tahu kami tentang Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa? Oh... aku ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "Jadi dia yang mengirim kalian ya? Tsk, sial sekali... sudah kuduga kita tidak boleh mencuri dari tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "Jadi, apa yang kalian lihat di dalam? Penuh dengan persediaan makanan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Persediaan makanan? Kalian bercanda ya? Rumahnya berantakan sekali... Kita hanya menemukan kotak yang aneh, berharap ada yang berharga di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "Aku tidak mau orang lain melihat isinya, jadi aku berencana membukanya sendiri setelah kembali nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "Tapi sekarang kalian menangkap kita, bagaimana kalau kita membuat perjanjian? Kotak kecil itu ditukar dengan kebebasan kami... Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "Setuju. Sekarang tunjukkan isi kotak itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "Hah!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "Ini kan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "I-Isinya... surat utang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Ya, dan ada banyak sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "Sepertinya semua ditujukan pada Nona Aoi, pemilik toko kelontong... Uutangnya banyak sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "Sebaiknya kita bicara dengan Nona Aoi ini lalu cari akar permasalahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "Terus kalian, silakan pergi saja. Berdoalah semoga kita jangan sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "I-iya, tentu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "Jadi kita sudah menggunakan surat utang untuk menebus tubuh kita... Artinya kita impas dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Ah sudahlah! Ayo cepat pergi dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Tidak akan. Kudengar kalian menjarah rumah Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aoi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Selamat datang di Tsukumomono Groceries, kami punya semua yang kamu butuhkan. Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "Atau mungkin... ada sesuatu yang ingin ditanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "Tentang surat utang ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Ah, jadi kamu temannya Kurosawa ya? Haha. Mungkin kamu ke sini untuk membayar utangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Wow, wow, jangan asumsi dulu dong... Kami di sini mau tanya saja, itu semua datang dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "Bagaimana Kurosawa bisa berutang begitu banyak uang padamu? Apa dia beli sesuatu yang mahal banget di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Coba kupikirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa datang secara rutin untuk membeli bahan makanan dalam jumlah banyak. Dan dia selalu membayar dengan uangnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "Tapi harga perbekalan mulai naik akhir-akhir ini, dan gajinya tidak cukup untuk membayarnya. Jadi dia mulai menulis surat utang untuk menutup kekurangan yang tidak bisa dia bayar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "Jadi begitu toh caranya dia bisa mendapatkan perbekalan darurat itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "Tapi kenapa dia harus beli dengan jumlah yang \"biasa\"? Kalau harganya naik, harusnya kan dia beli lebih sedikit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "Yah jika kamu pikir lagi, rakyat yang menerima perbekalan darurat pasti sudah menghitung dengan cermat berapa banyak yang mereka butuhkan untuk bertahan setiap waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Kurosawa berpikir itu akan mengecewakan mereka jika mereka tidak tercukupi. Apalagi setelah perencanaan panjang dan cermat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "Jadi dia memutuskan untuk berutang daripada mengecewakan orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Jadi Kurosawa membeli semua perbekalan darurat dan membayarnya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "...dan tidak ada yang menghargai apa yang dia lakukan... Mereka hanya mengeluh dan meminta pertanggung jawaban...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "Kelakuan orang-orang akan selalu mencerminkan kondisinya. Dihadapkan dengan cobaan berat, tidak ada lagi orang yang bisa berpikir jernih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "Menurutku sih, kalau Kurosawa bilang kepada orang-orang tentang persediaannya dari awal, maka tidak akan ada cibiran seperti sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Tentu saja, aku yakin pasti masih ada saja orang yang tak puas. Apa yang dia lakukan benar-benar hal yang tanpa pamrih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "Dan alasan kenapa dia memilih untuk menggunakan uangnya untuk perbekalan darurat dan tidak pernah mengatakannya pada siapa pun... Aku juga masih tidak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "Kalau kamu masih penasaran, kenapa tidak langsung tanya saja pada dirinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Sayangnya, dia tidak ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "Oh begitu ya... Aku jadi ingat... sepertinya Visionnya juga akhir-akhir ini baru saja diambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Tapi sayangnya... Jika dia tidak menyelesaikan utangnya, dia tidak punya pilihan lain selain menjual pedang kesayangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Pedang? Pedang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Apa dia tidak bilang padamu? Dia punya pedang yang sangat berharga... Dia sudah membawanya selama bertahun-tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "Aku sudah bertanya padanya tentang asal-usul pedang itu — dia bilang itu hadiah dari ayahnya... dan pedang itu terlalu berharga untuk dijual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "Tapi juga, aku menyesal tidak menawar harga pedang itu dengannya... Karena semua pasti ada harganya, setidaknya menurutku begitu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Kenapa kamu tidak tanya saja sendiri padanya tentang pedang itu? Mungkin kamu akan menemukan jawaban yang kamu cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Tapi sebelum kamu pergi, kalau kamu mau berbaik hati dan melunasi pembayaran hari ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Eh? Tapi kita kan enggak beli apa-apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Hehe, informasi juga bisa diperjual-belikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Jangan khawatir, aku tidak akan memberi harga yang mahal tentang Kurosawa. Lagi pula tidak ada hal yang rahasia. Biar kupikirkan ... Dua ribu Mora saja cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "Setidaknya kita tahu dari mana datangnya perbekalan darurat tersebut, terus kita jadi tahu kalau Kurosawa punya pedang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Ayo bicara lagi sama Kurosawa dan kita lihat kalau dia bisa ingat sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200505",
							"2"
						],
						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Heh, kamu ngapain di sini sendirian? Pergi ke mana dua orang yang lainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "Aku beri mereka pilihan: antara mereka pergi atau kugunakan pedangku. Terus mereka pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "Dan ini menjadi lebih efektif daripada kata-kata. Mungkin aku harus menggunakannya lebih sering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Apa kamu berhasil melacak Treasure Hoarder? Semua yang kukatakan benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "Sebenarnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Jadi begitu. Ternyata kamu benar-benar mendistribusikan perbekalan darurat, tapi kamu membelinya dengan uangmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Masa sih... Aku yang dulu, sampai sebegitunya kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "Aku benar-benar tidak ingat. Setelah semua yang kamu katakan, aku masih tidak ingat apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Kenapa aku beli perbekalan darurat buat semua orang? Dan kenapa aku harus menaruh diriku sendiri dalam situasi seperti itu... aku benar-benar tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "Tapi aku tidak bisa menyangkal bahwa aku memang menarik pedangku untuk menakut-nakuti mereka berdua tadi, aku bisa merasakan adanya penolakan dari diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "Pedangnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Pedang ini dulunya punya ayahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "Aku ingat waktu muda dulu, aku pernah mengambil pedang ini dan menyelinap keluar untuk pamer ke anak-anak tetangga. Ayahku lalu menangkap dan memarahiku habis-habisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "Apa yang dia katakan ya... Eh, aku tidak ingat sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "Sepertinya aku jadi lupa banyak hal penting sejak Visionku diambil olehku. Banyak kenangan, hilang selamanya, tidak peduli seberapa keras aku berusaha untuk mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "Semua yang bisa kuingat sekarang adalah ayahku mengatakan bahwa pedang ini mengandung sejarah hidupnya. Sebelum dia meninggal, dia memercayakan pedang ini di tanganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "...dan dia bilang padaku, \"Dengan pedang ini, kamu harus—\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Hei... kalau dilihat baik-baik, sepertinya ada kata-kata yang terukir di gagangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Apa kamu bisa baca kata-katanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "Kata-kata ini: \"Kebajikan dan Keadilan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "\"Kebajikan dan Keadilan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "Sepertinya, kedua kata itu menjelaskan semuanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Mengambil utang yang tampaknya tak ada habisnya dan diberikan atas nama amal untuk orang lain. Aku rasa itu adalah ambisi terbesarku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "Tapi keadilan dan kebajikan, apa gunanya? Aku membeli perbekalan bagi mereka yang membutuhkan, dan lihat akhirnya bagaimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "Tenryou Commission mengambil Visionku, dan orang yang ingin kutolong malah tidak mau mengerti kondisiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "Dan ironisnya adalah... entah bagaimana aku masih merasa kasihan saat mengancam mereka dengan pedangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "Aku tidak bisa jadi orang baik... tapi aku juga tidak bisa jadi orang jahat. A-aku tidak tahu apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Lagi-lagi orang yang bermasalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "Kalau kita ada kesempatan, ayo kita bicara sama Thoma soal utang Kurosawa. Yashiro Commission pasti akan menolong untuk melunasi utangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "Bagaimanapun juga, kita tidak boleh membiarkan dia menjual pedang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Kehilangan sebuah Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Iya, sepertinya kehilangan ambisi itu hal yang mengerikan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "Untungnya, kamu enggak punya Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Ayo kita temukan orang malang berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "...sepertinya bukan masalah sepele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Boleh kulihat sebentar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
		{
			"id": 200505,
			"completionStepIds": [
				200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200506",
							"2"
						],
						"stepId": 200506,
						"stateName": "QUEST_STATE_UNFINISHED"
