			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Oomori",
					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Katanya Tenryou Commission langsung diperintah oleh Shogun. Mereka bertugas menjaga ketertiban dan hukum di Inazuma, dan mereka jugalah yang menjalankan Dekrit Perburuan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "Tapi kenapa mereka menyerang anggota mereka sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Paimon jadi bingung... Eh? Sepertinya ada ribut-ribut di sana, ayo kita lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "Kutanya sekali lagi... Kamu masih mau menahan perbekalan darurat bulan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "Seluruh klan kita bergantung pada makanan itu. Kami butuh penjelasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "Sudah berapa kali kukatakan... Aku tidak tahu apa-apa tentang perbekalan darurat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "Beraninya kamu bohong! Bekal itu sangat penting, mengerti? Bukan barang yang bisa seenaknya diambil oleh samurai serakah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "Kamu kira seorang samurai bisa bertindak semena-mena? Akan kulaporkan masalah ini ke Tenryou Commission!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Perbekalan darurat... seperti makanan darurat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Hah? Siapa kamu? Anggota geng Kurosawa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "Apa? Kita kebetulan lewat sini saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "Kami dengar ada ribut-ribut dan datang untuk melihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "Oh begitu, kalian datang di waktu yang tepat. Mungkin kamu bisa membantu menyelesaikan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "Dia adalah Kurosawa, seorang samurai dan juga anggota Pasukan Shogun. Mereka memberikan perbekalan darurat di area sini, dan dia adalah orang yang bertanggung jawab untuk mendistribusikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "Dulu, kita hanya perlu meminta perbekalan dari dia dan akan langsung diantarkan. Sekarang, dia menolak untuk mengirimkan apa pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "Dia pasti menyimpan semuanya untuk dia sendiri, pokoknya aku yakin! Kita akan kelaparan tanpa makanan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "Tidak ada yang peduli dengan kita... Dulu kita pikir Kurosawa itu orang baik, tapi dia sudah menunjukkan sifat aslinya. Sama saja seperti samurai lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "Tidak heran semua Vision akan dirampas. Sang Raiden Shogun tidak perlu orang seperti dia untuk memerintah bangsa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "Pasti dia salah satu orang yang Ayaka minta kita bantu. Tapi kenapa dia mau menolong orang seperti dia ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Mungkin kita harus bicara dengan Kurosawa dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
