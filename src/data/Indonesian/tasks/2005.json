			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "Aku bahkan belum pernah dengar tentang perbekalan darurat itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050502,
					"content": "Aku tidak tahu apa itu cuma gosip atau mereka mau mengancamku, tapi itu omong kosong. Kalau aku menimbun perbekalan, apa aku bakal masih miskin seperti sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "Keluargaku saja kesulitan... Sekarang, permisi ya, aku masih punya urusan yang harus dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "Kami dengar kamu akhir-akhir ini kehilangan Vision milikmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "Itu kebenaran pahit yang kudengar hari ini. Pasukan Shogun bilang aku tidak layak menyandang Vision — mereka bilang aku malas bekerja. Ternyata aku telah mengecewakan Raiden Shogun. Makanya mereka mengambil Visionku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Aneh juga, kan kamu membantu Dekrit Perburuan Vision. Kenapa dianggap tak layak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "Sejujurnya sih... Aku bahkan tidak begitu ingat detailnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "Yang kutahu adalah aku harus menjalankan tugas setiap bulan, tapi aku tidak ingat tugas apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "Bukan hanya itu... Ada sesuatu yang mengganjal seperti... seolah seseorang berutang sesuatu padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Apa ini ada kaitannya sama perbekalan daruat yang hilang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "Aku tidak mengambil apa pun! Seperti yang kubilang, kalau aku mengambilnya, aku tidak akan kesulitan seperti sekarang ini kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "Terlebih lagi, rumahku baru dijarah oleh Treasure Hoarder... makanya aku datang ke sini. Aku mengejar mereka lalu tertangkap oleh mereka berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "Kalau kamu tidak percaya, temukan saja para Treasure Hoarder itu sendiri! Kalau memang ada perbekalan darurat, pasti mereka sudah menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Heh... Sepertinya dia mengatakan yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "Tapi sebaiknya kita konfirmasi dulu. Ayo kejar Treasure Hoarder itu terus kita dengar dulu apa yang mereka katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "Seharusnya kita bisa mengikuti jejaknya. Mereka harusnya belum jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
