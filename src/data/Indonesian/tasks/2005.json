					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "Semua rumah para samurai penuh dengan banyak barang berharga, haha! Kita dapat jackpot. Maksudku, selain dari rumah yang itu loh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Kamu masih belum lihat apa-apa, masih banyak lagi nantinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Hari ini baru permulaan. Aku akan memimpin kalian semua ke perjalanan penjarahan yang akan tercatat dalam sejarah para perampok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "Bos memang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "Sepertinya mereka Treasure Hoarder yang kita kejar. Ayo beri mereka pelajaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
