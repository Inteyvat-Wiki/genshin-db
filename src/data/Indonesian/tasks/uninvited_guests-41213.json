			"dialogs": [
				{
					"id": 412130501,
					"content": "Aku datang untuk memeriksa keributan apa yang terjadi, dan ternyata kalian yang sedang berulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
