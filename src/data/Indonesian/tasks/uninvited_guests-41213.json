			"dialogs": [
				{
					"id": 412130601,
					"content": "Kekuatan naga... energi kehidupannya bahkan dapat menghidupkan kembali pohon yang sudah mati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130602,
					"content": "Luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130603,
					"content": "Kenapa pohon mati bisa berubah menjadi monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130604,
					"content": "Paimon hampir saja ditelan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130605,
					"content": "Tapi kenapa kejadian ini tidak pernah terjadi sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130606,
					"content": "Mungkin karena pedang itu terjatuh ke tanah. Akibatnya, kekuatan dalam pedang itu merembes keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130607,
					"content": "Ini salahku! Kumohon, tolong jangan mengusirku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130608,
					"content": "Aku janji, aku tidak akan berulah lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130609,
					"content": "Ah, Tuan Pallad. Kamu tidak perlu meringkuk seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130610,
					"content": "Eh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130611,
					"content": "Cryo Regisvine mati di tempat seperti ini... Apa jangan-jangan karena dia tidak bisa menghisap kekuatan naga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130612,
					"content": "Setelah pemurnian yang kamu lakukan, kekuatan elemental yang murni menghidupkan dan meningkatkan kekuatan Cryo Regisvine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130613,
					"content": "Energi kehidupan yang murni menyebabkannya terus bertumbuh... bersamaan dengan semangat tarungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130614,
					"content": "Situasinya lebih buruk dari yang diharapkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "Aku juga belum pernah mengalami kejadian ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130617,
					"content": "Harus kuakui, fenomena langka ini adalah penemuan berharga yang tak terduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130618,
					"content": "Sucrose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130619,
					"content": "Ah, iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130620,
					"content": "Awasi petualang itu dan bawa dia kembali ke kemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130621,
					"content": "Baik, tuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130622,
					"content": "Mengenai masalah ini, aku mohon maaf, Pengembara... Tapi aku harus meminta bantuan kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130623,
					"content": "Aku akan membantu sebisa mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "Kekacauan ini benar-benar tidak terduga, dan hanya kita yang bisa membereskannya. Mungkin ini karena kemampuan kita semakin hari semakin hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130615,
					"content": "Tidak kusangka bisa begitu. Apa karena aku terlalu kuat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
