						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Luar biasa! Aku belum pernah melihat senjata seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130202,
					"content": "Dan kamu juga sangat hebat. Baik dari gaya bertarung atau pun caramu mengayunkan pedang, semuanya sangat sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130203,
					"content": "Terima kasih untuk pujianmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Pedang ini sangat unik. Jelas-jelas aku tidak mau menelitinya terlalu dalam, tetapi aku tidak bisa mengalihkan pandanganku darinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130205,
					"content": "Paimon rasa ini adalah keunikanmu, bukan keunikan pedang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Ini sudah pasti adalah pedang misterius yang memikat dan sangat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130207,
					"content": "Tuan Albedo pasti sangat memercayai kalian, karena dia sudah menyerahkan pedang ini kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130208,
					"content": "Aku juga merasa terkejut dengan hal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Hehehe, kamu berhasil mendapat kepercayaannya karena kemampuanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Aku setuju dengan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130212,
					"content": "Tapi sebelum pedang ini diserahkan kepadamu untuk menghisap banyak energi, bagaimana Tuan Albedo menyadari keunikannya di antara tumpukan barang di gudang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130213,
					"content": "Gagasan cemerlang biasanya datang begitu saja. Misalnya, Paimon tiba-tiba ingin memakan Sticky Honey Roast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah, aku baru ingat kalau aku belum makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130215,
					"content": "Setelah menyelesaikan penelitian, aku langsung bergegas mencari kalian. Di tengah jalan, aku berpapasan dengan seorang petualang yang terperangkap dalam timbunan salju. Aku menghabiskan banyak waktu untuk menyelematkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130216,
					"content": "*krucuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130217,
					"content": "Perutmu keruyukan karena lapar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ah... AHHH! Ti-tidak kok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130219,
					"content": "Jangan malu-malu! Katakan saja apa yang kamu pikirkan dengan lantang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Anu, anu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130221,
					"content": "Biarkan Paimon membantumu: Paimon lapar! Kita harus mencari sesuatu untuk dimakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "Aku lapar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "A-aku lapar. Aku ingin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130225,
					"content": "Aduh, aku masih merasa malu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130226,
					"content": "Kenapa harus malu? Mengaku lapar akan membuat makanan terasa lebih enak loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130228,
					"content": "Iya! Ayo kita pergi! Pasti ada makanan enak di kemah~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Coba saja ada Sticky Honey Roast yang membuat perut hangat di tengah dinginnya salju ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "Aku ingin makan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "Aku merasa terhormat mendapat kepercayaan darinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
