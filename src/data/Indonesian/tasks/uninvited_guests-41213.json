				{
					"id": 412130301,
					"content": "U-ugh... Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130302,
					"content": "Tuan Pallad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130303,
					"content": "Ka-kamu belum pergi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130304,
					"content": "Bukankah dia petualang sembrono dari Mondstadt? Apa dia juga ikut dengan Cyrus bertualang ke gunung salju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "Di-di-dingin sekali, a-achoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130306,
					"content": "Setelah aku menyelamatkanmu keluar, kamu terus menunggu di sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130307,
					"content": "Aku mau pergi, ta-tapi aku tersesat. Maaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130308,
					"content": "Huhuhu... Di-diingiinnn, aku tidak bi-bisa bergerak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130309,
					"content": "Tuan Pallad, kamu perlu melakukan banyak persiapan untuk naik ke gunung. Jangan meremehkan perjalanan ke gunung begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130310,
					"content": "Ayo kita bawa dia pulang saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Apa kalian mampu? Tapi kondisinya ini... Takutnya dia tidak bisa berjalan sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130312,
					"content": "Walaupun tidak mampu, kita tidak mungkin membiarkannya membeku di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "Benar juga... Maafkan aku, pengembara. A-aku mewakili dia meminta maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130314,
					"content": "Kamu masih punya waktu untuk mengkhawatirkannya? Lebih baik kamu pikirkan keselamatan dirimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "AH! Fatui menyerang lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Kalian seharusnya sudah tahu tujuan kedatangan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "Sebelum menyerahkan pedang itu, kami tidak akan membiarkan kalian pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "Tidak! Tolong jangan serahkan pedang itu kepada mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130319,
					"content": "Tentu saja! Aku tidak akan menyerahkannya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Semangatmu boleh juga! Ayo kita kalahkan semuanya sekaligus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Tuan Pallad, aku akan membawamu ke tempat yang aman. Cepat kemari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130323,
					"content": "Lucu sekali kalian! Satu pun dari kalian tidak akan bisa lolos dariku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "Pedang ini akan kami jadikan hadiah untuk Yang Mulia Harbinger Signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Jangan harap bisa merebutnya dariku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
