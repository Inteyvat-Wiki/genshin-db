						412130504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130504,
					"content": "Bukannya kamu sedang merapikan dokumen? Kenapa kamu bisa ada sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130505,
					"content": "Ditambah lagi, kamu bertarung dengan musuh berbahaya di medan bersalju ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130506,
					"content": "A-aku juga terlibat... Maaf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
