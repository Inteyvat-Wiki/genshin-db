					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Anu... Aku, aku hanya... Maaf, aku hanya lewat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130509,
					"content": "Aku rasa kamu ke sini karena ada sesuatu yang menarik perhatianmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "Aku sudah menceritakan tentang pedang itu kepada Sucrose, maaf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "Kamu memberi tahu dia semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Kami hanya menceritakan tentang asal-usul pedang, kami tidak membiarkannya memegangnya. Setidaknya kami masih punya sedikit akal sehat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "Ya sudah, kita memang tidak akan bisa menyembunyikan hal ini lama-lama dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Sucrose sangat tertarik dengan pengetahuan dan misteri. Dia memang sangat berbakat dalam alkimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "Ah... Uh... Aku berjanji tidak akan berulah lagi! Aku berani bersumpah atas nama penelitian terbaruku, biji Sweet Flower yang lebih besar empat kali lipat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130516,
					"content": "Aku tidak takut kamu berulah, aku hanya mencemaskan keselamatanmu. Lain kali kamu harus lebih berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "Oh ya, ada apa dengan petualang yang sedang berjongkok itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "Aku melindungi Tuan Pallad selama pertarungan. Dia seharusnya tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130519,
					"content": "Aku... Aku kedinginan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130520,
					"content": "Dia pasti masuk angin saat pertarungan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130521,
					"content": "Ah, aku tidak memikirkan kemungkinan ini sama sekali... Ini kesalahanku, maafkan aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130522,
					"content": "Tuan Albedo, aku akan memeriksa kondisinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130523,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "Sucrose mungkin sangat canggung dan kaku, tapi dia adalah anak yang baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130525,
					"content": "Kamu menyebut orang yang badannya lebih besar darimu sebagai \"anak-anak\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "Benar juga ya, hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130527,
					"content": "Anak itu... bila tidak diawasi, dia bisa-bisa terdampar ke tempat yang aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130528,
					"content": "Anak muda selalu begitu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "Benar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130530,
					"content": "Sucrose tidak sengaja membuat masalah. Tolong jangan marah padanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "Tenang saja, aku tidak marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130532,
					"content": "Loh? Sepertinya ada yang berkilauan pada bilah pedang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130533,
					"content": "Eh? Ada perubahan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130534,
					"content": "Kekuatan pedang ini tiba-tiba bertambah sangat banyak. Apa yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130535,
					"content": "Kami telah bertarung dengan Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "Di antara para Fatui Skirmisher, ada beberapa prajurit kuat yang belum pernah kami temui sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130537,
					"content": "Ternyata karena kekuatan yang belum pernah ditemui sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130538,
					"content": "...membuat kekuatan pedang ini meningkat pesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
