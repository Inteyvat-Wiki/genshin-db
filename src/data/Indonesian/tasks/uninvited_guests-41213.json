			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo! Kami kembali lagiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Loh? Dia sepertinya tidak ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Apa dia keluar untuk melakukan penyelidikan? Atau pergi menggambar sketsa misterius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "Ah! Kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130105,
					"content": "Loh, Sucrose! Kenapa kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "Aku sudah menyelesaikan penelitianku. Aku punya waktu 5 jam 26 menit untuk bersantai-santai hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130107,
					"content": "Karena itu aku datang mencari kalian untuk meminta informasi tentang masalah yang kuceritakan waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130108,
					"content": "Wah, perhitungan waktu kamu akurat sekali! Apa kamu manusia jam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "Ti-tidak, tidak perlu memujiku seperti itu... Kamu sungguh baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130110,
					"content": "Itu bukan pujian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "Bo-bolehkah aku menanyaimu sesuatu, pengembara? Aku pernah memintamu menyelidiki rahasia Tuan Albedo. Apa kamu sudah menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130112,
					"content": "Kalau tidak salah, satu minggu sudah berlalu sejak kamu meminta bantuan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Kukira kamu lupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "Apa...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130115,
					"content": "Su-sudah seminggu lebih? Aku jelas-jelas... AH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130116,
					"content": "Ugh, aku terlalu tenggelam dalam penelitianku dan melupakan masalah itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130117,
					"content": "Konsepmu akan waktu sebenarnya bagus atau tidak sih...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "Ja-jadi, apa kalian sudah menemukan jawabannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130119,
					"content": "Yah, bisa dibilang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Bagus sekali! Bisakah kamu memberitahuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130122,
					"content": "Bagaimana menurutmu, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Hmm... Sepertinya tidak apa-apa kalau kita memberi tahu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "Dia bisa melihatnya juga, tapi tidak boleh menyentuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Tunggu. Apa yang kalian bicarakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130126,
					"content": "Ini apa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130127,
					"content": "Ini adalah rahasia Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "Pedang ini sangat kuat. Jangan menyentuhnya dengan tangan kosong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Uh, ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130131,
					"content": "Ah! I-ini... Aku belum pernah melihatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130132,
					"content": "Hohoho, lihatlah sampai puas! Paimon tidak tahu kenapa tiba-tiba merasa bangga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Menakjubkan sekali! Ini adalah pertama kalinya aku melihat senjata semisterius ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130134,
					"content": "Samar-samar aku bisa merasakan kekuatan yang mengalir perlahan dalam pedang... Pedang ini seperti makhluk hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130135,
					"content": "Kamu bisa merasakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "Mungkin ini karena aku belajar alkimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130137,
					"content": "Aku tidak berani mengatakan apa-apa, tapi aku benar-benar merasakan suatu kekuatan yang \"mengalir\". Deskripsi ini bukan yang paling tepat... Bi-biasanya aku tidak mendefinisikan benda seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130138,
					"content": "Percayalah! Aku biasanya tidak menggunakan kalimat ambigu seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130139,
					"content": "Baiklah, baiklah. Kami mengerti kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "Pengembara, apakah kamu bisa menggunakan pedang ini dalam pertarungan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130141,
					"content": "Aku ingin mempelajarinya lebih rinci lagi, tetapi aku tidak bisa menggunakannya. Hanya kamu yang bisa membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130142,
					"content": "Tapi kita harus melakukannya secara diam-diam. Jangan biarkan Albedo mengetahuinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Ayo kita berkeliling untuk mencarinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Kita lebih baik mencari tempat yang lebih tersembunyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "Ini adalah jawaban yang kamu cari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Semua sudah kuselidiki dengan jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
