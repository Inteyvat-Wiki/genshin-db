				},
				{
					"id": 412130502,
					"content": "Ada apa? Kalian berkelahi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "Tu-tuan Albedo... Aku tidak sengaja...",
					"roleType": "TALK_ROLE_NPC",
