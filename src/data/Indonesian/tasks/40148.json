					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Uh ... makanannya sudah datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Oho, jadi ini Humbly Enough? Wah kalian tidak main-main ya! Porsinya betulan mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Ayo, bro, duduk sini. Kita semua di sini teman, jadi tidak usah sungkan! Yuk langsung santap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Ehem! Bos, kita harus menghargai budaya setempat. Di Liyue sini, tamu harus mencicipi lebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Sopan santun ya? Hm ... Shinobu, kupikir tradisi kuno bukan gayamu sama sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "Karena kerjaanku di dapur sudah selesai, sekarang aku jadi tamu juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Eh? Kamu bercanda ya, bro? Ehh tunggu, aku tahu. Makanan ini harum banget, jadi semua orang mau mencicipi duluan! Yah, salahku sih punya selera pilih makanan yang enak-enak. Ya sudah, ayo kalian cicipi, aku yang terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Kamu, Paimon, Ayato, dan Shinobu segera menyantapnya, dan \"daging\" di meja pun sudah berkurang banyak ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "Hmm, begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Akhirnya, giliran Tuan Besar tiba juga! Pastinya dagingnya paling besar juga nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Tunggu, jangan dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Hah? Kenapa lagi sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Ayo Paimon, kamu pasti bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Eh ... Oke jadi, Paimon lupa buat kasih tahu kamu asal muasal cerita dari hidangan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "Asal muasal cerita? Heh, siapa peduli soal itu — kita semua tahu hidangan ini bakal masuk ke perut kita juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Yah jadi ... Melewatkan asal muasal cerita itu seperti ... pergi bertualang tanpa pemandu! Percaya deh sama Paimon, kalau kamu dengar ceritanya dulu, rasa makanannya bakal jadi lebih nikmat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Paimon ada benarnya. Sama seperti setiap teh punya rasa yang berbeda, tidak ada salahnya untuk menerima niat baik sang koki dengan mendengar kisahnya dulu sebelum menyantapnya, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "Niat baik bro ya? Iya sih tidak boleh disia-siakan tuh ... Oke deh, coba ceritakan asal muasal-nya! Aku siap mendengar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "Nah gitu dong! Jadi dimulai dengan bahan-bahannya ... Eh tunggu, jangan, mending mulai dari asal muasal Wangshu Inn ... Jadi dimulai dari sejarah di Dihua Marsh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(Sekarang kesempatan kita, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Oke!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Sewaktu Itto sedang mendengar cerita, kamu dan Shinobu langsung menyantap makanannya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "Waduh, dongeng Dihua Marsh bikin terharu ya ... Orang-orang zaman dulu pasti hidupnya keras banget. Bikin kamu jadi menghargai apa yang kamu miliki sekarang. \"Humbly Enough\" ... pemikiran yang bagus soal hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Duh, enggak boleh sebut \"tahu\" pula .... Kenapa topik kita jadi melenceng gini sih? Ugh, untung cuma tinggal sisa sedikit lagi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Tapi kita sudah ... kekenyangan nih ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Aaah! Bro, Shinobu! Kalian selama ini makan terus ya?! Sisakan sedikit buatku dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "Sudahlah, aku tidak mau tunggu lagi! Kini giliranku buat makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Tunggu! Bos, itu terbuat dari—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Itto, tunggu dulu. Aku ... punya permintaan kecil. Mungkin kamu bisa mempertimbangkannya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Aku pergi dari rumah dengan sangat terburu-buru, jadi tidak sempat bawa keluargaku. Mereka sudah banyak dengar soal dirimu dan mereka pengagum berat Geng Arataki, jadi mereka pasti kecewa kalau dengar mereka sudah melewatkan kesempatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Namun ... kalau kamu mengizinkanku membawa sisa porsi dari Humbly Enough ini ke rumah, aku yakin mereka pasti sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Eh ... Hmm, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Bos, kamu tidak boleh perhitungan dengan teman. Di Liyue, itu penting banget ... Lagian, bukannya kamu sudah banyak makan ikan panggang tadi waktu lagi nunggu hidangan utamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "Termasuk punyaku dan Ayato juga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Hah? Jadi itu punya kalian?! Aduh ... aku terlalu kebawa suasana waktu cerita tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Ehem, kalau begitu ... Sampaikan salamku pada keluargamu, bro! Hei koki, bisa tidak ini dibungkus saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Kamu tahu kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Mungkin aku boleh cicipi duluan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
