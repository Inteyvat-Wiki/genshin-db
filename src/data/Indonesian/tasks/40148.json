			"dialogs": [
				{
					"id": 401489701,
					"content": "\"Pembelah Tanah\", \"Kumbangzilla\" ... Aku tidak tahu ternyata banyak kumbang hebat di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489702
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489702,
					"content": "Kamu tidak benar-benar datang cuma buat nonton kontes adu Onikabuto, kan ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489703
					]
				},
				{
					"id": 401489703,
					"content": "Heh, kamu tidak bisa bayangkan ya. Yah sebenarnya perjalanan ini separuh bisnis separuh liburan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489704
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489704,
					"content": "Terus kenapa tidak datang ke Lantern Rite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489705
					]
				},
				{
					"id": 401489705,
					"content": "Setiap pengunjung punya agendanya sendiri. Untuk beberapa orang, mereka datang untuk menonton festival, dan untuk beberapa orang lainnya lagi, justru untuk menghindari kerumunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489706
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489706,
					"content": "Dan entah bagaimana, aku sepertinya berada di tempat yang tepat di waktu yang tepat pula ... Dan untuk sisa tahunya ... Yah, aku yakin Thoma akan urus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayato"
				}
			]
		},
