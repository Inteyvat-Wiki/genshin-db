					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Sepertinya ... semuanya rusak? Tidak bisa bergerak! A-Aduh kaget aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "Hmph. Apaan ini cuma Iron Chunk yang sudah karatan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Vana saat ini berbahaya, kalau Paimon ceroboh bakal celaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Hm ... Arabalika tegas banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Paimon yang terlalu sembarangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Oh ya? Jadi kalau Paimon setegas Arabalika, apa Paimon juga bakal jadi sekuat dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Paimon harus tegas terhadap diri sendiri, bukan orang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Oke, mulai besok Paimon bakal tegas sama diri sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Oke, karena cabang batunya ada di sini, sekarang kita harus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Kita harus buat supaya tiga batu mengarah ke arah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "Di-Dia baru saja bilang apa yang Paimon mau bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Oh ya, gaya bicara Arabalika jauh berbeda dari Arapandu. Dia sama sekali enggak pakai metafora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Tapi lebih mudah untuk dimengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "Langsung ke intinya, jelas banget ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Karena Arapandu banyak berpikir, Arabalika sedikit berpikir. Aku hanya mengerti melindungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "Arapandu dan Nara Varuna melindungi Vana bersama, mereka mengusir tanah kotor bersama, menyembuhkan Varuna Contraption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "Nara Varuna telah lama meninggalkan Vana, mungkin dia juga tidak akan hadir ke Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "Arapandu pasti tahu. Entah telah berlalu berapa lama, waktu telah berlalu hingga benih tumbuh menjadi pohon tinggi, Nara yang meninggalkan Vana tidak akan pernah kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Tapi Arapandu ingin menyembuhkan Varuna Contraption sekali lagi, demi Vana, demi Festival Utsava, juga demi Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "Oh gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "Arabalika belum pernah bertemu Nara Varuna, tapi Vana tahu tentang masalah yang dihadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika enggak akan berpikir banyak seperti Arapandu. Dia hanya tahu, Arabalika harus jadi kuat, bisa melindungi Aranara, juga bisa melindungi Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Nara Varuna sudah enggak ada, Aranara juga masih bisa memperbaiki Varuna Contraption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "#Ehm! Lagi pula masih ada Paimon dan {NICKNAME} yang bakal bantuin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Bau besi di sini, sangat aneh. Nara {NICKNAME}, aku serahkan padamu. Aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "Enggak tahu apa yang dirasakan Arabalika ... tapi masalah hutan, Aranara pasti tahu lebih jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}, pokoknya, kita cari ketiga \"daun\" yang terpisah di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Jadi tidak seperti Aranara ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "Apa artinya \"seperti Aranara\"? Hm ... Paimon gagal paham deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
