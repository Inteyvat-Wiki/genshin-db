			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Fyuh ... kaget banget! Untung ada Arabalika yang bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Tuh kan sudah dibilang. Paimon bakal celaka kalau ceroboh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Ugh ... Iya deh Paimon minta maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Di dalam reruntuhan ada penjaga, dan pasti bisa bergerak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Benar juga, apakah ini yang dinamakan \"sesuai kenyataan\"? Karena bagi mereka, kita adalah orang luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} dan Paimon adalah orang luar bagi Vana, tapi tidak bagi Arabalika. Jadi, Big Iron Chunk ini yang enggak paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Kalau mereka enggak paham, Arabalika bakal bikin mereka paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Wow ... Paimon bakal jadi anak baik deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Paimon harus menepati janji ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Iya! Besok ... Eh tidak, mulai dari sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Batu di sini, hanya bisa dibangunkan oleh Aranara. Nara {NICKNAME} dan Paimon serahkan saja pada Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Ooooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Kita sudah selangkah lebih dekat buat betulin Varuna Contraption! Kalau Varuna Contraption sudah beres, jadi enggak akan ada spora lagi di Apam Woods ... Duh ngomongin itu bikin hidung Paimon jadi gatal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "Varuna Contraption akan memurnikan air hujan, enggak akan ada hujan hitam, jadi enggak akan ada banyak spora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Tapi jamurnya pasti masih ada. Paimon harus hati-hati, jangan sampai ditelan jamur seperti Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "Ehm ... Paimon bakal berhati-hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Di sini sudah enggak perlu Arabalika, aku akan kembali ke \"tempat istirahat\" untuk mencari Arapandu. Nara {NICKNAME} dan Paimon, apakah mau pulang bersama?",
