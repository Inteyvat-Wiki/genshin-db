			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Nara ... dan sesuatu yang bisa terbang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Benar, aku adalah Paimon yang bisa terbang, terus dia ini adalah {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Kamu pasti Arabalika, oh ya, kamu sama sekali enggak takut sama kami ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "Nara Emas punya aura Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "Ah, iya memang Arapandu yang mengirim kami ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Tidak merasakan ada niat jahat. Jika ingin menyerangku, seharusnya di saat Big Iron Chunk masih bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "Benar, ini yang disebut \"memukul Aranara saat mereka lengah\" ... Eh tunggu, kami enggak akan begitu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "Kenapa tidak? Jika aku adalah musuh, taktik terbaik adalah serang musuh dari kedua arah. Binatang juga melakukan itu waktu mereka berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "Hm ... Masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Paimon jadi bingung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "Pokoknya! Kami enggak akan \"memukul Aranara saat mereka lengah\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Karena Aranara adalah teman kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#Iya, benar! Karena Aranara adalah teman! Paimon dan {NICKNAME} enggak akan pukul teman sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Hm ... Kenapa dia rasanya enggak puas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "Paimon tidak memberikan kesan pertama yang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Tapi Paimon enggak merasa melakukan kesalahan ... Hm ... Emosi Aranara sulit dimengerti ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Oh ya, Arapandu pernah bilang, \"Ararakalari\" punya Arabalika hebat banget. Dia pasti pakai Ararakalari buat ngalahin Ruin Guard tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "Paimon tahu soal Ararakalari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "Oh! Ooh! Iya dong! Paimon tahu! Itu ... ya itu! Kekuatan ... yang kuat banget itu kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "Wah! Paimon merasa diremehkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Fokus ke masalahnya saja langsung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Hm ... kami datang buat bantuin memperbaiki Varuna Contraption! Seharusnya di sini juga ada cabang dan daun Varuna Contraption, kan? Kenapa enggak kelihatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "Apa itu cabang dan daun, lebih seperti akar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "Eh? Masa sih? Tapi Arapandu bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "Dengan \"sistem akar\" yang menyelimuti Vana, Varuna Contraption mendapatkan kekuatan dari Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Oh ... Masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Lagi pula, akar ada di bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "Batu dan Iron Chunk di sini bukan milik Aranara. Untuk turun, harus mengalahkan Iron Chunk terlebih dulu. Mereka kuat, tapi Nara Emas juga tidak lemah, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#Tentu saja, {NICKNAME} sudah mengalahkan banyak Big Iron Chunk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "Oh? Kalau begitu coba Arabalika lihat kemampuan Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "Eh?! Dia kenapa masuk ke dalam tanah ... Ah! Jangan-jangan sudah pergi ke tempat Ruin Guard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, ayo cepat ikuti dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "Mungkin saja dia seperti itu terhadap siapa saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Kok gitu sih? Mereka imut, tapi temperamennya jelek ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Kita telah mengalahkan Big Iron Chunk. Ikuti airnya dan kita bisa ke bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Sudah lama tidak ke sini, semuanya sudah berubah, mungkin masih ada Big Iron Chunk di bawah tanah. Aku bisa mencium ada aroma besi. Aromanya tidak enak sekali, hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Nara {NICKNAME} kuat, jadi tidak perlu khawatir. Tapi Paimon, sama lemahnya dengan Aranakula, jadi hati-hati ditelan oleh jamur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Hm ... Arabalika terlalu kuat! Kita sudah bertemu banyak Aranara sebelumnya, tapi kayaknya enggak ada yang bisa mengalahkan Ruin Guard dengan satu pukulan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon tidak tahu banyak tentang Aranara. Kalau Aradasha sih, pasti bisa membereskan Big Iron Chunk dalam sekejap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "Ararakalari-nya Aradasha sangat kuat waktu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "Dulu? Kalau sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Sekarang, Aradasha tidak di masa sekarang. Itu alasannya Arabalika harus melatih Ararakalari lebih keras lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Jika saja aku juga bisa mempelajari \"Ararakalari\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Kalau begitu, biar Paimon yang maju saja pertempuran berikutnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Hehe, jadi Paimon yang bakal lindungi {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "Paimon, semangat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Serahkan sama Paimon! Serahkan semuanya sama Paimon saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon suka bermimpi. Entah itu hal baik atau buruk. Tapi kita sekarang harus menemukan mekanisme batunya, agar airnya bisa mengalir. Kalau tidak, kita tidak akan bisa ke bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranara bisa masuk ke tanah, tapi tidak bisa masuk ke air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Oke, {NICKNAME}, ayo kita cari di sekitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "Paimon pasti tidak sanggup belajar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Asal Paimon niat, pasti bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "Banyak sih orang yang ngomong kayak gitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Apa Paimon minta Arabalika ajarin aja ya? Nanti habis kita selesai makan dan istirahat di tempat yang tenang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
