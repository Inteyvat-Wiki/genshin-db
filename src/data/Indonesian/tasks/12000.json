					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "Wanwen Bookhouse... di sini tempat untuk membeli buku di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "Apa sebaiknya kita tanya, mungkin mereka punya Panduan Wisata Teyvat edisi Liyue? Buku itu menarik sekali loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "Ah, silakan melihat-lihat saja dulu, tidak beli juga tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "Kami mencari Panduan Wisata Teyvat edisi Liyue. Apa kalian punya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Oh maaf, tapi sudah lama kami tidak menjual buku itu lagi, karena tidak begitu populer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "Eh?! Padahal edisi Mondstadt begitu populer... sayang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "Karena penulisnya membuat buku itu dengan memasukkan banyak hal yang terlalu pribadi, sehingga tidak terlalu banyak panduan di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "Menjual buku itu sangat sulit, dan beberapa pengembara yang membelinya selalu mengeluh padaku setelah membelinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "Terlalu banyak unsur yang bersifat pribadi di dalamnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "Wah sayang sekali, padahal edisi Mondstadt sungguh menarik walaupun hanya berupa buku harian seorang petualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "Bagaimanapun juga aku tetap tidak mempunyai buku itu lagi sekarang. Kalau kamu masih ingin mencarinya, kamu bisa coba pergi ke tempat Chang the Ninth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "Chang the Ninth itu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "Dia seorang kolektor buku yang tinggal di Desa Qingce. Walaupun temperamennya buruk, tapi dia sangat antusias kalau bicara soal buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "Waktu dia masih tinggal di Pelabuhan Liyue, dia adalah pelanggan tetapku. Sampai sekarang aku terkadang masih mengirimnya beberapa buku menarik yang sudah tidak dicetak lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "Tempat tinggalnya sulit untuk dijangkau. Kamu harus pergi ke gunung di belakang Desa Qingce, lalu ikuti jalan kayu setapak sampai ke atas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "Kamu tadi bilang, buku yang sudah tidak dicetak lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000315,
					"content": "Apakah volume enam dari \"Legenda Tombak Dewa\" juga ada dalam koleksinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000316,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Ah maafkan ketidaksopananku, namaku Xingqiu, seorang pecinta literatur yang kebetulan lewat di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000319,
					"content": "Kita berdua sama-sama sedang mencari buku yang hilang, bagaimana kalau kita sama-sama pergi ke Mt. Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000320,
					"content": "Masuk akal, kalau begitu tunjukkan saja jalannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "Sebagai sesama pecinta buku, sudah seharusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000322,
					"content": "Sebenarnya aku tidak ingin berjalan sejauh itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Anggap saja kesempatan untuk beristirahat dari keramaian dan kepenatan di Pelabuhan Liyue. Sekali-sekali semua orang butuh relaksasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000317,
					"content": "Kamu tiba-tiba muncul begitu, mengagetkan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "Apakah ada konten yang menyinggung di dalamnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "Ah... langit ingin menghukumku... langit ingin... menghukumku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000502,
					"content": "Permisi, apa kamu Chang the Ninth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Eh, ada perlu apa? Ayo cepat katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000504,
					"content": "Kami dengar kamu mempunyai banyak buku lama di sini, kami ingin meminjam Panduan Wisata Teyvat edisi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "Huh, jangan berbicara tentang buku denganku, menyebalkan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000506,
					"content": "Setelah Chasm ditutup, bisnis pertambangan keluargaku mulai merosot. Lalu Fatui datang untuk mengambil alih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000507,
					"content": "Untuk membayar utang-utangku, aku terpaksa menjual semua koleksi buku milikku...! Apa kamu tahu apa artinya ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000508,
					"content": "...kamu sedih karena tidak bisa membaca buku lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Salah! Buku-buku itu adalah karya hidupku! Aku mendedikasikan hidupku untuk mengumpulkan, menjaga dan merawat buku-buku itu! Sekarang mereka hilang begitu saja!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000511,
					"content": "Ah... sudahlah, percuma saja aku mengomel dan mengeluh padamu seperti ini. Lebih baik aku cepat-cepat menabung Mora untuk membeli mereka kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000512,
					"content": "Jika kamu tidak ada urusan lain, aku juga tidak ingin berbincang lebih lama lagi. Pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000513,
					"content": "Apa kamu juga menjual volume enam dari Legenda Tombak Dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000514,
					"content": "Oh? Tidak kusangka aku akan mendengar nama ini lagi... seleramu bagus juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000515,
					"content": "Jadi maksudmu selera kami tidak bagus?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "Buku itu adalah maha karya pada zamannya, ketika pertama kali dirilis orang-orang meragukan buku tersebut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000517,
					"content": "Tapi buku itu akhirnya berhasil mengubah kesan orang-orang mengenai novel bela diri. Sampai akhirnya banyak orang mengikuti jejaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000518,
					"content": "Versi edisi pertamanya hanya dicetak sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000519,
					"content": "Edisi selanjutnya terdapat volume enam untuk melengkapi cerita aslinya, namun entah mengapa tidak dicetak kembali walau telah dirilis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000520,
					"content": "Betul, ya benar begitu! Karena jumlahnya sangat sedikit, tidak peduli berapa banyak uang yang kubutuhkan, aku tidak akan pernah menjualnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000521,
					"content": "Ja-jadi maksudmu, buku itu masih di tanganmu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000522,
					"content": "Iya, itu adalah satu-satunya hartaku yang tersisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000523,
					"content": "Oi! Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "Berani sekali kamu membuatku dan bos menunggu. Aku perlu jawaban! Kamu ingin menjual Cor Lapis itu tidak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "Jika kamu macam-macam dengan Gentry Maocai, artinya kamu macam-macam dengan orang Fatui, kamu seharusnya sudah mengerti tentang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "Ah, kamu lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000527,
					"content": "Tapi aku tidak bisa memberimu diskon 70% dari harga awal... Jika begitu, aku tidak akan pernah bisa membeli koleksi buku milikku lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000528,
					"content": "Bukan urusanku, kamu ingin membaca buku atau ingin makan? Atau kamu ingin dikubur bersama dengan koleksi bukumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "Ugh... kamu... ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000530,
					"content": "Eh jangan bicara begitu, saudara sekalian, tenanglah. Keputusan ada padanya jika dia ingin menjualnya atau tidak. Kamu tidak boleh memaksanya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000531,
					"content": "Kamu pikir kamu siapa? Minggir, ini bukan urusanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "Aku tidak bisa berdiam diri saat melihat orang yang membutuhkan, aku murid dari Klan Guhua, namaku Xingqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000533,
					"content": "A-hahahahahahaha...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "Klan Guhua, dia bilang Klan Guhua! Hahaha! Apa kalian dengar? Pada zaman sekarang masih ada orang yang menyebut Klan Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "Bukannya petinggi Guhua yang terakhir sudah gugur sekarang ini? Jadi kamu ini siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "Keadilan dan identitas diri tidak ada hubungannya, kamu bukankah hanya seorang pekerja yang tidak lebih hebat daripada tuanmu, tapi sama-sama bersalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000537,
					"content": "Ka-kamu! Baiklah, tunggu aku! Lihat saja, aku pasti akan membereskanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "Lalu kamu, Chang! Kamu harus menjual Cor Lapis itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "Ah... seekor anjing memangsa harimau yang terluka. Entah berapa hari lagi aku bisa bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000540,
					"content": "Ayo kita kembali ke topik pembicaraan tadi, jadi bisakah aku meminjam buku itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000541,
					"content": "Kamu juga terlalu cuek pada kondisi orang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Sudahlah, aku juga tidak mengharapkan orang lain peduli padaku. Melihatmu tadi membantuku bicara, jadi ambillah buku ini lalu pergilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000544,
					"content": "Sungguh terima kasih banyak! Aku menunggu buku ini selama 3 tahun. Aku, Xingqiu, pasti akan membalas budi baikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000545,
					"content": "Baiklah, jangan lupa untuk kembalikan setelah selesai. Aku juga tidak mengharapkan apa-apa dari orang yang mengaku sebagai murid Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000546,
					"content": "Hei! Kamu mau pergi begitu saja? Masih banyak hal yang belum jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "Lebih baik kita lihat dulu suasananya saat ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "...kamu sedih karena tidak punya buku untuk dibaca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
