						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Benar, tapi menggunakan Vision memberiku keuntungan yang tidak adil dalam melawan musuh, sehingga aku tidak begitu suka menggunakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001008,
					"content": "Mereka sekarang sudah pergi, tapi mereka pasti akan segera kembali lagi untuk membuat masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "Aku mengerti, aku tidak akan membiarkan sesuatu terjadi kepada orang yang sudah baik padaku, aku akan bertanggung jawab atas hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001010,
					"content": "Orang Fatui biasanya tidak ikut campur dalam bisnis. Tapi melihat sikap sombong orang tadi, sepertinya benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001011,
					"content": "Sepertinya ada persekongkolan yang cukup serius dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001012,
					"content": "Tadi dia menyebutkan Gentry Maocai. Aku kenal nama ini... Dia tinggal di Pelabuhan Liyue, bisakah kalian berdua pergi dan memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001013,
					"content": "Boleh saja... lalu apa yang mau kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "Aku? Aku ada urusan lain yang harus dilakukan, hmm... Ayo kita bertemu di Yujing Terrace di Pelabuhan Liyue nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001015,
					"content": "Kamu benar-benar ada urusan atau cuma mau memperalat kami untuk memeriksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Oh, jadi ternyata begitu, paragraf ini... benar-benar menakjubkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001017,
					"content": "ARRGHHH!!! Paimon jadi kesal! Paimon jadi ingin menamparnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "Ayo kita tolong Chang the Ninth terlebih dahulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Huh, baiklah! Tapi Paimon akan memberikan nama julukan yang jelek buat dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "Mulai sekarang panggil dia \"kutu buku\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "Bantuan darinya, cepat atau lambat pasti akan datang.",
