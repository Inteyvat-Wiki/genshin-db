				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "Jadi kamu berdiri di sini hanya untuk membaca buku seni bela diri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Menarik sekali, sungguh menarik, aku tak pernah menyangka ternyata begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000603,
					"content": "Hei, dengarkan aku bicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "Jadi begitu, tidak heran buku ini begitu banyak dicari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000608,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "Orang sombong yang datang tadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "Benar, tega sekali mereka memaksa Chang the Ninth menjual Cor Lapis dengan harga semurah itu! Itu sama saja dengan merampok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "Kita harus mencari cara untuk membantu Chang the Ninth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Hei jangan lupakan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Oh jadi sekarang kamu bisa mendengarkan kami ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "Alasan sebenarnya aku meminjam buku ini adalah, kupikir akan sangat disayangkan jika Chang the Ninth terpaksa harus menjual buku ini juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "Dan mengenai yang kukatakan pada Chang the Ninth, aku serius. Aku akan membalas budi baiknya, ini adalah hal yang seharusnya dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "Aku akan menjaga buku ini, dan aku juga akan membantu mencari cara untuk membeli kembali koleksi buku miliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000617,
					"content": "Kamu sudah memikirkan caranya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Tentu saja aku punya rencana, aku sudah punya petunjuk, sekarang hanya tinggal memikirkannya dengan terperinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000620,
					"content": "Baiklah, berikan aku waktu, seharusnya ini tidak akan lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000621,
					"content": "Eh kenapa kamu masih di sini, apa kamu pikir aku hanya menggertakmu tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Huh, Klan Goofball tidak punya nyali, tidak punya keberanian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "Oh, maaf, maksudku Klan Guhua! Klan Guhua, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "Ada pepatah mengatakan, \"Serangga yang mencoba menggoyang pohon besar terlalu menyombongkan kemampuannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000625,
					"content": "Ah? Kamu bicara pepatah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Tolong pergilah, aku tidak bisa menoleransi perdagangan yang tidak jujur ini, terutama jika orang yang kamu paksa adalah Chang the Ninth yang sudah begitu baik padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "Hei Nak, sepertinya kamu juga ingin membantu Chang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "Kamu memilih waktu yang salah Nak, lihat, hari ini aku membawa orang-orang Fatui untuk membantuku. Temanmu yang dari Guhua itu tidak bisa membantumu sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Aku mungkin masih muda, tapi jalan yang kupilih membuatku tidak asing lagi dengan perselisihan. Kenapa aku harus takut menghadapi kejahatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Inilah waktunya aku memberimu pelajaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "Kamu sepertinya tidak punya rencana apa-apa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "Sepertinya misi mencari Panduan Wisata Liyue masih belum selesai ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Kalian mengapa mudah sekali menyerah dalam mencari buku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000606,
					"content": "Orang sombong tadi sepertinya bekerja untuk Gentry Maocai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
