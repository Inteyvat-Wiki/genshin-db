			"dialogs": [
				{
					"id": 747020101,
					"content": "Oh, akhir-akhir ini kamu bawa banyak ikan. Akuariumnya sekarang sudah kayak habitat laut sungguhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020102,
					"content": "Hehe, kita sudah kayak penangkap ikan profesional aja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "Kalian sepertinya bangga sekali dengan pencapaian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020104,
					"content": "Tentu dong! Tapi di balik semua ini, ada yang lain ... kayak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Penyesalan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Nah, itu dia! Paimon ngerasa begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Kenapa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020109,
					"content": "Paimon enggak yakin ... Kayaknya ada yang kurang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Mungkin restoran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Hei! Jangan begitu dong! Mana tega Paimon makan ikan secantik ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Kita cuma kekurangan pengunjung yang datang dan ngagumin hasil karya keren kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Maksudnya ... kalian ingin buka akuarium supaya bisa dikunjungi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020116,
					"content": "Emang enggak boleh ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Kalian tidak khawatir bakal terlalu berisik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Kalau begitu, serahkan saja sama kami! Kami yang bakal ngurus iklan dan pekerjaan hariannya, kamu tinggal fokus sama pekerjaanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Kalau memang begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020121,
					"content": "Kita bisa bagi keuntungannya 30/70!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Hah ...? Kami cuma dapat 70%?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "Bukan, Sandrone yang dapat 70%.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Oh, benar juga ... Sandrone yang sewa kapal ini, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Aduh, kalian buat aku kayak pemilik tanah yang kejam saja. Kan kalian yang kerja keras, harusnya kalian yang dapat bagian terbesar. Aku tidak pelit seperti Pantalone kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020126,
					"content": "Jadi maksudnya ... kamu setuju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Tentu, aku setuju. Tapi pastikan agar tidak mengganggu risetku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020128,
					"content": "Yuhuuu! Akuarium Bawah Laut Gulup-Gulup Wingalet sudah dibuka untuk umum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*huff* Tentu saja kamu sudah pikirin namanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020118,
					"content": "Kalian tidak khawatir bakal ada banyak masalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Mungkin tamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Nah! Itu dia!",
