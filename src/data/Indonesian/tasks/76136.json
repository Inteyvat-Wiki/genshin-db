			"dialogs": [
				{
					"id": 761360301,
					"content": "(Mungkin <color=#FFCC33FF>Jahoda</color> ingin periksa kotaknya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Hehe ... mari kita hitung berapa uang yang aku dapatkan belakangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "Waktu itu Bos bilang mau kasih bonus, bagaimana kalau sekarang aku—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Kok tidak ada uangnya? Cuma selembar kertas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "\"Jahoda tersayang, tutup kotak ini baik-baik. Bonusmu tidak akan keluar dari sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "*huff* Bos lagi nakut-nakutin aja, pasti ada ruang rahasia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "Tidak ada ruang rahasia, bonus kamu ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Oh, makasih boskuh~ aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "HUWAAAAAA— B-B-B-Bos, aku cuma lagi hitung uang sebentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "Sekarang aku kerja kok, sekarang juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Berhenti dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Siap, Bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Kunci kotaknya baik-baik dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
