			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon. Kalian juga datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "Kami juga mau tengok dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Kalau dia tahu kalian datang ... yah, tidak akan ngomong sih, tapi dia pasti senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Kamu cukup lama berdiri bersama Illuga di depan makam ....\\nIlluga bicara dengan rekan-rekan yang telah gugur, tentang peristiwa-peristiwa, baik kecil mau pun besar, yang terjadi baru-baru ini di Piramida ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Dia pasti bisa tenang setelah dikasih tahu kalau semua orang di Piramida aman sehat sentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Iya. Misinya sudah selesai. Dan kita, kita masih harus melanjutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "Setelah kita selesai pun, generasi penerus akan melanjutkan. Seperti Winter Icelea yang hidup diterpa badai dan dingin, tapi masih tetap dapat tumbuh kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
