						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Yah, itu memang masalah lama yang lumayan merepotkan. Syukurlah sudah beres sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461002,
					"content": "Ternyata enak juga rasanya sesekali berbuat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461003,
					"content": "Kamu juga banyak bantu orang-orang Nod-Krai! Rasanya kamu sebenarnya memang orang baik, deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Heh, belum tentu. Aku sebentar lagi akan balik ke Fatui. Kadang kalian terlalu polos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461005,
					"content": "Yah, setidaknya kami tahu kamu bisa dipercaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hmph, terserah. Tapi nanti kalau sampai kena akibatnya, jangan bilang aku tidak pernah peringatkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461007,
					"content": "Nah, selanjutnya ke mana? Balik ke kapal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Iya! Urusan pribadimu soal masalah Narzissenkreuz sudah beres semua, artinya sekarang kamu bisa \"temui orang yang memang perlu ditemui\", kan, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Semuanya pasti bakal senang banget lihat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Heh ... kalau dulu, aku sih tidak pernah mau akui ini, tapi ... Iya, aku benar-benar rindu semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461011,
					"content": "Tapi Columbina lain cerita! Kali ini aku akan balas semua ulah menyebalkannya selama ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024611,
