					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "Be-Beres nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Yep. Kan sudah kubilang, gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460903,
					"content": "Barusan kamu ... bagaimana caranya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Makhluk itu tidak ada istimewanya. Campurkan jiwa-jiwa tersesat, sedikit energi jahat, beberapa kekotoran, dan segunung kebencian ... hasilnya ya seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460905,
					"content": "Aku cuma memisahkan jiwa-jiwa asli dari sisa kekotoran, jadi mereka bisa diterima oleh aturan dunia saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460906,
					"content": "Prinsip di balik formula dunia adalah \"divergensi\". Dengan memulai dari satu titik asal, ia mengurai dan menyusun kembali berbagai kemungkinan dunia untuk menemukan jawaban tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460907,
					"content": "Dengan kata lain, jika formula dunia-nya dihitung secara terbalik, kita jadi bisa menciptakan fungsi konvergensi dan restorasi. Aku bisa melakukannya dengan bantuan larik numerologi-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460908,
					"content": "Konsepnya mirip dengan reduksi homologis dalam matematika. Aku mereduksi mereka ke bentuk paling mendasar dari keberadaan mereka tanpa mengubah sifat dasarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460909,
					"content": "Artinya ... Ah, lupakan saja. Dari tatapan kosong kalian, kurasa kalian juga tidak tertarik mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460910,
					"content": "Sepertinya aku akhirnya paham perasaan orang luar saat aku mengoceh soal urusan shaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "I-Intinya, tadi keren banget! Sandrone memang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Heh, baru sadar sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460913,
					"content": "Seperti yang diharapkan dari Pengurai Segala Logika ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Ehem, cukup soal itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460915,
					"content": "Ki-Kita harus pergi sekarang! Aku akan atur ulang mekanisme di dalam menara. Kita bertemu lagi di darat nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024610,
