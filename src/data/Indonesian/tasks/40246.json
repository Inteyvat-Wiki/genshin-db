			"dialogs": [
				{
					"id": 402461101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402461102,
					"content": "Um, Sandrone ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402461103,
					"content": "Jangan rusak suasananya. Kalau tidak nanti aku teringat waktu kamu tiba-tiba pindah aku ke antah berantah, padahal aku sudah jelas-jelas minta kamu berhenti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461104,
					"content": "U-Um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402461105,
					"content": "Daaan ... cut! Bravo! Bravo! Kita dapat adegan yang sempurna! Ini persis akhir yang aku mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Produser Film"
				},
				{
					"id": 402461106,
					"content": "... Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461107,
					"content": "Tadi kamu ke mana, Nona Columbina? Tiba-tiba saja menghilang, lalu tahu-tahu sudah kembali sambil meluk ... teman baru ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "Se-Semua tadi ... terekam di ... Kamera ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461109,
					"content": "Kameranya memang sudah nyala dari tadi, dan kejadiannya begitu cepat, jadi ... iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Tunggu, ini pasti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Iya, sahabat baikku. Orang yang selama ini kucari. Aku tidak pernah menyangka bisa bertemu dengannya lagi. Aku ... senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402461112,
					"content": "Dan filmnya juga berakhir bahagia. Semua ini berkat kamu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402461113,
					"content": "... Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
