				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali semalam minum banyak banget ... Kira-kira sudah bangun belum, ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Pagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460203,
					"content": "Waah! Co-Columbina! Kamu, eh, bikin kaget ... Lagi ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Kami baru selesai syuting adegan dadakan, jadi aku ke sini untuk cari angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460205,
					"content": "Yang lain masih di bawah, lagi diskusi adegan terakhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460206,
					"content": "Maksudnya, akhir ceritanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Iya. Mereka bimbang apa tokoh utamanya perlu bertemu lagi dengan sahabat lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460208,
					"content": "Ah ... Soalnya inti ceritanya memang dia datang ke kampung halaman sahabatnya untuk cari dia, kan? Paimon sampai hampir lupa alurnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Iya. Sutradara Furina dan Nona Chiori merasa akhir yang tragis di mana keduanya tidak pernah bertemu akan lebih mengharukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460210,
					"content": "Tapi Sutradara Xavier merasa kalau keduanya bertemu kembali akan terasa lebih hangat dan menyentuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460211,
					"content": "Menurutmu bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Aku? Aku ... kurang yakin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460213,
					"content": "Secara pribadi, tentu aku ingin melihatnya lagi ... ingin merasakan momen saat bertemu kembali ... meski hanya terjadi dalam film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460214,
					"content": "Tapi berarti ... seseorang harus gantikan dia, dan itu membuatku merasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460215,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Jangan pikirkan yang itu dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460218,
					"content": "Iya! Jangan murung begitu! Syuting film kan harusnya seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "La-Lagian, semuanya bakal lancar kok! Percaya sama Paimon deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Lancar ... bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460221,
					"content": "Uh, ya ... Yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Semuanya bakal berakhir bahagia. Lihat saja nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Heh ... Oke. Aku percaya kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460225,
					"content": "Aku akan menikmati prosesnya untuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460226,
					"content": "#Wah, ada {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "Ah, teknisi pencahayaan dan asisten kameramen yang bolos kerja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Eh, iya ... Kami tadi kabur bentar. Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Hehe, serius, jangan khawatir soal itu. Semuanya berjalan lancar di sini, jadi fokus saja dengan urusan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Terima kasih sudah mengerti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Kelihatannya suasana hatimu sudah lebih baik sekarang, Nona Columbina. Maaf kalau pembicaraan kami tadi membuatmu tidak nyaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Tidak apa-apa, aku baik-baik saja sekarang. {NICKNAME} dan Paimon sudah temani aku bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460234,
					"content": "Jadi, menurut kalian akhirnya lebih bagus kalau mereka dipertemukan kembali ... atau tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Kita harus ... tutup semuanya dengan akhir yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 402460236,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Kami pasti akan menebusnya nanti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
