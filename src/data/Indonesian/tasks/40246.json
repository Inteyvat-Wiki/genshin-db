			"dialogs": [
				{
					"id": 402460501,
					"content": "Hmm, sejauh ini belum ada tanda-tandanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460502,
					"content": "Apa aku mulai ritual pemanggilannya sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Keluarkan dulu air dari lantai menara ini supaya lebih mudah gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460504,
					"content": "Eh, bisa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Tentu saja. Alain dan Rene sama-sama melihat masa depan yang menanti Fontaine, bahkan sempat membagikan beberapa metode untuk membuat bangunan tahan air. Prinsip dasarnya adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460506,
					"content": "... Ehem, itu tidak penting. Buka saja mekanismenya sesuai urutan yang kubilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
