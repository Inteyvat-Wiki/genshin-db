			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "Sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Iya. Saat benda ini muncul, aku akan coba bicara dengan jiwa-jiwa di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460703,
					"content": "Tapi, kemungkinan besar mereka sudah tidak waras kali. Kalau komunikasi gagal, kita harus siap bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460704,
					"content": "Kalau begitu, Paimon cari tempat ngumpet dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Kalau memang sampai harus bertarung, aku yang akan mengakhirinya. Percayalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460706,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Baiklah, semuanya diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "... Jiwa-jiwa pengembara yang terhanyut bersama arus, dengarkan panggilanku. Jiwa-jiwa yang hancur, dibungkam, tercabik, dan ditinggalkan ... ikutilah jejak masa lalu dan kembalilah kepada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "... Biarkan dendam mengenali dendam. Biarkan makhluk-makhluk hina berkumpul lagi, dan di tempat ini ... berwujudlah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(... Sekarang apa? Sudah beres?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460713,
					"content": "(Ugh ... Makanya aku lebih suka matematika daripada sihir. Dari mana bisa tahu proses mantranya sudah sampai tahap apa? Rasanya sama sekali tidak ada logikanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460714,
					"content": "(Ilmu mekanik jauh lebih gampang di-)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460716,
					"content": "Awas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Wandering Souls' Resentment"
				},
				{
					"id": 402460718,
					"content": "Hei, kamu! Atau siapa pun yang di dalam sana ... Dengarkan aku baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460719,
					"content": "Aku adalah keturunan \"Lord-Artificer\" Fontaine, Alain Guillotin. Aku bisa bantu kalian kembali utuh dan mengembalikan kalian ke Ley Line. Kalian cuma perlu kerja sama denganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Wandering Souls' Resentment"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Ck ... Sepertinya mereka memang tidak bisa diajak bicara lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460723,
					"content": "Oke, rencana B ... saatnya melepas stres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
