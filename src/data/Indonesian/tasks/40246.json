			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, kami sudah di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Ah, ya ... Bukan kami yang minum-minum sampai hampir tumbang kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Heh, apa? Kalian meragukan kemampuan minum nenek ini? Porsi begitu masih jauh dari cukup untuk bikin aku mabuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Masa sih? Soalnya ... lama-lama omonganmu makin enggak nyambung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "O-Oh ya? Hah, aku tidak sadar. Semoga aku tidak ngomong yang ... aneh-aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Hmm ... Kamu ngomel soal Ororon setengah jam, ngeluh soal kerjaan setengah jam, bahas soal novel ringan satu jam penuh ... terus, eh, habis itu Paimon ketiduran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "... Mereka sudah pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461209,
					"content": "Hm? Oh, para kru? Iya, tadi kami sempat ketemu mereka di dek, tapi mereka sudah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Tunggu, sekarang semua urusanmu sudah beres, kan? Terus kenapa masih belum ketemu Columbina? Dia rindu kamu banget, loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Aku ... aku cuma mau bereskan semuanya dulu. Lagi pula, ini kesempatan langka untuk buat dia kaget. Aku harus rencanakan dengan matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461212,
					"content": "Tapi, cukup soal itu. Apa kamu berhasil menemukan lokasi target kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461213,
					"content": "Tentu saja. Kalau Nenek Itztli sudah janji, pasti ditepati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Bagus, coba kita lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461215,
					"content": "Morte Region ... Tunggu, ini Menara Gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461216,
					"content": "Tempat jiwa-jiwa dipisahkan ... Apa itu sumber kebencian ini? Atau Narzissenkreuz secara keseluruhan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461217,
					"content": "Aku ikut. Pergerakannya berubah-ubah, jadi kalau nanti ternyata tidak ada di lokasi, aku bisa memanggilnya dengan ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Aku sudah terlalu banyak merepotkanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461219,
					"content": "Aku tidak keberatan. Lagi pula aku juga tidak punya kegiatan lain. Ritual pemanggilan roh tidak akan bikin aku kenapa-kenapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Dan kalau aku tidak ikut, nanti mereka malah punya bahan bercanda sendiri lagi tanpa aku!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Baiklah kalau begitu. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461222,
					"content": "Hehe, jangan nunda lagi. Ayo berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
