			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "Aneh ... Harusnya ada di sekitar sini. Kenapa tidak ketemu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "Kamu lagi cari apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "Kamu itu ... hmm, kamu pasti seorang Pengembara. Aku pernah mendengar tentangmu dari warga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "Namaku Javi, aku ini ... adalah seorang pedagang biasa. Saat ini, aku sedang mencari \"Peti Impian\" yang pernah aku kubur sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "Mengapa nama peti itu terdengar aneh ... memang apa isi dari peti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Hm ... kalau harus dijelaskan, semua ini adalah harapanku saat masa kecil, yaitu \"mewujudkan impian\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Kenapa harus seperti melakukan hal seperti itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Hahaha, semua ini adalah permainan yang aku dan teman-temanku buat di masa muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "Menulis semua impian kita saat itu, dan kuburkan di sini. Kelak, bersama-sama membuka \"Peti Impian\" tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "Saat ini juga, merupakan waktu membuka peti yang pernah kami tentukan. Sayangnya, sepertinya hanya aku yang ingat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "Hm, tidak apa-apa sih untuk melupakan janji ini ... aku harap, mereka semua tidak melupakan impian itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "Intinya, aku ingin menggali peti milikku. Aku ingin mengenang masa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "Sayangnya, aku sudah berusaha mencari di sekitar, dan tidak dapat menemukannya. Apakah telah digali oleh orang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Apakah kamu dulu memberi tanda di sekitar tempat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Aku sedikit ingat kalau dulu aku mengubur peti itu di dekat pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "Sebuah pohon? Di sini banyak tumbuh pohon loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "Saat masih kecil, kami tidak begitu memperhatikan hal itu. Aku ingat, kami hanya memberikan goresan kecil di permukaan tanah saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "Sayangnya, waktu berlalu, dan tanda itu pun lenyap. Aku juga tidak tahu dikubur di samping pohon yang mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "Hm ... ada ingatan sedikit yang membuat aku merasa aku mengubur peti itu di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "Pengembara, bantulah aku mencarinya, bolehkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "Bagaimana cara mencarinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "Aku ingat, peti itu aku kubur dekat pohon. Cobalah untuk menggali di sekitar pohon-pohon itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "Aku mohon padamu, Pengembara. Aku akan memberikan imbalan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Kamu lihat saja, hutan ini begitu besar. Bagaimana cara aku bisa menemukannya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "Baiklah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Hehe, terima kasih ya. Kita memencar saja untuk mencarinya, kamu ke sana, dan aku ke arah lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "Lagi pula, impian itu telah terbang jauh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Maka itu, impianku sudah pergi ... menemukan peti ini akan membuatku tahu, impian apa yang harus aku capai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "Aku mohon, Pengembara. Bantulah aku ini, aku pasti akan memberimu imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "Impian itu telah terbang pergi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Hahaha ... rasanya aku cukup setuju, bahkan aku lupa apa yang aku tulis di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "Lagi pula, impian mungkin bisa saja terbang pergi, tetapi peti itu bagaimana bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
