			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "Apa ini ... untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Peti ini aku kubur sembarangan, dan kertas di dalamnya juga aku tulis asal. Paman tidak perlu merasa bersalah karena membaca impianku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Lagi pula, aku tidak butuh pot bunga ini, jadi ambil saja ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "Aku juga sudah meminta tolong pada seseorang untuk membawakan bibitnya, harusnya sebentar lagi mereka datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Bibit telah datang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "Hah? Kamu kapan datangnya? Kok aku tidak sadar sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Hmm ... Ami, kamu mau jadi tukang kebun, kan? Kamu harus mulai dari menanam benih ini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Terima kasih ... Tapi kalau aku tanam di sebelah toko ayahku, nanti bakal ada serangga yang masuk ke panci ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Kan kasihan nanti serangga yang jatuh ke panci, apa lagi nanti jadi ada serangga di makanan orang-orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Tapi kalau aku pindahkan bunganya lebih jauh, nanti aku lupa. Kasihan juga kan bunganya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Lagi pula, ayahku selalu sibuk, dan dia tidak pernah membiarkan aku pergi terlalu jauh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Hmm ... Kalau kamu mau kita bisa rawat sama-sama. Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Walaupun aku cuma bisa berkunjung sehabis kerja, tapi aku ada waktu luang sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Boleh juga! Tapi ayah mungkin tidak setuju ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Aku itu berteman dengan Tuan Jahangir, papamu itu. Dia harusnya setuju kalau kita bicara padanya bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "Oke! A-Aku mau tanam beberapa bunga deh! Favoritku sih Sumeru Rose! Suatu hari nanti ... Toko ayahku pasti akan dikelilingi sama banyak Sumeru Rose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Bagus, itu impian yang bagus, Nak. Ayo berjuang sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Jangan lupa kasih aku bunganya satu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "Iya! Terima kasih, Kakak! Coba kupikir lagi ... aku mau tanam Sweet Flower juga, terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "Sepertinya anak ini benar-benar suka bunga ya. Semoga dia terus berpegang teguh pada impiannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Hehe ... Semoga dia tidak jadi sepertiku, orang dewasa yang biasa saja dan membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "*uhuk* Pengembara, terima kasih telah membantuku. Ambillah imbalan ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Bisa menjalani hidup dengan sepenuh hati itu luar biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Terima kasih ya! Aku juga tidak akan mengeluh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "Aku hanya ... berpikir setelah melihat \"mimpi\" yang kukubur itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "Baiklah, aku harus segera pergi. Terima kasih atas bantuanmu ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Mungkin seharusnya dulu ... \"impian\" yang kutulis dan kukubur itu adalah impian yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Bisa menjalani hidup dengan sepenuh hati tidak akan membuat bosan loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Semangat ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Ini, bibit bunganya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
