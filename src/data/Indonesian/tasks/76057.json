				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "Gimana kalau habis ini kita bikin pertandingan kelompok? Atau satu lawan satu ya? Oh, halo kalian. Selamat datang di tempat latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "Tentang tempat latihan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Makin banyak yang datang, berkat kalian. Juga berkat anak-anak dan Persekutuan Tangan Hampa tentunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Aku sadar kalau tempat latihan ini cocok sekali untuk acara kumpul-kumpul. Ketika bertemu kawan yang sudah lama tidak jumpa, biasanya bingung kan harus ngobrol apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "Tentang Persekutuan Tangan Hampa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah, aku belum dapat cara yang lebih manjur daripada sasaran tembak untuk alas sarangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Aku dan anak-anak sudah mencoba berbagai material, tapi mereka benar-benar suka yang itu. Untuk saat ini, pilihannya cuma barter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Tapi kami sudah mulai paham nilai tukar mereka. Sudah dapat untung juga, lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Kapan-kapan ke sini lagi deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "Ya, silakan! Ingat ya, untuk kalian, selamanya gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
