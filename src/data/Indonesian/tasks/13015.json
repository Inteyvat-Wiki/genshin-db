			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Oh, bagus. Kamu sudah bangun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Semua orang harus mulai bangun, dan kita juga sudah mendengar laporan serupa dari sekitar kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Dilihat dari situasinya, kamu berhasil menyelesaikan masalahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Iya, walaupun susah payah sekali sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "Akan ada banyak orang yang berkumpul di sini sebentar lagi, jadi tolong jaga ketertiban di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "Aku harus pergi ke Akademiya dengan mereka sekarang, tapi kami akan segera kembali kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Oh, ternyata Archon Dendro. Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Aku mau mengecek catatan registrasi dari pelajar Kshahrewar. Harusnya sekarang dia masih tidak sadarkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Oke, tunggu sebentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Setelah beberapa saat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Maaf membuatmu lama menunggu, Archon Dendro. Kami sudah mengonfirmasi bahwa ada pelajar bernama Beynuni yang sudah tak sadarkan diri selama beberapa saat. Penyebabnya adalah karena penggunaan Akasha yang tak wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Dia masih belum sadarkan diri, dan masih menerima perawatan di Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Eh? Bukannya namanya Moseis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Sepertinya dia tidak mau diganggu siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Tolong berikan pengetahuan yang terkandung di dalam sini kepada matra, dan minta mereka untuk memasukkannya ke dalam otak Beynuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Baiklah. Tapi demi keamanan, aku perlu tahu alasannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Sederhana, karena di dalam sini terkandung kesadarannya. Kesadarannya itu sudah lama terjebak di dalam mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Dia melakukan suatu hal yang mempengaruhi keamanan Sumeru. Setelah dia bangun, aku akan infokan kepada Mahamatra Agung mengenai rinciannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Baiklah. Akan segera kuurus. Terima kasih, wahai Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Mm-hmm. Oke tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Seharusnya sekarang semua orang berkumpul di \"Sekejap Mimpi\". Ayo kita kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Diam dan dengarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Aku penasaran dia bakal ngomong apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Halo, kalian semua yang baru saja bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Maaf mengganggu mimpi indah kalian. Mungkin aku agak judes sewaktu di dalam mimpi. Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Mimpi mempunyai kekuatan yang luar biasa. Mimpi bisa menginspirasi kita untuk menghadapi perbedaan, dan membantu mereka yang mempunyai aspirasi untuk mencapai keinginan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Tapi mimpi juga punya potensi untuk mengeksploitasi orang, membuat indra menjadi bingung, dan mengacaukan kenyataan. Sayangnya, kalian terpilih menjadi korban dalam sebuah skema busuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Seperti yang sudah kukatakan sebelumnya, aku masih belajar, dan aku juga tidak bisa bilang bahwa aku bisa sepenuhnya bersimpati pada penderitaan yang telah kalian alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Tapi lihatlah sekeliling kalian, dan kalian akan melihat banyak orang yang mengalami nasib yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Kalian harus bangga bahwa kalian bisa berkumpul bersama di sini dan bisa menyongsong masa depan bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "Perjalanan hidup itu panjang, dan sulit untuk kita melihat tujuannya. Ini akhirnya membawa kita kepada berbagai pertanyaan yang sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "Apa arti hidup? Apa arti keberadaanku? Kenapa aku terus mengalami sakit dan kehilangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "Tentu saja, pilihan yang paling nyaman adalah berhenti untuk maju, menyerah dan berhenti berpikir, dan terus saja mengulang apa yang menurutmu biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Kapan pun kamu berpikir begitu, lihatlah pada orang-orang dan benda-benda di sekitarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Beberapa orang bekerja keras sepanjang hari hanya demi agar keluarga mereka bisa makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Beberapa orang bepergian ke seluruh penjuru dunia hanya demi membuat karya seni yang beresonansi dengan seluruh Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Beberapa orang pergi bertualang mencari rahasia dunia untuk mencegah bencana yang mendekat dengan cepat, namun masih belum diketahui, bencana yang menghancurkan dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "Hidup bukan hanya mengenai dirimu sendiri saja. Setiap tindakanmu akan membentuk dirimu dan dunia di sekitarmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "Teman dan keluarga akan selalu mengingat apa yang kamu perbuat, dan mungkin beberapa orang yang tidak pernah kamu temui akan diuntungkan oleh tindakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Karenanya, banyak orang berjuang maju untuk membentuk sebuah jalan baru, walaupun mereka harus menahan rasa sakit yang luar biasa untuk hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Begitu kamu memulai perjalananmu di jalan yang sulit namun pada akhirnya akan memberimu hadiah yang setimpal, kamu akan mengetahui jawaban atas pertanyaan-pertanyaan tersebut, namun pertanyaan-pertanyaan itu juga tidak akan lagi terasa penting seperti sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Tapi kalau kamu meyakini bahwa hidup itu hampa, mimpi kosong, maka begitu pula lah yang akan terjadi pada hidupmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Kamu bebas memilih ingin seperti apa hidupmu, tapi sebagai Archon kalian, pertama-tama aku harus menginformasikan ini dulu pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Pada akhirnya, terserah apakah kamu ingin merengkuh mimpi indah yang dibayar dengan hidup nyatamu atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Nahida, kamu hebat banget! Paimon saja hampir tergoda sama pelajar di mimpi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Dia memang pintar sekali memanipulasi kelemahan dari sifat dasar manusia, tapi mungkin, bagi dirinya sendiri, ini juga jadi seperti ramalan yang berhasil terpenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Mimpi itu benar-benar indah dan menggoda. Manusia biasa tidak akan bisa melihatnya, dan pasti akan tersesat di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Tapi selama kamu masih bisa bangun, kamu masih bisa melanjutkan hidupmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Kamu juga sudah belajar banyak ya, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Hah? Apa yang membuatmu berkata demikian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Kamu bisa berempati dengan orang lain sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Iya! Kamu bilang kamu enggak paham sama perasaan manusia, tapi kami jelas-jelas lihat semua keraguan kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Pidatomu tadi juga ngena banget ke semua orang. Pokoknya kamu mantap deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Terima kasih. Aku sudah dengar banyak cerita menyedihkan selama perjalanan ini, dan beberapa dari mereka menyentuh hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Tidak bisa dibilang kalau para korban mimpi itu juga salah sih, dan apa yang mereka inginkan juga bukannya tidak masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Jadi aku bisa paham kenapa mereka mencoba menolak kita dan melindungi mimpi itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Tapi semua pengertianku dan perasaanku ini mungkin satu persen pun tidak sebanding dengan penderitaan yang telah mereka alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "Kurasa \"satu persen\" ini tidak bisa dimasukkan ke dalam empati yang kamu sebut tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Ekspektasimu terhadap diri sendiri terlalu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Tidak ada orang yang bisa punya empati yang sebesar itu juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Hehe, baiklah. Sepertinya memang ya harus keluar melihat dunia dulu baru bisa bertumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Emosi itu berbeda dari pengetahuan. Sulit bagiku menjabarkannya dalam kata-kata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni, atau \"Moseis\", bilang bahwa aku tidak pernah mengalami rasa sakit akibat kehilangan, tapi aku punya perasaan kalau itu tidak benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "Saat aku memasuki mimpi, aku merasa diselimuti perasaan hangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Begitu hangat sampai-sampai aku merasa aku kembali lagi ke awal kehidupanku, dan aku sampai tidak ingin bangun lagi rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Eh ... Apa dia juga lihat sesuatu di dalam mimpi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Tapi saat aku membuka mataku, perasaanku itu langsung hilang tanpa jejak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Kalau aku harus membuat analogi dari hal itu, bisa kukatakan bahwa aku tidak bisa lagi melihat kata-kata di selembar kertas setelah dihapus, tapi aku masih bisa melihat sedikit goresan di mana kata-kata itu ditulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Tapi setelah aku mengalami mimpi itu ... Kurasa aku bisa dengan percaya diri mengatakan kalau aku tidak akan terlalu berlarut-larut pada arti dalam kehangatan tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Sudah cukup dengan mengetahui bahwa ada kehangatan seperti itu yang mendukungku, dan keberadaannya membuatku menjadi seperti aku yang sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Kalau aku terlalu berlarut-larut pada hal itu, seolah aku menaruh beban gerobak di belakang kuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Aku berpidato untuk menginspirasi rakyatku, jadi kalau aku sendiri tidak bisa melakukannya, bakal memalukan sekali kan, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Greater Lord Rukkhadevata sudah membentuk Nahida lewat aksi-aksinya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Walaupun dia sudah lupa, pikiran dan tekad Nahida adalah sebuah bukti bahwa dia pernah ada.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Daripada memberi tahu kenyataannya, aku lebih baik menghormati keputusannya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Hei, kenapa tampangmu jadi serius sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Kamu seperti mau mengatakan sesuatu. Ada yang mau kamu katakan padaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Eh, aku lupa mau bilang apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Hehe, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Karena kita baru saja bangun, ayo pemanasan sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Hari yang baru akan segera dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Ah tidak, bukan hal penting kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Kamu harus lebih percaya diri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
