			"dialogs": [
				{
					"id": 210230201,
					"content": "Kita harus segera memperbaiki tangga itu secepatnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "Apakah kamu adalah penjaga penginapan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Benar, apakah ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "Seseorang di bawah menitipkan paket ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Oh, ini pasti paket yang dikirim tamu untukku. Kenapa Zhen Qiang tidak memberikannya sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "Masih ada paket yang harus dia terima? Hah, dia pasti merasa repot dan malas harus naik turun lift...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "Maaf, kamu adalah tamu kami dan tangga sedang rusak sekarang. Aku sedang mencari cara untuk memperbaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "Maaf sudah merepotkanmu membawa paket ini ke atas untukku. Ambillah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "Awalnya ini aku siapkan untuk Zhen Qiang, tapi karena dia menyuruhmu mengantarkannya, jadi kamu yang berhak mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "Baiklah, aku akan bersiap untuk memperbaiki tangga. Silakan melihat-lihat penginapan, dan cari aku kalau kamu butuh sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
