			"dialogs": [
				{
					"id": 733520101,
					"content": "Halo, pengembara dari jauh dan teman kecil. Apa kalian menikmati Festival Sabzeruz-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520102,
					"content": "Kalau kalian tertarik, maka aku, sang Raja Mainan Fantasi mengundangmu untuk berpartisipasi dalam permainan baru \"Kereta Bunga Berguncang\" yang hanya tersedia selama Festival Sabzeruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520103,
					"content": "Apaan tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Namanya bikin Paimon kebayang Nahida goyang-goyang gembira di kereta bunganya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "Hati jadi senang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "Luar biasa! \"Archon Dendro bahagia setiap hari\" tentu adalah harapan semua orang di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520108,
					"content": "Asosiasi yang kalian buat ... adalah gambaran yang begitu indah, pantas diabadikan dalam sebuah gulungan lukisan yang megah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520109,
					"content": "Akan tetapi, permainan ini memiliki suasana yang lebih semangat. Daripada perayaan, mungkin lebih baik dianggap sebagai sebuah petualangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520110,
					"content": "\"Yang pintar dan yang tidak, yang baik ataupun nakal, semua anak berhati polos akan mendapatkan Kereta Bunga sendiri selama perayaan Festival Sabzeruz ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520111,
					"content": "\"Menaiki kereta masing-masing, anak-anak kemudian akan memulai sebuah petualangan unik, menghadapi dan melewati berbagai bahaya yang mendebarkan, serta menemukan harta karun berupa seribu kuntum bunga yang indah ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520112,
					"content": "Paimon anaknya pintar dan baik, kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "Hehe, betul! Hartanya sudah pasti punya kami deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "Haha, bagus, bagus. Kalau begitu, silakan main sepuasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520113,
					"content": "Percaya deh, kami ini ahlinya dalam mengatasi bahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Aku jadi ingin lihat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}