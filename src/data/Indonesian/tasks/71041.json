			"dialogs": [
				{
					"id": 710410401,
					"content": "Di sini tempatnya. Hah, sudah kuduga. Pintunya dikunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "Harus pakai dua kunci di waktu bersamaan untuk dapat buka pintu ini. Kenapa sih orang Liyue perhatian banget sama urusan tetek bengek begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Kurangi komentar yang tidak perlu lah. Tinggal lihat saja ke pengumuman yang ada di sebelah pintu, di situ jelas tertulis amunisinya masih ada di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Urusan amunisi sudah, tapi kita belum tahu keadaan sumbunya kan? Jangan berharap terlalu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Aduh kamu ya, ngomong begitu bisa bikin sial, tahu. Banyak kerja, bukan banyak mulut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "Lagian, ngapain juga kita dengarkan ocehan Treasure Hoarder ini sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "Omongan Clitopho barusan masuk akal sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Betul! Kalian berdua jangan ribut terus dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "Hmm ... oke, sebagai juniormu, aku turuti kata-katamu. Kita lanjut dulu, mungkin Kak Jinwu tahu cara buka pintu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410411,
					"content": "Sesudah itu kita bakal sibuk. Mau buka kunci sungsang harus mengaktifkan dulu perangkat sinyalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410412,
					"content": "Kata Kak Jinwu, di tempat tinggi yang menghadap ke arah meriam, ada titik observasi regu pembongkar. Kita bisa sesuaikan sinyalnya dari sana, lalu buka meriamnya dari jarak yang aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410408,
					"content": "Apa pun itu, kita harus buka gerbangnya dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
}