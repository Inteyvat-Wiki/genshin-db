			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "Mekanisme penguncian belum berkarat, lalu ada bekas minyak pelumas juga ... Sepertinya masih ada yang merawatnya setelah tambang ditutup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "Sungsangnya juga masih utuh ... cuma bagian pengamannya saja yang terkunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Ngomong apa sih? Baca mantra yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Terowongan di depan ditutup batu besar saat para penambang dibubarkan ... kelihatannya, meriam ini akan berguna sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Tapi semua meriam tidak berguna kalau tidak ada amunisinya. Kita harus dapat itu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Hmm ... Jangan bicara seolah yang gituan saja aku tidak paham ya, tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "Dekat sini ada gudang. Di sana harusnya ada amunisi meriam. Semoga tidak dibawa pergi semuanya waktu evakuasi dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "Berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "Ayo jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
