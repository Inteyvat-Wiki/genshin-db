			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "Pengembara! Kamu datang tepat waktu, kapalnya baru dicoba, sangat seimbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210102,
					"content": "Perhitunganku ternyata tidak masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210103,
					"content": "Jadi, kapan tes beban bisa dimulai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210104,
					"content": "Sabar, Pengembara sudah datang, jadi kita akan segera mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210105,
					"content": "Apa itu tes beban?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "Sederhananya, kita mencoba kemampuan menanggung beban dari kapal dengan barang berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210107,
					"content": "Hmm ... artinya harus ada yang memindahkan barang berat ke atas kapal bersamaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210108,
					"content": "Pengembara, aku tahu badanmu kuat dan bertenaga, kamu cocok untuk pekerjaan seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210109,
					"content": "Ternyata ini alasan menyuruhku ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "Ti-Tidak ... Aku benar-benar tidak bisa memindahkannya sendiri, jadi terpaksa meminta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210112,
					"content": "Aku pasti akan memberikan banyak imbalan! Tenang saja, beberapa hari lalu aku baru memperbaiki sebuah kapal besar dan mendapat banyak uang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210113,
					"content": "Oh ... banyak uang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210114,
					"content": "Eh? Tapi, sepertinya aku menghabiskan uangnya untuk membangun kapal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210115,
					"content": "Semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210116,
					"content": "Masih ada sisa sedikit! Aduh, aku akan traktir kopi deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210117,
					"content": "Pengembara, ayo cepat mulai! Cepat, cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210110,
					"content": "Kamu buat aku kesal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
