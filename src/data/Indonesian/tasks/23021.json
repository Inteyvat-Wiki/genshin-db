				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "Oke deh! Seharusnya sudah selesai, ayo lihat apa yang akan terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210601,
					"content": "Wah! Ada yang bocor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210615,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210602,
					"content": "Ka-kapalnya miring! Apa yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210603,
					"content": "Ce-Cepat turunkan barangnya, pasti ada masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210604,
					"content": "Bersama dengan Rafiq menurunkan barang dengan tergesa-gesa ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "*huff* Untung barangnya tidak banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210606,
					"content": "Sebenarnya ... masalahnya ada di mana sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210607,
					"content": "Apa yang aku bilang dulu? Perhitunganmu terlalu ekstrem dan tidak bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210608,
					"content": "*huff* Aku ... aku ... baiklah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210609,
					"content": "Tidak mungkin, aku sudah menghitungnya dengan akurat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210610,
					"content": "Pengembara, terima kasih atas bantuanmu, ini imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210611,
					"content": "Aku akan kembali dan menghitung ulang kembali. Qishan, apa kamu bisa bantu aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210612,
					"content": "Cara bicaramu seolah-olah aku tidak bantu kamu sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210613,
					"content": "Serahkan padaku saja, tapi jangan lupa, habis ini, traktir aku minum kopi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
