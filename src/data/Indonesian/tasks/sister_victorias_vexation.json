			"dialogs": [
				{
					"id": 190010101,
					"content": "Aku harap Suster Barbara baik-baik saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010102,
					"content": "Apa yang terjadi dengan Barbara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "Suster Barbara bilang dia pergi untuk mengumpulkan beberapa tumbuhan herbal, tapi dia belum juga kembali sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010104,
					"content": "*huff* Mungkin aku harus melaporkan hal ini kepada Knights of Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010105,
					"content": "Aku akan pergi mencari Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "Kamu? Ah... baiklah sebagai Honorary Knight, sepertinya kamu memang cocok untuk mengerjakan tugas ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010107,
					"content": "Aku jadi tidak perlu repot-repot melaporkannya kepada para Knight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010108,
					"content": "Baiklah, kuserahkan hal ini padamu. Sebelum Suster Barbara pergi, dia bilang mau pergi ke Wolvendom untuk mengumpulkan beberapa tumbuhan herbal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010109,
					"content": "Kamu bisa mulai mencarinya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
