					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "Alrani! Ternyata benar kamu! Ta-tapi, apa yang kamu lakukan di Inazuma? Bukannya kamu di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130802,
					"content": "Ini... Oh, ceritanya panjang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130803,
					"content": "Tuan Kaushik, Anda kenal Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130804,
					"content": "Oh, Anda Jenderal Gorou, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130805,
					"content": "Benar sekali. Alrani dan aku seorang pelajar yang meneliti di Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130806,
					"content": "Kami meninggalkan Akademiya untuk mempelajari topik yang berbeda. Tak disangka aku bisa bertemu dengannya di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130807,
					"content": "Tapi ... Um, memangnya pelajar seperti kalian bisa keluar masuk Akademiya dengan bebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130808,
					"content": "Aku tidak bisa bilang itu \"keluar masuk dengan bebas\" sih. Alrani dan aku termasuk sebagai Driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130809,
					"content": "Bagi kami, meneliti di lapangan adalah proses dari penelitian, jadi kami diizinkan untuk meninggalkan Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130810,
					"content": "Jenderal Gorou, aku bisa menjamin kalau Alrani jujur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130811,
					"content": "Baiklah, kalau begitu tidak ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130812,
					"content": "*huff* Aku selamat... Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130813,
					"content": "Hiroyuki, Ookubo, masalahnya sudah selesai. Kalian boleh mengerjakan urusan kalian sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130814,
					"content": "Baik, Jenderal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130815,
					"content": "Baik, Jenderal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130816,
					"content": "Maaf, Nona Alrani, karena kami telah mencurigai Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130817,
					"content": "Meskipun nama Anda sudah bersih, namun penyelinapan Anda ke Pulau Watatsumi sudah menyebabkan masalah untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130818,
					"content": "Eh... A-apa Anda mau mendenda saya? Sa-saya tidak punya Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130819,
					"content": "Ya, karena Anda sudah mengatakan bahwa Anda adalah penjual pupuk, dan Anda juga peneliti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130820,
					"content": "Maka ada hal yang bisa Anda lakukan untuk kami. Ada seorang pria bernama Iwata yang meneliti pupuk. Nona Alrani, saya harap Anda bisa menolongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130821,
					"content": "Jika Anda menolongnya membuat pupuk yang tidak meresahkan warga, maka Anda boleh bebas meneliti di sini, sama seperti Tuan Kaushik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130822,
					"content": "Pu-pupuk? Tunggu, aku hanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130823,
					"content": "Dia pasti bisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Alrani, ini adalah kesempatan bagus untuk mengumpulkan bahan penelitian. Karena kamu datang ke Inazuma, berarti tesismu masih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130826,
					"content": "Uh... Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130827,
					"content": "Kamu juga tahu standar kelulusan Akademiya bagaimana. Kalau kamu tidak bisa lulus bertahun-tahun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130828,
					"content": "A-aku lakukan! Aku akan melakukannya, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130829,
					"content": "Aku sudah mempelajari tentang pupuk dengan Tuan Vahid. Aku pasti bisa mengerjakannya, lihat saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130830,
					"content": "Kelulusan benar-benar mendorong orang untuk belajar dewasa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Kalau begitu sudah diputuskan begitu ya. Nona Alrani, kuserahkan masalah pupuk kepada Anda. Aku masih ada urusan lain yang harus dikerjakan, jadi permisi dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130833,
					"content": "Oh iya, tolong ingatkan Iwata untuk meletakkan ... pupuk itu jauh-jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130834,
					"content": "Baiklah, aku akan melanjutkan penelitianku sekarang. Kalau ada pertanyaan, kamu bisa tanyakan padaku kapan saja, Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130831,
					"content": "Kelulusan adalah dorongan yang kuat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Kuserahkan padamu, Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
