			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "Makna totem ini... Hmmm, Pengembara? Ada urusan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Tentang Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Alrani ke sini? Ke Pulau Watatsumi? Aneh sekali. Kenapa dia di sini? Bukannya dia di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Dia ditangkap para prajurit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Apa? *huff* Wajar saja sih. Datang ke Pulau Watatsumi di kondisi sekarang... Wajar saja kalau dia dicurigai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Kita bicarakan ini nanti saja. Ayo kita ke sana dan bantu si ceroboh itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
