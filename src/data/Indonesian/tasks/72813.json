					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "Diam dan jangan bergerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130502,
					"content": "A-aku tidak bergerak kok. Kalian dengarkan dulu penjelasanku. Aku seorang pelajar dari Akademiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130503,
					"content": "Bukannya kamu datang untuk menjual pupuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130504,
					"content": "Aku ... Memangnya pelajar dari Akademiya tidak boleh menjual pupuk? De-dengarkan dulu penjelasanku sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130505,
					"content": "Orang ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130506,
					"content": "Iya, Jenderal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130507,
					"content": "Saat menangkapnya, dia sedang berkeliaran sambil mengendap-ngendap di sekitar dan terus mencatat sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130508,
					"content": "Jenderal, aku yakin dia pasti mata-mata Shogunate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130509,
					"content": "Bukan! Aku bukan mata-mata! Aku sudah bilang kan, aku ini peneliti?! Aku tadi sedang mengumpulkan bahan-bahan untuk tesisku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130510,
					"content": "Omong kosong! Masuk ke medan pertempuran untuk menulis tesis, kamu kira kami bakal percaya? Kamu pasti ada motif lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130511,
					"content": "Apa lagi yang bisa kulakukan selain mengerjakan tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130512,
					"content": "Oh, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "Pengembara! Oh, bagus sekali! Tolong bilang ke mereka kalau aku bukan orang jahat! Aku ke sini hanya untuk menulis tesisku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130515,
					"content": "Kamu kenal dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130516,
					"content": "Bisa dibilang begitu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "Hanya demi lulus, peneliti-peneliti Sumeru rela melangkah sampai sejauh ini ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130518,
					"content": "Tapi dari yang kamu katakan, kamu sepertinya tidak tahu banyak tentangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130519,
					"content": "Dan status \"peneliti dari Sumeru\" juga kamu dengar dari mulutnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130520,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Hmmm... Bukti-bukti seperti ini tidak cukup kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130522,
					"content": "Tapi kalau kamu menjamin dia, aku bisa percaya kalau dia bukan orang jahat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130523,
					"content": "Jenderal, aku punya saran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130524,
					"content": "Anda ingat Kaushik? Peneliti yang mempelajari sejarah dan budaya pulau kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130525,
					"content": "Dia sudah cukup lama di sini, dan identitas dia bisa dipercaya. Bagaimana kalau kita tanyakan saja padanya, minta dia lihat ... apa penjual pupuk ini benar-benar peneliti atau tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130526,
					"content": "Ide bagus. Pengembara, bisakah kamu membawa Kaushik ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130527,
					"content": "Demi mencegah hal yang tidak diinginkan, aku akan mengawasi penjual pupuk ini di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130528,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "Kuserahkan padamu ya. Kembalilah secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130513,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
