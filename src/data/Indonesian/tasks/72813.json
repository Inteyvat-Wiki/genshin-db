				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "Terima kasih, Pengembara. Terima kasih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130302,
					"content": "Waktu aku sedang membuat pupuknya, tiba-tiba muncul monster entah dari mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130303,
					"content": "Sungguh kejadian aneh... Untungnya kamu muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130304,
					"content": "Mungkin mereka seperti itu karena pupuk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "Be-benarkah? Tapi kudengar bau seperti ini adalah tanda-tanda keberhasilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130306,
					"content": "Kita jangan bicara soal ini dulu. Ayo sini, lihat dulu pupuk yang kubuat, biar kujelaskan padamu lebih rinci ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130307,
					"content": "Tunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130308,
					"content": "Eh? Tuan Gorou? Kenapa Anda bisa ke sini hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130309,
					"content": "Sedang patroli ya, Gorou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "Aku... Uh, hal ini nanti saja dibicarakan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130311,
					"content": "Tumpukan benda itu ... punya kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130312,
					"content": "Hahaha, iya. Pupuk ini hasil kerja kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130313,
					"content": "Tuan Gorou, jangan-jangan kamu juga ke sini untuk melihat hasil pupuknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130314,
					"content": "Hehehe, kalau begitu, mari kita bu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130315,
					"content": "Tunggu! Tunggu sebentar. Aku ke sini bukan untuk itu. Tunggu, sebenarnya aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130316,
					"content": "Ekspresi wajah Gorou terlihat sangat tidak enak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130317,
					"content": "Mari kita ke tempat lain yang agak jauh dari sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Iya, ayo kita ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130319,
					"content": "Jadi Tuan Gorou, kenapa Anda di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130320,
					"content": "Akhir-akhir ini banyak warga yang mengeluhkan bau busuk di sekitar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130321,
					"content": "Jadi demi menjaga keamanan, aku datang memeriksa dan mengikuti sumber baunya sampai ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130322,
					"content": "Dan akhirnya aku menemukan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130323,
					"content": "Iwata, aku dengar kamu sedang meneliti pembuatan pupuk, tapi cara pembuatannya ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130324,
					"content": "Meresahkan warga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Benar sekali. Bagaimanapun juga, Iwata, bisakah kamu membuang pupuk itu? Aku akan membantumu menemukan cara lain untuk pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130327,
					"content": "Tuan! Jenderal Gorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130328,
					"content": "Aku di sini. Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130329,
					"content": "Kami melihat ada seseorang yang mencurigakan di luar, Jenderal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130330,
					"content": "Dia bertindak sembunyi-sembunyi dan menyebut dirinya ... seorang penjual pupuk, atau semacamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130331,
					"content": "Kami merasa sangat aneh, jadi kami menahan orang itu. Kuharap Anda bisa menginterogasinya sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130332,
					"content": "Pupuk lagi, pupuk lagi. Kenapa aku harus terus berurusan dengan pupuk hari ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130333,
					"content": "Aku mengerti. Aku akan segera menyusul kalian ke sana. Pulanglah dulu dan tetap jaga ketertiban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130334,
					"content": "Iwata, tolong selesaikan masalah pupuk ini. Kita akan bicarakan lebih lanjut nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130335,
					"content": "Pengembara, bagaimana kalau kamu ikut denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130336,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Memasarkan pupuk? Paimon merasa ada yang familier. Tapi tidak terpikirkan sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130339,
					"content": "Ah, ya sudahlah. Mari kita ke sana untuk melihatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130337,
					"content": "Penjual... Pupuk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "Terlalu berapi-api?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
