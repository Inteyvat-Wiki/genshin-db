				{
					"id": 728130903,
					"content": "Hmm? Orang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "Asisten yang Gorou temukan untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Halo, aku Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Ya, yang pasti... Jenderal yang bernama Gorou memintaku membantumu meneliti pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Senang bisa bekerja sama denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "Wah, bagus sekali! Kalau kita sukses, kita bisa menanam lebih banyak tanaman di Pulau Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "Ingat untuk menaruh pupuknya jauh sedikit ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Ah? Oh, baik. Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "Pokoknya, semoga kita bisa bekerja sama dengan baik! Mohon bimbingannya ya, Nona Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Aku akan berusaha sebaik mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Demi tesisku, aku akan mengusahakan yang terbaik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "Spesialis pupuk dari Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Halo, aku Alrani... Tunggu, siapa bilang aku spesialis pupuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130908,
					"content": "Aku... aku hanya belajar sedikit tentang pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				}
			]
