			"dialogs": [
				{
					"id": 10020201,
					"content": "Siapa gerangan, yang berani memasuki Jueyun Karst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
