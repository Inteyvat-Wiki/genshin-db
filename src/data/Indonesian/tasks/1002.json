				},
				{
					"id": 10020202,
					"content": "Aku disuruh ke sini oleh seseorang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Ini, silakan dilihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Sigil of Permission. Sudah lama sekali semenjak diriku terakhir melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020205,
					"content": "Yang ada di hadapanmu adalah sang Adeptus agung dan tercerahkan, Moon Carver. Bicaralah, wahai Pengembara. Apa yang engkau cari di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020206,
					"content": "Sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "Itu mereka! Berani-beraninya pembunuh menginjakkan kaki di Jueyun Karst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Millelith Sergeant"
				},
				{
					"id": 10020208,
					"content": "Pak, sepertinya kita juga sudah masuk terlalu jauh ke Jueyun Karst ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Prajurit Millelith"
				},
				{
					"id": 10020209,
					"content": "Ahh ... Mau bagaimana lagi. Pelakunya harus ditangkap, itu prioritas kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Millelith Sergeant"
				},
				{
					"id": 10020210,
					"content": "Melewati batas suci kami.",
