				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "Cara orang masuk ke tempat ini sungguh sesuka hati dan sangat tidak beradab ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190102,
					"content": "Kalau bukan karena aku tahu ini Tenshukaku, aku pasti akan salah mengira kalau tempat ini adalah pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190103,
					"content": "Kali ini sudah lebih paham, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190104,
					"content": "Aduh, Kujou Sara diapain sama Signora ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "Akulah yang berhak menghukum pelanggaran orang-orang Inazuma. Bukan kamu, Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190106,
					"content": "Baiklah, maafkan aku kalau begitu, Yang Mulia Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190107,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Iya, iya, aku tahu kalian tidak bisa melupakanku. Tapi kalian tidak perlu memanggil namaku terus-menerus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190109,
					"content": "Jangan berpikir aku terkejut melihatmu di sini. Aku tahu persis kalau kamu membenciku, dengan caramu mengikutiku seperti bayangan gelap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190110,
					"content": "Kamu diam-diam menyebarkan Delusion ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Ah, jadi kamu ingin buru-buru membongkar semua dosa-dosaku di depan Shogun ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190113,
					"content": "Hehehe ... Aku ini cuma seorang diplomat dari Snezhnaya. Aku tidak tahu-menahu mengenai persoalan yang kamu bicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190114,
					"content": "Dia kelihatannya sedang mempermainkan kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Demi warga yang sudah kehilangan Vision mereka ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Tidak usah membahas orang dan hal yang bukan urusanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190118,
					"content": "Mereka awalnya hanyalah ikan teri yang namanya hanya pantas untuk dilupakan. Tapi sekarang, setidaknya mereka sedikit berguna dengan menjadi batu loncatan dalam revolusi besar untuk mewujudkan keabadian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190119,
					"content": "Bukankah itu merupakan suatu kehormatan besar bagi hidup mereka yang singkat dan tidak berarti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190120,
					"content": "Apa ada yang salah dari ucapan saya, Yang Mulia Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190121,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190122,
					"content": "Gnosis milik Venti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "Ah, lagu lama kamu nyanyikan lagi. Kamu suka sekali menyimpan dendam ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190125,
					"content": "Impian Tsaritsa adalah hal yang paling mulia dan murni di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190126,
					"content": "Hal-hal duniawi lainnya yang kamu sebutkan tadi ... itu cuma sedikit pengorbanan yang diperlukan. Itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190127,
					"content": "Waktunya untuk menghentikan semua ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Kamu? Menghentikanku? Hahahahaha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190129,
					"content": "Kebetulan aku juga sudah muak melihat wajahmu. Tapi tak kusangka kalau kamu orang yang bisa bertindak gegabah seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190130,
					"content": "Sebelum kamu ucapkan sesuatu yang tidak bisa kamu tarik kembali, kamu lupa kalau kamu itu buronan kelas kakap Inazuma? Kusarankan kamu untuk pikirkan posisimu dulu matang-matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190131,
					"content": "Menerobos masuk ke Tenshukaku, lalu menceramahiku di depan Shogun, itu bukanlah tindakan yang cerdas. Bukankah sudah waktunya kamu untuk berhenti memerosokkan diri lebih dalam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190132,
					"content": "Kurasa kamu tidak tahu seberapa jauh jarak di antara kita ... baik dari segi status, maupun kekuatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190133,
					"content": "Aku menantangmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "Duel di Istana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190136,
					"content": "Laksanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190137,
					"content": "Ckck, kamu benar-benar penuh dengan kejutan ... Jadi kamu sudah tahu cara memanfaatkan aturan yang berlaku di sini, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190138,
					"content": "Harus kuakui, aku memang tidak pernah membayangkan situasi di mana kita berdua berada dalam pijakan yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190139,
					"content": "Kamu tahu ... kalau yang kalah harus mati, kan? Kamu yakin, ini yang kamu inginkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Hehehe. Kalau begitu aku berkenan berbagi tarian terakhir ini bersamamu ... sampai maut memisahkan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190123,
					"content": "Dan untuk orang-orang Liyue yang terancam karena ulahmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Demi rekan-rekan yang jadi korban Delusion ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Kamu mencoba untuk mengendalikan Inazuma ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}