			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Maaf, aku masih ada urusan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Santai, kami juga cuma ngabisin waktu saja kok. Balik lagi kalau lagi senggang ... atau kalau bosan mampus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Maaf bos ... tiga jurusku ternyata mengecewakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "Eh, santai saja. Toh kita juga cuma buang waktu, jangan dibawa pusing. Bielov, kamu ambil napas dulu di pinggir sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "Kawan, jurusmu rupanya mantap betul! Namaku Terho, salam kenal ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Namaku {NICKNAME}. Salam kenal juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "Sepertinya kamu punya segudang pengalaman tempur ya. Baik, yang tadi tidak dihitung, kita coba sekali lagi! Incali, giliranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "Bos cuma ingat aku kalau lagi ada masalah ... ck. Oke deh, pendekar sakti. Sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
