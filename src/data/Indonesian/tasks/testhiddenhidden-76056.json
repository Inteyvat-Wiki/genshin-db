					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "Astaga, aku bisa kalah dari orang yang kebetulan lewat ... sampai tiga kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Tidak, tidak. Aku dan kamu kalah dua kali, sedangkan bos kalah sekali. Tidak separah itu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Hah! Kalah ya kalah, percuma cari alasan! {NICKNAME} memang sangat kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "Kalian berdua lawan aku saja tidak kuat, dan sekarang sialnya ketemu sama pakar sejati. Lihat tidak? Kalian masih kurang latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Kalau aku ... sepertinya harus mempertimbangkan untuk pensiun lebih cepat. Hmm, tempat latihan Vaino masih terima pegawai tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
