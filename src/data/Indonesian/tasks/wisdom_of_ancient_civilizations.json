			"dialogs": [
				{
					"id": 205060201,
					"content": "Woooww...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060202,
					"content": "Alkimia yang sekarang kita lakukan hanyalah mengikuti metode dari leluhur kita terdahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060203,
					"content": "Terlebih lagi mereka yang bisa terbang di udara harus paham bagaimana proses alkimia agar bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060204,
					"content": "Tapi setiap kali aku merasa aku mengerti bagaimana cara kerjanya, sesuatu tak terduga selalu saja terjadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060205,
					"content": "Apa lagi yang bisa dilakukan oleh alkimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "Sebenarnya aku juga tidak tahu, tapi aku juga jadi penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060210,
					"content": "Masih banyak resep-resep misterius yang harus kupelajari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060211,
					"content": "Dalam perjalananmu, kamu pasti menemukan beberapa catatan alkimia yang berasal dari peradaban kuno masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060212,
					"content": "Dengan meningkatnya Rank Adventure milikmu, banyak resep lain akan tersedia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060213,
					"content": "Terima kasih atas penjelasannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "Ah jangan sungkan, jangan lupa juga untuk berbagi cerita petualanganmu denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060218,
					"content": "Baiklah, sampai jumpa lagi. Semoga angin selalu memberkati perjalananmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060215,
					"content": "Saat kita bertemu lagi, aku pasti sudah menjadi penyihir alkimia Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "Masih memikirkan hal itu, apa tidak puas dengan Paimon yang sekarang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060217,
					"content": "Haha, kalian sungguh pasangan yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060207,
					"content": "Bisakah kamu membuat Paimon baru menggunakan alkimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "Hei! Memang satu Paimon tidak cukup?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060209,
					"content": "Hahaha, sayang sekali sampai sekarang masih tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
