			"dialogs": [
				{
					"id": 205060101,
					"content": "Halo, Namaku Timaeus, aku peneliti alkimia. Selamat datang di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Alkimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "Alkimia adalah kerajinan yang diturunkan dari zaman kuno, kini tidak banyak orang yang mengerti tentang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Mekanismenya sungguh misterius dan menakjubkan, benar-benar berbeda dari prinsip yang selama ini kita tahu tentang menciptakan objek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Jika kita bisa menguasainya, kita bisa menciptakan sesuatu yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "Ini meja tempat percobaan alkimiamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Benar sekali. Oh ya, apa kamu ingin mencoba melakukan alkimia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "Kedengarannya sulit, apa tidak masalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Tidak apa-apa, sebenarnya prosesnya sederhana. Jika kamu tertarik, aku bisa mengajarimu dasarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Craft",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Aku takut akan meledak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
