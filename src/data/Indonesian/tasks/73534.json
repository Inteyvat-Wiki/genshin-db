				{
					"id": 735340701,
					"content": "Ah, jadi sukarelawan yang masuk kriteria percobaan terapi alam mimpi ini masih sangat muda rupanya. Kalian anak muda zaman sekarang memang sesuatu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Namaku Nitesh, pelajar Spantamad yang suka berkelana. Saat ini kerja jangka panjang di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "Tua bangka seperti kami sering kebanjiran masalah bertubi-tubi. Semoga kamu bisa menolongku menghadapi akar semua permasalahannya ya, anak muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
