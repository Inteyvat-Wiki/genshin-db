			"dialogs": [
				{
					"id": 735340501,
					"content": "Salam kenal, namaku Higuchi Tetsuya, seorang penulis novel Youkai dari Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Belakangan ini aku lagi banyak tekanan, jadi ... apa pun boleh dicoba, asal bisa balik ke kondisi prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "Peringatan dulu, alam mimpiku bentuknya mungkin agak ... personal sekali, berhubung alam itu buatan alam bawah sadar kan? Berarti termasuk dengan segala permasalahan yang sekarang sedang dirasakan. Mohon maaf kalau Anda menjumpai sesuatu yang tidak enak dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
