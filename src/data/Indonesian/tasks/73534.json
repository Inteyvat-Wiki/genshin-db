			"dialogs": [
				{
					"id": 735340901,
					"content": "Jadi Anda toh teman baik yang direkomendasikan oleh Dharmakirti? Namaku Piyush, mata pencaharian arsitek. Senang berkenalan dengan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "Aku pernah dengar Tuan Kaveh menyebut nama Anda, tapi belum pernah ada kesempatan untuk bertegur sapa. Ini kebetulan yang sangat menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Kemungkinan aku bakal memimpikan tentang proyek yang sedang dalam proses pengajuan. Mimpi buruk ... sangat buruk. Sayang sekali kita harus berkenalan dalam kondisi yang serba formal seperti ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
