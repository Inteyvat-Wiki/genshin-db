			"dialogs": [
				{
					"id": 735340101,
					"content": "Halo, halo, kamu ya yang mau bantu aku perihal Terapi Alam Mimpi? Jujur ya, aku sendiri bingung bakal mimpi apa nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Aku orang Mondstadt, tidak punya hobi spesifik ... selain minum, tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "Dan aku tipe yang ngelantur dan kacau kalau sudah kebanyakan minum, jadi ... mohon bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
