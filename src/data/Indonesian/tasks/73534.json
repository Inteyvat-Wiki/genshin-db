			"dialogs": [
				{
					"id": 735340301,
					"content": "Salam kenal. Kita sekarang sedang dalam perjalanan menuju alam mimpi bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Namaku Youguang, pengawal dari Liyue. Aku menyentuh sesuatu yang ... najis pas kerja belum lama ini, dan semenjak itu jadi tidak bisa tidur nyenyak. Makanya aku datang minta tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Kalau mimpi buruk ini bisa hilang lewat terapi, aku akan sangat bersyukur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
