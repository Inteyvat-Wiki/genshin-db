					]
				},
				{
					"id": 411220804,
					"content": "Hahaha, boleh juga kemampuanmu, terima kasih atas bantuannya. Sepertinya monster-monster itu tidak akan berani kembali lagi untuk sementara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220805
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220805,
					"content": "Tapi aku masih belum bisa kembali... Selain monster-monster di sini, masih ada banyak monster yang berkeliaran di sekitar Stormbearer Mountains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220806
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220806,
					"content": "Aku akan tinggal di sini untuk mencari informasi. Lagi pula, kalau ada orang yang membutuhkan bantuanku, aku bisa langsung menolongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220807
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220807,
					"content": "Karena sekarang ini belum semua orang tahu kalau mereka harus pergi berlindung.",
