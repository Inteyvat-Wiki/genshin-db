			"dialogs": [
				{
					"id": 411220401,
					"content": "Hmmm? Halo, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Situasi sekarang ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Aku tahu sih, makanya kami datang ke sini untuk melihat meteorit jatuh. Kami akan segera kembali kalau kami sudah melihatnya, jangan khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "Kita juga bisa melihat meteorit itu dari kota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Memang bisa, tapi harus dari tempat yang sangat tinggi. Aku sudah pernah mencoba beberapa kali, aku selalu disuruh turun dan dimarahi oleh penjaga kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "Makanya aku membawa Jill ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "Paman baik hati itu pasti rela membantu kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Membantu? Maksudmu, dia bisa membantu kita naik ke tempat yang tinggi untuk melihat meteorit jatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "Tidak mungkin lah... Tuan itu sikapnya aneh sekali, galak lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "Aku membawa Surat Perintah untuknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Benarkah? Coba kulihat. Waw... Surat Perintah Knights of Favonius sungguhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "Kalau ada Surat Perintah ini, apakah paman itu bisa membawa kita naik ke tempat yang tinggi untuk melihat meteorit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Hehe, bagus sekali kalau kita bisa melihat meteorit dari dalam kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Kalau begitu tolong kamu bicarakan dengan paman itu ya, aku juga akan berbicara dengan Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "Wah... aku sudah tidak sabar untuk melihat pemandangan saat meteorit-meteorit itu jatuh dari langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
