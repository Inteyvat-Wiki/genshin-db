				"objectNames": [
					"Jill"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "Hai...? Apakah ada sesuatu yang salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220302,
					"content": "Situasi sekarang ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "Oh, aku tahu tentang meteorit-meteorit itu. Tapi... kami sendiri belum pernah melihat meteorit yang sedang terjatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220304,
					"content": "Kata Will dia tahu tempat yang bagus untuk melihat meteorit jatuh, makanya kita datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220305,
					"content": "Kita juga bisa melihat meteorit itu dari kota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "Tapi kalau mau melihat dari dalam kota, kita harus memanjat tempat yang sangat tinggi dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220307,
					"content": "Para penjaga pasti tidak memperbolehkan kita memanjat terlalu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220308,
					"content": "Paman baik hati itu pasti rela membantu kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "Eh? Maksudmu bapak-bapak aneh itu? Tapi saat dia berbicara dengan kita, nada bicaranya galak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220310,
					"content": "Dia cuma mengatakan satu hal, pokoknya kita harus pulang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220311,
					"content": "Tapi kalau dia berjanji memperbolehkan kita untuk memanjat tempat yang tinggi di kota Mondstadt. Kurasa... tidak ada salahnya pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220312,
					"content": "Tapi tolong sampaikan ke Will juga ya, soalnya ini ide dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jill"
				}
			]
		},
