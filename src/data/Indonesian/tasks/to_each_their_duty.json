					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "*huff* Sepertinya sudah tidak ada cara lain lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "Oh, ternyata kamu. Begini... kamu pasti juga sudah melihat meteorit yang jatuh dari langit itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220104,
					"content": "Meskipun untungnya tidak ada meteorit yang jatuh ke dalam kota, tapi di luar kota sudah porak poranda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220105,
					"content": "Banyak orang yang datang berlindung ke dalam kota, ditambah dengan orang-orang yang tiba-tiba tertidur tanpa sebab. Sebentar lagi kita akan kewalahan menghadapi masalah yang ada di dalam kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220106,
					"content": "Aku ingin memanggil kembali semua Knights of Favonius yang sedang bertugas di luar sana untuk membereskan masalah di dalam kota terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220107,
					"content": "Tapi mereka semua tersebar di luar sana, sementara sudah tidak ada Knights of Favonius lainnya lagi di sini yang bisa menyusul mereka ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220108,
					"content": "Apakah kamu bisa membantuku untuk memberikan Surat Perintah ini ke prajurit-prajurit di luar sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
