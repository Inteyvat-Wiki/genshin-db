			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "Halo, ada apa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "Surat Perintah ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "Surat Perintah? Wah, biar kulihat dulu... Sepertinya Tuan Huffman ingin aku kembali ke kota untuk membereskan berbagai hal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "Waduh, aku tidak keberatan untuk kembali ke kota, tapi coba kamu lihat kedua orang anak itu, mereka sama sekali tidak mau diajak kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "Aku tidak tahu keluarga mereka ada di mana, tapi aku juga sungkan memaksa mereka pulang. Makanya aku hanya bisa mengawasi mereka di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "Sekarang aku diperintahkan untuk kembali ke kota, bagaimana nasib anak-anak ini kalau kutinggal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "Aku sudah membujuk mereka berkali-kali, tetapi mereka sudah tidak mau mendengarku sama sekali sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "Ah, bagaimana kalau... kamu yang membujuk mereka? Siapa tahu mereka lebih menurut denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "Kalau kamu bisa membujuk mereka untuk kembali ke kota, aku juga bisa kembali tanpa cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "Baiklah, akan kucoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
