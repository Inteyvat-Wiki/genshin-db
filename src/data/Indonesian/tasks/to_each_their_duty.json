			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "Bagaimana? Apakah kamu berhasil membujuk mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220502,
					"content": "Sepertinya berhasil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Bagus! Bagus kalau begitu! Terima kasih sekali. Eh, apa maksudmu dengan \"sepertinya\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "Asalkan kamu mau membantu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Membantu... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "Apa? Kamu mau aku menemani mereka melihat meteorit dari tempat yang tinggi di kota? Itu... sepertinya berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "Apalagi mereka masih kecil, untuk hal seperti ini aku harus membuat laporan ke markas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "Aku punya Surat Perintah ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "Surat itu... sepertinya tidak seharusnya digunakan untuk ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Ah, sudahlah. Yang penting kedua anak itu sudah mau pulang ke kota. Nanti baru kupikirkan cara untuk membawa mereka ke tempat tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "Kamu janji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Tentu saja, aku berjanji atas nama Knights of Favonius dan sebagai... orang dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Tidak peduli berjanji kepada siapa pun, janji itu harus ditepati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Aku benar-benar telah merepotkan kalian, serahkan saja sisanya kepadaku, aku akan membawa mereka kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Lalu... aku harus memikirkan bagaimana cara membawa mereka naik ke tempat tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
