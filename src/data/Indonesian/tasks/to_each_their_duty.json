			"dialogs": [
				{
					"id": 411220601,
					"content": "Halo, apakah ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "Surat Perintah ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Surat Perintah? Biar kulihat... Oh, aku diperintahkan untuk kembali ke kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "Maaf, tapi aku belum bisa kembali sekarang. Aku masih ada tugas yang lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "Sepertinya monster-monster di sekitar sini juga terkena efek dari meteorit-meteorit itu. Mereka menjadi lebih ganas dan berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "Demi menjaga keamanan di daerah sekitar sini, aku harus membereskan monster-monster ini terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "Tapi kamu hanya sendirian di sini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Justru karena di sini tidak ada orang sama sekali, aku jadi bisa mengerahkan semua kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "Ini adalah hal yang sangat penting. Aku tidak bisa meninggalkan tempat ini sebelum menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "Mari kubantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Terima kasih, di sekitar sini ada banyak tempat monster-monster itu berkumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Lebih cepat kalau kita berpencar untuk membereskan monster-monster ini. Setelah selesai, kita bertemu lagi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220611,
					"content": "Biar kubantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
