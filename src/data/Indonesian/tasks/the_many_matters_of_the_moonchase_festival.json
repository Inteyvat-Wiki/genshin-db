			"trigger": {
				"objectNames": [
					"Linyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "Ugh... Aku masih harus meletakkan setumpuk peti harta karun lagi ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "Apa tadi kamu menyebut \"peti harta karun\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "Eh? Kamu... pengembara? Kamu juga ikut Festival Moonchase?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Bisa dibilang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "Kalau begitu kebetulan sekali. Adventurers' Guild mengadakan acara untuk merayakan Festival Moonchase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "Bagaimana? Kamu mau tahu tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "Acara seperti apa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Selama Festival Moonchase berlangsung, Adventurers' Guild akan menghiasi benda bernama Moonchase Charm di berbagai tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Siapa pun yang menemukan Moonchase Charm ini dapat membawanya kembali ke Guild untuk ditukarkan dengan beragam hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Kami juga mengutus sekelompok petualang untuk menempatkan sejumlah besar peti harta karun spesial di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "Peti harta karun spesial ini penuh dengan berbagai barang berharga yang kami siapkan khusus untuk kesempatan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Selain dua kegiatan tadi, kami juga menyiapkan beberapa rentetan tantangan sulit untuk para petualang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Secara jelasnya... Ya, tantangannya termasuk rentetan penyerangan perkemahan monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "Dan apa hubungannya ini dengan festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Aha... Ahaha... Ugh, kamu jangan berbicara seperti itu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "Setelah mengalahkan monster-monster itu, ada hadiah yang bisa didapatkan loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "Kalau begitu apa bedanya dengan misi-misi biasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "...Tolong, bantulah kami! Sebagian besar dari petualang kami sudah pergi untuk menikmati festival, jadi banyak sekali komisi kami yang terabaikan begitu saja dan tidak ada seorangpun yang mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "Bantulah kami! Dengan kemampuanmu, pasti mudah sekali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "Baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "Ten—Tentu saja, kamu akan mendapat bayaran yang setimpal, Pengembara, jangan khawatir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Aku akan tetap berada di sini sepanjang Festival Moonchase. Kalau kamu ada pertanyaan, langsung saja tanya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "Kami mengandalkanmu, Pengembara. Baiklah... nikmati festivalnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Siapkan saja imbalannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "Tantangannya tidak ada hubungan sama sekali dengan Festival Moonchase!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Aduh, jangan-jangan tugas-tugas tak jelas lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "Bukan kok! Event kali ini benar-benar ada rasa petualangannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}