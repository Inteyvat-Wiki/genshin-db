			"dialogs": [
				{
					"id": 751350201,
					"content": "Bona, terbangnya terlalu cepat! Kami ketinggalan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Haha, maaf, maaf. Aku jadi tidak sabaran setelah lihat Altar Api Purbanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Kita cuma perlu pakai altar ini untuk ke Tonatiuh kan? Tapi kalaupun arus anginnya bisa angkat kita, kira-kira harus terbang berapa lama ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Duh, Paimon jadi khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Jangan takut, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Oke deh, Paimon percaya sama kamu. Tapi jangan jauh-jauh dari Paimon ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Baiklah, kita harus berikan Pyrophosphorite sebagai persembahan, kan? Kita punya dua nih ... Gimana kalau kita taruh dua-duanya saja, buat jaga-jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Seru ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Iya nih! Paimon juga jadi semangat! Yang begini pantang dilewatin petualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
