			"dialogs": [
				{
					"id": 750761201,
					"content": "Ah, akhirnya ... pahlawan dari jauh, jika bukan berkat dirimu, kami pasti sudah lama musnah ditelan musuh dari kegelapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				},
				{
					"id": 750761202,
					"content": "Pada zaman dahulu kala, suku ini disesatkan oleh ilusi kegelapan, dan banyak jiwa malam yang terlilit oleh Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				},
				{
					"id": 750761203,
					"content": "Di tempat segel itu berada, bahkan perwujudan kekuatan malam pun perlahan-lahan terkikis ... segelnya memutus segala bentuk komunikasi dengan dunia luar, dan dengan demikian memutuskan suku ini dengan sumber keyakinannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				},
				{
					"id": 750761204,
					"content": "Segel itu harus dibuka ... jika ingin punya harapan untuk bertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				},
				{
					"id": 750761205,
					"content": "Terima kasih, pahlawan dari jauh ... para jiwa telah menemukan jalan, mereka pulang ke rumahnya dalam mimpi yang berawan, menghindari wabah keji yang mencengkeram wilayah Yohualtecuhtin sang Patih Malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				},
				{
					"id": 750761206,
					"content": "Ah, akhirnya ... malam yang sunyi ... aku kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayob Manifestation yang Lemah"
				}
			]
		}
	]
