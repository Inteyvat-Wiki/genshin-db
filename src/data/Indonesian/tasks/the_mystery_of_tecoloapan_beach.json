				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "Kabut di lautan semakin tebal. Meresahkan sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "Jangan-jangan legendanya benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Legenda apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Ah ... itu tergantung legenda apa yang ingin kamu dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "Tentang pulau terbang dan grafiti raksasa, ada dua versi. Yang satu lebih mirip dongeng, yang satunya lebih seperti kisah nyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "Manakah yang ingin kamu dengar, wahai pejuang dari bangsa asing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "Kalau yang dongeng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Hmm, dongeng selalu ada bumbu romantisnya. Asal grafiti di pulau terbang berkabut itu bagian dari Kisah Qoyllor dan Ukuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "Dikatakan bahwa seorang gadis bernama Qoyllor meninggalkan karya grafitinya di pantai karena ingin menghubungi ayahnya, sang Bapa Surya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Bapa Surya melihat grafiti dari langit, lalu mengambilnya dari bumi ... kurang lebih begitulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "Konon kabut yang mencekam itu adalah hukuman yang diberikan Bapa Surya pada penduduk di permukaan dan karena penduduk suku telah merenggut kekuatan putrinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "Mau yang nyata atau dongeng, intinya kabut ini bukan pertanda bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "Pahlawan dari jauh ... tempat itu sangat berbahaya. Jangan mendekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "Kalau yang kisah nyata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Dan menurut legendanya ... katanya pada zaman dahulu kala, ada penyihir jahat yang menyamar jadi Wayob untuk menyesatkan para pahlawan suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "Kemudian, para pahlawan menggunakan grafiti raksasa itu untuk menyegel si penyihir jahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "Permukaan laut itu pertanda bahwa segel telah berhasil dipecahkan oleh si penyihir jahat. Dia sudah kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
