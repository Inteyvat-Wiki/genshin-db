					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020408,
					"content": "Tapi sampai sekarang aku tidak pernah mendapat balasan... mungkin ayah sangat sibuk dengan pekerjaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Jadi kupikir, karena ayah sangat sibuk, aku ingin menulis surat padanya dan memberikan sebuah hadiah... Tapi, hadiah apa ya yang bagus untuknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "Oh iya, aku bisa menggunakan <color=#00E1FFFF>Dandelions</color>, Ibu bilang semua orang di Mondstadt menyukai Dandelions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "Jika kamu ada waktu, bisakah membantuku mencari beberapa <color=#00E1FFFF>Dandelions</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020412,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "Oh! Terima kasih... Terkadang kamu BAIK juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "Tidak mau mengirim benda lainnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Aku ingin mengirim yang lain tapi jika terlalu berat, merpati tidak bisa mengirimkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "Lagi pula ayah bekerja di tempat yang saaaaangat jauh, merpati itu harus terbang begitu jauh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "Kamu sedang apa?",
