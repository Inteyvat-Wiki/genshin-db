					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020404,
					"content": "Sekarang aku sedang menulis surat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020407,
					"content": "Ibu bilang ayah akan mengirim surat dengan merpati pos saat dia ada waktu.",
