				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "Hah... aku ingin tahu apa yang terjadi dengan anak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Hm? Oh, kamu datang tepat waktu. Apa kamu masih ingat surat yang waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Jika kamu ada waktu, tolong bantu aku mengantarkan surat ini kepada Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Mengapa harus aku yang pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Setelah apa yang terjadi terakhir kali, aku tidak percaya lagi kepada merpati pos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "Dan jika aku sendiri yang pergi ke Mondstadt, aku pasti bertemu lagi dengan anak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "Hah... tolong jangan ada pertanyaan. Cukup antarkan saja surat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Hm? Kenapa kamu masih belum pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Tentang surat itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "...ini tentang sesuatu yang sudah lama terjadi. Jadi kamu tidak membacanya waktu terakhir kali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "Jika kamu belum membacanya, lebih baik tidak usah. Sungguh panjang dan membosankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Anak itu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Ah anak itu, anak yang memberi makan para merpati di jembatan, apa kamu masih ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "Ya, Timmie. Karena satu dan lain hal... akan lebih baik jika aku tidak melihatnya dulu sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "Sudah puas? Sekarang cepatlah, antarkan surat ini kepada Grace sebelum dia khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Aneh, seharusnya sudah tiba sekarang... Bagaimana jika terjadi sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Surat dari Draff untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Eh? Mengapa kamu yang mengirimnya, bukannya harusnya merrpati pos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "Apa sesuatu terjadi pada para merpati pos itu? Di Springvale kecelakaan dapat terjadi setiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Terima kasih karena sudah mengantarkan suratnya, tunggu sebentar, aku punya sesuatu untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Tentang surat itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Ah kamu membacanya? Hm... memang bukan hal rahasia sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Seperti yang Draff bilang, ini sesuatu yang sudah lama terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Namun walaupun sudah lama terjadi, ini merupakan hal yang tidak dapat kami lupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "Hal yang sudah lama terjadi ini sebenarnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Apa kamu benar-benar ingin tahu? Baiklah, sepertinya aku bisa memercayaimu... Tapi berjanjilah untuk merahasiakan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Aku janji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "...ayah Timmie adalah teman baik Draff. Mereka selalu melakukan sesuatu bersama. Berburu, minum, sampai berulah bersama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Aku tidak tahu sudah berpa kali mereka diperingati oleh para Knight dan ditegur oleh Suster Victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Akhirnya saat Timmie lahir, ayahnya bertobat. Dia berubah dan mulai bekerja keras untuk keluarganya dan untuk menjadi \"contoh yang baik\" untuk putranya, seperti yang dia katakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Lalu, dia benar-benar ingin memberi contoh baik bagi Timmie sampai dia membujuk Draff untuk berhenti minum alkohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Kecuali saat mereka benar-benar tidak tahan lagi, mereka akan bertemu dan minum apple cider bersama-sama. Terkadang aku juga bergabung bersama mereka dan minum sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Namun, suatu hari ayah Timmie terluka parah saat sedang berburu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Draff membawanya ke sini dan kami berusaha semampu yang kami bisa untuk menyelamatkannya... Sayangnya, dia tidak tertolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "Setelah itu, Draff memintaku untuk merawat Timmie sedangkan dia kembali ke Springvale untuk berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Setiap bulan dia mengirim surat dan sejumlah uang, tapi dia tidak mau menemui Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "Tapi, akhir-akhir ini dia bilang dia ingin mengatakan apa yang sebenarnya terjadi waktu itu pada Timmie, ah... aku tidak bisa membayangkan bagaimana perasaannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Kamu tidak ingin Timmie mengetahui yang sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Ya, aku tidak ingin Timmie mengetahui yang sebenarnya, dia masih terlalu kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Meskipun dia selalu bilang dia sudah besar sekarang, dia bahkan membantuku merawat Nora dan Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "Tapi... apa dia bisa menanggung semua fakta brutal tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Mungkin saat dia sudah beranjak dewasa dia siap, tapi sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Aku ingin dia mempunyai masa kecil yang bahagia. Walaupun itu berarti kita tidak sepenuhnya jujur padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Aku tahu Timmie sekarang sudah bukan anak kecil lagi. Dia mulai penasaran dan menanyakan banyak hal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Aku merasa semakin sulit menghadapi anak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "Nora bilang Timmie, sebelumnya Timmie selalu membawanya pergi ke hutan, katanya dia ingin membuat hadiah untuk ayahnya dan mengirim surat untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "Tapi akhir-akhir ini, Timmie terlihat begitu lesu dan tidak bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Jika kamu ada waktu, bisakah membantuku untuk melihat Timmie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Kenapa kamu tidak pergi sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Sedikit tidak enak hati tapi... Walaupun aku terus mengatakan bahwa aku tidak akan mengatakan yang sebenarnya pada Timmie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "Tapi setiap kali aku mendengar dia ingin mengirim surat pada ayahnya, aku merasa simpatik padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Aku khawatir suatu hari nanti aku tidak tahan lagi dan mengatakan semuanya padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "...dan aku tidak akan membiarkan itu terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Jadi, tolong bantu aku untuk melihat keadaan Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Kamu tidak bisa menyembunyikan ini darinya selamanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "...Benar, aku mengerti. Tapi Timmie masih terlalu kecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Tapi kuharap... tidak, dia harus mendapatkan masa kecil yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "Jika demikian, tidak peduli hal apa pun yang akan terjadi di hidupnya kelak, setidaknya dia memiliki kenangan yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "Apa yang salah dengan mengetahui kebenaran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "Hmm... ya, masuk akal jika kamu berpikir demikian. Banyak hal terjadi padamu sehingga kamu mempunyai banyak keberanian dan kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "Entah apa yang terjadi padamu pasti sangat luar biasa dan menyakitkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Tapi Timmie masih terlalu muda. Mungkin ini hanya keegoisanku saja tapi aku tidak ingin dia menderita karena itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "Setidaknya aku ingin dia memiliki masa kecil yang bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Aku tidak bisa berjanji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Ah, kamu benar-benar...",
