			"dialogs": [
				{
					"id": 711100101,
					"content": "Kalian berdua mau ikut kontes foto pemandangan \"Petualangan Chenyu\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Kontes foto pemandangan? Apaan tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Sesuai namanya, kontes ini diadakan untuk promosi pemandangan Lembah Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Kami sudah melakukan survei ke banyak orang tentang lokasi pemandangan paling menakjubkan di Lembah Chenyu. Peserta tinggal pergi ke sana dan jepret Kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Lalu kami akan memilih beberapa foto yang bagus untuk dipajang sebagai materi promosi. Gimana, kalian tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Aku cuma rakyat jelata. Ada hadiah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Kalau foto kalian menang, tentu saja ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "ASYIK, hadiah! Oke deh, kami ikutan! Demi hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Hehehe, kalau seandainya kalian kalah pun akan ada hadiah hiburannya. Ikutan saja, tidak ada ruginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "Mulainya dari mana nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Silakan baca buku panduan ini, di dalamnya ada tempat-tempat wisata menarik yang direkomendasikan oleh warga Lembah Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Eh? Kenapa ada yang dicoret gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Hehe, yang dicoret itu yang sudah kena kuota. Kami ingin mempromosikan pemandangan Lembah Chenyu secara menyeluruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Kalian masih bisa daftar untuk empat tempat yang tersisa. Boleh pilih satu atau beberapa sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Ohhh, gitu toh. {NICKNAME}, sikat saja semua sisanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Kalau kesempatan kita buat menang dari 1 foto itu 1/4, terus kita ngumpulin 4 foto ... berarti kita 100% dapat hadiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Pemahaman nenek moyangmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Lah? Tapi kan 1/4 dikali 4 sama dengan 4/4 ... 100% dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Hitungannya sih gitu, tapi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Ya sudah, jangan buang waktu lagi! Hadiah, tunggu kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Si Paimon jago matematika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Kebetulan, aku tukang foto paling jago se-Teyvat raya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Wah, semangat sekali. Baiklah, misalkan foto kalian terpilih, akan ada hadiah khusus menanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
