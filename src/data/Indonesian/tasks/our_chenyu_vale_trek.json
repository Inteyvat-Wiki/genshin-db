					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "Itu tadi bahasa burung, katanya \"boleh, boleh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Bisa bahasa burung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Sedikit ... Soalnya mereka kalau makan bunyinya \"Hiee hiee! Hiee hiee anng anng hiee hiee!\" terus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Jadi aku yakin itu artinya \"boleh, dengan senang hati\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Terus aku belajar panggil mereka kayak gitu juga. Begitu dengar suara, semua langsung datang. Mungkin dikiranya ada makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Kalian coba panggil aja, sekalian difoto! Sayangnya aku sudah harus pulang, padahal masih mau ajarin beberapa kalimat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Santai dek. Nanti kami cobain sendiri deh. Makasih ya ... hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, kita cobain panggil yuk. Kalau burungnya bisa kefoto, pasti menang nih lombanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
