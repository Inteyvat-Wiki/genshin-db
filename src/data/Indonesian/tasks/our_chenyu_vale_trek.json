			"dialogs": [
				{
					"id": 711100801,
					"content": "Hmmm, foto-foto ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Eh, kenapa? Kurang bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Justru sebaliknya ... aku sudah melihat banyak sekali foto-foto bagus beberapa hari ini, tapi foto dari kalian tetap bikin aku terkesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Contohnya foto Desa Qiaoying ini. Burung pelikan yang tertangkap kamera memberi kesan suasana desa terasa lebih hidup dan damai. Komposisi yang unik, bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Kalau menurutku pribadi sih, foto kalian berdua pasti akan terpilih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Wuah! Paimon jadi malu nih, dipujinya gitu amat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Memangnya itu foto jepretan Paimon ya? Ngapain kamu yang malu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Paimon cuma ngewakilin kamu! Kamu juga malu kan~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Kembali ke pembicaraan tadi. Penilaian kami akan selesai besok pagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Karya-karya yang terpilih akan dipajang untuk umum, di jalan sana. Mulai besok dari pukul 8 pagi sampai 6 sore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Terima kasih sudah mengikuti kompetisi foto pemandangan Lembah Chenyu kali ini ya. Jangan lupa datang lagi besok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Oke! Kami pasti hadir, demi hadiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Jujur, iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
