			"dialogs": [
				{
					"id": 711101301,
					"content": "Berhenti! Stop! Jangan mendekat ... kalian ... orang baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Eh, kami barusan nolongin kamu loh! Kepalamu kejeduk apa gimana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Ah! Benar juga ... Maaf, perjalananku ke Chenyu kali ini terlalu banyak kena sial, aku jadi agak pusing ... Terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "Kamu juga ikutan lomba foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Kalian juga ya? Kebetulan sekali. Aku cuma turis biasa sih ... tidak berdaya kalau harus berhadapan sama Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Sialnya, aku ketemu mereka di jalan lalu digiring ke sini. Memangnya Hilichurl zaman sekarang juga minta pungli ya? Kacau ... untung ada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "Yah, memang kayaknya sial banget ya hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Bukan cuma hari ini! Kemarin aku juga sial. Aku beli Kamera yang sangat mahal dari pedagang Fontaine, tapi malah rusak setelah dipakai beberapa kali. Waktu aku kembali mencarinya, dia sudah menghilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Pedagang yang tidak punya akhlak ... kalian juga hati-hati ya, harus jaga itu dompet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Oh iya, ngomong-ngomong kalian juga ikutan lomba \"Petualangan Chenyu\", kan? Berarti mau foto-foto Mt. Xuanlian juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "Sebagai terima kasih, aku akan memberi tahu kalian lokasi terbaiknya. Ayo, aku tandai lokasinya di peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "Tuh, dari sini semuanya kelihatan, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "Lah? Terus kamu sendiri gimana? Bukannya sama ikutan lomba juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "Aku rasa di sekitar sini masih sangat berbahaya, sebaiknya pindah saja. Aku ingat ada tempat lain di buku panduan ... itu loh, \"Adeptus Menikmati Teh\". Aku mau lihat ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "Oke! Sampai jumpa lagi ya, kalian! Semoga setelah ini aku bakal berhenti kena sial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
