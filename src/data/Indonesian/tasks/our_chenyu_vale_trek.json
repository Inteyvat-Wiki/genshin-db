			"dialogs": [
				{
					"id": 711100201,
					"content": "Kawan, kamu ikutan kontes foto juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Sebagai seorang fotografer dari Fontaine, tempat Kamera diciptakan ... izinkan aku beri sebuah nasihat: yang terpenting dalam fotografi adalah Kamera-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Jadi biarkan kukenalkan kalian pada seseorang. Di kampung halamanku ya, tidak ada orang yang tidak suka Kamera buatannya! Harganya terjangkau, kalian bisa beli lewat aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Eh, eh, kenapa mukanya jadi malas gitu! Tunggu dulu, aku kasih diskon lagi deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Hei, heiii! Jangan pergi dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
