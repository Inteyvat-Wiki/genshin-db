			"dialogs": [
				{
					"id": 711101001,
					"content": "Ah, kalian berdua sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Kalian sudah lihat foto-fotonya? Total ada delapan foto yang terpilih untuk kompetisi \"Petualangan Chenyu\" kali ini, dan kalian borong setengahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "Selamat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Wow! Foto kita sebagus itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}! Apa kata Paimon? 1/4 dikali 4 itu 4/4 alias 1, 100%! Keren kan matematika Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Jelas-jelas ini hasilnya 4/8.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Hehe, seperti komentarku kemarin, para juri lainnya juga sangat memuji dua karya kalian yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Jadi, silakan terima album foto kenang-kenangan \"Petualangan Chenyu\" edisi terbatas ini. Di dalamnya ada semua foto yang terpilih kali ini, kalian memang pantas mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Ohhh, jadi ini hadiah kejutannya ya? Cakep banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Ada lagi, semoga Mora yang jumlahnya tak seberapa ini berkenan di hati kalian. Aku secara pribadi ingin mengucapkan terima kasih untuk partisipasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "Karena tempat ini adalah tanah kelahiranku, dan kalian sudah berhasil mengabadikan keindahannya. Aku yakin foto-foto kalian dapat membuat orang-orang menyukai tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Wah! Paimon juara cerdas cermat matematika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
