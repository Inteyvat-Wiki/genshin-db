			"dialogs": [
				{
					"id": 207411001,
					"content": "Apakah kamu sudah mengumpulkan Dandelion Seed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411002,
					"content": "Ya, sudah terkumpul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Semua ini seharusnya cukup. Mohon tunggu sebentar di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "... Lord Barbatas, tolong dengarkan aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Wow, dia begitu... taat. Begitu... banyak kata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "... Siapa tahu Si Pengamen itu dengar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Baiklah, tolong bawa Dandelion Seed ini, bantu aku menebarkannya di lantai atas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "Aku seharusnya melakukanya sendiri, tapi dengan kemampuan fisikku sekarang... meskipun aku bisa naik ke sana, aku mungkin akan sulit untuk turun lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "Jadi, aku minta tolong padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
