			"dialogs": [
				{
					"id": 765070101,
					"content": "#Wah, {NICKNAME}, coba lihat! Enggak sadar ya, album foto ini sudah penuh aja! Semuanya kelihatan bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Benar sekali. Waktu cepat sekali berlalu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Hehe, enggak sangka kita bisa nemuin banyak tempat bagus begini, terus bisa ambil banyak foto teman-teman kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Lihat yang ini, kita susah payah banget cari sudut foto yang sempurna. Tapi hasil fotonya benar-benar cakep deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "Semua berkat Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Hehe, pasti dong, Paimon kan pemandu paling perhatian dan kompeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "Kenangan bagus kayak gini emang pantas dibayar mahal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, bagaimana rasanya pakai Kamera ini? Menurutmu kemampuan fotografimu meningkat drastis dan kamu sudah hampir sehebat Master Pierre Leblanc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Dari segi teknik ... jalannya masih panjang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "#Benar, yang paling penting itu senang! Lagi pula, Paimon rasa foto {NICKNAME} enggak kalah sama foto-foto dari fotografer profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Karena di setiap foto itu ada cerita kita. Bagiku, ini adalah karya yang tak tergantikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "Kalau nanti kita ... bertualang ke tempat lain, lalu mengingat momen-momen indah ini, pasti seru banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "Mulai sekarang, kita harus lebih banyak foto bareng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Oke! Kalau begitu, album foto selanjutnya harus lebih bagus dari ini! Ayo kita buat lebih banyak kenangan yang unik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "Yang penting menikmati prosesnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "Semua berkat dana daruratmu, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Setiap foto adalah sebuah kenangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
