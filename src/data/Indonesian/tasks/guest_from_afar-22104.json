			"dialogs": [
				{
					"id": 221040101,
					"content": "Benar-benar merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "Eh, maaf! Sejak kapan kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040104,
					"content": "Monster di sekitar penginapan semakin hari semakin banyak. Walaupun suamiku mengatakan bahwa mereka tidak berani masuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040105,
					"content": "Tapi kalau hanya dia sendiri yang melawan monster-monster itu... Aku masih tetap khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040106,
					"content": "Kalau ada waktu, apa kamu bisa membantuku mengamankan area sekitar penginapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "Terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "Aku sangat berterima kasih atas bantuanmu. Aku akan memberikan imbalan yang memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "Penginapan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Hah? Tidak ada yang luar biasa dari penginapan ini. Lokasinya hanya sedikit jauh dan tamunya sedikit banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "Para pengembara yang melancong selalu memerlukan tempat untuk mengisi perut dan beristirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040112,
					"content": "Seperti itulah apa yang suami dan aku pikirkan. Sesederhana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
