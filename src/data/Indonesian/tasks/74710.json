			"dialogs": [
				{
					"id": 747100101,
					"content": "Hmm ... Ikan kecil jinak berenang ke sana dan kemari, dalam akuarium yang luas dan ditata dengan baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "Pemandangan yang benar-benar indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "Makanya akuarium kami populer banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Kalau saja mereka bisa tenang begini di perairan terbuka, orang-orang bisa menyelam dan lebih menikmati keindahan alamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "Bagaimanapun juga, aku jadi tahu kenapa ikan-ikan ini begitu gelisah berkat bantuanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "Selama bertahun-tahun, sudah banyak kapal yang karam, bahkan ada oknum yang membuang limbah secara ilegal ke laut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "Banyak sekali sampah buatan manusia yang tenggelam ke dasar laut, lalu menumpuk dan merusak habitat alami. Hal ini menyebabkan ikan-ikannya jadi semakin agresif ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "Dan ternyata, sekelompok penyelam sudah menerima misi untuk membersihkan sampah tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Tapi sepertinya aku harus memberi mereka dorongan secara halus dan meminta mereka untuk mempercepat pekerjaannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Sepertinya masih butuh waktu sebelum kita bisa melihat hasilnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Yap. Sambil menunggu, kita teruskan saja pekerjaan kita dan tangkap sebanyak mungkin ikan-ikan kecil yang agresif agar mereka bisa lebih tenang dan pulih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Mengisolasi pasien dari lingkungannya yang berbahaya adalah langkah penting dalam proses pemulihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "Oke! Serahkan saja pada kami! Kami akan tetap waspada untuk pasien baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Sepertinya pekerjaan seperti ini tidak bisa selesai cepat-cepat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
