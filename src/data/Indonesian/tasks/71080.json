				{
					"id": 710800634,
					"content": "Cerita tentang perjalanan mencari saudara kembar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Kamu cerita pada Taliesin tentang peristiwa yang kamu alami.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "Menarik. Tanah kuno yang terlupakan, pengorbanan yang tidak diindahkan, dan penghukuman yang tidak adil ... Ini sungguh tema yang agung! Kisah yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "Dan kisah ini adalah tentang semua yang kamu jumpai sepanjang perjalanan, yang semakin mendekati tujuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Terima kasih karena sudah bersedia membagi cerita. Aku akan menuliskannya. Namun kurasa belum waktunya kisah ini kujadikan bait-bait puisi ... Aku yakin ini baru sebagian kecil saja dari keseluruhannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Aku tidak akan mengolah kisahmu dengan menggunakan kemampuanku yang terbatas ini. Aku hanya bisa berharap kamu akan menceritakan lagi perjalananmu ketika semuanya sudah usai nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Firasatku bilang bahwa ketika hari itu tiba, kedua telingaku ini akan diberkahi dengan kisah kepahlawanan yang paling agung yang pernah ada di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
