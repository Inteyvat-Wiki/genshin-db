						710800631
					]
				},
				{
					"id": 710800631,
					"content": "Ini ... luar biasa! \"Maka sang Pengembara terpilih berkata: Tidak perlu sopan santun. Majulah sembilan dari kalian! Kuhadapi sekaligus!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800632,
					"content": "Itu ... agak lebay sih jadinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "Tidak apa! Nah, sekarang izinkan diriku mencampurkan fiksi ke dalam latar belakang kesembilan pendekar pedang itu ....",
					"roleType": "TALK_ROLE_NPC",
