					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "Astaga. Betapa hebat! Betapa kuat! Sempurna. Beri aku sedikit waktu untuk menuliskan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "\"Kabut gelap melanda bagaikan longsoran salju. Kedua pengikut Abyss yang kini terpisah pun menghilang, tanpa bekas sebagaimana ketika mereka muncul.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
