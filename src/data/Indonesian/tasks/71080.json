						710800624
					]
				},
				{
					"id": 710800624,
					"content": "Menarik. Semuanya terdengar mustahil ... Beri aku waktu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800625
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800625,
					"content": "\"Bahkan jamur raksasa yang tumbuh menembus langit, tidak berdaya di hadapan kegelapan yang menelan semua.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800626
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800626,
					"content": "#\"Sebagai jawaban, {NICKNAME} sang pahlawan pun datang, menyucikan bumi dan mengusir bala.\"",
