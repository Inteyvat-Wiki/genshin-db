				{
					"id": 710800617,
					"content": "Cerita tentang kristal yang ada di Chasm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
					"content": "Kamu cerita pada Taliesin tentang peristiwa yang kamu alami.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "\"Langit dan air mengalir di permukaan kristal, demikian noda ungu dan merah terhapuskan olehnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "\"Sang makhluk purbakala terhuyung setelah terkena kepalan besi sang pahlawan. Ketika itulah bintang utama kisah ini muncul!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "\"Sekutu misterius yang datang membantu pun pergi tanpa meninggalkan jejak, namun sang ular raksasa telah hancur berkeping-keping tertimpa kristal ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
