			"dialogs": [
				{
					"id": 700610701,
					"content": "Oh ... kalian sudah kembali? Jadi gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "Sudah kami usir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Wah, terima kasih banyak. Ini imbalan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Kerja keras itu memang seharusnya dibayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Akhirnya aku bisa merapikan ladang bunga ini. Semoga tidak ada \"makhluk sialan\" yang datang mengacau lagi ....",
					"roleType": "TALK_ROLE_NPC",
