			"dialogs": [
				{
					"id": 700610101,
					"content": "*huff* Lagi-lagi, kenapa ladang bungaku jadi seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Kalau begini terus, bunga-bunga tidak akan bisa dikirim tepat waktu. Apa yang harus kukatakan kepada pelanggan aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Kamu lihat, ladang bunganya hancur ... awalnya banyak bunga loh, malah dihancurin kayak gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Semua gara-gara dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "Keterlaluan, benar-benar tidak manusiawi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Ya kan! Sebenarnya bukan manusia sih, pelakunya babi hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Entah kenapa, belakangan ini dia selalu datang untuk memakan bunga dan berguling-guling di ladang bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Mereka juga sangat licik. Begitu ada yang mendengarnya dan mendekat, mereka langsung kabur, dan hampir menabrak orang tua yang lewat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "Keterlaluan, benar-benar bukan babi hutan yang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "Tunggu dulu ... kamu Honorary Knight, kan? Oh, pahlawan dari Mondstadt, tolong bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Oke, aku akan mengusirnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "Syukurlah kalau kamu mau membantu ... seingatku, dia lari ke lembah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Makhluk ini sangat licik, mungkin kita harus memancingnya keluar dengan bunga ... sayangnya, ladang bunga sekarang jadi begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "Mungkin kamu bisa memetik beberapa Windrest Flower di jalan, lalu menipu dia biar tahu rasanya ditertawakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
