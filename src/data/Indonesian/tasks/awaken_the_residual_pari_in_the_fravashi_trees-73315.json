					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150313,
					"content": "Bentuknya memang aneh, tapi jangan dikatain hina juga dong! Jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150314,
					"content": "Di sini rimbun, banyak pohon. Kirain kamu bakal betah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150315,
					"content": "Heh. Aku cuma betah saat di berada medan pertempuran. Hanya pertempuran abadi yang kekal sampai selama-selamanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150316
					],
					"speakerTitle": "Sorush"
				},
				{
