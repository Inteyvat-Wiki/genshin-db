			"dialogs": [
				{
					"id": 733150201,
					"content": "Tidak kusangka akan jadi seperti ini. Menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150202,
					"content": "Apa maksudnya, Sorush?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150203,
					"content": "Bukan apa-apa. Hanya menyaksikan wujud hina kaumku saja. Tak perlu dihiraukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150204,
					"content": "Kan! Paimon malah jadi makin penasaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150205,
					"content": "Coba Paimon lihat ... Ada pohon yang aneh banget di sana. Terus bentuknya lingkaran, mirip pintu ya jadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150206,
						733150207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150206,
					"content": "Kalau kita lewatin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733150208
					]
				},
				{
					"id": 733150208,
					"content": "Nah, kan. Paimon jadi kepengen coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150209,
					"content": "Pohon Fravashi bukan pintu. Kalian akan mengganggu sisa-sisa Pari yang menghuninya kalau masuk sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150210,
					"content": "Jadi namanya Pohon Fravashi, ya? Tapi mana sisa-sisa Pari yang menghuninya? Kok enggak kelihatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150211,
					"content": "Pucat Terbang tentu saja tidak bisa lihat. Karena sisa-sisa Pari masih terjebak masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150212,
					"content": "Kehendak mereka mungkin lain, tapi menyaksikan mereka begitu melekat terhadap dunia fana ini ... Aku tidak tahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150213,
					"content": "Kelihatan subur loh, padahal. Memangnya salah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150214,
					"content": "Heh, Pucat Terbang tidak tahu apa-apa. Pohon Fravashi adalah Pari yang bertempur sampai titik darah penghabisan, melawan pencemaran yang mengotori tanah ini. Mereka menjelma menjadi pohon dengan menggunakan sisa-sisa kekuatan yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150215,
					"content": "Seluruh kekuatan habis sampai wujud pun tidak bisa lagi dipertahankan. Dan Oasis Vourukasha menolak semua yang tercemar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150216,
					"content": "Dikatakan bahwa pada zaman dahulu kala, Orde Pembenaran melakukan ritual penyucian agar mereka bisa kembali ke Oasis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150217,
					"content": "Saat ini, sudah tidak ada orang Orde Pembenaran yang tahu tentang ritual tersebut. Yang bisa mereka lakukan hanyalah menjaga agar Pohon Fravashi tetap hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150218,
					"content": "Tapi itu cuma memperpanjang penderitaan. Dari bentuknya sekarang, aku tebak sudah tidak ada lagi yang tersisa selain kenangan pahit yang harus ditanggung sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150219,
						733150220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150219,
					"content": "Masa mau dibiarin sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733150221
					]
				},
				{
					"id": 733150221,
					"content": "Iya, Paimon enggak tega. Masa dibiarin sengsara sendirian sampai seterusnya gitu, kan kasihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150222,
					"content": "Demikianlah takdir kami sebagai Pari. Mungkin mereka pun berharap untuk dapat terus menjaga tanah ini dengan cara seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150223,
					"content": "Sorush sotoy. Gimana kalau mereka mikirnya beda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150224,
					"content": "Kalau Paimon ya, jelas enggak mau kejebak di sini sendirian. Pasti kepengen banget pulang, kumpul lagi sama semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733150225,
					"content": "Pucat Terbang, berani-beraninya meremehkan tekad kaum Pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733150226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150226,
					"content": "Ha, sudahlah. Aku akan bangunkan dia. Biar kalian bisa mendengar suaranya yang semakin samar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733150220,
					"content": "Ayo tolong, ada caranya kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733150221
					]
				},
				{
					"id": 733150207,
					"content": "Mungkin bisa sampai ke ... mana saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733150208
					]
				}
			]
		},
