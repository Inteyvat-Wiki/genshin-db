				]
			},
			"dialogs": [
				{
					"id": 750410501,
					"content": "Kalian sebaiknya segera pergi. Kalau kalian di sini lebih lama lagi, nanti keburu terlambat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410502,
					"content": "Kenapa terlambat? Karena ... seluruh tim petualang sudah gugur. Semuanya ... ditelan oleh makhluk hitam raksasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410503,
					"content": "Mereka memintaku untuk melindungi orang-orang yang dievakuasi, setidaknya memastikan bahwa mereka berhasil meninggalkan kota. Saat ini, tim penyelamat dari Suku Bunga Bersayap sedang dalam perjalanan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410504,
					"content": "Aku harus membasmi monster-monster jahat ini, sehingga orang-orang yang selamat bisa kembali ke tanah yang disinari cahaya sekali lagi ... Hah, tapi ... duh kenapa aku di sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410505,
					"content": "Suara di telingaku ... Ahh, semakin lama semakin kencang. Aku ... harus kembali ke air terjun. Ya, aku harus ... kembali ke air terjun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410506,
					"content": "Pejuang pemberani, kalian harus pergi ... secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
