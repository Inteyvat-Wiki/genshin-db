			"dialogs": [
				{
					"id": 741570301,
					"content": "Rumah ini dijual. Harga terjangkau, beli sekarang juga sebelum terlambat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Informasi Penjualan Rumah"
				},
				{
					"id": 741570302,
					"content": "#Kak {NICKNAME} dan Kak Paimon! Mau cari Tuan Leroy ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Benoit ada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Enggak ada. Papa bilang Tuan Leroy sudah pindah ke bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Fleuve Cendre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "Fleuve Cendre yang pernah kita kunjungi dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Bukan sih, bukan di situ. Katanya masih ke bawah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "Kata The Steambird, Tuan Leroy jatuh dari gunung yang tinggi banget, berguling-guling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Aku enggak ngerti, kenapa orang jatuh harus pindah rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "Ah, aku tadi ketemu menantunya Tuan Leroy! Terus ada kakak baik hati juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "Kakak itu suka banget sama aku. Warna mata kami juga sama, ungu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Dia nanya di mana aku tinggal. Katanya boleh enggak main ke rumah kalau ada waktu, terus ngajak berteman juga! Hehe, keluarga Leroy isinya orang baik semua ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "Duh, aku sudah bawain Bulle Fruit buat Tuan Leroy. Tapi dianya malah enggak ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "Buahnya buat Kakak berdua saja ya, mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Makasih Molli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Sama-sama! Papa Mama selalu bilang kita harus murah hati sama teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "Satu lagi perbuatan baik hari ini! Aku mau pulang, tulis di buku harian, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Kamu melihat Molli dengan riang berjalan menjauh. Kisah keluarga Leroy pun berakhir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Kebetulan lewat saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Aku lagi mikir, apa perlu kasih tahu Kakak kalau Tuan Leroy sudah pindah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Kata Papa Tuan Leroy sudah enggak tinggal di sini lagi. Dia pindah ke bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
