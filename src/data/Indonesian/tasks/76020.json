						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Wah, itu benda kecil kelap-kelip yang kita lihat tadi! Eh, ini di mana sih, ngomong-ngomong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Masa iya kita sudah mutar sampai ke bawah pohon aneh itu? Terus yang hijau-hijau itu ... apaan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
