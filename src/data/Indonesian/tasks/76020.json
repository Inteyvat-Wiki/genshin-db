			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Hari ini juga pulang dengan tangan kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "Kamu ngapain di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Lagi mancing. Tapi sampai sekarang yang ada cuma barang-barang yang bukan ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Kalau dapat barang-barang kecil dari kapal karam sih masih lumayan, pedagang keliling masih mau beli. Sebelumnya pernah dapat sepatu bot yang masih ada setengah ... Ah, sudahlah, kalau kebanyakan ngomong nanti ikannya kabur semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "Sekitar sini apa ada yang menarik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Berburu harta ya? Konon, \"Harta Karun Maha Besar\" ada di timur bulan dan barat matahari ... jelas bukan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Ah, tapi ada banyak kapal yang karam di perairan sekitar sini. Mungkin ada harta di bawah sana, tapi ya tidak semudah itu juga mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "Aku dengar di kedai. Pelaut yang selamat bilang pada malam ketika musibah itu terjadi tidak ada bulan, tapi ada seberkas cahaya temaram yang mengintip dari balik ombak-ombak setinggi bukit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "Katanya itu Kratti bermata satu, monster yang konon bisa menelan bulan. Dia sedang berebut daerah kekuasaan dengan ular laut raksasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "Lama setelah itu, wilayah ini menjadi kelam, segelap tinta orang-orang yang kerja di bagian pembukuan. Tidak ada kapal yang berani lewat. Semua takut pada arwah-arwah yang bersemayam di bawah permukaan air, yang akan menarik mereka ke bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "Arwah-arwah itu konon masih bergentayangan di sekitar sini, tapi ya ... yang begitu sih cerita untuk menakuti anak kecil. Aku tidak percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "Tentang pohon ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "Menyeramkan ya. Dulunya di sini pernah ada pusaran air, para pelaut menyebutnya \"Mata Kratti\". Lalu pada suatu hari, tiba-tiba pohon ini tumbuh begitu-begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Tapi bukan itu saja hal aneh yang terjadi ketika itu. Semuanya bermula ketika ... batu-batu itu jatuh dari langit. Mungkin pohon ini juga berasal dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "Lalu ada benda-benda kecil yang berkilau kelap-kelip. Itu langka sekali. Aku yakin di bawah sana ada jenis ikan baru juga, makanya aku ke sini, mau coba peruntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "Dulunya aku punya teman mancing, tapi dia cerita sering dengar suara nyanyian aneh. Dia amat sangat ketakutan sampai tidak berani balik lagi ke sini. Ck, padahal dia cuma setengah Bani Bulan Embun, tapi rewelnya sudah kayak anak totok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Maaf ganggu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Santai, toh memang lagi tidak ada ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
