						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Aneh sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Kalian lihat itu? Pohon ini barusan tiba-tiba bersinar, dan ada benda-benda kecil ini ... Sayangnya bukan ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Jadi yang di tengah itu akarnya ya? Entah kenapa, sekarang dia jadi berkilauan gitu. Lebih bagus ketimbang waktu dia berwarna kusam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Kamu menceritakan pengalamanmu sebelumnya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Sulit dipercaya ... tapi kalian tidak perlu mengarang cerita bohong untuk menipuku. Sepertinya apa yang dikatakan temanku yang setengah Bani Bulan Embun itu memang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Tapi tidak masalah, mereka hanyalah bayangan dari masa lalu. Tidak peduli lagu apa yang mereka nyanyikan, atau apa yang mereka katakan, juga tidak akan mengganggu kita yang masih hidup untuk memancing ikan yang masih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "Kalian juga pemburu harta? Yang kalian pungut tadi itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "Oh, jadi ini yang namanya <color=#00E1FFFF>Bukti Cognoscenti</color>? Kok kayak bulu biasa sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Ada pedagang kenalanku yang bilang kalau kita mengumpulkan lima <color=#00E1FFFF>Bukti Cognoscenti</color>, kita akan dapat petunjuk lokasi \"Harta Karun Maha Besar\" di timur bulan dan di barat matahari. Entah benar atau omong kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Tapi banyak pemburu harta yang percaya. Mereka gila-gilaan mengejar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "Ya-Yah, namanya juga harta karun! Paimon juga penasaran sih ... agak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Kalau usiaku dua puluh tahun lebih muda ... Ah, tidak. Umur segitu pun pasti lebih pilih mancing di sini. Ck, satu hari berlalu, satu lagi ember kosong dibawa pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}