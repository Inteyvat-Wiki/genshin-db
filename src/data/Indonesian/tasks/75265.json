			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "Hei! Teman, aku punya barang bagus dengan harga yang bagus, mau lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Eh? Ini bukannya boneka Koholasaurus? Kayaknya Paimon pernah lihat di Pasar Angin Sepoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Benar sekali! Tapi hargaku lebih murah, cuma setengah harga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Kok bisa murah begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Hehe, kamu tidak perlu khawatir soal itu. Aku punya caraku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Memang lebih murah sih, tapi rasanya warna boneka ini agak aneh. Jangan-jangan ini barang palsu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Palsu? Dasar bocah tidak tahu apa-apa ... pergi sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Pergi sana! Aku tidak mau jual ke kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
