			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "Wow. Laut di sini cantik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620102,
					"content": "Eh? Dihua Marsh bukan laut dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Airnya terhubung ke laut juga sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Hmmm, benar juga ... tapi aneh ah, kalau Dihua Marsh disebut laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Hmm ... tidak paham. \"Lautan\" dan \"bukan lautan\". Bedanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620106,
					"content": "Rasa airnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "Oooh! Air di hutan agak manis, jadi bukan laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620108,
					"content": "Tapi kalau Cider Lake isinya sider semua, jadi termasuk apa dong ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Termasuk tempat favorit Venti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Tapi di samping masalah itu. Hanya perasaan Paimon saja atau Kichiboushi jadi lebih pintar ngomong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Menurut kata-kata Ioroi sebelum ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "Apa ya kata Ioroi? \"Aku adalah Ioroi, bake-danuki yang menggetarkan langit dan bumi!\" ... Eh, bukan, bukan yang itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "\"Hu-hmm... aku mau garuk perut\", \"AH!\" Hmm, beda sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Ha-he-ho, Paimon pintar tiru. Lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620126,
					"content": "\"Semakin kalian terbiasa dengan auranya, semakin kalian mengerti omongannya.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "Oh iya, benar! Semakin terbiasa kita dengan aura Kichiboushi, semakin mudah kita mengerti kata-katanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#Dan latihan! Jalan sama {NICKNAME} dan Paimon, Kichiboushi belajar banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620129,
					"content": "Paimon kan pemandu terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Eh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Kamu masih ingat kata-kata itu ya, {NICKNAME}? Senangnyaaa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#Em! Terima kasih, Paimon dan {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620136,
					"content": "Tempat \"entah-laut-atau-bukan\" ini cantik sekali. Rumah yang sangat amat tinggi di belakangnya juga cantik. Bantu Kichiboushi ambil foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620137,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Partner yang bertualang bersama, akan tumbuh bersama juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Em! Partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620135,
					"content": "Partner perjalanan terbaik yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Sebelum kita pergi, Ioroi ada bilang sesuatu tentang ini kan ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "Lautan adalah perairan luas yang ada di luar daratan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Wow, itu definisi yang ... serius sekali ya. Tapi berarti bisa dibilang masalah \"perbatasan\" ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#Tadi {NICKNAME} bilang kalau Dihua Marsh terhubung ke laut. Jadi apa bedanya batas \"daratan-daratan\" dengan \"bukan daratan-daratan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620113,
					"content": "Sepertinya jawaban seriusmu tadi tidak membantu menyelesaikan masalah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Semua konsep ini dibuat oleh manusia. Tidak ada artinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Kalau Dihua Marsh merasa dia itu laut, ya berarti dia itu laut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Kalau Kichiboushi merasa diri Adeptus, artinya Kichiboushi Adeptus, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620117,
					"content": "#Hei! Jangan dengarkan dia, Kichiboushi. Kamu bicara apa sih, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "Meskipun sedikit aneh, tapi sebenarnya masuk akal juga sih. Kamu bisa jadi bake-danuki apa pun yang kamu mau, Kichiboushi! Siapa tahu, mungkin suatu hari kamu bisa jadi Adeptus tanuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "Adeptus tanuki! Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
