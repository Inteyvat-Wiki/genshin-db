					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Hu-hmm ... Kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620302,
					"content": "Aduh, Kichiboushi! Kenapa tiba-tiba kamu menerjang markas Hilichurl-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Kukira kita bisa ... bermain bersama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620304,
					"content": "Eh? Kenapa begitu? Hilichurl itu monster bahaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Yah, tidak bisa dibilang berbahaya juga sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "Hei! Kichiboushi kan tidak jago bertarung sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620309,
					"content": "Hmmm, waktu kita pertama bertemu di Chinju Forest ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "Benar juga! Bukannya kamu menyamar jadi benda mati sambil dikelilingi sama Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620311,
					"content": "Waktu pertama bertemu ... pertama bertemu ... Aku berpikir ... Oooh, benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620312,
					"content": "Waktu itu, main petak umpet sama Hilichurl. Hilichurl di hutan tidak menyerang bake-danuki. Sering main bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620313,
					"content": "Eh? Jadi hubungan kalian baik-baik saja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620314,
					"content": "Tidak tahu kenapa Hilichurl-nya begini. Hmmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620315,
					"content": "Bagaimanapun juga, harus hati-hati ya di sini! Meskipun Hilichurl saja ... Eh, terutama di dekat Hilichurl ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620316,
					"content": "#Duh, jadi bikin bingung. Kamu saja yang jelaskan, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620317,
					"content": "Kamu harus bisa membedakan orang jahat dan baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "Benar! Begitu caramu melindungi diri sendiri nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620319,
					"content": "Tapi jangan lupa selalu bersikap baik dan terbuka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "Yap, benar sekali! Dengan begitu kamu bisa lebih menikmati hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620321,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME} dan Paimon bicara hal sulit. Kichiboushi tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620323,
					"content": "Tapi Kichiboushi tahu kalian orang baik. Jadi Kichiboushi belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620324,
					"content": "#Baiklah, sudah cukup deh. Sekarang saatnya belajar memancing dari {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620325,
					"content": "Em! Memancing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620307,
					"content": "Benar, sangat berbahaya banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620308
					]
				},
				{
					"id": 722620308,
					"content": "Hei, jangan ditakut-takuti begitu juga!",
