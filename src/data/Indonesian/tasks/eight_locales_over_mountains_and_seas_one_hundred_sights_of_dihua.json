						722620617
					]
				},
				{
					"id": 722620617,
					"content": "Susah ... tapi Kichiboushi paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620618
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620618,
					"content": "#Bermain bersama {NICKNAME} dan Paimon seru sekali ya. {NICKNAME} dan Paimon adalah teman baik Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620619
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620619,
					"content": "Latihan itu seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620620
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620620,
					"content": "Oh ya. Ngomong-ngomong, tujuan Ioroi kan membawa Kichiboushi ke delapan tempat untuk berlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620621,
					"content": "Dragonspine, Guyun Stone Forest, Mondstadt, Pelabuhan Liyue, Mt. Hulao ... Sebentar lagi latihanmu sudah selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620622,
					"content": "Hmm, benar ya ....",
