			"dialogs": [
				{
					"id": 722620201,
					"content": "Sudah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "Selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "Oh, begini saja! Kichiboushi, kamu pernah memancing ikan tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "Memancing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620205,
					"content": "Sepertinya belum ya. Oke, kalau begitu ayo kita ke tepi airnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
