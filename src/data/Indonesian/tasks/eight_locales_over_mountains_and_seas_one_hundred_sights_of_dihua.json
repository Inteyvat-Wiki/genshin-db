						722620613
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620613,
					"content": "#Benar, tapi kalau kamu belajar memancing, siapa tahu kamu bisa ketemu teman baru. Benar kan, {NICKNAME}?",
