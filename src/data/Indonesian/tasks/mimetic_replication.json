			"dialogs": [
				{
					"id": 736920101,
					"content": "Ah, halo, Pengembara. Sepertinya kamu datang untuk ikut Gala Kebijaksanaan, ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "Kalau memang tertarik, apa kamu mau mencoba permainan kecil yang dibuat Darshan Amurta kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "Permainan apaan tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Darshan kami telah membuat permainan kecil yang dinamai \"Replika Biomimetik\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "Dalam permainan ini, aku akan menjelaskan kebiasaan-kebiasaan dari hewan tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Tentu saja, kebiasaan teratur ini sudah dipersingkat dan digeneralisasi agar lebih mudah dimengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Yang perlu kamu lakukan hanyalah memakai model yang sudah kami siapkan untuk meniru gerakan hewan yang sesuai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Kedengarannya sih mudah sekali ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Memang. \"Hewan memiliki kebiasaan yang teratur\" adalah kalimat yang mudah dimengerti dan diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Tapi di balik kalimat yang kedengarannya sederhana ini, ada misteri tak terbatas yang belum terungkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Tapi, selama masa ini, kita kesampingkan dulu pengamatan akademik untuk sesaat dan menikmati kebiasaan teratur dari hewan-hewan dengan santai dan rileks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Aku mau coba main sebentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Baik. Kalau begitu silakan ke sebelah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "Aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Tidak masalah. Stanku buka setiap saat, jadi kamu bisa datang main kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Rasanya sih tidak susah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}