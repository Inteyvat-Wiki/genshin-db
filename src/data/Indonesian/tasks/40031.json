	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "Halo, Pengembara. Kamu datang tepat waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310102,
					"content": "Ooh, Paimon yakin pasti ada sesuatu lagi nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "Benar, biar kutebak. Kamu pasti mau bilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "Mm, memang seperti yang diharapkan dari petualang yang berpengalaman. Seperti yang kamu bilang: kami memang punya misi baru yang cocok untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310106,
					"content": "Kantor Detektif Bantan Sango sedang membutuhkan bantuan, dan mereka secara spesifik meminta bantuanmu dalam menyelidiki \"hilangnya banyak hewan kecil dalam skala besar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310107,
					"content": "Eh? Hanya hewan-hewan kecil saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#Aw, ayolah. Apa kamu yakin hal sepele begini saja perlu {NICKNAME} buat turun tangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "Tidak masalah, aku bahkan pernah jadi kurir makanan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "Sebenarnya, bukannya Bantan Sango itu kantor detektif ya? Kenapa mereka perlu bantuan petualang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "Jadi situasinya begini: Sango meminta petualang yang sangat berpengalaman untuk menemani Ryuuji pada sebuah penyelidikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310115,
					"content": "Lalu ... Hmm, Sango minta aku bilang begini:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310116,
					"content": "\"Banyak hewan peliharaan milik orang-orang hilang, sehingga kami menjadi kebanjiran komisi. Jika hal ini bisa diselesaikan, maka dijamin akan mendapatkan hadiah yang berlimpah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310117,
					"content": "#Dia bilang \"hadiah yang berlimpah\" ...! Hmm, eh {NICKNAME}, menurut Paimon kayaknya hewan-hewan ini harus diselamatkan deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "Lagi pula, misi kecil dan besar itu berguna untuk meningkatkan kemampuan diri kita, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Paimon, kamu gampang sekali ditebak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Terserah deh~ Ayo kita segera cari Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "Tidak masalah, aku bahkan pernah jadi tukang perbaiki gerobak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "Yah, tidak masalah sih, aku bahkan pernah mengalahkan Stormterror ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "Bagimu mengalahkan Stormterror itu masalah sepele? Wow ... kamu memang hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310104,
					"content": "Ada misi baru untukku, ya kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "Bagus. Kamu tiba lebih cepat dari perkiraanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310203,
					"content": "Tentu saja! Kami datang ke sini setelah mendengar tentang hadi— Eh, tentang hewan-hewan yang hilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310204,
					"content": "#Oke. Jadi masalahnya kenapa? Jangan takut, Paimon dan {NICKNAME} ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310205,
					"content": "Ayolah, kita berdua tahu siapa yang akhirnya akan mengerjakan semuanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "Paimon akan menyemangatimu! Itu juga termasuk bekerja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310207,
					"content": "Bersemangat sekali ya seperti biasa. Baiklah, jadi masalahnya begini. Akhir-akhir ini kami telah menerima banyak komisi mengenai hewan-hewan yang hilang. Sehingga efeknya adalah tentu saja kami harus menemukan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310208,
					"content": "Mereka pada umumnya adalah binatang peliharaan, jadi artinya mereka seharusnya tidak kabur dengan sendirinya seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310209,
					"content": "Inazuma memang mempunyai banyak cerita aneh. Tapi semuanya terjadi karena suatu alasan, dan tidak ada yang tidak bisa diselesaikan dengan logika. Penyelidikan kami di tempat kejadian perkara sudah membuktikan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310210,
					"content": "Ayolah, kita berdua tahu siapa yang akhirnya akan mengerjakan semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310211,
					"content": "Ehe, sepertinya Paimon harus menyemangatimu juga, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "Apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310213,
					"content": "Terima kasih atas tawarannya, tapi tidak usah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310214,
					"content": "Aku mengikuti jejak hewan yang hilang dalam beberapa hari terakhir, dan menemukan lebih dari satu perkemahan. Ada beberapa yang dijagai monster, tapi bukan masalah besar kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310215,
					"content": "Namun, saat aku ingin melepaskan salah satu hewan yang terjebak di salah satu perkemahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310216,
					"content": "Hewan itu diambil oleh \"bayangan hitam yang muncul tiba-tiba\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310217,
					"content": "Saat aku terbangun, perkemahan itu benar-benar kosong seperti kuburan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310218,
					"content": "Ck, sepertinya ini tidak baik buat Ryuuji. *huff* Apa yang terjadi pada Ryuuji yang pernah mengaum seperti oni Torachiyo saat dia mengalahkan pelaku dari insiden \"Sanbongatana Kinpachi\" tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310219,
					"content": "Lalu dia memelukku erat-erat saat aku berpura-pura mati, menangis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310220,
					"content": "Tunggu, berhenti! Berhenti kataku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310221,
					"content": "Oh, ayolah! Apa yang terjadi selanjutnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310222,
					"content": "Ayo kita selesaikan dulu masalah ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "Apa pun masalahnya, kami dari Bantan Sango membutuhkan bantuan dari petualang hebat sepertimu untuk membantu kami menyelamatkan hewan-hewan tersebut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310228,
					"content": "Kalau kamu ada di sana, kami jadi ada saksi walaupun Ryuuji pingsan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310229,
					"content": "Uh, Sango, kenapa kamu tidak pergi sendiri saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310230,
					"content": "Ah, ah, jangan lupa. Aku adalah otak dalam kelompok kita ini. Itu adalah tugasku — menggunakan otakku. Jadi menurutku, tubuhku ini cuma aksesori saja bagi otakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310231,
					"content": "(Wow, pemalas sekali, pintar berkelit lagi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310232,
					"content": "Tentu saja, kamu tidak akan bekerja dengan gratis. Kamu akan dibayar, sesuai dengan yang dijanjikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310233,
					"content": "Itu yang mau Paimon dengar! Ayo, kita berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310234,
					"content": "Ah, Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Tunggu dulu. Tolong bawalah ini bersamamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310237,
					"content": "Loh? Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310238,
					"content": "Ini adalah <color=#00E1FFFF>Ubiquity Net</color>. Aku meminta seorang teman untuk membuatnya berdasarkan catatan dari Kamuna Onmyoudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310239,
					"content": "Memang sih jaring ini tidak cukup kuat untuk menangkap kriminal, tapi kalau kamu bisa membidiknya, seharusnya sih tidak masalah kalau cuma untuk menangkap hewan-hewan kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310240,
					"content": "Dengan ini, membawa kembali hewan-hewan yang hilang akan menjadi perkara mudah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310241,
					"content": "Wuhuuu! Jadi gampang deh! Terima kasih, Sango, kamu memang yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310242,
					"content": "Ah itu bukan yang \"terbaik\" kok. Anggap saja ini \"sebuah asuransi untuk menghindari kegagalan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310243,
					"content": "Ryuuji, pergilah bersama mereka, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310244,
					"content": "Baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310245,
					"content": "Aku sudah menemukan beberapa jejak dari hewan-hewan yang hilang tersebut. Ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310246,
					"content": "Oke, ayo berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310247,
					"content": "Terima kasih, Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Paimon ahli sekali dalam urusan menyeret orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "Iya, apa yang terjadi selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "Oh ho, apa kamu tertarik dengan kasus yang terjadi sebelumnya? Jadi sebelumnya, polisi baik hati yang bernama Kinpachi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310225,
					"content": "To—Tolong, ayo kita kembali fokus ke masalah yang ada sekarang saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310226,
					"content": "Baiklah, oke. Maaf ya, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003103,
			"completionStepIds": [
				4003103
			],
