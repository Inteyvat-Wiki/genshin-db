			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "Berdasarkan penyelidikan kita sekarang, seharusnya ini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Heh, benar-benar ada banyak sekali hewan-hewan kecil di sini. Apa mereka semua hilang begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "Terus ini ... seekor anjing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "Apa ada seekor anjing yang menjaga tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "Hah, ya jadi begitu. Mm ... Ini memang memalukan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "Eh? Malu kenapa, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "Anjing ini adalah \"bayangan gelap\" yang mengalahkanku dalam sekali pukul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "Jangan khawatir, mungkin anjing itu memang benar-benar kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Tidak perlu ... menghiburku begitu. Memang kemampuanku kurang kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Tetap saja, posturnya yang tegak dan terlihat penuh dengan aura kebanggaan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Heh, sepertinya mengingatkanmu pada seseorang, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Benar. Komore Teahouse ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Betul itu! Paimon juga ingatnya sama dia! Awalnya malah kita kira dia bisa ngomong, tapi ternyata enggak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "Maksudmu pemilik Komore Teahouse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "Ryuuji kenal sama dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "Kurang lebih iya. Mereka memang mirip sih. Tapi sebaiknya kita jangan lengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Taroumaru dikenal sangat ramah karena banyak berurusan dengan manusia. Tapi untuk anjing ini, kita tidak tahu apa-apa tentangnya. Karena itu, aku menyarankan untuk tetap waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Mm, omongan Ryuuji masuk akal juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "Aku bicara dari pengalamanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Tapi kenapa anjing ini mengumpulkan banyak sekali hewan buat jaga tempat ini? Paimon enggak paham deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "Kita membutuhkan lebih banyak petunjuk untuk memecahkan misteri ini. Untuk sekarang, ayo fokus dulu menyelamatkan hewan-hewan ini. Pemilik mereka sudah mulai panik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#Di sini saatnya kamu beraksi, {NICKNAME}. Setelah kamu menemukan hewan-hewan tersebut aku akan menangani sisanya. Kujamin mereka pasti akan segera tiba di rumah mereka masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "Kamu tidak mau bantu kami dan serang bersama-sama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Kita kan masih tidak tahu apa musuh ini bisa dikalahkan dengan \"menyerang bersama-sama\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "Sebenarnya, kamu tidak punya pengalaman dalam \"berjalan sembunyi-sembunyi\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Yah, dulu sewaktu kami mencoba untuk mencuri Holy Lyre der Himmel ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "Itu ... benar-benar pengalaman yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "Meskipun demikian, kita harusnya bisa menyelamatkan hewan-hewan itu jika kita bisa menghindari penjaga dengan aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "Aku sudah menaruh beberapa objek yang bisa menarik perhatian mereka. Kuharap benda-benda itu bisa berguna untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Baiklah. Ayo kita beraksi. Aku akan berjaga-jaga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "Kami berhasil menghindari orang-orang yang ingin menangkap kami di Rite of Descension ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Kami pernah membuntuti seorang pegawai pemerintah di Ritou ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Taroumaru",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Jadi kamu payah ya, Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "Hei! Anjing itu kuat sekali tahu! Paimon juga pasti tidak akan menang melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
