				{
					"id": 400310501,
					"content": "Bagus sekali! Kamu benar-benar bergerak dengan spektakuler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310502,
					"content": "#Hehehe! Ini sih gampang banget buat {NICKNAME}, masa kamu tidak tahu sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310503,
					"content": "Baiklah. Ayo kita menuju target selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310504,
					"content": "Tunggu. Masih ada lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310505,
					"content": "Masih. Kalau dilihat dari jumlah komisi yang Sango terima, kurasa ini adalah kasus hewan hilang paling parah di sepanjang sejarah Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310506,
					"content": "Namun tetap saja, walau tanpa adanya sejarah yang membuktikannya, kasus hilangnya hewan-hewan kecil sebanyak ini dalam sekali waktu memang benar-benar tidak normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310507,
					"content": "Aku memang mengikuti jejaknya sampai ke area lain, dan aku menemukan ada hewan-hewan yang terjebak di sana juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310508,
					"content": "Apa perlu sembunyi-sembunyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "Yang ini tidak usah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310510,
					"content": "Musuh di sana seharusnya bukan tandinganmu. Kamu akan tahu setelah tiba di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
