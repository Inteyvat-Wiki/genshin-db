				"points": []
			},
			"dialogs": [
				{
					"id": 400315101,
					"content": "#Apa kamu perlu sesuatu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315102,
					"content": "Tentang Ubiquity Net ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Ah, itu ya. Sebenarnya tadinya aku mau memberikannya untuk digunakan oleh Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315104,
					"content": "Memang kamu pikir pekerjaan kita tidak bahaya? Ryuuji sudah terluka berkali-kali sebelumnya. Jadi aku pikir — bagaimana cara memperluas jangkauan di mana kita dapat menangkap penjahatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315105,
					"content": "Aku membaca banyak buku-buku tua yang menuliskan desain jaring ini, bahkan memintaku temanku membuatnya. Pada akhirnya, bagaimanapun juga, \"menangkap hewan-hewan kecil\" itu adalah yang terbaik yang bisa dilakukan oleh jaring ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315106,
					"content": "Tapi apa pun masalahnya, jaring itu bisa berguna di tanganmu, jadi itu hal yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315107,
					"content": "Kamu tahu tidak, aku penasaran tentang apa yang terjadi dengan Sanbongatana Kinpachi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "Ooh, jadi kamu penasaran soal itu? Yah, jadi begini ceritanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315109,
					"content": "Sebenarnya sih ... ah sudahlah. Kalau Ryuuji tidak mau aku mendiskusikan masalah itu, aku akan menahan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315110,
					"content": "Aku harus pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003152,
