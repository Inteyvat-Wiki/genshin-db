			},
			"dialogs": [
				{
					"id": 400315201,
					"content": "Serahkan saja hewan-hewan yang sudah kalian temukan itu padaku. Aku pasti akan membawa mereka ke rumah dengan segera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315202,
					"content": "Tentang Bayangan Hitam ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "Aku dengar ada organisasi rahasia yang melatih ninken, atau bisa disebut juga anjing ninja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "Mereka bilang ada seekor ninken, dengan nama Inujin, menghancurkan banyak monster yang mengancam Inazuma dalam bayang-bayang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "Tentu saja, itu cuma legenda. Namun, aku jadi penasaran apa Bayangan Hitam ini adalah ninken yang legendaris itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315206,
					"content": "Sudahlah. Aku seharusnya tidak beralasan begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315207,
					"content": "Tentang objek pengalihan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "Aku gagal menyelamatkan para hewan selama penyelidikannya, tetapi masih punya waktu untuk menempatkan beberapa perangkat asap di area tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315209
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315209,
					"content": "Kalau kamu aktifkan mekanisme ini, harusnya kamu bisa mengalihkan perhatiannya untuk sementara waktu. Kuharap itu bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315210,
					"content": "Aku akan segera kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315211
					]
				},
				{
					"id": 400315211,
					"content": "Bagus, terima kasih. Aku akan berjaga-jaga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		}
