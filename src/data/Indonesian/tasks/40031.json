			"dialogs": [
				{
					"id": 400310801,
					"content": "Terima kasih banyak atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310802,
					"content": "#Benar kan! {NICKNAME} memang yang terkuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310803,
					"content": "Apa jumlah hewannya sudah sesuai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310804,
					"content": "Tunggu dulu ... Hah, masih ada yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310805,
					"content": "Hah? Tapi bagaimana mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310806,
					"content": "Menurutku ini masih cukup oke. Kita tidak dikalahkan oleh si Bayangan Hitam, lalu kita juga berhasil mendapatkan kembali cukup banyak hewan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310807,
					"content": "Karenanya, penyelidikan kita bisa dibilang mengalami kemajuan. Kita cuma kekurangan petunjuk saja sementara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310808,
					"content": "Begini saja. Aku akan terus menyelidiki. Kalian boleh lakukan apa yang biasanya kalian lakukan untuk sementara waktu ... Nanti setelah ada petunjuk baru kita bertemu lagi di Kantor Detektif Bantan Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310809,
					"content": "Yah, toh kita tidak punya pilihan lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003151,
