					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "Kalau dia mau main licik, kita juga bisa!",
