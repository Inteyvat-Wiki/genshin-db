					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Kalau sudah kenyang, siapa tahu dia bakal jadi jinak terus kasih jalan buat kita, dapat deh hartanya! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Mau dikasih makan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Paimon mikir dulu! Saurian di sini kan biasa makan segala ya, tapi Paimon enggak yakin Yumkasaurus doyannya apa ... Kalau dilihat dari warnanya, kayaknya dia biasa makan daun atau rumput-rumputan gitu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Ayo kita coba cari yang begitu terus coba kasih ke dia! Kalau sudah lapar kan biasanya apa juga dimakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
