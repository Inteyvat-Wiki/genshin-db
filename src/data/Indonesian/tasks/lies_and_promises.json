			"dialogs": [
				{
					"id": 750220801,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Hehe, bagus! Sekarang coba kita lihat di dalam peti ada harta apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Eh? Kok enggak ada apa-apa? Cuma selembar kertas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "Oh, jadi yang ninggalin kertas ini pemiliknya ya? Jadi kita bukannya lagi dikerjain sama si Saurian tapi sama pemiliknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Benar-benar tidak bertanggung jawab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Iya! Kalaupun dia lagi sakit, kok tega sih ninggalin Yumkasaurus di tempat kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Dan kalaupun dia mau manfaatin keserakahan orang-orang ... Eh, enggak, tapi dia mau manfaatin empati orang-orang pada Saurian ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*huff* Yah, tapi tetap saja kita enggak bisa biarin dia tetap di sini buat nipu orang-orang demi makanan. Ayo kita cari kepala suku Tirai Daun terus kasih tahu dia soal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Kalian menjelaskan situasinya kepada Wayna, kepala suku Tirai Daun, dan membawanya kemari.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "Duh duh ... Aku sudah punya firasat waktu kalian mencariku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Tidak kusangka ternyata Saurian inilah yang ditinggalkan oleh \"dia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "\"Dia\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Dia itu orang yang melakukan kesalahan, tapi karena takut dihukum, akhirnya dia meninggalkan suku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Tapi, aku tidak akan membahas tentang namanya lagi. Mungkin dia juga merasa ini bukan hal yang perlu dibanggakan. Coba lihat, dia tidak meninggalkan nama di akhir suratnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Rupanya Saurian-nya memilih untuk mengikutinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Tidak, tidak bisa dibilang \"memilih\". Karena Saurian itu makhluk yang polos, mereka tidak bisa membedakan mana yang baik dan yang benar. Pada sebagian besar kasus, mereka mengandalkan naluri untuk memercayai rekannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "Ternyata benar, sulit untuk mengubah sifatnya. Dari kecil dia suka menggunakan kepintarannya untuk menipu orang lain. Menipu orang lain dengan cara ini, bahkan Saurian-nya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Kami akan kirim orang untuk memberi makan Yumkasaurus ini secara berkala, soalnya dia itu anak suku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Kalau soal \"dia\" ... Duh ... Benar-benar akhir yang menyedihkan. Tapi aku tidak perlu kasihan kepadanya, manusia memang seharusnya bertanggung jawab atas tindakannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Jadi kalau makan kebanyakan, nanti bisa ditinggal sama temannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Hei! Bercandanya enggak lucu ya! Lagian Saurian ini enggak salah apa-apa, mungkin dia nungguin pemiliknya balik ke sini, makanya dia enggak mau gerak sama sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
