			"dialogs": [
				{
					"id": 750220703,
					"content": "Yumkasaurus tersebut langsung melahap semuanya secepat kilat.\\nKamu bahkan hampir tidak bisa melihat apa yang barusan terjadi ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Di-di-dia bisa makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Paimon dapat saingan nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Kalau cuma seporsi ... kayaknya kurang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Kamu ngomong apa sih! Paimon itu penikmat makanan sejati, benar-benar dinikmati dan enggak bakal langsung main hantam kayak gitu ... Kalau langsung dilahap gitu sih, enggak dinikmati dong namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#I-Iya! Paimon rasa juga gitu, dia ini kayaknya \"Doyancamilansaurus\" ... untung {REALNAME[ID(2)|SHOWHOST(true)]} makannya enggak banyak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Tapi mungkin dia kelaparan! Kasihan banget, yuk kita kasih makan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Gwoawww ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} mau makan juga? Kasih dia Sauropal dulu, terus nanti kita bikinin yang lebih enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Saurian yang kelaparan itu pun memakan semuanya sekali telan.\\nKamu berkedip tak percaya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Oke, sekarang harusnya dia sudah kenya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Hei! Bentar, kok kamu masih mau sikat lagi makanannya? Masa dua porsi belum cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Wow, sehabis makan langsung tidur halangin gua? Dia kayaknya enggak niat buat minggir sama sekali ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Gimana nih, {NICKNAME}? Paimon enggak habis pikir ... kalau misal mau tidur siang sehabis makan, ya setidaknya jangan ngehalangin lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Kurasa dia enggak bakal pindah deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Kayaknya kita dikerjain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Ughhhhh! Mana dia makan banyak banget lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Si {REALNAME[ID(2)|SHOWHOST(true)]} saja enggak tahan! Ayo, {NICKNAME}, bangunin dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
