					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "Jadi dia sengaja halangin jalan buat dapat makan? Nipu orang buat dapat makanan ... kita dikerjain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "Hmph! Kalau gitu caranya, kita enggak usah baik-baik sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#Biar si {REALNAME[ID(2)|SHOWHOST(true)]} yang gali terowongan sampai ke peti harta karunnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
