			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "Entah mesin ini bisa membuat camilan manis atau tidak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010102,
					"content": "Apa yang mau kamu buat kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "Kebetulan sekali kamu datang, Pengembara. Diriku baru saja terilhami akan hidangan selanjutnya — sebuah puding. Seperti itulah sebutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010104,
					"content": "Sebelum memutuskan hidangan ini, diriku sudah melakukan banyak penelitian dengan resep-resep terbaru dan populer. Katanya hidangan ini lembut dan enak — sebuah makanan penutup yang enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010105,
					"content": "Diriku tentu saja sudah membuat perubahan dan penambahan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010106,
					"content": "... Seperti menambahkan Rice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010107,
					"content": "Tentu saja diriku berhak untuk menamai masakan baru ini. Hmm... \"Rice Pudding\" akan menjadi nama hidangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010108,
					"content": "Kedengarannya sangat mengenyangkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "Kualitas Rice adalah kunci dari hidangan ini. Diriku mengaktifkan Supreme Cuisine Machine, lalu mesin tersebut pun mencari Rice berkualitas tinggi. Hasil pencariannya membuat diriku tiba ke tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010110,
					"content": "Pengembara, karena kamu berada di sini, sudikah kamu membantu diriku mengumpulkan Rice berkualitas tinggi? Mesin ini menunjukkan kalau Rice itu berada tidak jauh dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010111,
					"content": "Kok aku lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "Mesin ini perlu dirawat dan diriku tidak bisa memisahkan diri agar bisa berada di dua tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010114,
					"content": "Kamu sangat terampil dalam pikiran dan tindakan, dan karena itulah, kamu adalah asisten yang sangat membantu. Pergilah bantu diriku, dan diriku berjanji kalau kamu juga akan mendapat bagian Rice Pudding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010115,
					"content": "Kalau begitu diriku mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010116,
					"content": "Supreme Cuisine Machine ... menyala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010117,
					"content": "Pengembara, diriku sudah mengaktifkan mesin ini. Ikutilah jejak yang dibuat mesin ini dan ambillah Rice yang diriku inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010112,
					"content": "Bukannya kamu bisa terbang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "Terima kasih! Kalian telah menyelamatkan hidupku... Namaku Brunn, aku seorang pedagang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010202,
					"content": "*huff* Benar-benar sial... Aku awalnya sedang mengangkut barang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010203,
					"content": "Tapi... Tidak kusangka aku diserang monster di perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010204,
					"content": "Aku terus berlari ke depan, tidak sempat perhatikan barang-barang di kereta, dan bahkan tidak melihat arah lariku... sampai akhirnya tiba di tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010205,
					"content": "Setelah lari sampai ke sini, kukira aku sudah berhasil lolos dari mereka. Karena itulah aku berniat turun dari kereta dan memeriksa barang-barangku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010206,
					"content": "Tapi mereka tiba-tiba muncul entah dari mana... Terima kasih atas bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010207,
					"content": "Barang-barang apa saja yang kamu angkut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "Aku mengangkut setumpuk bahan makanan, beras dan sejenisnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010209,
					"content": "Sepertinya beras yang dimaksud adalah Rice yang diinginkan Adeptus. Tapi sepertinya sudah tersisa sedikit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705010210,
					"content": "Bisakah kamu menjual Rice kepada kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "Kamu mau membeli Rice? Bukannya aku tidak mau menjualnya, tapi... Hampir semua barang angkutan di keretaku terlempar ke jalan waktu aku lari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010212,
					"content": "Monster-monster itu pasti membawa barang-barang itu sebagai hasil jarahan dan kembali ke perkemahan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010213,
					"content": "Aku sekarang juga pusing. Bagaimana caranya mendapatkan barang-barang itu kembali? Kalau tidak aku akan rugi besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010214,
					"content": "Pengembara, dari posturmu, kamu kelihatan sangat cekatan. Bisakah kamu membantuku mengambil kembali barang-barang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010215,
					"content": "Ka-kalau kamu bersedia membantu, aku akan memberikan Rice sebanyak yang kamu mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010216,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "Terima kasih! Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010220,
					"content": "Bawalah kargo balon udara-ku dan letakkan barang-barang itu di atas balon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010221,
					"content": "Mohon bantuanmu ya, Pengembara. Aku akan menunggumu di sini, setelah kamu mendapatkannya, tolong bawakan kembali padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010218,
					"content": "Kurasa aku tidak bisa membawa barang sebanyak itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "Jangan khawatir, aku punya solusinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "Apa barangnya sudah kamu bawa kembali? Terima kasih, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010302,
					"content": "Kamu mau ... Rice, iya kan? Mohon tunggu sebentar, akan kupilihkan beberapa kualitas yang lebih baik untukmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010303,
					"content": "Selesai! Ini beberapa Rice untukmu, seharusnya cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010304,
					"content": "Sekali lagi terima kasih atas bantuanmu, Pengembara. Aku akan melanjutkan perjalananku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010305
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010305,
