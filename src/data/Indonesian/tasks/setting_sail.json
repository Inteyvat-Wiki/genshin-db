				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Akhirnya kamu sampai juga. Kamu membuatku menunggu, Kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "Dan sepertinya ada penumpang gelap... ah, lebih tepatnya tamu-tamu yang terhormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "Woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Salahkan saja Shogun Yang Mahakuasa. Badai di sekitar Inazuma semakin hari semakin ganas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Meskipun kru kapalku siap menerjangnya, tapi cuaca yang buruk tetap menghambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Sekarang, biar kuperkenalkan. Ini Thoma, mitra dagang yang belum lama kukenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "Heh, entah sudah berapa lama aku menunggu saat bertemu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "Thoma, mereka berdua adalah——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "Tidak perlu diperkenalkan, gaung namanya sudah terdengar sampai kemari. Bahkan badai pun tak bisa menghalangi berita sepak terjang pengembara asing ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Senang bertemu denganmu, Thoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Hehe, bangga sekali rasanya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Ha, kalau beruntung, kabar itu akan jadi permulaan yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma sudah tinggal lama di Ritou. Boleh dibilang kalau dia adalah kepala di daerah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Kalau kena masalah, cari saja dia. Dan kalau dia berani macam-macam padamu, akan kuurus dia nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Hehehe, tidak usah khawatir begitu. Kami pasti akan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "Bagus. Kalau sudah beres, aku pergi dulu. Aku tidak bisa tinggal lama di sini, terutama karena ada buronan di atas kapalku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Oh, benar juga, Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "Sampai jumpa lagi, Pengembara. Ingat, selalu berusaha sebaik mungkin, walau \"badai\" sebesar apa pun menghadang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "Kami pasti bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Selamat berlayar ya, Kapten Beidou! Dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "Baiklah, pertama-tama, kita harus daftar dulu di pos perbatasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110724,
					"content": "Eh, bukannya kita di sini harus diam-diam kan? Kenapa malah ke kantor pemerintah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Haha, jangan meremehkan Dekrit Sakoku. Coba saja, kamu tak akan bisa menghindari pemeriksaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110726,
					"content": "Jadi kita harus taat aturan... meskipun kita cari celah sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110727,
						20110728
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110727,
					"content": "Oh... oke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
