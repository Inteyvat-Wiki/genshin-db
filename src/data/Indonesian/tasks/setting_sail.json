			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "Ad astra abyssosque! Ada yang bisa kubantu, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Tentang cara menuju ke Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah, kudengar Kapten Crux Fleet sudah janji untuk membawa kalian ke Inazuma. Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Rasanya sudah lama sekali sejak aku terakhir kali ke sana. Sayang sekali, aku tidak punya informasi apa-apa yang bisa berguna buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "Ketemu! Kamu Pengembara yang akan diantar Kapten ke Inazuma kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110107,
					"content": "Aku sudah tunggu seharian!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Oh, benarkah? Hehe... Senang bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110110,
					"content": "Kru kami sudah hampir siap. Setelah menghitung jumlah orang, kita bisa segera berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110111,
					"content": "Kapten menyuruhku untuk menjemputmu. Kita angkat sauh setelah kamu naik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110112,
					"content": "Beidou memang orang yang tepat janji ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Tentu saja! Kapten menuntut banyak hal. Kamu bisa melihatnya sendiri nanti di kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110114,
					"content": "Jadi kalian akan segera berangkat? Kurasa aku harus mengucapkan selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Perjalanan kalian mungkin berujung di langit tertinggi atau jurang terdalam. Namun setiap langkah tetaplah sebuah pencapaian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Sampai jumpa lagi, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Ad astra abyssosque, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Oh... Sedih sekali rasanya mau berpisah... padahal biasa ketemu setiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Hehe, kalau kangen, cari saja aku begitu sampai di sana. Aku tunggu di Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Jadi ada Katheryne juga di Inazuma! Kan, kita nggak perlu mellow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Haha, kurasa ini saatnya kalian ucapkan selamat tinggal ke Pelabuhan Liyue. Aku sudah menyampaikan pesanku, jadi aku pergi dulu ya. Kapal kami berlabuh di Guyun Stone Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110125,
					"content": "Oke, terima kasih sudah jauh-jauh kemari ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Cuma melaksanakan perintah. Sampai ketemu di kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sea Drake"
				},
				{
					"id": 20110122,
					"content": "...Sudah kuduga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Kami bakal kangen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Jemputan kita datang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Tentang Crux Fleet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
