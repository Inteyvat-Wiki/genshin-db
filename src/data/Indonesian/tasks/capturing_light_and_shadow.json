			"dialogs": [
				{
					"id": 790501501,
					"content": "Yes! Berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "Para Tetesan Air itu kelihatannya senang, Paimon jadi ikutan senang deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "Kita berhasil melindungi kristal pertemanan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Oke, sekarang teman-teman pelukis itu dan karyanya di Veluriyam Mirage sudah sempurna deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Mungkin suatu hari nanti, pelukis itu akan kembali untuk mengunjungi teman-temannya dan melihat karyanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Omong-omong, gaya lukisan ini cukup unik ... enggak kelihatan mewah, tapi cantik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "Yang paling penting, Paimon juga bisa ngerti! Mungkin kalau Paimon tiru gayanya ... Paimon juga bakal bisa gambar yang bagus dan bisa dipahami orang-orang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Lukisan yang bagus tidak selalu rumit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "Iya! Kalau kamu oke, kita ambil foto mural ini yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "Jadi Paimon bisa mempelajari lukisannya kapan pun Paimon mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "Siapa tahu kalau Paimon sudah berhasil bikin lukisan yang indah, nanti bakal ada banyak Tetesan Air yang tertarik dan mau jadi teman Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
					"content": "Paimon juga mau belajar melukis seperti ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
