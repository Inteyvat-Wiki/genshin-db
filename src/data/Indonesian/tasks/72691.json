			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#Tuan}{F#Nona}, aku lihat kamu dari tadi mondar-mandir di sekitar sini. Aku yakin kamu pastilah orang yang tahu caranya mengapresiasi keindahan seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910102,
					"content": "Aku ada pertanyan mengenai keelokan. Apakah kamu bersedia membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910103,
					"content": "Ya, mau tanya apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "Aku baru kenal dengan Tuan Lenne sang penyair Mondstadt ini, tapi kami sudah seperti teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910105,
					"content": "Benar kata Tuan Ootomo. Kami baru kenal beberapa hari tapi aku sudah sangat kagum dengan wawasan yang dia punya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910106,
					"content": "Hehe, Tuan Lenne terlalu sungkan. Kami berteman karena puisi, dan ingin menggunakan kesempatan kali ini untuk berkolaborasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910107,
					"content": "Karena Tuan Lenne sudah susah payah datang ke Inazuma, dia ingin menambahkan kearifan lokal ke dalam karyanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910108,
					"content": "Betul. Sayangnya jadwalku sangat padat dan aku tidak sempat jalan-jalan melihat pemandangan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910109,
					"content": "Jadi, apa yang bisa aku bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "Kawan, tema puisi yang ingin kubuat adalah tentang \"nostalgia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910111,
					"content": "Ketika melihat pemandangan di tempat yang jauh dari rumah, orang akan merasa rindu. Karena itu aku ingin menambahkan sesuatu yang melambangkan tempat yang jauh ke dalam puisiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910112,
					"content": "Boleh bantu aku fotokan beberapa tempat yang bisa kujadikan inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910113,
					"content": "Inazuma pasti punya banyak tempat yang pemandangannya sangat khas daerah. Misalnya, kalau membicarakan tentang Mondstadt, orang-orang pasti langsung teringat pada Dandelion, atau Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910114,
					"content": "Ooh, Paimon tahu. Kalau begitu kita foto saja barang-barang khas Inazuma. Harusnya bisa kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726910115,
					"content": "Terima kasih, aku mohon bantuannya ya! Ini aku berikan salinan naskah puisiku yang baru setengah jadi, buat referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910116,
					"content": "Soal berapa lembar foto yang aku butuhkan, <color=#00E1FFFF>4</color> lembar saja cukup, yang penting fotonya beda-beda. Aku juga akan tanggung biaya perjalanan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910117,
					"content": "#{NICKNAME}, permintaan Lenne sudah cukup jelas kan? Yuk, jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
