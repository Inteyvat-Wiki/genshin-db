				},
				{
					"id": 726910302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Bagus sekali! Terima kasih ya. Coba lihat ... Oh, aku sama sekali belum pernah lihat semua ini! Yang ini juga bagus, dan yang ini menarik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "Kawan, fotomu sungguh memberiku banyak inspirasi! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "Aku sudah coba tulis beberapa bait berdasarkan foto-foto tadi. Aku bingung mau pakai yang mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "Aku penasaran, kalau kamu bakal pakai yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
