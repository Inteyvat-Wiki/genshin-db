			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel ... aku mungkin bisa ikut. Tapi aku tak tahu harus gimana siap-siapnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "Gampang. Bawa selai, roti, dan rasa penasaran. Pakai baju yang nyaman, jangan lupa bawa baju ganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Terakhir, siapkan mental. Karena mungkin beberapa barangmu harus dibuang di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Oh, rumit sekali ya sepertinya. Aku juga tidak mau buang-buang barang. Punyaku, aku yang suka, dan itu berharga buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Esnoir terkasih, setelah barang-barang itu pergi, sebagai gantinya kamu akan dapat yang lain lagi yang sama berharganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Percayalah, perjalanan ini akan sangat luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
