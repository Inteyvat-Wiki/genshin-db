					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Aku di sini saja. Supaya ada yang menunggumu pulang dari perantauan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Tapi Esnoir, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Aku kurang pintar. Kurang berani. Tapi Rozel, aku percaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "Aku percaya angin berembus melintasi semak, sungai mengalir melewati danau. Semua akan kembali ke tempat asalnya, seperti lingkaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Mungkin, setelah mengalami begitu banyak perubahan, mungkin keinginan terakhirnya ... adalah untuk kembali ke dirinya yang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Aku akan menunggumu di sini. Di rumah. Seperti yang selalu kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
