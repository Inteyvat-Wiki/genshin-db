			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, kamu ajak berapa kali pun aku tidak mau ikut merantau sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Aku ini temanmu, dan selamanya begitu. Aku tidak benci kamu. Tapi aku ... tidak suka merantau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, merantau itu tidak sengeri yang kamu bayangkan kok. Cuma ya lama di jalan doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Di dunia luar sana banyak bunga yang tidak ada di kampung halaman. Banyak orang yang kita belum pernah kenal, dan bahkan bentuk awannya saja beda loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Aku bukannya sudah kasih kamu biji bunga dari luar ya? Pasti kamu belum pernah lihat bunga yang warna dan bentuknya kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Dia masih biji, mana tahu bentuknya seperti apa kalau belum ditanam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Kalau kamu mau ikut merantau, mungkin kita bisa langsung lihat bunga ini kayak gimana aslinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel ... maaf, aku tidak mau merantau. Tidak ingin jadi Perantau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Mereka semua jadi mikirin terus harga karpet, jadi tidak peduli topinya secantik apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Mereka berubah karena merantau. Aku takut jadi seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Ya memang sih. Tapi apa kamu sudah lihat peta, sampel tanaman, dan buku catatan perjalanan di dalam tas mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Kita ibarat angin yang bertiup melewati semak yang beda, sungai yang mengalir melewati danau ... bertemu hal baru, menjadi beda dari dirinya yang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "Kita berubah karena merantau. Aku juga takut kok, tapi di saat bersamaan, aku bersyukur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Seperti roti yang diolesi mentega di kedua sisinya. Mau sehati-hati apa pun, tetap akan ada satu sisi yang menteganya jadi belepotan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Ya kan tinggal oles menteganya secara terpisah, bisa kasih rasa yang beda juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Ide bagus tuh, kayaknya bisa bikin kenyang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Anda datang juga. Rozel lagi cerita kalau dunia luar itu indah sekali, dan mau ajak aku ikut merantau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Menurut Anda ... apa dunia luar memang seperti yang diceritakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Lumayan, biar menteganya tidak ngotorin tangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
