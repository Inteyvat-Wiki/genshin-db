			"dialogs": [
				{
					"id": 790610601,
					"content": "\"Surat ini ditujukan kepada tetanggaku, teman-temanku, mercusuar, dan bunga kecil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Surat yang Tulisannya Jelek"
				},
				{
					"id": 790610602,
					"content": "\"Aku akan merantau bersama Rozel. Silakan kalau ingin menggunakan ayunan, meja, dan bangkuku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Surat yang Tulisannya Jelek"
				},
				{
					"id": 790610603,
					"content": "\"Semoga bisa berguna ya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "Surat yang Tulisannya Jelek"
				},
				{
					"id": 790610604,
					"content": "\"Tetanggamu, Esnoir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surat yang Tulisannya Jelek"
				}
