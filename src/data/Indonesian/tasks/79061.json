			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>Dunia di dalam</color> sini juga bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Iya. Esnoir tinggal di sini, jelas suka dong ada di sini. Lagian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Di sini banyak teman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Iya! Aku takut kehilangan itu semua, makanya jadi khawatir terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "Semuanya bagus, sangat bagus ... aku tidak mau mereka berubah, juga tidak mau diri ini berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "Tapi ... merantau akan mengubah segalanya. Iya kan, Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Sejujurnya iya. Tapi kamu bukan berarti harus sedih, Esnoir terkasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Baiklah ... baiklah. Aku tahu hatimu, kamu juga tahu hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Aku akan pikirkan lagi ajakannya, keputusannya nanti dulu ... sekarang kita minum teh saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Baiklah, aku akan temani. Jadwal pelayaran berikutnya masih lama kok. Kita pikirin bareng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Banyak bunga cantik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "Dan kue enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
