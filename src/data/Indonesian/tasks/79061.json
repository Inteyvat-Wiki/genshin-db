					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Iya. Ada banyak sekali hal baru di <color=#FFCC33FF>dunia luar</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Betul. Di sana banyak makanan enak dan hal seru, banyak yang menarik, banyak orang hebat juga. Misalnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Ada yang fokus pada esensi keindahan segala sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Benarkah? Wah, padahal aku kira di luar sana orang-orang cuma peduli sama \"harga\", yang ingin pakai topi tapi tidak berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Ini ... yah, anggap saja coklat di kue lah. Rasanya bervariasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Kalau semua cokelat rasanya sama, berarti kuenya juga jadi enggak spesial dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Paimon bisaan ngomongnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Daritadi denger soal ini mulu, ya masa enggak paham-paham. Iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Gitu ya? Aku pikirin lagi deh ... mungkin merantau itu boleh juga ... ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Jangan rusuh, Esnoir. Jadwal pelayaran berikutnya masih lama kok. Kita pikirin bareng yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Paimon sudah beradaptasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Idealisme yang tidak pernah pudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Dan orang-orang yang berani memperjuangkan mimpi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
