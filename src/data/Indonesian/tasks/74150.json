				{
					"id": 741500601,
					"content": "Anak-anakku tidak ada di rumah, makanya kerjaan membersihkan noda di pintu dan belakang rumah jadi menyusahkan. Aku terpaksa minta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
		{
			"id": 7415007,
