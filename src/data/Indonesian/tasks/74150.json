			},
			"dialogs": [
				{
					"id": 741500301,
					"content": "Kalian sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Semuanya sudah kami bersihin sampai kinclong. Molli juga sudah kasih makan kucingmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Benoit, di samping rumahmu ada setumpuk kardus tua yang kotor banget. Itu perlu dibersihkan juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Kardus? Oh, tidak usah. Itu kardus untuk simpan barang-barang yang sudah usang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Ada beberapa perabotan dan barang yang tidak rela kubuang sebelum pindah ke sini. Ditaruh di dalam ruangan juga tidak cocok dengan dekorasi interior ruangan, makanya kutumpuk di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "Aku jarang memindahkannya. Orang-orang yang tinggal di sini juga orang baik, tidak ada orang yang bakal ambil deh. Biarkan saja barang-barang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Tuan Leroy, Tuan Leroy, apa bantuanku berguna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Tentu saja berguna, Molli. Aku akan lebih berterima kasih kalau kamu tidak lupa sampaikan salamku pada orang tuamu waktu pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "Aku sudah siapkan camilan dan uang jajannya. Anak-anak, kemarilah, kalian bagi-bagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "Tidak usah, tidak usah. Aku tidak perlu uang jajan, aku cuma mau elus-elus Nana lagi. Boleh tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Boleh. Pergilah. Hati-hati dengan cakarnya. Setelah puas main, jangan lupa datang ke sini lagi untuk makan camilan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "Ayah ... kenapa Ayah keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Aku kesepian karena anak-anakku tidak menemaniku di rumah. Jadi aku keluar untuk hirup udara segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "Morticia, tuh kamu lihat. Kita baru pergi beberapa hari, tapi Ayah sudah tidak senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Tapi, kalau Ayah tahu hadiah apa yang kita bawa pulang kali ini, dia pasti maafkan kita, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Hadiah? Kalian bawa apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Pasti barang bagus dong, Ayah. Nanti Ayah bisa lihat sendiri. Morticia tahu Ayah suka barang indah dan mahal, makanya dia sengaja pilihkan untuk Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Terima kasih, putriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "Ini sudah seharusnya aku lakukan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "Oh, iya. Kedua tamu kecil ini anak-anak yang datang ke tempatku waktu kalian pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Halo. Ayahku orang yang baik dan suka sekali dengan anak-anak. Baguslah kalau kalian mau menemaninya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Tapi, sekarang aku dan istriku sudah kembali. Jadi harusnya gantian kami yang temani dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Baguslah kalian sudah pulang. Cepat tunjukkan hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "Ayah, ayo kita pulang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Oke, Athos, jangan lupa kasih kedua anak muda ini camilan dan imbalan ya. Mereka sudah bantu aku sapu lantai dan kasih makan Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "Oh, kasih camilan ke gadis di samping itu juga ya. Aku masuk dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Tuan Leroy, Nana sudah izinkan aku elus perutnya loh ... Eh? Ke mana Tuan Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Kamu lagi cari ayahku ya, Nak? Aku menantunya. Anggap saja aku itu anak laki-lakinya. Namaku Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Aku tahu kok artinya menantu, berarti kamu tuh suami dari putrinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Haha, kamu tahu banyak juga, ya. Ayahku sudah pulang duluan. Terima kasih karena sudah temani dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Camilan ini untukmu. Selanjutnya aku dan istriku yang akan temani dia. Kamu tidak datang juga tidak apa-apa kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "Cepatlah pulang. Kamu sudah main di luar selama ini, pasti keluargamu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Tidak, tidak, Paman, aku sama sekali tidak merasa direpotkan kok. Aku juga sudah janjian sama Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Aku pikir dia masih akan butuh bantuanku, misalnya kasih makan kucing, siram tanaman, dan lainnya. Bisa bantu dia saja aku sudah senang sekali! Lain kali aku masih akan datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "Cih, yang seperti ini nih yang buat pusing kepala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Hm? Paman kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "Tidak apa-apa, Nak. Ada hal yang mau kudiskusikan denganmu. Eh, bukan diskusi deh. Aku mau minta kamu lakukan sesuatu untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "Boleh. Hal apa, Paman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Paman akan kasih kamu camilan dan uang jajan. Tapi, nanti kamu jangan datang lagi ke sini, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Kenapa? Apa aku berbuat salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "Tidak. Kamu tidak ada salah apa pun. Cuma tubuh ayahku tidak terlalu sehat. Belakangan ini insomnianya juga sangat parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Demi kesehatan tubuhnya, aku dan istriku berharap dia bisa istirahat di lingkungan yang tenang. Kamu pasti mengerti maksud Paman, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Oh, Tuan Leroy lagi tidak sehat ya .... Aku mengerti. Nanti aku bawakan lebih banyak Bulle Fruit untuknya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Setiap kali aku makan terlalu banyak kue sampai sakit perut, ayah suruh aku kurangi makanan manis dan banyak makan buah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Kalau Tuan Leroy banyak makan buah, dia pasti akan membaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "Huff ... Ya sudahlah, begini saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Untuk dua sobat muda ini, aku yang akan kasih kalian camilan dan imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Selanjutnya, aku akan perjelas maksudku deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "Kata-kataku ini mewakili Keluarga Tuan Leroy. Aku minta kalian tidak datang mengganggu kehidupan kami lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "Meski masih muda, aku yakin kalian paham maksudku. Jadi, tolong jangan datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Ya, begitu saja. Aku pamit dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Kenapa tidak boleh datang lagi? Aneh banget. Jelas-jelas Tuan Leroy itu baik sekali loh, kenapa Paman ini malah tidak izinin kita ke sini lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "Iya tuh! Kata-katanya sih sopan banget, tapi kelakuannya kok enggak berperasaan banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Aku tidak peduli omongan dia deh. Lusa aku masih tetap bakal datang buat ketemu dengan Tuan Leroy. Kalian mau ikutan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Ayolah, datang dong. Nana kan imut sekali, aku masih mau elus-elus dia lagi. Tuan Leroy juga bakal kasih camilan, loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "Iya, kami datang juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Oke janji ya, kita datang buat elus-elus kucing dan main sama Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "Kalau ada waktu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Oke, sampai ketemu lagi lain kali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
