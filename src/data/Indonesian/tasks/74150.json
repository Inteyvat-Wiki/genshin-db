			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Terima kasih, Molli. Mata ungumu yang indah itu bersinar karena kebaikan hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Hehe, serius? Tuan Leroy benar-benar suka boneka yang kubawakan waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Iya, suka sekali. Bonekamu benar-benar imut. Aku bahkan sediakan tempat khusus untuknya di meja makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "Wah, dia pasti senang sekali! Kalau hari ini? Perlu aku papah untuk jalan-jalan, atau ambilkan koran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Kalau tidak bisa baca korannya dengan jelas, aku juga bisa bacakan untuk Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "Ibu bilang setiap hari aku harus melakukan satu hal yang baik. Guru privatku suruh aku mengarang cerita tentang orang baik dan hal baik, harus dikumpulin minggu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "Eh, tapi bukan berarti aku mau bantu karena harus mengarang, ya. Kalau boleh sih, aku tetap berharap bisa bantu Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Haha, tidak perlu. Bantuanmu yang terbesar adalah kalau kamu kasih tahu ke orang tuamu kalau kamu sering main ke tempatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Ya, Tuan Leroy. Aku sudah bilang ke orang tuaku kok, meski sepertinya mereka tidak terlalu senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "Jadi kamu masih akan datang lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Aku akan datang kok. Meski orang tuaku melarang, aku akan tetap datang. Kita kan sudah janjian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Kamu memang anak baik yang menepati janji ya, Molli. Kakek Leroy suka sekali denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "Dua tamuku yang baik hati, selamat datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "*Ehem* Tadi kami enggak mau ganggu pembicaraan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Kami ganggu kalian, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Tidak apa-apa kok. Kalian tidak ganggu apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Teman mudaku, Molli, sedang keliling untuk mengerjakan PR-nya, kebetulan dia sampai di pintu rumahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Dia berharap aku bisa bantu dia sedikit dengan mengizinkan dia berbuat hal baik, jadi dia bisa punya materi untuk kerjakan tugas mengarangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "Aku melakukan perbuatan baik bukan karena PR. Setidaknya bukan cuma karena PR ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "Benar. Aku yakin kamu anak yang baik. Kamu pasti melakukan kebaikan bukan karena PR.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "Sama seperti kedua tamu yang muda ini. Mereka juga datang berkunjung ke sini bukan karena perlu pekerjaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Anu ... kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Jangan dimasukkan ke dalam hati, cuma bercanda saja. Kalian tidak mungkin marah pada orang tua sepertiku ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "Anak muda selalu punya banyak waktu. Kalau memang kalian mau menghabiskan waktu kalian untuk datang ke sini, aku juga suka ditemani anak muda. Jadi, kenapa tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Aku sudah siapkan beberapa kerjaan untuk kalian. Karena ada orang yang berkunjung di sekitar sini, pintu rumah cepat sekali berdebu. Belakang rumah juga sudah beberapa hari belum disapu. Tolong kalian bantu aku bersihkan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "Hmm ... ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Molli, kamu mau main sebentar dengan kucingku tidak? Sekalian kasih dia makan ikan. Anggap saja kamu temani dia main. Oh, ya, namanya Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Dia mewarisi nama anjing yang pernah kupelihara. Tapi, sayangnya anjingku dibawa pergi putriku waktu dia menikah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "Baik, Tuan Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "Pergilah, anak-anak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
