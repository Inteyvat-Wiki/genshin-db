			"dialogs": [
				{
					"id": 741490601,
					"content": "Kirim koran ya? Taruh saja di pintu, nanti aku ambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Hari ini kamu sudah membantu Benoit, sepertinya tidak sopan kalau terus mengganggu istirahat orang lain. Karena sudah janji besok ketemu lagi, jadi tunggulah sampai waktu yang dijanjikan besok untuk datang lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ketuk Sekali"
				}
			]
		},
