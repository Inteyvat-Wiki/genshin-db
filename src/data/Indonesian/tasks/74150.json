			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Kardus-kardus usang yang sudah tertutup debu tebal dan kelihatan berat itu ditumpuk begitu saja di sini, benar-benar merusak pemandangan jalan Court of Fontaine yang terang dan bersih.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Kotak Aneh"
				},
				{
					"id": 741500702,
					"content": "(Noda air yang sudah berumur terlihat jelas di bagian bawah kardus itu, sepertinya pernah ditaruh di tempat yang sangat lembap.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Kotak Aneh"
				},
				{
					"id": 741500703,
					"content": "(Dibandingkan dengan noda di pintu itu, kardus yang dekil ini sepertinya lebih perlu dibersihkan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kotak Aneh"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
