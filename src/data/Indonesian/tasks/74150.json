				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Oh, kalau kalian ketuk pintu sekarang, tidak akan ada yang jawab. Morticia dan Athos lagi tidak ada di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500802,
					"content": "Tadinya mereka bilang mau pulang hari ini, tapi mungkin mereka masih ada urusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoit Leroy"
				},
