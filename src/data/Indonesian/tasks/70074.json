					}
				]
			},
			"dialogs": [
				{
					"id": 700740101,
					"content": "Eh, Paimon baru kepikiran nih! Padahal kan jelas-jelas Varka sama para penyihir yang mulai diskusi ini, tapi kok kita sampai enggak perhatiin topik \"PR\"-nya si Varka sendiri ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Coba Paimon lihat ... Varka, Varka ... eh? Kok isinya ... kosong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Gimana kalau kita tanyain langsung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Ide bagus ... okelah, kita datangin semua kedai dan rumah makan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "Masih belum ada ya? Duh, harus pikirin cara lain deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "Panjang umur dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Hai, Varka! Kami mau nanya soal \"PR\" kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "Oh? Honorary Knight dan Paimon! \"PR\"-ku ...? Maksudnya gimana tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "Hexenzirkel kasih PR buat semua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Eh, \"PR\" ini ... benar juga, aku ingat Alice pernah ngomong sih ... kayaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "Lah? \"PR\" ini kan asalnya dari pembahasan kalian! Gimana sih ... Sudahlah, mending sekarang kasih tahu kenapa yang kamu sendiri malah kosong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "Mungkin karena yang punyaku terlalu berat buat buku sekecil itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Jadi penasaran kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "\"PR\"-ku ... adalah bikin anggur paling enak yang pernah ada di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "Itu apanya yang \"berat\"!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Eh, ini bukan bercanda ya. Lihat bekas luka baru di tanganku ini? Ini akibat dari mencari resep racikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "Aku masuk ke Domain yang besar dan gelap, lalu bertarung dengan monster paling galak, bengis, dan buas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Asli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "Sekarang tinggal sisa tiga bahan khusus sampai minumannya jadi! Honorary Knight, Paimon, boleh tolong bantuannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Oke ... sisa tiga doang kan? Kali ini Paimon anggap saja cerita tadi benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Nah, gitu dong! Hehe ... kita perlu \"serpihan kayu yang dihajar knight\", \"bulu merpati yang rontok karena bahagia\", lalu \"kuah obat yang direbus di periuk raksasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Ini ... ini kita bukannya mau bikin anggur? Bikin minuman? Itu sih kedengarannya kayak bahan ramuan ajaib woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Hmm ... benar sih. Yah, tapi wajar kan? Ingat siapa yang kasih PR ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Resepnya mesti diikuti sampai titik koma tidak ada yang kelewat. Artinya, tiga bahan itu harus ada dan sesuai permintaan. Yuk, mulai dari serpihan kayu dulu saja, yang paling normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "Seberat apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "Tapi yang kamu masih kosong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
