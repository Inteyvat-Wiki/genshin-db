			"dialogs": [
				{
					"id": 700740401,
					"content": "Hebat! Jadi ternyata begitu caranya, sungguh—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "STOP! Kuping Paimon sampai kapalan saking seringnya dengar kata-kata itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Oke, bisa nih. Bentuknya, teksturnya, kualitasnya ... mantap, mantap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "Serpihan kayak gitu gimana bedainnya sih? Tauk ah, gelap. Habis ini \"bulu merpati yang rontok karena bahagia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
