			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "Hei!!! Kalian bikin merpatinya takut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "Grand ... Grand Master?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Wah, ada Timmie! Lama tidak ketemu tahu-tahu sudah tinggi lagi saja ya. Kamu makannya pintar kan? Sehat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "Si-Siap! Aku selalu ingat nasihat dari Grand Master! Makan yang benar, dan latihan yang benar kalau mau tumbuh besar dan kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "Bocah satu ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Efek Varka itu nyata ya ... Tapi jujur, Paimon malah lebih kaget kalau ada anak kecil di kota ini yang enggak ngidolain Bapak \"Legenda Hidup\" Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Maaf ya, merpatinya jadi kaget lalu kabur semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Sebetulnya aku mau tanya juga sih. Kira-kira ada tidak cara untuk mendekati merpati tanpa bikin mereka takut ... biar mereka tetap senang gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Ah ... kalau aku sih biasanya cuma jalan pelan-pelan ke dekat mereka, terus kasih makan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "Nah kedengarannya mantap tuh! Kamu masih punya sisa pakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Ada sih, masih banyak malah. Tapi Grand Master, kalau boleh tahu ... mau buat apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Kamu jangan cemas, kami cuma perlu pinjam satu atau dua bulu mereka ... Janji antar pria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ah ... ka-kalau gitu siap, aman Grand Master! Terima kasih, Grand Master!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "Kenapa jadi sopan banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
