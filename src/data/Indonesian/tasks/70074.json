			"dialogs": [
				{
					"id": 700740201,
					"content": "Jadi \"serpihan kayu yang dihajar knight\" itu ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "Ah! Grand Master! Honorary Knight! Kalian juga mau latihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Latihan ... yah, bisa dibilang gitu. Kami kemari untuk menyelesaikan sesuatu yang spesifik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "Padahal sudah sehebat itu, tapi masih tidak berhenti berjuang agar bisa lebih kuat ya ... Kalian berdua silakan latihan sampai puas! Aku mau menyimak dari pinggir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
