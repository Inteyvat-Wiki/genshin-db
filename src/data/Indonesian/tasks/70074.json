			"dialogs": [
				{
					"id": 700740801,
					"content": "Kuu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Merpati"
				},
				{
					"id": 700740802,
					"content": "Monitor, bulu sudah diamankan. Sekali lagi, bulu sudah diamankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Akhirnya! PR ini lebih sulit dari dugaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Tinggal satu bahan lagi ... \"kuah obat yang direbus di periuk raksasa\". Hmm, itu sih pasti Dadaupa Gorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "Aku mau langsung ke sana. Kalian nyusul saja nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Walah, dia semangat amat sih, lenyapnya lebih cepat daripada merpati kaget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Spesimen sempurna \"hidup sebebas angin\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "Dasar ... dasar om-om pemabukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "Hmmm? Siapa di sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "AH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "Diona? Lagi apa nih? Kenapa pakai ngumpet-ngumpet segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "Aku ... aku lagi metik buah! Ya, sungguh! Cuma enggak nyangka bakal ketemu manusia menyebalkan yang satu itu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Belakangan ini dia datang terus, maksa-maksa supaya aku bikinin dia minuman yang tempo hari. Saking seringnya, aku sampai muak ... pokoknya kalau ada ciri-ciri dia mau nongol, aku langsung kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "Minuman yang tempoh hari? Ada cerita apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Kalian juga tahu kalau dia dan pasukan ekspedisi baru saja pulang, ya kan? Begitu sampai di gerbang kota, tebak mereka lari ke mana? Cat's Tail dong. Mau \"merayakan\" kepulangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "Wah, ke tempat kamu? Paimon kira mereka bakal langsung balik ke markas loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Terus aku selama ini punya kesan kalau Varka itu tipe yang minum di Angel's Share.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Ugh ... semuanya. SEMUANYA. Mereka pergi minum ke semua kedai yang ada di kota. Cat's Tail kebagian giliran ketiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "Entah kenapa Paimon yakin banget kalau mereka \"merayakan\" lagi pas pasukan ekspedisi berikutnya pulang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "Ketebak banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "Pokoknya, aku benar-benar sudah muak lihat muka-muka para om-om pemabuk itu! Jadi aku mikir ya, dan langsung kepikiran buat bikin minuman paling najis, jijik, dan huek-hueks di seantero Teyvat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Diona, kamu lupa ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Ingat kok. Makanya aku sempat minta tolong Prince yang racik. Ck, kalau saja para pemabukan itu enggak mulai ngajak main si Prince kayak besok kiamat gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "Akhirnya, dia sudah kabur duluan sebelum minumannya kelar. Paling enggak, si om tukang mabuk tadi dapat hadiah bekas luka baru dari Prince!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(Ah, jadi gitu toh cerita bekas luka baru Varka.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "Aku masuk ke Dom{RUBY#[D]kedai}ain yang besar dan gelap, lalu bertarung dengan mon{RUBY#[D]Prince}ster paling galak, bengis, dan buas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "Yah, minumannya kan jadi nganggur tuh di situ. Pas di depanku. Sisa selangkah lagi sebelum jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "Dan akhirnya, kamu sendiri yang kelarin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Iya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Aku penasaran nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Uh ... serpihan kayu yang nempel di baju knight, bulu merpati yang aku pungut di hutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "Terus kayak semacam jamu Hilichurl yang awalnya mau aku racik jadi obat buat nyadarin orang mabuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME} ... Varka sudah lama enggak pulang kan? Dan ini kejadiannya baru, kan? Berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "Belum ada yang kasih tahu dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Waduh, gawat, gawat! Kita mesti cegat dia! Buru, mumpung masih keburu!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "Kalau cuma Diona doang yang bisa bikin kombinasi racun kayak gitu jadi enak!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "Boleh tahu apa saja bahan racikannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Mau dihancurin kayak apa pun, asal Diona yang bikin kan jadi enak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Ck, itu sih dia sudah enggak sabar ingin tahu rasa minumannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
