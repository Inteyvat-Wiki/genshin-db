			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "Luar biasa ... sejak kapan Hilichurl bisa diajak bicara baik-baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "Ella! Kamu lihat Varka enggak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Ya, tadi dia lewat, terus bilang mau pinjam \"periuk raksasa\" sama Hilichurl ... begitu para Hilichurl lihat dia, mereka langsung kasihkan loh! Percaya enggak percaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "Anehnya, mereka bahkan tidak bertukar sapa atau saling bicara sama sekali. Aku tidak paham, kok bisa ya semulus itu ... apa mungkin Grand Master tahu bahasa isyarat Hilichurl yang belum pernah aku pelajari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "Uhh, dia bukan pakai \"komunikasi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "WOI, sekarang bukan waktunya bahas itu kali! Varka, dia mana dia sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "Itu di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "Akhirnya ... selesai! Anggur terbaik di seluruh Teyvat! Ada di tanganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "Varka! Jangan—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "Oh? Hai kalian! Para Hilichurl di sini ternyata cukup pengertian, proses peracikannya jadi lebih cepat dari perkiraan, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "Nah, sekarang waktunya! Saat-saat menentukan ... untuk mengetahui seperti apa rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "JANGAN! Jangan diminum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "Hmm? Kalian mau duluan? Hehe, jangan mimpi ya ... gelas pertama jelas buat yang bikin ... buat aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "Bukan, bukan gitu—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "Tenang saja kali, ada kok jatah kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "*glek* *glek* *glek* HAAAAAArrrhhh ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "Sebentar, ini ... kenapa, kok ... tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "Varka! Kamu baik-baik saja? Varka? Vaaar—kaaa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "Grand Master!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Ayo dong! Kamu udah berhasil menang dari dewa jahat, masa malah K.O di sini? Jangan dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Ugh ... Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "Rasanya tadi sekilas ... aku kayak lihat semua Knight of Boreas dari generasi ke generasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "Aku bingung harus hina karena kamu tumbang di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "Biarkan aku cerna dulu ... baik itu minuman tadi, mau pun pelajaran pahit ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Kamu menjelaskan ke Varka soal kemampuan istimewa Diona dalam meracik minuman.\\n\"Dengan kata lain, cuma dia seorang saja yang bisa meracik bahan racun model beginian jadi minuman super enak ...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Aha ... jadi masih ada satu bahan yang kurang rupanya. Berkat dari Peri Mata Air ... haha, ternyata oh ternyata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "Eh, jangan ceria kayak enggak ada masalah apa-apa gitu! Kamu bohongin kami, urusannya belum selesai nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Maaf maaf ... Aku benar-benar kira resep ini aman, dan mau jelaskan sambil minum sama kalian setelah selesai bikin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Tapi sekarang ... kalian juga tidak bakal mau minum, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Sudahlah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Hmm ... kalau begitu, anggap saja minuman kali ini utang ya. Gantinya, aku traktir kalian makan di Good Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "Nah, gitu baru betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Murah amat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "HEH! Bukan gitu! Lihat enggak tadi dia jadi kayak gimana?! Cuma segelas loh padahal. Paimon yakin dia sudah belajar, sudah tobat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "Yah ... memang salah sendiri juga sih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Daaan sekarang kita balik ke \"PR\" kamu. Yang benerannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Haha, ya ... sebenarnya aku mau ceritain soal itu di kedai, tapi ya sudahlah. Ganti latar ke alam terbuka juga bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "Jadi kalian bakal beri \"PR\" ke semua orang di Mondstadt, ya? Ide bagus ... aku dapat tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740944,
					"content": "Hah ... kalau kamu memang sepenasaran itu, \"PR\"-mu adalah \"mengubah takdir yang terlihat di kaca ramalan\". Tapi kamu sudah menyelesaikannya dari lama. Tepatnya, dari saat kamu memutuskan untuk berangkat ekspedisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700740941,
					"content": "Kenapa kosong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "Nyaliku kurang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "Atau muji karena kamu masih sanggup berdiri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "Jangan gugur di sini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "Intinya, bukan masalah \"bahasa\" ... baik lisan atau isyarat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
