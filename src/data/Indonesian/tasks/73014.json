			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "Ah, ternyata Nara, Nara Emas, Nara pemberani ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140302,
					"content": "#Ini Paimon, ini {NICKNAME}, semua yang di Vanarana sedang siap-siap buat Festival Utsava, kok kamu datang sendiri ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140303,
					"content": "Arapandu memiliki misi penting, demi Festival Utsava, demi Apam Woods, demi Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140304,
					"content": "Jadi Arapandu itu kamu ya. Terus kalau Nara Varuna? Kok kayaknya nama ini enggak asing deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140305,
					"content": "#Nara Varuna ... Dia sama seperti Nara {NICKNAME}, berwarna emas, Nara pemberani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140306,
					"content": "Saat bulan dan matahari tidak terlihat, bahkan pohon besar di Vana diterjang angin kencang, daun dan ranting robek oleh hujan hitam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140307,
					"content": "Rasa sakit Vanarana menetes memasuki lumpur, bau dan aroma besi serta garam muncul di mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140308,
					"content": "Oh-ow ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140309,
					"content": "Tidak tahu setelah berapa kali matahari terbenam dan kembali, Nara Varuna lalu datang, Nara Emas, berbicara bahasa emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "Dia dan Aranara, membawa kembali bulan dan matahari. Varuna Contraption membersihkan rasa sakit Vanarana, lalu tidak ada lagi hujan hitam, tidak ada lagi aroma besi dan garam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "Semua yang ada di Vanarana berterima kasih kepada Nara Varuna, semua suka pada Nara Varuna, seperti matahari, lumpur, hujan, dan embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "Wah, hebat banget yah! Dia pasti Nara yang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Tapi, hehe, Nara {NICKNAME} juga sudah banyak ngebantu orang dan dapat banyak terima kasih loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#Arapandu pasti juga bakal suka sama Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "Setelah dia meninggalkan Vanarana, banyak yang terlahir dari lumpur, juga banyak yang kembali ke lumpur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Cabang dan daun Varuna Contraption juga telah kehilangan kekuatannya, Varuna Treasure menjadi seperti burung ketilang yang ketakutan, lalu mengepakkan sayap tanpa arah dan tujuan. Hujan juga jadi semakin lebat, pokoknya aneh sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Jamur yang bisa berlari tetap tinggal di Vana, juga ada benih yang belum pernah terlihat di mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "Apa itu jangan-jangan Fungus dan spora? Tapi, sebenarnya apa sih Varuna Contraption dan Varuna Treasure itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Senjata yang sangat hebatkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Pedang yang bisa membelah Valuka menjadi dua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Tunggu! Bisa jadi terlalu kuat dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Hmm ... Bukan, salah. Nara {NICKNAME} dan Paimon belum ada yang tepat nebaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Ayo kita ke tempat tinggi, Arapandu akan memberi tahu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Mungkin bukan senjata ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Terus apa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Mungkin Aranara bersayap buatan dari air ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Kalau gitu sih Hydro Mimic dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
