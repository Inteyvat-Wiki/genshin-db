			"dialogs": [
				{
					"id": 730141001,
					"content": "Ini adalah \"tempat istirahat\", di sini kita bisa lihat ada jejak kalau Aranara pernah berdiam di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "Varuna Contraption kelihatan lebih spektakuler ya dari sini, hmm ... bikin kagum banget sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon, hati-hati jangan terjatuh ke dalam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "Enggak mungkinlah! Kayaknya sih ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Kami sudah sepakat untuk berkumpul lagi di \"tempat istirahat\" ini setelah menyembuhkan cabang dan daun Varuna Contraption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Kemudian mengusir cacing jahat yang menggerogoti akar Varuna Contraption, serta mengobatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "Terus, maksudnya \"cabang\" dan \"daun\" Varuna Contraption itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "Cabang dan daun Varuna Contraption tersebar di seluruh Vana, dengan adanya mereka, Varuna Contraption memiliki kekuatan untuk mengubah hujan hitam menjadi hujan baik, hujan yang membawa kelahiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Seperti air hujan yang mengalir ke sungai, sungai yang mengalir ke danau, cabang dan daun mengumpulkan semuanya ke dalam Varuna Contraption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "Varuna Contraption yang sekarang berbeda dengan dulu, seperti ranting patah yang mengahalangi air hujan, air tidak lagi mengalir ke sungai, danau juga mengering karena tidak ada aliran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Hmm ... Kok masih bingung ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "Sama seperti Paimon kalau belum makan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "Ah, lesu dong kalau belum makan! Jadi sekarang Varuna Contraption lagi marah karena lapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "Sepertinya tidak gitu juga deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Iya ya, kalau kelaperan mana mungkin ada tenaga buat marah-marah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "Pokoknya, sekarang harus nyembuhin dulu \"cabang\" dan \"daun\" bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Benar, Arapandu bawa Paimon dan Nara {NICKNAME} ke sana bareng-bareng ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "Ini seperti dihalangi di jalan saat sedang dalam perjalanan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "Terus semua halangannya harus dibersihin supaya perjalanannya bisa dilanjutkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "Padahal kan bisa ganti halauan saja! Memangnya siapa sih yang nentuin rutenya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Benar, siapa yang mengatur rute jalan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
			]
